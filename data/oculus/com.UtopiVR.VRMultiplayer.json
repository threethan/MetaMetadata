3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qr4OqgCsggIQ7kNvwHOpwzu&_nc_oc=Adpeily6NRn1y9z3VClZpXErVTGHgVj2mzE31oqLMXbF_ld55SAGsnINm5SqVBeE3SE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8gT6eTcqqdJ0tqVtJ0kfl89FG2TiC5lPiTslasTMvzw&oe=6A5A348E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRL0-fLl-_8Q7kNvwG_xpNg&_nc_oc=AdrTZDLl0aW9G0bpIEZBHKiiXgPtiBpXWT-PPb7_ZlrpXK8nq0m676r2K0Vyhb4bnm8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDb8nKN1XvZSkmBS6Pq_3RbBZiK7TAMft1x2Dstm1zk9Q&oe=6A5A4499"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rb6y5MhXkRIQ7kNvwEdVu4u&_nc_oc=AdrIH945bYPnveQ0uvGaxaComEzCcX46U9WgW-kYkdBwANfVRfstq0yDyr79ES1XFnE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1TwJ5N-Us8dRYTa5BoIZQQ-_Fq0fzwqKL71ZV8n8-zQ&oe=6A5A240C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_J7lezgj1ZMQ7kNvwGbxEU8&_nc_oc=Adp2XPiQg6R9O6T6ih_dilH3OxAuQ7uDMHxoBT_sjQL1cbR-EPSeAIJv8zibgGQJino&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af932XnJdrpq7aLt3eIG9ks0ghivgwL_7FRju6aaVNzeFA&oe=6A24270E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54UTzZaM2A0Q7kNvwGAtuJ2&_nc_oc=AdrRViCnzHoPM55uRieE4K5srPUPwloxYtoVOqGgXSqLedlemqc4RcfYaZ504XrBtVo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_RZDO34D1C1myrqjEpSJW6lRk_Zzu63OFGBgE3S6GIw&oe=6A243719"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tktfzbih6AsQ7kNvwGjT4Os&_nc_oc=AdpFVGVcuFfPACXffmd_Hg-0AJW7qYl6V-Z2_e85J2plJzXiW45kXfgttb1ad-3W8aE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95JpKjDLYDhzf5QHi-aYlvWiM1_jBNHyHGFRoxnq1bRA&oe=6A24168C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSYiH_-_uyMQ7kNvwEG50fW&_nc_oc=Adr6I-3V6Uc5nRA6dF5_V8LCFpwDb-4BMzhuOTSDD0ic-gzllwljo8oSQ4pKwLcsv4s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88aJvKfRy5j-QCEhQAopa216e4T8mu9w7wX2Tu0MH-UA&oe=6A2ABE8E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJLEMAmVseEQ7kNvwEj1k0C&_nc_oc=Adod6x7ESfCgMKqux8OeVH2W5Zx09aiyBmPCzu1LAL6f9LsBGlWVk1jcJo0-o-fJUvc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7CM92mTwZvSSfxajpsW-PoSjMYfXeRks8OqCCMgFCKA&oe=6A2ACE99"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OthBWs5rvzUQ7kNvwGDNCbY&_nc_oc=AdqGXPR4fPRNpBR6AZ3bCFre2tSa-DpPkJBcaLbMoHrV3icCIFGBgBTKXxcEIUPTLm0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-93K3Lto5BSf-Z3Udk_0Sv2rPyTiHZzgoJV7pTk57j6w&oe=6A2AAE0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
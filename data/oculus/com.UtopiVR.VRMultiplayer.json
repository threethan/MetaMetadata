."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtxOqrhyAeIQ7kNvwEKtvw5&_nc_oc=AdpbioPXJ0o4MvSSw6XK1l-jIxB6K2Lgus1baeUkf0XwzcMgZiZ3VSxMinRTLXaaYP4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI_SYg54LbhAWfxYDE_AEdmcgTG9q5-enSPEYz8AwENg&oe=6AB5352F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEtxlrafaHkQ7kNvwGsuo__&_nc_oc=Ador8nytFQr4Uua8Sfnxtvl1pBC0DOy6OzaMKWKihJ_8Tn3ZpX04p1P2DbU1jVMPCzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdcIkcMeZCMyK3TNecWQj8TEsRyWoB8TZfyXKDUzn4VQ&oe=6AB51B6D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpflqDB-L7oQ7kNvwG8WhZR&_nc_oc=AdrGRaTGfN-yYAPhs4LJoVOorHbzx5kgWTcgANbGw0Ct6RyyeQnV-RhURCmKR3NjVoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOC5rycn2WS5VN5tiBmfb9Pkt_x8jxRtQNJRfovx6g1A&oe=6AB54BB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q67W2VPVfsQ7kNvwG3X6mr&_nc_oc=AdqqQNhKbqnY7fAYMurVAbkyRdK6h5BH-qwjxAGuWFCv-kkt6tT27MBahV7fqzG-jys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKelYsNq0rqLEZWg1n12ijd4ZGFTQ-GaMmRkTT8U6-zA&oe=6AB541C6"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlNx7jWgygAQ7kNvwFAZiR0&_nc_oc=AdrSUJfT_17vp2DDNzVSj4ViSPLBGJcgPRvLnwXQxVunLkHuCN_3CKDALdjLHSldKv4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUjh0rTBfAPJNWds-Bq-WF0TyaPHoVJRrwT5mfhf2KwA&oe=6A79E1AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7Jg4CJZnWIQ7kNvwFp_k3z&_nc_oc=AdriiQVpNkrS9QIbtcnXlV-JhtPF9nw7e9GvnqsdeIbQ-HoQ4_sI2FRw_7u86CYB0RE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgUDFyOxB_WLdxJy7DrpQriZeJOvtbGaJAK0UBQzZB2A&oe=6A79C7ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8EFikze44EMQ7kNvwGokOg2&_nc_oc=AdoAxCjBRouGYomnwlqtJNokM4cl8zfD3hZUdHwCh5D43r-_eu4dRzsq6thNYAFAves&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFc99nHmzGk4v6qK2e727Xtnr4D9eQs7aGZ0v50yO0u2A&oe=6A79BFF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UHvldolqh4Q7kNvwGrM88o&_nc_oc=AdqEhdrWnwjIBKeZ5uN81FICqsS-LfU7h2s6WKEaS-_A1LSMHjjEP9hWp551xIDjqd0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXAKDWJNOOV2F_2oYHTf-NBhub5AlQSMPoj5PVQraGUg&oe=6A79B606"}, {"file_name": "Hero Cover3000x900.png", "id"
3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_Edkp5IvogQ7kNvwFplxde&_nc_oc=AdqYGDcm6T4jrautl4tayzKkvIcNiVp0o_xdE1yapVsVfdhfEBTIy3WZA4mGMFY1dPA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9UEu48EBmHc6Z-5xePhEo9m3bidb0_Pk6TPiwzDFF-gg&oe=6A21840E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XS6VdWkX-3kQ7kNvwHub2OT&_nc_oc=AdpgbHlslKyRcQY4qll1fxItDmSn9X4U5lKAuejbLG2d212jyZrBWWsVTmWIPRlnWoo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-R02mPVXs25EWvIEKihZ7LU2p6DLSZAzsMnwpi2ia5g&oe=6A219419"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tktfzbih6AsQ7kNvwEP_inO&_nc_oc=AdpNeMNCi6rXjI6XwytcdtUgrl_55lqQSIjYYoGujKqejsTHwFHlozMpUcp1iKn_TQs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cjPfgANRE04IGCKctwq0slYh5450BS4pdYWScJvAefA&oe=6A21738C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
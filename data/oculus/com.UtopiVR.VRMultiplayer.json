3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUM77x4QeFcQ7kNvwEn8V75&_nc_oc=AdoNs9ESjTmEwyY00p0EjBmJKBeXzzMw7Mizl6BOrHzQ2hLfQlNn70vVzbsCibJA6os&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKc4F-TM4QGsK8aE57Dbr6y4M_YgtetcrB9CGkhg1tNNw&oe=6AAD430E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Inn0zB4vx7QQ7kNvwEoqvt4&_nc_oc=AdqWzkdwUYa8TtIxjK461kozqOCAW8VNFSKYr-6ZHEqvpjqIoptUcHj4NIpZ8UOJ1Jo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsx9_9bFdX8ZA2z1JhGGwgUKhgodlD-xRcFelu7putUg&oe=6AAD5319"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TRkH4BqmTyQQ7kNvwEw0HMI&_nc_oc=AdoxYO-bbiCUUJ1oLDxRHAkQcnzn5o6nnvLTX7xOnHgqkbwrDBxdIdWRMtrG1KyJy48&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTHPwa931FL7eLNlvGnZ7-Qiq0lLHzeCDsylHr6lMjKg&oe=6AAD328C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
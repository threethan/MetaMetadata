3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASP2-E8TqMgQ7kNvwGZOivG&_nc_oc=Adp38WZmJrU2DVv-mAQyWkZBYQdanERNP9ftoBcq5OlS_vO-pwl5mpR2Q9QmEgxJTj0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZgq9u00Gdd3lcTohvF2aiTjT_l_a2Ev1RpxIs9_BcNw&oe=6AEC8B0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tBGCKbrEtcQ7kNvwE9N-lv&_nc_oc=AdrfR262F25RnLE45Co3V6kt4PXc-9fmlkN1YG59-xKYXOgCJRT_Y5CdyPo5MvF8lVc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2NQPP2ptHroeS4DgW7EIavdJptEblN7hVx_84ttaGkg&oe=6AEC9B19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuq87UtwjIYQ7kNvwEtGv3n&_nc_oc=Adq8WrjXODgmAW-sdMwPsruaVMwBTkdQOJF8-3jfUoKsQaqTjD07rb0spjd332NXM10&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRww0IGZwpgCtS0WOckWnQ76Pj6MYb9cfMiyJvEd3PKSw&oe=6AECB2CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
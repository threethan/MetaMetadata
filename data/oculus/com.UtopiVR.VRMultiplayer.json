3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iZL7n6c1nwQ7kNvwEsuU6N&_nc_oc=AdpZjBFaiGkl6FQpD_IiStf0w7D2QsqHOPUyC7-px9hivB7TSM_F3fw56LE9oVfHzBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2leBIGKCeE54Yjv-FSLYPhA2ryrEEjLkjDwtAw5QfYxw&oe=69EE198E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKmQXIUF6MwQ7kNvwFl_a4n&_nc_oc=Ado5pup515yYzwJEjzePMfH8ItBGNypJC0P4gz-SxRIqr5hgfb6J6qIfWpHNaGVZEqo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FEOd1SCu_EpZOp76YRnbxCyDJnZBr5iyBU5Q0MOorxA&oe=69EE2999"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pYFnLio1KIQ7kNvwEK3nPC&_nc_oc=Adq8-4ap4ROB1DTrL7FROcGuju2bJ3xzHSyHPZW09j_6W3--A5IVG12b1OMdYuavkx4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YseT0rhLQW2JZS3-zml531-WyWWC35CJj1Z4zQrBgGg&oe=69EE090C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
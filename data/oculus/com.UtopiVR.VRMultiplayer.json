3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QInkPTIUfRMQ7kNvwF1dE3p&_nc_oc=AdqfeRVEyBi1Nvgw9RdVx7NyCovOt_xL17_cInaJ8z-HfSeWRP4HNKDmuk0oI9ow9_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYFRz717U7hEKH_iTGtNJ7L7WPuEAfztRmptitA1n56w&oe=6A636F0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBnMPKpgqRcQ7kNvwFLayL2&_nc_oc=AdrBHr7sYM-UlIxbYrMuW3UuC-OCSQ5e3SQQV5cn15btTWiV4G1Blnrt6HBdo7w1O8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDru7-nIoimnZIqQ32fkYxbns76MZjbgWfWPHmdQyLwGg&oe=6A637F19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r5dDQYW6l0Q7kNvwEnx2xL&_nc_oc=AdpNL5UkUtYwSdYeGBffLmFj-8LNw3aC54bK0fQFIzzk0ZWJYyJPxYWW1hg4-eiRYTQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA35zqPtV7m4gGtzVFiRodJErPDgLVaXRCGoV6V5nSR0g&oe=6A635E8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_BAUpAsXzEQ7kNvwE8nZqt&_nc_oc=AdpSa2aG8RtCiuRr_ZkcYKyOyjnnQx3lenPunW3hZo1f_6X0A6j5Zvvw11VdjGl4oFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMs3Nb32CvRkHyyTy-eVSUTe0N8SZEn9Qjyp_8wxIHBDw&oe=6AC658AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6inEorzX4UQ7kNvwFGYmc7&_nc_oc=AdppsQs1CsA2lz11if3VGtKjlpjMiak6bvVKC1vd_6gdIabXtYhPYiasx386sRzo5tk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPflhCmchbCv-n8spPD9ebG2GSmJ7omcdW2FgZ2GjzfhQ&oe=6AC6772D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlDzEJGH4nYQ7kNvwF8_d6F&_nc_oc=AdqE4GOVxFL7f7qh_-Xw2dzoQ99oMSKBvRb1JIB9oYYEFvdY9m98woP7FTFTFdWRrBc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-WuxM2a2BxkABv-voYA8q9mPRtXRoISK7i9mnQP2Ycg&oe=6AC66F39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFE45K8_pHIQ7kNvwEvq1y2&_nc_oc=AdrvMfpQOupy_wXQQL6aIcmOqPyQ4NUOmWn1JOONMxnybKof6qO0h4lp9815jz2HS3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmtLOd81DA-P4wwJCkmSRfgi6BkdTCEnE4_dCnAys3Fg&oe=6AC66546"}, {"file_name": "Hero Cover3000x900.png", "id"
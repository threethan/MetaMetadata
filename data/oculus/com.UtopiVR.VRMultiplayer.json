."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOcrTvQvwKwQ7kNvwEqZrWF&_nc_oc=AdrEGsLxSr9iatQrjV7jliNk2ED1loB25jDSDE7j8q0ueeQD6R84gIoSTv9r2kKclHw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOZbTgp0Y-rjx03y3Ot_GCA5y_0YK_W1kuKCx4lFzTYg&oe=6A98342F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5CicnVFL-UQ7kNvwGCez73&_nc_oc=Adr2bXC4uDoB8iZYQN4q39qTYqsRW7H62PFUHnL2xMYle8ORAU2V30xee3NAp8lfxlE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5whDTIcco9Hcuhc2j0cJ4Bm-R6b4B6-EsRRWFp_cPWQ&oe=6A9852AD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tN0wE7_NuEQ7kNvwGiOCYp&_nc_oc=Adq2i3B1ABZXdDh9ewjfYjnjpyqMOJx9Poz3ORen4-3vWIXgGdaoS7l9wZlFnuBSoCs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLaKDwvEeQfDdIMVXivBE7fCRDlqQcN7qZe8p37Y-6whQ&oe=6A984AB9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zO34oeKphIQ7kNvwGEQ-o2&_nc_oc=AdpGgCTqggkP_-YhGd-4kGZ2hAUpotvnc9R6EO6WeXXAPetye6EH_Fx2dnXEw1VItdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7Sp9pMRuBfO1h93f3A-WzzJm0CU3-F85tbn0KRj-RmQ&oe=6A9840C6"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDcj9U8n5tEQ7kNvwGBO6zT&_nc_oc=AdqSbEu2J4CTHWzCZnGZSdXzIbUDDpkjFwHTvoQ0mbQxrUTePwdToFy16_xSpEb-99c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dClBEo4waVNQTw8vz_7VcAuHHYtVw01o5EUVakfXchA&oe=6A0B23AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvYS16uxRwoQ7kNvwEv-3yF&_nc_oc=Ado4M6l-1pAgDd3JSoLNt17xrLiywrxlAz3h4c2mw3kk6QeQrdCoEKGn1WMmm6z2z08&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fyLgXWDxRIj3lfoP-RC9QkET0HXUSWQbBUHpIfSN74Q&oe=6A0B09ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IcxLjlGa1QQ7kNvwEZTEjO&_nc_oc=Adp2ec5r1333p7-j-hZSTtElDxZ6WUh4-rGMCEZ-NeXKItMODdSA4b_ETgr0czTsy9M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gi5c9PNQ37TmAVfgHZDkRR2wgqioyTrSjcxcBoqYCvQ&oe=6A0B01F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_jl3fmqBkIQ7kNvwEaMThn&_nc_oc=AdpqWI1M69p7PTXVY_emESz54KCLnWAeybGAnRzuZE9KARV3CwPqyKZQeij7dKpC5zE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WH0No2Cg3bnlkrGL851lRDnzPkjSzIrAWDCa_u5FmEA&oe=6A0B3046"}, {"file_name": "Hero Cover3000x900.png", "id"
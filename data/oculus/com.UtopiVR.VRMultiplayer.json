3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRJ3JtPvQaUQ7kNvwEHUHTk&_nc_oc=AdoJrcS2SBBUEIV8d2wnlUT34dGNiaBGCJMHnSOWpAy4D4kI1irkIyUesWuuBGwuoss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdrj1Z5WYExud0Rm3_W-CXonaa1p4sA7fIvVnHBfcRIQ&oe=6AF5C58E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVu8xinVtRMQ7kNvwELvl0k&_nc_oc=AdpxMH8dzC66gk-8_MpCgQkTGugLxL3Ay2KIBce2xsdBfyIjNE51MFm-sdqvpLar2Fw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT9GfY7pOb2ji1iAQGqYbkseBb4RiXSQ0H4UAejADYc1Q&oe=6AF5D599"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6ZD5sL64BcQ7kNvwGqWaNy&_nc_oc=Adp2ll4llkzCyYuxtyUAnZVG-nYuJdMElp83N-GvwZF8IwmSDSb0iO01VcK_lM2ORnM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8ERnDb5b5LpenhNwuYJBsR_jEfmpxNTFRD5nX-xdjqg&oe=6AF5ED4C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
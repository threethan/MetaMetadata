291"}, {"file_name": "Utopi screen 01.png", "id": "4303246779911211", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618351_4303246783244544_4805874035622876239_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVbbscSJLEkQ7kNvwEEKZiy&_nc_oc=AdrCz1YwWkj2g9xzk2ZdFEiJFWRB7d12UjT3ATof63XZAfwkY-zIy4YUbmbwFQQHAVQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUmPJHGKKx4UOLpgZDBuahX7HM5fAP6MzZ2Jr4TBJr0Lg&oe=6B103D15"}, {"file_name": "Utopi screen 05.png", "id": "1670993150248850", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824532_1670993153582183_2928640391252588422_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osq1u9OTuPUQ7kNvwHSsB5v&_nc_oc=Adq7HKt71v3tW6zVjyTI8EHd35EvJNcc_cDWLnSboYMvAX5ZT-H2GJaRBkEK5xWm-9k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8luqX0u9bE_T98flyrCHAJs0Vr08T6MUxXAM3YtA9Ng&oe=6B103E38"}, {"file_name": "Utopi screen 03.png", "id": "1287060295777096", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830428_1287060299110429_7519371814019840060_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Vdp9tcUouoQ7kNvwEnDofV&_nc_oc=AdrjATujOMxgA9Yrj5zYpIMS4ZXrtx8yKhZE9hgajHI7NQOBN-S5Twyk92PoESSQhFo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWoKOGKWk_XfArPGq41g2eF_uwBDdCHo9_ky9966Rgv-A&oe=6B105A40"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR School", "keywords": [], "long_description": "Long Description\nuTopiVR brings the full experience of a real classroom into virtual reality. Teachers lead live lessons, students interact naturally, and learning feels just like being together in one room. The app features an interactive board for writing, drawing, and sharing slides, as well as personal notebooks where students can instantly copy content with a single click. Beyond simple online classes or educational games, uTopiVR offers authentic, engaging education without travel, without borders, and with unlimited possibilities. Join us and be part of the future of learning.", "short_description": "Immersive VR classroom with live teachers, interactive board, and personal notebooks \u2013 real education without borders."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bb2wUOp9_3cQ7kNvwF86bmZ&_nc_oc=AdpfcJfcO_dbWJM8QPw5TSHawRfvMGhPC9bb3mnX1msgEFVboyCbmo5jQgdsKGhEE_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXFDRGu8_kqYUkqDXEoZKXAKVwJeuHrKX2XHsGChL3PYA&oe=6B1064EF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfNQ5mrH1OoQ7kNvwEYMaaC&_nc_oc=AdrwIoplKzvw0LJbxB84Odc3dkogDZ7829MLugiC4j1aZewI4hMg2bjtoxU9sf-wB_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX-Gbus46xrhiuwVaZHimZDIZYc7VI2pOl35Fx34o8CrQ&oe=6B104B2D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5JyTA6cK7ToQ7kNvwF2wD79&_nc_oc=Adry-GulK3hqgt9Jku4VaAPMktLWjAkYFYZVzsW9RMPTBanVnZeiPVqyfK0jw-Rc7d4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWmUAYJGxucuUXpbAQ9snqnpOc7XBxtmP7WCgSfhvD0QQ&oe=6B104339"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/49
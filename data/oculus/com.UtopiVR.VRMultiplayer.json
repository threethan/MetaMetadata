."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_IVri4XOhAQ7kNvwGeti38&_nc_oc=Ado2i4MsTmWgbcV-3PjukF8PjHyJopZIRaLAv6MXcNkNootbnPPzJeDvSwrw7i4mfjQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPJ7CLZk4gLnAx37n6fRMzphyzccpfaJxYCKDIwtlvQA&oe=6ABA7B2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajtG2QdU7PwQ7kNvwEQa2b7&_nc_oc=AdqeguoE0ooWkk5VIn5kOaPlv7mk5FcPak2FQulBRuPgfFicJIs6xuO2OwvFwyDuG1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLITwxbzpdbTW1JId-pyIVD5Z77ANSjOO4QYViIXgRaHA&oe=6ABA616D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47vSXIxUAywQ7kNvwHZWiK4&_nc_oc=AdqVGW0aJFr1rJDMPl9aIpYycr4cl9MlSicVEwItvEbTDwQYFFh_68tHnEDtWZ2u9Ug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl1JEKsriTVLnnxPgT_T3mdivGhatG-iPoU1tZ2JOXaQ&oe=6ABA91B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMh62DyE_LUQ7kNvwG0DePv&_nc_oc=AdrfRZPomeuga1FAY24OUhztNhERIU2PZoIuW62sPLtAH7k726_T_WUxecTMdRWwtdY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIVEkD8QP9vu2iQB7ofH8zXtLU8d8EeuUYqnmqfxLp1PQ&oe=6ABA87C6"}, {"file_name": "Hero Cover3000x900.png", "id"
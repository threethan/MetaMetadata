."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOnMqQ4T8w8Q7kNvwEoD2lI&_nc_oc=Adpk60k_hUfbeW1VmP97XCJXuDUS5in_8e02htRK_xEByj4Vm3NAXcPoxKkGF9IgGdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zqlP4Gr3XVtfKRAHaVcuQ4XSzxD17tr6XGdao5c2SFw&oe=6A048C2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Zc0O5SN38oQ7kNvwG0TYLR&_nc_oc=AdqCpFaaqH9rTXeh_GU1KaZaZ4jIoEIvmw1Sb4XQBDpAs_ZpbNcpIdOhKy2NOFduN30&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4f0WBgYdyYocj_bcU9VJqzRbSSlF1FIM26qYMKQNmqEQ&oe=6A04726D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x98pYtzWVDMQ7kNvwF_kUWp&_nc_oc=AdrgGKs_JJ7BgHUvvm7pncl50faO_FlknRoHocSFUZqGKvB_f6dPH92caIBo-PkgLeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Tfn16MMPWczlcwNyZQUi1JdD5AzRZ3w9mceVS96Pn2A&oe=6A046A79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O011pryS7S8Q7kNvwGpgahL&_nc_oc=AdqrJGPvf23adX87DhkRKNlVYK05YTp0lNG0N3Y71S_toOfCqpfIQtmw-lRHaP2RkHw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aLc7PPtm32zOtDcok_L37WeUkHsdMHZynDJD_mtwRow&oe=6A0498C6"}, {"file_name": "Hero Cover3000x900.png", "id"
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbrLGeIzXuwQ7kNvwFKlTyc&_nc_oc=AdqyLZatiZNks9GyGpI-Io9rI9nj2n-e3kXTB4m5OfPWi1y9qXX57sCSAlQK3QOlZi8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALjCLAvw70a7osl_oh8iB5b4Z_KjDgA6EzSlZ3KroZRw&oe=6A5B8F2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=963A7DODlr4Q7kNvwGq03cx&_nc_oc=AdrTli_jGHU08nZNdxZAJ0cDM-1fqesEwVj-OSanv_rE3mjNVNQ1JhaQ20hgw6AuOQ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7sghJQgef7QRHhhs5zGILQEHb3caq3-me-s3j-Rhipw&oe=6A5B756D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHqm3HhQyvwQ7kNvwE4p1J-&_nc_oc=Adrq761hC7LXm_gMDTtUav5pCb_ueraQ1aIifrcvS-FhGb7xRv0kHEoIYFma2Awzlxk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_kqoJ3bZAQWYajmK-yeAxGFKLR2DmPz3Lmu7UQgkeJg&oe=6A5B6D79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsHJfen8ymMQ7kNvwEEtVOj&_nc_oc=AdpgHNM2yIDZKg0Q8QgeOR-0RKRZccMTssWk-S2-xaDTWBfm5IhM5y_QJgn279J0W1I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBM4Z0R0nF8dpbxTsIqXcTho30uVbWDLIp6NzppAdINYw&oe=6A5B6386"}, {"file_name": "Hero Cover3000x900.png", "id"
771-25/499617693_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81VYzacBNc4Q7kNvwHGs4TE&_nc_oc=AdoQOCLX5JD3HSLLB1OCQwdreuC1rJLfkxffXSb6JJAd-OSyAyEEX6Dc3nVmJ2wG-l4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGynsAYuWfrHRVDYxFcrqaai9UceB-67_osYwGjErq_fg&oe=6A7DCD0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoH6pfJtk58Q7kNvwE7xppi&_nc_oc=AdqOaQGB2KB3zV2NHnDhTgubAWRYJMRxVqPv0ULwGUiz6eiYK1fnIJTA_TqYxe-RUFs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsTxvr9jYfBxSzM45SQghax0VIwFY6gQkoG7sG_a5eEA&oe=6A7DA4D9"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xCTgxuOXMTMQ7kNvwHGzC99&_nc_oc=AdrisqWLWP9UJMlpzsvJnz5SucqHijv2B0A2kc5WHSFLclXOstd5DsXtQ28MVe6oTa4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXUug2IBd7SFWPsk4CLT_K-92vVzg70qkv_kD6KHIODA&oe=6A7DBC8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, be
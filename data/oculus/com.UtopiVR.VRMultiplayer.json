."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pr46x9rIPeEQ7kNvwF_Aen-&_nc_oc=AdoRpoufvJ6iYXIynIoU2Q4DQvxxBIlFqlIbP3-82p4Njm4L570DdTK6wxq6wJ3mnzA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BYY8pKiQ2l7cNFU7Fvj2R7I3mIgxHuY1bunFB_2_vlg&oe=6A2824AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XouaFiTyxQQ7kNvwHqhLTr&_nc_oc=AdqcvDWkxLfm5Sp0ApbKBcyovBLjsVmVnPJZJ5UT-sCrH3MQN9Ue8yN210tVV_etX8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fS28y-xXc9yxTfQs8MomJoOpG8CmCJl4TEspUSIGHjg&oe=6A280AED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSgw1Uvio7sQ7kNvwEp6uCx&_nc_oc=Ado0_Kk1belSwdUMheXnjh2tUt6mLhSepXwMc02frhx9VkfVlDgzDEXn7vPh3qLTZQE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ypm7cINoISKoRYesQirmoI__MubPeUgZFGfYQRWuDkg&oe=6A283B39"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_oeTX8MM9gQ7kNvwHTDIw-&_nc_oc=Adr8xwKoeMeHStgOOj22BrpfCHTYpw-O1yruYn721MUA6SmKLimQPt1zABhnNrOcDp0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I0UfrdXQBH4ctKfMbCsq1fTfBSw8bxbubFqGFVntufA&oe=6A283146"}, {"file_name": "Hero Cover3000x900.png", "id"
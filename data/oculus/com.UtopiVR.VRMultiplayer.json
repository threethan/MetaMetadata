."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkOuzIx_9A4Q7kNvwHZSXdz&_nc_oc=AdrmFrKvBw9e-fG-EYnsyvonkn2lcyWkxBmcXMDqZv4ZmnAAPwTmRg_vZvP6oWsOYjE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVnx2skk6HVCjBhfi-TLyyYen9gDS8FoVz1nYGp4ABgA&oe=6ACA4D2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNAQ5tpdgewQ7kNvwESSV16&_nc_oc=AdryBqcGZ8-kR-xRMsj8QszfzOC0URc78LNiQb55sudL0-LEpyV4qme4AtdsHjK9bmI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlZlFQLXOtjNm6CkVdqUYx_VPuzBrHRyjEdDX8Ez9jyg&oe=6ACA6BAD"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-Mbb_cZTKgQ7kNvwHpyDEA&_nc_oc=AdoMXveIVvKBTqS8W28D1Kp9XkagyyyF14yTIFkfncK-XsTmEPWqwvFELk6r72eK-Wk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMm3I2dlmBkmBi49tTVk8bGilRBJZvwZ4umH-vFHEwjg&oe=6ACA63B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMvZ7gxk7LkQ7kNvwGDvYwJ&_nc_oc=AdpCKEffSboTsMlxFuGGa9WjG-dW-0CyD0br5OJ-iOMe8c5hyW_sqpJbQZYElwTSBKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1MYb5wXqOL8bKlMz0zcJrKwOrr8_rf252GYbkgrGiUA&oe=6ACA59C6"}, {"file_name": "Hero Cover3000x900.png", "id"
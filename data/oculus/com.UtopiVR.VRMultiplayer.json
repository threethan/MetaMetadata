3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LC0agYSDlb4Q7kNvwEMsqmH&_nc_oc=Adqj_HCs8puudwZVXrknz1NpdThOe5wzsJeDh5i_OLW06LL4WGtneNIEPS2KEdbsc68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBW1W8BNaqAeiur4vHmZjQYvyD80R_cXA9lyRh-NEdffw&oe=6A4A628E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ph_avbK2-C0Q7kNvwF9gsrE&_nc_oc=Adqp0wMY0erKDvGRBgZluf0GZWkTxFmq960LtimCim_WBrtoCE_hZu1unHlQozH0gzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9H1IfIkABPvQRMkJgXUzdsrC8Bx6Xp1ACEhMUGDmV_g&oe=6A4A7299"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaaw6hFjI0wQ7kNvwHcEgqY&_nc_oc=AdrcBO8GCUgfqBYzq-6H0HnLR-0DFUc0Aw7arLPmKjJZwkKCRpfoZ1uizmO9_yDOcd8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTVtpx-AThbbJgQ7vVUOp0yeoedf0quxlAYIyUe01Weg&oe=6A4A520C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
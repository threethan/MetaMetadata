3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mW806zNdWKQQ7kNvwGfTVIm&_nc_oc=AdqM7Ose0GJkGaFJdJ96PPp_sFtgO1bnvf_11L-WayJNjDPf9sx1igPUD6LKOKL7cqk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NFbw8glmI9rhUX-Uijdy4aw1EzDEnJBIKo0uDArzkKA&oe=6A16F80E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_LviyGCUT0Q7kNvwELivTJ&_nc_oc=AdrKKJeunAtXEhPMDJLCPG5RBi1fRToZvPFNtW8xEeagBUGlOz6itn24zLBrE_6Pf_8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B-WI4aMsyd7HyUfI6DEx26hK2OK0xvSDmYulaob896A&oe=6A170819"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIZAm5VF_pAQ7kNvwGM6nas&_nc_oc=Ado4IBEgI9NMk7oY4DUuGhJXOZD9sDsg0H7k1IkGifKhXjEIPwRhp1GmbebZnUImL4M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Hzz8nlVmyy7PAjhq69pYtRrcgA0Kz1NS3Gc_OOtwgGw&oe=6A16E78C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U3fgw3Dl0MQ7kNvwFavAB7&_nc_oc=Adr88lXHp0KhGlt9-DG-XA0GBbxGJLuU7pHCpBN4IZvLCdoK4CBJcvkh9W__gl__0ig&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF9rm243cKmm7G0dp_XxBMf5P3YqUUQoiL9cgClYjjnA&oe=6A4A6BAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KUIlMEdfOcQ7kNvwG3oXSD&_nc_oc=AdpaBqsfrkWcvia_VTsOnhnVxGruxnMmhFVgVDyBpWHL-XroKweNBbB1mKlYkIHMmoY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuf4lkC40S-bxmuW-LvZidPc31Bs7x-8rLCSrRSayRcA&oe=6A4A51ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LljlvjCt6UQ7kNvwHSL-XB&_nc_oc=AdqgxXEoGn-xvs7NNFko05mbxxonpFLEALCTfs_GFkDk8PWxUEHR6S_MhX_VBR6yGr8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTldYcrt0wc47zxerATERY9cKqOx6zf5LKGgniedZ30A&oe=6A4A8239"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBeEuJ137D4Q7kNvwH8ZaNj&_nc_oc=AdpB6re7F6qrJT3jfbbSbS_9zzeK5VIEGcVDJC0bemjT9RVrAKumS0RQ1mJxgdpj8XQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7qs0osMO22cvlr4hlgLao6havxrkK84LDiBeRU9QQaA&oe=6A4A7846"}, {"file_name": "Hero Cover3000x900.png", "id"
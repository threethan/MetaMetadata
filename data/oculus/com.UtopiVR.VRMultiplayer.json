."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dX-SrXSBl1oQ7kNvwGQY02q&_nc_oc=AdrG_TbRBjI2wugVEjFPv9FcYnazBQJSJ1k_r00yDaMXwiB_OlGFVAXs4_zvhcVA2Y4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQegQuzSanUGsz3YFaMiRnZM23HFl4eOFBqCEw6vyn8Ug&oe=6AF5CEAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBufFfJmHmQQ7kNvwELfsDq&_nc_oc=AdoETysDhdZ4xn8Gx-XpwoS_sSxnQj56Fdp_tFLQ0SOB2DlLtoUVG8N6E3YQH46rT2Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmdiMybbQ_x5-4gsjtltvrwO9MAn_3u5dQqtNd4dRc4Q&oe=6AF5ED2D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPTSgug9rSwQ7kNvwF6-UrN&_nc_oc=AdqRiMq_01EoAuGNByWRdsL72zOLuM2mBQJybp2WnBUYmiRMuYf6mC86nx5tiX3ICdQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4tVn80XTKCwbmUMzP1QrKLjg1sQ36Uk8IHrlQsVA2mw&oe=6AF5E539"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hbj103Cg7cQ7kNvwFzTwyJ&_nc_oc=AdpKw8OZwpt1wJY9MfG0WdQvicUwj756_QV5w_M23q_bfFUOMOUou-nsL22sOAG8m9U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTct6AFiQUsyU7_67e7QsCCpQZ5J4IZQUgDVzL9EDZl6w&oe=6AF5DB46"}, {"file_name": "Hero Cover3000x900.png", "id"
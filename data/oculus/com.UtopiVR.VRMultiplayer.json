."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7OzpuEKsfQQ7kNvwFiBbLj&_nc_oc=AdpRFMTMXfz4wWTIke77wvJgGk22CU-u41P5lHIpU_GGv2TJiiKsUz8aeHapX0qt8H0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MBJ0E-A7dZ_56BFi75VFA2_2OZQxEOH8D4bVxbxRCPA&oe=6A300DAF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B73_KE_LTnEQ7kNvwEf3YxD&_nc_oc=AdpIv2UqNIfvVS-4ubfemJCiNw1leSi7noLHWUAFMn0fM23Z4yJtgEgja7u6q4H6zBs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Rd_14xsBB2NMP-rd_9Yc8fMJVmLaQ-zBsXXzPLzsD3Q&oe=6A2FF3ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMrJmPHPqTYQ7kNvwGFC7ov&_nc_oc=AdrRz44ruLEKCKKjuG-LQGVpNqedaeErDrNJhOt_sQ2yckijzJcKZq8_xOEOzwzshco&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8100K_TaPUgVsYCvIY-RsDA6tj6QKS3HrmNpTdEUU8Rw&oe=6A302439"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiOcCJpJ0NEQ7kNvwGbBvie&_nc_oc=AdqSTuiuUX0isbIsQj7noDkvIfP3KkiBviWaM8OSwZ_10t0z0JFSJwSjEMF1AqRvQEI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9jkV5A61xxLITnZ832SdDlD9VDhEl-14jaO7stHf-Gvw&oe=6A301A46"}, {"file_name": "Hero Cover3000x900.png", "id"
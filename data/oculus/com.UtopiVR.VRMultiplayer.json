3_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydHXhZUcnXAQ7kNvwGvNCqN&_nc_oc=AdoX3jVowoCrqojM2p8VVTxSYPQSTByGZ-_uW2P9eIL3OuVb7stcH7AYe9GL-XQ2tcU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RgDc08s3JlLrhwCeMujdWtbqMpdJ-NbmtD8kNxwPn1w&oe=6A15A68E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UGYELnHVn4Q7kNvwE7aJjB&_nc_oc=Adq7PkEPfkT4dNByYG3pmcDAPXii8DgKgko5Ink7c6e3TKfsWp36D7g_7l2H23CBcd4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Wj6FCb6f-WKEZYmo2E5DLtU0EAAroZlvAESYkIptUGw&oe=6A15B699"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIZAm5VF_pAQ7kNvwEdqayC&_nc_oc=AdqcxmiSGAjEUOLfvAuqgy3p2piB3NXHMmx3LRm09Y9nKwIk_vZEkIpPddgqJYIlo9E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HyDhvbyJfQTbhtsBA5ymex3i8m7VYvzAqecwuAs9PWw&oe=6A15960C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, bez granic i z nieog
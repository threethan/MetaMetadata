."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dbrLGeIzXuwQ7kNvwGxiT-S&_nc_oc=AdqU9bhXUv9Vf2M2vkJXM9B-MpiEOslWJad9suaKRKOcCuHwdb4umt_iVcflndvFkWQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBS6SQlHXcfXrxLsVkFosXppnBK6LFJbUFBwrCXWkEkIA&oe=6A58EC2F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abG0Cy2BNJgQ7kNvwGMVO0p&_nc_oc=AdoDbxoISuqt-Xp2kInafqza-wmQouGKudhCNG7E94nfsjNhmqQneTdMdikpswKPGoo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBudFZuG8hnDGqlyjolg5EUM4JVqUkFS2d3c5I4HkCQwg&oe=6A58D26D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tupRY4TOxfwQ7kNvwFokXOE&_nc_oc=Adod5IAIRK54ag6Gy9J-6QMHxZxPGUaIQK6ZmcNJJSUHH9yzCT30v19BxCd-nwJD7os&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj7smcAHYfMgNOiElrYVeM02fJSWKDjWyDD2iUq4S9RA&oe=6A58CA79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsHJfen8ymMQ7kNvwG62Mla&_nc_oc=AdrlNS3L1vt3X8LzDFvItk2vWXXFHxAheApVqijQXR898GUkAsVRo6iougPH36-NwZQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQvDzUKFKxiSgRDJym0QJdY1vSHwd7taa8xzcYm3Z7RA&oe=6A58C086"}, {"file_name": "Hero Cover3000x900.png", "id"
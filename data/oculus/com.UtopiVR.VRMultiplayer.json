."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XlNx7jWgygAQ7kNvwEpifAH&_nc_oc=AdqvzkbWaEdjhv7oqPyyzeeKoU2EApLe25XyL7nLDqT4l6ZpV3-McSenplCBE2bicek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGFDaxEO74BpiHzyniiC3A_e0z8WDfpd1WApJKH2U5Hbw&oe=6A78902F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrtMDtsXhcUQ7kNvwHRknUa&_nc_oc=AdqnMHtSWwc-q4YU_IJeXxiGxNlhsaEjm6E8IjYiiVfw3QkJovd3maWtw2XI0DmqM0Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbbHHt_goHgpVgyUN7T8KH6nWZVgr8gO8CqjnlIqR_pg&oe=6A78766D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaVUkj-aSZYQ7kNvwGoAaZG&_nc_oc=AdoT8A8hV05bRpy8DNcpwzUhaKB1JlRGB0_103dFkEVXE9_uc9vGrFYbUUvpI57Xngw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL6YQ0IrL4qQb0ropsLjeozRKdc1hW33Nunb44glAOvQ&oe=6A786E79"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6UHvldolqh4Q7kNvwF3bAhX&_nc_oc=AdrZdJII1o8HqIFo-fhmmvrYcQJuAR6SvsPFWG1IeWIJjDt46_TK--w1cRhoONaO748&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkJr456FiCggfmB3K6edoRik8j69AYZX1zTQ5PdiDpRw&oe=6A789CC6"}, {"file_name": "Hero Cover3000x900.png", "id"
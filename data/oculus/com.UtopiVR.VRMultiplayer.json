."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujYxEejocrMQ7kNvwGLt2Y6&_nc_oc=AdohN2j5h1_7-24feyHzb41Rx5lggECYeQzUII9MPLD2ArLiXlOfi7jRzu0D82MFQuc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIRdM9d3B8KdIxGJyCBiMFBQJCcm3b0VWtj0ptas2pHw&oe=6A6CB2AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1XSNGvuwTMQ7kNvwFZ65Mt&_nc_oc=Adro6RS5-ZNGECEWeCiwGD3NP-MxjugaWiiryl_JOCz0QEJi56S3EQcOO7gjIXP5SXE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDFUMnWdlBm46EsPymJN-OQunR325RgehAHD4oM5K2Rg&oe=6A6C98ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2-RLBo6YKpoQ7kNvwGc9zAa&_nc_oc=AdpjjikH82ygH3J5Slcs8jlgrJxB0hZL9z_pvS8Tdi5G-jQY2aFoxk_3sZEuNtXcFrQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMPs9X_giD2WQ9M3oxX4vwJZi6xBteoc1NtDe_pc64-w&oe=6A6C90F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHJMi-Zm07YQ7kNvwE4TADH&_nc_oc=Ado1Z8MllZ9r7pQm093te9rBWbmze6L6bv2QX5i8u0KJg9dIGmbiW65Ed7y4mfa6L6U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2j7jCqm57DOFH3klQVWEKXwC3FjFmzXoQT7ZOEcLbUw&oe=6A6CBF46"}, {"file_name": "Hero Cover3000x900.png", "id"
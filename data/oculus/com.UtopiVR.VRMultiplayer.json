."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lVELzaZc2oQ7kNvwE1DE-H&_nc_oc=AdqeAcpzXZrhZ_ak5k7_5JdvzjIxBh9lewKjm4CWynI7uw-jxgd4FrJ9SmcOgTrGtIw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4u5fHy-GpLWqadqTpGMOfmli22IZ9YrJPNgkqF5KnvYw&oe=6A0097AF"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqggTmQ95roQ7kNvwFSqrlv&_nc_oc=AdqvLQ3a7lu3b4hnrQoafgTyb-CRn7znQQrcNklHMYRQyYdfU7YS3cqotSgIQgaiF1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ds-tojXJGm0ILwIMJcQaRPrgueZWW3OilRF2Dr_qW4g&oe=6A007DED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oaIH_hD4jZIQ7kNvwH2zGKy&_nc_oc=AdomUHC0gFKqiPawLlkT_5MFjGPOn2bdI3fCOdF3FdEnZg03Gjf9VXDpdcOqWoMQM6Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DI9B9HRbQBIPyR8-cMC6C6t7YKNZNztWmJDS9C5EVhg&oe=6A0075F9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZOY99wMRcgQ7kNvwHvvh8L&_nc_oc=Ado7zlfK79JWdzJIy24DbD9WtdInxJx2_5V1EJMvrwh6VEmiyUcsUDwDPsxUNdU4isw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6m6AhXJpv-JNmWZA7VOQhuBvfETSLeOmp2tGXkVPfZwA&oe=6A00A446"}, {"file_name": "Hero Cover3000x900.png", "id"
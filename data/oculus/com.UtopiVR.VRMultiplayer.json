771-25/499617693_3696474280655686_1645444672926216909_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2f3aV4MAtYQ7kNvwGSsn7-&_nc_oc=AdrPITugzcAWR3PXdSGh0ak04S2rFwx06phYXYZogTuYTCcTHkVs31a-q6d_BgK8aek&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84v_oO1MIjM-NpfW0tRb34z3KtbFUWIGRL5p64-bdaEg&oe=6A466E0E"}, {"file_name": "Utopi screen 04.png", "id": "2087557138716301", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499303445_2087557142049634_161084464344270592_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2yOu5_E27cQ7kNvwEYEh3D&_nc_oc=AdpLVH0HWksqL51XSqAvz9XCpUyIZCYHJ3UfkTKiHD-1K__H0llYlN3s2Govt-03hu4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nPlY53xrnl-6Xj62BTWajNPRw2wjbM4fG629T5kbAhQ&oe=6A467E19"}, {"file_name": "Utopi screen 05.png", "id": "770795615935155", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617693_770795619268488_5149474149359664309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyfk1LjQOvMQ7kNvwE6RuFQ&_nc_oc=AdpAhnYAj5qOXMKZTMltInLXMjBX-fOE7aDatbT6wjcJq5C26qdf6v5cNPRvmR1XzJI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xjVPRYhMVUCXLqb5iqwCachj1W4adZUus2GVdipGFUg&oe=6A465D8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "uTopiVR", "keywords": [], "long_description": "uTopiVR przenosi pe\u0142ne do\u015bwiadczenie prawdziwej klasy do wirtualnej rzeczywisto\u015bci. Nauczyciele prowadz\u0105 lekcje na \u017cywo, uczniowie wchodz\u0105 w naturaln\u0105 interakcj\u0119, a nauka daje poczucie bycia razem w jednym pomieszczeniu. Aplikacja oferuje interaktywn\u0105 tablic\u0119 do pisania, rysowania i udost\u0119pniania slajd\u00f3w oraz osobiste zeszyty uczni\u00f3w, w kt\u00f3rych tre\u015bci z tablicy mo\u017cna skopiowa\u0107 jednym klikni\u0119ciem. uTopiVR to co\u015b wi\u0119cej ni\u017c zwyk\u0142e zaj\u0119cia online czy gry edukacyjne \u2014 to autentyczna, anga\u017cuj\u0105ca edukacja bez podr\u00f3\u017cy, be
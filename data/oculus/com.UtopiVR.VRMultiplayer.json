."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o84QfcRrbEoQ7kNvwHKWPQ8&_nc_oc=AdqwQar8Giyl8CbidZxuc_n4s6cWKubTk4KGVpWkACnLok7cVqfTgKphCWVnOJXyjXE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQIs1qBzcP9qdEwpuFsftfG8v4dy2-TqGLJ7J1JMI8MA&oe=6A84356F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQmwNeMCVuAQ7kNvwEasyXg&_nc_oc=Adq1jymrq-gqCu5nvF3O-2fWw6yEiSkuYrRDg5teVNphO771LfJNgaqtSsRzOGW8TeE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNwZuUBXah4R35PuMrVZRHpUu6U_9qoEvtP6CnZzNcDw&oe=6A8453ED"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTR4XC67ZWoQ7kNvwEsoS2x&_nc_oc=Adr789iyhulTYL_iLG982GJuzyt9SEYSoZ5iFV7QNPUVRiDwxb4V99Dydkz14JrSguQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDGcOvtQJw1ib_IVTcR0EnXruOqSDjSC4v_vZzcJzc-Q&oe=6A844BF9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxfKpjfeGjwQ7kNvwG10r3A&_nc_oc=AdrrFTJ0vZNziDHqR6oYbr5ks5IVuFBbV8HTjeATiZYh09IDtfSFSKiUNw1gkJSKB-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHstdL0IY5_S413vSohs0UPbeKDjJozjm8we6bmp09M6A&oe=6A844206"}, {"file_name": "Hero Cover3000x900.png", "id"
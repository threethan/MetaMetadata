."}, {"images": {"nodes": [{"file_name": "Landscape2560x1440.png", "id": "2907926936080689", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617698_2907926939414022_765797073903788866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRIYgO6oqnIQ7kNvwEgKA1g&_nc_oc=Adoo-ZMnWE3m6QTukraRxnpflQqs796P67-PguJKM5mP5BS_5OPeaCzkVa4KTSZL_18&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AKf7IZFqkzf1kpgAoVE5lVK_CQfNeJsx9DF2gupojPw&oe=6A34022F"}, {"file_name": "Landscape2560x1440.png", "id": "1863250024613411", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308026_1863250027946744_9021948593827972383_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hx9Z83215pQQ7kNvwHWtmr9&_nc_oc=AdobT-5IQ7b48aqP_DKPxAVDNs3b4MmoqUlNqAm1MdafKa9XtPPsSTcwlL-YNXtbIUI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fXDL4Mp_Vc2YNeCIXG4rIiP-FHs9Q9EU0WC03cU_2FQ&oe=6A33E86D"}, {"file_name": "UtopiLogo.png", "id": "1354178952944489", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499298502_1354178956277822_7078438908620814251_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oY03T2n5leoQ7kNvwHNUOZP&_nc_oc=AdodM3bSEu61_-0uV9hA5XcNsB8CDxPW_sUt3YiY2UKb4h7-cir-o3ThyPqFiLNSW6s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uie-tCVxelmv-kTNxxysqxD9rRxN0gvxY5iuUDkR-UQ&oe=6A3418B9"}, {"file_name": "UtopiLogotrans.png", "id": "1305409841177830", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823878_1305409844511163_1783727567460272720_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iteYfHpIvTwQ7kNvwG6PuOw&_nc_oc=Adoo61cC6DAi3cdMVdpKRqkqzMEBseASKRR9-Ukd5ZPvaZanfrJSF_ZzrTpQe8HNaxY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-OpD9caaBtgXmRWCKd5h-by-hc1Hkd7P6DVET32ycCRw&oe=6A340EC6"}, {"file_name": "Hero Cover3000x900.png", "id"
com&_nc_ss=7f30f&oh=00_AQTfmbJCuIYnfgCmsl91mTeiVTT_Wu-_D9jAf_xwea3GPQ&oe=6B0DBBCD"}, {"file_name": "sklet.png", "id": "901020115794298", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_901020119127631_4395945150363653763_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTr9N2YawzMQ7kNvwGvNdh0&_nc_oc=AdphP8987AWvevshH-sXa31ywL6JAlU-NVlJwyMQdluqGa-eOZ8I8ceHNR1pQfIzVRU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcI4qxUAB8C64Xfo4DtJO0g0k8DOUNwqWlR3OpgYEwzg&oe=6B0DA349"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail-2560x1440.png", "id": "1229421825710723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_1229421829044056_6046627764641539981_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnvCaRZqptoQ7kNvwGTqIuL&_nc_oc=AdohvGNEGLgfHxfvoEfMZSvfhQkGLsa4CoczNiNy98M3r5xavl8B3gcvPNR2_2kKpZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDLxPbIxOiL0Qkb4MVwglGXG6Thy5quOjRD6E7grkd1Q&oe=6B0DB903"}, "display_name": "Dungeon Anomaly Demo", "keywords": ["puzzle", "horror", "anomaly", "exploration", "mini"], "long_description": "This experience is an early demo version of a first-person VR dungeon exploration game.\n\nPlayers explore a mysterious and atmospheric dungeon where the focus is on observation, anomaly detection, and solving small environmental puzzles. Gameplay is intentionally minimal, emphasizing tension, atmosphere, and careful exploration rather than fast-paced action.\n\nThe current build represents an early stage of development. Features, content, and mechanics are subject to change as development continues. Player feedback is highly appreciated and will help shape future updates and improvements.\n\nThis demo is designed to showcase the core concept and mood of the experience while laying the foundation for future expansions.\n", "short_description": "A first-person VR dungeon exploration demo featuring minimal gameplay, anomaly detection, mini puzzles, and a tense atmosphere.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dungeonanomaly/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Solyx Studio", "support_website_url": null, "website_url": "https://solyxstudio.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32944827935165013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823270_1355182255933845_5675133720325471246_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=px-zKXgBoHMQ7kNvwFU5okf&_nc_oc=AdqihM9vcy2oz7TW7nIC_u3SRi2o0MiMOL6WqB3gXdnuEpV1bokU19mauBUg4M_BHxg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR_fR1Lbt__xB8v_d9Mpke6LCByw_cWZOTNh0se3wp6Rg&oe=6B0DC69E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dungeon Anomaly Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1767387480, "lastRevision": {"nodes": [{"id": "32805641835750291", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
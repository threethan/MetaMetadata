63653763_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXGEZhR6jKIQ7kNvwFHmVgW&_nc_oc=Adoh83QbkM7gP7r-aSodcsCqfaEARoOQwItXQad5mr6JH9cFoG5bdF5Xl92gqow385s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES82TOHcQC22vxwiESWilbCh6HnUiDDf6dLQyZ7PK1Lw&oe=6A708889"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail-2560x1440.png", "id": "1229421825710723", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818849_1229421829044056_6046627764641539981_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdPkbo2lwN4Q7kNvwEAv2SR&_nc_oc=AdpSa4hkr293OWe88kajl65xDl3TyFEHRQmGu9bu7CtiHcJFGVDUKLZf4BdJ8ijrU4k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsm5gvzb_OlpQyMc2cq-34t7UxEIp5ZhQ-X-CHetgPxQ&oe=6A709E43"}, "display_name": "Dungeon Anomaly Demo", "keywords": ["puzzle", "horror", "anomaly", "exploration", "mini"], "long_description": "This experience is an early demo version of a first-person VR dungeon exploration game.\n\nPlayers explore a mysterious and atmospheric dungeon where the focus is on observation, anomaly detection, and solving small environmental puzzles. Gameplay is intentionally minimal, emphasizing tension, atmosphere, and careful exploration rather than fast-paced action.\n\nThe current build represents an early stage of development. Features, content, and mechanics are subject to change as development continues. Player feedback is highly appreciated and will help shape future updates and improvements.\n\nThis demo is designed to showcase the core concept and mood of the experience while laying the foundation for future expansions.\n", "short_description": "A first-person VR dungeon exploration demo featuring minimal gameplay, anomaly detection, mini puzzles, and a tense atmosphere.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dungeonanomaly/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Solyx Studio", "support_
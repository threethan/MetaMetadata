dq1ENh356twrS4BPA5yWP_6oFDRFS9AG0FIaZ-0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftlSOr2LX6JXzdPN_gLhbq6gy2C2W5_0DZw_zr_PhjT1Q&oe=69A58189"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail-2560x1440.png", "id": "1229421825710723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818849_1229421829044056_6046627764641539981_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQeqbPQgvvEQ7kNvwHvIcmN&_nc_oc=AdmA_H_bV9ckSSAxqtWByUL12VsVDf1YQtmEPRTKxBSIEOOdOfp1zJfPD7G4OhwN60A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfuHEfKQPvD_11gH5TY8fOMK8p_PEZdPA47StRHU_cId-A&oe=69A59743"}, "display_name": "Dungeon Anomaly Demo", "keywords": ["puzzle", "horror", "anomaly", "exploration", "mini"], "long_description": "This experience is an early demo version of a first-person VR dungeon exploration game.\n\nPlayers explore a mysterious and atmospheric dungeon where the focus is on observation, anomaly detection, and solving small environmental puzzles. Gameplay is intentionally minimal, emphasizing tension, atmosphere, and careful exploration rather than fast-paced action.\n\nThe current build represents an early stage of development. Features, content, and mechanics are subject to change as development continues. Player feedback is highly appreciated and will help shape future updates and improvements.\n\nThis demo is designed to showcase the core concept and mood of the experience while laying the foundation for future expansions.\n", "short_description": "A first-person VR dungeon exploration demo featuring minimal gameplay, anomaly detection, mini puzzles, and a tense atmosphere.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dungeonanomaly/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Solyx Studio", "support_website_url": null, "website_url": "https://solyxstudio.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags":
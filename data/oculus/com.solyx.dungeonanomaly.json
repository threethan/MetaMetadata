nc_sid=6e7a0a&_nc_ohc=3JDj2JIAcacQ7kNvwFqKcwF&_nc_oc=Adn2ITbGdjZ5VECMUzDgy75swSOVfbDmrWt2zCz1mRlsveG3K3swNRGSVBCvB5JKCjs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy7MczZyjXvbIBJkMFHUd8kAaKgcmY285y0xjINXhV-gA&oe=69BA9989"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail-2560x1440.png", "id": "1229421825710723", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818849_1229421829044056_6046627764641539981_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Od4S39WZoy8Q7kNvwHjgyy_&_nc_oc=AdmgTa2_JaCI4l3viyPgMOYk9NMyrLeOw8JTuIFt23MsHoJxme1vhyCEhEAKmLxtW7o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyJgY-GtoV4BglGLatUsVfYrJN9CcXrOS-oRb9-zGEIsA&oe=69BAAF43"}, "display_name": "Dungeon Anomaly Demo", "keywords": ["puzzle", "horror", "anomaly", "exploration", "mini"], "long_description": "This experience is an early demo version of a first-person VR dungeon exploration game.\n\nPlayers explore a mysterious and atmospheric dungeon where the focus is on observation, anomaly detection, and solving small environmental puzzles. Gameplay is intentionally minimal, emphasizing tension, atmosphere, and careful exploration rather than fast-paced action.\n\nThe current build represents an early stage of development. Features, content, and mechanics are subject to change as development continues. Player feedback is highly appreciated and will help shape future updates and improvements.\n\nThis demo is designed to showcase the core concept and mood of the experience while laying the foundation for future expansions.\n", "short_description": "A first-person VR dungeon exploration demo featuring minimal gameplay, anomaly detection, mini puzzles, and a tense atmosphere.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dungeonanomaly/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Solyx Studio", "support_website_url": null, "website_url": "https://
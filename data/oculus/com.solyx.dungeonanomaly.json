com&_nc_ss=7f20f&oh=00_AQR84-KSSP3LApGfxfcm5YeLyTEiVQfK9aN6STMIxUlDpA&oe=6AFF030D"}, {"file_name": "sklet.png", "id": "901020115794298", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491819239_901020119127631_4395945150363653763_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_99ZZb99fQQ7kNvwHS55Qy&_nc_oc=AdpkG2-dz2e-1FggnaS3qIyxkqHnbclIVJEOYwj9eOirYSIotsLfuCkdihFbU33OqZU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR52eSDZsj7-PsJuLTfM1PkanuQqmcFUbrB76D34rI9jQ&oe=6AFF22C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail-2560x1440.png", "id": "1229421825710723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818849_1229421829044056_6046627764641539981_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xKzEmmQz4cQ7kNvwFJZTwz&_nc_oc=Adqqy_Efd1Twog3ljZ5KozzJ8YBbFkt9adAJWpKZIi57H2H893SNntAgw0pdVvIcNII&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPYTFaVICaWTYG-shLuEjD0oDikuj7JxNjNZkV10_LnQ&oe=6AFF0043"}, "display_name": "Dungeon Anomaly Demo", "keywords": ["puzzle", "horror", "anomaly", "exploration", "mini"], "long_description": "This experience is an early demo version of a first-person VR dungeon exploration game.\n\nPlayers explore a mysterious and atmospheric dungeon where the focus is on observation, anomaly detection, and solving small environmental puzzles. Gameplay is intentionally minimal, emphasizing tension, atmosphere, and careful exploration rather than fast-paced action.\n\nThe current build represents an early stage of development. Features, content, and mechanics are subject to change as development continues. Player feedback is highly appreciated and will help shape future updates and improvements.\n\nThis demo is designed to showcase the core concept and mood of the experience while laying the foundation for future expansions.\n", "short_description": "A first-person VR dungeon exploration demo featuring minimal gameplay, anomaly detection, mini puzzles, and a tense atmosphere.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/dungeonanomaly/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "Solyx Studio", "support_website_url": null, "website_url": "https://solyxstudio.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32944827935165013"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823270_1355182255933845_5675133720325471246_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uL8Nq9NImYkQ7kNvwExgOm3&_nc_oc=Adrp9t-ve1CM59veHOAH1N5SZsP1GR9uACWNuWzgSdP6dLRmO-u5uAhQEllJYtbiGzs&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUXgrOFdn0zvclFherXdIHEogdTxHIc8q7Tg_Jmsf-eg&oe=6AFF0DDE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dungeon Anomaly Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1767387480, "lastRevision": {"nodes": [{"id": "32805641835750291", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
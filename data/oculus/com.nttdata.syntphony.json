ess support spaces\nBusiness-specific connected process for employees, associates and other collaborators (e.g. onboarding, support)", "short_description": "The purpose of Syntphony Immersive Experiences is to help top level organizations to provide large-scale engaging immersive experiences either to their customers or to their employees by providing an enterprise-level extended reality platform."}]}, "developer_name": null, "developer_privacy_policy_url": "https://trustcenter.syntphony.com/products/immersive-experiences/privacy/meta-privacy-notice", "developer_terms_of_service_url": null, "publisher_name": "NTT DATA Spain, S.L.U.", "support_website_url": null, "website_url": "https://naka.syntphony.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9816705648417782"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473393841_1340091210348358_6999397752953950849_n.png?stp=dst-png_s360x360&_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65SHReF7xwAQ7kNvwF0Ja_3&_nc_oc=AdoTNC9vbEUQZ2ohz8LFxVHEDrPY4xjOB7ouIX6C5kg_tZXEmnL1LR2I6ve7dnxCB2k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIYXi8qQ8S0i5TP-eGmRpkRxNkxqbEv8HDcmdhCAt1QQ&oe=6AFDDF12"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Syntphony | Immersive E
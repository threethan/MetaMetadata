8vfg&oe=6A8459DE"}, {"file_name": "Harvest_2025-08-09_18-02-55 - Copy.png", "id": "785947880629278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307479_785947883962611_5711614899637360126_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7guKpD8obUQ7kNvwE_t4vB&_nc_oc=AdpQEHaGCg8mZPu3DT02DG8wAAVVXAJsgfvZN1jlZ01WauPL7h4Y070NSgTV6j-lBiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmsbkWUeuXBvQKb1ntTAhZzPzakegynC_riO5XQdCOVw&oe=6A844716"}, {"file_name": "Harvest_2025-08-09_18-03-53 - Copy.png", "id": "2246161835846915", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827277_2246161839180248_3146232929423072659_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsloMAn5oEMQ7kNvwFUtPuV&_nc_oc=Adqo1AFvuXu3erryRK-TI7Z1FKYClaGUx_9vo_dgzj0Cp6sYrf0_KeOR5yfNGJHsnrs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs6_fJSrST26ljZsUs3olqFYXNMjzXNinR_XIA9nRqUA&oe=6A84582F"}, {"file_name": "Harvest_2025-08-09_18-02-38 - Copy.png", "id": "1208249147997269", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820382_1208249151330602_6132495508164050382_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gca95BmtzckQ7kNvwFGx_j4&_nc_oc=AdqiPN2V1a_RyoNKiG0aa_2P_8AfPRaugEBkyKqOLXDY3SzSm5O4HhVkkgGRaarOJjk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVJJU1AW_AmkHrSaseVpNrM8xhmqQfd0-LSAQdY-I-9g&oe=6A84680E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rusty Robots: The Harvest", "keywords": ["horror", "survival", "social", "multiplayer", "casual"], "long_description": "**Rusty Robots: The Harvest** (or simply *Harvest*) takes place in the distant future. Play with your friends across more than **8 freeplay maps**, including **Outside**, **Forest**, **the Backrooms**, **the Bedroom**, **OG**, **the Robo Shop**, **the Robo Gallery**, **the Arcade**, and **Rising Lava**.\n\nThe game also features **22 cosmetics** that can be purchased with in-game currency. Players receive **100 currency** each day they log in. The Robo Shop includes hats, masks, skins, holdables, and more.\n\nIf freeplay is not your style, try the **story mode**. In story mode, you play as a sentient robot known as **the Unit**. Your mission is to explore a once-familiar testing facility, now overrun by humans after robots were harvested for their resources during a global shortage. Will you reclaim the facility and escape with your life, or will you be harvested like the rest of your kind? The full story mode is still in development, but the current levels are available to try.\n\nWhatever your style, this game is a great place to socialize with friends and enjoy **\"endless fun\"**. Expect updates periodically, though progress may slow during school.\n\n*Love you!*", "short_description": "Rusty Robots: The Harvest, or Harvest for short, takes place in the distant future. Play with your friends in over 8 freeplay maps with over 20 cosmetics to spice up your look! There are several minigames to play, too! If playing with friends isn\u2019t your vibe, indulge in the story mode chambers, with 7-8 planned for the future. More info in the full description.\n"}]}, "developer_name": "Nicktender", "developer_privacy_policy_url": "https://blackdiamondsword9.wixsite.com/robotg", "developer_terms_of_service_url": null, "publisher_name": "Rusted Games", "support_website_url": null, "website_url": "https://blackdiamondsword9.wixsite.com/robotg", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "s
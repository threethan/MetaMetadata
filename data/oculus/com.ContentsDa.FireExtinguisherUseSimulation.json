i": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618252_904894585367429_8106817442076789903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=86rD8yF6HmMQ7kNvwEqbspM&_nc_oc=AdmMiaDfKnmUhV_Q-_BCsWa3-I3yEToBh5SDB2wQqjqz7fhB3aVfHt2niZkPImrak4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyrq9B3_rt2edCBUA6q5et1UMeqkh5z1eXmpOxQ2yQIMw&oe=69BEA4B6"}, "display_name": "Fire Extinguisher Use Simulation", "keywords": ["safety", "extinguisher", "fire", "simulation", "contentsda"], "long_description": "1. Get a fire extinguisher: Grab a working fire extinguisher from the fire extinguisher rack on the right. Check the green color of the pressure gauge to determine if it's working.\n2. Prepare to use the extinguisher: When a fire occurs, pull out the safety pin on the handle, hold the hose toward the fire, squeeze the handle, and spray toward the fire.\n3. Use a safe position: Stand with your back to the wind, or if indoors, with your back to the door.\n4. Use a throwing extinguisher: If the fire starts again, try using a throwing extinguisher to put it out.", "short_description": "Master the use of fire extinguishers through virtual training. Learn about different types of fires and the appropriate extinguishing methods."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
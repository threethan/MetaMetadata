1.oculuscdn.com/v/t64.5771-25/499619588_1232183661905562_586071002215126225_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JvQtB9JGlqEQ7kNvwFMSTqR&_nc_oc=Adm5DPgpOiIuCvhF72UERgdwiAfjlTZLClgc9XX_atmzzEofI_w83UFNrzdgJVN8_q0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftyezQnZ6lwC_IfZojp0rTvon7QYC8FEyQi1QtJzJaewA&oe=69A82626"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_2560x1440-Trailor_\ubcf5\uc0ac\ubcf8-001.png", "id": "904894582034096", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618252_904894585367429_8106817442076789903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsMbSl3vYU0Q7kNvwHJSlbO&_nc_oc=Adnk41OBSBw8t6wqPn2gSHrFHzjztRC7Rxr9deKoher8bb2ciKA_rxKaO9dfNLyxcpQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsUfIyGEMKJcVbW5C0Di3naAqUs5Tol8u41lV8smCEbsw&oe=69A83B36"}, "display_name": "Fire Extinguisher Use Simulation", "keywords": ["safety", "extinguisher", "fire", "simulation", "contentsda"], "long_description": "1. Get a fire extinguisher: Grab a working fire extinguisher from the fire extinguisher rack on the right. Check the green color of the pressure gauge to determine if it's working.\n2. Prepare to use the extinguisher: When a fire occurs, pull out the safety pin on the handle, hold the hose toward the fire, squeeze the handle, and spray toward the fire.\n3. Use a safe position: Stand with your back to the wind, or if indoors, with your back to the door.\n4. Use a throwing extinguisher: If the fire starts again, try using a throwing extinguisher to put it out.", "short_description": "Master the use of fire extinguishers through virtual training. Learn about different types of fires and the appropriate extinguishing methods."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_web
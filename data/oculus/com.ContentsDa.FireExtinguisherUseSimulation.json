-7&_nc_sid=6e7a0a&_nc_ohc=BfiJiZE17TIQ7kNvwEAiwN-&_nc_oc=Adkz6YY7Gs15gdwrS1INXC_D8nigPv12zOwVvamBAFSB7A7sJmZuDft9q-pO9JQKxKA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzH5JeZT1irIQvdSZQ4sRmdaeT_cZSieFsmricxl7_paA&oe=69BC01B6"}, "display_name": "Fire Extinguisher Use Simulation", "keywords": ["safety", "extinguisher", "fire", "simulation", "contentsda"], "long_description": "1. Get a fire extinguisher: Grab a working fire extinguisher from the fire extinguisher rack on the right. Check the green color of the pressure gauge to determine if it's working.\n2. Prepare to use the extinguisher: When a fire occurs, pull out the safety pin on the handle, hold the hose toward the fire, squeeze the handle, and spray toward the fire.\n3. Use a safe position: Stand with your back to the wind, or if indoors, with your back to the door.\n4. Use a throwing extinguisher: If the fire starts again, try using a throwing extinguisher to put it out.", "short_description": "Master the use of fire extinguishers through virtual training. Learn about different types of fires and the appropriate extinguishing methods."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["S
jA&oe=69AC1F69"}, {"file_name": "ApplicationFrameHost_48IWNEnzJ6.png", "id": "1232183658572229", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619588_1232183661905562_586071002215126225_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtAa0S443ngQ7kNvwHD_IYs&_nc_oc=AdkB9F2ElAntmZe52TD2eQ7xGIG1h3wXK_J4ISiCw_rTVnR1suF092E48XKyhU5nptc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzokmfY0ob1UhPI-XZfHGDiORKHssvIQExYARTJ3_nX_g&oe=69AC1AA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1_2560x1440-Trailor_\ubcf5\uc0ac\ubcf8-001.png", "id": "904894582034096", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618252_904894585367429_8106817442076789903_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k7tEWWQSHL0Q7kNvwEQwHsM&_nc_oc=Admptq1WJwlsk1LvKO7z8wiqbtXp55Bw43ioqPHlgb67u-h4dXzq2e2clr_DZ54jpEk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwLJ_wl4Nhy2lfc9LINT4dqlSpMGtWNLoa59vfBfykzyw&oe=69AC2FB6"}, "display_name": "Fire Extinguisher Use Simulation", "keywords": ["safety", "extinguisher", "fire", "simulation", "contentsda"], "long_description": "1. Get a fire extinguisher: Grab a working fire extinguisher from the fire extinguisher rack on the right. Check the green color of the pressure gauge to determine if it's working.\n2. Prepare to use the extinguisher: When a fire occurs, pull out the safety pin on the handle, hold the hose toward the fire, squeeze the handle, and spray toward the fire.\n3. Use a safe position: Stand with your back to the wind, or if indoors, with your back to the door.\n4. Use a throwing extinguisher: If the fire starts again, try using a throwing extinguisher to put it out.", "short_description": "Master the use of fire extinguishers through virtual training. Learn about different types of fires and the appropriate extinguishing methods."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_ter
2511_5930742839648481253_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlmy37GM7v4Q7kNvwFg-u4l&_nc_oc=AdobWC3wo4oN4rBSh-3Vh5KZDZ7_fXrTbkYUCv9wBywpbkPvDGVF2odb40jaQpbzVBY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRzD0yDy0hqkiMVmfrs5ts4mdKBZE7Qot0Wd8LViMOxmA&oe=6B0DC600"}, {"file_name": "2.png", "id": "2145441929682027", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596061819_2145441933015360_4937299183028552339_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWqaompG3VMQ7kNvwGCyhAj&_nc_oc=Adojc_5PnYGGFdseK61cZaACNRmy9kLqUwivQHX_rHEwjYF3SoXtLD4CnJus2KbK4Bs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQbnM6ZdqcIPNWxElSy8V6VzGkPXYrDa1keBNMRy12GLw&oe=6B0DA4B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aanand", "keywords": ["Devotional", "Spiritual", "Meditation", "Temple"], "long_description": "Anand is an immersive Virtual Reality platform designed to bring devotional and spiritual experiences to life. Explore sacred environments, devotional stories, temples, spiritual journeys, and immersive experiences in VR. Anand allows users to select the devotional experience they wish to explore and step into an engaging virtual environment designed to create a sense of presence, peace, and connection. With immersive 3D environments, visual storytelling, spatial experiences, and interactive elements, Anand provides a unique way to experience devotion through Virtual Reality. Choose an experience, put on your VR headset, and begin your immersive spiritual journey with Anand.", "short_description": "Experience devotion like never before with Anand, an immersive VR platform featuring spiritual and devotional experiences that transport you into sacred environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VBGroup", "
2511_5930742839648481253_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1au8GooNr4Q7kNvwEesrYt&_nc_oc=Adqr77_D0HP9t-IdakfuSDMWLygd4Tx7eXKZK6rbSK0WGPS4Hv7DoJhE4kOoChAz0sw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSMff4d2tGviYfhJTU3Y-Ass3gI_yooUOx0QUnSOmMRlg&oe=6B005EC0"}, {"file_name": "2.png", "id": "2145441929682027", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596061819_2145441933015360_4937299183028552339_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6UKd8ZoSfgQ7kNvwHx_guv&_nc_oc=AdpR8wv0KNVhVqu_v2C1FoD2VJ4OjVuAEtjaov6hO0ZQW_Wq-q6mp_xL5fKANDQMGCw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKaREYTCF3EBR4qm1_2FA50e8QB7fhPZTC9J54j4d4BQ&oe=6B0075B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aanand", "keywords": ["Devotional", "Spiritual", "Meditation", "Temple"], "long_description": "Anand is an immersive Virtual Reality platform designed to bring devotional and spiritual experiences to life. Explore sacred environments, devotional stories, temples, spiritual journeys, and immersive experiences in VR. Anand allows users to select the devotional experience they wish to explore and step into an engaging virtual environment designed to create a sense of presence, peace, and connection. With immersive 3D environments, visual storytelling, spatial experiences, and interactive elements, Anand provides a unique way to experience devotion through Virtual Reality. Choose an experience, put on your VR headset, and begin your immersive spiritual journey with Anand.", "short_description": "Experience devotion like never before with Anand, an immersive VR platform featuring spiritual and devotional experiences that transport you into sacred environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VBGroup", "
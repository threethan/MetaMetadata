2511_5930742839648481253_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-NQcarxmaAQ7kNvwHJRypK&_nc_oc=AdrD4oqvXwdrjV36z8aomVK1qNUZ8CbH81LoASc-WSt1Vpsw_cA4hkpQqDjBMF---s4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTA1aGxx5cc87gW9FjvAQVcz7s2v_Xflr9TSm61aPQZOQ&oe=6B0301C0"}, {"file_name": "2.png", "id": "2145441929682027", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/596061819_2145441933015360_4937299183028552339_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lJVrm1VEIQQ7kNvwHicYKi&_nc_oc=AdpanClDXieEGD6XqLbZEa_mbTLwrkhAOXXtBSePiCcHcHG0TanFdiYC0pMqTJ0k2Qg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAYOz8nKh8MlIP0_f6o3fVMev_EhFlSQMRMDYogPyjPA&oe=6B0318B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aanand", "keywords": ["Devotional", "Spiritual", "Meditation", "Temple"], "long_description": "Anand is an immersive Virtual Reality platform designed to bring devotional and spiritual experiences to life. Explore sacred environments, devotional stories, temples, spiritual journeys, and immersive experiences in VR. Anand allows users to select the devotional experience they wish to explore and step into an engaging virtual environment designed to create a sense of presence, peace, and connection. With immersive 3D environments, visual storytelling, spatial experiences, and interactive elements, Anand provides a unique way to experience devotion through Virtual Reality. Choose an experience, put on your VR headset, and begin your immersive spiritual journey with Anand.", "short_description": "Experience devotion like never before with Anand, an immersive VR platform featuring spiritual and devotional experiences that transport you into sacred environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VBGroup", "
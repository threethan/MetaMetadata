2511_5930742839648481253_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=od8JBrnjUrIQ7kNvwFXqxEf&_nc_oc=Ado8MvrGRi8esYB2BGsEkLnlcjzcgPk66qIzWpk0TP8RmZpcidgsHxNa_CzgT7yd7j4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0PWAauuPoHkT6S8hlb8AW7P6av9DEpvvpBJCT9-3dwA&oe=6B0847C0"}, {"file_name": "2.png", "id": "2145441929682027", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/596061819_2145441933015360_4937299183028552339_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvgiZ1TxmlYQ7kNvwHIv378&_nc_oc=AdpPOzthg08IUhNE2BVPPyGQr_a6l8B6SIv4qfcXe406czzU0lWDKbovefahoTCMZ18&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdZpMEtlGWJAVTfB0trmFsGTKY8Tp8GQE7gKmxDk2W-g&oe=6B085EB2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aanand", "keywords": ["Devotional", "Spiritual", "Meditation", "Temple"], "long_description": "Anand is an immersive Virtual Reality platform designed to bring devotional and spiritual experiences to life. Explore sacred environments, devotional stories, temples, spiritual journeys, and immersive experiences in VR. Anand allows users to select the devotional experience they wish to explore and step into an engaging virtual environment designed to create a sense of presence, peace, and connection. With immersive 3D environments, visual storytelling, spatial experiences, and interactive elements, Anand provides a unique way to experience devotion through Virtual Reality. Choose an experience, put on your VR headset, and begin your immersive spiritual journey with Anand.", "short_description": "Experience devotion like never before with Anand, an immersive VR platform featuring spiritual and devotional experiences that transport you into sacred environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VBGroup", "
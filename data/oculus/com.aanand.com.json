=00_AQQSomK1RLQiXdY8NNljm1aY7_OmPORkqi91ceM-g13ZKg&oe=6AF08CC0"}, {"file_name": "2.png", "id": "2145441929682027", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596061819_2145441933015360_4937299183028552339_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmFUfZMa4lkQ7kNvwEYjJq0&_nc_oc=Adp0ElmyGArMTpuo8EMxaMqAUBDLXpmdHbAfR7is_0OG2-3Ijzoy7ENlglRFX62cjzE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyQx_MeN_LG5fwIA4Yx1ydKQ4l5byar2UfVABcQ8cVsQ&oe=6AF0A3B2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aanand", "keywords": ["Devotional", "Spiritual", "Meditation", "Temple"], "long_description": "Anand is an immersive Virtual Reality platform designed to bring devotional and spiritual experiences to life. Explore sacred environments, devotional stories, temples, spiritual journeys, and immersive experiences in VR. Anand allows users to select the devotional experience they wish to explore and step into an engaging virtual environment designed to create a sense of presence, peace, and connection. With immersive 3D environments, visual storytelling, spatial experiences, and interactive elements, Anand provides a unique way to experience devotion through Virtual Reality. Choose an experience, put on your VR headset, and begin your immersive spiritual journey with Anand.", "short_description": "Experience devotion like never before with Anand, an immersive VR platform featuring spiritual and devotional experiences that transport you into sacred environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VBGroup", "support_website_url": null, "website_url": "https://vbmetaverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_sub
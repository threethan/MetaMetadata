2511_5930742839648481253_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=od8JBrnjUrIQ7kNvwF686TB&_nc_oc=AdqWhzNwdo1PrMmK9LPdKJnDRxS7_ZipjCN1EUjjvDM2xrnHhn3WCwZ2zOl6aXLvePY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq0MoyVILt5i1WP3crmGogBsxwpiFndoLY5ecbr9V3IQ&oe=6B06F640"}, {"file_name": "2.png", "id": "2145441929682027", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596061819_2145441933015360_4937299183028552339_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvgiZ1TxmlYQ7kNvwHQXI8D&_nc_oc=AdqFOAc8PRmY8v691i0-BlVeB_F-3z__5aj1RsYtBFBRim57ZFCySykqNLUnZuWIRzI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4EZl-Dahmf8hrGkOruuV-GwrIsoxBtW31TOB6V0qPfg&oe=6B070D32"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Aanand", "keywords": ["Devotional", "Spiritual", "Meditation", "Temple"], "long_description": "Anand is an immersive Virtual Reality platform designed to bring devotional and spiritual experiences to life. Explore sacred environments, devotional stories, temples, spiritual journeys, and immersive experiences in VR. Anand allows users to select the devotional experience they wish to explore and step into an engaging virtual environment designed to create a sense of presence, peace, and connection. With immersive 3D environments, visual storytelling, spatial experiences, and interactive elements, Anand provides a unique way to experience devotion through Virtual Reality. Choose an experience, put on your VR headset, and begin your immersive spiritual journey with Anand.", "short_description": "Experience devotion like never before with Anand, an immersive VR platform featuring spiritual and devotional experiences that transport you into sacred environments."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VBGroup", "
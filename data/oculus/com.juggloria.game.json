uoI2XPtDIJz1J8XnNJl-A4RFfcYGgoZj3BaGEXPyruU5qVozZGQjDwet6k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfCovYw_3FtZvkCXzBf7TawKGSuxUCy4PHFlx8Pzwd1w&oe=6AFB17BC"}, {"file_name": "02_targets.png", "id": "2099933584224626", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821704_2099933587557959_4731969059934694696_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iozknHvV-W8Q7kNvwHPZfx2&_nc_oc=AdqLyi15glhIIE6t3Zo8EzAPLtlssWwNrrbUbvldS5hgz-dfEJJUhuCJxnyxzKdBCQU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZdmn5natwN5RakLOCScZWztmJ7Ow9onf3WvtQzy_5hg&oe=6AFB3BDB"}, {"file_name": "04_balance.png", "id": "909780701924223", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825470_909780705257556_354509401826435697_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-c1sFXY0J0Q7kNvwG5Qkko&_nc_oc=AdopaxsfVO6p8EThCP4PhLlgiaFkQV7V3OnB7jgv-ArsHMU-0DcA9QlmZEBgV5f_t6U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScVKe5tvs7UDCea-T_EXd_3C_aDxebgC2KuGTNGEgyag&oe=6AFB3ABC"}, {"file_name": "03_delivery.png", "id": "1590940665743577", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827567_1590940679076909_8443899207458813194_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcX61wewNJEQ7kNvwHDE78n&_nc_oc=Adomnmepcl3RZF2bQrLUIlXJWSTrjFMuGDhdyNmeEJvkKwyJKQUWzzXZP1NmeZ4fWpI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShnnVSPPtGvcV5KTjShBCjCUAKXUZhwy35iJ3jl84xfQ&oe=6AFB4331"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Cover.png", "id": "1963343697691471", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491824328_1963343701024804_3904691966524617049_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30gNHF13y-8Q7kNvwHCvCei&_nc_oc=AdqcCaT_vnlmm-3xTfXGmeqs0p-RxgRcnLWUKxOZNrkDFPDQU-hY94r1Sp7dAL9cbDM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToZgaJ07BKlCxnIW96cxScPK7Fnk2d4-6nQjQoAbD2Kg&oe=6AFB27E7"}, "display_name": "Juggloria", "keywords": [], "long_description": "Welcome to Juggloria, a vibrant virtual reality circus where every throw, catch, and carefully timed move brings you closer to becoming the star of the show.\n\nPut your coordination and accuracy to the test across six varied circus acts. Send objects through rings, strike numbered targets, complete fast-paced deliveries, overcome maze-like challenges, maintain your balance, and develop your juggling skills in a responsive, physics-driven arena.\n\nStart with training and practice modes to learn each activity without pressure. When you are ready, enter the career experience, improve your scores, earn medals, unlock new challenges, and track your recent performances. Multiple difficulty options let you develop at your own pace while still giving experienced players a demanding skill challenge.\n\nJuggloria is designed for single-player play and supports both seated and standing experiences. Comfort and accessibility options include turning preferences, adjustable game speed, text sizing, contrast settings, subtitles, controller-hand selection, audio controls, vibration controls, and height calibration.\n\nTake your place beneath the circus lights, master every act, and give the audience a performance to remember.", "short_description": "Step into the spotlight in Juggloria, a colorful single-player VR circus challenge built around skill, timing, and precision. Juggle, throw through rings, strike targets, complete deliveries, solve movement challenges, and test your balance across six distinct acts. Practice freely, build your career, earn medals, and become the star of the show."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/juggloria/ana-sayfa", "developer_terms_of_service_url": null, "publisher_name": "ComeChi", "support_website_url": null, "website_url": 
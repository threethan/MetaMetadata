978", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499308125_1854275358775311_3999254360938578070_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZdeH-9fD0QQ7kNvwFa_PRV&_nc_oc=Adr6yJ44WufnTmNWTaU9WqGRayXqTn6cyc3LK_0Rnkw2LcMv8JNRK6Pht3p37Qime6w&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISf5NwI8xA7mUqceqTTiDB06ZJkHdpYKCrL_xHaqaL2g&oe=6AA9437D"}, {"file_name": "Soon (8).png", "id": "24361929886827918", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620860_24361929900161250_5046335894950625423_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjDuUOU9OcMQ7kNvwFyaUl2&_nc_oc=AdqAnQq0_5v3dAWD4WxSZzE5LBvmAyDg6peQHGhGuhFbX07jPPps22cBoYxb_Y5cGag&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLLKV0IxI1ih8xO_Al7dSnJqVFt0khQPUvTEO5TqkEuw&oe=6AA94A71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bluddle", "keywords": ["Free", "Multiplayer", "Garden", "Animal", "Simulator"], "long_description": "Welcome to Bluddle! Bluddle is a VR game first of its time to make an egg hatching and pet growing game. Play with up to 4 people in a lobby and show off you pets!\n\nHow to play:\nBuy an egg from shop\nPlace the egg in your assigned plot\nWait for the egg to hatch and wait to see what pet you get\nwhen hatched you can see what pet you got\nthe pet will then dig up items\ngo to the sell stand to sell your items and or pets\nshow off your rare pets and items to friends \nRemember, Have fun!\n\nBe sure to stay safe online and follow the rules.\nBe kind to others and do not hack, mod, disrupt, hurt, and ruin Bluddle.\n", "short_description": "Welcome to Bluddle! Bluddle is a VR game first of its time to make an egg hatching and pet growing game. Play with up to 4 people in a lobby and show off you pets!\n\nHow to play:\nBuy an egg from shop\nPlace the egg in your assigned plot\nWait for the egg to hatch and wait to see what pet you get\nwhen hatched you can see what pet you got\nthe pet will then dig up items\ngo to the sell stand to sell your items and or pets\nshow off your rare pets and items to friends \nRemember, Have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bluddlepp/home", "developer_terms_of_service_url": null, "publisher_name": "Zane2evil", "support_website_url": null, "website_url": "https://sites.google.com/view/bluddle/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24019776421056050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499312649_1044566697421684_2815457992646543352_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5CCD7QsmeIQ7kNvwGVqFG7&_nc_oc=Adpd00MmXlorFVH2fR0oLuNL7Td49OlBUS-3Kip9ojpxaTW6-uy7ihJ_RsYxh8SwUA4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS7KHJg_NbCOxjSA2fBw-KAXUtDA2Pp3P-i_3FsFERBQ&oe=6AA96854"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bluddle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1755712860, "lastRevision": {"nodes": [{"id": "9980269338766661", "release_type
ot\nthe pet will then dig up items\ngo to the sell stand to sell your items and or pets\nshow off your rare pets and items to friends \nRemember, Have fun!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bluddlepp/home", "developer_terms_of_service_url": null, "publisher_name": "Zane2evil", "support_website_url": null, "website_url": "https://sites.google.com/view/bluddle/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24019776421056050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499312649_1044566697421684_2815457992646543352_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4olAmz6fMjcQ7kNvwEQP5CE&_nc_oc=Adosb5rlBq_H3BJXVFt5C2JbE1qxwMyWJVxVG46dR5ZoIQsB-5W-D7WdjjbSlm6xOok&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyrem4RhV3gvkOT21pJ11oT7za9udrouTq3-IAFwkn1Q&oe=6A8ED214"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Bluddle", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 1755712860, "lastRevision": {"nodes": [{"id": "9980269338766661", "
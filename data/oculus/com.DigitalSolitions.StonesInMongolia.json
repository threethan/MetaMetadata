.com&_nc_ss=7f20f&oh=00_AQKN2qeq-SEufj9NTzDMnVBueQrHOEm_m7d4cOa3AfsaTw&oe=6AA158BE"}, {"file_name": "3.png", "id": "1219593709822020", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473391887_1219593713155353_510970325031866808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUZyPBCTmHgQ7kNvwHi9Ipq&_nc_oc=AdrzKMwDaT1Tx4xMKwtWBarP2RSmPQ5EgVGI2Mf-vd663RTui5o4AQPMIeJFtAfmwME&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLto8dp9UT4ypiyYFUuz7wtCi_kDqpy9v4I4hhsDAmmQA&oe=6AA17409"}, {"file_name": "4.png", "id": "3909705529341795", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824583_3909705532675128_3263692379501154714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH-bl_tISUwQ7kNvwFViHaw&_nc_oc=AdqWd5lC1rvAP5ZhWU2HOojQQvMUkFWGxkUKuMv3AKhG7NX-pBH6oe9dPLfyBoXxWk8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeDgRX7i7zgf8eYemc-bj9AetA99mAJRPmpYwqXDQ9vA&oe=6AA15ABA"}, {"file_name": "5.png", "id": "3928600934122853", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/473392175_3928600940789519_588506163522189863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Sxl4jgQ-dwQ7kNvwFWnJFW&_nc_oc=AdqaxESXY-ixynBjYmAlCFQTn2oVNRmiZfXdF0SqFgB7SKSoQ5xiwL8YJLxW_CSRcLA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg80svnK2c_KSEAzA-Me_NXf_rQEuud43MAhwzcYoHXA&oe=6AA16813"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Monuments of Mongolia", "keywords": [], "long_description": "Enter a world of timeless monuments that reveal the story of a powerful and enduring civilization. These sites\u2014ranging from mysterious stone figures and sacred sanctuaries to the remnants of grand imperial cities\u2014stand as lasting symbols of human belief, resilience, and artistic expression. Crafted over centuries, each structure reflects a deep connection to heritage and purpose, carrying the echoes of leaders, visionaries, and communities who shaped their world through ritual, craftsmanship, and innovation. These landmarks are more than silent stone and wood; they are storytellers in their own right, whispering legends, honoring ancestors, and preserving the memory of a way of life that continues to inspire. Explore each monument to uncover the values, aspirations, and timeless spirit of a people whose legacy still stands tall.", "short_description": "Discover timeless monuments that echo centuries of history, spirituality, and artistry. From majestic stone structures to sacred temples, each site reveals a powerful legacy shaped by tradition, belief, and human ingenuity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24819473201028352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824583_1858444391620058_485974472394305354_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rke66SKlRrgQ7kNvwFzwcbk&_nc_oc=Adq_xU_w-_hUaLm8JFjPX-iU8tdnnVSap5dbrzQEeNnuFbofC6oJSdDoJxjR8RfBfzQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzuZ2f_4QM1z8hSTwmpuOpd5SxDyme2NdBARpSnJDO6g&oe=6AA17F05"}, "
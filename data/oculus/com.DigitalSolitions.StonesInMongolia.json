.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKBXRCxMjS015sPlUcYwRchGRRSGWX7S2Gb5Pue2plhQ&oe=6AA941BE"}, {"file_name": "3.png", "id": "1219593709822020", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473391887_1219593713155353_510970325031866808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xSa5odCDzaoQ7kNvwHolP48&_nc_oc=AdqVxs8jGnuGgt8Oaj1tsUXtZMR9As8v8-7bgGsBttgOtSu8s5CmHZgpyn8PDzb8Fh8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2JMBDWYy626AdNUq6LpqDmD0mwFBe7MiPmA-EVN-0IA&oe=6AA95D09"}, {"file_name": "4.png", "id": "3909705529341795", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491824583_3909705532675128_3263692379501154714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozcjagx7ogAQ7kNvwGy-Ts8&_nc_oc=Adoyrqi7B_nxTe-QR5UIiidnpcmjvtLO0YdIDxmqv9HjLq-r41a0-ASSErut-yUNoE4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_n_FJTyqcu7UiGJkvAnmCKxvAanVg2vcJLdfPEAfJbg&oe=6AA943BA"}, {"file_name": "5.png", "id": "3928600934122853", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/473392175_3928600940789519_588506163522189863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZN0Zi4XoxicQ7kNvwHz9m6Z&_nc_oc=AdoFf3osuaQuOd0bca_KqWlckQpxss6nRpzb07g8qSfiFene7LrFi8g0V29a1Lbrb98&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEWz3h13HX6eW9fQViffE7VPVFWyA3k_b2h7FOj1ZSsw&oe=6AA95113"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Monuments of Mongolia", "keywords": [], "long_description": "Enter a world of timeless monuments that reveal the story of a powerful and enduring civilization. These sites\u2014ranging from mysterious stone figures and sacred sanctuaries to the remnants of grand imperial cities\u2014stand as lasting symbols of human belief, resilience, and artistic expression. Crafted over centuries, each structure reflects a deep connection to heritage and purpose, carrying the echoes of leaders, visionaries, and communities who shaped their world through ritual, craftsmanship, and innovation. These landmarks are more than silent stone and wood; they are storytellers in their own right, whispering legends, honoring ancestors, and preserving the memory of a way of life that continues to inspire. Explore each monument to uncover the values, aspirations, and timeless spirit of a people whose legacy still stands tall.", "short_description": "Discover timeless monuments that echo centuries of history, spirituality, and artistry. From majestic stone structures to sacred temples, each site reveals a powerful legacy shaped by tradition, belief, and human ingenuity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24819473201028352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491824583_1858444391620058_485974472394305354_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGvg1iLTIxMQ7kNvwHdnqhb&_nc_oc=AdoX7uRzf9__9xsynvnTZ_4Xd-wZyOoQ6tCnaX1yv6InNUmd9iGEVgmrPTngcgYZ3dQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbH3si2HHX_axbDCx8SPYtlwJz6PQ6XEYNmmvx8-27Jw&
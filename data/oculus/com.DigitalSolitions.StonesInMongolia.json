nt-ord5-1.oculuscdn.com/v/t64.5771-25/473391887_1219593713155353_510970325031866808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mkOUPCcvp8Q7kNvwFeoTX8&_nc_oc=AdmNnYPasAYVvDdqSs_BnL626UPHzvEe2FgteMnRWf-6yEruUQ_iDyyRkdtd188TGMU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzjld1rlOmOz41_2Z1MVx9nZ-JrcZmhCCFxuckE-52oaA&oe=69AC04C9"}, {"file_name": "4.png", "id": "3909705529341795", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824583_3909705532675128_3263692379501154714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Jkmt6kukGcQ7kNvwE8kj9s&_nc_oc=AdkeHFiJqttQTFK2OZYY7-a-c3WWVdd7sN_ec026Z6xp4Cs9P6MxNqQmgzykz8HDLQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwdJ9NyMl8-brB1jkqSO1M1eeYFwkePogFQTL4QpMaNCg&oe=69AC23BA"}, {"file_name": "5.png", "id": "3928600934122853", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392175_3928600940789519_588506163522189863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAcUMdfIlzAQ7kNvwFe0wuw&_nc_oc=AdmXwF9sp0GWtEWYIQHbumYKhegysY9xUBgVlm5XqNSNX4E3qGyW2bYhlOF54BXGd6E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLjVevV2qXVXUWYbE0RfSC13168Oq5QfdTirNA1eDQgw&oe=69AC3113"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Monuments of Mongolia", "keywords": [], "long_description": "Enter a world of timeless monuments that reveal the story of a powerful and enduring civilization. These sites\u2014ranging from mysterious stone figures and sacred sanctuaries to the remnants of grand imperial cities\u2014stand as lasting symbols of human belief, resilience, and artistic expression. Crafted over centuries, each structure reflects a deep connection to heritage and purpose, carrying the echoes of leaders, visionaries, and communities who shaped their world through ritual, craftsmanship, and innovation. These landmarks are more than silent stone and wood; they are storytellers in their own right, whispering legends, honoring ancestors, and preserving the memory of a way of life that continues to inspire. Explore each monument to uncover the values, aspirations, and timeless spirit of a people whose legacy still stands tall.", "short_description": "Discover timeless monuments that echo centuries of history, spirituality, and artistry. From majestic stone structures to sacred temples, each site reveals a powerful legacy shaped by tradition, belief, and human ingenuity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24819473201028352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824583_1858444391620058_485974472394305354_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIbeKtRogzwQ7kNvwEusCwj&_nc_oc=Adk58xAYi-dX3Q6rFPjHHqF2iyHJqyaPfejwhv434lWwiSiVRziZ22ALXS7sw_rstAI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRCFkBG37MWdofHX_FDgreqjYPK_pKYWEcpsIkV2o74w&oe=69AC0FC5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Monuments of Mongolia", "platform": "ANDROID_6DOF", "context_category": {"context_c
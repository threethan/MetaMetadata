nt-ams2-1.oculuscdn.com/v/t64.5771-25/473391887_1219593713155353_510970325031866808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WpnhC7mkcYIQ7kNvwHcw7Zq&_nc_oc=AdluIjWL3tdgyfDwHwOQYXcEkwiOts6ITFcfJtIhiB1Sy9hn_w6zwK-TrLu-5e4_qWs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOHbKiu-kl5AszJ6xhrrn4p3VWGAaNDwSGObABxk3vNQ&oe=69AD5649"}, {"file_name": "4.png", "id": "3909705529341795", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824583_3909705532675128_3263692379501154714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Jkmt6kukGcQ7kNvwGKTvUf&_nc_oc=AdnL7KCzhs_Cr54UbaNvkFI11f4Te8muC4r8ncQVz8hOipfquuDoXmrrfoUzkHj--1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJPywOBBwRSCc4gcM18OGUVZ19Cn7fb2LOV7WyloxvPg&oe=69AD753A"}, {"file_name": "5.png", "id": "3928600934122853", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473392175_3928600940789519_588506163522189863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAcUMdfIlzAQ7kNvwGTFH_l&_nc_oc=Admj-vnC2MJVqmggMnDw3v8LgKz7pTd_8lZhWObcMjv1dBOzllmKVsYYi4aNfnitb5c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyH3N7xznaEYKaq0hzTu4dYPSYAsX3F5cFVq0Z6LTEKWA&oe=69AD8293"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Monuments of Mongolia", "keywords": [], "long_description": "Enter a world of timeless monuments that reveal the story of a powerful and enduring civilization. These sites\u2014ranging from mysterious stone figures and sacred sanctuaries to the remnants of grand imperial cities\u2014stand as lasting symbols of human belief, resilience, and artistic expression. Crafted over centuries, each structure reflects a deep connection to heritage and purpose, carrying the echoes of leaders, visionaries, and communities who shaped their world through ritual, craftsmanship, and innovation. These landmarks are more than silent stone and wood; they are storytellers in their own right, whispering legends, honoring ancestors, and preserving the memory of a way of life that continues to inspire. Explore each monument to uncover the values, aspirations, and timeless spirit of a people whose legacy still stands tall.", "short_description": "Discover timeless monuments that echo centuries of history, spirituality, and artistry. From majestic stone structures to sacred temples, each site reveals a powerful legacy shaped by tradition, belief, and human ingenuity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24819473201028352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824583_1858444391620058_485974472394305354_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIbeKtRogzwQ7kNvwGHR4zG&_nc_oc=Adm79dPjLhTF-Vn1cYRVXXhADiEJsKyGQJLBs-P8W5jS87V1jut0nf0-I_dWDAwMs7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3LckyITpBD_DEwJRwMNAmqmxsAv8Fr5RzPPy5RvdNUQ&oe=69AD6145"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Monuments of Mongolia", "platform": "ANDROID_6DOF", "context_category": {"context_c
.com&_nc_ss=7f20f&oh=00_AQQ5HzqJbupk6JiDB2f8hW-rlHkXOLOwWRB5w8LGq-FWnw&oe=6AF1FC7E"}, {"file_name": "3.png", "id": "1219593709822020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391887_1219593713155353_510970325031866808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gc7-iTAMrtgQ7kNvwGhDDW7&_nc_oc=AdpuxvTDRoB9b0IpDOuyEZRefXLlzEXc40NHQfll1gohP9AXxoGz94YFo5_vJpyi-RA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3gV8PZO3NRRLgTlNm1amJ8qFbwO8xlE-wcabimGI2sA&oe=6AF1DF89"}, {"file_name": "4.png", "id": "3909705529341795", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824583_3909705532675128_3263692379501154714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_vTQvF5A5QQ7kNvwFAO9Pp&_nc_oc=AdqoYo13uXIT6vdn3XPf8VOTzU4368LeaKK_sacSt930spQPEQGOIvNURfbe-nnvJJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdPzAxgEJLidHRJnQhVUh9qk8zU0WpbNOvPtoZou_Dbw&oe=6AF1FE7A"}, {"file_name": "5.png", "id": "3928600934122853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_3928600940789519_588506163522189863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQseuHlUhLEQ7kNvwHVHVzW&_nc_oc=AdrsCa7J3kd0Z203w1cDba_P_R7wu58YsKYO0NxyZim1qTMBXHnniXxwq57ZcyloIfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRX38QDKLpqt9n4lsNYy-qWNA_n1LBcNfRUY7uTjz8ZOQ&oe=6AF1D393"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Monuments of Mongolia", "keywords": [], "long_description": "Enter a world of timeless monuments that reveal the story of a powerful and enduring civilization. These sites\u2014ranging from mysterious stone figures and sacred sanctuaries to the remnants of grand imperial cities\u2014stand as lasting symbols of human belief, resilience, and artistic expression. Crafted over centuries, each structure reflects a deep connection to heritage and purpose, carrying the echoes of leaders, visionaries, and communities who shaped their world through ritual, craftsmanship, and innovation. These landmarks are more than silent stone and wood; they are storytellers in their own right, whispering legends, honoring ancestors, and preserving the memory of a way of life that continues to inspire. Explore each monument to uncover the values, aspirations, and timeless spirit of a people whose legacy still stands tall.", "short_description": "Discover timeless monuments that echo centuries of history, spirituality, and artistry. From majestic stone structures to sacred temples, each site reveals a powerful legacy shaped by tradition, belief, and human ingenuity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24819473201028352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824583_1858444391620058_485974472394305354_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zeiTWR3rZWMQ7kNvwFS0R2d&_nc_oc=AdqRUAB_HBcmKK2S_nbHW39-22tDcsIg8_zccA1p-BiQLguGVqMUI-D6mZ0ATmp_zYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNYxlSsPcAwpindaUN2ggOES7pcl4gzWX1YVqXOy1xuQ&oe=6AF1EA85"}, "
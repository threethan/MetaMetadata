nt-sjc6-1.oculuscdn.com/v/t64.5771-25/473391887_1219593713155353_510970325031866808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKhSemI6rj4Q7kNvwFip1_k&_nc_oc=AdnfNL26XR7qNACd0Nmy6nNH6u7TdAI14GiMoQgdUEH0k_UsWC1ZvAG2yUVPRAVaswg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsyR3Up0qSxRHls2DDeSSXQAA8lEm1s2B_x2LOUqtP9Q&oe=69B14AC9"}, {"file_name": "4.png", "id": "3909705529341795", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824583_3909705532675128_3263692379501154714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=puUwGaDZRXAQ7kNvwE3KNh1&_nc_oc=Admsypm5cO2vUAcDIVYnF4g4CUs-xPH6n0ci4AFi_maB_Q_o84bpObV-SVg2b2naIig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzccXsQ7y7Ekn92uZktSx4o62kHcit8gpULTZeXfCD8sg&oe=69B169BA"}, {"file_name": "5.png", "id": "3928600934122853", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473392175_3928600940789519_588506163522189863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8PQ1gfGT5cQ7kNvwGhvLim&_nc_oc=AdmMVdrYupYxHcMt2kSNbyDlUKr4YyvNZuSqRF5T00ddmnTjkoWSw0CGwta0a5H1azI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzsio5IoALwRJhHMPzP33gzp7aWHI4G2zctNG2fxvMLow&oe=69B17713"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Monuments of Mongolia", "keywords": [], "long_description": "Enter a world of timeless monuments that reveal the story of a powerful and enduring civilization. These sites\u2014ranging from mysterious stone figures and sacred sanctuaries to the remnants of grand imperial cities\u2014stand as lasting symbols of human belief, resilience, and artistic expression. Crafted over centuries, each structure reflects a deep connection to heritage and purpose, carrying the echoes of leaders, visionaries, and communities who shaped their world through ritual, craftsmanship, and innovation. These landmarks are more than silent stone and wood; they are storytellers in their own right, whispering legends, honoring ancestors, and preserving the memory of a way of life that continues to inspire. Explore each monument to uncover the values, aspirations, and timeless spirit of a people whose legacy still stands tall.", "short_description": "Discover timeless monuments that echo centuries of history, spirituality, and artistry. From majestic stone structures to sacred temples, each site reveals a powerful legacy shaped by tradition, belief, and human ingenuity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24819473201028352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824583_1858444391620058_485974472394305354_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=byYLDDMBuGsQ7kNvwF-WvQ7&_nc_oc=AdkM-_1uwuQpqmbDtBcqxgzZEKXT4V2WNkOlGxLTQP43149yGQ9VIuTMkuGmS-OqQM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyesDk_9wnBInLZvVXRYtTCi6L8S4nyBQbNTJ5xfwD5EQ&oe=69B155C5"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Monuments of Mongolia", "platform": "ANDROID_6DOF", "context_category": {"context_c
9822020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391887_1219593713155353_510970325031866808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xXluyO-Ah4Q7kNvwGqy2lN&_nc_oc=AdqSvD67RmwK3Ci3XxyzKDsm9J-tWUWgqK3M_n_o4tXZ6vPt24hTqEISyowm19vlBMo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCx-OXVN3NXAhXvTcDXgAwBquYcamfPRcUB_3OpsKgOrA&oe=6A677209"}, {"file_name": "4.png", "id": "3909705529341795", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824583_3909705532675128_3263692379501154714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Cq9yg8CWMYQ7kNvwGIEGFN&_nc_oc=Adp4xiSt6OTfOfHI4Vw0He-yF8vWINGcus16U1Y7L7mhtK_DPk-EdTRg3XYiLckPfmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQvmdXeXBGcUc0PiT0tfX7I7P1OPh9TCvguKbLs_fZPQ&oe=6A6758BA"}, {"file_name": "5.png", "id": "3928600934122853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_3928600940789519_588506163522189863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXgb8z0qyJcQ7kNvwG_u6cK&_nc_oc=Adpa1li5B4Thv3ImRuldP55YVKHHF580zB3ijwgONghkWXW3JhbZjJrLHB12n9Eod7E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG5FQk8_Nl7P856BYEjjnNKj5U96phyOvQqKtv3id1PA&oe=6A676613"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Monuments of Mongolia", "keywords": [], "long_description": "Enter a world of timeless monuments that reveal the story of a powerful and enduring civilization. These sites\u2014ranging from mysterious stone figures and sacred sanctuaries to the remnants of grand imperial cities\u2014stand as lasting symbols of human belief, resilience, and artistic expression. Crafted over centuries, each structure reflects a deep connection to heritage and purpose, carrying the echoes of leaders, visionaries, and communities who shaped their world through ritual, craftsmanship, and innovation. These landmarks are more than silent stone and wood; they are storytellers in their o
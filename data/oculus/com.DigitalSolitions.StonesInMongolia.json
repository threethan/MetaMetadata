HcyUwF_cRLdQ_T1m5WGnXMNi_lKOtCF4ze740SuM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsvRMWyMH3UVjbzsITS8T1pr2Hp98ElIa9XBVTixLgP0w&oe=6999ACBE"}, {"file_name": "3.png", "id": "1219593709822020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391887_1219593713155353_510970325031866808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZVpgmr-iyYQ7kNvwGtYQi2&_nc_oc=Adm8Wahehi0_zsZ0FEbdSa1IpUgm0bf2FVo7ogAtGH6H9w6Uz5a1_yg6sxhXVM2FjIE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvvQEmPMpYHtw-DZbbEbKMjcywRP0pvxXSt2D6TFAr6ew&oe=69998FC9"}, {"file_name": "4.png", "id": "3909705529341795", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824583_3909705532675128_3263692379501154714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87yjA0BayqsQ7kNvwFNPAKm&_nc_oc=Adlnc2o2q8fmkgiwEmG2k4mlwT_7twg3vV1ZVCkfsuM_Et_Pxx9y7ntW6FFMxHYGq8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudaA_8CLtHEx16OEWSxqczSGa1rnc9cAzHs7jSYSSwoA&oe=6999AEBA"}, {"file_name": "5.png", "id": "3928600934122853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_3928600940789519_588506163522189863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ql6hXl_jnS8Q7kNvwFI8UOT&_nc_oc=AdnDF2WvUH_STeXQfIvk8HYBatm1NiiBHRzLE5Squc0caTNCKeh3Ji4MMVzceLOqWig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuupS-cBAi_q8UOWkmLu5fz9Lt__H77Gy4q9t6fcWQYQA&oe=6999BC13"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Monuments of Mongolia", "keywords": [], "long_description": "Enter a world of timeless monuments that reveal the story of a powerful and enduring civilization. These sites\u2014ranging from mysterious stone figures and sacred sanctuaries to the remnants of grand imperial cities\u2014stand as lasting symbols of human belief, resilience, and artistic expression. Crafted over centuries, each structure reflects a deep connection to heritage and purpose, carrying the echoes of leaders, visionaries, and communities who shaped their world through ritual, craftsmanship, and innovation. These landmarks are more than silent stone and wood; they are storytellers in their own right, whispering legends, honoring ancestors, and preserving the memory of a way of life that continues to inspire. Explore each monument to uncover the values, aspirations, and timeless spirit of a people whose legacy still stands tall.", "short_description": "Discover timeless monuments that echo centuries of history, spirituality, and artistry. From majestic stone structures to sacred temples, each site reveals a powerful legacy shaped by tradition, belief, and human ingenuity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24819473201028352"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1677292349573584"}]}, "baseline_offer": {"id": "1677292349573584"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1758974100, "status": "PUBLISHED", "id": "1677292349573584"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24819546591021013", "
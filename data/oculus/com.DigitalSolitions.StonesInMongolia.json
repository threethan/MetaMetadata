.com&_nc_ss=7f20f&oh=00_AQLhghW7Xl3v5jUPLsdCsI-KSz_irzF_81SqMcDY58Eh5w&oe=6AA2AA3E"}, {"file_name": "3.png", "id": "1219593709822020", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473391887_1219593713155353_510970325031866808_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Tp3_eKzuvYQ7kNvwEpdjqf&_nc_oc=Adq9sbIcmiRL28dbfi0x9EM0p3iGTdUg9ruT5qu5OhWcl-EKmRjGlXgTXWQQCi4o6dc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJi24OKuUy4IGp0CJx72B4h3lY97kieU_PZnyeoVZKQtA&oe=6AA2C589"}, {"file_name": "4.png", "id": "3909705529341795", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824583_3909705532675128_3263692379501154714_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DH-bl_tISUwQ7kNvwErlH2i&_nc_oc=AdoRcDkKiDdXGHL8m74Onqcv1te5WfUj6Cpb82UjtUatHafxyJVcIKwOWFyQ_ReCnXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXCKZqXzJj3Pn8K8g_q2B8nEk3pk5botpd-7cCbOyp8A&oe=6AA2AC3A"}, {"file_name": "5.png", "id": "3928600934122853", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473392175_3928600940789519_588506163522189863_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Sxl4jgQ-dwQ7kNvwHq0cuk&_nc_oc=Adra829vpLBF8pV1Ir7cPqtvkPUx2RucX3MZCccXmY85MD-JZOUkB62KlaTAy9AR2CQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJP15fCtQ50lNfcyZ8Bzucmg84YyzBf9nVyjTbqk0SmBA&oe=6AA2B993"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Monuments of Mongolia", "keywords": [], "long_description": "Enter a world of timeless monuments that reveal the story of a powerful and enduring civilization. These sites\u2014ranging from mysterious stone figures and sacred sanctuaries to the remnants of grand imperial cities\u2014stand as lasting symbols of human belief, resilience, and artistic expression. Crafted over centuries, each structure reflects a deep connection to heritage and purpose, carrying the echoes of leaders, visionaries, and communities who shaped their world through ritual, craftsmanship, and innovation. These landmarks are more than silent stone and wood; they are storytellers in their own right, whispering legends, honoring ancestors, and preserving the memory of a way of life that continues to inspire. Explore each monument to uncover the values, aspirations, and timeless spirit of a people whose legacy still stands tall.", "short_description": "Discover timeless monuments that echo centuries of history, spirituality, and artistry. From majestic stone structures to sacred temples, each site reveals a powerful legacy shaped by tradition, belief, and human ingenuity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://digitalsolutions.mn/policy.html", "developer_terms_of_service_url": null, "publisher_name": "Digital Solutions VR", "support_website_url": null, "website_url": "https://digitalsolutions.mn/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["mn"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24819473201028352"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824583_1858444391620058_485974472394305354_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rke66SKlRrgQ7kNvwEufCYP&_nc_oc=AdrTA8g_PlyUO7RL4OycKmGVh-ZGiiPWoXyhX3rTCwSMMSr6nn38R_Zc6drtdczw7O8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHeA96eme0sDD-AIvW5GCNGmloR2TL-08uzLAC60JbBQ&oe=6AA2D085"}, "
ent-iad3-2.oculuscdn.com/v/t64.5771-25/499311537_1099405485136712_8487006464356831985_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_xPpOEHOWAQ7kNvwGiDjDR&_nc_oc=AdlI2oBexrxpk38WVPXrYggWaVzzgFcgtAxGfFy1VDud9DQqv3ofUoa9ZlcEglrJ3yY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvFwfZjaCGQOkAIU15dxuMraNHN6RGqyPDjnW-0JHXnRw&oe=6999A544"}, "display_name": "The Amygdala Protocol", "keywords": ["Horror", "Psychological", "Survival", "Mystery", "Detective"], "long_description": "Welcome to the Crestwood Institute.\n\nYou are a private detective, hired to do the impossible: find the celebrated neurologist Dr. Elias Thorne, who vanished inside the walls of his own abandoned children's hospital. You are not the first to try. You must be the last to succeed.\n\nStep into the decaying halls of an institution that once promised hope but delivered only misery. What you find is not a simple missing persons case, but a dark conspiracy centered around a forgotten child and a monstrously unethical experiment. They called it The Amygdala Protocol. You'll call it a nightmare.\n\nForced to confront a terrifying supernatural entity born from trauma and unethical science, you must use your wits to piece together the clues, solve environmental puzzles, and hide from a presence that knows you are there. She is not just a ghost; she is a result. And she is not alone.\n\nUncover the truth, but do not let it consume you.\nKey Features:\nFirst-Person Psychological Horror\nInvestigative Gameplay\nHide and Survive\nA Story-Rich Mystery\nDynamic Entity\n\nPsychological Horror, Horror, First-Person, Detective, Mystery, Investigation, Atmospheric, Story Rich, Supernatural, Survival Horror\n", "short_description": "A private detective is sent to the abandoned Crestwood Institute to find a missing doctor. But inside its decaying halls, a horrifying scientific legacy waits for him. Investigate a decades-old tragedy and confront the entity born from a monstrous experiment known only as... The Amygdala Protocol."}]}, "developer_name": null, "developer_privacy_policy_url": "https://titanzgamez.blogspot.com/2025/09/privacy-policy-for-titanz-games-last.html", "developer_terms_of_service_url": null, "publisher_name": "TitanzGames", "support_website_url": null, "website_url": "https://titanzgamez.blogspot.com/2025/09/privacy-policy-for-titanz-games-last.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING", "OCULUS_TOUCH", "TRACKED_KEYBOARD"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9090419221082758"}}]}, "scheduled_offers": {"count": 17, "nodes": [{"status": "PENDING", "id": "973230272034837"}, {"status": "PUBLISHED", "id": "1430750468399644"}, {"status": "PUBLISHED", "id": "1577533050157281"}, {"status": "PUBLISHED", "id": "1440056230795121"}, {"status": "PUBLISHED", "id": "1404933221000143"}, {"status": "PUBLISHED", "id": "1927896068134583"}, {"status": "PUBLISHED", "id": "695021070158708"}, {"status": "PUBLISHED", "id": "2199300920564052"}, {"status": "PUBLISHED", "id": "1375597430960596"}, {"status": "PUBLISHED", "id": "1385139290067894"}, {"status": "PUBLISHED", "id": "1230940949092625"}, {"status": "PUBLISHED", "id": "1736717543493030"}, {"status": "PUBLISHED", "id": "1436939594060694"}, {"status": "PUBLISHED", "id": "685208187945018"}, {"status": "PUBLISHED", "id": "683323618106104"}, {"status": "PUBLISHED", "i
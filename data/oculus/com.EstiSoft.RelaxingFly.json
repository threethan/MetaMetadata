fLBFOFRbWaL2rgyGwKapA3WQrLBIGe3DvyTorL2ydxaUh71oE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tT-HILdAFCH-3HnrdzpYVRRWmJqsPxFTtaDlcULEHDg&oe=6A19B9CF"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-09 130334.png", "id": "649648331234851", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823281_649648334568184_6621274621149346023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gAcKzXo6axoQ7kNvwEP-gcQ&_nc_oc=AdqIX01PyNvk17a5GXNa9XJXIgd7Xu8weiWDdOIBsrMF4txSCAGyGSU8TZSWRpMFRwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LmQEL6xyiVFmNvDnzUKAc1Cn0LchNj_1mPiqJQKPAhA&oe=6A19902C"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-09 130214.png", "id": "884332730502268", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821580_884332733835601_1752669689253215686_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oYrZ5-XaHgQ7kNvwGlCzuw&_nc_oc=AdpF95RWs5YeClenLCrv3qeN5u2EbHdagPAgZNJDdqf_r8oHfBGf2H1bz8NHEekB64o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BCx1HSggLkny5uEnXKZp9v_mKztNMwq2A2wl682d-AQ&oe=6A19A599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-09 130214.png", "id": "1071243114819656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393669_1071243118152989_7972799590512901973_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZwBaRpWBZeIQ7kNvwFukHFS&_nc_oc=AdrhUbNVNLtqV_hwRwLqFy2gy97VvfuC9-A1LZV4bErf2-3A1NAcGymPUlkmG9xJ4LU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GmbPVaxk8b6X5twlCpKE_3K0Y6QSd9WO4rV5N_JvQBQ&oe=6A19A6C3"}, "display_name": "Relaxing Fly", "keywords": [], "long_description": "Soar through the skies in Relaxing Fly, a calming VR flight experience that puts you in the wings of a majestic eagle. Fly across vast mountain ranges, through glowing energy rings, and along serene valley paths, all beautifully rendered to immerse you in nature's wonder. With intuitive controls and no combat or time limits, the game is perfect for relaxation, stress relief, or simply enjoying the freedom of flight. Whether you're weaving through enchanted skies or gliding peacefully toward the horizon, every moment in Relaxing Fly is crafted to help you unwind and reconnect with a sense of calm. Ideal for all ages, this VR experience is not about winning\u2014it's about flying free.", "short_description": "Relaxing Fly lets you soar like an eagle through breathtaking mountain valleys and glowing portals. Feel the freedom of flight in immersive VR as you explore peaceful skies, dodge through rings, and enjoy stunning landscapes. Designed to calm your mind and elevate your senses, this relaxing experience is perfect for players of all ages seeking a serene escape in the skies."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29527676116880468"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1002954769079085"}, {"status": "PUBLISHED", "id": "1393824885086743"}, {"status": "PUBLISHED", "id
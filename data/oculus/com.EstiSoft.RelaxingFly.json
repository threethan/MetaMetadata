-25/473391806_1202344994947888_637173086244729868_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enYGBlDvUMgQ7kNvwE5cc1u&_nc_oc=AdmztYPO4Lse1jVFJCUnI6QIm7xCu8alVYe8yI-I9PVyCKvTFQzHIDSLbqjNIGK6lW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs0NVsKdxJjLG5OoKpPL6FfvZrN_f2AX0QLjLj1gRWS5Q&oe=699D9206"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-09 130317.png", "id": "982486940365886", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824324_982486943699219_6397691831629601720_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JoaLCV6TtfcQ7kNvwGJWd2Z&_nc_oc=Adm918nFbG-gMujX0g65plceo0WYQQztIPPyIpzwtPN9SvQC-7ps_pDsk86Zr_jx7rE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftboY68sCnNyuPnY56Bioup1fXsIxS-U9xtVMubynuQ3w&oe=699DAE3F"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-09 130237.png", "id": "1976291746234638", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393177_1976291752901304_3273178365412721577_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBKWXxp5P-wQ7kNvwHV1MyD&_nc_oc=AdnM_POt0InGZGjOh1y_Egww_Jqv3bC_2GJvpQ1pGzIh35LkiaugzTwb3uUz0QPoUcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftBJIr1CJuElv080lhc3cLEOm9lEfDI-dPDJqwGEftMmQ&oe=699D948F"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-09 130334.png", "id": "649648331234851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823281_649648334568184_6621274621149346023_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uURnxmC55sQ7kNvwGHmdCe&_nc_oc=AdlcRiSkE0_gPTexiDcJvOm7_q3T0vBgGrnXGOw9NQkq76x2qGrWaHsh_4LgJYyeZJo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsOIt6j6f7qiVdozE-aU4XQBRiiR4r6X4fRa844EePatg&oe=699DA32C"}, {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-09 130214.png", "id": "884332730502268", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821580_884332733835601_1752669689253215686_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbGlbpP4NSUQ7kNvwE2y8L9&_nc_oc=AdkI0B8S1_tHcVN_uQPXrkYcMptU_TNXWa9mL2m9eNNZXxhsTDwzmdFBg0--LuJaNvc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu_G5dLTJg6uc3C-wmCQe6Qcx9d1-mXpaQx6DLUh5qQYA&oe=699D8059"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-09 130214.png", "id": "1071243114819656", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393669_1071243118152989_7972799590512901973_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpMU46dgoasQ7kNvwElSRWZ&_nc_oc=AdmuPNvIB8hQ77EDdrVB9t69ympie9yjODZK7uEqeIl1NaZ-hl3nKo33gx9-T72GM3k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsPKass0xDU_zM-MJ63lrHYKJ9epPOCFmY4VKzYkqQxKw&oe=699D8183"}, "display_name": "Relaxing Fly", "keywords": [], "long_description": "Soar through the skies in Relaxing Fly, a calming VR flight experience that puts you in the wings of a majestic eagle. Fly across vast mountain ranges, through glowing energy rings, and along serene valley paths, all beautifully rendered to immerse you in nature's wonder. With intuitive controls and no combat or time limits, the game is perfect for relaxation, stress relief, or simply enjoying the freedom of flight. Whether you're weaving through enchanted skies or gliding peacefully toward the horizon, every moment in Relaxing Fly is crafted to help you unwind and reconnect with a sense of calm. Ideal for all ages, this VR experience is not about winning\u2014it's about flying free.", "short_description": "Relaxing Fly lets you soar like an eagle through breathtaking mountain valleys and glowing portals. Feel the freedom of flight in immersive VR as you explore peaceful skies, dodge through rings, and enjoy stunning landscapes. Designed to calm your mind and elevate your senses, this relaxing experience is perfect for players of all ages seeking a serene escape in the skies."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29527676116880468"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824301_710311551526979_1171717525708937841_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtsUiIXLoyQQ7kNvwFTOvG7&_nc_oc=AdnMCn7wOmm6bLGpgAElsZQMWo2iMmr4CmW6bnMRZ6auCyf1s1eA-dCf-3zIa6gisUw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs6OsHzQhRYWQopLA0VaR_Hn8iFsm_C1lyurm83qS2B0g&oe=699DB560"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Relaxing Fly", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1747224240, "lastRevision": {"nodes": [{"id": "29527676170213796", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "29527676100213803", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "589578660213489"}, "iarc_email": null, "msrp": null, "transl
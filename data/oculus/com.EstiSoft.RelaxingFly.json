3"}, "display_name": "Relaxing Fly", "keywords": [], "long_description": "Soar through the skies in Relaxing Fly, a calming VR flight experience that puts you in the wings of a majestic eagle. Fly across vast mountain ranges, through glowing energy rings, and along serene valley paths, all beautifully rendered to immerse you in nature's wonder. With intuitive controls and no combat or time limits, the game is perfect for relaxation, stress relief, or simply enjoying the freedom of flight. Whether you're weaving through enchanted skies or gliding peacefully toward the horizon, every moment in Relaxing Fly is crafted to help you unwind and reconnect with a sense of calm. Ideal for all ages, this VR experience is not about winning\u2014it's about flying free.", "short_description": "Relaxing Fly lets you soar like an eagle through breathtaking mountain valleys and glowing portals. Feel the freedom of flight in immersive VR as you explore peaceful skies, dodge through rings, and enjoy stunning landscapes. Designed to calm your mind and elevate your senses, this relaxing experience is perfect for players of all ages seeking a serene escape in the skies."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_
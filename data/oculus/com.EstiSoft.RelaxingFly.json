_oc=AdktPmEqlwuAsrOvMiaiEl5pZmKpYj1oHXVjQZI-aLnWuni1C7HFB2So1dA2kgsBdXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv3meK6yGJC8wEMAh9nS0_HGZc_BFBToII5tNc1g9GnKQ&oe=69A45019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-05-09 130214.png", "id": "1071243114819656", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473393669_1071243118152989_7972799590512901973_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oWyAMeGxSBYQ7kNvwH8dDV-&_nc_oc=AdkeGFZ00ajr3OCovcAFfHd0YzD0466pGuk2LZtBObjvehQuUxnb4B9aYS00z17jVBw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuyOYMhuodTlHa50CP0EZHj6BMQYcGTNp3q_gj434xrtg&oe=69A45143"}, "display_name": "Relaxing Fly", "keywords": [], "long_description": "Soar through the skies in Relaxing Fly, a calming VR flight experience that puts you in the wings of a majestic eagle. Fly across vast mountain ranges, through glowing energy rings, and along serene valley paths, all beautifully rendered to immerse you in nature's wonder. With intuitive controls and no combat or time limits, the game is perfect for relaxation, stress relief, or simply enjoying the freedom of flight. Whether you're weaving through enchanted skies or gliding peacefully toward the horizon, every moment in Relaxing Fly is crafted to help you unwind and reconnect with a sense of calm. Ideal for all ages, this VR experience is not about winning\u2014it's about flying free.", "short_description": "Relaxing Fly lets you soar like an eagle through breathtaking mountain valleys and glowing portals. Feel the freedom of flight in immersive VR as you explore peaceful skies, dodge through rings, and enjoy stunning landscapes. Designed to calm your mind and elevate your senses, this relaxing experience is perfect for players of all ages seeking a serene escape in the skies."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["ROOM_SCALE", "SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29527676116880468"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824301_710311551526979_1171717525708937841_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmmQvQKpJNUQ7kNvwHwDao9&_nc_oc=AdlpkxR3swxcklL1_m-pi29YdH1YH1Y0MyisZyDRoAXO063W_nFayGuReFBvQjly-rM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftjxP5pkmTR7S0fJy2Ha2T26kFQlMh1BxiG5TNZItelPg&oe=69A44CE0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Relaxing Fly", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1747224240, "lastRevision": {"nodes": [{"id": "29527676170213796", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "29527676100213803", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "589578660213489"}, "iarc_email": null, "msrp": null, "transl
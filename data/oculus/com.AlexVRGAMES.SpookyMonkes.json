j&_nc_oc=Adq0sVnmnubfbIVThI58dF9q7Wk0RDD9bFttNas43exNwUF_voke4ZrNxxzh27Yo8QQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBLGzMh5w4geqBHlcaKsKFmymiiA2iPFXNkCmCtDVt9Q&oe=6A882F09"}, {"file_name": "Untitled (19).png", "id": "1234911801451981", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499296039_1234911808118647_2593510906285837941_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5zDomEo7S4Q7kNvwF0eYa9&_nc_oc=AdoqtO9Gj5M_tAnPxDb_TXkPrwGeOQ_2sduey4niS9E2GBTZZG_tsIcNHQS2zwbEICA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBWTweZrRl308jeK0FQQ0TZNed-SPu0jooraruYXNLpg&oe=6A8842AF"}, {"file_name": "Untitled (20).png", "id": "1245559177154930", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499303746_1245559180488263_193013781294779519_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CW3qGi58eQoQ7kNvwEW01Dt&_nc_oc=AdogSUBVKqlhbLIKzBJXBuFcYcT2uvks7UkLNQmV4m7a4CYgb28IUUcC5i4A8deKUGs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHu33keWBa-GGuFKv1Kv2JhYhtpX6ytcI_FUb4LcEpgKw&oe=6A881F95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Monkes (GET V2)", "keywords": ["Scary", "Ominous", "Spooky", "Fear", "Horror"], "long_description": "Survival is a climb.\n\nIn Spooky Monkes, you\u2019re not just running \u2014 you're being hunted.\n\nSet in an eerie, abandoned facility map cloaked in fog and mystery, this game pushes the limits of what VR horror can feel like. Use your parkour skills to escape, hide, and outmaneuver monstrous entities that stalk your every move. With no weapons and no second chances, every branch, wall, and cave becomes a tool \u2014 or a trap.\n\n\ud83d\udd26 Key Features:\n\nMultiplayer or solo horror gameplay\n\nDynamic jumpscares & AI predator movement\n\nPlayable with the physics of Gorilla Tag\n\nAre you fast enough to survive? Or will the facility claim another victim?", "short_description": "Enter the darkness of the facility in this Spooky Monkes. Run, climb, and survive as you're hunted by something that knows the map better than you do. No guns. No safety. Just you and your fear.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/spookymonkes/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AlexVRGAMES", "support_website_url": null, "website_url": "https://sites.google.com/view/spookymonkes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24294420920210125"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/507817984_1266558008416498_7864552655583204502_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOqK-TBXkxcQ7kNvwHS_i-p&_nc_oc=AdrZ0a8XlwA9X3-eWgQHiXucKYbW4lBalk2lqqvqlaYOmZDAGkAMJOOLGrCfgwCDTis&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8M0Qmy_B6lZt36Wl835fefXXZ-OsNaBOX7nNnUnZdjQ&oe=6A8839CB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Spooky Monkes (GET V2)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Platformer", "id": "528142316460358"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Su
0", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618444_1045484641063213_7516981011686385031_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QrIOxGLIXHAQ7kNvwHsk4Wr&_nc_oc=AdqaLHydOdlyI4RvHzE24WomUQ6wYFaxmvxHcU1N0g10y3aZ3oAxYzHncVq5wi4_scQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTfcMHgwMeBPCx4GU14RyI6XPNbFfQ803yPdmNS1kVMA&oe=6B0848C9"}, {"file_name": "Untitled (19).png", "id": "1234911801451981", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499296039_1234911808118647_2593510906285837941_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmIe8ZDGIsYQ7kNvwEroNGn&_nc_oc=AdpEZI8dAwZ2AZqZUWAfnlhGNL77vn8x-BXgGdKg1DEoTAMJKxkSRolJute2uM_ciNs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkWKpnpzOTMFbgniIqvVx3uQ2FPrctO2XlcDSvf2O_3A&oe=6B085C6F"}, {"file_name": "Untitled (20).png", "id": "1245559177154930", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499303746_1245559180488263_193013781294779519_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvqiu6Zrbz4Q7kNvwFA_FGN&_nc_oc=AdoMbqR1b8yeVyoZ06RffbMGO-zHoJj9d-91HzyU2IEUQOXZQw_KAyRtCYZrm9p0Wa4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkxXewU0D86SRRwzrDp9XAPFpZXmiiOBRurc4mzsB0vQ&oe=6B087195"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Monkes (GET V2)", "keywords": ["Scary", "Ominous", "Spooky", "Fear", "Horror"], "long_description": "Survival is a climb.\n\nIn Spooky Monkes, you\u2019re not just running \u2014 you're being hunted.\n\nSet in an eerie, abandoned facility map cloaked in fog and mystery, this game pushes the limits of what VR horror can feel like. Use your parkour skills to escape, hide, and outmaneuver monstrous entities that stalk your every move. With no weapons and no second chances, every branch, wall, and cave becomes a tool \u2014 or a trap.\n\n\ud83d\udd26 Key Features:\n\nMultiplayer or solo horror gameplay\n\nDynamic jumpscares & AI predator movement\n\nPlayable with the physics of Gorilla Tag\n\nAre you fast enough to survive? Or will the facility claim another victim?", "short_description": "Enter the darkness of the facility in this Spooky Monkes. Run, climb, and survive as you're hunted by something that knows the map better than you do. No guns. No safety. Just you and your fear.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/spookymonkes/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "AlexVRGAMES", "support_website_url": null, "website_url": "https://sites.google.com/view/spookymonkes/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24294420920210125"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/507817984_1266558008416498_7864552655583204502_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GwfTWkNgX-AQ7kNvwE2in3Q&_nc_oc=AdqxVPAl9e3W8teU_GW75VV171IkwajBaWle7Pbk-d_uaQXJXlTNMjTkD0Wk3-fm4yU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVYMEg7pVOINGQ11dfAIN_pFt5vBmXLr-xB8CKRsb7jg&oe=6B08538B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
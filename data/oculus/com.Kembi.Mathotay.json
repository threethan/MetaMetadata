614638098953_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lOC_dTCyOIQ7kNvwE2s3To&_nc_oc=Adoc-efPj6ICQY_g50MAt08se41rgtCufeLILnODJDmv4mmykhZcSAB-7MJlplle0NY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77MmdDUUijEVN_yEeATR12rZRBEg3tOgYs0O8qb71AWw&oe=6A119EA4"}, {"file_name": "forest_16x9_2560x1440_noborders.png", "id": "2647360252295613", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499303198_2647360255628946_4111486552377260130_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FwqStq7pMMIQ7kNvwE-txlG&_nc_oc=AdqsF313lVVp4xOnwji_3y6AUxnMkmHWoqUord8NU-dPq6wls1l4IlaZ9y-Lm3ocdOg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UYjoK3mKLLlSWzG1XJdnp35zZetxTbOCYs0suiCZQAw&oe=6A11B187"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mathotev", "keywords": [], "long_description": "Build your arithmetic skills in a whimsical VR adventure with Mathotev, the clever and mischievous forest cat! In this playful educational experience, Mathotev gives you a series of scavenger-style challenges using addition, subtraction, multiplication, and division.\n\nExplore a colorful forest, search for the correct answer cube, and bring it back to Mathotev to solve each equation. Encouraging feedback, gentle guidance, and bright visuals make learning feel like play.\n\nDesigned for kids, families, and anyone who wants a fun and friendly way to sharpen their math skills, Mathotev transforms VR into a magical learning playground.\n", "short_description": "Solve puzzles, explore the forest, and sharpen your math skills with the playful cat Mathotev!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/dawnelaw/mathotev-privacy-policy/blob/main/privacy-policy.md", "developer_terms_of_service_url": null, "publisher_name": "Kembi Productions", "support_website_url": null, "website_url": "https://github.com/dawnelaw", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort
173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKoEk1LN6N4Q7kNvwEhMnyG&_nc_oc=AdqBxZnMySPTqmx5xO5z8DV1DUl5qOCN1dHsQ858T-CtnZPzB1wTpneypC_iEDilk_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ULaD7Zn6hPidPvISHQnAW-_Y6_-YzYcSm8XhDiA440g&oe=69DCCD67"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUhn4tFqWJAQ7kNvwHQZ46j&_nc_oc=Adoemop786DPunUo-su1x1o0g0H9QKPBH2I3N25yxqYjA1by6WeXjCYhD05DakkrS_I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XGilz0AWzfyaF4aRel1zD2f4UUGyR78zBDUs6VQ7lpw&oe=69DCE233"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7amMYLRO_PkQ7kNvwF2SHVg&_nc_oc=AdplOxrsmj_xw1jGi_L4TMzlO6b5Oi4w8Vt5v6N09oQ6gpXX8WTJMfFyKLbGUz2r-D4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18HOExgIq2SjbQs9RPOXQjmJjmEztYJGhuTfNpFrfuDw&oe=69DCEB6C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrJH6Wee3XQQ7kNvwHf-j7k&_nc_oc=AdqYYWPfqU7pLNHeg7nK4c0zbEf0_s_za-di4dzPMPDeujQCFim37AXga0FV3kXPYdE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0v6zuuu_oO2tNIigkXmZVjKdr6q19C7UQ1Et0JXQq4Ag&oe=69DCF9CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WJJNNPSL6cQ7kNvwEKMcg-&_nc_oc=Adr5NPGWqSvsBEM21OkTtNDUebAC9N7FjnX4hGE-8re6WvUJjSaQ7mAy1TftNCOfoxI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nxgu0ub6EpKra10xnTuVlBriU-zQLxNE3S_YNlhWbEw&oe=69DCE95D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
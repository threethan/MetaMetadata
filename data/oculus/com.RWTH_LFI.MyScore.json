png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Slb1rd9r8DoQ7kNvwEKfnF9&_nc_oc=Adl2WtMeAX62JwA_h6ByE6ODXjRg1nxB9tVg4XM9glzdHufg_mFfA3b54HrOiTc3nq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxPuzymbBRuOKBA7qj2_iTqiZZ-2aJHzxw7sjPq17G5Aw&oe=69B54067"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gafyp3X0yN0Q7kNvwF1Lf5F&_nc_oc=Adl1zsXd4YykNgrUjTXZqZQy6SpPmrWhOKg0uzNYw3KeLnJXF7xbVbFisNuS6vwpXuk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz5CeB2Edtww5LvNnYVglYOGB5NEGgUv2PbtUxq4RYCGA&oe=69B55533"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EUVKmJyc_MQ7kNvwH0lA9f&_nc_oc=AdmzcnUkRpxEpG1v5aFWA8Mrq-eL5u76WHvPxpsAGsgxLi_5CIoG3cTXOwh0IYoPU-Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxZq5DWE1QPQ3OhMjC_2_uSFoEEEI0ajfFu9B1oBPwAjw&oe=69B55E6C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YAOw0vYlWHwQ7kNvwGspvBn&_nc_oc=Admi4WZLFuK3ToqMpa9zq3VuLWcxqDHvNBuuT0BzC1sQPJ3PEwcNlfqatC9DgfqRAjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz8su5XIi4dcRvvKS7P06L_yipDbmQ06B_SWYrCdbmpiA&oe=69B56CCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yb5vLzu9pIUQ7kNvwESDh4j&_nc_oc=Adkgx7qh6J2X6G0SP9uZU0D9dPCDGGTqZNAABaw6PcoHS6znkfOoJr18vBrU_uFzCaY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwB0oD-na7U_dQ_uMQ9q4z9i7xeguTheFba-DqAITdpew&oe=69B55C5D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SOCIAL"], "has_in_a
173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pc_qjgTUL2cQ7kNvwEWEThq&_nc_oc=Adq-fzTIBYQO_ZXZzFKgfGzJJbhkPBkgNCNm9Gd4iYfRrCyjvQPAYPu1zb1qEbkU3Zw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHR4VXzNk0rbhwHh8HHbVKWDgxqMcllmX5XVwMCng8OA&oe=6A69DDE7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gupBdz2siBMQ7kNvwFMWund&_nc_oc=AdopNGRH8UYOh6hcZIPc7BT8HtnDPAF9u6pDVqelcN1USzgHGMg7AtshBslXqT-9wy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHHZ-rIwsTUWDYtE6CWcc6wz4P6ErENEOzMFpJK0JCmg&oe=6A69F2B3"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XJgILRcKsIQ7kNvwEPnhDh&_nc_oc=AdpeS9noC-eNdX8qA2yP-NcA_mXuxC5lbQ7F7x6l-O002Jmyk--z0Jr-MxL5XkB7SPU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA08WtIj0lwArsmA04H31hYb58zUw2NHm6V8wKSjNsJrQ&oe=6A69FBEC"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0D9O5Sjs0MQ7kNvwG2pYdO&_nc_oc=Adowgr-6iUoQDYviR2Mr_PriLSNl-xsoiS17rPFnduzQsb_f__0gP3Vch_-nXR--mqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLi6NRFleDibFytUX3WRUMl9-VdByfnUE7mTojlUnfow&oe=6A6A0A4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tsTigqyG_h8Q7kNvwEP7FCM&_nc_oc=AdrrzsKqsl0S-oTq7_3KSr5t1g-YAjBSsIzf-YEO2h18FYqo4Qz2Ju3BmPyWfgzsniI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1A1lpJu-2VxqdtkjFsCmUDsoJg7AIlq9c2M5zpf9whw&oe=6A69F9DD"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1rnS5R-gVsQ7kNvwH83mnW&_nc_oc=AdocCMGc3vzJRkGhofOm6hWCQh4qkLQDXlFPR-tMaA6oOheEhSx_KOxIbr2Sg1aG_vw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO1CLm2WmWTCdDC1foUXuF2of-wUxCuFKNV0qQBGzj4A&oe=6AB68D27"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g8wzfcBwwIQ7kNvwGSiJtQ&_nc_oc=Adr5tAUUywRRtjK7oPKl1F_Jz3gRmirkbyj_J8epjDEmbyo8MSlQrSLiyR3urS7LJSA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ_ev_nky4ovv85kBJ6VbAnZnJKT_FAxQooRAV43ddEQ&oe=6AB669B3"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVkcL0O4COQQ7kNvwHjow3E&_nc_oc=AdqO7-PvzzZFHT5bzDORfYkePnqEAJ7E3ir1kbvmajDOgUHV982qx9PCUkPRIZX8w6A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLz73xBiiL4tBrSgk81en_FKY1kNXiuhpkq2sWBXXwI2Q&oe=6AB672EC"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPEUmbD6A4IQ7kNvwF-3NNI&_nc_oc=AdpfDfXEg86Gba7rwPvBuxuEXx-G49qMf57tRRfjOPzvBGxmjOsqlQML9Cx5J_tMARU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUM-UrQL19fFWdDeAuJtNPsJ4355Ar_2UdJg6EobhMWg&oe=6AB6814E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-U3UZd-QDIQ7kNvwEJQMoL&_nc_oc=AdoqEch6wvoJBKtc1S3JJD4pEAsXXpD3F_8m13mvl9ZDfxB0XU6zVmwin00syLfp_ho&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHNnLF6cUSI13Ndp-nCN85-kRDtiX1lD4qmC35xv4ijw&oe=6AB670DD"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
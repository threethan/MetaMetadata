173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GEKPc-XTeAgQ7kNvwEMYymd&_nc_oc=AdrL2qBx7bHDJLGCidZz2Bj2KHrkt9DRtI3GTtNjCt3LMXQUj_pmE_Xxz_0kTLJ2D98&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgE9tZ-86PfxZ3xCCLN_t2yzL-CtAQH3STWhShR3xmSQ&oe=6ACCF6A7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdH2yawv9yQQ7kNvwFFPkLN&_nc_oc=AdrJsr4Rl2Hldv5itPBN3HwpckNAM91Xk7QYcBxXhGilPamzITUEDpjHHxGh-ylIn9Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPU5je5WHoXrMXKJAeO-l2-uhS-1L4Jm5Qqww2xILxHIA&oe=6ACD0B73"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9H7JbT1Xh4cQ7kNvwG2E-AX&_nc_oc=AdpEtErlWh2tmrjCIKOuH2lO1QUdk-_WDXsS6x21LQJ3SbYMi6VOsMUuaRBIqJWMNaQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMf30R41piF36iTnmtzugKosoVqU7q8GAaMnSIe9_jAw&oe=6ACD14AC"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mY_3VjZ39ysQ7kNvwEAmD5E&_nc_oc=Adql4mabhPee6ada8h1X6xr_U_GGs6fa4FG3BAWob-acXYLPm3FLMqXTkhbK3v_vlPE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGhy56hnfvGO5qyvu5fJuHb3UUbljE2dPRLmnykEk5fQ&oe=6ACCEACE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2WQ5OvP9nYQ7kNvwGiV4-q&_nc_oc=Adot_VlOGkIzL9v0SmgrgU9Sl66CeOAUiXwlPoNCUX1_xIOVk_iAMIAMyOUXeXZ6GsA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgRQDdrzm_dQdZiD-wUGKpHrnZ-BLtxQHIk_z_Tpa2Yw&oe=6ACD129D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
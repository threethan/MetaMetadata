173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j1rnS5R-gVsQ7kNvwGxbyV-&_nc_oc=Ado_lra7dpE5rNFV47BBkv1DbQMO17Hy56lLfQi6z5ABUtIuuq3_AziWeEwGtlgM_rQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzdfRKMh2fQAj2-NPRivDmj5agvoVJuu3G0xOJOcICkw&oe=6AB53BA7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0g8wzfcBwwIQ7kNvwGNBMlg&_nc_oc=Adq0Vli9LqojIPS5GdHFlhbKMC-nJ2QSpbX8MUl_Bv1yu5NgGaeZc0msu6O0g983BkU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO2BrPGvdxTMTAfPUnnn7T-2RTpZzDhDqp-JZmgb57VA&oe=6AB51833"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bN473ivcZUQ7kNvwFiT-ft&_nc_oc=AdottdNi9Gy73EL42Q6nSgJzR6zcGbUOxGsJ1cBCSsKrsKLYYbf1r2L9LmO69PNcZ5o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7OB3SvrdsC5_bEf3Ns8nzcifMDR1sA-D94mB0zg3lWw&oe=6AB5216C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPEUmbD6A4IQ7kNvwHjBej-&_nc_oc=AdqDfupQnQUDiqCfkfJ_nzG2kf198hKcKamN46PxmMSSH8oA-xJGNg3EEQpvtpxLQA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIST4dTJngprH2WUQEHz_2_G60beMpLpqDX8E0rApjuyw&oe=6AB52FCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6M7NMy-U02oQ7kNvwEQjYPK&_nc_oc=AdoUy02LTbbxHMX-DSPbE3ydUtys0D_yjxiz7dNsw3RSLqpZXQVt-K2Txx-PVXSU_nM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdrADw1kYsXKkVd1lKxxBWDzQlMoveePKUC9hWqmKUrQ&oe=6AB51F5D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOtNofBxaoUQ7kNvwFt5VKL&_nc_oc=AdoBKDwyvVjmqDEcYEkUJPopMzh_z5EwAJt2oge0MJbrbzEn_cHAr1cj1QyVSz7Jf0g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8xCELYChnFwpYW8cWfED85Js99OpcJLHAz2kYENfBuA&oe=6A9D80A7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wpj5w-UJNF0Q7kNvwHiBmW5&_nc_oc=AdqM2Tv_9wCjHBCErRHBIx1hQ8NaMFat3YeVlg4GhGIk77n8L3pmt6gBuDrersfFJm8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIAmfjMWbIpqFi1x8fPi5pQ1uKcKL_JECDmVrIVvs8pg&oe=6A9D5D33"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHP4tRCa77EQ7kNvwEtQied&_nc_oc=Adorx_9bs0ODZJDStValQ6lEX-2s439dtYPNI9_HsuZt20Mbbe6XieU7ykJe7Sq3oM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTEgS6l6cOqCPGSVd13NNZFFKdnf3sntghXnjQP3FQjA&oe=6A9D666C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0oU5tzcF0v4Q7kNvwEHi3oy&_nc_oc=AdpOKcwvSvWy4NhSHdkvSDVWOeb-kIdp_XkRvo_gLS4v5XjUHuPKLsgUVDBnO86fC8g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgzohOGMEgRQV95uGfyCqu2eu3r0yhBSqfOWiyCkOqVQ&oe=6A9D74CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTWKL2gJAgAQ7kNvwFb_Mr2&_nc_oc=AdrHpNhwKpExWyxC-zIeEt4nFQgqetCCidOVSWyxbfn1VOd9oMtJXqxPfS5HjfiMucg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYo_j2aJHr4k7cNrLYsIWgxjeCQylawzEoCkxr9BGzdw&oe=6A9D645D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
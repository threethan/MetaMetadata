png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFRgoqskaNYQ7kNvwGtj-0_&_nc_oc=AdmvaXHvLh2ujADgYJY-LMm-lfw8Fa-Mfoh9F-rFT-um1q0l-m9gklkNJZJqRYR9OW4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy_0DpLCsSlx-fORXfMS0gEG33sprC3eyfp-10rvoq94Q&oe=69BFCC67"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arPMqaWmeccQ7kNvwFXkbEk&_nc_oc=AdmeINj0TNvU_hqJ5mohZp8SapuPb8B_6neFDxBA_EraVu2pCzp0bK9_0NsVfZidvdo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzCdEYsP1wQwHhnMh3FRbaBjKmqab683jxxf9gIQeKkBg&oe=69BFE133"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=60UxAQNTgAgQ7kNvwHPzy2t&_nc_oc=Admxd_N3POv5gcBEMDGZkP8SanahcpHirDKORrGFjTnkIwBPryD7EpHqDmpuKarqsXE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8Hqb8zJGZXaZT43ebJHF-ovfSwHWCvcZTIZtfzoT7Ig&oe=69BFEA6C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=815ZZ5YsBM8Q7kNvwE14J8_&_nc_oc=AdlN6AC1ky13P0t7kpaStJMh6_m5Fda4wo-k_RkWdDoKl5R1OtQ3y6tAhuGeg7gdYQU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbMnYzd2LU0acdHD4rMfqISzc2hsSHhFUZO9iKocOHUQ&oe=69BFF8CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=te8aB2Z4dqMQ7kNvwERC6Ym&_nc_oc=AdkLsvxQMYCU2__PP8ytmoGyN3NTDMj9xCyNSXSWKHmE-NxDMQSiRGOza0I8g8Ak5Uc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4F4juOzD_oQ8AtZNnP3N-BHtMt9w75gBiBG-KhfCTzg&oe=69BFE85D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SOCIAL"], "has_in_a
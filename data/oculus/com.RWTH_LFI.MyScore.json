173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G974WmLhy74Q7kNvwGnsdEb&_nc_oc=AdqJpGqbke97Cc9vbTyd6EqA62mOvGR1x8XrK2t2-hFV5qluWHlN9hqEE361aoP1QHM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCC9sOU6CdrfIJ6yPn0LI303S9F0F1tQHjdWLMOd68Yg&oe=6AF5D527"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zDmZAfCBsEQ7kNvwH6kgNF&_nc_oc=AdpcHIwweDjy3iq26sjthJeWwCHFDibJgZMbC0Rrd2ao64oc6O-dEv92D1IbR5IN5U4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwhsW_K4ince1_19_koFNyiI9xdpHvlNmkN3gFBPDKuw&oe=6AF5E9F3"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38n5BI436OQQ7kNvwGC1Y8r&_nc_oc=AdrCoDWCWaldzcL6RQVZWvwEoryA_fRDZPzVWffpYb0SF9oD3LX5y8kK0ERx540RWKM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyhxOL3TmxMAwvHHJ_CTIbKHfLdYi0kWTztx079uL9aA&oe=6AF5F32C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGet2bFL_rYQ7kNvwEdhpVr&_nc_oc=AdoFl3QDWeag_CW0lPZA0-CKETVtSbbUqGSfPQ9AScwHCppnBbteMHlmpvTF7eujfgI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWIzVcmS_rXXrpqlokZPRXZk_duCRe-JPz9qcEVLUs9A&oe=6AF5C94E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euK0x_92wt4Q7kNvwHzhSM0&_nc_oc=Adp-xfq-NvyhIBEHzI7Y5N4utAawTUBiOgF1nowji0FmHJ405GeUJUCvNkbT8J6urQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ5fPrhViqxvHvi6oZck7ODEZyJBJblPRN2E1yVNbwZw&oe=6AF5F11D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
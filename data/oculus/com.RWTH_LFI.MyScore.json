png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mWVIJ4FDZAsQ7kNvwEOfmRx&_nc_oc=Adl60tIHf2e_YUChi7K2_ferUiP4VOBsSOFz_smkHp2q4oZEJAACGY1z9ZRi9Ma3OFQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwn19OjgfuooQSsliWRtUXZaKuzmr-f_gzlfgN9-w6AOw&oe=69BA8667"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb8nj9WdGeYQ7kNvwEjCcLp&_nc_oc=Adk-N0de0MRpN1HANsQ1nGf3DaZaj125g_on-QL1Ieo_nydp9RJCs8XWahPYg95YsHM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZlVA5lW_FmcLqFgb9FCS3s9UIc2NtGSgYx0eR2MQqWg&oe=69BA9B33"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E5d3x_7q0UQ7kNvwG5GxgI&_nc_oc=Adk6pq_3n15FQxivqjAPNdKtHx8nTGf4UOGhAYZtzn_yVJmxRF1hoh55PZh6ohYkDlg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwKj4kh9o32BI9FfAi7t3b7bifq5j3snvdQaFPQLbC_5w&oe=69BAA46C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeYvAxbV5QsQ7kNvwFCsLVB&_nc_oc=Adl7WZXzGDcORd1i83KB_wkm6N7euXNVLdKmKIXZ32ALx60BUUzU_Hirp2JXtwoCSt8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1V1xsH4q1ugJwx3hwFKvcjT-efLUv_NFPLcpzT7YdNw&oe=69BAB2CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmSyyP6s4P8Q7kNvwFt2hUR&_nc_oc=AdnatTiIE2QaC85pgyXgHY3I9SYamWB5QwiIuKD-2pUhMXsngjgDC8mavbZtMkwxMWM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyDSypBnwrNKoCdFUYmyzl_F2QmcGPqhHgTIDoo6N2t3g&oe=69BAA25D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SOCIAL"], "has_in_a
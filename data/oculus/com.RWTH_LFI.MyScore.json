173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dapNEUcYN1oQ7kNvwHx3Y0b&_nc_oc=AdrJ8ztzt6diPpijCc-qxNZpyjsefH3b2YmaFN_A0uiONPYeDqD5OU-oXv6_1G8qwLc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1thTqtBizp4074M8QRH63Jf9rzvGDP23-9mKlCTiGMBQ&oe=69DE1EE7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLkIIuwMtNEQ7kNvwH_TvMi&_nc_oc=AdqAnBj0f8a6U27BYM-ayDBvtJpbrHvurJYXLNMGZJKfTOZyDak5U9hDRLJo9kOQ3og&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03QAQJWHy-mvOGn3ecQ-3bMgWenNpNyJW8pyq4tCm3jw&oe=69DE33B3"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7amMYLRO_PkQ7kNvwH9d6eR&_nc_oc=Adp10EtGt5QvL63gj7c-sVu03iGzxGMAByJe6v_OSX29V6IPZFBeFJ-2wn-MSgc5dW4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A7y49Bqv86ZfdvF8b_SV6aAItqiqSnXQj1uFqbTDrYQ&oe=69DE3CEC"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrJH6Wee3XQQ7kNvwE0k0RA&_nc_oc=AdoRJRedrvfBOeF0PqMtaMrJVYG7nGFQkOOFqDy7EXNI7tSmGCCdXw5-v1A6qXPTXgc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HFWGPrBdIR7tEk9kpPc1npRm3qupXeviA8_cdCJX-OA&oe=69DE4B4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WJJNNPSL6cQ7kNvwH65P7z&_nc_oc=AdrrpT90edtPwbqoUWWiKKUgUiWGAyoEJOtj5m0PqJ0SzgrbXqLDTxv713YlfV9XHJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-eQBXDeQp_5ZXy6tOOiK_OKakTpGlFzLMuF-ZPdCCWA&oe=69DE3ADD"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FTR8ybjpczIQ7kNvwF93RVH&_nc_oc=Adpx1XKnn8yh9gBVIEw-0PT3AH3sWmSjI9NpCJ03mYINBnhiP0U4NHIErt6svnvJm8w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu30xDCwrdeC2bdjDgJ2T91fitI3t07085iT0vP9WiRQ&oe=6AD0EB27"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwszlvPpiY8Q7kNvwFTaPp0&_nc_oc=AdoxB1bUTHrg31rcco8TnYV6nh6Ok7EUxmwdFjU7HUVQvNAReram1tvedsArOnLeZK8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJUJ-cktfOHA58FTtWNKzPvS5KH-74WA-KaoOwGdP_Vg&oe=6AD0FFF3"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkeFzxRjpikQ7kNvwHfhQgP&_nc_oc=Adol3da-hSjQm6caheXgyT94NWDbXzU1j2U88b2aoV3U2lRGvz9B5naHTiLEJM-lFvc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFyuXz0j1hoO4pZUAPc2B2pRdunPBtFZtMkmYpbyNkNg&oe=6AD0D0EC"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxQsNcf4xYMQ7kNvwFht2Vx&_nc_oc=Ado128O2rEQFN-EBTfRd_t0veVpj-KAeaiHYor7W48ldbajtfXc8n8YG0KzXg1bDF-o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDoBh7WqgQrKdODIkDBI4DRyZ__9_tQe3l_9X7tqT0rA&oe=6AD0DF4E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Asgze-CsYHsQ7kNvwEuG0L4&_nc_oc=AdrE0ill7FNdnCHy0d__1yDSylSJxIqSj8P1LdHOOKByGdnIe4F-lmKsO8ltXMO-y9Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsyJyKSkse1-Cz90hsIcunbPizWj-RsuCuET5PKTRi9g&oe=6AD1071D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
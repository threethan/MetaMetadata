nmapOsi1Afrhp3wJo8-YmHv19Y8fXNVz8n3dkuZyKg&oe=6A60A367"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0H5ZLDSvZCgQ7kNvwGl6lPn&_nc_oc=AdpZXoraQQ_n-EgxwtFY1XIp69k7f6Gc-DGSM7_eLCYAP900zKWsTrNC9sqJA7clgKs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD3PpTReHqPk0FIjQ0eP10gramrjmUyVEBQUex0aPr6A&oe=6A60B833"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w1riqdkth7oQ7kNvwGUd6y9&_nc_oc=Ado4mb8rgC_0_c2QQlXnuiM0-bxJztv_PrQQYrWiIBhkz9nHAZgblwNnmJwr-3hbasQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlncog2NZ1g7LpVKmWT16LmyGU3SsPHv1uj73yc6xXog&oe=6A60C16C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZbKyoWbGbUQ7kNvwGOb1S0&_nc_oc=AdrZyrwRnVIF3MGNMupNp_7-_aaggA1QVxF8HllVz8aTpkTQBDUuKEwOMHLkG2THUko&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVx7Ap4l-pxL4CBkQS_DjBV5kiU3gkUfsVobpMk_hgGQ&oe=6A60CFCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXaPBzv0pHsQ7kNvwEzp5fW&_nc_oc=Ado7bVRejhQGmrNwbW-oyYUFkvw4qCz3oXkSZhz8vA1-YHl4yT-N-4rbd5Ll-cuOz74&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUzRKn3KPjyWvC7yRVm1uIFaokhAhcBd_hdBYHabW-0g&oe=6A60BF5D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
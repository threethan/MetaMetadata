png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9s9xRBwzv4Q7kNvwELlOHD&_nc_oc=AdlJZO24dNBz-Leme5E1OIjMl3iV4KbHZCmesh6JK77p-JDr6QzIRe66UyU3_7dn3ss&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwmuUOpoQhR2XrNPYJ_RNYoEs0I2Iroze1P8fjoHEUqdA&oe=69AFFA67"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26v6MgCsEBMQ7kNvwGeXsob&_nc_oc=AdmN-JQ92srzgdqemkTDLEBqqp27RfaXFCtn6PvICwcCnI-Gcxtelt-avp8IVIUcP5g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQi6zHbm_jovWoGaEN3-ndlrJB2BKP7dKM4IerjNyTJw&oe=69B00F33"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V53dwHOA4FcQ7kNvwG4BK41&_nc_oc=Adk15Todti0XmroR2XZ7jHyQwOTjMUJzWhoUip4Vjkdo6_AqFYsv0pk-vV0qNiQ21-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxeHyY-8XMb8SGJ11Kjfan_J13p7kzBKFOo0HOPy_mNvA&oe=69B0186C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZ-6qVEMXvYQ7kNvwE6AZtk&_nc_oc=AdmUEEpyiapajm6-Lq-7vrUNqYpvVYUS9gYv9XfaOR7wDBFvxTQQ5DlnERDkzOWJuR0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeN3T3gCiV31JmX304h6f68msU33-SIKM0b9N0CqtJsg&oe=69B026CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksTcfalnR5cQ7kNvwHGEti2&_nc_oc=AdmTPCDXpjvME_PFGGWEJLoqDRDCtKbYBkvQo4XhXodChITCtYmL8NKGt6kj8lASdzM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwab2zfc89lnIoIzAiCex1fbBXy9Re_RyptfklA7Bsycw&oe=69B0165D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SOCIAL"], "has_in_a
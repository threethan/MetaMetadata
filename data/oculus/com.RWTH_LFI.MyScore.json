173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOHzQCtgFXYQ7kNvwECoc4V&_nc_oc=Adoija2qbMY9Fc6uKGHFl_xy87-L-1aD_7-abOk4HuS__48YPe4SPN3zx-Ir57ivaBE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBjCtI87ByVwvAkwDxQMpMoR2hUiklMoUHHxiQ2Qf_Wg&oe=6A5E38A7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIUYDMxrVDoQ7kNvwHNPnQZ&_nc_oc=Adp8tqdaa7_QmypdZTBI5Evh1eEILwAn2Qi2VNxofX-NNp_zLbO-ZIxvikvLHBcneRI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBg_c9ml6E0jQ4BJs90EQllHYFkrd12ojQ8S3f19I2Ljw&oe=6A5E1533"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIBzby4OrQwQ7kNvwHmsPFf&_nc_oc=Adpdurvk4EqLCDq6D2sP6cJv-zqD0zzzn9rQQDPCZkKuHPDV7JMTz5f_LqgUstPbNSg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdOFNAmzsreK-45f2JsLRIIVjdTjxgWFTRF5y5_sNq7A&oe=6A5E1E6C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ZbKyoWbGbUQ7kNvwG_x6hq&_nc_oc=Adr08255lDzjryLcIgoVbB4QX7QS1MqClSZcclW0XUrK2Ni_Z3lV1t18sf2so44LuLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCrNYyxuxTMfo3axxGfC0WIeXiYo8DWDlqk0gmxz16zDA&oe=6A5E2CCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVPurxnkRt0Q7kNvwFyWPfl&_nc_oc=AdonOUiplojJsgaFEkNLP9JUL3LBIllp040e4TlXryWp5l4fvG9kXn2-sRwKOzSGC2Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4n5jhdDS-1abOsuFn2azcLUGKajGxSdC2sBpqY5ePGQ&oe=6A5E1C5D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
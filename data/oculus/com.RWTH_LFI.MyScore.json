173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKeydnIcF08Q7kNvwGoLu6P&_nc_oc=AdrXXIPthqlxCZzz_V3Bt-MSBRPSAL0c3T68HZgvJS-o3JHNjoO10F6Iw_c-P3MF5ME&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgWFBXsIDQ6l_eIyAtJitOYgg0IGY4TCH28i1L7-hxvw&oe=6A7EF5E7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5b2tmjkoPcQ7kNvwEfK9Hi&_nc_oc=AdppqbaB60N2cgVfioOCy2FDBxeIuYx-HhSvdPR0EjE_kNG8ExECNpdDN6k74ZRnmlA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWImxZE6kz3xeKDERWtQGrSFUpd0kDSaOiFhAgm5cg0w&oe=6A7F0AB3"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIwfSY4gW-kQ7kNvwEmm3hI&_nc_oc=AdoZWkkLLEcUX-KSoMLCQFtlEihhHF4qmtIcv5hubk_6r8T1k_8h3ruCWLyfj9wANxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOTg0qW-9ts9a-ALn37MvF4BP8PNBE1tHyHCrR7F2k-Q&oe=6A7F13EC"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9-DrzsLtDZMQ7kNvwEZn2xc&_nc_oc=Adq9cNnmbAD_79OGdRerB5PE12Km9RbQA_x5pg9A3r3SQXZfw2qJ6bTbMOLmCdS1WXE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFITa8bKI_zrJCqsYcdNyiniWzoaP-YjXseK4CyXwcjoQ&oe=6A7F224E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R12Isx1iLbUQ7kNvwHETkeQ&_nc_oc=Adp0sAKgy3AIFqtVavXHQJkSDq4ggIddSyOY0JbyK_6x7HiwZVcgt3P2AmIXCYHe_vM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyMDjb1GV_p_dXqIFFQhUDR0Y66icOOyaUuIz6zCFIug&oe=6A7F11DD"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
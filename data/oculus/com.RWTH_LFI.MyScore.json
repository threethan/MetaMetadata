173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znqZaWS3ASQQ7kNvwEsE0ev&_nc_oc=AdpuOhtH5ATtpOeYLnWNWyiNj7RWy7ckc5bAyZAh51GDZ9Qyz8qUZEISn0G50fIU1j8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsw1ud2Bz8LsgwQdXSifeY8xoQIA-d-uMfThuEWx0a4Q&oe=6A5109A7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZ2GKrxK72sQ7kNvwFOFHA4&_nc_oc=AdobudevsVAAiFvbl9hZlc4gbfOE5VVuB7hUzzmsGlRWYdzKQVOyiNfbu4jFPH-SHIw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGpxqxCKipXfyIVwhL52Q__AbXd-Q4OLqjpXuzFrB0-g&oe=6A50E633"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRpziXCGhecQ7kNvwFI6gK_&_nc_oc=Adr4hL5Hi5pwYWMxbmhaIwl_OTblRfBBsX8JAkcLzFBWIomlAVrJw3gL3xrStkR69mY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOslU7pEIZ4hyY_Y2-sO5iZIUjbp75adfqQNP-ZFGNYw&oe=6A50EF6C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LrlCzipRVjEQ7kNvwGavGCI&_nc_oc=Adqsdph3bfaZzIHgX3S8DSMIrH3327EuykaWqRN0NRaeB4wfMmlvEiBswV-XcZ19fDM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJRo58KKMW7FBY6Z2xDHrXIaADwyuAiQ4jAFX_8aF4TA&oe=6A50FDCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsIoncRVLpEQ7kNvwHH2lFv&_nc_oc=Adqiq1IDu60u3C0d_9126Lb_1NPAIYGWZOCknsN95YSON1SEje73Bvafcy4NhpPwrb8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuqTRBycB0arnbrQfLfJXh7w1w_2Flc5RyJEasTjdwYg&oe=6A50ED5D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
ixB_DHYmBErsW7vcPALKIuBVLZOKrkPhFt37f_V-PQ&oe=69DF7067"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLkIIuwMtNEQ7kNvwFhyChm&_nc_oc=AdoiZNWiidOCrL3TC4SsLg_KbvCK__dLzwZJpy5_Bq4aiXvL2VEEDEe347Lz4PjPgfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3of3WWmNORE3MhIs8s75hfGXDjuvcoYssKIQE9E7nc1g&oe=69DF8533"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7amMYLRO_PkQ7kNvwERLeSW&_nc_oc=Ado1V7OJSlyjJPtxayjpCHdIu_wQg_qyY5IF_sIqXLaoZ5FaLlugZSxBAPfYfsjeUk4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2exRpGnXjHkTLNQgL0XGDh5m_lSqpqip3Ey4vXG71PHw&oe=69DF8E6C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqAKAAsNbhAQ7kNvwEzxqMh&_nc_oc=AdqaHmDyx2vmS_tUXOhp1cmno1icUp87hd47vE2RJyzG20w334tlAs4M5QYkuG9XRAE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_yaOad0NtajyLSxIeEwMADe4DcB_sqCqGMhWPGe0uIQ&oe=69DF9CCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WJJNNPSL6cQ7kNvwFlyLVn&_nc_oc=Ado6sDn1MqU1nxlYGa5S2qW-SoJlkV7zaLagQigKa6pkjkLEZX2Ibq3ttO_ckrmt--g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TJiLY4zDjAcYk3JEsrIlkJPqTfRvhtQEkf4VeeKlJhA&oe=69DF8C5D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
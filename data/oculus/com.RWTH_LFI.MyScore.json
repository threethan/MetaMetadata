png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yX71PZRke2EQ7kNvwFwHlYB&_nc_oc=AdkaXkU4xgz_ZPWpWTatrnR8mtjzS_QUeLo2OFUxpOUumxtt2QrCutCwcNUSROhqRo0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuhpG7g47qiEHEMyKHgxj-wpz45_f2AvqWEyf_HCrjmNg&oe=69A81167"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIPmWVEo1iIQ7kNvwGpl3pp&_nc_oc=AdmWtLJOgGX79yXpat2kmaJ4o1shJqxht8f575xVxbxR-pTQUfxAEx5lo8z_cX-N6rw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuWRLqy0QEC_4KD2sHRDKM8F5rNQkOOl6mtuSz8_qJpMw&oe=69A82633"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EQnQzfSZ5dMQ7kNvwHP4e1B&_nc_oc=AdnhlpRDr3DC7TQ6JS-l7xJcWe12oEbgpLFMQQOVAe46usJoGRiLaoT2FxQ26U7mdlw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft5-mcxiY2nBRNmHJhHsOlxfE_D6YP0W5tvbI-Z7ViyuQ&oe=69A82F6C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBZhmPTtaAUQ7kNvwF-P5Oa&_nc_oc=AdnEhdV_ITGOR0SwvGrhzfGt9PPoavvgOUV-LYnbQUMSUuFFAYmf0gGmEpjUXP0HsxY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuaX4MBsSdMMLAUlC4romHtZmLX7zqwKvyHo0dAFtYabw&oe=69A83DCE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GbldY_eR4a8Q7kNvwHQvd9X&_nc_oc=AdmuN9LwBNkTVD00kSOf7IKlksJmYq7Xrkv7mPnSRnB3NVYClObF3JLbDwL8BmnXTTo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsPLK_9rLlcdOlZd7Bgi6a-IxSxarkrmr8HyvTVc4t2XA&oe=69A82D5D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SOCIAL"], "has_in_a
wSS680hyLEiDOrSFtMXIyrv2o101pNS9caMuklexKg&oe=6AE20EA7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EI0LgDYTcD4Q7kNvwGNuRT6&_nc_oc=AdqCFnz3f3txnGXaJNhWBzE6Es0LENe4CdRTKbzjL5xNVaX-HFMhK_iybHNwpHS0nDo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFIs4cKirN74GO5ZzK3_ti8nG1kDQCwXTbOgYgCBB4cA&oe=6AE1EB33"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWko8YLDX8AQ7kNvwGGB37e&_nc_oc=AdrvdbleL09ip5HNrH7XKgmF21tmQRNtPUQxZTKC4S2-Xy8j5VVneVTNl6M_Xu56-rc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnScMZi_SnmJM1PID0HCILh-TfV8oLVBz-_ssYwDZJDg&oe=6AE1F46C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFPk7bWnp2YQ7kNvwFxEyCe&_nc_oc=AdqVerFIXBpOvwTkGK10ZtyfuJm5Jb6kHwpGIUOEVjL-VIlirvVPz29e1_YewIxnJco&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQ6P4LpvpQM_s2Vm6U-KUrwKojMNre-S4zYxv1yFDuww&oe=6AE202CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O8h2DvYKtnoQ7kNvwHEJeHC&_nc_oc=AdqSOUMgehiR3ceGDoiF7oDaiHHvW8NEOYY3_5zpjUi-j41I8f0wLT1cjuQj90AMOPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPk2EBOC3IKBRAMcX-UDEbcc97a-jUAp7IFJNdOZ9Zocw&oe=6AE1F25D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
s=7f20f&oh=00_Af_-P4vpIp7_ba4tqQOEGbWUY5hTCf6_wcoVdW8ORDF8Sg&oe=6A394EA7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDtpnNIM9PsQ7kNvwEmZ3Pz&_nc_oc=AdpPMYKoInIH1V8psmu86wDS_0UNDDNWt3HIoWCA-3EdLyIPPaylYKqxuAY9ZiRULsY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_08ZnWj2Iyhu9zq5f91h6pYA0mUhUK7-YpZxzRzoi_mg&oe=6A396373"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qM0MkHE8groQ7kNvwFwmjiJ&_nc_oc=AdoWzqBEb6_NykORZzGaTsy0fsOR36SjAuRZUuiyFU5e2eNrIo4ccMQOIDHlv7RmkoA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80ulUdLZo8rIZhq6CZFLxmRWxPlSlf2xPzfHM2Hi0Uxg&oe=6A39346C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IOGya0QGoAQQ7kNvwHD_qA0&_nc_oc=AdoQAeyHXvZq56kjRkmbQefSleGMvjIpbimoK-eIPcfz4xTdm1n5fikKnCfnZdHzw6g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aBH1kgM5DBAFBW2-6bTniYT8G-wiPLoFLnjCmo_oG3Q&oe=6A3942CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHiNfeyDVbwQ7kNvwEtxZcD&_nc_oc=AdoaygvcCd-WqR9DqyF_eFXh0W3AIoIhQK9bqfkfPixEPWwpLejS0f1xdcz9VA7NnvQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NkP-8WS7dICuF7KHbKrjTSNTJn4FVw6nvUuFz4dGJ3g&oe=6A39325D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "suppor
173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vKoEk1LN6N4Q7kNvwFpu0IL&_nc_oc=AdomYSF1hLTNVN-uNqruV3Ux8he26tz6ebi6sF5d2unxUmZsuOwsyArlG77b2QSSFH0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ak706p6oJjWmxsu5_F7emI3w-o445b0XLRiE2bOEdyw&oe=69DB7BE7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUhn4tFqWJAQ7kNvwGcWefq&_nc_oc=AdrXEyCziXAn-X8WaDv_36CYCQ1lB3bAF9v7Ofd419Qmnk5wiDQ_hmA0TiGzTTun-YM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tiGrNZmmaf87n54EnaxVRti3qw20uhToeglBHzbI_pw&oe=69DB90B3"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2FGpa3mF_0Q7kNvwEJnrJd&_nc_oc=AdqhnOM9oMXz17PL9C767Rxb6M3v6J5UFERru1G-P1h-hQe9Wm51wiXE4g4igCFrDJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02LLqY0vR6Ydsf9t9V4HdOSoMOLscb-X6157QLXv7GIw&oe=69DB99EC"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrJH6Wee3XQQ7kNvwEzPCTe&_nc_oc=Adpxb41Ew5aVANdRJKI83JTKi3J-16NvDWnaGE5GNurYSROAdUnymOJLEh7ir5r5XQ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TqCWtkJFwKFkvyGC9_H49G9S23g7-5_ibBPyLajUdpw&oe=69DBA84E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mK4zCUfms_MQ7kNvwEejcNw&_nc_oc=AdpLqGEnozmPGSXFW08_k_HUsN5Or8PKovWo5QHb-aaiBHhnIFuwyUZDeItw-AVcEDY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WWYtLTwl_2F8jbFK2cj6y0UQ7E0tdwHp2xiL3R71GfQ&oe=69DB97DD"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gigkP6ELgjAQ7kNvwEbUoTr&_nc_oc=AdoKJlLGcgmPiykuB6kkvBPM-HlDXPLp7Lha2G64ICPq0v8omy0jODR1yPpNz8wdUqA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1xeHrgPUdasXEjfhQFXf2FaNlu3Opx3TZmOzPuE_ePQ&oe=6AA17527"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbyzdLUOX4UQ7kNvwHUgsBy&_nc_oc=Adod3jHU9A8wjFGw72_oX75cgDXAN5sgZ2VxtyEak18l-qWk-2yT_uS3QnUdEqy_YNw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-nd6kqpfHNaFe044GxYJXCwHBvC8TJmpEzKgkK5kG5g&oe=6AA151B3"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZI_qJDQa6sIQ7kNvwFemv2h&_nc_oc=Adqbm0uipIELsgZF59C2DEBa-wfun-oXCpP66XTZs8_QtEEP53RAlMDQTizU1_9mFno&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0ROKjomkksqYPmHJaT9O231HUysgkMU7JZwWgs4SN9Q&oe=6AA15AEC"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9tWJZNkQcCsQ7kNvwFZfOnq&_nc_oc=AdoPvnnAbHuz7H-Mg95zZrowrE_87-a2M8rmHzVCb5XZ-nSTwVTwz8lBuzzVPqheU9E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCwPuOCui9o7Ibg_WAnlvQNwWDsZ10eUHJyIsTDO7B8g&oe=6AA1694E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TW9bHqjDHsIQ7kNvwGmelLu&_nc_oc=AdqWm0TvDYjhnfguxV3HtEMiiLdxZrB1mZq0ZmVEhetcxrCj8uTegoXH3nLwNrI-Vxs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdiyylEeJo6HG0O2hDWiLG7osEqr4Y32ptYJzfO2ktQg&oe=6AA158DD"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
173185595_8442783581608611934_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LPGvkTl7QoQ7kNvwH-A4DJ&_nc_oc=Adp9bhfZIIfJtB-yAVK2VZE8o7MOF2Qv2TmRwqQ6OudEBjsBdqG5A_vqSiCIz08kln4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5bvm3wMj7ht7tF8Ka2eMMm14vgxqKS2DwotsIq-dpuw&oe=6AB7DEA7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ch_sEXWb3i0Q7kNvwF-8ciE&_nc_oc=AdoRAC-ZA33qxZHVx8KXfiT2VcXGpmW00s7UezaXZ4vP5UGxXPITVnpWs_4Bg9ulKuk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQ6th3BX_dDZ_yyi2OW5SDwt_QsZNIrU_7hsgVOFwZAg&oe=6AB7BB33"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVkcL0O4COQQ7kNvwH2v0du&_nc_oc=Adov9X_hd3UyvpkhqDUCf9pNrrmoA3tEjJ62pkqRRtD0cd00adRmkd9SsbOT2WEV4TE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQT7yY83XY_5SX6G9esfmN7mDcYtTFyjZ-Z4x3-oK-XA&oe=6AB7C46C"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPEUmbD6A4IQ7kNvwHRxzhU&_nc_oc=AdpBxkPS4VLt0u0_H7GrB16SYlJK2Dw4S9z1Td7Dhozw2P19MdHP9BWmoEcaJVcdkY0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdiLxgDqRVd1J-d9pX_RFwoGXxzAuc6ma-N5Cu-s-TUg&oe=6AB7D2CE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-U3UZd-QDIQ7kNvwEFZhOV&_nc_oc=AdqxMSnRkvRtpI7iOTodFX-zFPLTRjTWUFOXq_8JP67kjJy018la5mI4zgB0TUR5DYI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYkt4-p1VnWzcEGAcptPSDB1CFoezvlpiSxbRWS4nchA&oe=6AB7C25D"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "gen
png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFwHOGNJpdUQ7kNvwEmdyYj&_nc_oc=Adlqxd4wniRh1fjvB-UTsy63gzFRo6zRTFeZMUIFTvd3nw4Lq031f7huUH3iFeEf5s8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZili8YHyQjFn4d-8qqB9farR1RP_q8771cPF3uN2_7w&oe=69B934E7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q17MYEr2sSIQ7kNvwGdMP8h&_nc_oc=AdlOYUQ103c4Rfeh8jkCn7ogPNDvNJkD9WhT2w823sncfNkjWCNTItm4gcqvU71W3Sg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwArqz_gXpnRc4-o7fHc7MVBWAZ2ibmzdfH2Dzf3krD-g&oe=69B949B3"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0E5d3x_7q0UQ7kNvwFuIH5n&_nc_oc=AdnkPMwPoA1QFhty8No4_5h5kmq8ky81r3Iq5XOqZ2coBoQlHt4FF2gPT_ju-MUeS-o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwq6GU6smm4OocOVg1KZr98rrz3jGj1wFHSfO1iKuvTqg&oe=69B952EC"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeYvAxbV5QsQ7kNvwGcfHpF&_nc_oc=AdnG1mWlVMtddkCgrz6cEK4JlPrtUhSo_oLzrZ5A6HS8Z4CdVn3FRszMxXy0wrtKLlU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzsqOCyC9ZFMxHFwIumfoD_6AGyfQ5ECKUuh0a8KlNJYQ&oe=69B9614E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmSyyP6s4P8Q7kNvwHwtFXH&_nc_oc=AdmA3sCEa1mBkCIEHJdqKOxgYOyB-fruar_NuNB5t_e4ONZGDHHTdg5e7pqz3NGOwLI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw-Mc1aIBkhG_usserWMQMTZOHSoPUAqZUoOCjzEmLkOQ&oe=69B950DD"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SOCIAL"], "has_in_a
2ByUs_iXpsSRvQ675UdhVIXjL0QUaTZ6jTLoPo2glw&oe=69D635E7"}, {"file_name": "MyScore_Screenshot_ConferenceRoom.png", "id": "2716882555127409", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001713_2716882558460742_4376067495016840003_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5f0vI0D2_EQ7kNvwFgEBqN&_nc_oc=Adom3i7qL2OoJuiAF1XUxntWRoAClxrXb_o-MGTYhsb_VZrW__bDWV1UNlhAeWVghKY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_mPSPdi-LMnoMU9sAImlwPbsToDxPAMJh45EaeOpExA&oe=69D64AB3"}, {"file_name": "MyScore_Screenshot_ShareScreen.png", "id": "717387746296645", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035390_717387749629978_4790814578517743958_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2t92GwLHTuwQ7kNvwEh1TX5&_nc_oc=AdqqGBtZghmUSjBT4YUYOsp7tutn5uYcV1VsQem0nwWoNf1gm6mLFhLaudbbLH8dB-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gpEir-Duv2bkzro2eCXiTLYsjlbmCdmHs2x4t6bvJlg&oe=69D653EC"}, {"file_name": "MyScore_Screenshot_Katschof.png", "id": "474678414392237", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035364_474678417725570_783758256892145906_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGNQWlOi9tIQ7kNvwENAqYO&_nc_oc=AdqfTZBhUOGD-a_9vdnzq66DIWv3PuvEFCYaGrTuB3ZDWVnLpF6UgSUWaiCKPyMoW20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3T7G_v63v5fT4fEm4BdpHWDRxtwYMhSGftrHUODKbluA&oe=69D6624E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MyScore_CoverImage.png", "id": "499263285020989", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982708_499263288354322_3563349829886586096_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC5SNTsDIEQQ7kNvwFtmcyL&_nc_oc=AdohSiX5Ibz5oy59JCPsb49OHf3c3WagBhfahPMou6IXpv_j8JmQHZpqHUskiYZQnKI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PcdY_SxlYZi_EW2H-Ib1mDUIIrUJhBzJVkLz1wYQC2Q&oe=69D651DD"}, "display_name": "MyScore", "keywords": [], "long_description": "In the context of the current pandemic, the limitations of face-to-face teaching, as well as those of hybrid approaches such as blended learning, have also become apparent at many German universities. The greatest disadvantage resulted from the location-dependency of these concepts. The widespread use of videoconferencing software and systems bridges the distances that the Corona crisis has put between teachers and students, but these approaches have their own limitations. The multi-faceted nature of face-to-face teaching cannot be fully represented by such applications, as the two-dimensionality of collaborative interaction cannot represent the true complexity and exchange in traditional teaching situations. Even outside the current global pandemic, especially with regard to international collaborations, the question arises as to what the future of digital teaching looks like and how it can promote exchange between learners and teachers even without presence.", "short_description": "With our open source software for avatar-based teaching and learning in virtual reality, we enable students and lecturers to communicate, teach and learn with each other using avatars and to use a wide variety of teaching and learning scenarios."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vredu.lfi.rwth-aachen.de/en/datenschutz/", "developer_terms_of_service_url": null, "publisher_name": "RWTH Aachen LFI", "support_website_url": null, "website_url": "https://vredu.lfi.rwth-aachen.de/en/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languag
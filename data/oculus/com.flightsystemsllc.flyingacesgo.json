7kNvwHtvKx-&_nc_oc=AdoL1JvlOuHYBRXNV0ELkbnAL2luuWMeCoqsfq-Owpd6pO_0CE684WCBdkU7zAr2HYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4x8LuoptAGHWqaulblf9v2Lee9gRBr7hR-tl0xk__cIA&oe=6A1D9728"}, {"file_name": "migrated_image.png", "id": "201299934426546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982705_2240486472870773_1224532761348407296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0ek1xIlg4AQ7kNvwGnhuhh&_nc_oc=AdqlW3m8YBLjjSjcLfcw8crsQQJhDVY-d3dujJPik4NMLPF7y_ne6pwVDhwhSgQVTyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5n3VgMufxW_4jSAmdyeMJP4Z4mIkpyZfyFg3pFK0GKeg&oe=6A1DAF62"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/1u2hg1", "id": "306922216927954", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974479_306922220261287_3494691593129033728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vyf_UIvntUQ7kNvwG2tQaE&_nc_oc=AdojRunudOmvCCpUkUSVChNWUY3kCFRZaWCJfDgONn1HNfgmXkm1COWqao2JPN_qzGE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7P1XhmPvbvYfOWlgusjZCABA4U86JE8oxHBN73MFIrnw&oe=6A1D9B9F"}, "display_name": "Flying Aces: Navy Pilot Simulator", "keywords": ["Flight", "Simulator", "Simulation", "Aircraft", "Plane"], "long_description": "Flying Aces is a story based virtual reality experience unlike any other. You will experience what it\u2019s like to train to become a navy pilot. As gamers, we search for experiences that aren\u2019t possible in our daily lives. With Navy Pilot Simulator, we\u2019re able to bring the armchair pilot into the cockpit of a fighter jet. \n\nThe Oculus Go allows us to create an experience that previous generations of hardware aren\u2019t capable of. Conquering the game will require a skillset of hand eye coordination, decision making, and a tough stomach. You start out as a low ranked Ensign (below a junior lieutenant) tasked with learning the functionality of the F-18 Super Hornet. As you progress through the ranks, the missions become more challenging.\n\nFeatures:\n- Campaign with choice based missions\n- Combat Theater Mode\n- Landing Competition Mode\n- Free Flight Mode\n- Optimized Specifically for the Oculus Go\n- And more!", "short_description": "Flying Aces is a story based virtual reality experience unlike any other. You will experience what it\u2019s like to train to become a navy pilot. As gamers, we search for experiences that aren\u2019t possible in our daily lives. With Navy Pilot Simulator, we\u2019re able to bring the armchair pilot into the cockpit of a fighter jet."}]}, "developer_name": "TAS Systems Corp", "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "http://www.flightsystemsllc.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472797544571205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982467_2395243027204915_2735773453201178624_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uUw2agg6NjQQ7kNvwHhbUzU&_nc_oc=AdpJTUYsHr7Y5nMSKtq7VYjvHU-Pw3z1EHdqG97-xcW-C5JuVwL1GRjSoyfoALI2C7g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oAnTP9w5_WQAV2w0yzsnEspmHs9YTEJikJcTdyiOrBw&oe=6A1D9F5B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": fal
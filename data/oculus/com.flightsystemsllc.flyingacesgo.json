.com/v/t64.5771-25/38974641_902061403519016_4600076081876172800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HL7vQKEzNIcQ7kNvwEuKSKf&_nc_oc=AdpU0fmBv1LZ6-LXWZdAh5Oo02qdwHKIErC3a_reTxUrKys8B24CPoULVkYlXgY0fjs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4cZeWzK6NopdvkhN6Hk3pGcKLPYcpswSfwVDiXbVwAw&oe=6A53A4A8"}, {"file_name": "migrated_image.png", "id": "201299934426546", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982705_2240486472870773_1224532761348407296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SNCQ2XTsFnkQ7kNvwHmdElt&_nc_oc=Adq6y5JrOzK61sD7S3VIuRC98vTzAGTrIamc9cW7pEs1exk4uv0z7uF0XhSiGVc1zJM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs5INa482GLs8nNtZ0p7ICAmUVucVDcDpPTadNM31_9Q&oe=6A5384A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/1u2hg1", "id": "306922216927954", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974479_306922220261287_3494691593129033728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WAe8YPPh_YQ7kNvwF2-9Zv&_nc_oc=AdpSYD9fp_AAuiRvndBXPxCRb3qBs9jsw3YLN3KmzQV8-zyLLB296a0BCCG2cuc4Q3M&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvo9QBMMEHU1gelG0PW23YKo3v2Qtvz4z2mVnqyDd4dQ&oe=6A53A91F"}, "display_name": "Flying Aces: Navy Pilot Simulator", "keywords": ["Flight", "Simulator", "Simulation", "Aircraft", "Plane"], "long_description": "Flying Aces is a story based virtual reality experience unlike any other. You will experience what it\u2019s like to train to become a navy pilot. As gamers, we search for experiences that aren\u2019t possible in our daily lives. With Navy Pilot Simulator, we\u2019re able to bring the armchair pilot into the cockpit of a fighter jet. \n\nThe Oculus Go allows us to create an experience that previous generations of hardware aren\u2019t capable of. Conquering the game will require a skillset of hand eye coordination, decision making, and a tough stomach. You start out as a low ranked Ensign (below a junior lieutenant) tasked with learning the functionality of the F-18 Super Hornet. As you progress through the ranks, the missions become more challenging.\n\nFeatures:\n- Campaign with choice based missions\n- Combat Theater Mode\n- Landing Competition Mode\n- Free Flight Mode\n- Optimized Specifically for the Oculus Go\n- And more!", "short_description": "Flying Aces is a story based virtual reality experience unlike any other. You will experience what it\u2019s like to train to become a navy pilot. As gamers, we search for experiences that aren\u2019t possible in our daily lives. With Navy Pilot Simulator, we\u2019re able to bring the armchair pilot into the cockpit of a fighter jet."}]}, "developer_name": "TAS Systems Corp", "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "http://www.flightsystemsllc.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472797544571205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982467_2395243027204915_2735773453201178624_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GjAucjJvya0Q7kNvwF9x3qC&_nc_oc=Ado237NgsiZDqVbS0VuXO5N6OelqjadBm7twaQelNIJwH50I2huDN1OFlZA3FlwT420&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC
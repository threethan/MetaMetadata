oY5ol&_nc_oc=AdoAGktJU8fp8JSwfdb32UBjlZeDibQnoqLuJUFcrJ8pTllzzJQ7OwmkLhsaARJpiLc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45f6YIHhPUFRjv2hiYGTIpoVFvkKnC38j82FDgvhmLTA&oe=6A132362"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/1u2hg1", "id": "306922216927954", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974479_306922220261287_3494691593129033728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDFKcEVwydYQ7kNvwEmLw8X&_nc_oc=AdoTS8LNbJzmTRpI7iC_hrtLDWo8jO1G2fUER5ZuXsN823e4ImqAOFQbV4UToSoCePE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MjftXk8kFtgv8bW-MuORMD1k0ABMpjTKFRTThVCUFDA&oe=6A130F9F"}, "display_name": "Flying Aces: Navy Pilot Simulator", "keywords": ["Flight", "Simulator", "Simulation", "Aircraft", "Plane"], "long_description": "Flying Aces is a story based virtual reality experience unlike any other. You will experience what it\u2019s like to train to become a navy pilot. As gamers, we search for experiences that aren\u2019t possible in our daily lives. With Navy Pilot Simulator, we\u2019re able to bring the armchair pilot into the cockpit of a fighter jet. \n\nThe Oculus Go allows us to create an experience that previous generations of hardware aren\u2019t capable of. Conquering the game will require a skillset of hand eye coordination, decision making, and a tough stomach. You start out as a low ranked Ensign (below a junior lieutenant) tasked with learning the functionality of the F-18 Super Hornet. As you progress through the ranks, the missions become more challenging.\n\nFeatures:\n- Campaign with choice based missions\n- Combat Theater Mode\n- Landing Competition Mode\n- Free Flight Mode\n- Optimized Specifically for the Oculus Go\n- And more!", "short_description": "Flying Aces is a story based virtual reality experience unlike any other. You will experience what it\u2019s like to train to become a navy pilot. As gamers, we search for experiences that aren\u2019t possible in our daily lives. With Navy Pilot Simulator, we\u2019re able to bring the armchair pilot into the cockpit of a fighter jet."}]}, "developer_name": "TAS Systems Corp", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "http://www.flightsystemsllc.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "648150376487610"}}]}, "scheduled_offers": {"count": 55, "nodes": [{"status": "PUBLISHED", "id": "837455170328459"}, {"status": "PUBLISHED", "id": "873530826440798"}, {"status": "PUBLISHED", "id": "1276396052700276"}, {"status": "PUBLISHED", "id": "226063978400719"}, {"status": "PUBLISHED", "id": "1411833382340739"}, {"status": "PUBLISHED", "id": "1745568512252592"}, {"status": "PUBLISHED", "id": "259183881918461"}, {"status": "PUBLISHED", "id": "2451338558299890"}, {"status": "PUBLISHED", "id": "839538760152717"}, {"status": "PUBLISHED", "id": "2348815428766402"}, {"status": "PUBLISHED", "id": "230085578020514"}, {"status": "PUBLISHED", "id": "1667466940098821"}, {"status": "PUBLISHED", "id": "702231084029990"}, {"status": "PUBLISHED", "id": "197708697956721"}, {"status": "PUBLISHED", "id": "507555033359193"}, {"status": "PUBLISHED", "id": "198745044807861"}, {"status": "PUBLISHED", "id": "1100797750256104"}, {"status": "PUBLISHED", "id": "995574057549780"}, {"status": "PUBLISHED", "id": "377917676652000"}, 
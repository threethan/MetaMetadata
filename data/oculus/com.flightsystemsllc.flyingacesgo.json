.com/v/t64.5771-25/38974641_902061403519016_4600076081876172800_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WeGBnqQoUUoQ7kNvwFbt-rV&_nc_oc=AdrHCbwIcQDwYKe0qn3hTG4bK7wUsKCHUKxX-CvMka_EmspjGZ3-o2KtoMObzX6kKg4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAACclvHu4Ukx6F7OOePVZ-APRXws_U5y2CRx2tN0kLPg&oe=6A60D3A8"}, {"file_name": "migrated_image.png", "id": "201299934426546", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982705_2240486472870773_1224532761348407296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ci9kJUg3yAoQ7kNvwHhCp-s&_nc_oc=Adpeid79SZESlR9S_Gp1GeTRYyCa6l4WCenzLeyxn7i-SwvMRqFrtyU-K04tn2EI6OE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9ncI64JLRINUXeN6reom3ptIVDwqLfFoyEtIw4oGYcQ&oe=6A60B3A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/1u2hg1", "id": "306922216927954", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974479_306922220261287_3494691593129033728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KNpHm_d9NsoQ7kNvwGVIN8T&_nc_oc=AdofXfLEXnewCeGTyIHfEb7WGQLq6qInDVrCOxgEODclK6axShLU1q0XQmk9Q3xzRGg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5TXTUO1h4UZ6kA4WXerDSGVMtrU62M5F2uH3YppHPeg&oe=6A60D81F"}, "display_name": "Flying Aces: Navy Pilot Simulator", "keywords": ["Flight", "Simulator", "Simulation", "Aircraft", "Plane"], "long_description": "Flying Aces is a story based virtual reality experience unlike any other. You will experience what it\u2019s like to train to become a navy pilot. As gamers, we search for experiences that aren\u2019t possible in our daily lives. With Navy Pilot Simulator, we\u2019re able to bring the armchair pilot into the cockpit of a fighter jet. \n\nThe Oculus Go allows us to create an experience that previous generations of hardware aren\u2019t capable of. Conquering the game will require a skillset of hand eye coordination, decision making, and a tough stomach. You start out as a low ranked Ensign (below a junior lieutenant) tasked with learning the functionality of the F-18 Super Hornet. As you progress through the ranks, the missions become more challenging.\n\nFeatures:\n- Campaign with choice based missions\n- Combat Theater Mode\n- Landing Competition Mode\n- Free Flight Mode\n- Optimized Specifically for the Oculus Go\n- And more!", "short_description": "Flying Aces is a story based virtual reality experience unlike any other. You will experience what it\u2019s like to train to become a navy pilot. As gamers, we search for experiences that aren\u2019t possible in our daily lives. With Navy Pilot Simulator, we\u2019re able to bring the armchair pilot into the cockpit of a fighter jet."}]}, "developer_name": "TAS Systems Corp", "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "http://www.flightsystemsllc.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472797544571205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982467_2395243027204915_2735773453201178624_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YYBCBmphgX0Q7kNvwFzawv4&_nc_oc=Adqi2CVMS53zN4Ve7wGzYrtaGZT_o6iO5uUp-eYFQ2QLIKWD_fJ6EuL-edAEAFdRBeA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD
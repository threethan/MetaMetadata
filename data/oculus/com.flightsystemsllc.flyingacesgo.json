gv7gLVGWaA7fCv1QrbdwV4cPwsP_Q&oe=69B02AA8"}, {"file_name": "migrated_image.png", "id": "201299934426546", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982705_2240486472870773_1224532761348407296_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh9FHzhzhocQ7kNvwF46SoU&_nc_oc=AdkbPPq7OXDUcdslVWHcc9jc0MKxnaCsdBRADy2BO7F6ey52uVQvhD07FpkePJdvNG8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_2ZTIR827b9Qbqn0Kuf-gvpeiQ_zIVu9GDCSHcs1pMQ&oe=69B00AA2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/1u2hg1", "id": "306922216927954", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_306922220261287_3494691593129033728_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9qBOyZ6leIQ7kNvwHUeZJi&_nc_oc=AdloYqQX8Nu_FScyzutJ_TPIFdVj1AQkyfBzPkbtiCPNGqqDq6vHARP8g-KYUP-L2Eg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxehfEpjVqlbcdqskolQrJhWEo5Wf39cLmUL3vdz7bTQQ&oe=69AFF6DF"}, "display_name": "Flying Aces: Navy Pilot Simulator", "keywords": ["Flight", "Simulator", "Simulation", "Aircraft", "Plane"], "long_description": "Flying Aces is a story based virtual reality experience unlike any other. You will experience what it\u2019s like to train to become a navy pilot. As gamers, we search for experiences that aren\u2019t possible in our daily lives. With Navy Pilot Simulator, we\u2019re able to bring the armchair pilot into the cockpit of a fighter jet. \n\nThe Oculus Go allows us to create an experience that previous generations of hardware aren\u2019t capable of. Conquering the game will require a skillset of hand eye coordination, decision making, and a tough stomach. You start out as a low ranked Ensign (below a junior lieutenant) tasked with learning the functionality of the F-18 Super Hornet. As you progress through the ranks, the missions become more challenging.\n\nFeatures:\n- Campaign with choice based missions\n- Combat Theater Mode\n- Landing Competition Mode\n- Free Flight Mode\n- Optimized Specifically for the Oculus Go\n- And more!", "short_description": "Flying Aces is a story based virtual reality experience unlike any other. You will experience what it\u2019s like to train to become a navy pilot. As gamers, we search for experiences that aren\u2019t possible in our daily lives. With Navy Pilot Simulator, we\u2019re able to bring the armchair pilot into the cockpit of a fighter jet."}]}, "developer_name": "TAS Systems Corp", "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": null, "website_url": "http://www.flightsystemsllc.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "472797544571205"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982467_2395243027204915_2735773453201178624_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0sl-YawNN3IQ7kNvwFVGM36&_nc_oc=Adlz2AdiV_Y_VX0OcisJIQXBEFHFxod7Uz60aSrYfaxz39N1SxJ9leStvgTNMfe5C98&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8Qqu4B6-iBbRlMl8W2YX6_yo0x-to8t3J43GC01UWfA&oe=69AFFA9B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Flying Aces: Navy Pilot Simulator", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1560358800, "lastRevision": {"nodes":
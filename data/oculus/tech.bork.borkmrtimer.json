1-7&_nc_sid=6e7a0a&_nc_ohc=LDHD8KvHEyoQ7kNvwFDvReu&_nc_oc=AdqiMrKD6A0WdKIZddZ_lGibL_kLVe0Ms0PZpASILKwBHCjTdsIPYzLBfJDAJMz9GNs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiT9vBBQfjBxIBQC895uKMDCVO6Ky4vEpXwYGnFNSxhw&oe=6B031DB3"}, {"file_name": "Screenshot4---timer.png", "id": "3591485597778670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982585_3591485601112003_8991231896154520076_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TFZS7V7WU_MQ7kNvwGtQCfO&_nc_oc=AdoYlTc5U8Mzq6lUS1fJRNGuz80z8rOEx0f73DHuuUT-IFHOkn5p9E_l_D0wjJSuKik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJzqRwIm97hei_kSknTYYo9sYRSH69hTNedaKaiOr0xg&oe=6B0330C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot0---timer.png", "id": "255996280877163", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984449_255996287543829_9086772370733880197_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P0dY-Vw0AI8Q7kNvwEX7caQ&_nc_oc=AdqVCuPoUpS5bcIet1z0vSOsiv2hfVOPLV6yhk82IvReUngyQ7NIf2XDde886i4Z5dM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRD99tXI-6EP3oYAm9rLVVMMYCEEWUo0-k1nKstzRb2lw&oe=6B0329CC"}, "display_name": "BorkMR - Timer", "keywords": [], "long_description": "Greeting & Salutations Human!\n\nBehold, the BorkMR Timer a MIXED REALITY Timer \u2013 a marvel of modern technology with more tricks up its digital sleeve than you'd expect:\n(lol it's a basic timer but in the \"metaverse\")\n\n\u2022 Easily set your desired time limit \u2013 because let's face it, time doesn't wait for anyone.\n\u2022 Engage the \"start\" button and witness the passage of time as it slips through your grasp.\n\u2022 Need to catch your breath? No worries! Pause the timer and take a breather.\n\u2022 Reset and restart whenever your plans go slightly off the rails.\n\u2022 And for the grand finale, an alarm sound that will pique your attention like a master conductor. Missed deadlines? Not here!\n\nThis demo uses <color=green>Hand Tracking</color> first \n\n\u2022 Use the purple bar on the bottom to <color=green>Grab and Move</color> the Timer panel\n\u2022 Use your hands to interact with the buttons on the Timer\n\u2022 Use the <color=green>Left Hand Menu</color> to add more Timer panels\n\nAny Feedback?\nLet Me Know What You Think!\n\n<color=green>feedback@bork.tech</color>", "short_description": "Behold, the BorkMR Timer a MIXED REALITY Timer \u2013 a marvel of modern technology with more tricks up its digital sleeve than you'd expect:"}]}, "developer_name": null, "developer_privacy_policy_url": "https://bork.tech/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "BorkTech", "support_website_url": null, "website_url": "https://bork.tech/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "6758079857613574"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1820507738930587"}, {"status": "PUBLISHED", "id": "171030749399558"}]}, "baseline_offer": {"id": "1820507738930587"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1785260340, "status": "PUBLISHED", "id": "1820507738930587"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9201481546606714", "version": "0.6"}, "id": "1299041700746767", "channel_name": "L
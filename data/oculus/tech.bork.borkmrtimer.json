5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zSbSTCs4WpJheed1R39w1xcrYRQLfwiTnM3j_sBa4zg&oe=6A15BEAD"}, {"file_name": "Screenshot4---timer_v2.png", "id": "516075657552995", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974816_516075660886328_5238560819027724955_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ksV-T0AXup0Q7kNvwEeAvrn&_nc_oc=Adr8bJjsu4op_IhKwZuTeeTIwu6yy5o8bm61FfqtEXzkFr4Zi0puJ2zHgRCOArLhs-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70CP2ONg1G766hq-kA-UviaSb7ahQtSOqrwFa8xg5LFQ&oe=6A15A88B"}, {"file_name": "Screenshot2---timer_v2.png", "id": "1865502913877498", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75195906_1865502917210831_1247336392415744841_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGS2PDIctJMQ7kNvwGzkv45&_nc_oc=AdqQXB2kE07qGGZspw0sSwXbpVh46R9NuITp1n-35fmWMWwr7e2joulf4pAswzCDdk0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GCvZZoVNdVTCPZUNgZCd-BwPVGjvS0sPSTn9A4LH_2w&oe=6A15BC21"}, {"file_name": "Screenshot5---timer_v2.png", "id": "505123855207363", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_505123858540696_9037161498573919233_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CB1FIFnHdrcQ7kNvwFMno63&_nc_oc=AdqgEhtOmN0hT1sM4hxrZnj27yRX0B2RnR750qixf1fNG9yfaGUWk63aN60UoWVOeRY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40-1k0ZCU2VlpUdEmdwsZoWE7Pezrp1RbXSRk2L_upng&oe=6A158F45"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot3---timer_v2.png", "id": "516568480843785", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75245824_516568484177118_7670382255718439260_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhPi8O5IEsYQ7kNvwGMZ0FU&_nc_oc=Adrq3nPyqPbIWZZNrUNuH4lNsBWVat1fD2roaMGzzvNZnbs3Z0bcnItJxMvSA1nGREQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4n6M94oCz0hCyNcu8c3VgUczkBKl6jrdMdAf1mDkfY-A&oe=6A158F27"}, "display_name": "BorkMR - Timer", "keywords": ["timer"], "long_description": "# Greetings & Salutations, Human!\n\n## Behold, the **Bork Mixed Reality Timer** by **Borked Reality**\n\nA marvel of modern technology with more tricks up its digital sleeve than you'd expect:  \n_(It\u2019s a basic timer but in the \"metaverse\")_\n\n**Important:** Controllers do not work. Hand tracking must be enabled to use this timer.\n\n\n### Instructions for Use:\n\n- Use your hands to interact with the timer buttons.\n- Set your desired time and hit the **Start** button to begin.\n- You can also **Pause** the timer when it is running.\n- **Reset** the timer by holding down the **Start/Pause** button.\n- Grab and move the timer panel with the **Purple Bar** at the bottom.\n- Use the **`<`** and **`>`** buttons to collapse and expand the side panels.\n- Add more timer panels using the **Left Hand Menu**.\n\n### Left Side Panel:\n\n- Close the panel with the **X** button.\n- Open settings with the **Gear** button.\n- Lock or unlock the timer panel with the **Lock/Unlock** button.\n\n### Right Side Panel:\n\n- Use the **`+`** and **`-`** buttons to increase or decrease the time.\n- Use the **Middle Button** to switch between minutes, seconds, and hours for the **`+`** and **`-`** buttons.\n\n### Settings:\n\n- Switch between **Dark and Light mode**.\n- Adjust the **Opacity** of the panel.\n\n---\n\n**Any Feedback? Let Us Know What You Think!**\n\n**https://discord.gg/xvN3mMFGky**", "short_description": "Behold, the BorkMR Timer a MIXED REALITY Timer \u2013 a marvel of modern technology with more tricks up its digital sleeve than you'd expect:"}]}, "developer_name": null, "developer_privacy_policy_url": "https://borkedreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Borked Reality", "support_website_url": "https://bork.tech/contact/", "website_url": "https://borkedreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114428
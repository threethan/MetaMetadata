3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNLJclsdhJy6lGs9umZvXtGNvT1eVMS7XK2-9wcHviRw&oe=6A64A06D"}, {"file_name": "Screenshot4---timer_v2.png", "id": "516075657552995", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974816_516075660886328_5238560819027724955_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2S_tEIOzeVAQ7kNvwG3EYTY&_nc_oc=AdqHAw76cJLP3cbOfhQ12Eqnh9eg0LRvquQvpHELejC3OaWC8CDUs8hEwqIhcDnVR4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnqUNCSqVD3SQ9GWCdCvWiAZa3fr96x79laDGPuUu1vA&oe=6A64C28B"}, {"file_name": "Screenshot2---timer_v2.png", "id": "1865502913877498", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75195906_1865502917210831_1247336392415744841_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y59ArHYzNhAQ7kNvwECA33_&_nc_oc=Adpl1U9u3C4o9146dcMze1kFL3spWq-nFJ-OVN7wXODTPQsRTSPJnsicGlJsu_jOBPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALlv8qKyi-RH3Vb_OVBGyrc4FFCXenhWM74wP_-HtfjA&oe=6A649DE1"}, {"file_name": "Screenshot5---timer_v2.png", "id": "505123855207363", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974640_505123858540696_9037161498573919233_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVeZrcpxLGIQ7kNvwHySpNi&_nc_oc=AdoybPYohWEoMpncQn4Mvn-VabfDmMUJRf2BMBpHHdl35KI69lisWzg2TVmbDl5JomM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAehwTz67SLC6e3iG3yOX0lrLinuexzrqclct6PvGLw6g&oe=6A64A945"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot3---timer_v2.png", "id": "516568480843785", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75245824_516568484177118_7670382255718439260_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4hBo-Z4eQYQ7kNvwE_5Mb1&_nc_oc=AdrPuBz75W7gTfY0PYZYMJWw8zi6Oi-q45hqGD7y483-vc_fG10St_U0r-vAoGnwd3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCxedOkIdXiv6iILKs3tUjjUYiQg0anLQKjR-6JiGPRQ&oe=6A64A927"}, "display_name": "BorkMR - Timer", "keywords": ["timer"], "long_description": "# Greetings & Salutations, Human!\n\n## Behold, the **Bork Mixed Reality Timer** by **Borked Reality**\n\nA marvel of modern technology with more tricks up its digital sleeve than you'd expect:  \n_(It\u2019s a basic timer but in the \"metaverse\")_\n\n**Important:** Controllers do not work. Hand tracking must be enabled to use this timer.\n\n\n### Instructions for Use:\n\n- Use your hands to interact with the timer buttons.\n- Set your desired time and hit the **Start** button to begin.\n- You can also **Pause** the timer when it is running.\n- **Reset** the timer by holding down the **Start/Pause** button.\n- Grab and move the timer panel with the **Purple Bar** at the bottom.\n- Use the **`<`** and **`>`** buttons to collapse and expand the side panels.\n- Add more timer panels using the **Left Hand Menu**.\n\n### Left Side Panel:\n\n- Close the panel with the **X** button.\n- Open settings with the **Gear** button.\n- Lock or unlock the timer panel with the **Lock/Unlock** button.\n\n### Right Side Panel:\n\n- Use the **`+`** and **`-`** buttons to increase or decrease the time.\n- Use the **Middle Button** to switch between minutes, seconds, and hours for the **`+`** and **`-`** buttons.\n\n### Settings:\n\n- Switch between **Dark and Light mode**.\n- Adjust the **Opacity** of the panel.\n\n---\n\n**Any Feedback? Let Us Know What You Think!**\n\n**https://discord.gg/xvN3mMFGky**", "short_description": "Behold, the BorkMR Timer a MIXED REALITY Timer \u2013 a marvel of modern technology with more tricks up its digital sleeve than you'd expect:"}]}, "developer_name": null, "developer_privacy_policy_url": "https://borkedreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Borked Reality", "support_website_url": "https://bork.tech/contact/", "website_url": "https://borkedreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114428
3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p2IA5euyWWy_Z8rbraKn3K0GxH3n5VYvACee4NVWM1w&oe=6A09E12D"}, {"file_name": "Screenshot4---timer_v2.png", "id": "516075657552995", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974816_516075660886328_5238560819027724955_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EbdvLnlVLJgQ7kNvwH6sG0M&_nc_oc=Adp4tt69lOz4CpvE8gq-S3dUpgdJByFYs8qwx_Tgvi2CO1Hi4iF_H-mbQQLLrUldBnY&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XDeVFRdVitxo3-MjZPI1XQ8xU4dFN-jq1lTkUg_xv1g&oe=6A09CB0B"}, {"file_name": "Screenshot2---timer_v2.png", "id": "1865502913877498", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75195906_1865502917210831_1247336392415744841_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLipkDB9GTEQ7kNvwGOCvtW&_nc_oc=Adoe99g4-sC4DIe32Rhx5bGb_pQSSPEOqEmb1gVO4v8fFLCRkmLu6DIywQjUhqWyW7o&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4laCeeYDbslFHUsLiZtUGMNcxvO5VU6QeCjUxp2rQYXg&oe=6A09DEA1"}, {"file_name": "Screenshot5---timer_v2.png", "id": "505123855207363", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974640_505123858540696_9037161498573919233_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovgBeWLTZt4Q7kNvwFahEMq&_nc_oc=AdoMqGUfU3LINbFyt-qutxrpkKNktbmROsSJwhAZy7W6y3EwqiG0mtowIKa2ZbpnCz0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oFtYT4Nt_WHDPGdEYfMgKpmM5gCu1D-Ku908p84mk5w&oe=6A09B1C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Screenshot3---timer_v2.png", "id": "516568480843785", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75245824_516568484177118_7670382255718439260_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MLKHdsCCSkgQ7kNvwFaWjeg&_nc_oc=Adrw6nD5HuveGAnWRo4y72H3XKkmzbG5txy92F3mcG38RE41Zd2lfeXnu2xmFaItdxQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b-vW3oezjbZOoAX6YArm-CrCUpoN7cTCv1dJS1VlQCQ&oe=6A09B1A7"}, "display_name": "BorkMR - Timer", "keywords": ["timer"], "long_description": "# Greetings & Salutations, Human!\n\n## Behold, the **Bork Mixed Reality Timer** by **Borked Reality**\n\nA marvel of modern technology with more tricks up its digital sleeve than you'd expect:  \n_(It\u2019s a basic timer but in the \"metaverse\")_\n\n**Important:** Controllers do not work. Hand tracking must be enabled to use this timer.\n\n\n### Instructions for Use:\n\n- Use your hands to interact with the timer buttons.\n- Set your desired time and hit the **Start** button to begin.\n- You can also **Pause** the timer when it is running.\n- **Reset** the timer by holding down the **Start/Pause** button.\n- Grab and move the timer panel with the **Purple Bar** at the bottom.\n- Use the **`<`** and **`>`** buttons to collapse and expand the side panels.\n- Add more timer panels using the **Left Hand Menu**.\n\n### Left Side Panel:\n\n- Close the panel with the **X** button.\n- Open settings with the **Gear** button.\n- Lock or unlock the timer panel with the **Lock/Unlock** button.\n\n### Right Side Panel:\n\n- Use the **`+`** and **`-`** buttons to increase or decrease the time.\n- Use the **Middle Button** to switch between minutes, seconds, and hours for the **`+`** and **`-`** buttons.\n\n### Settings:\n\n- Switch between **Dark and Light mode**.\n- Adjust the **Opacity** of the panel.\n\n---\n\n**Any Feedback? Let Us Know What You Think!**\n\n**https://discord.gg/xvN3mMFGky**", "short_description": "Behold, the BorkMR Timer a MIXED REALITY Timer \u2013 a marvel of modern technology with more tricks up its digital sleeve than you'd expect:"}]}, "developer_name": null, "developer_privacy_policy_url": "https://borkedreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Borked Reality", "support_website_url": "https://bork.tech/contact/", "website_url": "https://borkedreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "3626922114428
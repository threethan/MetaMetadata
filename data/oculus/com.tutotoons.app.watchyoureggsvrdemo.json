n.com&_nc_ss=7f20f&oh=00_AQQzTv6sqN_gTsO-a7kCAH5GzFK-rntESKMw8R8uqgjCeA&oe=6AFF2900"}, {"file_name": "4-Scr_2560x1440.png", "id": "897834472003710", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39031620_897834475337043_3641443759314478482_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSYpPgVtK50Q7kNvwELhVVi&_nc_oc=AdpuegIZZrbwfWELJnVghFKvDr8KMwhVwVCl_uLJ16izK76zJwrTnpK2suDKmCZcdNc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbXOE1vNOZTbsBPXbxi3T_I-EPljmI41dYegQ29UB06Q&oe=6AFF26E7"}, {"file_name": "5-Scr_2560x1440.png", "id": "667460385353080", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974499_667460388686413_1680631719444613738_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feLpXSmZkv8Q7kNvwGIWyNM&_nc_oc=Adqr3EdR7HbwHZ5KLJhtOZF4EQDSCGi3G7-Ve5cQRWtbFsu6YAyOUtmtVZDw74hiy-M&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIMEjiUJh1injDAMyufLvSeN5yyWlWJEIiWJe2gdmxbg&oe=6AFF211B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail-2560x1440.png", "id": "369103632712908", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75318181_369103639379574_6433273081839844129_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a34qr-drLcYQ7kNvwEE2JCO&_nc_oc=AdohSwgUMSSDVZUP_WNxHvLUjXev_2muH2gV5iKhWves0vOxR85cU_U6Tiyc0w_A1aU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnsJFoNj2u5MFRLmsHXGVQ_JQjX9X0R7JeKHS1BUzf2A&oe=6AFF109B"}, "display_name": "Watch Your Eggs Survival VR Demo", "keywords": [], "long_description": "Dive into the heart-pounding world of Watch Your Eggs! VR, where survival is your only option. Step into the shoes of Agent Pops, who's on a crucial mission to protect the unhatched Frostwing Penguins' eggs from relentless Icy Land creatures seeking to steal them. Strategize your every move, arm yourself with upgradeable weapons, gather an extraordinary team of penguin allies, and fight off the waves of furious enemies together!\n\nYOU\u2019RE ON A MISSION\nThe Penguin Egg Watch Agency (PEWA) is an impressive headquarters deep within the heart of Frostwing Kingdom. Hidden from prying eyes, it's a marvel of engineering and ingenuity. Inside, a team of engineers works tirelessly, creating innovative weapons to eliminate Icy Land Creatures and safeguard the Frostwing community.\n\nYour mission is clear \u2013 use all the tools you have to protect each unhatched penguin egg.\n\nCREATE A SQUAD OF PENGUIN ALLIES\nThe more eggs you save, the stronger you become! Each egg hatches into an active squad member, possessing impressive fighting abilities. They have it all \u2013 from expert target detection and close combat mastery to the power of healing energy and wizard protection to aid you in this fierce battle for penguins\u2019 future.\n", "short_description": "Experience the thrilling world of Watch Your Eggs! VR, an action-packed first-person shooter game. As Agent Pops, your mission is to protect unhatched Frostwing Penguin eggs from wild Icy Land creatures. Plan your strategy, equip yourself with powerful weapons, and face the wave of furious enemies!\n"}]}, "developer_name": "TutoTOONS", "developer_privacy_policy_url": "https://tutotoons.com/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "TutoTOONS", "support_website_url": null, "website_url": "https://tutotoons.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
_oc=Adm_w_SKQZcJ1FBM9UpNDaOBVUB6LepkMAQ4XMOsHsEA8NpGGuUjPLNno_Re6AhtQZg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-HGte41K_W4MYRQ-gjT0cyPJN6KltzoBJjAWdkCd5cA&oe=69B6A927"}, {"file_name": "5-Scr_2560x1440.png", "id": "667460385353080", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974499_667460388686413_1680631719444613738_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bAOc8u_eEwQ7kNvwE6Hp_1&_nc_oc=Admxo5G_oV4b9trqgI7s8epntvfEhO4-SvWp1Flocnoh4tzqO3JwWk0jG4t0r5szAVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxVbCtilQE91xiWP0J5dohsscWSXqrpoQjMvhq5W31dcA&oe=69B6A35B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail-2560x1440.png", "id": "369103632712908", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75318181_369103639379574_6433273081839844129_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1fHTKf74EQQ7kNvwH756jT&_nc_oc=Adnwgz_hJh9XXimZXLlj-xaIDUzqRMRrV9ics1dck3LViPM5ekHIXwlH-uh5UlJXIas&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz_LOHUdduTqxgehplbakyBLrSLq8JwTUN31w1P_Ak2lg&oe=69B692DB"}, "display_name": "Watch Your Eggs Survival VR Demo", "keywords": [], "long_description": "Dive into the heart-pounding world of Watch Your Eggs! VR, where survival is your only option. Step into the shoes of Agent Pops, who's on a crucial mission to protect the unhatched Frostwing Penguins' eggs from relentless Icy Land creatures seeking to steal them. Strategize your every move, arm yourself with upgradeable weapons, gather an extraordinary team of penguin allies, and fight off the waves of furious enemies together!\n\nYOU\u2019RE ON A MISSION\nThe Penguin Egg Watch Agency (PEWA) is an impressive headquarters deep within the heart of Frostwing Kingdom. Hidden from prying eyes, it's a marvel of engineering and ingenuity. Inside, a team of engineers works tirelessly, creating innovative weapons to eliminate Icy Land Creatures and safeguard the Frostwing community.\n\nYour mission is clear \u2013 use all the tools you have to protect each unhatched penguin egg.\n\nCREATE A SQUAD OF PENGUIN ALLIES\nThe more eggs you save, the stronger you become! Each egg hatches into an active squad member, possessing impressive fighting abilities. They have it all \u2013 from expert target detection and close combat mastery to the power of healing energy and wizard protection to aid you in this fierce battle for penguins\u2019 future.\n", "short_description": "Experience the thrilling world of Watch Your Eggs! VR, an action-packed first-person shooter game. As Agent Pops, your mission is to protect unhatched Frostwing Penguin eggs from wild Icy Land creatures. Plan your strategy, equip yourself with powerful weapons, and face the wave of furious enemies!\n"}]}, "developer_name": "TutoTOONS", "developer_privacy_policy_url": "https://tutotoons.com/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "TutoTOONS", "support_website_url": null, "website_url": "https://tutotoons.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24722635944049559"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "750218950360073"}]}, "baseline_offer": {"id": "750218950360073"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1708326660, 
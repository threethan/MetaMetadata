n.com&_nc_ss=7f30f&oh=00_AQRFL2eU7FwJqLdkKj-ZoYeS3RZTvRlUOREkoqEGlrQUHw&oe=6B0DA980"}, {"file_name": "4-Scr_2560x1440.png", "id": "897834472003710", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031620_897834475337043_3641443759314478482_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa_D9xo0jOgQ7kNvwGjgpUv&_nc_oc=Ado5sADcKsD2dH91UTcTq4ohmw5DcopLEuG7wvAGrBefuGGPQcoLDMkcLfzT9V3tpSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRahYi2fRAst6kOPiAIwytxVmw8oxdzSU-NplFBRdqJ4A&oe=6B0DA767"}, {"file_name": "5-Scr_2560x1440.png", "id": "667460385353080", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974499_667460388686413_1680631719444613738_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpohFfvPQLYQ7kNvwH2AiAL&_nc_oc=AdodeSC9hsj8EcyNFZTxYKM11yP8Ag4EoyBUZiZK2p_uhLu6n4sJRBtHJ2OnsI-oa2U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRqeubXdMwWODgc_SIpqlZtDHPANaAcTEXXE30F9yc4aA&oe=6B0DA19B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail-2560x1440.png", "id": "369103632712908", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75318181_369103639379574_6433273081839844129_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9GKKp_hsKYQ7kNvwGtwI5J&_nc_oc=Adoz4FPj4FEsR-dzqIe4NKmx-qnJm_yScP4mHJhes1gZqxWBT-KcmZ9T6zXzrngZ9Fs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNAjdzbSYkD57tEPPf_sL-LgOkVcO3sQT-ek2dY4F4KQ&oe=6B0DC95B"}, "display_name": "Watch Your Eggs Survival VR Demo", "keywords": [], "long_description": "Dive into the heart-pounding world of Watch Your Eggs! VR, where survival is your only option. Step into the shoes of Agent Pops, who's on a crucial mission to protect the unhatched Frostwing Penguins' eggs from relentless Icy Land creatures seeking to steal them. Strategize your every move, arm yourself with upgradeable weapons, gather an extraordinary team of penguin allies, and fight off the waves of furious enemies together!\n\nYOU\u2019RE ON A MISSION\nThe Penguin Egg Watch Agency (PEWA) is an impressive headquarters deep within the heart of Frostwing Kingdom. Hidden from prying eyes, it's a marvel of engineering and ingenuity. Inside, a team of engineers works tirelessly, creating innovative weapons to eliminate Icy Land Creatures and safeguard the Frostwing community.\n\nYour mission is clear \u2013 use all the tools you have to protect each unhatched penguin egg.\n\nCREATE A SQUAD OF PENGUIN ALLIES\nThe more eggs you save, the stronger you become! Each egg hatches into an active squad member, possessing impressive fighting abilities. They have it all \u2013 from expert target detection and close combat mastery to the power of healing energy and wizard protection to aid you in this fierce battle for penguins\u2019 future.\n", "short_description": "Experience the thrilling world of Watch Your Eggs! VR, an action-packed first-person shooter game. As Agent Pops, your mission is to protect unhatched Frostwing Penguin eggs from wild Icy Land creatures. Plan your strategy, equip yourself with powerful weapons, and face the wave of furious enemies!\n"}]}, "developer_name": "TutoTOONS", "developer_privacy_policy_url": "https://tutotoons.com/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "TutoTOONS", "support_website_url": null, "website_url": "https://tutotoons.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
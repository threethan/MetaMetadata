n.com&_nc_ss=7f20f&oh=00_AQQ-td_RCH9hYmhVEsvip2qxXDWAPG35cSE7dWVlD-k2xA&oe=6B05C080"}, {"file_name": "4-Scr_2560x1440.png", "id": "897834472003710", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031620_897834475337043_3641443759314478482_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IHESgwuMgEQ7kNvwHdMvVp&_nc_oc=AdrNjnQXL3dqDbpAap5JoFrs4gTvyf8CmLP1hhiK9bfBTyvzHBS_DxQwkPAYisiYviE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzLRZ9HJv1cEg0oYozTiM8xubqvHT2Pbc18QqT6oOfwA&oe=6B05BE67"}, {"file_name": "5-Scr_2560x1440.png", "id": "667460385353080", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974499_667460388686413_1680631719444613738_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iR6iyRMhtmoQ7kNvwGUPt0S&_nc_oc=AdqQJiSpcSDdoTI0JUNk2iKixSryqayEVnwdQIBqMr2kOPVXG6AMnbxcpDKozo5NK7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzJ1Gct6WyUrmk8pH90IrT2W3WE7eZOCz3pHSMwJeuBg&oe=6B05B89B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail-2560x1440.png", "id": "369103632712908", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75318181_369103639379574_6433273081839844129_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uTI12SYkOUQ7kNvwEaZ4fQ&_nc_oc=AdqxQjVJHFOMCJCoxI6gyFCuzDT2c6Xx8uLN0uzZolUKEg-DSFRG4c1ASHjsx8s227M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdaKLCsRADpyUcoY3ZHw7QHpXk7OPC-Zo5w3c00Gn8qg&oe=6B05A81B"}, "display_name": "Watch Your Eggs Survival VR Demo", "keywords": [], "long_description": "Dive into the heart-pounding world of Watch Your Eggs! VR, where survival is your only option. Step into the shoes of Agent Pops, who's on a crucial mission to protect the unhatched Frostwing Penguins' eggs from relentless Icy Land creatures seeking to steal them. Strategize your every move, arm yourself with upgradeable weapons, gather an extraordinary team of penguin allies, and fight off the waves of furious enemies together!\n\nYOU\u2019RE ON A MISSION\nThe Penguin Egg Watch Agency (PEWA) is an impressive headquarters deep within the heart of Frostwing Kingdom. Hidden from prying eyes, it's a marvel of engineering and ingenuity. Inside, a team of engineers works tirelessly, creating innovative weapons to eliminate Icy Land Creatures and safeguard the Frostwing community.\n\nYour mission is clear \u2013 use all the tools you have to protect each unhatched penguin egg.\n\nCREATE A SQUAD OF PENGUIN ALLIES\nThe more eggs you save, the stronger you become! Each egg hatches into an active squad member, possessing impressive fighting abilities. They have it all \u2013 from expert target detection and close combat mastery to the power of healing energy and wizard protection to aid you in this fierce battle for penguins\u2019 future.\n", "short_description": "Experience the thrilling world of Watch Your Eggs! VR, an action-packed first-person shooter game. As Agent Pops, your mission is to protect unhatched Frostwing Penguin eggs from wild Icy Land creatures. Plan your strategy, equip yourself with powerful weapons, and face the wave of furious enemies!\n"}]}, "developer_name": "TutoTOONS", "developer_privacy_policy_url": "https://tutotoons.com/privacy_policy/", "developer_terms_of_service_url": null, "publisher_name": "TutoTOONS", "support_website_url": null, "website_url": "https://tutotoons.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
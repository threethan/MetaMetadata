04H3qrRmKu1WsEAGewKOgZJoS40kORB0UKa4KMvUzr9BvTboSg6m2762iUc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjE98mFcAoSBv0Yi629YRW63loOtH9YwAYPnYmKwzf4A&oe=6B031847"}, "display_name": "Rebolt VR", "keywords": ["survival", "horror", "maze", "multiplayer", "coop"], "long_description": "Rebolt VR is a first-person survival game. Escape a shifting maze of dark corridors while a monster hunts you: find keys, solve terminals, open the gate and get out before it finds you.\n\n- Move with gorilla locomotion (push off the world with your hands) or the thumbstick, with snap or smooth turning\n- Play solo with AI teammates, or host a room for friends: browse public lobbies, or share a room code for a private one\n- Dozens of gamemodes: Waves, Infection, Overdrive, the Backrooms, PvP Weapon Roulette, Sword Arena and more\n- Grab and throw props, carry and fling other players, swing swords, and tumble with physical ragdolls\n- Voice chat with your room and in-headset comfort options", "short_description": "Survive the Asylum. Escape a dark, shifting maze alone, with AI teammates, or with friends online. Find keys, solve terminals, open the gate and outlast the monster. Join public lobbies or play in private rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rebolt-vr.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WANDERLUV PLATFORMS LLC", "support_website_url": null, "website_url": "https://rebolt-vr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": 
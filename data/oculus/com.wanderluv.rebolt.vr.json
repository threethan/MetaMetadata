nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtedWul7IlgQ7kNvwEt4JsE&_nc_oc=AdoDTU4J7dOgD9WbVg_rH4PJV507fYQAKNH9ESJoUViIc-3e6kc76E1UmCR8eV73uIg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVP7fGo59FTfOdEyJg61uWg7ZMh-zEIBspc_ro8N8Zs0Q&oe=6B0EFFD7"}, {"file_name": "screenshot-2.png", "id": "1747045606572544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_1747045609905877_5952102571237943844_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SL7lxHYRaaMQ7kNvwHfrc4V&_nc_oc=AdrQGnEw1-8hDasQSRD1Mbplbz2BWmN25qSb5B-QbL3gcsyPCRMfdC3CoIWRVa186_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXLcy8nalc3ksM2j8Sm7K-i8ZrefEr4xF3Tow9SWexcAA&oe=6B0EFBC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "key-art-2560x1440.png", "id": "2113241042657178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673573223_2113241045990511_7119844626899437870_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDpDR7WRVpQQ7kNvwFRu7mT&_nc_oc=AdrlhXpFYVtg4QuqgwhaU3cpsfqBYUoZp8DbYpQBuU3NaalOtjmW39koEVWMCyziILA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXQ6pgyUvlvocz_kaGRUYVd73s0XYbyBkQkeXxHEM4JQA&oe=6B0EF5C7"}, "display_name": "Rebolt VR", "keywords": ["survival", "horror", "maze", "multiplayer", "coop"], "long_description": "Rebolt VR is a first-person survival game. Escape a shifting maze of dark corridors while a monster hunts you: find keys, solve terminals, open the gate and get out before it finds you.\n\n- Move with gorilla locomotion (push off the world with your hands) or the thumbstick, with snap or smooth turning\n- Play solo with AI teammates, or host a room for friends: browse public lobbies, or share a room code for a private one\n- Dozens of gamemodes: Waves, Infection, Overdrive, the Backrooms, PvP Weapon Roulette, Sword Arena and more\n- Grab and throw props, carry and fling other players, swing swords, and tumble with physical ragdolls\n- Voice chat with your room and in-headset comfort options", "short_description": "Survive the Asylum. Escape a dark, shifting maze alone, with AI teammates, or with friends online. Find keys, solve terminals, open the gate and outlast the monster. Join public lobbies or play in private rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rebolt-vr.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TezJr", "support_website_url": null, "website_url": "https://rebolt-vr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1443902152132290"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604375581_1440779741344419_4922147910205968162_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KM2baTSbGYQ7kNvwFi4QtL&_nc_oc=AdolhjTDsEm48OtR3MBP8IyEOHyAjRSvdg5a3ScAREpxIeTHTG4eshRsvcx-cleLOJQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXsEaZbVdjg-0VgHTenwLxdUHhGifg18q-EwnQL9rXvA&oe=6B0F00D1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rebolt VR", "platform": "ANDROID_6DOF", "context_category": {"
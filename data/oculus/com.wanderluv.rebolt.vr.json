nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtedWul7IlgQ7kNvwG4riSV&_nc_oc=Adqi6aunMRydnmEyqiccBc-aAc1r9k5EJ-p2WgWqrvpz6bFQls7zeBQQArh-i6cJlvk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRj-CB2XvlNAgIJ5D41EZcyPlgXGZXIopfiFj1bwQJYfg&oe=6B0DAE57"}, {"file_name": "screenshot-2.png", "id": "1747045606572544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1747045609905877_5952102571237943844_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SL7lxHYRaaMQ7kNvwEczDFM&_nc_oc=AdotLV83aksfnRHUTr5rQrrkH7EyLcttQRhPsFxwBLs0kkIeTA-3DR-L2XaT9Fue9QQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDfMGCafXcM4WW_xkplQg9PwD_h8SPq8huG50xel-wCQ&oe=6B0DAA43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "key-art-2560x1440.png", "id": "2113241042657178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673573223_2113241045990511_7119844626899437870_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDpDR7WRVpQQ7kNvwGap39z&_nc_oc=AdpoxWHOiXxv4qGV3_DZOyjMOGaDD4gq4WfLeEf92RfijE4BQwURktc232FL8tKI9QY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1wcU9lhU4GEzdDBhNQMBWw9KTNPF_-jWnFCDpHK6ptg&oe=6B0DA447"}, "display_name": "Rebolt VR", "keywords": ["survival", "horror", "maze", "multiplayer", "coop"], "long_description": "Rebolt VR is a first-person survival game. Escape a shifting maze of dark corridors while a monster hunts you: find keys, solve terminals, open the gate and get out before it finds you.\n\n- Move with gorilla locomotion (push off the world with your hands) or the thumbstick, with snap or smooth turning\n- Play solo with AI teammates, or host a room for friends: browse public lobbies, or share a room code for a private one\n- Dozens of gamemodes: Waves, Infection, Overdrive, the Backrooms, PvP Weapon Roulette, Sword Arena and more\n- Grab and throw props, carry and fling other players, swing swords, and tumble with physical ragdolls\n- Voice chat with your room and in-headset comfort options", "short_description": "Survive the Asylum. Escape a dark, shifting maze alone, with AI teammates, or with friends online. Find keys, solve terminals, open the gate and outlast the monster. Join public lobbies or play in private rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rebolt-vr.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TezJr", "support_website_url": null, "website_url": "https://rebolt-vr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1443902152132290"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604375581_1440779741344419_4922147910205968162_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KM2baTSbGYQ7kNvwHow0T3&_nc_oc=AdqOtX4VqWlKf7gyWjJOUWu5iH_saWM9cma7-4AJmSXdOI9Bruj9kb79KU_bnT-zjTw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTlivcVqMckCWKNwxzW_9MJAP8ZjN3aUX73bcKb7yVbHw&oe=6B0DAF51"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rebolt VR", "platform": "ANDROID_6DOF", "context_category": {"
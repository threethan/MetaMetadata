h turning\n- Play solo with AI teammates, or host a room for friends: browse public lobbies, or share a room code for a private one\n- Dozens of gamemodes: Waves, Infection, Overdrive, the Backrooms, PvP Weapon Roulette, Sword Arena and more\n- Grab and throw props, carry and fling other players, swing swords, and tumble with physical ragdolls\n- Voice chat with your room and in-headset comfort options", "short_description": "Survive the Asylum. Escape a dark, shifting maze alone, with AI teammates, or with friends online. Find keys, solve terminals, open the gate and outlast the monster. Join public lobbies or play in private rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rebolt-vr.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "WANDERLUV PLATFORMS LLC", "support_website_url": null, "website_url": "https://rebolt-vr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "1428942060294966"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3481634982007883"}]}, "baseline_offer": {"id": "3481634982007883"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791836820, "status": "PUBLISHED", "id": "3481634982007883"}]}, "liveChannel": {"nodes": [{"latest_
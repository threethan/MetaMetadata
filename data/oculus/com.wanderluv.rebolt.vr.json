nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zja5Cz7UfOkQ7kNvwHCUd3-&_nc_oc=Adp0g5iKJbK3fs4nk8LSnzvoyv0sufaDniL9tHk0JXNJVpCXD-dKZYGtqZs61VcpXuA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNYBjlyC6NcrpGjyPXHsOerjoU2JpgZyycBdnbf9ncIQ&oe=6B007F57"}, {"file_name": "screenshot-2.png", "id": "1747045606572544", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_1747045609905877_5952102571237943844_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BZwkbt0rn28Q7kNvwF9dJMd&_nc_oc=AdpM1GLeMyHo37EoSmWybQMo81z0zfozSxWY7f00BxHf860pUsXPad2VcHJwPAADP0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQig3rHyBnkqx1uwmSnlJBiqbQiqMrn4rJMG1g-4oOQ6A&oe=6B007B43"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "key-art-2560x1440.png", "id": "2113241042657178", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/673573223_2113241045990511_7119844626899437870_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8Uc-qAzYwEQ7kNvwFjdaPH&_nc_oc=AdrlYNw9ML5XNUFL-pUZ7s_IX3dEv0XZxPrPfWcNCUlppre5-6_Wj0BA8WcRAX3sxFM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK7SCqYjWQsngDGYCzuDgsXgn2hdFcxNdZLqA_cH9jYQ&oe=6B007547"}, "display_name": "Rebolt VR", "keywords": ["survival", "horror", "maze", "multiplayer", "coop"], "long_description": "Rebolt VR is a first-person survival game. Escape a shifting maze of dark corridors while a monster hunts you: find keys, solve terminals, open the gate and get out before it finds you.\n\n- Move with gorilla locomotion (push off the world with your hands) or the thumbstick, with snap or smooth turning\n- Play solo with AI teammates, or host a room for friends: browse public lobbies, or share a room code for a private one\n- Dozens of gamemodes: Waves, Infection, Overdrive, the Backrooms, PvP Weapon Roulette, Sword Arena and more\n- Grab and throw props, carry and fling other players, swing swords, and tumble with physical ragdolls\n- Voice chat with your room and in-headset comfort options", "short_description": "Survive the Asylum. Escape a dark, shifting maze alone, with AI teammates, or with friends online. Find keys, solve terminals, open the gate and outlast the monster. Join public lobbies or play in private rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rebolt-vr.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TezJr", "support_website_url": null, "website_url": "https://rebolt-vr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1443902152132290"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604375581_1440779741344419_4922147910205968162_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9raSopLMDl8Q7kNvwGW8j4j&_nc_oc=AdrPMyvjBnPmX52393ngLnBGu6O_eq01g4_zRhhZkZ6ZAA9zvNfraBU6BkDIQrw-wQw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiB-4Lp6c3dN0YbAFma-dq76hRjxx8JC6Do24BA8d62g&oe=6B008051"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rebolt VR", "platform": "ANDROID_6DOF", "context_category": {"
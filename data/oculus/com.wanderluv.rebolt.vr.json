TtoppxkTmWGUE2uHSBHkJ39p1hovTW22oTfoLeH5RogQ&oe=6AF4A1D7"}, {"file_name": "screenshot-2.png", "id": "1747045606572544", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1747045609905877_5952102571237943844_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SswqT_1lXHgQ7kNvwEvEiq4&_nc_oc=Adrd3JNkGK599RtrUXuaqatqohjT7wwx6exhZGhanqxh1BNrLfM0wAfwIbaWvCLQwKY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKVTKyouUtwwzcKJgbWqIQ0y3eCVDYSR_VqFvfmmb9Rg&oe=6AF49DC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "key-art-2560x1440.png", "id": "2113241042657178", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673573223_2113241045990511_7119844626899437870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_N84r5xCswQ7kNvwEyhP9Z&_nc_oc=AdpQ1t3hx4jsob5z-b1jZzvsb1_f6yIdwSltmNHiHBcVHYoGV0qwFBpHGoUHl5_CWKw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTQWHoBm2b_C8_d1NMivE79dQk5ygxAnUBtLFHnOl1WA&oe=6AF497C7"}, "display_name": "Rebolt VR", "keywords": ["survival", "horror", "maze", "multiplayer", "coop"], "long_description": "Rebolt VR is a first-person survival game. Escape a shifting maze of dark corridors while a monster hunts you: find keys, solve terminals, open the gate and get out before it finds you.\n\n- Move with gorilla locomotion (push off the world with your hands) or the thumbstick, with snap or smooth turning\n- Play solo with AI teammates, or host a room for friends: browse public lobbies, or share a room code for a private one\n- Dozens of gamemodes: Waves, Infection, Overdrive, the Backrooms, PvP Weapon Roulette, Sword Arena and more\n- Grab and throw props, carry and fling other players, swing swords, and tumble with physical ragdolls\n- Voice chat with your room and in-headset comfort options", "short_description": "Survive the Asylum. Escape a dark, shifting maze alone, with AI teammates, or with friends online. Find keys, solve terminals, open the gate and outlast the monster. Join public lobbies or play in private rooms."}]}, "developer_name": null, "developer_privacy_policy_url": "https://rebolt-vr.vercel.app/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "TezJr", "support_website_url": null, "website_url": "https://rebolt-vr.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "MULTI_USER", "MULTI_USER", "CO_OP"], "id": "1443902152132290"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604375581_1440779741344419_4922147910205968162_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3w1DroaPNXsQ7kNvwH303W3&_nc_oc=AdoQRl7e8o8ttCb9SzqEnVCSEaqrlGd02whd9yjinc58M3n1L44VFtWcGe2stCIamEg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGRldIOPAaE583rHJV9wWUTNZCmRi28tPZCFED_X22fw&oe=6AF4A2D1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Rebolt VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Survival", "id": "644354873106712"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1791836820, "lastRevision": {"nodes": [{"id": "142894207029496
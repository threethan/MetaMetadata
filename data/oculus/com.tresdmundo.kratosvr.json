humbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1075695298429395", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/773875811_1075695301762728_6076258855426394050_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mg4Q9U8y5d4Q7kNvwEoXgds&_nc_oc=AdoCiw3FrHQEE-m7IyzbEWwGuQ7Mg9dgextI3p_oiM-NqvoaMWwz0b-mc8aA8v7R52E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfk75XfCzq9lDmzGOEHPer27JpZlZD1Ze4sLs8ixmh0Q&oe=6AFDBD3A"}, "display_name": "Axe man : dirty Blood", "keywords": ["axes", "colosseum", "gladiator", "melee"], "long_description": "You walk out of the torch-lit tunnel. Every step is heavy. The roar of the crowd grows until the gate rises and the sand is yours... or your grave.\n\nAXE MAN: DIRTY BLOOD is virtual reality melee combat with no attack button. Every hit comes from your arm: a graze barely marks them; a full-body swing takes heads and limbs off. Let go mid-swing and the axe flies out on its chain; steer it with your wrist and squeeze to bring it back to your hand.\n\nYOUR ARSENAL\n- Two chained axes you throw, steer and recall.\n- Frost Rune: pull the trigger to frost the blade, then freeze your target and everyone around it. Clash both frosted axes to release a runic shockwave.\n- Spears of Sparta: cross your forearms, throw them open and fire a ring of 12 spears that hunt your enemies.\n- Fury: fill the bar, click both thumbsticks and fight in slow motion with 2.5x damage.\n- Cut thrown spears out of the air, or bat spiked balls back with a hard swing.\n\nYOUR ENEMIES\nDraugr, berserkers, soldiers, street thugs and lions. And bosses that do not go down easy: the rhino gladiator and his Armoured, Alpha and Primordial forms, the Tiger, Ares and El Verdugo, the executioner waiting beneath the arena.\n\n26 slaughter, survival and boss missions across the colosseum and Olympus, in rain, storms or fog. Every mission grades you from S to D. The crowd only remembers an S.\n\nMenus and on-screen text are in Spanish.\n\nFor adults 18+ only: intense graphic violence and dismemberment.", "short_description": "The crowd roars. The gate lifts. You hold an axe in each hand, each one bound to a chain. There is no attack button: the force of the hit is the force of your arm. Let go mid-swing to throw the axe, steer it with your wrist and call it back to your fist. Cut spears out of the air, freeze enemies with the Frost Rune and throw your arms open to unleash 12 Spartan spears. 26 missions, brutal bosses and one rule: survive. For adults 18+ only."}]}, "developer_name": null, "developer_privacy_policy_url": "https://claude.ai/artifact/UPus7zW3rqtPWm54UxwMxY", "developer_terms_of_service_url": null, "publisher_name": "Francisco Manuel Mier y Teran Almazan", "support_website_url": null, "website_url": "https://claude.ai/artifact/UPus7zW3rqtPWm54UxwMxY", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1113290841137018"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312369_2587985058312322_2479806385741746067_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuWe_cHixdoQ7kNvwFZ6x7i&_nc_oc=AdqhGO8s_nlnxcwUngCxj91PlVtZ6lHzgMdsQmplenIsOXQvGCWMqguwlftEn5MnIlo&_nc_zt=3&_nc_ht
29246400768", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_2111829249734101_632846138707904507_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0CFjiIuLkYUQ7kNvwGUi-HU&_nc_oc=AdoRE7JGOTiO5IQD6DcmJC4LD8-NRdkpj99Zl3tDsjk31N6O9h1pync0JrAwoGuXuBs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7XK05tEf4bq1dfN8zUEkS2NNx_doJdbL5z5jDb501Nw&oe=6AF8A4BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "67LOGO_hero_image_2560x1440.png", "id": "1509047543933535", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593942860_1509047547266868_9138180012382816772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2yHzAAZl_UQ7kNvwGHseRz&_nc_oc=AdqMIASRkvvcAhQA4ZcuokTNWT5J9FchMNkE85pBAGHFD7VdV5flm7BgYZkTkvuRRTc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjQg6OsmZUUA41bGKUCSU-XDMLLGEDCX2aDz8KQIhmJA&oe=6AF888DC"}, "display_name": "Six Seven VR", "keywords": ["67", "Meme", "Six", "Seven"], "long_description": "Six Seven VR is a fast-paced, meme-fueled virtual reality experience built around one simple question:\n\nHow fast can you Six Seven?\n\nStep into VR and perform the iconic Six Seven motion as quickly and accurately as possible within a 30-second challenge. It\u2019s easy to play, impossible to master, and strangely addictive.\n\nPush your limits, refine your rhythm, and chase the perfect run. Whether you're warming up, competing with friends, or just embracing the absurdity, every second counts.", "short_description": "How fast can you Six Seven? Go full sigma and push your limits in a 30-second test of speed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://takecarestudiosllc.com/sixsevenprivacypolicy.html", "developer_terms_of_service_url": "https://takecarestudiosllc.com/sixseventermsofservice.html", "publisher_name": "take care studios", "support_website_url": null, "website_url": "https://takecarestudiosllc.com/sixsevenvr.html", "category": null, "comfort_rat
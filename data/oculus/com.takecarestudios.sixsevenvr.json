est of speed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://takecarestudiosllc.github.io/sixsevenprivacypolicy.html", "developer_terms_of_service_url": "https://takecarestudiosllc.github.io/sixseventermsofservice.html", "publisher_name": "take care studios", "support_website_url": null, "website_url": "https://takecarestudiosllc.github.io/sixsevenvr.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26414358354871843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821919_1563379098056880_6647020350526791019_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2H-1Lvlpv0Q7kNvwEB3HHp&_nc_oc=AdpmtB4XMTgyNLYnfukbCqvUwhsGKaDTQhRHUHJnVlOEXQV6njTZ8ze2gsgwmL9aYhY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_p2y9KKW1XN04vuHek9Amm6vJvAuqgRq5XILazhGZ4mg&oe=6A31608B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Six Seven VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_dat
oculuscdn.com/v/t64.5771-25/499619113_1483010509985751_1501828755190826516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MBRGvUZsqgQ7kNvwEjvYKd&_nc_oc=AdrayR0oYzYXA8pqVTqcAK8QxOl-AxU4EOcP5whxZ5vY9OZFl3L7t4Tp-hHwWm3S7wo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwjKon-OWFiGFUb8lYbejDjzJarQSAmozCyi4zsu-LUw&oe=6A5A2493"}, {"file_name": "screenshot4.png", "id": "2111829246400768", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618103_2111829249734101_632846138707904507_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y9S8Ri5BREwQ7kNvwF-7bFf&_nc_oc=AdqnF22mrlU-igq5xDp0WWMuxD1rk15icwsXzi0nEyqoRwpOrxfZzadHO2sD3Zs8GEI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnRk3_huT0hytMyL15-mGHmmB6fBadMjbC_Dh8YLlQRg&oe=6A5A387B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "67LOGO_hero_image_2560x1440.png", "id": "1509047543933535", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/593942860_1509047547266868_9138180012382816772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oZxbIir_LxAQ7kNvwF1aRsI&_nc_oc=AdpMpXvesOA5UpCv1E34wj9tu015LY0z2w0Z8CRZILLqVwcxDV-ztKJbo8iGQFGpnjE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBE2mspn7ACaNLnkCEU5n6HDwC7pFYcvf8-J0Ob9EwbQQ&oe=6A5A1C9C"}, "display_name": "Six Seven VR", "keywords": ["67", "Meme", "Six", "Seven"], "long_description": "Six Seven VR is a fast-paced, meme-fueled virtual reality experience built around one simple question:\n\nHow fast can you Six Seven?\n\nStep into VR and perform the iconic Six Seven motion as quickly and accurately as possible within a 30-second challenge. It\u2019s easy to play, impossible to master, and strangely addictive.\n\nPush your limits, refine your rhythm, and chase the perfect run. Whether you're warming up, competing with friends, or just embracing the absurdity, every second counts.", "short_description": "How fast can you Six Seven? Go full sigma and push your limits in a 30-second test of speed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://takecarestudiosllc.github.io/sixsevenprivacypolicy.html", "developer_terms_of_service_url": "https://takecarestudiosllc.github.io/sixseventermsofservice.html", "publisher_name": "take care studios", "support_website_url": null, "website_url": "https://takecarestudiosllc.github.io/sixsevenvr.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26414358354871843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491821919_1563379098056880_6647020350526791019_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6712MNXTSgQ7kNvwH0BzY6&_nc_oc=AdqjpHUMBHOPHCd_CQx-wmTwUbSge4VbLyqMWX8IoS4Hzv7KrSuUutKQbBW137x1ZRI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5PCfd8rdxN5tW4rF_yKkLfnD4HmZhqpPJciZA6wyyzg&oe=6A5A3F0B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Six Seven VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_dat
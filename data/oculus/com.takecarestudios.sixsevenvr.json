oculuscdn.com/v/t64.5771-25/499619113_1483010509985751_1501828755190826516_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJPvuZQ6gI0Q7kNvwFQAYPr&_nc_oc=AdrJFZPkaUdGwZJh4Qs_a9I56MG7KqEVBImVX-_mRzJdp-zgnFRbd1KLB7BE4WLXtLg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5gTihYhop6KCMN4RDrpNX1V28oCP5npWM7Dg9WlxIAg&oe=6A6B4813"}, {"file_name": "screenshot4.png", "id": "2111829246400768", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618103_2111829249734101_632846138707904507_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTZT_P2bqOoQ7kNvwHxO0Ej&_nc_oc=AdrUW1wGe62TEAEBq61WHNhJBFFvOZ6OA9ARfrkjg89O2USoyPDU0MJNrt73GF5nhzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcQIeRfeY6uNK-V0tpORCPFNkO-gqgA1WXdB8aL5jU9w&oe=6A6B5BFB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "67LOGO_hero_image_2560x1440.png", "id": "1509047543933535", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593942860_1509047547266868_9138180012382816772_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9iVpGTTUQQQ7kNvwFXgTAj&_nc_oc=Adp7V0Ay8PS7w9VKDLAAJFCZWQJbpq9Ra4psu6AkbYk4KCSvpcf24eecP511cK9Qcag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG-oFXZc9QCT_JRmYssgjwLJ5FiTTvLDraI_FbzNKDQw&oe=6A6B401C"}, "display_name": "Six Seven VR", "keywords": ["67", "Meme", "Six", "Seven"], "long_description": "Six Seven VR is a fast-paced, meme-fueled virtual reality experience built around one simple question:\n\nHow fast can you Six Seven?\n\nStep into VR and perform the iconic Six Seven motion as quickly and accurately as possible within a 30-second challenge. It\u2019s easy to play, impossible to master, and strangely addictive.\n\nPush your limits, refine your rhythm, and chase the perfect run. Whether you're warming up, competing with friends, or just embracing the absurdity, every second counts.", "short_description": "How fast can you Six Seven? Go full sigma and push your limits in a 30-second test of speed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://takecarestudiosllc.github.io/sixsevenprivacypolicy.html", "developer_terms_of_service_url": "https://takecarestudiosllc.github.io/sixseventermsofservice.html", "publisher_name": "take care studios", "support_website_url": null, "website_url": "https://takecarestudiosllc.github.io/sixsevenvr.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26414358354871843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821919_1563379098056880_6647020350526791019_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1tIgpeTmqIEQ7kNvwEFPHIU&_nc_oc=AdqBLnaWdWpYfkFNvuaddKIr0AlTCN4gOegVRM6M-1P4iEejoWc4CkE_KSUh3XX-M5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgg4hw0QXASmA72ZAa-6nP5LDwpabeJ6DUJP9sg_sbkA&oe=6A6B628B"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Six Seven VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Rhythm", "id": "1672577396871977"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_dat
 virtual reality experience built around one simple question:\n\nHow fast can you Six Seven?\n\nStep into VR and perform the iconic Six Seven motion as quickly and accurately as possible within a 30-second challenge. It\u2019s easy to play, impossible to master, and strangely addictive.\n\nPush your limits, refine your rhythm, and chase the perfect run. Whether you're warming up, competing with friends, or just embracing the absurdity, every second counts.", "short_description": "How fast can you Six Seven? Go full sigma and push your limits in a 30-second test of speed."}]}, "developer_name": null, "developer_privacy_policy_url": "https://takecarestudiosllc.github.io/sixsevenprivacypolicy.html", "developer_terms_of_service_url": "https://takecarestudiosllc.github.io/sixseventermsofservice.html", "publisher_name": "take care studios", "support_website_url": null, "website_url": "https://takecarestudiosllc.github.io/sixsevenvr.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26414358354871843"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1466168815298833"}]}, "baseline_offer": {"id": "1466168815298833"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1779167100, "status": "PUBLISHED", "id": "1466168815298833"}]}, "liveChannel
0jQJTeFoHuyT1OXA&oe=6B03298E"}, {"file_name": "screen2.png", "id": "971599833430824", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75314844_971599836764157_1222812123435304818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlbENuTZcvEQ7kNvwHNAYym&_nc_oc=AdprwHPvPeceTGk5VSkDStO6lY-ERL44A1UD7bZL7p5tXb34iMlQ4ROojGdq4Ps8pbc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKWoK3fpuoeXeJ3dZS2t_nLXYxdUfdVZd9EnMnJ-NMnQ&oe=6B0307E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_wimpsody.png", "id": "4561781057237876", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75240098_4561781060571209_5102327165194826822_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8zthQzwm5oQ7kNvwHutdQK&_nc_oc=AdppFYlcc53bpwalFF9CvZU49cl9sH3uaxuGmWHzTvz7FhdHUwi15lC1lERPtAMhi0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT-19uVgv1pDXaM6V12KIRdooWApZjGvKi1eL4uxBFsA&oe=6B031FB3"}, "display_name": "Wimpsody", "keywords": [], "long_description": "With Wimpsody, you'll just have to seat back, relax and watch trippy animation that will match your music. \nWith the demo section, you'll discover the psychedelic Baron Samedi and the space ship orchestra's tunes, all locally, with no need for an internet connection or extra headphones, just your headset.\nWith the Spotify section, you can listen to your music on Spotify while watching Wimpsody's animations, it requires a Spotify Account, and will be much more capable with a premium account. You'll also need to listen to you Spotify music an an other device than your headset. Headphones are warmly recommended to be fully immersed.\nEnjoy :)", "short_description": "Wimpsody allows you to do visual trips with music in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wimpsody.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Antoine Germanique", "support_website_url
iDKr49AyGvGhs0BE-vaRC6QkvDsdZ2vbSAIidvlsA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmlBPoIuQXctry3GQLKv8D8Y14WheKt5IGXyvbDtZBKw&oe=6A8ECBA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_wimpsody.png", "id": "4561781057237876", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75240098_4561781060571209_5102327165194826822_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4D7cWEcq3XMQ7kNvwGukv41&_nc_oc=Adq4LE8XbxIhDjNiDgOe-jEVCB-CkzbcjjDfCGIo7GmA1prhgC5hPSQ16iJIYrETXI8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEnZHBuqNSb1RZ-z4eQe0FZEmlM4hJtxAgAdU1C1_B9cg&oe=6A8EE373"}, "display_name": "Wimpsody", "keywords": [], "long_description": "With Wimpsody, you'll just have to seat back, relax and watch trippy animation that will match your music. \nWith the demo section, you'll discover the psychedelic Baron Samedi and the space ship orchestra's tunes, all locally, with no need for an internet connection or extra headphones, just your headset.\nWith the Spotify section, you can listen to your music on Spotify while watching Wimpsody's animations, it requires a Spotify Account, and will be much more capable with a premium account. You'll also need to listen to you Spotify music an an other device than your headset. Headphones are warmly recommended to be fully immersed.\nEnjoy :)", "short_description": "Wimpsody allows you to do visual trips with music in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wimpsody.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Antoine Germanique", "support_website_url": null, "website_url": "https://wimpsody.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "MUSIC"
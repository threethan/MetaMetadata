5Q4vt08IQuso2JHQ&oe=6AFF350E"}, {"file_name": "screen2.png", "id": "971599833430824", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75314844_971599836764157_1222812123435304818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mC909pjX3cwQ7kNvwFnYVv4&_nc_oc=Ado5N9KchM1ZKiD_k_o1p6-55NyfUXbr_Mf6dIfuxKB_Eyepv-NNtOdGd3CxiTU0ing&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5rULVLGJw2cS5SWTmuVG_Hi1UEj1xwvy_Ldo0Pua-Xw&oe=6AFF1368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_wimpsody.png", "id": "4561781057237876", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75240098_4561781060571209_5102327165194826822_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm9GYvjdNG4Q7kNvwFuWoqH&_nc_oc=AdpWlekm3-HPZ8YmOZFpsmQOVlEeXNu-iuX22n6BDptcJvGIi_QZ4UnlwQ93jpHK2K8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzT4x-uNRHqXB2txLMaxvRMTDaLd1NOJJCOe8ZGnlc8g&oe=6AFF2B33"}, "display_name": "Wimpsody", "keywords": [], "long_description": "With Wimpsody, you'll just have to seat back, relax and watch trippy animation that will match your music. \nWith the demo section, you'll discover the psychedelic Baron Samedi and the space ship orchestra's tunes, all locally, with no need for an internet connection or extra headphones, just your headset.\nWith the Spotify section, you can listen to your music on Spotify while watching Wimpsody's animations, it requires a Spotify Account, and will be much more capable with a premium account. You'll also need to listen to you Spotify music an an other device than your headset. Headphones are warmly recommended to be fully immersed.\nEnjoy :)", "short_description": "Wimpsody allows you to do visual trips with music in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wimpsody.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Antoine Germanique", "support_website_url
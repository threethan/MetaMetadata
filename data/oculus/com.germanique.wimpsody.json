rvEpl-xQQzZ80m1g&oe=6B0F070E"}, {"file_name": "screen2.png", "id": "971599833430824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75314844_971599836764157_1222812123435304818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeMgLb7dc2QQ7kNvwGX75cr&_nc_oc=Adpc7__XBE_4bLc_JrL_dgkkNGxjr8FIl4R0NjnidIiABmLBUhHxf9m5wR_dZ4Hno9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpY3MW3B-mD85YT_gQg25vasGrhxdJSJ1XNKzcfvaXiQ&oe=6B0F1DA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_wimpsody.png", "id": "4561781057237876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240098_4561781060571209_5102327165194826822_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cv3WpZyMkXUQ7kNvwH3hkfh&_nc_oc=AdpKJ1-vSpkFboqdk0jDOo7D7Q04NNn2Fwglf5CfGLB_Ii7zDsV8m-V2OBK52vloN2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFmbuUIgBSl6DPuOLhj4BW1nIFvTmjb6GuUoEAxQU6CQ&oe=6B0EFD33"}, "display_name": "Wimpsody", "keywords": [], "long_description": "With Wimpsody, you'll just have to seat back, relax and watch trippy animation that will match your music. \nWith the demo section, you'll discover the psychedelic Baron Samedi and the space ship orchestra's tunes, all locally, with no need for an internet connection or extra headphones, just your headset.\nWith the Spotify section, you can listen to your music on Spotify while watching Wimpsody's animations, it requires a Spotify Account, and will be much more capable with a premium account. You'll also need to listen to you Spotify music an an other device than your headset. Headphones are warmly recommended to be fully immersed.\nEnjoy :)", "short_description": "Wimpsody allows you to do visual trips with music in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wimpsody.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Antoine Germanique", "support_website_url
tPO229Qu8xjIxsww&oe=6B071E0E"}, {"file_name": "screen2.png", "id": "971599833430824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75314844_971599836764157_1222812123435304818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCa8KQyxNYkQ7kNvwHay-qw&_nc_oc=AdpQU0gT3Z-1m2im04D-qet2Uur67sGlGQywCG0te3Gec3bbLDKvd83jXmL1PskJN-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj5DKKPI6h4nONdn6sZeZguC0VvuHjJDz4zmToJMgKKg&oe=6B06FC68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_wimpsody.png", "id": "4561781057237876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240098_4561781060571209_5102327165194826822_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atvCRfrswK8Q7kNvwHbj5tT&_nc_oc=AdpBNcmct8x9n2_cgKEN0zXeP89gbhrh2j3yhN2EaYuE7FmWQxb6Iu1TOxIWgWOEgFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTCiAo7qCmB8WX13xHRSSye0VLfIS37WQBv2Ufq-FdrQ&oe=6B071433"}, "display_name": "Wimpsody", "keywords": [], "long_description": "With Wimpsody, you'll just have to seat back, relax and watch trippy animation that will match your music. \nWith the demo section, you'll discover the psychedelic Baron Samedi and the space ship orchestra's tunes, all locally, with no need for an internet connection or extra headphones, just your headset.\nWith the Spotify section, you can listen to your music on Spotify while watching Wimpsody's animations, it requires a Spotify Account, and will be much more capable with a premium account. You'll also need to listen to you Spotify music an an other device than your headset. Headphones are warmly recommended to be fully immersed.\nEnjoy :)", "short_description": "Wimpsody allows you to do visual trips with music in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wimpsody.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Antoine Germanique", "support_website_url
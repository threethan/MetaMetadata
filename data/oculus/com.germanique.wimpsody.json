LvoR9HwT_OjOLMzvPFd6LlGRq18CQ3j0Pk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xx6_-RMS_1mheJSnWCyOCiCa_L5fH8a9OVUKUgffjYg&oe=6A395268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_wimpsody.png", "id": "4561781057237876", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75240098_4561781060571209_5102327165194826822_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xDAfeqFqFcQ7kNvwGqZbD3&_nc_oc=AdoIcRWWvo3u1jBVW7S7WWFz-SBtvTLJo6BHyR7BrpzZyDk0aGrWcyMfMZNc82LO1-c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kQzir1KGTVv8O1tXr5KO8Fy95hB5n37J8LayXgRym0w&oe=6A3931F3"}, "display_name": "Wimpsody", "keywords": [], "long_description": "With Wimpsody, you'll just have to seat back, relax and watch trippy animation that will match your music. \nWith the demo section, you'll discover the psychedelic Baron Samedi and the space ship orchestra's tunes, all locally, with no need for an internet connection or extra headphones, just your headset.\nWith the Spotify section, you can listen to your music on Spotify while watching Wimpsody's animations, it requires a Spotify Account, and will be much more capable with a premium account. You'll also need to listen to you Spotify music an an other device than your headset. Headphones are warmly recommended to be fully immersed.\nEnjoy :)", "short_description": "Wimpsody allows you to do visual trips with music in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wimpsody.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Antoine Germanique", "support_website_url": null, "website_url": "https://wimpsody.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["ART_CREATIVITY", "MUSIC", "RELAX
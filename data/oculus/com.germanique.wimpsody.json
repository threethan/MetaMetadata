Cx-Ed0mcXW8weuuA&oe=6B00868E"}, {"file_name": "screen2.png", "id": "971599833430824", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75314844_971599836764157_1222812123435304818_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlbENuTZcvEQ7kNvwH0lMXE&_nc_oc=AdrD3ThfKu6BAHg26FaYx8dCYdtEb3bzUL6pCBe4IztzpT4BJWGEUKONvFQjVhcNj8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh72FLdDOoVzufZjyAnYmMyz4GwkkVhzFhxeXe17MP9Q&oe=6B0064E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_wimpsody.png", "id": "4561781057237876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75240098_4561781060571209_5102327165194826822_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sm9GYvjdNG4Q7kNvwGbLpdu&_nc_oc=Adphw_FRdCsHTET3M0oAwcS0_vy4q-lvGF_MyMV8TNVPFxTPVjrxXBz1es4UApeSXfQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIY2riR1yEhRV9YNXyEVonqi5QCtCVEjyILTC8NcIw8w&oe=6B007CB3"}, "display_name": "Wimpsody", "keywords": [], "long_description": "With Wimpsody, you'll just have to seat back, relax and watch trippy animation that will match your music. \nWith the demo section, you'll discover the psychedelic Baron Samedi and the space ship orchestra's tunes, all locally, with no need for an internet connection or extra headphones, just your headset.\nWith the Spotify section, you can listen to your music on Spotify while watching Wimpsody's animations, it requires a Spotify Account, and will be much more capable with a premium account. You'll also need to listen to you Spotify music an an other device than your headset. Headphones are warmly recommended to be fully immersed.\nEnjoy :)", "short_description": "Wimpsody allows you to do visual trips with music in VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://wimpsody.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Antoine Germanique", "support_website_url
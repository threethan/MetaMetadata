44997_229023173522899_2938603674922338433_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QX9QVy_oJAQ7kNvwEV_iP1&_nc_oc=AdqG8j-fyWsmu1g9cyDwF3D7vAxhBV2-Rtj5XqoHLoKr87DCSyNok-A1MLDO-gKegPg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8aurHPHl_q5lsXT9mKml5xuCvf0dkXzZ_9OLpvrJ6-A&oe=6A4F918F"}, {"file_name": "captura-05.png", "id": "1777050276059807", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570288_1777050279393140_1852125029583893075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSFdqw0d_pQQ7kNvwE8FRs7&_nc_oc=Adr5_QwjcsrpeIKIXrcdc53FjtzLfyMm2IJNSQPaWozyBQmfQI_G73SzYYWtDG45uYk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDD-oQSsv0UUUnUYJBLRYdEQoKwoCjmPJ_x3WWofx2ADA&oe=6A4F976E"}, {"file_name": "captura-02.png", "id": "1630252834165251", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75210393_1630252837498584_425167374006353066_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5gE6vlLfS0Q7kNvwGtgCTj&_nc_oc=AdqZZj9XLtBMDtXON6gTDI75RpV4_uRGiLuiLmowpt88vzad4Grt4J2Sb69_Tbxi1K0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDePgpT-9tdH-1Ojs8VgUqRU1Upp959W07me8Q6Fry7NQ&oe=6A4FBA52"}, {"file_name": "captura-03.png", "id": "348591614208200", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75348043_348591617541533_7187445081530822500_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdjNFYYoeUAQ7kNvwF7_WJs&_nc_oc=AdqVNz4NE8aTxWvdT7FB70GEe1mJUWDBY-_lbraX4cG4TH56vJGMy2BOLbommCKarho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDVlbH9M6ZKWK6okTxLRKPyA_L08zSexWaaRHQNXADyyg&oe=6A4FAEBF"}, {"file_name": "captura-04.png", "id": "1019768959154236", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974635_1019768962487569_1278257591174281796_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXYv-ELuaJ0Q7kNvwExDHfs&_nc_oc=AdprX9TBs2JlovWmyeQ550H240CW87Mwo3xmZ85XyuTzgQxtXD89BjeIbVsTlp9iv7A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOF69M_RXezm_ORY9ded5go6sxh7CX1mzAt_3jPWd6nA&oe=6A4FA30C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mendi Alde - Lankoetxe", "keywords": [], "long_description": "\"Mendi Alde\" offers a 3d recreation of the architectural proposal for a building commercialized by Lankoetxe. Through the application you can explore the interior of the houses interacting with its elements. There is also the possibility of using the different tools offered, we highlight the dimensioning of elements, making annotations, saving proposals for materials and colors, or viewing project plans.\nThe application is totally Cross-Play, allowing users of different platforms such as Meta Quest Pro, Meta Quest 2, Meta Quest 3 and Windows to interact in the same environment.", "short_description": "Visit the houses of the cooperative Mendi Alde interactively and with a very high level of detail."}, {"images": {"nodes": []}, "id": "492037043285558", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mendi Alde - Lankoetxe", "keywords": [], "long_description": "\"Mendi Alde\" ofrece una recreaci\u00f3n en 3D de la propuesta del edificio de viviendas comercializado por Lankoetxe. A trav\u00e9s de la aplicaci\u00f3n podr\u00e1s explorar el interior de las casas interactuando con sus elementos. Tambi\u00e9n existe la posibilidad de utilizar las diferentes herramientas que ofrece, destacamos el dimensionamiento de elementos, realizar anotaciones, guardar propuestas de materiales y colores o visualizar planos de proyecto.\nLa aplicaci\u00f3n es totalmente Cross-Play, permitiendo a usuarios de diferentes plataformas como Meta Quest Pro, Meta Quest 2, Meta Quest 3 y Windows interactuar en un mismo entorno.", "short_description": "Visita las viviendas de la cooperativa Mendi Alde de forma interactiva y con un alt\u00edsimo nivel de detalle."}]}, "developer_name": null, "developer_privacy_policy_url": "https:/
"https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821719_1966963367575758_7602976987452093628_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esaB7Y6Twu8Q7kNvwFZhbGD&_nc_oc=AdrWn2C9adtnQItYOFY4IO6KXDD84Zpp3w0I7qoI4CcSn4D74SxrenRzqg5S5Bb5a3Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4v9dKoKIx21cjbA1iK6zAw9E3AMTwAMAMGf0t72C9noQ&oe=6A15A8F1"}, {"file_name": "5.png", "id": "1487646096060204", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821099_1487646099393537_3581322408804862552_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihJsvUs-yiUQ7kNvwF_nmQ9&_nc_oc=AdowkkkrXsvbyfq28yMGQQ5KcZbxgu9zQZI1kBgU03nob3WBjjq-WBKBuFeRvn1dwPI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d2q7eNCANbiNxTroIYYT1qw3f0Nl2NGGGl_KIX9hRtQ&oe=6A15C2FC"}, {"file_name": "2.png", "id": "1650835902930864", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821568_1650835909597530_7698794668934931366_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBnJUx8F_ykQ7kNvwGHgkw5&_nc_oc=AdqAGL0CFuSekkQm1dYQE0ogBsz4yr_UdVanQCZRv5Vjww_5cr8ByvRkxUjYEGfc91E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dl2W2-CLP5yxIpKUedHY3tXbOcwvv8W8uqJJOKeT-gg&oe=6A159E2E"}, {"file_name": "4.png", "id": "1585136295931711", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818860_1585136299265044_3093262744778465937_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iMQ86GHnZ4Q7kNvwFfqOeu&_nc_oc=Adrhx8HIxV-TmJbmlwFH09xTYx3njhgwOFmVk2fBEic4k1AfBpjtPUD9JeyX-jU2www&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vt_w8fY0ZtZFpzTLXlsg8FIcoagkTKs-LVQ2ktXkTlA&oe=6A15914E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCover.png", "id": "880090948185547", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823351_880090951518880_3964157107066797762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUtpSmdaq8wQ7kNvwEYrgm3&_nc_oc=AdpRjng-aJDcgcM4DxKMH9JzfPVP1i_d_FZpB83_YT_H8OKuH2siZR27yxKeOlP9MiQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62-VNv4a_fcoeoQY0qXGtdd1qD7wGjA178GSIzC9retg&oe=6A158DDE"}, "display_name": "Zumbi Shooter: Arcade Waves", "keywords": ["shooter", "arcade", "zombie"], "long_description": "\ud83e\udddf The apocalypse has begun\u2026 and the clock is ticking.\n\nStep into a fast-paced - VR arcade zombie shooter - built for intense action!\nFight through relentless waves of the undead using dual-wield weaponsquick reflexes, and smart positioning to survive as long as possible.\n\nEvery match is a race against time. The clock is always running out, and the only way to stay alive is to eliminate zombies to gain precious extra seconds. The longer you survive, the more chaotic and dangerous the battlefield becomes.\n\nFace multiple types of enemies, each with different behaviors that will constantly challenge your strategy. Adapt quickly, react fast, and stay focused as the pressure keeps rising.\n\nBattle across several unique maps with different atmospheres and challenges. Earn money by defeating zombies and unlock new locations as you progress deeper into the apocalypse.\n\nPowerful random power-ups and military support, including air strikes, attack helicopters, and robotic turrets, can turn the tide when the horde becomes overwhelming.\n\nWith escalating waves, intense VR gunplay, and nonstop arcade action, survival is never guaranteed.\n\n\ud83d\udc80 Shoot fast. Think faster. Survive the apocalypse.", "short_description": "\ud83e\udddf The apocalypse has begun. Time is running out. You are the last line of defense.\n\nJump into a fast-paced VR arcade zombie shooter on Meta Quest. Wield dual weapons, fight through relentless hordes, collect devastating power-ups, and call in military support while the clock keeps ticking.\n\nEvery second counts: eliminate zombies, gain extra time, and survive increasingly brutal waves.\n\nShoot. Survive. Resist the apocalypse. \ud83d\udca5\ud83e\udddf\u200d\u2642\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Tuning Mania", "support_website_url": null, "website_url": "https://zumbishooter.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34733356049589088"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "4259877950902163"}, {"status": "PUBLISHED", "id": "26171743722481993"}, {"status": "PUBLISHED", "id": "1445602847140645"}]}, "baseline_offer": {"id": "1445602847140645"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782493200, "status": "PUBLISHED", "id": "4259877950902163"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35969856062605741", "version": "5"}, "id": "760984793391958", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34379230471668316", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35969856062605741"}, "release_status": "RELEASED"}, "binary_release_cha
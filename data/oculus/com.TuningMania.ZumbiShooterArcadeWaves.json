11&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkh2NZ9TmMAQ7kNvwFY7AuI&_nc_oc=Adqldf7opCojLGb0Cem92UhdAIPIWQ7p7ebK-3RoWSqP6-e2NjlOR_pLQJHHXed9aGQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYLumICW8aeqx9mX1tUlytCH6lON2G3nxdO7ZYQiks9A&oe=6A7F23D6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "videoCover.png", "id": "880090948185547", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_880090951518880_3964157107066797762_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-QpDWR8RBUQ7kNvwE5iD59&_nc_oc=AdoDH6FoV0hMgm8kqU-DUCJ4PoXAm9I9xLfta51pKyWVR1ydIgHgn_d9PiGYcEpnEr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7sNHhK3NCe41SNokWXumMKgqMRsYSgAZIeuOxq4ZN3Q&oe=6A7F05DE"}, "display_name": "Zumbi Shooter: Arcade Waves", "keywords": ["shooter", "arcade", "zombie", "action", "endless"], "long_description": "\ud83e\udddf The apocalypse has begun\u2026 and the clock is ticking \ud83e\udddf\n\n\ud83d\udca5 Jump into a fast-paced VR arcade zombie shooter built for pure adrenaline and stress relief! Blast through relentless waves of the undead using dual-wield weapons, quick reflexes, and smart positioning to survive as long as possible \ud83d\udca5\n\n\u23f1\ufe0f Every match is a race against time. Eliminate zombies to earn valuable Time Rewards and keep the clock alive. The longer you survive, the faster and more chaotic the action becomes \u23f1\ufe0f\n\n\ud83e\udde0 Face multiple enemy types with unique behaviors. Unlock powerful Perks, complete Daily Challenges and Daily Special Missions, and adapt on the fly to stay alive \ud83e\udde0\n\n\ud83c\udf0d Fight across unique maps, earn cash from every kill, and unlock new locations as you push deeper into the apocalypse \ud83c\udf0d\n\n\ud83d\ude81 Trigger random power-ups and call in military support including air strikes, attack helicopters, and robotic turrets when the horde becomes overwhelming \ud83d\ude81\n\n\ud83c\udfc6 Climb the Leaderboard, beat your personal best, and uncover a hidden story through cryptic transmissions, classified documents, and buried secrets \ud83c\udfc6\n\n\ud83d\udd25 Easy to jump into, hard to master, and packed with nonstop VR arcade action. Survival is never guaranteed \ud83d\udd25\n\n\ud83d\udc80 Shoot fast. React faster. Survive the apocalypse \ud83d\udc80", "short_description": "\ud83e\udddf The apocalypse has begun. Time is running out. You are the last line of defense.\n\nJump into a fast-paced VR arcade zombie shooter on Meta Quest. Wield dual weapons, fight through relentless hordes, collect devastating power-ups, and call in military support while the clock keeps ticking.\n\nEvery second counts: eliminate zombies, gain extra time, and survive increasingly brutal waves.\n\nShoot. Survive. Resist the apocalypse. \ud83d\udca5\ud83e\udddf\u200d\u2642\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Tuning Mania", "support_website_url": null, "website_url": "https://zumbishooter.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "36713809274877079"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820428_15
04&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-QpDWR8RBUQ7kNvwE5iD59&_nc_oc=AdoDH6FoV0hMgm8kqU-DUCJ4PoXAm9I9xLfta51pKyWVR1ydIgHgn_d9PiGYcEpnEr4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7sNHhK3NCe41SNokWXumMKgqMRsYSgAZIeuOxq4ZN3Q&oe=6A7F05DE"}, "display_name": "Zumbi Shooter: Arcade Waves", "keywords": ["shooter", "arcade", "zombie"], "long_description": "\ud83e\udddf The apocalypse has begun\u2026 and the clock is ticking.\n\nStep into a fast-paced - VR arcade zombie shooter - built for intense action!\nFight through relentless waves of the undead using dual-wield weaponsquick reflexes, and smart positioning to survive as long as possible.\n\nEvery match is a race against time. The clock is always running out, and the only way to stay alive is to eliminate zombies to gain precious extra seconds. The longer you survive, the more chaotic and dangerous the battlefield becomes.\n\nFace multiple types of enemies, each with different behaviors that will constantly challenge your strategy. Adapt quickly, react fast, and stay focused as the pressure keeps rising.\n\nBattle across several unique maps with different atmospheres and challenges. Earn money by defeating zombies and unlock new locations as you progress deeper into the apocalypse.\n\nPowerful random power-ups and military support, including air strikes, attack helicopters, and robotic turrets, can turn the tide when the horde becomes overwhelming.\n\nWith escalating waves, intense VR gunplay, and nonstop arcade action, survival is never guaranteed.\n\n\ud83d\udc80 Shoot fast. Think faster. Survive the apocalypse.", "short_description": "\ud83e\udddf The apocalypse has begun. Time is running out. You are the last line of defense.\n\nJump into a fast-paced VR arcade zombie shooter on Meta Quest. Wield dual weapons, fight through relentless hordes, collect devastating power-ups, and call in military support while the clock keeps ticking.\n\nEvery second counts: eliminate zombies, gain extra time, and survive increasingly brutal waves.\n\nShoot. Survive. Resist the apocalypse. \ud83d\udca5\ud83e\udddf\u200d\u2642\ufe0f"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tuningmaniaprivacypolicy.wordpress.com/", "developer_terms_of_service_url": null, "publisher_name": "Tuning Mania", "support_website_url": null, "website_url": "https://zumbishooter.wordpress.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34733356049589088"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1678005143467891"}, {"status": "PUBLISHED", "id": "4259877950902163"}, {"status": "PUBLISHED", "id": "26171743722481993"}, {"status": "PUBLISHED", "id": "1445602847140645"}]}, "baseline_offer": {"id": "1445602847140645"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787425200, "status": "PUBLISHED", "id": "1678005143467891"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "36598559239735417", "version": "9"}, "id": "760984793391958", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34379230471668316", "is
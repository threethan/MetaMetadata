1140p_19.04.2024_21-56-54.png", "id": "368560609472252", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036617_368560612805585_1626245667070759015_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wm0xXr4HyYcQ7kNvwFoRJtu&_nc_oc=AdpEZRoeaZFo6Vt8P8UfM_tJ9fumQvwXWqK2_eIgqg-9DtQgmCgna__r8y3o7NoGWYU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KXQ1pV-kbUto2pZVm5-aNd3_1Uiqv4Tffk55NXM2KEw&oe=6A413D5B"}, {"file_name": "SampleScene_1140p_19.04.2024_21-59-32.png", "id": "396925546572714", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974902_396925549906047_2837933980579594878_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EH2DFTcko_sQ7kNvwFyNnlS&_nc_oc=Adry4n1JRmalQKwxnmfGug_JgXhpkAnkG-BBPzsI48x-lEcW8d9TEhCf_MtDf0XlCnI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ah0XZTQYdJwFgMdpYwwz_CaW2_iyZdTUakKT9wR_SQw&oe=6A4119C8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SampleScene_1140p_19.04.2024_21-59-32.png", "id": "963514982055932", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75488378_963514985389265_6582491196824186946_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W7VviVtPXPkQ7kNvwGWooJ1&_nc_oc=Ado1414wDR6llqleerRM-PUVjING0ZVV9l-yx5DjxCeycYlMFot5zJ-E4p02fVqA8K4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9reKFxto15dfSWAeRKhhm3__7yMh4QNriVXm_V5SgO8g&oe=6A41315D"}, "display_name": "TerrorMonkeys", "keywords": [], "long_description": "Welcome to Terror Monkeys where the eerie echoes of a forgotten factory beckon you into darkness. Trapped within the labyrinthine corridors of an abandoned industrial complex, the sinister shadows while evading the malevolent spirits of mischievous monkeys gone awry. As you delve deeper into the heart of the decaying facility, uncover the chilling secrets hidden within its rusted machinery and ominous chambers. Each step forward brings you closer to the truth, but also closer to the clutches of terror lurking in every corner.", "short_description": "Armed with only your wits, unravel the mysteries of the haunted factory while confronting the twisted manifestations of your darkest fears. Can you survive the relentless onslaught of primal nightmares, or will you become just another lost soul trapped in Terror Monkeys\u2026"}]}, "developer_name": "SillyBilly", "developer_privacy_policy_url": "https://docs.google.com/document/d/1QhUskMFFLMyoqVhtoFG1VQgsSzu9UujBw6d91GKE1pk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SillyBilly", "support_website_url": null, "website_url": "https://sites.google.com/view/terrormonkeys/startsida", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25198841589759741"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25284918621152037", "version": "0.4"}, "id": "962461181673480", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25173148345662399", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25284918621152037"}, "release_statu
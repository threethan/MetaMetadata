64.5771-25/491822812_1577178866305299_4972459713143795140_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhbhYsWbBuwQ7kNvwFcggMZ&_nc_oc=AdpsjE8tq02I6UpJ5CXRDvyzQdcU4zibaHevyjCV_qhril7BSyh21JG1Ku4DvUlLb34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRdcJW5SOdRx9m7Tp7ACaRgRFMyPgtfHjWx-Up8JVuVpg&oe=6B0D9B98"}, "display_name": "Wild West : The Last Cowboy FREE", "keywords": ["pvp", "multiplay", "cowboy", "action", "wild"], "long_description": "Download the official version now!\nhttps://www.meta.com/experiences/quest/9166491820097988/?require_login=true\n\nWelcome to the ultimate Wild West showdown! Wild West: The Last Cowboy is a thrilling VR shooter that puts you in the boots of a true gunslinger. With charming,  Cartoon-style casual graphics and fast-paced action, this game delivers an immersive Western experience like never before.\n\n\ud83d\udd2b 1v1 Online Duels\nStep into the dusty streets and face off against real players in intense, real-time gunfights. Your reflexes, accuracy, and strategy will determine who walks away victorious. Every shot counts\u2014are you quick enough to survive?\n\n\u26a1 Fast Draw Ranking Battles\nTest your skills in classic Western-style quick-draw duels! Only the fastest and most precise shooters will claim the top spot on the leaderboard. Draw your revolver, aim, and fire before your opponent even blinks!\n\n\ud83c\udfdc\ufe0f Explore the Immersive Wild West\nFeel the sun scorching the desert sands as you roam through rugged frontier towns. From old saloons to dusty roads, the game captures the spirit of the Wild West, making every battle feel authentic and exhilarating.\n\n\ud83c\udfae A VR Experience Like No Other\nPut on your VR headset and step into a world where you're the hero of your own Western legend. Whether you're engaging in high-noon shootouts or climbing the ranks as the fastest draw in town, Wild West : The Last Cowboy guarantees an adrenaline-pumping adventure.\n", "short_description": "Become the fastest gunslinger in the Wild West! Wild West : The Last Cowboy is a VR shooter with  Cartoon-style casual graphics and fast-paced action.\n\n\ud83d\udd2b 1v1 Online Duels \u2013 Challenge real players in intense shootouts. Quick reflexes decide the winner!\n\u26a1 Fast Draw Ranking \u2013 Test your speed in classic Western quick-draw battles. Climb the leaderboard!\n\ud83c\udfdc\ufe0f Immersive Western World \u2013 Step into dusty towns and experience the cowboy era."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.dmong.net/ppr-zomvirus", "developer_terms_of_service_url": null, "publisher_name": "DMONG GAME", "support_website_url": null, "website_url": "https://www.dmong.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "23887282154244832"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26476381598668195", "version": "1.0.8"}, "id": "2132094863878372", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2
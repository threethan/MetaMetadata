om/v/t64.5771-25/473396844_3047651628718384_768421876498486961_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLcv9m9sYcYQ7kNvwGbrhfR&_nc_oc=Adoefd2Ol5TqmV5F3aNAeG13VfpZRJG2a5xZqMETc1keBiyKnxNrxOetaMAqaPLUgVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbhO9YLVrcQ6GXbT0q3JZrIMzVtqJ1D-cFCD5toSY73A&oe=6B0DCB61"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Wild West : The Last Cowboy FREE", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1745617080, "lastRevision": {"nodes": [{"id": "23879200981719616", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "23879200948386286", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1368145531044655"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1656527978368237", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wild West : The Last Cowboy FREE", "keywords": ["\uba40\ud2f0", "PVP", "\uc561\uc158", "FPS", "\uc778\uae30"], "long_description": "\uc815\uc2dd \ubc84\uc804 \ub2e4\uc6b4\ub85c\ub4dc \ud558\uc138\uc694!\nhttps://www.meta.com/experiences/quest/9166491820097988/?require_login=true\n\n\ucd5c\uac15\uc758 \uc11c\ubd80 \ucd1d\uc7a1\uc774\uac00 \ub420 \uc900\ube44\uac00 \ub418\uc5c8\ub098\uc694? Wild West : The Last Cowboy\ub294 VR\ub85c \uc990\uae30\ub294 \uc2a4\ub9b4 \ub118\uce58\ub294 \uc11c\ubd80 \ucd1d\uaca9\uc804 \uac8c\uc784\uc785\ub2c8\ub2e4. \uce74\ud230 \uc2a4\ud0c0\uc77c\uc758 \uce90\uc8fc\uc5bc\ud55c \uadf8\ub798\ud53d\uacfc \ube60\ub978 \ud15c\ud3ec\uc758 \uc561\uc158\uc774 \ud2b9\uc9d5\uc774\uba70, \uc11c\ubd80 \uc2dc\ub300\uc758 \uc804\uc124\uc774 \ub420 \uae30\ud68c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n\ud83d\udd2b 1\ub3001 \uc628\ub77c\uc778 \ub300\uacb0\n\ud669\ub7c9\ud55c \uac70\ub9ac\uc5d0\uc11c \uc2e4\uc2dc\uac04\uc73c\ub85c \uc0c1\ub300\uc640 \ub9de\uc11c \uc2f8\uc6b0\uc138\uc694. \ubc18\uc0ac \uc2e0\uacbd\uacfc \uc815\ud655\ud55c \uc0ac\uaca9\uc774 \uc2b9\ud328\ub97c \uacb0\uc815\uc9d3\uc2b5\ub2c8\ub2e4. \ud55c \ubc1c, \ud55c \ubc1c\uc774 \uc911\uc694\ud55c \uc2b9\ubd80\uc5d0\uc11c \ub2f9\uc2e0\uc740 \uc0b4\uc544\ub0a8\uc744 \uc218 \uc788\uc744\uae4c\uc694?\n\n\u26a1 \ud328\uc2a4\ud2b8 \ub4dc\ub85c\uc6b0 \ub7ad\ud0b9\uc804\n\uc11c\ubd80 \uc2dc\ub300\uc758 \uc804\ud1b5\uc801\uc778 \ud328\uc2a4\ud2b8 \ub4dc\ub85c\uc6b0 \uacb0\ud22c\uc5d0 \ub3c4\uc804\ud558\uc138\uc694! \ub2e8 \uba87 \ucd08 \ub9cc\uc5d0 \uc2b9\ud328\uac00 \uac08\ub9ac\ub294 \uae34\uc7a5\uac10 \ub118\uce58\ub294 \uc21c\uac04, \uac00\uc7a5 \ube60\ub974\uace0 \uc815\ud655\ud55c \uc0ac\uaca9 \uc2e4\ub825\uc744 \uac00\uc9c4 \uc790\ub9cc\uc774 \ub7ad\ud0b9\uc758 \uc815\uc0c1\uc744 \ucc28\uc9c0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ud83c\udfdc\ufe0f \uc0dd\uc0dd\ud55c \uc11c\ubd80 \uc138\uacc4\n\uc0ac\ub9c9\uc758 \ud0dc\uc591\uc774 \ub728\uac81\uac8c \ub0b4\ub9ac\ucb10\ub294 \ud669\ub7c9\ud55c \uac1c\ucc99\uc9c0\uc5d0\uc11c \uc804\uc124\uc801\uc778 \ucd1d\uc7a1\uc774\uac00 \ub418\uc5b4\ubcf4\uc138\uc694. \uc624\ub798\ub41c \uc0b4\ub871, \uba3c\uc9c0\uac00 \ub0a0\ub9ac\ub294 \uac70\ub9ac \ub4f1 \uc11c\ubd80 \uc601\ud654 \uc18d \uc7a5\uba74\uc744 \uadf8\ub300\ub85c \uacbd\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ud83c\udfae \uc555\ub3c4\uc801\uc778 VR \ubab0\uc785\uac10\nVR \ud5e4\ub4dc\uc14b\uc744 \ucc29\uc6a9\ud558\ub294 \uc21c\uac04, \ub2f9\uc2e0\uc740 \uc9c4\uc9dc \uc11c\ubd80\uc758 \ucd1d\uc7a1\uc774\uac00 \ub429\ub2c8\ub2e4. \uae34\uc7a5\uac10 \ub118\uce58\ub294 \ub300\uacb0, \ube60\ub978 \ucd1d\uc2f8\uc6c0, \uadf8\ub9ac\uace0 \ub7ad\ud0b9\uc744 \ud5a5\ud55c \uce58\uc5f4\ud55c \uacbd\uc7c1! Wild West : The Last Cowboy\uc5d0\uc11c \uc0b4\uc544\ub0a8\uc744 \uc218 \uc788\uc744\uae4c\uc694?\n\n\uc9c0\uae08 \ucd1d\uc744 \uc7a1\uace0, \uac00\uc7a5 \ube60\ub978 \uce74\uc6b0\ubcf4\uc774\uac00 \ub418\uc5b4\ubcf4\uc138\uc694! \ud83d\udd25\ud83e\udd20", "short_description": "\uc11c\ubd80 \uc2dc\ub300\uc758 \ub9c8\uc9c0\ub9c9 \uce74\uc6b0\ubcf4\uc774\uac00 \ub418\uc5b4 1\ub3001 \ucd1d\uaca9\uc804\uc744 \ud3bc\uccd0\ub77c! Wild West : The Last Cowboy\ub294 \uce74\ud230 \uc2a4\ud0c0\uc77c\uc758 \uce90\uc8fc\uc5bc \uadf8\ub798\ud53d\uacfc \ube60\ub978 \ud15c\ud3ec\uc758 \uc561\uc158\uc774 \ub9e4\ub825\uc801\uc778 VR \uc11c\ubd80 \ucd1d\uc7a1\uc774 \uac8c\uc784\uc785\ub2c8\ub2e4.\n\n\ud83d\udd2b 1\ub3001 \uc628\ub77c\uc778 \ub9e4\uce58 \u2013 \uc2e4\uc2dc\uac04\uc73c\ub85c \ub2e4\ub978 \ud50c\ub808\uc774\uc5b4\uc640 \ub300\uacb0! \ubc18\uc0ac \uc2e0\uacbd\uacfc \uc815\ud655\ud55c \uc0ac\uaca9 \uc2e4\ub825\uc774 \uc2b9\ud328\ub97c \uac00\ub978\ub2e4.\n\u26a1 \ud328\uc2a4\ud2b8 \ub4dc\ub85c\uc6b0 \ub7ad\ud0b9\uc804 \u2013 \ub2e8 \uba87 \ucd08 \ub9cc\uc5d0 \uc2b9\ubd80\uac00 \uacb0\uc815\ub418\ub294 \ud074\ub798\uc2dd \uc11c\ubd80\uc2dd \uacb0\ud22c! \uc21c\ubc1c\ub825\uacfc \uc9d1\uc911\ub825\uc73c\ub85c \ucd5c\uac15 \ub7ad\ucee4\uc5d0 \ub3c4\uc804\ud558\uc138\uc694.\n\ud83c\udfdc\ufe0f \uc9c4\uc9dc \uc11c\ubd80 \uc138\uacc4 \u2013 \ud669\ub7c9\ud55c \ub9c8\uc744, \ubaa8\ub798\ubc14\ub78c\uc774 \uc774\ub294 \uac70\ub9ac\uc5d0\uc11c \uce74\uc6b0\ubcf4\uc774\uac00 \ub418\uc5b4 \uc804\uc124\uc774 \ub418\uc5b4\ubcf4\uc138\uc694.\n\n\uc9c0\uae08 VR \ud5e4\ub4dc\uc14b\uc744 \ucc29\uc6a9\ud558\uace0, \uc11c\ubd80\uc758 \ucd5c\uac15 \ucd1d\uc7a1\uc774\uac00 \ub420 \uc900\ube44\uac00 \ub418\uc168\ub098\uc694? \ud83d\udd25\ud83e\udd20"}, {"images": {"nodes": [{"file_name": "Square.png", "id": "3047651618718385", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-2
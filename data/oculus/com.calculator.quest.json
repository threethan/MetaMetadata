fw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUd4UezOFI1a5VkJDIkE7a7cgEOk5WgHAeYvFtm9vW6A&oe=6AE33F11"}, {"file_name": "2.png", "id": "911277978531425", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818860_911277985198091_2193995836151340250_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=szuTFGjOOIsQ7kNvwFbacIq&_nc_oc=AdpfwriuzRbXbq6-zuH_3D1wMbATTALx289NHcaWu00XcxQhRuCh9AbSjXdKYq1oAdU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYjLwFCxX0NOa6LaFr4b6oDzARNRN9_IfaPB68WLO4cQ&oe=6AE3589D"}, {"file_name": "3.png", "id": "1588646825726349", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491825462_1588646829059682_52758224669800800_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYLmpH1P2-EQ7kNvwHY59uv&_nc_oc=AdovKTydOLbe8xWeVaVj0-MPgqIqbKuud8nSTM6SrnEgpZ3YlsqMB20UsWllI2-KtiQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbCTilmvt6pVWAou7LOoNI-ktpdqFdkuI5us3Nmqeayg&oe=6AE33D22"}, {"file_name": "4.png", "id": "2224763694952551", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819281_2224763698285884_2984391317207770104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HgLZBbMdeO4Q7kNvwEY0hRY&_nc_oc=Adp0Bt8SdPwD0J_LarC9fVJjIIotWrwr8Llgbs9kKac7FTHx1Wx_xtS8pcLiH0szGZ4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM7Rmd08thltlK1yXWdG_8tK_-MdFoVdyFI2UjNkCP6w&oe=6AE33B1A"}, {"file_name": "5.png", "id": "1109979894587744", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819281_1109979897921077_4919178994838455810_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qS9m4_F3TbkQ7kNvwHWosqw&_nc_oc=AdrUIUbl_YuBeWZ01NEukFGFdJKHNKRXGQf0B418nEaUoPlTF1TASueACYe984ssB20&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1V48-9L_-c8lduRUBCh4cVwhBrqdGbXu-L389xhcr4Q&oe=6AE35465"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CalcVR Calculator", "keywords": ["calculator", "scientific", "math", "productivity", "utility"], "long_description": "CalcVR is a lightweight, native calculator designed specifically for Meta Quest. It runs as a floating 2D panel in your VR environment \u2014 always within reach, never in the way.\n\nTwo Modes, One Tap Away\nStart in Basic mode for everyday math. Need more power? Tap Scientific to unlock a full suite of advanced functions \u2014 and switch back just as easily.\n\nBasic Mode: Addition, subtraction, multiplication, division, percentage calculations, sign toggle, backspace and clear.\n\nScientific Mode: Trigonometric functions (sin, cos, tan), logarithms (ln, log), square root, square, power, factorial, inverse, constants (\u03c0, e), and parentheses for complex expressions.\n\nBuilt for VR: Runs as a system panel alongside other apps, resizable window, hand tracking support, dark UI theme optimized for VR readability, high-precision math engine with 15-digit accuracy.\n\nCalcVR is free, fast, and distraction-free. No ads. No permissions. Just math.", "short_description": "A sleek, fast calculator for Meta Quest. Switch between Basic and Scientific modes instantly. Runs as a resizable system panel in your VR workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/calcvr-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/calcvr-privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_T
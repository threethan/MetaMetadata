v/t64.5771-25/491825462_1588646829059682_52758224669800800_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FerdW9m6p8wQ7kNvwFxk3vJ&_nc_oc=AdqEzc_eui8-l8dk8HNRQJDffDkll_S4mSJ3oPTgkKCRizIPmT6GZ33B_O0m_uaR9kw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5R_7WUxBO8lKnasojVQiA2UN2T48W7qdN9jUoPeLrsg&oe=6A675022"}, {"file_name": "4.png", "id": "2224763694952551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819281_2224763698285884_2984391317207770104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PqigXAL4GoQ7kNvwG7z4kM&_nc_oc=AdpDnRrz4zQKccRZDS8PW0CRgjE9dlWvoNQWoUUPMF1IutizlW3CDwyhrnHZUSWi7xQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQWyRK7WVoMh7lkxkSWoIFIaqPF6ekQp0v9qN1kJCP4g&oe=6A674E1A"}, {"file_name": "5.png", "id": "1109979894587744", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819281_1109979897921077_4919178994838455810_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mySX2WINPb0Q7kNvwH8Eodq&_nc_oc=Adrn7apT96d6W81RZMPsv6atgIjU2ZhlZICrwLfHcb-KpAm-CMp32A-CDLv13pPjCks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbhsLIEMfApOcTgsriBYQXhx5grP6h9cqQgNVsIBs-jg&oe=6A676765"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CalcVR Calculator", "keywords": ["calculator", "scientific", "math", "productivity", "utility"], "long_description": "CalcVR is a lightweight, native calculator designed specifically for Meta Quest. It runs as a floating 2D panel in your VR environment \u2014 always within reach, never in the way.\n\nTwo Modes, One Tap Away\nStart in Basic mode for everyday math. Need more power? Tap Scientific to unlock a full suite of advanced functions \u2014 and switch back just as easily.\n\nBasic Mode: Addition, subtraction, multiplication, division, percentage calculations, sign toggle, backspace and clear.\n\nScientific Mode: Trigonometric functions (sin, cos, tan), logarithms (ln, log), square root, square, power, factorial, inverse, constants (\u03c0, e), and parentheses for complex expressions.\n\nBuilt for VR: Runs as a system panel alongside other apps, resizable window, hand tracking support, dark UI theme optimized for VR readability, high-precision math engine with 15-digit accuracy.\n\nCalcVR is free, fast, and distraction-free. No ads. No permissions. Just math.", "short_description": "A sleek, fast calculator for Meta Quest. Switch between Basic and Scientific modes instantly. Runs as a resizable system panel in your VR workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/calcvr-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/calcvr-privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25927063416974433"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823351_1430972435149662_5440451268244965752_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iK7S9o4xfPsQ7kNvwH_8ROQ&_nc_oc=AdrQQqQe_oC6l_3iZieSzvLk2QkvTTFGuLI0EodOvWgrGLzw7r_aPU9rCXJmJWq30-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB18H7xfQde2na9J4BbO97fnyBH2EscwqVQ7D7JXYq9mg&oe=6A675E52"}, "is_concept": false, "i
MNQ0qaWb7B91Yw&oe=6AA16D9D"}, {"file_name": "3.png", "id": "1588646825726349", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825462_1588646829059682_52758224669800800_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE62vx8pjhoQ7kNvwEgQ0LD&_nc_oc=Ado2n7lOueThCBNU6xL4Xurk5aeiO5liTxNzlg0ABLHMJ2QTMqYuAeLHwR2314KJ8zc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJx-hHXsQqbooayB-ah64A3qIOBfCLvg__ouLY74MeRxQ&oe=6AA15222"}, {"file_name": "4.png", "id": "2224763694952551", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819281_2224763698285884_2984391317207770104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE1mJPFQMM4Q7kNvwEIkmjf&_nc_oc=AdrTgwTJpsr7i-GbawwDQsgokvkNx15Hj88ka4P44xvHa4K1cyk7AX6pDjEtdXNgxjE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqcar_KdS4hTyfEEp95GO9n7cPfywaBB5OFikrPTHg0g&oe=6AA1501A"}, {"file_name": "5.png", "id": "1109979894587744", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819281_1109979897921077_4919178994838455810_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvm5zbb6u4IQ7kNvwHuNN5s&_nc_oc=Ado2WrX4cH3QzvRzGckVOjiKtJ2unPFmFJBE6DUxprMSygbb8GqljkPttSMvtMTo2Wk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_0kZrBg6m5VA1upuKSN0EbdLop-GuE4dMlzc3Gtgr_g&oe=6AA16965"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CalcVR Calculator", "keywords": ["calculator", "scientific", "math", "productivity", "utility"], "long_description": "CalcVR is a lightweight, native calculator designed specifically for Meta Quest. It runs as a floating 2D panel in your VR environment \u2014 always within reach, never in the way.\n\nTwo Modes, One Tap Away\nStart in Basic mode for everyday math. Need more power? Tap Scientific to unlock a full suite of advanced functions \u2014 and switch back just as easily.\n\nBasic Mode: Addition, subtraction, multiplication, division, percentage calculations, sign toggle, backspace and clear.\n\nScientific Mode: Trigonometric functions (sin, cos, tan), logarithms (ln, log), square root, square, power, factorial, inverse, constants (\u03c0, e), and parentheses for complex expressions.\n\nBuilt for VR: Runs as a system panel alongside other apps, resizable window, hand tracking support, dark UI theme optimized for VR readability, high-precision math engine with 15-digit accuracy.\n\nCalcVR is free, fast, and distraction-free. No ads. No permissions. Just math.", "short_description": "A sleek, fast calculator for Meta Quest. Switch between Basic and Scientific modes instantly. Runs as a resizable system panel in your VR workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/calcvr-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/calcvr-privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25927063416974433"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823351_1430972435149662_5440451268244965752_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UOSL3s7GZA4Q7kNvwHFtYlJ&_nc_oc=AdqT1F856-3OlNOgGmcSLW-zLVkNE3pr0zRN_GuhvX9CLEfQF9uhypks9rctTfzPL8U&_nc_zt=3&_nc_ht=scontent-
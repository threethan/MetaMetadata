82_52758224669800800_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Gy-9SpKffoQ7kNvwFQBV6h&_nc_oc=AdrLZ2eRQNhJ0QC1KKUpEHJhzQT9ln9roePR1lb270yOZjSI65232jXZ47L1xgPVZoM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9egWZWksEJdWKgjMgcyLi1TOhcd8KkOdt4WMrOaimn6g&oe=6A3AB562"}, {"file_name": "4.png", "id": "2224763694952551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819281_2224763698285884_2984391317207770104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S4fVVzQMCv4Q7kNvwFZP3t1&_nc_oc=Adqdto7wYLbheJqUJetC84BwFUvfhc8EXxxxr_flEUEKv0neOnuBySBLf-uZ1KSEvTg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zbzh36xWg9fxylyuRlXULoTEtAWSrdh-xRRVEvfKJyQ&oe=6A3AB35A"}, {"file_name": "5.png", "id": "1109979894587744", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_1109979897921077_4919178994838455810_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHaVjlXoqQkQ7kNvwEBpiqb&_nc_oc=Adq_yGr5x7N7dypTOWE9hwips-PR8oIyaNkaYI4wY6j432FADUQU4rcjSNxHwwiBwWI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XTrcAwIMJ-kUXo9qjsRaA_ylI2_LggrkfCJI62ozQhA&oe=6A3A9465"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CalcVR Calculator", "keywords": ["calculator", "scientific", "math", "productivity", "utility"], "long_description": "CalcVR is a lightweight, native calculator designed specifically for Meta Quest. It runs as a floating 2D panel in your VR environment \u2014 always within reach, never in the way.\n\nTwo Modes, One Tap Away\nStart in Basic mode for everyday math. Need more power? Tap Scientific to unlock a full suite of advanced functions \u2014 and switch back just as easily.\n\nBasic Mode: Addition, subtraction, multiplication, division, percentage calculations, sign toggle, backspace and clear.\n\nScientific Mode: Trigonometric functions (sin, cos, tan), logarithms (ln, log), square root, square, power, factorial, inverse, constants (\u03c0, e), and parentheses for complex expressions.\n\nBuilt for VR: Runs as a system panel alongside other apps, resizable window, hand tracking support, dark UI theme optimized for VR readability, high-precision math engine with 15-digit accuracy.\n\nCalcVR is free, fast, and distraction-free. No ads. No permissions. Just math.", "short_description": "A sleek, fast calculator for Meta Quest. Switch between Basic and Scientific modes instantly. Runs as a resizable system panel in your VR workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/calcvr-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/calcvr-privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25927063416974433"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1293823349289791"}]}, "baseline_offer": {"id": "1293823349289791"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773173280, "status": "PUBLISHED", "id": "1293823349289791"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25927067126974062", "version": "1.3"}, "id": "1361815955705753", "channel_name": "LIVE"}]}, "is_for_oculus_keys_
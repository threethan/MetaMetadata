6ci2W6wbE8w9Yw&oe=6AA01C1D"}, {"file_name": "3.png", "id": "1588646825726349", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825462_1588646829059682_52758224669800800_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE62vx8pjhoQ7kNvwH2M3f1&_nc_oc=Adp_Rf75cLI3xpJC5_b4_oOoyd8XWZpg6YcKBUSLiS7mKHY054stCmbtrcIsu6xAmLE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxeRI_9eIZSBkyTd5IvKSaa_f8C9G06MmgLEc6jAScEQ&oe=6AA000A2"}, {"file_name": "4.png", "id": "2224763694952551", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819281_2224763698285884_2984391317207770104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE1mJPFQMM4Q7kNvwHurlqb&_nc_oc=AdrMBpPcb4Yvai918SKdzgJF-UUKnOi8hXkzZ8E2P1v4-v84kNF8Zo-TkrNoWqlDMRI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5DwO1bAfJFB_Zjr58CSAJf-MLdJmhklihUL1YPV3AcQ&oe=6A9FFE9A"}, {"file_name": "5.png", "id": "1109979894587744", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491819281_1109979897921077_4919178994838455810_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvm5zbb6u4IQ7kNvwF4Ods-&_nc_oc=AdocuFv9PAzaP29jef2fsWFSb0xQOIqB3XIGKfSwEaTvk-_flvRWZhL-W3p-oszvrb4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYbV2F6eypVhZCtD73Z4c9_bg3rDY9xyr9mOKdegWDog&oe=6AA017E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CalcVR Calculator", "keywords": ["calculator", "scientific", "math", "productivity", "utility"], "long_description": "CalcVR is a lightweight, native calculator designed specifically for Meta Quest. It runs as a floating 2D panel in your VR environment \u2014 always within reach, never in the way.\n\nTwo Modes, One Tap Away\nStart in Basic mode for everyday math. Need more power? Tap Scientific to unlock a full suite of advanced functions \u2014 and switch back just as easily.\n\nBasic Mode: Addition, subtraction, multiplication, division, percentage calculations, sign toggle, backspace and clear.\n\nScientific Mode: Trigonometric functions (sin, cos, tan), logarithms (ln, log), square root, square, power, factorial, inverse, constants (\u03c0, e), and parentheses for complex expressions.\n\nBuilt for VR: Runs as a system panel alongside other apps, resizable window, hand tracking support, dark UI theme optimized for VR readability, high-precision math engine with 15-digit accuracy.\n\nCalcVR is free, fast, and distraction-free. No ads. No permissions. Just math.", "short_description": "A sleek, fast calculator for Meta Quest. Switch between Basic and Scientific modes instantly. Runs as a resizable system panel in your VR workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/calcvr-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/calcvr-privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25927063416974433"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823351_1430972435149662_5440451268244965752_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndg4DgqkDQMQ7kNvwE4rMse&_nc_oc=AdoVHsNcbGyB3ya5D62FfYHcFZQx5vJ6miMbvTsz3tF0oHxchmyxca2KReva-R1RRYQ&_nc_zt=3&_nc_ht=scontent-
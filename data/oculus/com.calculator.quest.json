_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4t0Q9o_j11ftgT--TYSxrEvooWbQg7wjrQF_1MhzvSZw&oe=69FF3523"}, {"file_name": "hero_portrait_1008x1440.png", "id": "1258064419604866", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1258064429604865_8044946115449242694_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjG3uzio3kYQ7kNvwE-O4aH&_nc_oc=AdoSEBRTQeQjje0mBPf2HzePBIfFyKCoQGuxgwr2SnSvbaqMm-OhhGU5whTDpwdep64&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NJyXyoeH_DPSTdkFw3uOJb9DMo5frKWLNS4LEfHmufQ&oe=69FF37F8"}]}, "id": "1958571194867337", "locale": "en_US", "screenshots": [{"file_name": "1.png", "id": "1923378268568248", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823783_1923378275234914_7563970368077313000_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1y8R0th1BVIQ7kNvwEm2rFk&_nc_oc=Adp3GudcfQbZlgJKVnNwA5OwMV3g4ncElq49eJ4_ozmQNre0__MpITRPMwdgQBZivO8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55hDUCDv3qgBi_zG9AfgoWhkr2SM6FYGIMEBKUy41sGg&oe=69FF2B91"}, {"file_name": "2.png", "id": "911277978531425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818860_911277985198091_2193995836151340250_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQ6QX1M_U7wQ7kNvwHkyING&_nc_oc=AdokssOFC6Nbw8Qk1CfB6ZffqnLEpt1ird2P6VcZxKdVgkc24lJv9PNp6N6kQqmDxM4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5A_0XM7wcc7KvygKclltOTaJGNlRxY1ZS-vH_Bmp2nvg&oe=69FF451D"}, {"file_name": "3.png", "id": "1588646825726349", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825462_1588646829059682_52758224669800800_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RoKuERNI574Q7kNvwFFTadu&_nc_oc=Adq07e_mLeUrKEUsZUzP1WaK3JMX6GM7TVKuGIkZnJFkys5nI2CVSWIeznGtv0rtrKM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ohWM9CXv2wCf5Wq200x6-UjJkGfRps5c6Rag-scgl-w&oe=69FF29A2"}, {"file_name": "4.png", "id": "2224763694952551", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819281_2224763698285884_2984391317207770104_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B48PIyzNS1sQ7kNvwGbOuF-&_nc_oc=Adr_eeUoXl_LIx6RJ_mzcyw79OVMyhjsUDIkbCBnGodSUxNZemmUpJYF1ssX0U0vfrc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YVpe1e2YXvjEwLkrnkQwEbTkzFj1rcyHLHioP9DEGYg&oe=69FF279A"}, {"file_name": "5.png", "id": "1109979894587744", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_1109979897921077_4919178994838455810_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_wTiIegiZE0Q7kNvwFOlpdI&_nc_oc=AdrXIDBYwZSdlGBvCIcnZV-TKPJjOvcm0rbBpZjxfeiJTdBHJmn6MMgt3mNMkfHgNR0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XX6cX4T4UJ4VFcTeK7Qtr-0n_2bnB3MCGBBtYWPYU1Q&oe=69FF40E5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CalcVR Calculator", "keywords": ["calculator", "scientific", "math", "productivity", "utility"], "long_description": "CalcVR is a lightweight, native calculator designed specifically for Meta Quest. It runs as a floating 2D panel in your VR environment \u2014 always within reach, never in the way.\n\nTwo Modes, One Tap Away\nStart in Basic mode for everyday math. Need more power? Tap Scientific to unlock a full suite of advanced functions \u2014 and switch back just as easily.\n\nBasic Mode: Addition, subtraction, multiplication, division, percentage calculations, sign toggle, backspace and clear.\n\nScientific Mode: Trigonometric functions (sin, cos, tan), logarithms (ln, log), square root, square, power, factorial, inverse, constants (\u03c0, e), and parentheses for complex expressions.\n\nBuilt for VR: Runs as a system panel alongside other apps, resizable window, hand tracking support, dark UI theme optimized for VR readability, high-precision math engine with 15-digit accuracy.\n\nCalcVR is free, fast, and distraction-free. No ads. No permissions. Just math.", "short_description": "A sleek, fast calculator for Meta Quest. Switch between Basic and Scientific modes instantly. Runs as a resizable system panel in your VR workspace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://f1tt0n.github.io/calcvr-privacy/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Anwar Studio Official", "support_website_url": null, "website_url": "https://f1tt0n.github.io/calcvr-privacy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25927063416974433"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823351_1430972435149662_5440451268244965752_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1wKEdfOsE0Q7kNvwH0Q-Nm&_nc_oc=AdqfGfFqYX3eGs3q_SL6bO4yoID2D-vmImQBcARKVAX2alWpA1Z0q2jE2MJ86c1bqks&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SMHrkyi95QNRGu1byidxpN_UhY4pkXqLUMthpU38gPw&oe=69FF37D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "CalcVR Calculator", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Productivity", "id": "1063584910766706"}], "release_date": 1773173280, "lastRevision": {"nodes": [
nc_ohc=KD6WhE_55YUQ7kNvwEPfnY5&_nc_oc=AdnZa2hzP2hu50zBiwrbwcZKlFRk3kHMwuPlINw4hkLaNNHnbH-BPVO8giVHh12HgHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxpghcek8YJXwIAgXibzne0lWdz3XILSja9BeHomyBFoQ&oe=69BE8E1A"}, {"file_name": "5.png", "id": "1109979894587744", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_1109979897921077_4919178994838455810_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FukPD4Ead74Q7kNvwEnG-6_&_nc_oc=Adn5lizICXQFodRj5LI82AjzcNpVGHwMMTAVePDkgNfvUnYKMHmW5R2DQrYu8RmSnOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfykABQBUkwX2ZL3MvKh9ucM5su34i3r7FGE9n2Ls9fYfQ&oe=69BEA765"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "CalcVR Calculator", "keywords": ["calculator", "scientific", "math", "productivity", "utility"], "long_description": "CalcVR is a lightweight, native calculator designed specifically for Meta Quest. It runs as a floating 2D panel in your VR environment \u2014 always within reach, never in the way.\n\nTwo Modes, One Tap Away\nStart in Basic mode for everyday math. Need more power? Tap Scientific to unlock a full suite of advanced functions \u2014 and switch back just as easily.\n\nBasic Mode: Addition, subtraction, multiplication, division, percentage calculations, sign toggle, backspace and clear.\n\nScientific Mode: Trigonometric functions (sin, cos, tan), logarithms (ln, log), square root, square, power, factorial, inverse, constants (\u03c0, e), and parentheses for complex expressions.\n\nBuilt for VR: Runs as a system panel alongside other apps, resizable window, hand tracking support, dark UI theme optimized for VR readability, high-precision math engine with 15-digit accuracy.\n\nCalcVR is free, fast, and distraction-free. No ads. No permissions. Just math.", "short_description": "A sleek, fast calculator for Meta Quest. Switch between Basic and Scientific modes instantly. Runs as a resizable system panel in your VR workspace."}]}, "developer_n
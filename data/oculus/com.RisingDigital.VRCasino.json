5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53olILGc3EdGH33vyJaWIt-A3tbbutxnAHE2aVXWPWyQ&oe=6A19BBAC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1640447910620523", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499303864_1640447913953856_8778089648188273896_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h32xSw6oCgYQ7kNvwFgeEF6&_nc_oc=AdrnFNPsVBxdwHpR_hXAVApep6ut-eUeOQ0R2b4l49Hvt8hd70gXALUMP6pEGEtnH3w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sQxzFRQqckBJGxfLUA9b4kBhnKhPW82dwSdnlC8Gj8g&oe=6A19A39F"}, "display_name": "Winning Dragons", "keywords": ["casino", "slot", "Universal", "social", "Vegas"], "long_description": "# Chase the rainbow to riches with the all-new \u201cA Wee Bit Wild\u201d update! Step into a lush emerald realm where the enchanting \u201cA Wee Bit Wild\u201d slot comes alive in stunning VR. Spin with Irish luck, trigger epic bonus rounds featuring shimmering wilds and multiplying pots of gold, and hunt massive jackpots in an immersive 3D world. Whether you\u2019re a high-roller or just testing your fortune, \u201cA Wee Bit Wild\u201d delivers heart-pounding excitement and bigger thrills than ever. Update now and let the shamrock lead you to legendary wins! Free to play \u2013 endless fortune awaits in Winning Dragons!\n\n**Discord:** https://discord.gg/WeE3mGYaHj\n\n**Facebook:** https://www.facebook.com/groups/1064744705574930\n{1388708499596337}\n# Key Features:\n\nClassic themes from Universal Monsters, Jaws, and Jurassic Park\u2014 decked in holiday cheer and festive spins.\n{738808249229748}\nOriginal casino quality games like 3 Pearls slots and Roulette under the mistletoe. \n{1531137854873811}\nExpansive VIP lounge for the high rollers, complete with high-stakes games.\n{732040696594512}\nSocial Bonuses from 6 pm to 10 pm CST every Friday and Saturday\u2014double the cheer with extra daily bonuses.\n{1372463134488870}\nThemed events with limited edition holiday items.\n{2424982977958555}\nLive chat to jingle with your friends, or team up for co-op roulette rounds while enjoying the holiday cheer.\n{695060666696705}\n\n# Join the Adventure Today!\nBe an early adopter, score limited-edition rewards, and share your feedback for a chance to unlock mystery rewards! Play Winning Dragons now and let every spin ignite your winning streak!\n\n", "short_description": "Step into the Winning Dragons Early Access and  immerse yourself in a VR casino adventure where every spin is full of excitement. Connect, compete, and encounter the spirit of the casino right before your eyes. Slip on your VR headset and let every spin bring you closer to epic wins. Start your journey today and feel the roar of victory!\n\nAny efficient feedback and suggestions will get mystery rewards!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.risingdigital.com/?page_id=2200", "developer_terms_of_service_url": null, "publisher_name": "Rising Digital", "support_website_url": null, "website_url": "https://www.risingdigital.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26794171480201212"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296236_745787558267285_4758258192746072233_n.png?stp=dst-png_s360x3
d locomotion as you climb, launch, and outplay others across custom-designed maps and dynamic game modes."}]}, "developer_name": "SPACEIFYYY", "developer_privacy_policy_url": "https://docs.google.com/document/d/1vZP33srl6a25VUIDaMuVfdxuczf0UKoJ7qKt9EKV160/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SPACEIFYYY", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1xt5A4vsyocBSR3f4Urq2X1lqQtNb1JWx4zo1ryMwppY/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26241666462183355"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499304106_948132434220133_8295701047580787634_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-tBq0r-6i74Q7kNvwHzK7L1&_nc_oc=AdoiRruGbzFD8k1kyMqaDqgqxW07FwlmvKruxapa1wHxhMLE5d5qMvpy7HmKdIu3hYo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSnDm3OX-LggZEipvn70RrdY7xnguj2gOEDcjnRzVARyw&oe=6B0B1C7A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "LAVA HUNTERS", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1773849420, "lastRevision": {"nodes": [{"id": "8500473106729297", "rele
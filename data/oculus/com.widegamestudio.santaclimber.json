com/v/t64.5771-25/75568729_957616736226181_248872339428838956_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEcmYHGffwgQ7kNvwEm7gRT&_nc_oc=Adrx5vVkaa5xfKdZ3kSa4Dd7prIq13azb6y1Y9AgprxEsnucA_S7JF7bMD2U1xLsLDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hTLroRLCgxToMJmljmCDbrz0kNyLtheFENKbUCgfaUw&oe=6A033B9C"}, {"file_name": "ss-2.png", "id": "2389525634719391", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39003244_2389525638052724_1264944382341137383_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uhe6dpvKpx4Q7kNvwGg9kob&_nc_oc=AdrVd6H6YVue15ayBE-LfXvOPwmsK4AMULmRfy43uQu7dyy2t2m9SXrgmnC1f3-1wdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gYj7lHWwC5iuSgCJUpWbxxPN3tTCFRyXmZhnKj1BC0A&oe=6A031829"}, {"file_name": "Screenshot17.png", "id": "899430715331396", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75269160_899430721998062_6622083555410339756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IWTArC-B74Q7kNvwGe-MLd&_nc_oc=Adpg8NG_uDCJKuuiCwISDfmGUrLcBy51bAAyJbQczxarCcXk_n9WBRRYwMbEC1jpZWg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TsKKtQN9S78Auay_QvU0e4K62BeF2Mg3T-3aBD9r2WA&oe=6A033505"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launch-trailer.png", "id": "1369420680907026", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982588_1369420684240359_5188357687988717631_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyz5kJLd4esQ7kNvwF6KUdq&_nc_oc=Adq5YQmnN8BWVN2ovE2m2ShBT5YKBvbI8QjjUECX8-zqtPQwrKH2aNgo4o49m6zyw_4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jlsfPFXQaRC3ugfjm569SUPou9YJo3X5o7ZjlgRw6pg&oe=6A031FA8"}, "display_name": "Santa Climber", "keywords": ["climb", "climber", "santa", "multiplayer", "coop"], "long_description": "# \ud83c\udf85 Get Ready to Scale New Heights This Holiday Season!\nStep into the boots of a cute Santa Claus in Santa Climber, the ultimate climbing adventure! Armed with candy canes and an iron will, you\u2019ll climb snowy rooftops, icy slides, spinning wreaths,  and festive obstacles to deliver presents and save Christmas. With your trusty reindeer Rudolph sniffing its nose because of the flu,  it\u2019s up to you to keep the holiday spirit alive\u2014one chimney at a time!\n\n**\ud83e\uddd7 Candy Cane Climbing Fun:** Master physics-based climbing mechanics for a fresh, challenging gameplay experience. Look out for the wreaths and gifts, your candy canes may get stuck!\n{558871726987825}\n\n**\ud83e\udd1d Multiplayer Mode:** Partner up in co-op mode or race your friends to become the fastest Santa to deliver gifts. Do you have the spirit for saving Christmas?\n\n{1555537405167398}\n\n**\ud83c\udf84 Holiday-Themed Challenges:** Navigate icy slides, swinging ornaments, and spinning wreaths across beautifully designed winter levels. You can literally hear the bells jingle in this game.\n{1957050388039689}\nWhether you're playing solo, teaming up with friends, or racing against them, Santa Climber is super fun and brings festive thrills that will warm even the chilliest of hearts. Can you conquer the parkour and save Christmas in time without letting the rage get the better of you..?\nHoist your candy canes, start climbing, and let the holiday adventure begin!\n\n\n", "short_description": "In Santa Climber, you\u2019re Santa stuck in a chimney and your loyal reindeer, Rudolph, is sick\u2014but that won\u2019t stop you! Climb, swing, and gift through a winter wonderland with friends in this lighthearted adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://santaclimber.widegamestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "contex
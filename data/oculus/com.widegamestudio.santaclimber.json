=1-7&_nc_sid=6e7a0a&_nc_ohc=TgiktsEEG6wQ7kNvwEWRkOE&_nc_oc=AdqF8nIHiHjXXM2_O4CK7_ZYjlbHNUCHDQkoqdmts6MAJ0f68DS371kB-D1AkE8mNYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IxXB7hIwCrhQAX6g6RvMNFOO-QU-PaSkTA1c-TrgAXg&oe=6A032E08"}, {"file_name": "Screenshot37.png", "id": "1084804273125784", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223483_1084804276459117_622156840082921041_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_pML95lI1oQ7kNvwHENA44&_nc_oc=Adq_34a2zX7xfeR5-g7xyiPeTsZ4Vz0DJW4VHCB6mlp5Q1JiNAdYMNz58Gu8lFSan7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Vtt0h8n1OVNKAT4gKPZwtUDVdnHtMe6hMNuT524a5LA&oe=6A033552"}, {"file_name": "Screenshot33.png", "id": "957616732892848", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75568729_957616736226181_248872339428838956_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fEcmYHGffwgQ7kNvwEm7gRT&_nc_oc=Adrx5vVkaa5xfKdZ3kSa4Dd7prIq13azb6y1Y9AgprxEsnucA_S7JF7bMD2U1xLsLDA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hTLroRLCgxToMJmljmCDbrz0kNyLtheFENKbUCgfaUw&oe=6A033B9C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1630946498179755", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499296119_1630946501513088_8096212431036476961_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FEnZlvE4KWIQ7kNvwGKERyt&_nc_oc=AdonZ5cpv5bQ2YaSZuCBwuEqJ5qDKpSnuJvbesbp4qDm4qFCaLsLSpQipU-qAPjjaz0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6b8KLUmmzqGdUJYtdyVp0gYvqhts66A_ceg5KL2TtcIQ&oe=6A032C63"}, "display_name": "Santa Climber", "keywords": ["climb", "climber", "santa", "multiplayer", "climbing"], "long_description": "# \ud83c\udf85 Santa Climber \u2013 A Climb Worth Coming Back To\n\nSanta Climber is a physics-based climbing adventure where things rarely go as planned. Using your candy canes, you\u2019ll swing, climb, and recover your way through tricky obstacles, icy surfaces, and unpredictable moments.\n\nIt\u2019s easy to start. Staying in control is the real challenge.\n\n# \ud83e\udd1d Solo or Multiplayer Chaos\nPlay alone to focus on your climb, or jump in with others to race, cooperate, or just create complete chaos. Every run feels a little different depending on who you\u2019re playing with.\n\n{634751932331313}\n\n# \ud83d\udd25\u2744\ufe0f Multiple Ways to Play\n\n- \ud83c\udf84 **Classic Mode** \u2013 A balanced climbing experience with a mix of obstacles and slippery surprises.\n\n- \ud83d\udd25 **Floor is Lava** \u2013 Keep moving as the pressure builds and the danger rises.\n\n- \ud83c\udfed **Factory Mode** \u2013 A different layout with more unpredictable challenges.\n\n{1383112596384173}\n\n# \ud83e\uddd1\u200d\ud83c\udf84 Customize Your Santa\nChoose from a growing selection of Santa styles and stand out while you climb.\n\n\n# \ud83d\udcac Built-In Voice Chat\nPlan your route\u2026 or react in real time when everything goes wrong.\n\n**Hoist your candy canes and conquer the climb! \ud83d\ude80\ud83c\udf6d**\n", "short_description": "Scale tricky obstacles and icy paths in Santa Climber! \ud83c\udf85 Use your candy canes to climb with precision, tackle different modes, and enjoy unpredictable physics. \ud83e\uddd7\u200d\u2642\ufe0f Play solo or with friends and see who can make it to the top."}]}, "developer_name": null, "developer_privacy_policy_url": "https://santaclimber.widegamestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_a
v8Ml7svcD7at5r_sbdv6e5s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ejg7GUCDJhXtBCEHdh45xmsqb76UyCaUnEp2_Uslx5Q&oe=69E4C5A9"}, {"file_name": "Screenshot17.png", "id": "899430715331396", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75269160_899430721998062_6622083555410339756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9aEOu6cN0wQ7kNvwG7aSAm&_nc_oc=AdqajDy-AufaIlvL0SMA9-bQMlmF6euThQ4HTPDKmv36-c1fxaKJ2G4g3o9v9IwzdqM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28pSM_g875DjPLGAupvT-8uDiOojLUB7HONKC9rC1xGA&oe=69E4E285"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launch-trailer.png", "id": "1369420680907026", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982588_1369420684240359_5188357687988717631_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lOpa7kcrcvoQ7kNvwFIy6ZO&_nc_oc=AdrmYzWIYa6CnwMUoXOWNDQ6jhkvr6KinzCvinfSImQzgnO-m1oyuTLUcJr_fUL0F7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XAe5SElbogD9ap48HSGC1eMxJ7INj3DVr_ZZJYkCONQ&oe=69E4CD28"}, "display_name": "Santa Climber", "keywords": ["climb", "climber", "santa", "multiplayer", "coop"], "long_description": "# \ud83c\udf85 Get Ready to Scale New Heights This Holiday Season!\nStep into the boots of a cute Santa Claus in Santa Climber, the ultimate climbing adventure! Armed with candy canes and an iron will, you\u2019ll climb snowy rooftops, icy slides, spinning wreaths,  and festive obstacles to deliver presents and save Christmas. With your trusty reindeer Rudolph sniffing its nose because of the flu,  it\u2019s up to you to keep the holiday spirit alive\u2014one chimney at a time!\n\n**\ud83e\uddd7 Candy Cane Climbing Fun:** Master physics-based climbing mechanics for a fresh, challenging gameplay experience. Look out for the wreaths and gifts, your candy canes may get stuck!\n{558871726987825}\n\n**\ud83e\udd1d Multiplayer Mode:** Partner up in co-op mode or race your friends to become the fastest Santa to deliver gifts. Do you have the spirit for saving Christmas?\n\n{1555537405167398}\n\n**\ud83c\udf84 Holiday-Themed Challenges:** Navigate icy slides, swinging ornaments, and spinning wreaths across beautifully designed winter levels. You can literally hear the bells jingle in this game.\n{1957050388039689}\nWhether you're playing solo, teaming up with friends, or racing against them, Santa Climber is super fun and brings festive thrills that will warm even the chilliest of hearts. Can you conquer the parkour and save Christmas in time without letting the rage get the better of you..?\nHoist your candy canes, start climbing, and let the holiday adventure begin!\n\n\n", "short_description": "In Santa Climber, you\u2019re Santa stuck in a chimney and your loyal reindeer, Rudolph, is sick\u2014but that won\u2019t stop you! Climb, swing, and gift through a winter wonderland with friends in this lighthearted adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://santaclimber.widegamestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9026348834097519"}}]}, "scheduled_o
uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974836_611155074704325_732067859997458197_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8czw887CVkoQ7kNvwHHehKF&_nc_oc=AdqbMPnRZQBRCvWQQUoJOsClXkI-tuOpuvnv0ZZ_rdhg7QC2mJcWr5OfeQs4wsdX0xw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7HJEyVOjUwp34Qfi6zgje32ne1GvJHP3Ar0VRoi3jfw&oe=6A6223BE"}, {"file_name": "SC-ss (1).png", "id": "1270400808631168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620860_1270400815297834_895340843010149633_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHEb4ue6QXEQ7kNvwGveJoH&_nc_oc=AdrgIdWqWa0X5cMM9eOgiSs1nCfdz1BElnXjZQD3aUTgrIzb-iU72_nnoEJPyzoelH8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr3PoYfUIX10gVR2l-th6YQqlEDoiGONb9Ty8Q3ME7rw&oe=6A621A08"}, {"file_name": "Screenshot33.png", "id": "957616732892848", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568729_957616736226181_248872339428838956_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VvFy9VmDrkQ7kNvwGFxOZx&_nc_oc=AdoDJvRKvlldvkFr1Sm8bH66aeMlNhtck_U2eUkqdRQxxPtB-9f2pv68w2-VsnpnK9M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzK3xy-Xg-UJF9iB5vVd_1vlyhOoXOTuQmWI5VeiNIpQ&oe=6A62279C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1630946498179755", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499296119_1630946501513088_8096212431036476961_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DPwUhiVEWEQ7kNvwFPzqOr&_nc_oc=AdpkEfkqRPp_LFpKj2xXaL4nyitG8ngmd6WBgyanBnJr42rrO06mIzuWQd2bw__bXZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwfIm7uBJfNx4hH1OaJ0lwiEjFG0X_vyCvtaun_0qxMg&oe=6A621863"}, "display_name": "Santa Climber", "keywords": ["climb", "climber", "santa", "multiplayer", "climbing"], "long_description": "# \ud83e\uddd7 Santa Climber \u2013 Grip It. Swing It. Don't Fall.\n\nOne candy cane in each hand. A towering obstacle course ahead. And absolutely no guarantee you'll make it to the top. Swing, grip, recover, and somehow keep moving upward \u2014 even when everything around you is working against it.\n\n# \ud83c\udf00 Chaos is the Point\n\nNo two runs are the same. Slippery surfaces, moving platforms, unpredictable physics, and the beautiful disaster of other players make every attempt feel fresh. You'll fall. A lot. But getting back up is half the fun.\n\n# NEW:\ud83d\uddfc Tower Mode\n\nA vertical endurance test unlike anything else in the game. The Tower gets tighter, faster, and meaner the higher you go. No checkpoints. No mercy. Just you, your candy canes, and the question of how far you can actually get.\n\n# \ud83d\udc65 Climb Together. Suffer Together.\n\nJump in solo or bring friends into the chaos. Race each other to the top, accidentally knock each other off ledges, or team up and watch it still go wrong somehow. \n{634751932331313}\n\n\n# \ud83d\uddfa\ufe0f Choose Your Arena\n\n\u2013 \ud83c\udfd4\ufe0f Classic Mode \u2013 The full climbing experience. Obstacles, surprises, and a long way down if you slip.\n\u2013 \ud83d\udd25 Floor is Lava \u2013 The floor is rising. The pressure is real. Keep climbing or face the consequences.\n\u2013 \ud83c\udfed Factory Mode \u2013 Industrial chaos with unpredictable layouts that keep you guessing every step of the way.\n\n\n# \ud83c\udfa8 Make Your Santa Yours\n\nPick from a growing roster of Santa skins and customize how you look on the climb. New styles drop regularly \u2014 so there's always a reason to check back in.\n{1383112596384173}\n\n\n\n\n\n\n\n\n\n\n\n", "short_description": "Scale tricky obstacles and icy paths in Santa Climber! \ud83c\udf85 Use your candy canes to climb with precision, tackle different modes, and enjoy unpredictable physics. \ud83e\uddd7\u200d\u2642\ufe0f Play solo or with friends and see who can make it to the top of the TOWER!N"}]}, "developer_name": null, "developer_privacy_policy_url": "https://santaclimber.widegamestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "27050364971269296"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499307505_26330318720001946_536226133349303544_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNLQFUvKSWoQ7kNvwEedLjG&_nc_oc=AdqTp0WcOciQ5NOmwCzgWxmp-JYg8u6XxlgWpeVj6H48ovycIKFOoA4Gmjf23AthZ3M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB08AMnGPiWmwhzYU1_pXpnBrlDraQwZl0iwsaw5Ta7HQ&oe=6A621BDA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Santa Climber", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Arcade", "id": "1592192974313489"}], "release_date": 1734668580, "lastRevision": {"nodes": [{"id": "8983046108427792", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "8983046065094463", "is_first_party": false, "enables_in_app_ads": false, "is_concept":
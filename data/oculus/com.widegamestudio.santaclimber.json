, {"file_name": "Screenshot37.png", "id": "1084804273125784", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75223483_1084804276459117_622156840082921041_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poPTIGcUzRMQ7kNvwFLqMAH&_nc_oc=Adqa8-Z8dLnqlrXoxrJ-nClJYWDKbRfKOPug41Lhjlo61DM3HnsGRskxdB0Ftby5lyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSFbCVFTKxr3qx120dAjfNv7bWo7V1Jna2huhPIYXzCQ&oe=6A622152"}, {"file_name": "Screenshot33.png", "id": "957616732892848", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75568729_957616736226181_248872339428838956_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VvFy9VmDrkQ7kNvwGFxOZx&_nc_oc=AdoDJvRKvlldvkFr1Sm8bH66aeMlNhtck_U2eUkqdRQxxPtB-9f2pv68w2-VsnpnK9M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzK3xy-Xg-UJF9iB5vVd_1vlyhOoXOTuQmWI5VeiNIpQ&oe=6A62279C"}, {"file_name": "ss-2.png", "id": "2389525634719391", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39003244_2389525638052724_1264944382341137383_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pm2FVxuRP-IQ7kNvwGsfk9U&_nc_oc=AdoXWTaveMv1YuPBwhxGd_IfJ-UJUla1wiLnYJo5W84xrYCGOsVPJzVwVUijWu5J-U4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq5uvynX4OpMSpufvgxTX2hkdgbk5F39845Sa9YoWDjw&oe=6A620429"}, {"file_name": "Screenshot17.png", "id": "899430715331396", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75269160_899430721998062_6622083555410339756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiIh4Fp9OBIQ7kNvwEUH72u&_nc_oc=Adopw53AGL1xmfTi7QguJjkycP6MgXcH6fbHkoJoKXsGf2-SDjfDpIZs2BjYXcG_pPk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwuirGpEiBa9asRtGLjU1wno9SsMoiubsp8GunoEOjIQ&oe=6A622105"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "launch-trailer.png", "id": "1369420680907026", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982588_1369420684240359_5188357687988717631_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x1JpKxvnDFAQ7kNvwH44Hc7&_nc_oc=Adr3JZFXKdIrdeormL36AeeUK6EzB9korKr9XR6FhmyI_CJZbHOO4uOtoKIswwTavDQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmneb-FmC6WplbldkT9XHf4r_7vHdc_L1C8B3UmR50eA&oe=6A620BA8"}, "display_name": "Santa Climber", "keywords": ["climb", "climber", "santa", "multiplayer", "coop"], "long_description": "# \ud83c\udf85 Get Ready to Scale New Heights This Holiday Season!\nStep into the boots of a cute Santa Claus in Santa Climber, the ultimate climbing adventure! Armed with candy canes and an iron will, you\u2019ll climb snowy rooftops, icy slides, spinning wreaths,  and festive obstacles to deliver presents and save Christmas. With your trusty reindeer Rudolph sniffing its nose because of the flu,  it\u2019s up to you to keep the holiday spirit alive\u2014one chimney at a time!\n\n**\ud83e\uddd7 Candy Cane Climbing Fun:** Master physics-based climbing mechanics for a fresh, challenging gameplay experience. Look out for the wreaths and gifts, your candy canes may get stuck!\n{558871726987825}\n\n**\ud83e\udd1d Multiplayer Mode:** Partner up in co-op mode or race your friends to become the fastest Santa to deliver gifts. Do you have the spirit for saving Christmas?\n\n{1555537405167398}\n\n**\ud83c\udf84 Holiday-Themed Challenges:** Navigate icy slides, swinging ornaments, and spinning wreaths across beautifully designed winter levels. You can literally hear the bells jingle in this game.\n{1957050388039689}\nWhether you're playing solo, teaming up with friends, or racing against them, Santa Climber is super fun and brings festive thrills that will warm even the chilliest of hearts. Can you conquer the parkour and save Christmas in time without letting the rage get the better of you..?\nHoist your candy canes, start climbing, and let the holiday adventure begin!\n\n\n", "short_description": "In Santa Climber, you\u2019re Santa stuck in a chimney and your loyal reindeer, Rudolph, is sick\u2014but that won\u2019t stop you! Climb, swing, and gift through a winter wonderland with friends in this lighthearted adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://santaclimber.widegamestudio.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Wide Game Studio", "support_website_url": null, "website_url": "https://widegamestudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "9026348834097519"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "1469175271410402"}, {"status": "PUBLISHED", "id": "1734491937240421"}, {"status": "PUBLISHED", "id": "2641037786238464"}, {"status": "PUBLISHED", "id": "682372824601369"}, {"status": "PUBLISHED", "id": "4142342489322864"}, {"status": "PUBLISHED", "id": "566057616300391"}, {"status": "PUBLISHED", "id": "941885680699881"}]}, "baseline_offer": {"id": "1469175271410402"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776072960, "status": "PUBLISHED", "id": "1469175271410402"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27015609131411547", "version": "DEV-1.2.0-169"}, "id": "3878420452411726", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bina
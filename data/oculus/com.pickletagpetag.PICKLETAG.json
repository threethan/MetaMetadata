ickletagpetag.PICKLETAG-20260510-032529.png", "id": "1907888716574868", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308204_1907888719908201_7556900399939987458_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWSFnUYiqCEQ7kNvwFq1ee1&_nc_oc=AdoRG2vvEMr-_qNjn9HNEiRz7HJ3rBdkTmbYErCBUQEcrl872lmVDJZsDCWeQtTOick&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCj1xMFIFDFxlVnThleu7Qzc7C5YV1fOgg6EBWQVoVyAg&oe=6A5B697F"}, {"file_name": "com.pickletagpetag.PICKLETAG-20260510-032507.png", "id": "1804581463835109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303672_1804581467168442_7781983281853417396_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DoPmM-nOjGkQ7kNvwHOK8vx&_nc_oc=Adovmoid4_srTPOY7xWfV0_0BUxe40NUP4RxztZKqsTbivGTNtiV0oJZcYboDDzZBlM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8XtRrF4mcX6javO1WjGHbqrnowxZaOFa3rIsUrRudTg&oe=6A5B83E7"}, {"file_name": "com.pickletagpetag.PICKLETAG-20260510-032430.png", "id": "1984620415478614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305050_1984620422145280_3647704813663907542_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo1_j_sHHKoQ7kNvwEHMemH&_nc_oc=Adp-fVuCIajyySUxk_twVcX4EjAvAMoORq8vx-Ep9rMgnFEIZ0_dgDpc60FaDWEnjlo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBojS1a96nNS8j71jBRq4mmxeEqZnYUEXgUpkdQHZrcfw&oe=6A5B5D91"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickle Tag", "keywords": [], "long_description": "Pickle Tag\nThe Ultimate Brine-Fueled Chase!\n\nMaster the iconic \"arm-swinging\" locomotion you love with a crisp, green twist. Pickle Tag takes high-energy VR movement and drops it into a world of competitive chaos. No buttons, no joysticks\u2014just pure physics as you fling yourself across vibrant maps to avoid being tagged.\n\nWhy Play Pickle Tag?\nMaster the Movement: Dive into polished, physics-based mechanics that make every leap and climb feel responsive and rewarding.\n\nVinegar-Fueled Parkour: Navigate vertical playgrounds, hidden corners, and high-speed lanes designed for elite escapes.\n\nSocial & Competitive: Join a growing community of players. Whether you\u2019re playing casual tag or competitive rounds, there\u2019s always a lobby waiting.\n\nGet Your Crunch On: Stand out with unique pickle-themed aesthetics and immersive environments.\n\nStop loafing around\u2014grab your controllers and join the jar!", "short_description": "Experience the crunch! Inspired by the movement mechanics of Gorilla Tag, Pickle Tag brings a vinegary twist to the VR chase genre. Use your hands to climb, jump, and swing through immersive maps as you outrun\u2014or hunt down\u2014your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/petagpolicyfr/home", "developer_terms_of_service_url": null, "publisher_name": "RVXGT/AIDENVR/PICKLES", "support_website_url": null, "website_url": "https://sites.google.com/view/petagofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26694261420202957"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes":
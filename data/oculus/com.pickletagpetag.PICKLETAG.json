ickletagpetag.PICKLETAG-20260510-032529.png", "id": "1907888716574868", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499308204_1907888719908201_7556900399939987458_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkMa9S2T8_gQ7kNvwHt3b6G&_nc_oc=Adr5BNu-rNmrCr646tVjxbJPeM0l150fA3j46Eeu0sWEwRLL42Oc9Sjre4yVOHe21oM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtI8ksjdzQe6veppted19Qd14vXkAn4KFNYSDyJ9XqDA&oe=6A6DDE7F"}, {"file_name": "com.pickletagpetag.PICKLETAG-20260510-032507.png", "id": "1804581463835109", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499303672_1804581467168442_7781983281853417396_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbBVSzxXutUQ7kNvwH8ILuq&_nc_oc=Adocyn7dHOE3QEqZVQ1gAiCciqv_FV_1J3sEXzTVsGDn23v67FJ6WWJ-sTF6eO7pctE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRFX-Jig-YB8LnTkXxXfQMIyzY873I_0OWrXAFjMjECg&oe=6A6DF8E7"}, {"file_name": "com.pickletagpetag.PICKLETAG-20260510-032430.png", "id": "1984620415478614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499305050_1984620422145280_3647704813663907542_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzkF15VfXBUQ7kNvwF91A0h&_nc_oc=AdqdQ0_EWFXohU0VkXRtmSl_AItA7ejBDs8tlIH1fcfEj2ArTTVYQQ1adErsdUI4GhI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCV0KqNA0Z8s_IzJ1lCH24sUmm4XedKyjEXpQEuOO9MA&oe=6A6E0AD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Pickle Tag", "keywords": [], "long_description": "Pickle Tag\nThe Ultimate Brine-Fueled Chase!\n\nMaster the iconic \"arm-swinging\" locomotion you love with a crisp, green twist. Pickle Tag takes high-energy VR movement and drops it into a world of competitive chaos. No buttons, no joysticks\u2014just pure physics as you fling yourself across vibrant maps to avoid being tagged.\n\nWhy Play Pickle Tag?\nMaster the Movement: Dive into polished, physics-based mechanics that make every leap and climb feel responsive and rewarding.\n\nVinegar-Fueled Parkour: Navigate vertical playgrounds, hidden corners, and high-speed lanes designed for elite escapes.\n\nSocial & Competitive: Join a growing community of players. Whether you\u2019re playing casual tag or competitive rounds, there\u2019s always a lobby waiting.\n\nGet Your Crunch On: Stand out with unique pickle-themed aesthetics and immersive environments.\n\nStop loafing around\u2014grab your controllers and join the jar!", "short_description": "Experience the crunch! Inspired by the movement mechanics of Gorilla Tag, Pickle Tag brings a vinegary twist to the VR chase genre. Use your hands to climb, jump, and swing through immersive maps as you outrun\u2014or hunt down\u2014your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/petagpolicyfr/home", "developer_terms_of_service_url": null, "publisher_name": "RVXGT/AIDENVR/PICKLES", "support_website_url": null, "website_url": "https://sites.google.com/view/petagofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26694261420202957"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes":
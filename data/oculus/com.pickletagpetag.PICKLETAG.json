cdn.com/v/t64.5771-25/499303672_1804581467168442_7781983281853417396_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HMxfy5BagcQ7kNvwGtgE7-&_nc_oc=Adp39phi1oNn71tMyyAKkoG1ZAcrlOdcsO69dLHAhR5A6i2cDQWwuddVxSjr7kMLZxg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-smVueAHykk5a304FsW1WNmO_L8HeGp0f12zIMOVlqsg&oe=6A296AE7"}, {"file_name": "com.pickletagpetag.PICKLETAG-20260510-032430.png", "id": "1984620415478614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499305050_1984620422145280_3647704813663907542_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IZRnQrK8WBEQ7kNvwFXabos&_nc_oc=AdqqzTeFOwU3e8M38IY8iWtcrgDzbgV5HFJ2Lj8RR7i4HKTvtMTwV7RY0G8vBxbslkc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LSNt1Agjtf2Cba2Lw926XQD9vQ1esnnIelJMHUo3-Rw&oe=6A297CD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Terra Tag Reborn V3", "keywords": ["Fun"], "long_description": "Terra tag Reborn\nThe Ultimate Brine-Fueled Chase!\n\nMaster the iconic \"arm-swinging\" locomotion you love with a crisp, green twist. Terra tag Reborn takes high-energy VR movement and drops it into a world of competitive chaos. No buttons, no joysticks\u2014just pure physics as you fling yourself across vibrant maps to avoid being tagged.\n\nWhy Play Terra tag Reborn?\nMaster the Movement: Dive into polished, physics-based mechanics that make every leap and climb feel responsive and rewarding.\n\nVinegar-Fueled Parkour: Navigate vertical playgrounds, hidden corners, and high-speed lanes designed for elite escapes.\n\nSocial & Competitive: Join a growing community of players. Whether you\u2019re playing casual tag or competitive rounds, there\u2019s always a lobby waiting.\n\nGet Your Crunch On: Stand out with unique pickle-themed aesthetics and immersive environments.\n\nStop loafing around\u2014grab your controllers and join the jar!", "short_description": "Experience the crunch! Inspired by the movement mechanics of Gorilla Tag, Terra tag Reborn brings a vinegary twist to the VR chase genre. Use your hands to climb, jump, and swing through immersive maps as you outrun\u2014or hunt down\u2014your friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/petagpolicyfr/home", "developer_terms_of_service_url": null, "publisher_name": "RVXGT", "support_website_url": null, "website_url": "https://sites.google.com/view/petagofficial/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26863781213250976"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499312454_1007004598457017_4354274466175669521_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfbGc-JOom0Q7kNvwHxypAS&_nc_oc=AdoTOiWZNFLpVOMz6iI8zRGcQFFNUXo7sqXKJ8KkweGKLoOt8dWTBI6cXxVdxyzn2tE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-SQEce_sbFnCXvMUWzQok1BmwqohniWFTMqsZWwH2UdA&oe=6A296E96"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Terra Tag Reborn V3", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1778529600,
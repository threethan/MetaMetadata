ess&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PUSH11DLbq4Q7kNvwEwxBDc&_nc_oc=AdpPAwzn80fujeMWRy9ohQ3IdfjuwxZLyW-B8sovXeGbKZCWM1xu4QaLGR253-b9Tj8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1dkMQqanVJbIoC_ksUJss0g9QUclGzRyYGJT7UhPnDQ&oe=6B0308FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Thumbnail_2022-03-11_(2560 \u00d7 1440 px).png", "id": "1031675607452540", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974660_1031675610785873_5337617673550948645_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rCqmGFvRF3wQ7kNvwF9FfOv&_nc_oc=AdpgaeC_fug4NuaiMWgFuaqHG_Y7fb0wzXKxDlbT0PKc6_pu4VBwck4zrq8UnFUm4l4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHaRRT7hvUhPSnPdFv8H6iDlLM3E0SVkH7bmpn4TIDQA&oe=6B032F93"}, "display_name": "Steps of Privilege (Beta)", "keywords": [], "long_description": "Steps of Privilege (Beta) is an interactive VR experience that provides a safe space to explore the nuances of privilege and foster the discussion around diversity, equity & inclusion.\n\nIn this fundamental, yet powerful, experience, users listen to 20 statements and move forward or backward if the statement applies to them. For example, If you studied the culture of your ancestors in elementary school, take one step forward, and so on. This exercise provides people with a unique opportunity to understand and reflect on the intricacies of their own privilege in a safe and judgment-free environment, while not exploiting the stories of others. People are also given the opportunity to experience and contribute to a community collected, call-to-action idea board through saved audio recordings.\n\nEngaging with Steps of Privilege increases cultural competence and emotional intelligence, and empowers users to leverage their position within a social structure to work for social justice.", "short_description": "Steps of Privilege (Beta) is an interactive VR experience that provides a safe space to explore the nuances of privilege and foster the discussion around diversity, equity & inclusion."}]}, "developer_name": "REM5 Studios", "developer_privacy_policy_url": "https://www.rem5forgood.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.rem5forgood.com/stepstermsandconditions.html", "publisher_name": "REM5 Studios", "support_website_url": null, "website_url": "https://www.rem5forgood.com/steps.html", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "NARRATIVE", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "413136807275875"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974854_990265221579423_5812509968316492635_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8frnOavba7AQ7kNvwEAwQei&_nc_oc=AdrOyqtSyt6sApGB7yHvSCyaIVuPFEGrQq-MdZagzOeHgfYUamuP0i5-47d3jF4decM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0I8yxEWZT80bvtIQwDmQsJbYDEXOztygkgtDE2ddypg&oe=6B0301AB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Steps of Privilege (Beta)", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}, {"topic_name": "Narrat
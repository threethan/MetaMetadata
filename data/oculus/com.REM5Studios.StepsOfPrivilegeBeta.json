om&_nc_ss=7f20f&oh=00_AQQY_fwzqZRODix3YcwMSesFinFpfRjq57TpFYGCx7n7OA&oe=6AFF1139"}, {"file_name": "Steps_of_Privilege_07_Orbs.png", "id": "5094010363952323", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982727_5094010367285656_7245475253513303616_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw_S7lgzJbMQ7kNvwHz6OAb&_nc_oc=AdpJ_y2SSGG1c0xnWwO7DxDPk3jPKmaSUHhRCuiVkJeD6-7a8dmb9E49Cjx1Wot-O3M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCfSSAVti5FUk2PbQZ76-zs1vA3ytyA2_--fy6rut6Kg&oe=6AFF147E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_Thumbnail_2022-03-11_(2560 \u00d7 1440 px).png", "id": "1031675607452540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974660_1031675610785873_5337617673550948645_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFOP7_zL_YYQ7kNvwFKqbmU&_nc_oc=Ado_z4_qTy6_ZEh6k3yiCIqolxysbH2Pg3Puug-byhgwSNrBqQiYJlijVwyAeX0T84U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMqto85oBNZES9t9VfAIQsvISS9Wlo_K6OFNkxjoPhyw&oe=6AFF02D3"}, "display_name": "Steps of Privilege (Beta)", "keywords": [], "long_description": "Steps of Privilege (Beta) is an interactive VR experience that provides a safe space to explore the nuances of privilege and foster the discussion around diversity, equity & inclusion.\n\nIn this fundamental, yet powerful, experience, users listen to 20 statements and move forward or backward if the statement applies to them. For example, If you studied the culture of your ancestors in elementary school, take one step forward, and so on. This exercise provides people with a unique opportunity to understand and reflect on the intricacies of their own privilege in a safe and judgment-free environment, while not exploiting the stories of others. People are also given the opportunity to experience and contribute to a community collected, call-to-action idea board through saved audio recordings.\n\nEngaging with Steps of Privilege increases cultural competence and emotional intelligence, and empowers users to leverage their position within a social structure to work for social justice.", "short_description": "Steps of Privilege (Beta) is an interactive VR experience that provides a safe space to explore the nuances of privilege and foster the discussion around diversity, equity & inclusion."}]}, "developer_name": "REM5 Studios", "developer_privacy_policy_url": "https://www.rem5forgood.com/privacypolicy.html", "developer_terms_of_service_url": "https://www.rem5forgood.com/stepstermsandconditions.html", "publisher_name": "REM5 Studios", "support_website_url": null, "website_url": "https://www.rem5forgood.com/steps.html", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "NARRATIVE", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "413136807275875"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "4606887462773769", "version": "2022.03.11.001"}, "id": "827955181329950", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "
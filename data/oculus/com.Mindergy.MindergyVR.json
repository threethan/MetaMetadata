pNTO0VN7Ef1n45_acPMhKnSgKpJN6IT4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY_VHQY6h9FkiB2yNDAiw5SBmGqdVGtmCIdib9zEZxAA&oe=6AF5BF99"}, {"file_name": "SOL10.png", "id": "892518056985610", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827585_892518060318943_7401630415899068504_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v4kERRskNTMQ7kNvwE1ryM_&_nc_oc=AdrVuYA-5YDq_8aySPWT1ZRFC6chCJ8wE8MymH1AxwPqgjYzNYX311rFE65N9NCljFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRO5Wd-nmZ-SU9RUO8eCBIzZQHXeov870XXVPEvN-JPPA&oe=6AF5E69E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SOL09.png", "id": "1589144606238821", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823757_1589144609572154_2293399720138919078_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93xqVc-oMHgQ7kNvwHG2jhs&_nc_oc=AdqhPjTtdHqP2Yl7ugbrCm-3SuMg04Pw7YR97ARrU6aLJWmL7HsTnRV-cqubW38qxDI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgljxhnrnyUYymngEr7eR0dFS-iRPQ8wN-BYRt2bxFFA&oe=6AF5D251"}, "display_name": "Mindergy VR", "keywords": ["Relaxation", "Meditation", "Mindfulness", "Wellness", "Wellbeing"], "long_description": "Mindergy brings evidence-inspired mindfulness, breathing exercises, and relaxation into virtual reality, creating immersive experiences designed to help you reduce stress, improve focus, and restore mental balance.\nWhether you need a quick reset during a busy workday, a calming evening routine, or simply a moment to disconnect from everyday pressures, Mindergy offers guided experiences that make relaxation feel natural and engaging.\nInside the app you'll find:\n\n-Guided breathing exercises to promote calm and relaxation.\n-Mindfulness experiences in beautiful virtual environments.\n-Short and longer sessions to fit your schedule.\n-Content suitable for both beginners and experienced mindfulness practitioners.\n-Immersive audio and visuals designed to enhance presence and reduce distractions.\n\nDeveloped by the team behind Mindergy's VR wellness platform used by healthcare providers and organizations, the consumer edition brings the same philosophy directly into your home.\nTake a break from the noise, breathe deeply, and discover how virtual reality can become a powerful tool for everyday wellbeing.\n", "short_description": "Mindergy helps you reduce stress, calm your mind, and recharge through immersive VR experiences. Using guided breathing, mindfulness, and relaxing environments, Mindergy makes mental wellness engaging, accessible, and easy to fit into everyday life."}]}, "developer_name": "Mindergy AB", "developer_privacy_policy_url": "https://www.mindergyvr.com/privacy-policy-app/", "developer_terms_of_service_url": "https://www.mindergyvr.com/terms-of-service-app/", "publisher_name": "Mindergy AB", "support_website_url": null, "website_url": "https://www.mindergyvr.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1358628613990425"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824292_1374257781568309_2475584752183735747_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYrdMZWbj-AQ7kNvwGY-Zu2&_nc_oc=Adpz6tJYsGRe-X2XFXSJEFAXVLz8dP2qof3s-NB_hzp7WXMIffIKClEHT7FJAxldn3c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&o
4SeykfQ1uMw9WvDWPzmFR0I46g9IjsC4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1gdRjR4S93yNt8EAnoekBvrXzLB7v-WfiRcU10Q_dmA&oe=6AC4F819"}, {"file_name": "SOL10.png", "id": "892518056985610", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827585_892518060318943_7401630415899068504_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjvXId16LDYQ7kNvwHZoxok&_nc_oc=Ado7Ay88F2obrbV88VAVNtZVSa_XgonLXXbde4hhKnRx98J3TlszL93LUiWpvOpfJL0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxvdoiKyspxlzETbRAUFuvJi-c40_2nyCVSefTr6NBlg&oe=6AC51F1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SOL09.png", "id": "1589144606238821", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823757_1589144609572154_2293399720138919078_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GvwzozWp4bYQ7kNvwFt8QJU&_nc_oc=AdpMWI3s8FU-X3PryG82DBYtLfOfrNWaXC6tv3DsTj0by0d10bR4kB_M6nl4-AzlXcs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVuu_ZEkPayCr_pIRPnHQxPTKK2luJWVrqCvf9aL-ptw&oe=6AC50AD1"}, "display_name": "Mindergy VR", "keywords": ["Relaxation", "Meditation", "Mindfulness", "Wellness", "Wellbeing"], "long_description": "Mindergy brings evidence-inspired mindfulness, breathing exercises, and relaxation into virtual reality, creating immersive experiences designed to help you reduce stress, improve focus, and restore mental balance.\nWhether you need a quick reset during a busy workday, a calming evening routine, or simply a moment to disconnect from everyday pressures, Mindergy offers guided experiences that make relaxation feel natural and engaging.\nInside the app you'll find:\n\n-Guided breathing exercises to promote calm and relaxation.\n-Mindfulness experiences in beautiful virtual environments.\n-Short and longer sessions to fit your schedule.\n-Content suitable for both beginners and experienced mindfulness practitioners.\n-Immersive audio and visuals designed to enhance presence and reduce distractions.\n\nDeveloped by the team behind Mindergy's VR wellness platform used by healthcare providers and organizations, the consumer edition brings the same philosophy directly into your home.\nTake a break from the noise, breathe deeply, and discover how virtual reality can become a powerful tool for everyday wellbeing.\n", "short_description": "Mindergy helps you reduce stress, calm your mind, and recharge through immersive VR experiences. Using guided breathing, mindfulness, and relaxing environments, Mindergy makes mental wellness engaging, accessible, and easy to fit into everyday life."}]}, "developer_name": "Mindergy AB", "developer_privacy_policy_url": "https://www.mindergyvr.com/privacy-policy-app/", "developer_terms_of_service_url": "https://www.mindergyvr.com/terms-of-service-app/", "publisher_name": "Mindergy AB", "support_website_url": null, "website_url": "https://www.mindergyvr.com/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1358628613990425"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491824292_1374257781568309_2475584752183735747_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7BmP5lzTVwQ7kNvwEVZBL0&_nc_oc=AdpeXRHH7FkPlkef37Q3C-ZVTn6eup4afn-7CXC5OU3jKRxB0eL8rZafDiitHKSnEqY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&o
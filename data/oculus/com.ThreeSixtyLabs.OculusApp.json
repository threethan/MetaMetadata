scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNq2M8aHfKQQ7kNvwF-6H1x&_nc_oc=AdoimiK4VyOWlJ9-ju3YpwxkYFlGrnv9WqmTHznH3pM_rT-W_hHx2e98Q6vpud6LC6A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18YsYE3Pow9kaJ8Bk-jTuLFR0a--hNZhO4HKiuUJbsXw&oe=69E63DA9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbPPag5aH0sQ7kNvwEUI7HR&_nc_oc=Adq2V7eCtESa-uTK9WM7C669RQhWZciB5TXvebxHXdcr9vI02Dy2rbHyzhDVqL44Q34&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PA6ViClJpABp_42HJXbp_wd1K37mi6OZJXN0e5rSdRQ&oe=69E62EAB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IGAE05oEBsQ7kNvwEynXLr&_nc_oc=AdrF_UuD7_MYhGpgiQHC3V6JbJoWQRLO6rAIGfCwGdGzRPM7klURyFiHnteSqIb198w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mbOrBEGDgkXUYQ5a_cgY7lemu7HVSMfoRHgSVEf2KhQ&oe=69E641AD"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JGhZqEuSd8AQ7kNvwHAo19m&_nc_oc=AdoMKWrdEnNxM7OKElLdT5sLizvtx9fs6OPIhQEQFnwJ_2oB8XcUEAGBeoPOnYqBGD0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VeT1GvDWeySTJbslpPbcQC2PcR19PU64e1uRLd7H6LA&oe=69E62555"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zvd7gorWm-AQ7kNvwFlkQ_E&_nc_oc=Adp_SfmxaOlcZKqzPQjx6FHbD2kKxcSqp6oLeocl19UAp-urf49fY4ow622Fe8a8Fog&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss
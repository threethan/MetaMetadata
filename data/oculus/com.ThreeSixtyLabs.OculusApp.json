scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qGOJA7XuCNgQ7kNvwHsaF5k&_nc_oc=Adox-_9fuy_gorQMpw0f8V2s-0DCDT5HmmGy-FXzKl5hpWpM82XIOQgXwum5KPm5ZBM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKLh-6oGyWZbxZ4eb9VIlL79pDq4F6pFcRn2cef6Z19g&oe=6AA2C429"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZZOiVyKCHkQ7kNvwE0rk7w&_nc_oc=Adog8cOrmTyHcNml1Hg0co5-of9T-EV6J6W1qFiQFRCEB0b7pOCj_R6xUKMAt2O0LMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmUNSqLA97kGL0W7EgyAAGVSqtq97uPcd6-mEGnsW3Pw&oe=6AA2B52B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2-JX9aNTS0Q7kNvwG9q59e&_nc_oc=Adowd4zcmYB4MLvedEb9jUkEOkUBx657D_FLRBRwJrcJsG2aKx-uDG_5BdA97V1bRaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz0VVDRPvBNvM75PngRWtwhL925tE--UzX7wQYnH-hjQ&oe=6AA2C82D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXHRSAucd1IQ7kNvwHFWfnI&_nc_oc=AdoQ4skRGRAEEq2O08pTDcIl4jMRN3DtvR3uTwpDtTcqdrTqUmuTCSctnA7kWewAa0A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8JePWSIBmMTgWVsC8X2vxNp1SszCUEw_Rc3ZjmKlROQ&oe=6AA2ABD5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFgTTCbGCBYQ7kNvwFPVAn8&_nc_oc=Adp5RoYRzumj1cu2qzRFL9Q_nEnqnIJrMJWa_zK2Tqv92TNbwleDV6o49MNMj9Lcrqc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss
scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erv3Pu60h-UQ7kNvwEuMC75&_nc_oc=AdoZQuaBf-W-_fd6P3aDPfO7Ux8BTt7G1a6hxNikQC5wEhu29Yg_ki_SjE14W-GXpQ0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AXu8UTSO0Kh_7LPTRiOJaHDbY8DlZGcJDrVI9taOrkQ&oe=6A4529A9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgNxmd3oSZEQ7kNvwHMi6WU&_nc_oc=AdpWIwaLi2CEekjfz8BRBbKTAmOj6LqQb_Am8XPJhtZLDi2HsuZum_MS7ib3uMxQGwE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8N1KQOMAEc59xmTxfNKUfgq6E8BKl3gwxzpE_jX-_KBg&oe=6A451AAB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iOx8J_zIB00Q7kNvwGAde_E&_nc_oc=Adp1Kga0NaPQ7H4C-j0AakX3_7ZD8LaAa8AJsaTK9zpVAiBQgnCvf8P3uHsX332Xk9I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9dIBQgaIHl649npxzsByZ_Ub74cZSll8c0pYZOj1fQNg&oe=6A452DAD"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3gC4UtRbfkQ7kNvwFMPruR&_nc_oc=AdrFIVWK6xxyjmnUMm-oKyMqV1zZnUXn1VD10XxLltD98yfOOppTbDP8ogR2kD-HADA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KqDQt4Lb5KSx8sZkRvsawKIWH9Q7emI9gEGI-7sOiPA&oe=6A451155"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdxWMt2BJsYQ7kNvwFDqON9&_nc_oc=Adp3Dv2bsw7owvtVvG_zsS8D-Y48MDh_WIEJo3QLBwyQiCwc5mykXV9JGdqGTasEdVU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss
scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LypXFfiKlXQQ7kNvwE_JaR1&_nc_oc=AdpCBTPEda0kqBuERLdM4y2lw7RU_gINzG8D_WBOj41Wq5daiVfWIJV6Ij3-m0elDTw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELVB9QcwE9FyZUwpXOjr5or_gTheko7FUXA5wPU_nQMw&oe=6A940B69"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osokwN-y-wQQ7kNvwF1K7yf&_nc_oc=AdrYr6cyHoDBy76pH8i0NKW6hjZid6UHXiajflsytRCSRkEVT_e-z9xSMYyaBxsUrFs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNrp9ao2qyL2pBlTykRg8k5cqp_hKpoAzFs8vck3a2Gg&oe=6A9434AB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFcWJyR9teEQ7kNvwFT1t0o&_nc_oc=AdqyZe-q75hZ6gi6A_SDUvuayWPsjNS_3dquiSG-rf9349b9WIpjTV104c7lAU1ZaSA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKs5MB7U-D5wu9k2MBXMMspdOl2QrCdEc0FZMR7PnZ7Q&oe=6A940F6D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2iFAEHdHkUQ7kNvwFa5YEy&_nc_oc=Ado_47Pi5FVBQtRFKEEQuvl_tAhXj0QO9ejt9HFSAFqBvKd8uKa55WDiazTPBT1vX2U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsB7QU5HqTP3BP5CxzEKgJLuLA-TQTpDGB1Zxw82Avwg&oe=6A942B55"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeTibtqh3wcQ7kNvwFj7IhY&_nc_oc=AdoIoFGo8NZg0bmy1050w6u2krins1grykKeSU_YB3c-mnK7pn3DT2cEmWzZVylovbQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss
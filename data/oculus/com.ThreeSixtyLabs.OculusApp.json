scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WVnvMJ8gN44Q7kNvwHz1bQE&_nc_oc=Adr2xDgfIYeyX0Z75VRSGN5Z8Ik58HD8_qBVFCE9oFEo5SI0eO9d3Nx5_re4Vc2xCWk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt6ShsLev3Ikbwk5-5731iPi6kcUlW1VzkoX2r1ApTxw&oe=6AC26829"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXJRAqrWhtkQ7kNvwGZe5lF&_nc_oc=Ado9WTzCXt90H7P4dA9JohZCf1JNxszMhzCUbsejUdwMQpwgQ0AHG8W32lmqZbx7QSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPXzhu86-_ybXk1_jZAC3w2zVjwUNUvDpcx8QN2CJA0fw&oe=6AC2592B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBn5R4E43tYQ7kNvwEx3nzw&_nc_oc=AdrtXphczlTjlBZJrJBRMFQj8aqAfxsTsEg8Twg1GpeYaD16fQlYGFRQgv0jsGEhSpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrRbNlXX74FYpy4vy-7TuJlzX6tZ0XziafVQ6QuJQLsQ&oe=6AC26C2D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JuZqog3hYqAQ7kNvwEO6KnC&_nc_oc=Adq7el-xrCuLr-WxLR2o4XHvJedAYZDTWAWwO8C8iAftp_rq-EnK7Vn9GQfjecG3sVE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMAcE3F0ftFXTWs0D2Ec4gu1QD-eJVv1jVLjd_QKGKog&oe=6AC24FD5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJ7RG3azQl4Q7kNvwHdR5t8&_nc_oc=AdoowXveXDB6P5nQCPh1fibTThSfHtP3NwwZAFUrg5gU4SsjvXenXm9jYztcOA2NY4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss
scdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFmsZOD8KCgQ7kNvwGjKf7G&_nc_oc=AdqYTiYKaUZBGkwjpikqpbS-1frAjcC7kxQH-AoPZH-Wa0XrQ4MqlAQCJvkkfhBPakE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z_M5LSkHjzpRCxObc6-lK03cfKlB_hRqW4ugXRYbdSQ&oe=6A3E832B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/2gj9Xm", "id": "2350656421929558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974671_2350656425262891_8706371997208150016_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_Yf6J67kp0Q7kNvwEWSr7X&_nc_oc=Ado5FupixQ6RRSvErurHP88PXIU6ccwtK3ear7xMqmpEHA8PTCLi4l6FZkAf3oOtkiE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97lPHuXYRU56DdMd76m6x1Yx9nhhQd-Av-_wG7YZ-S2w&oe=6A3E7F0B"}, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "3
scdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LU8ZrgXHTTgQ7kNvwGeI5UH&_nc_oc=AdpCs7WST6G_YEsPxnVdGk2dp6SQaJH5imH-Kt1yWKHzkaRXJn7ODi4gcIMWPdr4nT8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_YEsYkuMmeKS16tZ1k9Yq-WbIJA7cnFoVRFK50Yposw&oe=6A0C6A2B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/2gj9Xm", "id": "2350656421929558", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974671_2350656425262891_8706371997208150016_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQS6NXXhf_4Q7kNvwHA3ko0&_nc_oc=Adp5JXIMG2zDX_zH44iWxA2znnJx-mHXcT_iXshGPMKvrDs6241DB1TcXTaEAV7gbOM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uVZUPt8qg2JnClNG5aYx-pVzaDnMa1JsbluRYJ_59Ag&oe=6A0C660B"}, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "3
scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHhML7pEAm0Q7kNvwGDjxsD&_nc_oc=AdrwZJgTcS50ZDv54WcnzHSCwN6x0BsGu-Kj_oRPzRLtj2PYiymA2asxx4pbDtxva5s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBK3C4KbMf4xG_wLRCkDYGk4LZnZY_Bo3oRIKFQkNX1WQ&oe=6A54FBA9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5mmhGfspHcQ7kNvwEQw0hM&_nc_oc=AdqRKsUuyxXRCUGObJd1bGKIgour22DIViakit54KnLJ6ajNjiwmfmBLTWUtPYv47WE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUybCvq-8HrLKAkGbsNOo_m77Y_E32IIZSO4hQT_fObg&oe=6A54ECAB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfHNG7fBdgEQ7kNvwFa6Kx3&_nc_oc=AdrokTYeApq18oNfQVq3Ps24X_GkMnldJa-7gHnaauf9p3O1VUti2scU5QL9VZCdZ0o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA94QkBw5vmLQkE37YQ78HhDec-wiofUa_tAbZu09Ru1Q&oe=6A54FFAD"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Tpzc9rXrlQQ7kNvwGr8G5i&_nc_oc=AdrvYXohCA_RC8bGRfle3pIvAZpvr7f1oIsZW5KmamyDKH0WKk5Kj4zJWnjOzIRYdcc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDtS-Cam-g-gc0n12WX-baGfry26eHRNeaoF0UKh4TTQ&oe=6A54E355"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LU4wz6t3ooQ7kNvwELfm1Z&_nc_oc=AdpempPKBFchYvaBszCzLvZsWQCXbMjqpZ0tilg92ykxXnmMMe-Ayjv15aDxiwwnEnw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss
scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfAMAQksClsQ7kNvwHnqrm9&_nc_oc=Adonr0m9neRqnf4BSfG-MvifUaZpG22v9utdFY5dV2dWgN3GAPjB3w968LrXL2lW-yM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzAyh6HlSxTfsSi19BBfNFY4ESOQn0Kf3VF0Rw3D-IRg&oe=6AF32FA9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cobVV2bG4O8Q7kNvwGNSdcj&_nc_oc=Adrt-_s5cHwnu2gnlvPlmVZ51tykx271Tbj6VMl9gDic5FrN8YOi4jCNXKOA_csLWSA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1zqmj8Zjohvk2SGr27oZ9Hw8MxNXo1vadqjkKbzwoKA&oe=6AF358EB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8E6AJ4vXOMQ7kNvwF659Sa&_nc_oc=AdofGdTZTeurO5KiqEr3RJC6GX7Pcvq7TgRUPkpnrUzn8T8Svj-9k4bQrzaqcAHF1Uc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI5l9h4ys0I1WaC7GMGBd4GUMVUCRM7MTAm_tzdjs0Bg&oe=6AF333AD"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8k39ckuNCpkQ7kNvwFW5t3k&_nc_oc=Adp3B-8r_3Nyp_kO10knrX2nN0ABo9ws4qI4BWNCkTz9r6HKRTPe-qoT_g-B3rJGPEo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTv-75laxck_tUQDMFUolHpG8Q9Hmys5SoTv8UAVc0c7Q&oe=6AF34F95"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKHKCeyV19MQ7kNvwELCc_u&_nc_oc=Adq1-m-2dZNUj_OgaP8bUBimjrWBYsCMxwlutHmlq0soefqteBWyokCafsKDQQfu19E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss
scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fHhML7pEAm0Q7kNvwFyTFTB&_nc_oc=AdorcRoZOfkDApq9dSkqeiRqywAupIUP8xJr3tkSquHSXPEKGMbv2bDDkZY4FCnU-WU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALEuDMChxvJGV5GLQocq14kHuHkzUF-MWoTKMo-ur9YA&oe=6A564D29"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lxJ-uLPPXgQ7kNvwH8GYJq&_nc_oc=Adp2cjQQVcB34dX83kF99-M-KxD5XcOZtIYQWzA4E9H5T_oonvKgV-AkOMElwXbgKhk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDnxH3Tx_RaG4oetN9acz3hDMb-PeMXEiK8YoaWGIzrFQ&oe=6A563E2B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfHNG7fBdgEQ7kNvwGZl6pa&_nc_oc=AdqfRnQyt3G5s_FJTsMOTshCWFUR31Fbh3wsp-7EcIyw8iR3AiBn_ktEPumyxkRVXT0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHXwg7Dvy4eE0OlFYQ_z8oYzUTLYUwR63N4VjZiqzvAg&oe=6A56512D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i4D0ecEe6HwQ7kNvwFD94ar&_nc_oc=AdrrjkoP4q9PLAPcuu93o8FoBL9WtLabHAd0t2Fja7khCbWd2AA4a-48Li40-ZaY-Dk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTzCDrXE93SRIzqe2W34a_ghugFe4DDhTkZYlot42HQw&oe=6A5634D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulmt7txoOh0Q7kNvwHiPkAs&_nc_oc=AdqYgrINxy8_LzqIoYrpapfu1_04nXfB85YjBvcMPQTRwHtF8w40gVFvnFIbT1rAygo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss
scdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmu_6fL4c8MQ7kNvwG8BG4W&_nc_oc=AdqfYwsEAU4IBqCuevpxctfdy6dorRwSV1eQOeBY6vVxOrUFNdEGEaXqjQbYbqtPwLs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEit9ShbbhJc5YU6lSEgIxd2S4cxBK9GiNQooHqH9I0uQ&oe=6A89706B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/2gj9Xm", "id": "2350656421929558", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974671_2350656425262891_8706371997208150016_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VM2YXQaonOIQ7kNvwEuq-wd&_nc_oc=AdpO0Kn0d31nA5uL-GmRlykZpt1_2z4x9cvmvLt4zuiZ8cx1_L-S9QyonmskIcf-B-Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcCfM3-91VJ0nrKV9oY69jGaZdAyHq7xLNoiMDg37EQQ&oe=6A89A48B"}, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "3
2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y749hvbL1JIQ7kNvwHsHOMd&_nc_oc=AdmOSKMHCEItRKYodMtReFk57hMifw9XN4Eamyyt4quqQRkNgU8nPG5XxQr12QPvH7o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzMZCqHZa7p_cLQ0BNJ9IzPnn21WXwpp7eLuywISWgVrg&oe=69BD5F29"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-fvYh8aq1YQ7kNvwGV4Oqn&_nc_oc=AdkbMx8HOotbx0zhDJzXEsxsn19urfbFjzB3FfcvLlxUKoQMM0oNr6HNxNHoGD-1p9Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxa2ItY_6AIgOZE9JRMF0hGysRsOlkGaygECxJ8y1Rqzg&oe=69BD502B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XQxRLVet7hAQ7kNvwEQ5pOx&_nc_oc=AdnJLeDZQ2EA15HJYx8Om6Duif6C1_HlX1jfz5RSz71bmWET69sBIuQRWCeuf5srs78&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwWHcKGinC-aH3taaa5cxmyHmPXn8VLTSMrFkiaQiJPtw&oe=69BD2AED"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e7qEPeVzH0Q7kNvwF4X_ZD&_nc_oc=AdmmqM-8igkBfV9S114Le16ZL_n0bwdda7_D-4GTTTCYNLBOp8deboug2AooeqJPccw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz3HFlBDNrUNeGMYVlzkpMHn5fp8VcjUQa7wp9Di9VBzg&oe=69BD46D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49FtDxBQSEAQ7kNvwGS4Z6Y&_nc_oc=AdmI52RXRATGtvlb3zXtclZVSrQjZmbp6HSnzxsm8FLl3hVTRR7R5xXiJvzqSu0LZcY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzOQ3oMo7MjO-wSl4KBINi1tJ5E_JcSNFmmzN
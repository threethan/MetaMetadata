scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YUchmbMUQOsQ7kNvwHs2G6e&_nc_oc=Adq46myarSLxL6_Coo_AzmH2nGoMXnjVh4aFRaEOwkdJfbvGzwWpCw_-czQHXNN_MOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hoTfEI5CUorZSBMmsy-5wOB4luU3LwXesPrc47y0B9w&oe=6A3A9DA9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0pezbiJZgCQQ7kNvwHqOZw0&_nc_oc=Adr5xgy2AjtlT18aqxGZh53bO4ee_Bcj46Zxj9-H9XtL6kiJsj6MuZbKEjlpL_3Epik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ErHSuvgYUu98FPTownE_GdgC5ME7jieEq4GsC0b4tlw&oe=6A3A8EAB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fjr_FiuCnLUQ7kNvwEmzfWP&_nc_oc=Adppbd2ulggQwhSauqSevEtIMSIG6V4OJy4cKC25iAHDfsLeLW7YYJ-H8ZyAbDz6Ekw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9e9Fx_JuxKwot_xZ88Jx2WVgpqArYvmWUd8e_SeUdZvg&oe=6A3AA1AD"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L7bCZMjhclQQ7kNvwGoAHm9&_nc_oc=Ado9xgCMs1sLlMcvD9w0j8qjXWvZZzCmkFWRPbwMbR3YZBQ2Xi9hmHYD9GMPtseDiSs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZrTRDrkpRY3Udpu1DRl7Y3JZ-1wYn8PPFnkVp6Kvf0g&oe=6A3A8555"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Caysla7jEyMQ7kNvwELH5cS&_nc_oc=AdoAHNNaCtqUpb79-hl6QebXC9AHEEekpq7zst0_NJBYn_lLMVfjA0jx-vXN1uEuJJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss
scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Qchk1iQ1bIQ7kNvwF7svOD&_nc_oc=AdrjiWURQAlJYjQmHWKMPpBxTjy7wfxhNmWUtxZDmCh8nKJm5tcS6NSZxtthDKGeA9I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfZ7Z8_KPEcFmZyiuAmJ3sOxN82GS_71sOM1oPf7PQQg&oe=6A4E6429"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6OY6FW5XAWgQ7kNvwFBi8nK&_nc_oc=AdqF1URN6Su_ZBGkiOLaxV8tlbiQ1zVDP1kqRmCzKP23H8Bzfc-U-2CJwD3QyRqtNHs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7-ut30rsJ5fzxWjOIxDTp2osUI9w57OKOSXZ9FErVCg&oe=6A4E552B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jl3ozZiEbooQ7kNvwGsOWqV&_nc_oc=Adrz_I_4fZ6MOW5pNWTROa7lq6TDiX822OtXI5p0V_2eLln_Wuev609KCZVAdedPHRI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqSqDd00qIOKigM8n8uFKBbDYSM3745-57qN3knWyWEA&oe=6A4E682D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nfFuPLqJ-kQ7kNvwGGa4BT&_nc_oc=Adpq7lzZvSCIuAJlFvxC0nkIHyLfm70f3PjvCziuwTg4fBlVo6wkxMFROFV_0s0IceQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLNPX_mJdjPFdyXjmpRw13plZomjIJhxkszCWFPDCOwg&oe=6A4E4BD5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0t3sfBa1cKQQ7kNvwHhV5sy&_nc_oc=AdrP5vyFINJNDtEfeEUbUdetT7JpXWpRfrecelH3KxMhmFo-R_V5qVMKWvbHknrNisQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss
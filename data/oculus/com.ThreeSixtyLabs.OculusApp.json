scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IGlp4vaepkQ7kNvwE6nQo1&_nc_oc=Adq6jR1xgyGC_vYpIWs7AAqKYpCMYmUGqO1pMIBbCV1ve1ghd0XMLVKvdxV00asnzPE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLMdd_RVfAvA5LdOw3DjbRpjasP1mflVXZx3MhdLcuqg&oe=6A622AA9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEgNwRuxh2cQ7kNvwH1Fhnl&_nc_oc=AdqAIigBXphrItEM14myAzEvxIcMH8ckb5FUT5CBg1LOTphJs0SEG1DOX3-PvBrjmN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeSKVSVj6R3f6XsWEXikz0wQaPGW1YFZpdLntFYHU5Dw&oe=6A621BAB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FtinJUcflroQ7kNvwFF7qMh&_nc_oc=AdrHuUEa49wzXtEWv18dWRFLo8jk_jkjSCdcW408rO5btaLJat3Czq4La2dbPF6U3tk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0hp4Ujl0NEWrAoWKRXEfIH5or7q1Rd5lJGKvN5JPl2g&oe=6A622EAD"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JR2jTIF5ChsQ7kNvwH296T2&_nc_oc=Adr9mzJHGCUMavQpohLVbamBNXISzPZK2EMt8A1m9-aBFWdNfMIEC1UTiiIR-5SlTik&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyIgIGUePwoKH76VSqg5fRM84QSexkgWvYDbAM1b4l5A&oe=6A621255"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1XGA88CA1lgQ7kNvwGascYI&_nc_oc=AdrLJ7YjtYfSnNT2734wnldlv5uhP7RRbuW90PFZJkHh8Mt5H1U68j_-kWdJkKDq4W4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss
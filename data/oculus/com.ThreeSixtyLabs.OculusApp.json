Jx-s_jiIgL8EMvUCX-J8K20eDnAN7Xfi6MpIV2crzZQ&oe=6AFF0A7A"}, {"file_name": "migrated_image.png", "id": "254808908866934", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GMY6J2xrh9sQ7kNvwFfZiwP&_nc_oc=Adp83ftTaVVkxQzahHJj7SVQmZ1Mm5loIDniWmleoBGFVEwI8FtRHF0mAgqCwxnk4TU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6-zHWe5jl3NlhoNJOU3wwD8QDmH9Rf9o3IBKDLGwRbw&oe=6AFF2D15"}, {"file_name": "migrated_image.png", "id": "204172720839906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2udaGoNa1wMQ7kNvwEE15or&_nc_oc=AdrQG761nRbFxkQw7E05ObaZxaMWRLEZtVNBzQ6FM2DtC1XnEtWS9yQJjkvK4DrVPrY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSswsvmMTHH1P1wzLJ4Eqea0dG7S4R5dMg_HwKeP1mKOA&oe=6AFF366B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/2gj9Xm", "id": "2350656421929558", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974671_2350656425262891_8706371997208150016_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XGYnhWjxx_UQ7kNvwHKU_-g&_nc_oc=Adp-AYBm2E31sprsILT26xVQvvdPrL-Bm0vuzXnw5cF9ryHbRmldleo9KwgcmIFttYE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCHd3_yqjTChS1YWOczOQbf71yuBpMzO--gIK6uJPjew&oe=6AFF324B"}, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "TRAVEL", "DOCUMENTARY_HISTORY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3222046758084589"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "778445145973665"}]}, "baseline_offer": {"id": "778445145973665"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1579197650, "status": "PUBLISHED", "id": "778445145973665"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2838596269550671", "version": "21"}, "id": "521847575253228", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isApp
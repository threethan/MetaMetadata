2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y749hvbL1JIQ7kNvwHEndd_&_nc_oc=AdlefcRsuoNkNjkgxs7oNF9aWBAnpq0k-XbqCNVrqRgBml19rgyjV9bm_L51Ft30vno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBhYkvuY8MexjLe4_RqNfe5yhfB19E4oxAWhnKBdt7bQ&oe=69BE7869"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-fvYh8aq1YQ7kNvwH6Qz11&_nc_oc=AdkjK3e5-HKX6NryTlASB0sDajtmzOe1UleYNGDBlk7vVCzT0G-3cyKxAQ4eHs5F9_4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTO1PgpcZ7GeOPxuIcCsS67nF56PRuTLdK6yTOZN3OYg&oe=69BEA1AB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FxIjjJOZSwQ7kNvwGdZ7bT&_nc_oc=AdlBZp8pPRaBEafyl6DVjCNwjMzllmL8Icdc6ExYKoQTyhov8lQZHhTJu2EdM8LN3ug&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzP7kqX4Vgg7TQVC-cGNwDt7EyW51omlp6XljW8YuFmBg&oe=69BE7C6D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0e7qEPeVzH0Q7kNvwErOsAo&_nc_oc=AdnpMV_-SnWGRLkAuiqSbR87SCznkHbbWFHumeyIvPZ9ni1jl3pWGsBkRGXlbcNm95c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfylH2nEiCtsXTj6bv2n8yr80-bbrMmZODh0gK0MaogCUA&oe=69BE9855"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49FtDxBQSEAQ7kNvwEuu9Vc&_nc_oc=AdnDk83OM3QITVFDsjdbrT3BMR1igp6K_HnVWxXkHZMfqfZP8QIbCdDcxbSSE46QxJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZZAvlGq07M-ek4J7QbvyN_TC29tEzkXDQXDo
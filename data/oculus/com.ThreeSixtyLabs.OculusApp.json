scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erv3Pu60h-UQ7kNvwEnjY6G&_nc_oc=AdriFTCl9vesBvW4XMUJxRqMMVRL5Iru10f08tKJzjebbMPNZ4LeSxrdePPkM8pe0fA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80UjwaL2_s1n0Vywz_vgx6tkDRJLp_8Xko7-ZloUIc9A&oe=6A43D829"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YgNxmd3oSZEQ7kNvwHbWVyG&_nc_oc=Adoc2JNKvIX6Zs0X9LFRyFafKCcHqi7cQl3SI1XHe47F9m7ROpsplgmhKeShzkKu148&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Qv1O93W2MKN1y0i2yeQEHyZ7wpl6SWb8WdVkfnfz7TA&oe=6A43C92B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IQ-BX2FlMD4Q7kNvwGQ7gbC&_nc_oc=AdoYDxU-rgEkOksfZV30ZGa-QWqMb3892xc1WyTKjVWppveeznmWx1bAimZ1iR5V6tg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j3b5IcbkgioLYl-QnV3HqeNGLzVRNrPPYYgSW6iiLOw&oe=6A43DC2D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p3gC4UtRbfkQ7kNvwErrtoQ&_nc_oc=AdpeRsffwJCiYLsmXrEH8p7KvlaVk6SNpbR36OGCnii13M2Sh41N4aAABek3PGfXcps&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Gx1pxFsnwCON1JS7cx4g0Lz3o5shyZBM_8RQidbeBzQ&oe=6A43BFD5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdxWMt2BJsYQ7kNvwH4LvBQ&_nc_oc=AdrVXY7lKy_PZgNjlsaWglrOJ_bs8wddu0Bz5N8BZxoBdQKQOHdcC2EgCLksMTaI698&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss
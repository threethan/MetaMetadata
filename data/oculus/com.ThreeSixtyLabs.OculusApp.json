scdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zyPEGAIY4CoQ7kNvwGR9bf3&_nc_oc=AdrvmiY-fONxelojt__Zjn_UuESL47dXw8I2Im0SWANpsxchiDXDxzJ8R1jECZtThOE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQId-x0kcm2t-rMKAi6DakNOTonkqwL2NBQQks_APAKMAg&oe=6AAD412B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/2gj9Xm", "id": "2350656421929558", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974671_2350656425262891_8706371997208150016_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND3-HVT8EbsQ7kNvwE6MHDR&_nc_oc=AdouPNavX7nxE66-F-kKvt7ndqiwH18-DFoNyAHPfkHLZOVMMZ7aQ2S7lD9L7I9VQF8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgjsQFYbIe9XD-pUn43riocpD4_Sr6XSgfg6MBFYKFNQ&oe=6AAD3D0B"}, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "3
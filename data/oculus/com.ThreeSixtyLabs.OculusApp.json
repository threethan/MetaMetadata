scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BfAMAQksClsQ7kNvwEJ8zOa&_nc_oc=Adq_65MSVcn4PzjhJgLGJEnL97Nk9ucPRBcWuSGpZcxkqeo2vLV6Zkh5VUrKVCo5a28&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZWO83C-y4o0rE2HtKLB6aquRmYarS70BTyAR81AC4Gw&oe=6AF1DE29"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cobVV2bG4O8Q7kNvwE5Zk3G&_nc_oc=Adp7SFCVDPVqKcWdqLo6F5U5QzqypDrkgEQ6Oo0-4jH3LMGzE0fCmmPTB1HZE-9pWww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3er1e-GfpVpj9SGFUZ-Z_1ZcXYGy9zjSl-x55oyHfTw&oe=6AF2076B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zl4PZZdJYEUQ7kNvwFLWhX3&_nc_oc=Adq4cQUK9cBWLc3mArTVIQYNYpSg51SYDvHLv6FnQtmrNl42IDgwRUI4bKaqXHb2SY8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQaLStlVWQbEYfu4JqEexAR_U5lsxni2jFcpZmXTNYYiw&oe=6AF1E22D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8k39ckuNCpkQ7kNvwGNFhJS&_nc_oc=AdqEenDi-XilrD6VZDNGnxXkUGRNuC2TMaaOU5qtpmj0Yzld8Nw9XSUH67DAE7rjANo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTU00Y8j2ScIO1V1BcSCQInxSDn8FjIZSpsYKpXSGMnHQ&oe=6AF1FE15"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gKHKCeyV19MQ7kNvwGAdqm7&_nc_oc=AdpqcYJtCo0jzmMze4yrjGdhPzxThwdlUR5GQBXAf2gKG0GAcRIxri64gLpXj27zOAY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss
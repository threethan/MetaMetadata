scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxdavgS0jnMQ7kNvwHSx5lI&_nc_oc=Adp4q9HYMXBzW5NiYgVXUPBO1tPdJvGqg1kEJd80PjSgwViimYhuqS8COKmwgJRHRf0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HPQaarpyJqFa9GnLcyrO7kOY4St_V6aiu13fkkrwJzg&oe=69FF4A29"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cC7_2ZLyE4Q7kNvwETCwLv&_nc_oc=AdobyJss3wECYfMy317aXZCyM9bXj-8KK2qaQGUKMCXslAJ8IMXyYBLkIrhgHDhdpQ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Kr4M9VblaH60raiukFJfofbHwzo5lQ_KPAhjlqJtYbQ&oe=69FF3B2B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-f03X2DAM8Q7kNvwF2xbTx&_nc_oc=AdoobhXmMKRyx4o_AhY-kVk6RTOJWe8myWWpvN6jMgXQK4TMlYMDAtByrLumR-dMNqw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Doeufzbm5eOiz4fKrVsYYmgq7LtCRx4NtscsuPrsiVg&oe=69FF4E2D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZ6BkN41_u8Q7kNvwFZ93At&_nc_oc=AdrE0qHqNfVoXzRRxoZXvsnFfTHLqxvK78jO_a6FyvUhfrkVbmdobiA_7l5tuek3y-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Zp4_6PSxfz6q69Du8CGLKwJQHiH7-RDb91zNtXrKp7w&oe=69FF31D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-31ZWFoZzwgQ7kNvwG6tNxh&_nc_oc=AdrUkwyUBdgMkS-b-MmLKUyLNR8rKjzfNSXPjs5azaJR1DDdeUIo8dQ8v1n4voOZl4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss
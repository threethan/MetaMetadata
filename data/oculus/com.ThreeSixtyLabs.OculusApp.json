scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptfHc9bXWpUQ7kNvwH53Nrv&_nc_oc=Adog16LdcHJh3G4qhKE6nLu9oQVGOF6rRCxkuwOgFgjhfC0-q7r7Ep-jm6H0nfYLKlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L4JriWTFRJXW3aX-clpgcVTKy0AU78FcTrdfkvmqPuw&oe=69ECD529"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ie_sAsZi64oQ7kNvwEnK1yT&_nc_oc=AdqFdwtQ9jbAJzxoOY9RhuAt58Z701ykTVVE_rpZfkC-pm7xk8MX8xKqWDSSRdM5uiQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Z5KmUvxpZulZlsCdOmZcTOjJUBuTaXF5vAYT9OI2o2w&oe=69ECC62B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXF1yd3n0n8Q7kNvwExko5v&_nc_oc=Adp2hTP5IPfttxRpedZlTBgPd0if-64TkVi-Z1XyAbwUqFcVHrd5Rqdk3PNUmeMTzAE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lm3135k2SlAOKKkb9aj6iQ7HuLXlukdhhpRcd6EEmBw&oe=69ECA0ED"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPIFHhGmhF8Q7kNvwEor4_P&_nc_oc=Adq3cOLhVMQd3c_tOlsGbAWc4NnI9ohBo9NhWtBz5YVb3G9_ed972zNZLurWjCIvH14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qWls4h-wykN0KF15s1Z3R0Tw_f0l7FGTohPrxVyolGQ&oe=69ECBCD5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7aA36TQpwfoQ7kNvwEU3aHP&_nc_oc=Ado2yJJH36wGr0AK06Y_WOOZ6EChl5dzdYXiOc793xrwl7ZdtNtInNSnBheMB7Z3qec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss
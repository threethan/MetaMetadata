2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_KnvRthHDUQ7kNvwFHAWjp&_nc_oc=AdndtUnnN_t3aJ5ehtfisPMyBWycJd_MDt-vQSvLRmMPzLSTUOeV4IKPbfjZSPqdjRY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8bHTxUmnDinhU1kJANXpGhEDOVkwqN4kslJi5p-jDPw&oe=69AEA669"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KfPrJHt_foQ7kNvwG5kx1_&_nc_oc=AdkiUbacUGOhow053VSg2MC6vYCQVgOEvjE6PurL7M1r9nUS284wVkezrpQsOFlnp6k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQqZVqiOKsfSQK88WXFNIgzIoBSVjYB4a6Wf36k8Gkiw&oe=69AECFAB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwr8AERZAAoQ7kNvwFSvzGz&_nc_oc=Adklmr65xnmEIoMI9KbLBz5l1hxNP4esoF8yjKoYW1iTJDuFSZLVX8eamAM5zc3VQjo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzW0ZXeI4_U5zC53N1T2FetGdy9F5yj201wHBk7snf1_w&oe=69AEAA6D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iyo_4KZ_0qQQ7kNvwHVwMNv&_nc_oc=AdkE6tu167S2BaGi-MhZ0idaiNVtJ6_ziGezo8mZAmAMXHXv8FF7KADQeaHR3d3PM_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzzHuytx3xA5jRgmuaCwxZIndcfdqWn41HxrkuO06DABg&oe=69AEC655"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h15t1wR0eS0Q7kNvwHAVGuH&_nc_oc=AdlwfnLejaHDQ2r-OUF3_ZpZcIrc1ayynUm1wDkY3igsCi-OBIFv4reIBTi7n9mW0Bw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJ-T7iiyIT_rKJrQ63xhrE_xLi-PGY8XgmdBi
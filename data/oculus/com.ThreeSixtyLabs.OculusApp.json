scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bt8OQ8o94hEQ7kNvwFKdd-o&_nc_oc=Adpqj0V0N9ockGgi4NlhRsgfdwytAOSZe4gDL-8-o9vVWX7nucpLedAZeVOmat45CQc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qI0ZsQMDrUl8ALEhyVB8iBLMrSvdiIXf_IlAD_cF23w&oe=69FB55A9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guiaTP6boRAQ7kNvwE0k_og&_nc_oc=AdrgryxVEkLGoXwcVGdnAqcvfVt-xisXuPeQq-ZEFL9I2XYM7bFWTt0t4LJ5qHpoSes&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LskypixCexmTLK-JxVfZfd9q6m0WPepBZwXegBGQcyA&oe=69FB46AB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Da19rdgCyvwQ7kNvwHuCvhF&_nc_oc=Adon_4uHN2V9BuYpgLJ_wqtqHQbZR0h70SyvAelMBDRtie-P5pJGMa7At6jNn6NQMJU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UcZ2sdHf_SlsSW9jbCZV27CLAp-SQHnnVDQOX015h6w&oe=69FB59AD"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JxgkuSqLSsQ7kNvwHKza26&_nc_oc=AdrcXGplChHPx6r_q4z7SpGm1kYLoY_3oIuM7_CsHbRujJZ5hzDGTl0TXXDzfYdGP5A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JXYbujY9nSmyqU-SsJC7NEWC8KbQmaclmn3aBX6Z5AQ&oe=69FB3D55"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2jGsNIXZepQQ7kNvwGqltll&_nc_oc=Adrrq3VkbwiJbnK7NsswSBot67l6MSKaPYQyjnmtl996VUM1Jnp1PvqtKHEbFhxzTDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss
scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KyvzQpHZdsQ7kNvwHpDIIV&_nc_oc=AdoZ_7S4nQMqw0HX6FADMTkvkcF0I6C0CB6KUCD0iocOvm--u8I1u7cp5pD5p7PTMkk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz0aQVh3teMorChijTOYqg_f2uLu4vMF9AVPGA4n4Z2PA&oe=69C7B2E9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v8CmsMBrGWkQ7kNvwHDxmMz&_nc_oc=Adrzl4FnTFpM6dSh4zeDGWb4KjSTEDFpXO2BmezVDhrNC2ya-5iQDDMAtxtYSkkU3Bo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqEo4XZnZ7aqNFuNeoTFnALw6lRkYt2hCq6QgfmYJCmw&oe=69C7DC2B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2dadqWCd7jQQ7kNvwG7KMAi&_nc_oc=AdqD3uZlKH8qsGHFsImgGHQMbRm8wL1EDjYdW-A97sllftRnOXZ5I3FM4ZB6BQ7Ay5M&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwJ1fqNk7FOd6Ev7pEPSsivPKY4c70ReRKOqFnXAQNEaQ&oe=69C7B6ED"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULNdlQjqOsQQ7kNvwGtg9Nt&_nc_oc=AdrmfX5fHvBiR-n06oRPaWa0_Dml9xUuLZG70a0idogJjhWp7LTFGdyrpO772-5pMeA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWKvr2Qp6aMJW1JIkTmCIu0H8JfQhXSl5lwSAhz2ChHA&oe=69C7D2D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmTrKlsZE6oQ7kNvwEVb2qW&_nc_oc=AdqTUUTFWe_ANynjeXwh3-bRtdJoZrYVkZ0iBGO8keHSYdiwdzN8Rq2hLPKHVXQTjvQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss
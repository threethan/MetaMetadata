2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWziEgW3jMgQ7kNvwGt-D2k&_nc_oc=AdmEY-eOUdgHkawZSQOWq0FKfqSLHUPU9rq3TNpHgy6r3PFgf25m2OO3k8C25HA_Y0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPk7rpaUVg9o_nkQ6HGpXn7uVpE3JwPzUrbINOwUmRrw&oe=69B7E0E9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pp8xh6AsmDgQ7kNvwE9nyg-&_nc_oc=AdldyGaij9vo_dr6xp3p_376I6h3haK6dUYogjs44tIyrGXfyuKtbbpeZjn0nMwMe2U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzj8qOWPKMPkIGnTMlg4M8-OOar26v2aJ1vfZKj9WDzEQ&oe=69B80A2B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ubc7vyLqTEcQ7kNvwEiDJWy&_nc_oc=AdmhLMweRteZdCpQzJEy4tkH8t5yPKhLtmbWmqy84gK4dYdc8p-PyYmTd12pCg9X6as&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwZiZeUsoaPCEN1yZiuTX9k5FBP0uKrGhK_GxiPhllx6g&oe=69B7E4ED"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIbpnB5pc-cQ7kNvwGKyD1l&_nc_oc=Adn3KPSx6JIBl_9G4ZI4iqpb6RXbuSP8Hwrc_o7VybtY9mmNYTfz7Fh8DUuTT6OANok&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwRD9PCc6BpZWpJUlG05CKCTk9Rsd3LCsk0aIuWD7HHbw&oe=69B800D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tK-QHhumNj0Q7kNvwHedAaC&_nc_oc=AdlDydoqjqCQf36otPug4o3FPN17CNUciIl19jWfhEu-ksY7VUU__Ev1gA3iccNaw6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfziC6rKekPr4Dn7DHNAauoC-Oh8-QeT1zZg6lu
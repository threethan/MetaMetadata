scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsuRy631DwIQ7kNvwHM4yiw&_nc_oc=AdpzcPGRfDDWQIvA1PBXmIlvTY1c1M9iq95KvwRuiMwinpBcAAYeaspICuLpGOUarok&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTIJQpretM-6JvDWTwObjlDRRvIq1gNgNH-cJBNiGRDQw&oe=6AE75229"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJPMIvvJz5AQ7kNvwEFkvMp&_nc_oc=AdqerP_i4MoKG26_OXRPG4-GgMpRsLW_l0lYb4XDExju4hhpCFEvnDnpcsT5nH7cyd4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQylGsp8dy_Ru66mBrtp4KhdnL_1n2uNg2nq7SSK3mMuA&oe=6AE7432B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dZeYdU2m2BQQ7kNvwGm1L1r&_nc_oc=Adq1Vnf-f2oKMcfVRp39aoWsbEXIrdwSWDk6cIXnXhqOJUM8dZf5wuBGpbkHpBNBPY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7p_0UM3CzyJkvceVR8JHf-6SIReBwpaPqrzL6Dp5Q0Q&oe=6AE7562D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkNjveyJa7gQ7kNvwFJNctx&_nc_oc=AdpBKB8rlcbwRHZPY1cnYiDcRN1SjJIbKSUpZ-Cn6LzqgBBpcnErjWyrCaFpmr_o_wU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvRdWlqibArSRzUPsPfp8IS-Mp151BHI8RcG1wjkQ9rQ&oe=6AE739D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBgva3QahbUQ7kNvwFcGBKB&_nc_oc=AdrTlhkdkdvhEG3oAwb3H-8R97DUYRCOmT-AtyTmdoV1Syqpu-EU2F7pyGiXUbP3pA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss
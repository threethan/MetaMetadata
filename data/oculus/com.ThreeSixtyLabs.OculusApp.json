2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_KnvRthHDUQ7kNvwHjeefH&_nc_oc=AdmgswMCMViaYaKWMxM56ivKq1LnTO6o2uqRLiHF0fLZ1yhh0VgC9l8UaV3psKGaG3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxY6LcvpRWFmmkXXDVHJfjXMnFP1qJeDi0o7-QO9bxwA&oe=69AFF7E9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qL2IajY-iFMQ7kNvwE8nlfr&_nc_oc=AdnLjhAoWOptjcT01ZP2Ab5qRbM5dcpEcQLEKbXEeTTvJ2gY4P8j5yOqxy19NT2YnNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfygPZ0z4eHTuHjqq5sBm-5s6pgDehk5McPojYcFIWFw-Q&oe=69B0212B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mwr8AERZAAoQ7kNvwFqB9eG&_nc_oc=Adnwf2fS3xuVKtiYfiTAeiHEjqwTraUoDuaPy8UIRuXNoi_xYkaxW71TdvGy5gBX0RE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx_r9eblikkGaKgnFc7MefAUYgzkfUn1r5zRhXQZVDtGw&oe=69AFFBED"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQsxQO0JQUMQ7kNvwGp64WF&_nc_oc=AdnnfpaD2PTBxahC298A9lc5LTVKkCVZjOa1bdZrQlKDU9yL6Qt8NsttqNoS9IO8BZs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZRpZUbGkX0LNJnYphfusrPlWnNB4Q2twAkcKk4_2EJA&oe=69B017D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h27AUP3qgmEQ7kNvwETrBtO&_nc_oc=AdkHWagMMeEh8T4dnREyY2lABfwfLXZDSIuriocP0LVJuVq-LfCnW-sAa5KfNsPwITI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYruJArFBwBd48ZQp8bSzMSyOk7IM719PGfVT
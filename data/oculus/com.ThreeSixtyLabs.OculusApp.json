scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND8GCrM1nrwQ7kNvwFrqV8N&_nc_oc=AdqC5aHHAiA-az64O1EL_IfNJydG-Hz4Xt3lh2744BZr1jX-NVk1wO9B115Rx9NPHOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmtktrLXzEyD78nNeJYMmC5JqVG7JwvMWQcoYT-L76-w&oe=6AAAAD29"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCIiSZHiQoAQ7kNvwFl_rv5&_nc_oc=Adrw1odIuGCfdnx9rxWrQTW0rMoC-xws4osbEg5u3zbfUjP7XsnBH1N0CCsSqxJunKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSgMm3YtWKNYi1Z2imHoz1WzEmrg37VfD5TH6jwgZTIg&oe=6AAA9E2B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yibFxqmp1jYQ7kNvwHBd_3P&_nc_oc=Adr_FeQhfg_yXhfs95LEaRliLwQtcgOr4LEXPzFL7ih4VSXPq3Zbi6Uy0DY8n6CViDA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaluwobfAUCICCZ7Flck88Tiw2uM43B7MO-Hr6Z8d6BA&oe=6AAAB12D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByldeXZBv-cQ7kNvwEm89UF&_nc_oc=Adp8YRaCfxt1g6Km1hx801zFBJqWc_8GAnNaDU985jhLd_mxK30I8mC0093h7D3rrVc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrS3Z-VNAK13S1NN2Yuxm65G803spNc2CRzm7jcQQ0yg&oe=6AAA94D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTmpeTNagAcQ7kNvwFrtX-7&_nc_oc=Adrblgwan2J6LXU2boBA76uF7U-HoLROTj6677AzYsI-5a7ebsUWLcjqIcSHxDSc1Gc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss
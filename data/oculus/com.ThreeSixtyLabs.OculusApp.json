scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAbxZgsd7KQQ7kNvwElj3at&_nc_oc=AdrSuk8OHxxMNVVV1b6Yl077lyFPjX4PBhzlIGjyKiRCzfKHBfLVleCR1kWRvMvQx0s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaxq-j1_m6d3zHhXRBcQ7PMSmTxY1jXrq8v_ZgER2lMg&oe=6A4A6FA9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uxd-H2FHlkgQ7kNvwEaK3yQ&_nc_oc=AdofpeSecmLhyUmBtxG3wnrWiZbNuyrH2bsQjgvE48F99OZtISaq0_Z5r6Fma7rgBV0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqwo2qzX7TXceBNG4l0wp_GHCLArIf2pUkedJG79thoQ&oe=6A4A60AB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ0JjddZzJAQ7kNvwHnOfSF&_nc_oc=AdpBz7csfw6aOgbwinbIJP-3FGGrsDzujVlrCXlmbcz-lBQVJ8CWA-6z4yOqQuXu7HM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ7_9NoyZoCcSfZxmNWAWqMjQK6HczQ9dew2fHz2BZxw&oe=6A4A73AD"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQNCKr-T_BwQ7kNvwF7tI8I&_nc_oc=AdpCPFFZGKKeLbcz6-77Orx2fUJw-nqYSy2E4j52LY22eCCW1kOjVcvw8vvjvbg0bLQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR2L3Tc8oMv00E4EtrfEudwWRJ2iZfVS7e9KT28iG92w&oe=6A4A5755"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pqF_VCDgwwQ7kNvwFArhtL&_nc_oc=AdpbYcN3_ZGRN6F5OitttvZSueNEPIZJvNTH0QkMtGUCLKFpw5a1lUyAtGby_xZTAp0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss
scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Uv9pvyAwUIQ7kNvwFCNDUy&_nc_oc=AdoOJTVncW0UxyLqop_O8MCc3UX54FIfWxP7KQfY78GqnXxZDCWo7Vsn67VMIvTETME&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3t3LTYdyfYaXNZMzCRqSTWXnY7lVxcAxy7Z23YQI77cA&oe=69F36CA9"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cerj1629Qi8Q7kNvwHDx2dL&_nc_oc=AdphsFp5sTwnQb3XF-9PvV8iXLOKuxU14CQF2RZAgORQxguAeNzg4NjD22o36ORzo4Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Sl_lljrHuTkvEy5NqsbQOj8y3NYZDnmMbfc5xpbsoxA&oe=69F35DAB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY-THPQnsekQ7kNvwFeiFmd&_nc_oc=AdpKtYUZHDPQluwFo9u-FAjx782_sFZeIZR_Y8D7LnD7eB2ie7u7X-DqHrIvCAyzd4w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3FPR4BigKwl7ffoHBecUaUHLdZf_XK7ziSpI6zmoYrhQ&oe=69F370AD"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vycqbW8aHcIQ7kNvwGW53Ns&_nc_oc=AdqRV6zARBDgvEw3x5DPs8J376jplpLZ2AMDGGrbO9_nw3OPjbXI22Ctm3IjOA1wBxE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1kWPe04IaGsAf538PxYk1xHm6iQs2CQdUj4yBe-pJkIg&oe=69F35455"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhA_-NeKCPAQ7kNvwGS2Flr&_nc_oc=Adqltxz9O3yA2BwImz9q2yTSu__yn1uHshUovez9_W_cys4MN6Pm3CiOECp7fWoZls4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss
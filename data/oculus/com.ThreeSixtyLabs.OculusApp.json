scdn.com/v/t64.5771-25/38974721_2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTMupOV8WrIQ7kNvwFcEivH&_nc_oc=Adp-SbP5Ym_hcau-j-YdrnRIuHZNdjcRwe7tj7pvIWD181gI_IkzvBLBadulAT6LNmA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKbbb1aqZkGBCMSnentbQRUejAPoP1mH-y6OjAcII6qQ&oe=6A86DC69"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmu_6fL4c8MQ7kNvwEI9j5B&_nc_oc=Adpv0jDf2dj23jgLFs41bR3fv1LlOLg-V39gBkntnGFK2uVai_3BllWumNUbLv_hzO0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMseyyDFyb-yb7AR45BKjMqXMyEeAFICDLtAIsIxSCVg&oe=6A86CD6B"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z2cbUkG02bsQ7kNvwGIMiAu&_nc_oc=AdrAhPK_IVBxsi4Me5LH0xpWSt3kLp_1jhFgwWTQskJpcgDZnQ8qY066CFQJ1Oa5zm0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnXAfuOE51LWK_HFZSWQLzMqj7Ted0Te9pML_1ruJKsw&oe=6A86E06D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=78jIzeVnx2UQ7kNvwHusTax&_nc_oc=AdpyIGIjfRbHLE-MwwXPJQIXuzlaW_AHc-n0oyHaYS-Q_0TY6jn3bFutT33ylbKm0Vs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLJZ8nO27cK-qHzx3qtgeuJ4_-Kpmf5sdA99ckliniQw&oe=6A86FC55"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcZ0bVVS-QQQ7kNvwH12b-3&_nc_oc=AdoH0HjNdDift5rxKtkEUuL4mki-cj457ZA-LaqPgbtfq_qHEJMkkE04jR_zrWRr0vM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss
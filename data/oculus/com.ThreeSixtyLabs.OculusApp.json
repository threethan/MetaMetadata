2290559594327029_604087575384162304_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZCziD4E9osQ7kNvwFNqrlG&_nc_oc=Adk26zHP5jpezvLkyi8NKMsioIkfc1T39ux_WOClt07ujbUL6v6X7GTjm1CK8DUyBW4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvWM4hh5Hbr32VBYuKwgnUtunVZHU8GCvny_pQiuiLsdg&oe=69A96069"}, {"file_name": "migrated_image.png", "id": "709855469553458", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035417_367808570571354_1730385471076302848_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Tcz3Di3-xMQ7kNvwGg6gz3&_nc_oc=AdnqdpgJtaMqynMZZgq-kpt8RCmw8g6Ck--3YYhWavqVu1HL2HBe-8CpL-DLU3j3poE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv67Ld3YUw7aN6bjvwzW48HMka7l8ZCqQ4TLC8Nm5gTgQ&oe=69A989AB"}, {"file_name": "migrated_image.png", "id": "617287925488508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982626_2099989106962404_515613826066939904_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pQtouJIYL3AQ7kNvwGTg0M-&_nc_oc=AdnR-JTEy2FQ4AcwWYRebCWQst5EWyNd7CD9_G8pl0bAlnUUbLV1oAOQqX1Vzxkc20A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuwG8t2vZTfPyE-FL8S6sI0W8JEu1a7fOjyeK2R5RIQOA&oe=69A9646D"}, {"file_name": "migrated_image.png", "id": "209848500235532", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001684_347354272875951_1682161058585772032_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqPA5t8Ytl8Q7kNvwHU1p4w&_nc_oc=Adk3dm-FMuVKv5AP5E3UcE1P7oJLuPtRfJeqjB7STjdB-sHiz-hDOsQphiXR-ZGMp-Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvRI_ZJrwoF0KTdFMGN-Pa_jNWTOhAkfWnhhHiSX75pLw&oe=69A98055"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "360 Labs: Immersive 360 Stories", "keywords": ["360", "video", "films", "documentary", "stories"], "long_description": "Celebrating more than 5 years in VR, Portland Oregon's pioneering VR studio, 360 Labs, sets new storytelling standards in this new medium. This app is your private screening of our original VR films and documentaries. Journey through the Grand Canyon and be in the room when the Navajo people decide to protect it for us all in \"as it is: A Grand Canyon VR Documentary.\" \"The Fire In Our Backyard\" remembers the Eagle Creek Fire of 2017 that burned the historic Columbia River Gorge near Portland, OR. These experiences and more will thrill you, inform you, and make you feel like you were there. \n\nOur original films can be streamed at up to 4K resolution or downloaded for offline playback. We will be regularly updating by adding new releases as they're available.", "short_description": "Stream or download original VR films & 360 documentaries by 360 Labs."}]}, "developer_name": "360 Labs", "developer_privacy_policy_url": "https://360labs.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "360 Labs LLC", "support_website_url": null, "website_url": "https://360labs.net/app", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "DOCUMENTARY_HISTORY", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "362519821993947"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982668_1731232217183913_8547515360385957888_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ijgOGFcse7gQ7kNvwFXU2B-&_nc_oc=AdmEsBo0uvu1eaNUlohKa2Zm9IFbDYKRPwLMbSx1o7OE4bz3viJxxI-MueNeIUU5zYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuqhAZJShNPm4iEb7-VRpSBuwslPu0bbhthQBC
8fIM8j7QpB1A&oe=6B09B7AA"}, {"file_name": "MCave_Asymptote_SCR5.png", "id": "1249168120460867", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823366_1249168127127533_8304838705569328017_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2cDulqMi_gQ7kNvwHGCMsD&_nc_oc=AdpFJUf-bRAgPR3hKoS86VbiG8nECiVDp_Q8_MiPtQrNYwlqzJa8CHHXtvbMsYW4qjc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrtM1P0fGMwJlqb5Tn96G7rgyaQyacMsTE4naJp61yzw&oe=6B09A3A5"}, {"file_name": "MCave_Asymptote_SCR3.png", "id": "1451092906541688", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824328_1451092909875021_1390144558562273414_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQBGEwNVWKYQ7kNvwGA6AYv&_nc_oc=Ado0EHuHSzUmthZL-NDWfWfsjK_J17Fg_07XsQxMHgJUTFrgnwYsmfCwXJ795uNYDLI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfU5-lliMNNfgkTYQx6EF58neJ82NiGanId6vc1cWjEQ&oe=6B099D5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MCave_Asymptote_ObrazGlowny.png", "id": "923553506998120", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823341_923553510331453_9130877192166425118_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-vqAlt5zpEQ7kNvwG4JgC-&_nc_oc=Ado9wNKod8Fewug1C13-FtkkXfBvFUqoqPJJ6Az_-nMCs_6ffI3ZErA6BDWJ1vtOgzA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjXa3L412F1rOd09Ufudjqexym70MYW4d95JiC9br0lg&oe=6B09ADEB"}, "display_name": "Asymptote", "keywords": ["Flying", "Action", "Arcade"], "long_description": "Asymptote is a fast, arcade\u2011style VR game built around free flight in full 3D space. This demo presents a complete, self\u2011contained slice of gameplay: two zones, one enemy type, two power\u2011ups, and the full risk\u2011and\u2011reward cycle that defines the game\u2019s pace.\n\nCollect unstable energy cores in a dynamically shifting environment, manage time and risk, and use optional combat to boost your score multiplier. Short, intense sessions and local leaderboards encourage replaying runs and refining your flight paths.\n\nThis is an early version focused on the core mechanics. Additional features will be expanded as development progresses.", "short_description": "Asymptote is a fast, arcade\u2011style VR game built around free flight in 3D, where you collect unstable energy cores in dynamically shifting zones and balance risk against reward. This demo showcases the full gameplay loop with two zones, one enemy type, power\u2011ups, and local leaderboards."}]}, "developer_name": "MCave", "developer_privacy_policy_url": "https://mechanicalcave.github.io/asymptote-privacy/", "developer_terms_of_service_url": null, "publisher_name": "MCave", "support_website_url": null, "website_url": "https://mechanicalcave.github.io/asymptote-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33992052993741750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_873941548766269_3696947139818873033_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRH4mxEwpKwQ7kNvwE9AjAX&_nc_oc=AdptoR0XdELE0O8IscAnYm7FKcdJt2Rr-QWADtVMvtZ6gaAzxoh5xZcA9IMtUBY__6A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_n
?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUyWrfORb_gQ7kNvwFM-H5f&_nc_oc=AdqWWZN1Xnvto8XFysQFWNwidFg4xYw20OvG_bEI5e4JdAtNHoUaqsmRtXzei_1nRgk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_DXQSP9atyBnRhFkUwm9x_cnUfQf-a8-ZE3pmqi6rSg&oe=6ADE2225"}, {"file_name": "MCave_Asymptote_SCR3.png", "id": "1451092906541688", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491824328_1451092909875021_1390144558562273414_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mOQbljQmxgIQ7kNvwEylIwT&_nc_oc=AdqUaMzJwrB7bd9r8acESzmVYR3ONvfKCGkpa3KdG30GcBn6eH3xhaA0OlZRtsG8tNw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9GQe4t0QMGLC2aAJPbhmw_GOEiF3tvTliDvNJImKs_g&oe=6ADE1BDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MCave_Asymptote_ObrazGlowny.png", "id": "923553506998120", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823341_923553510331453_9130877192166425118_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RV-6GaC51kwQ7kNvwHslRSs&_nc_oc=AdppmZfmSYdihENX13KfpiF1b28m95L9eqAKuIGh6QsjCPFUgvlbmIOzufNCMbhkjWM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUwsaI0cLFL3HzZ6aVoOfxXPi3UIRvseqrqxCFLut87A&oe=6ADDF42B"}, "display_name": "Asymptote", "keywords": ["Flying", "Action", "Arcade"], "long_description": "Asymptote is a fast, arcade\u2011style VR game built around free flight in full 3D space. This demo presents a complete, self\u2011contained slice of gameplay: two zones, one enemy type, two power\u2011ups, and the full risk\u2011and\u2011reward cycle that defines the game\u2019s pace.\n\nCollect unstable energy cores in a dynamically shifting environment, manage time and risk, and use optional combat to boost your score multiplier. Short, intense sessions and local leaderboards encourage replaying runs and refining your flight paths.\n\nThis is an early version focused on the core mechanics. Additional features will be expanded as development progresses.", "short_description": "Asymptote is a fast, arcade\u2011style VR game built around free flight in 3D, where you collect unstable energy cores in dynamically shifting zones and balance risk against reward. This demo showcases the full gameplay loop with two zones, one enemy type, power\u2011ups, and local leaderboards."}]}, "developer_name": "MCave", "developer_privacy_policy_url": "https://mechanicalcave.github.io/asymptote-privacy/", "developer_terms_of_service_url": null, "publisher_name": "MCave", "support_website_url": null, "website_url": "https://mechanicalcave.github.io/asymptote-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33992052993741750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823310_873941548766269_3696947139818873033_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LU5KB-QFn5sQ7kNvwEwQcEU&_nc_oc=AdqjuP3UVYGvccAAossI7O4TFVX2OQTW_ygQr7Lqa73jpMKcbb3Jul3zfxTw60BAUQk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ1Fh7CTxJbgRYhDOMCdM_ku5IIVTJ-CVpyP4WEfYofA&oe=6ADDFC11"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Asymptote", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_na
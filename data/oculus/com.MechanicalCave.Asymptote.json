nR1S43fWMPFA&oe=6B007D2A"}, {"file_name": "MCave_Asymptote_SCR5.png", "id": "1249168120460867", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1249168127127533_8304838705569328017_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXnoxHYvBsMQ7kNvwEt6HHn&_nc_oc=AdpWCQoC_BJf6gtw5MstZs-H2GHtFXpDScCE0Ox0Tc9kUVwvHgO5EHluSrX9B3HFkaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnHcmcwD1-VeqkPaGvORSa5UZRlL2HPOvw1sjUClF3tA&oe=6B006925"}, {"file_name": "MCave_Asymptote_SCR3.png", "id": "1451092906541688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824328_1451092909875021_1390144558562273414_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YTrqsZPk6xkQ7kNvwHP_D6Y&_nc_oc=Adpv-L3Wd6wfaAI1uYirGdmj5M-7cPMnpdjl6dXoc7DBzpOk03k3jnz7pm6qt_Z_CSc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT__taZO7DssCcuhEgRVDYJP_GWex7eXaQTX-Q0RDzHqg&oe=6B0062DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MCave_Asymptote_ObrazGlowny.png", "id": "923553506998120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_923553510331453_9130877192166425118_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gh7wWMqxyYAQ7kNvwGJOEZR&_nc_oc=AdoniYbPE2sDJDrBqdI7xA3ajeyqqszQhK8GtO2EuMzoHc_np30WZoFf41FUmOPWaCM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjdx222pJV-ES8ZSQe0237zCJMCZGVIiAzv3hTbqpz6w&oe=6B00736B"}, "display_name": "Asymptote", "keywords": ["Flying", "Action", "Arcade"], "long_description": "Asymptote is a fast, arcade\u2011style VR game built around free flight in full 3D space. This demo presents a complete, self\u2011contained slice of gameplay: two zones, one enemy type, two power\u2011ups, and the full risk\u2011and\u2011reward cycle that defines the game\u2019s pace.\n\nCollect unstable energy cores in a dynamically shifting environment, manage time and risk, and use optional combat to boost your score multiplier. Short, intense sessions and local leaderboards encourage replaying runs and refining your flight paths.\n\nThis is an early version focused on the core mechanics. Additional features will be expanded as development progresses.", "short_description": "Asymptote is a fast, arcade\u2011style VR game built around free flight in 3D, where you collect unstable energy cores in dynamically shifting zones and balance risk against reward. This demo showcases the full gameplay loop with two zones, one enemy type, power\u2011ups, and local leaderboards."}]}, "developer_name": "MCave", "developer_privacy_policy_url": "https://mechanicalcave.github.io/asymptote-privacy/", "developer_terms_of_service_url": null, "publisher_name": "MCave", "support_website_url": null, "website_url": "https://mechanicalcave.github.io/asymptote-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33992052993741750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_873941548766269_3696947139818873033_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vDnvVOwAlwQ7kNvwEpyi3j&_nc_oc=AdoHxfNa6o-TIgdI7l7pvEmz-rZXLWwoBW3hVZvNpiB189jvxnB-UQNolAo1h4NNV_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_n
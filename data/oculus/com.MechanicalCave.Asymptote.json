?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fhd4pCl8GkQ7kNvwFFz3ox&_nc_oc=AdpEhMDSJeKyrgt3aJmv0HYRcAPEsQbFQURPbUQR1TI-BlwykrzsAQLI0cxweAlHEWE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQXOpYiDADljOWk2eEfMhVMU_ASidAt4vJkK5oW_j6nQ&oe=6A883865"}, {"file_name": "MCave_Asymptote_SCR3.png", "id": "1451092906541688", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824328_1451092909875021_1390144558562273414_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wAc_FzmUYiEQ7kNvwHD6x4Z&_nc_oc=AdpwmataLidOjAtUSIb9zmwnuLT_qKpE8A_pe93tCevqhfA5A2LjWaGpKO7Uvdd-YDg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEt6zw_marWnTNOr9PJWF8TbAzHe1JOg65snS8qOjcSEg&oe=6A88321E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MCave_Asymptote_ObrazGlowny.png", "id": "923553506998120", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823341_923553510331453_9130877192166425118_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1pV5Sss8q0Q7kNvwHkM3Uj&_nc_oc=AdqbC1ACNuhpXOn5DTl_mMI1nUBCqCe_NwE6YnpUlc1svTqYcyoRdlcBVPuJByjWl00&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWAasr5XZNAbM9hMl00q6fsM6yrd8UYmqBi-HZJSzXCw&oe=6A8842AB"}, "display_name": "Asymptote", "keywords": ["Flying", "Action", "Arcade"], "long_description": "Asymptote is a fast, arcade\u2011style VR game built around free flight in full 3D space. This demo presents a complete, self\u2011contained slice of gameplay: two zones, one enemy type, two power\u2011ups, and the full risk\u2011and\u2011reward cycle that defines the game\u2019s pace.\n\nCollect unstable energy cores in a dynamically shifting environment, manage time and risk, and use optional combat to boost your score multiplier. Short, intense sessions and local leaderboards encourage replaying runs and refining your flight paths.\n\nThis is an early version focused on the core mechanics. Additional features will be expanded as development progresses.", "short_description": "Asymptote is a fast, arcade\u2011style VR game built around free flight in 3D, where you collect unstable energy cores in dynamically shifting zones and balance risk against reward. This demo showcases the full gameplay loop with two zones, one enemy type, power\u2011ups, and local leaderboards."}]}, "developer_name": "MCave", "developer_privacy_policy_url": "https://mechanicalcave.github.io/asymptote-privacy/", "developer_terms_of_service_url": null, "publisher_name": "MCave", "support_website_url": null, "website_url": "https://mechanicalcave.github.io/asymptote-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33992052993741750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491823310_873941548766269_3696947139818873033_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-MNz-hIicoQ7kNvwGoWGoD&_nc_oc=Ado_xlNtPH8q3dpfrfwkxNknSjm_0vF-KCfnRjYWJDD_Tl_cgh3CU9sISyoq59pWwPA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-J96iqqUsRa6zaZ8_QxmC74qIPxEEbZSJvOKn0yBgAQ&oe=6A884A91"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Asymptote", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_na
E9uSFHc6rf9Q&oe=6B05C32A"}, {"file_name": "MCave_Asymptote_SCR5.png", "id": "1249168120460867", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823366_1249168127127533_8304838705569328017_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kF38UvxsSyAQ7kNvwHxsnQc&_nc_oc=Adrdlp69NGA61z5Lf04_LNOm1zcJC6ipvzsnZt9dvbhzJbKRhO831wy1l2MNO01k_Gg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6zU4wgFU3YN4Ik3Vdpy8InqIUaNGs9lqfKCXc5onq4g&oe=6B05AF25"}, {"file_name": "MCave_Asymptote_SCR3.png", "id": "1451092906541688", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824328_1451092909875021_1390144558562273414_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gqdVIL9qNZ0Q7kNvwFhu16u&_nc_oc=Adq3akgXqRRaqkFUtyNmlUawrgquI5K0EHuXeM5nu7SHjqTUTGFUVcw6Ivv8bw-WLdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTE9VDaWv16VMXndM0rx1xMK6xEaFX6bip9sDS4gRVCA&oe=6B05A8DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MCave_Asymptote_ObrazGlowny.png", "id": "923553506998120", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823341_923553510331453_9130877192166425118_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rRc4AJW-hzkQ7kNvwGbxshk&_nc_oc=AdowMV9MsVhe8d4nDaiAv0ZooP53e8O9tIyCfuLsjZRsb4if-wH_fp5KrE9poGGjiyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyB5ITAN9_GmpZ2VHlz2OXehDbAoi9BjFcFQ_C4peUEw&oe=6B05B96B"}, "display_name": "Asymptote", "keywords": ["Flying", "Action", "Arcade"], "long_description": "Asymptote is a fast, arcade\u2011style VR game built around free flight in full 3D space. This demo presents a complete, self\u2011contained slice of gameplay: two zones, one enemy type, two power\u2011ups, and the full risk\u2011and\u2011reward cycle that defines the game\u2019s pace.\n\nCollect unstable energy cores in a dynamically shifting environment, manage time and risk, and use optional combat to boost your score multiplier. Short, intense sessions and local leaderboards encourage replaying runs and refining your flight paths.\n\nThis is an early version focused on the core mechanics. Additional features will be expanded as development progresses.", "short_description": "Asymptote is a fast, arcade\u2011style VR game built around free flight in 3D, where you collect unstable energy cores in dynamically shifting zones and balance risk against reward. This demo showcases the full gameplay loop with two zones, one enemy type, power\u2011ups, and local leaderboards."}]}, "developer_name": "MCave", "developer_privacy_policy_url": "https://mechanicalcave.github.io/asymptote-privacy/", "developer_terms_of_service_url": null, "publisher_name": "MCave", "support_website_url": null, "website_url": "https://mechanicalcave.github.io/asymptote-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "33992052993741750"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823310_873941548766269_3696947139818873033_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdPGAWYc3aUQ7kNvwHHdCuN&_nc_oc=AdrUgTfyfJTjLSa35SJGnG4gcNd4gZzwRUviwbXseLokiszOuSU7bwDAfjWRvPAduTg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_n
ame": "New Species Found", "keywords": [], "long_description": "Dive! Your mission is to investigate reports of unclassified sea life in an underwater biome. Get ready to explore the mysteries of the ocean as you take the control of the OE-Mk IV submarine.\n\nYou have arrived at your oceanic laboratory which is your homebase for species classification and refueling. The Mk IV submarine has limited fuel and oxygen. Fuel and oxygen consumption is increased by high speeds and excessive spotlight and instrument use. You will need to collect information about sea life and return to the laboratory before exhausting your resources to complete a successful mission. If you run out of fuel or oxygen before returning to your homebase your research will be lost at sea.\n\nNew Species Found! Combines action and adventure while exploring and learning about the undersea world and the amazing animals that live there.\n", "short_description": "Dive! Your mission is to investigate reports of unclassified sea life in an underwater biome. Get ready to explore the mysteries of the ocean as you take the control of the OE-Mk IV submarine. Your mission is to take a fantastic voyage under the sea and learn about the amazing animals that live there. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immersive-3d.com/PrivacyPolicy", "developer_terms_of_service_url": "https://www.immersive-3d.com/", "publisher_name": "Immersive 3D", "support_website_url": "https://www.immersive-3d.com/", "website_url": "https://www.immersive-3d.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": nu
om&_nc_ss=7f20f&oh=00_AQRARSf90PLHngRJkLoGjoITQd80O1CuLPx-LxirqApsTQ&oe=6B085E53"}, {"file_name": "output-onlinepngtools (98).png", "id": "561110515566094", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974583_561110518899427_1446462400523906396_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UZA7qTnl0sQ7kNvwGiTbP4&_nc_oc=AdrDRt05W5HAva0bDorvhUKicxRWFGhI7HaS0qmYmHSgKFsahvhy-KV5NPk35hLm8bE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrO_VeOr3EUsEFCxLq8_6KLLBwV5WGIGr3CPjx7IfAnw&oe=6B0856CC"}, {"file_name": "output-onlinepngtools (99).png", "id": "1084880892224478", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982512_1084880895557811_342572118875759481_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yqggs2kxSMsQ7kNvwHqGEeh&_nc_oc=AdqMKc32-VWaIi4E-xupsukIqj4-GAqT2NWIj8dHuQIcijD5TbpjiLZdTOFwQGI0ONk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRU3qmIJjPrIrLZAXLxDgSItVlavFZsxHD5S-rB5JAp9Q&oe=6B086DF0"}, {"file_name": "output-onlinepngtools (96).png", "id": "7473066002766903", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974671_7473066006100236_6654848422998600134_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sC77mvJHZq8Q7kNvwFHjuOR&_nc_oc=Adpm91_r7gXODYAtl-qflL2Jb6VJ72R4g_TWdJB9wcnGOA8x-qEsQB1GiN734ZWQoM4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTu7X1d27zB4qEYe-d3BSRlU0GnMinYbgiYQPuMxxKNdg&oe=6B08717E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "2375321699948121", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/908842205_2375321706614787_2013673474779363248_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=70PynLT6XOwQ7kNvwHf1QrM&_nc_oc=AdpJV_R2ITHv08Da6EjwVFLyNCmj7-qOsri-F2M9VbMpWMKHBotN6l5MeE8noI2Y4Gg&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzzIZqcxJRvjIR9GV-MZ7na134XPtYE40XY0VtzCRT2w&oe=6B083FA3"}, "display_name": "Chaotic Dojo", "keywords": ["karate", "shotokan", "boxing", "judo", "capoeira"], "long_description": "Step into a dojo where your opponent fights back.\n\nChaotic Dojo is a VR martial arts and self-defense sim made by a martial artist. AI opponents dodge, feint, change angles, throw combos and counter, so every round feels like sparring, not hitting a sandbag.\n\nDOJO MODE: Duel Shotokan Karate, Boxing, Kung Fu Sanshou, Capoeira, Jeet Kune Do, knife, rapier and sabre fighters, each with 4 fighting styles. Plus cutting, judo and archery drills.\n\nSTREETZ MODE: Defend yourself against multiple attackers in street, transit and indoor scenes.\n\nKUMITE MODE: Take on 10 to 100 opponents in a row, unarmed, with weapons, or on the street. How many can you knock out?\n\nJUDO TRAINING: Learn judo step by step from zero, with diagrams and video demos of six throws, from O-goshi and Seoi-nage to Kata-guruma.\n\nWEAPONS: Knife, sabre, rapier, katana, bow, baseball bat, brick and bottle.\n\nHEMA-STYLE SWORDPLAY: Physics-based duels end in one or two clean hits. Keep your guard up.\n\nTAKEDOWNS: Judo throws and knife-defense takedowns deal real damage.\n\nWATCH MODE: Pick two fighters and watch ragdoll-physics AI bouts.\n\nMove with your feet instead of the stick and a session turns into a real workout.", "short_description": "VR martial arts sparring and self-defense. Fight AI that dodges, feints and counters, with fists, swords, knives and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "2776542286000603"}, {"id": "45978
om&_nc_ss=7f30f&oh=00_AQRNIDpVW4EuKplCF39FB5XkT-hw72bymm6KdZ944ffaKw&oe=6B0C52D3"}, {"file_name": "output-onlinepngtools (98).png", "id": "561110515566094", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_561110518899427_1446462400523906396_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Q6ekHPFvkkQ7kNvwEx0olV&_nc_oc=Adp2Q5PLr1gozkvpXG4suOb5mYSK4Cu6d2ZYfGqY6_uj4bFXNwm2VC4da4SPIgp-6tU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT4JEnolNB4rpv5QvNMwYybY-dEJ4QhrscjvQ9qtEijtA&oe=6B0C838C"}, {"file_name": "output-onlinepngtools (99).png", "id": "1084880892224478", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982512_1084880895557811_342572118875759481_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGLHpvY9wc4Q7kNvwH_sqm-&_nc_oc=Adrwk9UGWUwxgUebmO7CkWAgvb69iN2ZsYUmZQQYdoHlAPsDRs0tMy8tsAeieH317Rc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRq8eybmfqooYZv6h3YAed_ENhQmFXVgvLW4tbjeFXl2w&oe=6B0C6270"}, {"file_name": "output-onlinepngtools (96).png", "id": "7473066002766903", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974671_7473066006100236_6654848422998600134_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUCak7c8QlsQ7kNvwGOm86o&_nc_oc=Adp1i3qaPvYH41EM21MfgV6DoGiHrTXXL3ETkSAQKnPK3SLyCGbm3YjDW-2ScUtDOPk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ3_NAZ0wc3NTZlScPpjb5jn9VM3BAvcC5U0CvzN5NBmA&oe=6B0C65FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "2375321699948121", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/908842205_2375321706614787_2013673474779363248_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tk79n2F_B2EQ7kNvwEP-Cpv&_nc_oc=AdqUx917IaOEfgi68bEaOUFB8DCWd6p_9MiR1_4B2neS3kOX8-78ovmmjpBjjyz_gxw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR6wX-p4gkX0RDhEi_oARy6MhBlo1WxYwKa2jPGtTAg2Q&oe=6B0C6C63"}, "display_name": "Chaotic Dojo", "keywords": ["karate", "shotokan", "boxing", "judo", "capoeira"], "long_description": "Step into a dojo where your opponent fights back.\n\nChaotic Dojo is a VR martial arts and self-defense sim made by a martial artist. AI opponents dodge, feint, change angles, throw combos and counter, so every round feels like sparring, not hitting a sandbag.\n\nDOJO MODE: Duel Shotokan Karate, Boxing, Kung Fu Sanshou, Capoeira, Jeet Kune Do, knife, rapier and sabre fighters, each with 4 fighting styles. Plus cutting, judo and archery drills.\n\nSTREETZ MODE: Defend yourself against multiple attackers in street, transit and indoor scenes.\n\nKUMITE MODE: Take on 10 to 100 opponents in a row, unarmed, with weapons, or on the street. How many can you knock out?\n\nJUDO TRAINING: Learn judo step by step from zero, with diagrams and video demos of six throws, from O-goshi and Seoi-nage to Kata-guruma.\n\nWEAPONS: Knife, sabre, rapier, katana, bow, baseball bat, brick and bottle.\n\nHEMA-STYLE SWORDPLAY: Physics-based duels end in one or two clean hits. Keep your guard up.\n\nTAKEDOWNS: Judo throws and knife-defense takedowns deal real damage.\n\nWATCH MODE: Pick two fighters and watch ragdoll-physics AI bouts.\n\nMove with your feet instead of the stick and a session turns into a real workout.", "short_description": "VR martial arts sparring and self-defense. Fight AI that dodges, feints and counters, with fists, swords, knives and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "2776542286000603"}, {"id": "45978
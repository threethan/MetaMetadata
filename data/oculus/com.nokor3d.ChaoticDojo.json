om&_nc_ss=7f30f&oh=00_AQQyhAGDvguNlxtSXMPCPlIq0JopJoXLsliQ70jw2oudlA&oe=6B0DA453"}, {"file_name": "output-onlinepngtools (98).png", "id": "561110515566094", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974583_561110518899427_1446462400523906396_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Q6ekHPFvkkQ7kNvwGp0T-l&_nc_oc=AdruDxQDNZ3GKF4bWWXdx14F_nW2DgX5bds5jjCLPuBKzoArV6UrFCEPyu1XlPsBogo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS_-bkHOZnsDJL6T7TvlDfFNycxwu4ug7pC6ewlP6H62A&oe=6B0D9CCC"}, {"file_name": "output-onlinepngtools (99).png", "id": "1084880892224478", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_1084880895557811_342572118875759481_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGLHpvY9wc4Q7kNvwGgoFSS&_nc_oc=Ado9xcgir1nDyjoIXPl6_yIWn1HUpOEbmRTYGLsXDECFBrh_vKu8AmIOX5Vuniv95ts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSs10m_vlTSD5XG3xfM8wM5KXp90dvYzHIzNNIBqb9-NQ&oe=6B0DB3F0"}, {"file_name": "output-onlinepngtools (96).png", "id": "7473066002766903", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974671_7473066006100236_6654848422998600134_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bUCak7c8QlsQ7kNvwG8eT2a&_nc_oc=AdrXhBvENhOv0XZalIS64kSMTMdk_yz7SGY5kSV2iK3NUA2tjdhrs5J3ihtACdFUvZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhyKOQEgMJIKJg68uouo6hS34GoAJasFjfVwrzYqe_UQ&oe=6B0DB77E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_2560x1440.png", "id": "2375321699948121", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842205_2375321706614787_2013673474779363248_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2cWdpRneSAQ7kNvwFY4GVu&_nc_oc=Ado4v0YYmf_bDHhgRfGZ-MltgXs3kBU6u3bBvQ7_aR645PqhWQ-sVwhr6WCrTmMvYx0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRa_GRUgpVmxT_4CHbvvTunIX2aw4k8V1-kPBpE9jyLCA&oe=6B0DBDE3"}, "display_name": "Chaotic Dojo", "keywords": ["karate", "shotokan", "boxing", "judo", "capoeira"], "long_description": "Step into a dojo where your opponent fights back.\n\nChaotic Dojo is a VR martial arts and self-defense sim made by a martial artist. AI opponents dodge, feint, change angles, throw combos and counter, so every round feels like sparring, not hitting a sandbag.\n\nDOJO MODE: Duel Shotokan Karate, Boxing, Kung Fu Sanshou, Capoeira, Jeet Kune Do, knife, rapier and sabre fighters, each with 4 fighting styles. Plus cutting, judo and archery drills.\n\nSTREETZ MODE: Defend yourself against multiple attackers in street, transit and indoor scenes.\n\nKUMITE MODE: Take on 10 to 100 opponents in a row, unarmed, with weapons, or on the street. How many can you knock out?\n\nJUDO TRAINING: Learn judo step by step from zero, with diagrams and video demos of six throws, from O-goshi and Seoi-nage to Kata-guruma.\n\nWEAPONS: Knife, sabre, rapier, katana, bow, baseball bat, brick and bottle.\n\nHEMA-STYLE SWORDPLAY: Physics-based duels end in one or two clean hits. Keep your guard up.\n\nTAKEDOWNS: Judo throws and knife-defense takedowns deal real damage.\n\nWATCH MODE: Pick two fighters and watch ragdoll-physics AI bouts.\n\nMove with your feet instead of the stick and a session turns into a real workout.", "short_description": "VR martial arts sparring and self-defense. Fight AI that dodges, feints and counters, with fists, swords, knives and more."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.3dnokor.com/", "developer_terms_of_service_url": null, "publisher_name": "3DNOKOR", "support_website_url": null, "website_url": "https://www.3dnokor.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "2776542286000603"}, {"id": "45978
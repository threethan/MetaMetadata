4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eAIEoSFQkoQ7kNvwHUzT-N&_nc_oc=AdrTPipBWEL8I1lisAvxLFRUXXYpHmzLcAkZVPoi24q2pdEDI6AJVHMAMjv5Lc-Ooqc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K8Vgemr-QFz8Rzx9lsyDXBwkCgRtACJOZhuRWQdsWKQ&oe=69E8BFC0"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFMcLG8spVYQ7kNvwFsZxgX&_nc_oc=AdqHujKFGdwWuFe_ggbscAOC6zGVOXra67F_x89Fh2jOyK1kHAvAg0puPDEjfu17IMw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af066wCAewTL184uiJS295XWfZHsY5QT6NjI_2XQGCHaHA&oe=69E8AD6E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUF4MDd817EQ7kNvwFZjbmq&_nc_oc=AdqMIRP_2fM2fbQGMiaMVVrTchgKQOpO-HBIDILWToaQ7h9-qKn_WtEOmxxMHi5sC18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rvXYkZaJONZ1P3EABt6k_7_SBCndT0_OltnFWzVhz7w&oe=69E8B4A3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p30bdWU_yTwQ7kNvwFxtlLJ&_nc_oc=AdpfKckOBBW9vC1WlfHW-PPI3mXV5IpQqvI0q0kC_v4r5GWFBmiXIfZtiGM80i1Vwnk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3n-fKT6KwdGehcA_4e8WZTxVCqw5vOj6c7em04DMCnBg&oe=69E8B19E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ElJtcuOMqjIQ7kNvwF8tS1p&_nc_oc=Adr0XVItkjowbRXOIQmd31CROEKUARoCm80HqVJ6LaEWpXzEt7eNxxStL7wdxic0S34&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FvBGjj6fngE8uloTTWCbPjGApz9ju5uXqqEXhKS9Ogw&oe=69E8AA22"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
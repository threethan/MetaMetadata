4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zv1qMh_3xMQ7kNvwG4sK7U&_nc_oc=AdoheuPb6WrcBjbtDiO_MU551rOwQUGIjLgAlvBzg0bEXD45KYBCUqHQcsFMIdoYvq8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JJ_W19zj5_iplC_FwrYosXzmTU5FyLVbdK9MxYghwPg&oe=6A12EFC0"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP15AUNx998Q7kNvwHaaJ99&_nc_oc=AdoTBJOC8Ozm1_haf5EhCeoHqV1BHkfy3hDe7heDkMC5OGmlPId0mEBXiyTxR7tudgU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-_zSoPOlnQsSZZK9HDQc2-fRVXd4nWt19PEazrahNBg&oe=6A1315AE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKIzgu4bUP4Q7kNvwGUU72_&_nc_oc=Adrgv9UyrttnH1V17o00DST_3aai9_y8GwQ-BiTKlk6L5c5f5iay1LWsX6LzcY1HNBY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af678EGdABDHeeuOzd7kwjh-mU0fWyh9QrJVE0Ryh_E_HQ&oe=6A131CE3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8dX8fXSf7wQ7kNvwGXPa73&_nc_oc=AdpKqqves-QGvnWmxBC0uzw69tuG6I0f_IMEb4KD8q8VHqs-PVF7mOuVTySd8-nTOpk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53dntAwV9TZYdWuikiZIy8aT8T14NyH8jlF_pmKJH1lw&oe=6A1319DE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XEaIKzRSm0Q7kNvwHYVt0F&_nc_oc=AdpsPzOQwIqgdpwLcIF8fi8Chrk3UlRx6nHS8_toa_z95bAYLO23aoAbFcFbQCw8_Hw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PB1reYG2lw9KfxU7K0nW7FlwdXFZOS1fhZBEHX_qb2A&oe=6A131262"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
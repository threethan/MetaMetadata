4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3-IL6cvQW4Q7kNvwGHxUGd&_nc_oc=Adpl3R6tVb6yXfj7F6YSIJCctgGbe79Jp3IS0j7J4YID5hUDsXS4hyNigB5og_ZM04U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Sigr_C9mbESLTjN67rqrYHFS5kcIj1e--a9c2h1_Jpw&oe=69D8EDC0"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMKdQwAgMNMQ7kNvwHCF2-A&_nc_oc=AdpTPpfTvl4tVHstUiOVEHIcwNJboftZQ1uJzvCue4A8umMSdcq5tqyFqMJ6XQXF4-M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0s7XOMZdd0x_xEZU6wrPQ2EoYiVtyRZ6DWwv6uQpuZWw&oe=69D8DB6E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=286XDBYZkFEQ7kNvwEqI9uJ&_nc_oc=AdoXXHxmrcOtriImHFbCExZfs5TAUVvBSRqz9-iRTDbr8SsDfo5-JwPrbcAFoHLgIUk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19cGMQ_9mOC6owWm_dFBI00NMpbuqCTDFf8r7vxLFA3g&oe=69D8E2A3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQr2SbsxdEEQ7kNvwEv7Xbu&_nc_oc=AdpmxrWMpktPVuM6bmUgy1WkL8SJdBSaSq7sQc9L-s0sAeLXpvoMzTO88zEh_mBL_dg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af22yBkTllZUvQtiQgd7de0Mke8fk6C5oeq2JzaYN3LLrA&oe=69D8DF9E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8i_lg5Z_IhcQ7kNvwHl1W9f&_nc_oc=AdpAt0vn_M5MJkwGNLv0J8bOWOfCiaHB91zm5m8ZAelszHSQrAGZ3vu1jfyqtqh0ogU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cJLZF9irFC2ckg5jAGtEz7zhvAKQFaSo9UpuDD_dLuA&oe=69D8D822"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
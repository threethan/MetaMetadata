4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM-T9_NyOk0Q7kNvwH-ycei&_nc_oc=AdojK2nIafppQfmV5AgX7qOJvsCHwdtTWOm0McO5u2UUjB9XpHagaZ0rqHQOSSpcOtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FVX5vK7Mevp7uTvhfcb7N1tnGVG5XLC-44nipRIFagA&oe=6A3FC2C0"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkmVnwV3oYwQ7kNvwHe_d3x&_nc_oc=AdrT5jhj5oC964aF9G1igJtNTqbV1-433x3YRsas4TUXARNGDYLDgQudxJeCnrgSlmo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fz7hJTAc0VP8lDiu3eqOTF0LEozZW8hCc_rrWE6l-Ow&oe=6A3FE8AE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umNf5olwYIUQ7kNvwHlpDBl&_nc_oc=Adp4xxDlW_gJF-Z-8paiHsNNA2cVAIIe9dgYyMPMaKWpzMFCnDEalkdxxnzvQGef0jg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bU-M5izbYzONh6H5YcjK-kDPlLUISmJwJWoHsaKKFpg&oe=6A3FEFE3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kz-QpyGh7_UQ7kNvwEQGHkM&_nc_oc=AdooYvBq7mI5ZCoPBqFF5kPtWPnQrubj-OYVLq7ykVYad-7H30mpEk5G6Q5KCr3xSAc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XRcMlX4Q79cjpMTH148xUDkMNffGasiquZVW9pOku8g&oe=6A3FECDE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sR0o8sKo9lgQ7kNvwGnVuuk&_nc_oc=AdrDuBTLgFKq8L-POXRYhksQJVKU-7_BSehGkb2IiykCEdOaeLTB4gPu1mZn0vo4pBw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QPv2RLm1q7mvUU5RDUCiaR1PxKRhaDjGbb86ax6NqVQ&oe=6A3FE562"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
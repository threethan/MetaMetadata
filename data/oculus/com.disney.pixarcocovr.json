4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Czf-v3yTs4sQ7kNvwFOW859&_nc_oc=AdrS_VbQzlsUYke_rXvquyR6vGzOT49N2rlbbUDvuoPl_5R0nFa3rBNI82SkFM7wE4c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA6oliE61ncDkMu4ahoOQXSuQUiOwxqd3q1hm1PMx-Cw&oe=6ABA5E40"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9grEGTEWdgcQ7kNvwFqG3MQ&_nc_oc=AdomCxTPO5CnbpNggzSyyNWEWAUZf5nqs9eJKz7MBOsFMr7h3_1qDfbUF1nq_rGHjyI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIayrK75E_qTrC_aCEGffX8MM8bkNF4a96BNWrLkri9cQ&oe=6ABA842E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-naYjiMG_DMQ7kNvwFN6AcY&_nc_oc=AdohSBTV2ennuYoDqM_BrjdzaW_UYoatT5oEFOg6xuRcLMTxg4AhDO6ei2L2ahfHtPo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjE7Y3JC790T3SkPy3Vg2RWXq1NhjedGowNihB1WS_cg&oe=6ABA8B63"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQZ7ZZIxjUcQ7kNvwFOm1eH&_nc_oc=Ado0AqXJQS38hp38iDfyJtOjhGPXxaaeotZVRnj4bvfrRIGsHlPQvzLsOaxEbGVjKdY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB3jdT_AyPASSzYzxtDXhCHFIP7GDry1LnAnDBCIuiKQ&oe=6ABA885E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox43DZenHGIQ7kNvwFebNK_&_nc_oc=AdqNQ90sNqnlZb6Hs8PAfmCEQc-VbWYs9RcsBr6QtD0-YTCH034pxzQ0Bk3eO6d-qE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJozBRHWQwH8nhTcPe5gtX-uLt28DPg_CVPZ138fzfsfg&oe=6ABA80E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eriEba_NxisQ7kNvwGkhHjG&_nc_oc=AdpLzc4JtaOChMq2Y-ZLtX6xVLqYp1zHdhKYVFtg60LZQqpG3dnW94NWg0huWAXuVDE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF2yLEd_CVRqS5eDNRyekqZ3DYq1xFpZIWnAwc5cP1Og&oe=6A9C4400"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkqFoZw0KgEQ7kNvwFhp9xW&_nc_oc=AdoRSlu1LuG4xhEHk4622TqQ2U22NokbV-2KJHS7xkU7FpLtW40UrH3L-rOT4zftshw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8973CqpAgNumdbvUMZgkSdxDvPDX8t0IfNp90P3xpbg&oe=6A9C31AE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zUbB6IC9xyAQ7kNvwFESOz_&_nc_oc=Adr_G-0VP_LY4ruSFk8XQdusBjD8rKP7HWggJ5l4PAO-7wzBC7K3NkljLjy5segbiFc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLj7GjV8w5Jna775hh-Up1GUkcYwukIJrJBs1_LOqYSzg&oe=6A9C38E3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OKSgRP-T5ngQ7kNvwEZsBbN&_nc_oc=AdpHmkOqIKESDgl5aRVhKXl33AJUMJLgoIPt_XRKXbyMCzwqGzULt-nGjOVhmsosxpI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKh4NqKoHOnkxCc4m-7zQmzGhTUdtIr8H8t9lmkX7L1KA&oe=6A9C35DE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07tKpnTfBc4Q7kNvwFrhhIJ&_nc_oc=Adry6BNTQjek8l-4iRnak61Zks8sqhfc6d-zdkOPN3ot-4-0B1HyMEj8YlPAAzVV1c4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPoO0zE_uC0YSGnTKLyJ6iPxJDW9UF-2S-Oq7Z5dz7zg&oe=6A9C2E62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
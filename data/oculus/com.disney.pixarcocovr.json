4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPdlnIRUaqwQ7kNvwGT7cyX&_nc_oc=AdrmFsKUmaHNja3ySdPbpUuuRf1TvjP2GSCZb7zYPmEYAWHwphMH15aNxf_9Y0lqL6w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBv6T0nGAuhdV_TwDcCeBSHkLChmDinsdYCzPc6Rj_QQ&oe=6A99A100"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkqFoZw0KgEQ7kNvwGq3hl7&_nc_oc=Adpkm-FrDVUaRoCRaT7mdW2YBNzvzD70fjbcjG-LqnQdi8AoflMuKXljmmj_K74YW3o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBQQBgS_qnjXpCmQuZIWwz2PPNzAs4bbNQJ-OsRMg7ag&oe=6A998EAE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8m784ClChPsQ7kNvwEvlah1&_nc_oc=Adp6N6OopERO3tIVz5eCZIPGxdi2P4bcS_Sf4yPkMBVWnaSJJrt9LsG-nmTuWOxx3T0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL61YBHi5UiGC_Mray3wAcUFlImJC3SOLrSHAPrl48dHA&oe=6A9995E3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmcWbLmkyJIQ7kNvwEEGd3p&_nc_oc=Adqc_yiSh7V-IaJbDYrtslpO49tT3wKZ9oebjQpoiEtQ9EeX_zE-UfilzlQTZ-BE1Sw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlMBThtJAP_-YZSDxEDW4teNBVbX_wl4VVp3MYz3-Wwg&oe=6A9992DE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFh8YR0grfMQ7kNvwH6DFCq&_nc_oc=AdqXAd2FhgT2wZqypeM8XLkjBWbeBRAfmLAWSpFzVdNVtH96bwzXpodVNdaG3UVqb6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJocXu_iWXLSHWgLYWe5cbBgMsv91sgE4vSdq7U_XFtQA&oe=6A998B62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
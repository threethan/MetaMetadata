4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tPdlnIRUaqwQ7kNvwG3zcSs&_nc_oc=Adoup19GOfvFn9ek4Vy2YNDpWb-LaBDqFoM1uW4j1vPTWpM8SonMBZWjKU_4nmYyNBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDMPvGINgC0U1ep563cb1ApWIQ2Z7QnMV7YZMiT2syEQ&oe=6A984F80"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5pGq3W3vfLAQ7kNvwHW6qJ9&_nc_oc=Ado_w32WcYYr9duyLkpKsSFN8uIzO1b1bP5qzGR5ai2xGCiNc_kYPPbx9cEIsPnkg7s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfYdwXap4tbYSlHbIqMIL2oN7_2TDI82Q13pNIw4AV9g&oe=6A983D2E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8m784ClChPsQ7kNvwEveJl-&_nc_oc=AdqjLaAhalk1RFm98kqDblj40jxNuN8ksGpDhtDoNn_lfXDJ5tS4MgQdFuHm85YQkuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvuQ0uKhnUS_Zm7GW9KergYVKMevaJr0nFBYNY2MuxFA&oe=6A984463"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmcWbLmkyJIQ7kNvwHsoWRF&_nc_oc=AdrUsGjrCUnQhNHtSAhkZJeqHISGKLEgL-EsDG5LbcvwD73AEpw_v9tCuy_NQOkMHWI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8zHSyyQnoOGNQZBc4rBHd44Vvlc4aimQlTfac87QJow&oe=6A98415E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFh8YR0grfMQ7kNvwEZoiCC&_nc_oc=Adpgo90MoGR3c7greB1NTkuENwtQK-KbvvqZUZ0IXX0_SaaflxIWlcW3p5mYlDt-bm8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOSZAfrTJXBuxbvcI7_GNvd2VBjcxR4y6GJxzq5d9qug&oe=6A9839E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
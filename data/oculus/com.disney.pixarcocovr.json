4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajYUNT1wIcYQ7kNvwHb3emK&_nc_oc=AdoBYPaBCzrvwSfAKZligG5gBoZx1o6fsqWxt7qk4mcmBkqX1WEoZ0wkP0hXIrucvL8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8nN-3_8WuHDvFOc6zv7wksaL6ZTsVIlZjBFnONLeMyw&oe=6AB123C0"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhfhYvv2t90Q7kNvwE-5DTU&_nc_oc=AdpXCQ4w6qVOMLZcT_E9LAmMot2pych8QC5JdFpuwBSNfCL3HTHm5omUS5aSYAlfLmE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpQy2pHaqZexCxOCedorEy4keQxTuKJANkJ0wjF_h7Qg&oe=6AB149AE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1TFDg1EIrRYQ7kNvwH6Njp6&_nc_oc=AdpuQe6w1dKLPqCDi1L2yKgCGA6x8-_pLr3twK9smoLkADFOHHIl7dKP4sfNB4cb47E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRrVvoHtTv53FMq85PN-SclXDuRZQqIVAc5Y-fPMgTsw&oe=6AB150E3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpXbuxHQS-8Q7kNvwH8B6Us&_nc_oc=Adopta1JKFb5BE-3u6BUequCtqswq9DuK53Tz8DXxEWFf0SQxWx4bXBPBfShlrrjQYw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeSW9Hcd3om_CJl5_4Pt4EsYRv--8E4f70qRTtp3waiw&oe=6AB14DDE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HtPTjmLmi1wQ7kNvwHhVKEm&_nc_oc=Adrx6W6pj5QKZOU8PHiqJy3GRwRpOMt3Ul1ZRLA0CYKiO_LBvdBSQOEJ87AnxwXig_Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIImtkp41o2GXm2SDzsp1iXQbA8ZI1LRwi69dj-yE_qjg&oe=6AB14662"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
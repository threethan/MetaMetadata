4.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYAgHj3CE0kQ7kNvwHjH6gV&_nc_oc=Adp2HqpyGW2-Fa155mAfHQcAhxBe19cvM2tiUA9VsUuIrmdStvQTOry9JnsK2qau02g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTihH-sdUJcZ1h347aBiYLAfJlI-Rme5BuLKyVOYk3ZyA&oe=6AFB1A62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": 
4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2T0JD8Yty2gQ7kNvwGc8pOF&_nc_oc=AdoSfNfLyhRd4d_RoDkcwBVpcrzkxvwYCjbLMmtdK2Bzv_tIqtkWILFwSA5K5Yjav1U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83ELlQiOqpOBzH3vfvz_mIqoJIjlz_tFSgTKdPiND2Bw&oe=6A3293C0"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssYVbswde_cQ7kNvwGhAtR2&_nc_oc=AdqyA_C_AgEAVdh4oXWaXARZr5LnawIgP4JCfwduFs5IzfJeaXdP2jYm3-xoBnKl7cc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q0Xxrq9TeYPXXgE9FVWGZkTWobVhTscc4htjRlOnmHw&oe=6A32B9AE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhStKG6JKcIQ7kNvwFp_h3I&_nc_oc=Adp5_wTd4L7wt8nMNuh-jTPMfIbsm6uqbDX6WeGJSUgUWOpf6Q8FTEF0pcARnsIqaEU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tAhNIj1wlMP6SQrSSp_XFsC0JlbM1zqB58MIlPzPbzw&oe=6A32C0E3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lei0Vc84cLUQ7kNvwFOdIdr&_nc_oc=AdoSlMN8MxV_rkAZPBloBNyVjJtivUpBTxW3RHpjygcWu0TAmM9D11OkSYOgPMKQFu4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PHagn5vzHiFs0ap_kRAcAUAHOVXa4gMrBYrmTvZ6PVg&oe=6A32BDDE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPBk89_hEfAQ7kNvwHR3XDV&_nc_oc=AdpP5FN6QLRVfzdEXlJ73JUQX3l7DLyRrqA6MuwbfjvFSBJSODPzLeZDfyCySv8NKHc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XLPcjT3ReduLDj29TW7SeG7V2CT-sWalu6KCp3KjqNg&oe=6A32B662"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
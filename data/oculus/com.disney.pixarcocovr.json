4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVUA4B1c7kUQ7kNvwEDZFOO&_nc_oc=AdrzaTXxuMWwleis8xpJbcycSwvBfwimKP5KeZe919qeonZbCD23fYMVyjzu4lyCijQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNR0Omz6UYSrsvCT-GM5KApoqau69GtaEBMpqVvAB2WAQ&oe=6ABFDC80"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhhJJpTZ-_QQ7kNvwGnuGk_&_nc_oc=AdpwvzZLk1UrberxA7gU-l4TAE6qaExuhfRbjTpS7yGrkeZGbdCenhM0UbuYW-pB1O8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhub-TgrdqAbW2xBytvRWs-wAaH9uRldoWwx_PEd1oEw&oe=6ABFCA2E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfxYBRLabxYQ7kNvwHG7iZv&_nc_oc=AdoLT2SM6HPigjtB5q72MwGgGWj6orWZntpZM_6cHHGgLwhfJmhf25Mp2aiU5_EH-Qc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOK0wALt8i-1Ogg7-8ZrZrerU1hqTgvyxw0gt_6jdNgGw&oe=6ABFD163"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dNh87v_nto8Q7kNvwGPGTvt&_nc_oc=AdpVhPCsNi-AXQTdhkaza15jR0V5Mjc6Ld14jT7EZhbC724sj4TY8yXXdY5XrlLvkpY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvE84njQMeORTy4bUw0AT4vw41AO4wLO3aLY26VNyadQ&oe=6ABFCE5E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VYtJxOWOwAQ7kNvwE4k729&_nc_oc=AdpjaYCgi7S-C81kVS1uzTZB8E7q80mKQ5S51QRhJ-5DBcstITz9G0h__tvlGtc12Q8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6ZOuYtaRluroReUWIh61vPHQOhAz9u-Y7cn9lY6czhw&oe=6ABFC6E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
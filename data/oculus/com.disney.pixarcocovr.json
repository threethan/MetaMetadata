4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsEWZlj7Rr4Q7kNvwHSguFQ&_nc_oc=AdphKAiNQv9bxSfVSueS-M0vE76xwzyJ1PmCokXD2Gh0fwmy_IQpYQPjAYHCYFHHdDQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkeZBTPX20jSnzzuGLC8j8pYDD6I7D3CdRPSOoOPatFA&oe=6ACE5D00"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPsohkUvZWcQ7kNvwE9dej1&_nc_oc=Ado4ic9HjVgz_WFPcSY6qdl_MucqZJjiLSUFNRb68yz7lsMdIJR-6hEUfGYOy1tca7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfuPkbMKYOTTgBBRGdv0FCQb3DAxcKn-mkjvLRLJO4CA&oe=6ACE4AAE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3riVw11o0UMQ7kNvwGOnNOH&_nc_oc=AdrzDqJMfL7WUMLt5ZLKOYiO4LaneSBnYehkC0ADtjFQ_jY1NeWwLGR1ZXUmYjWLsOY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuW_ZBoeiv5KYtv43XNIYSnT9kl_KLhVoM3GFZlyqt-Q&oe=6ACE51E3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0jtDkLlT2kQ7kNvwFPPnhZ&_nc_oc=Adrcm4I5goCk_97LFb_YUMH042C1-ztZl1o9IUBTy34Drqf-Ieqv8MDv4FhMOysmFS4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNauVY8plQhNflYKVKgb4gqlNppAbGGTdpWq0DQPBHXUA&oe=6ACE4EDE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgbDkruU10QQ7kNvwGF2OBd&_nc_oc=AdpQFSnUCmnywInXSDGONW2r-e0T0fUzM-qvjjl-cfD3SqTQYuiGO33-5w6vxYk_WRg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPIgSK7srQGbVRTB1I332O6VlLyNflSxsnaItyKz9bWGw&oe=6ACE4762"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
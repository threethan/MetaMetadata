4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EReauAwXNIQ7kNvwFE1qsC&_nc_oc=AdpIX_nQBO4cQFq8LFihX6uF08vkiqXtvT27hrGGcV6GaqYsqFpqHsGn_HTAI4Ycg14&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63244yuxLOviM7S_aH4gxFYjjAnqS7GMgioEir1ebZqw&oe=6A0B06C0"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_ji4xXFuu4Q7kNvwFMzK6h&_nc_oc=AdpghvnZNXDebc8_kApB-xBonSyzLouk5GeB50UEOamP_l1Wgi4eKz4PIiAP-YVo8BA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qlsAlRKMt79vIew_u7MmLPZGiW6WtfUqGCOQjlebI7w&oe=6A0B2CAE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDHkiXCq-iYQ7kNvwEYmHMt&_nc_oc=AdrfRvYRIT6JhoGkOZ_YCqUTlebRSbpgk14b8i26pWv6Zp2fo8QuBrJ2o2bgw7mYYo4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4okREKfg9vuNFPY5bJIYHzYIqUQNiH8ah8Aqmrl18p4g&oe=6A0B33E3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=poCAAnmopkUQ7kNvwEVloxO&_nc_oc=Ado32vYud6SSfT-lbKdJYxP1kK5DK0NWwHHruuM9QZfioK3SF-EhJhVAe6XSpQG-ZGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KAwHk5woqO15J7Cyw8_iyo58nPon8b0w9y1H8iejOSw&oe=6A0B30DE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEdnIKXGle0Q7kNvwGuW_qb&_nc_oc=AdoQeoCEUK8a94Ehnz7CRidjTs7HmFPs87Aedb7ukZI_7C0kk1ENLBxSmvMwPKOtRVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ryR4jm-huL1pUm-s0GLmz1sUv1qHi4Nx6GCg6LIf0Tg&oe=6A0B2962"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
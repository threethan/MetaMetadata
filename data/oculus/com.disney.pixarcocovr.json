4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zumdi4EurwsQ7kNvwE-YhE2&_nc_oc=Adq5Vw-miftDLHmLuregwiCzGAO0JUnyRtG8vhjHlUloNzEFRQTAldrx3OLlgmMZdFs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcP3ge4Q2Y_Dara-gUEZMjQk-CgROp_CmhbUOjuKHynA&oe=6A68A140"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ir6UbOHHKO0Q7kNvwGXMPAv&_nc_oc=AdolFrJznbVznaSuPQdYI_u6h0_bBi9kxzVPhBHfLbU8Ca7PBGMWRkJ4SPB9fbqbwH4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG5fiB7TdqT7HIIM7BXup0Snjqz73oM_YSQWqbOGIRaA&oe=6A688EEE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zU467ouXv4UQ7kNvwHE_tQ3&_nc_oc=AdrK0ipakYXMBWt164pPD8FsUg9JS4-BqW2BYFlsldS851rYVB5OragSEMAENSR915E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWPH9d5LM-tzLsjzokL1Q_FkI5FC9KqJnEYGzwrl1CkQ&oe=6A689623"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-AeDf8e19ugQ7kNvwHEsZRT&_nc_oc=Adp6J1CptA5diMbzYGK9YQ69MjLf9adqgzGEvftz1RG97L5OS_4OLdExC85v7r45rGM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyTMSzmFBarrmPt3IH5lFk9B668HN6_ASf4e_NcGQYYA&oe=6A68931E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFRLvx62CxcQ7kNvwFGtVgQ&_nc_oc=AdoHHubs1eTonYRq1Wm89GKtpnfdswboVieh7BhBG4fFHBydDmLDV5o6Ucnooxr9ExE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCniO-f9CYDWV0TMDGliK5Je45PRAAybwetOSiE25eb5A&oe=6A68C3E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-H-pbvfJTEQ7kNvwFQMPY7&_nc_oc=Ado4p9XmW0fJFuJjCK996lT59_0bgf_cO52tzGLjXG233ivRUTjWa5a5DWpUnwkym7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XuYpPvyhg4JUtuYeBUDFM8H-Mga2CAKExaueNpAyzdw&oe=69E0D6C0"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cjQbn4yoXEQ7kNvwE85z6M&_nc_oc=AdoIl4fcSSshyVAlZclpYRj8AXM5fOoA9PEFUnDwIt293gb57GR2EuiZXH9gCK5RGSM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_ZXkC1zYr2BMlsu_bXYuUMvOHOe2a3tmvTAGPPb_UbQ&oe=69E0FCAE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTLgsRAsRvYQ7kNvwGvkLA7&_nc_oc=AdqjijBAq1YNQwnxc4Vn23ED9H-kADEG7uLtLhkBId1kQ4V695gOw2iOi9vyo2lgo7U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TZbEiWTd1qyYk41ph4aSSbrEdR4GkS1oZDBLBdM4NFQ&oe=69E0CBA3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_3SNTyPiwsQ7kNvwGy2Pdy&_nc_oc=Adrs9sYqektvxQ_1oYolw9P0TjcAt0aY8RmZnkzd8aDbPUkX0_cagzle2yFt53zE-1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-65l0Yeh7VpmnSCEwq_WHJR7ed8ZJMhyDsopVekM_dw&oe=69E0C89E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efuRLD-JHt4Q7kNvwFAsUC6&_nc_oc=AdrN2isr6-L2-sLSo3NsuPrr58g2Ze_OGdS87BJOOFo0Cn2gbm3TdhhnDAgmFdfywUo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2s6g5f_-9YcIsp0Ze1MSxDcTWov8NRRF72vVoTooFDag&oe=69E0F962"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
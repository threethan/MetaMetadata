4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogNHhkK2t88Q7kNvwGAlIWf&_nc_oc=AdrMbBE5K7D0IeiKmNjRIiw-n-hvUEJF5dlSfEiKcz3mfnR_KMLu8nOKXBy3cf2v4Jo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUtoIdlQVU2Ktnj6hlrArjkgLFlkGrxWKDIg4Sg3BEGA&oe=6A92D140"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j6YJaFaMXEwQ7kNvwEM74wn&_nc_oc=AdooCIWq1CwZRLO_ppONdiH6ytBkJ_MAA_H7JhuEvXViYVrY4HXJq48RPde49QDFwSM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJD3QWaCw4fgqzQjNlyODAz_S30_Xz9AtqJr67rgtYtA&oe=6A92BEEE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EXb92Lj3IKUQ7kNvwEDi2R-&_nc_oc=AdqQ-eC9mjamxQtRGSm7eAkAtQMCyK1KL9ZE6-A94Hd5zTx4rFSyUS6T5rJ-5XG-2vc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxWnT1OSNQm05EDzPP2l-LhhIgUA3kh64WEwihXlaUdg&oe=6A92C623"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZZchfvboZ0Q7kNvwF2RFrw&_nc_oc=Adq27T6E-wkhXs1GNm-UK0ZVR_uKE5fjJaQiEduFhGYpKzydSd0VPP8cO987jqqZG6c&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqWCUvb5kbZlVyGQRA46e8fWC6Xa8WjrfgHxeHpV5-uA&oe=6A92C31E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWAv5XsUvhwQ7kNvwEnzN9L&_nc_oc=AdpZX3quHqDpZACcqqLlZUztDn-d3KPRaakkbOQqyFKQDtBAFuEYnJMb3smxxsFzxA8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo-J0x6gU0dmSy2-7XAvuUYl2QQrsxqFNpSUEAZHrM3Q&oe=6A92BBA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
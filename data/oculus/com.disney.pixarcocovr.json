4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1apOOqOgXIMQ7kNvwF7J5ol&_nc_oc=Adoij9wy85hF_M5KQ6GHvVKMhdKhcevFblz6m67Zl93Sj11A3v0ZW6nA0N7zYmmAZYY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV2DWmspHar0OgBP8BZcWDy0z9LRhKnknXK60JMjIVSg&oe=69C52740"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ib55BaIn2AQ7kNvwEvvkNc&_nc_oc=AdqZ2hBLYi1P-JLmvb0E81m97yX0Qv92zr4TNXQmDqbbLon6Dy3CdukknchReHF3m4s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwReSsS3pVoR7mntlLIfE4uQL4Y3E9gKmKNGkWtHae8ag&oe=69C514EE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdVz_2ioOq0Q7kNvwFNRLE9&_nc_oc=AdqhDqg6yZxBGcziOaW0p69JfCy3V3IOwdglwMf5koL0ruji7nutG4e2Insl6Z26l7w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyKcWxJ1UMiIO31Q6IQvzJ_HBWroxTdjQQ6p4ChE4iTNg&oe=69C51C23"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ureRen9WzEkQ7kNvwEfuqKO&_nc_oc=AdovCSjC2qgGUo6sYnb44rorgBNenfhcK0Fhw_VIMU7IqG4bC3Ls9B-RIjMtilvFDKg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKAPrhFxz2wO68KPpbLRu5EWYwKT_1wquE2bz01hRTbg&oe=69C5191E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-eQZ7FfGsIQ7kNvwEeSpVQ&_nc_oc=AdpYw2b5WfvB7LTtri-sr90oZ4BD7knePhUecnGTTuahe6zz8JYvgooz8rBDWunBQZI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQFUF-QQ8H6R-r4W0FuS6OX9NN9ePT6DVjpvOAg7y2zg&oe=69C511A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woFjzgQQk2MQ7kNvwFLN1qT&_nc_oc=Adrcll4_6uXOHgoChlTeaqiBcUt_Y-mSykGNcbAgFVZU8Zk9ZKuWqwGy7gcEmjD24Xo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RVdvfZ9bwcS5_j6ROl-rNYAsL6_08BkFLsSeFxA3JAg&oe=69FB34C0"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jp9pMJkR-IQQ7kNvwGZjsQX&_nc_oc=Adr20pUU4cFChGQWhEh9wgPdh7FI-4rcoTNB56daC7X_G0aPwfx4SnHwRtuIfpOgN-I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DULrntHpg1L5KJomF9DRTWys3mTXudTwyjpKs65yGMQ&oe=69FB5AAE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KYIZBoW84AQ7kNvwFnHJ44&_nc_oc=Adolz89vA2-3C2qKZ_4HN7KaU9vaeI0_dWwuEqLEN-mvatUB4L-EiEXCFtgxvrxRkwM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68aT805k65ZLVu3d1Xs8mtQSIZovcgtisuVlH9lpCO7g&oe=69FB29A3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ssjpH1Vn_08Q7kNvwGopoMU&_nc_oc=AdoBExN5F9SkzCI4nQmDJpc-5_KBdLHu5QPVS0E8Lhrv8hij0mong2SkGf2E9C1EADY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cGHOcrK4R8tyFwaybT3phPT-dwJrzXOMM8y81Ha7_vg&oe=69FB5EDE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3emhL6qprlYQ7kNvwFY8W6o&_nc_oc=AdpiprGVC1NmJq41PHXDWYd16OTV_h_QQvYFqIUloes48IGA73wNzNTKOqekwlbZZXg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l6DPE30RWylq7DSZpeqdqIApFmJxP_GCJNs8uBeE3vQ&oe=69FB5762"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Akfed904MdcQ7kNvwHzdibY&_nc_oc=AdoieIcrOAB3kvpQSbMF3vvNDRg3tfmD56mmGJZBQde6ty1DqjcDNFj-zfnuDLezGAs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1n9j7vrHxDlQVCYhjMydvIILV2aIS_gvlQ_wGJ0ZTgkw&oe=69DCE240"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2o-yZsoPFEQ7kNvwG4_aew&_nc_oc=AdqCOt0nyWqXegZMGpi5GOlIrnNMYRgcXJWLsBc1120xH8o6DSDoPx2IIh8wiuZmwyw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18CTHtQmFa_IX58Ugwz3IHvplTKoV03NNXGDTldTJ44w&oe=69DCCFEE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7WxVR7fWTYQ7kNvwEZu8iM&_nc_oc=AdpLNXBFU087LgmzTZBbX_b1kVmvzcPD5G8h8P_Rz-icjoqKHNbTfEC00CbtTyXJjwM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XqtG0JYjyE6PVtfjYfBjRS4HvE6vGoeTqXlSy7GuwwQ&oe=69DCD723"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzFBf7Ad0XAQ7kNvwEZOKG9&_nc_oc=Adoo0PlNyvLVTWfbfHV2df0Vib7iLrjtjkn39VRFkaAsOiWg_YE-BEvIsKiix68XdQM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Kc2sCxseRSaoON4pWz2QYNZjWY5KLCsNwM1Kh3ggpXw&oe=69DCD41E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=smeke2mpXaMQ7kNvwHVm-dz&_nc_oc=Adqah3wCaCnkas19C7vCsdt4JoqOqhyU0MNacbBcGmd2c8SigGR4_oOMCh9eRQYP6q4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BP6zeOQsrtDbIoIC6cNjHmBm5kpr7NKph2tgoyGjiKw&oe=69DCCCA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
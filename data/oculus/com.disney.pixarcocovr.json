4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-H-pbvfJTEQ7kNvwFcMiOd&_nc_oc=AdpzHa0E5Z-ktfJA_jf7qg-rMsO9kkt-MkLMDEumb9aqFDvI9G_HVEKs6yKXVCE470E&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CL4pYwRKUZEoQjHzbzKJbjA7_AFHxnk27IdxUuCLD-g&oe=69E22840"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cjQbn4yoXEQ7kNvwGkkPgE&_nc_oc=AdrwabJmy5t1rqrw1nqay7hirE3JF2CrFtCkWI8J4efuRhLcIAMKd-hIEnDF9BfhseA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1scN_-WlUDE22-2imKrd3J_Spwx4X4mPJ_GPi4g9U7rQ&oe=69E24E2E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTLgsRAsRvYQ7kNvwEHrBzi&_nc_oc=AdrDjC90GDRjfbyJ7Tl5VcK9J4xFNjrwOcacOLGPyZubJ_B5hfyiHpp2iJYAg5xbkyM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q-rl4tlfkb8XwxuqXxcZ4Ex_cGY6pOxNQtvkN-sJhbA&oe=69E21D23"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V_3SNTyPiwsQ7kNvwGWfj7U&_nc_oc=Adq8P2GIIae4RK-eO4ogWkXAV865KYszz7lF_LDc_4OYSbclTuJFLGBaZ_-1nJe1OCU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0teR4050TQ-pETAxVWM35Stxn5TgyphewUD2szFSYTGA&oe=69E21A1E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQj1OPeNkO4Q7kNvwEDdJrr&_nc_oc=AdrLxy1MY2PZmGZVETrgjrmwvRX09PQET63tHzH4d0vqlw-jR0wK_md8rJhRQ-BNCpw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pRuFv3jnUdkSgRWcuU21YLCu_EZQw7qwWdtXK8GY3cA&oe=69E24AE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
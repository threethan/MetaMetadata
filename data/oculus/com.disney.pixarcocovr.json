7244800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kHpVdvQITEQ7kNvwEPp1zA&_nc_oc=AdrAihDp9ZKplB-NPINDsGFMQi-c8hIDYmFHFtoVnguaozVjigsLRCXnIHk6fo-HMFU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OjbRHMv3NLDLQQmuDnE8iyAvyvqWAqPaX40kwB-zfKw&oe=6A22FA00"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGIqFTDfCSUQ7kNvwF0eOBO&_nc_oc=AdpVO6g-amWVmmSP3vDatxOU8BQKiC7ELv2vE4ejzxA0PGsTWZ6xtx-mx4saTRn07gY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BOjGVx5FY1U2VGmSFvj_D6KhRhN4h8kvmTuvmwn99xg&oe=6A22E7AE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej0sTnsp2jQQ7kNvwGcKIRo&_nc_oc=Adqn4i8i5nFeDHAzHjT8QwJL5ejMMUM5gOyPvmbz8G8ahig2DiwxPuPdJc-nT8qze2g&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AnVFyQNkXFE4w_VOSzvApJF4j_VKaF0ohXM3SpdLDvw&oe=6A22EEE3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDRfDbc3cnUQ7kNvwFDbXZr&_nc_oc=AdoHQgQAuEHUYoxRefkGctWHPrimsl6Vpu0G3oVZiF73PTuFMv8yoiCq-uvt0A3rius&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9QSPVtM33v5AWputdatmqfHBvSjhPYlRS_lOW25S0nHg&oe=6A22EBDE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRW9rowSHkMQ7kNvwG61OHi&_nc_oc=AdrVHmpRbOjiFxLLizEnBfd03oJrB0NDGv_tcFCMApxubCOmDkx4rFebgl-v7VVEf6s&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9u7ItRaWOuzU78UQdApZo-s-40v5dVq3CrZ08QkMCnLg&oe=6A22E462"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "sup
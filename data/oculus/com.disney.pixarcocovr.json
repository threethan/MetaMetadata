4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6prK69Y250Q7kNvwEVwIc8&_nc_oc=AdriRDf7A0Bk-sjHPsQRyDa0zv8AT_IuUJTqHGGdPLd-2c3xhaQDADq6jRiNq5LvRhI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbAmR3VBX7Za1ys_YrsBJNzKzfHQOzpc1-t-6bn2wbmQ&oe=6A50E640"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRN4HS8XngsQ7kNvwGVjPjS&_nc_oc=AdrsZlk2ZFXceTrMGAJvfMuwtHAEDMCEwXb-N2MT_TsklJPFzxVyitrWlM9SGRncR0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHE9NQ8wf-5S2XgETnMXdfM42fSVXdBg74-o25SvUOGQ&oe=6A510C2E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxmZwIJuKoIQ7kNvwF4qwe9&_nc_oc=AdrzYTq_Yz7yifXvzQiPjP6iLEceiU-gZTTCxCUoM9W_faJHkTTPi0iV38xHhxijT5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn1QFGIacH8QNLopNbr9VeEaeg1E6pdfcNM7f_F7Ky3g&oe=6A511363"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rzcLOFrHlYkQ7kNvwFlXL8l&_nc_oc=AdqhSl0t8jxKIubr1nBfTmWRujudI9aHpVao5-T13HQ6R98ebhdmSdDu6l9FjqVAUCo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBJjYhtFwDsqTXWOqtni3wPC_Qr1ro5iw-osiHLb2qGA&oe=6A51105E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0s8feXAM_UEQ7kNvwHClYor&_nc_oc=AdpydV9a8LYjpc6N0Ia21cP0o8oF19vAnIkyTSAweMNbzQoKTI-8qntuPyl7W0Jem7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDY9-jIGeO-XreafEm7v4xAvaM0v8o6M8ArzXxvd5SFAQ&oe=6A5108E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
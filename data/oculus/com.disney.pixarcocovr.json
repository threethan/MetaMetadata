=00_AfvpiN0HhvLt0YGNfuapsvFK9t0t0UVFPXT4ceCkQM932w&oe=699C3A9E"}, {"file_name": "migrated_image.png", "id": "247096786454689", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VNuxflMG7GUQ7kNvwHDqDef&_nc_oc=AdnA4zRV-Npq9kNSTkeKUhZOb2t3Xi4emcOsAirHyvPQbdBObJ-1SXi3dHUKlgGZPds&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afv7ljN0iDn0b03KnwLkupAtEA026yobrtWeiFhhVTJy2A&oe=699C3322"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coco_video_7.png", "id": "138276410159384", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162696_138276413492717_1494748721810767872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c6iGo--Wp2YQ7kNvwE4zITO&_nc_oc=Adnhwl-vlIXuDHk5YZJ8ZpfQmJ7xQtlWI6BpjrJBla1MkmeQU2L0oBYPhf6MUJ_slVs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvuehO1skihGu_CvDhxBnmnEX8jbkT-ir27XCnDLiT7lQ&oe=699C5F6D"}, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco, coming to theaters November 22.  \n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "develop
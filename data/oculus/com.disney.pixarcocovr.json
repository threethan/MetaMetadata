4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sc440hxXuUoQ7kNvwGY0im1&_nc_oc=AdqYA0D_X_ndGEbDemyHDK2cqkb6Kp_3L63KyWc8MykFvFGltF0XpiDKYB010S76vOY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRiQNuYp3XVK7dtVQXwoNoUqIZX2zaOdU2FdGCnSzfyQ&oe=6AEE0100"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAQwIcwkrt4Q7kNvwGKWOgB&_nc_oc=Adps3qjJXZ2VjwyLuOOxWiSYVMBKmuRxOFy6RfoocLFAd7EkWQ77sWmuU2nKQ7joNWk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXM7rIez7sEuWwejtpJ82EaVg7VOZm-5LMujpT4_SjxA&oe=6AEDEEAE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCJnpf2C6I8Q7kNvwHR5Px9&_nc_oc=AdoEvOO0kuqZRNgPbQbVWVk56I4z3HRvJgq6RWewTLEn0ALFxuMeZEEY-mcreCYhYuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSp1h1x7svumV6XhGu-d2YCNExev5HbawDrnmPZ1KByIg&oe=6AEDF5E3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8xaKCo6j3QQ7kNvwF2_rZ4&_nc_oc=AdrUGWBczTAQB5ey3SWifkRom9fAgq9L6AB4S-fixSc8d39K-2r745OHAj9ugbVSBW4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD0y7FW1-GvGov1ykQ0VM6cmvgrXkq3QFUl9gnsj3GyQ&oe=6AEDF2DE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dkCV3Evmu8YQ7kNvwHS_uF0&_nc_oc=AdpipMgLNvl_AvTL9UPkLvP6396nxEGNzX0thuPXjQOi8gRgOeAGyKShrvoX7_SvJa4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA6XkX-EkN6V2T5qdfcHW8ZJ0s0Uzlj2qJpbiUgMUwFA&oe=6AEDEB62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2JyQ2VKxSVsQ7kNvwF2vZZx&_nc_oc=AdqtGE6KCa-vBmjECdTa1Icioz52KCagSupvkhZ2nKrWWltIv6L0_bTU1DwJ0avl6mQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAPB4s7RPRLRO7RYtbkyGCsO08QJeUysIG2GN4WHVGRg&oe=6AB90CC0"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9grEGTEWdgcQ7kNvwEs7OW1&_nc_oc=AdqV8x6xuYpsIkubskE7DO7nyV17rax4T6ns4KS4X8W7S1_Q0ZxMlx9K8jSFOU5JrZk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkTiBNUMffVX9OO9ztO4n9XRYBZxcPs7WZaJRoF7s03Q&oe=6AB932AE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkO9uglV9qgQ7kNvwHQ0btd&_nc_oc=AdojyO6-m9OM_mhmyKMrNBfj1ZsX7Cy84mDdmJVVFR4pJez98POazzeJ2ptq8bgMRz4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPfo9eKKR6F9YnTBZx1rPk3wi_rcEiZj33nmJMZIooJw&oe=6AB939E3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0UHZhXWckcQ7kNvwGKSxsz&_nc_oc=Adp2YLKAes16DJppp3jPWytFT0RXWQol_yHi99zqJXen8k4IqbB4YiZS6W8P8GzZpwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4tDqS1iKhtfk-44EDx0rdJD-_DGMnV22CldCHE54BNA&oe=6AB936DE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox43DZenHGIQ7kNvwFUXHT1&_nc_oc=Adr117TnyIJ4X2z3qMxTkkZw3Dy5yhIjjeiAZJVyDJI-oIc3VzK6NWTOsWEgJdCyOp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0RHfb9ZcIm9sgJyFLIisV-cQAr81mJiQm5a0oMtxWrg&oe=6AB92F62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pqJMbGaTfVgQ7kNvwF9mt5p&_nc_oc=AdqcoDSY6mwsKfeb_TwaZZuiHCzs_4FSn2P4YY2dDLFqPZOpDm9S0oU7fr-MCg5jFDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0qeOAKS8T1uq4EqdVYUcoXIxcycsh7xBEdf57o63GIw&oe=6AD25180"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzakvLO0oJYQ7kNvwFvVaQW&_nc_oc=AdqiYCFBI3b5EiKTnHEgJ7_fJh9RYlHd5hb-UB1doLlzau5nT6gV68Aqdhm-DPNKJhc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTL2GAeXhPu_kDW79eL3kWr4ymUMOB8QOnAyDw8MjvdA&oe=6AD23F2E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5kIQ2pMgQgQ7kNvwGnds3e&_nc_oc=AdrI-xETH2VQhI7M08BUvG81vMbRiq4Rx2hPPjkqu6oEatBjJ5ublb0wIeZtLc_PRp8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjdn0WFifJQlEA1NqnLdph9LwVznGjQ07ovzpAMRF4fw&oe=6AD24663"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OGw3kl731yAQ7kNvwHv68Cv&_nc_oc=Adpj-ICMBEBlDn8Yp29O7fKL_ddid4qNaz4eyH4XwX5U8_pE-J6tyUCSJjaQMI5Rvuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMg909Ffg9LGY-0N47MlYK5-IGRymASRnHG7vw7jvVj4Q&oe=6AD2435E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EDkfd40ZHGoQ7kNvwGFBlsk&_nc_oc=AdrBzzl6HDY39H9LuSRQLa2ESe1iJ21L1o_fXJ4izneT-boyiIdP2cPWnDEMRqd-WU4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1IdoYQvYUiWoOXSsCx56DSyFmXUYdJXsU810PkgCfOw&oe=6AD23BE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
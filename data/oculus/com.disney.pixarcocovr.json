4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CADp7cKHFzsQ7kNvwF2mMEB&_nc_oc=Adr4OHSFGNeEpeiEUnoVv-s074CvvQnSnKNqtNelGcquOIgAp5XV_OhhB2CF3BNtuwM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJte9jS2m2b9leVRzfuSHbAZqfE_NEBEKrGj20h62KwA&oe=6AE1EB40"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiZZ8PAl8RoQ7kNvwGuddc_&_nc_oc=Adqgelh_Nd7tRvqYPeURu4fqnBg4rg4gMze1Ywfg5gnPRvXeg43rljnT7s5mHYkUWl4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQjVYqfD5OtpU7ANRFf4DWs9BPEYnjZ8RCYZ7fl12FNg&oe=6AE2112E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dly_rddk6ZIQ7kNvwEx-Gq-&_nc_oc=Ado2ALxlRR4g_xfiXEeWDn_whMyc_TOeuAAuzVIFC-uk-DaGaQYhMmJ3UEmaJAHre3A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPnSf0Tkq_svrWjH6DFk1Pq5fIEXJjnlokv6yY6xFYLlw&oe=6AE21863"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlIjx9zOR-0Q7kNvwHyHMab&_nc_oc=AdqZhOCTHmCz4_PKTKY2_viB2tpgw2CIDNYxPsuF_Q6YsRThjuKvOro6AEUOM1euDFU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-NVo0M25ExNRo2z9toYROKEdZLMqk_zqvXTerGqapqQ&oe=6AE2155E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3NH_epaC9QQ7kNvwGTCiv4&_nc_oc=Adp7QRU9j1yzC5KnFHhXaULStafCP6F897u174B261wwyUHneBOVG99BVpTbKn9xPgA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnc0kIxRJPYH04OULmNtjNewezMtUQIYPwp9IMzqOnLQ&oe=6AE20DE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
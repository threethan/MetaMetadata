4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCjk6Uxot04Q7kNvwGz0JzC&_nc_oc=AdqozVJR1Rwc6pAWZCNasheCfjU8QyDXhsWXlnbTxkTliKb7Hv471BrOfkTwQ6XiRWw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEquJ73z9PRr9gtAvLccb7yZooNQBpHwMKS0G1cl33yw&oe=6A8AE840"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dyyqKhWeeCoQ7kNvwFAknE-&_nc_oc=AdqR_m7NWpaSiqXD9-JK1_qG9t0zY4_P0lo5bmxEHaDFIynv6P-YPiILP_skAOcQYyM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6f1uRTFhlVW41tIfVF5Vwltalqo-8Di1qI1zqsbhVXw&oe=6A8AD5EE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PP8pKDzUyS4Q7kNvwGsgX7i&_nc_oc=AdoRMLexC3H9n59wANAFzvu4aqRg017p4e79PX6nJjHtQVCsMpcfPV-lLQsM3c7Pkuk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR28dRsN4wZEe_iIoKgzeGt8FLmVL2urHPRC6rbIHgrA&oe=6A8ADD23"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCPbmNqtBWwQ7kNvwEo5d4D&_nc_oc=AdpGoLjXIAyNncagi3cLz1-MefA5rnGRvo2nMErsMbgzQsl74wrhyeVJ7DB6KEpCb04&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhiIEe40vEa3heUQu50oMjMe_KMOQnf9Nm5rUmwjaJnA&oe=6A8ADA1E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XPwXhcfFmKEQ7kNvwG5W8QL&_nc_oc=AdpWYfNNok5qiPrbYovWWuJ8-nqGv8_Vc0_gQ6HHLqPqg_TmGANb_RZHN5QDiXnVacQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErcXzDiPiPA_kKqDrqMhcf29uDVuLwqE86QPPl9tlJtg&oe=6A8AD2A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
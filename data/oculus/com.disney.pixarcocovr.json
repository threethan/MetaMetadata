4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqWg-wUeHAEQ7kNvwFLqyze&_nc_oc=AdpUGHbHxiyk-qpDXGAO0rS6M3BvORv3UNEx4a2gKcIlrERBxB6iJuGcBE0vsmpEJNU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBWVNVf7Qv0XteghnImH06mtNRFEk5Jlmfpra3S94Gkw&oe=6AE099C0"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiZZ8PAl8RoQ7kNvwEoPZ9i&_nc_oc=AdqgvgPhaq6ugOOG_WJyjtVajDjClIyB0-ipYH4ekHFUDjh4PP8UrjdYX36-om8Eups&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPB5y8zzNFb7vE5eO1VimTZIbHQxKi15mIDPdyZYlrI3Q&oe=6AE0BFAE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LDYEB2qVlAQ7kNvwFOnM4G&_nc_oc=Adr7n9z39-4aYc0Y5-KtAPYvKmnTbBJcujzjZjLr1nzsrgdufTCZyplnLS6PcN3Kr9A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-gohpCr1SA_I4-ePQ8dXX3LY9NXlvKT0sLtsz6PZ8FQ&oe=6AE0C6E3"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S1YfUVfvAZAQ7kNvwFgU-je&_nc_oc=AdqmmejThxCgWTnDzhJMp6qJfefVLX7Zr7leFXvo09ytKSouOzeiJIzx_Bv28UBe15E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCYZbES7L661wh_MtLkTnmIWJXRjHYTdgNqLpKwAyX3w&oe=6AE0C3DE"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3NH_epaC9QQ7kNvwGdpQJR&_nc_oc=AdqeMs3CCKq8wDFoky2WX_xZUdhrvX91ELWjWDNa8FTt1VbnEiAQ2snFxJgy_0yNY_I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYe54Y1NyeyGKI9_5C9WbKeAgjBJvzvjfSR9qH9E0Ypw&oe=6AE0BC62"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Akfed904MdcQ7kNvwH3jK1Y&_nc_oc=AdpX-S3L47iHAf67KbefDeZounP-uDnjJTw9wS5u3_FYRkh2dBNeFweaeLzf7hcIkjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fyVFlOtjONXYmk6F4Tft8hfJGtPSznXsBYkrJNu7skQ&oe=69DF8540"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cjQbn4yoXEQ7kNvwGIKREs&_nc_oc=AdpxtXctSBwq46thRYrw4Ifq8iYhaee3ql2DRsd8SitbpL7CK5ideIOPZmeGCx9qZvY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Gx90FLIZkfyP4lt-1wkVouScbP6N0P39vc7oAn64amw&oe=69DF72EE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w7WxVR7fWTYQ7kNvwEmG-7M&_nc_oc=AdruHHQ88bjZJTfVmPX5A4eEwdFMvsqlHSGnRKV7WY-4D3gbvj-JOrKT6ucJ_-4zhPs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3O-kBvR7nzVfP2o8-5BYRUCMsNE7jGcjlVLjz4WgBbUg&oe=69DF7A23"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzFBf7Ad0XAQ7kNvwFwlO4O&_nc_oc=AdoBHj1Lu_IQ9RITqvLltx25za4qGLxvSWRr18wZ-sc3M0xsJ_IEHBORz3Pf6sQZyQw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hv4mHO8oAdeUPB9vxNTrE0bfxIgNMSb1jidRIa2FJcQ&oe=69DF771E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efuRLD-JHt4Q7kNvwGVEggf&_nc_oc=AdrE90rLGd1a1m60h4et0yhD0enQV7J-pm2ZHukVJKOY-ts7YklQTggyIPe_xYXUpS4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TdUSPEEDlBHk6umBtop5-FrQTvDO2p7cuuLdvb7cubQ&oe=69DF6FA2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
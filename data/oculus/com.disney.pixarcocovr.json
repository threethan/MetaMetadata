4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-5enj4wLEsQ7kNvwFApJNd&_nc_oc=Adr9CqLTnkO5tds9SfRK-XPEIY8i97sE6jnerzQuZZmUMfOdaAp5J8a5Dbiiu9l2QRk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vWMmHkT6YxGRAsAnncV-n1d9fMaEuzZCg2IMDUH-9eA&oe=69D79C40"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nMKdQwAgMNMQ7kNvwEwppoX&_nc_oc=Adpbe1RtQMZUjb1M4ZU7e-UEIKIwhtcAflKfjoZBiCEhR0uknXdTmuPvW_e7OMrjtho&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3KWrXRZSnvBF0PW3B4sDkS5NFKESepVzkjTi2oowCp2Q&oe=69D789EE"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVbZXCvY4ZYQ7kNvwGqbA1f&_nc_oc=Adq_1UnF0pyB9TVQ5AIpvKse99kOZVCBYFi3E4BQA_21H3XGGtfVG7sSUlO41d2AnV8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JiPUMq71uOtvZ-NDnu52X30cOp1uznWIItNgHsXxfqQ&oe=69D79123"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3465tneWaJIQ7kNvwE6oZM_&_nc_oc=Ado3FrVc4K7deabTN1xoXEfV48vzagSo6KXYDGAnAHpkQWM69xespyfLrIIs47ctSR0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2d5JitfWtjdL2Gm9n06jVaFWj6TDD7i5AuYk1A3fCpKQ&oe=69D78E1E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8i_lg5Z_IhcQ7kNvwELXc4F&_nc_oc=Adr7jFjaRWoz-d9APmU5CKCvDW7W_XN7VaP-tiLrNTBMVFz0pPboaDyMzSqEyaUVFqk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lcyDKvSXxG4OenKI_g2DzKIoYH0UmQkmkVq4Dnqoocw&oe=69D786A2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=934SdLZVk8kQ7kNvwE6wbjX&_nc_oc=AdrAfVvAo9yQcePZo4LXJjSesjbTenzN2-cBuK2nMJ3hsVK_Q3SzN5wrK_YQric6yiA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-UulyWc36BtPxh1Ri-s6XBZTolv3vqcja0i2hD3gPJw&oe=6AF1F580"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOnRWStw4kMQ7kNvwHflCUk&_nc_oc=AdqjHQERwa03XIG6wOGKnjOSfZFcu88ut6DyTV-7JonWc1ANVkmn1uFLQBtTVqqa-6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_sCznyqQwoSDYTFfqLH-f8gucyF6-gwuCM_mISvd2Lg&oe=6AF1E32E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUHhe8_5HisQ7kNvwEoWszH&_nc_oc=AdrsLQ4dmFhh89Cr58WQdVKz6UDKs7KVeJ0I3TPvoee1lSEn1iQiHOStQF8hL148ALg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4Id1BZScA-lxUnB3mnybsyghmb-UYZ-Ux79d1a2SZ7w&oe=6AF1EA63"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9iS9gPDZcKcQ7kNvwECFOar&_nc_oc=AdoTsnTsDbg33Zznup2P4TpiIulqhg7vzorvtRDqhDcfsed84adAHZOg3uzZdz9lBtw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq2bOj5QS3DFuiN_RhcphY0SyJnMz6Uy0qJGmmkcM7Kg&oe=6AF1E75E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsRoc1vGQ_YQ7kNvwHLr0MZ&_nc_oc=AdqWapOkBdjSVQh4JVdj5OUZUDAmpnHlpafzCnoza034EBZzs7OZ7TwPqrvBohM6F-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQqglXpq12rgGNzHI0svZ9qpazhcmfXua3ZlGjq5WSdQ&oe=6AF1DFE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=APT6Ti21AfYQ7kNvwEoPosu&_nc_oc=AdoF2hYT6U_kLiyz0pasXNJDQTP6C9qWS8JLZRv8jCx3UyC8GjTiFy8VWGayu5pa4io&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5xyZOaO2Vg8YISkeTR-bbXgV3XmTtZ0Ab7DKg0_4xSQ&oe=6A732D40"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdgWgGi6yDUQ7kNvwGi7sYG&_nc_oc=Adrv6DgBv1b8BcHCkgoOnSUp3xSClAW3GrT9duVmqU5H2hMIXq_MeRlqnCK8XBNzlk8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENyP81UCSwBjy0uLTCYsR6r47-u482Nw3wVIc_KxCzIw&oe=6A73532E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzcZIrXepWYQ7kNvwGO1s6P&_nc_oc=Adrk4MVPmm9PGxSx3mKokr3dsuNqYApwRYPHJPDIhJsM_bUUoOmI_Q9TA3XcLe1UaaE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgdxTGQBaZacMETuteyCSlMuv4cMA9gtFM8tC15bW7HQ&oe=6A732223"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVDddmdmfrAQ7kNvwHOgga2&_nc_oc=AdqTmO6KfWFG6n-9_mZNlSb4Ju390lh8HX_6vTCeKrF_ZQ4ID7Y8cTfpqhm4Wk65_l8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIgjv2e_-t2xg7sJLLNmBuq0lNEVuncfxWKkRCAGSBwA&oe=6A731F1E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7f4h7J3Nv0Q7kNvwEvq4s_&_nc_oc=Adp45Q8ZkVOMUYYKfpxWi7dvOkZQoB0XAswml7phcbYmPEr8uHCe_cZRh9EnvJSrlIY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRzIFekmf7LFANt09IXENOj8SpdxQG7_CwYZ4gojhRzA&oe=6A734FE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
ri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ureRen9WzEkQ7kNvwEfuqKO&_nc_oc=AdovCSjC2qgGUo6sYnb44rorgBNenfhcK0Fhw_VIMU7IqG4bC3Ls9B-RIjMtilvFDKg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKAPrhFxz2wO68KPpbLRu5EWYwKT_1wquE2bz01hRTbg&oe=69C5191E"}, {"file_name": "migrated_image.png", "id": "247096786454689", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-eQZ7FfGsIQ7kNvwEeSpVQ&_nc_oc=AdpYw2b5WfvB7LTtri-sr90oZ4BD7knePhUecnGTTuahe6zz8JYvgooz8rBDWunBQZI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQFUF-QQ8H6R-r4W0FuS6OX9NN9ePT6DVjpvOAg7y2zg&oe=69C511A2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coco_video_7.png", "id": "138276410159384", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162696_138276413492717_1494748721810767872_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_T-2QSeaQAUQ7kNvwGl3B0a&_nc_oc=Adry2atVtB6mNWRJIAKQlIz2t9UvKmSj_1brRvdsyBbyTU39Vze-n6FMKSfc7O2n3cs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwmwNoxBEv5HfRjNsIFityOOD2JQz3xCy5aYlLD9skpow&oe=69C53DED"}, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco, coming to theaters November 22.  \n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "4889794377801101"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2371475156211254", "version": "1.0"}, "id": "125088748251493", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2098235286868577", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2371475156211254"}, "release_status": "RELEASED"}, "binary_relea
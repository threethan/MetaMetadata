4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_X3DztnVO_cQ7kNvwFtq2Kj&_nc_oc=AdrjypQtp6HcEt4ul5d-iFE5xeaLzfU_cq4gVM38AYaTxRLJpYFxoOEpZo_7nRvM5t8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYVb9DCnFb8i4Jit-MGaMdbJUsnWRot-O6B3MTj7GmyQ&oe=6A58CF40"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mf0xX91TWfQQ7kNvwFeEBGJ&_nc_oc=Ado2oWEtX2BTLY_oZicFUyTNgb3ElottM17ciubmrzxMlUWUY6MQCZi2hWDISSOJws0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKe0zAH4NLIr_L5ePlCT9j1gDlygM0eI7Y8st9pm7X3w&oe=6A58F52E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRCs9RB2O4MQ7kNvwHBHPau&_nc_oc=Adp3e_npQYN8j5HQAHagNS119hauC_0OMVLttG6YxuSvZ23FKQyIeIL57Je3aSyFB3o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8pvAZbzYF0VbyUxnpB6HedSMY__TSa5pPKQj60jJk6Q&oe=6A58C423"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=STUjQ7q3yj8Q7kNvwFJc5AS&_nc_oc=AdpSJGMDA1NNO94WoV0CP67AnRpl3py2b7oE3jEpBABbg7putHXivKfR1BwJeMLw5rM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDR_4lGAzSw1XveV3UTPI2OCK3VmeYrEsN0dINVRCFpGw&oe=6A58F95E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YDkL9TmO1fkQ7kNvwH7le9h&_nc_oc=AdosevK-Q2gG2Jg5wno6hHLibj7rIxlKxFqys9gx4mAyUh4eVEFfc5DDWTeJzVPc8_g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3PguCeG8fORwOeARGET6s8eZWW80WDgJorap1RNuw2Q&oe=6A58F1E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
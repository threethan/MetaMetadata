4800_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kHpVdvQITEQ7kNvwEAJvq5&_nc_oc=Adps4EdADvMDx82XT1Td-Kd35NaNKRJSuQuihrdKY3hNGIPGBD7oY8LEIbYzCQySsPo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_owJVzYB9UrmtjkBdVTqPgaFzA9cH-4lD2uUMCYiFr4Q&oe=6A21A880"}, {"file_name": "migrated_image.png", "id": "341295990182850", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162701_127610137906662_6635819807709069312_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQM-4uf95ugQ7kNvwFN33Gx&_nc_oc=Adq6NnDKr7Cgr2qzCxy-AGm2ZWCZdvBmLSdqTsLwpibIZ2NiHrH62v3rmsFXIdryPe4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vQ7l3JEALC21G-qbXB-KcRM9pINUWVRGoVYTkMT082A&oe=6A21962E"}, {"file_name": "migrated_image.png", "id": "256493978720033", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12138787_143506626300094_6938792929687240704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej0sTnsp2jQQ7kNvwHMFQv9&_nc_oc=Adoux3Fmv6K8vYPnzZ5E-dtmwA09n2WO_lk9Il0_1xOvCN45kvcju3RpcSsU2zhlknU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JWgzlz58yYt9XwwuKY6083RKeJwR6MXIBft12h9jbvw&oe=6A219D63"}, {"file_name": "migrated_image.png", "id": "209997493578465", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162718_296743914149845_4296246371620487168_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDRfDbc3cnUQ7kNvwEhGsN9&_nc_oc=AdrSUD2yLnbHCIoP_haCQGK9ip_Y4mOUl-IXThbmhGhCaCuesh9iqm1uahPVTPifOAg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gEFHDvrtmfd1FENiBMv-EhNnqU6cBkoHDsYzUMHTepA&oe=6A219A5E"}, {"file_name": "migrated_image.png", "id": "193869358727865", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162682_132381304133910_8499134903143628800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRW9rowSHkMQ7kNvwHAxgTp&_nc_oc=AdoZs48jnEHADyHm5Ca296eTCZiUtCBz-3u-5yu6jBk_EY7j3nfVlttRn7j2LLg_Rhk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B6H-fN7etq_yIYDupbyihZ_IqrpVOv0Y6kpGP5o1mag&oe=6A2192E2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Coco VR", "keywords": ["Coco", "VR", "Disney", "Pixar", "Oculus"], "long_description": "Coco VR is Pixar\u2019s stunning debut into virtual reality: an adventure into the beautiful Disney-Pixar film, Coco.\n\nFollow the magical alebrije into the luminous world of Coco filled with lovable characters and beautiful settings from the film.\n\nFEATURES\n* Meet Miguel, Ceci, and Hector in fascinating locations featured in the movie.\n* Express your uniqueness and rock a new style in Ceci\u2019s costume shop.\n* Take a gondola ride and see the gorgeous city from above.\n* Live a little in the spotlight!  You\u2019re the star alongside of Hector in a musical celebration of Dia de los Muertos!\n* Full localized Spanish version available through the setting menu.", "short_description": "Introducing Pixar Animation Studios\u2019 first VR experience with the visual - and storytelling - magic only Pixar could produce. You and your friends will explore the world of Disney\u2022Pixar's newest film, Coco, in this social VR experience."}]}, "developer_name": "Magnopus, Walt Disney Studios", "developer_privacy_policy_url": "http://www.disneymoviesvr.com/privacypolicy", "developer_terms_of_service_url": "https://www.disneymoviesvr.com/cocovr/termsofuse", "publisher_name": "Walt Disney Studios", "support_website_url": null, "website_url": "http://www.disneymoviesvr.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EXPLORATION", "MOVIE", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_MX"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "support
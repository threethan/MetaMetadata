oc=AdnLqn2frTLm1JtYLH0wOu5Sc5qkAzjEeB1J2jKQjjln3vKjQk5tfiAjfKgoPTIozOQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfwrLqHb25x54OM1undjyz9MMsaeOjUO9GIVjamsb_jH6g&oe=69AADADB"}, {"file_name": "img10.png", "id": "1022191999072577", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/75234372_1022192002405910_796788183209070265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N34zerNVHW4Q7kNvwFhNGGs&_nc_oc=AdktM1s4MCUzBwRz02MFJVbGTLekcz3VdYlwcoSc_8_iVXVvDfd98JkwezHFeegRzW0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_AfzIsdsKhz9aUJSRkyU-9k4fm8Mcdx02pNbpoHglzC2I0g&oe=69AAC095"}, {"file_name": "img7.png", "id": "351672257511279", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031356_351672260844612_5705810526296635594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esnFQGS3uSEQ7kNvwFaa6Zj&_nc_oc=AdkRc-JbP-QAP041nGelZR0WcJYjL0PBvep0W-fftwt8Hp3e5UgtVz4Et1u2vwxxVUk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfxksqW-FOLEwt0PIJjrpIRbj_laLEa0COCw03RP8ZP-CQ&oe=69AAD206"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjtwN8mEXaUQ7kNvwEl42kG&_nc_oc=AdmVkTJ6yBQ_wB9TFRUD80ld5S8Wg1YZ3XHpcEqIcS1q0I_fw7FiUkX3CcmvPuwdcTA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzJBVgQSqgROk6DmBysA-Svu7iGy4r6-pzb7OukeD5W6g&oe=69AAB0C3"}, "display_name": "BattleGlide", "keywords": [], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://battleglide.com/#/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ghostly Bird Games", "support_website_url": null, "website_url": "https://www.battleglide.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26160424460238171"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974757_1313189139274607_1213585301948800695_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y5yaIea_M90Q7kNvwGWrF9K&_nc_oc=AdlzqSvvo7xkKH1UvFU
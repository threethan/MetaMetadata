GT&_nc_oc=AdqTA31h3BFGXtPwTYPxNkAXOF3To9ZQrtT19xSg6HcYHx7lpsHf1Jih6wSUny7xYyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZBL6Oh970PAvVwasvoDJLEsBWKw4VNmXj6RZis7dFww&oe=6AC64D5B"}, {"file_name": "u3_1.png", "id": "1063234476562636", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604385997_1063234479895969_213107836021952510_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IDXA1ThI0wQ7kNvwFAGuDP&_nc_oc=AdqtEgjEG-l-jHx5pcOG56SXa3UrsJj85RHshAaNfk4zjXRPP67lebggywQZesmBd40&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHedcvoXECT-NgZgtW2lJGyr-ycYZMO1jrLfhMmIbhCA&oe=6AC65B66"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0XV0rk34JsQ7kNvwH0CI-D&_nc_oc=AdrgvXvdabpLNj3MsZk86mQoJo9HCRNVJy-CssPcMbLi-M-ubtTM1khRBvB1bYWj5FE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFNhnTsTiNXbkj6bgWm-jX8xxWfI2m6Bcn6z1FyI-P0w&oe=6AC65B83"}, "display_name": "BattleGlide", "keywords": ["superhero", "fps", "fighting", "swinging", "multiplayer"], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like 
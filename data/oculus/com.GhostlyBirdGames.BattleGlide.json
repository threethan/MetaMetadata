tent-sjc6-1.oculuscdn.com&oh=00_Afv-6jnL3E-BczVu8t3kFRp7O3N0jRcbsq0ZxUCOIIVpoQ&oe=699865DB"}, {"file_name": "img10.png", "id": "1022191999072577", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75234372_1022192002405910_796788183209070265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddpLSmS1E3IQ7kNvwHq3jzr&_nc_oc=AdlU_jvhABpx2pS74twfc6_vW-jvNNwBZdXX90pw4mj6J8imnVg65LZ0Si18vuesj6k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_Afs43HF6_coXPw7AmwOp6W90A7x97BouFIaBdvy_sCMFQQ&oe=69984B95"}, {"file_name": "img7.png", "id": "351672257511279", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031356_351672260844612_5705810526296635594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=54Pbo3pkzsIQ7kNvwEnE0hD&_nc_oc=Adk1yT9LhJNKqD2IgkdrPOhpMzOIrcy4ueJUHK7hKxmZrafMl_yi2-tWWh9p5SuxD30&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afs1t3DA1hRpuk8LIIye7bvcllfdxfOQUa8oR2e0ANEUxA&oe=69985D06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htNdRPFMaUAQ7kNvwEYf9LT&_nc_oc=Adkaja1l_9ZSXTjgtUC4mJoG7gG1NvdN_eEd7sASmlGMJxJ0C74eSD2nHs64RvMNh9o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfsXEiGJxX8gY9r0md-GRsEPbjEivAEVvfFqm8RGX26jeQ&oe=69983BC3"}, "display_name": "BattleGlide", "keywords": [], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://battleglide.com/#/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ghostly Bird Games", "support_website_url": null, "website_url": "https://www.battleglide.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26160424460238171"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974757_1313189139274607_1213585301948800695_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95YKG4K1s5QQ7kNvwHiWKuM&_nc_oc=AdlKElPgnaV9DKNgUr-zZZNaVk5RsC0S8U21zxc8F5MB-rSuXxEv2JDombVd6hBh4-s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfuRZv1JI8KXjPehLnPAQFn2TvV
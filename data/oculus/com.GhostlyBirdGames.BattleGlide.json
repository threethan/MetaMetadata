e=69B53D6E"}, {"file_name": "img5.png", "id": "221985157337392", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57569428_221985160670725_1956832022154885653_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFdp3Lffg1MQ7kNvwEFWlkn&_nc_oc=Adn7NbHyk8aS3Ba1yOI2j35p8AyXi8FA8vaLEtUzVHW05BKojyjrIIS2KDHc9UAfNYQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1Y3TWI_BqBzJlHl-LaJ01Sv_MUIe45zFxo9n1Q56irw&oe=69B561F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ny7yegYc3jEQ7kNvwGMmHIM&_nc_oc=Adk2FHsRXk9a830gJ6ktHk8Kaaul7zqjpZC8UEfjbRXABKrMpm5Qlxx3_gFokmc7eqc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxzJQUNB2phwUul5IOY2sOtpL6W3otcxql6WIVKWgqiwg&oe=69B53CC3"}, "display_name": "BattleGlide", "keywords": [], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, and evening.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day and also evening.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://battleglide.com/#/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ghostly Bird Games", "support_website_url": null, "website_url": "https://www.battleglide.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1421179985383805"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "715011688318138"}, {"status": "CANCELLED", "id": "1322659252081938"}, {"status": "PUBLISHED", "id": "810482610325157"}]}, "baseline_offer": {"id": "810482610325157"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1766088000, "status": "PUBLISHED", "id": "715011688318138"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25231303696483590", "version": "0.3.0.1"}, "id": "3411945632393120", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9685315748175636", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBina
ontent-ams2-1.oculuscdn.com&oh=00_Afu8Cu8AOWx2ZXzSw7-jkB4m5zn10eMRbTAdD0zKAgLT9w&oe=699EFD5B"}, {"file_name": "img10.png", "id": "1022191999072577", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75234372_1022192002405910_796788183209070265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yr9nLPgJmdEQ7kNvwGY7C0T&_nc_oc=AdlMXIFSmE9VuADlCgUHQYjqD2x4rnJGguk9CFMcvJVv_QG5-DpuiLnSinnHHmhcsq8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsD0Wbv5MGix96P1bm3iaTJiHSgC-ckkLy4gEV_FeCO4g&oe=699EE315"}, {"file_name": "img7.png", "id": "351672257511279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031356_351672260844612_5705810526296635594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9OBrEahx74Q7kNvwFwg4MG&_nc_oc=AdncLbwOoJm6IFHs9HWuvqyKTQHcjSXq9f1Zu4GpvYxjiO70rl877XppO72k60gcnNs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aful_WT_8RoWugIHNdDaro-NHgvX2mK6a3qgEdegIAIwpw&oe=699EF486"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wncoIfPygIYQ7kNvwE_hB7L&_nc_oc=AdnuTz23sbOrIuETeoI_E_5daypz_PbLXGkYzySqCAqRL8rWohzqzs1s-3inkmZBx_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuDqT0EuRPA8koHlX1PAyu72UmizC34XTDDZorKbo5OQQ&oe=699ED343"}, "display_name": "BattleGlide", "keywords": [], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://battleglide.com/#/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ghostly Bird Games", "support_website_url": null, "website_url": "https://www.battleglide.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26160424460238171"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974757_1313189139274607_1213585301948800695_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONpD0ULlHEIQ7kNvwHv8Hzz&_nc_oc=AdlS6lrTi4P3gjIiD-tBL3bXP1Z9FHSDBtS9dBo1z5qiPTW9HOcmiX1I_-v3RH5Khbo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuGGPVf4uWZWcKTr3aMnYEWT
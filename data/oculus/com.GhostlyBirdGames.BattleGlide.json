Xe&_nc_oc=Adqbl0rfZpIfUkusJgWrR_YIhumyJp5mdfWhr1QMG3gHN2ZOMp5F1PNR-6Gmk1ocyik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcRDALf2XD_4ULGDdH5aPTJ0cMONMJ3e3hwd_O_wS5WQ&oe=6AF5C35B"}, {"file_name": "u3_1.png", "id": "1063234476562636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604385997_1063234479895969_213107836021952510_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HIpRhoeTIUgQ7kNvwFx-XL2&_nc_oc=AdrCzs10p7_6p2hTB7cdSZ4V4xBM6g0O8NGL92Yv0fDvpgsoEQdh8ISKtXdTidkcHNc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4x86YJdSnICn5XvVTFVv-Kytm-4l--fg_xMlTFVVMag&oe=6AF5D166"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MoCJF02q-0Q7kNvwGE7A5t&_nc_oc=AdowBHhoRe0jvJFOZYh_JTjBrccwW7-flkSLFa0WlpG5Lq_y__K7-Kd-emB90TNsp5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXxZfh2FACZApik_KjT8_u8CxT0aJm9J_Kc_VT53LnkQ&oe=6AF5D183"}, "display_name": "BattleGlide", "keywords": ["superhero", "fps", "fighting", "swinging", "multiplayer"], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.battleglide.com/#/legal", "developer_terms_of_service_url": null, "publisher_name": "Ghostly Bird Games", "support_website_url": null, "website_url": "https://www.battleglide.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "38324161950530967"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596149727_1745851700084371_5352128265715049241_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcOFT8W1diIQ7kNvwHR-oF-&_nc_oc=AdrVH7jBR5cxUELvaP6TPDuOFuHSHpw066Jiq9v-PYY7ROzgnYzw_n2jckNf9e8eUY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSI2aJrHn_ap3YxJOnhgrF7iPJ04nd0Mf4MailA1Hu23A&oe=6AF5E1EA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": 
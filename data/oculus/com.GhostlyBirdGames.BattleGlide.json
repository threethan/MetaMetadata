ontent-ord5-3.oculuscdn.com&oh=00_AfvGxVMXm0n9Ro7pT_-kgrl9mw9H01u5dlPuEXGblZNH3A&oe=69A4435B"}, {"file_name": "img10.png", "id": "1022191999072577", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75234372_1022192002405910_796788183209070265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2ELie3A13QQ7kNvwHFTbqa&_nc_oc=Admz3UpPWfIgBedPKHmV5JsLLhCIGrkODi-UMuy4m3yyWPXbFMDbLFUQbX-PojNj3ws&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu2IgCfe1D-PTYWzLtW1OfCav0kxl5f6RSlVjhGfFDMJA&oe=69A42915"}, {"file_name": "img7.png", "id": "351672257511279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031356_351672260844612_5705810526296635594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n9VL-04_p1gQ7kNvwFearaP&_nc_oc=AdneDBB58a6Z7TyrtkU0OSjJTgll8r5DI8APFsFEqbO5b7rGBK9x_sH7d6nhFOaOHNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsWqmW9P5L6L1qcVJPLxFzU1zmp0x4vJPcnsfsdDwDXIQ&oe=69A43A86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRjF3B-HMPcQ7kNvwFDtlEE&_nc_oc=Adk7_Vj5P1kGE9ZUG4kQbGYroQ6raEVNMCI81JvF2xFLaAjljqWk1T0FJuNAlGg8_g8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftxUUYdp3LG3C9an31VGlUKCiDj-F8P1rXETUv18NQYkg&oe=69A41943"}, "display_name": "BattleGlide", "keywords": [], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://battleglide.com/#/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ghostly Bird Games", "support_website_url": null, "website_url": "https://www.battleglide.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26160424460238171"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_1313189139274607_1213585301948800695_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWcKcv_vlkcQ7kNvwEVkssG&_nc_oc=AdmCkVBKn-ddJHIM1t9gFtmVlV49rvepr9EkGWkC5u3CKod3lzpRZMLEsT5wShj0pOA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftYXsGjp95vnqgaqgjABnsR6
D566"}, {"file_name": "img9.png", "id": "733455098251552", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982501_733455101584885_3575635568871713626_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5u7uV7qd_IQ7kNvwHrn33l&_nc_oc=AdpJMWOKHZB8jNAxSN9MpRaE8RxanA8hnYBbS8SquX5iGtbUYoiyD9febq4A-xFX92k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT--jay2yTqqSZ48sKTmaiJSHenO5VI9hYWnL43GWiaHQ&oe=6B01D91B"}, {"file_name": "u3_1.png", "id": "1063234476562636", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/604385997_1063234479895969_213107836021952510_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnewqc2qBNkQ7kNvwEKtQpZ&_nc_oc=Adp8a8GB6gihZ5b_6Xq9-eT1vIF3R_QkLL_b67YCtpatALXkGx9ARqf8vl0g0yUJv-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTO9_-ELHs7nQP5OY0JI3jwDvHjw9HVgjrkiXb9lgjYzQ&oe=6B01E726"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFdA9NSnIvQQ7kNvwFU8wms&_nc_oc=AdoL2VbOY18yPfB9q9X7bpzCTc69lZgHLsFetaJIUUNqN1RP1OR59U3nXzJRGuNvzcQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh8rbiq9Z0UdgKtYG5yGxpPm829okzYYHUj4G3WgBbPQ&oe=6B01E743"}, "display_name": "BattleGlide", "keywords": ["superhero", "fps", "fighting", "swinging", "multiplayer"], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.battleglide.com/#/legal", "developer_terms_of_service_url": null, "publisher_name": "Ghostly Bird Games", "support_website_url": null, "website_url": "https://www.battleglide.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP", "MULTI_USER"], "id": "38324161950530967"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/596149727_1745851700084371_5352128265715049241_n.png?stp=dst-png_s360x360&_nc_cat=105&_nc_map=
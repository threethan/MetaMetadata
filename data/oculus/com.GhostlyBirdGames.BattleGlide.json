tent-ord5-3.oculuscdn.com&oh=00_AfuvihyWM2MKaFP0mvYkPykNO6UFUvIeqDxVu2PSArNSmg&oe=699B08DB"}, {"file_name": "img10.png", "id": "1022191999072577", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75234372_1022192002405910_796788183209070265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddpLSmS1E3IQ7kNvwFN4ez0&_nc_oc=Adncv0PdJSmKeE8BvcnI8L7-Nlxh5NGH2nI46tvXbTuoTu8996AjEd32hhEAhJ-Bg4M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftaWWkzm9evbuvFJnIfR9NqM-Yg7LnB9tBCFYFf_ZgD5Q&oe=699AEE95"}, {"file_name": "img7.png", "id": "351672257511279", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031356_351672260844612_5705810526296635594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZriX0833AsQ7kNvwG5q1rD&_nc_oc=AdleRZeJnKuPHPE8WAcRzRR_Bsm9eu4wU7jqc9YfF4bHk-2B2kDdmPlGRucjCaYxL8M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfsqcVTG2ljSV0_Iw3ZLywucLTtap7-sUNlJ2moh2alxpw&oe=699B0006"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=htNdRPFMaUAQ7kNvwGGFJTO&_nc_oc=AdkiXdIqGxJQQzIhCSUClyN7ZhC2cqQPULoB4K4nn3DPgVJFpFm6rQcLauZpbZd_3B8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afvqn65O0dlEfIJzSp7LS_iDcuovlQwGWSP8FQKwm2txYQ&oe=699ADEC3"}, "display_name": "BattleGlide", "keywords": [], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://battleglide.com/#/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ghostly Bird Games", "support_website_url": null, "website_url": "https://www.battleglide.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26160424460238171"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974757_1313189139274607_1213585301948800695_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=95YKG4K1s5QQ7kNvwEkcU_8&_nc_oc=AdlZkE9uVwqBgU4VhFtr5jAC82M4t-AGwp_WSgC4jSl6jSjVr2uII1NAuFNfbGTvvGo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftorSTPwuRSr_65zhdp7KZbHXY
content-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ykfooLyAYY73dgF8MzS24bwDp9huWZs7TGcQixfDU7g&oe=69D7BCAE"}, {"file_name": "img5.png", "id": "221985157337392", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57569428_221985160670725_1956832022154885653_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DMrzL7rKgcwQ7kNvwHlqGpZ&_nc_oc=AdpsAa8heyIYJARiNV4T-CJmefFalPHkJQVZlZ5hl9a5EVHQhyIDa2O2THgjujGCYG8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10Pwe46NsVLqANyz-ORu1c8PJBquo9avB534bOFnrkew&oe=69D7A8F8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4CQGBshAdsQ7kNvwGSaqFD&_nc_oc=Adp-1S8Pw1I-CVp1_AStVzhFUfcuaqTU7Z7BlwTCGSrCsOhVKIOUDqYEi_TQg3522-g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TDINLVMf4AHf0T7QBc3m5D6pOwaV1W9bz6wPGrg0ZSg&oe=69D7BC03"}, "display_name": "BattleGlide", "keywords": [], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, and evening.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day and also evening.\n\n- Take down criminals in 
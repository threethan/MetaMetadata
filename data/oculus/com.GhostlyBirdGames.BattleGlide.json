ZBt2chpVQQ7kNvwEMXyDX&_nc_oc=AdoQkri1s0Fmfjum5nGvlHR5RHxtOSfLJnYTxZNrujroc80Hl_8ZWoHMfqh8fBPmlfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3m2yt1gdfc2C9pxn5pKwWNiLjQls1WofvJAjSn0dq_zg&oe=69F751DB"}, {"file_name": "img10.png", "id": "1022191999072577", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75234372_1022192002405910_796788183209070265_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbRTjJ4FnX0Q7kNvwEPSPPX&_nc_oc=AdohKiSBbJEPWItgAx18aMBoz2uO040y5noCa4lvLLTrPqS9Dqc6cX3PLrJhkDimpPQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0RenZkTBPo365_zY2PuamtuzHYBCZ1COpfaLtstp89yA&oe=69F73795"}, {"file_name": "img7.png", "id": "351672257511279", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031356_351672260844612_5705810526296635594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BsAV3JUoZLgQ7kNvwGvjAOu&_nc_oc=AdrW5RA1_zcXJcaVeb4oog_xaaGzxejsBcUky2nBE-9qXyWjuT4BEBRKW06F7QhUhKE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0bGXiZ62C0AijCk6y85ppzOr-_JyKH0AhM_CLudbxkCw&oe=69F74906"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ha1p98XI-sQ7kNvwHHNb4_&_nc_oc=Adqo5XBtWowM5uw52KH5tSO9T_l4WYZ3cGkO03hnXWZThUXoPXIeCl3EHMpWSQTCbsM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0qUF51CqZhOXFLOov8eNBgkukiAxNHhC7hhEOxtJ1cOw&oe=69F76003"}, "display_name": "BattleGlide", "keywords": [], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://battleglide.com/#/privacy", "developer_terms_of_service_url": null, "publisher_name": "Ghostly Bird Games", "support_website_url": null, "website_url": "https://www.battleglide.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26160424460238171"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974757_1313189139274607_1213585301948800695_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xp8HSmczO
IJB8K3IG_YP8t6eclk3yGzd4-vW3BlfSNcdjpQvHIqjMKiQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBKqCYEAvCs7_3GvD2WoxvR5zwUQcAyyMDGssxzbLk3Q&oe=6A972D95"}, {"file_name": "img7.png", "id": "351672257511279", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031356_351672260844612_5705810526296635594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BvrJ3Mwqv-QQ7kNvwFOmXbV&_nc_oc=AdpbhiZSV7ieshAQBQzcmuOAER_yalGSLzY92Z1vs3O7B-0_huAx5zXxqhHN3DbFq9o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFI43PbyX78-iKrUQYGhcjLJOrORU_E_td5xH8Wpu_MAA&oe=6A973F06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YqdbfXSuKk4Q7kNvwGe0KyR&_nc_oc=Ado7rHO7LPN4PLeYEQ3HdD_6UJw7prooT4YYz0njzlL8mZznmBqLewFiFiejZPJSQMg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFofq8LE314Ox6EMZAFIcIKM-rZPAgL5GnzrDmuVFvoNA&oe=6A971DC3"}, "display_name": "BattleGlide", "keywords": ["superhero", "fps", "fighting", "swinging", "flying"], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.battleglide.com/#/legal", "developer_terms_of_service_url": null, "publisher_name": "Ghostly Bird Games", "support_website_url": null, "website_url": "https://www.battleglide.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35887066327573887"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974757_1313189139274607_1213585301948800695_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9jDuSfaiD-8Q7kNvwFHWy4O&_nc_oc=Adrr4A7dqTrIIaW4uRUtN-eU-SpDSZYszZcoG97fIcMs7s9cUltE1wEsyrxhg6qvu8M&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGy5yLwoOKDI2dLJxPnBlfFAXjdebOnmiLhcz-Aa2ITQ&oe=6A974EFE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BattleGlide", "platform": "ANDROID_6DOF", "context_
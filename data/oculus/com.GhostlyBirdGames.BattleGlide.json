Q1R69ao7f0B9rMowADftTkAw3mVFz9HSjOSveVbGp27KuXI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqYlYdJTKWAu1Taq6m3XhPc3txWpu32nKTncoPW4fwiw&oe=6A8C3115"}, {"file_name": "img7.png", "id": "351672257511279", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031356_351672260844612_5705810526296635594_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpzcNmg2c9gQ7kNvwGYS503&_nc_oc=AdruZF_oruqW4cnUAGb2fncktZe2Y1TVpuH4usNyf4PPW4jBoXNTCWMzQ6P032D5Dao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpiSPn7O_nUcQyX4DbiwBQ8_A0KVZHLjfrgtcwqp15yA&oe=6A8C4286"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnail.png", "id": "794121865642317", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035334_794121868975650_8463868109182604137_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHb9VyGeIpkQ7kNvwHb1Y9M&_nc_oc=Adr_paU6LuyUjL-5z7jkqKyWFEglSP-NvRmqZUjsZnqR6pe7d1VLrPAn4TbtExA9OYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYTAxZ_G_NY_Xb5416IiH-oiKqSSFmiZaXL_RGavjpJQ&oe=6A8C2143"}, "display_name": "BattleGlide", "keywords": ["superhero", "fps", "fighting", "swinging", "flying"], "long_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, jumping, and climbing walls. Choose the time of day you want to fight crime: day, night, or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Handle weapons realistically. Disarm your enemies or give them a taste of their own medicine!\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans.", "short_description": "BattleGlide is an open world sandbox game where you can move and fight like a super hero.\n\n- Explore a lively and open city by rope swinging, and climbing walls, during the night, day or in between.\n\n- Take down criminals in countless creative ways, including grabbing, shooting, punching, disarming, or dropping them from the tallest skyscraper...\n\n- Use a variety of weapons to take down your enemies: fists, pistols, assault rifles, large props, baseball bats, explosives, and even frying pans."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.battleglide.com/#/legal", "developer_terms_of_service_url": null, "publisher_name": "Ghostly Bird Games", "support_website_url": null, "website_url": "https://www.battleglide.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35887066327573887"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974757_1313189139274607_1213585301948800695_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUvSTBswa0cQ7kNvwEqjIjD&_nc_oc=Adr7_gSTa9r1tP9wTBA-jdCeG8EIs7Yv9_WjRlX9afdUHvsXUHgGS92veNMAX9UB2FY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAmcr5QiH8G6bAq7Y1-JLdyuVFdQMofKGqlLFIfzd3rg&oe=6A8C1A3E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "BattleGlide", "platform": "ANDROID_6DOF", "context_
dn.com/v/t64.5771-25/491821704_1753030325365066_9005742420297931541_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkXMTZa2Gx0Q7kNvwHfSkVD&_nc_oc=AdrIT36vAFKRZ_fgcaiY9hJNSrmXgdB7TozdXikJ6z1vfI3rwLOt9plKNl2q3562vuc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Rs1RGoEhP5EossfLhT3socb2zmciTsKXwXCtOsT2XXA&oe=69E6240D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ss1.png", "id": "771083069355916", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818890_771083076022582_601711011248765481_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AZXHU2iSy8Q7kNvwEDIzW6&_nc_oc=AdpvU_dFz5aFkUERBJs1vRTpvNGYF1H9nczWWfWRunyq1tETvniK-093PtOYIz0-AGo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ihjwddv_EDJz_13DzFjbnd-5-hKpt7--J90hYshZc_A&oe=69E61AB2"}, "display_name": "Lumber Harvest", "keywords": ["Chill", "Relax", "Harvest", "Farming", "Simulator"], "long_description": "Lumber Harvest is a relaxing and immersive lumber simulation where players explore forests, harvest trees, and build their own timber operation.\n\nStep into the driver's seat of your forestry vehicle and travel through natural environments filled with dense forests, rivers, and islands waiting to be cleared. Your goal is simple: harvest trees, collect resources, and expand your lumber business.\n\nAs you explore different areas, you will discover new forests with larger trees and greater harvesting opportunities. Carefully navigate through the environment with your vehicle, position yourself correctly, and begin cutting down trees to collect valuable timber.\n\nThe more you harvest, the more money you earn, allowing you to continue expanding your operation and unlocking new areas to explore. Each forest presents a new opportunity to grow your lumber empire.\n\nThe peaceful environments, satisfying harvesting mechanics, and exploration-focused gameplay create a calm yet rewarding experience. Whether you enjoy simulation games or simply want a relaxing activity where progress comes from your own effort, Lumber Harvest offers a simple and enjoyable gameplay loop.\n\nTake control of your vehicle, explore the forest, and start building your lumber harvesting operation today.", "short_description": "Lumber Harvest is a relaxing first-person lumber simulation where you explore natural environments and harvest trees to earn money. Drive your forestry vehicle through forests, cut down trees, and manage your resources as you expand your harvesting operation. Discover new areas, clear dense forests, and grow your lumber business while enjoying a calm and satisfying gameplay experience."}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25654944420788523"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "924773486719168"}]}, "baseline_offer": {"id": "924773486719168"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773685140, "status": "PUBLISHED", "id": "924773486719168"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_resu
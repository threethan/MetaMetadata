oculuscdn.com/v/t64.5771-25/38982656_832602007808533_5730836623362129129_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBdAVUalPjMQ7kNvwG2S8lB&_nc_oc=Adp0TWAo9XBbC5bRNq67Rsxe40t8DXDAhs5c8oCiefmbOC9fmSI-BBSJyIgrovQUCog&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSa_94WM7ZPQoNY-T2TTeVEije-dR2JuKL41Y5rCNkYvg&oe=6AFF02F6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "547155914029815", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75210884_547155917363148_5907858472536931705_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_XVrAZOzYEQ7kNvwFoaBWt&_nc_oc=Adp4XMWNNL3TRR7msvMX7iWEpAtWyByZ8Is5OmmhBQuLhpJjQ2_Nr6zwSUeJNpclr3w&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrchxa3YSBgNDeetpLQWlTBaES4iEN4lssNJfW8fqaew&oe=6AFF30E4"}, "display_name": "StarRaver", "keywords": ["music", "concert", "club", "social", "rave"], "long_description": "Hang out with your friends and party in this sci-fi music experience! Visit the unique clubs defining Starcade Arcade and enjoy the casual multiplayer party games in each room.\n\n\u2022 Test your aim in a sci-fi western saloon with a game of Space Pong.\n\u2022 Enjoy classics like Tic-Tac Toe by playing with life-size VR objects.\n\u2022 Vibe with all species of aliens in the notorious Club Jazz.\n\u2022 Party with DJ Inkers while you play with Space Slurpies.\n\u2022 Discover the dark secret buried beneath an art deco dining hall.\n\u2022 Finally, relax and enjoy the show as you attend the StarRaver Concert.\n\nYou are our invited guest to the Starcade Arcade universe, and we would like to introduce you as an exclusive VIP in our multiversal club: StarRaver.", "short_description": "Hang out with your friends and party in this sci-fi music experience! Visit the unique clubs defining Starcade Arcade and enjoy the casual multiplayer party games in each room."}]}, 
ng", "id": "1352430872833448", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1352430876166781_6442822026823898424_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCNB-Le08yUQ7kNvwHPKFMN&_nc_oc=AdrN-jWugWyCYof4w1AAb9rVA99KIsr83lSpavMUWddcFhxY-FXDaSilor1bfZFEvI0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0tSN7cK29D_PZAcPxIKUTlne2dkxfL-DqVbxtzYE39g&oe=6ADF5B34"}, {"file_name": "AIEnhancer_ss5.png", "id": "1560358158321711", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_1560358161655044_6994740137523297611_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr-HyQu0VdMQ7kNvwFmLQMg&_nc_oc=AdrMf6kE3sL7EIjT1Z-7xQAs8NoWbWpm_mW3CM_jiMBVmHTHAnIcLl28YaA5eweyJ84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjUcljX41XyzFIK5r4llWo7IK68wlVzmCuViiP8CwPdw&oe=6ADF6645"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AIEnhancer_ss5.png", "id": "1553502909294548", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821230_1553502912627881_7615182672197085054_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCrM_lYXC1YQ7kNvwEF8KFI&_nc_oc=AdqlVwSvww9Or_zYENNulDYv0q7kdiH7j2Ax9NCqNKPyMwgTOE9kQcVvReVeqbIKM8E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGbRhWcCffnvd2oqqIRpLU9tNiGXa8qwFl4SNXLg_2_w&oe=6ADF581C"}, "display_name": "Slice Chef", "keywords": ["Roguelite", "Survival", "Action", "Casual", "Arcade"], "long_description": "Cooking has never been this dangerous! Slice Chef brings the addictive thrill of 'survivor' style games to VR.\n\nIt\u2019s harvest time, but the crops are fighting back. Set in a vibrant farm world, you must help your determined little chef fend off an endless army of mutant vegetables. Tomatoes, cucumbers, and eggplants are swarming from every direction, and the only way out is to slice through them!\n\nKey Features:\n\nRoguelite Survival: Defeat waves of enemies to collect XP and level up instantly. Every run is unique!\n\nStrategic Upgrades: Choose wisely from random power-up cards. Will you boost your Movement Speed, add more spinning Slicers, or increase Health Regeneration? Create powerful combos to become unstoppable.\n\nHorde Combat: Face hundreds of angry veggies on screen at once. Experience the satisfaction of clearing massive crowds with your upgraded arsenal.\n\nGod-View VR: Oversee the battlefield from a comfortable third-person perspective, giving you the perfect tactical view to dodge attacks and find safe paths.\n\nVibrant Style: Enjoy colorful, low-poly graphics that make the chaos look fun and satisfying.\n\nSharpen your knives and get ready for the ultimate food fight. Can you survive the garden in Slice Chef?", "short_description": "The veggies have gone mad! In Slice Chef, survive endless waves of angry produce in this addictive VR roguelite action game. Guide your chef through chaotic swarms of tomatoes and cucumbers. Slice, dice, and dodge to level up and unlock powerful upgrades like spinning blades and speed boosts. Build the ultimate veggie-destroying build and see how long you can survive the harvest chaos!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "RO
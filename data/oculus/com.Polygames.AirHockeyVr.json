&_nc_ss=7f20f&oh=00_AQTsiyGtwSIBqRJzTP7GBE1-8S_1yPugeY9rkjEajj-tww&oe=6B031B42"}, "display_name": "Air Hockey VR", "keywords": [], "long_description": "Obsessed with creating the best Air Hockey VR simulator in the world\ud83e\udd7d\n\n- Play offline against AI or doing tournaments\n\n- Play against other players online from all over the world\n\n- Dive into the game using mixed reality,you won't even notice you are wearing a VR headset!\n\nAdvanced physics:\n\nThe physics is designed to be as real as ever achived in any other Air Hockey simulators,you won't even notice that you are in VR.\n\nEnjoy Air Hockey into a virtual world! \n\nWe hope that you enjoy playing Air Hockey as much as we enjoyed working on it.If you run into any issues or if you are interested in join our community follow the link in the addicitional details section and follow on our socials!\n", "short_description": "The ultimate Air Hockey simulator"}]}, "developer_name": "Poligames Studio", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/41873021", "developer_terms_of_service_url": null, "publisher_name": "Meta quest store", "support_website_url": null, "website_url": "https://linktr.ee/airhockeyvr?utm_source=linktree_profile_share&ltsid=53169d43-faf1-4ba8-8a3b-087017633fd6", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7812430118794958"}, "revi
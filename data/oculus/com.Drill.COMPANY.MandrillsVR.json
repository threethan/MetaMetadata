_ohc=Ewiu5Zkpn2gQ7kNvwHFflEj&_nc_oc=AdpkJMqBLvcoELZjvNw4WLmokC0drfl_KnyJolC8yS1dpuwtt3j8mtZsFm6QfrNT-ks&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjcOcT2M0p2a7Ac0rsFM467UDNiuk0jJ5jnSPsfllTng&oe=6AF5F6BB"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-30.png", "id": "606344938424319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982715_606344941757652_5573548456782094684_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muTZip8E5D4Q7kNvwGXJ2F4&_nc_oc=AdrY1Z8-alBwkuYexphuYCr_OUBDTJLPPH9nZOnUgg0ojERVbD67_QBv3LFBMNVOQ4c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRruG2-C73N8PkmWH2g0qrWfrBn6PaqtXrxHF9YjCEg1g&oe=6AF5E7EF"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-40.png", "id": "1235930147465651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001697_1235930150798984_1865019294501584451_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6YSL1GN4VsQ7kNvwEtXjxw&_nc_oc=AdouWFCGrNZI_CRU06c3yNl6nDIz_A8S-Qg-QfiiiKDep9ddoKvTY-u_Jmhp_cBnLDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTp97E2PWiUlSgf5MfbNP-YhFs9qNsggnlRuT0nBKNVaA&oe=6AF5EFF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mandrills Main_Custom..._25.12.2024_22-14-26.png", "id": "580119351293665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_580119354626998_4396366189324284114_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3F2Jly8ZyQAQ7kNvwGMccge&_nc_oc=Ado_nTanf6_aZhgXwEDTnZDpG3T0rmZqcsSdjkskMmjidcnp9i8PWL-W-mXk_eYzYN0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhlkeqTTAEPx5gLbA7y1xeW9veOOLIc87h1OPueSsXwA&oe=6AF5F137"}, "display_name": "Mandrills VR", "keywords": ["cozy", "chill", "fun"], "long_description": "Mandrills VR is a serene and immersive game designed for players who want to relax and explore at their own pace. Set in a stylized, enclosed forest environment, the game features a tranquil space filled with interactive elements such as small, leafless trees, wooden platforms, and simple structures that invite climbing and exploration. The grassy terrain, surrounded by high walls, creates a cozy and contained world that feels safe and inviting.\n\nThe game emphasizes a laid-back experience, with no rush or high-stakes objectives. Instead, players can enjoy the freedom to roam, experiment with their surroundings, and take in the minimalist, retro-style graphics. Whether you're hopping between platforms, discovering little details, or just soaking up the calm atmosphere, Mandrills VR is the perfect escape for those looking to unwind in a virtual playground.", "short_description": "Mandrills VR is a relaxing and casual game where players explore a cozy, enclosed forest environment. With simple, stylized graphics and interactive elements like wooden platforms and tree stumps, it\u2019s a perfect space for unwinding, climbing, and playful exploration. The focus is on creating a chill and laid-back experience."}]}, "developer_name": "mmo0n", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicymandrills/home", "developer_terms_of_service_url": null, "publisher_name": "mmo0n", "support_website_url": null, "website_url": "https://sites.google.com/view/mandrillsvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_U
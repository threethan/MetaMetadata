bUHRXrpbr22g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3St5yOC7-yl7lTJGKOme6iR7rJ1XRvwTu1FG5JDLfsBA&oe=69F206FB"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-30.png", "id": "606344938424319", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982715_606344941757652_5573548456782094684_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MctjleXfAF0Q7kNvwFeeEFR&_nc_oc=AdpDmJZb-eiSgJ4P1q3W8KXmHikbLAZOvUqkNVnCjxiqT7pbEcPulFqeURKrxzxrUjY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0Yd9rORXl0zTFmL-KsY_sdLS2QDbIY3n1KD3w_XCJ5HA&oe=69F1F82F"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-40.png", "id": "1235930147465651", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001697_1235930150798984_1865019294501584451_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1b71ZgaKjAcQ7kNvwGUh79H&_nc_oc=AdoEAfrPsqx45jVWy1Xc1ezGk61m26PTNkJX68MNE3A0Za9bU8E1R5LlDICpp45aAU8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3yL-mH0UOCLfDTssiBlFqXePJGo2LteQ_Jt1V10idZLQ&oe=69F20033"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mandrills Main_Custom..._25.12.2024_22-14-26.png", "id": "580119351293665", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031398_580119354626998_4396366189324284114_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6M6-w8dS5kQ7kNvwE6HuI9&_nc_oc=AdqZJeyexndyYHJScXePZKsfZ7qzcNpfYoFXiO6kNpyJ3ufGN8mnxkKTPP12w-KY2JY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2nte3pgivmIdlvvVvFMEYOWaty3VU0IgCdux2igwQbMQ&oe=69F20177"}, "display_name": "Mandrills VR", "keywords": ["cozy", "chill", "fun"], "long_description": "Mandrills VR is a serene and immersive game designed for players who want to relax and explore at their own pace. Set in a stylized, enclosed forest environment, the game features a tranquil space filled with interactive elements such as small, leafless trees, wooden platforms, and simple structures that invite climbing and exploration. The grassy terrain, surrounded by high walls, creates a cozy and contained world that feels safe and inviting.\n\nThe game emphasizes a laid-back experience, with no rush or high-stakes objectives. Instead, players can enjoy the freedom to roam, experiment with their surroundings, and take in the minimalist, retro-style graphics. Whether you're hopping between platforms, discovering little details, or just soaking up the calm atmosphere, Mandrills VR is the perfect escape for those looking to unwind in a virtual playground.", "short_description": "Mandrills VR is a relaxing and casual game where players explore a cozy, enclosed forest environment. With simple, stylized graphics and interactive elements like wooden platforms and tree stumps, it\u2019s a perfect space for unwinding, climbing, and playful exploration. The focus is on creating a chill and laid-back experience."}]}, "developer_name": "mmo0n", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicymandrills/home", "developer_terms_of_service_url": null, "publisher_name": "mmo0n", "support_website_url": null, "website_url": "https://sites.google.com/view/mandrillsvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "28016346821345620"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_appr
_ohc=QOZMJ_P1GA8Q7kNvwF3YlDF&_nc_oc=AdpWJizNa2rkuHSpFK9xlVhTJAXfesch52uDof8idqZw6M7Eqjppen_ge1Y22IV14X8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3knOlFArjaUqLVWaCeJg2APSJYOQ7w2JEF69QGtT1UBg&oe=69E4D7FB"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-30.png", "id": "606344938424319", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982715_606344941757652_5573548456782094684_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aO9IFH4Y5wAQ7kNvwFLL4ow&_nc_oc=AdocU5MaE_uWQhRF2UI7NPeFEbifP89S1-VvFJW-AZ24e4U4cxZJfeT1PiLYnOS6aNE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gd5SuMJZ6SB_xg2RV8vzmBewPZDFeQknf1oTMSZ-ZTg&oe=69E4C92F"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-40.png", "id": "1235930147465651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001697_1235930150798984_1865019294501584451_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pn6T_ooUgKkQ7kNvwGuBjqW&_nc_oc=Ado1r6UZ_V0kOlRTar54AL5WXoPBzyGx6K_yYzwdD-88Xpr7D_xQWZL2J6MVOfbFKHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EHPWRoqpCyR8Fw9onX6LZC4npXtOOajemTmN4H-TKuw&oe=69E4D133"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mandrills Main_Custom..._25.12.2024_22-14-26.png", "id": "580119351293665", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031398_580119354626998_4396366189324284114_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHj0sbM7S7EQ7kNvwE6vu5s&_nc_oc=AdrJ-MNDlV554m3u-MXJ1qdmfWc6Q9XD6Uz6JhWIphYvbZbHIdiU_lRmvvRX52h-mUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hCmHRO4mIkeN7a80emhW6BANIh2NtwHh0DOEilb2cXA&oe=69E4D277"}, "display_name": "Mandrills VR", "keywords": ["cozy", "chill", "fun"], "long_description": "Mandrills VR is a serene and immersive game designed for players who want to relax and explore at their own pace. Set in a stylized, enclosed forest environment, the game features a tranquil space filled with interactive elements such as small, leafless trees, wooden platforms, and simple structures that invite climbing and exploration. The grassy terrain, surrounded by high walls, creates a cozy and contained world that feels safe and inviting.\n\nThe game emphasizes a laid-back experience, with no rush or high-stakes objectives. Instead, players can enjoy the freedom to roam, experiment with their surroundings, and take in the minimalist, retro-style graphics. Whether you're hopping between platforms, discovering little details, or just soaking up the calm atmosphere, Mandrills VR is the perfect escape for those looking to unwind in a virtual playground.", "short_description": "Mandrills VR is a relaxing and casual game where players explore a cozy, enclosed forest environment. With simple, stylized graphics and interactive elements like wooden platforms and tree stumps, it\u2019s a perfect space for unwinding, climbing, and playful exploration. The focus is on creating a chill and laid-back experience."}]}, "developer_name": "mmo0n", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicymandrills/home", "developer_terms_of_service_url": null, "publisher_name": "mmo0n", "support_website_url": null, "website_url": "https://sites.google.com/view/mandrillsvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_U
tQ&oe=6B033006"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-47.png", "id": "1747050112694441", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75269160_1747050116027774_3486763604323309054_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYXxfyqCcmcQ7kNvwGVI3Si&_nc_oc=AdoPSX04gKPHnSKFZdGdd48ddcdfmdJL7M-u4ksBQXe8atAdwGoI-3x4ws6PP3JyYVY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRsu6u49EvYDBKZTREN0hfXdyzky8wzI0yCuFKiVpFbEA&oe=6B0325BB"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-30.png", "id": "606344938424319", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982715_606344941757652_5573548456782094684_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v_oTvDB54RwQ7kNvwFmp9s9&_nc_oc=AdoxUDaUdy14nQl-4n0H0-T9XoXvdUYq1DK-xoQF3Z5QLoqT-qsGvY5L6kzhgxGuOVQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOJUtwNNNGM73GTRw6gz9FbOHmEUu-fKk1yMbY6qHR3Q&oe=6B0316EF"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-40.png", "id": "1235930147465651", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39001697_1235930150798984_1865019294501584451_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrQl5F4NA7YQ7kNvwHXU148&_nc_oc=AdoKMPARIsaHSIb5FEzIZHEt2J0j_xMfZQs03ESoZixjuWbCg6m3BTiJc3W41-ov7Jc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFNaWUtc_h0Abdn2Qc_8kfMb1R8VIbaCLpcyCgkT82nw&oe=6B031EF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mandrills Main_Custom..._25.12.2024_22-14-26.png", "id": "580119351293665", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031398_580119354626998_4396366189324284114_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UaVPFgmDNc0Q7kNvwGqK0Qv&_nc_oc=AdqsQer0EU31G0u2MEIr9K9ipzulgTy7vYJMGVm8mMgcY_sDbjLCHv_X84ArXGzU2bI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7ilF0QQJMWGMoi5aYK66PWZip8_vAvxP2_G_072ky-w&oe=6B032037"}, "display_name": "Mandrills VR", "keywords": ["cozy", "chill", "fun"], "long_description": "Mandrills VR is a serene and immersive game designed for players who want to relax and explore at their own pace. Set in a stylized, enclosed forest environment, the game features a tranquil space filled with interactive elements such as small, leafless trees, wooden platforms, and simple structures that invite climbing and exploration. The grassy terrain, surrounded by high walls, creates a cozy and contained world that feels safe and inviting.\n\nThe game emphasizes a laid-back experience, with no rush or high-stakes objectives. Instead, players can enjoy the freedom to roam, experiment with their surroundings, and take in the minimalist, retro-style graphics. Whether you're hopping between platforms, discovering little details, or just soaking up the calm atmosphere, Mandrills VR is the perfect escape for those looking to unwind in a virtual playground.", "short_description": "Mandrills VR is a relaxing and casual game where players explore a cozy, enclosed forest environment. With simple, stylized graphics and interactive elements like wooden platforms and tree stumps, it\u2019s a perfect space for unwinding, climbing, and playful exploration. The focus is on creating a chill and laid-back experience."}]}, "developer_name": "mmo0n", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicymandrills/home", "developer_terms_of_service_url": null, "publisher_name": "mmo0n", "support_website_url": null, "website_url": "https://sites.google.com/view/mandrillsvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads"
OA&oe=6B083DC6"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-47.png", "id": "1747050112694441", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75269160_1747050116027774_3486763604323309054_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZLOZI8nRekQ7kNvwEI56mo&_nc_oc=AdruQwZCOqpbAAEBSGHu_ayhsi5R-IP4-FUraWLqGM53BP4lk8McTTWaGqo5UlCvX1k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT861QRycql3EcyvLMWEB5FioP-j6NM8dSev7cAFWPMpQ&oe=6B086BBB"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-30.png", "id": "606344938424319", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982715_606344941757652_5573548456782094684_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=or1MojfqDCwQ7kNvwEw77Qn&_nc_oc=AdpLF01tNyAgeFq5GM3U_v-cK-qyId-uY_pCmrKA8pGzVQHpo66E4syYZDAOWrteEFg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRnCr5fEv5FTAPaUrW8Qu7pC-etiFYXVIM0faz-k7Qeg&oe=6B085CEF"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-40.png", "id": "1235930147465651", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/39001697_1235930150798984_1865019294501584451_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYttfQGbJNAQ7kNvwFtxwV-&_nc_oc=AdrHwqMnStRYMk35mPLvTdEVMCDQL_kFcIzTX8LHU6kRop6g6D6qEektHZFIPkjuK4M&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHrGpT3pijtayHJYZ2r8-hhaQ5PQA94mwDxfasPdRudA&oe=6B0864F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mandrills Main_Custom..._25.12.2024_22-14-26.png", "id": "580119351293665", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031398_580119354626998_4396366189324284114_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZgPc80kfIkQ7kNvwGgrZIs&_nc_oc=AdpOBVsybOn-K5xSEPPDWfBROTMs5ZVjzYcmCD0jk0PXTaa3gkbhNtpxfdR5d0UI-hA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbrh8Bz7EsiK7UkW_baWPqr1Glb8vuzNf0MZ0XXcDijw&oe=6B086637"}, "display_name": "Mandrills VR", "keywords": ["cozy", "chill", "fun"], "long_description": "Mandrills VR is a serene and immersive game designed for players who want to relax and explore at their own pace. Set in a stylized, enclosed forest environment, the game features a tranquil space filled with interactive elements such as small, leafless trees, wooden platforms, and simple structures that invite climbing and exploration. The grassy terrain, surrounded by high walls, creates a cozy and contained world that feels safe and inviting.\n\nThe game emphasizes a laid-back experience, with no rush or high-stakes objectives. Instead, players can enjoy the freedom to roam, experiment with their surroundings, and take in the minimalist, retro-style graphics. Whether you're hopping between platforms, discovering little details, or just soaking up the calm atmosphere, Mandrills VR is the perfect escape for those looking to unwind in a virtual playground.", "short_description": "Mandrills VR is a relaxing and casual game where players explore a cozy, enclosed forest environment. With simple, stylized graphics and interactive elements like wooden platforms and tree stumps, it\u2019s a perfect space for unwinding, climbing, and playful exploration. The focus is on creating a chill and laid-back experience."}]}, "developer_name": "mmo0n", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicymandrills/home", "developer_terms_of_service_url": null, "publisher_name": "mmo0n", "support_website_url": null, "website_url": "https://sites.google.com/view/mandrillsvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads"
3w&oe=6B0F0D86"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-47.png", "id": "1747050112694441", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75269160_1747050116027774_3486763604323309054_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePXLtHcFUNkQ7kNvwE85loN&_nc_oc=Adpyu9sRLW_I0splpl80U--3hdn-TIvb0_UDwjUzFQzwwo6ao8S6uGsX3ez7xv8G2u4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXe2UuIv6EuunLDJiKQsnCj8oQy7jlx2jIxj2WGFOd60w&oe=6B0F033B"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-30.png", "id": "606344938424319", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982715_606344941757652_5573548456782094684_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YovZ1lPDvPAQ7kNvwE2ZHNi&_nc_oc=Adre6Ub0PPMq6Re7-I68M8kvYAFXMTtGT2hU1iPNcmVNjheCrJy1_MhNIThEoRQ47kQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWZdmPbiMCNijEHQPXhKdUWGc-ogEkfLLX89E_3uMeFWg&oe=6B0EF46F"}, {"file_name": "Mandrills Main_Custom..._25.12.2024_22-37-40.png", "id": "1235930147465651", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39001697_1235930150798984_1865019294501584451_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z82aPQqymfAQ7kNvwHeuVM8&_nc_oc=Adp3AJ_jhi1wsnjmTBKEHdG4ZDPX9m-iZ0ES9czpGdXQW1lmaK10lld8_jc6puA794k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXpPdisZeZeduInLc_vRGiLKOhoyPZsv6Z2BOpkZH7dHQ&oe=6B0EFC73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Mandrills Main_Custom..._25.12.2024_22-14-26.png", "id": "580119351293665", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031398_580119354626998_4396366189324284114_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ig8Q0ZCuiYQ7kNvwEThrZY&_nc_oc=AdpjYwl8WnVBPXDRDeV3PxVh9I8rqZmI0OXS0RydtfiqNKMR3W7mUzwRU9ZHhAbC1BE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVdTxfxndX4YUwkKGLm3GsfgqVXx4hdbi65-3o6EActlg&oe=6B0EFDB7"}, "display_name": "Mandrills VR", "keywords": ["cozy", "chill", "fun"], "long_description": "Mandrills VR is a serene and immersive game designed for players who want to relax and explore at their own pace. Set in a stylized, enclosed forest environment, the game features a tranquil space filled with interactive elements such as small, leafless trees, wooden platforms, and simple structures that invite climbing and exploration. The grassy terrain, surrounded by high walls, creates a cozy and contained world that feels safe and inviting.\n\nThe game emphasizes a laid-back experience, with no rush or high-stakes objectives. Instead, players can enjoy the freedom to roam, experiment with their surroundings, and take in the minimalist, retro-style graphics. Whether you're hopping between platforms, discovering little details, or just soaking up the calm atmosphere, Mandrills VR is the perfect escape for those looking to unwind in a virtual playground.", "short_description": "Mandrills VR is a relaxing and casual game where players explore a cozy, enclosed forest environment. With simple, stylized graphics and interactive elements like wooden platforms and tree stumps, it\u2019s a perfect space for unwinding, climbing, and playful exploration. The focus is on creating a chill and laid-back experience."}]}, "developer_name": "mmo0n", "developer_privacy_policy_url": "https://sites.google.com/view/privacypolicymandrills/home", "developer_terms_of_service_url": null, "publisher_name": "mmo0n", "support_website_url": null, "website_url": "https://sites.google.com/view/mandrillsvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1592192974313489"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads"
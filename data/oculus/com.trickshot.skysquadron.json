-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IzelS8VLp0Zx9zgVdKBSxV1W74xGPVQojrCB21_M8Ug&oe=69D7B829"}, {"file_name": "square.png", "id": "155847846345518", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031502_155847849678851_4510571598378776957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo6GdytSDzAQ7kNvwHEgyhX&_nc_oc=AdrNA31FgTg_taa_l3AC8kN1pdPMAR-4RhvSyIJOJqiGlva-d8jT46BUc3lTatdvkEo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KKCA9ELW0dOlo9sKVsKQc7OeYx1WuGTOb24jDOlR62Q&oe=69D7899A"}, {"file_name": "86616643_628527301037753_4935761023400411136_n.png", "id": "118385830115094", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75655852_118385833448427_7261118773013276707_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjzaAyRFxgkQ7kNvwHQldF9&_nc_oc=AdrZwXkIXV2AigVzAmiSPot7TQazLsktTsMFhqSaDLXSejp7qqWsQjBUTGqhnrgYQB4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0kGlfaqTEbqlomCuZ3op_LGxSWw5wvzBRIMnpbQ-cZsA&oe=69D789C4"}]}, "id": "940035830615069", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_01.png", "id": "330189238263293", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974730_330189241596626_3504081645159931413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kEMwxaq7FmAQ7kNvwHv8pjg&_nc_oc=AdqrDQsMWoUAPZRDJljwvE9ji58IWa2A0KE-V40KZcGnSPvU021BI1krKwSgiD6Yy6Q&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y_ad5HdoyougKgptIyFi9sYhQZej-nT99mHECPEp5SQ&oe=69D7B27E"}, {"file_name": "Screenshot_04.png", "id": "331564628107224", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035450_331564631440557_9048855752575604372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLkRPvXECAoQ7kNvwGz4usT&_nc_oc=AdpH9ci7M2mLQG5mCDm1oD2wvxOnAN9bMYm8aKzwoRV2zZCI99gid9Yh_JsJW9IKFx0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-uz37HnTFkBSsi3GSw8zgoxmaZPNvfF5RLEi3_GWJUA&oe=69D78932"}, {"file_name": "Screenshot_03.png", "id": "243208007303085", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974702_243208010636418_3611120165931760364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqrl07tM9MIQ7kNvwGkEV1e&_nc_oc=Ado-SjjpmunfS0PHskx1MxPFBKE9UPI4KavLmFmayHAkkTO6aa0MClw02IC7txLEHfI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JJoP3jkDnSq1zK9vTVRJn4cHCLrKU_1kC8WOp59HzNg&oe=69D7BD91"}, {"file_name": "03.png", "id": "172962897955001", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035320_172962904621667_2608548065462889890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yXXoihPWYIQ7kNvwE7d7RN&_nc_oc=AdpGUcgskorWD8Sh8DDnjBDgzDTyz1kAec0cbW0D3MBp2rc6qyQWkIblZs2oZPHvMVY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HnjVD0mH0g1_5wahkRkVdfbGPxsohBiASWP4wTfGPBw&oe=69D7B9E8"}, {"file_name": "Screenshot_02.png", "id": "408947180396198", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031385_408947183729531_4120429492114197544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43UBEXQ3gr8Q7kNvwG7UuQT&_nc_oc=AdpIdCy-uv2C77MiyU6n_35Dqq6yD9cqfUjCCgStedqIlnELhiQhB6tIK19HojsMR3k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Z1uQfZ9aYEQJ-3UEkK1DqZ932AvBoL8OGFSaFZ6aGjQ&oe=69D794D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sky Squadron Demo", "keywords": [], "long_description": "Have you got what it takes to keep the skies safe from ruthless villains? Your island paradise is being invaded, and hot-shot Keith Koala needs to jump into the gunner\u2019s seat and fight off some of the most menacing meanies that the Aussie Islands have ever seen!  Grab the controls to blow them out of the sky before they plunder everything your home has to offer.\n\nIn Sky Squadron VR you take control of a plucky Koala and his friends while they defend their home from evil invaders. Grab the gun controls by both hands to aim and shoot in this classic arcade rail-shooter that sees the player destroy fighters, dismantle giant bosses and repair their plane on the fly. Invite a friend to join you in online co-op, or compete for the highest score on the global leaderboards.\n\nFeatures\n- An Australian take on the classic \u201cStar Fox\u201d universe with a WW2 twist\n- Online co-op to easily play with friends\n- Branching missions with different objectives\n- Fully destructible bosses\n- Compete on the globa", "short_description": "Jump into the gunner seat and save your island paradise from the evil invading empire! \"Sky Squadron\" is an Aussie twist on \"Star-Fox\" meets VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development PTY LTD", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "241719458438280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031502_155847849678851_4510571598378776957_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6
reenshot_03.png", "id": "243208007303085", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_243208010636418_3611120165931760364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRaJhOic8TAQ7kNvwEAh0Np&_nc_oc=Adl2daEoZK1e7HoL3vMD0ZdrCBaHzYWQcbjioC6t5-5HRjml2C-tYkVnDXPI3OK0zUw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzCeAK2F_SckQr8ADq638nGUpYmRIpj9ploc9RLTwNWcg&oe=69AD5551"}, {"file_name": "03.png", "id": "172962897955001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_172962904621667_2608548065462889890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=biQuNJyxMUUQ7kNvwEM8Jd-&_nc_oc=AdmancGiRhSwUO_AQZB2qjHgNZjVt9a7t2P1Aw5Rp8jbIxuRojKiT1_uesiQrzDM06U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzooNJVhDi-MQ7yAY3vyNz0pJHxpjI2UnFFvW3CBLUhIg&oe=69AD89E8"}, {"file_name": "Screenshot_02.png", "id": "408947180396198", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031385_408947183729531_4120429492114197544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lQ739gGrpEQ7kNvwGPz1o7&_nc_oc=AdkC3ZWI2VX_tTKYU4NaPVLIThVEFVO1kcgjT7qYRzs5hlR8Z2sLbH_wyS6iVSjNMyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOFg9Ykbhf_X2ZNRhoJsJqwkxEj57hc7UZDGNyABsEVA&oe=69AD64D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sky Squadron Demo", "keywords": [], "long_description": "Have you got what it takes to keep the skies safe from ruthless villains? Your island paradise is being invaded, and hot-shot Keith Koala needs to jump into the gunner\u2019s seat and fight off some of the most menacing meanies that the Aussie Islands have ever seen!  Grab the controls to blow them out of the sky before they plunder everything your home has to offer.\n\nIn Sky Squadron VR you take control of a plucky Koala and his friends while they defend their home from evil invaders. Grab the gun controls by both hands to aim and shoot in this classic arcade rail-shooter that sees the player destroy fighters, dismantle giant bosses and repair their plane on the fly. Invite a friend to join you in online co-op, or compete for the highest score on the global leaderboards.\n\nFeatures\n- An Australian take on the classic \u201cStar Fox\u201d universe with a WW2 twist\n- Online co-op to easily play with friends\n- Branching missions with different objectives\n- Fully destructible bosses\n- Compete on the globa", "short_description": "Jump into the gunner seat and save your island paradise from the evil invading empire! \"Sky Squadron\" is an Aussie twist on \"Star-Fox\" meets VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development PTY LTD", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "241719458438280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031502_155847849678851_4510571598378776957_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFYExMHW2c4Q7kNvwGLdQC4&_nc_oc=Adl
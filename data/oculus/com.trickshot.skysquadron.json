vNQ&oe=6A0B2BF2"}, {"file_name": "Screenshot_03.png", "id": "243208007303085", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974702_243208010636418_3611120165931760364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mcNdMte-VycQ7kNvwEvB2v2&_nc_oc=Adr5s-k-ErKczqNsUm8va8fh6eE7pg5ipbwu01f620U6Qz9YqmezQRybC3xw_Hdm7Uc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SbOZydK8WTUGhIFPSpiw0oyTHX8i34VieLK7O9fANqg&oe=6A0B2811"}, {"file_name": "03.png", "id": "172962897955001", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_172962904621667_2608548065462889890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pI4mq3e6AiQQ7kNvwF96m_T&_nc_oc=Adp-euZry9cevK0X9eyw6inVXudfBH7Nf3ZVnW_E9xoi3RfaA9RVufUmD2waZ-elHHs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52bY9SRoj_7GdktUrE6s8wSWejuNEo6vb836UVa4pHhw&oe=6A0B2468"}, {"file_name": "Screenshot_02.png", "id": "408947180396198", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031385_408947183729531_4120429492114197544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rWKt4kfGAJYQ7kNvwFUJi_y&_nc_oc=AdrGZxI1tP4_p7fbxYyQ2mk35tPrkyNI_VloqlLsWAdBY-1U_Ey-d3YlMbkMgh4O7m4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SHO2CDbV3bczKWh2T0uOb-knlm7otwNJeTHTlejdguA&oe=6A0B3796"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sky Squadron Demo", "keywords": [], "long_description": "Have you got what it takes to keep the skies safe from ruthless villains? Your island paradise is being invaded, and hot-shot Keith Koala needs to jump into the gunner\u2019s seat and fight off some of the most menacing meanies that the Aussie Islands have ever seen!  Grab the controls to blow them out of the sky before they plunder everything your home has to offer.\n\nIn Sky Squadron VR you take control of a plucky Koala and his friends while they defend their home from evil invaders. Grab the gun controls by both hands to aim and shoot in this classic arcade rail-shooter that sees the player destroy fighters, dismantle giant bosses and repair their plane on the fly. Invite a friend to join you in online co-op, or compete for the highest score on the global leaderboards.\n\nFeatures\n- An Australian take on the classic \u201cStar Fox\u201d universe with a WW2 twist\n- Online co-op to easily play with friends\n- Branching missions with different objectives\n- Fully destructible bosses\n- Compete on the globa", "short_description": "Jump into the gunner seat and save your island paradise from the evil invading empire! \"Sky Squadron\" is an Aussie twist on \"Star-Fox\" meets VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development PTY LTD", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "241719458438280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031502_155847849678851_4510571598378776957_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6
-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe709Y1vn4cARCdwRxcgB8_N9b0eiCVYc2FNbfe4TY2g&oe=6AF32AA9"}, {"file_name": "square.png", "id": "155847846345518", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031502_155847849678851_4510571598378776957_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLNRL8G_FvcQ7kNvwFDzWes&_nc_oc=AdoLsaqeuNdRzEaIUGexRb4jQGIB05hVYZZKejx4kKmVEiRsmYwBWkPIgrBmYBQYIUE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-WAoIDh8g8R5IDFvgJ1_ZtwYrAgn4GHAgubqREsL45w&oe=6AF3345A"}, {"file_name": "86616643_628527301037753_4935761023400411136_n.png", "id": "118385830115094", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75655852_118385833448427_7261118773013276707_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79mA_pc-iNkQ7kNvwGzOuq8&_nc_oc=AdrnRrrYM1Di6u7W4v1cxVqJcl0wqQjGvtnkdRHPvWrgvRR0Lvbepfga8dbKuViOS4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1irp5KpDSu2R438iRb4kYQLed59VR6prVtjmvQ7G2xw&oe=6AF33484"}]}, "id": "940035830615069", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_01.png", "id": "330189238263293", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974730_330189241596626_3504081645159931413_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wlVEBJu-j0Q7kNvwFGQ1Bh&_nc_oc=AdqGN9eg6dHcPSjqk5dGtuZXp9cqVIsn9el8ZcOcjRStm_9EiD_V94vtnu_YUfGXT_Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT71t5dnVoU3L1nV0ZA5m-Oux8vvfhVQFFRT0wjxtX78Q&oe=6AF324FE"}, {"file_name": "Screenshot_04.png", "id": "331564628107224", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035450_331564631440557_9048855752575604372_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqu05Fssb2AQ7kNvwEqFZoV&_nc_oc=AdrVHLlZ5AEdkFxDulzxdRO7xm26S8K6O1Tsn19I-QBmIZeymP--03YT98KTPoyOciM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRf8Nu_a7BB1gjlMp5Vp00hXyWa6CmMdVzb2WEUd5YVFQ&oe=6AF333F2"}, {"file_name": "Screenshot_03.png", "id": "243208007303085", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974702_243208010636418_3611120165931760364_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hcAl1D8C0H8Q7kNvwEMqK1H&_nc_oc=Adodv77U0q3TCTTa5AFWnfOK4CcFgnwKZhgfJULaHoeZW77qJ0eBW8336kQ1mCS18IA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXQZ0-L8QbLdDDsu9gdKyJ7eYQZZcz_a27VIJM-mVctQ&oe=6AF33011"}, {"file_name": "03.png", "id": "172962897955001", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_172962904621667_2608548065462889890_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNKE5-coeZMQ7kNvwFIjNLS&_nc_oc=AdpNUn_uidnQzhRebwdvn7WSU6fQlm3Tkk50q6vVN3MtZE4kfF5RcQnre9zhh1hfPEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpoUxmQPrqdkEzWYBawasmPoMIRXnLC61h6L-A1XM7-Q&oe=6AF32C68"}, {"file_name": "Screenshot_02.png", "id": "408947180396198", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031385_408947183729531_4120429492114197544_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqSsoqOmOqAQ7kNvwHFh4ni&_nc_oc=AdqkgED3nJliwlJZjemLag1xdfWxVg_Hr0tjm-OQXQU8qpCXNUQ43EvVyxmRzbpfwZM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmat4ZhrYlFxoWPmpq6iNM3JJLkqUU_21kh6IKE9WXiw&oe=6AF33F96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sky Squadron Demo", "keywords": [], "long_description": "Have you got what it takes to keep the skies safe from ruthless villains? Your island paradise is being invaded, and hot-shot Keith Koala needs to jump into the gunner\u2019s seat and fight off some of the most menacing meanies that the Aussie Islands have ever seen!  Grab the controls to blow them out of the sky before they plunder everything your home has to offer.\n\nIn Sky Squadron VR you take control of a plucky Koala and his friends while they defend their home from evil invaders. Grab the gun controls by both hands to aim and shoot in this classic arcade rail-shooter that sees the player destroy fighters, dismantle giant bosses and repair their plane on the fly. Invite a friend to join you in online co-op, or compete for the highest score on the global leaderboards.\n\nFeatures\n- An Australian take on the classic \u201cStar Fox\u201d universe with a WW2 twist\n- Online co-op to easily play with friends\n- Branching missions with different objectives\n- Fully destructible bosses\n- Compete on the globa", "short_description": "Jump into the gunner seat and save your island paradise from the evil invading empire! \"Sky Squadron\" is an Aussie twist on \"Star-Fox\" meets VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTsVR5zvtVSLBBmnyuJCb-8vKqFCG-v4egtNg28sD4SLsCwkJ3DAw8CC41bEaKPMxi0wxDfMeQYD9ee/pub", "developer_terms_of_service_url": null, "publisher_name": "Trick Shot Development PTY LTD", "support_website_url": null, "website_url": "https://www.trickshotdev.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FLYING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER"], "id": "241719458438280"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031502_155847849678851_4510571598378776957_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6
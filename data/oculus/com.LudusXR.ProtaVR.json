ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4nhB78ZSNxoQ7kNvwEFSSFJ&_nc_oc=Adpz8w9jAdodiKz2JsCV9ASKGJkXsT79RNYpP7x4rbn_ERX1dj2Gc6yddAiwoUYYB24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8SN3XEZyBMY7HGo-ERzt-tN-SU4O39FGEtG3_vzA8pA&oe=6AEF4C81"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvy8C86KxoUQ7kNvwGvOrrC&_nc_oc=AdrdXZUpZorRARIyNI9jfpRxyseSX2proHLO4dfuq9T3Y75FMKXfBY7QYAm98YNG1So&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVn7rMx_KQ06cTpub2zmpZNBn0lBQelYn-ruWB5um0ug&oe=6AEF4197"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFRoWmHEkhUQ7kNvwEq9tU3&_nc_oc=Adq4YeiFL22rlapi4VWLlPcHOmmZD8mHhRpouPbChgCIkqQjgZND_4HF72kzOTsmumo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_VfTXw2aHrmeN07DiGQ-lKUL1acOH74yI5J-BSSnKkg&oe=6AEF4B31"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bY29QKoBqYQ7kNvwEatnMQ&_nc_oc=Ado8Fg0KA7S9tovZD9i7C_xEwy0TCR7Q8vOtvhf4vXHhdOx8HoP6wNTjd-iMjh_aHkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJEfPHHF3Gp1YIcNiL__tcHnEGL2f6AFN_B8lQBqt5ag&oe=6AEF5944"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85trLDCEOxEQ7kNvwHC6k7K&_nc_oc=Adr5jYgIw01RyS9v_aAIbQyjhhInJhnhwqVpPPqwnF8z648w-8wncXM8FPhMTKxV37g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVl3Gmzq8In3lEYP0P-qpXm3V6xJaCgaIcHYRwfksviw&oe=6AEF4DB3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
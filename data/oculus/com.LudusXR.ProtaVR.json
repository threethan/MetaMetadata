601670", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8dFtt4adggQ7kNvwFIGp4s&_nc_oc=AdlQ9pvIbLY5JVkYx6mGVC2D44n-2hdb0rT5H7-4ck6nyjSVJ9nsx9zzilk_Kn0d0c4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-0444u7qcifwJm_ak4hVJbdthGp_OYAIVwLldun_uHg&oe=69AAC341"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEABiWGJ4rYQ7kNvwET-dmk&_nc_oc=AdmrORqt5-ibMs8ydLdYNQhb3BxdoZl23VN-10deHN6LBNBEv6Lk-MSqJJLi9N9EL5M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxCWRQWY0rc-TsGSAjsdLbGsIBoiKImCn_zyN_CpGm30A&oe=69AAB857"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjIdEuiw7h0Q7kNvwFBj0gQ&_nc_oc=AdnIsWooY0nY9lyNllRRVZ_F8o7qOxau97iXNftoHIkJRZ0XSSKxkbjJ3KkHKoVrEd4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxeJ9LyaTwtD7O8iepJbKaRMygFQXOJM0_UZxX39g0lcA&oe=69AAC1F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnmQJ18Y2GQQ7kNvwE96520&_nc_oc=Admcn8b5V5hl7GCYSABJTuWMaG38HwvnmZ3GM4y7EZY0zpQ9LvdUiJ-bzPQYA3_KAac&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy2NdFIiNCm5vcNraLSzPir4E11jCKd7iq7FTvMcwalwg&oe=69AAD004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXuNQurQnuQQ7kNvwGUVjRJ&_nc_oc=AdnvPc0gJL_6cBjQB7JCwArn87xuNBC9BS8DDtwntu9P1kK9YGCAIFztMtV8sh0kkpA&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfzxY-zmn4Y7d2diBOuJSQi8Fi6kwLjbvlQR5Zn6Q5a0Gg&oe=69AAC473"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommende
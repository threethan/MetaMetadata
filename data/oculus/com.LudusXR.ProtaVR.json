ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjPv6fJ1ZcUQ7kNvwEl3dVf&_nc_oc=AdoJeHLi_zCLciJBusi_RBRBcWV1WqeqmaXgTZY-4g8UYm9UcTKG2YHLEUB1KrSGhzE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7D1fO8IZ0RwBZz9-8vh3GJTJw8DW_T-iryHw4jYkMFYw&oe=6A0DA3C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXhE6xtArg4Q7kNvwHgYxig&_nc_oc=Adqzq4npWoe7Qhs44w-G-i9pu-dPHnPDQpeNzhaWlvRzOHZN6buLvOhtvt2i5LfBWRw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7KV4J-0pA7JXzX91tDlbBoccVjqEb4PmNX9CHnwYKzNg&oe=6A0DD117"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i52rX8zrFJAQ7kNvwFwDLKd&_nc_oc=AdpY0VMqRqmw4dBBUMVj7N40ZgX4DxMjI1mRFNLumFyEBn6pNtw4fifQ1Uc7NRFjx1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fegojO2h2jh0hmyjQ-OEBo7YvFPmBvLCI-d5MjFKkfA&oe=6A0DA271"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQPk1TYy39kQ7kNvwE4pF7E&_nc_oc=AdqkMliEc5i8a8XL7E7FA4aIKrwOWEc2BDOwNfxrbKGwKHUod4K54WtQoH9nWq3WsCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77MStqAHUKuYHvgT-VeQjculXtoSd27IWNI8APRusFrg&oe=6A0DB084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ4mM7jjNCIQ7kNvwG2ipxq&_nc_oc=AdqjMBDONbBBVsTbmRXXXHy6oJPJ20DGk-C7rrc2t8er5DWCwYd7lxxliABrAn2krc0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6k1D456HJmG_36YxIU96BYyb4RafdG0M1lsBfnwingzw&oe=6A0DA4F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
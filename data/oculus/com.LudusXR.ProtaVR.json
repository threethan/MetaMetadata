ota4.png", "id": "1510165476601670", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m7OZOSAn26gQ7kNvwGLSCYe&_nc_oc=AdrWbrH_j3Tqb0LFMhBS9LGyyib9tj1Lzn_VvTMl3sbVUTCHOn3jhYvNZTNEgPJ1ULU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPD39V-AwmOXXluPnA990lK1_W9eTAqzBua9jHJ5uCIBw&oe=6AD39D01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ht5NQYGFkQQ7kNvwHxO6G1&_nc_oc=Adob1IsH20h3ZM7sV6Yvr3M9j1B5fS-zXExWSTfxC-km83DWnfFOcF-OdpYlDDgdDEc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNxtXf-Q2O0hSWStY8dZ4cfExB2hBYvknW8ibLfYXSdPQ&oe=6AD39217"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMLXsiJXq0MQ7kNvwHRNkGO&_nc_oc=AdrChOMJ5yj6jSaZPueGMNJ4fXnBssSJXSpzeAgGfT_yPjiCnel8LyRT8D6yQxc-ZUQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMtlBIm_Rlypq9m7wXojzmhFRs5D2ATfVJ3UWD1UPK2WQ&oe=6AD39BB1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcI8fX66XHIQ7kNvwEMLYrB&_nc_oc=AdoolAqIfDDEV6_oRFzcOHXQP68LXt-XnqPHCbyr1BocGUTV7XpHom33nEs09NQqnhY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrSyy0velvP3IIC3W82C5BqSiUtamjWeP8PMqm1LzGyg&oe=6AD3A9C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ll2BZfWEV3AQ7kNvwF7pzd3&_nc_oc=AdqhZZqhHOwpwCYuQFll95KzhscRLYX1L7Dcs56ptLR71y9SbEQ_jC7dWt3iH_BULak&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOli6-_xfmPnOYAnDp2WUHSL0aeCylMJJl7Hq0URm5GpQ&oe=6AD39E33"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
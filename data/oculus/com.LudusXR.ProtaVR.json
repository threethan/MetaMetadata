ota4.png", "id": "1510165476601670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzUM8q67LpQQ7kNvwEzHmpo&_nc_oc=AdqVD_XTz27nc1J3jEkBxxKK14TzHcNnH4WEzlHsrFe6kBCrQLMaLNuu7mnC-q0wa1E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Mzp7uUfqrjuRD3OdTTWjylaT-zVbaQv6E8DmMcroO6Q&oe=69D25041"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqswKjmF7r8Q7kNvwGn8Q1S&_nc_oc=AdrjTNcSe1aNB-fAzRmWH230aSQSfrNDvBBc5B7yBhm_gy7bl7Avh5Lz42n9D-NTQQs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1U4Z4c-vXoujRdb6MgDXvq2gBCW29PEbz1lZvu3Va06g&oe=69D27D97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6rGcXTgVy8Q7kNvwFJtMO2&_nc_oc=Adp6RunRLgYqDM8kY3_kKef3ftLJYqiCsYyS0wtx812UvoCveOLBMFEsyuIM9kdlmw8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2szwyA1HACJisLXpP0XCt1okZbO8KrGnzlD2Zcwl3Zxg&oe=69D24EF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=go0WsLEvvrQQ7kNvwE0O3cB&_nc_oc=AdoILtuAWMMY7T8cxXsK_PJ0hJucQt3XnULWID2QqEMHJDdBqoz2V2I5b21ojYjcTNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qhksjzSLbsvuyopkLGK46z8nDC5LBy8DmetUoPVjF0g&oe=69D25D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9rwUNzTTooQ7kNvwFpZS2t&_nc_oc=AdpePm_qJb82d0M0auDMR8-7qYgEJ4T0U5WIhpG0Mi_2TS2nw5mW9RCmgoEqAWDZbp4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gJRr42QSTt17UN2Kojxiu-abnn0RYf3cZNZSRaPweXg&oe=69D25173"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
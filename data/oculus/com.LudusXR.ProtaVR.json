ota4.png", "id": "1510165476601670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilx6aSlq1bkQ7kNvwHyWYaS&_nc_oc=Adqd6RYVgN4MHhyO-tYFIVM6fRKSNgycQ1V4sz3YiuMoLFuJgRNMpiL_i5n-EECaOcA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzWRzQmjlJrLarohXn1hhMsrB8dlVaXz3whNHNIKHxAQ&oe=6AE21D81"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhiNUNMhGagQ7kNvwGQEXAK&_nc_oc=Adp4NnyK0GRx_ZbwZ9tSTUgKDPH5NpopC0UN1lTXwLNHMk3U7jBMXZxiJ7ajhZD_rVg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtWlhY4ucRWRvlWz8BceXIOuRSpXTtL5fx11Vuf_BEew&oe=6AE21297"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iY0pNj-Z3wQ7kNvwF2AOvU&_nc_oc=Adq0pIXvetRJv7otn61o7_QzNiWlJ7HGtxiPMt7p76nELzjMmXRBjjMXmB3r3Xz2fyM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPOnnIyaKvY0ZMe85NU275j94vmA6zzSJrbiY1yMYCPQ&oe=6AE21C31"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQ40LCpBRnsQ7kNvwEZquhF&_nc_oc=Adr-ta_bwUC4AnJSp3qJwSv4EirVZRNfSXpsDZVJtMz-tk9RWZRu9WEiu2x1f2KiQF8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdeGgLG-AuShMYvOU9b-SEgS4rOqgchoubYYgU_ZKJGQ&oe=6AE1F204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My-BUcFTeUgQ7kNvwHoauJB&_nc_oc=Adrt68o9ro8mnTB6MU_UsZ0lIooLIKPJqiRXh27N352lO8OSkoDSunLc3sjEMO666q8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTrPImjEV_cUP1Q-EgjyKEQZBECYtNpxkjLvYeJi4LyQ&oe=6AE1E673"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
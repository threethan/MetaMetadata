ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLiCocHkpPcQ7kNvwH5Cr6X&_nc_oc=AdqUEI1n34RnRlAdyIuM9wzwW7N2ZKAY3NxbcZ6ywQR0RpJwqYYkJt5_EFIJqGxzai8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIGj3URpmC6FE7bHTagcSRGnSxfCTfiPrO2Cd8S5p7vw&oe=6AB15601"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdoCK2uPwIEQ7kNvwFnxsFR&_nc_oc=Adph9uxkthrhWEU5faLMh9MFoxgvASCgoDo6Pircb_3-r5uzGikxkNTt7usi6I5XaFw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIu6fNRrbiZI7CExXGIDj477-8M4FYpdqXvkXQqFfFMng&oe=6AB14B17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dtFIDSU9mkQ7kNvwGWcsH9&_nc_oc=AdrzhSFIMTGDDZqnOoon6A242CQVBlvU4xV-Di8xKfux81mgxLAXMRWJKJPHzH3bSRU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaVwYosySAlQtROoNjvw_Iqzui2efinCAPX8XNTlzoAg&oe=6AB154B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7y0TNOA5zrIQ7kNvwHb_aq-&_nc_oc=AdovhClP5S6vM4M4sbxrP7J049svP4t4kdMrAnlDEoWlNfJmSHVmAfVQWLgjMSAxu0Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9ehCNvgd7rpyLS6mGQ8oMqkpdUPdJciPgCpGVgNa_1Q&oe=6AB12A84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQglJbXaieUQ7kNvwH5ndOI&_nc_oc=AdqvH4-aGkgje7JxLy1yLFMJPngI1nud4MKK81tjHbVkCH0K4brsmOH-hXL19S5rwBM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaqnWNrXIcEbRSGONOb8F4o4VJkbZ4lSlMvASp3XGClw&oe=6AB15733"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
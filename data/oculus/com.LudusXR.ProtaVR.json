ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0eimfbpeUoQ7kNvwHOXavT&_nc_oc=AdrMx6Bco12YBMMYZKtojc4ieexXtPNHzLITi3g_HEwqbFnoWr2MC8rUIydVkoB3Um4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIg_11DKuPM7vlE8OV3umLIxgtG0B32LK0VKOiUlvDxDQ&oe=6A984981"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiLuP3vFu3YQ7kNvwFYS8H1&_nc_oc=Adp69ztgL-1kBGjuYHXRFszigykXjb3Fxn1b6zZQe3ZAVEl9nipxI22N6b5boinyFZg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX0cUJ8QseoxkIgdqWv0U-wJrTgBPsx1RGqP1jraej5Q&oe=6A983E97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtiZzP_bikkQ7kNvwHuSfA4&_nc_oc=AdotznTziuaQ5wom9EJ18RXUXOviQt2ncGG-PsSgdbWTaiL-iY_jibUOi3prCNVABUQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYJmM7f6crzycoNYN7gYGwtk-4Dn8IRHzeaXGXVabbrw&oe=6A984831"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNSRfDk3rDkQ7kNvwF_P2xK&_nc_oc=AdofzUI5QkR1DgKuu2Iy0KuixH2WbiBUF0iPwYk9tOFTN-CYkdoM-OcCgd6pMfuAeP4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJD6UzL3SxVoys8a2El3MckYofvAcy_P1ZTV1cW_q5Yqw&oe=6A985644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cviyXoEPlqYQ7kNvwHiMxbw&_nc_oc=AdqSPd2JaRMryq93w5YfyuWxP8Y0g-vyvUHCiHe_5YCZGNxxYDAXFtmb4hJe3TdIeCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8XRVwPNkVljTW8f_VP41UYl9plEFWWwrFMMKfd_yA_g&oe=6A984AB3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
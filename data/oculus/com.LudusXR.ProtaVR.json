ota4.png", "id": "1510165476601670", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1yxHbSzR4kQ7kNvwEunIcj&_nc_oc=AdqQbwS5QPPZgd1SrotszOw61Hs-ezPh8ILTzKuxeWurUR7G_BxMlJR5Pwzh2cK_H-A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-k0JDsBzvTpthW4zR2vXp_uDc4d_ak2GKI-g3UqZbExA&oe=6A244581"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hgwQqt5X-gQ7kNvwEjaA8v&_nc_oc=Adrxng6jX96PcR07lxyJzcpZsq5WwHEVCz__lLiWxUV0f4M9qgAj_eeQ47Lk4-ZDZgo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NpYUNJ55Z1h3Ts9WBlJOtHUetPYw-2nxpC-NVE-ANkw&oe=6A243A97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0mzw1Q-ARcQ7kNvwF0yaPO&_nc_oc=AdpD2fSo3LzsU5BnMYU7tziU4G_HnUjqpqwhV6Cfn0dpV-NRZdFWlWkk6f1b4Xm0Ntc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RF3ipskyN_cpvRTwnTJGGfHiia0NkrC2f-lL2jXId-Q&oe=6A244431"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLD5mD_XYXsQ7kNvwG4TZ8l&_nc_oc=AdozVZ45PdI6lJyYiQwFgRtMNikkHpNaXEIuQnCK-M7FKDX2nm5dOTJ7zIs6PRKEDu4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af843U5ubxUYLd5tI8MHFChQIe5bsncXnFOUmjY7uzvHXA&oe=6A241A04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYPTligkcxcQ7kNvwEg3vin&_nc_oc=Adq38k7NgJwEiWjaVURmFtRwOO2yehcJip3yNm9nx0Oc3xe-k484RZyc7qSpUAMjJP4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-r1cP78KTnWMVG2OfAOGKyR5l8r4SHgI0DTKWI9UsycA&oe=6A2446B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhRVG-XUMN8Q7kNvwEIGSea&_nc_oc=AdpTcbzcuWUJZoppho0PzZNJCVq2wvq_gV6GKWba2pwkKLQu10K4F5gCMPe4Q9Pr5zo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtdg8F3xpo-_JmOBJnExaDC63lldMeRHQIGKj_cYSYtg&oe=6A771BC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuM2GXeQjJ8Q7kNvwEgyody&_nc_oc=AdqWcrdYeU31I_VM130jk7srrLCv4hspTBwjbGSmDBqpatn7tjnYNSTL4MLyrG9qJsg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKDYeBqjgLALYwUwEfolufFlaR6LQkkP5kgsO3oa760Q&oe=6A7710D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRD3EFRGaWMQ7kNvwH7AkCF&_nc_oc=AdoRzfFrkokZIKOuCL2TCjBX9YaekEAPhL_xv5LpZ-cs53celJNdI_tZCNebqMPCZ3s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtUvpYwopr-7pBZe99kIf7Pp4H9NKPYdJN3m0H40Sv7A&oe=6A771A71"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBEBuWXyHE0Q7kNvwEXfvDg&_nc_oc=AdoiWmMSzLTsKBjp-vRZNKqUiVoC6eDnDt8qtg3Z8veZNefduQorjzglbBZ-b66Lv5M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRg3i4qdjmND9x4OkjkFB2pGlxGJzP2smI79PU2FU5AQ&oe=6A772884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEcFTU8xty8Q7kNvwEn2jqh&_nc_oc=Adr24rllk-9SlDu0UIzw8CmvUGMNDWz5qt3pfRE2fol4LL_S70COr7HCGUl8FRAxT70&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJOglKdUEpsZ9vn8c-PevriZsg3eNDuGabdQtVDi7HKA&oe=6A771CF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc90794LsDcQ7kNvwGbFlfA&_nc_oc=Ado4F8fjTC7OMNTxInG2aPEQfJepVMtpElrPpvrGlfVzhCLbXaRaFZkdTU5Op2aNQL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4ep2E_8iY0nrK8nbPjpvNhUjoO3HjQiVCXBkpvLUWeQ&oe=6A64A6C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlGtWrbZNj8Q7kNvwHrxGHp&_nc_oc=Adqc3NCM6lyqg-dab3Dsnxskxt6BSCLL8jN1e7RCJtj5aC_wW9odzJk4GkhbCktTn2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB828iaH3G5PUSo72lTxOgmTBSStaR2_3aD1BLtZxvgOw&oe=6A64D417"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmfrGhqk5-kQ7kNvwHwIf6o&_nc_oc=AdrHJxvoYDYY4HE6UehsXpmW-q9njHgG8Ff3fHlAo-iD_vhY8zvOy7WMvIniAm0NQcA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWWZ-3yT_JMRVhqMcK62dItesCgm3FpFFppGGgp7bg6Q&oe=6A64A571"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdWJodzYHjYQ7kNvwGDbXsW&_nc_oc=AdpAuNAErfba6JoisDViWIWdoSW52y4n05c3kUojVKxuy0cmwf8a4CCBFrGjsPT4xYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBao06y8UKEWo6nebHfrtyLGsIrqvi5xCxl2DcqP1hwzA&oe=6A64B384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_OvM7CnDawQ7kNvwEvdQC4&_nc_oc=Adqbhz1dEfyJM02wpRwoEJJLdXtdoamzovivqJSuYo7iOmXYoMR4spMWeL31k61bj1k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0aoY1wlBcg0iajbxVHy5lTYLcgT3ZofpH5C8cpRo6lg&oe=6A64A7F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
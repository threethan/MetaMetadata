ota4.png", "id": "1510165476601670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPDGZfZWWbwQ7kNvwEQoifQ&_nc_oc=Adp1pyXfA7JtqjHwRp5MV8D49GZ2T_qA-F6spqKDD7qYrIZmrnHxZ8k3tsaZhHmheow&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzotLSsmmbAYe8870f_8jYwwpjdCSASCDYQX5RZfcnF3Q&oe=69C672C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDoHehs5TUUQ7kNvwFgFKJ2&_nc_oc=AdoKBk_dtVc9hL38ZDSUSe0QMHBbsjrzYHcuWQZZi7NNWr9uUJFQNj3bSzz5wsuPCT8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyX313joEYlrOhSfL0reAxF98sIhWYZ4RXO3BRE53L4CQ&oe=69C667D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMmySMw8GCgQ7kNvwHgy6ar&_nc_oc=Adoe5x3h4z3c9HzsU4gEV9DqvF5vdFEppi7LxPym_e9XZMdZEMDftbMTLLGkjIituS8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbO6QmmjqGSyCnfK0lArFEdLzo-zEI0J55pdYxdOZMMw&oe=69C67171"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kx6rpqz_GgQ7kNvwFO8x_Y&_nc_oc=Adq2sNBuqx6jNMiqbx3fvGRWGXGRX5y72ZUoWhWCpnPvB_p2GJ6aUKO7onhMHt-zHSg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBw7SnO6mJ4JWNRy4ZT1U869EaRNiV8q16RCmzyxpo6w&oe=69C67F84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8hnCtuUZmMQ7kNvwHDf9WV&_nc_oc=AdqJnsRSBAB2JV7H7L8G3kKD0-nJ1-oCtHsTHrBW9vo1WXuKrx5UZd6j49_63MmYbys&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwN0-EZIn77SAFIccrFZlsEJbt83DzZC3PSvJ1xk4-FZA&oe=69C673F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
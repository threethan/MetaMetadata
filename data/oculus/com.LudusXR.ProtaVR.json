ota4.png", "id": "1510165476601670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DkkzCZeCccQ7kNvwFDDjNa&_nc_oc=AdoLGp9eGCOdS0Y3OLXirnzRIUFm0HZTgOXGXIu2K2lwsIc6iZ7TzNtUI2riUsXZYcs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx3q5UZQk5TzQWpQf2EAOR1dO153_6hd5E-OoJyCOE-7A&oe=69C27E41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9sLpjVfjJYQ7kNvwHkFO52&_nc_oc=Adq11CVtKLnvBd7hO5RWjE609nr-_MkG3itJ8JLLH4VcwEJUv0W942WFn-mjQbj05xM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8Rs3CKad9srqfk-XLcs311BCnpch7gmg_SDyWJ4nYQQ&oe=69C27357"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uG-FBzMRDUsQ7kNvwHLWg7s&_nc_oc=AdqwFkzqQaQ0kkMcmPuOAkMb-zuatu1DAjLVJvXVnxCi13Nxxkw_t6VbZDiCiMrYSpk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxL4lyjVlEna-e6sksdFLZnrb1g5XJnAGai5E0EeI78Hw&oe=69C27CF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CI8_D0tGfZkQ7kNvwFH9N9Z&_nc_oc=Adrh6bNrPdRc3-YVeyEjrrFZIEKuxStRbsMvFpTWWbz20tFA_7vqTM7vij7s27mCtvg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzbghx2vD1sVLKAfR9RMzVqcA6EKQC-33wyYn0KnqJboA&oe=69C28B04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeLCvq9BJ70Q7kNvwEMq3ws&_nc_oc=AdqtS9cDWqBVkpZgULzzAVJL_9DfTgoLVnnTO0UcPZ5GJxOp4tPCAlWiSRFL3hHmr84&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZY5rZNuDjd0q6qq7kOf1m_nlfTL0m12xD6y6OBEI6QA&oe=69C27F73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
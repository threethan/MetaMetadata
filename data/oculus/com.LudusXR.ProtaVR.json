ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDS2z3uno9cQ7kNvwHk5kPw&_nc_oc=AdqLR76dWlH7D_dFPUOlI2DB3KHGczUE6K8BGk6oDaq2DZiQA5IPnZi_SoOwf6gKzlk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrlWl5UznhGrn-G2Gg8qloO2gIhChMLZQaRXqnzfIvbw&oe=6A844AC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tCD4j3KlMMQ7kNvwHpeXEk&_nc_oc=AdqH-0kMMq_bXawgQRsRdbsnjd7A3e5L_wvK0JKMQrnbw8jw_a7O4uBJMZN1peIRM3s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH85O72zOJjSRfiHlCOJvR-1mUAVucviLmgpRlDpIKSuw&oe=6A843FD7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDRzQpFaiigQ7kNvwGE4zYa&_nc_oc=AdrEB5pEk8N6wdwWzX278jnEQYkmH6mQXEMTIsONPffVDHCVi6e0IeB88d8NTAsq7eE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcL2Rx0H-WjWv9TJonxW3NzwGwzDj8WLCFtAnBMSzwKw&oe=6A844971"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INXivNoeqPUQ7kNvwGCq-Aw&_nc_oc=AdoDWrA7XTnE_JPyYVTfm-QKr3Rvi8Wg0mXdtU_C6jUoW0jD11G3UN1cBRy8akWcx6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd4LsSczzpQYVk7UwfTazdvW_x-HinNSHYfyPyLJTsag&oe=6A845784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P026ZW7ctXUQ7kNvwGt1bs_&_nc_oc=Adr7VMjrzFnDJ5yXLmYQdXw4NWFDGoqwf-2T1MowcHUWPgXjctkBorjGoOgAzH9YhgY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHA4P7q8Ax89H0Ab5jTlMyMAGAb0kKNOenCubuNuigQQ&oe=6A844BF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
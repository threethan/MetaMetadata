ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Uhqhp9dkLkQ7kNvwGMk79k&_nc_oc=Ado8iCBbJOoCgjLTNPk49dkNWEmTHiWPElAC3xbwhkCQUnPDhSgP095tsbgX3jRLfcY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0fc1gqeUw6VHwLo4wUBaSYofXXOynRfHlF41p30Tr62w&oe=69E8B9C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwoCLIwfEYMQ7kNvwHXB7ar&_nc_oc=Adq_ugkZYYvEk8J789am3T-M13bnVWkq-ngikpY6OXJfeF2R9czUq_ZlWlfBQn7hXsA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uSTP9yp2QeK8DMRJMzoWrUfuoT5vLMSsdU2fNfmB67Q&oe=69E8AED7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2IJqEeAfJUQ7kNvwE7Zo-r&_nc_oc=AdoIs4iPICzBXpdohDOBmwW39UqZEv8pKUD6jUzYVnlCZ1HzL7U27D4EgEQbVxEH0fs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NueehnyWMmXWu336XC5IIR6xjFy3CF8zZQ8kg58h5AQ&oe=69E8B871"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7uCwwj_EloQ7kNvwErmqtD&_nc_oc=AdqE7-R8LwAbcp-m_nykbEdB-N7WNQllGcpwn_alLZDAm5cbiira58wY8NLsKzFqDnc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HEThthHcrDdBAcUwRjDsfX-GR-eC_yzfoq0I-IePSQw&oe=69E8C684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsYY4VE9hDoQ7kNvwFx8AUf&_nc_oc=Adro0LPW0OHsD9qZJyQ89OR4ntFD0UEe6ksqDLzdOiXB8b44zjz_seBY9S0XcQ7XVx0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13O9TvyjUdbmZXjJKvgkrhOdv8Sj7Hbr-CoLFuQWpy8g&oe=69E8BAF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
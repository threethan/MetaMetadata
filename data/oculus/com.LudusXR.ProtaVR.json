70", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4Lp8SD8izIQ7kNvwGs-j8s&_nc_oc=AdkIXFWTOYBwL6f7Z_wsUgaUDH6osdkd3li0O3iHdlwHwKGnQ4s9Yh7Jzcg6BKcKWrQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGH3uWPd2XLIhrDiARqPOZelPKtAu8zeGzXxt62waTZQ&oe=69BBE6C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoyD1kegl6cQ7kNvwFJ1B5X&_nc_oc=AdlU3wi84J5I-tm3CfRsFj9myHB_oN30sGU2FsewwUhA84nIwBWyHee-SL5eTL2TaRg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzoL46sNTlxMmIsZy2dfFxTiGZBkO6jmCpBIt5m4Y9cXw&oe=69BBDBD7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kw8IK2y0YtIQ7kNvwEplg8R&_nc_oc=Adm45TLJ8zQmSx6f1-Zuimd6SLyAxjqEoAz0L8RR4yE9yj1xRZqp4c3KtcrD-AgIdYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyp1JxqlyHhCbsSKZuvKg75fThWG3MBqQI2gIK8PoCcgg&oe=69BBE571"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-HwWYSjS80Q7kNvwE8Yulg&_nc_oc=AdnRefUsUyAPl2InLwhQBqk4-_2im1y-r4JgwB_QdMQxyAJ9C579baKEFyG0R02oWWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyg3KpQ2V0xADRhB55W7O1iGC2Y-eKYXN59dNvx-O9F7w&oe=69BBF384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5QZ0AfRnNQQ7kNvwEVhn4G&_nc_oc=AdmbG0fNCvJWf5b5I9DfuzReHnKFnSTc5GQV9rElOho7FX87HWqUK_O-fk1qrVGJ4NA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfybX-QPWZJpRyjSzS5jPmJsRcFTjwy7B_7aJ-68UE60tg&oe=69BBE7F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
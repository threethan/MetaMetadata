ota4.png", "id": "1510165476601670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjPv6fJ1ZcUQ7kNvwE7fhRG&_nc_oc=AdoZ01ZZeTsXzEKp1cOW4d4e1g9p7SldsN8qHH1JuucafXuaqVgYFfR_BHMw_g6S5ZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XcFMjMo5rQ1BKTTdBySS-ovydpkuZiiluNvHFuDc58g&oe=6A0B00C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXhE6xtArg4Q7kNvwE40rGn&_nc_oc=AdoqEPzNGVAMChPUi3tJeOPxaosfRRmnVkpKnFQvQNjZDZMmT-GPXrN10bZOfwcgVNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WccdNAWW3DAPNUwhebc40ovCcPvq92bjfSPyFxR4hvA&oe=6A0B2E17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxjB4nv1w0gQ7kNvwGxBUl6&_nc_oc=AdqK_vRCnCL447wmWl4OsIxzkAyoM0udGva57Zajn9f4Q7AQ0I0YGUpDe2ejsGG8_3I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qS0tWqEKvPsgNrXz0d7dl9_KKtAe2Oioppw9LAoH1ag&oe=6A0B37B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaDYjN2f02cQ7kNvwE60yNx&_nc_oc=Adrbgdbzd2YN-gB8TMDH5EHKAnHUE5-_uQx6y8bbFOucFylCqsYp_kvtA9gSwOe7nP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43Tyf2Hgni2vP3A40jnED_xOV2iVU-XgrjH7nC7nWG-A&oe=6A0B0D84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ4mM7jjNCIQ7kNvwFQE4PF&_nc_oc=AdrG0G77ZdSR0a2fsT35LGqVNEUn6LTVWa4hN2v4TDsCPYKYYDR6lDgpFmSTceL0p6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XrSYfCzTPTFMYGxmcHT-Wvni0b75S--cEeeKFuDr4vg&oe=6A0B01F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
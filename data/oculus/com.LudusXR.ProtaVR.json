ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S-Pex3igEPAQ7kNvwHEGWb9&_nc_oc=Adr-eFr_xxe-haTHf0nRWEGlZRBFnPnX1QOAbmrOUINPtuBxuA99MNb3t8Ur6N8v43c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMupGrg-W2Jfcv7hmgtGs5zLNA2GGRiqCnIbrm-o9q6Gw&oe=6AE61201"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dz9uiZTUiDYQ7kNvwGfRXt9&_nc_oc=AdqOLx_Yvqj7CGPZxuW8ZWBpscaXfTsBS0yRoq4K61LsMTLo7jakR7KGXjrFPSFH5O8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8yacWk1qeYu_dyYxlcGnaiQ65Xay3o2ch0UOADmQ0Pw&oe=6AE60717"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHJcyPfMXlYQ7kNvwEFRB4b&_nc_oc=Adp8zj-NltbeaDORAn0Xi36kXnCxX8FyrLHCgKQa80Vxio_sMI-JmS50mBgzQAw-nlY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxz_teh3V-149e5SX552LF3JeDbWSv2cnnA7nky4MP-A&oe=6AE610B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvdLdZd_ipQQ7kNvwHvOX29&_nc_oc=AdqhLFvmHizuCMCD7JAX7-4QgqOPIwpzZJ331TUznYEK-8pTnWMfMyptE9colQOPCB0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXUrR8j9kPHDWkLsqIviUKQJM4eiLtztd-lK89Hy_0TQ&oe=6AE5E684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOQVxB12CcAQ7kNvwF6-aCF&_nc_oc=Ado2vd7UZlFcjzAeXQF68HQN6cmKhcKG8fma30T3I1-Ld6tr7acJ-3Ehdlj2bn3DBkE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjK9YQ9KD3CE9ct48N58jFT2F4b80I0YmPxcydmhk7HA&oe=6AE61333"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
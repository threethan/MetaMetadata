3_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jcy4FjIynT4Q7kNvwEK0A6E&_nc_oc=Adk8o_bg4PuNitEE8IZInyNvj_4aYFKz7rdFFGfAi1XR3gHUzZ38M07RUNC2L1PdvdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsedZ79IzOSEn_sU0yEWIZlgdZO8CNFhtkIlw60LhAusA&oe=69A42BC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpAXYBaQzZcQ7kNvwHp7iIm&_nc_oc=AdkE9wp1ibmGzsSocZ2wTsElr-jl-McsRNtKwMzV2pPwDJLcH79OJVtGcKvX6cGWtoE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsH3se5qFruo6UGAKjsOBZrQ-S9YWwVAkrJMkOD5oxU3A&oe=69A420D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1jYPNh2ld0Q7kNvwFjyb6r&_nc_oc=AdmiwxtUuzmQs6Cb6wDBlTpAEgEXHdde4m5irhho8mOOK6Dhle9Iuto-8yxeYdbHHEw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvWELbwBfY9q5QlTvUcI92G8s49_oOtP65N7FdMzhKnYQ&oe=69A42A71"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb9Vd75PSksQ7kNvwFKZaZ1&_nc_oc=AdkUt0-xHQOztqbc94JZtzmguQq7Hl001wtj-fiVCGDYyjx0taHWjFdiKa5wwR6-r5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvhBhvoC_gclK05Fc4yVpYzrWMO9RIsk334ddnxs3i9SA&oe=69A43884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cktq-AzaCkgQ7kNvwFQCmEh&_nc_oc=AdmHiFCE4trJb3C79MPZDpc2a70YsJ2Pebp5pzjQRQr76IouYZ2mZgPq9prbaNLDujc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftAya1hsU5fofL-NFSBE41_eonqeXGJu5FyMTgwRObPPw&oe=69A42CF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
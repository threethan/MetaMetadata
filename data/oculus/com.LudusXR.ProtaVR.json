ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Auyxf6N0VRIQ7kNvwE7cRYg&_nc_oc=AdpXiDIjVkRcbH9ukpLRkRvXMf_4uki-mBckWWlXYQ_5OWWBcKJBf0vcqhsr_C391vg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Or-R5_r-5UAr3X1cBartUEuXRuZXhYwTsTlnRYKFGdw&oe=6A070C41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8lBws_gjhgQ7kNvwEvWYts&_nc_oc=Adr30dpxklgnHkCmIxSIF7MD5t4DLyBKUPcBghLTrD_FGYqgzzxazL8G0z0UYsnx9y4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Vb5Ndo-TMNk9FnUyrRuT2nMO41PUpFFD6xY4BVN07lg&oe=6A073997"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl36BN-8GK8Q7kNvwFDHDqz&_nc_oc=Adong9wDSGXhlXYSvUjDCSRJSYAtYJdTxGAjV-GVa4OJJhu5egVnW5cL0q7aFHanxng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bElX8afvyWKpvjGGWsrmGPCpsohEHVwGY9W891vRdng&oe=6A070AF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mN9qujVRsRcQ7kNvwGpPd8_&_nc_oc=Adre8DMJQJ4PjeK0T0y_SaDpfnXqmgzCAxHKKrx8qpNKqw7PXJsrGsSiMnslLxz9Qg8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rW4sVJId1aapS68hyXOz1snWQ5WaNKG3j4O9IKk86oA&oe=6A071904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0q7qUSZMUcQ7kNvwGKb72U&_nc_oc=AdqhXYvln0-hMjBo92ESajdu6i-AqoPCgDr7fTDFZ6DYgxtH0XL7vOt5wh63N6uJq4A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PmPRlgfd9X0uG_T3XpUzlFLwugc_t9c48M5Jt_g7Ekg&oe=6A070D73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfoyQaRCOSsQ7kNvwEInW5j&_nc_oc=AdoV_0nx18vS8cyFN-ZqTe68Xx-cxCoa_InC374V6rUPTfK69ZM0gQkUg1QZQXzT4Lg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlOBaN-EijuqJbav3kTe0D05XP06fhZTrUJkxwCpe-kg&oe=6A538341"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2WMQQwlIoP0Q7kNvwHwNGtr&_nc_oc=Adq2PV-npPtjv-QzJrz-4zfPZjRgmFhXK--aSLc5hqAiCwnjjb2s7qb8kAVL170xxXk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWuu_sp7xAgV8_RNspTDPQoPll8x693NKyzlYsCuGN1w&oe=6A53B097"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR1TzPxM-VYQ7kNvwGXMreM&_nc_oc=AdrvKMd_r9IWIwiJXSi3zAtD2pcX5WNDTdWmSlgTAFOFepPeKlFEi4qF28Ia9cLyEHI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC75-6oPQKJUicrYHLkuvmrXTKHW8w38acPNfuf8T9Gtg&oe=6A5381F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxMqlN-TGKUQ7kNvwH0vvvw&_nc_oc=AdqFTIe9C7mnG6VKp1zxBxzzt--2NJ3bpC4W93xTA0mw2V4fmK2F4uDxto7yM_knyK4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuaIeCLAdOqNn0y9fd_D5fAh3OK4sfaS0Aa3tcPeiRtQ&oe=6A539004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPAgohNowBoQ7kNvwHAtlFI&_nc_oc=AdoyD11K7NNyvJKyXkYwL2rjIZNpFG-TJYh8dBZOxw78zckzffY--KtPvTwWicB4GqQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcrQ9oAcuMIn41gmCgd2EOXhV1YSmUR3BpoEfSp0azrg&oe=6A538473"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
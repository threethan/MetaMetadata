ota4.png", "id": "1510165476601670", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMIESiZUxZ0Q7kNvwH-xBOs&_nc_oc=AdodiOgOpmZZ8eYxOQSmPwQ5E22_a67OE4HuKhrrDtA-oa_piopuO1onzcCP66C5pa0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dZjBWeiqbSz-yhIZuN-w-RHyGUFif2iZBBEB7h9sA8w&oe=6A107F01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfVGUfejkbUQ7kNvwGa7ybw&_nc_oc=Adr9K9h6TmSW3ZelRnZOvey86WjrLAhV1-AI6wkDXaXG582Pdv_C3szWbPmSet8Mm6E&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sW_29ocj8cSHIXshpACp6KeRXNngluhduWk7lRg_MeQ&oe=6A107417"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7PGhxlqJEg0Q7kNvwHPVxhr&_nc_oc=AdrRWMU3dz3VBo3Sk7fJHA5vMyqF4Xy0BOMda2Gev2De0UUwDXa4qn6Sce9U9fI1hfs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40zh3sQJB1_4tUUFmu9bmTNnqIHGGU36SYP-GIffoaKA&oe=6A107DB1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK64w3zTkjIQ7kNvwF_ZNRc&_nc_oc=AdrZuoWLOyUXDaNq14PDmpMEpGw_1uTmjcXsNztd9TIKIkuar7JxP6N9hizsEF9oPgs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nd3IIDSVnMwLtxPCHgfons-9bLlQDSvMLffNW2a815A&oe=6A105384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntL55GEe_FEQ7kNvwHTYLn0&_nc_oc=AdqbhEIEci9dNBaGTZvcQfEkLiL27QJ1MmKaB-acIltIedO0F-fJC2jB0s0PKtX_mzk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VksKuPKBPAqrG3qXV8X9LTGa1et8T631oRx36RR77sw&oe=6A108033"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
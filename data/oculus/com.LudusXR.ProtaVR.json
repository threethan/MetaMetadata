70", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4Lp8SD8izIQ7kNvwHKLfYR&_nc_oc=AdmP_tXUuiyq8IQ3JEcsq7b-ZlCFaclDu3R7X5cgozMiQeaJnPhLO2xZCFSXKjCGq7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxc-yNNoDwHtJClwBU61bw4h5ZFMiW6AQQCIxdFdfb3cw&oe=69BE89C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoyD1kegl6cQ7kNvwEJfTly&_nc_oc=Adne0KTzcbXMNaTSVBQHk2R17kGCzoYWAn0FzwLJFPrRa0OHf6zIfj0ZY31D_wiP7VM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyZMMf0ydR5qPUhMio0UG5dCWU2fWKDLA0fK9M21xDIA&oe=69BE7ED7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mfz7YXbYQEQ7kNvwEON1Kt&_nc_oc=AdlYSO5rTv0cej90xJRow05SUq7lbOX87ULhXY90sJ934c2uYdBVsoq89H8wV6dwEho&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz4_Kk-sZlQPgNRRSYhbll9J9uxHdPVPabHE5FTvVPaeQ&oe=69BE8871"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWL1J6g6FSwQ7kNvwFflGMo&_nc_oc=Adl2S78tUI3hDFaoxiYATZOGxrmnFelhG588ZAGwjz8zF2EqkuPLvqWFf5BLcIuZJGU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwlMGT9NpSZs8yGjMjycrcaQjUuaUXZ1oYM8fNi4G7Paw&oe=69BE9684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5QZ0AfRnNQQ7kNvwGcdlir&_nc_oc=Adn75jZIBOAAEpQ35tovCu7S-rPd_Br2pAkbSdmD6pqwXT5hCGWq7RiOvy_9-rvU0IQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyz7IamOqlwl5Qvu2ONdKe9Tv5JErdyhVrV2pByXrrhrQ&oe=69BE8AF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
ota4.png", "id": "1510165476601670", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiB3u7Gu1M4Q7kNvwGBiU6D&_nc_oc=Adp_KJoG4pmlZKOCa1URC3fonffoqFsgzVPyTmMwZNV8jCi1YFLeSMAbyWYUoyrEHIE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1u7l3fJFXReBJ5ma2gCPG-wsGLgRva6JE0Lp7EYz50g&oe=6A26E881"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApO0FlvGXAIQ7kNvwFRUNYi&_nc_oc=Adp69lwgrTPbp40YAlpRta9JQJyQ-GfjJIf_1dvMYRdGRVDaKFRCxIJ_pLihZdL8xdE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EHDs3uou0oh2RElNpxhOOd3GsweUk2bobyXaBbJNpVA&oe=6A26DD97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w0mzw1Q-ARcQ7kNvwGO-YMP&_nc_oc=AdpyKjQ52vZ-l4O3wQWjiP4gmdHfQpJS2scsCNVCX72fPOs6qX1RfVcCX-NHu69PkQ4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hmjv2SyxJLkG3RQsq9Kd2lCo155z6Z9PAcIXBq24zBQ&oe=6A26E731"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wLD5mD_XYXsQ7kNvwGghPVZ&_nc_oc=AdpB7cFxUc3AH-Zkqgp0NqvlV_l6DcLw_lC9364lV3QxBOa1TtXQtYH4Jd87jLQW35E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GnYGZrWEHcIs4OVZWbYX3RSOBu7ZLrxa2e4UA4oxYfQ&oe=6A26BD04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fED9Eszgo5sQ7kNvwEBnkqz&_nc_oc=AdpLsmK9fh2Mqx_7IXQrHnjKd3a3QMQ3WNXsAp_hSH43ec9jMZZhYRCAWNXII_ko0pE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wD4Vk5oi82p3usyrsmLdba5QalPv40Jr8LLztrBvJJg&oe=6A26E9B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NQ3KScQ0DXcQ7kNvwFaNphB&_nc_oc=AdqK4Q-a1b3mhdWnA9eUz9wXLwa5meBN3RfaHrTLneMEONgzHSfQp7zOTw3MuO2rFsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FBFfPdJb6uNpRfdrVm8riPlEXqdCYbSlDSxzjfNiilQ&oe=6A0074C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VUBJmR943vgQ7kNvwFy3R5k&_nc_oc=AdrFJ68KSxW7-qbaoOGswUvgh1Bd3m4mvsyLDcktrviLe6tNfp9ozUHce3We8XFphWs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SK-iCSa4WGZ5PhhI2C1qZE5teN19OHxavqpEkjddQ2Q&oe=6A00A217"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyIWK9qOE_0Q7kNvwGqtlV9&_nc_oc=AdpSRoH0MniDLh5p986T2h1GieO1pMeTERy_m_q_5DV_Y-fpm7fOLjd_Nw3PiTO7gyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VOLrrjteizB9kpY187zZUPaGACNLzskh0GXWOoshLEw&oe=6A007371"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBci1OK82h8Q7kNvwFOvPhG&_nc_oc=Adqzwwhk7z7Y4qy-C-zLjUKDYoXesp0v4g_cyaosFBmJTJ1md5dGdfAfmpViWuZKb7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_3R3bn3T2AeQfQ0U7wDu6XDaQGvQdCbALTIIYO-7bzg&oe=6A008184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK3Cv3-aeFYQ7kNvwEz_dQD&_nc_oc=AdomnoP-PdDCv6Yp9CDlwt_LMoB567ToixclMSTiTclHqTBuow_AS_MFHVonsgsLSv0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ou-zynLkmLrp6slUbsA84fHS4rhtJtvIjIRacAaU0Ew&oe=6A0075F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
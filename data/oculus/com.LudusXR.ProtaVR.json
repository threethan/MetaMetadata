ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjtiQZCVlp0Q7kNvwFF6iP_&_nc_oc=AdrGpxK4NSF4HP9tF1E4DICAqZVO5x7kQW5JNvxul8m5kOWG-ItaMUfLSl6NnWd7Uow&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMx_GNWokg3YTIwbcDu85YjXRPsXwnN-Fei5jToUA18Sg&oe=6ADF7A81"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I5eFl3HJ7o8Q7kNvwE06SCq&_nc_oc=AdqD5KOqQl-Y5aNCXcrfsTDRwRbDQ2ywjBprXIz8bjakXEymD8KH9gu63EFrbRxYI1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqUy3ELUA_xCamjfU8IRstql_1mUlQfUBjTr2dsjwMOg&oe=6ADF6F97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unPlmoshZwsQ7kNvwEMkNuC&_nc_oc=Adrl0XgGh91lYDRjXs5tJO_-UdintBO09aRuJyYsQCxsS64k3n2juei6nT3R16f9fUE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8zk9gx8zah9VR6V07O2mB1-ngSzPP6miXxLRKHBD11Q&oe=6ADF7931"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkiKgwOdTm8Q7kNvwHW7EjT&_nc_oc=AdpS4ZnwxLso9tEwCgZPNKq7ZPz5jcYejuX6kfXQKyKcv5ZgKY_QmtEwul7CX2NXnIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuK_lc4c9nWjDR31nZIh-1qjn2f4oz3LE31Fp-FpaAHw&oe=6ADF4F04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7rwukw8aS4Q7kNvwHKT_Ua&_nc_oc=Adq0UzXvbYQLtIbofxL1_GT9pmHAWAD1VK-OZQro2idusoVN1_MRcuFETXDzCjswLoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4RSNM_IKIPlN-ovZJZpZp34xAouBzUlI0UOUS0HhP1A&oe=6ADF4373"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
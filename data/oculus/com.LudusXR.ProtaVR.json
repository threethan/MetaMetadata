ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S87eb_SZCHUQ7kNvwGfo18g&_nc_oc=AdrlW1eIdR3cEi1HJ4qEbM6bQcFPL594uyB1f7Vz0VAjle3_CyAorExHTuvTWi86Fdg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1GlR15E6xiYdPI-vVoiRarsRY06RrC4-CWNpI7g--0VQ&oe=69F73A41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3HtIs49bBAQ7kNvwGwbaOz&_nc_oc=AdqOCxvCS-UQLpLmCU-zqjAT_1KB_B_wx85qty--6GejWAPscGH023kFho60R9gbHM8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13T0kmlwZdQ76he1563-wHwHLSyQItK4aJh-3svV_bcw&oe=69F76797"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruPEa2EFCSkQ7kNvwGE94yq&_nc_oc=AdoItCOrC0E7_5IE7l62Z6V7FDkL-HjDWG5epOMBgVxva3tAIMGABY64BKUUzMqdOyQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3UBPcx-Z6TPJiZy0Z6fb3uCJtkDhxXjW1CULA3ZujJ4w&oe=69F738F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0PTz4LDgLMQ7kNvwFo0NDp&_nc_oc=Adr3wwl9ObR688DEA9HiMM1xehwvT5tf-EaxzxXxvAAv3Hh4TDmbQn86eMun9bicdPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af223QXdtW_K9RdfRlX9Gp-Wl8wAYCkZ-Gvd_PLI15vG2A&oe=69F74704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8h58Hut0T8Q7kNvwGb9oXx&_nc_oc=Adpn7QVnxa4K105q9yNeDgmf3Qc6eCrb92OU3ImHbJ6fmg3V2auOC6ePyzVhrdp1JWA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xT6xl-XNWOoWYJJUHuaLiR5OB66H6LpWcPosQ9EBuGA&oe=69F73B73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
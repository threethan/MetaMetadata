ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qzkFMS8ogAQ7kNvwFkh5YK&_nc_oc=Adqp8z3d-K3o5sonZ4oUNqeqluGnThGISJZVZcO412OQ2Tw9U8rJLtqtDb3d8n7TBb8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMjQIr9zUOo87fWQ0g3zlYzWHPYoUwXBJWSdJ9NML-efg&oe=6AC27981"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N77r5LIQcM4Q7kNvwGV2XU7&_nc_oc=Adqjm5q2f4swMmf7oIA5AblYAs-fdaDyb9M-Sv2JyB5qdpYp25ON5_AnugMbYt68NFo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyH2JOfgGX-2AmAPCiG7fAMga1P5dH2MRVXHdteL-Tdg&oe=6AC26E97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=covGGi0aeBQQ7kNvwFz_I-R&_nc_oc=Adrcbd8jedxEqBKfAV2WzjvUiqWAGiyyVqvsCwqczLuHxguGszw-ze4mMqEurlbYCVs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNibYK4DAXFyPiL2b_tsfziUxpE7a5dZvn5-3gKHb83nw&oe=6AC27831"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94bzsupOf4MQ7kNvwGuvuIE&_nc_oc=AdqYH8ZCyextu-vskobKzksbvkjNSAjsy8QbaLxHeTY1z-CXjW6XwVm9qT4COZ6_rhs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPxfr9sJLOCoIIGn5016gmenIiA_ZFlHxGS2eYcnd4Tw&oe=6AC28644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1Nbm7c_fjcQ7kNvwHT9pmV&_nc_oc=AdqWchNVFJjX4JFNSQYi9xnECQXmQgg6C1N29UMZqH1C3ne8zQQ88w996OAR5MXcJrQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbipUVuM0UMB9rYFwOe0SoIf0utOzRqqkB1E51I2FyIQ&oe=6AC27AB3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
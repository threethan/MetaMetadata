ota4.png", "id": "1510165476601670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQeZZBRZ3IwQ7kNvwHwti9w&_nc_oc=AdrwOygmGErq5RG59wftYNi2b3Oqm7p-qmDZQ3fOMI3XbxuusaRA_MQqUsI1D4HMTJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ppSPYlqheAlyZ8Jm9vas-bKOQ1BMNYcu0lAF_zNeuAQ&oe=69DE2DC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxDtonZMLBgQ7kNvwFtxGOr&_nc_oc=AdoYVQ0fkq9mUPbgZTppt-5UpBVmw9lGFungnBbAqHtgHtq4oUQ2qdsYtDTzNQx6SUM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sZuV0dHHOiQ4jGtzoPwNlYgTkd0XX1isOo8pNfMgnMg&oe=69DE22D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAij9BgYIW8Q7kNvwGWTkCC&_nc_oc=AdqaDE89WZZe3DOrMB53sHDJ0WFJj57cz7GOmvK_jyU3PyGOzpAUtiImveD80EPVKi0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3q36rx_JLjwOoJnfFR6fHXzgBgXTYROmhdiGzgStBDHQ&oe=69DE2C71"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OmJ9CyGP3UQ7kNvwGTeFiv&_nc_oc=AdpayQfM3kcdJO27XEKrGDVy5a5cgRLyr6XbaDQdvfAMjMe0IqhCYf40I11XJ3ne5v0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1byo-fJZ3CHiNv9j9-pwl5dwC4KEGZda19273CzrwZZg&oe=69DE3A84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzxvjxDaFFUQ7kNvwGMdZ1-&_nc_oc=AdqYKDVRoS4gEzFI1Nh2808f_oTXW-A5T49TrwC1W4RxMOMOLIvTU4A8p6NpwOr6EAI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gDFkd-QfwiNst6dZZtS7NJp60pylCa2ZNqqzT6sHkPQ&oe=69DE2EF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
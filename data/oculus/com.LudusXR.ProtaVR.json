ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f9FRWyc0sRUQ7kNvwHGr8uH&_nc_oc=AdpTHyCGBuEZIe2xuVcBrNjFEZOEwMk8nq4m04RS504MLjA1CcEeUxhatR_YBRBi1d0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQUnoS-DiXPDEaDbmkOKOpRN84wPOvsrtpxqQDV0BEvg&oe=6AAC1001"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GKjhvYsdafkQ7kNvwHtgXfd&_nc_oc=AdrNh_z4IzKXceVakM4w3TU0PqNZnBdreylS0r9dfB3A9AYtQXz_3bfwW89iXgfID0U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6jtEE06r3eo6ajtMhYmT_qwJtR71W-zaYb6Jt4FsBRg&oe=6AAC0517"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUMskMBL7LIQ7kNvwHivyNR&_nc_oc=AdpWBtWBeW4vK2lcr3aP3T3L_xGNpoUO94d-QJromdqYlkzxPvFDynd98tMd9P30eoA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKuo6UXY_qR7iT53MJyaRELKaCFlWBW-GevnYhRKhhfg&oe=6AAC0EB1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZofbpSnkpAQ7kNvwE1Ilx6&_nc_oc=AdoJLmOi-9_m4bEsVT7kdtWGXkbWIMolnJm7In8yRPSlm3-DbxYSQxBw3qnLRwYxZ-w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLl12mJY6dhS7ozBwBvZL1plaMkM2WlIgdEHeu99CEwmQ&oe=6AABE484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TeTe6emZ680Q7kNvwGipJT5&_nc_oc=AdrV1WC6C2OYvZ5waVxSdEDOGH6hxgpD2WtuPA86_u5QVX6yuEqSAjCWoFB1yG0ntu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYw7OkHVI2djIX4qZL9eWe1apfKQ9VxtptwTi2nXGANQ&oe=6AAC1133"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
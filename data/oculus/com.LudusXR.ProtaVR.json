ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S87eb_SZCHUQ7kNvwFnvqrS&_nc_oc=AdovYjt9jpChRrLk78-f_oQaFHh3RppaISDH2JHOb4Du2pTNvKSUvuD1vfJhLSlQVoY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af31MsjrW9OvqktzN_r1V0jOAUYs3BhlgOmA3dulkVMwrg&oe=69F88BC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3HtIs49bBAQ7kNvwEU0ssv&_nc_oc=Adqec8sfZ_hiV-r2bmBDEioCs62-JGdaUVWTd8Q_LKlfX6pRDmykGprXHTqXK3fL9l8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Vo7tXCxxWe9XutT2O5o7uH9JvWIbYKrKqKJ6nma4m0Q&oe=69F8B917"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkwNLcBG39cQ7kNvwGv-nIG&_nc_oc=AdpBPyH6BmEP-S6dz_vwzCORWXoTFVQMhUeD9eCZCMvhMFd_2RlDqq8huF99TtCIKCU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OSoMzK-ITYHiieH6J93RztrSpDD2o5MlZSdgzuSTyCg&oe=69F8C2B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0la7hM7opgQ7kNvwGFb-3M&_nc_oc=AdohdL4TDiAPKRvIz1UEXsXX-IV89dKUumbEspGPX9erycR-CwXIsynLBXZqeFEVq7M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2N0FvnSrLFULRYNvj6lGF1Pe9zDiSPd_9WwFlj-qyRCw&oe=69F89884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i8h58Hut0T8Q7kNvwE9GCQq&_nc_oc=Adp1B9c64wQ2UwIf65yqZ0YWf-cym2pupBXDx3zN-aCh0KP597FqST3ALXD9sT34z1A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xHsAhq_NJV4Fa7jz62M2F8xzaIycjcjPua_wwW-4mSg&oe=69F88CF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
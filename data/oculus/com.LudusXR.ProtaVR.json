ota4.png", "id": "1510165476601670", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTxjUTnz-PUQ7kNvwE8NeQE&_nc_oc=AdrhYkuqZU_cJKD-Dt0A5878lWq7rmKr1QnehrNboQm-QUriWTAldZVySL-JNk_a1cM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwRITdLvCVsyKkLZwUrnVmNdsAgv07qbBSY9hZN9ZTzQ&oe=6A973041"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiLuP3vFu3YQ7kNvwE-uHeu&_nc_oc=AdoPlMUiEa9PaIXC2BLfPtbGC6Be9KMP8d0i-OKXuysjTuihYBaOlJx9G4wUre6S3M0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEinSzTullo79XG9hWCqNTsgWRptdjZW6oYIapbpTlcTQ&oe=6A972557"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtiZzP_bikkQ7kNvwHlBunO&_nc_oc=Adp4q6QD8OiKL8_yJYLtZvDwfyDkCJEWpG9ZlWrlrg9AX0FX4Hch3-hKdXrtSZJraNA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJIjEUxZqCYQvpRxScmcJQL7KT9cdZ44KAsgHr7iPTZw&oe=6A972EF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNSRfDk3rDkQ7kNvwEaKEbr&_nc_oc=AdrUW8GF8fbkEsZQNc40FRNvzZKisK9QV-nKYlWAAcDUwYwB49jHuL1MJ3JgV-wN4XI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHacz93hlf1gTFVVEhFYJv34qHG8FRfd0eX4kKS0PnQfw&oe=6A973D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cviyXoEPlqYQ7kNvwF0gaoD&_nc_oc=AdoIbGp0emh0LwDvysBvmpedg5CUVFUsJg9uQ_8NPSGe9Zm8ZQ3NzeeldwHUuJg1V00&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLttP5mYgz4Z5H-V151JxKiL2tNUTYqVkwn5c1rSS1mA&oe=6A973173"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
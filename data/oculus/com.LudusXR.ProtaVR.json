ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VA45CVMfsYQ7kNvwGlqHFh&_nc_oc=AdpYjpKfgGlavfIgfYq4yMG-R_KOSieLFNfCYJvx_1h8cuBmOUa-tMXfQblfKH6Svhc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDWtTY5MQ7GiirQUshIFNL8s-RT3xNuhOlkwlsoKG1qw&oe=6A7F04C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abk-eAq4J7MQ7kNvwH4oDZ_&_nc_oc=AdqWt6N1bHOuNvjCzGsq2wTgc5u_BIiwwyk9BkJ2ZC8UFHIcnP6gNuxBp6vAZVMwz60&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyzyiqbTQDxNPejVjisbTak2CbY7atOjYW0ygF4EjqBw&oe=6A7EF9D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1veF3yhhgcQ7kNvwHma1aK&_nc_oc=AdqtLhqXKaXd8XLDCf2Odtb6aYpNYJVYP6QhJw6zq1JFzXL8iFyknpQhwosN-X-Wdyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEP5onw53OfPGJT9xx1L4vjUIRX5YkYEKVrxEJ3U-KQYw&oe=6A7F0371"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L0h2oagfPQQ7kNvwGpUUg0&_nc_oc=AdoJfZLtdT__WivDUfiaHj1h3Li8I0JlWyn6aSJZuWfXqz7yrGgoJmaJH6pdhWHE1uE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvwGEmr5bmJhGReN_cxM87_janmjosAN-KADM49K5VQw&oe=6A7F1184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=at97rc6GBK8Q7kNvwHfDymb&_nc_oc=Adq-yPgO5l-pcKI7qP3QH_28R3iui5Z5OANN05M2zyAGw1OywGoc9qA895dgLTC-Ubw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWVLhhpA6X_Tey0Ev5MwPGXtSu8Pkc7xbYnzRsQhimXw&oe=6A7F05F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
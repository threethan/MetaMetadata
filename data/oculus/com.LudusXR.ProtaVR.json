ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqBPiZrTtCMQ7kNvwEzARQ-&_nc_oc=Adoqk5LcvsC-AsqjR0UbigkvSbB5V71vYTlEcQz6cds9OXo2ano8t0HNGAkEnA3wqOU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK9GKpmB747FETiDkzkno4nNtxTVFEMxbQLsX0KyvOrA&oe=6A79BEC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoPa4HnzZhwQ7kNvwEu4Y3K&_nc_oc=Adp0ndMf3I2x6j66aG6fQSWnzN0yeJyEp4HKsa6pnNjMniOhxgNajeXzUjok8BczFt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzvSAD6kUlHZ7l6IvzpFCmbJkZWwHBWG-sw275aIEc9g&oe=6A79B3D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRD3EFRGaWMQ7kNvwGxi3yC&_nc_oc=AdpFxSOUvqzzmUJ0JKsbz-oC_OImg_PFw-85GqdO3lSgXt3XC2ewjJjdtR3gVXpDB84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9jKD73xQM4IOBsU61560HreNyy6UutNOHhVY70pLpAQ&oe=6A79BD71"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBEBuWXyHE0Q7kNvwGjnbFQ&_nc_oc=AdohrhlTQZtNDAyC8es_RVmgztQ2zoSZVh2gv_z9mIscr-QW4pcZzU1l978_qz2d1S4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuZquT1yXu9BIJ8xM5oMtir8whZYSLPTZXuDBtFKXbzQ&oe=6A79CB84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3f87STx4vcQ7kNvwGQ6SKp&_nc_oc=AdoyxeXR8ywXA813sjTA8eF1qmzThW4EhszF7ITwstPJgfMsybf_FaW_YUMRF1XoAlI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4QDdTc-fBLTyc8q3KZPIbjN2c4grA_Q3p0KtZ9zzoOA&oe=6A79BFF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
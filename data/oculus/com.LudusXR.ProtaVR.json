ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Auyxf6N0VRIQ7kNvwFTeuZE&_nc_oc=AdqF36wYD5Qz8AzJ7DNxemYLWNrlJSBctnmbJ9v8P2Dv8BR1-SCOPrrCTrGpJbGDzcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vOxQmR3ld_s3zv_XO3_rA_SV3AkDueANNxLqGYlI1Sw&oe=6A085DC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8lBws_gjhgQ7kNvwGcprcC&_nc_oc=AdoLF08pz7Td4IRpsPGwpQJGcraEfE4bgaKC1woOiG_z0xonhTH375bOI4sH0ENEE6I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IXPZ_5PZIDYY64t0EbVxALM-XRZNs-E-QQm61I4c1MQ&oe=6A088B17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxjB4nv1w0gQ7kNvwHB8-E4&_nc_oc=AdpU5VdZSV9DfZtnCQYsBwFHAtFpDATxLaZ49pTQ4JmhN0sitOcUz0bQdTsdaYVqh_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CJC6fXEMkJ0R42-Te3DDuw1cAunLj3c0fWfwbgcbrHw&oe=6A0894B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaDYjN2f02cQ7kNvwGq4eQ1&_nc_oc=AdoGzu7fpoNI2rbtmtPNclKv-f_w8f0RLnmmHXM3vnJSTPUhnWa0H6KQUBnyr7uqiHc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZMGDElmtU4qqKtwT55EnyHn9oaAS6j_n0DvvSy-Lyog&oe=6A086A84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0q7qUSZMUcQ7kNvwHg7EOZ&_nc_oc=Adp_zACsh3-1qYpepPUBRd1C6bt2qDSTVe-aGD8TGWyC_jY75YSo11uJvEAtTxaWoZ8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uhzGyLKUgKCyvfSDDNEsuLRXQrCbklYXznQJmbMiK_Q&oe=6A085EF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
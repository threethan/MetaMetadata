ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zjEc2IsSXcQ7kNvwGYKKRB&_nc_oc=AdpEsBwy_l3wae_e6i2Td4Q7PVf0kGgBiYmYe5-KG1iS0eVTeH_7AssWaEymLp_66R8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIRa2_LRcA6vR9gEQ7ND_btIgyYzgh9eSma8quu-htbg&oe=6ACD0581"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kW8Nn_cwr44Q7kNvwHuBhxV&_nc_oc=AdoJjllHJGaUyJh6hl1wtmHq1GMFYY92l8EVfeeBjWOILb0m8z5IvawPiSEgvQWjY9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcuQ88yPor3Prz_ZuW1StvkZ6rhgoTQeHmcgeLo9uDtw&oe=6ACCFA97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1P0xqJLh3dsQ7kNvwHlb3r0&_nc_oc=AdoYEQZ6f6fa_Zy6wRMbFgsu1Re9k2Zyxz7Ao0wPQTmZxPXloae_sosfoZdf28bYkLg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWzbmEL2mZnDMucqGS-Mab_Cp-qxwDaWM6QgEy7U9iyw&oe=6ACD0431"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ts4GwleOhG0Q7kNvwGJVEbm&_nc_oc=AdqMrOOMPcsMz0-Yn514HCqYtZBl8wYmi4bKwRTdObujAg7EoRpFiSNBC78e-9l1-n4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNAeKWz7T6_RrmjWwN_piY7JQAj7hQRMMq743tv0u4MFw&oe=6ACD1244"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtPi4BR8Nj4Q7kNvwFbOlUW&_nc_oc=AdpW1otq1cUTgAiHEL_QVH4h4mqy88L6saOF4ajW5X229loaFENAPbIkkEPZcCbtVHw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKiWtkEQYK2BhzOMPSlWp-3gtNqZHGfE8basnIdFx_dg&oe=6ACD06B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
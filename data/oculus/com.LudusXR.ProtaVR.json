ota4.png", "id": "1510165476601670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMzMtwdQxXAQ7kNvwG66IOS&_nc_oc=Adqt5m_zN5wKtc_tKhIPaLEmHMThKQMZFm8j_GarEnewCvFnAtAfgL6Ngcu-6a3OnzM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-vM4Xa-2LfDVF5p8OOAuoE5JhNBi3HkXKS8k5DiUdMQ&oe=6A4502C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnaGc30R0MQQ7kNvwE1WlI7&_nc_oc=AdpCArKfO9zZ9UEQoVgV7Z3tUNZZ5FFAThAstuEYUGxRTJuMVozACFlIkak5cXqItzs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tq9aciJP-wUBW2s515Fb_91mVCpQfQmldSX4m1wlWog&oe=6A453017"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6lpgP39aXsQ7kNvwHTwN1W&_nc_oc=AdoApuw-scq9bzWcRd-OdCgDFMU53HC6LEI_8StRUQRfYtwoeV47OLa28ejvyLYRgj4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eTRHIGSdyjSu-juXvdRwkTpiqZ_GNRlJo1ppiMI8kwg&oe=6A4539B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7D8kXshr7kQ7kNvwE64gle&_nc_oc=AdrPrRpOqnMcLW69wlHPhKYxUeo41snONF77xCjDy4YBXrwRCVOZ6fWNTBq58X2xIgE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9pIzhLmDEIEW88WjgSFt4D6EkEAoYDqUkEhODeADcPAg&oe=6A450F84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z99C3Pbn0PkQ7kNvwFyRGcf&_nc_oc=AdpdY20HH0Vp88-_mfbVo0UXgcN13khBRdh2enXJtZ6KEuWQpnS3JbNys6j8ECuusUk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uqAMbiERwYhJgCe1ht1IjnoO2z8vJMAqIuBVtF-GAog&oe=6A4503F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
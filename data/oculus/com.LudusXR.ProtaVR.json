ota4.png", "id": "1510165476601670", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-29oeL8D6tkQ7kNvwFNXMOH&_nc_oc=AdoVhoY9t_CPXlU55mPrBFIaJu5G1FYtt0tRazkTGIC1T2FddlLNPFJ3c0aN-dMW9pI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0J9-F7vGP2v9w7G4SotG6_69bRoF96C8Q5zAdmrWDXag&oe=69E616C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTPrwYikvSsQ7kNvwERzN8z&_nc_oc=AdpX43yf5dMOgjg8M2sz8G6KDlKGAXPbYuRgp23fv5O7DkEU2hN2Un7aZZeTmendbn8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SOQdl8vL_ObMMOAZmP9m7mlq9_MoQh1rg-_ws59GkCQ&oe=69E64417"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9NfC49A2aKoQ7kNvwFJXYQq&_nc_oc=Adre8tryaD1BSg2QmjXKiW57tN5T12GWwRts3gTh0mVAkH_Oh-y1RUgESGKHihcJEfM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MrT80s8ibyDre2SZRDXEwx7l56BLAzH-apGpSH21kxQ&oe=69E61571"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Erm2sg2rWcAQ7kNvwF2oRVx&_nc_oc=Ado9p6L0Av8dvu6EsqHlBM_WCqrFkTir6ExCWgKCJvLZj1MEUAKn1PjX6IoSLgSavK4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sbt8hglO-CdSJ_Z-N4QEaAKKU0l5NiSR17LSKPgd4Lw&oe=69E62384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yBpozZlcOoQ7kNvwEVh5ia&_nc_oc=AdqPNWldlt-1wFzejNV3goqQzXM0EZvqW2ONwS_ful5SJ82wBQsEEug4foZD5R_gse8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lWZS0QEyychB9W34E5i09ONtperhSX6bfuLKkrdptvA&oe=69E617F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lWdTzTptjEQ7kNvwHRzONX&_nc_oc=AdqQiMFEY5_3R1MjuceIibDLS2k5VGKddu06JFZUK-I8g1Eq4pJ5puGe-Nq2voBMfWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-bgs4YBPFo-Daq4DqBhzhQ8lA05iCV0d_QEU1a_Q7sQ&oe=6A15C501"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuTjbsAiwBwQ7kNvwGIC38q&_nc_oc=AdoA2krwRsvQEKD6VlsSA655E-_91-14Q8aE2TRnLqRVJPQWgxPYb_HAYV9DizXDrQA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Qb2BzYyGPWZZu5fHyt4ZM13JQK1a8J_GlihaWu9K5sg&oe=6A15BA17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KHzKUvyiyUQ7kNvwFEXX5q&_nc_oc=Adq3lB5s3iIIsRz4PKBo7Q6VGvOKzCyU_0rk0x0888hDf2002kCONPUFt7WFM3yCW6k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75RYScM9QPf7AxQq-gUQo4NvolP98IiqN_9j3qPqP2-A&oe=6A15C3B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQt2f_sXgRIQ7kNvwEBoInN&_nc_oc=AdobZzrC8kELvfR9GNOSSIpBJ-prBzfw9_21niOFG4mZ9Bk0eSDpfBcihZk7qfbBrr4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45CChQ5EemJQpsh-KHS0QMgAtZCNx5wuO_-QegFJCvLQ&oe=6A159984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N5sSlOLz-wYQ7kNvwGYTqsq&_nc_oc=Ado3KJKFZZLCaXZp3Z3PTXEGr24mfaqQgjzTg1pHh2zC52EJsPtk6Fl2AhHdbXFe9e4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DnzuVRbpewXVGmgckGQ71iIrA6Pv9cNqpKLQ8VIYdGQ&oe=6A15C633"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
70", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pP6QBxq5mcQ7kNvwGY_dUC&_nc_oc=AdltJ0dCrUWskvbLagsZZ4e3zNGFW-TCV-5HWENjVPB6D1ULEw1zDBfgtLo5nH0rqDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz_WthjhLRms0pB5BhvwvJj-BxdGL_LBODC0puqgj-S5w&oe=69B54F41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dAUjBKcnL4Q7kNvwExpMfL&_nc_oc=AdlXogRKAHuiWc4rjiourQM6Wkpoo22jfh5HKC656i-Dnig4x8L5zyk139VgewBMJtk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyDASPCfsddngbxdfp3VunrsvdNoumZfddcdeHO-1ie4A&oe=69B54457"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWuoAzGDDu0Q7kNvwFXvTfU&_nc_oc=AdmQbyw4jbqPf73M5opxLiPMNx5nfZaJLZlPu-tR1UmfhWorkukQ9gH1CKMb4k_vTTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfycCMD9_G4gHj3e0Xby4oxGS7UBxaxbQHr4kh2vi7hDLw&oe=69B54DF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxtt81Xr0TAQ7kNvwEuFIVp&_nc_oc=AdmGeEbPYW0rImUhnJWHnyiWev5sU2AuuaYxAY4CzDRAKf7QdHakHFKywobBvXw8ITk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw9MEg7GnBqO6ba2pmX-LgVc2SmPEdmAF_XonLj2ak06A&oe=69B55C04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbbBGkWkQD8Q7kNvwF6n6g-&_nc_oc=Adng8Mv4kqdufBk2YiPanDekX9dizjCGrGgBMGlyzLU8382uNgK18Y3ii5ZocSnXWok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZ88h7i2ELglyO0eEGQJtfQXTm9SXC3Rplshk_PEDrKA&oe=69B55073"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
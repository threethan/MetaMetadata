ota4.png", "id": "1510165476601670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lWdTzTptjEQ7kNvwGtNlFH&_nc_oc=AdozXK1ce1qcF5Hpk_sc8MKVbh8yY-TGj8UP95T797DHp0PCiBc8RKVH5d6JAf5ixfI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VFrzOxmiG29qQCqDSfmBU9-CgBp7dxZjYv_bGEAGGuQ&oe=6A171681"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP1Q-DTcD6UQ7kNvwFkguPY&_nc_oc=Adp69eKn0NJRs2GZM4VsVT8Zuw0sn3L4vVlfqbjZ0zTSSqXr0NnNrCjCRlFo4fjFgQA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_dh9TpNJ3CHkeyGCPPxR5FZz7c0l0WXSXQN0giAXTOQ&oe=6A170B97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8KHzKUvyiyUQ7kNvwG9Fdih&_nc_oc=Adq_X3VcGnHdIFaaw5CBUD6O4UFqhj26E5M3xAJh1IJuqKX_EO4tD0bWTgFidHZPyQM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5680cTXWMaKYrkgJgC-dq5Akq38jezFoncmNc4VfajHw&oe=6A171531"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQt2f_sXgRIQ7kNvwFnBZoH&_nc_oc=AdrKQ-loF6yeHfdnhjUvP3tQ10k7L1bJ2uCOPXv8wyZTIPszgIgA8pYeSGtbOc2YVa0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LLBMOrrEaJjqhg6xPAEVH40RMlHxKQgk7wUVGUA64pg&oe=6A16EB04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrQzbutun1oQ7kNvwFOEcE-&_nc_oc=AdpVODG9XCMIY31vzjGD_-yTbX86M8ZPWMEsi9BEfHP3Si_hniMYTH0OAQeBvIQs8VY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af452WfZK46bjIP5-CwkBwMDVytZh9RqN0ZtZD8DVHZm5A&oe=6A1717B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
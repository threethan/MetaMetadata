70", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ei1gbqx2FaIQ7kNvwFtNKse&_nc_oc=Admt1GjCqbSKJWarN48ym2Gz2fNgr63Zaz301iu4MVUZGqEzbrtpExucg8C1-5dSxFc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXkvfW1nrhzChejSLmKfVqMAbTlsT56QSxTWt_V2nW-g&oe=69B943C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5AR73IZpMAQ7kNvwHk3nh5&_nc_oc=AdmpFGl2V4iMvDax0kfriGQAP244WFKN5i0us7nh4y6PITCnG_5SGWpFtVzpEObL518&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyaZA4AsmokOE5Yx-NtiHLLKGao4hYXKio3LW5jT3PHDg&oe=69B938D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kw8IK2y0YtIQ7kNvwHpY7WG&_nc_oc=AdnFWfnTZkQjnWo5HgAWIkLfdtVAKYaMh760-aILr_r2KCBhJWv_WNpJcTVCtHzgUeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwkcamNdi-MTwLlICrqLXiJgWu1f7HsFwghxboroZGnUw&oe=69B94271"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-HwWYSjS80Q7kNvwH_rGS-&_nc_oc=AdmjBIcZ6wLxk8wjXAabghRJyCXdWMl_OKWFTJNDoDNoCnE5pd8ulPHndq7saN2NtoE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzciNvarjNurC-qiWAgH0QPvawUZ7KUYiwj79cQ1cyj1A&oe=69B95084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP0c_E-OcOUQ7kNvwEgsbyV&_nc_oc=AdnGtDS50UdO06s71ip4lgUwev8UjwXTcYaVNP30i1YZDxJx4XSpsvKPSpYlGYv82-A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxuBUs4dtKiA1D63j2M2kFRJkSdOwvnVopBboSnRuKwew&oe=69B944F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
ota4.png", "id": "1510165476601670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJaN50fdv2MQ7kNvwHTK8Rn&_nc_oc=AdoZWjvX5DHm3f5vUFpKdy1e-es9iru2M_AK42phTPYkzBG-ZWyccPmkOXrxet532EY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHzQsanNPgyZk6dVVS73SRgtzPn1LJo_OSeAzu9JS2Dw&oe=6A689B41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHyrxfoncOkQ7kNvwHGQYTW&_nc_oc=AdqvKAfurlTqG1tMMvYOeInwA-bGol3IAJ7EFGBGjKJ9o6XQXzpm71BuYMkwMerGgBk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9M6kge8Spo5jFEc8XhfuhGVgnG9sqNr_TOV9GwJFvKA&oe=6A689057"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQDJXoI_O7EQ7kNvwGXq2em&_nc_oc=AdrmiXo5xk7_uVIUjx_0fa2gCKDHcfYXwvPDplOdcgQX3M_aGr-L_3FEvrbKViOVqbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUdlzcyd3SDmd2hlFC7r4FI4p3KVOuOrYmugyoKi025g&oe=6A6899F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=op0z7Y01HpcQ7kNvwFvWtWd&_nc_oc=AdqBT6xlqHwA6Hf-bU9UrtKlGeeZTheQvwpYpk16ewc0rS4Ays-h7_175jox-EDfxr0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdaAwaiN-ZwKgx528sAfquaGDlsfCWG1pavgcg64bXYg&oe=6A68A804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5r8bnyEcLUQ7kNvwG6vKue&_nc_oc=Adr6xMTcYMCeW8ErQEUj6DPn8Qc2TgzANgxqPv61VIXxYyNWribc3nNe878ghxEK8mA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7Oim46z7qt2Hrw1LoFPZTrUrdD8feA9Ee9NdV2wMm0Q&oe=6A689C73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
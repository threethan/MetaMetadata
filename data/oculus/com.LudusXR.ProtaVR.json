ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef7xagds_UkQ7kNvwHykH_R&_nc_oc=AdrWur_yJtmJeRLRqc1F5J6CUekFzzQU4DaDz1ZjqpiE63ynuBLJlSgQSF8KlM_vXYk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAf9XfLTUGgS2LxkbWdxVihvES802SnwPWo7XdrsZo9A&oe=6A4CEBC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9tIiqJa4asQ7kNvwG91KlM&_nc_oc=AdqhdU8hQ_GsPtMMI17MK_CunY1YLDt1M9P5GuK8UEdPA3UXIw0vDkBqzPEY0jHXs7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF_Q628fW28ZIWRv298BlJ0FPg-18k3syuFOrsmLcu6g&oe=6A4D1917"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zg6SWieN3KcQ7kNvwFg_mQO&_nc_oc=AdrRRftzqdA7CI8AQQ9m6TuHUFtPY1W7YAqVQUtAozs1nBNTYlXZ2uoy1iQYy56l4ps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0dHO0DBep_xE-uqWpeU0JJeMuNO71DYus4U96ft8ZXw&oe=6A4CEA71"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQfLEB600b0Q7kNvwEEV8yL&_nc_oc=AdrkD35D8B3ilMeRo-bgz1Fzgju4J1E-1ZGn1i-7bGJYDa4jK771sjnLKF9XFUnYb0U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5pWTA2vZtAMmddNqbXylTjqlajgEviyMN9_-Kzhjgjw&oe=6A4CF884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ICeUoF-FzAQ7kNvwFRIMmS&_nc_oc=AdpYCak4j3WmjBBLTiF0vg483yIu8eH1vcErPqhkvCAF7-zZTQDqVC6U9ZwLWz-uE0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrKDCItz0VSz2xu9bSH_v2zxlQnTH0B26hQ82sOGofyg&oe=6A4CECF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhRVG-XUMN8Q7kNvwHHySMV&_nc_oc=Adoq8d-92B22L68xZukAEcPvt_4SfUeGmI3t_QStu3K-dja3_iAFxVF8sHPVCR2s7Xo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFp8odg39SyraMcNFRVkFYfGxdcnVf4vlnOgiBdqCERzw&oe=6A75CA41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuM2GXeQjJ8Q7kNvwGqs3Ra&_nc_oc=Ado8Dz3IgaguKo-6EufCm-2XvJ4fYg-n-KX7VIbgiIaT5HXOggKzOeBl470SJ1cl2BA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_jtdsq5zDm23tPA-pkK1TwIxsgymv1BkZA8e_ncRx9w&oe=6A75F797"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmDoeKn7MJkQ7kNvwEAykCf&_nc_oc=AdrSTRfuSlRmwHnFgVBY6w_32ymZMkbb7S_KHskzhmsed7l0lBiGFZmVawNbKhFswHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcpp6kvMM79I3Hm85-mzOCEeKyPfavk2jgonnsGlSQNw&oe=6A75C8F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpQoNNIlQ_QQ7kNvwHkDcXn&_nc_oc=AdqUV5Icj4FQIDIiamnhfUzJh6tRw536XNUgt8cXslcMsOQMVx1mCO4vygHL1YJRK3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw8eisIDS9EaZdxFWd1MwuROV4DS5DQ1iznJrHMaXjhA&oe=6A75D704"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEcFTU8xty8Q7kNvwEl6AJR&_nc_oc=AdooN6ZAXY4Zg8GhXvvNpl9q3Hrq0Ye4-E3_nD6wywohoh8SmX-l-9UFdwcpE_qSYwQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFL8-JPVoQf1Y1rG-T-pbWGXggPYrHOyECKsRVCicD6DQ&oe=6A75CB73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
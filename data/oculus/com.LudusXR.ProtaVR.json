ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1g5nCPAaO8Q7kNvwH8zfZ6&_nc_oc=Adq-snIvEYB_yuWt1XYB1oLMYECzz1D1BB7Hd8fTkRUN1DaFlv2naCP6E-gTQ6qDrPE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKCkjARXOL2dGJ8RVmC8XBZ_JCSV5LZ3vVHpsXn3mobA&oe=6AC66E01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liS8s0-bKnkQ7kNvwGbIE5W&_nc_oc=AdqmxZ_F6b_lzmKwIjaS1hpUr7u9e81DYoUVupJv4uirFRsswbP9FK0pA_eMMOlCm8U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwZZetitWXAkOvyhBKErLUGjk9vZqoYhOlFivog51oXg&oe=6AC66317"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChENsW2CBPEQ7kNvwGJ_6GO&_nc_oc=AdoH77ns77-DCA2rZoAEF9XasEtLb18l1xCadhLKDd7D3HMfVYJ5pDvqsU0Hjhw0vQo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRenEHV0RnvBScprg9apMsEQt6ylfY5lhCdx7GGsaAHg&oe=6AC66CB1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6xZROhft9sQ7kNvwFzmBcD&_nc_oc=Ado7dmDUxHozyV00lXsH6Zjk_q0Ge2G4G0ZBtWTvavaRDcRp8rpUI-Qr6Bn3lVkjnyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGmijGlPaJg4bSPZflpwsHDsVEGt6SmY1qrGV06dH4rw&oe=6AC64284"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Lpm3MAK6OwQ7kNvwFKVq1F&_nc_oc=AdoSy6pl5C1NIb3q_aZDSWtgqNyPllEo-_4qZ_dRQqq7Jodpf6-P4N6SsWWtEN2bvC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPRrCzUuKgh8XOSfto7T5bNBpxx9pIv_OlIU3W8h4k7A&oe=6AC66F33"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQeZZBRZ3IwQ7kNvwHcC3ZL&_nc_oc=AdrekdwZXYwYW0V792ZOJYA2IuCIEVqh70BJH4-5OEDNtSSGJPlJdJG0wOFq6qEEy04&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zRB3Swh-PMBFjHDmEq-JCFliFTBgP9qQAeN0ZHLYB7Q&oe=69DCDC41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxDtonZMLBgQ7kNvwFWIcQk&_nc_oc=AdoIN56foRRsG1W01wE2kO62MysJ-AoDlUCIZ9hRdVdA1FUhs3ujyRt83lAsnTgc6a0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1byfn4oeRXTAjFU-XUg75OSZSgDQIp5o6JKkqrKvZWSA&oe=69DCD157"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAij9BgYIW8Q7kNvwGXJlS6&_nc_oc=AdrrO8ZDjPbxJWfhmvNvmXNL7OiENcRYaOHDR7cYDullpSUOvO_nDzgiTHsnVlAh46o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hqf0gWspD5DGrL-hhf53jvUDnTetPuT9ULzmWo3Obzg&oe=69DCDAF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OmJ9CyGP3UQ7kNvwGdRF-8&_nc_oc=AdonfImGra_yHEcAbDJP1DeLI1hQAJPVBbogYtURas2KYvT25qeJVDnLeqOICv98jxo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oPtmEnDKBInX5HaVHDe5_1gDvxEdLbdatdifJ1GZVzA&oe=69DCE904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzxvjxDaFFUQ7kNvwHIkRyI&_nc_oc=Adpv7pvVG1ujPOTx89HZCq-MUrKtyatr8NXlaPw5b1Pa05uoitQi6hx1ewrJMbqSRF8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Dh38HC4fucAYdBvaxxd7rk5IXSNOqsYvT-HIW0Jcrug&oe=69DCDD73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
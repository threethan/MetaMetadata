ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_kFnurABLIQ7kNvwGK_TZR&_nc_oc=AdpQi3TNk9EWVjqzI-VCodEFUnKj-c8tEuCyr0fcQahQw9lXZ8zvfcFAIp5PQm-7gCI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElW0zv6_unZVNnOSrvXFWTGA7SxHKMDKS9uvFfZCRHpA&oe=6A8C33C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rfpr7MERLnAQ7kNvwEvr82G&_nc_oc=AdoDd5x3kZgm-7EweQcYfLHNIqUe2t3X1UjxWnPCmekkMDkOVPQ-uwRENAbEeF1Opm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcugCWeBGIwa88kdzxZchN01ZMHBg7idklvyUflc9H8Q&oe=6A8C28D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHTDwV2To1gQ7kNvwEYitP8&_nc_oc=AdpwOcyuobg8myHLjIlvvZcP5TT8UW_5zIdvluYrHuXod8Nla03Fq6SC0LDYgg_B0MU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfJxdluY-jee2bIC8JGwqynTHXC_9aoLo3BUshbQ3gxQ&oe=6A8C3271"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYtkRttVho8Q7kNvwEAojWJ&_nc_oc=AdqYR2k7JxfOeAxsTd2KtUsShiHVSk0OZ4Z2r8GMZ81Bif-ruofEcQ-jT2i4r-YSVCA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3YQcmUK5qoM-jw-Fu8poGHl-27VFF2JiiLCtAGmxwyw&oe=6A8C4084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlpprOQmz6wQ7kNvwEJ31jH&_nc_oc=AdpTs2BbUSa0MjdDNdGTHVUDI4aT77ODSyse7w44Mjuavl6kary-nHaE6VoBES8Z19M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFR_30FMITlKfrKikYy2EKZM6ZlQexzA139URQcvFKIGg&oe=6A8C34F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
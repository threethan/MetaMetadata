ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0eimfbpeUoQ7kNvwGpcWzc&_nc_oc=Ado3pENAxZogUPlFERwXAjSIy8eXUl8l-PgEva7WWUF7c_AFaFbb6R0M707x--zBmj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_1IjRhWGuVi8mjV2Fp8vtQl9X6H6clp4Aq6aoSFEpuw&oe=6A999B01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R45itnPNC1QQ7kNvwE39j7h&_nc_oc=Adqd2MTObC9NpdrfYQR1FiSzE3zGvLGattXqAi72mh7AXaB8TWzh1kTZTcp07MmpAok&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTHRBUy0NGUoexQAmT0AJrv4bFe3Z-6EBaq1x0bcSQMg&oe=6A999017"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtiZzP_bikkQ7kNvwEi5X0m&_nc_oc=AdqsnD-vEsDP4ARbBOsNd-IMWyUuF7K_ga3H25nkDpoRqD00pmcRuO9ebdzASQhsMPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCZAnuVaL9xUV03It2CNXud9uAxlv8ECiuntz6ZNV_Gg&oe=6A9999B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNSRfDk3rDkQ7kNvwFU5n-J&_nc_oc=Adq0jRFiiWHJvVOsmNB1k2eBZNWhO52R-hGaQwL_d7RAXO3F9bNevbfBkXw4O2x_AnY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl_gONbXJwoALWdt2fJXrhHkwadWYuV5g_zuKeYZqR9Q&oe=6A996F84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW1NSR9gIbwQ7kNvwE07E5y&_nc_oc=AdrHRYyY24vCfhb0XUKUTC38aB2-SQjIGkG5sxLqrZN0XKL_Qh9mcTyJwpnAcAvEfik&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf12l-sIlxwpMDOL6QE3RlFipm3ljjiOsZv7b-AJmCmg&oe=6A999C33"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
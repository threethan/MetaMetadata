ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIlLJZyQrkAQ7kNvwGSyx-6&_nc_oc=AdomEw0IZwYPFRqCt9sXZHh-QhMT3TjS7XrFHV9OnyNZHAUcIe6Ygm5I7pW_tICdCHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92W_CH_BeTYt2-uee5eVBwFAsIwfXDvun5P0xZmTCgDA&oe=6A3AAF01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lZh6qWgNxhcQ7kNvwHp_PtJ&_nc_oc=Adot0KPbhlsG6qOvBYIisyHz6VdujFMQy9J8mZ7Ptf37Gg8OldDblI5Do1Hx5gzZ_ic&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eXw1FxRkl6yhNc6dikc8wXjx_cI7Dkv0vpK4nkMzb3g&oe=6A3AA417"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwiVQokdgk8Q7kNvwGe9l5U&_nc_oc=AdqMIitIOrevecwsk49Ld1Sbhv-p5pbEwboL-_cnEfSID4Kq0O3nYxGehMOrPJY5ACE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-tMVBaeBF1DRU7pAxS-uI1wvElPjCTZ_oYkRkSHIc7g&oe=6A3AADB1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ubEmsTLDDIQ7kNvwHuV_PC&_nc_oc=AdrITXX1gDGLtT6gyrL4mZ4Dx2pRDjaShpmuui61iDeRydmxIm2PbjMskSj67xfSx4o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lFvLhnRylTsy_csMH_ssqncG8lENf-CQ1HVjEHoBkMQ&oe=6A3ABBC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dvXsD0_4kd8Q7kNvwHOw6wq&_nc_oc=AdosfEF2upw9teA-sFPHjxjERpag1uyQWavpX3CN9AOQZPxXYLdJ8B41j60ZejM0LII&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UVZgZhE9O_M1YsNHfrYjhbZi3mW9IcJzgKGmp1fKZLQ&oe=6A3AB033"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
3_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppVcOs9gmpAQ7kNvwEIMe6M&_nc_oc=AdmfXOCBZActHuofmq-eL0zzWY-2tpHLrZ2gBwCX0Jdb76Y1MmMLEyOmgXuZtreOMMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afv6V8ClS4ZLJ2j06xx_DpGNRivvdsFYTL4emjhYyMursg&oe=699C42C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7p-_ImGWCwQ7kNvwEFFjvf&_nc_oc=AdnVuqyqQk-MEwZ7tGn-R1UXd-0Xz3sqNpalvX8elzLWZMaSOxg0LmHvV-7lZ6gIqLY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsgQCwhYnc25DeAd2sI8XcEpp-scik75_zesk7RfAcGrw&oe=699C37D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fvTlDUzVZBQQ7kNvwHc08Ko&_nc_oc=AdlkK6JkG0lZZqOBo2Im_ae3WFUbfVEeD5xKsbUjgg7pW9BSEeRhLnH1Sa1lS11F0RI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsLj68e-1W2oaywJuSrTaKWxKGjzKhqSykItZCqa_SKfA&oe=699C4171"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NV2sy4E5pU8Q7kNvwHDHm_n&_nc_oc=AdlKxfPKP4UTLA1vx4O4nCJlIvWvxJMo69d4I9BAM3WSFcD-tJqi2YHtTTpguCdsuo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuBL6Y-Qjgq72CRik48ouI7uERUVcw-dHuoTt8mqSaOlA&oe=699C4F84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DyP_mTfqyesQ7kNvwHQrnvn&_nc_oc=AdmgBWpDvzpzvy8cJX5u_nc1m9aT_jM_YmGv056Nv-KDMWQiQXo39DZIg_CBUn_VDi0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuNTRXn5JE3D4CJnKqm9PfHxuBN2nlTgPhScTE7MYyfeQ&oe=699C43F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
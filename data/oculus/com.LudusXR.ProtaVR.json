ota4.png", "id": "1510165476601670", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwK3FMzew-kQ7kNvwHhiO1u&_nc_oc=AdpJ2c4aJ5Uc3X-Hftqt86j0gjkP1G5NBdEPcvjf0yLMjjgxi8frFSz9sISJGoKd3oQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkEBIvZHfRxkCG4LNBtGfDhxYTHFheJk9G7p-iuTJxuA&oe=6AECA981"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvy8C86KxoUQ7kNvwGJlBcE&_nc_oc=AdrB1yW6WlLwbhJuIVAXdqqTt-7Dg_P4BW3y5pC0NyiynGOr8xXlnXgvOQ7Ric9_7w0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6U4t37bHr6aRQgcA9VWQ52U5zGIjdBQ6BMj0dNpamsQ&oe=6AEC9E97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_n6M1y_7RkQ7kNvwHlLNXI&_nc_oc=AdoN9ywnMQOmjDmZLtYEAvYhCPvHrM52d7pdvL5Jyr3izJYreUxgAhiaHFxz5SplTNs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDaY1YoK_hXF2QYnWC72KWfGcEttePEjoQssDmOdhYLQ&oe=6AECA831"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9CzzS0zHVoQ7kNvwFJOYBy&_nc_oc=Adrsv_V5fp6xXal8tMQSxEqVJXITayYq77yhdT2HGTOmXRXcDZgCsgfK25CpBBI84aE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQnOkgfNW8j70ZmVad6_ABqb9OQsqThop5DFZITGxnRA&oe=6AECB644"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85trLDCEOxEQ7kNvwEBpBfl&_nc_oc=AdrF3O-C0dvldLC7uDtAyhgWXkvZXbg8ly-yDqFtdNmKQXPXzCw-UvxqTCDK9JWQtQk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBdwZZY8ma28XMQVFF15RTL6G2e4pIc5jxmT5d1IXUZA&oe=6AECAAB3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
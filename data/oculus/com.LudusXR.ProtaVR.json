ota4.png", "id": "1510165476601670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMzMtwdQxXAQ7kNvwH57Eq9&_nc_oc=Ado1MC98HAz7xQOJ64sqmK6DIeMI_CtDgwg8ICpjoLT6VWQ4WltqE4BLeXnMZAdR_TM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-F4pi1NJnVdYZ4D_uwuQJe2nJKXFX9rCrF9dxvCHVNow&oe=6A414681"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEopLoP48DcQ7kNvwF_7Sww&_nc_oc=AdoQ4KX3lTYVMw2b8SVxqfR9B_y3ADf4ql1ywQYvUvGYZJdEDp3zuThttY5tPb8w2xA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jxOHVLrMirr64dQekkk4SyrHt-oGy9Rgd7f3lEj8-rg&oe=6A413B97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx7ruDv7__QQ7kNvwHnKNJF&_nc_oc=AdotPYAioXDyMjBAY79GrhNuoj6QaCftg29H48RI2UByXCwAWci5QNz49XjUY8HGpBQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-N8_umSPresfp6-ti-Gjav8zebDViIkU5rYNCfqPs0oQ&oe=6A414531"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EY7-CmwKlgsQ7kNvwGXNQWr&_nc_oc=AdoBHfr-cpJqEpPFeAr9OOTt0AYeDuuWBLJePVxXGJoVos3Z9i0LxyFSsbV2zt2is-4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8eDpWZDB5XzCO_cuqmoqEu1ba7GNpVXBTua_ug0uiSBw&oe=6A411B04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqB8LX0PsbQQ7kNvwGIFw69&_nc_oc=AdqoqHRtuAZX7u7eMo0ASXx1n0NPLh6fZLGWZZV-o-w8iQAgp-2Q-Olw0tf6EkIj19g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xAVuIQosKdG8c6HjbtR4hKIjRag1K-uvNkwMrVAl58Q&oe=6A4147B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
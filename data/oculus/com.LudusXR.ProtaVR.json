3_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NiCUWqqqKSQQ7kNvwFTWzBi&_nc_oc=AdpvD1mus_82ObGe8IV3DpcmgguAphsVdwuzpy_tcV6jw3pL2mbpO9jV2vULZAppQBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3rp_LtdWbxw4yOKaS6VDnDfZAbyQoWlIvl1W9q47rQIg&oe=69F0A2C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OuWFdHxtQw0Q7kNvwGInoDI&_nc_oc=AdqKN20wXBgYH9Og_iX0mi3LZDgIVWYOmTnDNnDfaZnwXjqfn_4zhPwV3dtTqj1Zq1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1IRALDGXElvjYlXbpk0ZaVqz2IPDvoNnqXAlw6svlczA&oe=69F0D017"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk01SmoUh5IQ7kNvwHPVZVV&_nc_oc=AdqDqfqZy7BDH_p7FGEZLeyTme0Zi4T3OZYt_VyD3kAvPADnVGmRqzEGDS6cI2Q9PC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1iQ1I0RrkNeMiEs_fzpPwzTRPzrHolc7UCmMmTzkQYdw&oe=69F0A171"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2mla32xRUcQ7kNvwEoasG_&_nc_oc=AdrUMw0DjF0kDm8aqdDaIdUEWc64u3vpp6l-jXeNyXSlR8yj3s-9zQA4Lp3bynjHXuE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0XnvUxcYB1Ixtni48EUg5_7DcqN8GcZT_hpwbbYxOCDw&oe=69F0AF84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zKiWuVG9QV4Q7kNvwEgvTTm&_nc_oc=Adpm5Iz-qLsNru4V1PAaG-jTuj2fzZfNegqzJrDgDE-wegRg_amAsYLEQpKzVrddmto&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2T9OXqSbRkY2al0SxYr7r5LH9WSasFapo-BNZPfiIugg&oe=69F0A3F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7_NnwO2nzkQ7kNvwHrh3h4&_nc_oc=AdoArcKLKFNR905BeWP2qZGLYF3q53LjOrPnabDFA_VyUiP5PN0JlTUo2ktQCFRMeFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rxZAFQxHQ41eHQRhzUbQOOlx-psKVtsgNzhssh6Sxtg&oe=69EDFFC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y95dTsrGFpwQ7kNvwGHsrii&_nc_oc=Adohmx8sPe8569qTlqY4XX4ejEQfZvVKMha-hFSKyKWDdCxNY1ICz_L5LM5q8UkICJA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13oJ3AMcPExXIljXjDbuwfyrgud-owu2r9wDmzISzvIg&oe=69EDF4D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrvoBMNI5r0Q7kNvwGLfQsg&_nc_oc=AdqJKCtO8maZbLLod8T9Pi8kxUwAXkU6zaynCLDiUmJE6ASQJst0ux_3V4YpQP1D7Ig&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2FXb4gqWA3KDVzN4WtprgOJsZwwe0XQImEqcSdUa_pZg&oe=69EDFE71"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZOdZW_OdCIQ7kNvwHgkk2u&_nc_oc=AdqAVMd2qV1SPCNBVCc6msWGLAsrNGq2qgLqppoavr08iVlGMqppLWaNvIJD4eQrjRM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34NSN4MaRHVGeVdeULQz2KWNp5N5FzCYBI44MhhyVwEQ&oe=69EE0C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqk-iMGzlKgQ7kNvwErXTk0&_nc_oc=AdpqtAt92bhNlUFE6SVsxmaluHdj8SDlpkY0DBgfaOVahEtMuGo7b7DGtXan2oNpNAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LMEauU8ZvNmkwwj71_0HZM3QSxCHDHN-_FL6jdwfcKw&oe=69EE00F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
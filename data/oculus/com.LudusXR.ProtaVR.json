ota4.png", "id": "1510165476601670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zexbwAKYWXkQ7kNvwEW-7ai&_nc_oc=AdpUSKRNBj2L-VHsOzJUoZyDhxjmIUoEl811rR3PTHTEBWBGnDCSCwqHhSAGaC1QbGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VePpWwQDUJJ7lNG8RXwHbgs6D1W_vfEYLlYCnH5MK0g&oe=69DA3941"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZoW7Q4VuMDwQ7kNvwEw6cGx&_nc_oc=AdrZRFJdVFz91eExoLBoQfGo0ByGm9TJj_DK4ibLAMnMKaag4RDNs-LkyOvxasIYcb4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24pA-v1a1I2zZx150-7JyTcQPuqO0SSGJG-W7zpbTg_w&oe=69DA2E57"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPeh6aJuMZ0Q7kNvwExjUdg&_nc_oc=AdrM4nlkbnCJF_RMfQLunjpvX-uaW8XhypXc4gUBpG9LlzeZtAVtpiHF-8eTprDR1u8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3grak-Rd3391e2IDPBHDhLMR5KXRLJTdU-8dK-1osRUQ&oe=69DA37F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S_Hmx6rOL4Q7kNvwEIGL9R&_nc_oc=AdrlJoYZx2ONNYwiCbayyVEnRSn8-N5fXvdwM04uUIy5HI7wcHTq9WFjdG0CTvrpByE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ILd71HNJAicvumR5KRk1mcr89rWE1zEdIce-smU2vgw&oe=69DA4604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umoN5tE1m0EQ7kNvwFgOh4b&_nc_oc=AdpFrrdidlLdn7VqBcgmORM01J_JECHnU2_vTkWzOBJ2OuIr1SHojlMqDt-44ghaqAY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05AyeuUFFbTI1DVHf-GExbWx9PyeLj6pXSC2UxWbyfFA&oe=69DA3A73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
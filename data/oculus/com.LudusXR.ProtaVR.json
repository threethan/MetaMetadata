ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNa7TuMqWdQQ7kNvwGeRP5V&_nc_oc=Adom86gyValNFEkyebBm46UKWYZ78g4lInwhETT8m8N5w9rhb2U5DkUgtX7gbbq6bX0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JJZSfQXRIlla4FyuN8IHuJdcZtmBY2rdsLNtvAI_Scw&oe=6A046941"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8PrTl7Jx5UQ7kNvwFp5e5C&_nc_oc=AdpJpmFbACfR0vB7raIciSmc7wMu8sNqqotIOpLe1zmFV1H1K822A_O5uaev5OY8NTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56sXj4bbFnBvyfqMsEIyl881fqEMGWExfHZue7bQJSsg&oe=6A049697"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cl36BN-8GK8Q7kNvwE1Y-tB&_nc_oc=Adp-aTrnv5mp96jXjxWmwUP2U1UumVH1PpPlOs87bnCkL0ae6jbbqTQrVrwAucpH6lk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X0IK7v_6O78I5Yt0Al4q6qxpvgiYRHEHCst4NgOlo0w&oe=6A0467F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mN9qujVRsRcQ7kNvwEpZ5kn&_nc_oc=AdpN1121qy72YoWCtQl-84vd9pP3Xu_XmOgyxG2tVciINvmFmGZ8YZejEUG3MgH6zyY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BBxCq11hyYslDsH86QO0KnZjEg_KkyQkQmrXUitaQeQ&oe=6A047604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3C1Ogb4vuAQ7kNvwEJ4hxc&_nc_oc=AdqW1VCpQiazPhXFBdx4OcoslaCoe4as7YHd85zBnmIP7_oPDasxVa65yqKzGqKe7hk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AjTmkFM6XKPdv1hdvaFK83GrQl9u0r79onD4O9XmCHQ&oe=6A046A73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
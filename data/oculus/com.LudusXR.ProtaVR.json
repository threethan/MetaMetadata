70", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8DkkzCZeCccQ7kNvwHS8AKa&_nc_oc=Adnv4c7kn-VM2omAXyfqahfXRQLKXpO3kZ4wwgdIougzAf10TWweC57o2jySNsfS94s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afx23aPzdL56Yf6J1i-U1H11m70UHf4u7w5VzUz0cp2Tzw&oe=69BFDB41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9sLpjVfjJYQ7kNvwF6XCFh&_nc_oc=AdkxaPJAkMmThBImDR3bThnMahimJu60zebFdtdz7wus473nLVrruJXJe3v5irNDR08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxjS-32rQTU0ROirOOoaHlG-Rxex-kkPFfBD4BfNRFBvQ&oe=69BFD057"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mfz7YXbYQEQ7kNvwH9PUKn&_nc_oc=AdlraKpiO8K2yqJjRjvBGm__7bFt29L7SchndnBnD13fZrQwlGGwR7lmKWuKa-tzliA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy8SLZLSEO9jptiX8VwFJ_NMT1gAgJYnWBvXPlkzcCgMQ&oe=69BFD9F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWL1J6g6FSwQ7kNvwFyeubR&_nc_oc=AdnR2i0__0PN0Z9tei7uEvDaG1LMJZS-spOFIMwJj1BxbCig3bIYoLJ2pozpj1Dt8pY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvtDtR8ZHr-PMAEtyBhGZLvleCRFc09zfsufwguLDWkA&oe=69BFE804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PeLCvq9BJ70Q7kNvwGw9Tqi&_nc_oc=Adlln4Y0XMsDIZhzht7ARu8wYfy7QdNXR2zvCERNrZz4Jwu8z2rhZMk5fEIrXb8gI3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzslehsqRXPzusw1thYlH-vYP6NSDLUfHC_fCbG-r1paA&oe=69BFDC73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
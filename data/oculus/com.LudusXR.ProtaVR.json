ota4.png", "id": "1510165476601670", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tC_nXmTMa20Q7kNvwGdbiRv&_nc_oc=Adorsg7D57vr1duLb8ze1ogaCPeFo7q5uCkvF8sDKglXFQhA-1EEzOiZrdvXs1OGznw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFBGLZRGzPa8K_9zTan9u9H7AJY1CFLvz8a9I5mA-VPA&oe=6A5A1AC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnofAcm3MpIQ7kNvwG0_O_i&_nc_oc=Adqm9k26JGFJAx2RsDy3Pl9mzbuyUIjNofnt8cxBYun9GowgB6kXOR4iL5Lhq-cHZGU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbSAOVbSy4Bi7TSd5ox6W-MuTEZNq4qhT7gEF4_-3ojA&oe=6A5A4817"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UsvWV6QzruUQ7kNvwF9r7km&_nc_oc=AdrnFRYZxbDPOSpTNC-aBZh1sm3x-Dz15n71NMJp5dF54mASBdDzKrGDMf8Ie-JKkTQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUz16d1i0Er2bHx-QoHzM_5_Jp5yK5BSiX_AIVimDdNA&oe=6A5A1971"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvJpdHM7AIgQ7kNvwHcV_sH&_nc_oc=AdrhS7OSBLXnWh2OFNRKFC8_09_gq_95hNuhnQp5oSLyKC3xDQkpKvwfxa5IyC3p9O8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb4qeBJZeZClPD0NBL-4lg5Vm-O9ryVACCuSWbI2mW_A&oe=6A5A2784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyp9PUqIDEgQ7kNvwE99UY3&_nc_oc=Adq_BqSO8iEZBAzoLpY-VSKGcUNnezowsMtnmpjHdTvL0KnzrPioIQitcg1cAxqSdqE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRmPjeY6kvHSFGBFVMOTuC-0trd9pEUwRKDX9mVf_OfA&oe=6A5A1BF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
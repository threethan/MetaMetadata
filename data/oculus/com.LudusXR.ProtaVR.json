ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiB3u7Gu1M4Q7kNvwG3Agwd&_nc_oc=Adpgp4F9Rlh7p330D-oNRImOUwp8B1_iMchdEfLsrHJCLZSR4kGh3Lj7lZJSI8jaIvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LrUgCO442B84qepOFtkgQezn0Fw0Uaqjr6Z5w5wKcgg&oe=6A283A01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApO0FlvGXAIQ7kNvwGso6-u&_nc_oc=AdpEX-jVEa5mRVGKOFmtEtp9huS-DVhFtrwohYz6rp35z-ek7SUmdnhWMmpSDiu9xng&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Eid7oWAqoJNwQQp_XF4YK-ggGWLkBPtcJoab0g2nh3g&oe=6A282F17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nX5wsqOFHGAQ7kNvwEQEJ4q&_nc_oc=AdqfoAI2sylb_4Up2pEj6zQd38jxOEVtZl1hOy1bv0CqBK0n-siJnMfpL8tipI4O7GQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_gkN8VMG0koLqiUQvGOfcVImlKBO9KOGYNn_kjTT3NbA&oe=6A2838B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyUNB3FmM_gQ7kNvwGLwZMH&_nc_oc=Adr0mdm7iZ1FnizDcM7k-cT6pt9fmHAEyYqFRGKjuNb7n_xGW_rPcbC5hmu1-BNqCsw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kgZruT5BSbkkXduhTO5uc2SvkdrYOAkmGnsC-sQ0bSA&oe=6A280E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fED9Eszgo5sQ7kNvwGs90hp&_nc_oc=Adpb08_h46J3aYb1vbEY55AdxgpKPc7lnR3ZO2u4BML8N4jqBpu8cXmrHKj9LYs7hCg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lMq1fMMMvdGdu_6IEAXplMb2GXP22XalzQYU9mn-BIw&oe=6A283B33"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
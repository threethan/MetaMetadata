ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc90794LsDcQ7kNvwGUljqu&_nc_oc=AdpX4pc_OOSn-7FvkNvmtSVfkI38epdJJirA8rajnFn4ZaMaBYS4Ywse7jan1tyzeZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL08KtqVJMZzj5HCKtkElV1n1-KgiPRoBqAPJCDID1JQ&oe=6A635541"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlGtWrbZNj8Q7kNvwFDzh21&_nc_oc=Ado1kGh-aB_URZpyYqsbiCWoL4TDW4UmYyxLqwtVzyqNaIwzYIITpMSTg93qe6RJczc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArMv4LU4p21OK--qsNwZ-1rPfbzncWn1LUmHXAXygCqQ&oe=6A638297"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xmfrGhqk5-kQ7kNvwFdZg2k&_nc_oc=Ado7wL4291EoOhVQ5M4PqOSib5I-HHlvVblQI9recBg4phBuTq0XK1FkX9FmquBxtB8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDo3VnmKMK6sxNl96L5xJv-cvIBqn1meUqSILPObo2BYw&oe=6A6353F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EdWJodzYHjYQ7kNvwEi0abZ&_nc_oc=Adq2BYwnm-Yr3bOuSYWiEflTAjI51aPw1671t_WLNs9JRR-LkXAMmx9wjDjd9MKezfc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv88g1_DYzcnJrALvfujmJxx1ivKuv7HbxbA-u-w2c3g&oe=6A636204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_OvM7CnDawQ7kNvwHQ8tz5&_nc_oc=AdoY0kZCYWWex66JNw_Rl4OjqENXBMJ7lQ5C4yFMOFOZy4_ztEjnNoYVVZjhHEKEW1Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-bm7yCMHeVIYQHdUFL07UdtkyRyD7DOlnj1j1nec0mg&oe=6A635673"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hOhuCM7sl0Q7kNvwGSC0rB&_nc_oc=Adp0XVJoFaZxbXRGe5gDBL5MuC-Dcp7JqDCckeuFeLShn_BXB1sXP8juK0uiCYdsmxM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFCDo9oXvEkIMWKQv3YYf1CQot4xutEjShhJr2Zq50XA&oe=6ABE8501"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s84i2t1k2WoQ7kNvwEvrGsm&_nc_oc=AdoxR2EgzcV_SchCjDXkTaI6HL35qQtXQFxfV4F2zm4a51BpAb-DecShDz8YFXJK_nM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwIO3c1uIz4K92jrMCqsyKlm7QdOSoRa8WALqUFoRPuw&oe=6ABE7A17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61GUcbdOd9EQ7kNvwHak0kc&_nc_oc=Adr4EOv3glp_AisqQvC0Fl5Fbwt9QRL0YrIpGySy5Gj0_5BeZ_8_kaMSfdNnNie0fFY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHMhD0B1TIEQh539tnRolpIQw095Rdd2MoSXIQ1r-kTA&oe=6ABE83B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tq_YVEsiAz8Q7kNvwHCw2zy&_nc_oc=Adpf83capwI540A7Ocz5y3DJkXUoX83roW1QR_I9IZF_nF4OuE1oWv_uBZp4SFik6GI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV386hbUzrUEE2HdW8BtxFIBOyOqL245QoP2ZCA6Co4A&oe=6ABE5984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U9bqC3xqqwQ7kNvwFECnLK&_nc_oc=AdrlDWnCEeUPolViRVJMQvFNounxoKxf0AuCVkuk3cCJNkNnRlRKDynLHpvOUTpArfo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxq_wVXgf-cc0_X2ONUW1S4s_4Dezg6kJwW9SejCXqyg&oe=6ABE8633"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
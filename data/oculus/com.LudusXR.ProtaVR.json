3_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=15hHLE0RejsQ7kNvwF81XXR&_nc_oc=AdkEUzTVz0CKH17kXzEPE-SsZ5-Y9kDqXZFUBbwNCNgyxv_H44LrDc3lSS1TBWZaojs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsWkIlCKbgnwd44Otexq3hzhxL8WBui0gUBg0YCFlWALA&oe=69984E41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e8RTdC1IOFcQ7kNvwFjMS0F&_nc_oc=Adlc5uOlcCloHi0sdJZ2vO_X70cEtoK5Zd6Vp0xUlAqZRdtuEIPCMqyVv2gdD5nwo4I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfuElkTctiYnAUtJGTmtDzUx8z6IXUt_C-RSqscop8Dl1w&oe=69984357"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_n5V6oVh7QQ7kNvwGxRw0s&_nc_oc=AdlFOwuNdT4k1UiWgoD4OjPE1Ow6EBiyWzn0xK2KcvBHzjmrSOrQxN0hCZZwHsDUx4Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvuWwx4OYnS3AWEQ5nimR9FhkX6UMpJxgZQjjyu6VyxWQ&oe=69984CF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYY-0ULbltEQ7kNvwGGpXGO&_nc_oc=AdlZR81tY9XPHf6EeQkpItzxFirpgeoJrJLGCjkjAj4d-Vx513osgxwXlfCN2Tjmrio&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvDULBYt5ktCZxoONeUfHENRW5amZ95XHOD5rWU1oT6YQ&oe=69985B04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMXRQBwERQ4Q7kNvwGwXVxh&_nc_oc=AdmWkX0SpxQFU3hUpfWooJErh72pE_HBisZSE5zd2BUV4TjAsL3NjKJPuAPcPZNXdBQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AftFQhh1g8MxdRCBfXpz0zpPlUnaC1sIU2cBAPiEpLmYiw&oe=69984F73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "sup
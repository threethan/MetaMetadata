ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA66SNDLd64Q7kNvwGXZFlQ&_nc_oc=AdqJf1TF0ibTY67Jy-pjVylSq9bP5MjNDtwNxShc1alAGB5TiRCWNfDLlmGwlUrrkFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBz6fhYh9yDEnibgvnW07Tt0XN8y6UKJW2jx_erfTLyQ&oe=6A9EE101"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5U3YZaDwkiwQ7kNvwHYPuZ-&_nc_oc=AdqWd1RztoMAl3LRSnjck72k7b_tryyRbl8cWvwz333NAYE7zL-lZjB_T8EIlVxC3Xs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6OZHeo7kSUt2D-cB3YMj_pYYUjPCzkJjwFRVYiFowkg&oe=6A9ED617"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_MUdxy1CosQ7kNvwFfTO8o&_nc_oc=AdpamHsS6XbYeLMkipwyIZx_kaFNFGi5cJpV1lLoYlJl0AQEGmd-otm1Yk27H_6pCYE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtF0WIY6E25mZG8-X4uns4CwtCWehl7YsOraGQrrLa2A&oe=6A9EDFB1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0fpRakTM8YQ7kNvwESNaKs&_nc_oc=AdoKMRmzWwxeQ5RqRePda5GfIY8xO00tTGcB53BgJZFVDMxk_P4ED2FFRQr9mzB-XhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKysu2AvzJb1DH97skXfKOrEj8aNjy2hsDt9nxfsyo5qg&oe=6A9EB584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q2ZyLR6n5wQ7kNvwFceqP3&_nc_oc=AdqwQzVvjtU367qQrTQgMooLmu3ShEIR9h8Qm6K-x7YgXbrEwfuweAjEyirHHKYVwyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0aJhplTuyxd35f5vjNp4dhxqlKaYGQG8cuCLVBBVZNA&oe=6A9EE233"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
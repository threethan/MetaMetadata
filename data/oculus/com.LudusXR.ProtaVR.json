ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA66SNDLd64Q7kNvwHuX0sa&_nc_oc=AdpuYi1kIna4izzRpZq35PdjEKNaiSJ8s5BKL7R_RynUwkIs7AH3EHCipxRlt9eZIWE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLscSLyhWw8iwFTfJdjBjp5AOPv0xhpaZSA7ATXOrwA2g&oe=6A9D5741"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5U3YZaDwkiwQ7kNvwGEd7io&_nc_oc=AdoGAPkKef7htxlHFnKnX8YXdYehnw-oJ6WT4DiTIzAlGHsWSql0aQ34YhRgzVOb_o4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOpEuAe45Uj-W4e_UNlK1q6GvEdNKF6FyqgGqBBqdkfw&oe=6A9D8497"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAAkAOXuFUAQ7kNvwHllX7v&_nc_oc=Adq1q0JjslZ04TkeynwEyk4gUn4EcGWjP0FRnHfHVG-_JrqyMsGoX1k2gl3vmd5I3Uk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLX8KDRn1LMaoXcSddqztVERtdVIZn6WtKjaoYSopXJUQ&oe=6A9D55F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx9KBwYaun8Q7kNvwFvEB6i&_nc_oc=AdrG8-FfDvEsMTtNx5cZKJnW5piXNwwH6EMpyuvxkS2vfXUs_9xoYUg_PpXCnuISkkQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOVdV2KUeCR1FnPf7D05PmOTEIVwi5e1h6aW7wRhyoJQ&oe=6A9D6404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q2ZyLR6n5wQ7kNvwFPENFM&_nc_oc=AdpVYnDsT45P3w2eT8ZSj35luwJwasNOYZl300mVygkYjB0gGt2j6Ph73RGt4dsAorE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKskpzvbqQobBJ4MenNI9jsRMOZB0iF7-nqRDIvxSl48g&oe=6A9D5873"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
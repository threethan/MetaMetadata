ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixTpwBjyPhIQ7kNvwERNFbL&_nc_oc=Ado0hCWdKMx_JrTtqjAhxwM5OCcGd-ZyJMF89ebzTxqpwb_GyHJ2dlj5sSBxNxG2Ja0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5_yuRmMA9XzWOjG3-sc_EztFRcA0ramsJO-gJd-wbEg&oe=6A7478C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0cTjrLWew0Q7kNvwERQrGe&_nc_oc=AdqhBYdsrde0a7hosAw0waQT2tXLqiiW2DL2v8W5cL3adEfKjIvrbWWlgw8FllNF0CA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtylmyGtYuLvjEPPhPKepueaG4fjOqA5zdPU9kb5l1rQ&oe=6A74A617"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmDoeKn7MJkQ7kNvwF3MUw-&_nc_oc=Adow1-aKBFwx0QqZw59Tx0RZakg56gzdqv9CdZjva8jMV7a2SvqWCVqPKwgH5mLxBj8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOjrgkRHF6CImLrQZiGCMnm8P6f4yQS0EsIPr9jhiZ7w&oe=6A747771"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpQoNNIlQ_QQ7kNvwE9IGCA&_nc_oc=AdrtlUjM3-1MUTi9lmZd9JBjAi7-_f9NdCVBTYyGtTtyY7gKtiszbHVc6O1rYrh8pvo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjirlkANSRqIyRiFgYv0Yojnp88otlXpCPI3yAo8uMjA&oe=6A748584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQPXNrLfK6EQ7kNvwEQyFvh&_nc_oc=AdpYVqxqvrhH3M8ls_TaQ1SjdjsUfaAJeni8StcJU50o0roBTuQ6DdFNU41rSfr8pAA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFSdP8HvL43QSERxakn6jQ25cDeMHxGYRBO36E5spLJA&oe=6A7479F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
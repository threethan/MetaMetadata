ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO5rTcyMUP0Q7kNvwGTnws8&_nc_oc=AdparnbQNhmTOjoesKqNYDbqsGwnKlAm4nQlTUrzLzDSRwzlTmU7g3ExAxCppBdMPqE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPni6X6Tqf0YdPo4DYOa7aTJINABOHPl2iM3Ew7IJgvQ&oe=6ABA9081"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3WCnndBFJkQ7kNvwGmOMuj&_nc_oc=AdoDU_mTsdUIoTHkkmoznGdS-U0aedyOugKuzyDMzILzC9zJjps_e90B-g1fLOmMSbw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbE1r2zbw541n_D9QpTN43gSDgro_CnS5VFyi9aOZRnw&oe=6ABA8597"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPXeuqbcUOcQ7kNvwGcV36b&_nc_oc=AdoWWfIiYihEUAEdaQpRv9UQYBToQM3Glm461j9J_18EdilZTmtEoLgUC8OgDvqiBSk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnme2I6prhm6CJIesxQU1oMsbdFvZKi6nIJGvVTqCowQ&oe=6ABA8F31"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6LuSEfBDrsQ7kNvwFVPZfe&_nc_oc=AdrfpGj8P9aiYxJ3G2VJAr4Rc4QQAiGF6EuQVfqukBPoPhcGJZgxONA5uUYhdzZfsLA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6EhkpIk6gyaJ-kYtwROGx3v01v5diBRuNFnWy2T_84g&oe=6ABA6504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buEjR9NA0cwQ7kNvwF3N2op&_nc_oc=AdphlPJyMoP1iiM8064PV8ir-Fp3verWvcLtQGE7i70-BoLvlGLnI9wEmIrV0fEvWyo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc8R0zlh3Uhg1uGSUJR_GTBzY5dZJaek62gVeESgcomQ&oe=6ABA5973"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pv2TocDijZ8Q7kNvwEuhJGW&_nc_oc=AdojMcPe2cgG0U4m7dVcjkofSFQvBJ9YAXGfOEiUR6a479PQPPd69zbo-Ed7l930WEk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8u868UK9UTNQPLjHfP6S_ogMW9hErMRCrjKRvUERyT5w&oe=6A32C601"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFTKUCZGxtQQ7kNvwFdzgMx&_nc_oc=AdrlPcCQyjMSpmR-OrElATNXyicVszQc3Hd2vS1EDtMceTDQr0SP50XE3EejUHmdj9U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--gDbzREz2uVvHWB2UKJ23UnfSO1Gk3D3-7nAzXaw1zw&oe=6A32BB17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWyUxZq3mAAQ7kNvwG6vFu_&_nc_oc=Adp6Ns6HD2YBLZ8atzIgtFTmGh5wB5qwo6Ri_cezK7n-Zc8TKfJhyxnRpkLVYKyA7nA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af98O15b0C4VMWmBG3z4cb_RXVZiIZ6BmcAzV06mY9RM0g&oe=6A32C4B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QhsDDtJNRY4Q7kNvwHQjeDm&_nc_oc=AdoExZIxhjC4gypQ5jodcMReMnIRkA7jXnlIn6-0Xr4MRLlpzyt5e__jnLhe0Kpzhho&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EYrYDM5fg5LV75BXTCj0UMNx1lAofviSdNZQN_AbiOA&oe=6A329A84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqfdEHXQll4Q7kNvwF1afI3&_nc_oc=AdoP8MkKaRr56oX8-OfqrundFl0h53kanKlwm_S0FIodG0238TMLxgNeQm9PXBZ65vk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LJRa1HF5Axa-fA82oyONyD9Z321qzsNBqBH6Zt1nDIQ&oe=6A32C733"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
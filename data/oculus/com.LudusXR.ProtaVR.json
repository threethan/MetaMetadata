ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rO5rTcyMUP0Q7kNvwHVRX7a&_nc_oc=AdoKDtzl-DgPEYBOrAo9-38TRlLunhiBENFjCnIzvhHPX3_Q1c6k-jC_hrpMgqiXeR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKUVVeuDRIkkkSw1y6261uYQUnYIsa-m1OU2x6WrBeig&oe=6AB93F01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3WCnndBFJkQ7kNvwFx0_PY&_nc_oc=Adq-d0_C-z6BdTVHLDzLNi4qgv2HFG6-OEsDNrxfYrSRGWVNHVPK8Dwx6CRMrt5mlPk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB3yEmbLcBl9V9az9tRlSOLyhduNGEMqvcZqnrAMfmHA&oe=6AB93417"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dq_79ae9qNEQ7kNvwH93Si8&_nc_oc=AdqHbi7m1cbF5URY9YX727GhX055S50XlpkCLamQZQcz0Aea9bPVP_4WHDdc6TQqrXw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_YUj66M9RRSoiBtjYhKB9v9l4MoRoRiaxZJ2Ami6ebw&oe=6AB93DB1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxFhoJ2jwdQQ7kNvwEvQqE1&_nc_oc=AdpFALVYsZpF3auOVALfuInuZx7fzf9_OCJtayoNVaSFF_D2_6fcZ16D_yC3VMTnEts&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKNneC950sdHTgYh2BNbPw-rJGoJcLjdgz89WRa18cE6A&oe=6AB91384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buEjR9NA0cwQ7kNvwE5lUu-&_nc_oc=Adqp8kF7UywSAlX2jtOHuWqMdb6sopjbxin5klWs8vNIbVE_aRZPeCqcU_UL0ypq03c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFiwlBjc2YKm5jJZuz4vz93e5EJklZLZJRoww1gCjP-A&oe=6AB94033"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
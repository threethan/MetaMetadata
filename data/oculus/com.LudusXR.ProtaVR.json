ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hOhuCM7sl0Q7kNvwEFSRXQ&_nc_oc=AdppbVagHeruBLEO3nPiDL2WFdxKlAMZMKUkDxFr_jB9j3LhQuZuSxxo3e0TVIN4krc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbBGYxmF7WeSN_2yzD4Lap0eQUlje0zHvaAemK4cDiqQ&oe=6ABBE201"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3WCnndBFJkQ7kNvwGj8KWL&_nc_oc=Ado8GIOvzMihim6itdm3KMB4MNPg5gDHmacHJTnQtfI6j8cIPtgDsNu-lbEr_wdSTfA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLerCYPQts-zUQ3IonIo5dZACENA0vu4PZCdZvcP2vSnQ&oe=6ABBD717"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPXeuqbcUOcQ7kNvwGaKBGl&_nc_oc=AdqwxF52VzglPg9fxRheIFEWyrPX6Ur2gKFyL4HRQjz0aJN0QRYdxCCjkEozXwViUwY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGGW-zNilwFx4PbEEJk2Yg9jPwVjmFXpT2RmdESGO3ZQ&oe=6ABBE0B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6LuSEfBDrsQ7kNvwEo1ChC&_nc_oc=Ado8hrNqBM7EwnDvbYuCvU7U8tBoUHJrIEd845uT2QTaPiQy3z7Y7haUdoJbs1tnig4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbmBrr79PRCzrYV8idBvj5n5BVg8TkI1DkEE5jlPR0Kw&oe=6ABBB684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=buEjR9NA0cwQ7kNvwH70QlU&_nc_oc=AdoB-2tqbFend_5bjtuQDzlYLeaxuZU-KC4dcXdXcSIk37EzIwpiBpg9lBxP5hS6Q2M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFtR7KxMXtrLd8FA4bDErv_0qWLvn8rgFB4x7Xog2Xow&oe=6ABBE333"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
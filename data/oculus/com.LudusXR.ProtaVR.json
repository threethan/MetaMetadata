ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Uhqhp9dkLkQ7kNvwF0WlH9&_nc_oc=AdrTkKdgVBcWmKY45vfei298INXiMqrz2zZFwt2SefQrB1E2iuroRFPU9MRR7B0MkkQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sBU5Cax-eb2tAOkVFNygdtZJtMROZg8msiYRrW_Q-FA&oe=69EA0B41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cwoCLIwfEYMQ7kNvwHrfZAu&_nc_oc=Adoa_DNipZ8Y2ekjXXpYL8pT7UIyjr4KOEukwGvOdb4vRNZ27sZXXyefzsmJGa5gW6c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3P6j5J88qKpna41HCBr2Mh1bYCssdunH4D5_THSBTsyQ&oe=69EA3897"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2IJqEeAfJUQ7kNvwE0Atzb&_nc_oc=Ados3ssOmOp0wkhjTGrzpCK-6xSS-ZOud6dyNxHQx_WloKz1QuSEEyKDxF2UCOo6od4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QI9Bv84Aku6ZndZALkwvACWvfW2RaRNZtqEhlFHsqIA&oe=69EA09F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7uCwwj_EloQ7kNvwFwhlrx&_nc_oc=AdpHLjdUUfpmQqC4CUX54HNl7sb52fnnYOojMGKp0KJRh1bljY5JQBlqW1vDANcnZSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Z7q56dEj8sfYdJ9kZ9cefVbyS7KvzyHGKjtgP9dR3mw&oe=69EA1804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsYY4VE9hDoQ7kNvwE_4AOj&_nc_oc=AdqtHR1lPE8BIjYoXsWQ8z-bkKnnb5_x2J113MnAMy1NmBZIovtbkAkpc_fqhyrsYVo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mg9n_c9gIrqpT91B1iqk0RbDBYuhCpqtptDnwm5K9xA&oe=69EA0C73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
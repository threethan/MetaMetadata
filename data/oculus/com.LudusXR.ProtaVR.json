ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiiFb2ZrFNIQ7kNvwFeou8K&_nc_oc=AdpOLEsb3iaRBEjQNEfDu0sVFFJr3XZ4Cx-6ALPmArtMGpt90XKrZYDnGLqTEy-MO88&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NSAmDqYs5PvOi0K8qTyYj31ECA_vHIfJjv2xGgd_Jnw&oe=6A2D8001"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E-qkpEEXzq4Q7kNvwFA40qI&_nc_oc=AdqkKFLWpn-gU0m62-r9-Ongus7cOOkTJh3uEubYVCyIbqNKT6zr1wGFn_wQnYQBbh4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i7ein90ke-dXmodlV6_zATEzQITv_r6cgMIzo3fiqmA&oe=6A2D7517"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP0GVhPxzDcQ7kNvwHd_fQz&_nc_oc=AdpU7eJIcVZCx_uCaj9CdHqnfvd7SqnpmtsuHY8V2vunU00R5rfwnDw6hePpS7vwePM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VNou-RetfNl19WiSR3OmSeV-Nbkt_LLHxeqRI6Ez1hw&oe=6A2D7EB1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iyx9ooYoDbkQ7kNvwHQHQWU&_nc_oc=Adp4N_IFnS64J8XvpCqaz3G5dpTG3nXZ7124k4hNJLL1P6ot5IvSbtbVD7XH3tgSUKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_L4xbmc3-xCwNtE2oDkvME_5bRQ8rG2m_ViFmkwIOog&oe=6A2D5484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6f4pGYkCD0cQ7kNvwGHlx52&_nc_oc=AdqUJ68VUOaXMjLGBYHef972rrvZHADCCzsUCQch20IXA6mHK3FS_heDLP0L1YOrU0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_N8iMLLMjffbhPK82Qjc_G5hmDQWDRZIASA8vp2qyNfA&oe=6A2D48F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
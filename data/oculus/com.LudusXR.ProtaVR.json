ota4.png", "id": "1510165476601670", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-skVNlcnMYQ7kNvwEicx3o&_nc_oc=Adq3-oHUwwtATTnLZ7G2YCy2X-HuTqstZjjTKeNMn7MHtEzlSG1qSWkkkG3tyP1oWrE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rghX93yTtwYGFpSYSTwL5BfSt8hQDUEfsk6UO0QDQTA&oe=69E22241"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuHdSLTPFAcQ7kNvwHpNCGH&_nc_oc=AdrZR9Ewka6Xcrj3FTwT9yHGwSEuO2bNUoNu2LmksCGmSjU7GZNoQ1-8yQBceYwNR6M&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kcPAbP-YsY82VjZ1XOAp8Hg0mj-joEhxPySJ5tLpw2w&oe=69E24F97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5YOTTZw8DEQ7kNvwEkUt0B&_nc_oc=AdpHLkmVao9GSzuhZKldGzU6_tZjaUyLBLeBRQsXR2c1d40wGQwF0ijZ2mR_JdNd_0w&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0MKNKbCAgsBBC7Fktaq1yvNm16zyt6BriSwL5P3J4ekg&oe=69E220F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LnRzbZ1RjMQQ7kNvwFTt74x&_nc_oc=AdqjW_iyNoe3IYr5lICpXyzJyRSED18FiVVemWf2ra9yahZtm2612yHdgHHrrcP5CAM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h8wBMKVJ4LLCwgrIxJmRh_RkJc29h5oFSWihvc9J6QA&oe=69E22F04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOmxPyZ8-K0Q7kNvwHVYzgK&_nc_oc=AdpJuEQL0-7uqinwdJGXQmB1FeEhW1k53CICvL5_vtLNWxsqpdRvaf073939nHklXMA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01t0B7mraGaATlXBHMQUq76dHg4_Snsr8pHNNb2VWjTA&oe=69E22373"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1g5nCPAaO8Q7kNvwHkt1a_&_nc_oc=AdqrZbSyXqdqnblAHtQEGepIEmE_XnGcnM0QTeWacy4EphmjEWUIL0G0DHekdsJxzp0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKozTaLhzSkboPgDi94mJ-Awudxs5mDtJzh-shWTFnpQ&oe=6AC3CB01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N77r5LIQcM4Q7kNvwE8a2c0&_nc_oc=AdpqAQAfpOUqrRC6A65k8xjhSm-S7XsOGXFRdU6gMmB-1gSKZF2Jj6SgTFvjEECmOIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyDY_81-6c5nUlkGkqMomMEdWHoAXK47IzwLu9YQISgw&oe=6AC3C017"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=covGGi0aeBQQ7kNvwHNFv-T&_nc_oc=AdpVhTqWxAx5kl3PfL0cENj3KAM6gCsqsesqfI77L_5P1_ElB-3QzLxlTaNvE76FD1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjtwQQ72VE9M06KDKg7wxdkgbeE5sAjXP3vdPLCZQqZQ&oe=6AC3C9B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94bzsupOf4MQ7kNvwFU0qCk&_nc_oc=AdrJJW4AH7nS6UEXy_eMqIWLcpK84F2qXi2fLbCyEoFJK7KAEpxTjJPu3sV1GhUVSPU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPZBTf2azKuhfa9u5PGlqpz1SaoHORX2HTmgPyWLyQIkw&oe=6AC3D7C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1Nbm7c_fjcQ7kNvwGh1FCR&_nc_oc=AdoQm078xRQGEBRB0fZ-EWarGccQwQqOkXfRl-tNsKI4QqkR_-lviOUfvntfLcPh10Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMY3908dGvsBBIGzPA-19wWVHMX8LPzCD6J9ZeSTXcdzA&oe=6AC3CC33"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
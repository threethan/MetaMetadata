ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFCZUbK37ZoQ7kNvwH5be3S&_nc_oc=AdqnEQef7RYjHWQvqFXPPvpSArM5t2GY2fS9--8ri2xk2QAwssx-UY59ipdf3uIB5Jk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKi-lr2mshufu5D9WR8vzOd4SQko7zzpcshiP6U--_2g&oe=6AB54A81"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MAyqQ2UF-hQQ7kNvwEcrJYK&_nc_oc=AdrgNarx0FE0OCJbzw4vtNZMya-1IB-b9t2ad27NyhkqxwgSPT-BSBBYWvrHdaOurq4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLApaAXbBZZBJzDIgiiyqP5JamWWXuSDztojxUbYQOkyQ&oe=6AB53F97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F-VWXXWmIgQ7kNvwGGz4xf&_nc_oc=AdrVpKimgEKsTAcxymINsIsaRo_ySwLowc7Rq7eXbjHtaKma19e7J4FOIvaEBeNrUoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGQcQqpamjIK9ke11NP_M-KkWBinCybiPMV1rbM-poXA&oe=6AB54931"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTrDbzK0AVgQ7kNvwGohErl&_nc_oc=AdpJwlpsmIO0-8riEM8xkD9l4hP7FvK-PiqTkK7m9PujKiWtJgd72FJAyjdm2tMB0cU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJejp_bib4konmH9Y5n8BpdFQ7DP_WSkMOjV51yPvwWQ&oe=6AB51F04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfpyAs2DX2QQ7kNvwEZBoFB&_nc_oc=AdrW1L-L6AacPzhrHhq_DfL4hiM3k25xQ3Cw0Vn5ahWWFzOIIik847IRBGlHjMyosQM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp5DgVu48ahnk9BI-OGcKpTaNqEGvYJBuWxaCATCHTTA&oe=6AB54BB3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
70", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Pr0nYEpMvwQ7kNvwFgMR84&_nc_oc=Adl8o0PwVFv_Qf3_Je6Lb6xCnoSFAFbFhavygSWNplSmzkNdo-eaAype4CIt4ZBHYX4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5I85PFcVeqHjgPvDO94hf2DYzyFPoYP9qmP7Ra3jgWw&oe=69AEB7C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLWAT0laGQIQ7kNvwGUAVbG&_nc_oc=AdkGyZz38dR3xjAUERt5m8nFwnsQ7QK0er_fYpAk2_QND-zDztv5rtP-RtJhnN4c7dE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQlw7Lpfoep1siDfC8SkG4eFSZ_OuflEX6OU77JI5HYw&oe=69AEACD7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbGXlOSRcr0Q7kNvwESTFhI&_nc_oc=Adl-7PBUwBjZ1l6aM7rcp-RAgrV_ZvN1aCItzxpSGQ9HNkFWzaxqUHlVStzXMaVGwCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxWfXJKPy5b1lo5-HH75a_QJehXt-cNTz9L-0JZHJSU3Q&oe=69AEB671"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kt6NopneH5kQ7kNvwFox2zd&_nc_oc=AdmNc7HTu6m74xXE-TfhTh2zO4gcEcUynWqwGTG6T21HgbetovRylmAWCCIxZMHlUt4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyjYcor49muyT98LyXHMn_UWtcUFj5oK4ZRJSs9Ff1pTA&oe=69AEC484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96g_pSkwb3kQ7kNvwF8fj00&_nc_oc=Adkzyuujwo8vY6ykomZgCRH-OUAHO_GRHK_Pr88QR-FhoUZZXh73L5dIG0_8PuVr1Ts&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxxuPZ5SBctteMyfHTcrci6P_kHsFjL8tH5YN2WjyJB-A&oe=69AEB8F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
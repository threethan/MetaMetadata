ota4.png", "id": "1510165476601670", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFJ1kwfxZ1kQ7kNvwFkrGk2&_nc_oc=AdpxV0aJJYpMk7iypbc75gBibSQr_VlCRqarYGiN-aVc5xqa8ZpAmvGQ3V2tZ-rqIFM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FqSLu0Qv40Q69GWE-IGgwuUyyMCmKXBQzlzCeSt9Z6A&oe=6A1B0B01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEn3gO2U8roQ7kNvwG09eOx&_nc_oc=Adoun475CB5xxawwEB424EFX3EBRB8QQwyQbcnoCDVk_nIUaF1TQvbctfA25A0EYpsY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6zWDRIUIVgqVxL72IO7ttteHYtK0Tq3MX1QZ3LWxHu7Q&oe=6A1B0017"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYq_iS6RRJUQ7kNvwEIpkge&_nc_oc=AdpvILgKOLZPn5ngxNDg4kARrLVfs1wKkdDdaKMqgh26JzU4H6AwOTEw2dkLS3PV3E4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60-O3hL2ajWpBp7y1tsOHIovnz7wBG23JNrFsBSy5dYw&oe=6A1B09B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlNcnAmx0AEQ7kNvwEyeCiB&_nc_oc=Adp55J4WdM9oa9UtoBHIqe7grOrNFufvqzkn33uZfyXXOBrOeEBzD4TvAJbfd8R4RdM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gI0adJRcsCbDFrqsfia9owaex8H6eT71McytwYOosGg&oe=6A1ADF84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_5ZX9_qORoQ7kNvwFjXHZ7&_nc_oc=AdqnggKZ8XeJCF9q6AVlYTn0sN9t6IN9jFT03CXuP3RM4N_BSNqatzQW4Qdqcluihz8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SHgl_hucOHbW4xdijKhqEOcs_jRUpZl1OqNPZ7Ae5yQ&oe=6A1AD3F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
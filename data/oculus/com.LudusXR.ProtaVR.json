ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwK3FMzew-kQ7kNvwHMZfzf&_nc_oc=Adq4tkMaEVJqPfW0Yg35I2JeEqfUhh__pc9DXuos3ugflmfPiTsy2Zgi5hdPfcL3zYA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiX6Xm7Lm3WN7U8_A0XGY7hcEUmjrenCxyWw6n5ZjG-g&oe=6AEB5801"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h4AlG65pYIQ7kNvwFXD9Gg&_nc_oc=AdpZ7wAJJTBVD3bm7u91qFxrUU6lLqsMHv-756X5zHqjYcx7IVuGTRZMVH4Xrx85S-k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlFmuncQnmVfSgZsVbOkGZrzjVd2MLPdvzDlx2msDSOg&oe=6AEB4D17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_n6M1y_7RkQ7kNvwGN0Ow1&_nc_oc=Adqhbxcof8eQ-z1eWe3zWOqcOsiXqtwu8luKJG6kb2Wia8m0OTWO2i2Ce_ubtMlwdwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPxFIXO9z7QON2RrKp5guy28VZ6uSh6fBItPBpIyDcXQ&oe=6AEB56B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9CzzS0zHVoQ7kNvwGQ_cPQ&_nc_oc=Adp8uMR6_U9zHQ2NgxOJ63d9u_92WyKp6jB408xeX6lnn_DmrvXqOc6d8FsQh5dPuMs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSbsnbiqU5Mx0RFiHy7oK_fmj4bEGddjK4G898ozQblA&oe=6AEB2C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rk6HPhTiuGgQ7kNvwE2cfF0&_nc_oc=AdrebvG41m9BN5nAPeXvXVTd0Gr3DfyA7Cr4g7ul02tJdnTmUeIqtGi0myJjM7QRVP8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsI1ApMNgAE_5C_nOk9tsxsha5ZvTxRvq-sGfn5_g0iQ&oe=6AEB5933"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
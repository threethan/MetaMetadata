ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODPvpUNVIc0Q7kNvwEC6dCU&_nc_oc=AdpanAwk2GaFbNcqI7sLeID_71XndHNJCP_Or_JHi9qJHC4PmrgfoHcGOT-leIMYAZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC556EGOQBT4-us9n1eMpR7pD1uSHNBtgi98TvVwU5KFw&oe=6A60B241"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0nvnfzK2u8Q7kNvwGAsWKa&_nc_oc=Ado3kb3836TVmZNAJuCCfZhGc0yMr7hqXdApS2taEqCvnQPSUCv3P3ypL3SSHTXlpjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmGHQNHmbSdPQRoXwZhkDrC5VKkTf2fcedrihUZ2-UWw&oe=6A60A757"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z75Wk8Cq7sQ7kNvwGQ4UyG&_nc_oc=AdoM_hvmqJKQ7LPQrmYNzX558qDzThDMEy_qLBzQTzaDJJMRNDMV61nZaI1Rg_eAztU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgzU8oNVMYzVgsikH43k8cjAAn7iUPOtk851DKrHDiAg&oe=6A60B0F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odPB-jhBCOkQ7kNvwEyGpTP&_nc_oc=AdpeM_iTDiSV07yXjPTIvKoR0by0k21X5dUSvE0z0BnTRKQeyfcnDwhG85-yxfz8If8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy1CouKwcW-94EPUAXnj1Jg7Y2tyjPkS3rKTSFDMXQWA&oe=6A60BF04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_y6OJW3C8cQ7kNvwE4TkNd&_nc_oc=AdrRBXnhOh88os7EWynx5dz3Ml-H2K34lEBi6WXi6ron-P9Qzeg_LeHhG534oCCOOsk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlf-OLKQAwS-cfmydcgr2xZ5xM_89qtJoxx2JfFB3Wcw&oe=6A60B373"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
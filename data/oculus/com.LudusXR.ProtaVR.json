ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLiCocHkpPcQ7kNvwEb526s&_nc_oc=AdrBVXO4aYBA-KzshXanGI2JOqYFNVMcR9rS5v-_4zyu8YqVy6P2cDUNwAOipGa9IbE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYsDK80emGi1Pln-NQKltsDNgFdc642DRUAyMcGWbj_A&oe=6AB2A781"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdoCK2uPwIEQ7kNvwFobGmi&_nc_oc=AdrqTZc1h6GhAxFjKwN_GN7pCwQmWY0Q8S3FdzR2nJo5YQeKG3JFvuypzDFUSUzbeFo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-CmWk8QKz6A_w81JMz7kz_OboXcMH41bvPnjboV8Gkg&oe=6AB29C97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4F-VWXXWmIgQ7kNvwE_9Fxy&_nc_oc=AdoMbKKMQTHvQnOI0F6kZV4uM7tyUeWxEZvXaQTAIjn9ko0KLhX6TjCMfWCbrjBuGxY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxqRASp_Qbb0Qi203ifa9BxnPdj4eeqpoAKXIBfkIM1Q&oe=6AB2A631"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dTrDbzK0AVgQ7kNvwHJA9BQ&_nc_oc=AdrnIIDjCFiiBUyPlPlLdZawzKcOUCgWTiB1oeycD8FqHZyYmG7jV7jwOLppAarRJW8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQKs29-qWZisU0iPWZDdXyyP-LKIkXN2rfjKv7RMYuXQ&oe=6AB27C04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQglJbXaieUQ7kNvwE9z7cc&_nc_oc=AdoUBpxhrUlcBqLSoYlV1nD5tr_NFGLWROPHHCuxNh6JZqAP_X_nETJ12yUXk3VNbK4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTHcDZyN8HtTBxR-7a2cPkdXvHDyZXIuVh6YDQe5X86Q&oe=6AB2A8B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
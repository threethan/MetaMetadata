ota4.png", "id": "1510165476601670", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w_kFnurABLIQ7kNvwFxuxmE&_nc_oc=Adqtro92Q98cv_fNWv9a4n73OWtzwJxJ4vxenAPhlTDN_05cHCQgsaWsKzIZl3sEWbc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMYPRbwfNofk3llDZlPBvzGdnrC6pURfKd8o1oioaJAA&oe=6A8AE241"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rfpr7MERLnAQ7kNvwG_EFu5&_nc_oc=Adopx-s7aF4NcbxplUq5PNFbdEt5eRPMxUplWf-SJ4jyBbDmue2PjfKdYh2brrp040g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8uZEn3Kz--c9HKB75jqt0iOQp0BwE96XZrtUhA4LgMg&oe=6A8AD757"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO8Wj4Q4IuwQ7kNvwHeTkqW&_nc_oc=AdpTYT9cLT1XES8xMlW2jFDAa65L9zS4KabSw8_E5SWAZs-AhF6BvDtOO9Yq7ReBO5I&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1Zgxb_Nph2NdTbv-k0N6PYTSp9uWFICKWfy1mgEYW4A&oe=6A8AE0F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYtkRttVho8Q7kNvwGmQt4K&_nc_oc=AdqU5cBszdKpujMqyqY2RsfeW8jbvChd8fteer85cHAK48yJbDNhnVWgWcfk7iGJAv8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEapaDRFFCU6QIKioDixh0-uMDA0UO9Mf6qBjWmCuDmfw&oe=6A8AEF04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlpprOQmz6wQ7kNvwEyiEid&_nc_oc=AdokjuWrMdNca82LatT-x9WRyBsVqO8HvbBJCW1hnTjm_a8M560g-QN3JETxERkiILI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMG2EyJ6XkXRYRjmEj8i1lq-yfhBg4jqW6yfqx5PWN_g&oe=6A8AE373"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
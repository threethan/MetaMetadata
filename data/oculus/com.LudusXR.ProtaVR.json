ota4.png", "id": "1510165476601670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW7Em9qI46IQ7kNvwHjyDJs&_nc_oc=AdprAgjR5SK2cu6Zczxm_1P2EvLAammAX4iocpzvDRiIAbwziWlWx9hqrukQe1p_sis&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSUoUxTcliXl32OVmpjMdDYXukOuY3DNf1E8h7w8jXpQ&oe=6A6F32C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlacmpoUH14Q7kNvwEeFEvM&_nc_oc=Adrz_ie2Qi-MypIgZl6rOk6OLFwxXsQuZLHrz8jDloPptmdCW9K91Q6Ln1cjJXQT2yY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUZYiP0zc4XjIlHw4p7-MWD9tA6utLEydrUe5v4FMvLw&oe=6A6F27D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l300l1rQmbgQ7kNvwESE_Gx&_nc_oc=AdoSWiI9cUIrHXHtJs5aaC_b9PL1s-RZnGntzrDT6x0zO4GAOeh0MIhflSaXZB_4VpM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFyQbHKzCAprU7pDBIMfcYWa-3HQk1G6zMemnknlny2Q&oe=6A6F3171"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9KLgvWEt1AQ7kNvwE9CxJ8&_nc_oc=AdrKHZN2mw6LqSNiLDXy7gKjBnAd8LBmbBIRK1eemCMZ-GPg2se20qw018l30zHV0fM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv7IqgLA0vpDpofTULZY8LXkkOV7DqfNu28vhLBVQi1g&oe=6A6F3F84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NYt2THzevIQ7kNvwHtpcE6&_nc_oc=AdqEuheUGqySYAk3Jx5PahqXvDeU5rgtsGowaGNDwTat42hZj3_Wg10p5Eb_NrDGlMo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFvWsjdDHqNGb6ztNO82Zr39x6Y-kR58OL8W6v_jaknA&oe=6A6F33F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
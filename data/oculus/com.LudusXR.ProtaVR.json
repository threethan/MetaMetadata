ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFJ1kwfxZ1kQ7kNvwEgRQyl&_nc_oc=Adrzy7na-aofp0u3CJ0eKgpAUke4KAvaYT-xxwZqUyTJyNmFcKdaB3oxxUikcQuaJX4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mZJFmrPTQ4DSzo45luB_JnmSZne5dcqFlAtaWDREezg&oe=6A19B981"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP1Q-DTcD6UQ7kNvwEUyMzr&_nc_oc=AdqMWQcErUvL9w2tIekSUefM4ywEPZhKvajcsmGi6wFnixXuWGor6IRxq6sV4LKNqCE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a9qkziOst8jL0rWmQLazp8ZnMr1jsLL4-NCtMrjOylg&oe=6A19AE97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nYq_iS6RRJUQ7kNvwFKiSdn&_nc_oc=Adp7OXg_gib5nrei2anHAi99XjRgMv91mxVD_9GuBvuMFlxA6FAy_OLKEd_VAeYTeCo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NwLUDDdX1a5FES_FX7lPj95m3aozgjJvG3_QFgblqAw&oe=6A19B831"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qlNcnAmx0AEQ7kNvwGkbeX1&_nc_oc=AdoR5Da2LLPH7gxKFk6Jjll3ljdCouPoX_FDoLjFbD2Qv58hqERQgoePgdkH0Vo6Emo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mc-txrgZl3tKUQut_fDT8-tREeCqTfgQV9f3GZiLluA&oe=6A198E04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MrQzbutun1oQ7kNvwEHRW1q&_nc_oc=AdovfGVxIisCOsoRamux7p1oyxk1_rW8U55tCmMdyWVjmNu8m7ppiX77xuDBnzdjCZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O9rVBhJuaUXggbyDu0o1s9cT83XMBAUB-Ejac6fj6NQ&oe=6A19BAB3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
70", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N4Lp8SD8izIQ7kNvwGVKAAL&_nc_oc=AdmDcEb0p8NCO8tmAuwMisr-4NBFmI8Jn_P2ja_sfGo3lw41p4Y9Rp0iBBbr36mjfTE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtaZwnLMCYQ-eFjCM--TXkbhktBJmSDUWMnCcgDVKgQg&oe=69BD3841"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoyD1kegl6cQ7kNvwFa5tmq&_nc_oc=AdlYQu3auLuerUwNLqjlE16oFzfkl4XuUe2b1FZzZNWLagLYP-6g0zaOlSNYdGNDG54&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwA2MlXNhSuYejluTDkstDVX6_5GP-4GecC2cNCcGm5vg&oe=69BD2D57"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Mfz7YXbYQEQ7kNvwGzv-QC&_nc_oc=AdmtgCB0xVcMk3GM0BnbcoXR5J3kF-WCLmgWCgf7N_ptik9aKnLQuiNk2EkBXEmylt0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxuRdB5RqaUC0nGGV0Y8yT5oyGuicfsAJGGBv8b5PAhXQ&oe=69BD36F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWL1J6g6FSwQ7kNvwGnBxgT&_nc_oc=AdmMggbaXQE3a-lizyHasuGMHz_n_Bk5Hr_bV-GHngLjy0sVDo3PuIV_lc6_HX0VVyU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfybCYAst3myw9TJrkHEhBdoJYgtb-XXOK_uofSq_aLsjQ&oe=69BD4504"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5QZ0AfRnNQQ7kNvwGCA3_s&_nc_oc=AdlViFktdYbOeJyr4rFMmExVrRcmAjBsVpdL92coP3Iw3soBQXCurgG3MhBFIUVVMaw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJLNEu3NUJrhROsP0NB0Edzro4hDiChiGCJw4iADNXbA&oe=69BD3973"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
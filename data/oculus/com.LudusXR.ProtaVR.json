ota4.png", "id": "1510165476601670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xfoyQaRCOSsQ7kNvwEN9Z1c&_nc_oc=AdoexfkZfgRRNTPWK-OFgUhFYVYqu-3PLvSAUhOPr9Qe5aLqs4jPq7BYvKk7HQ1lD7c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUFRE-aC50ZVliGOcatHRSBbZQAfxwqb7Y3BxoFzmyqA&oe=6A511881"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obfLP7GL80QQ7kNvwEk7XP9&_nc_oc=Adp916cGC1f6XC6hglH9x5fe6JdSph5B2tHFZF1NUvWc3aMNEYt9me9mufvKNI4NX2k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7sKlao9xhRJd_wGJXNVZDtdiCRmpCqlrOAdFfUbpMDA&oe=6A510D97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAjG1_oV-VkQ7kNvwGiH_Gy&_nc_oc=AdqSJtjXZm8Lxo13hfIZhDgBHdg7MwZHLEMiR1xJGmHSOEf1Vbkv1HMtqc_IOdWtCZg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARS2g5SOiIS9O6WbsGTWWxaIZcj3VYc0xErNEi5rqRdA&oe=6A511731"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kviK-pDJHroQ7kNvwHimtfi&_nc_oc=AdpzpVXJuEbHJLjjsjFEeYZQosF_OpudiClEQ5WkSpI8wEBWxtgPclOHhKA-4cCRf-g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkRxKI3yWGtmol2rzzjNfOv3LigW3e0JZFoHiHx0Yzbw&oe=6A50ED04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Go0qVMCvsgQ7kNvwHMFHe-&_nc_oc=Adq8qW-nQO7p5u1TuAYNwi3vcTspOGOSXKMj9S6K4_OCD6YjyX3zdKCyXOi0gss6Qsc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_S_4eU_XT7HLI1aB4HfXFJD3m3MlRDEc1C3JR6f4F0w&oe=6A5119B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
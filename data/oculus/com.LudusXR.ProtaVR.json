ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZWotGnW6TUkQ7kNvwED9HAY&_nc_oc=AdqyhdIogSKs4sT3-rkNn1rdYJppgyZE7e3FZcZ4by994rdqKbBfrjL5fhAeRKB_iro&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Z7sPnUU0C7gVI9M3A1mb7vSZ10jtsjTgDph5Uz_kE3w&oe=6A3FF501"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEopLoP48DcQ7kNvwHFiAR2&_nc_oc=AdouyNgoyUEkz5R77xpOsw2UacWRKMrG54dQiC6-87r2woucGAFL-SC8IEHhh_9ef7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bq4MpJLiQdQGC3xV32fGbEiwPMGzjmcmD-iZe5t3FyA&oe=6A3FEA17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zx7ruDv7__QQ7kNvwHQOl1w&_nc_oc=AdqD-fAa_0eNIX8fyj0bWsBlr0Yx6ELiZ11KTJmuk0V3PhSkk2devMB8hr2wHfQ6_Ys&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H4nzUCH89G2GvRtTEvq1QlkMintQbVSMatn418IeWEA&oe=6A3FF3B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EY7-CmwKlgsQ7kNvwHuVKxf&_nc_oc=AdqVsL0oaiv-KBFZd9YAqB-nKevQ03Ns-EgkKEbX3NtWtjliVIXJvshdIBTlUVi5IgY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eFcoUhShuR2LSJJ1No_HPUlkaz0dSTLeiVnww_lTXJw&oe=6A3FC984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqB8LX0PsbQQ7kNvwEsM6uV&_nc_oc=AdqY-3K1o662yZQLFbLk2RKGxKid_2F6vMHeL__woOtI5nEIUy8XTyN0mtNrmGHGi1g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Etw-mVegKorQAxQxztxPaaMETc4WqHjXVdEq2r4C9Gg&oe=6A3FBDF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
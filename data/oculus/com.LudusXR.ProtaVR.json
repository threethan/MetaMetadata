70", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7pP6QBxq5mcQ7kNvwGZ4uKu&_nc_oc=AdltuoA3-85ziuJxTlLdLRGnAwlLwV2Q5SPTIDqsH7huHC8eWOanReqC6xfyBTj0Px8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJYX1aVNPi6n1l3MCtHWNJhM06gHx0i809ALrdP8NYAw&oe=69B6A0C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dAUjBKcnL4Q7kNvwENfBmF&_nc_oc=AdmU3Tg-KouVuu_k16pRIqe45Vv_QUUcPuXpyYc4urIIATLeIxnzNwQEesfCvmdiK6o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfxN1pRXTvd8hVNsbukESJZpzHYY0ktFUGgOZeTz5iuw&oe=69B695D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWuoAzGDDu0Q7kNvwEbS_cV&_nc_oc=AdnGfHR1Z35y2sRonGCY8R18T0n7s9wNJP6aP9Df4tFd_6hC_gYUlrsklvsHMiXGZRY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdNn1ysDp1in8_PrksowCo27iu56RSOsH3ESzx1DEQ_w&oe=69B69F71"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hxtt81Xr0TAQ7kNvwGBNAkV&_nc_oc=Adlseisuo3kcUMyG-t2bth1kj8RDAyaD--4edryv6ApCkn2Clut99lXQ3O4buL3DqXs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz9cckRvwjo53MCttDJ8z1zm9dsm8hvrUc5zgV3EgKojA&oe=69B6AD84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbbBGkWkQD8Q7kNvwHo7Fxh&_nc_oc=AdliLLS2avNtY36X2cgA9MucBNhYazQnDd1FNiogWUeeidv_oEZnG-5jgBZ1aCG-jNg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyLJg-XDi9C7DNs1K3BNSfIG5X7urpJRt5xlBf22SUhLQ&oe=69B6A1F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MW7Em9qI46IQ7kNvwEAQK8S&_nc_oc=AdpqMecbslE4EDMMTbZ2puQACKLtXIk3FiXFtr2su2GXk9BDEAJ3IAlfxqQIJF8zyog&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoPWcdSG0_rvrpAMerILVRUYcAmTxcXRRwasN3TL0C3A&oe=6A6DE141"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vlacmpoUH14Q7kNvwEBWfq7&_nc_oc=Ados31Tf7leD6sjFAiNBND1dJdS6weYKadvc1elcPGXwhWDf20wGXn7NTCMO4JaWJvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtOQHe_VU5E-r1veQfYFb7iJXKedQjzZW5XIlshI8icQ&oe=6A6DD657"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWyVaXM4ggYQ7kNvwGsibAZ&_nc_oc=Adou6DZT97VjEqLMgtWpAFW1wl09VzuE12aqMfsyfPTFfEbk4mnsm90qWXzssZfM5_k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbHk0EMO0GSCs1LPqXGBv6E4ILmIoQ58avB8uGUuk3xA&oe=6A6DDFF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgMVb0CqJXoQ7kNvwG9ytx0&_nc_oc=Adqi6Egded2cPkIwWfeRv_sFVS5xWl-MxIHpJr0jOm9sQzS94C7PdKpi-5cJrCoVBK0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtUW99HfuHi4b-rcT-T8sjn0hOWr63htHGaNPSXzZ7SQ&oe=6A6DEE04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1NYt2THzevIQ7kNvwF444Fu&_nc_oc=AdosTNNA98GlLZIJJH5S6dWU7hOFZq9WuA1DJFlEQlCwwAk9RVZZSvc55FQua8GqlbY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaKil7e_pT5ell34c-_-RzdC4UcQqgBBk8igVm-TnlaQ&oe=6A6DE273"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
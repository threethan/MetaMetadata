ota4.png", "id": "1510165476601670", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Auyxf6N0VRIQ7kNvwFwovTn&_nc_oc=Adohu93COTWj0ss1WajM-u9iPCYzI1u3mmYqtYeurqjTIxe6IU3WTJmozWoTpwSOLQA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4_XQ6Tu8Wt_yKbOG_qIvnmVhyekxtTVMQ4mOgdPTiY0Q&oe=6A09AF41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8lBws_gjhgQ7kNvwFgbuZ4&_nc_oc=AdqKygx_CWySiS2iKYR755mMXQUjrVwDlsP68vMZPAvn_BKO7U-PBvimU3n_sAysioc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DDgq3ZDOlAZ3E_ZBBek_TPjSO2uSTZnvlDy8vln_FRQ&oe=6A09DC97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OxjB4nv1w0gQ7kNvwG50C4q&_nc_oc=Adr4AbJuZ16AkksrEdYRyM9vlLXxgftwjescdE6aHxSRejiZrcwkwPL_zCoiCbc28L4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jVoYEj4I0c0HKwXSP3-sza731-Zvs71dtvXbX9_t4Iw&oe=6A09ADF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eaDYjN2f02cQ7kNvwHXoP0j&_nc_oc=Adr4hpqqTZh7zQb01Gv1M8u3urJxQ-f8-I7woWAdNG5oNGmMrHVdsitges95hWGoyHQ&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qwryiJaWaCIMBRohCzKxzvCFEuD_YutSdYU3VDSklFg&oe=6A09BC04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0q7qUSZMUcQ7kNvwHpTpYc&_nc_oc=AdpYxNTgGwp5oeSO1YvPsiOla9QBn1xbD2gczTbFC_0sBuVubfpd2tML4FI15GTRzAQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vrei_v5s96HTrMGzQjIMbMSoqNG20F73lOcWjAEi5iw&oe=6A09B073"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
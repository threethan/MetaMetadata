ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kOez4zb-ZYQ7kNvwFYIjV_&_nc_oc=Adpqyu294BKaPYeXF60-_7Y6Z4b0c7k8Q0W7gCrnXYCPXJNXA7sOyo26agsHZEF4t_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa7Vp9z8nt396JbsnAB8Ip7TOoXdPX5VBnwRNw6HmyQQ&oe=6AA57881"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBglyUF-fe0Q7kNvwFDAhBL&_nc_oc=AdqnE9Y_Ccr7dI90qJ_SurcS8326JHjfddrWou2LtNewK-PHp7lorcycIgIQe7ly784&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKna8Dydwx8x6P3VQ7ua4MZnjcm9xDtoK2XBVBpMA5uwg&oe=6AA56D97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yF7ScwbrT4Q7kNvwEzgZtV&_nc_oc=AdpNQH8rxf6_P7T7zg1NpLmlNlDiPd7fNPsxnDIfLqPcCN6zTwip7QtpDX-Ttq6Eglk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL12iBoRExMs-LA240dfr6BGTJHDB2YFftnr55pZ67imw&oe=6AA57731"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FuFHPod1vCMQ7kNvwEuW31M&_nc_oc=AdoO9HrUDd2QkmOvEsFWEctUBBErRr5ChG67aUWs4E7rJVA_pKMkJYZKbtOeofS2jrk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq4O9n3k6UDoqDcycJaNbjCCHhgVECQIIF8WXSsy5QmA&oe=6AA54D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pQYk4TEcCIQ7kNvwHVTzrR&_nc_oc=AdprxV7YPNkI85YOTtnLLVCfcmB03LamyydgxnlNKIFG3r_srCTjEAHlx07Ra1rX9hk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6RQfTe5a2j8O0LrA7FQ0Vn68rWdYkwV9lFU1Whi28zg&oe=6AA54173"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YzUM8q67LpQQ7kNvwFcf38S&_nc_oc=AdowWaPkZVFNMzpSdm9_N-_c0J5meszMxsZUnclbp-SBFTD8LuXHBd3lkbGsJ_kK9Vs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyqTLSERF6MGznvVEu4ImR8SgKPTyzPVxMdl142kiOxoA&oe=69CFAD41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqswKjmF7r8Q7kNvwF-qVWA&_nc_oc=AdqNFD4-U9IiPndwn2kQ2NjEOqAoLhpSbsJ4I4Fvx7w7ZGxLsWbvgR_9cCcdisP5QN0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBORwH6s725m0Re6SVs6Q_PT2uzIslt2xNoEmzN6sCkg&oe=69CFA257"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSoTBPb-mzQQ7kNvwHcE2rO&_nc_oc=Ado2cJf0bO5RNEnGK9Uabt8N3c7WAqblaDGB_QqOH0hk8Y1H7V-T8Wa2w1jMsqnGONY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyImCBrmktKoVDkr_Anqr5rpuy53s8lwwO2qmf8lHvQdw&oe=69CFABF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJ5YnmJvIDgQ7kNvwGXK6jT&_nc_oc=AdrBe9Yc-WLOMQUt7u2pJ7tmxvy0yhQsUv-yY5221owW9Gmb2pux7mx5Sh9Y2deHPuI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afze-IDcL-SHRN63DINWCjck4y0r9KwZUYDUnnVUMSuK2A&oe=69CFBA04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9rwUNzTTooQ7kNvwEISOLP&_nc_oc=AdrxYoXb6tfjtrJFrAu_M1RoChcVxzBmoXysshmJ82dAu5rlTpWGYkt4ZcAFe60kYq0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxtGfjeoA-rpYgQiTlQKp0uIKqgiWACnmOql04mZSWLMg&oe=69CFAE73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjPv6fJ1ZcUQ7kNvwEKUsN_&_nc_oc=AdqZQ66Ye2lLpOV-55dML4tDNdT3hTdEYwaDbJFCUt9sim8ga290MuliuXuQo1mDacI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GBX4vExX6bI6xTLN4DQYaZzxQgNytUJn_fMfUfiq6kg&oe=6A0C5241"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rXhE6xtArg4Q7kNvwGCLszb&_nc_oc=Adp2ZgVDIpQkWqf_u8dcwU0kTJ6hhYTjtsLU88ElKbIMc__EfShrqr98E-e_kCuKqDQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iRtq0G2pIdAka5ShyNeJNI8Ab_k_2pBNsHHZngp7E0g&oe=6A0C7F97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i52rX8zrFJAQ7kNvwFTMqGY&_nc_oc=Adoh-PkldpxT-fAXKv8IFB7OeUEVUxB3qaHxyDYZX9qUelnidJKaqRWU5YAIp9_18yo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gSLLJHbL_22wv2BfmFZqzZsNE5Na_lnuLgR-zbL3exg&oe=6A0C8931"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQPk1TYy39kQ7kNvwEhBgP1&_nc_oc=Adowu648EJltW88_jgPYZXJa2hxtIy31RCTFpwm65vjLTGWSS1IdUasfp0XcudklXC0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_YZnJLxTXLj9odYIevQh0D4EO5Sa7T_7DoUU25y-gXA&oe=6A0C5F04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EJ4mM7jjNCIQ7kNvwHMeKCJ&_nc_oc=Adq618n_38JDFYa7kWf4ebjRUfYdIaGvbADSf8xMciXQEhBCRzOKFWKJrW2MZLi3XDU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wHhd875rcal0VrsgVlAmxhPNwRN-tpjJp4qCeA7aFNA&oe=6A0C5373"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
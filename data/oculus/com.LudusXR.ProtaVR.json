ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OytObfjWLf8Q7kNvwGjsPYI&_nc_oc=Adr4xCtnx9MgCHjKS7EPDIMgOz3_YyqNmUSgJ-VncmxIENrrgIt7B5_MQ1iJVqW6ogQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPTbv2EdbaHlg54ETGEtvzV1fDsrx08hLdm7o_x9moSQ&oe=6AF49281"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RzCFpiKr3XcQ7kNvwGTk2Sp&_nc_oc=AdoOlwvXUMgw8ZdlmzzULMx6mhEEz7wF_WfMo1LtkWDKlBVm97rjvJFUcYnW5UN34-4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVD1OCkowjKtSMbOkg4nwshDumSo2aFgoUn_B0H-gpVQ&oe=6AF48797"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1Dg1_9GNQkQ7kNvwFmucfd&_nc_oc=Adpa2Jmtrk-KYb4U9-_apWoxbCWRpzCDnDU5WPspZDG-vHuVkPSIzUu9WPTwBHt6Ty8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSOyz05BDl5ZpdswOaRA9sLkzNqss-qmL6YN1M9CtmEg&oe=6AF49131"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSoRFHJw_sYQ7kNvwHQU8BD&_nc_oc=AdqsJP9co4PgzxoFnfaKrwOpCS5YSCcu_ktt_gUQQTesCY4Lve0Eet8jVnXMJO8B3P0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfERO8DzhkUnw39mAPt1KFRQRZ3lwwyECjIp4315JYXw&oe=6AF49F44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4k4_Cmz5haoQ7kNvwHz5MCb&_nc_oc=AdoD2oE4y6ERVUvazfGTPqytDOjza2CVZYiJAERWM7sOe5ndSoI693YXIXnhrzSW-xw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXah-BPVLRxnWziNzyIgsF4hFUCpOKcJFaL0QfDlb7uA&oe=6AF493B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
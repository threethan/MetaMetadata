ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXsH1Ptd6aoQ7kNvwG4BJ3z&_nc_oc=AdozZP6ydJsSEa6wtw4dyH2v0OprOx0QL6HfEilxfR0rAySCiRh6BLhHoGgx_AcwkbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJrIc61iwFeOGYXUDYWv05FimmPYoF48DgVcKwL-572w&oe=6A6B3E41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIsO2V64CTkQ7kNvwF6LNMH&_nc_oc=AdqRYzOuZ3gvApp9lNZJQRXOedHtNPjuZofQ2Z4v2zjqF3BeXsDDaP6xznD-YLME5sk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHPPfnK0PDghOqihAIFgSLZepyzVVEqZLraQ7fKKcC0Q&oe=6A6B6B97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWyVaXM4ggYQ7kNvwF7YoVD&_nc_oc=AdrzZ3D6d2jW-P8ywkwpcI4J5hfxW6bzZNeYrk_tckNvmDNJP0qJRyZRORd0K_cmHHc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7rBH0FlHCV4j2QmEVmyCY9AlMIxMprAyhgxMJ98BDuA&oe=6A6B3CF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgMVb0CqJXoQ7kNvwHE_3f8&_nc_oc=AdrcWKaNq7dbUajln6A9xxQplPh5SnBviu_HjetUhru7BYwde8pDXWVikeh9VlNKLh8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7yc8shxCAS5rnJ3znteNoh6C28R_XvenUlLvKhz7_TQ&oe=6A6B4B04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46c9K1Y2hEUQ7kNvwHNSjWC&_nc_oc=Adqtcht_fuogbT_fUXdbq4jDRYCEZLh4d4dOpQqCMo71n1gO1zLjrgTNm-JTBU3F0vc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB70optAIBQ6DYG_4q6eKQKTzMXIJNcT5ns-daFyACWbw&oe=6A6B3F73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1jYPNh2ld0Q7kNvwG71qQk&_nc_oc=AdmDNYiuBFZisf5VKeQ1Q8aeOaTgkD4rHHKOZpcnheSmXJvmDg8Sa9i6lAyzGYCvqi0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuvyVG650HUd7UrgY1xcrXtSq7elDv7-aka7S6NYKpWJQ&oe=69A18771"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xb9Vd75PSksQ7kNvwFah_xV&_nc_oc=AdkoEXfvNxM5QpaR3iWhD-Pu4J7Ri8cJIqlDQ_LYurxhQk_PjJJmf1qMKh_hUZvFJdI&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfvDZHaXm-nCaTIKYr-mOyWb1Tai8OeSsPF67H3JO4IH2g&oe=69A19584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKMdONJ4-HAQ7kNvwEcsvmu&_nc_oc=AdlRRRdYWtipZuqNmlSz4ATwQfcr7BqR-GwebmJ9ZKs3nDB5flXXj4m7API2q-wSaSs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftvDqH9jY3YaC0ETgaZYmZ9U6osv8BtnX8dhvLAEZ3B7g&oe=69A189F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7264831523614310"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2960161767473585"}]}, "baseline_offer": {"id": "2960161767473585"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1722970800, "status": "PUBLISHED", "id": "2960161767473585"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7567440113353448", "version": "0.1.9"}, "id": "1112285373230825", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicat
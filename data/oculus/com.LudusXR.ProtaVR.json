ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XiqgMZpHm8AQ7kNvwFmRNGW&_nc_oc=AdpZGkBI_B9AcSOZeTIxgeqWiy4GK1EIQa5mQQbyXj_xUu_ZKhsALgDfI6ZCiqkp9-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnkj9Huw9yRv5HYwiebaKw61wpjVgEUooali-IwVP7mQ&oe=6AEA0681"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3h4AlG65pYIQ7kNvwFytYaO&_nc_oc=AdryXWhpFC6RXZmdJVcZgAqfeaI2o3kVOe3avu8w26JJvPSUIPBHd02jTIZDZc1VkjY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvnIr5xSB87urxlE0EF38Syet47p_T6l0HVvkVrZWc3w&oe=6AE9FB97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_n6M1y_7RkQ7kNvwG_mQ-C&_nc_oc=Adqmz-J1M-p7jWMFbL0u31wHRVniN4F2aQhclzOaOntJAadrIMw-3nOSlHjhCI0EKwU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUFyWwckDSEBJmjX6Na1d1ZwhJVn_kOwr-Q-MzalZNvA&oe=6AEA0531"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z9CzzS0zHVoQ7kNvwG2d4Ml&_nc_oc=AdqHttLIs3U6ajmEUV7dtFcgQCjm-vTeGwigCFyLdrfJTUuC3kBKUCq-1fKkS5Ny6Zc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6kPNZmGbS-sqMoWsRbat--WjCPGGkCpvRtO96LvxDAg&oe=6AEA1344"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rk6HPhTiuGgQ7kNvwGK32uv&_nc_oc=AdoExD8SJURkk5wGjNiN8JBPSD9lwYXZZ8EqGl6qSXPlr1aQYrD6mOR5uPk8Jc2nxiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIlrEzLdT_HI-IETTEdSoFtgETascJCdR9fVqRKK99nw&oe=6AEA07B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HXsH1Ptd6aoQ7kNvwHcPfk_&_nc_oc=Adralxn9uL2EPG-NxWEmNyfNS1I15eAhi_jFPTpsyC22pNegP515lkIjq430ny1z9Ac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXtmMA4F1qUYK6i7D4XlgnU-bAdP5vu9SMB7_AkhE6bg&oe=6A6C8FC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YIsO2V64CTkQ7kNvwGXJUY-&_nc_oc=AdojnKbUvMidmJMMHFjUelTVoio6PgrgYz7ryiAN0d1Lt4-9_GddGiK_ZiTCm_QWtzw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2QvsA76ZzYbjoa3-oZ3OBFbQfXFRutxJ6cPYYxFS7lw&oe=6A6CBD17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWyVaXM4ggYQ7kNvwHWwXA8&_nc_oc=AdqYTC_OgQ6O9nfjXJ47lbbzHVe97iezKqsOL0btxOd8OZ9DM02bsqyPKyGATT9pbdA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcgRv87_scl8sZqyl3tO1DLxI0sUu5yOiw09_ZoUsAXg&oe=6A6C8E71"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgMVb0CqJXoQ7kNvwFAhsX1&_nc_oc=AdpwqFTJJUqt4hODWIopEUcPRlhW221DLSRa3EkhP6xs2Se-VioVN_dMs200rRakASM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTIPdzrvJR0ffP8rn5pIhUWy4TsOQMyMsRtVyc_awbwQ&oe=6A6C9C84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46c9K1Y2hEUQ7kNvwHqOx7Z&_nc_oc=Ado9KnQhmon3Gnzl8lXMk4d6A4mouQ19hd7xoaGuM5bcmBC8ep3T7CyIt6cohBRK-3s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFnyr-65sS-azhpnBqdYuArJ1FE7W-ddjaGuT6aX-47A&oe=6A6C90F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
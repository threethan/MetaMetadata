70", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaL9vk3SKMcQ7kNvwHzCSkY&_nc_oc=AdnI3lynRj2I9iwInPKb8pYQhanfIMyE0QL8mrTsikgvxiieMK9GQv5OJLJUufWJCx8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyTSGHYFYLUaIGpkOcCmq5JJHY-wwr33J3gi0BzM5PzRQ&oe=69B2AC41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XnjsnnFpnYQ7kNvwGz8B89&_nc_oc=AdmSa0tDzHuxQaVNdfjnniboKmzDx80CeYS2TVwupAuR4ZMtfV0JwFntTI5Lfy3l068&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPuIewkdVgVt7DGegiYSFaF4URgxhzkhUoI8lP7ktNHQ&oe=69B2A157"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx-LogzRHlwQ7kNvwFVL2lU&_nc_oc=Admf_ks4pe4TLaouGRmyT7iSt18OvZIOl5mB7_2coJlw0lUtDEaX3zj9A58pXCKYWIU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxKJCmsSaR58dSc4OOUHvbwx0cK2qHgmMio9XwuOLmOmg&oe=69B2AAF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SJ7BmiQLuMQ7kNvwEGokaZ&_nc_oc=AdnmwdXunQMewIeuKqNJeS7zbJPH6SCBuI1NOalJLkEm0Apb_f1DHaSNZeO1DDlDGdg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwVd1illEdb-oxe4EPcq5ry8lQRreKcWOZGf9B9xr1iZg&oe=69B2B904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu_vmil33LwQ7kNvwGk9uaS&_nc_oc=Adn9i9b9dxu6ynhxDzJ-YbmdxX4qXPeP8oRfenetzU6xkjmkkyVKZda_wAgOzkswCkM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyRYePGVdlzCeaq97W-YfqEctirLF_L3jsigojjFpoe0A&oe=69B2AD73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
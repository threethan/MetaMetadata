ota4.png", "id": "1510165476601670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwcIaUGBYw8Q7kNvwERvLre&_nc_oc=Adrm9L63eFHqgEst0H68hjmwc65HrTFZaB0RRgvOpB8eSGeY4thS-Y0fb72lC-gVVjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rKQVDrr2Hm3qjYY79EI2lPKbFejU1l8KseAUz0AFYeg&oe=69FB2EC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q614KLdyTgUQ7kNvwHGq-Sh&_nc_oc=AdpbtzFzKQp0Q_0TV6UoxFLq80MyQGFOIFAlEJXEmvKUs4VIQ6fXGhckx446hKNA-Kc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sKToPV2p11S-ez54MlQSTBY9pQijdC-07tfy3V0xxdA&oe=69FB5C17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EkwNLcBG39cQ7kNvwG0vfAR&_nc_oc=AdrT9dRuMkEsj7B-aaQ72F_ccOpJLU1qLS-rEvHpL24j32B_3VDLRM4rGLfyUWc8nCw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UtcZtIAXrHh6dhS-ow7K0t63BMa41rmMEYfs-Hp0xxg&oe=69FB2D71"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0la7hM7opgQ7kNvwHr4hqG&_nc_oc=AdpVWb_zesutnShx0k5lLMurW8N44t-RmF-Uh5gv8PYcBxTHVHH9SDylyFYcfO5BFt0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cZEOvpNdBG58TSVfCnW-vJbwfpV8Sj_B0OtLASnIS9Q&oe=69FB3B84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN6v56NjUOsQ7kNvwG2UBPl&_nc_oc=Adproi0H61ABIQ57LMApqWT-D6CYFFF-jlofROBmgiLB8ymvSxY38DZdRIc-ff3uTUg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4GpIZx3XBD0gzQO3VxmB4NDdq1w6ETaA24sATIKK259A&oe=69FB2FF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kiB3u7Gu1M4Q7kNvwG_b5Is&_nc_oc=Adr5P_AX2OwCZ58zxjxkRGnnHx0cIswDuzxy8QEpu01QzmWhEb5ELMRXxLUs06oDyZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__yEzBIXfYYn_yha9dh0JjF1mnwcN99qLZzpDZR7xY0Q&oe=6A295341"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApO0FlvGXAIQ7kNvwFsyjZy&_nc_oc=AdqJ2sZj-Lv2tV69CTSq428h6dS-jr6RO7Enxe-8Y_3NvXeH6YikLfq4WAzUniJaffo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bWtlM8dUnbAqKhg7U6xCvbI7YvffazgQL7ihjY5K3NQ&oe=6A298097"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nX5wsqOFHGAQ7kNvwE9BOYz&_nc_oc=AdplECHTKjK78BIpwGDedafhFanZwHyFr_q9XWzQisdUMV22Ws8OWRmEBEUUX8-GPEc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8GFkoPvcf66hXsHOoPQwO5nbwqP-EhJICY7Aq3YWx30A&oe=6A298A31"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uyUNB3FmM_gQ7kNvwFFJdQk&_nc_oc=Adqlh8yNj5ZXZd02SBeFEy4wzPWJokzdHZ3LoDvTUPImvG0E6R-zO87Jje0Rsu--BP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2iCfuOb7wtRaCZiHdwwJ1Jt9JwQN8tPK7ko1d3osRLg&oe=6A296004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fED9Eszgo5sQ7kNvwHNucP6&_nc_oc=AdrXkY9CKh-C41abjNCcI3lDPKnmkxErVueIJWRtB6Qm-XKROZVWL0YDF0_OhKR0Jak&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9KXmvhcGhiWMKK13a4_5BESWmMzXY0jJZlfiXYi4MhnQ&oe=6A295473"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
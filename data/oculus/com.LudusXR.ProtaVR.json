ota4.png", "id": "1510165476601670", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUeoAAB4SWAQ7kNvwFiRJN4&_nc_oc=AdpVSMPGU6s1Qx3PqgczHi72lwrbxpWEvgWjA6Hld1qL78cvxzUeN3_KicxADdib9PQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVo_kDLNdvAW8WN6_eohzECZvbuoKULOIlLfznkY4ZzQ&oe=6A562641"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXOeXRK9pG0Q7kNvwEEK9rr&_nc_oc=Adr997jcZyC8337wAP5dv-DdRnrJSeZNTJfE6Ca9AiTaU9njOuScCztwm1N7nZQtNTM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1lwph6HdCa-0Dfcu-P1mEW4Y_3nWUrRkR_yLyGfUOkw&oe=6A565397"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KR1TzPxM-VYQ7kNvwGfu2gd&_nc_oc=AdpNQOAdvY6rQwPNCnZD-R9-YfiMNJTZvSLqJyETvcIgLEDcMyn4BB6F2z0cOq88RBI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAFmUNigko24fwCBIF8L8gSh86NRmHNrUeaR6Kt27Wiw&oe=6A5624F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxMqlN-TGKUQ7kNvwHfjS8b&_nc_oc=AdoEhR2F0XUM0eDMuUZtcrCb3-h51IA0rJRjJdSDGwYD1O1Pu6MYlV8CCFrK3lW5NXQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH8oi0yt3F-GorSwMnJYK7oiFckCmBGT2sc-kBIQMoXA&oe=6A563304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIMRebCfdIgQ7kNvwF6NzKv&_nc_oc=AdpKeYy9BWQnWqmBamCWfYoHcZY_tv0-X-Xs1wA2lhj1zTW-ebz-eQQXS5hnnzlVp_4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABejpO9qEdqR9tRY2D_fZWuTTqiMz2MA0Sqjuw-zEbvg&oe=6A562773"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
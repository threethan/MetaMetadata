ota4.png", "id": "1510165476601670", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KQTGhLndcMoQ7kNvwHczX0T&_nc_oc=AdpA7Lt26hwojSWlRa7OwMkiu53VZ1MQZZfpz5qiHKUTivhtDCERWC8PuHrjLGRylc0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB6ocXRSVuSy-rEmw_UOaAFUoJbSIigRWtSC_AYp0xSw&oe=6AF9D881"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TbU46gS5zwkQ7kNvwFFHPEa&_nc_oc=AdqL1HCvXcYgHtmT-DDZtTdGXkQWR_pOwwAcKiV2sfiBGGVy_jMtwZVs-feL47qP9r4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7hJQua0O43ymv690pjh8U3J7osPK7AH_CHjx_ZdAHcA&oe=6AF9CD97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8g4R7F-dOkQ7kNvwHCFKtV&_nc_oc=AdqnpNjXxshA2K02y44kxKk7zPn_Nq2xqOc_eqUHrRgEVhSwS0LPDSjNo67qsIm66og&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjIPjIwaIW2y4mol1AP7ch515HQUoPp73wJ1oOXySWOQ&oe=6AF9D731"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmSw5IxPgukQ7kNvwEpIMpT&_nc_oc=AdrMl6ALPPzSIIgx0FCymUQkRhyxvqbPQKQLCEy9L-0SZ-iwXWMkfurkwSCgs_mO5kM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8Zdavv8Tmfv3XhZbvUW1ovUymp3RYJyqedeIxuArqqw&oe=6AF9E544"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHqcuBPaCx4Q7kNvwHxAATB&_nc_oc=AdrzjC4lKOch99mE1IJ3f11b25FHd1P56OEW-Q7URxqeX3Nz4AWtzFm48_FeuxwiJEU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbmFZLaykwHqVInWgZVQqXuc3O5Yq2NwMVxy-29P0thQ&oe=6AF9D9B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
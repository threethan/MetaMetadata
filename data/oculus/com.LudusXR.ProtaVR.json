ota4.png", "id": "1510165476601670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixTpwBjyPhIQ7kNvwGqLSqm&_nc_oc=AdosEPOW2mBGXly03I2BaSVcI9gEcAqOpCgdg-zBaAAcBx1DqLNWmVHlE5264H-nv8w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJ97hFAKMGUNDip4hJo0hNpxIaGlVSg2pgF1XzxtqNyw&oe=6A71D5C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0cTjrLWew0Q7kNvwGfAtsK&_nc_oc=AdrHe5iFguD7IlhZvV4EdCPacHlYqT33hNm7KX7UA7SABTYOS6h8D_ikBU9ZcOi5jnY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtNWeXtNhCY1YbfSk6qarZg37B2wq98rEy0Z6bq0a-4w&oe=6A720317"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l300l1rQmbgQ7kNvwF-7TFz&_nc_oc=AdppS-0S1xz8EKikoPOJUOhKZqXKvdDuRfx2SD3EYy75c3PMtWcmP72MOuJetIykaqM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNgHVDCZS0vTCV4kg9o620YwqwJQ-I-3ssumQfw6Zv3Q&oe=6A71D471"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9KLgvWEt1AQ7kNvwGsrmDJ&_nc_oc=Adp9uS8B0u6XGwxZuYsdXXJG5JC3oMp5whCGpJutZpJ-ULm_glIvk6uCcnTQIlbyHNk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUSz1wTr2wH89XoTagRqsQ67Mn8lUuNrrT3WLN1Jm6xA&oe=6A71E284"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQPXNrLfK6EQ7kNvwFXhGjk&_nc_oc=Adoa5OcqnP20sLmJPgM7PkGFFo3rcrtnI2XoAFSh5bVMLolSTj2VN4zeSx5AzcJpKCM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9IkafdFH8TwzGYPPQ-UhXoLDOpKk_4VFuWVMhSgJMsw&oe=6A71D6F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
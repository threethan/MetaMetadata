ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDS2z3uno9cQ7kNvwEgnyv_&_nc_oc=AdpYG28KwoO-Lyzh2YV1yK87MmJO4MfLGyl6Vdf6lGPOnC7AacWLbpnTuqki2dVwlko&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcaoW4AVJ52c7s_bNx-Tr4wyQPxqaLhKwvF0CdjhXKWA&oe=6A82F941"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tCD4j3KlMMQ7kNvwEtQ9ud&_nc_oc=Adp1pR2DzbpTdrKTgmH3ZdRzmufoyTlF8IhXtwzRewkZY7v0kWKYgQ2oXve3f_0H5g4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpB4GXJhdtnefkZ48vIEf3lw-YkmKwLrw32wwB6K3woQ&oe=6A82EE57"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDRzQpFaiigQ7kNvwGj2PdY&_nc_oc=AdqlhmSh3Pg6AohcTcITk2_NviSJgsFFCQ9owviIlJlFR1pfv-Fct57g-lPHud5dPQI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETjxW-rl-U_NtYliV7EfYA5yk5HXJJMgSNsycL7e54bw&oe=6A82F7F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INXivNoeqPUQ7kNvwH3oL2k&_nc_oc=AdpdIVF98x5vJLAcUay7LAKyhD91OZEGIRAbctHFCkdraKj0mPaeOMmJxZgXB7ClSEg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqNbpUzuk-TXyFgG5JFSrXyqgMuKkDMRpF_Fes3VZ8qA&oe=6A830604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P026ZW7ctXUQ7kNvwHSMlF2&_nc_oc=Adpkei7Quo9Xo9jmHTkB4imTUiUHOZ9GSA6jno9YHpezfqpMVTyT9J1JBjUmJO-AjJI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlT3h83yH19bqVEhZe2t9aQNABnKOapHOSJBD7cx4Qcg&oe=6A82FA73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
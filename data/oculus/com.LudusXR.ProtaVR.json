ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilx6aSlq1bkQ7kNvwH6HV_b&_nc_oc=AdovdSMlpr8QHESVQG-DJIVwA7VPZSov-C7NgIVrfHzwAoIkiwJeKeEKxJ4jpfDebzw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtUhVcdFRY4Bn7k8cL42x1EgWL38OYkVTTYfZM2UhghQ&oe=6AE0CC01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhiNUNMhGagQ7kNvwH4ilsy&_nc_oc=Adqrap7BvxYxUR-K9O4-b4MlZRQsFihALHZvnjnfP4JKyrBjSVVoz_TOQ0_OrbHP4UM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9FdGaaBnatAYDNVp_kyuXQ_5i_l6d6GLh1VTJR4i5VA&oe=6AE0C117"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unPlmoshZwsQ7kNvwGzKPsw&_nc_oc=Adrawd7zlzfSOcY-UcIKE1i9bkMQur9zTlddwkMzN55C-xbdfRwCoek1fJYbTCLGVuM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrzb9s_hdypaFJn-39GAYlnZw_7Ye2gq6S-CDCl2b3PA&oe=6AE0CAB1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MkiKgwOdTm8Q7kNvwFO4vqP&_nc_oc=AdrVN8eG2bYcSmncbbA3cGa279pb6-q8LZmFBYdGgZeVTxzBc-AalWJ5dKJYv-etnkY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJyct31MZNTFW6Ps-fqCsHVkhKNE5X777c4FAyr0UkVg&oe=6AE0A084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=My-BUcFTeUgQ7kNvwHC_NTR&_nc_oc=Ado6FZmvI-oBtiXXfyoJBA1A0UHJ52CeVzLm6y8XxMpc9VgsmSbmfRFj4PNPXbJ7LR4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9_lQ_gpvUqUeDW2bMQxpHXx-D5Di2m2XMmhadMFoJIg&oe=6AE094F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
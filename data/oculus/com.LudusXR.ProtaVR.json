ota4.png", "id": "1510165476601670", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNLT4ElrkpgQ7kNvwF2LjpV&_nc_oc=AdpVSw4wgRNEzpqoWrdd8pdBpY4NxVWylslE2HSMbHVMv2ZMXX2N7S70GVApynI3ygk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4sd_64uQMDBi_IIi5vNxF5q0wvq3-ECUfdZeuXV6v4w&oe=6AC91101"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rzx_GbE0zosQ7kNvwEWk1xF&_nc_oc=Adp2Yx7q4ujozdn9IDf4ENxzyF__N_bAKC-PO8vfPC9y9vSpRfEcUmaDBxzkwrp9OUY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeD2UuA5yi7ozzqgZX_bbYlwhDYMF6VOsok1vcxiwvRg&oe=6AC90617"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChENsW2CBPEQ7kNvwGDNQOU&_nc_oc=Adr7mgOkmh-ajVzMhG0X-Yz2nYRQfFz4sJ51cFgKoFzOciNzIXW8zIXC4AKCfCBeaWA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWtezMsn0zMk0ZbRN62Mxjx79lkD6Un3ljbKt9ypLFLw&oe=6AC90FB1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6xZROhft9sQ7kNvwGXfaWw&_nc_oc=AdrtGcgpq419jP1JhjdaMAmD-zxEeLI2zec8AK2a_72ofjUMXvbPk62-p7taFsgRI7s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGzRrTZlECy5XaYSDlCE7rvGXqib3KmwANBR5ie6vr7Q&oe=6AC8E584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24O608-VY4MQ7kNvwHZHtQu&_nc_oc=AdpurzQGid02QZOupu1fNJCJ9B1BM0q3-mk3YukYkYD2bO8kM3QY2TTqWhQLT39RCtA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-IuePyoNXuWtU0pD-B6RHgC91ydCw8dkGNd2tok21Pw&oe=6AC91233"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
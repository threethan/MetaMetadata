ota4.png", "id": "1510165476601670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pv2TocDijZ8Q7kNvwF52RpO&_nc_oc=AdqdB6ugJ3JN0WhU8adUBwSjActiOhbXkwDJIo-MCs_0gHutpgD86p89hEVigjkZZrM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qntDMsa06SuYjRi9FV4sSvr_pBqJHzckt-R8rNafULw&oe=6A341781"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFTKUCZGxtQQ7kNvwFuSDzw&_nc_oc=AdrUirs7OfNJwXIfU7QdiQGzDoRv8A4AiyavF6ANDsWFtf90Bey1tVwuGXls-nQDdZM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Bt2YnkpbYKjPoBFuxvmhsMkmVZbv4HumWCJ4na24A9A&oe=6A340C97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kmSPAGDh9tIQ7kNvwGU1E8-&_nc_oc=AdpATIz6EcU99iZ_nV6uYsX9TcBSiUzfi1p8C3JUWfCh06hlUjjXH8tlkxCtS-MgUnY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gfoL-EwqLcU8VgOQPfBsLz2x2YxDBMlZ3b48WWTA-tQ&oe=6A341631"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omDcqw_Ag0YQ7kNvwFI_6Lo&_nc_oc=AdoQ4Ctk1Sfwh6cl4bLTMH73oLhlq4t67GA8JrCY1K83WvW_Rp1R8Q_GQA7EU-4TmrE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_atLH-DovusDeh6hsv-3OngHDou_5CWTWRtS7hhEdecQ&oe=6A33EC04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqfdEHXQll4Q7kNvwHfU9gs&_nc_oc=AdoBB_t2tu12eRVYo_3wz0X-_wAdg1rg9kRMTmYZUCMrKRRzPrKGcWfnBbT5m9-RWCc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hvEht0wHi_8nzNFnhPp3S0xEMTjJZ8NwTyH8XxXmUew&oe=6A3418B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uc90794LsDcQ7kNvwGyG9Kn&_nc_oc=AdpNs0xdIkXZNwm5GShIWuUA10gnyRDWzf_LOzoB0I49ShMHpYdwQfLQURLzVnm1vd8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuvs2psG2LuS7QQ1nR-K1GHNZtRcDaIZJH576oa21tVQ&oe=6A6203C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlGtWrbZNj8Q7kNvwEEcCQV&_nc_oc=Adoqx7GIrDqxWuMjfP1aFxjB9UEnMFNkB8ZNzTkWsHTDw67j6fV9IHXJfADDfhrkgGA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwjEoe-n_-HUW5esTb6_T4xi-ukI1g_66LBr3fEgsgEA&oe=6A623117"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2z75Wk8Cq7sQ7kNvwGiumGD&_nc_oc=AdrDDNVr-pKBlWCAAp2GgGdkxhytun-eMXhZKHvnX_Z-W3JZ7G5EP8GNyOlRHkEVpVM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmFDQ0t79nCx_utvGnYNM4x6ut2LhUDnNas1_6mA4_sg&oe=6A620271"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odPB-jhBCOkQ7kNvwEyTi3J&_nc_oc=Ado7EiRjpx5DYUNNQLNxFEkLVoqd9g_F01-4Rzxbo2Ur57-7jx8GV7jBHruJHiWmOoE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9YppmO9V6_lVKr5EKAFLEQ9C47ehcN8QJsDk0e7sqoQ&oe=6A621084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E_OvM7CnDawQ7kNvwGHh1Y3&_nc_oc=AdoFaX4jwHAG5XnIBuPBPxZd8kRn5bY4sUspc6pMb0feFNkAe97nahwNMmw78U_BioY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnDvbMJYmxBrA5Kq9RoEntGHocZZqwPmDzaBIPf8-_vA&oe=6A6204F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgnesYqVso4Q7kNvwGybXy2&_nc_oc=AdpzgbPA2I7FkmmwLS_qjPPGeFZno0BpllBpi8SdQh6RZr4kyz0q2Xl31CnRWchSIWM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMsXP1urbf_ZDHLjDrFq48magtwNJVfubbPP0Bj1g7AEA&oe=6AD0FA01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ht5NQYGFkQQ7kNvwFkvmgN&_nc_oc=AdpkLxzFt82_8FIm_DXt5mWtsWbKuZWhPrg7sVPVzNpv25LHefPGJvIrtIYVQPcCRBM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLUn0NaP7-LgvSs74QIfcrmcelFd66ak-A6QAUXrLTrw&oe=6AD0EF17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dk47ob2LMxgQ7kNvwEruhIH&_nc_oc=Adr2NLYRGdtyJQzOEIn6MsOjX8vFTamkXu3Kv7PeojCnlXO2zMXm_-qWzZNuYZ0Q-CA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd8pTGSlFf1a2tiNyws1Fci4SuA6GaSGn5-QECtv5RZQ&oe=6AD0F8B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MSwmAV056IQ7kNvwHLM9y8&_nc_oc=AdpYp-7xh6F2M6zGyOmVMIa2Sk2p5msKKSuIWJt2KS4YtszYj-8Kj4OimuIt-tHTC2o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPA_VJAhuNN3abZ9sDIUnCQmDpr57REtxpglh1_vA3B8Q&oe=6AD106C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ll2BZfWEV3AQ7kNvwG1mxnn&_nc_oc=AdqXN7voxu4OKGfUiTsOuMbL2b6NLMtIOcJ9_Z5m9PVfNzW6delO2C2QXynXo8q1GB0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWIgLBX9CmXfbOrr0N3ukfrHM7Ad2kkEZlfIRxhd-vMQ&oe=6AD0FB33"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
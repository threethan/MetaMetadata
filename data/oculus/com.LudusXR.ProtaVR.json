ota4.png", "id": "1510165476601670", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFoHtNEEEaYQ7kNvwHzXWGI&_nc_oc=AdrspWfEBBFM9lCA7Zd1fXm1TfA1_Y_hNftGv-4JF6iI6aIyCP-UGi3kqdXVFCR8UZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZX30ex1FcstquvZx4Vft8znQD8fN0IaY_HtHbUpePOw&oe=6A92CB41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_cZZn7IinaIQ7kNvwFLsPBH&_nc_oc=AdoK7oX9S9HYM4msM1k8hsK4r2LFdWeC9er5-3k4Nsf5jV41uwnpHFTh0uedIhhrAss&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcZRWWYcE35NcDQ8JahuTtcSAk-Rg8VaDbVmaaMe2qCA&oe=6A92C057"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBevx80JhyQQ7kNvwEVjvJg&_nc_oc=Adq9dssTK7XoIEmWDunS1jgOnXo4cuoi9BRUUq6Zj8F7YorM04KJRzD2hwxHvBJrTxE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMWuZwuU5hXLbIQhR228gcM_3Wjwnqm-m8YLTPqZjUhw&oe=6A92C9F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-3kPXL13lFcQ7kNvwEjC2FQ&_nc_oc=AdpNWLt56TvLuh9KqWSS2lGC1rRhcfJRNgzsso8jZbflSBVktc_et4AajLX1_yRBgVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvWvlTAO8ZwzWVEyxG8SVgX0ZsJ6R_kwWaW6EgKVmzLw&oe=6A92D804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7_ASbiJ7bQQ7kNvwGhhlu-&_nc_oc=Adq91yRH4I2aIvSMVOQ7gONFcukMlUS76P6aqcCHp9SWbGQZDZjAhL3dxqy-y5R4wKs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXe8BtnYUHwXy28SnOmQqAOk_F9l03rGTQPK6s6uL04w&oe=6A92CC73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WI0k3XMSXSgQ7kNvwHVSE3y&_nc_oc=AdrcNS1NkLVAHXHkAeF9wwWRTged3Dn1WsV2bQd4j1irlo0YaqPEGZCTGEI33BvM78E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIn8oFFpxatAleNXPt1l069S0GBzw59osjIydEonF_ZVA&oe=6AA14BC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIgBPgluY84Q7kNvwGFG7d1&_nc_oc=AdpGOoHYcCNPcpvBTklXbkHIHH6uWAHPo3-SXtViyaUMB5Rw67xYd42F2k6Wx6tIp4Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqcTzMwGSvtEL9dhoWvKT9ZTLNpX2d-9_yIf9cxHcdww&oe=6AA17917"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c_MUdxy1CosQ7kNvwGzzbnL&_nc_oc=AdrqTTQfFnI2BBmuNpjzQPZn95dHsEfWjatyDgXLcUhR8gpAVkw_yra6gp2K-KjVmJU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf_PVQTEAplWYqDATMjkYaGrW_Padtdbnx_WSHSUANGw&oe=6AA14A71"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K0fpRakTM8YQ7kNvwFWrmxz&_nc_oc=AdqwugRz1mfzY9ce1csEe5gCZ_RIskoBwQClWy8YU6c1XQ-fcoAOne6bVaatGJdtdXQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIw9nXCqJLElI45WzBVZkUT9MFSw6bXebICvZ5aX5VO4A&oe=6AA15884"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hw_8qMqbEtUQ7kNvwFoAQmt&_nc_oc=AdrP4eW7yrZ97f-vXScWHUnRqHeXLbYblc9uiiA15oXl1wcvYpHeFxiMAM_poQGD2Ks&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhiYmT2fJaE2eTKpS1v8D8Z3HfyAdtfGr9Ty-kIxCQlw&oe=6AA14CF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
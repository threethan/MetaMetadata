ota4.png", "id": "1510165476601670", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gWhOz-xz-UQ7kNvwGVZ4_W&_nc_oc=AdoPGNbLejsqQwvxtFdFYm0UjaLpbh-G19DB5y98dlvuaf12D2oDIE_VtgkgtVvgBNY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNwUoV-gyDIcm3Rtvo6NtHoBqH3c3EKQG3Q-dGT6jl6w&oe=6A883F41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nj9xgwIuz5UQ7kNvwHVTJXq&_nc_oc=Adp-3MyIGWvIRrXOrFqW3r_DPuZP-6uM42v15gBY3aEXMf8_El31k0frz3rfjn3vDf4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6fnafgtH9L9DcVLUwGJO_kBIoj3O77nl0TEeq17KdOw&oe=6A883457"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NO8Wj4Q4IuwQ7kNvwEQfjmJ&_nc_oc=AdpFWVAbnSh4gcBAM7Dp6ncpHIMP0o8zArIX0tesEzwLEbrE5Y-fmM5mSRdgabx5uls&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBnIfvXLGFTZsg7oiXwWe3UgIEmTm6oBqK_B4ddebjMA&oe=6A883DF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDAcz-xZu6YQ7kNvwEqoDG-&_nc_oc=AdrejWffYuCqaSm--3NMiYHDANZz78HJrsbOQELp0GpjRIdwSyKJ-9tb_j216TJrmR0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkqYBadt_H0JRVt2NVeH6EQP3O2N845mEa0uFQYBAl6w&oe=6A884C04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZRDX6n53IMQ7kNvwFTOap2&_nc_oc=Adr5DVc81K9w6A4k9DQAypymsA-F22LpI67CElLf1i3I0xvwkb9EJXi0h8DO9ERajGM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZKHirxZ1VlDnQ8Y4yY42kFvmzON7q4gj6OK6ptsAKxQ&oe=6A884073"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
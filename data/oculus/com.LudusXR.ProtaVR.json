ota4.png", "id": "1510165476601670", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87jw5q8-xk8Q7kNvwFa7PH4&_nc_oc=AdrheUE2j1hvhkuPCc2PZLLBNfQvnc6761mlo5TW15ZXZ91XX1oNRnUotIC87HJafXo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2HZV5uuO8jUOOAmloX01KI34LRTS9Aw7O3IuCvyztuNA&oe=69F345C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsnSD8LTLa8Q7kNvwFfDy-F&_nc_oc=AdrKEDbZB596QZXaQqsiXWGwEJbCc4vDkJrFiMb-azPgRoEvbH3mEOvPySTaqEGQf0E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af00yw3mn6oYm-Qdv6X3bfn5W3UZ5S4CGsmNjpL6D4yBoA&oe=69F37317"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk01SmoUh5IQ7kNvwHvazKM&_nc_oc=Adr_wT28akbSYr9TXf72cVXP3APTg_uFIxoOm9pED5q4I58avq4gnVX7_2tOy5H7bb4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MeDiA7sYaCncD5b6c9j-BPUdj5GmVSe_wugjATikmyw&oe=69F34471"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A2mla32xRUcQ7kNvwEnMRh7&_nc_oc=AdrHfMf7-jVr2KYhpE1kW9nzTcb-TNgwdLo6npa7QbOPK71C1gLNrXcAbk53-KlQxqo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1W98UozcledEjAGd3xxUbmds-qnIo6XljDcHm1iFRG2Q&oe=69F35284"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhc4mHATx80Q7kNvwHnfl9i&_nc_oc=Ado47lMYj4pQc9feauWHA2cF-DmyPbQEqN0csODuzavZAm4WQ1mdXglkFkJlcjaptMI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WGRp4VfECet7a8oLG2PJoiTWVIf4paWeNPJxBYzhMdQ&oe=69F346F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
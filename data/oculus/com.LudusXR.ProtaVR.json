ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqBPiZrTtCMQ7kNvwEEBCa-&_nc_oc=AdrDD7F1r0HxjF2eSbnqBVrCTPmV6us53XC123SgnzY51qXgu7xNHOKEOrVsZqwiPIU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuWVWqgznzUaFbs7hoB4ESS71_VGdYlMOfZ5HMYkQhsA&oe=6A7C61C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoPa4HnzZhwQ7kNvwFDuVcW&_nc_oc=Adpn-f-3mUqXc0R564boZWA7aKblf71uRbT9E5o9d3xf_rz0bMD92PzvQZUw5yjR7aM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHeaXQyGM23xJ2eNnZaGl6SW76N1ohiLyJjjaTbedu-xw&oe=6A7C56D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oxtr2p61n9cQ7kNvwEQlkOE&_nc_oc=AdpD2PJDqBgl6BmjkXfxDX6fHYxvfqV608aDuJ0vhgc2eds0B3KZXwwR0FeNj-uialA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO8r0zV-qekQcGoFWamlwey4CkLeX5ZnQc9l33EUwdMA&oe=6A7C6071"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sR0Cj238UkwQ7kNvwFNkTKg&_nc_oc=Adra9YvQml2sD-ntyNt3eka6chuAKTnFbAA2uA8_6AG4W-eq720O1ioiw-LHPNc_aPA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFTtef1CMQizuNLhF6GCTDRIGdiRA4g_SC5DuwEerTvw&oe=6A7C6E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3f87STx4vcQ7kNvwEEkTYe&_nc_oc=Ado4LEhUC_pcFkr82eufhUK_73YnMda3V7-GYBSaImCiHBphD0E0m3dFvwUhaJRhNAs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErpf0tnDImRujS8Sr9FZeSdhvKCXzIKyIBN6FpxxsoYQ&oe=6A7C62F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
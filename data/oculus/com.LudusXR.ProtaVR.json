ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UhRVG-XUMN8Q7kNvwFDlFWR&_nc_oc=Adp_BvCRk7WH1rToqkV4xurUN4HpLxXmmFTayXePDCTBa3_qwcRC1jc50PdWjDDxKjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEBwfe24bTeKg-Ypth0oRiVgg6O7QvpAZsMf6vOm2frg&oe=6A786D41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TuM2GXeQjJ8Q7kNvwFnxOx-&_nc_oc=AdojfmcjP4eu3hwoCn4Cn1u3Id3XT3SKq10Dequ2VZvRgvhXcu9ZCNjPCNm25eXPstc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtal4xC9WWIH3RlCI8LkWLQFNIW5zcZhoGAjzG-53dhg&oe=6A786257"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRD3EFRGaWMQ7kNvwEsTdzH&_nc_oc=AdpdCj_GgcHdDje9x0nBKkRqzenAy_GvMEqdCmG3o-T9RpLQc-jbgdQc9_TAvLExM-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGCt564zihlKtQxZVcls695UH_8Y5uK6qc233HHIVtpw&oe=6A786BF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VBEBuWXyHE0Q7kNvwFOZvJi&_nc_oc=Adrvri_G3SEkPsWJSJh892pICMJV4gh2InlpD3yoNLSincHgKMFkOl7VkVoo34tja8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZX84_HXnrPr3L4OpfBby178gRBxTgG9Hfh0p9IjVN2g&oe=6A787A04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEcFTU8xty8Q7kNvwG2eiLQ&_nc_oc=AdoO_OANdwPZ_q5lUHR9l2knY-atRdPdmpnZWqy5mxJD9dI9wSOPJ9_UDx58hDWQHA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEa8u8WUIAIBEwdIGW3gJCDved70QMrf3hxyM33lrAzrA&oe=6A786E73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPDGZfZWWbwQ7kNvwEzai_X&_nc_oc=AdoWzI6iYpyqPp9xb0NaU4kFV_XRbdAp_nzUr6iIrSAilU0uUFv13AqF99PDreeSJTk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUJFuC9hFNW-8BdJTDvSiZigjt4AAP_QKvqVshozsx5g&oe=69C52141"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDoHehs5TUUQ7kNvwFnrG5O&_nc_oc=Adp5xXKmrQ0kp02ILj1S4cDAaji8Tzc6OKycEsj0700jq1UR874gCQAFxCVcDk5vjsg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw3Wg1TvA799q2Tqmjr5bgJ08jsA_WQyJd7OqCG6CCEdA&oe=69C51657"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMmySMw8GCgQ7kNvwHD8AbX&_nc_oc=AdolS42Go9jujdxhAj8X4XTHN46Vemey4RJNsZ_3GSgnMo6EvSxFJqUfUT5c9rftiWM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMDHoW171kGRqIa1SaovOjaC_d_zSPLy8_1Vz44-HM1A&oe=69C51FF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4kx6rpqz_GgQ7kNvwHvIcE1&_nc_oc=AdrAHvJyEF9XrAu13XO7PxnX4cEQwCz1KBYM4xonJttC0DXmfOFGSk4vv3ydbue437E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxzFt74zV_xyGkZs5Rcoiyc2LD8keqmRg3uPBUFG-wcXw&oe=69C52E04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8hnCtuUZmMQ7kNvwGjQHNm&_nc_oc=AdrF84F7rH25oSvOBSHdvKisTi4QJdNQ26Kn3rMt3oObPiIPrjwS8Q7gYYNcuxg0Yqo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuJZHIwgJFmdWfbGxaNE28KTBtqW006S8a-rln2F06rA&oe=69C52273"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
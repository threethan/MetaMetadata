ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgnesYqVso4Q7kNvwHVBTaU&_nc_oc=AdqA6nkEl8IPq4AIdMVDB8JQsNJeGPQOwH35YiXD_ZSgXS3sJEptWPQU704cKfNpYno&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeS_hmCJ71LEO5F-IIeh0QpVwhZNrEf5yk4jwq43vAQw&oe=6AD24B81"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Ht5NQYGFkQQ7kNvwE7n_YD&_nc_oc=AdqaZY_fiydEjdH71S_j7orPTKlAQhgYvSrAOMoQgaahkH-T5qbuLP1dAUIMdcF6sTQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFLFx-tLuTS_dk9LrghxAddJ0eP0idaIbo2Jw4hvwCkQ&oe=6AD24097"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMLXsiJXq0MQ7kNvwF6AZDI&_nc_oc=Adp62uKJ5SVLNsBkmqpB8IkgQQkFtNKhlCr658ESz00A9ES8sUcynwMwiz4eKx86ePs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxjUE9SNJpFSLhzazqx7_05yU2R_cxPStE27136wDXDQ&oe=6AD24A31"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcI8fX66XHIQ7kNvwFV8swi&_nc_oc=AdqIo_xkrYzm__koZd_0W-Yy76vVdvhSBhDNN3x0s02BOaTwAbk-F3kzP71YqEGScoA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMX88J7hUYpE_NUSgUqRoKQ2nbDRhG00Zca5_GPpzJ1g&oe=6AD25844"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ll2BZfWEV3AQ7kNvwF4tls5&_nc_oc=AdqMJdg8k-0-Shbv0OHpebLw13EDn_hBNZHL4zN4Mil3kfEX-9dnOerzaYF7Ey4S6kg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfDnVf6AmCf-Jt8_ZVrxkJsyU6UdqxXC9VmrQDruOSNA&oe=6AD24CB3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
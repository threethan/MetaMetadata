ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwcIaUGBYw8Q7kNvwFtJFDW&_nc_oc=Adp7LKPIQ_0gxLoiKJ9iB9SchBlxjlhBvmVfp7T8o8GWVPr6qeNlZzIhlZncaPQ4imA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5H0EH3Di8k43uBPXaQRmVaYrO9q_Rmfz3aU4ggLPEBgw&oe=69FC8041"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q614KLdyTgUQ7kNvwGsPClO&_nc_oc=AdrJnnVJxHOOJdwHm0DAFhzjBDnJ-BLyqo6ErKElljFf8HPJ03OFxy1j3bXdPrdJkVg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X0QGl-Wn29VQV2ixAgijvbyt2TDtwb-lubm1uL8015g&oe=69FCAD97"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvTAdO8miGAQ7kNvwF8mmcO&_nc_oc=AdqE2XQ2T3Dv078eexfhgpjuoevZ9W-IW4XtsdThcbNgQR3AXpdKbLU4-is8_dUMCTE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5GXmw3FtJr4d1MBSsIrpegEbugQYdMt8LVZ9R4UWbwCA&oe=69FC7EF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoqOLKNSjmwQ7kNvwHb5Mfu&_nc_oc=AdpPf1ld5XBouIoL164OuT-WhKdcCVwD0NKddrpYLi1SN7UG2_UbD8fJhG2_BC3MpB8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af776h7yIQIpVCU1bVn8mU_IOsFDsE2sWTSMwITy_aMNGw&oe=69FC8D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN6v56NjUOsQ7kNvwG9b4sD&_nc_oc=AdpMAxsP913cDInAd5f8oJdGnS7ahaDEczKL0G7DW7Exiox3U0RkjYB-VbdQ05FiCSw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MVWVw37-SqYA2W_i782DY5fI_ZIZpu1VfzvQSwFrYtQ&oe=69FC8173"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
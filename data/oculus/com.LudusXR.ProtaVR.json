ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7_NnwO2nzkQ7kNvwHca8Z2&_nc_oc=Adqi383uraeSYsDLodjuWo_uXocoMSyA4732DPe_KLe9iM0rSHbJmLcxRzeQ7bcrKno&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pdNkyl-Ohkn2QrNKgIyda3rAglB8bfRb9DLbWZdqTVQ&oe=69EB5CC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y95dTsrGFpwQ7kNvwFplzUp&_nc_oc=AdrrKbCITo-q0WpEKxmkHgFWWtVKowVuaAAVQSjbfY-gYO9e5MKW3QX3C2Z6vgbEHjA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MlDrpXqtAg9MTke6koL9kyTu8fXcCvutNCF1boVX52Q&oe=69EB8A17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e2IJqEeAfJUQ7kNvwHWB89M&_nc_oc=AdqJUgS3BTAAyriegP54RUHjGMKjcG66nvBCFiXnnP20wEc0dOLaIr_WU4w2Llom5UA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Emb8oAo7QjCp25JF62XZBAuWcQQ8OPympp9gL5PKwKA&oe=69EB5B71"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7uCwwj_EloQ7kNvwGG4yiF&_nc_oc=Adr9lJPqJ0iekAD6htdNKVgLcUV9wT2J4TCcwmCgUfC6mqIh4n-AFdZJ-Uq7InylXXQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1NOZYZ_3eq8qaSk5ODSQ81_-coz-hHJnyqf9d0RiGHPg&oe=69EB6984"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cqk-iMGzlKgQ7kNvwFttHDY&_nc_oc=AdpkfGKrg5GrgtEQKOdyGaAQLKS9HD9biTuG4Zjvdn10pU-mjl42HgugDWS0rNiL748&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xlF2pqSMuyPQAQEe-n7gtX7NWJqM5U7zn7r9ORGkC1A&oe=69EB5DF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
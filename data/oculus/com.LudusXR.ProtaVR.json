ota4.png", "id": "1510165476601670", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNa7TuMqWdQQ7kNvwHgN382&_nc_oc=AdoOEMJFcR_MzrB3lXCpgfgHC0e6tXpgEmBJ8hOZdILMXt06qc4TwCHK4mQ5IvCnyDM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lZnBJx5MnOPWuy9aj6UlYpLRlSu2A_sZl1RseuQkNRg&oe=6A0317C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8PrTl7Jx5UQ7kNvwEJ3rfK&_nc_oc=Adp3GMk2fqG_ZzTankueSBtAASD_6GRBNPxIVyXSc72KHuR7GN7m8jRFfChLcODpJ5U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cHFUH3wQ78tDJYvFKgTFbHArpsg7LX5gkklcAcyc-Xw&oe=6A034517"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyIWK9qOE_0Q7kNvwHWpnVR&_nc_oc=AdqH94T5gNg1WtVE6bIusoqplUXDDbwVfzIUIF5mw6WoV7ukzhpPBtgXvnyKHR1cXlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BPDfnXJ8uyo8m_jQ1uDJmYkXcw2pT1akuhR_iE5HM6A&oe=6A031671"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBci1OK82h8Q7kNvwEoxEcM&_nc_oc=Adp_mpKj6O4v6HmKMJMcyegMP6Evg6OtshY6tivJqt7oOde0X0IrdRU9d10ujM9mH54&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79_FnINXFGr8HAnF0kPAKSU2uX7YhpJDyzLu4RMt1iOg&oe=6A032484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l3C1Ogb4vuAQ7kNvwG_YpMF&_nc_oc=AdpgBtZUIo6hOe43HrCgfuPyuz2dFjKMDXcn8ndQZnO_nzT0xeDENfZBP8nMHAEsAlU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yQz4IsON4i6ULGGPaSmOeSWe5qG8nagR3Mm98lXtbIA&oe=6A0318F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
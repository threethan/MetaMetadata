70", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8dFtt4adggQ7kNvwGxC3fj&_nc_oc=AdnVYJIfEO5D-7uQ7tIZ9jn509hhfUZ9gLdjz_SLN9bXB7a_wMZm6QLEv4GiVc6FR1w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuXhPr7wpQPXuWtWXeSFWiMCDePvBlQlOHgsGJ89KPh9A&oe=69A82041"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEABiWGJ4rYQ7kNvwF3awze&_nc_oc=AdnriCRRtIkESzYcxeI6AMOW33W5dv-Or5E6gSbHQBenABiu4v5RcLd1EjEXeQk8h7M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuA3DVxn8p7Ci57RwJB2mCVe0DH4pHEepd3-rTTBBh7dw&oe=69A81557"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-OPMboRJjp4Q7kNvwH-ZoIz&_nc_oc=Adm8uY6yk7jaFAMxFwh6x8mIVhno38ANQHtyVuVUh2_u4RAb0J9fAAjg0GAIGzkpfaw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsN7L7JhmYt2FFQScHTvwiD0JT-1zagW_xW2rha1xtBpQ&oe=69A81EF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERrwhMUdGDAQ7kNvwGLTste&_nc_oc=Adne-bzZD-SKL6Qs180QXnQeanG2lGsg9LW1YsPDmKgCkaLcg37C-5pJNyjvQTo5gBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuFFESm3wog7zksSpM6pWFAhsLyAtQunE_mk4jBKDFk0w&oe=69A82D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXuNQurQnuQQ7kNvwFb0BKO&_nc_oc=AdnXNXgt23cys5va-_mE0n8wsciTuagN7QHWlfQnqQpkHGyGsQ384-gIXajExTqqrso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft_SZO7Px-ryaEE_OVYl6OxQlBMQjmK7bOEddAC1Uo7fQ&oe=69A82173"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
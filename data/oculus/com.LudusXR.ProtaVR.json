70", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaL9vk3SKMcQ7kNvwHgogr_&_nc_oc=Admai2orU6Jo0hYJnazWSM9-G6jVgUdnbm2mXMsr5QFgojIZdguQqfYAq02-BYob504&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzuAmTdKm4JZ2ddG-ZKyq40fQrOzsGOtqlKaxBSDCNoVw&oe=69B00941"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XnjsnnFpnYQ7kNvwHv44zO&_nc_oc=Adn3oCR4wzlL5KK-GGv4e3f2TbFx_D_2YKNbI2MjB-20wIoAfpAfjfTo-HyNg9l5nz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxcY0jLR9l-PhGmDBe8xCGxVwFVST5dHswSxQVfBqPYBQ&oe=69AFFE57"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbGXlOSRcr0Q7kNvwHQLfP1&_nc_oc=AdlpwSr5YaH7ZYYN9Aa_QuH732H-WDoHotlLBlmFrRS8wPebZZywR62DJLrdCk_DQ0I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx5vwl2v1Tt_2aIVGb3DIkN0cj3KEgCeA4ih-UMl1sRrg&oe=69B007F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kt6NopneH5kQ7kNvwFwit5k&_nc_oc=AdmmZUX4AFIcFtketal8pbC4aLe2WCJtbkjyS9Adi4cTd91Okvyc4f9haJ0THY9sWvE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx-vAbdI5sqioyRvnKsbm72qsrLuRyB7MwSb1_7RE1T0g&oe=69B01604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu_vmil33LwQ7kNvwFxPaHH&_nc_oc=AdknVH6lwWR0OTxHkOkENNscwsu3PKZBafmsVh6DZ0oF6NcJWS4Q4yGfY4Ci7_IP1c8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7UTpccSkfrnfbRbfFeaPPdJ4rzcs4F7qmIJSPerasNg&oe=69B00A73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xtRHc4zd7W8Q7kNvwGm-CoD&_nc_oc=AdpszqIIXduDdkXddeJbwEjKmliP4HAYksYN2kiMKkFfGDOO0xc_2lgqprRmmF7AIkU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RVXCv0Awtphs2H_6fYbCooqvIcVm4PI03kU9iMqWpXg&oe=6A2018C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1uRDPgztE0Q7kNvwEBseUV&_nc_oc=AdrR4e__-U1jXlii_Cu5PdiaRrPuU-dsz5wKVW6dXBqs56eSizwNzXmI__vebrP8-Bg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6f8MVQdfdRO_sGzT6fcu3jPC7gu8uimBrv0W2gLT0yvQ&oe=6A204617"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZsABCcLjNgQ7kNvwEtM-dL&_nc_oc=Adr5CTefkXIdGTYwdSEogqE4UsN2F6V370N1ilXrUPWket_9Y6K7l-MsIgO9cmQD8wA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pkLLMSlEDSml0BjB1wbnJyQyfuPCPuNU_eRhBKmyS9A&oe=6A201771"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wWQkHpPHS7wQ7kNvwFoxH3n&_nc_oc=Adq9-QgYVEReuSxCg3nnIIttzVUEXczZKH0EfOt8y4wlyjKcNjNbueKE4JJ1UF9TSmw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mnGwXxqNg4KsgkFEKPliWN_8VcvUEBvzyGVZTFJNTOg&oe=6A202584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WwsyBUf7Gy4Q7kNvwF1mfjU&_nc_oc=AdpwG61yCV_ExLoNxwvUJknGcFDfZDAVkAVkat35n88JPX-YAu_ZfK6uxMcN8sfafDA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hx_sM48GP6vr90DDtWPq3EEQwvicunulvcc1aQK_TUg&oe=6A2019F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
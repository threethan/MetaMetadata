ota4.png", "id": "1510165476601670", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TMIESiZUxZ0Q7kNvwHJzkKx&_nc_oc=AdpXWlPoXyG9SsMYKM-i8DV0Yzq6_pMLbIEIVBDi2LcC_DdvJcXNpfGudMQeQyyuteE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JgOKmEOa-wz2WD6gY6tEtDALjcf1AUdeC42oR3TgemA&oe=6A0EF541"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OfVGUfejkbUQ7kNvwHaHiS2&_nc_oc=Adp_s-Kx7NihbJiGXXeMZR-nJTccbdMT8Mm4hSJFlWq6Ynz3XTuBL4a82qayVJerykk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m-mahne2BGTYra9rL2CZLcmeAABEKJL5cIQucUGtcRA&oe=6A0F2297"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i52rX8zrFJAQ7kNvwGWllmN&_nc_oc=AdqHsuZfy2G-8qSdpUTz0mJdNzo09JZ2Hif-kdj5Inc4OE0Zf0Fw_N2GIpwZH4CNV6k&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bRI5uI-4urkNTNn_cf5maun25P9meyr2-dkyRgln2JA&oe=6A0F2C31"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZQPk1TYy39kQ7kNvwEURLwm&_nc_oc=AdoXJD1YRbUZdaHi6UVbx0xZBRY6aZy68R8PcDsZBRfPzLCuiVc_nQPoHuK6VfqclHw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a1MgLA5E2k73iNUNs27iIAb08EP_TTjftuYmQ3C-R5w&oe=6A0F0204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntL55GEe_FEQ7kNvwGz6h4v&_nc_oc=Adq9ZewZ4qP3w9D7oyT-Kp-KYpve0Xx3EqEilME6iXnCAYAvXvqp1Vpmgm1p5QUAxFM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uNH8pO2OolVrZkj5-QSNItrWuXNcfdfRPN2uLUbA_aw&oe=6A0EF673"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
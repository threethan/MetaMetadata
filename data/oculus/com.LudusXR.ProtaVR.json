ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ODPvpUNVIc0Q7kNvwHjqmVa&_nc_oc=AdrjS6emivnU8HuloQNN6mFZJIIwd3F9axWhhTjcGcdlvfu_x4-ntZMfGK4xm2k07A4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOMLM6ieslDsk5VX44v9YjUta7PlA9oj6ICTPbpkNQ4w&oe=6A5E0F41"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0nvnfzK2u8Q7kNvwGdDL_a&_nc_oc=Adq0rkWSOOi0MvGgUap3s6Cl_MB8MoCQEwGEkZuDy2r9QRK-ATCC9hUyUUsT3DGooR4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPhnXAk1IDixXmF2RpdJmmetfgmdx6j4Q6Tmu72UJfxA&oe=6A5E0457"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTPf3H66Hn4Q7kNvwF5sUxp&_nc_oc=Adrn_TJGVlhWMLNB6xmScyAfvB5U3vbpFS0n2OeHcuwEY3TxaHGXIK2xZR_XcRijLDs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6eNSzlFub-qTw6ytgMZgGMqLqNrXaMo35fzrx26UCDw&oe=6A5E0DF1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1kyLg18fAcAQ7kNvwE2upQd&_nc_oc=Adr1cgrWSKjTj63HrEzm3xal5LqlXMMOHyDisulEVrdFTe_-kk8L6vkb-vatACW4D0o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrqLznj_eM-KjluRK1j69UvlpieHVDEbvl2J9aU_tIuw&oe=6A5E1C04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_y6OJW3C8cQ7kNvwFqxuQ_&_nc_oc=AdoovlRqosfSNgA0YbrG5UOtduw1-yBaJS739aP78gLaKRHAI2SJz1z5x6ypDP2tVYQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqnUakcM6KX7VF29eP-izVqMSXjIl86p9Z9YfdrAePeg&oe=6A5E1073"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
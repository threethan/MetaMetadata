70", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaL9vk3SKMcQ7kNvwGKGf38&_nc_oc=AdkGnSrtemTAqSgUtFuqjfPCOmdScdIz5TGV_AlYdzqk1zMbEHNDnPk_7MNDOsGU-9g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz7Su-VhS20ujCppI-LCY3EopF-2uuSd87rpVpr7TdNhg&oe=69B15AC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5XnjsnnFpnYQ7kNvwF37N9L&_nc_oc=Adn1RkGtDqyIk71wpAsnwzauB0jc_TF91fv7KCY34gf2NoY5cBc_nQqWmrdg0c5c__A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSd7s1l8-ScaWLIg242fKVSQcdY0sQS--ykk-qJv22OA&oe=69B14FD7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx-LogzRHlwQ7kNvwGcFmUn&_nc_oc=Adl3bB10Obt0MptChDWcXceJ8uwARmQP6zCv10wRqeFgMA_Mht4AsL7PBpuvLZA_9-A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzjVjcGb43t6Oba0U4Jw9KajYunLMamTxzbSsCoDXHOQ&oe=69B15971"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SJ7BmiQLuMQ7kNvwGoC0vC&_nc_oc=AdkK8KsovUiq1tDIIFQsn-y5dxhSISxSwJ7jPl7isxJhS3bKUTky4eZU0y-EI3NqbNA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoOw-KbeYXqf7VlnQ29NtRxoRdygC3BNIIItczQ7uNKQ&oe=69B16784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pu_vmil33LwQ7kNvwGigHh3&_nc_oc=AdkfLjU1gpZkwKS_ZsbNWOgHrLqEDMHD3yy5dxmQ8yG-jg9IOiu22w9IarJcNlLWjvA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw-j8DoIzuDa4I7GJjAP00ZxBAkmjTPpVs7DhmQd7MxAg&oe=69B15BF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
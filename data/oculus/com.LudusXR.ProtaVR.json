ota4.png", "id": "1510165476601670", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukKL0amntSwQ7kNvwG1KKpl&_nc_oc=AdpjkRobhfsXH_j0mumiybht9ahMzs0wCkAzdJ2RAq6Th9WcgTs9EJWNbKkt8qQu5do&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz03IgVHuZ5lDE2bMj0tZByslEojVXD8i8rEYt8pT6B0Q&oe=69CBB8C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7st9BAQtvsQ7kNvwELkUDo&_nc_oc=AdpbsTakKc9GiiJujvW7tadU9Ckrb1SDlPK8bSsb5yTOI4TIW9y8VKrDhw3Lc209YCU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzrH5KMBAwCKyfDgh35axLWols-184Ln71NxP-N2g31Kg&oe=69CBADD7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zomBQbiZq1EQ7kNvwFWTu1f&_nc_oc=Adpmb_uXu4XZgv2IWd-Ix0qk7U0BzpKUxLQpJ_9AhZUmqie8Sf7anJCa0pZIthVo-5I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwtsTNDuV3ymyfNoBTEtmiHZgOO-MSZt2nbWcvLp2nTXQ&oe=69CBB771"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVuZwmQZ_SkQ7kNvwH31I6u&_nc_oc=AdoN_u3C-bu5Jy6tdEwGjhjmjCFHl4TZrfSpeAWdWEfzmV8VgIGSRhrZVJGbRVTkzRM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzKvgi4C1QXR4ltmPd_J_YkyRw2XZVyUlSFaa8_jwkYUg&oe=69CBC584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08_xXmFlpS8Q7kNvwG4BVsC&_nc_oc=AdoJsbGUkcTMm8LJAStYgpOUMd0oj4Kws4deAqKgQDqg3l20CJMGhncwb70A2C_tit0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzK6aGQKCnHp3lSuIIse3_PGuPI2X089Ze8e6z6HOMpw&oe=69CBB9F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=87jw5q8-xk8Q7kNvwGaai9P&_nc_oc=Ado_a1FsAbDoqWIf9iUFzd8xFH0D5Sc002WnWd5-fUK-wzdF8tBYRzSHr1W65yResj4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1h8cw87s6__eBzB50MOmYFQFKC-70xzbbQUTT83NPR3w&oe=69F5E8C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsnSD8LTLa8Q7kNvwE2xGT1&_nc_oc=AdpRQ6486qxBSibtkWcZp3sbZ-sXFDICxJdYgEUA84sJCIzssI14gkmlM48EgnnOuhY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1SCXj_kxUGfk91uX5z6vEAgphxg_buNUCijSpgWlyhyw&oe=69F61617"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruPEa2EFCSkQ7kNvwEnRm9z&_nc_oc=Adpkh3NC2bWxukwzPO4NJdV8ccUm17u1yKdDg9us1jK_3IfpxCniQPq8iURfxDh2SEA&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GtFzFvWcnyR_vFeSPQPxHb6Nw2KswUkhI3-eWHW0CwQ&oe=69F5E771"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0PTz4LDgLMQ7kNvwFX9Anx&_nc_oc=AdqAYQ--lpDQUvGRHLq6Pqs-I8O7yuk2TxQkSMpGAzIdo9BwQlSVVZCqqfnAI_gPSfA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2tktgbrlEuxBmugeX7A6rberpVEjZ4yArikt1gZ2Zypg&oe=69F5F584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhc4mHATx80Q7kNvwHr6IC1&_nc_oc=AdpdW6rW3LYmpwaRLlt8oH4YHRBnuNG1utgoHSIE2ZZedkIkGTeu-bKyzrTMBDraW48&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23fGa87diU5oNo8TFJgzvh2HVwdaBPKbJM_4InC-n1sA&oe=69F5E9F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
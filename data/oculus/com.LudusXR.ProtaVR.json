70", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8dFtt4adggQ7kNvwFfIztI&_nc_oc=AdnvW1WJl-j50k-ZIEq91W4eXr9UdJBEaefxxWfvl3jWlAE0FtBH089Qm47JiDiI_9w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftXCAT1KG_uHsOsuK4sGTVQIuJN74RG6_6lfitp6_yUdg&oe=69A971C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eEABiWGJ4rYQ7kNvwEmeUQQ&_nc_oc=AdnQtZ1VumghtF_lflYM6qMeMYRKfGfMC3VYUmxiAfd4BHYp8EyEblX0HY5QBqEPPEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftmXhjG5gyHuOIHUv-W77Upbf1oGM5EG4nEhTVmWtbtFw&oe=69A966D7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjIdEuiw7h0Q7kNvwGhmNOp&_nc_oc=Adnafgvs0uJwds3lmt-gS36HVN0bwHwg6xjO8EwRsS6F7YlpJobJbIhML6Mb_tNgr8w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvDdVP-jbdWJnhKYTzn491JVckiZHPWxVujMGw8nwKRfQ&oe=69A97071"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fnmQJ18Y2GQQ7kNvwFHuP2H&_nc_oc=Adn6F3lrxMt5YYQqTqcppLflV9suWDzqvXBkP9Z6A6aEWBhh_jyD373i4nS9LB35TN4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvYmP9LYR5HtN7Z33nF_dpVyFLZbx0U9tg9mLq-DI85Zw&oe=69A97E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXuNQurQnuQQ7kNvwEXaicV&_nc_oc=Adl5hGaNYgzx28HXjVAtS6Dxs_yDyXv_DL098PVdeWcijnsX5uC9SKNZFqp9lOd4h0M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afv5qewte1wCCJsNSyZNt2MuIn0w-dGg9sAtOVIC1cSSCQ&oe=69A972F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_grap
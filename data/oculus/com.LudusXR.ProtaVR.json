ota4.png", "id": "1510165476601670", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwcIaUGBYw8Q7kNvwGm2pIe&_nc_oc=AdqH2fVR5c1ojZWHRQYQViNFygba_MjNpQhjxLXyRMg6pejoMP1BBlQLcUF-uxCHt0w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tlEt8x6tlfgjynXiviYe3eKR4MpCv7BFMe2hCcxS57w&oe=69FDD1C1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q614KLdyTgUQ7kNvwE9MQDZ&_nc_oc=AdqCdpkw-P2KgcaVtmqEVZGiZn4vvQS_OceDX92_4T1akpPHWEhYZzMDY2wE1x33B9g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lhLrh9j66eoSC55fT7_Hxr_xhezoWfAJkyGPWsoWL6Q&oe=69FDFF17"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvTAdO8miGAQ7kNvwEgilgE&_nc_oc=AdoCz-vTiy6I6k_x2xt5U0YFCMduwWDhoO78cuXEOH1olS9ZQ2XOvjsXhF4xM4qF1qY&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7k7M_VmnegnHvq3IpWso7q3ImBAdbDpY5p_-iuAXtUHw&oe=69FDD071"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XoqOLKNSjmwQ7kNvwHLQlN0&_nc_oc=AdrGFif0J6U4XK42Np7I5yFFfgpE1tg1kGSx2FHmU4wLVdw87dDmU0cSa4Ugpt_7Mhg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af415aJY8_NS1x_I7PmU6vWz72CH4jpuIL7Zc-6Plgi1ZA&oe=69FDDE84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DN6v56NjUOsQ7kNvwFUX8JB&_nc_oc=AdrUfFCp_5ulDnK-EgkdOV9JO9GL4bu_3KQFX5i9mcbmry_kKdLuBI0l6GcF6xqZfZk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IqXIRX7s6iMFP-gPaky5I-Xw9Er8lZP1GgaSWvswtLQ&oe=69FDD2F3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
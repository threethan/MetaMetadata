ota4.png", "id": "1510165476601670", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VA45CVMfsYQ7kNvwFIWMbr&_nc_oc=Adqv0N5_bbMnHFL8t2IA5F_qs1on08KZH5aLdPEzqD5cBEMM-fDQlgdl2Zw5cSvBa4M&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwNzM_Ef6vXXug6mu86MZ60LWH6RmjBrx1nFALY7cdcA&oe=6A805641"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abk-eAq4J7MQ7kNvwFpjidO&_nc_oc=AdqXXysjry9haGhXtPnnBSXav46fqmLZe9VKBF1pwFVIPloWfARi5W6RSQRCGZVeZro&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsp1OAzgDGjDKv5Fo1DwbwQQH20UUK2cv-yOk8j-82Vg&oe=6A804B57"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1veF3yhhgcQ7kNvwGyIYbb&_nc_oc=Adr3G_JXvsXRImDtWj4jd8MtNMfttbYloWgT2Gucd-9VGivnzMhqZJSYLZlS0RgfvbI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR5RbtC7Rh84t_sxZSRIDywNJWbhBx883jGs1-QEijXw&oe=6A8054F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L0h2oagfPQQ7kNvwGdT6ad&_nc_oc=Adpwovo_Sg8gbcUfHiCnFdX3pbIs80QdijeYp_oDa1-_85fxjyXwjSDjMuXc3wm95J8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR8RdjzaLX5GSNUgwFyw86ZgHDrTSO8Xxb8MJh_vUHfg&oe=6A806304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=at97rc6GBK8Q7kNvwEnD3-e&_nc_oc=AdrYh6aVyFeoLnHHGJtfJmvLpcK_OYd56fbE5Qr87XWsx_qZG6Gvb8X4uS2ImdsS3jk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpDAdPZScUv_YreDHmENADVHlD5O0-xSMM418Jg32A8w&oe=6A805773"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
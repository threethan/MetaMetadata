ota4.png", "id": "1510165476601670", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA66SNDLd64Q7kNvwEazft2&_nc_oc=AdptFUa9o5X7XnjaiauCtkmXLc3uNS2GnxwdmMo1ATyAlfhRcYTp33WccOhUJZ_AOl0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0zuXda8QbGBkSJj3v_R-Lpx5qgmEzLSOVI0jfpaCmVw&oe=6A9C3E01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R45itnPNC1QQ7kNvwEo-fLO&_nc_oc=Adrnu75dI9BE3ZFle-seqxdwYAwzuBvl56xWmrbnQ5tTk6OG6_8tNlRV2gJU123Y4bk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDwlLrZRZ5OpZ4uwxn-mdqDDi_ZKaBq-AWAFoeAoAAAA&oe=6A9C3317"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAAkAOXuFUAQ7kNvwGjUued&_nc_oc=AdoBgMHUZLvKHAE2Z2nqBLMqGlhgWcPHSoGagmryaZgbHbhxlZ4WCURDEJPg9wCUnso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoAK91wfySxyHLNFWnyoS6VyXAZdZpF1AceL1TxZZQIA&oe=6A9C3CB1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xx9KBwYaun8Q7kNvwFSDoHq&_nc_oc=AdoHGCrdMd9EeFobSYn16MacTIs_EkslYSi0XAl-HOoElsbCM3hDSj5N6VVoJVE-RtM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJegaY6bB98SVXjwDIdpf2foMBi6Hn590xx5ou3cg74MQ&oe=6A9C1284"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FW1NSR9gIbwQ7kNvwE6OGEn&_nc_oc=AdqWZFiMYf6eb9Edxb88GHM3wry_IbPrMxWiRMwHw8FNii6wxZjCkcBuQmoHUvKamf4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtTTd01fzH4Z3tUn1lyR8AVDFE7K4QmTqDjzrYUBDv5w&oe=6A9C3F33"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
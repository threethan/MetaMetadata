ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LHKUgiNou48Q7kNvwEiVKUN&_nc_oc=AdqRnA05ewkVbEBqGSSncEoKau-HQtTk90JBcsVGUxiKeQeNuwTg3G_W7nAVor9kf1k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-NpHd1_3gSd70hYAsDGi8cqRo8CU41g9Musb0pDhZ2TQ&oe=6A2ED181"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCbObI3pyxQQ7kNvwEJmNdS&_nc_oc=AdpZlT0jjYbq4eQ_CaacPJQw8YbkZ_pBOIK9dXiRetSkcRi5eQzPlPJIsvfcQ9X_gS0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PPHB_dmZRc0VDhP18Me6ZZTVS4t0Lnn8454jTggg9pg&oe=6A2EC697"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LP0GVhPxzDcQ7kNvwFCnqEK&_nc_oc=AdoIEk8GjFvAorbvslPE-7E0MQBwnE2siwlSVZ_KDC9_ZNFFMeMdUIx4kZTbZWMpp_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dlT9VaVLyVLwujWgIR88NdHPk46a8anu6bLx9Gofalg&oe=6A2ED031"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iyx9ooYoDbkQ7kNvwGv5s1F&_nc_oc=AdqM9Bc3Lv0j5RMkg5d_UcaWao6IyOj13jH30-DMWdJEAiiY12drrAQdUHOeIxBORnM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nRchFXoeByEd0Z5hxoKpAOAaCAOebBUmn9trUbPIhIw&oe=6A2EA604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhEwuLwpntEQ7kNvwE9YTuM&_nc_oc=Adqf2geWD5ZfAnkm1ueA_l9ePHnqiS3Os9zwAhRs5wNLSXcp_wh_a5L4jyJtya4Eq8M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SZAA0Q4ZDuUxsQm-vd-MA2RUXOJMK0eZlDXMkqUtKLw&oe=6A2E9A73"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
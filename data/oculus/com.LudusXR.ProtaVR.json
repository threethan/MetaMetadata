ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kOez4zb-ZYQ7kNvwFaFde3&_nc_oc=AdoD_yoXRCQ7nOWuokdeAAw8Cdz9JT4Rp4g0-x_vDZFxvtehlNeTn97MOBYnloE0zpI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqMsE2bhuIbGTPGQRiI_-1hk_MIBezsCFYiV0-FlU3aA&oe=6AA81B81"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBglyUF-fe0Q7kNvwHCIrUl&_nc_oc=AdotLMruQUnR2NPJDfRmk0YP-n7EGSZcWw4jkXsVfLWWEzp4ot85WUq-xTD79y6CPKE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJohTdmEniYVKwvYhM9eblqKKPynNwzrf-IaqfMkXfcvw&oe=6AA81097"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAbRRroCy70Q7kNvwHukqgB&_nc_oc=AdoofVPaZvTrrvX_MZYMA6x8ymy-zI5MpPxD4qrCn5RCccamjf6Fg8MC7uMNz7Ws50k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpmGgrrFWybNm0FsXBxSKgXOXxmn1uNvTpcZtHRnxHFA&oe=6AA81A31"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCebQ22PNeAQ7kNvwE88KSz&_nc_oc=AdrgUP2UMG-f2TS8eOReYjhjfiGgnxdB2WjzYU5-qt8WbKT6EVBN_k4UU2N9Hgae3F0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcVStzakXvulazOT-dU7IeAO6mPJmdiHsfMec1PPWlNQ&oe=6AA7F004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pQYk4TEcCIQ7kNvwG1O-PP&_nc_oc=AdrFrg_krcpx6dkI6SQCu3NmgDv3JRqyxVnQsZhfKFoGTQG4WayhMR7P4eAbtb4dQ1U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyUIQZ5ekFneXxqa7zlvwXn-yBvoJgBTdp27sHH9PzHA&oe=6AA7E473"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
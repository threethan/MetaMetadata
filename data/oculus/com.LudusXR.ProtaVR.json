ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_wvGkzCdCcQ7kNvwH5567G&_nc_oc=Adr29gYSoLZWPm-6lqYLHq3V2VC0gS3PH0BJP0k26xE-tZbOc1v58uy-EdPCJl2fcV0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuY74ekEUPBenL11ebHWh-hH8X0-Jldyn0DWk2_R0w_Q&oe=69CA6741"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlBg9bq6AQ4Q7kNvwE7c2oy&_nc_oc=AdqVz_6A7fYSx8wHUDpDmlphLsLMR7-cjHYyKbjx5TYdRgU-9coio_rAUqJVCManZdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyIut7tYOyIgHqMuHG4SPVg3H8wwqGlYpKefGHla_tRGg&oe=69CA5C57"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zomBQbiZq1EQ7kNvwH5DFuN&_nc_oc=AdqrENwG6Q0h8knSrH_JkWcLTiGn5JRTcH9ootrry9UPGH97I7C2Yz7muK3-OsI1HsY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxW-hQJ4OxfZLecpWlZndI7svlX1B1vgI2nTq3YDYDFcQ&oe=69CA65F1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVuZwmQZ_SkQ7kNvwEtICam&_nc_oc=Adq_G1utt5mRv4BLBRhJS3yjZov4d_qBXL88whEw_Vgp7mbOLxUdvd6-5fsJBCgxF8A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZi6rhqj2iG6dJBl83_v5roW7vlMnb-NCNFW_tf1ERcA&oe=69CA7404"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6HzVv7CT-gQ7kNvwH1IOVs&_nc_oc=AdoR1qqBLwLnhvnxchjBIZeCxF66T-FY61X6naLsRQba3akAP0LGlNcTLx-XtQ9E89Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_y0h1j5mTY7yAC2VQuP8aQIr34lIi024Vp7hJ1XpIRQ&oe=69CA6873"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQeZZBRZ3IwQ7kNvwFlWRIL&_nc_oc=Adr_vas0-Nm6dl6WaIEEpdvqRX6_fbpeUqcWmZbfKYaVnKLFbLgPCTQsmsmMtW_5zZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18C9QBAhRAWx-WIqDXOyHKvFcy7YbiomX78rhe8yLalQ&oe=69DB8AC1"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pxDtonZMLBgQ7kNvwGVuTHz&_nc_oc=Adq5BodRBtXK4ERYn85Tdj-_8G4GknJhC7K59MtCAWEA7fjP0yGqbxIu5LSMpT2qJZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mk_ZV_cUycvbtFYX4xgMJfOkOs8GtNHuoxqBA4BRweg&oe=69DB7FD7"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPeh6aJuMZ0Q7kNvwEBntav&_nc_oc=Adp6K7aQkSklJUDo8Twa9g1QOJY6vubx-_ZBpDGEBQq9TL0h2M7mmSDI0dCeFCifQbk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pQTux_Ycwjf_OPxeU_DU9MdgUpsuaI83tPH3P4wcdbg&oe=69DB8971"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S_Hmx6rOL4Q7kNvwF0nkQ7&_nc_oc=Adp2uYhrQS-vbBh_BkCYidoB3wqCeVL8VLc56ohcW08UI5sRoL_XqagIvFHZC6VJF2Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Nz2qu65AYHfCQwpvcVjWV8ZhObtVjzHCciSKBrAcjSw&oe=69DB9784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzxvjxDaFFUQ7kNvwHPlHcN&_nc_oc=AdqAc68K7DPA2D8Ge1xfenpVjwGWTjyc_n4Djk33whPP7snJE_F7FyP_YbdJVYEAXb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TvO22CozUExktaICq55CoRKY2eBzxyhY5LAwLf5ZcDA&oe=69DB8BF3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
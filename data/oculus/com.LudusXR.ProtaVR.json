ota4.png", "id": "1510165476601670", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwK3FMzew-kQ7kNvwFkBHPU&_nc_oc=AdosU-Ge8uvQicoHifMrF-m5G-FfUuuNUJkR1n8_OZBLO-S0Y-QffpS3PATa8DINTak&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD_mW4-gJeHbUaL-dOEW0JmfGOjhNzlpi0pNmu6FxQiQ&oe=6AEDFB01"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvy8C86KxoUQ7kNvwFY1Z5S&_nc_oc=Adpc4IIAr7JNXtF-j9EOkeyWu7sgzd0ZmDbK5at0jcIz7kv_6xFjDFzpoMuz8rlpiEE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmqVZObFujDuTXYI8aL8-sw_0RxfOP4KsLoodiouHW7Q&oe=6AEDF017"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFRoWmHEkhUQ7kNvwGv6NXq&_nc_oc=AdqKvRXUxE9mV5dlgElbjb93OGH9mOj-UFE9slgbsNhoVRgxTnKI34kzUGrHQ3NQYX8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZT7YSFKBbzd7wSSpFKYskptfkd4EC9COpFLevY_Cccg&oe=6AEDF9B1"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0bY29QKoBqYQ7kNvwE3qGMM&_nc_oc=AdrzM3o5bkmdJVqsVszc0tFI90o7_Thf2_2eQygoFL1suF5dsl5Zb0sT1TLs3DSUuRU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShId3A-dilx8Kfw-lWHL_LsF0usSQv4tjuDUHn8_EOcg&oe=6AEE07C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85trLDCEOxEQ7kNvwHKHk_B&_nc_oc=Ado50pSxuP_ZLeg8DstQ9e4aQn0cWcZjfMVb50BWj6jXjtMc6sF8GDkIY_yCbln2Sno&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzFxocJZdzVKATKxUomsM3Zj-jzhRLKhKP6E4X0VWWDg&oe=6AEDFC33"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
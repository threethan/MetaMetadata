ota4.png", "id": "1510165476601670", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974573_1510165479935003_6808623209379084531_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1hOhuCM7sl0Q7kNvwECETSN&_nc_oc=AdonetfoHSWA4s0ebPIMEyhrrl49oqbl1HvIHjPfXbr_LTiViHvog_QCf-Vn8492Kxg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLe-PKj7vn59Pz9f9b-LVrTTFnjS0fevBNYys1j-oMtUQ&oe=6ABD3381"}, {"file_name": "Prota1.png", "id": "732891888875473", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982557_732891892208806_1054169315475505460_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s84i2t1k2WoQ7kNvwEQCVWV&_nc_oc=AdqiN6OlYW2PoRUH_pEJgdqS6auExGbbskvVAmiz1QZleH5rwJzok1qogqjxDq6ytRY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3yVJo468A5TlYE4hOuSJ-BmLrwqQ7KKjebB85oxwXrA&oe=6ABD2897"}, {"file_name": "Prota2.png", "id": "808466791460593", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982643_808466794793926_8672718806699155022_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPXeuqbcUOcQ7kNvwFAFKtG&_nc_oc=AdqDPk5y7-LvI2N1wIIE8OusjYW1gRsPFUvO_s92jdMIuz1coclA9AAd6K_hBIvxekY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0ZL3OedZfAND1wKwAh_lcZkdxXPi2BpU-XlKbyEHXSQ&oe=6ABD3231"}, {"file_name": "Prota5.png", "id": "2242214472788899", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75221323_2242214476122232_6782148399623504804_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6LuSEfBDrsQ7kNvwFluNbC&_nc_oc=AdqNiE9R_8b1pRldZNUCLcfhTv_obRXm9MrmRljZGmHACnjitZ2CGDH7iNol-1tEpXU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1LFpZWGVThiRUobojtabxatFa3uYcjuiY0uc3ffxNwQ&oe=6ABD0804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Prota_trailercover.png", "id": "447869714788238", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75393564_447869718121571_5268257617367494539_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7U9bqC3xqqwQ7kNvwGgVqMP&_nc_oc=Adqd1PgcE5Eqw6-sFy_LX5LYJTEFF5i02nBdz15nbaQ5vq2iiZsqsvs8zogp7vZX9Hw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJI8Mb_czpLm30-N93vwKPsQWUUqOBnfH-fMmIFO9xuA&oe=6ABD34B3"}, "display_name": "PROTA", "keywords": [], "long_description": "Prepare for the most challenging aspects of job searching with this interactive VR experience. This simulation offers:\nJob Interview Simulation: Navigate through ten tough interview questions, designed to address delicate topics such as disclosing a former prisoner status, explaining employment gaps, and other challenging scenarios. The feedback you receive will depend on your responses, helping you gain confidence and improve your interviewing skills.\nPractice and Reuse: This VR game is designed for repeated use, allowing you to practice as much as you want. By reading the suggested replies out loud, you'll be better prepared to handle nerves and deliver polished responses in real interviews.\nKeep practicing and master your interview skills with this immersive VR training tool!", "short_description": "Prepare for tough job interviews with our interactive VR experience. Practice answering ten challenging questions, navigate delicate topics, and improve your skills with personalized feedback. Reuse the game as often as you like and read replies out loud to boost your confidence. Master your interviews with this immersive VR training tool!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ludusxr.com/private-policy/", "developer_terms_of_service_url": null, "publisher_name": "LudusXR", "support_website_url": null, "website_url": "https://protaproject.eu/index.php/partners/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
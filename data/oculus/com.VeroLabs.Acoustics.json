OBuJP38xv1PWVLtqIFpiEnnV7avws1LdKuSFg0r_fOzw&oe=6AD22C4B"}, {"file_name": "Screenshot 3.png", "id": "1777648583280065", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823296_1777648589946731_1391759799624786109_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHUwTqXZjYsQ7kNvwHNWodp&_nc_oc=AdqmPP313ua1aA150IaOdjSl7Qyrk87dzyZhPRw_uxv_BWqhpArclogylkQieW7Pdzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNItowHcuDbDOLel70avYt8lfIGqGAirsiTP10uMUu94g&oe=6AD24A64"}, {"file_name": "Screenshot 4.png", "id": "924008687134361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_924008690467694_8792611800701457104_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wz3pgJgjb5YQ7kNvwG5LhNu&_nc_oc=AdobD1PiR069v8XW5yzn76tcTOIx-YROvvcgUsB9a02dgdzKt05m9QE18mUGM6CUZBo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHgcP36LcUhxqVOh0s3ks3QLVOzVeFiKCshVOyxq7TtA&oe=6AD23A81"}, {"file_name": "Screenshot 5.png", "id": "1074230722053702", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827987_1074230732053701_7194033824719521076_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zt4glVQNWqgQ7kNvwGF3QwZ&_nc_oc=AdquM8-1Ixr9vybUQ68SvnnBT63s8JXO8xzAukA--yHpEZ9XWJsjYySyNjcd4ySYDnU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyBkqJMjLwyPuhKPVtrvK1vaGZTrNFZqnetRvhgqXfWg&oe=6AD254A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VEROlabs Exploring Sound", "keywords": ["engineering", "STEM", "acoustics", "sound", "mechanical"], "long_description": "Get ready for an exciting journey into the world of sound! Put on your headset and explore up close how acoustic waves travel, interact with spaces, and shape our auditory perception.\n\nIn this interactive VR experience, you will be able to:\n\u2022 Measure and distinguish sound wave frequency (Hz), amplitude (dB SPL), and wavelength (m), and observe their direct effects on pitch and loudness\n\u2022 Apply the inverse square law to measure and predict how sound intensity decreases with distance from a point source\n\u2022 Compare room acoustics between a bare room and a panel-treated room to evaluate how surface absorption improves overall acoustic quality\n\nThis VR experience is part of VEROlabs, an all-in-One platform that transforms education and training through immersive Virtual Reality (VR) experiences, students and educators can explore and run VR experiments across different disciplines.", "short_description": "Explore Sound Properties and Propagation through an interactive VR learning experience by VEROlabs."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vero-as.com/verolabsprivacypolicy.htm", "developer_terms_of_service_url": null, "publisher_name": "VERO", "support_website_url": null, "website_url": "https://www.vero-as.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1343033918890119"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827960_1025016823931148_3767188820123619433_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOEzM1j08GoQ7kNvwHQPNqX&_nc_oc=AdoGKaArfDCaHt3vpn9C1uYEx9WWqGEXH3sof_udfqw5SOdbzKzBrMdptMCsPXGzC98&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEaod9uuBdMunQyrSenmzBMY
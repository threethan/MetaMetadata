oculuscdn.com/v/t64.5771-25/38974601_370904050148344_776678916323540992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XRcZB2N_FkQ7kNvwHhqN8G&_nc_oc=AdqRDac5nhi8IHE7ralT5zFUlPp3BNejyKVaNCPnDElHw5QlrgEyPDC4yBzfrv1m8KA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdPwtlF0_kEF_7RfOP2WrBkkh0EOve1Ws7yA-cqL6lEw&oe=6AEF3A76"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5RTWYE636sQ7kNvwED6xpP&_nc_oc=AdoqHf01YBviJI3MhK_PHM5kqAyEbe__gXqcYdwqUsR3ER__D8UUV-U3apafjhCl43g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7-Nwjf1oMBl2KU3eaiSMH7sBZbbtyPdGcvFahFJ4Yvw&oe=6AEF31DA"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucxL_Js2wxsQ7kNvwGKYEH-&_nc_oc=Ado4Tw6JOAfwjzwhfbuVD4tUjowOsFIPoGOi0qKtff28LpX1FkNBRQ9vq-SdX63tHgQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWJrt9SnFB_UPrFXD8zC3h7soru9IXYVe6dmwu4sRo8g&oe=6AEF66C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdaaFrjGkxcQ7kNvwGJfBtu&_nc_oc=AdoxfxYsHsZSvoofYbdZRJh-PBszedxj3rOsVMLxmGYL9SP9aGHU0-Uga6_h4gKrhjQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQX3C_rpGD8rWUY113gNkbfoW3a96_zEgIG03NyHQKB1w&oe=6AEF4FCC"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEM
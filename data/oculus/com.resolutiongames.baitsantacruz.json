oculuscdn.com/v/t64.5771-25/38974601_370904050148344_776678916323540992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrYS3hZpAIAQ7kNvwF4BHCs&_nc_oc=AdpZGnOzbkD7eKVToKfyMnmOGUJ7z9jKhcZohHFxLgpCuoVTXXddxp-uFK3xHclcxzc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUrkW9SlDAIgJbXE_8k70e9UPFyPJrAEfRsuhuGveOew&oe=6A901636"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W8ZqrD2jP0MQ7kNvwFkuPiY&_nc_oc=AdoKOk67XHqj1_-A1gh9fC9ZdYUp0l521N_VFklRbeEMqeW5yVBcMe85UhxIVyZ4uq8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF35B7OXoUpum5JfPbsC2Ft4fgBkjsXW76mvoXaFKmCug&oe=6A900D9A"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-6KYbb0b2EQ7kNvwGQI6ap&_nc_oc=AdpxByB5tQo6u1ZlVQEHShvZF590oHb9TM96qNLkZUjM_JcaVYu0w3cbdVE_IR5aptM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGR7i_Rm0OdR_0ajBXNxQPmG3PJ3FdNdO19kLuKqQs7yg&oe=6A900A47"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT-xGpB9YUUQ7kNvwFUdoe9&_nc_oc=AdoqJ8lC2L5clbjHFt02XQWReWAEcqH6v4XxrY1yI-Qu-ttBn9-_gppygbDcWHFCcbg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAAKtwJSJkHbe1rTrue1Bd-6lM7KfOYABCJgxSLfzeEw&oe=6A902B8C"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEM
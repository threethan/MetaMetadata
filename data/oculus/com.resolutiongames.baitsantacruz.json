uH6MQ7kNvwHtdvO-&_nc_oc=AdqCq1zsmrULrBs0zmh8D2dQ5GlHsPv-g_NdOPQyGP9V7k6VWtlmuwOCVsgP4xzQOVY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qPcTkOnPh2QddgukgWKV0-jm9nwPupqiGiUo4nxWxyg&oe=69DE53F6"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZuUlvs34H_AQ7kNvwEE4SNq&_nc_oc=AdoziMPiAM9bvzfO2I3VL6ZmEDDtnKX0GPW5DtNzPBfF-YLxCyZWfdIQlEEF8KLc0J4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35fmXpda83sJNaAb9-Tujdh_CK5HM3xTFVyvMCLB2CTw&oe=69DE4B5A"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBp9N1a2XhsQ7kNvwHPuZIu&_nc_oc=AdpDU2c00Z2hAe-Udut_FsFY-Pf3QyoW0zabr3XgEzf9fEJqIqqtFbrkzK3lmUAqqvM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ri0srGTm4h-17QNfENvylSG6iI6Wed_n0ej0_xQY6gg&oe=69DE4807"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss9-X_4IoJoQ7kNvwHhs7UY&_nc_oc=AdqP7cxFIHrLS7Zu8x9o_eeMN1kIraPKYRnXtTjZ9tt_lQug1OMsl2ArlMuNpPaAWHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PIX8uqLB9rqwREkIH41t9qd4lSQm1l3gY8n3RNSLRfg&oe=69DE310C"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": 
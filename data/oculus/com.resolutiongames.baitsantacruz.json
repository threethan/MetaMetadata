cdn.com&oh=00_AftZR7FU7mqlB63OULm_UP9kMKOdiXr8J5RTvbbg1p4kqg&oe=69A419B6"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1jyifLpJTQQ7kNvwHgA5ti&_nc_oc=AdlGCsyQW4GPRkRa_8N912JACVj3bQZiEcuTubwc-Ni9fElQZ9Tpx2NrMpRLvEMWPT8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuJubsEcLf0zUUHIxLHYMP1_8bfw1n1ti3-2KbdiQ2DbA&oe=69A4495A"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yM27sw7zPeEQ7kNvwF2PadV&_nc_oc=Adl0EzBx0jlqFT_2nChzJ6Xnd0diGVBlgvBcM6VonnyjUjHeVBDk8bCHgAmiWh3W07g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvdyxX7HMc1QtLbSUGE3w4Da8kQxleq3VcaLinT3hhwcg&oe=69A44607"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hv8u6YUBCAgQ7kNvwGWoGs9&_nc_oc=Adl3JyRWjRCYM4QN7z9XGpgO_rNOtFx1S226Je-MR8mtMu1OwUoSdP9K21EL6dQGb9A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvGC6S1D-uK5Hr9k1E56c-bewJ7y_DbXP36fhln5B23DA&oe=69A42F0C"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "fr_BE", "fr_CA", "de_CH", "it", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "suppo
nt-lhr11-1.oculuscdn.com/v/t64.5771-25/38974601_370904050148344_776678916323540992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrYS3hZpAIAQ7kNvwG4R8Pv&_nc_oc=Ado-tgMcRH6ydyMOj2ZaeDYAJ0KJDr73jeO1UNuUXK1Fz0A0kbyt7Xr-LjueeeVnVLc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQbg4IDPc8squYXZPUesdZTOQ8t_RB3pW9wIVVKaR0jQ&oe=6A8EC4B6"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JqxPDIeK6D0Q7kNvwG6XZoi&_nc_oc=AdoS-pgRORdDsg7rNHI7Kuwx_hJWwwA9wWat8xKRxxazQilS0Rf5IM5mYsoj6xd45D8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETJnwW_oT_6JIYt7sw75M2Bj1F55PImm62P26T3yneEw&oe=6A8EF45A"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-6KYbb0b2EQ7kNvwHhKjiZ&_nc_oc=Adq6FSXrlqygKIqq1sQvQZmMRfaEcroYGuo1jbHigai30o1W0rHL7bjYTH9ODBNA8jg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnOm6r7hL98cRrrZ5W8iXJkprEPyMn2FG1eWURMSWzeA&oe=6A8EF107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTVGNOaQmc4Q7kNvwFWDhsf&_nc_oc=Adq4CVkc3ApbnNNI77PGt02CGJTF932wXozGtiLmbnvBprzqWAzzfEdBINmCby5Ge5c&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHnhoSVL3EFwnpyZWYzVIvuxzEAaKJ6gTn7spl1KqeVw&oe=6A8EDA0C"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_
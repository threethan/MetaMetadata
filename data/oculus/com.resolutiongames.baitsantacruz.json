uscdn.com&oh=00_Af02Hj2gTIaMHaTyvXOTcNS0SSmzr4RKDpkgS_xlUESGXQ&oe=69F0C8F6"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZFULUyGMxsQ7kNvwEX3ud_&_nc_oc=Adpdaut0514d87_uds5mLvZQCyd1JqogbXzY01uuYBsdL0_dt5LORTgyUq_LIHJK3KE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3dA8Y5FSrK_jiA2i_KMOi5jJLAvTXBDjUoX4NkseeqCw&oe=69F0C05A"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhocUery8mgQ7kNvwHw-H5v&_nc_oc=AdrnwypkEzhQDF-eRYwp5_KqrH-GY15ystuT0UrqWOeOd0b7EOAjFEBjp0k06mQtIt0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af02uDpjzt7kYS3GE_QSM6pOc_jVrzJkvVhpg1caYeXI3Q&oe=69F0BD07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gufWe8lKzYQ7kNvwFLeDqq&_nc_oc=AdpcqecE7lmjrvPxtTcqvdqivBAwq-neGtI5-dolLhNpsLLRrGBAGYMTGgWSKF9pykA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0G1M3HlIQJ3B77RA0ZhVMxZfCNE_BwkYso5BIqE_E60w&oe=69F0A60C"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "fr", "fr_BE", "fr_CA", "de_CH", "it", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "sup
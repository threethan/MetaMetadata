oculuscdn.com/v/t64.5771-25/38974601_370904050148344_776678916323540992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BX5VfP02LscQ7kNvwEf_Llh&_nc_oc=Ado2z8bqOLUefTiLNZ1at0fuD-SyFjgN9xRjMBg21BW8CP6TagOmd98bj4c7l1dVVGw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpOyMIKVLIgWkuMcxIC_vaip_AWVfU9iKk8iX5zFDlYw&oe=6A7B3676"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eh-ghc3s9n8Q7kNvwGHEvHU&_nc_oc=AdqMFI_Z-QyfR_X94oQGeCypCezMXOteMAJdr2Q7sk4bzm95INp1kF0w0aT7CXRAMTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGuG3LIlOsZE3OEof-KVrDmEsu5a8qKCIpRWCdemgmGQg&oe=6A7B2DDA"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujjLvO69td0Q7kNvwHxuCwg&_nc_oc=AdquK41o9P3wKbByQB4jsVJ2kde23ljzRjWlBD4AgHfyR8V1zgKcATNrIN9qxb-6cyw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbLVkq7Jjuii8rmCwzZkZAJfvh-sE6ws8_EVlqpywjnQ&oe=6A7B2A87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHqHR6jF5C4Q7kNvwGGdb61&_nc_oc=Adp9i3WsEYJX8x8fW3yGubqpMNU_k8gJhQDg3z-ngtQiM1hVPP-MMbcUaTuL2L7bBmY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQERj13Ql2gcqFKmtxHIC5o31GGq3OrlUJ2_Fu8TWEOH-g&oe=6A7B138C"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEM
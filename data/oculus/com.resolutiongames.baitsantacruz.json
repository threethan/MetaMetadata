oculuscdn.com/v/t64.5771-25/38974601_370904050148344_776678916323540992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr9IIYi9jFUQ7kNvwEorgr2&_nc_oc=AdpAavn9ysuB3pZzI7bNni_YzutfUyxWsRYwLJHIZAab5Y7GvnRilu3oyLz__eVg7Xs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCzjbv4d6GoT3eCGMbF8fHhxylSIOP1xU7wE3YDsSoJA&oe=6A9ADA76"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JW9PDy3c_kEQ7kNvwFGL_tV&_nc_oc=AdpPesOvBdV1qKEGS8IxoVAJ8OeKJMuMp4uzWAo5ZMDgZ5Q1stagpiNtGoUbeEP-l6A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSFC-_vHWIu1YEhQvbSxOxK3Uwa20_Rg5X0-hMDbmaWQ&oe=6A9AD1DA"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21sAoyReM6oQ7kNvwFyqRQc&_nc_oc=Adp8q4CCCKN7I2-KdS3FdzQCMlK6QuHR5rTc5Jx_XX3MUjBegg2tRTrku-vh_wIc9Ts&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6XmjYd0GGGdZ1daHg762sOYOIgOPH5k8WGsGg6sRutQ&oe=6A9ACE87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMwnQdPw17sQ7kNvwHuAw7p&_nc_oc=AdrzH9kg4fIjVRZUeaR-Ae-ykgalBb3L_YmPrlajiX-Jdx2ieN1Gn6CY1FCYO5if1FU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgjF07NSB9Mvh9NFAPddw7G3LOe8mDZGs8OxXn2pB14w&oe=6A9AEFCC"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEM
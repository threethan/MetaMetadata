oculuscdn.com/v/t64.5771-25/38974601_370904050148344_776678916323540992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4LF70Sd3Co8Q7kNvwHL6Epg&_nc_oc=Adon2F1HHyP272E_RZK3Dm2R06DPmsi7WBvGHXmwPQTdfkmCReiNSzqOPKV_owzZq6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKpBzMUOMF43EMPjZeZapSBLH3qJ_jW07nrByeBPLOQg&oe=6AB92CF6"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xg51fSjiGqoQ7kNvwF7Gt0j&_nc_oc=AdqS93kYoRBhyulT1b-3ZMOkVPnsTsdF_RrTyKHJkrmhMpfN3ByUmbCbfEEUmxyDZWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRRj3RMdYbF7kMykIyeqpq5YBOtuZJeozuRm2r_yH-7A&oe=6AB9245A"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-92bM1WOAIUQ7kNvwF5QADw&_nc_oc=AdqJviQ4olM-67e6z-nMovZrQmh5OnNvVr7FHIr6MW8rrCOAO_u-rcTj229ky0R3FwE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6iqpxJYdzsfuOaboEJnygp54V7d-F27Cl1Ob-bN3FMQ&oe=6AB92107"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QI2i_GJhR0sQ7kNvwEIDxPq&_nc_oc=AdqsTCBXZVUyoJanE2MMbwav0KCN6EqQkJ6FCtfAxEefMFEOzVoVHdrMQrar5ri426c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCvDlZbp-y_lTo-auxOyZAtA_LGTxT8UjdD9uQM3IajA&oe=6AB90A0C"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEM
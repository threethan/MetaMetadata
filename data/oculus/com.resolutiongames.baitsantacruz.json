oculuscdn.com/v/t64.5771-25/38974601_370904050148344_776678916323540992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HkLHjPZ6mQYQ7kNvwH5eRmn&_nc_oc=Adp24JoTkjURYWIfXPFKaYtD4yN-yldBLPNZxmHy42sWgDf9U4ENlS1bR1D_eLZwvzY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGlueFhUvGGN2gv0TjmWlDXA9iaF4y2Eh_Qkkd5FSs6Q&oe=6A510676"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lj1EWMhHeBcQ7kNvwErC9ZS&_nc_oc=AdoZtDPZS_D_b0_XRHJ286bz-gDm5bVRKecnrRMHer8xrX-dXu1dAMhNqBSfPKhx7xw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBebrjH2fs8ebiDNkyTFT05YRzVHX0E6hliuhQTIWaqlw&oe=6A50FDDA"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65Yk3O5MAvsQ7kNvwFkR86C&_nc_oc=AdpK5uTfEU2IadwNMjgPlEmw-dHsOfU-jRqbz1PE7zYF1nYdTfgTz49-89GKdiy58fA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBigf5GfX0cecgif96jCYAMQtOx8NYA3B9YOnLNmyDLXw&oe=6A50FA87"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfGxyLFnVyIQ7kNvwH4SO2g&_nc_oc=AdrEIMk34uN7_zX4rWW3zpqk_tij4W7McrYQgEApjKOKv0UTbpr2OZxNExHYwJ7prds&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcLG89Kr7hD33EY_hd5Cpo0uGYZUX0r4jfZQgIMEx0rA&oe=6A50E38C"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEM
oculuscdn.com/v/t64.5771-25/38974601_370904050148344_776678916323540992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S6-R6unOEvoQ7kNvwHyV5IP&_nc_oc=AdqiEmfjhQu9KD1SH7MC1opUIRY_wXRzb35MmWPj5vhmcRRtyHeX64z_Y4HikYL7M7Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7iie0_-GhG_wrQIAZhem5fPhBpEmlf5A6OumQNODDJw&oe=6AB689F6"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3O5_83ywxo8Q7kNvwFgfx68&_nc_oc=Adq6Sw9f_Ftjle7BbeyoLmxq6nhmHlrAh8ip1w4LRCibEcNRS4Imxi0NqX8Wi7SAUVc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIT_CJYYwsBgQ4_7ijs-jirsFKDgj9r4SnwoBX34Ny7Lw&oe=6AB6815A"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6jXjwExl8UQ7kNvwG9iNBW&_nc_oc=AdpSVRWAg3ze0hXgzvMARidKzd0_Ktlr8Ntb_S77FDY8W-NzWPNJU2hv7_uRDnFpDOA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA2-hDzGAZ4PPfoGWbuKRLTNqifkqVqZh0ZuOvtqboBQ&oe=6AB67E07"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlaO8CojrJMQ7kNvwFrCjmq&_nc_oc=AdpR5lxWY3rgsE36qFsJkaBRQkhM8SnGrmoB0SA-uJS1L675XVlPacIEitSXpLN0hBI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5n2k4Cg2Vob8i9YWC4tjsf9ghF1tpyuokNR5b1cjPhw&oe=6AB69F4C"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEM
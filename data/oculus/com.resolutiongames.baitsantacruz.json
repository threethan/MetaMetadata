oculuscdn.com/v/t64.5771-25/38974601_370904050148344_776678916323540992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ne5PAa0RuOAQ7kNvwGvvX-T&_nc_oc=AdoiRwVrFadD9m4aISmzRk0bSIHq4yRHrRXryuQgRjO-Iobiyfl7YL8rrktEht3lr_4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-jWCeXRfgzch7fdL8VndYz-gcPEkF-kdMYV6azRfipQ&oe=6A676FF6"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYZf0LZpCYoQ7kNvwHravOm&_nc_oc=AdpT9BoAoYyCE2iIiRwVIJ2FiHEe5fHTYmJ3LckgrMlMHNVrfbQKjSDy3V3RqodnV80&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi8-rTm2X5ox6waOe5l2SO8rLQ4VRdtk2uBW40tGAMRA&oe=6A67675A"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SkaQqr3PZwMQ7kNvwH_P9OZ&_nc_oc=AdowW16GsggbECnzLif7vVJk_mc_sPOh6IVyuyPN8n_UywDv34wsuV-2DoBeesdbPh0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBolVq7ThoA_GK5Phl7f_E3xFoGg2_r7WnoZ4ezbS-Z2g&oe=6A676407"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjYprPsj_bkQ7kNvwGC3TmL&_nc_oc=AdrK1B1HvtpsrIq2eYftTUojhLDSWLY8VQrCztxVkhqKGW0mQJXi6gUvCqVxw4Pf2IU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDQ2qI91AmuelB2TP0auTQOnnzCM07FwO5UnOCZx_U1aA&oe=6A674D0C"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEM
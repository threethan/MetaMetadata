in6-1.oculuscdn.com/v/t64.5771-25/38974601_370904050148344_776678916323540992_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQr4WRd-mNUQ7kNvwEstIQB&_nc_oc=AdqVun8vJ_jJSfNbvz7Utuzp3tl7R1trd4AlTqOp9mzTVBMl58aInVj7T3wVQRRfSbg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK2QN2a0pJcAu3JFMVtFOm8ooRISXGZzX33N0ZA6oz6g&oe=6AAEA0F6"}, {"file_name": "migrated_image.png", "id": "2363844927238876", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974488_1469519529848649_7426903215414706176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_ZiisaSzAEQ7kNvwFJo9jI&_nc_oc=AdoAFvcXwmKX6prAAebRyxf0jWKnCw_evpcm9ZYTz68OUvEe1jfqpxL-qtn-mMfaBco&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEjM-S7prT7A1nPuEqiYRJZzdTfM08Bph3QpM-1Ozw3g&oe=6AAE985A"}, {"file_name": "migrated_image.png", "id": "646388049495324", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982585_2268489740096871_2807216123886436352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAYFZmhf-18Q7kNvwEzA6Ed&_nc_oc=AdoTNL6SIbE7LHxT9Fz1hLAXWMRD5tVzVTXNDooe57R-5Gseim0b98RVueOS2_w-3cY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI3UTn7T65kMaCVtBmxgFZR4E2Ib_JMGU-63X6rloFPg&oe=6AAE9507"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Hibvii", "id": "201330004041151", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031460_201330007374484_7730455393473658880_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y52QXoF5oykQ7kNvwGvvkhj&_nc_oc=Adpm2y1xrZQnYYG7AyV62vLZ5Xjr8YXQg1UxkQrSzDl_uNWzIjL4qlpV3ZrtK93gkUg&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSHZdprdKmjnqvR79EhQNJSD7InI0Kx_mPXUwUQuH7Rg&oe=6AAE7E0C"}, "display_name": "Bait!", "keywords": ["collect", "explore", "fish", "free", "lake"], "long_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cIt\u2019s definitely the next game I\u2019m getting my mom to try.\u201d - The Verge\n\n\u201cIt\u2019s amazing. Bait! had an almost instantaneous relaxation effect. Once you get started and cast your first line, everything else in life disappears and you\u2019re truly in the moment \u2013 I bet my pulse even went down.\u201d - Maarten Noyons, founder of IMGA \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?\n\nGameplay spans four different lakes, each with a distinct style and its own unique set of fishes. Can you catch them all?", "short_description": "Join the more than 2 million players who already enjoy Bait! \n\n\u201cBait! is one of those pleasant games for everyone.\u201d - VRScout\n\nYou\u2019re invited to Bait! Island to help your boss catch a rare fish, and thereby save the struggling aquarium where you work.\n\nDuring the game, you will catch a lot of different fish and make friends with the locals. But, will you be able to keep your loyalties both to your new friends and to your boss?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.resolutiongames.com/privacy", "developer_terms_of_service_url": "http://www.resolutiongames.com/", "publisher_name": "Resolution Games", "support_website_url": "https://www.resolutiongames.com/support", "website_url": "http://www.resolutiongames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SPORTS"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "
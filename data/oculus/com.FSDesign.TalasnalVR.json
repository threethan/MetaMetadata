557467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK5wfaEbTboQ7kNvwG7LxV1&_nc_oc=AdpUDFdfVrWnmgt0Z8CSOBl-NjlmL0vOJ3x0ylh9cnXNbwokIRBgO1pYQh6a6bhJvoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uP_CK6AnnRxGDz2_QSxne3tltnuBB9LM4IS14yoN91g&oe=6A032831"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=878MZzk8MW8Q7kNvwEbg7eK&_nc_oc=AdqONf9NjhxdRmkQfFVd3RVVU28V3l4YaGlS_Ncp78QeovFIPcdOcTC2cEwc_zt67fY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jJIRK2d6fBdXdRdNuceld7e3fKKyEZ_uT7QCKhzsvBw&oe=6A034613"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VB6F4lOjeKwQ7kNvwFlGM6C&_nc_oc=AdrYAaaMTZ1EYSD5F_v5EqIaPr1mIxQaO4vd9BoxkBdviMgLHbEayddjIm0q5zhyH0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kDXROLfpWP-lD1Dtz9O0fQnJoH95t-n55M7cc9i5Wtg&oe=6A034AD1"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLNiDssPlLoQ7kNvwEnnqxx&_nc_oc=Adp8RkyX8O0Y4lTeqJpp9YV1TaKKXO1Ubt_oIIUBkD1tT5JeeeLfFKN63APRYCJuQLs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Od4lH7JTKKR3tOFz4A765z3FiBrNrCyqKAxUFIbewnQ&oe=6A03145C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "support_website_url": null, "website_url": "https://www.behance.net/fernando-sousa", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "684071766301820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86807788_2884755721819476_4405880643963968984_n.png?stp=dst-png_s360x
Lu5irY_LpL80HVNHBYzeVSH13A&oe=6B071DB6"}, {"file_name": "Talasnal_Screenshot_2.png", "id": "437888675024500", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75307246_437888681691166_4385571175614557467_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FmZDdxPry18Q7kNvwGteb7e&_nc_oc=AdqPVR8crjP-Dkkuu5E-XX4AxUN-wvyEZJVLtKbkfdXsHQyGDCjl1REs6t7xvkCMglg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS85EU1bkom4TVnPeZXibvey8Et7a3RuDz8YeplF_6qIQ&oe=6B0717F1"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDBtBMKtoHIQ7kNvwHPksQn&_nc_oc=Adrv3zruo1SGNFYt6UzMtGbQPeqpY_XjPxhliy8Gur7QFswvizOT4cnhSgR23E4Q228&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREt396C9zDCSUbiZH1a5GgTfHlVCmHU8I6381NNm9rHQ&oe=6B06FD93"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BBQOUopiQHcQ7kNvwFYhwtS&_nc_oc=AdoScNrc0ikF9Fp4IMSyQ-yec0LKMhpFBy1_-92tBRcOEwUBiyjnOP7zOaWC5yv-JB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPp564S5XaxFNfAeAMY1jhOA9fhr-R2V0ZzCYo3s8e5g&oe=6B070251"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGJdpmu1JQoQ7kNvwHqqT88&_nc_oc=AdqqzvuWY-UjKj4M7FUjKcl2sd84Jtg33-l5HlrLKKtevf7-B4CIW-JW-nr8Gyrmxd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_D5AhN_hnq0-DcjqqdISIBcDWsZYEAZXqg-64Ofhrow&oe=6B07041C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "support_website_url": null, "website_url": "https://www.behance.net/fernando-sousa", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_
dn.com/v/t64.5771-25/75542962_478020120481482_2335875178620447945_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mSaOd3JpFMQ7kNvwFxrMKy&_nc_oc=AdlM31EpCCFXyAXlaXAXWgxmpamosZXIOwutxtqqLNsUChnyHTAWsVjBQk2e6MiVvDY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxHROIxz_hVyMiKEfOfiPOjJqF3n93oaRVsdF7ZKSyImQ&oe=69B54369"}]}, "id": "593393559002660", "locale": "en_US", "screenshots": [{"file_name": "Talasnal_Screenshot_1.png", "id": "2488119967997651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_2488119971330984_324807568160469793_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4EO7z898JAQ7kNvwGZa6X3&_nc_oc=AdkCvgrsXPKrQxetS1XAK0LXU_ndqy0d-cjqXs0BDXkgaLxOcWXZfxwwfpTf9U437wM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQpyeomgKYFZkXkCxZU2kGrX55l9NvVMveuIpB9LmbGg&oe=69B56576"}, {"file_name": "Talasnal_Screenshot_2.png", "id": "437888675024500", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307246_437888681691166_4385571175614557467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCE1gQyNwQAQ7kNvwF0pgX2&_nc_oc=AdmB998BKnABxN9styyzkBJLH0LAoI8b1Km_rZftd-l_gyUtyEXiOon5zgWZvJtI8s4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzZGxy7ZRepCx17oaSw4aE3FVvOx56gz-m3mCnn8ouYGw&oe=69B55FB1"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqTqEE_WHIUQ7kNvwGEgZ-L&_nc_oc=Adn_N2QoTZimc7zBVbvbF0rre5WMXAt2VSECyIoyUbAcucUa_xHaSOAE1osJWdlRCE8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw26EMQCdu1WAqj9W5LMQ5A6JLfaWrg0CimgkXJkLUTxw&oe=69B54553"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7dx22midYsQ7kNvwGrc62x&_nc_oc=Admh7nS7cRMaGAHwQkcg1ni8VKwKduIMtdK8wBXLKLnrfpggaiUb1ZjMtesjm6e13qw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxymY2bORyR1ZdFRjtu9jZ3_ZsQkt80zCfjY1Y_-8_mg&oe=69B54A11"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr_FXac53wMQ7kNvwE-Hm3i&_nc_oc=AdliWpFTD0rOQ5FSbOaiNAYUmbsnRAkozFmHQWNT-Yh9Sp8JrjI9vn9aYeZOC0Ne0UU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxj1y0Ztllldd3bL1KqUze1mY8AaHZtWRU9BbI_6EcYiQ&oe=69B54BDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "
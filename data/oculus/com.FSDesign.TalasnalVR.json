dn.com/v/t64.5771-25/75542962_478020120481482_2335875178620447945_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LEbvN78_xeYQ7kNvwGlcWl7&_nc_oc=AdkxfYJYgQOqW0r_l7D3UHJIwHg0W95Y9W9CaVCZ3JXbSwBH8_Qv6fxxPquG7RxBYeQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afuseac1qAq0tYdhr_x1qEBgoGjrBm9ykQhdCBs4KXec-g&oe=69A965E9"}]}, "id": "593393559002660", "locale": "en_US", "screenshots": [{"file_name": "Talasnal_Screenshot_1.png", "id": "2488119967997651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_2488119971330984_324807568160469793_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0B3JwvICBUQ7kNvwE7QWXc&_nc_oc=AdldMcoIRy8Wj0xsSUZ3k919JePgjQxmlGAHbFdioeSeeVCHZmZ6yX-64qbNfj9Na30&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv-mvEOyoDeKwrjyOkTziVbXCFc1tuMWTxpPtw4pzMVRg&oe=69A987F6"}, {"file_name": "Talasnal_Screenshot_2.png", "id": "437888675024500", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307246_437888681691166_4385571175614557467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfpPi7vfY4wQ7kNvwEShi39&_nc_oc=AdmKMMC6Pzo62SVRT_zmSbXPAP-UlK_KPCfvoHihvOfIrKvzgkBTSowUg23PBWM3IGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afv-EwDkSCNSqCFOTZ8TYHmi96F2VEFLvs7PkeAEdZW2Wg&oe=69A98231"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KADOkqTalIQ7kNvwFZ8S2b&_nc_oc=Adl8QalGpHzSbc5D0qg9km-jEb3GIpnEnPrpReDppvUcaJ07uD8ywwIeu3KEr2gECYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu92BhDbVHViHqyjjjVXnaYsnIUg1OprELUpdT9QR3Cbg&oe=69A967D3"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPzJs6WnLQAQ7kNvwHEWxX_&_nc_oc=AdkHL5-tbThTqljOK4HaPSBHdXVPA3AVrQhC_jp1jv1p2FOvmJaWVdtl9k8k0Pt8Z5w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvxOn6Twz2qPzraBMRX9FibDqBm0AW2UaUlrZz4BiHouQ&oe=69A96C91"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B2YV5Q0RXMQ7kNvwG_5C3V&_nc_oc=AdnxlOz4vMGx0aJP-wHYqmF9NzOQ2bny5_oZUhNNijAX4ebePwFQsu7IXt_XTITLcrg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvIvX31D2RE4SWCUINd2faOQwyo5pMvZIE2eku-q5ohWw&oe=69A96E5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "
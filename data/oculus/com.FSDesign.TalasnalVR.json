dn.com/v/t64.5771-25/75542962_478020120481482_2335875178620447945_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mSaOd3JpFMQ7kNvwGXXbBo&_nc_oc=AdnqUbd3fVV8xO2VRhizElGcfWkvZ5adD5_tU4V5uLVXFYNG4yyMd6b6UcDbZj1S1X0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrDUFsII-9xqYIPbtbR1eFGjSIzLjqIPzPXgpNj7gItg&oe=69B694E9"}]}, "id": "593393559002660", "locale": "en_US", "screenshots": [{"file_name": "Talasnal_Screenshot_1.png", "id": "2488119967997651", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035326_2488119971330984_324807568160469793_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4EO7z898JAQ7kNvwEEUYfm&_nc_oc=Adm0QDh6u1nsQxVgMoNbSEBXarBQMw7Y1r5jn-39Z3gP2hNm4sDuxKeH4UF0pvumS_g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwpAJPmfdDd_N3TXV7QahD3p5EIaihbgvSy8tbH_TNGHA&oe=69B6B6F6"}, {"file_name": "Talasnal_Screenshot_2.png", "id": "437888675024500", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75307246_437888681691166_4385571175614557467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wCE1gQyNwQAQ7kNvwGPcDQS&_nc_oc=AdkVQFq-qrQDtp4JKwTh1b2lrlgOCHhKpAJ471u9cVCeBPoe45co52lQLqr23WTwxiA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afyk-DPwaCes2I4FWaynHnAFmaorPa-SJSDB2bJA9n7HEQ&oe=69B6B131"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqTqEE_WHIUQ7kNvwHCg5OA&_nc_oc=AdmdT5tQYymUVQi1RgzUf8aZPjIFVQWvFQtfmVMj2HCJltOIN9RyWjd34fTH-sIvA9Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzi0CIqhnKKrvpJwYHIjB4Vo_MW-39uqoYpFb8zCsaNUg&oe=69B696D3"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7dx22midYsQ7kNvwGUELfV&_nc_oc=Admvj0cdGCCifp4MxyHs9it9-3kJqDF-zVT80AB1P1BSvu9aT5ovK08xY-iDZ37LKCw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyY67zrVA_3gPlGVC3ZgiyZla4g6bHpIJ3klUt8KBFd4A&oe=69B69B91"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nr_FXac53wMQ7kNvwHNhRH-&_nc_oc=AdnV3fDBDUU1uTRhCCho7jGDeS-5BNDLywphJTyP6DGmACe0XmQcTCM5ggHUkyhgXsU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyObdSw4YslIOH1UbIGrNmzYy5IM-zJcIz0pIdrc8QYqg&oe=69B69D5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "
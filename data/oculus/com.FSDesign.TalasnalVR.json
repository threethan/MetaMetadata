n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMD9S0cTDMIQ7kNvwGXa3qj&_nc_oc=AdpWgd04VNf-qmiaSiXUTL-oCkDJXuOGM6MiDDIXbZ9W4RUTqDEsal6lhbXY-CE6GJ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7NWe_1ck4oYOFoM8X1wOePtTlh3KXI5WckOPA5HuA8OQ&oe=6A0C8551"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgyZsXFvjQAQ7kNvwG8k4_b&_nc_oc=AdpxcsjnYo1y_cWuyeXVhywwDFGRDgZaGmLouYoTGhhTSAyJn67KTjcZ0PMh3RrzqXA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PU6xDbOeAUV104qqyQIgZgMS4kAtUR2nGE5sU0GER8Q&oe=6A0C871C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/202
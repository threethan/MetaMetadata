02023723518923", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M5uhc_kdiRkQ7kNvwHyxXKa&_nc_oc=AdoH5jFX56-Txpiym8yiOdf7L5JfPKvT0YpRwk0lJfwE_NPr82twB4dp0ehgMBrPUUA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfaRLJ9_rHWW9K8KWoKF1xurpmWgsQeUkSsZkLmrWnqg&oe=6AFB2013"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lItBDab3NMUQ7kNvwGWPWre&_nc_oc=Adp0Gq6u4J8HzP7Tof1bWttzIxWwrxWUIE95NVoZ2dACTgGqSf0e9OomzIo_oUrrqUw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXjZYe7Lm-KZODtWsEHhV33Vn1K8sXe0En8OUM891oBg&oe=6AFB24D1"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbzXJr6k8nsQ7kNvwGudDg5&_nc_oc=Adp_SlSZG-5gZJCZ1-3Cev0aKXjsHUqoqqeOCWlZywSUiIqc0Zom4WkdPAfYhe0dGxg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSye7YYSte_zr5BvxazOUCAZXuAFIFN9i3d_y1S7VMPBw&oe=6AFB269C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "support_website_url": null, "website_url": "https://www.behance.net/fernando-sousa", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "684071766301820"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "475246317557934"}]}, "baseline_offer": {"id": "475246317557934"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1662487620, "status": "PUBLISHED", "id": "475246317557934"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5351587278252936", "version": "1.2.1
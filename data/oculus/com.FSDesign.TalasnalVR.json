dn.com/v/t64.5771-25/75542962_478020120481482_2335875178620447945_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBLP-teoX1YQ7kNvwEJOtQo&_nc_oc=AdlDbgUREKMgz46HvL4XScBqx2e4RSiWbihuNAaz5EVL6HpoGPehEcmkA6zU-CGeyhE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwUAJqHqkzZ3Tyamg015yVQImkK2RZ6q1DEp3qzwWem6A&oe=69BFCF69"}]}, "id": "593393559002660", "locale": "en_US", "screenshots": [{"file_name": "Talasnal_Screenshot_1.png", "id": "2488119967997651", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_2488119971330984_324807568160469793_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jFnhxrgCylcQ7kNvwGG6OQu&_nc_oc=Adm3Q7nt_2wXJhNQs9MXu3yQ1A1CNOVc0TN11UDqIWKlLLlIoDctEbQdoWGrsrHhKEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5rVh38WYDD99jf48HZJDlpYQeGRl2_h4N4z-5qqP1Sw&oe=69BFF176"}, {"file_name": "Talasnal_Screenshot_2.png", "id": "437888675024500", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75307246_437888681691166_4385571175614557467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXK2jNx46gUQ7kNvwEFneeK&_nc_oc=AdlHs2Su1fB4PMQEbDFZyvTkEodDqJBE17DDgBZFasghfbOjrj0M4U53541EBssYMGg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJB7vtf7pxjgtI9-CclW2DjUvjMnr6IHTANSDhU-ZJag&oe=69BFEBB1"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gi7KWgct36oQ7kNvwGCoKsa&_nc_oc=AdmqiXQtCvIEw756binExQdrZCo9k3igs5AstyHQ2SEr12frNZA3TXb8pBEJoABp33A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZmm6qEXvGOUmuUSXIw4UKHHYDFbOsftwJGvEQj8VPrA&oe=69BFD153"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h_RI0OSodaAQ7kNvwElFjP6&_nc_oc=AdngcS4gJQwzkIXFP_S-LgyZMd-Pk_hW4VyMlxD6lFx_ubrC-AWGtSFpMlvtN9en-fo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvuSxReN2KKHQWJ6wMRlhcaQ_guZmGVw6HfXBBlbR2Ew&oe=69BFD611"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mvTnX1P-phEQ7kNvwG06Gj2&_nc_oc=AdnPeaXpLPpssc2yWMYlfFw4YKi7JxnlkHKqevkgHLohuQqfcQ6ql5U4eT8YZPAlad0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFxSuyCSipH_d09IBFZ8B_pzt_-7lMnoX8FmrcrMiW1g&oe=69BFD7DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "
557467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gk7RRY551HkQ7kNvwEzgUO0&_nc_oc=AdqlPypxqoNnHB6oHNzWgIQDh2u12AO1sUqo_nYM5w-huu2s3C6dlDbLM28dtwFYKck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04kLCrsQcie9aV1HsrBR51HvpC7oXMbWTrODUFpUhZ1w&oe=69EB6D31"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDs8X-PzpVYQ7kNvwErtKSS&_nc_oc=AdrrwdyqlDrzY94DfsnZhrTylXT7h3VQ9I5ds_j-0r8h-jzcQaGLY9Nr0SYDpHTX500&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zkRQIThuk21vtTGi0FjM3pXgivr1leV8mjGg7astfcg&oe=69EB8B13"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cEQWZV2MNsQ7kNvwG6Q9TW&_nc_oc=Adr78g7Mdt5b5Wu5G7zYyyALiE7NPalqZ_eZto71Y-ByScqB7gHZBO4DSthHiKSaUKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12pT7VYysWUu4k1cVYXZEVkw0v12ZXzm1Y_CBhB7k_ag&oe=69EB5791"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p_n5kAkjeUsQ7kNvwG0xzgZ&_nc_oc=Adr2zRC1zEgZbcxBwp-iTHBGOTR4BK71vGGdcgpBoUZewnvVneP2DuJGRokknxfUND0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RiBWpZ7KGL9FokEfQJ9RZP_J8aspxq53-5_SY-AnmRQ&oe=69EB595C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "support_website_url": null, "website_url": "https://www.behance.net/fernando-sousa", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "684071766301820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86807788_2884755721819476_4405880643963968984_n.png?stp=dst-png_s360x
AchAlAMLtFd7q9-xZsp7hmMqvygNHmBbWnq_iKpF1qlP-nEhaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs2_GLurmVBq8sND7Le8b6T6ZaPgZ75h9kNdtcLKiW90w&oe=6999B031"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=toUqr0O3Wg8Q7kNvwGu1hg6&_nc_oc=AdkXGW4lJSHx0Ok3671O25cunW44xLhMlVDC6ddz_B_2fOGpqGsJofunRqQR8dBaBl4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftWuXqWn_t1oekpd7IoqfsAejMF8cOjK7rVOeb64P3-lg&oe=699995D3"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HO4Ud3zrtKcQ7kNvwGW8-Nd&_nc_oc=AdnUOqPDeMdg4f8gcN-PR6WpNVDdngSqeNd4RnUuy8AZNn9TW2JrKpCS8sJa0MQMwn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu6MEY-i8p2We6XS5mTetpdRQYXql39C9yByjOoqasn5g&oe=69999A91"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDw1T10LFIYQ7kNvwG4XFr2&_nc_oc=AdlSAK-RIOP_HERB1go2fmoR3pW7ZxvgYGlsRXBdrtkfFNZi3rtSFTVAkYE-5C-0qMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftQWu3_TqDx0St1wqcXgvnE73dhLHInxoNtRBABrH7kuQ&oe=69999C5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "support_website_url": null, "website_url": "https://www.behance.net/fernando-sousa", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "684071766301820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86807788_2884755721819476_4405880643963968984_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTkbIZVHi5IQ7kNvwHpImV0&_nc_oc=Adk72nZ6GBzANSnWToXZOMqds-V31t1nBiMLYX0gpK3TD5RMq0219JL4BCJeqXT09U0&_nc_zt=3&_
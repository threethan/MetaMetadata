dn.com/v/t64.5771-25/75542962_478020120481482_2335875178620447945_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAjIRTocfMwQ7kNvwFHmIoc&_nc_oc=Adk-O1pJ35ru9xWNVWZEsYoWLESrDyYK3c9vOFpl9o_F_AcqiguemW5weE-5nEYYCGE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwMW_B4WFykTbjDaxjy5C9KUczdRZhwTdoQ-KgNxQzcyA&oe=69BBDAE9"}]}, "id": "593393559002660", "locale": "en_US", "screenshots": [{"file_name": "Talasnal_Screenshot_1.png", "id": "2488119967997651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_2488119971330984_324807568160469793_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCDgyYPqWJYQ7kNvwG8W7Xm&_nc_oc=AdkK1WuDrAz-QkU3MmRmzfEHRrq0OwpoVSX5aKxb-nM2IOCB_FdwU2a9va2qCJJ2xmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwwXQFacJWtuIk6eYuBmKvccR-WICvenPbexkseZr-aOg&oe=69BBFCF6"}, {"file_name": "Talasnal_Screenshot_2.png", "id": "437888675024500", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307246_437888681691166_4385571175614557467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6KfZneJuNAQ7kNvwEaglcz&_nc_oc=AdnLQUsp-yjGQ96NWY3OoFUlptTf898Od82d14DA6IUgjIpCjB1iOgIXuKeafpSyA_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzQK_gCRFabXVB968cjIgKyKmYW3d27ykVoOQxm-uYMNg&oe=69BBF731"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ASEmMvfk734Q7kNvwG50k-J&_nc_oc=AdnIsJ9TyZ8UALUT8gvvrK5X5xrKnlUoEWB-Vf-_JsUaenBNPCzem5jr2TJJGlAMZ50&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxkfImXb4901Hsber8h8wX3B8_nyvorgCWR6C0kuOCiQ&oe=69BBDCD3"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6LdXMPPZyJgQ7kNvwHiaLTH&_nc_oc=AdkVtzWWpilZ754fW3Q8BekHneMD8i0gguvbl1aBrP_PxqyHf85LCOTcFkucf1zvoDo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwantfCjeWGZ4quGvpAK2EMcQHCtNNpvYsdAJ7g1_fUQg&oe=69BBE191"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvlW9CuuLuQQ7kNvwF4xvcc&_nc_oc=Adnxt67rOrup8nq0Ev1-pb5JWXKdcQKLxrMbTL9Yqjtk04RMWuocia3VzlxAt4urvt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwg-hkFNaQs8KdnozblUfhHJ6xG0RyNdScEJ7NtUeKsIA&oe=69BBE35C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "
557467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hWiuybW-ksQ7kNvwHAw7LS&_nc_oc=AdpHBKCzExOdRZ-7f0CLOuTFehCLxfbMeOu63ppWcNO2Fpzuzo5JMk3ONmFB0QSgp2g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-u4e3iM1psfAPl1KG8VvujLQJ5p5GWGy2nG7l5AgCyew&oe=6A2EA9B1"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KebREJ5tN44Q7kNvwG7s4VT&_nc_oc=AdokuDJro1dEUxRYKW-Tt9XZ1BLMtk1hCmCVCvgwYkMtZDEtEg1ECK2Y1ozB3VJe5qw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FBjhXId3TwgaEDyPmj07zKx6x_NNd1NMNkIGpCHMEKA&oe=6A2EC793"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdr5UJr3fJIQ7kNvwHtBEr9&_nc_oc=Adqc9WSEFe1-cs7gdvNhi7tYgphUDnsL2aNMVozqtcXcJxNnShHGJjYGx4dti8dUWms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8_5BFOYnIoRadKALhblQpRblil8Z6WUo59zoAhod1eQ&oe=6A2ECC51"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FvJxSpMQkAAQ7kNvwEKn827&_nc_oc=AdqaS-weCBJaKsmLdebbSg5LYvFoHAghKktpD-aK3AToiza4PHyv_r2Gooz8hZ5N3mo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vbkIwSdK2pMAVe86baqbxBh-iS6zDwMtQosb7za7WPw&oe=6A2ECE1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "support_website_url": null, "website_url": "https://www.behance.net/fernando-sousa", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["DOCUMENTARY_HISTORY", "EDUCATIONAL", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "684071766301820"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86807788_2884755721819476_4405880643963968984_n.png?stp=dst-png_s360x
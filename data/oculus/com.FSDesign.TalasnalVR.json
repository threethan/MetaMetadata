dn.com/v/t64.5771-25/75542962_478020120481482_2335875178620447945_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAjIRTocfMwQ7kNvwE5PsWc&_nc_oc=Adkiou5Z2Dp94JRX_WwgsIZQJsJQHDCZ19Mm04OznMRkhqt0McX7_So2wNRi895VbUw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwnHboWbheK7513vop48F9GR99ItA8R5krbBdSb7A8nbg&oe=69B937E9"}]}, "id": "593393559002660", "locale": "en_US", "screenshots": [{"file_name": "Talasnal_Screenshot_1.png", "id": "2488119967997651", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_2488119971330984_324807568160469793_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HpDIGcE_G4Q7kNvwG31f3j&_nc_oc=Adkyh2aL3FTN8kR23K1NSzBOP0EkWig41M9U1dgOrQpereOLvk3C7M4lbSsDzSQVees&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzmCtzyklXCSWV-dnQuyJm0Mt9BB8NxG3MVeMDlHWQ4IA&oe=69B959F6"}, {"file_name": "Talasnal_Screenshot_2.png", "id": "437888675024500", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75307246_437888681691166_4385571175614557467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5583ZIKBkBEQ7kNvwFy3jp6&_nc_oc=AdkXp2QeN6IFLz-yBTVbYY-llYWiN0Vu9wVKgqHyB8pEZoj-xeqJ23I6_fF2L57R3Xk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFlas7swbIXQhmYE-5Bgj3fjz0jv_UKYKsdys0ipDBlg&oe=69B95431"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDg__KfKfDkQ7kNvwHiiIoX&_nc_oc=AdkM8h6-oM5jp4GsRU1izADNkh9QAmvJpkPuwnS0fH8oDrJw8Z-UQvk3Boq4Arfuw3c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDCFa2y9cfGBIRN9ZW1iE9BGYwAq889U9hZBYd-5mnmg&oe=69B939D3"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcfIQXfv6BkQ7kNvwFGJs9O&_nc_oc=AdkIo1_3XxlJCwM9BhvsBPHOuIHuJbKaoOT7HxK8yKcnpE3guXh7802J4g3B_2nCIDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afzvp0eUR6x6-xgqxzhXKsLsCyBqywx0sz1-sCmD-hVdtg&oe=69B93E91"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-iD0RUGvlQQ7kNvwHCA9TJ&_nc_oc=Adn-_b_7B2DBuFEND8nrOOShyum8DkAvB7ywfy3fW_4KSgArrqv_pVI3QfXwX__dMz8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxltsI5RvFvrmncs2ZP5w6T6809IT_gX8OnHWhM28GsuQ&oe=69B9405C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "
dn.com/v/t64.5771-25/75542962_478020120481482_2335875178620447945_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjacBazBnrMQ7kNvwGFFxTG&_nc_oc=AdnHHKij5gxW0e9xo67stmJ5tuMkVjKUJTbmDc0JIZ2_CnCEF_RuxAE4MJGzSzgte5Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuQFCBaRR2AdmPtL2mHCnJRMrKK6ugapt3D3Vo_uGv2Ew&oe=69A81469"}]}, "id": "593393559002660", "locale": "en_US", "screenshots": [{"file_name": "Talasnal_Screenshot_1.png", "id": "2488119967997651", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035326_2488119971330984_324807568160469793_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0B3JwvICBUQ7kNvwFRxdqr&_nc_oc=AdmoecNPGbjS-xWLwnybQ7jg573GoP-mM4fDoIk53PnQ2uwcKxp5f2BsPTYlXUvWSKM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afsm83rt-m8qLwJUbtOLy-AdlZ7dJr6YlE4Nqzmz5ucpCA&oe=69A83676"}, {"file_name": "Talasnal_Screenshot_2.png", "id": "437888675024500", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75307246_437888681691166_4385571175614557467_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gfpPi7vfY4wQ7kNvwG9gLZg&_nc_oc=AdnRgtuCVu-j4SwuZNMZ1dhGB1GOT-hNJW_ZcHZ2P4fIE2c17Ypehc1Z67ua3-J8Kj4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv5YvJFBasmq3GYM8leMdyE0VusPx1xLgudti7zPIMh-w&oe=69A830B1"}, {"file_name": "Talasnal_Screenshot_3.png", "id": "2002023723518923", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75375756_2002023726852256_8558703323763451720_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KADOkqTalIQ7kNvwFy0V5f&_nc_oc=Adl4TcNrTW-t7-WoU6HijFCZrMKRnBcbbdBkB9uemsPNqEMqHsMdWGe0hkYD5RPXSZ0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftYDd3i5MK1HU9Tlje6EpYDsrAEtf3syglzYA0U70R1aw&oe=69A81653"}, {"file_name": "Talasnal_Screenshot_4.png", "id": "1277408626339806", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035326_1277408633006472_263758744334772154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPzJs6WnLQAQ7kNvwHp3Lkg&_nc_oc=AdkJoiP8sOk3uydduEDgNUHkJtbeixQHmQEV2Fj4SnXb2N75KB7FPzYy7MI9LkvNEeo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuHQJ2Hz4S62n_ptVbCUA28xykDp9Pxs08U7qPfmWTWFg&oe=69A81B11"}, {"file_name": "Talasnal_Screenshot_5.png", "id": "811622046873538", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572936_811622050206871_7484775287227675262_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4B2YV5Q0RXMQ7kNvwHXAWIW&_nc_oc=AdkMunctie-1ksatY1BddUbKWc8WEPT80jMEqWsQFjyskmASpL-mTKu1Bqtdg4MxNzg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftdFz6fLk5wo17A81NMi7uhrhTxq3F8DMJq4h5rChPPGw&oe=69A81CDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Talasnal House VR", "keywords": [], "long_description": "The exhibition of the Ethnographic Museum Dr. Louz\u00e3 Henriques (opened in 2020) articulates the dimensions of the dominant Portuguese paradigm until the 50s and 60s of the 20th century, corresponding generically to the \"Rural World.\"\n\nThe museographic narrative presented in the exhibition circuit was intended to move away from a representation often associated with the idealization of rural life, either for its emphasis or for the condemnation of its inhuman rudeness.\n\nThe Virtual Tour is an integral part of this circuit. It allows the visit to a typical house of Serra da Lous\u00e3, characterized essentially by its construction in slabs of shale and wood in the jambs, lintels, and aprons. Several specific artifacts are integrated into the house, reinforcing the richness and complexity of some of the numerous human activities in the \"Rural World.\"", "short_description": "A virtual visit to a 20th-century traditional house in the village of Talasnal, located in Serra da Louz\u00e3, Portugal."}]}, "developer_name": "Fernando Sousa", "developer_privacy_policy_url": "https://privacypolicytalasnalhousevr.wordpress.com/2022/08/02/talasnal-house-vr/", "developer_terms_of_service_url": null, "publisher_name": "FSDesign", "
_oc=AdokSW6MXO_FlIl_W-7vb_AFeNhI4Dh84fUD5P2BZRK83QVMWP_93eu2JQhLMyWMKWA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMHYK3dGdvdomhS6TtmhyPl63g1PVbpIzXf3aZKY7wFg&oe=6AE8A110"}, {"file_name": "Image Sequence_018_0000.png", "id": "4801975316741126", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593882405_4801975320074459_2391861023402776024_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xQvKqIavQBsQ7kNvwFvgUG4&_nc_oc=AdpFzbt-XyGH7tQQAnU77zy545GODU0_D868ORXTspc0L_sufCuas29fpPxA94zuvW4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyTSH3-f2KE01BJIxDzjbTPtqRweUFpEdXku9AK7rTBQ&oe=6AE8B475"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Reflect XR", "keywords": ["creative", "wellness", "selfreflection", "mindfulness"], "long_description": "**Explore yourself through art, reflection, and immersive VR.**\n \nReflectXR brings creative expression and meaningful reflection into an immersive virtual world. Inspired by art therapy and informed by clinically grounded concepts, ReflectXR offers engaging creative experiences designed to give you space to slow down, express yourself, explore your emotions, and discover new perspectives.\n \n---\n \n## **Explore four immersive experiences**\n \n### **Creative Calm**\n \nStep into a calming virtual environment and color intricate mandalas while listening to instrumental music. Focus on the creative process and enjoy a moment of relaxation.\n \n### **Explore Emotions**\n \nExpress how you're feeling through an immersive 3D canvas and a variety of mixed-media art tools. Create freely, then take time to reflect on your emotions and creative process.\n \n### **Explore Self**\n \nCreate your own virtual mask and explore different aspects of your identity and self-expression. Reflect on who you are, who you've been, and who you're becoming.\n \n### **Explore Journey**\n \nBring a meaningful experience or period of change to life through an immersive visual timeline. Capture moments, milestones, growth, and experiences as you reflect on your journey.\n \n---\n \nWith **16 distinct creative experiences** across four modules, ReflectXR offers multiple ways to create, reflect, and explore in a space that is immersive, engaging, and entirely your own.\n \n**Create. Reflect. Explore yourself.**\n", "short_description": "Explore yourself through art, reflection, and immersive VR. ReflectXR brings creative expression and meaningful reflection together in engaging experiences designed to support relaxation, self-expression, emotional exploration, and personal growth."}]}, "developer_name": "Persistent Technology, Inc.", "developer_privacy_policy_url": "https://app.reflect-xr.com/Home/Privacy", "developer_terms_of_service_url": "https://app.reflect-xr.com/Home/Terms", "publisher_name": "Persistent Technology, Inc.", "support_website_url": "https://support.reflect-xr.com/", "website_url": "https://app.reflect-xr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8590553617637714"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/593909648_1066453002969811_798229877814196245_n.png?stp=dst-png_s360x360&_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awp1bqfaSCIQ7kNvwFaWDVD&_nc_oc=AdpGx0W21cjWMryb2xkzb2mFSSgRuQ_BjdTe4Vsck-eLi3CYR584y50iLRz
920916344_1622736217626694540_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mit2SwwBFW8Q7kNvwG_FDJB&_nc_oc=AdoWJQt1pGTn21AW_gkL9tj2Ocuttx4bjP1RcF_eRgU37fCkeua6bTIM2GRBd_i-ecg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTk1fK0HArP25aIxBl6YBqaW9pS8MVSAchnl4UCN8IJQ&oe=6AE4A44D"}, {"file_name": "KitchenSkillsScreen.png", "id": "1741716483745964", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593749142_1741716490412630_5681386212373817578_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut-JFAygah8Q7kNvwGhIKaV&_nc_oc=AdrqBqaT6az5bymuN-AxosCBcVIGeGMHU9iakr1GI5JV0CkxIU4Zw3lED7pkWrvw76s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiVVgT3daqi95MndIjnFMkzLt4RQ91G02m_S507yMVLQ&oe=6AE4BBC5"}, {"file_name": "KeyCodeScreen.png", "id": "2234185157371356", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293690_2234185160704689_6365137581986807744_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tF8tDePDIYQ7kNvwFb_OyR&_nc_oc=AdrWYKUchwlLJZIL6WPeUCFkdDSQ-PPwYpq_XPec0JP9SyaCOMsXVDIqzmFrg4lAhsg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfqmsSty1VOntPFG-v5V8zUEsr4JR_t3WJ2pnK4EJ-wA&oe=6AE4ADF0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "InReach", "keywords": ["Education", "Training", "Learning", "Skills", "Free"], "long_description": "# Learn New Skills. Build Your Knowledge. Transform How You Train.\n\nInReach is an XR-based learning platform that transforms real-life content into engaging, interactive training experiences. Whether you're learning knife sharpening techniques, mastering tire changes, or developing specialized skills you can now learn through the eyes of real experts.\n\n**Capture.** Real-life moments. Real environments. Real expertise.\n\n**Create.** Transform that content into engaging XR experiences on our web platform.\n\n**Deploy.** Instantly share training across VR, mobile, and web.\n\n# For Everyone\n\nLearn new skills. Upgrade your credentials. Access your organization's custom training\u2014all in immersive XR experiences that actually stick. \n\n# For Organizations\n\nBuild the training your team actually needs to know.\n\nOrganizations can capture their own real-world expertise and create custom training tailored to their needs. Upload VR videos, photos, and 3D scans. Create interactive modules. Deploy privately to your learners across any device.\n\n# For Creators, Artists & Subject Matter Experts\n\nShare your expertise with the world.\n\nDevelop premium courses on InReach and publish them for anyone to access. Turn your knowledge into an interactive experience that people actually want to engage with.\n\n**Skills and Knowledge always with InReach.**", "short_description": "Learn new skills. Build your knowledge. Transform how you train.\n\nInReach takes real-life capture content and transforms it into engaging, interactive XR experiences. From knife sharpening to tire changes\u2014you can learn new skills through the eyes of experts.\n\nOrganizations can capture and create custom training and deploy it privately to learners. Creators, artists, and subject matter experts can create and publish premium courses to share with everyone.\n\nSkills and Knowledge always with InReach"}]}, "developer_name": "UP 360 Inc.", "developer_privacy_policy_url": "http://inreachxr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "UP 360 Inc.", "support_website_url": "http://inreachxr.com/help", "website_url": "http://inreachxr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supporte
z3gIIEEIwZ8Q7kNvwGHC66H&_nc_oc=AdptqMNjXu-grxNoYoIz2bad0HDFxmCCxpqKuwrqjhlHKwUYSV30206Vdc1KOVufkxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1XnRPrzrypwr2NlHTljIvQyDjkt-q4bT9U-MFEqFqbQ&oe=6AE5FE75"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXVL9clQzfkQ7kNvwGCHoJ1&_nc_oc=Adrqqc0MfVuV1NJMP-BDgbMxYQLUQiEJMbR3TWDmiEO0h-XWBIjCwxtuX3Gs1wMyjbo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6LdPRxyofoDeZ7_iRWZWp7WHYptbJWOfryCE5-PzwfA&oe=6AE60A5F"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sEp5Pq-FXiwQ7kNvwGeM0yn&_nc_oc=AdpPRDX37gc_0rUskow2vK8xWw4pxJQIipAiEx2Z99l6o3iBwYkCeHij1XvR1Jz7iXE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAYGNAgem9ALO7eSG2l-TLNp3Axwn8WOD65z2uV97x0g&oe=6AE5E322"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSgb4orFsaAQ7kNvwEMOWxN&_nc_oc=AdqVK1vlsmtI5vyU3evCJi4j148ZurOplqJm0w0bvdoKLtmvvSkTyiFlBjpRYwu1cVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1FhxvKVDC36CbMILimzNvJRURM4Yic3NxObOQydV8kg&oe=6AE5F715"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=inS6uTWwHZwQ7kNvwHo8lGa&_nc_oc=AdoPA0BI9vvE3kTFtrhAwQJ8TfAfB_0xSeMfwuW0k5_GGAMbeXINGF4bH65waTVwmbw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBhfSR8YFc3F76z98QF---lcjQrSrcYy959vKsM1T4bA&oe=6AE5F2FE"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subs
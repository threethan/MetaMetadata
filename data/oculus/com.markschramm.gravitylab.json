3Hc6uQtLRbcQ7kNvwGePbhT&_nc_oc=AdrztnjGWLMH0CcR5BITbHRciZPBKL1hj_5BFdBPZ7hW7A-_mlaLZYwyvTD3zGC-9Mc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BKWheYiorCws2lYGIt0a3jqXpzOCeDAR-S-DHP-GqcQ&oe=6A428475"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLU6ueSnvdIQ7kNvwH6ZF6Z&_nc_oc=AdrGAOHyESSj1c6LuNiD6l8dIFaVtphuROowL7cQW92QbJzv2Hamze6RCh-40xz2GKw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PgLYPXXvV1y0kDS5DOi3OlxHDerAh2bfmsQxMbv5QTA&oe=6A42905F"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNZ3Qq1T81AQ7kNvwEnjDmK&_nc_oc=Adr1pNv-7YOdX7Spe3jyQtPCTLlh1-T_s4qIOHIpKQ4OeutaI4-eY8qBsiPDBaHJKeU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ImqEPub2kEhkHNSiaAPGxiAjnbdKRTlQfAoL3UieZFQ&oe=6A426922"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPV0ravScVcQ7kNvwE43b9f&_nc_oc=Adp7DQcZZKkY1arq8Q6-1kwi-P_x8IWbG-v5CImPx8Xpj3VZmI_Revfys-nPwCn1mVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OCpmlFsbazohKxrEGdJV2v45eF2oUyxdHPsvejl3OBQ&oe=6A427D15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XY-v437eWIQ7kNvwE9Q9pN&_nc_oc=AdocN4M7Nh84nzZe-i7q_PfqY2DvYd73Vp9JaUgKn0tD2OIfB5xDZN7_eYDXkbhgphU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kPWOAtcHYqoNlTG72UTJ6YwQZyq2GCJ6M8xve7N50WA&oe=6A4278FE"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subs
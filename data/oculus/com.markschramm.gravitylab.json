xiC_RdwYYnsQ7kNvwHnfAdT&_nc_oc=AdqvVRoeXARbJSBgtzBM2unP6VibrQYa1RhUBGGWLiE1w998GhXWylIzNe6zNVWNIzc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc7OdMF9FdeZB-ivSkaeaKQx8JFUiQdZYoffkNMtVLow&oe=6A4FB375"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYukcRuOkT0Q7kNvwFjexW_&_nc_oc=AdqdPVb7qiUrRW7-ubocjPeBa38Ket-9okYmTNfuMmAYMgjC4DIiS_BUpnW0JtZqGKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC83AujPKcyRSCtrclIBpk2S4GPTOzhE_UujpBU7ofxLg&oe=6A4FBF5F"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=97x32citaAAQ7kNvwFLuoA7&_nc_oc=AdoyzQFrEYaS4VFhT4AKc9EQaHHMVo8qpyRFkZ5goagyji_-9BXE2B3y_GCfLidRYCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC71BmTStExhqghRiPNb86lLlV5QI-ZWBzHheNV_zgtNA&oe=6A4F9822"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZxAdZpFXScQ7kNvwGNgD7v&_nc_oc=Ado8U-fzI-a0pMkE15QKvF_GBlB232UJjla5f2RM-H6Yx_Op3Bv6VjPJVhAF4OMfYio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsIpy2O0ZJ4RRkuncxEZr2AcndG86z5RZIhEKjfK1V6g&oe=6A4FAC15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2P7QDA_fzLkQ7kNvwF5eRii&_nc_oc=AdoLcX1P1CJKYNM3ckOIyNymwy1IZAMwakrC8UkEEjTWCm5DRpH8_POebDOaz85srCE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCePuSeDSlwBrA_VsGHMTuCiVNzpAyD_N9E9auLu52RSg&oe=6A4FA7FE"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subs
qe-h3yt1veUQ7kNvwF0JuKk&_nc_oc=AdoVuOxFLTFJTvp8P5kCZOTcOoiGWac367CLceSeCEG2lwhQrP7uOCrtCuD5Tm3rIlU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FDPTDGKkN8RxJw4JOafcA3wpyM39f5tckP1HXnOS5MA&oe=6A203D75"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXZHcSZIzWAQ7kNvwFtQQk3&_nc_oc=AdoNLJizQ7v7Y5FepZOKYd9mm19PJLAhdkyK3lnk8ZF8byyQGKg9QUuq-UunPFdtkV0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xYQJAMC1MFlZjfWVaf_AMdiSYQksxz2smgAg1OnSP1w&oe=6A20495F"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdwEa8c_SKMQ7kNvwFQEmuJ&_nc_oc=AdpzaUgzjOzB3w8eWyR2rKP8KW876DtqPYtizxSN52KauI3rMdr4muaNGamR9Jdm1t8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T8B0NyU1_YkI9mao8YGqPob65lgOfasIDfZizT6CIog&oe=6A202222"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOD48zkZSMAQ7kNvwGjlii6&_nc_oc=Adqf-bG5N_cdOaV7TjAin2JTl69An4ooINpen3dnXYQI9kkP7fEY8v2-UeXau6zoB74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5bfKsiQcQqAMMda8PyPLd7r_fR061D1JvcgnW4kV0IOw&oe=6A203615"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_onI-8C8LAQ7kNvwF5hK07&_nc_oc=AdoBVdXHZAB175ASkheXH1NV1O9MbRoE72fFCp-N6ExOARC-pCGINHKky2s3Dyfv6yQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yUrTv-b-9fF1gmxe6LyWc2qqdiMNoeJDjbmpYr_qXiQ&oe=6A2031FE"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subs
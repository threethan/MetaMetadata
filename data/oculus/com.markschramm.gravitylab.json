e7a0a&_nc_ohc=RUU5nnVDJKYQ7kNvwGvaNhX&_nc_oc=AdoG_WnyAHAW15SJrY0nTogOJQNbCFUEcIp_ekOiEMvL-R7td5yCZbhszTAuHpL7y8g&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPeS7SGHhZFuzFo_VzDi9ILyq4wTNY5W6V2F1XjvimfA&oe=6A8D71B5"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSZvQCubvQwQ7kNvwGI_qi-&_nc_oc=Adr5em3y-T2BQTsOiJep4i_Is19vqQ3tw2sXWZ9bGFWNPT_oCT6KCURRL0d0jyzXUsk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVzGpbvOHIIlSpDsWPbFbawy55uFsBdZywPI3zN7YY9w&oe=6A8D7D9F"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gEKUnojlKtoQ7kNvwFEsCgh&_nc_oc=AdrZx1V6tOR2rd4fYQuq6DivHy_8byaRI9Rp1YrIJL_hOGuIRC9tbtUchEzzl8dkbig&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGtxghqUThHY_pMJ1DEKrvmvXJDr1IvpMSgixXbDm4vRw&oe=6A8D8EA2"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnNrEnNOMrkQ7kNvwF6PXoY&_nc_oc=Adp2yyMNsbbZOA-43RQ1jEij0faMTVZNzyE7E_ws9AOU8IggWni1Mh3XY85gbei4OyI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEH9JHd03WtlH95pf3Q9xN5RssaQyk549Rvgt-AqBvvw&oe=6A8D6A55"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3Ahzds-iQgQ7kNvwGj9x7R&_nc_oc=Ado3NYgcmIxh2H0TnJIIm50sDaxz68nwXvjTvt0sIoN_7ujr_y3XF-vyFYWIKSYcRso&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVKVKbbKvCST-uoEgeBGrHv91v6AQHsBtuA7R_tNiAuA&oe=6A8D663E"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272
kCxgjjFO4BoQ7kNvwFHe-Ve&_nc_oc=AdqwgUqipIDKlRv75gC8WKiiJDMrpL133Eue4P6K_R19_CiMoKjqsVJnS1nSeUzVaJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVIv6trVE3bLMOdeYkkyAYpCUUtwuE-u5BuIggji4mcA&oe=6AA807F5"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7ebMOd_Oj4Q7kNvwHCkWOs&_nc_oc=AdpW3-6eg0fzmBuKgO23ZVA0p6LUeKUZVOKzZY8ivDNPexBMgOuLhmn6v5ux_c4HjPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJe2sLPoJk_zMir1qzPo2IP-QIZvTuu4-voYgn8ncOsWQ&oe=6AA813DF"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BT8RHhyNBFoQ7kNvwHkmf82&_nc_oc=AdquCh3J9l9lKeG4B9HL2yVz9VYJub6dCXSmQ53aM4z5X1ePWMZYTJG8k_6-IwdNSXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIl5tZDwU6scGXij-fyHRTE4s6_ilBRgqR0xjYvVsv1Wg&oe=6AA7ECA2"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2E0A8jnFEn4Q7kNvwEdiS2U&_nc_oc=AdqtygW2QRGNWmursaNFZ6HK9dAJTJpn5nnbXGWjMa3vrAi9eTjt0o_4O5B5-EFzUoM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJipTYFRon4CcqJ2BXJbybNIJt8HNI4LRmXMOSHlO2ilQ&oe=6AA80095"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZatatN1cdIQ7kNvwF8AAL5&_nc_oc=Ado5DfDwSunFanjHuU0xnjhPeZM0wjeI7UvQIPEwcPsZMIcf6yqa-eUSsx7LcH5zPqg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuJEPpWhPi-in2j5LoqcgE4f1-IAitV7YI3eEOWjmtMQ&oe=6AA7FC7E"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subs
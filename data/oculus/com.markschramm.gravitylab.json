&_nc_ohc=-hUhApRFO9YQ7kNvwEXtfT-&_nc_oc=AdpWqsu5zs6BlvaInYCS3bNSYsoqQeMPGEyCofUXL9HNWLgnM6FVjanUw39_J4hgLV0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2ufiPalRkDG8I8hA5fD1MkpAmQ4tzN7W4GVk1qXr7JQ&oe=6AA41375"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKucaUK-r_4Q7kNvwG7fEzQ&_nc_oc=AdojupuRUeNs66_iype0Ueqwu2kR86u8UvGHILslmWyPJNTetca76nIjSoIWCisapGs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDQfXizapRsrh7tzPXlg3fJvdOKd8tVXPFBMowA-ZMtQ&oe=6AA41F5F"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQ1byTpflHkQ7kNvwHo6VPc&_nc_oc=AdouOHSiph51cdGUegjECkJ3Hu5eyFHIaE717bytDnud5P9nsFCH6VrrVeoxLaoZpu4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvL3zlcCDQcZiJWsQEFDLlhihXrodvC7X8TaRGFo_7PA&oe=6AA3F822"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r67-vh6xNbMQ7kNvwFdPDhS&_nc_oc=AdoyvCjrRmY6WvQa7e4miY_lQwHOf1P7J3nSF9mLMY-RGKr-FnEFatRIFbvx6NbdC0Q&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJZHmQas9JYf6JW4amcFJnNBGYmZv6os0C9hSfKeidkw&oe=6AA40C15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YSo_gEaXySsQ7kNvwG-oBBv&_nc_oc=Adpz2wdS0dcLMoR4I21oNekjK4yERn1JluwnI3scAj9NK4hj5ovl4K-EI---rdjSO8s&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5fthwVVX4Jjixia0dL7xwUEMexzO7boerfJVdyMsF0Q&oe=6AA407FE"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"
&_nc_ohc=Ymhx_VTVi_8Q7kNvwGBDA2F&_nc_oc=Adpa16wP3AtilRSuHlb4UJdQauquKcGGQQ2RCyFLvl4Ojg3AC1Ticxucpusj0-_jspM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEl00F3DMmc25cR1a5_7g6ptTZB-zEietunVUUx9TqygQ&oe=6A7D9FB5"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4mgD4Ivax2YQ7kNvwGo9auM&_nc_oc=AdqGeTIMevXw4VUCozPHS8x_XLk-hOyoGYWK6fSdWoSDSDYvy30TA7vucs3wPk91fh4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEX6T2qsqaYH3QRonHCkMr9mSKUfnygQR3xWSHD2CbACw&oe=6A7DAB9F"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrm0nb-IJigQ7kNvwHZemvI&_nc_oc=Adqaw7dhGAZLwyt3MxL_r_yzhbbVgf1k6Tayjr4jA2k1Auafr7TPGF7ANa7_JBmLN7U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAw4_qcmHxoVJ81KaVQPKfIDP4wK-PrOf3f-9Jgv8DHA&oe=6A7DBCA2"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8fYtjHd3_4Q7kNvwGpvc_r&_nc_oc=AdrrquYeCvRVzFYPVWtpXiOQ4CJRu_CRKhkRsdFplVP7Gz1CEWLNpyI-QHgUK9BTl2w&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3Spon_1B8p-MZZdqCyRB8mrw8SH0JLr54XAk2UkF0Bw&oe=6A7D9855"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tjXDg2yO_0cQ7kNvwFdd8CP&_nc_oc=AdqYGGj1LCCixDAKNslyFWzveEaSyDWynFAy7bfMnSlBanNTNphNRo2LxynKjPxdWLQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1FC1XzW5l123tUuZ22x0t_47g4ciDwt3iLUeFfmpQBg&oe=6A7DCC7E"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"
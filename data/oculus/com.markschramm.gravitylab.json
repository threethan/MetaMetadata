&_nc_oc=Admv3xP4f90zRAN1SJl3bPL-o9f-HhgZd7hai-5gL2HC5qQYAm5RMEML6i0FXGMB-8I&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyV8SlEySHacPaKNAqlkfALtiqrgLo-IUdYVTm7LPgGyg&oe=69AAE7F5"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VQWONC895IQ7kNvwG42mdK&_nc_oc=AdlGojB4boitySwBIerba3bhGAi9gZXFZGIde039IqEVzaQcVshlQUdGmxCq_KuWFVo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyciurtTuvo43dhXD33V7q8ZYVz7meQRQkzHgSBDzjnSg&oe=69AABB9F"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PnVIGVfqD2MQ7kNvwGmWsGW&_nc_oc=AdlfY7VNtBqB29DN18W_XWw2crEUWT8FfREmt4epKErzowLJdKlhkwCMLLbfWhYHRVw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEEwE3B9KPJ62GwCu9aiAC_MrgYFPjjGyPoKk45f_wSw&oe=69AACCA2"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9d7qLJ-a-NMQ7kNvwHT-FxA&_nc_oc=AdmFPKsEQcjUX5uYNJ5miNeYlRk3lA7Z-SXPVODmDX7S0rKWtmHwPSXydSu-HbqbVQ8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfyMnI1A-SPxle3m9Y10bD-kIfYUHRz9K1BWYcS13SODAA&oe=69AAE095"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0Cph6vdQKAQ7kNvwGDks2b&_nc_oc=AdmXFZbFLjxk2T6SiTX16_FOtvXTYzTmEETUpmJBn0dTyc_UR_0h3BaUAMR7nv9OEVI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afzi5tPcn0-yQmfGm53PMLapHpmal6MNEtub7P69YyOsNg&oe=69AADC7E"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "g
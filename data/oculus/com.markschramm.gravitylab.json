7Cy2k6kfnB0Q7kNvwFJUnTE&_nc_oc=AdqqXaPvX0F55ulaIVWIjs4GFl23OWjvlawy0UMU05iKtnBOcTs6zSoj8z4JTrabkys&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-m09E3N0eK1VD59CrbOjqn3tGP2bYo0DVw4DGwjpxow&oe=6A1EEBF5"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXZHcSZIzWAQ7kNvwH3V16J&_nc_oc=Adph-hq2z7Nn7qsNCTYcyDFB6pN0pOdGqn6yl8vPW8yiVTkQwGClvSVMNEnjqvQsa1k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MBOtidapzF_E6ykuLhE3Mxd3oPP0Em2fevRxh5QvkSA&oe=6A1EF7DF"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UdwEa8c_SKMQ7kNvwFw6YY4&_nc_oc=Ado3qKnTToxK2laZW1Lsx4BupooyXUe9R2RRcJHLcbUAs5Fut0gcbYRSX5-Ud9i0htU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P7wLwxMPqCJiRcDJmM-gMUf1bBdEUyfBrMZjPy-Dzew&oe=6A1ED0A2"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAsJJbV6Kr0Q7kNvwFoT4L0&_nc_oc=AdrODX457n8jV43A01o6r3JOyGLrUb2k2Iwk7ADqI964xU5bt8UiwVs6zeb24ceEeGI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vEqD9xzTIsCjhImb8E_EEDYrvbMK01pIucvra8B1y1w&oe=6A1EE495"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_onI-8C8LAQ7kNvwHsyxuJ&_nc_oc=Adrsxc_TIFX7JVfhSgRJZL8xkalVjoUbvODF4BbL75MX4bY6utkTFnINMCltiWRQyIY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qqpkXZBnx4kVhZB4oagVD9drd-6e8oLm7XIOGdZKIVw&oe=6A1EE07E"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subs
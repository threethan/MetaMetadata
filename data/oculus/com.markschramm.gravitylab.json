sxWbN58ekl0Q7kNvwEEUdOb&_nc_oc=Adrwl2OLoQmqyHrG8athjTvdXyAnVgAIhN3QlK6JViMM-r7TOgKJ0skjR3qEZGfpchs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jUOrGQaiKjmNVAZSVkTE4PyCI2L7ucMykSd8kQb24jg&oe=6A47CA75"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SLr6jEl3zBkQ7kNvwEPIaBa&_nc_oc=AdqEzktV6rI_T1KxiAQ6US4CpVTY3z1Fzd7LmAJqaRQF6OI4Sm3L3UX65CkS9AMzF-g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8fnXn5PQfZiMra0a5a7-ocLOXQ-BjnIBGmJCFKkvXPYQ&oe=6A47D65F"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnd4s6xt-OIQ7kNvwFdz5bw&_nc_oc=AdomFDm-pFyQCd05pm8Iu78ulmB5mR0_GIZU-OwNk86fSOkfOF89-WTSW9PGVWj5F3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rq0YSTlCrFmGAkRgM1QB_HtBAa8mxDIf_fJWC53lkXA&oe=6A47AF22"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUYXLgMgNdQQ7kNvwH5WUYt&_nc_oc=AdrJDvEzdXmHYLf8icTeMqb2qggmOWCGtv-YI9cq2hXZhPq0Z-pUqKiAkzfyWhsPmyE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nDIVyYvJSGj5BkUvg5_N3pgpevRyQCzGyJsG-tmEDog&oe=6A47C315"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySPnuQEwqOwQ7kNvwGw8LIj&_nc_oc=AdpMujXJtnHoJHr3Qn5zqLEfzKZSxw3nu2hGSo01mzp0pBcMP-7N7dTpMZNmUUBEE0o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HHVjMcCU_uKB7UWWrHMG1nYiswUEwM9wIXPqB2vSk3g&oe=6A47BEFE"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subs
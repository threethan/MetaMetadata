z3gIIEEIwZ8Q7kNvwHvqWqD&_nc_oc=AdqllE8OYZYjsTu4HNUkGs-tEjIcY5x6XlZWQ9bVYZTYS6x_6BIAFyJSEEl_habNkFk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnKK-yFcHiRa8achGBUzk9y-tcAqXeXIdYc5Y3LFpRlA&oe=6AE8A175"}, {"file_name": "gravitylab_2020-07-13_19-41-07.png", "id": "947443449055009", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75507166_947443455721675_3670997747033868022_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxV6NHkesjkQ7kNvwFWFbml&_nc_oc=AdokMu9iJaCPE74GqDCaPFWKzGnd4sG3U2jSXuLoxwHKjvAj4kUzKVkDRVQRupjyhMk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRldlQ24jodT5v_k3bMJ5NolJC6RK70PIo-1TDezURFqw&oe=6AE8AD5F"}, {"file_name": "gravitylab_2020-07-13_19-43-30.png", "id": "1525023904349116", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031412_1525023907682449_3956088323742041291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vfugcO1le00Q7kNvwH-OuRQ&_nc_oc=AdrGC4YH3xHxxbNpOC9PXYnsDmSr6VKOYPFn1-Cq3hoXCIbIi2XPD7X0w_WBFbvSI4U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMj0VQR9H-XzPay5UkRLmxhpl_O3IeUyeR7Wrv-SYJPA&oe=6AE8BE62"}, {"file_name": "gravitylab_2020-07-13_19-45-35.png", "id": "657019898257062", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75404375_657019901590395_5785667685364776297_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSgb4orFsaAQ7kNvwEj1riv&_nc_oc=Adr8nmr0C8IEXTg5jltr0uewmT0nhfbgHzF9LGnwUVjGoTlzr0_MPXPp3ytTOYL12_Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVzniTEq-MiTH7ym77trBTSQksLWm4D_kTW1FdYjDjfg&oe=6AE89A15"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gravitylab_2020-07-13_19-40-18.png", "id": "2762335540653496", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031640_2762335543986829_5936103490408270971_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7qr39LmDVcQ7kNvwFADqrp&_nc_oc=AdpWPRVvYuBBLVVqDRf7ogfTwaXovd8FvzARPdyY6nlibAX0rOaoB7_7iQegxGsZRpo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfqxf1fThGQrkvBjQCzLTgJv57pNip2HKtUN6Lo5g84g&oe=6AE895FE"}, "display_name": "Gravity Lab", "keywords": ["physics", "puzzle", "lab", "machine", "gravity"], "long_description": "Gravity Lab is a physics and electronics puzzle game that will keep you busy figuring out solutions and exploring an abandoned moon base.\n\nNow includes the \"Microstar\", \"Time Travel\" and \"Passthrough\" content updates.\n\n\"I have lost hours to Gravity Lab. The VR immersion is almost secondary to the mental immersion in eking out the best solutions to the problems\" - Road To VR\n\nFeatures:\n- 55 mind bending puzzles, with 3 variations each\n- Integrated level editor and workshop for community created levels\n- Multiple locomotion and comfort options including teleport, joystick locomotion and miniature mode for seated play\n- Cloud Sync and Leaderboards\n- Passthrough Mode\n\nPlease be aware that strong gravitational forces can cause a looming feeling of being observed! Never look directly at the emitted particles! All damages to the time and space continuum and all involved repair costs will be passed on to you!\n\n-- Gravity Lab Management", "short_description": "Build your incredible machine and solve physics puzzles with gravity bending appliances! Gravity Lab's new lunar testing facility welcomes you to try out our standardized testing scenarios - now designed for humans!"}]}, "developer_name": "Mark Schramm", "developer_privacy_policy_url": "http://gravitationaltestingfacilityandobservations.com/privacy.html", "developer_terms_of_service_url": "http://mark-schramm.com/tos.html", "publisher_name": "Mark Schramm", "support_website_url": null, "website_url": "http://gravitationaltestingfacilityandobservations.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subs
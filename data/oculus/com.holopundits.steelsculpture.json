display_name": " Steel Sculpture", "keywords": [], "long_description": "Experts designed the steel structure simulation to provide students, teachers, and future engineers with a realistic and interactive experience without leaving the classroom or lab. This virtual learning tool offers a convenient and cost-effective way to learn about steel connections eliminating the need to build physical steel sculptures, which can cost tens of thousands of dollars. This simulation highlights the structure\u2019s size, scale and perspective and is designed to rotate 360 degrees for maximum flexibility. The 48 types of interactive connections are broken into four connection types, including; Shear, Axial, Moment and Steel joist allowing the user to explore each type at their own pace. \n\nBenefits include: \n\u2022 Realistic 3D models \n\u2022 Researched and designed by engineering subject matter experts \n\u2022 Exploration of detailed steel connection types in a virtual \u201canytime\u201d environment ", "short_description": "Experts designed the steel structure simulation to provide students, teachers, and future engineers with a realistic and interactive experience without leaving the classroom or lab. This virtual learning tool offers a convenient and cost-effective way to learn about steel connections eliminating the need to build physical steel sculptures, which can cost tens of thousands of dollars. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.holopundits.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Holo Pundits", "support_website_url": null, "website_url": "https://www.holopundits.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection
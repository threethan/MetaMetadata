-M&_nc_oc=AdobCEFSco-KR_o5U1Nhtkbb2l_nwdKFbBED_8wEdszgj_kzDCyM1HRqxynUulODIyw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpaOASk0X2XiGPWLMMYVs2WDSoqtPcuLNaErODPgmcEA&oe=6AB93BB2"}, {"file_name": "\u622a\u56fe021.png", "id": "1677511719982777", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623443_1677511723316110_3444251227428112985_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T3HZcL5jkSAQ7kNvwGvvgSc&_nc_oc=Ado8yCBX1aj1ycOXoazhnDL9ZKe5n_PRrxqFTTsFcutuhW2NgzemVI6-oscr5fHQVFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLoUddNKiaCc9c3oU1Fia9aw5Hb2gjfW4Pc-tAaMuaZg&oe=6AB9194C"}, {"file_name": "\u622a\u56fe020.png", "id": "1342665101410900", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499620817_1342665104744233_7087761956111947440_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6IsbK0dHfzUQ7kNvwFsW4zS&_nc_oc=AdpVMlu-h5x2dHHSEAx7zKJnUuID7fDnJ2LMqqFhCpKKalYSBA0Z_NcDnFDH3DVDNc4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaoay2u4sxf48uTKpu5ftyUECd3d5OdGTMKb06GU7PCg&oe=6AB91202"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560.png", "id": "2357836991290185", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624851_2357836994623518_1567062127166219891_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHTZhqo7nlcQ7kNvwGgTsj1&_nc_oc=Adrf4MR2KqdAhrqBzlyhxbsck_l_xhvIrzHtAym4UZM2lSyCxre2hGEwdMLqIBNGgB0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJYpDpqefLPsLzglTC-vUDEiBm1PCFoXghO2UpfYAREg&oe=6AB91E9F"}, "display_name": "Slash Rivals", "keywords": ["animal", "battle", "wizard", "multiplayer", "fight"], "long_description": "Fight with various weapon and transform with super power. Have wonderful combat experience and grow amazing skills along with friends! Collect more gems, get transformation  and become stronger! \n\n\u2694\ufe0f\n**Join here\u2192 https://discord.gg/slashrivals**{1425521196171360}\n\n**\ud83e\uddbe Unleash Ultimate Transformations**\n\nFill your combat aura, then use your Ult to trigger a devastating super move. But that\u2019s not all \u2014 find forbidden altars across the map to unlock Transformations. \ud83c\udfc6\n\n\n**\ud83c\udfaf \u2694\ufe0f Forge Unique Combat Builds**\n\nMix and match weapons, but the real power lies in your Gloves. Socket rare Gems into them to unlock dozens of Perks \u2014 from life\u2011stealing slashes to shockwave stomps. Every Slasher plays differently. Collect Stash (the hard\u2011earned currency of the realm) to trade for new gloves and gem blueprints. Your build, your signature.\ud83c\udff9\n{897961579675486}\n\n\n\n**\ud83c\udf89 \ud83d\udc09 Colossal Boss Fights**\n\nStumble upon towering zone bosses that roam free \u2014 each with unique phases, weak spots, and personality. These aren\u2019t waiting in an instance. \ud83c\udf99\ufe0f\n\n**\u2728 FEATURES:**\n- \u2694\ufe0f melee & ranged weapons to master\n- \ud83d\udc65 Open gate challenge (private or public lobbies)\n- \ud83d\udc09 Transformations with  ultimate skill\n- \ud83d\udecb\ufe0f Social hubs to upgrade, chill, and show off\n\n\n\n\n\n\n\n\n\n\n{2007934199910133}\n", "short_description": "Forge powerful weapons, collect gems, and build your own combat style. Discover new transformations, unleash devastating ultimate powers, and take on thrilling fights with friends and rivals.\nEnter a wild monster world and battle alongside your friends in Slash Rivals!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsuplife.com/privacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Suplife Games", "support_website_url": null, "website_url": "https://linktr.ee/suplife_vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "821934236779161"}, {"id": "459781504968480"}, {"id
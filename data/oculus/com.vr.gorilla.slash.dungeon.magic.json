id=6e7a0a&_nc_ohc=YzduLJ2FxKkQ7kNvwE11ROd&_nc_oc=AdqV1Kek8iHyZFPmuyBUqpcj9vA-_hCevQDDmA4Sooix5LVoj4_m18RnylldwLRbWbI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKMT8EHprGYUdKRHg_f4gamJDwjZ-cxGES-rRQ6rZ6xw&oe=6AA17EAD"}]}, "id": "1734010207307511", "locale": "en_US", "screenshots": [{"file_name": "\u622a\u56fe05.png", "id": "1270995491162107", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618064_1270995494495440_1768825105649008252_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2t9f7aiBVzIQ7kNvwFBQgeY&_nc_oc=AdpJ2cNaM1ttIAe6j9MZUnnA-ZapIY3ChyJ8W9948op1mhLVBHFPHWkZAkQuVpVYAGU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyx8IKH4gvRH-5lpFXwuwWPwY_CI-7nUCJVeonRUHiqw&oe=6AA16329"}, {"file_name": "\u622a\u56fe03.png", "id": "778164065158082", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491825041_778164068491415_214016939545122023_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yBK2gE3e_k0Q7kNvwFmwEkf&_nc_oc=AdqZ-2SRhl2WZiA4lMSf5yMNSSpw9HJ8StwP5HqbkYBEudVzht8rq29XrLGnP0YwXCA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7dW7x7rg9RdJZob0Ow3tstWGSFgzjmEdFTyEMbgURhA&oe=6AA1545B"}, {"file_name": "\u622a\u56fe01.png", "id": "786264664283965", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618297_786264667617298_1927889817631548517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ey_x7hcJtl8Q7kNvwE3evYa&_nc_oc=AdrX5SSKXEPRhGzmDMSVcGwoRytAFcXXXdwtt5Q8QWgJNQRepMoTlaqxLRCbcg3WOZU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKA462nK-BlmYuzsZlTU2R5DjrLP0UefUc3hvLiGujbmQ&oe=6AA149E5"}, {"file_name": "\u622a\u56fe04.png", "id": "1469505248539552", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617850_1469505251872885_5472385591779009051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4u6_Hd2X2yIQ7kNvwFyKr0A&_nc_oc=Adq4TA7_hZO1RnzZi1gKeidQJ0bKDTyLWfggAqfhiZ64nbpZ67oihnRT4tTRBUAzHL8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBJMcJZuftnUJqPlQbB6OkPM3WufAUeNQleLLe1Ur6hQ&oe=6AA14EA4"}, {"file_name": "\u622a\u56fe02.png", "id": "2156343768450614", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619113_2156343771783947_6258111655263061428_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xBF92ftGb0AQ7kNvwG89Ftg&_nc_oc=Ado8kLM8--JyQl0Yeqo013vgw8aoaJpTBGR547TuPP4zGO4fHIhyzTiRczsdQ65RbMA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJdHwMIPebWXVqCdwmizmQ5aAm5jVrnetMNopnIxUAmw&oe=6AA1631C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slashmob", "keywords": ["animal", "battle", "wizard", "multiplayer", "fight"], "long_description": "**Slashmob** takes exquisite Pixel aesthetics and transforms them into an open-world, physics-based VR combat experience. Whether you're a melee grinder or a precision ranger, the dungeon is your stage to flex. \u2694\ufe0f  \n\nJOIN DISCORD to get early test \u2192 https://discord.gg/U9KVV7Pv9Q\n\n**\ud83c\udfaf MASTER MULTI-STYLE COMBAT**\n\nWhy pick one when you can master all? Switch seamlessly between heavy broadswords, rapid twin-daggers, and magical long-range bows. Each weapon has unique weight and feedback\u2014every strike builds your combat aura. Parry massive boss swings or land perfect headshots. The skill ceiling? Sky-high. \ud83c\udff9\n\n**\ud83d\udc51 EPIC BOSS CHALLENGES**\n\nThese aren't your average mobs. Face colossal zone bosses with complex behaviors and multi-stage battles. Cook up the perfect strategy with your squad to survive. Defeating these legends isn't just about loot\u2014it's about gaining massive aura points on the global rankings. \ud83c\udfc6\n\n**\ud83c\udf89 THE ULTIMATE SOCIAL PARTY**\n\nThe dungeon is just the start. Between runs, hang out in vibrant social hubs. Trade loot, flex your rarest gear (ultimate drip \ud83d\udca7), and find your next squad for hardcore runs. With intuitive hand-tracking and immersive voice chat, every interaction feels real. \ud83c\udf99\ufe0f\n\n**\u2728 FEATURES:**\n- \u2694\ufe0f melee & ranged weapons to master\n- \ud83d\udc65 4-player co-op (private or public lobbies)\n- \ud83d\udc09 Boss-centric gameplay with legendary loot\n- \ud83d\udecb\ufe0f Social hubs to upgrade, chill, and show off", "short_description": "Get your mob together and slay! Slashmob is the ultimate multiplayer pixel-art dungeon crawler where your aura is everything. Master an insane arsenal of melee and ranged weapons to cook the most lethal bosses in VR. Explore exquisite retro realms, loot legendary drip, and show off your sigma skills in the most lit social hub. No cap\u2014this is the physics-based dungeon run you\u2019ve been waiting for. Stop being an NPC, join the horde, and prove who really ate the floor. Let's go!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsuplife.com/privacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Suplife Games", "support_website_url": null, "website_url": "https://linktr.ee/suplife_vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "25799448986312247"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1762145394820027"}]}, "baselin
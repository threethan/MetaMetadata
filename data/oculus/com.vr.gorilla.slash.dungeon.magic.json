s://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819281_874291935647454_2388817399688494444_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNj95T2DiF0Q7kNvwHghMkf&_nc_oc=AdoJCEd_rPzEuuxvDtOOYhffG3WsWiQinKPIRnaqK9uBc5EjDQNjvsM3ccqH9beZTk0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpAsSUvACQlosxJ3ZFm_v-S1HuHnHsKNiprKHxdnPnPg&oe=6ABA8B2D"}]}, "id": "1734010207307511", "locale": "en_US", "screenshots": [{"file_name": "\u622a\u56fe05.png", "id": "1270995491162107", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618064_1270995494495440_1768825105649008252_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNCVyD9i92YQ7kNvwHCpbI7&_nc_oc=Ado5xw_rCHGd0sqeFd-d6l8UbcUl8uspL1chVuWT9E5KSUrlSHE4na5SSJyGZNKds_E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQZsd3EIyAd0qfXrcNngYUELXrhXZHzHCX5e9dr9EIIA&oe=6ABA6FA9"}, {"file_name": "\u622a\u56fe03.png", "id": "778164065158082", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825041_778164068491415_214016939545122023_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTCAJkvhDWIQ7kNvwFiay41&_nc_oc=Adp8jgEhFOVDtisBCY3WZa12AouqTWh7FS-tp4o348gBmjbJnF7tu2y5ZwoOJibNkts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5cQQi80q3nzDcVIHBJ5kn1xR_cwVcG7v9F7y23Fozag&oe=6ABA60DB"}, {"file_name": "\u622a\u56fe01.png", "id": "786264664283965", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618297_786264667617298_1927889817631548517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKs_16RLAIgQ7kNvwH9Edb1&_nc_oc=AdrRVZWvw9kcxhiTZo-kCKmRzFBeUNVbyGg1_SigTIKc9gd7coUaSqmu72rLvn0UQ24&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-iL3JqfbLLVggvVwVKvP7tYcUXqF2IoEhi9K-6zVn6w&oe=6ABA8EA5"}, {"file_name": "\u622a\u56fe04.png", "id": "1469505248539552", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617850_1469505251872885_5472385591779009051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yZAw2bw0RJ8Q7kNvwH5I6WJ&_nc_oc=Adr-9C_-SJcK7b3ikYenXN6YEKyMOAwbQ_8Rqn01EmgW4kJyvIDfa_ZF3iunW6Jiw-0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbImWtNX5dPDhab724klxhvT50ZTw_kUFmZrH76ZgOfw&oe=6ABA5B24"}, {"file_name": "\u622a\u56fe02.png", "id": "2156343768450614", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619113_2156343771783947_6258111655263061428_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjLjAcCLmlwQ7kNvwGA90qL&_nc_oc=AdryLY1BVkN_6RhM5ihIBL1I22eUp4wrPdIfXNm8IF1YnnZ6Yf1GIBV8jDlQ7gkbW78&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIiJcXSkZdstsQDu63r0jS4YN7Im-GBvh0x8J-lBJesA&oe=6ABA6F9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slashmob", "keywords": ["animal", "battle", "wizard", "multiplayer", "fight"], "long_description": "**Slashmob** takes exquisite Pixel aesthetics and transforms them into an open-world, physics-based VR combat experience. Whether you're a melee grinder or a precision ranger, the dungeon is your stage to flex. \u2694\ufe0f  \n\nJOIN DISCORD to get early test \u2192 https://discord.gg/U9KVV7Pv9Q\n\n**\ud83c\udfaf MASTER MULTI-STYLE COMBAT**\n\nWhy pick one when you can master all? Switch seamlessly between heavy broadswords, rapid twin-daggers, and magical long-range bows. Each weapon has unique weight and feedback\u2014every strike builds your combat aura. Parry massive boss swings or land perfect headshots. The skill ceiling? Sky-high. \ud83c\udff9\n\n**\ud83d\udc51 EPIC BOSS CHALLENGES**\n\nThese aren't your average mobs. Face colossal zone bosses with complex behaviors and multi-stage battles. Cook up the perfect strategy with your squad to survive. Defeating these legends isn't just about loot\u2014it's about gaining massive aura points on the global rankings. \ud83c\udfc6\n\n**\ud83c\udf89 THE ULTIMATE SOCIAL PARTY**\n\nThe dungeon is just the start. Between runs, hang out in vibrant social hubs. Trade loot, flex your rarest gear (ultimate drip \ud83d\udca7), and find your next squad for hardcore runs. With intuitive hand-tracking and immersive voice chat, every interaction feels real. \ud83c\udf99\ufe0f\n\n**\u2728 FEATURES:**\n- \u2694\ufe0f melee & ranged weapons to master\n- \ud83d\udc65 4-player co-op (private or public lobbies)\n- \ud83d\udc09 Boss-centric gameplay with legendary loot\n- \ud83d\udecb\ufe0f Social hubs to upgrade, chill, and show off", "short_description": "Get your mob together and slay! Slashmob is the ultimate multiplayer pixel-art dungeon crawler where your aura is everything. Master an insane arsenal of melee and ranged weapons to cook the most lethal bosses in VR. Explore exquisite retro realms, loot legendary drip, and show off your sigma skills in the most lit social hub. No cap\u2014this is the physics-based dungeon run you\u2019ve been waiting for. Stop being an NPC, join the horde, and prove who really ate the floor. Let's go!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsuplife.com/privacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Suplife Games", "support_website_url": null, "website_url": "https://linktr.ee/suplife_vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "25799448986312247"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1762145394820027"}]}, "baseline_offer": {"id": "1762145394820027"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786035600, "status": "PUBLISHED", "id": "1762145394820027"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29513484534908655", "version": "1.25.02"}, "id": "787684820694244", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25799448959645583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29513484534908655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "787684820694244"}]}, "change_log": null, "created_date": 1789648383, "id": "29513484534908655", "version": "1.25.02", "version_code": 12502, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25799448959645583", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29513484534908655"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1789636946, "id": "29511487818441660", "version": "1.25.01", "version_code": 12501, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "
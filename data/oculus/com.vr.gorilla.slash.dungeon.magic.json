id=6e7a0a&_nc_ohc=LwMRheZtzogQ7kNvwF0UGDR&_nc_oc=AdqTWGufWhz1-AGF0zaBpDuYIzSOQ3EonUeGiJUuGezjEgsO4IArHE-XjocBTcYUoxk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMaZDJXhexbDWv3UD3leC6jpxpJKSBUA7IrrkCSZJCNQ&oe=6AA967AD"}]}, "id": "1734010207307511", "locale": "en_US", "screenshots": [{"file_name": "\u622a\u56fe05.png", "id": "1270995491162107", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499618064_1270995494495440_1768825105649008252_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4TVRPeHl_iIQ7kNvwFQX5ZO&_nc_oc=Ado3rRM2rRkcmUMUrJjLjVlYB8LGJ8ZO7Byrf3VVNtG5VtbZZFNR8hHl6Hk-2T-tdcU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvb_UYTUyb0XkTiBVQwH7qeBU-iuttvDaDQpbiZyUuOA&oe=6AA94C29"}, {"file_name": "\u622a\u56fe03.png", "id": "778164065158082", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491825041_778164068491415_214016939545122023_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFBnM1DjDWUQ7kNvwGiD5ya&_nc_oc=AdoJNrw2WndEsZ0Wp-rUcVpG8G50dftqT_9cqWwCIooIGmXKiWt88EW_pmjh_-1oNfM&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfDfNoZd90sFrvjTiLI1godnM4gXn3RBswIrftE1PHRg&oe=6AA93D5B"}, {"file_name": "\u622a\u56fe01.png", "id": "786264664283965", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499618297_786264667617298_1927889817631548517_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s8-9Nvbq86EQ7kNvwEKljuO&_nc_oc=AdoYoAcdfPjWlsjQp63DtZRv2Hc_v5pZxs5mAbDfttICwdsQxrLVtCOXlL0mNShiJMI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ61RaKAmpMUvfMhrTVCj1TBEOcvmJS0VYzaexiAYafvg&oe=6AA932E5"}, {"file_name": "\u622a\u56fe04.png", "id": "1469505248539552", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617850_1469505251872885_5472385591779009051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TB70ocYMLD0Q7kNvwG_8kW1&_nc_oc=AdoHBpYCbpLZQ5c3MRlRM8KO_e1khs6aHvEcNQTHFEP-z6t2Wgv1UBGAQxHHRCXBXig&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJF-iqDYCuSgdOzdq7RhDBb1zlWSfjBCx6vYd5veHdyJQ&oe=6AA937A4"}, {"file_name": "\u622a\u56fe02.png", "id": "2156343768450614", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619113_2156343771783947_6258111655263061428_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faYZvsdOVcMQ7kNvwFFY6m7&_nc_oc=AdrUV4iSsu80CVs6WGd20UhPpi5ECzfRNQ7OVhh524_do7irJPeQgSdxEDiEHJI4SSY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZkerlrJbGiLbLP5g3ZjeDEmyjeaEqQe7kWoeiU9rleQ&oe=6AA94C1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slashmob", "keywords": ["animal", "battle", "wizard", "multiplayer", "fight"], "long_description": "**Slashmob** takes exquisite Pixel aesthetics and transforms them into an open-world, physics-based VR combat experience. Whether you're a melee grinder or a precision ranger, the dungeon is your stage to flex. \u2694\ufe0f  \n\nJOIN DISCORD to get early test \u2192 https://discord.gg/U9KVV7Pv9Q\n\n**\ud83c\udfaf MASTER MULTI-STYLE COMBAT**\n\nWhy pick one when you can master all? Switch seamlessly between heavy broadswords, rapid twin-daggers, and magical long-range bows. Each weapon has unique weight and feedback\u2014every strike builds your combat aura. Parry massive boss swings or land perfect headshots. The skill ceiling? Sky-high. \ud83c\udff9\n\n**\ud83d\udc51 EPIC BOSS CHALLENGES**\n\nThese aren't your average mobs. Face colossal zone bosses with complex behaviors and multi-stage battles. Cook up the perfect strategy with your squad to survive. Defeating these legends isn't just about loot\u2014it's about gaining massive aura points on the global rankings. \ud83c\udfc6\n\n**\ud83c\udf89 THE ULTIMATE SOCIAL PARTY**\n\nThe dungeon is just the start. Between runs, hang out in vibrant social hubs. Trade loot, flex your rarest gear (ultimate drip \ud83d\udca7), and find your next squad for hardcore runs. With intuitive hand-tracking and immersive voice chat, every interaction feels real. \ud83c\udf99\ufe0f\n\n**\u2728 FEATURES:**\n- \u2694\ufe0f melee & ranged weapons to master\n- \ud83d\udc65 4-player co-op (private or public lobbies)\n- \ud83d\udc09 Boss-centric gameplay with legendary loot\n- \ud83d\udecb\ufe0f Social hubs to upgrade, chill, and show off", "short_description": "Get your mob together and slay! Slashmob is the ultimate multiplayer pixel-art dungeon crawler where your aura is everything. Master an insane arsenal of melee and ranged weapons to cook the most lethal bosses in VR. Explore exquisite retro realms, loot legendary drip, and show off your sigma skills in the most lit social hub. No cap\u2014this is the physics-based dungeon run you\u2019ve been waiting for. Stop being an NPC, join the horde, and prove who really ate the floor. Let's go!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsuplife.com/privacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Suplife Games", "support_website_url": null, "website_url": "https://linktr.ee/suplife_vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["CO_OP", "MULTI_USER", "SINGLE_USER", "MULTI_USER"], "id": "25799448986312247"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1762145394820027"}]}, "baselin
7qG8a-SU7Uw&oe=6A81A5E5"}, {"file_name": "\u622a\u56fe04.png", "id": "1469505248539552", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499617850_1469505251872885_5472385591779009051_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k8fSpT8hTTsQ7kNvwGaMjG7&_nc_oc=AdpoSY4RX4T-2MkWp1DRWnV-x8MeP4gY6l4Zsl9FS6IeTEZ9xCS0GcWZZB6hbOQfQq4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiTXe5vjpVt7mS94taOz4g-G2yWtSM7BCY5G34sOqJSQ&oe=6A81AAA4"}, {"file_name": "\u622a\u56fe02.png", "id": "2156343768450614", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499619113_2156343771783947_6258111655263061428_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGZ6mbH6jQ4Q7kNvwFZRxia&_nc_oc=AdpoS5zzaN1mdtzaPHf5mkKNdcvUNoDf9ZeuxSkVGmdn0BAKhb2Y3yS0QZPZyufLOGM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxr12B7jGMEUYPzcjalh9YYISpnKoiBIoGcNJlqXSBpA&oe=6A81BF1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Slashmob", "keywords": ["animal", "battle", "wizard", "multiplayer", "fight"], "long_description": "**Slashmob** takes exquisite Pixel aesthetics and transforms them into an open-world, physics-based VR combat experience. Whether you're a melee grinder or a precision ranger, the dungeon is your stage to flex. \u2694\ufe0f  \n\nJOIN DISCORD to get early test \u2192 https://discord.gg/U9KVV7Pv9Q\n\n**\ud83c\udfaf MASTER MULTI-STYLE COMBAT**\n\nWhy pick one when you can master all? Switch seamlessly between heavy broadswords, rapid twin-daggers, and magical long-range bows. Each weapon has unique weight and feedback\u2014every strike builds your combat aura. Parry massive boss swings or land perfect headshots. The skill ceiling? Sky-high. \ud83c\udff9\n\n**\ud83d\udc51 EPIC BOSS CHALLENGES**\n\nThese aren't your average mobs. Face colossal zone bosses with complex behaviors and multi-stage battles. Cook up the perfect strategy with your squad to survive. Defeating these legends isn't just about loot\u2014it's about gaining massive aura points on the global rankings. \ud83c\udfc6\n\n**\ud83c\udf89 THE ULTIMATE SOCIAL PARTY**\n\nThe dungeon is just the start. Between runs, hang out in vibrant social hubs. Trade loot, flex your rarest gear (ultimate drip \ud83d\udca7), and find your next squad for hardcore runs. With intuitive hand-tracking and immersive voice chat, every interaction feels real. \ud83c\udf99\ufe0f\n\n**\u2728 FEATURES:**\n- \u2694\ufe0f melee & ranged weapons to master\n- \ud83d\udc65 4-player co-op (private or public lobbies)\n- \ud83d\udc09 Boss-centric gameplay with legendary loot\n- \ud83d\udecb\ufe0f Social hubs to upgrade, chill, and show off", "short_description": "Get your mob together and slay! Slashmob is the ultimate multiplayer pixel-art dungeon crawler where your aura is everything. Master an insane arsenal of melee and ranged weapons to cook the most lethal bosses in VR. Explore exquisite retro realms, loot legendary drip, and show off your sigma skills in the most lit social hub. No cap\u2014this is the physics-based dungeon run you\u2019ve been waiting for. Stop being an NPC, join the horde, and prove who really ate the floor. Let's go!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrsuplife.com/privacyPolicy/", "developer_terms_of_service_url": null, "publisher_name": "Suplife Games", "support_website_url": null, "website_url": "https://linktr.ee/suplife_vr", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "s
ueled simulator where you play as an invader, ripping open giant holes to swallow the entire city and reveling in the chaotic reactions of its inhabitants.\nDefiant cops? Annoying streamers? Even heroes trying to save the day? Throw anyone who gets on your nerves straight into the pit! No matter who they are, the only thing echoing from the depths will be their screams!"}]}, "developer_name": "Bomber Entertainment", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": "https://mydearestvr.com/en/blackholemaster/legal/terms_of_service.html", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2437792913298534"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622195_1059242413584451_6790566420473246333_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzH_lTKm-5kQ7kNvwFL6lkB&_nc_oc=AdpGQPFIY1r9CLqArcS0Sp0da--OwxmBCxPZePNGeiYIlgJpWZdCQjSja5uzAnepSQA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW64I9AGfFsaoHZmg03PAHARdhpVy1Ebf27r3Qly8dZ_Q&oe=6B1036F5"}, "is_concept": false, "is_test": false, "is_trial_offer
1-25/499624983_1394040585940141_4838719256750240956_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw6mgsZ1ttEQ7kNvwGe2NnB&_nc_oc=Adp-svS-tkXm9eHla8PJOQOGVggLFqkTmx06iH5CFmQvw7a7FM-uovZpgB9FWVMfUaU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ3b_ol8Ec6TKnfMcLy1_Upq3ATK_Xc-PB16QkUYdUEQ&oe=6B09C238"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape.png", "id": "1373376777629982", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499623131_1373376780963315_3427909163998431578_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6VB_GH0pa8Q7kNvwFc774L&_nc_oc=AdqC5srX8ZKEWNqJOdcO4Kh4NJbcf94ip1qvR2dJA3awnPMYZK8-7HCaZHVcQ41PvCE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJUNXOfDTa6-ZXuQjT7mjw0ln_n5RQpZUNzMdRq--zzg&oe=6B09B3DD"}, "display_name": "BLACK HOLE MASTER", "keywords": ["Bomber", "Hole", "Black", "physics", "simulator"], "long_description": "# [DEVOUR THE WHOLE CITY WITH MASSIVE HOLES]\nBLACK HOLE MASTER is a physics-fueled simulator where you play as an invader, ripping open giant holes to swallow the entire city and reveling in the chaotic reactions of its inhabitants.\n{1061858719554679}\nDefiant cops? Annoying streamers? Even heroes trying to save the day? Throw anyone who gets on your nerves straight into the pit! No matter who they are, the only thing echoing from the depths will be their screams!\n\n\n# [EAT & GROW]\nThe more you swallow, the bigger you get! Evolve from a tiny pothole into a city-eating void.\n{2440356506455942}\n\n#  [CHOOSE YOUR CLASS]\nCarve, cast, or snipe your holes! Play the way you want and master your own style.\n{1035497936141308}\n\n# [JOIN OUR DISCORD]\nHop into our official Discord server to get the latest news and hang out with fellow invaders!\n\nhttps://mydearest.net/Meta-BomberDiscord", "short_description": "[DEVOUR THE WHOLE CITY WITH MASSIVE HOLES]\n\nBLACK HOLE MASTER is a physics-fueled simulator where you play as an invader, ripping open giant holes to swallow the entire city and reveling in the chaotic reactions of its inhabitants.\nDefiant cops? Annoying streamers? Even heroes trying to save the day? Throw anyone who gets on your nerves straight into the pit! No matter who they are, the only thing echoing from the depths will be their screams!"}]}, "developer_name": "Bomber Entertainment", "developer_privacy_policy_url": "https://mydearestvr.com/en/privacypolicy/", "developer_terms_of_service_url": "https://mydearestvr.com/en/blackholemaster/legal/terms_of_service.html", "publisher_name": "MyDearest Inc.", "support_website_url": null, "website_url": "https://mydearestvr.com/en/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2437792913298534"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622195_1059242413584451_6790566420473246333_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=198ZMaRu-JMQ7kNvwGBcPAj&_nc_oc=AdqMaYsmMfBJaQcdOhUKkw2goP2gOe3gZJBBBv8hsCeFcn4taCsqWqBxWF7ALyL_gXI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCa7N-8o4yx6Jx_twhVzy_5ui-z1YuDiFawFBs6K9-AQ&oe=6B099F75"}, "is_concept": false, "is_test": false, "is_trial_offer
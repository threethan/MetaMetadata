.oculuscdn.com/v/t64.5771-25/38974576_2272242042998486_2531231390985355264_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CnTM20E73dQQ7kNvwHW_CZR&_nc_oc=AdobtpqZhLcS2umTrg5mKW7XA5crBs_7vg50B7r3RmjmKlVSrzqZNyjED-l3yQ18t2w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aTVlMj3-TrjKcOowQ7J_4wvWLVjwzhnxmQtWP75xShw&oe=6A2574F3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/jJY2tS", "id": "333391637274265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_333391640607598_64213347372892160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QA3miulRIhoQ7kNvwG38Ibm&_nc_oc=AdpFuQzhXAMou8IijUZOhN3wIp7Jx1BTRahxtSumFd2Y9IHpSOG9Hvmq5nx_2CnJdeo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lFMLUT5pr7YUbuijOgqFBZUlQeawfL6X04mCSk9Xx6w&oe=6A259AEB"}, "display_name": "Board and Ball demo", "keywords": ["Maze", "Trap", "Arcade", "Physics", "Casual"], "long_description": "This is a puzzle in which you overcome obstacles using the force of gravity. You need to control the playing field by joystick and to move forward the ball to the goal. The game does not look complicated at the first sight, but to pass it throught, you need to use the strategic thinking and your agility! Features: \n- unique physics \n- 4 types of traps \n- 40 challenging levels (5 in demo) \n- 4 different locations (1 in demo)", "short_description": "Its physically based game. You have to fight with the forces of gravity and overcome the traps."}]}, "developer_name": "RaptorsGames", "developer_privacy_policy_url": "http://raptorsgames.com/privacypolicy.html", "developer_terms_of_service_url": "http://raptorsgames.com/privacypolicy.html", "publisher_name": "RaptorsGames", "support_website_url": "http://raptorsgames.com/", "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQ
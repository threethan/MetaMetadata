.oculuscdn.com/v/t64.5771-25/38974576_2272242042998486_2531231390985355264_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZhoos_SQHsQ7kNvwFGjcjs&_nc_oc=Ado8YJMPV9cLm-EHzxIVELlmHjYwy9u-Gcx2Fjw2u5Q4HmVlq3VjR2t7h1NIcrnZ-jQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nVsqbPb6R1NBeQ7lqgS43MeJ_MudQiZ9ePSSf8BV8_w&oe=69D65AF3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/jJY2tS", "id": "333391637274265", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974827_333391640607598_64213347372892160_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiUAaitzU0IQ7kNvwH16CkU&_nc_oc=Adr0Ij9yuw6sn1OL-OoBUdtf7V0FqZqACbzEl0lBNKFSqzxOQ7u2ahMlm8FXjd5nkC4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1bBM39HIh2RyUpubCWH7-Gy9b6fq4xgp8X5C56F640Ow&oe=69D648AB"}, "display_name": "Board and Ball demo", "keywords": ["Maze", "Trap", "Arcade", "Physics", "Casual"], "long_description": "This is a puzzle in which you overcome obstacles using the force of gravity. You need to control the playing field by joystick and to move forward the ball to the goal. The game does not look complicated at the first sight, but to pass it throught, you need to use the strategic thinking and your agility! Features: \n- unique physics \n- 4 types of traps \n- 40 challenging levels (5 in demo) \n- 4 different locations (1 in demo)", "short_description": "Its physically based game. You have to fight with the forces of gravity and overcome the traps."}]}, "developer_name": "RaptorsGames", "developer_privacy_policy_url": "http://raptorsgames.com/privacypolicy.html", "developer_terms_of_service_url": "http://raptorsgames.com/privacypolicy.html", "publisher_name": "RaptorsGames", "support_website_url": "http://raptorsgames.com/", "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQ
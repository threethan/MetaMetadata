71-25/38974827_333391640607598_64213347372892160_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njlBxcbuMAoQ7kNvwGGfyTi&_nc_oc=AdqJpJKOtM7X0Evf_R5FqouDkyovpegiemBQj2paq12NotW9o8TpWW1W7wrkYVR8sVM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxPV3Q3rM-K1mhu_nbpcx023gTJGfcZjTtXmCN1wwt_A&oe=6AFC7F6B"}, "display_name": "Board and Ball demo", "keywords": ["Maze", "Trap", "Arcade", "Physics", "Casual"], "long_description": "This is a puzzle in which you overcome obstacles using the force of gravity. You need to control the playing field by joystick and to move forward the ball to the goal. The game does not look complicated at the first sight, but to pass it throught, you need to use the strategic thinking and your agility! Features: \n- unique physics \n- 4 types of traps \n- 40 challenging levels (5 in demo) \n- 4 different locations (1 in demo)", "short_description": "Its physically based game. You have to fight with the forces of gravity and overcome the traps."}]}, "developer_name": "RaptorsGames", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "RaptorsGames", "support_website_url": "https://raptorsreality.com/", "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "210547205219982"}, "review_messages": []}]}
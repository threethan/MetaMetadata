o-logo-gameroom.png", "id": "1096129843325386", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673607600_1096129846658719_8061728533932225718_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jr9GztrOpb4Q7kNvwHQwP-Q&_nc_oc=Adof5w0ra31yf_npb6t6cY2dUyj8OXCj_9GbQNV1R6pICGNPAWPIHlhkxuoZ0smmp2Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcPb_LrmYzUmznWsCYAQdlhNYOo7A0-QDCjMMv0EULLA&oe=6AFC8977"}, {"file_name": "icon-background.png", "id": "1091988917075936", "image_type": "APP_IMG_ICON_BACKGROUND_512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595112037_1091988923742602_4337224021844313467_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVsayeaV3mIQ7kNvwFLXGgg&_nc_oc=AdqDLsJpmQhr0_o4J2U23s9LEVM3RcPg-Fd3frWlnnnRE8GA8zdRBszOEwvb1bG5EoE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc40Ns_AW_tT1OQEZ8HfIBDA8m3nlkhCY7MC_ym30XcA&oe=6AFC64FD"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1003307322784860", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/595119480_1003307326118193_6526632097633340604_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdKaVJyfRHsQ7kNvwFH6lhe&_nc_oc=AdoJPw0jZZXgZH_1IRa3F1douLHFpiAdYysAqsnNhieRi1iElI6ylHuzrpnFmIAPVo4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_bAoNvOvEynjzVL6JOjaP5-xRsTU4esByku0J8ZGAmA&oe=6AFC9049"}]}, "id": "1119030913845365", "locale": "en_US", "screenshots": [{"file_name": "Screenshot from 2026-10-24 12-50-22.png", "id": "2394504240956545", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/596061819_2394504244289878_472382711013539362_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhBWr7ntCY4Q7kNvwG8Abbn&_nc_oc=AdoIcrdEhbIgExt9UmKLr9Y-K9K5Q5u2Kg2WwmqTov14hTsM90QP9vEfvLmYxxTiPDU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT99AIg0IxNwOgCwnH11dER_aKlSDiPPFf3iAMKQyci3A&oe=6AFC8050"}, {"file_name": "Screenshot from 2026-10-24 12-46-25.png", "id": "1162480783023481", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830822_1162480786356814_6414396398300047282_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EwCv7P3r4YQ7kNvwGMaogL&_nc_oc=AdpBGGdvZ9w6uevOf95V6ihkshbAq7OlC52SgPb2MFrF0eCkMnEyLxv_OqezLcly1l0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjB3ijHL3Nau5K3sGKy1ooQYgYo-ynONBPLqWayoCLOw&oe=6AFC822F"}, {"file_name": "Screenshot from 2026-10-24 12-43-03.png", "id": "1472528111644749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_1472528114978082_15441286705472830_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGZtnH1bOl0Q7kNvwF53j3y&_nc_oc=Adq2EokC38GGD8s3OxoIoq1NiAU179WFAXxuENUkQxF-5aTcHDc-EW6nWTzkLbdz0E0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqvODfR1dGwR57NE0448xdjFBuHMtURd58t_2GzKxfjA&oe=6AFC610E"}, {"file_name": "Screenshot from 2026-10-24 12-55-26.png", "id": "1598432591420381", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1598432594753714_8433526199119027828_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isktqLYQDjUQ7kNvwEqzs1h&_nc_oc=Adryi4JAprxfC0RSbWFq9rtlWLfUVVMeuMwL8T5SZKxw3Qf65nwmEDcFMuoINagxNv0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw_9afb76p4M2JxMkgJqTbm4eM1gSNKguL1AvWMdVMcQ&oe=6AFC7337"}, {"file_name": "Screenshot from 2026-10-24 12-44-38.png", "id": "1639734681267856", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673716021_1639734684601189_1142126958551828862_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBQH-zg-1vAQ7kNvwEPlFbn&_nc_oc=AdoW1OECGOQ3VyqVdgz_YjAZ_RZhXi93Uif-tGawpdqLqTUQdSQOEect_JXpeP48evA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmsxTya0Gv8xWPAx2Q90aq9FlZ1GXpDEgZ37GgaRKkSQ&oe=6AFC94CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BenioWorld", "keywords": ["cinema", "screen", "hangout", "friends", "cozy"], "long_description": "**Your screen. Your world. Your friends.**\n\nBenioWorld is a cozy place to hang out in VR. Pick a world, put a giant screen wherever you want it and watch together, or get up and play.\n\n### \ud83c\udfac Watch anything, on a screen your size\n- **Built-in browser** with YouTube one tap away\n- **Your own videos**, straight from the headset, no PC or internet needed\n- **TV channels** from your own playlists (.m3u / .m3u8)\n- Make the screen **as big, as close and as curved** as you like\n- **Ambilight** spills the screen's colors into the room\n\n### \ud83c\udf34 10 worlds to hang out in\nSunset beach, city penthouse, home cinema, airplane cabin, road camper, cozy attic, game room, bedroom, studio and window desk. Switch between **day, sunset and night** anytime, and control each world's own lights.\n\n### \ud83d\udc65 Better together\n- Host a room and **watch in sync**: the host shares the map, the lights and the screen\n- Join **public online rooms**, invite friends with a **room code**, or play over **LAN**\n- Bring your own look with **VRM avatars** and expressions\n\n### \ud83c\udfb3 Things to do between episodes\n- **Bowling** with a real scoreboard, **pool**, **foosball** and **basketball**\n- **Ludo** on the coffee table, a **chalkboard** to draw on\n- A **guitar** you can actually strum, **fireworks**, **hats** to wear\n- A working **phone** with camera, music and live radio, an **instant camera** that prints your photos\n- Grab, throw and resize objects with physics and **tool guns**", "short_description": "Watch YouTube, movies and your own videos on a giant screen with friends, then play bowling, pool, foosball and more across 10 cozy worlds, from a sunset beach to a city penthouse."}]}, "developer_name": null, "developer_privacy_policy_url": "http
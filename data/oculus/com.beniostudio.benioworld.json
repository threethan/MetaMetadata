f20f&oh=00_AQTFKJ5udCflbb56t_k6-8kWs8QeWn9ANuCinV96meRG7A&oe=6AFB2ED0"}, {"file_name": "Screenshot from 2026-10-24 12-46-25.png", "id": "1162480783023481", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830822_1162480786356814_6414396398300047282_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtIVsWumVKUQ7kNvwGq-VsN&_nc_oc=AdrQ8R3meEUBAmVriqFL7yMDUOqoe7bGb9K63N-gc1iYLIBC-YCZV8Idu8XqMhFFiZ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtPEWRDcNQRPuDaKFGu3CG4oQatbxPfdyCJnbzvNPI_Q&oe=6AFB30AF"}, {"file_name": "Screenshot from 2026-10-24 12-43-03.png", "id": "1472528111644749", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/596168449_1472528114978082_15441286705472830_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dGZtnH1bOl0Q7kNvwEL5VZp&_nc_oc=Adq2Ytbqad-4lwVwbIj95Mrq6yCSgKWhmhiWh0Seuo38gfe9FSIj2mCkm-9NfbNHbDU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSw9o788D3cUWp8usxcYxC550RHJRMPEe4G0iEo-dks6w&oe=6AFB47CE"}, {"file_name": "Screenshot from 2026-10-24 12-55-26.png", "id": "1598432591420381", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830904_1598432594753714_8433526199119027828_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isktqLYQDjUQ7kNvwG95j4c&_nc_oc=Adrrz_4XWfDXP6IwAkqocnldoHNUABle4Mjrrlkjq4t_nQNQq8-aU_ra6aHJp6yjR8s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBCMd1TbjdJrSC65zo0e4LtrWOOt1B3ozK5m0dgVrRGw&oe=6AFB21B7"}, {"file_name": "Screenshot from 2026-10-24 12-44-38.png", "id": "1639734681267856", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673716021_1639734684601189_1142126958551828862_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBQH-zg-1vAQ7kNvwHm3bfM&_nc_oc=AdoRn7loqOYgJPp2Ynq0KNKEXkUgNGlBZzDDR-s6GhYPPb-RIfpW-rworgI1Tisu8lc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJFGwQSmAC5QN34gUhPNzliu79rPZQAGLkarM-PQVBEQ&oe=6AFB434C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BenioWorld", "keywords": ["cinema", "screen", "hangout", "friends", "cozy"], "long_description": "**Your screen. Your world. Your friends.**\n\nBenioWorld is a cozy place to hang out in VR. Pick a world, put a giant screen wherever you want it and watch together, or get up and play.\n\n### \ud83c\udfac Watch anything, on a screen your size\n- **Built-in browser** with YouTube one tap away\n- **Your own videos**, straight from the headset, no PC or internet needed\n- **TV channels** from your own playlists (.m3u / .m3u8)\n- Make the screen **as big, as close and as curved** as you like\n- **Ambilight** spills the screen's colors into the room\n\n### \ud83c\udf34 10 worlds to hang out in\nSunset beach, city penthouse, home cinema, airplane cabin, road camper, cozy attic, game room, bedroom, studio and window desk. Switch between **day, sunset and night** anytime, and control each world's own lights.\n\n### \ud83d\udc65 Better together\n- Host a room and **watch in sync**: the host shares the map, the lights and the screen\n- Join **public online rooms**, invite friends with a **room code**, or play over **LAN**\n- Bring your own look with **VRM avatars** and expressions\n\n### \ud83c\udfb3 Things to do between episodes\n- **Bowling** with a real scoreboard, **pool**, **foosball** and **basketball**\n- **Ludo** on the coffee table, a **chalkboard** to draw on\n- A **guitar** you can actually strum, **fireworks**, **hats** to wear\n- A working **phone** with camera, music and live radio, an **instant camera** that prints your photos\n- Grab, throw and resize objects with physics and **tool guns**", "short_description": "Watch YouTube, movies and your own videos on a giant screen with friends, then play bowling, pool, foosball and more across 10 cozy worlds, from a sunset beach to a city penthouse."}]}, "developer_name": null, "developer_privacy_policy_url": "http
o-logo-gameroom.png", "id": "1096129843325386", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673607600_1096129846658719_8061728533932225718_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EA3aGsnFeb8Q7kNvwGMFqDZ&_nc_oc=AdqOPyguMpbZzeNSI3dqEgH5EBsM1RXKX8EYKVwZuTK5YxPZz9aANgHThoaxTw1wxzM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnnrxWdJJIrxV3sDd21bw1QeslW7pQfA3hiyDJEgB94A&oe=6AFDDAF7"}, {"file_name": "icon-background.png", "id": "1091988917075936", "image_type": "APP_IMG_ICON_BACKGROUND_512", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1091988923742602_4337224021844313467_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVsayeaV3mIQ7kNvwHLZbEP&_nc_oc=Adq7Y5_eBPGTL9H9IN_U7TkQRopZIQZW-kXvEbpMAw2XZTj2lXTIR5vneqLg1Rchos8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_inQmsbkJkpVBg-O3cghECCsPdta1o3vzwKeX7MXAAw&oe=6AFDB67D"}, {"file_name": "uba_APP_IMG_COVER_SQUARE.png", "id": "1003307322784860", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595119480_1003307326118193_6526632097633340604_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vdKaVJyfRHsQ7kNvwFPw9YI&_nc_oc=Adr6w2MwEuYThJNCfMbKvMjJIzCKWyOKAHcqRDjWN7SN8NC2fm7eBon7rLbdg0BoikI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHKEQFAAiFYRV8fgpeKdcWZX9ivKIrhFlPmapk6NQY-g&oe=6AFDE1C9"}]}, "id": "1119030913845365", "locale": "en_US", "screenshots": [{"file_name": "Screenshot from 2026-10-24 12-50-22.png", "id": "2394504240956545", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596061819_2394504244289878_472382711013539362_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhBWr7ntCY4Q7kNvwGeI8Oq&_nc_oc=Adp3alUoa_OlkrTl23UZPuyJHFEHXyKJkDeSOZnxlpZbLSQ5JDivJix2-QvsuA6GOtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxNo5jfuDczwGk-pWrUw-g99h1qlUANhmv8MPhNebDfA&oe=6AFDD1D0"}, {"file_name": "Screenshot from 2026-10-24 12-46-25.png", "id": "1162480783023481", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_1162480786356814_6414396398300047282_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EwCv7P3r4YQ7kNvwGf0_MA&_nc_oc=AdocgjEI0p_3IWdfsIcDhei65tqDbZ88WpawrgYSLeqzLVUKzRAfDIEzG40N2jTY1O0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt26i5mtIMfE5OzF8bF5pE_7jvCnMQXi7xRMbvjThzeA&oe=6AFDD3AF"}, {"file_name": "Screenshot from 2026-10-24 12-43-03.png", "id": "1472528111644749", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596168449_1472528114978082_15441286705472830_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXvHl0uK3uYQ7kNvwHQxTos&_nc_oc=Adpphz1oGGkkY4vcCMB6vz85CmC95zTMFrHVbyCCoVCdpdP_U9IBSOF_gLlOLZWaIkA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQc7mG5zGbNJZ8nwq-YtT6m0hU-kAW1UjeOiUe5HTHMdw&oe=6AFDB28E"}, {"file_name": "Screenshot from 2026-10-24 12-55-26.png", "id": "1598432591420381", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_1598432594753714_8433526199119027828_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLzPICXHK08Q7kNvwGizhGY&_nc_oc=AdqcVaWTjNyk_Wh19emwDD8DwLuZjtAY0tkiMy0zLJIMZIINNbzKyXGu2SDiyj9iPTg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv37NTe0fgxOED-zIDTb-Y8oWnN_OgQEhtCAVzwC1EHg&oe=6AFDC4B7"}, {"file_name": "Screenshot from 2026-10-24 12-44-38.png", "id": "1639734681267856", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673716021_1639734684601189_1142126958551828862_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgRYpnXJTQsQ7kNvwEQfQlh&_nc_oc=AdpLXxPECR8QdpB6lXVRC0-PbCUxv-2d5j9FL8FU_P_xYhDVtPwIILKvs8T1WTpTKM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJTIDkeVECcAOQpb-hhhO7iyVcUcijJ60_9RLyo63goQ&oe=6AFDAE0C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BenioWorld", "keywords": ["cinema", "screen", "hangout", "friends", "cozy"], "long_description": "**Your screen. Your world. Your friends.**\n\nBenioWorld is a cozy place to hang out in VR. Pick a world, put a giant screen wherever you want it and watch together, or get up and play.\n\n### \ud83c\udfac Watch anything, on a screen your size\n- **Built-in browser** with YouTube one tap away\n- **Your own videos**, straight from the headset, no PC or internet needed\n- **TV channels** from your own playlists (.m3u / .m3u8)\n- Make the screen **as big, as close and as curved** as you like\n- **Ambilight** spills the screen's colors into the room\n\n### \ud83c\udf34 10 worlds to hang out in\nSunset beach, city penthouse, home cinema, airplane cabin, road camper, cozy attic, game room, bedroom, studio and window desk. Switch between **day, sunset and night** anytime, and control each world's own lights.\n\n### \ud83d\udc65 Better together\n- Host a room and **watch in sync**: the host shares the map, the lights and the screen\n- Join **public online rooms**, invite friends with a **room code**, or play over **LAN**\n- Bring your own look with **VRM avatars** and expressions\n\n### \ud83c\udfb3 Things to do between episodes\n- **Bowling** with a real scoreboard, **pool**, **foosball** and **basketball**\n- **Ludo** on the coffee table, a **chalkboard** to draw on\n- A **guitar** you can actually strum, **fireworks**, **hats** to wear\n- A working **phone** with camera, music and live radio, an **instant camera** that prints your photos\n- Grab, throw and resize objects with physics and **tool guns**", "short_description": "Watch YouTube, movies and your own videos on a giant screen with friends, then play bowling, pool, foosball and more across 10 cozy worlds, from a sunset beach to a city penthouse."}]}, "developer_name": null, "developer_privacy_policy_url": "http
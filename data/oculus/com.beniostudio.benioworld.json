f20f&oh=00_AQRe-sh7Z9Q6jAJUwhNWq5LGfxODpTB4arJphSpw2q0x2w&oe=6AFF2350"}, {"file_name": "Screenshot from 2026-10-24 12-46-25.png", "id": "1162480783023481", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491830822_1162480786356814_6414396398300047282_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EwCv7P3r4YQ7kNvwHF0kg2&_nc_oc=AdqBz8KiPujOTHJYm38j_wEd0At8ypbwQbosdvaswMJruNIOSNIDu0V_pr87ZAc1x2g&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0818TRWgpDMvD5BmPe9H6QN_lGHBNeZpMiceYpTO1rw&oe=6AFF252F"}, {"file_name": "Screenshot from 2026-10-24 12-43-03.png", "id": "1472528111644749", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/596168449_1472528114978082_15441286705472830_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXvHl0uK3uYQ7kNvwGuNoAp&_nc_oc=Adp_1IZ7tWBn5v1zRrCJruLYieUsm43iQLrcf2xUmASfmHF2XRcwWRfRNF0M83K-YQk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-cSEm506AV9iby6Ak0S5QVpq6Ak3CNnTG5RGoAN8LhA&oe=6AFF040E"}, {"file_name": "Screenshot from 2026-10-24 12-55-26.png", "id": "1598432591420381", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830904_1598432594753714_8433526199119027828_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLzPICXHK08Q7kNvwHl85kK&_nc_oc=AdpWZMrpVB5itThPkyHRgUd82jCDkwE4KcKWGTgQirU_Fry613IgnxoeGKbPzwvgNWI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyZYkOwGZicpRKnBH5fk4Oq8pqeSCTQ-8h9OIOC-xMtA&oe=6AFF1637"}, {"file_name": "Screenshot from 2026-10-24 12-44-38.png", "id": "1639734681267856", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673716021_1639734684601189_1142126958551828862_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WgRYpnXJTQsQ7kNvwEILfhp&_nc_oc=Adrl6t_xdqHLvRFskWdgX1DhZCy2gIGl6Khy4docucfJVaRJpyeqQucseYBPo0syVGU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3pvem43ddrLMfZSlrd8usMw8gJOHYNwMxiG2fIZO1_Q&oe=6AFEFF8C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BenioWorld", "keywords": ["cinema", "screen", "hangout", "friends", "cozy"], "long_description": "**Your screen. Your world. Your friends.**\n\nBenioWorld is a cozy place to hang out in VR. Pick a world, put a giant screen wherever you want it and watch together, or get up and play.\n\n### \ud83c\udfac Watch anything, on a screen your size\n- **Built-in browser** with YouTube one tap away\n- **Your own videos**, straight from the headset, no PC or internet needed\n- **TV channels** from your own playlists (.m3u / .m3u8)\n- Make the screen **as big, as close and as curved** as you like\n- **Ambilight** spills the screen's colors into the room\n\n### \ud83c\udf34 10 worlds to hang out in\nSunset beach, city penthouse, home cinema, airplane cabin, road camper, cozy attic, game room, bedroom, studio and window desk. Switch between **day, sunset and night** anytime, and control each world's own lights.\n\n### \ud83d\udc65 Better together\n- Host a room and **watch in sync**: the host shares the map, the lights and the screen\n- Join **public online rooms**, invite friends with a **room code**, or play over **LAN**\n- Bring your own look with **VRM avatars** and expressions\n\n### \ud83c\udfb3 Things to do between episodes\n- **Bowling** with a real scoreboard, **pool**, **foosball** and **basketball**\n- **Ludo** on the coffee table, a **chalkboard** to draw on\n- A **guitar** you can actually strum, **fireworks**, **hats** to wear\n- A working **phone** with camera, music and live radio, an **instant camera** that prints your photos\n- Grab, throw and resize objects with physics and **tool guns**", "short_description": "Watch YouTube, movies and your own videos on a giant screen with friends, then play bowling, pool, foosball and more across 10 cozy worlds, from a sunset beach to a city penthouse."}]}, "developer_name": null, "developer_privacy_policy_url": "http
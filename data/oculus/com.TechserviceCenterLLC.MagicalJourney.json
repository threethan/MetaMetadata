-sea5-2.oculuscdn.com/v/t64.5771-25/39035322_1622106931293107_7673111564532441971_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RRdbyrwvEowQ7kNvwHHpk9t&_nc_oc=Adq5Hjodu2xlbOoJTgvxjpW-VTxH5yKDJQ6RZPDvjN02kKwH-0TyE3WK3bXzAQ8Xgss&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSOcJLh_DBJBdSz343qF9s5YZQj-jhchCeIrk4OlwPUww&oe=6AFC6968"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974909_908434023259504_3985756054659184676_n.png", "id": "925778641641882", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974738_925778644975215_4153897081312316798_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=492Zlsh7PiMQ7kNvwEH6oR8&_nc_oc=AdpmeR-dqalXUiW6dZgHdSeBzF2myQ_XKeC2CKwdVZ2EUHABBN6BjnIxkfJYexXetVs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQKHHLbQUbemOV9-UM-zzB23u8DJ9itI8cMTG14hD1DWg&oe=6AFC7F03"}, "display_name": "Magical Journey", "keywords": [], "long_description": "Millions of players of all ages have already loved the classic Match-3 game mechanics. Now you have a chance to dive deeper into these fantastic mechanics with the help of virtual reality. Line up three or more identical elements in a row, swapping two adjacent elements of the playing field. What could be easier? And what could be more joyful? \n\nForget about the real world and get immersed in a relaxing and calm magical atmosphere.\nExplore a bizarre world filled with a network of ancient magic portals.\n", "short_description": "Magical Journey is a mysterious world of adventures, full of ancient portals and relaxing surroundings based on classic match-3 mechanics. You play as Wizard, who is creating spells by means of runes, and with a magic wave of the wand, you are supposed to adjust ancient portals that open the path to marvelous new worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://magical-journey.net/privacy-policy.html", "developer_terms_of_ser
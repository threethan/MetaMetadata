dn.com&oh=00_Afskj3E6nbpN56Drqj4Njv_tJ_BsojmOi5m5_d1xV0HzIQ&oe=69A1931E"}, {"file_name": "39003228_1078563499314497_5337112190869677525_n.png", "id": "1101562614003426", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39003276_1101562617336759_4836598458753668503_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMdc36_x_ewQ7kNvwGGrnN5&_nc_oc=Adl467Qq7KjVeaAADIG9cO29H95zB-4Odu4VWtAq7eBueEJXmU6LU186UoHB69GeYt8&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfvVhO37onasTvnmiBjBNSy1E3-eqlIcIiY5UjfYPhgutg&oe=69A1A55D"}, {"file_name": "39035311_214370990453387_7907347975205163826_n.png", "id": "412956890514182", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39001703_412956893847515_5954129044835380243_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYxLg9FicKIQ7kNvwH5Hltz&_nc_oc=AdkMAdptcAReLNZ5tIo9wz7hV6yKS2MO7brj2MItyfovM_PMlCxkjrdr9DoZZ-hXUc4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afsxzou4FwjxjVeFStYgGCbWbNZUEY6RGohJfNZobjV13w&oe=69A19869"}, {"file_name": "38974705_314967146720044_7348271922241027561_n.png", "id": "1622106927959774", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035322_1622106931293107_7673111564532441971_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_Q63LItEjgQ7kNvwFcBwpw&_nc_oc=Adkat2OvxxrdKbSXoz8Ga0CEA5tjraeFgpiHWCqq4ulCn8iZrWeGtUSbGyZqBcnfKR8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsnAve1FG-Q6LSg7lTOU05ArCDWYHjQgXQ-aZhBgOiQsQ&oe=69A176A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974909_908434023259504_3985756054659184676_n.png", "id": "925778641641882", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974738_925778644975215_4153897081312316798_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqE2lEGZblEQ7kNvwG4IzXa&_nc_oc=AdmCa9ahU3FXP8yxOzfQ1qGRf7MIet2fFP5sL7UMt85Yh8RN6sKjbE9wF7DwPdvJVoM&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfumPN7cu_p4ZIoJnvFivIsOj_feFokfNUwLPM8_X2M_HA&oe=69A18C43"}, "display_name": "Magical Journey", "keywords": [], "long_description": "Millions of players of all ages have already loved the classic Match-3 game mechanics. Now you have a chance to dive deeper into these fantastic mechanics with the help of virtual reality. Line up three or more identical elements in a row, swapping two adjacent elements of the playing field. What could be easier? And what could be more joyful? \n\nForget about the real world and get immersed in a relaxing and calm magical atmosphere.\nExplore a bizarre world filled with a network of ancient magic portals.\n", "short_description": "Magical Journey is a mysterious world of adventures, full of ancient portals and relaxing surroundings based on classic match-3 mechanics. You play as Wizard, who is creating spells by means of runes, and with a magic wave of the wand, you are supposed to adjust ancient portals that open the path to marvelous new worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://magical-journey.net/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "TECHSERVICE CENTER, LLC", "support_website_url": null, "website_url": "https://magical-journey.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "505101394594219"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "691282
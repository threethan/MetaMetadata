dn.com&oh=00_Afvfkddv47b3HiSSXLAjA2dn4VlnM-cGXYyq9oLPNESlGw&oe=6999AA1E"}, {"file_name": "39003228_1078563499314497_5337112190869677525_n.png", "id": "1101562614003426", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003276_1101562617336759_4836598458753668503_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8ZNIy0yyrAQ7kNvwH-ITuI&_nc_oc=AdlGC-QLJauGJww91UbkGDbekxmlQVZL5a88trfU3b6bYkahDHOn16J8bRKAf0_3QKo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuKEuB3Lyoc6LQX04G_hURXyDTCQlRFI7yVGz67u0fReQ&oe=6999BC5D"}, {"file_name": "39035311_214370990453387_7907347975205163826_n.png", "id": "412956890514182", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001703_412956893847515_5954129044835380243_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F0Rm3kuEDqMQ7kNvwFwTaZ2&_nc_oc=Adkl7IuQzCt9jnrNU3OqiS5EwrRLaCZ6WgMIUXfoI8lfgJxM-vSi0tx3HOdNPOsFcoM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvX_GmiEe4o1X0LzDn_6pLcyj3pahD-Glzz0RNjP1VwmQ&oe=6999AF69"}, {"file_name": "38974705_314967146720044_7348271922241027561_n.png", "id": "1622106927959774", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035322_1622106931293107_7673111564532441971_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYaSSgNFcu4Q7kNvwGqin6g&_nc_oc=AdlhSmpFci5WFuTVLiZfv4reExbPjAbZ5Q4S8CNhDlNHMboZMtUUd6hoIpW9VCCpQLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHuW0W-OLbr7Yv9w2H9H59LNkz3-eRi3QPG8xXD_x-_Q&oe=69998DA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974909_908434023259504_3985756054659184676_n.png", "id": "925778641641882", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974738_925778644975215_4153897081312316798_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L0L1m1ckkU4Q7kNvwE77pl9&_nc_oc=Adl81_JDudRFHFTvyvsA7eZzGzvK05e8RD95Ho4Xub8-otqkHtoOwkg8W3sRQY1-MJo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvzZtUUp9p9UMRFG0ELmgo6cKMMSHeEMxIVxYWTnQT0vQ&oe=6999A343"}, "display_name": "Magical Journey", "keywords": [], "long_description": "Millions of players of all ages have already loved the classic Match-3 game mechanics. Now you have a chance to dive deeper into these fantastic mechanics with the help of virtual reality. Line up three or more identical elements in a row, swapping two adjacent elements of the playing field. What could be easier? And what could be more joyful? \n\nForget about the real world and get immersed in a relaxing and calm magical atmosphere.\nExplore a bizarre world filled with a network of ancient magic portals.\n", "short_description": "Magical Journey is a mysterious world of adventures, full of ancient portals and relaxing surroundings based on classic match-3 mechanics. You play as Wizard, who is creating spells by means of runes, and with a magic wave of the wand, you are supposed to adjust ancient portals that open the path to marvelous new worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://magical-journey.net/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "TECHSERVICE CENTER, LLC", "support_website_url": null, "website_url": "https://magical-journey.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "505101394594219"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "691282
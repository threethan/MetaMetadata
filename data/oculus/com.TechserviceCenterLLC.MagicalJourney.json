0f&oh=00_Af4zBdz9S1qYi0E2DTXDtoV7vrEo5rAv2gyn3PgnlglSvg&oe=6A073268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "38974909_908434023259504_3985756054659184676_n.png", "id": "925778641641882", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974738_925778644975215_4153897081312316798_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsrxOtfaGJIQ7kNvwHIYi8g&_nc_oc=AdoDbOEtCfuywTb8__I4N7095OW4xkqaeb0Yun9Syi0efVXUON8q73WjGm_wbEYVNUA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6orLRnm9-_NxiHvnLxvHNx5qJ8a99zkr_ZjMnldiVydw&oe=6A070FC3"}, "display_name": "Magical Journey", "keywords": [], "long_description": "Millions of players of all ages have already loved the classic Match-3 game mechanics. Now you have a chance to dive deeper into these fantastic mechanics with the help of virtual reality. Line up three or more identical elements in a row, swapping two adjacent elements of the playing field. What could be easier? And what could be more joyful? \n\nForget about the real world and get immersed in a relaxing and calm magical atmosphere.\nExplore a bizarre world filled with a network of ancient magic portals.\n", "short_description": "Magical Journey is a mysterious world of adventures, full of ancient portals and relaxing surroundings based on classic match-3 mechanics. You play as Wizard, who is creating spells by means of runes, and with a magic wave of the wand, you are supposed to adjust ancient portals that open the path to marvelous new worlds."}]}, "developer_name": null, "developer_privacy_policy_url": "https://magical-journey.net/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "TECHSERVICE CENTER, LLC", "support_website_url": null, "website_url": "https://magical-journey.net/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id"
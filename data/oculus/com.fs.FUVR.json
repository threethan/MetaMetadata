1-25/38974581_1584858151661807_7681775611370536960_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fH3zOeFMpXIQ7kNvwFAekwG&_nc_oc=Adq6CEX7hUOHU7iP8is-qlD9kZQA5_h1pDQN2M1SxbVl7vkQ3HTCEcoAMS4JpZT1qMU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6REPrYVR1K2-wlgmE4eyMiy3oYA1AW8dJqXP1XeUi_g&oe=6B046278"}, "display_name": "Flight Unlimited", "keywords": ["Flight", "Plane", "Simulator", "Flying", "Aviation"], "long_description": "Soar across the beautiful skies of the San Francisco bay area, Las Vegas, and Switzerland, in Flight Unlimited.  Fly in over 12 aircraft and perform various missions in this one of a kind Flight experience. Flight Unlimited also includes an extensive free flight mode.\n\nThe campaign tasks with you missions such as rescuing a prisoner from Alcatraz, B2 Bomber surveillance over the Swiss Alps, landing your Cessna on the Golden Gate Bridge, and more!\n\nAircraft:\n\nA-10 Thunderbolt\nCessna 172\nPitts Special\nChallenger Learjet\nDouglas DC3\nCurtis P40E\nRobin DR400\nF/A-18 Hornet\nB2 Spirit\nC130 Hercules\nE2C Hawkeye\nUltralight (IAP for free flight mode)\nF-22 Raptor (IAP for free flight mode)\nBoeing 747 (IAP for free flight mode)\n\nFeatures:\n- Satellite Imagery covering over 500 SQ Miles.\n- Realistic 3D Cockpits\n- Campaign mode with GTA style missions\n- Landmarks such as Alcatraz, the Golden Gate Bridge, AT&T Park, Oracle Arena, and more\n- 13 aircraft", "short_description": "Soar across the beautiful skies of the San Francisco bay area, Las Vegas, and Switzerland, in Flight Unlimited.  Fly in over 12 aircraft and perform various missions in this one of a kind Flight experience.  Flight Unlimited also includes an extensive free flight mode."}]}, "developer_name": "Flight Systems LLC", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": "http://www.flightsystemsllc.com/", "website_url": "http://www.flightsystemsllc.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "SIMULATION", "RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "649182276392515"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3103859252985780", "version": "1.0.4"}, "id": "529782127642246", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2859319657439742", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "3103859252985780"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "529782127642246"}]}, "change_log": "Restores Stereoscip VR effect.\nOptimizes aircraft controls.", "created_date": 1591709451, "id": "3103859252985780", "version": "1.0.4", "version_code": 23, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "3103858486319190"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2859319657439742", "is_concept": false, "lat
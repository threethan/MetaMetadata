c_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvEUPfSsQsb8tWVbAyNcOthyHT3VZnsXAsOp04kfO3Yw&oe=6B007D4A"}, {"file_name": "PkpfPd.png", "id": "208200937107269", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974520_208200940440602_1619291516285485056_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrLIbaVTxlAQ7kNvwH5T-jE&_nc_oc=AdqbSCgoI-5QBb1_mMk_RH_uOynKhTpXBtMv66KPYqj3xt7KuUbF6yg2b7bK7tydu5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdxPVuvsqlB4ca7UOBHjdL4n3uqIy2gr1GN9b1rZjo3w&oe=6B006E50"}, {"file_name": "yo0q5W.png", "id": "143377993719231", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974714_143377997052564_2084135470249279488_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWOjeEqBCTsQ7kNvwGCiPkg&_nc_oc=AdpxpkD40JkWvX3TsY-_wyvFRiUobhFcHi8DbJ2dLOC2uD1bTbs2nfxUBdU6HKmuRLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRu3RfDM8YHRqQs_fbXYJIH3Mft1c7l1ABxTjfZqfRwSg&oe=6B0077F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/ZumP2c", "id": "1584858148328474", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974581_1584858151661807_7681775611370536960_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GyhsRI1aixgQ7kNvwGPBoyO&_nc_oc=AdrfpMS_e2_FOYi41whsJCl8fflp-Gg1TH4GiXvSc1eFpVI6dmoxu1cIkg5unqc8V1Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRA6w3r436CPzCN40BnbVFeTaHNN8VY1dC2_WMtI67Ng&oe=6B006DF8"}, "display_name": "Flight Unlimited", "keywords": ["Flight", "Plane", "Simulator", "Flying", "Aviation"], "long_description": "Soar across the beautiful skies of the San Francisco bay area, Las Vegas, and Switzerland, in Flight Unlimited.  Fly in over 12 aircraft in Free Flight Mode, and perform various missions in this one of a kind Flight experience. \n\nThe campaign tasks with you missions such as rescuing a prisoner from Alcatraz, B2 Bomber surveillance over the Swiss Alps, landing your Cessna on the Golden Gate Bridge, and more!\n\nAircraft:\n\nA-10 Thunderbolt\nCessna 172\nPitts Special\nChallenger Learjet\nDouglas DC3\nCurtis P40E\nRobin DR400\nF/A-18 Hornet\nB2 Spirit\nC130 Hercules\nE2C Hawkeye\nUltralight (IAP for free flight mode)\nF-22 Raptor (IAP for free flight mode)\nBoeing 747 (IAP for free flight mode)\n\nFeatures:\n- Extensive Free Flight mode in 4 locations\n- Satellite Imagery covering over 500 SQ Miles.\n- Realistic 3D Cockpits\n- Campaign mode with GTA style missions\n- Landmarks such as Alcatraz, the Golden Gate Bridge, AT&T Park, Oracle Arena, and more\n- Over 12 aircraft", "short_description": "Soar across the beautiful skies of the San Francisco bay area, Las Vegas, and Switzerland, in Flight Unlimited.  Fly in over 12 aircraft and perform various missions in this one of a kind Flight experience.  Flight Unlimited also includes an extensive free flight mode."}]}, "developer_name": "Flight Systems LLC", "developer_privacy_policy_url": "https://tasappsystems.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "TAS Systems Corp", "support_website_url": "http://www.flightsystemsllc.com/", "website_url": "http://www.flightsystemsllc.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["FLYING", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1355870898261375"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/390
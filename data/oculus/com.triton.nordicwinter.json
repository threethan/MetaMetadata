-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_1433295088486847_6665651867617942569_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EX-UOQEbdb8Q7kNvwF0vuOo&_nc_oc=AdrWrOP2XUVl6rKOkHXjJiGFr2LAuxj-PXlzS7V9gQc6GTy8zYGpRgiHyA3J4oxIljQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVAynN986NZrUfcXQjKZX9epQDIeCWVr8CyIQ2rr5njag&oe=6B106334"}, {"file_name": "screenshot_5.png", "id": "4380086548876862", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823746_4380086552210195_4022589743334745345_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6WS5CNvcx0Q7kNvwEMI7AS&_nc_oc=Adph_-jqRtWkzLTx0u5EoissnA-MG2su97vXrlJsBodEtNoC3aIrUSjygmtRwBslZE4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWBArYEDb2xokBF0owI3KOKA0fm5getFmbYi6FJnjsLXw&oe=6B104ED8"}, {"file_name": "screenshot_9.png", "id": "1441134237555076", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1441134240888409_8587417022314434355_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M11Pkx9wjDwQ7kNvwHsIJA9&_nc_oc=AdpHp1Y-pB-dCWMZi3eoydB1gV6PIVqgMrj0aOHb0uDcME7cPU1xonvswm5ATuvojOg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUYZc5Q2sG961MRO5Z_C5FK4YzmPwkbOIyUrnEU6Me8DQ&oe=6B1061D4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1043961275384350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_1043961295384348_3998177144805216892_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q4N3vbX5KkQ7kNvwEZdYqC&_nc_oc=AdrezeDyhNSqKWZJBiYJvHKKltfMFAec4NP2tAV_vfcWnatIibaPU9hqN6XgPTT9YF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXgs6gU6IUAVK-OdcMDu7Ut-DozYE5tnS6BjM5RYMxfYg&oe=6B104AF1"}, "display_name": "Nordic Winter", "keywords": ["winter", "ski", "snowshow", "snowboard", "santa"], "long_description": "Winter in Finnish Lapland, in your living room.\n\nSit on a wooden toboggan at the top of Kaunisp\u00e4\u00e4 and push off. Ski Levitunturi, Yll\u00e4stunturi and Rukatunturi on terrain shaped from real elevation data, or ride two fictional valleys under bigger peaks.\n\n**Lantern Run.** Pass between the gate flags and both lanterns light with the next note of a rising tune. Light every one and a wave of light runs down the hill. At night the aurora brightens.\n\n**Race your best.** Every hill keeps your best time for each sport, and a ghost light rides your record line next time.\n\n**Sauna.** Take the ladle, dip it in the bucket and throw l\u00f6yly on the hot stones. Hear the hiss, watch the steam rise and the thermometer climb. Add a log to the stove, dim the lamp, and switch on the old radio.\n\n**Meet Santa** in his sleigh at the top of the hill and open a present.\n\n**Comfort note: this game moves you downhill at speed and can cause motion sickness.** The horizon always stays level, there's no camera bob, top speed and turning are gently limited, and you can play seated.\n\nSports: sledge, skis, snowboard, snowshoes. Six hills, from gentle blue to steep black.\n\nTerrain: Copernicus DEM GLO-30, \u00a9 DLR e.V. 2010-2014 and \u00a9 Airbus Defence and Space GmbH 2014-2018, provided under COPERNICUS by the European Union and ESA. (The licence requires this credit line in the store description.)", "short_description": "Sledge, ski and snowboard real Finnish fells, light lanterns, and warm up in a wood-fired sauna.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/nordic-winter/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/nordic-winter/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/nordic-winter/support", "website_url": "https://nebulytic.com/apps/nordic-winter/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
-ord5-2.oculuscdn.com/v/t64.5771-25/491824322_1433295088486847_6665651867617942569_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AS492VqrxcQ7kNvwGyuYrn&_nc_oc=AdrurfAen0UhwyWJj3OcjnLysF6_qf0SokPxIJ0upfjQHZXzRnOvFL9TJFKe9DfBZbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTUBk0KZCGCPntDgwMyWAMXkgYf_rOVw-xMLS94soAZLQ&oe=6B0DC034"}, {"file_name": "screenshot_5.png", "id": "4380086548876862", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_4380086552210195_4022589743334745345_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FCyoGy4DAQQ7kNvwESZIv2&_nc_oc=AdoCyafOeQEfugbtXzsmQjJ2rtggpH316KI9cvDJLc8XmjLOv9y2-CK-btjhT3HvJQc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRD90w--ziNN4v9xMWQ7tIDCeJNS7Z8XamBA5Gh1Kt95w&oe=6B0DABD8"}, {"file_name": "screenshot_9.png", "id": "1441134237555076", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1441134240888409_8587417022314434355_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M11Pkx9wjDwQ7kNvwEGask6&_nc_oc=AdpA4m4PLRiUkj8BSQd5XONTPqeyKd2YW23fgQE_KVmYvZC8HzQ7Ced9Dkl5qYRVsJs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTcRCkBXHsdeOH8T75L_Ml72zzFO9JvMYxY8b0bdA-jTg&oe=6B0DBED4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1043961275384350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821796_1043961295384348_3998177144805216892_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ERZLk6Y1lhkQ7kNvwFubx2Y&_nc_oc=AdohnFikedpUxBgnbqjSCS5kpjHgEb4mbf1i64gqq4KAMsWV_tIo8ZL7WSRuq8aPUTA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTB81sHmpBwIVqVQxQs7saZpGHKDZFXymJYK8iS_SgVbg&oe=6B0DA7F1"}, "display_name": "Nordic Winter", "keywords": ["winter", "ski", "snowshow", "snowboard", "santa"], "long_description": "Winter in Finnish Lapland, in your living room.\n\nSit on a wooden toboggan at the top of Kaunisp\u00e4\u00e4 and push off. Ski Levitunturi, Yll\u00e4stunturi and Rukatunturi on terrain shaped from real elevation data, or ride two fictional valleys under bigger peaks.\n\n**Lantern Run.** Pass between the gate flags and both lanterns light with the next note of a rising tune. Light every one and a wave of light runs down the hill. At night the aurora brightens.\n\n**Race your best.** Every hill keeps your best time for each sport, and a ghost light rides your record line next time.\n\n**Sauna.** Take the ladle, dip it in the bucket and throw l\u00f6yly on the hot stones. Hear the hiss, watch the steam rise and the thermometer climb. Add a log to the stove, dim the lamp, and switch on the old radio.\n\n**Meet Santa** in his sleigh at the top of the hill and open a present.\n\n**Comfort note: this game moves you downhill at speed and can cause motion sickness.** The horizon always stays level, there's no camera bob, top speed and turning are gently limited, and you can play seated.\n\nSports: sledge, skis, snowboard, snowshoes. Six hills, from gentle blue to steep black.\n\nTerrain: Copernicus DEM GLO-30, \u00a9 DLR e.V. 2010-2014 and \u00a9 Airbus Defence and Space GmbH 2014-2018, provided under COPERNICUS by the European Union and ESA. (The licence requires this credit line in the store description.)", "short_description": "Sledge, ski and snowboard real Finnish fells, light lanterns, and warm up in a wood-fired sauna.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/nordic-winter/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/nordic-winter/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/nordic-winter/support", "website_url": "https://nebulytic.com/apps/nordic-winter/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "27433260359255
86552210195_4022589743334745345_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6WS5CNvcx0Q7kNvwG1XTY1&_nc_oc=AdpAJnACF0-fFozCJQVNwcFyCaAIpesOnkv1V02ipKeKF6EJUHQrgsvOZvNSoBGq9p8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUodhHGsjCG9i_3hGK1wdI9r_JRoe8gVoq_YCHi1Q9WvQ&oe=6B0EFD58"}, {"file_name": "screenshot_9.png", "id": "1441134237555076", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1441134240888409_8587417022314434355_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M11Pkx9wjDwQ7kNvwEkrb4-&_nc_oc=AdrBYwl6XVGT7JzUhxWnPTXez_qXfaXzGKqAW3q4W6DElrLspbz6jv6YocQ9xgZFeAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWJs9L53IkYY9H9lm6yNZTfCmlEMGvh6WkkwMVsWDNQ9A&oe=6B0F1054"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_2560x1440.png", "id": "1043961275384350", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821796_1043961295384348_3998177144805216892_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Q4N3vbX5KkQ7kNvwFPsusr&_nc_oc=Adqn_J9dsKtHk0kB1SwZUtH4dnG5QnYkXiwixfPqKRMULOtDDJL03CMlrlHF__1TfpQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVioS08mdUDv6bPEuaT8uU87ubhr3xmPn20lhlkvyMYhA&oe=6B0EF971"}, "display_name": "Nordic Winter", "keywords": ["winter", "ski", "snowshow", "snowboard", "santa"], "long_description": "Winter in Finnish Lapland, in your living room.\n\nSit on a wooden toboggan at the top of Kaunisp\u00e4\u00e4 and push off. Ski Levitunturi, Yll\u00e4stunturi and Rukatunturi on terrain shaped from real elevation data, or ride two fictional valleys under bigger peaks.\n\n**Lantern Run.** Pass between the gate flags and both lanterns light with the next note of a rising tune. Light every one and a wave of light runs down the hill. At night the aurora brightens.\n\n**Race your best.** Every hill keeps your best time for each sport, and a ghost light rides your record line next time.\n\n**Sauna.** Take the ladle, dip it in the bucket and throw l\u00f6yly on the hot stones. Hear the hiss, watch the steam rise and the thermometer climb. Add a log to the stove, dim the lamp, and switch on the old radio.\n\n**Meet Santa** in his sleigh at the top of the hill and open a present.\n\n**Comfort note: this game moves you downhill at speed and can cause motion sickness.** The horizon always stays level, there's no camera bob, top speed and turning are gently limited, and you can play seated.\n\nSports: sledge, skis, snowboard, snowshoes. Six hills, from gentle blue to steep black.\n\nTerrain: Copernicus DEM GLO-30, \u00a9 DLR e.V. 2010-2014 and \u00a9 Airbus Defence and Space GmbH 2014-2018, provided under COPERNICUS by the European Union and ESA. (The licence requires this credit line in the store description.)", "short_description": "Sledge, ski and snowboard real Finnish fells, light lanterns, and warm up in a wood-fired sauna.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/nordic-winter/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/nordic-winter/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/nordic-winter/support", "website_url": "https://nebulytic.com/apps/nordic-winter/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interactio
vwHXtqEI&_nc_oc=AdrWV1zjgCneW7345bib0IQJuAZNWeuEPLweuP0_5YgBsP32U9tZaX2AXkBN3Dbo5dQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIED6cL1VZj1E_3Ptta4g8lD0PzsAMdPN3XgXPu0FR9Sg&oe=6AAC00BC"}, {"file_name": "3.png", "id": "1262441095454245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305443_1262441098787578_1680421373931876274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIYVicQLa3YQ7kNvwGd4ZgL&_nc_oc=AdqWnPBkJ_frR-k3lDVlHBPhHyT4rplm6rUD8d7b4WxpiyKwCNENJgW6H3RU8z70_qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOYb-iB2q6u4qcFXUUj9OT54VsYJQ_q1mfGlczzxRKyA&oe=6AAC0BAB"}, {"file_name": "4.png", "id": "1094027799233138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_1094027802566471_6071066136957424590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrDyT3Zh71IQ7kNvwHLfcZN&_nc_oc=AdoXNAYIshnrPzxhloxDGSsRM-YsWs48br2AGaMatL_QOu4zcMLm2_iSpqrLE-3cmxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKo0u-gfB2EFADUVDSyxbDraIt7EHmrpQ1u7cJZVeloYw&oe=6AAC0C38"}, {"file_name": "5.png", "id": "10088686581169741", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303507_10088686587836407_1399692419408589504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YV_n5IrMY1EQ7kNvwH3Mfs6&_nc_oc=AdrALKykOxwOmZHDuNs-7HgOkhA7mkNzFJiqUxfR2fZYdu0rx11DsUNFI5UDJ3Oo4J4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqRb0Y4cIxQSNzvm1UlxS-YMrI_k1GcM3v2YMXBBZM3w&oe=6AAC04B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440MW.png", "id": "891869513121387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296914_891869516454720_3350549110974526897_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qio4vQUbAXUQ7kNvwHP6cDI&_nc_oc=Adoo4u0n7HuLdpu62jJ5tJTfnZswgnmdNgTbIYK9ZIQ98BH--pRy1G_cmrP383gReaI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjD_yDG9uM7O96xaLf5JRWoIotVF5U3zS27Q_3Ihgblw&oe=6AABE81C"}, "display_name": "METWIN", "keywords": ["handtracking", "spatialcomputing", "industrialtraining", "simulation", "digitaltwin"], "long_description": "METWIN is a mixed reality (MR) learning and training module for Meta Quest that blends your physical environment with interactive virtual content \u2014 so you learn by doing, right in your own space.   Using hand tracking, gesture interaction, and spatial awareness, METWIN anchors 3D digital objects into the room around you. Reach out, grab, rotate, and operate them with your bare hands \u2014 no controllers required. Passthrough keeps you aware of the real world while virtual parts, machines, and guides appear exactly where you need them. WHO IT\u2019S FOR Trainees learning a new procedure, industrial and frontline teams rehearsing tasks safely, and anyone who learns faster by interacting than by watching.  WHAT YOU CAN DO  \u2022 Practise procedures hands-on with spatially anchored 3D objects \u2022 Interact through natural hand tracking and gestures  \u2022 Blend real and virtual with Quest mixed reality passthrough \u2022 Rehearse complex or high-risk tasks in a safe, repeatable space \u2022 Learn at your own pace, step by step  WHY METWIN  Reading a manual is passive. METWIN is experiential \u2014 spatial, hands-on, and intuitive \u2014 so skills transfer to the real task. It brings digital-twin-style interaction and industrial training simulation into one accessible MR module.  Put on your headset, look around your space, and start training with your hands. Mixed reality learning you can reach out and touch", "short_description": "METWIN is a mixed reality training module that blends your real space with interactive 3D content you control with your bare hands. Using hand tracking, natural gestures, and spatially anchored digital objects, it turns procedures and lessons into hands-on practice you can walk around and touch. Built for trainees, industrial teams, and interactive learners, METWIN makes complex skills easier to grasp and safer to rehearse. No controllers needed \u2014 put on your headset and learn by doing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VB Group", "support_website_url": null, "website_url": "https://vbmetaverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25667807519583931"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830812_1032103275577118_31215545984703181_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTGoSRrzQawQ7kNvwGVPBWT&_nc_oc=Adp64WLuC3YPEHsxwwWu_QtWgr6b8LNLKGWSgYuHdT9BZJcKg35_YvPgmItv9hQWEmA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISP87GWQO0POnyOf6OBAqTAM8elq0nq8pamSwUCBH-nw&oe=6AABF111"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "METWIN", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1750364760, "lastRevision": {"nodes": [{"id": "84736288
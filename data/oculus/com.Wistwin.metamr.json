vwGdnPR6&_nc_oc=AdquAwwnRKBEi_S5IAdCxRVt-HCSCvvVs36DE_rXRzKupDb0Gr2eYRglz1GDrXnyyqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgS4O_BdzOvX5q8JcRkb8V0bVCyLSunPkrz1Vh0vD9TQ&oe=6A75F33C"}, {"file_name": "3.png", "id": "1262441095454245", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499305443_1262441098787578_1680421373931876274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oErc5iHKan0Q7kNvwG8tjZ0&_nc_oc=AdrrC4LzUfc8qTO_WKfggDxh2OUGLMaJO7nKbGyS86Vc2d5DO151jrip32AW83yZ8Gg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGRZMgAeSuYNbqnFWD6fRWL_oSmYXV8ivybDCctuSk7A&oe=6A75C5EB"}, {"file_name": "4.png", "id": "1094027799233138", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_1094027802566471_6071066136957424590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wmAO5WRKKPMQ7kNvwGqEVB3&_nc_oc=Adoa9FIVOhloJdj-OkL2hj1o00nLKOgTy6oJSAfaiWDWMjohU_tWeWwRsMBT5rB8zkw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8i77gjm2xSD7NGQhhfNEeuO7lEHKMDL0yR6Z-qIyq3Q&oe=6A75C678"}, {"file_name": "5.png", "id": "10088686581169741", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303507_10088686587836407_1399692419408589504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obu14ue8uEsQ7kNvwF9iUx5&_nc_oc=AdrqG76lHW00DkT5No7ecDu4B6_YjjvDo8jyI3avhi4odOkoEmKzK0bjY1Irq42xIbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsHNX9A9mHBqUQXIsab8GOOwUFipJyNojK6rdhEguLKQ&oe=6A75F735"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440MW.png", "id": "891869513121387", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499296914_891869516454720_3350549110974526897_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ot4KEhtXNwQ7kNvwHi2UJg&_nc_oc=AdpApEOU7YW2Cj5d0Mjk99m72pEdD_A9AGqs_bIvYmv8mM7r4zyd88s-ej2yRfSBNCA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyc6bAReUhvMOutb_BibQbn2OOZL7Hjg8JV9yPF0SOtA&oe=6A75DA9C"}, "display_name": "METWIN", "keywords": ["handtracking", "spatialcomputing", "industrialtraining", "simulation", "digitaltwin"], "long_description": "METWIN is a mixed reality (MR) learning and training module for Meta Quest that blends your physical environment with interactive virtual content \u2014 so you learn by doing, right in your own space.   Using hand tracking, gesture interaction, and spatial awareness, METWIN anchors 3D digital objects into the room around you. Reach out, grab, rotate, and operate them with your bare hands \u2014 no controllers required. Passthrough keeps you aware of the real world while virtual parts, machines, and guides appear exactly where you need them. WHO IT\u2019S FOR Trainees learning a new procedure, industrial and frontline teams rehearsing tasks safely, and anyone who learns faster by interacting than by watching.  WHAT YOU CAN DO  \u2022 Practise procedures hands-on with spatially anchored 3D objects \u2022 Interact through natural hand tracking and gestures  \u2022 Blend real and virtual with Quest mixed reality passthrough \u2022 Rehearse complex or high-risk tasks in a safe, repeatable space \u2022 Learn at your own pace, step by step  WHY METWIN  Reading a manual is passive. METWIN is experiential \u2014 spatial, hands-on, and intuitive \u2014 so skills transfer to the real task. It brings digital-twin-style interaction and industrial training simulation into one accessible MR module.  Put on your headset, look around your space, and start training with your hands. Mixed reality learning you can reach out and touch", "short_description": "METWIN is a mixed reality training module that blends your real space with interactive 3D content you control with your bare hands. Using hand tracking, natural gestures, and spatially anchored digital objects, it turns procedures and lessons into hands-on practice you can walk around and touch. Built for trainees, industrial teams, and interactive learners, METWIN makes complex skills easier to grasp and safer to rehearse. No controllers needed \u2014 put on your headset and learn by doing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VB Group", "support_website_url": null, "website_url": "https://vbmetaverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25667807519583931"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830812_1032103275577118_31215545984703181_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvpxD7R1Xb0Q7kNvwGoWbSd&_nc_oc=AdqjY9hsi6cW-TE0mIWY3LtqG1__OceX6ZWhWhApvs53kpVFFJQIBWi1t8ygtotIZJk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQs_GI-B81ZEgej4dL33110cYNG48OyJVUdANtU9w04A&oe=6A75E391"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "METWIN", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Utilities", "id": "393222478507326"}], "release_date": 1750364760, "lastRevision": {"nodes": [{"id": "84736288
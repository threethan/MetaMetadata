/v/t64.5771-25/499310786_740359371859732_2258153571725841236_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQBDpUDvMYcQ7kNvwGDIsQJ&_nc_oc=AdpXhyZE9U5HO7_RMv2j6Su8UaSoswZ4LWGBMjPlp6H1VfRyhIaT2TZNJyRkJ-SegME&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeE_QS_BVK8QJFXIUekx5SF71_AA-fRf9lqyQn6p7HQw&oe=6AB68CBC"}, {"file_name": "3.png", "id": "1262441095454245", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499305443_1262441098787578_1680421373931876274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXMZR4aWROAQ7kNvwEJ6v6S&_nc_oc=Adr5T7MELv3azW_Y8jVfnT2qyTD--fb1LsxKw56w4fxyafW5nyqkjvBIhKw2gprFv9M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa7Yxw0qDK4hFh53F38UI7ixAWgjbtUjrIKZwJiUEc_g&oe=6AB697AB"}, {"file_name": "4.png", "id": "1094027799233138", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491830613_1094027802566471_6071066136957424590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c352raYd-xkQ7kNvwGvlxql&_nc_oc=AdorzLe1xA3MVKcacI9UAeLuZy8_p9WazC9ijLWz-Ud8aqMwj4V8M5bvRwgKTCPNT68&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKttzozA6iFC11kAJRZOQfn0GeVSrDU5OVsJFYWR7pT_g&oe=6AB69838"}, {"file_name": "5.png", "id": "10088686581169741", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303507_10088686587836407_1399692419408589504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSiOjo807YMQ7kNvwEn4ZRD&_nc_oc=Adq4EEIPmTvx18_H4wji3IgUpn2EBv9Day5LghubHBPzmAhPwMyRQWFnjwiZ0yBHepA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG6bafF22cKpUW5ov7uNSNDmp_WtNeJalOdbAvv-4vtQ&oe=6AB690B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440MW.png", "id": "891869513121387", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499296914_891869516454720_3350549110974526897_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaPA_B5zL6sQ7kNvwFUN1o8&_nc_oc=AdqJ2MrZnAKWk3Hwe7mmgxQ79F2uGxf3dvjzyDLRIjwbhsOqo_27qgLQ4O3QH1D56sk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9kcP-BOrGU8eVQSRmHiKnDZm6TFo13pHD2D5LQXO2tg&oe=6AB6741C"}, "display_name": "METWIN", "keywords": ["handtracking", "spatialcomputing", "industrialtraining", "simulation", "digitaltwin"], "long_description": "METWIN is a mixed reality (MR) learning and training module for Meta Quest that blends your physical environment with interactive virtual content \u2014 so you learn by doing, right in your own space.   Using hand tracking, gesture interaction, and spatial awareness, METWIN anchors 3D digital objects into the room around you. Reach out, grab, rotate, and operate them with your bare hands \u2014 no controllers required. Passthrough keeps you aware of the real world while virtual parts, machines, and guides appear exactly where you need them. WHO IT\u2019S FOR Trainees learning a new procedure, industrial and frontline teams rehearsing tasks safely, and anyone who learns faster by interacting than by watching.  WHAT YOU CAN DO  \u2022 Practise procedures hands-on with spatially anchored 3D objects \u2022 Interact through natural hand tracking and gestures  \u2022 Blend real and virtual with Quest mixed reality passthrough \u2022 Rehearse complex or high-risk tasks in a safe, repeatable space \u2022 Learn at your own pace, step by step  WHY METWIN  Reading a manual is passive. METWIN is experiential \u2014 spatial, hands-on, and intuitive \u2014 so skills transfer to the real task. It brings digital-twin-style interaction and industrial training simulation into one accessible MR module.  Put on your headset, look around your space, and start training with your hands. Mixed reality learning you can reach out and touch", "short_description": "METWIN is a mixed reality training module that blends your real space with interactive 3D content you control with your bare hands. Using hand tracking, natural gestures, and spatially anchored digital objects, it turns procedures and lessons into hands-on practice you can walk around and touch. Built for trainees, industrial teams, and interactive learners, METWIN makes complex skills easier to grasp and safer to rehearse. No controllers needed \u2014 put on your headset and learn by doing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VB Group", "support_website_url": null, "website_url": "https://vbmetaverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25667807519583931"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830812_1032103275577118_31215545984703181_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmKR4zvTgoQQ7kNvwHcBpBy&_nc_oc=Adp6-k31YAwlld2a6_CfCEU_wcD5ekqOFUqwrAMLye_TVhyJxOyjV_NIGhb_CPqx7jM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBrM52XILD_KQ6469q9cr_ASD1V543L2J9arom5AkC6w&oe=6AB67D11"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "METWIN", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Productivity", "id": "1063584910766706"}, {
/v/t64.5771-25/499310786_740359371859732_2258153571725841236_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JNzPY9XoWTsQ7kNvwHq1SIp&_nc_oc=Adqippfq-IAxfuWwzR_Prpyzzt5LjeHG01GJeUIgdiq0V9ucVNvlAVQYulwKK7YE0SA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNZ7OqdXEwIMtVT7vDiQB0C9PgU6IWz0yy6dxQ44MLrA&oe=6AE8A5BC"}, {"file_name": "3.png", "id": "1262441095454245", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499305443_1262441098787578_1680421373931876274_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rhZ7wv_9kP8Q7kNvwEAPnEC&_nc_oc=AdrLOyodz7EmZckTossOlJ7NcyK3_lmnP3PEcBVNlC2p11rHkj1HmGLUdTYDl77PwAY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzFdp1oFV4K8QAA_i_Z7LSEBM4MNsJvAFKhF9UabD_vA&oe=6AE8B0AB"}, {"file_name": "4.png", "id": "1094027799233138", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491830613_1094027802566471_6071066136957424590_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_owZ0Sc7e4Q7kNvwGxke9v&_nc_oc=Adqz68vZP8Fk1jTxNBle-5508LjwI_DDL7sOHWFoTt1l6K5hp40O4FU5K68YVp__1qs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ-dsnlZbpN0h1bLMwcrhWxKxhLjQcHuWuJvBXP_sk6w&oe=6AE8B138"}, {"file_name": "5.png", "id": "10088686581169741", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499303507_10088686587836407_1399692419408589504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezzmgclQxmoQ7kNvwGHCNFo&_nc_oc=Adrru9wl_ZNSQm1R4OQ_qIOfbN2L0CI0fi21vUK0uhTwxqaVVm9I7ov1jvhSlz-PApE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQowwnwC5cMu_xPjQ_YPEt2aKsanJ5yGuIvr6wS0Ti0ew&oe=6AE8A9B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560X1440MW.png", "id": "891869513121387", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499296914_891869516454720_3350549110974526897_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6CeiNw4y-pQQ7kNvwF8p237&_nc_oc=AdpFR_hy4tWOyMA9k4oqOe6Y-y4Ndxv7TGY4GTHu_wROXqu31gkq2n9-u2FqiiLgIQw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSb1RcSjXwBd9eUKknC4_6gqof48SrUl-A8cbnUwEHuNQ&oe=6AE88D1C"}, "display_name": "METWIN", "keywords": ["handtracking", "spatialcomputing", "industrialtraining", "simulation", "digitaltwin"], "long_description": "METWIN is a mixed reality (MR) learning and training module for Meta Quest that blends your physical environment with interactive virtual content \u2014 so you learn by doing, right in your own space.   Using hand tracking, gesture interaction, and spatial awareness, METWIN anchors 3D digital objects into the room around you. Reach out, grab, rotate, and operate them with your bare hands \u2014 no controllers required. Passthrough keeps you aware of the real world while virtual parts, machines, and guides appear exactly where you need them. WHO IT\u2019S FOR Trainees learning a new procedure, industrial and frontline teams rehearsing tasks safely, and anyone who learns faster by interacting than by watching.  WHAT YOU CAN DO  \u2022 Practise procedures hands-on with spatially anchored 3D objects \u2022 Interact through natural hand tracking and gestures  \u2022 Blend real and virtual with Quest mixed reality passthrough \u2022 Rehearse complex or high-risk tasks in a safe, repeatable space \u2022 Learn at your own pace, step by step  WHY METWIN  Reading a manual is passive. METWIN is experiential \u2014 spatial, hands-on, and intuitive \u2014 so skills transfer to the real task. It brings digital-twin-style interaction and industrial training simulation into one accessible MR module.  Put on your headset, look around your space, and start training with your hands. Mixed reality learning you can reach out and touch", "short_description": "METWIN is a mixed reality training module that blends your real space with interactive 3D content you control with your bare hands. Using hand tracking, natural gestures, and spatially anchored digital objects, it turns procedures and lessons into hands-on practice you can walk around and touch. Built for trainees, industrial teams, and interactive learners, METWIN makes complex skills easier to grasp and safer to rehearse. No controllers needed \u2014 put on your headset and learn by doing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vbmetaverse.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VB Group", "support_website_url": null, "website_url": "https://vbmetaverse.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25667807519583931"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830812_1032103275577118_31215545984703181_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nhg0en24RFwQ7kNvwGrsHbr&_nc_oc=Adr-tYlJEt9QffO2p88hnD7Dz3cAIV1tRo4BaE6NQPMaeathoWdAHPJ3Z5qGaZLMcHE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz_oST2LfpflS4ihwj64F6IUDvs3omg-RYfHysXDRXaQ&oe=6AE89611"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "METWIN", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Productivity", "id": "1063584910766706"}, {
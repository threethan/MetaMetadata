5PD5EmzGKHvB3kZ-kn5VubQL1GGVvYCiIMbF_ZQ73ulg&oe=6A19932D"}, {"file_name": "ssb3.png", "id": "804765565940941", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310646_804765569274274_9197403628021346738_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sHHIhJ9sBcEQ7kNvwFF5xDu&_nc_oc=Adqtl_J6ft4dsmaWGsSjJVsPBSFLgUuqGR9F83WEeuEbpMcorm4btiP9o8bxc3GJ024&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7viU04bDqV6CbUiFrgBovx7QW3v2TvbjVw1g4aUoxw5g&oe=6A19A5E5"}, {"file_name": "ssb2.png", "id": "2994941087561504", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304952_2994941090894837_7317041648530632742_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-TO0x_LwKtwQ7kNvwFbGJ9g&_nc_oc=AdqWXlcctQAyNWhRyJaHwWTepVd9V6cYLTS0Yb7NMP6mbKOjdBA0hLlv0jzs2a80he8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RKF16Vm-QpslowUs4bomITTrLqzmlJDnC9ZF0DfZb_A&oe=6A19B0AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerPic.png", "id": "865688822714946", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307505_865688826048279_2674830834782067694_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tO_Yd99MdQoQ7kNvwE6vJ4Q&_nc_oc=AdrdbZUJgN4Ct9ECFyr-hSrRUsTAlHYMkLafAbuGE9KBdDx2JxtoV9LH3pM9nrhW32A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NhYb2kmivBKvbydCSZIFAEq8_2xyBpEh1fZEAOuhw2w&oe=6A19B583"}, "display_name": "X-Slap Early Access", "keywords": ["free", "gamer", "slap", "hand", "alpha"], "long_description": "# X-Slap: Defend Your Candy with Your Bare Hands!\n\nMonsters are invading your home, and they're after your candy stash! **X-Slap** transforms your living room into an arcade battleground where your hands become the ultimate weapons.\n\n**Pure Gesture-Powered Action**\n\nSlap balls at monster invaders! Punch red orbs to unleash explosive bomb clusters, and point-and-poke yellow orbs to shoot devastating finger lasers. The hand tracking makes every gesture feel natural and satisfying, though you can also play with controllers.\n\n**Endlessly Replayable**\n\nWith **30 unique power-ups** and procedurally generated waves, no two sessions are identical. You'll experience heart-pounding moments where you're one hit from defeat, then a clutch power-up drops and turns everything around. That's the magic of **X-Slap** \u2013 skill meets luck meets pure arcade fun.\n\n**Instant Fun, Deep Strategy**\n\nPick up and play in seconds, but discover endless depth. Casual players enjoy quick 10-minute sessions while hardcore gamers chase perfect runs and high scores. Every wave forces new tactical decisions as you adapt to random enemy patterns and power-up combinations.\n\n**Early Access - Free!**\n\nOur Meta Start Competition entry is now available for everyone! **X-Slap** proves mixed reality gaming should enhance your space, not replace it.\n\n**Download now and start slapping!**\n\n*Compatible with Quest 3/3S/Pro | Hand tracking optional*", "short_description": "Monsters are invading your home! Slap, punch and blast them back to protect your candy stash. Mixed reality meets hand tracking in this gesture-powered arcade defense game."}]}, "developer_name": "Virtually There", "developer_privacy_policy_url": "https://xslapgame.com/privacy", "developer_terms_of_service_url": "https://xslapgame.com/terms", "publisher_name": "Virtually There", "support_website_url": null, "website_url": "https://xslapgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
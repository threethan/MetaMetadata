bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGbKQFg54JwQ7kNvwED2KbO&_nc_oc=AdpDnMgwARichFXSNzPWx_EvBJF4edDTMFaA2AbH76K7518QZwa80SL6flbIilE-fYA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpWkWi_3WDXv5jyH3Nn4qzJn_bNep1JDAnWrgM3suGrg&oe=6B086AED"}, {"file_name": "ssb3.png", "id": "804765565940941", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310646_804765569274274_9197403628021346738_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dx8C12C8t6EQ7kNvwG7u9jM&_nc_oc=Ado4lE5qxzgWehfic6MZWvmCQ5ojBKwGNXggC4XCWkuMsKYSZ3azQMFRWWe6fkkfUpA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTh6tGOwLh67jVIkMb9wnJbKMqZPm07AfgBXELLRmSWcg&oe=6B084565"}, {"file_name": "ssb2.png", "id": "2994941087561504", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499304952_2994941090894837_7317041648530632742_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ji6Bvv0whIQ7kNvwFjnbcS&_nc_oc=Adp-EC9R6CWOEOuRecPXaGZjLyqdP4BJ8EpTAVmrt-vRvV0C6LVO-p29-_Z27KNkiq4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmOvv4L4BYZLv-qsoiJbz-FEgknmO7W7akZITXGu1Kcw&oe=6B08502C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerPic.png", "id": "865688822714946", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499307505_865688826048279_2674830834782067694_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4LeLENGaQ0Q7kNvwFIdHjg&_nc_oc=Adrm14_Z10yI40N0AWI0-qYEtOHK6uVKxHHFY4Tnlzu64ZeXZWl3tTRNF0tFXAomXj0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEEKC9zd4mahe5EpRJPKEHXjCPEkgSdjxl8a-YPUxtAQ&oe=6B085503"}, "display_name": "X-Slap Early Access", "keywords": ["free", "gamer", "slap", "hand", "alpha"], "long_description": "# X-Slap: Defend Your Candy with Your Bare Hands!\n\nMonsters are invading your home, and they're after your candy stash! **X-Slap** transforms your living room into an arcade battleground where your hands become the ultimate weapons.\n\n**Pure Gesture-Powered Action**\n\nSlap balls at monster invaders! Punch red orbs to unleash explosive bomb clusters, and point-and-poke yellow orbs to shoot devastating finger lasers. The hand tracking makes every gesture feel natural and satisfying, though you can also play with controllers.\n\n**Endlessly Replayable**\n\nWith **30 unique power-ups** and procedurally generated waves, no two sessions are identical. You'll experience heart-pounding moments where you're one hit from defeat, then a clutch power-up drops and turns everything around. That's the magic of **X-Slap** \u2013 skill meets luck meets pure arcade fun.\n\n**Instant Fun, Deep Strategy**\n\nPick up and play in seconds, but discover endless depth. Casual players enjoy quick 10-minute sessions while hardcore gamers chase perfect runs and high scores. Every wave forces new tactical decisions as you adapt to random enemy patterns and power-up combinations.\n\n**Early Access - Free!**\n\nOur Meta Start Competition entry is now available for everyone! **X-Slap** proves mixed reality gaming should enhance your space, not replace it.\n\n**Download now and start slapping!**\n\n*Compatible with Quest 3/3S/Pro | Hand tracking optional*", "short_description": "Monsters are invading your home! Slap, punch and blast them back to protect your candy stash. Mixed reality meets hand tracking in this gesture-powered arcade defense game."}]}, "developer_name": "Virtually There", "developer_privacy_policy_url": "https://xslapgame.com/privacy", "developer_terms_of_service_url": "https://xslapgame.com/terms", "publisher_name": "Virtually There", "support_website_url": null, "website_url": "https://xslapgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_t
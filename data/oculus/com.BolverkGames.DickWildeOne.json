=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-QqCgUreUf84hLZKCg5Ojp_wuuCUKPJ5C59zHvnJY-g&oe=6A6B4F1A"}, {"file_name": "12504696_1647823545527280_97121515643863040_n.png", "id": "2479864442371507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_2479864452371506_6304139300377903639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqgglgNho3QQ7kNvwEhqqX9&_nc_oc=AdrKoyRTzPLu3-lLBVml___VKiIJZzT97jXT52P33Y4s9OHpZh9FnVa3ioI14xCwsJ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdQYMhQExcTFzFftpzQhWFqZshMIYKHufq8E8b5A5icg&oe=6A6B64EA"}, {"file_name": "12602069_395857384125124_8817570809330532352_n.png", "id": "929011539357194", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_929011542690527_5406921352790703223_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2eQBkBvUQYQ7kNvwHa2K8Q&_nc_oc=Adr4dbxecHBUSSYo7vo80npuB0gT2m-RDDOERPtLVzRy016I_o0DdNUnLwFMpPpNpAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdmo1VrClXqLNHLVzWNY8h32Kp70c5r-D51ddZQ8egag&oe=6A6B4562"}, {"file_name": "12602069_792270404257179_2177770683629568000_n.png", "id": "1188101426316842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820923_1188101429650175_2476170459749552977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DCi4PsI4bMUQ7kNvwFo88Kg&_nc_oc=AdpTJsgMGQ_NoN_POHdqE1lo-G7bff1BRmP_-6dM-cpCha8GAQ2uCIgnQhkbGkIYByQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5clEUMopPQ7Qy1LbCT2mSaZ4PIR5h4iDG48xfKw0GNQ&oe=6A6B3A35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dick Wilde", "keywords": ["fps", "shooter", "arcade", "dick", "wilde"], "long_description": "OUTRAGEOUS HOMEMADE WEAPONS!\n\nGo crazy with the homemade arsenal of Dick Wilde! Nailguns, grenade launchers, electric bow and many more!\n\n9 UNIQUE LEVELS\n\nProgress though 9 unique levels in 3 different settings: swamp, tropical and northern!\n\nBIG VARIETY OF ENEMIES\n\nGiant alligators, rabid piranhas, electric eels, charging sharks, bats and many more! \n\nPARTY MODE\n\nHave a hoedown by sharing the headset amongst friends and compete for the highscore! \n\nEPIC BOSS FIGHTS\n\nDefeat giant boss monsters at the end of each level! Can Dick really take on a three story high turtle with a homemade bow? Can you?\n\nDISCLAIMER\n\nBolverk games does not support animal cruelty in any way, nor do we endorse heavy substance abuse, weapon crafting or having a messy home in a swamp. \n", "short_description": "Those pesky swamp critters are at it again! Scarin\u2019 off all the good folk who just want to go huntin\u2019 n\u2019 fishin\u2019 on their lakes and lagoons! We\u2019re talking piranhas, eels, \u2018gators - you name it! There\u2019s even been talk of a giant mutated Turtle on the loose! Good thing our fav\u2019rite gun-slingin\u2019, grenade-launchin\u2019, cross-bow firin\u2019 exterminator, Dick Wilde, is on standby to open up a can of whoop ass!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://playstack.com/privacy-policy/", "developer_terms_of_service_url": "https://www.playstack.com/terms-and-conditions", "publisher_name": "Playstack", "support_website_url": null, "website_url": "http://www.dickwilde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interacti
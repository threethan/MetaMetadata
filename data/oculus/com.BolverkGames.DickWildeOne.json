uluscdn.com&_nc_ss=8&oh=00_Afz3F43irx645kEj_Xfbht6gFA4Ib0ClEuXAn08Wy2-yKQ&oe=69B8031A"}, {"file_name": "12504696_1647823545527280_97121515643863040_n.png", "id": "2479864442371507", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821782_2479864452371506_6304139300377903639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rw06Y8a27lMQ7kNvwFSXmea&_nc_oc=AdmLHYq3XHwjt1G5q2wFRdjzDDtv7ATNLnA6Z-iX1hGsbLA0v8ZE4zsp3rtBa_fY4dw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwRVuNzVA7pJkqOnm9luBpHD7bOd6djBfhc8DPZs16W9A&oe=69B7E0AA"}, {"file_name": "12602069_395857384125124_8817570809330532352_n.png", "id": "929011539357194", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818860_929011542690527_5406921352790703223_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFLhSiI4aOQQ7kNvwGhyyAs&_nc_oc=AdmqvC43wvdbnneAx7LK0TR3VaZKYLHHppDVjlYI6NZEOxQJ8dl7lD9EMV_d1JlrkLk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyuiKnkMHyV-mO0FBicH8CgHKwktkSKPOZ7ZNeptmXOPQ&oe=69B7F962"}, {"file_name": "12602069_792270404257179_2177770683629568000_n.png", "id": "1188101426316842", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820923_1188101429650175_2476170459749552977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5k8OKMeUuW4Q7kNvwEPU6Mr&_nc_oc=Adn1OEw0gtCy4j22eDItklq8ogt-ZwDJUfFpqnr1oKEm31PLeCawHniw1sSXK7WCmew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxllRPIh_ySYLWow9m77zXyyhKCyzWRxREafGx0cE36Dg&oe=69B7EE35"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dick Wilde", "keywords": ["fps", "shooter", "arcade", "dick", "wilde"], "long_description": "OUTRAGEOUS HOMEMADE WEAPONS!\n\nGo crazy with the homemade arsenal of Dick Wilde! Nailguns, grenade launchers, electric bow and many more!\n\n9 UNIQUE LEVELS\n\nProgress though 9 unique levels in 3 different settings: swamp, tropical and northern!\n\nBIG VARIETY OF ENEMIES\n\nGiant alligators, rabid piranhas, electric eels, charging sharks, bats and many more! \n\nPARTY MODE\n\nHave a hoedown by sharing the headset amongst friends and compete for the highscore! \n\nEPIC BOSS FIGHTS\n\nDefeat giant boss monsters at the end of each level! Can Dick really take on a three story high turtle with a homemade bow? Can you?\n\nDISCLAIMER\n\nBolverk games does not support animal cruelty in any way, nor do we endorse heavy substance abuse, weapon crafting or having a messy home in a swamp. \n", "short_description": "Those pesky swamp critters are at it again! Scarin\u2019 off all the good folk who just want to go huntin\u2019 n\u2019 fishin\u2019 on their lakes and lagoons! We\u2019re talking piranhas, eels, \u2018gators - you name it! There\u2019s even been talk of a giant mutated Turtle on the loose! Good thing our fav\u2019rite gun-slingin\u2019, grenade-launchin\u2019, cross-bow firin\u2019 exterminator, Dick Wilde, is on standby to open up a can of whoop ass!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://playstack.com/privacy-policy/", "developer_terms_of_service_url": "https://www.playstack.com/terms-and-conditions", "publisher_name": "Playstack", "support_website_url": null, "website_url": "http://www.dickwilde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "247202025
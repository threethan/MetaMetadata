9330532352_n.png", "id": "929011539357194", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_929011542690527_5406921352790703223_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULo0XHO84sMQ7kNvwG3z_dg&_nc_oc=Adpe3I8mbpsO7G9F5W0Yt17eOpM_GacH4mEJ17ABukMW3PPUG6UZjBtR6XqqnptdT-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQlrCt9SfWd6ldlJgYthVpAD8ZDIUtaP0YcjvPWsLN4w&oe=6AC3D222"}, {"file_name": "12602069_792270404257179_2177770683629568000_n.png", "id": "1188101426316842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820923_1188101429650175_2476170459749552977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JgL-1Tl8DZkQ7kNvwG2rYgd&_nc_oc=AdqxNLwqOMoEo5kgZPODz3BLYHgVbGulrDzSvslF5gkKdudLcWE240hb0qEnKBmhzY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZuycf-SdsyGnPaw7IKrYVJWWOIMaZEiCYpO2bIzQx2Q&oe=6AC3C6F5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dick Wilde", "keywords": ["fps", "shooter", "arcade", "dick", "wilde"], "long_description": "OUTRAGEOUS HOMEMADE WEAPONS!\n\nGo crazy with the homemade arsenal of Dick Wilde! Nailguns, grenade launchers, electric bow and many more!\n\n9 UNIQUE LEVELS\n\nProgress though 9 unique levels in 3 different settings: swamp, tropical and northern!\n\nBIG VARIETY OF ENEMIES\n\nGiant alligators, rabid piranhas, electric eels, charging sharks, bats and many more! \n\nPARTY MODE\n\nHave a hoedown by sharing the headset amongst friends and compete for the highscore! \n\nEPIC BOSS FIGHTS\n\nDefeat giant boss monsters at the end of each level! Can Dick really take on a three story high turtle with a homemade bow? Can you?\n\nDISCLAIMER\n\nBolverk games does not support animal cruelty in any way, nor do we endorse heavy substance abuse, weapon crafting or having a messy home in a swamp. \n", "short_description": "Those pesky swamp critters are at it again! Scarin\u2019 off all the good folk who just want to go huntin\u2019 n\u2019 fishin\u2019 on their lakes and lagoons! We\u2019re talking piranhas, eels, \u2018gators - you name it! There\u2019s even been talk of a giant mutated Turtle on the loose! Good thing our fav\u2019rite gun-slingin\u2019, grenade-launchin\u2019, cross-bow firin\u2019 exterminator, Dick Wilde, is on standby to open up a can of whoop ass!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://playstack.com/privacy-policy/", "developer_terms_of_service_url": "https://www.playstack.com/terms-and-conditions", "publisher_name": "Playstack", "support_website_url": null, "website_url": "http://www.dickwilde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24140041818949300"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24692081087078701", "version": "1.0"}, "id": "2183945325455047", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23955319734088177", "is_concept": false, "latest_released_binary": {"__typename"
uluscdn.com&_nc_ss=8&oh=00_Afs_SNc-Fy6EhjysctL5TC9ZxS0ZwwCD3JQZboM3jQ_aOg&oe=69A9829A"}, {"file_name": "12504696_1647823545527280_97121515643863040_n.png", "id": "2479864442371507", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_2479864452371506_6304139300377903639_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7z0teg1fR9oQ7kNvwH4rV94&_nc_oc=AdkeVdSIR64yUTO4TuU7yOwHxvA_M3oukpSSkoRHOOIxG2fhupD2rFsDyq5IKqBDAls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsYcy_Q54t2UxGuFMSMkKkcuhWQ9PD9D3BTUWQ_nnyU6A&oe=69A9602A"}, {"file_name": "12602069_395857384125124_8817570809330532352_n.png", "id": "929011539357194", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491818860_929011542690527_5406921352790703223_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ja7yE3jWWcQQ7kNvwGwXPDT&_nc_oc=AdkQ1j5p53lbBj9cVRcxOzsYXbjXdv8DM6wBD_zXIkMMvWVqcfDxBAt0ft26kpAgkEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftafP_GG1WI-53AuOgrXWiR_cUam5jTC0COQLypD8EwMA&oe=69A978E2"}, {"file_name": "12602069_792270404257179_2177770683629568000_n.png", "id": "1188101426316842", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820923_1188101429650175_2476170459749552977_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAUQbAY3h6IQ7kNvwGQ5eh6&_nc_oc=Admw4dGCgB3P2h363g5BClL7N8-cmZnkabzc-4lXAmQ27RN4YFvEaXbI84YrEGYo_TI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfskFAjedGBfDs84b4KTVLD-pZC8mf-sqUr_3-d3yJEhwg&oe=69A96DB5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dick Wilde", "keywords": ["fps", "shooter", "arcade", "dick", "wilde"], "long_description": "OUTRAGEOUS HOMEMADE WEAPONS!\n\nGo crazy with the homemade arsenal of Dick Wilde! Nailguns, grenade launchers, electric bow and many more!\n\n9 UNIQUE LEVELS\n\nProgress though 9 unique levels in 3 different settings: swamp, tropical and northern!\n\nBIG VARIETY OF ENEMIES\n\nGiant alligators, rabid piranhas, electric eels, charging sharks, bats and many more! \n\nPARTY MODE\n\nHave a hoedown by sharing the headset amongst friends and compete for the highscore! \n\nEPIC BOSS FIGHTS\n\nDefeat giant boss monsters at the end of each level! Can Dick really take on a three story high turtle with a homemade bow? Can you?\n\nDISCLAIMER\n\nBolverk games does not support animal cruelty in any way, nor do we endorse heavy substance abuse, weapon crafting or having a messy home in a swamp. \n", "short_description": "Those pesky swamp critters are at it again! Scarin\u2019 off all the good folk who just want to go huntin\u2019 n\u2019 fishin\u2019 on their lakes and lagoons! We\u2019re talking piranhas, eels, \u2018gators - you name it! There\u2019s even been talk of a giant mutated Turtle on the loose! Good thing our fav\u2019rite gun-slingin\u2019, grenade-launchin\u2019, cross-bow firin\u2019 exterminator, Dick Wilde, is on standby to open up a can of whoop ass!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://playstack.com/privacy-policy/", "developer_terms_of_service_url": "https://www.playstack.com/terms-and-conditions", "publisher_name": "Playstack", "support_website_url": null, "website_url": "http://www.dickwilde.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "247202025
ry_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "214260173762053"}]}, "change_log": "Revamped online mode to allow hosting and joining rooms with up to 4 players in co-op and versus modes.\n\nAdded faster movement speed.\n\nAdded smooth jump.\n\nAdded smooth turn.\n\nAdded HUD scoreboard to make it easier to see the score.\n\nOptimized performance for improved framerate and battery time.\n\nMade ball explode and disappear when no longer in play.\n\nFixed audio issue that caused symptoms such as the ball getting stuck.\n\nImproved splash screen texture filtering.\n\nTweaked bot set behavior: Moved set target 0.5 m from the player's head position along the center line towards the middle of the court. Moved set target slightly higher (at 0.5 m instead of 0.3). Moved set target slightly out from the net (0.4 m instead of 0.3). Increased chance of set (if pass) to 100% for pro bots. Removed rule that said that player head had to be higher than 1.5 m above ground.", "created_date": 1639745350, "id": "4808087099256260", "version": "1.6.0", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3858203824244597", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5489542257777404"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "214260173762053"}]}, "change_log": null, "created_date": 1613941936, "id": "3903287173069595", "version": "1.5.1", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinar
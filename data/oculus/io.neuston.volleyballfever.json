er", "keywords": [], "long_description": "Volleyball Fever is a VR sports game where you can chill out with friends online, or just play solo with bots.\n\nStick your feet in the warm sand next to the blue ocean, play a match in the moonlight, or go inside for those serious matches.\n\nEasy to pick up with realistic and intuitive physics.", "short_description": "Volleyball Fever is a VR sports game where you can chill out with friends online, or just play solo with bots."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.neuston.io/volleyball-fever-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Neuston AB", "support_website_url": "http://www.neuston.io/", "website_url": "http://www.neuston.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS", "SOCIAL", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "1101878107232388"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "810211885476848"}, {"status": "PUBLISHED", "id": "1542605180547882"}, {"status": "PUBLISHED", "id": "1677870989509929"}, {"status": "PUBLISHED", "id": "204378357767849"}]}, "baseline_offer": {"id": "204378357767849"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "810211885476848"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5489542257777404", "version": "1.7.0"}, "id": "214260173762053", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3858203824244597", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5489542257777404"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "214260173762053"}]}, "change_log": "Daily challenges, new hand graphics, and new soundtrack.", "created_date": 1659098490, "id": "5489542257777404", "version": "1.7.0", "version_code": 3, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3858203824244597", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5489542257777404"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "214260173762053"}]}, "change_log": "Revamped online mode to allow hosting and joining rooms with up to 4 players in co-op and versus modes.\n\nAdded faster movement speed.\n\nAdded smooth jump.\n\nAdded smooth turn.\n\nAdded HUD scoreboard to make it easier to see the score.\n\nOptimized performance for improved framerate and battery time.\n\nMade ball explode and disappear when no longer in play.\n\nFixed audio issue that caused symptoms such as the ball getting stuck.\n\nImproved splash screen texture filtering.\n\nTweaked bot set behavior: Moved set target 0.5 m from the player's head position along the center line towards the middle of the court. Moved set target slightly higher (at 0.5 m instead of 0.3). Moved set target slightly out from the net (0.4 m instead of 0.3). Increased chance of set (if pass) to 100% for pro bots. Removed rule that said that player head had to be higher than 1.5 m above ground.", "created_date": 1639745350, "id": "4808087099256260", "version": "1.6.0", "version_code": 2, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3858203824244597", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "5489542257777404"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "214260173762053"}]}, "change_log": null, "created_date": 1613941936, "id": "3903287173069595", "version": "1.5.1", "version_code": 1, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
09&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=832hXByQ83cQ7kNvwG5EyhZ&_nc_oc=AdrVc2PEkI81lBbIdwFiMeG-kH576XUu9-yHSI7WRX2ZmIONe9Sjp6I8gVcxHHtYwXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYNOoA8IzOQoLc2kD8dB9IatrblBiR3b5yIv2NL67k_g&oe=6AA2C7AE"}, {"file_name": "ScreenShot_03_2560x1440.png", "id": "1956694731931275", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298150_1956694735264608_4901817897400918377_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_sIvR1q9tgQ7kNvwG74voM&_nc_oc=Adrc5Bp-vNY2C-Wye7N2X9xueKtie0hQpW4ltJYoVrcN8KyqU7vFd0ENlaC8f0NGjMU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9U8Cgzr_3CCbHlIwUh0fvMrNrEcs1peJCS0l_qoT27w&oe=6AA2AC9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brainrot Survival", "keywords": ["MR", "Passthrough", "Meme", "Shooter", "Arcade"], "long_description": "# **Shatter your walls. Rescue the Brainrot.**\n\nWatch your room's physical boundaries crumble to reveal deep space. **Mow down hundreds of enemies** swarming the void outside your walls in this high-density **MR Space Shooter**.\n{748217571349302}\nEngage in intense **Passthrough Combat** to **rescue the Brainrot**\u2014your only goal is to save them from destruction. This isn't just a game; it's the ultimate **stress-relieving MR experience** where you defend the Brainrot from the safety of your living room.\n\n---\n\n### **Game Features:**\n{1419686969866160}\n* **Insane Scale:** Face **hundreds of enemies on screen** simultaneously in the deep space outside your walls.\n\n{886175917646318}\n* **Window to War:** Your walls disappear, turning your room into a safe haven overlooking the galactic battlefield.\n\n{2969329879923652}\n* **Rescue the Brainrot:** Snatch the legendary Brainrot characters from the enemy clutches before they are lost forever.\n\n{1274194554554068}\n{1479114093555059}", "short_description": "Shatter your walls. Rescue the Brainrot.\n\nWatch your walls crumble to reveal deep space in this high-density MR Space Shooter. Mow down hundreds of enemies swarming the void outside your room in intense Passthrough Combat.\n\nYour mission is simple: Snatch legendary Brainrot characters from destruction. Experience the ultimate stress-relieving chaos with swarms of enemies on screen, turning your room into a safe haven overlooking the galactic battlefield."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.attention.games/privacy", "developer_terms_of_service_url": "https://www.attention.games/terms", "publisher_name": "Attention Games", "support_website_url": null, "website_url": "https://www.attention.games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25645099118516216"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295652_1230406158486652_1661076909895036489_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmT7ZPH6UjIQ7kNvwGCzYBM&_nc_oc=AdrZoBirbB5U9cz8KJkxk1Dz-1EUnCSvF2dAv5QPcsU5jiCexk1l9__fziTzztNNrho&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYr7AbyaPA9Ae4yArTDIgv2IR62QkWBp2gXF-2wMmnJQ&oe=6AA2B4BD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Brainrot 
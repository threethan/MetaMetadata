ePA&oe=6AF20608"}, {"file_name": "3345ee65d72b566eefd1a85dd99a4e70(1).png", "id": "2686226111834312", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823905_2686226115167645_168206484506475733_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y3uFvWaCf2kQ7kNvwGXl24S&_nc_oc=AdrHkm8Y9U1yx972GtEzRS7hMBgmgZUA5q71EhjTMHVifxEnzEoEJZQrYtW1wPW-B54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScbIpb0YWLR7qOsaviZ8gIYjk-Ebykrp5-dwvDM-k52w&oe=6AF1D8C1"}, {"file_name": "3345ee65d72b566eefd1a85dd99a4e70.png", "id": "2163125884617268", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_2163125887950601_2782918534699932642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qo-BeJjc8XUQ7kNvwFmJjTE&_nc_oc=Adrl3OfU3vtXErVZ_OTkRtIdaWpfn51f06mMO08FqjQk6nsTjERgqzmmQ-2whwC94Lg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVYzV8bQrOnYGcPvOwqR82ncK5EMuapZJ5NjpZLgG_wQ&oe=6AF1DA0E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TRAILERTHUMB.png", "id": "1023370064097664", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823351_1023370070764330_8505332831366560657_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRjVtbyhRO0Q7kNvwEHaHbB&_nc_oc=AdoYPzN_aGlxZWEbe_FWUMOWIGbHeskf1GqngrlRhapCDb9zy8Gp8Nbz3qTEKccvZZw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdjrfTw1gGBLW9ymtm8EWByQJPRl2vwlQeLqgg5s4JeQ&oe=6AF1E5DD"}, "display_name": "Monke Fighters", "keywords": ["fangame", "fighter", "bvr", "physics", "custom"], "long_description": "**Welcome to Monke Fighters \u2014 a VR experience built entirely by and for the community!**\n\n# WHAT MONKE FIGHTERS IS ALL ABOUT:\n\n**Community & Creator Driven: Creators shape this game. Build, share, and play custom maps seamlessly powered by mod.io.**\n\n**Rewarding Progression: Level up, conquer story mode challenges, and track your progress as you master the game.**\n\n**Find Your Tribe: Connect with a hyped community of creators, modders, and players.**\n\n**Whether you're here to jump into custom player-built worlds or grind through story levels, there's a place for you here.**\n\n**Download Monke Fighters today and join the community where you belong!**", "short_description": "Welcome to Monke Fighters! This game is all about the community and the creators who help make it what it's truly meant to be. Whether it's playing custom maps built through mod.io or diving into progression like levelling up and beating story mode, this game is for you! Download the game now to join the community where you belong!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/monke-fighters-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "BrassVr", "support_website_url": null, "website_url": "https://discord.gg/Nr9vYfVMae", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1327565540447788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825503_1063538239966293_8230142135032970762_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lTEh65-s0vIQ7kNvwFB_WyV&_nc_oc=AdpChBDiTvj00YHmic07-rAxEmgFlaG1xglkJ2k1g3n5VqVS0Zehj7GI_DRdNthqjro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculu
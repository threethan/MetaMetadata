c_sid=6e7a0a&_nc_ohc=5JT9vXy5aDkQ7kNvwEemWpt&_nc_oc=AdrkB2h656OX-RPmgk6mVm6Ol1dxWa2K3Tyf3BWRnNcGlbXOPuiP39QVDrm5nb5Iesc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1QqC8HDuz-ldJReGodWB4miLzVkyTDuH5BM-9ocgfRQ&oe=6AA80AD4"}, {"file_name": "sitevision-screenshot-05.png", "id": "1350505950566941", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491824328_1350505957233607_2841861892846709987_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7Mc5_KpiM8Q7kNvwG-67y-&_nc_oc=AdqhmCZFOdVrLaoWn2V_BT-Ul8iKbdcTMSvbHk4EomWyyg8Amw6y9SuyFRZUisFs25w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV6_bJkKAyl4VBv3TH25CYp9arz9KfngC9aYQ1L4S5Ow&oe=6AA804DE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Site Vision AR", "keywords": [], "long_description": "See your project at full scale, before it's built.\n\n Site Vision AR takes the 3D models you already have \u2014 and design models of your buildings and sites \u2014 and puts you inside them. Not a picture on a screen or a fly-through video, but the real thing at real size, where you can walk to a doorway and see how wide it actually is, stand in a room and feel the ceiling height, and step outside to look at the whole site from the ground.\n  \n How it works\n \nSign in to your Site Vision AR account directly in the headset with your username and PIN. Your projects appear in a list, ready to load. Pick one and it downloads to your headset with full textures, then builds itself around you.\n\n \n Explore it like it's really there\n \nWalk through your model at 1:1. Move around the site, step into rooms, and look at the details from any angle you\n like. \n \n Try out colours on the spot\n \n Point at any surface \u2014 a wall, a roof, a panel \u2014 and wash a colour over it. The texture and detail underneath stay visible, so you're seeing that finish on that material, not a flat block of paint. Change your mind as many times as you want,and clear it back to the original in a click. It's the fastest way to settle a colour argument with a client: show them, don't describe it.\n\nBuilt for the people who make the decisions\n \n Architects, builders, developers, surveyors, and their clients. Anyone who has had to explain a floor plan to someone who doesn't read floor plans. Ten minutes in the headset does wh", "short_description": "Step inside your own building and site models at full scale.\nSign in, download your projects, and walk through them before you build.\n\n\nYour building, life-size, before it exists. Download your Site Vision AR projects and walk through them in the\nheadset. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.sitevisionar.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Mattacode Studio", "support_website_url": "https://www.mattacodestudio.com/contact/", "website_url": "https://www.sitevisionar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1732757251180495"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823310_2092219178036528_4418294009670030307_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HwEz9hlb5oQ7kNvwG6lyAY&_nc_oc=AdpGcYnpoM8-RllpWfvSVBfI985H4TfDklk9oYn7N2dkxBVufVv2VRA4Ls3NnOFwoYc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_s
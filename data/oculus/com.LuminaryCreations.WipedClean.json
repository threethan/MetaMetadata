e8FJONCoFO-Lb9Pv3Q-Czm0U2DK_M_4AW61L4tkrhbA&oe=6B0EF78F"}, {"file_name": "Code_2560.png", "id": "884457556448552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982503_884457559781885_6404999190527378083_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7CZkDNjvr_8Q7kNvwGFNUSJ&_nc_oc=Adoqvf1sx-aMfIJnTvXZcpoTOJ8gF3zfQhZMmn_JfDWjeRa-vCr2A0B30d06y1pJyRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUU4FlJ8T6G_EX7qqNjt_pWKz1OugtL8Mo0whz3-lIfHQ&oe=6B0EFCAC"}, {"file_name": "Image Sequence_019_0005.png", "id": "1607228460210325", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974700_1607228463543658_6729869300700556374_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCF8fGkuyIoQ7kNvwEtFBB0&_nc_oc=AdplyCC9k7piDJhlT0_g-XSOe-zQoyZtkfgkLp1ojCMODHw7FgaaVw8yIavACLSdkfk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWdKzW8O8NrhbUJ8wfiPbxvsnAEntgg2WySoywZ-iSNhw&oe=6B0F09D5"}, {"file_name": "Image Sequence_018_0004.png", "id": "517505127643893", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035419_517505130977226_7632472575508111921_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rVIAy6VT6MQ7kNvwFuUOcL&_nc_oc=Adp5V7ixvcOYZjfTfozuN7wegJPWmWTKf0WJ7PHSIHNQ6CT77iL_zGpF2gfWSeIOGiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWfYo48Cpsbq_oFms9KNbXzo0DuXJPk5mAH7UCpMRorYw&oe=6B0F15D0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wiped Clean", "keywords": ["WipedClean", "Cleaning", "CrimeSceneClean", "CleaningGame", "murdermystery"], "long_description": "Wiped Clean \u2013 Game Overview:\n\n**Undercover Agent**: Play as an undercover agent posing as a crime scene cleaner to infiltrate a dangerous criminal organization.\n\n**Crime Scene Restoration**: Clean up murder scenes by removing blood, footprints, and trash. Use a water spray and many other tools to find and remove all evidence.\n\n**Explore for Clues**: Investigate the environment to learn more about the dead through clues scattered across ransacked environment.\n\n**Body Disposal**: Carry the bodies and discreetly transport them to isolated locations, hiding evidence of the crime.\n\n**High-Stakes Story**: Every cleanup brings you closer to uncovering the identity of the most dangerous hitman, but with each clue, you risk exposure.\n\n**Immersive Environment**: Feel the tension as you navigate dark, gritty locations filled with secrets that reveal the true story behind each murder.\n\n**Constant Threat**: Stay one step ahead of the criminal organization\u2014can you maintain your cover and solve the case before they catch on?\n\nAre you ready to clean up the mess and catch the Hitman, or will you end up on the hit list?", "short_description": "Step into the shoes of an undercover agent posing as a crime scene cleaner in \"Wiped Clean.\" Unravel dark secrets by restoring crime scenes, scrubbing away blood, and piecing together shattered environments. But be quick\u2014the deeper you dig, the closer you get to the deadly hitman. Clean up the evidence, hide the bodies, and infiltrate a criminal organization from the inside. Can you wipe the slate clean before it\u2019s too late?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/about-5", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": null, "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
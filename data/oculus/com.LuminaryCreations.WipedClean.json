n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yGWa5oYKiq8Q7kNvwFnnnqQ&_nc_oc=AdoOwG8bV7EoyiTvTo2jciFKxTf5AtEaUTvH4NY2Fastj2ouNEOXboF-bjxkFcpsEhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2XXEzZSr9hyw5Zau3AzJ3Gyuu1uIm8oEcsFhyADytHpQ&oe=69F0BC1C"}, {"file_name": "Forest_1 2560.png", "id": "1278973457235517", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295588_1278973460568850_3263502089001510899_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEk6JeTnPGsQ7kNvwHWOcv5&_nc_oc=AdoAbyC7IjGxzOTUwcKjrnYv_jb7J6S2ksfQ3yZNnAr-f_2iQt9a8qVperdJ3JStoNQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af3p1pBv9hpkup54yZ-JZRF5r2xG5aE1AwGMww5TB21_sQ&oe=69F0B000"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest cover 2560.png", "id": "703251652768365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828806_703251656101698_8159365136596538566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZ0lVfqFB9cQ7kNvwHMZmnk&_nc_oc=Adr3QnjYzt8LOLEoxzhKd4_6Hv7U9Tf9738cTwo7rEs1DcUXRIJfhHdge3eyOpeT4_c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af20ykBjNsRDfFdl2Jo-fCxBl2OUEOsxwZJP2TtaR3QZnA&oe=69F0B445"}, "display_name": "Wiped Clean", "keywords": ["WipedClean", "Cleaning", "CrimeSceneClean", "horror", "simulator"], "long_description": "You\u2019re not just a cleaner. You\u2019re an undercover agent, infiltrating the world of **crime and insanity** by posing as a cleaner, secretly collecting evidence against a mysterious hitman. The hitman runs a large organization called the Syndicate.\n\n{651211397826643}\n\nThe deeper you dig, the closer you get to uncovering how he operates\u2014and how he does his assassinations.\n\n{841072921692949}\n\nThe game has a scary layer. As you explore a crime scene, unsettling things could happen\u2014shadows, whispers & apparitions.\n\n{1360261155820761}\n\n**Your mission**: Infiltrate the Syndicate, and capture the Hitman. The Syndicate doesn\u2019t tolerate failure. And they definitely don\u2019t tolerate rats.\n\n{2027694001311810}\n\nEach dead body has a background story of their own and you can explore more around to gather evidence and know more about the dead. The more you explore, the more rewarding it is. \n\n{4109581822642810}\n\n**Talk to the Devs and join our community on Discord**:  https://discord.gg/cK4aG9sp8f\n\n\n", "short_description": "You play as an undercover agent cleaning crime scenes and secretly collecting evidence to capture the ruthless Hitman."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": "https://www.luminarycreations.net/contact-us", "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24552566764428874"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825052_24069525832656540_7011981076700192026_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBWKssdKIqMQ7kNvwHf8mrT&_nc_oc=AdrPJswDkju5_5zSDfpn2G5plzCz--D_dNq6gfljg1LsCH5bHlLvy8q-G4XYw6KWnvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1-tqhiBPCWULuxl86xoPXg8Hs1fuIjmaNIdiQCEyi_NA&oe=69F0BB9A"}, "is_
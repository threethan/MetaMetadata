ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491828816_1114708513879175_8634699763884058537_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yi18tZzOii0Q7kNvwGFgeny&_nc_oc=AdpaMM65Z-m5Kswh0P8_TZ20ZC3l04miScsPxzEvTLMaPWEKoa4AEe59J0PvnWlHRlo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9zA9t6AXajzmqbCkM2rvYsE95NmBlKg_BguQqIRbDYQ&oe=6AC1091C"}, {"file_name": "Forest_1 2560.png", "id": "1278973457235517", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499295588_1278973460568850_3263502089001510899_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_aqdV4j9xIQ7kNvwEmmlsC&_nc_oc=AdptQ3i1fmlhBzW1IOORpiBKuQy-6rDssQ-eQSnbeTC_z60NVuBwQtqXzjZNtaAIjRo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSqDyDRPC3QJUbNkdJsFGtkU5ShDRxI5Himv3wNPhJog&oe=6AC13540"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest cover 2560.png", "id": "703251652768365", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828806_703251656101698_8159365136596538566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VLHGYsamokQ7kNvwFEgWVJ&_nc_oc=AdqfkZ0zqkuzaM32MvFPzEESpYkNLKZP_iefnR72P4CaNhusxno5vs4xpA9FPPjIEv8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3wrzIYtwkzBJybPxEIO3o6eGxqqKokoypI8XD2Hh7xw&oe=6AC10145"}, "display_name": "Wiped Clean", "keywords": ["WipedClean", "Cleaning", "CrimeSceneClean", "horror", "simulator"], "long_description": "You\u2019re not just a cleaner. You\u2019re an undercover agent, infiltrating the world of **crime and insanity** by posing as a cleaner, secretly collecting evidence against a mysterious hitman. The hitman runs a large organization called the Syndicate.\n\n{651211397826643}\n\nThe deeper you dig, the closer you get to uncovering how he operates\u2014and how he does his assassinations.\n\n{841072921692949}\n\nThe game has a scary layer. As you explore a crime scene, unsettling things could happen\u2014shadows, whispers & apparitions.\n\n{1360261155820761}\n\n**Your mission**: Infiltrate the Syndicate, and capture the Hitman. The Syndicate doesn\u2019t tolerate failure. And they definitely don\u2019t tolerate rats.\n\n{2027694001311810}\n\nEach dead body has a background story of their own and you can explore more around to gather evidence and know more about the dead. The more you explore, the more rewarding it is. \n\n{4109581822642810}\n\n**Talk to the Devs and join our community on Discord**:  https://discord.gg/cK4aG9sp8f\n\n\n", "short_description": "You play as an undercover agent cleaning crime scenes and secretly collecting evidence to capture the ruthless Hitman."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": "https://www.luminarycreations.net/contact-us", "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24552566764428874"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825052_24069525832656540_7011981076700192026_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cU7rjkRhJYIQ7kNvwGpqvdI&_nc_oc=Adp5HZ5sxKXn9BvVCwmIBpEYD1S2iqp73BwJZWHfnld6cbh3Vbm
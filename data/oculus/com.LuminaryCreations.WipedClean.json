-25/38982517_373306275717128_5699658659435046241_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q9qKxzO9dmQQ7kNvwFmbP_5&_nc_oc=AdqtjX-Zzs4ti-iYO74KDdUkClvjPos0esuM9JHeP_tSBER74HzIABbbAASYyOmyh38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_Xs6PiFdZFmrBShkaA0yfJhVb9ccHMuQvh-ub7xXEow&oe=6AEF607C"}]}, "id": "3655209578066338", "locale": "en_US", "screenshots": [{"file_name": "Cleaning_2560.png", "id": "1102699727811141", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031454_1102699731144474_3761858524748619896_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQNmOXSNbKUQ7kNvwHJa4cL&_nc_oc=AdrFs_JsTxy99B2Y_GspxEiteqRrzUgFQYIJ0kT0SOLrenzWxKqEi-bnUqmXGp76MMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlBmY-eGVzuI64l9Y-gD7KjriKLx0574zxMlRkmTdJaA&oe=6AEF44C3"}, {"file_name": "Image Sequence_020_0060.png", "id": "888643503222484", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036675_888643506555817_6691239226455080811_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyAhyo0f1HAQ7kNvwFfxVhq&_nc_oc=Adp-2MmavkJ9FbgrPgCJw2xnETMPn3opT9KO7nPyod3gjKBBIU_SsvmfKfYSfQNstwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLq_efgJgmkbzuoUu97-Oet_OSGGupsN1vVTSd8DV1Vg&oe=6AEF538F"}, {"file_name": "Code_2560.png", "id": "884457556448552", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982503_884457559781885_6404999190527378083_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSkdP3_HM9IQ7kNvwH8aJ3k&_nc_oc=AdrTWKjVzh6X4uB5dRGuqJV79jQ-SxXVWOCSt_Y6k_h-EueM-e44h190hE-tZxxQ-v8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ602B6wxRIEPSsclnEqEk9lJtfJZyyHjFr5psg3Uo6uw&oe=6AEF58AC"}, {"file_name": "Image Sequence_019_0005.png", "id": "1607228460210325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974700_1607228463543658_6729869300700556374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hf-WvWtWi7UQ7kNvwHJ0WoU&_nc_oc=Adrx7q5KMRMg45cYLmuNYIOkhoFt8XDNgM7jjqbqegu8z8uztNWiJ5YYpH_mn6o1H3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8RIEZ5z2kUG9gGItVPBeF_iK1hspGj4zP2-N5QxzBZQ&oe=6AEF65D5"}, {"file_name": "Image Sequence_018_0004.png", "id": "517505127643893", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035419_517505130977226_7632472575508111921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVPZ5xKrOzAQ7kNvwG9aOD9&_nc_oc=Adr-9ORdQyqbHl1imfB1AMKfTd5ttZzJlaxlJ8sf_E_jMmqOxgbdcPunM5YSpdJkNUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjFcs-baKMS87oDCyqDyHK54X7KFRvQtlRFowc1wLgBg&oe=6AEF3990"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wiped Clean", "keywords": ["WipedClean", "Cleaning", "CrimeSceneClean", "CleaningGame", "murdermystery"], "long_description": "Wiped Clean \u2013 Game Overview:\n\n**Undercover Agent**: Play as an undercover agent posing as a crime scene cleaner to infiltrate a dangerous criminal organization.\n\n**Crime Scene Restoration**: Clean up murder scenes by removing blood, footprints, and trash. Use a water spray and many other tools to find and remove all evidence.\n\n**Explore for Clues**: Investigate the environment to learn more about the dead through clues scattered across ransacked environment.\n\n**Body Disposal**: Carry the bodies and discreetly transport them to isolated locations, hiding evidence of the crime.\n\n**High-Stakes Story**: Every cleanup brings you closer to uncovering the identity of the most dangerous hitman, but with each clue, you risk exposure.\n\n**Immersive Environment**: Feel the tension as you navigate dark, gritty locations filled with secrets that reveal the true story behind each murder.\n\n**Constant Threat**: Stay one step ahead of the criminal organization\u2014can you maintain your cover and solve the case before they catch on?\n\nAre you ready to clean up the mess and catch the Hitman, or will you end up on the hit list?", "short_description": "Step into the shoes of an undercover agent posing as a crime scene cleaner in \"Wiped Clean.\" Unravel dark secrets by restoring crime scenes, scrubbing away blood, and piecing together shattered environments. But be quick\u2014the deeper you dig, the closer you get to the deadly hitman. Clean up the evidence, hide the bodies, and infiltrate a criminal organization from the inside. Can you wipe the slate clean before it\u2019s too late?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/about-5", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": null, "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7821594731286007"}}]}, "scheduled_offers": {"count": 12, "nodes": [{"status": "PUBLISHED", "id": "2318177329010887"}, {"status": "PUBLISHED", "id": "26600436959644605"}, {"status": "PUBLISHED", "id": "1795847777779325"}, {"status": "PUBLISHED", "id": "875454928581292"}, {"status": "PUBLISHED", "id": "1236929901600826"}, {"status": "PUBLISHED", "id": "860833619962250"}, {"status": "PUBLISHED", "id": "1517456955908952"}, {"status": "PUBLISHED", "id": "612725251530967"}, {"status": "PUBLISHED", "id": "729868002801540"}, {"status": "PUBLISHED", "id": "963220396024920"}, {"status": "PUBLISHED", "id": "11588067
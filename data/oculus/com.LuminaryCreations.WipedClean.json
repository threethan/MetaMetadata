9869300700556374_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09iT64A5DysQ7kNvwGRziM9&_nc_oc=AdoXKAOyHsjO8Anu-dIOl_oomP4mSoB3lUI_8ETFJ6SvZcszXFQK9nhnCgl9YHsZCXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2eU6fwIA0RwgoFFQdOinf1f9mTLW0TAauYa8nVrprfhQ&oe=69E38D15"}, {"file_name": "Image Sequence_018_0004.png", "id": "517505127643893", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035419_517505130977226_7632472575508111921_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pmCbL4G69msQ7kNvwHJnxhO&_nc_oc=AdqHdRKvPyGQpUGClKJsGqqcS0fBq5r__OaYoY0OsxMOEi1diMQ3Cvq9friSKlsA_Fk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YyPYPf757vj7EDqRk0VwOcDQLICF48U9mrbw3oWxG3g&oe=69E39910"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wiped Clean", "keywords": ["WipedClean", "Cleaning", "CrimeSceneClean", "CleaningGame", "murdermystery"], "long_description": "Wiped Clean \u2013 Game Overview:\n\n**Undercover Agent**: Play as an undercover agent posing as a crime scene cleaner to infiltrate a dangerous criminal organization.\n\n**Crime Scene Restoration**: Clean up murder scenes by removing blood, footprints, and trash. Use a water spray and many other tools to find and remove all evidence.\n\n**Explore for Clues**: Investigate the environment to learn more about the dead through clues scattered across ransacked environment.\n\n**Body Disposal**: Carry the bodies and discreetly transport them to isolated locations, hiding evidence of the crime.\n\n**High-Stakes Story**: Every cleanup brings you closer to uncovering the identity of the most dangerous hitman, but with each clue, you risk exposure.\n\n**Immersive Environment**: Feel the tension as you navigate dark, gritty locations filled with secrets that reveal the true story behind each murder.\n\n**Constant Threat**: Stay one step ahead of the criminal organization\u2014can you maintain your cover and solve the case before they catch on?\n\nAre you ready to clean up the mess and catch the Hitman, or will you end up on the hit list?", "short_description": "Step into the shoes of an undercover agent posing as a crime scene cleaner in \"Wiped Clean.\" Unravel dark secrets by restoring crime scenes, scrubbing away blood, and piecing together shattered environments. But be quick\u2014the deeper you dig, the closer you get to the deadly hitman. Clean up the evidence, hide the bodies, and infiltrate a criminal organization from the inside. Can you wipe the slate clean before it\u2019s too late?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/about-5", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": null, "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7821594731286007"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "26600436959644605"}, {"status": "PUBLISHED", "id": "1795847777779325"}, {"status": "PUBLISHED", "id": "875454928581292"}, {"status": "PUBLISHED", "id": "1236929901600826"}, {"status": "PUBLISHED", "id": "860833619962250"}, {"status": "PUBLISHED", "id": "1517456955908952"}, {"status": "PUBLISHED", "id": "612725251530967"}, {"status": "PUBLISHED", "id": "729868002801540"}, {"status": "PUB
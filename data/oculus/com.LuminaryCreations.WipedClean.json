.com&_nc_ss=7f20f&oh=00_AQI4DptRza5qENEK31_DTZtX8k-pPj9ex5u0Z2C-f8tjow&oe=6AAEA93C"}, {"file_name": "Icon.png", "id": "657879813715104", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821989_657879817048437_2711140452065723642_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-Qaw6Tvd5kQ7kNvwEGApV4&_nc_oc=AdpqRdTkJ6Ce-51e-YTrATWqIKO_6NU2ih624m_dZmpLfcJaGDCy7lLZWTRVrk-i5T0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEO8LwA1f8Vh4B1X91OcjLv9EXYUgCv0t63EBawb3Igw&oe=6AAE85E4"}]}, "id": "1125581946386612", "locale": "en_US", "screenshots": [{"file_name": "Shadows in tunnels.png", "id": "3734934380133245", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491819511_3734934383466578_5307616025151692811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IwmvoXZnssQ7kNvwHhYEsh&_nc_oc=Adpy2TJajJiRfIT4wk1Yctf5vRBe_oH0FUy-oSyzomGQVWE9NMRPqZjBTWMsI5wAbKY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3_UQPj1XKqW_MoPPVu1KDSe8XwxxvDYghzZQm770xXQ&oe=6AAE8DF7"}, {"file_name": "Footprints (1).png", "id": "1452040755933937", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818943_1452040762600603_4402482683115110893_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRpFdEkZf2oQ7kNvwGTqfRn&_nc_oc=Adp9NsV1RpgfUzA09shAGnpjiP717PC0A8xBGvWyBkZcNsn3iwJmIE0LUjiMjSS4B9Q&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOxIRbzY-EsaOfu7eqq_uECM96bjICgUkFHPgG2NUCqQ&oe=6AAE94F7"}, {"file_name": "Skeleton.png", "id": "1421145702269975", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823395_1421145705603308_2151851520155467657_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8bYbxwbkeTUQ7kNvwHTE56m&_nc_oc=AdojYVUUGu_EqIKHI4BlDaCXvc0qMYLof5-XTSJYo1FJ8IEWt9GEWEWtfOcaOhkgcIs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLQ_dP8PrWYJnbW1Kacs_LRdbSuelyOF1EfbRFk8npAw&oe=6AAE9D1D"}, {"file_name": "Asylum_1.png", "id": "1114708510545842", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828816_1114708513879175_8634699763884058537_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MVIGllyJt_AQ7kNvwFl2qXw&_nc_oc=AdoywnKbrfKtrTXm0h8ngfqVVmGoO2CVBtxA-WDXm8xw1kvlJbeJE4J2E9KO84PElBw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJv8FIAIl8fQmamaf9z0Boq3n5vvrI3thkToRAdwGjn5w&oe=6AAE941C"}, {"file_name": "Forest_1 2560.png", "id": "1278973457235517", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499295588_1278973460568850_3263502089001510899_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uV2NRm19Qr8Q7kNvwEX9fRK&_nc_oc=AdrwOaEfqnGnug-mv4a9OyJ3Wbbk9VSn-_Z3qTFyg23HoZxnumy8G50w5VR5gSBCfcY&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDeO-ByBxMyWHjyqimTJi0sE83XTCSrCc91nXLeh3tUg&oe=6AAE8800"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest cover 2560.png", "id": "703251652768365", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491828806_703251656101698_8159365136596538566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OcnHRyi08PYQ7kNvwFRNrWW&_nc_oc=AdolADjcC6RuLKBzpXfzBJuMbSxfPFB8gVsexGfGQzW3lV7ZPvMQIpyRfiu1OS3CNB8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAmUzqWwXSKbS4XCVn2LAhpI9aqFOiYTwV6BANLg8_nA&oe=6AAE8C45"}, "display_name": "Wiped Clean", "keywords": ["WipedClean", "Cleaning", "CrimeSceneClean", "horror", "simulator"], "long_description": "You\u2019re not just a cleaner. You\u2019re an undercover agent, infiltrating the world of **crime and insanity** by posing as a cleaner, secretly collecting evidence against a mysterious hitman. The hitman runs a large organization called the Syndicate.\n\n{651211397826643}\n\nThe deeper you dig, the closer you get to uncovering how he operates\u2014and how he does his assassinations.\n\n{841072921692949}\n\nThe game has a scary layer. As you explore a crime scene, unsettling things could happen\u2014shadows, whispers & apparitions.\n\n{1360261155820761}\n\n**Your mission**: Infiltrate the Syndicate, and capture the Hitman. The Syndicate doesn\u2019t tolerate failure. And they definitely don\u2019t tolerate rats.\n\n{2027694001311810}\n\nEach dead body has a background story of their own and you can explore more around to gather evidence and know more about the dead. The more you explore, the more rewarding it is. \n\n{4109581822642810}\n\n**Talk to the Devs and join our community on Discord**:  https://discord.gg/cK4aG9sp8f\n\n\n", "short_description": "You play as an undercover agent cleaning crime scenes and secretly collecting evidence to capture the ruthless Hitman."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": "https://www.luminarycreations.net/contact-us", "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24552566764428874"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825052_24069525832656540_7011981076700192026_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-RbfvWdbDsYQ7kNvwGxlLe5&_nc_oc=AdpW2pMjvKbTKk6J4MuFYHa6N1p8naOYb_4xQZ8
FzgeBsVYbpecKCTnNKMZskTrClJmUSEWwBPgb1I1k_A&oe=6AFDD40F"}, {"file_name": "Code_2560.png", "id": "884457556448552", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982503_884457559781885_6404999190527378083_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rn-tU0lch2QQ7kNvwGUHOYH&_nc_oc=AdpgsN1MLzQIr5FMXHpIIPYCayKZVeps6IEeg9TRgyDyhIdcCVgC4P75z5L5iFerPqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1gtZ4AVfgSGYA9vj5UYsZJleTj8Ig5htw3bIAXKaFGA&oe=6AFDD92C"}, {"file_name": "Image Sequence_019_0005.png", "id": "1607228460210325", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974700_1607228463543658_6729869300700556374_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FgQtJVYZL6kQ7kNvwHSLaI2&_nc_oc=Adp2AEzmzbWcOPz6MqRPHcijCfw-_B69uk6q9PJfCr8DfEROZZ-aqmrzt2NrQsc0fbM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRomCO_kq0GIMNsoESeO9ALM8scnlMYUQFae913tEBq8w&oe=6AFDAE15"}, {"file_name": "Image Sequence_018_0004.png", "id": "517505127643893", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035419_517505130977226_7632472575508111921_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJcAxylHUbAQ7kNvwHv87vx&_nc_oc=AdpmfLggCNyl3Z52qb0BhTx0bhul31pvu4rV2LdqkqjcekqB3oulRjq0-CULPI2LibE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQV0JdF_-S5mMs-VmSETPUY_uvTV1WyxikKaisFdj78LA&oe=6AFDBA10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Wiped Clean", "keywords": ["WipedClean", "Cleaning", "CrimeSceneClean", "CleaningGame", "murdermystery"], "long_description": "Wiped Clean \u2013 Game Overview:\n\n**Undercover Agent**: Play as an undercover agent posing as a crime scene cleaner to infiltrate a dangerous criminal organization.\n\n**Crime Scene Restoration**: Clean up murder scenes by removing blood, footprints, and trash. Use a water spray and many other tools to find and remove all evidence.\n\n**Explore for Clues**: Investigate the environment to learn more about the dead through clues scattered across ransacked environment.\n\n**Body Disposal**: Carry the bodies and discreetly transport them to isolated locations, hiding evidence of the crime.\n\n**High-Stakes Story**: Every cleanup brings you closer to uncovering the identity of the most dangerous hitman, but with each clue, you risk exposure.\n\n**Immersive Environment**: Feel the tension as you navigate dark, gritty locations filled with secrets that reveal the true story behind each murder.\n\n**Constant Threat**: Stay one step ahead of the criminal organization\u2014can you maintain your cover and solve the case before they catch on?\n\nAre you ready to clean up the mess and catch the Hitman, or will you end up on the hit list?", "short_description": "Step into the shoes of an undercover agent posing as a crime scene cleaner in \"Wiped Clean.\" Unravel dark secrets by restoring crime scenes, scrubbing away blood, and piecing together shattered environments. But be quick\u2014the deeper you dig, the closer you get to the deadly hitman. Clean up the evidence, hide the bodies, and infiltrate a criminal organization from the inside. Can you wipe the slate clean before it\u2019s too late?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/about-5", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": null, "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1008279844328894"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "
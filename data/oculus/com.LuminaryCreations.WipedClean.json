culuscdn.com/v/t64.5771-25/491823395_1421145705603308_2151851520155467657_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLzCb5tdyr4Q7kNvwFIqamg&_nc_oc=Adr76iLYyztao9n0WwexGOKG1kPIUnFq_F4YHj20wAidxXrnueNN-H6gZYZD-d0OVyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY_a8-U7v5v0-nq6wp4ZNfi_Q_C674ik_zE3q3joh2Fw&oe=6B005A1D"}, {"file_name": "Asylum_1.png", "id": "1114708510545842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828816_1114708513879175_8634699763884058537_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ezd-kOgPN1cQ7kNvwG94Nsf&_nc_oc=AdrYa9UMMoFiD7nQ6lVJ9NFsFu_nwffrzLVJOZWSDsRBa1cgyT9jVTOSs3kD9k4-tfk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiOcTSqIjWso7NGpZtFcY1sT4titjxEfBJbyj98nK8xA&oe=6B00895C"}, {"file_name": "Forest_1 2560.png", "id": "1278973457235517", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295588_1278973460568850_3263502089001510899_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxU7T0fAEX4Q7kNvwGYWgsW&_nc_oc=AdqOR2uRAM8fpQKRgmLBFJQdO-Uw0R9RlmN2KQqYxg4_GxL56H0MBo2-u6FoVYD5sqE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVtTLkbwohZsbeujD8S0-5FGBWNxOIsfShT7vh7L6LEw&oe=6B007D40"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest cover 2560.png", "id": "703251652768365", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828806_703251656101698_8159365136596538566_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XcEjQR8Nx08Q7kNvwEKzZLH&_nc_oc=AdoAQqrCzHZlkYBYKnUDt6QrLTmrNH76mgy-gsvS5s7p-3_KJFOBhj9ifPMrjjshjQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfWmB3LcIulWVA6dRwjqVnuJ44XLtQdPJEd7eF7S4CxQ&oe=6B008185"}, "display_name": "Wiped Clean", "keywords": ["WipedClean", "Cleaning", "CrimeSceneClean", "horror", "simulator"], "long_description": "You\u2019re not just a cleaner. You\u2019re an undercover agent, infiltrating the world of **crime and insanity** by posing as a cleaner, secretly collecting evidence against a mysterious hitman. The hitman runs a large organization called the Syndicate.\n\n{651211397826643}\n\nThe deeper you dig, the closer you get to uncovering how he operates\u2014and how he does his assassinations.\n\n{841072921692949}\n\nThe game has a scary layer. As you explore a crime scene, unsettling things could happen\u2014shadows, whispers & apparitions.\n\n{1360261155820761}\n\n**Your mission**: Infiltrate the Syndicate, and capture the Hitman. The Syndicate doesn\u2019t tolerate failure. And they definitely don\u2019t tolerate rats.\n\n{2027694001311810}\n\nEach dead body has a background story of their own and you can explore more around to gather evidence and know more about the dead. The more you explore, the more rewarding it is. \n\n{4109581822642810}\n\n**Talk to the Devs and join our community on Discord**:  https://discord.gg/cK4aG9sp8f\n\n\n", "short_description": "You play as an undercover agent cleaning crime scenes and secretly collecting evidence to capture the ruthless Hitman."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": "https://www.luminarycreations.net/contact-us", "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
.com&_nc_ss=7f20f&oh=00_AQJTAnodwKF_zPM_6vQG5zGDjJtnMbDmEZGgA-qMUbaJyA&oe=6AA9633C"}, {"file_name": "Icon.png", "id": "657879813715104", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821989_657879817048437_2711140452065723642_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEk3Ou5L7DQQ7kNvwFqEtaT&_nc_oc=Adp3V3ImkwzI2MakPlwNZ2ZVVfvYi-XCgNQvv0eVSN0M5lzNdpoxp4O54zFpHlE7Hvc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeTf4lq9BZ2CwFUFz9_YaVE7K65cLLvw_ph3eVqMCS3A&oe=6AA93FE4"}]}, "id": "1125581946386612", "locale": "en_US", "screenshots": [{"file_name": "Shadows in tunnels.png", "id": "3734934380133245", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491819511_3734934383466578_5307616025151692811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ec8baZQ0mnwQ7kNvwG1kou_&_nc_oc=Adq8dpAWGk1YdTk7HD4X-KdvnkZ9AIxhpMPSyOSPX6TI_YH75v8q78ctjsi3bBTEwo4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1yEgl7jkq3pkO0dn3wCRIdvfWkqnPRmQ_xM-bV8U2NA&oe=6AA947F7"}, {"file_name": "Footprints (1).png", "id": "1452040755933937", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818943_1452040762600603_4402482683115110893_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4O3w-eXXAYQ7kNvwH2VjQr&_nc_oc=AdrQ2hn21oe11OvCWQHrYrMDmroLxAwdYWpfhJ-b6g6GTwFJICbs85NGor_RAyFJGZQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI78k9bYkwqXFI3wu4B_W28cTThrn8Toh2xtFaSqKOk0Q&oe=6AA94EF7"}, {"file_name": "Skeleton.png", "id": "1421145702269975", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823395_1421145705603308_2151851520155467657_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HbaEnIt6nJcQ7kNvwF7taYZ&_nc_oc=AdoHJZQTAHaURIVEmVA_KId7Fz_eEVT7C71etRnu8rohdzxHylP3mlgps1SbiZE25uE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgUd_Y2bymFC8oEF5P5N10Zp6afjVj01YOhMgrXVBThw&oe=6AA9571D"}, {"file_name": "Asylum_1.png", "id": "1114708510545842", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828816_1114708513879175_8634699763884058537_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R-rcjKsjajoQ7kNvwEslp1e&_nc_oc=AdoZwuGb9rWVPzLg7-xAEbC5z1PCjAD39xc2qeSveGfghHg7MX53sTq3dpyj4EYtdDo&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgCnyirjKCTIjdDHxnlSBgqjr4qcHlqmRZukGMvuZ0sw&oe=6AA94E1C"}, {"file_name": "Forest_1 2560.png", "id": "1278973457235517", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499295588_1278973460568850_3263502089001510899_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kblIYDbiqlEQ7kNvwF20yzj&_nc_oc=Adp-vNjeuZ1KR1-GNKtugiEISu-GraSPAAF-Jt0is8JFtBa8wtU7h_UuFtukaStmjl4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6nd7SZ7dm3tnZofpLptnb_7YkF5axvyYe9iFp-qRzPA&oe=6AA94200"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest cover 2560.png", "id": "703251652768365", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491828806_703251656101698_8159365136596538566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nw7pW4kbUIQ7kNvwGzwNzT&_nc_oc=AdpfNcO-04Pfwb48x27MKUYxR8I_2LQVOVpcWLiiiP2InXFnA8DDeEHtodAuhDQhV20&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIunc5DqK7pSTxCMIFqCHDOPMguF5y8A8WGHXmycr0Hgw&oe=6AA94645"}, "display_name": "Wiped Clean", "keywords": ["WipedClean", "Cleaning", "CrimeSceneClean", "horror", "simulator"], "long_description": "You\u2019re not just a cleaner. You\u2019re an undercover agent, infiltrating the world of **crime and insanity** by posing as a cleaner, secretly collecting evidence against a mysterious hitman. The hitman runs a large organization called the Syndicate.\n\n{651211397826643}\n\nThe deeper you dig, the closer you get to uncovering how he operates\u2014and how he does his assassinations.\n\n{841072921692949}\n\nThe game has a scary layer. As you explore a crime scene, unsettling things could happen\u2014shadows, whispers & apparitions.\n\n{1360261155820761}\n\n**Your mission**: Infiltrate the Syndicate, and capture the Hitman. The Syndicate doesn\u2019t tolerate failure. And they definitely don\u2019t tolerate rats.\n\n{2027694001311810}\n\nEach dead body has a background story of their own and you can explore more around to gather evidence and know more about the dead. The more you explore, the more rewarding it is. \n\n{4109581822642810}\n\n**Talk to the Devs and join our community on Discord**:  https://discord.gg/cK4aG9sp8f\n\n\n", "short_description": "You play as an undercover agent cleaning crime scenes and secretly collecting evidence to capture the ruthless Hitman."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": "https://www.luminarycreations.net/contact-us", "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24552566764428874"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825052_24069525832656540_7011981076700192026_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jvpOewiq7cAQ7kNvwGKj_jl&_nc_oc=AdqdmLZFks-vpE1H__V0y6ERr0e5JAlulIgyShs
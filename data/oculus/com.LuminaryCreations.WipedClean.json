.com&_nc_ss=7f20f&oh=00_Af8452XV7xIdu0O1efc67aGnGYffJfQzkPQdfwXvLfxIfw&oe=6A3953BC"}, {"file_name": "Icon.png", "id": "657879813715104", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491821989_657879817048437_2711140452065723642_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAvRiRnFys4Q7kNvwHQqNaK&_nc_oc=AdqUTH3j21B-kT7MJURq91ga8tFHTx4--0B2fajKReQHbcKR58rqEvlicaZB0mSJlCI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZnPslFrRHXL82jKBjT_14W4VX1xCSKV-TGKhI8b9y-w&oe=6A393064"}]}, "id": "1125581946386612", "locale": "en_US", "screenshots": [{"file_name": "Shadows in tunnels.png", "id": "3734934380133245", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491819511_3734934383466578_5307616025151692811_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ZsbEIMrHdEQ7kNvwFbrDj6&_nc_oc=Ado3dl4lhqzOO8FkFzmuQVVKubO0Bl74lFKjohGxKcFnaoNkI87JpkMZci0TAELfBok&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Rjf8SkRi5PHFReTJloKEsAyPTGmilyU7INFORlaoNJA&oe=6A393877"}, {"file_name": "Footprints (1).png", "id": "1452040755933937", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818943_1452040762600603_4402482683115110893_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SUupITPban0Q7kNvwEy8jS7&_nc_oc=AdrGAp5bIqEpqX2zFdO5RCzXJPwQocyRskOtZSjoi6wZWMg8sZAiLDe0_P1I01sLW50&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w8m0TdO4PfgueStVnikudJyiom-Chr4D2ZPH83iL8iQ&oe=6A393F77"}, {"file_name": "Skeleton.png", "id": "1421145702269975", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491823395_1421145705603308_2151851520155467657_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7FeVtV68yJcQ7kNvwE7Uqpt&_nc_oc=AdqWwQc5tS0zpRGINjJ_VXdrjEoHShW-uZ_scKp11HvySEDc0bbG_PwnHV4M6AhMnN0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oNe-FXbstib6kYR-LNqZWzXtNYwAyYVSt7bNH4D-SVg&oe=6A39479D"}, {"file_name": "Asylum_1.png", "id": "1114708510545842", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491828816_1114708513879175_8634699763884058537_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zb5Sn6Lv0XAQ7kNvwEtN4bq&_nc_oc=AdopqYVDMueVGq5gyUnUpmH5_7PsXOpdoZ3W-nAsiulvqSYTdb2xJZgP919QoxPtqOE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2OIRCrmBt1GhXH6DBIyCw7cOmaTyRgk8xw4gLggwaLQ&oe=6A393E9C"}, {"file_name": "Forest_1 2560.png", "id": "1278973457235517", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499295588_1278973460568850_3263502089001510899_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ojj2NCk51sQ7kNvwF-B_AE&_nc_oc=Adp4IeIPXDkl0dWIymGLnt4snaHUQWzKzrE2caXpYrNu2wivwKiSvkIXoD4ySBi9Df8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6DV5Sbc3Q51xNO4lZ6mIipf35hh6Aq7D_p-AOCIR5gg&oe=6A393280"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Quest cover 2560.png", "id": "703251652768365", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491828806_703251656101698_8159365136596538566_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivco26qX0kwQ7kNvwFAWPTV&_nc_oc=Adrwrr_21pTeAY3TpU7YPPlc_5RfwSdAA8VoneG_dqkfMbzARnVKRLPW2WYtt7z3OO0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wAoK_lOZ0WzFHHzKKEDU52Kyamb1lCZMvZYPVJDLWJw&oe=6A3936C5"}, "display_name": "Wiped Clean", "keywords": ["WipedClean", "Cleaning", "CrimeSceneClean", "horror", "simulator"], "long_description": "You\u2019re not just a cleaner. You\u2019re an undercover agent, infiltrating the world of **crime and insanity** by posing as a cleaner, secretly collecting evidence against a mysterious hitman. The hitman runs a large organization called the Syndicate.\n\n{651211397826643}\n\nThe deeper you dig, the closer you get to uncovering how he operates\u2014and how he does his assassinations.\n\n{841072921692949}\n\nThe game has a scary layer. As you explore a crime scene, unsettling things could happen\u2014shadows, whispers & apparitions.\n\n{1360261155820761}\n\n**Your mission**: Infiltrate the Syndicate, and capture the Hitman. The Syndicate doesn\u2019t tolerate failure. And they definitely don\u2019t tolerate rats.\n\n{2027694001311810}\n\nEach dead body has a background story of their own and you can explore more around to gather evidence and know more about the dead. The more you explore, the more rewarding it is. \n\n{4109581822642810}\n\n**Talk to the Devs and join our community on Discord**:  https://discord.gg/cK4aG9sp8f\n\n\n", "short_description": "You play as an undercover agent cleaning crime scenes and secretly collecting evidence to capture the ruthless Hitman."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.luminarycreations.net/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Luminary Creations", "support_website_url": "https://www.luminarycreations.net/contact-us", "website_url": "https://www.luminarycreations.net/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24552566764428874"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825052_24069525832656540_7011981076700192026_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ufzm2FoEmVwQ7kNvwEtXVei&_nc_oc=AdqUwnA6YFhe82mUBn1UKHlJkGNPU-A2ur9Z8Sb
18123516887040_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qx2LAO4EyPsQ7kNvwHrleG3&_nc_oc=Adpcga64782sm5gx63Puijj-ocwBLdCM4NcUIC_9S49hXTA4n7usEW9qFbKN0TAPiog&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zy4AJ5FYVhlR6dP6oS65DLyPnX3b0DVSwpwArSyRQtQ&oe=69F3754D"}, "display_name": "Sky Duel: Tournament", "keywords": ["Future", "Cyborg", "Steampunk", "Multiplayer", "Sport"], "long_description": "So, you are in the future and participate in the battle of cyborgs throwing combat disks, and your task is to destroy the enemy. Target and send the disc directly to the enemy. Defend yourself by discarding the opponent's disc and go back into battle! \nWe have many new features for your enjoyment this time around, two new multiplayer scenarios and another refresh of the user interface. New maps for single and multiplayer modes.  Multiplayer for up to 4 players! \nYou should concentrate yours on fighting.\n For more information please visit www.vicovr.com", "short_description": "You participate in the battle of cyborgs throwing combat disks."}]}, "developer_name": "3DiVi Company", "developer_privacy_policy_url": "https://drive.google.com/file/d/1PFEKZrphG3XN2ajhf2AbFcqIQy-bKnJ-/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "pt", "es"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGL
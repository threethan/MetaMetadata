=6e7a0a&_nc_ohc=6WbMURpHeVsQ7kNvwEbl62S&_nc_oc=Adn9bwTKSN5Le3QKPJW2GAFRJK82i6ex5Fffn0ZC4b4G4TRPmUi0c9dhAkDzGa-QqkQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu9iGSWm3kKHfzHIzkw2pRvg6u9uqvh7cbO5P3fOTR1MA&oe=69A9690D"}, "display_name": "Sky Duel: Tournament", "keywords": ["Future", "Cyborg", "Steampunk", "Multiplayer", "Sport"], "long_description": "So, you are in the future and participate in the battle of cyborgs throwing combat disks, and your task is to destroy the enemy. Target and send the disc directly to the enemy. Defend yourself by discarding the opponent's disc and go back into battle! \nWe have many new features for your enjoyment this time around, two new multiplayer scenarios and another refresh of the user interface. New maps for single and multiplayer modes.  Multiplayer for up to 4 players! \nYou should concentrate yours on fighting.\n For more information please visit www.vicovr.com", "short_description": "You participate in the battle of cyborgs throwing combat disks."}]}, "developer_name": "3DiVi Company", "developer_privacy_policy_url": "https://drive.google.com/file/d/1PFEKZrphG3XN2ajhf2AbFcqIQy-bKnJ-/view?usp=sharing", "developer_terms_of_service_url": "http://vicovr.com/", "publisher_name": "3DiVi Company", "support_website_url": null, "website_url": "http://vicovr.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ru", "pt", "es"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "668449804318081"}, "review_messages
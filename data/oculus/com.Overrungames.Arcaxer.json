e=6AE75929"}, {"file_name": "SS5.png", "id": "215953870203848", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974917_215953873537181_2027191031282233093_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTGaiEGVqlAQ7kNvwEaRoxY&_nc_oc=Adrwgl3-L1ZoIdiQVpbzbYr171x0tchdTXdFt7MvAHTZ5RqilBP1KzMZDN4ePmm5omE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIHKH8fBOeyGTp7C0JZsZ2HFEbJEQEhzLR5Ff_c01S0Q&oe=6AE755DE"}, {"file_name": "SS6.png", "id": "327206728646967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974809_327206731980300_1403320869249893630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouZQ7vM77JcQ7kNvwGbj-Ww&_nc_oc=AdoPbMsJpMICUBlKhtYy7wVGrHbWdtLzGZ8zjYIcH5mem3GHU3QCPUc7rFOMsQs8Z2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6J6Jo2tzOV9w0kZxJhSgl_fOwpQfjiwfqOil4yTgS9w&oe=6AE753C5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Arcaxer_CoverLandscapeBCD_01.png", "id": "3834406180172541", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580065_3834406183505874_6113670602233577541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u-GqH_rAfoQ7kNvwFdgm7E&_nc_oc=Adp8DTcssm_aB3bxeTDF1lEN4OiPtSDmlrgdTf5VwRGGPR3qgW_-GAPtu90KD25XESA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIIOugTFjGWYSGTfOb-9PdN_-bE-ETyZxJjP0k0svpIg&oe=6AE76AD8"}, "display_name": "Arcaxer", "keywords": ["rpg", "jrpg", "roguelike", "story", "magic"], "long_description": "Arcaxer is a turn based VR RPG with first person action oriented combat, and a 3rd person god-view overworld set in a sci-fi simulation filled with colorful AI characters.\n\nIn the overworld you will explore procedural dungeons to find equips and new abilities for your character. You can access the hub world to interact with NPC's and buy new items with the credits that you earn in the dungeon.\n\nEven though combat is turn based you must dodge enemy attacks with your body, and aim and time your own attacks with gestures. Can you make it to the top of \"The Stack\"?\n\nPlayer Classes Choose fighter, thief, or mage to drastically change which abilities you learn as you level up your character.\n\nFighter: A class with a focus on physical attacks\nMage: A class with a focus on Hax, the game's special abilities.\nThief: A class with wildcard abilities that can change the tide of battle.\n", "short_description": "A turn-based VR RPG with first person action oriented combat, and a 3rd person god-view overworld. Dodge enemy attacks with your body in battles and explore procedural dungeons in 3rd person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcaxer.com/assets/docs/Arcaxer_Privacy_Policy_2021.pdf", "developer_terms_of_service_url": null, "publisher_name": "Well Played Studios", "support_website_url": null, "website_url": "https://arcaxer.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30867181456206260"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982609_652067149660399_6808100733566082452_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CDf3K6mMh6kQ7kNvwEMhIDD&_nc_oc=Adr-fNUEnKBmFeFb4QDah7AHZrrouegwY3cJuX_AQjUNHS2YeiYbJEIOZWBdKqW9yM0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_n
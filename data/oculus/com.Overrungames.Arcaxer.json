e=6AA81129"}, {"file_name": "SS5.png", "id": "215953870203848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974917_215953873537181_2027191031282233093_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ro-jr339_18Q7kNvwFdO2Cg&_nc_oc=AdqgDUfC9lGUnvFnG5HHL_zt8fi-ae3J5ZuJqHKqUilfplqg1804qiqHBxQ_-J5SIO0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIljv8DaVcbJGrBfXg7hzN4BAKTI1y7bjPQ9-10SJBd4Q&oe=6AA80DDE"}, {"file_name": "SS6.png", "id": "327206728646967", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_327206731980300_1403320869249893630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zSaXpYfkIScQ7kNvwEq3fHM&_nc_oc=AdpD9pdmkK1wNsWcUE206HVj8Kch7ZfCr7KhVCmnHH38yt2zBk4x6G2Lt44B_F1aFUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhK5mJgdxxO9fc-_YxP9N3xCidYEHFA3f9Dt2tRGitkg&oe=6AA80BC5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Arcaxer_CoverLandscapeBCD_01.png", "id": "3834406180172541", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75580065_3834406183505874_6113670602233577541_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGB-glswN2QQ7kNvwE000wl&_nc_oc=AdrGa_ODfJgYmz9PVrTinpcasuc6JyyRToKJeAT74wgVIaRtmPMvmaXjQF50P8wTdeI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLoMydx2vQ1Re7w7k0fYoyW0CFqTLLm7jhHEVasGzOzvQ&oe=6AA7EA98"}, "display_name": "Arcaxer", "keywords": ["rpg", "jrpg", "roguelike", "story", "magic"], "long_description": "Arcaxer is a turn based VR RPG with first person action oriented combat, and a 3rd person god-view overworld set in a sci-fi simulation filled with colorful AI characters.\n\nIn the overworld you will explore procedural dungeons to find equips and new abilities for your character. You can access the hub world to interact with NPC's and buy new items with the credits that you earn in the dungeon.\n\nEven though combat is turn based you must dodge enemy attacks with your body, and aim and time your own attacks with gestures. Can you make it to the top of \"The Stack\"?\n\nPlayer Classes Choose fighter, thief, or mage to drastically change which abilities you learn as you level up your character.\n\nFighter: A class with a focus on physical attacks\nMage: A class with a focus on Hax, the game's special abilities.\nThief: A class with wildcard abilities that can change the tide of battle.\n", "short_description": "A turn-based VR RPG with first person action oriented combat, and a 3rd person god-view overworld. Dodge enemy attacks with your body in battles and explore procedural dungeons in 3rd person."}]}, "developer_name": null, "developer_privacy_policy_url": "https://arcaxer.com/assets/docs/Arcaxer_Privacy_Policy_2021.pdf", "developer_terms_of_service_url": null, "publisher_name": "Well Played Studios", "support_website_url": null, "website_url": "https://arcaxer.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "30867181456206260"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982609_652067149660399_6808100733566082452_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LU7k461pM6UQ7kNvwFyzXVf&_nc_oc=AdovjRylWnJNjmECsv9w3JSQKICl1GnB01iCXaKcdIG-4Beyy9rUF_GUnEARfoWJI5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_n
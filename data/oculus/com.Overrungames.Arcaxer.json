6728646967", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974809_327206731980300_1403320869249893630_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDiojALykysQ7kNvwHHIcUZ&_nc_oc=AdnvSJDESajVbbH-Wh4p9ksDwNOsAiXaGVB8n9AqGO18Zt_TJE5iOTPhLu2SRTMPdwI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfzA1PIvlUW0gtLVck5Me3xtaSkrmH4DcSe9CY43W6MHqA&oe=69AAB385"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "YT THumb 2.png", "id": "794280687790406", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39031340_794280691123739_1856734029844587809_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vz6wdB-d0_cQ7kNvwGPMxTP&_nc_oc=AdmCCL6_CHcK0-tM3dVvdxsE0f-dk12R4_F5LciDu-_3CDnZ85PxA85RnhApPxVd-0s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfydODO_j_oiNcM5sPHG9fZ-buzNLhp9xTqmRQkhlOeZIA&oe=69AAE19A"}, "display_name": "Arcaxer", "keywords": [], "long_description": "Arcaxer is a turn based VR RPG with first person action oriented combat, and a 3rd person god-view overworld set in a sci-fi simulation filled with colorful AI characters.\n\nIn the overworld you will explore procedural dungeons to find equips and new abilities for your character. You can access the hub world to interact with NPC's and buy new items with the credits that you earn in the dungeon.\n\nEven though combat is turn based you must dodge enemy attacks with your body, and aim and time your own attacks with gestures. Can you make it to the top of \"The Stack\"?\n\nPlayer Classes Choose fighter, thief, or mage to drastically change which abilities you learn as you level up your character.\n\nFighter: A class with a focus on physical attacks\nMage: A class with a focus on Hax, the game's special abilities.\nThief: A class with wildcard abilities that can change the tide of battle.\n", "short_description": "A turn-based VR RPG with first person action oriented combat, and a 3rd person god-view overworld. Dodge enemy attacks with your body in battles and explore procedural dungeons in 3rd person."}]}, "developer_name": null, "developer_privacy_policy_url": "http://arcaxer.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Well Played Studios", "support_website_url": null, "website_url": "http://arcaxer.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "RPG"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "306514418180435"}}]}, "scheduled_offers": {"count": 20, "nodes": [{"status": "PUBLISHED", "id": "1401462945107951"}, {"status": "PUBLISHED", "id": "2112108112932904"}, {"status": "PUBLISHED", "id": "1680015782665893"}, {"status": "PUBLISHED", "id": "621413983829475"}, {"status": "PUBLISHED", "id": "579776704852437"}, {"status": "PUBLISHED", "id": "1080686036764904"}, {"status": "PUBLISHED", "id": "8410089582370786"}, {"status": "PUBLISHED", "id": "466524666023308"}, {"status": "PUBLISHED", "id": "792189849188453"}, {"status": "PUBLISHED", "id": "543197801144431"}, {"status": "PENDING", "id": "3531997510420647"}, {"status": "PENDING", "id": "3591096827787189"}, {"status": "PENDING", "id": "722784989689699"}, {"status": "PUBLISHED", "id": "238921255756357"}, {"status": "PUBLISHED", "id": "1376465636582884"}, {"status": "PUBLISHED", "id": "394353216727065"}, {"status": "PUBLISHED", "id": "884219512834138"}, {"status": "CANCELLED", "id": "1247775406062095"}, {"status": "PUBLISHED", "id": 
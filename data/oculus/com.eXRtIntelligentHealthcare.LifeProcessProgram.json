"is_test": false, "is_trial_offer_valid": false, "display_name": "Life Process Program", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1718124720, "lastRevision": {"nodes": [{"id": "7678247742196020", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "7678247722196022", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "750771957246191"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "8051176661586984", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Life Process Program", "keywords": [], "long_description": "The Life Process Program is an immersive addiction recovery application that guides users through a series of transformative modules designed to address addictive behaviour, relationships, and life circumstances. \n\nThe eight modules of the program are: Self Reflection, Values, Motivation, Rewards, Resources, Support & Intimacy, A Mature Identity, and Greater Goals. Each module features engaging video content, insightful reading material, and thought-provoking interactive exercises. Utilizing Motivational Interviewing techniques, the program fosters positive life choices and personal growth.\n\nThe program also includes high-fidelity meditation experiences, transporting users to serene natural environments. These guided meditations are uniquely crafted to help users embrace a life of hope, meaning, and purpose, free from addiction. \n\nDive into this truly immersive experience and embark on a journey towards a better life!", "short_description": "The Life Process Program is an immersive addictio
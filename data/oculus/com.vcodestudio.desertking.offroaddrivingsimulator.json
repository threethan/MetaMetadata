nail": null, "display_name": "Desert King: Offroad Driving Simulator", "keywords": ["offroad", "carstunt", "drivingsimulator", "drifting", "desertracing"], "long_description": "Become the King of the Desert!\n\nTake control of powerful off-road SUVs and conquer endless sand dunes in Desert King: Offroad Driving Simulator. Experience realistic driving physics as you drift across challenging terrain, perform incredible stunts, complete checkpoint challenges, and explore a vast open world.\n\nDrive through beautiful desert landscapes, discover hidden routes, and test your skills across exciting driving challenges. Whether you enjoy free-roam exploration or completing objectives, every journey offers a unique adventure.\n\nFeatures\n\u2022 Realistic off-road SUV driving physics\n\u2022 Massive open-world desert environment\n\u2022 Smooth drifting and responsive controls\n\u2022 Exciting checkpoint challenges\n\u2022 Amazing jumps and stunt opportunities\n\u2022 Immersive VR driving experience\n\u2022 Beautiful desert scenery\n\u2022 Easy to learn, fun to master\n\nStart your engine, conquer the dunes, and become the ultimate Desert King!", "short_description": "Drive powerful off-road SUVs across vast desert dunes, drift through challenging terrain, perform incredible stunts, collect checkpoints, and explore an immersive open world in the ultimate offroad driving simulator."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/vcode-studio-privacy-policy/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "VCode Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/vcode-studio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "interne
ersonnalis\u00e9).png", "id": "7064629786885327", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982617_7064629803551992_1341838333020840745_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQ3XUjQSLqkQ7kNvwGZ_rzb&_nc_oc=Adr2lzjnc3qzn7yAm0ZDniWB7BmeAEtvmCe9Pcjnqhmq0SI_SJ99WUjlKw0hqv1JHlM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0H-R5wnKyw8VhDQ_7pafxI1VwJFP9b4C1trhCqbA6Pg&oe=6AF722FA"}, {"file_name": "Mimbus Industry Frigo 06 (Personnalis\u00e9).png", "id": "931801884541673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982617_931801887875006_5886608164715486446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n01D2hxQm64Q7kNvwEuvc5u&_nc_oc=Adqzbjrv09VmwrgsUwKNhh5IM9WCcbAV7MDmHD7ciV7Y9ZwrzZbUdl5UkInjy6bzAMs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPvN0hEY0Nl9wwzPM-B9JufmYjm5enqwLYbX5TqwAyBg&oe=6AF72BE6"}, {"file_name": "Mimbus Industry Frigo 03 (Personnalis\u00e9).png", "id": "623530745948217", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982617_623530749281550_7681513392473556292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6VlCraRxa4Q7kNvwFziCJz&_nc_oc=Adp0RVdU5CQER5eRAIWVIwASNiOkpJIqwABohUNlabG4Np_IvlNsw7yCF_mWpu3NTsI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiZKEUuRhzVRYZDApezvaBmKcmNbcy4zCH3iUqsvYS1A&oe=6AF7258A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIMBUS INDUSTRY", "keywords": [], "long_description": "Step into MIMBUS INDUSTRY and learn how to work safely in virtual industrial environments. MIMBUS INDUSTRY offers a large range of modules to discover and learn various industry trades through Virtual Reality (VR).\n\nThese courses enable learners to acquire, practice and apply their skills in real-life situations. Apply safe-work practices, improve skills, and explore the different environments industry has to offer.\n\nMIMBUS INDUSTRY is compatible with Vulcan and allows you to track learners progress and adapt training to their needs and level.\n\nThis solution is developed for training centers, and industrial professionals in order to train the industrial work force of tomorrow. ", "short_description": "MIMBUS INDUSTRY is an industrial training solution developed in Virtual Reality. Immerse your learners in industrial environments and let them discover, train and develop skills in realistic situation scenarios. "}]}, "developer_name": "MIMBUS", "developer_privacy_policy_url": "https://www.mimbus.com/wp-content/uploads/2023/04/Mimbus-Software-Privacy-Policy-Mimbus-Industry.html", "developer_terms_of_service_url": "https://www.mimbus.com/wp-content/uploads/2023/04/Mimbus-Software-Terms-Conditions-Mimbus-Industry.html", "publisher_name": "MIMBUS", "support_website_url": null, "website_url": "https://www.mimbus.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24972239199041573"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "950155112792732"}]}, "baseline_offer": {"id": "950155112792732"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1700245931, "status": "PUBLISHED", "id": "950155112792732"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33669954892603250", "version": "1.0.7.251205002"}
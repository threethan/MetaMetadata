cdn.com/v/t64.5771-25/38982617_7064629803551992_1341838333020840745_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLqZ12pLSCkQ7kNvwGO2lvl&_nc_oc=AdlSNRkaysY1dZ89kWn7yFoqa0dZeKbWalRu-szVdckFWk2Ozu-Jqw2GU45_0pnA838&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzu1fC-gABZXfOhFwOZMvgWQ4nUtgOl1eo9nLfBzjWzCw&oe=69AEA53A"}, {"file_name": "Mimbus Industry Frigo 06 (Personnalis\u00e9).png", "id": "931801884541673", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982617_931801887875006_5886608164715486446_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mwm2fwkgYdYQ7kNvwFHFI2t&_nc_oc=Admh-pjUf68n2vCSqZ-LI6TFnrbsRvwzbIJmPbgJTUNstfOCVgRJxiHbx42m5lIBW04&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuZfn_HG7GMpjZmPZ3NOWvRe-pTTgNUHBWIQlGDJS6bA&oe=69AEAE26"}, {"file_name": "Mimbus Industry Frigo 03 (Personnalis\u00e9).png", "id": "623530745948217", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982617_623530749281550_7681513392473556292_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z58I0EOWBF8Q7kNvwG6h_uH&_nc_oc=AdneRa0R81l1X3KR8oh_IjlvV1SdKdNcn-LiI3cvBRIG2hwNFimpcfmnknheAJ5G2LA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxV5QFaeqjCWLAQkKpCcVePhqr8eMb_OdQxbIAhUi9ksA&oe=69AEA7CA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MIMBUS INDUSTRY", "keywords": [], "long_description": "Step into MIMBUS INDUSTRY and learn how to work safely in virtual industrial environments. MIMBUS INDUSTRY offers a large range of modules to discover and learn various industry trades through Virtual Reality (VR).\n\nThese courses enable learners to acquire, practice and apply their skills in real-life situations. Apply safe-work practices, improve skills, and explore the different environments industry has to offer.\n\nMIMBUS INDUSTRY is compatible with Vulcan and allows you to track learners progress and adapt training to their needs and level.\n\nThis solution is developed for training centers, and industrial professionals in order to train the industrial work force of tomorrow. ", "short_description": "MIMBUS INDUSTRY is an industrial training solution developed in Virtual Reality. Immerse your learners in industrial environments and let them discover, train and develop skills in realistic situation scenarios. "}]}, "developer_name": "MIMBUS", "developer_privacy_policy_url": "https://www.mimbus.com/wp-content/uploads/2023/04/Mimbus-Software-Privacy-Policy-Mimbus-Industry.html", "developer_terms_of_service_url": "https://www.mimbus.com/wp-content/uploads/2023/04/Mimbus-Software-Terms-Conditions-Mimbus-Industry.html", "publisher_name": "MIMBUS", "support_website_url": null, "website_url": "https://www.mimbus.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24972239199041573"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "950155112792732"}]}, "baseline_offer": {"id": "950155112792732"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1700245931, "status": "PUBLISHED", "id": "950155112792732"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "33669954892603250", "version": "1.0.7.251205002"}, "id": "1180528012610688", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bi
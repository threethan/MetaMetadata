VJeExUJiayJ6vptouHx3QQaz-ZFllyQjFfO_dKepVEKSHBZ5ev-F5iyrw&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQES2j-NCqoeurf8FsXszcEPGA-u3afeP2HPNJoBxGbAg&oe=6AFC8F46"}, {"file_name": "OOS_screenshot_03_upscaled.png", "id": "530450869259112", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974817_530450872592445_4546489165101483964_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-xRah35vhcQ7kNvwFpM8Ki&_nc_oc=Adq1YZ-L5JQqq7YijT3jHvcSQM-FwoOIBHp5zRLmz8AiMnhTBNnurySwJKusELxAX_Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBB65CsBHUVfzXU1_X-IA_oS7dhyE2p3jpDXotQWW6lQ&oe=6AFC8FDF"}, {"file_name": "OOS_screenshot_04_upscaled.png", "id": "2413585818811372", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974703_2413585822144705_283527615879611919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBpT4mZyJkIQ7kNvwH14HSB&_nc_oc=Adq8aFd53n9m12-4tcRoQGbuU9FF0V5X44spStfRZOw7djENPZfNQkpATHqkllfIEbY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT4R-N1JhdWZT1LofyuZZl5wujhOxyTeD0NqrydDji7g&oe=6AFC8ABE"}, {"file_name": "OOS_screenshot_05_upscaled.png", "id": "835945201247963", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974716_835945204581296_1812723864895900787_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ok4f127ZpAoQ7kNvwEkv0aY&_nc_oc=AdoSLJnKXjdU8BGQ6R_j2Ra1xTa91f74h24zvXnDfNiXIDWgxqVlw6QNqRs9cdM28Jk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_5xmUafVSoYEC8x1LfP2QsfghFLx2O8dMM7OraRtTUA&oe=6AFC75C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyyNlU4Pa78Q7kNvwG1d21q&_nc_oc=Adp2F0XeDVMeoNKelIW4Av5ISTrrNG2QxKupL5A5EHgOdzVkRkBjUq0Abbo4FrMqwbg&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8p97sFvx0D_oXca7lo5T1Ab8pmbzYRxbslfZ6uZnR3Q&oe=6AFC78FC"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["science", "education", "puzzle", "AI", "laboratory"], "long_description": "Explore the worlds within worlds that surround us every day, but usually go unnoticed by the human eye through gamified learning. \n\nAfter a lab test gone wrong giant ants, a protist and even fungi are taking over the city and  it\u2019s on you to use science to your advantage and clean up the whole mess before anyone notices. On your adventure, you\u2019re joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment over the course of 4 missions, you\u2019ll learn about the different rules that apply to each realm - molecular, bacterial, insect, human, and mountain.\n\nIn addition to the base game, there\u2019s also a Multiplayer Theater where you can watch your favorite 2D Kurzgesagt videos in a whole new way with friends. And in case that\u2019s not enough - you can even bring objects and creatures you collected in-game to life in the comfort of your own home via the Mixed Reality Sandbox.", "short_description": "Journey through 5 levels of scale ranging from molecular to mountain to clean up the aftermath of a lab test gone, well, slightly wrong. On your adventure, you\u2019ll be joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment, you\u2019ll learn about the different rules that apply to each realm, and have to deal with giant ants, fungi & tardigrades taking over the city. "}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_
UM8HW6lE9krze2gPwpplC-wDp8F1FSGVrK8lW_AU5PhY2mknYlwEuRM5E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR1yRkE4xPxwwybub4brZwSs48J4zzRglj2X0ZNlj0Sg&oe=6AFB3DC6"}, {"file_name": "OOS_screenshot_03_upscaled.png", "id": "530450869259112", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974817_530450872592445_4546489165101483964_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1-xRah35vhcQ7kNvwFO6-2I&_nc_oc=AdqZ0RKvQCasDC0tON_cvNspV4wfAtb7pHPhAGU082uH1w37WU214gfco6zCzEkndDw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4VV0MGKluONK-UO4475a-udaEsYCb6eA5cPb4YXn5Wg&oe=6AFB3E5F"}, {"file_name": "OOS_screenshot_04_upscaled.png", "id": "2413585818811372", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974703_2413585822144705_283527615879611919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvMCPlmG1sYQ7kNvwF_e-bn&_nc_oc=AdqBzaqQDHvAV4y1dS1g3EuuKnh_s9Gf3KqSeBAF99nF0VGB2wv6bjkB4CaRzhfENlk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRRnU4MD75sTA6R814tMlP9NInSsc9YfsMyznZ996h1ng&oe=6AFB393E"}, {"file_name": "OOS_screenshot_05_upscaled.png", "id": "835945201247963", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974716_835945204581296_1812723864895900787_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ok4f127ZpAoQ7kNvwEik1G8&_nc_oc=AdoskXYHYc1SFle-BoQu978hSontAX4OhCYje54yPtEca0iZ60kAeA199yn5dtMVkD0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX10BDzSdwp8zHx3zayKdsveCIO5trRU35JXnz-Vwung&oe=6AFB2443"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GageA0dZeZUQ7kNvwEJmmET&_nc_oc=AdrbKO4qHeZU2KxdomRg7qKqG2J4efZhV_KSHvPRpKn4rnG2lydc_SutYxSGep06Bhc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMRpHAjs6sORzz9nldJv6RnKgH73c4Lft7YVpUWimWOw&oe=6AFB277C"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["science", "education", "puzzle", "AI", "laboratory"], "long_description": "Explore the worlds within worlds that surround us every day, but usually go unnoticed by the human eye through gamified learning. \n\nAfter a lab test gone wrong giant ants, a protist and even fungi are taking over the city and  it\u2019s on you to use science to your advantage and clean up the whole mess before anyone notices. On your adventure, you\u2019re joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment over the course of 4 missions, you\u2019ll learn about the different rules that apply to each realm - molecular, bacterial, insect, human, and mountain.\n\nIn addition to the base game, there\u2019s also a Multiplayer Theater where you can watch your favorite 2D Kurzgesagt videos in a whole new way with friends. And in case that\u2019s not enough - you can even bring objects and creatures you collected in-game to life in the comfort of your own home via the Mixed Reality Sandbox.", "short_description": "Journey through 5 levels of scale ranging from molecular to mountain to clean up the aftermath of a lab test gone, well, slightly wrong. On your adventure, you\u2019ll be joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment, you\u2019ll learn about the different rules that apply to each realm, and have to deal with giant ants, fungi & tardigrades taking over the city. "}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_
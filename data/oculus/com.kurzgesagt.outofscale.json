com/v/t64.5771-25/38974817_530450872592445_4546489165101483964_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ox5sbY-WroIQ7kNvwHl3K_c&_nc_oc=AdquNd1X07TITHxj2m2AygmcNbc5Titd8_PgMdg8AAiyrw4iJ5CGWLuU8uABiv9L0Dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq6DXJNtumlA8wYVIcI9CVVp7br6pLfBonHfbTxdLkEg&oe=6A4FA31F"}, {"file_name": "OOS_screenshot_04_upscaled.png", "id": "2413585818811372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974703_2413585822144705_283527615879611919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qjaFxxE8mewQ7kNvwH0o1f-&_nc_oc=Adrk1-BvIsZRQ_TwB2s_h0iU4QBKeKiyit2hhdrUpkHmKNjt4CBoi0PulBBq26a8I2c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqB8JPpkECagyJJjxCfhZTr6AJTCBBHqQ95pM7UmxtPQ&oe=6A4F9DFE"}, {"file_name": "OOS_screenshot_05_upscaled.png", "id": "835945201247963", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974716_835945204581296_1812723864895900787_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwFGOu99SFUQ7kNvwHFRgbW&_nc_oc=Adrzwe0UOBgGfR3l12KcVp_zZTL4E5x8wO4UJniWH8WT7XYpKHqq4_GMoiSrmSXFEkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMiyk0eWGfMi-sXzdpaxgC-gS8obsvYohfcTDmQvh_Qw&oe=6A4FC143"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZklXmMAr5TYQ7kNvwGcaLNv&_nc_oc=AdpqCsnwcvGNmdHnFkhjJjR33m14ms6cZ6SbXYuyqMFnqFUXtGLFEE7VZENdg2a0FFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKvjU9hfEBSJAzp67TI1DWOqWUJzYMtEPR5FTgT0-zIw&oe=6A4FC47C"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["kurzgesagt", "science", "education", "puzzle", "nutshell"], "long_description": "In this VR app, you explore the worlds within worlds around you from inside your mobile scale lab as you travel to five levels of scale - molecular, bacterial, insect, human, and mountain. You're joined by STEVE, the lab's AI assistant, who shows you the different effects of biology, physics, and chemistry in each realm. Together you'll scan objects, find hidden ducks, and observe science in action. You will complete four missions around giant ants, a  tardigrade, a protist, and giant fungi that have accidentally been scaled up by using scientific concepts and scaling objects up and down yourself. \n\nIn addition to the base game, there is a Multiplayer Theater where players can invite their friends and watch Kurzgesagt videos together in VR. There's also a Mixed Reality Sandbox where players can bring objects and creatures they've unlocked in the game into their home.\n", "short_description": "Explore the worlds within worlds at your feet as you travel to five different levels of scale \u2013 molecular, bacterial, insect, human, and mountain. In this VR app you\u2019re joined by STEVE, the lab\u2019s AI assistant, who introduces you to the different effects of biology, physics and chemistry in each realm. Complete missions by using scientific concepts to defeat giant ants, tardigrades, a protist and fungi that have accidentally been scaled up to huge sizes."}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://kurzgesagt.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
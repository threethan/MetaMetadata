2445_4546489165101483964_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-z82F9E1KYoQ7kNvwGfG2bT&_nc_oc=AdqUDcpHdx2L6pP-L7M7t4EC3v7gE0VUPziiDhYvFTsPDtOJtfuDG0EOzfm68968xpM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2o58wDk5LZQkIu8yPRjahustZD41QGvPjjnM2uI7kb1A&oe=69EF659F"}, {"file_name": "OOS_screenshot_04_upscaled.png", "id": "2413585818811372", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974703_2413585822144705_283527615879611919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MYf4ABjURz0Q7kNvwEt3bw5&_nc_oc=AdotV6Q4hYkcCaa3ItmEwNnD6BH6igVIMywUKSUAQy-dxP117A5k1VIojHtXVvQBqow&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CGVfu3xsLa14p5uFhnQ12L6HlW2bk7yjONkcWLxCSBA&oe=69EF607E"}, {"file_name": "OOS_screenshot_05_upscaled.png", "id": "835945201247963", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974716_835945204581296_1812723864895900787_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDonqXv85UMQ7kNvwFULtmV&_nc_oc=Ado_vBbi1Bsmhrci52kplCrG7wCHDG2ovzjIwv6CbCgG-dV7k7PXC-k98j-AsdACWnQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3S6Ci4PxXGyePE9-Dbd04qR55v3hGGwILH2fA-fK0A0g&oe=69EF83C3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gLHiv8ZFX2kQ7kNvwFk0Knt&_nc_oc=Adr8P4Jqytzlyi3iYvWNLbKiDV7SsxqKNuy-dafy_tXEr1hVTH4cHwGk1PDQhOs18L0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JbScmfOZE_7lnem3L_9_qwYBapxPqQOZta_7Pnar49w&oe=69EF4EBC"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["science", "education", "puzzle", "AI", "laboratory"], "long_description": "Explore the worlds within worlds that surround us every day, but usually go unnoticed by the human eye through gamified learning. \n\nAfter a lab test gone wrong giant ants, a protist and even fungi are taking over the city and  it\u2019s on you to use science to your advantage and clean up the whole mess before anyone notices. On your adventure, you\u2019re joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment over the course of 4 missions, you\u2019ll learn about the different rules that apply to each realm - molecular, bacterial, insect, human, and mountain.\n\nIn addition to the base game, there\u2019s also a Multiplayer Theater where you can watch your favorite 2D Kurzgesagt videos in a whole new way with friends. And in case that\u2019s not enough - you can even bring objects and creatures you collected in-game to life in the comfort of your own home via the Mixed Reality Sandbox.", "short_description": "Journey through 5 levels of scale ranging from molecular to mountain to clean up the aftermath of a lab test gone, well, slightly wrong. On your adventure, you\u2019ll be joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment, you\u2019ll learn about the different rules that apply to each realm, and have to deal with giant ants, fungi & tardigrades taking over the city. "}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://kurzgesagt.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_
BhA4GQMUvMdOYLPRDK34w5j8ZWmpa80fNGqEK_lcwXmwP5VAwf75XkHA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNck51V_HvfNtol6FxscbGjr2n4S8JlgpL0nkT0iLwTA&oe=6B01D546"}, {"file_name": "OOS_screenshot_03_upscaled.png", "id": "530450869259112", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974817_530450872592445_4546489165101483964_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKE534xu8AMQ7kNvwFF6XYQ&_nc_oc=Adof1BOjIaenALDNBy6OffNGPiC8BOFKE1pC5zP-oisNxgTPFyvlFCTCrtHhqJ5OY7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJsfI2pkJvLLPhLML0tWFVv8lhKsHSP2OrsfjZUb32Ww&oe=6B01D5DF"}, {"file_name": "OOS_screenshot_04_upscaled.png", "id": "2413585818811372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974703_2413585822144705_283527615879611919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U4xszc8ngxIQ7kNvwHygOLa&_nc_oc=Adrxqz-pKm_yU2p_4WlTI4nBYkWfFfZb1Avv4-4I090elRhD2ljHoko1BFu4EEw89EQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE0p82TUXeed4_zg4pVFiwXDuXcSXstVcyDjcPYN3Y1Q&oe=6B01D0BE"}, {"file_name": "OOS_screenshot_05_upscaled.png", "id": "835945201247963", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974716_835945204581296_1812723864895900787_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wc62h4kBFdwQ7kNvwHhuVzW&_nc_oc=Adpb4zSnjD7PZmru-1VEx0nW2LNmwQfp_bSmoU2NNSfcxY1-I0ZnHdV25kWKvto4uqQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxT9MQ_SMSwPnH4htLKUGVhUVQQvmw42RgDwyVWlaQ_g&oe=6B01BBC3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fwp1nQsc8DUQ7kNvwGeprw0&_nc_oc=AdrSna0BM-jS54JIk7hcNCrvrjQJ9JAklmfSFehBd8HCxacG1Fb1JI-DDQYvJ8hjIsw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYbg-UjAvtaouBOS-T6pfRYaXsJ4L8qOtE9Ow9yYjBFg&oe=6B01BEFC"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["science", "education", "puzzle", "AI", "laboratory"], "long_description": "Explore the worlds within worlds that surround us every day, but usually go unnoticed by the human eye through gamified learning. \n\nAfter a lab test gone wrong giant ants, a protist and even fungi are taking over the city and  it\u2019s on you to use science to your advantage and clean up the whole mess before anyone notices. On your adventure, you\u2019re joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment over the course of 4 missions, you\u2019ll learn about the different rules that apply to each realm - molecular, bacterial, insect, human, and mountain.\n\nIn addition to the base game, there\u2019s also a Multiplayer Theater where you can watch your favorite 2D Kurzgesagt videos in a whole new way with friends. And in case that\u2019s not enough - you can even bring objects and creatures you collected in-game to life in the comfort of your own home via the Mixed Reality Sandbox.", "short_description": "Journey through 5 levels of scale ranging from molecular to mountain to clean up the aftermath of a lab test gone, well, slightly wrong. On your adventure, you\u2019ll be joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment, you\u2019ll learn about the different rules that apply to each realm, and have to deal with giant ants, fungi & tardigrades taking over the city. "}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_
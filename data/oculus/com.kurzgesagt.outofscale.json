com/v/t64.5771-25/38974817_530450872592445_4546489165101483964_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFhBkSEj_gcQ7kNvwHyhTlU&_nc_oc=AdrdAHaeCfwjFN9NOMYnS6fko8TOVG_OK4GviKQ9v4AFxTcMCCbuf5k9DcALpVqG2MY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfznS678hdcSpuan4O2Dk2io5wbKX89Tu681kisboc3wfw&oe=69C5359F"}, {"file_name": "OOS_screenshot_04_upscaled.png", "id": "2413585818811372", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974703_2413585822144705_283527615879611919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r97VqC9zdv4Q7kNvwFQxqTw&_nc_oc=AdoIi8AyRLu8W0Wj6yjzUXb9-gCmFNQCBZ0lrnbJtVNrpIs1oUI3P0zs-3N1TG35QiU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzr-ILzDrYit6ViU0zNK1u_adJ1rPIlI8JxP4nmSCRkcw&oe=69C5307E"}, {"file_name": "OOS_screenshot_05_upscaled.png", "id": "835945201247963", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974716_835945204581296_1812723864895900787_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM6-7reChjkQ7kNvwHixtxO&_nc_oc=Adq6MeTv0J6daVH0BgXj08JN-pc8TwdWCE-jHXZQXmadOnkm67IcKo23J00CNcJuZK8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyH5r_AWFrJCG6v4u5gFzJoRtSPgHAlJFqDYZf_luFKtA&oe=69C51B83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r0uUQ1eTgfwQ7kNvwGaZfR7&_nc_oc=AdpVTmn3OUk5HUmbM95ZDmwxMISocKd9KagKRoAn7Ev1fXPdZNlavWbRgNIrGAfEBXQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxeRLs3ZUQnMsKIduaLVb44WdaejsASe0Dp4zZJgM-9Ug&oe=69C51EBC"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["kurzgesagt", "science", "education", "puzzle", "nutshell"], "long_description": "In this VR app, you explore the worlds within worlds around you from inside your mobile scale lab as you travel to five levels of scale - molecular, bacterial, insect, human, and mountain. You're joined by STEVE, the lab's AI assistant, who shows you the different effects of biology, physics, and chemistry in each realm. Together you'll scan objects, find hidden ducks, and observe science in action. You will complete four missions around giant ants, a  tardigrade, a protist, and giant fungi that have accidentally been scaled up by using scientific concepts and scaling objects up and down yourself. \n\nIn addition to the base game, there is a Multiplayer Theater where players can invite their friends and watch Kurzgesagt videos together in VR. There's also a Mixed Reality Sandbox where players can bring objects and creatures they've unlocked in the game into their home.\n", "short_description": "Explore the worlds within worlds at your feet as you travel to five different levels of scale \u2013 molecular, bacterial, insect, human, and mountain. In this VR app you\u2019re joined by STEVE, the lab\u2019s AI assistant, who introduces you to the different effects of biology, physics and chemistry in each realm. Complete missions by using scientific concepts to defeat giant ants, tardigrades, a protist and fungi that have accidentally been scaled up to huge sizes."}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://kurzgesagt.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_
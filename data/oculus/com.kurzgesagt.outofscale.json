F8C7HD9UXeEr5Sp2bujiLLBthU0ErS-mvi0Y1jE3O3IoYaD3EuSGrlsD0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuqTAkCYh_-Vv0HjlnpB9IaqKR_ZM0LliJhCIJ0bsr0g&oe=6B0B0FC6"}, {"file_name": "OOS_screenshot_03_upscaled.png", "id": "530450869259112", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974817_530450872592445_4546489165101483964_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJ4ifmLCUH4Q7kNvwHfsTas&_nc_oc=Adp1SZJjPVv1gLTPDpcvBHxWg_GtsQBwzZgnjHZyvegZTQTpsHri-z2QhnsMAgsTD28&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSWIZoDY0sBMXfPKG_qbV22k3aDSJdTT3xEJA_0l9BiYQ&oe=6B0B105F"}, {"file_name": "OOS_screenshot_04_upscaled.png", "id": "2413585818811372", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974703_2413585822144705_283527615879611919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pY_HYtSV6vsQ7kNvwF1F3PK&_nc_oc=AdoHuegdNuVaU6VIMaSp8ooS3GDhpHAgP0y3WCuw0XFzk8j_zHkgOfYv5uTKTVuqAss&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ1YgDsPxkFV9V_wt-M-LxP_u-Ft-8OUgj9YTo70cw_vw&oe=6B0B437E"}, {"file_name": "OOS_screenshot_05_upscaled.png", "id": "835945201247963", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974716_835945204581296_1812723864895900787_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzoDy0LR13IQ7kNvwE9PJTs&_nc_oc=AdppAt3rmcY-r5c8lh2aAU18aTlHZQ1uofrFUMveNSJmJ8J22dVoYMrAx82bRpo-PeE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQoeit2KR7BaNwZUyH-L3SVvGnwTJnq8p1_VWjs_uPptg&oe=6B0B2E83"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8K_lZZCwhTUQ7kNvwGsfHsY&_nc_oc=AdrEh_hPCe_usjXlpnmT3cDlYCFXEzAjhhnUpYhDbSkUlar0xarxfyM_rN6G7aJ47_c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTPyJAHMjjNlaU-BR4PpLymcYlm5eXCHR0xVZwkpBXWKg&oe=6B0B31BC"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["science", "education", "puzzle", "AI", "laboratory"], "long_description": "Explore the worlds within worlds that surround us every day, but usually go unnoticed by the human eye through gamified learning. \n\nAfter a lab test gone wrong giant ants, a protist and even fungi are taking over the city and  it\u2019s on you to use science to your advantage and clean up the whole mess before anyone notices. On your adventure, you\u2019re joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment over the course of 4 missions, you\u2019ll learn about the different rules that apply to each realm - molecular, bacterial, insect, human, and mountain.\n\nIn addition to the base game, there\u2019s also a Multiplayer Theater where you can watch your favorite 2D Kurzgesagt videos in a whole new way with friends. And in case that\u2019s not enough - you can even bring objects and creatures you collected in-game to life in the comfort of your own home via the Mixed Reality Sandbox.", "short_description": "Journey through 5 levels of scale ranging from molecular to mountain to clean up the aftermath of a lab test gone, well, slightly wrong. On your adventure, you\u2019ll be joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment, you\u2019ll learn about the different rules that apply to each realm, and have to deal with giant ants, fungi & tardigrades taking over the city. "}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_
MJFWzTaFwkh9UaNdYKiIZ8j3iFpipulewcqZEX4AEKTJxqZd_5KT1jKBE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUoVpEfC7Y6XEI9OOrNzPJkfmyYuIER_IMjWe_MamksMw&oe=6B0F0446"}, {"file_name": "OOS_screenshot_03_upscaled.png", "id": "530450869259112", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974817_530450872592445_4546489165101483964_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYnaqk6wMXUQ7kNvwHQcsgm&_nc_oc=AdrK3ILoI7osQ4enRBubkn_MdDIGma7TIW6bPVQDtTbW-5G1BiLaT19BkrQyLbvEeTA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV7fMTVaHfs9NL6M4dipTRgY76CoveScEfv4Wbdhi6vLg&oe=6B0F04DF"}, {"file_name": "OOS_screenshot_04_upscaled.png", "id": "2413585818811372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974703_2413585822144705_283527615879611919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4k7h7DjVT4UQ7kNvwG_H5RS&_nc_oc=AdoXkA-mGt3SM9rh4lxfORVEG-SOhR-NRMj3T8_N0ATnMhYXwET73dUnsNiRUdbuxEk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV0Z7rlooNNnt0OBvmjwGRVm6J4CPVO_vVmNwCWa6uUqg&oe=6B0EFFBE"}, {"file_name": "OOS_screenshot_05_upscaled.png", "id": "835945201247963", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974716_835945204581296_1812723864895900787_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMCRrqhKcXwQ7kNvwHg8uer&_nc_oc=Adofp60H3MTeytG0YgBX3f6H1SxUN1LEt5AsJsJKPnIP1YQgVrDZmkX1viyKccTMmqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWdcsarrsWU-zthWsfAajL8-1gfIiLOZ_luAC4ZCERmxg&oe=6B0F2303"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK73uQH4_OEQ7kNvwGl_Lzf&_nc_oc=AdoqJHzvyz6RZRSQqTCMRDAsRpr8InfmcZ86HsPKQKJlKPxsSK7lyetRV3CY1fmM1GM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW2LjKM3NaMSA-OXgKZHKdN6ky4xOMQxOvWi2CwwgsmSg&oe=6B0EEDFC"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["science", "education", "puzzle", "AI", "laboratory"], "long_description": "Explore the worlds within worlds that surround us every day, but usually go unnoticed by the human eye through gamified learning. \n\nAfter a lab test gone wrong giant ants, a protist and even fungi are taking over the city and  it\u2019s on you to use science to your advantage and clean up the whole mess before anyone notices. On your adventure, you\u2019re joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment over the course of 4 missions, you\u2019ll learn about the different rules that apply to each realm - molecular, bacterial, insect, human, and mountain.\n\nIn addition to the base game, there\u2019s also a Multiplayer Theater where you can watch your favorite 2D Kurzgesagt videos in a whole new way with friends. And in case that\u2019s not enough - you can even bring objects and creatures you collected in-game to life in the comfort of your own home via the Mixed Reality Sandbox.", "short_description": "Journey through 5 levels of scale ranging from molecular to mountain to clean up the aftermath of a lab test gone, well, slightly wrong. On your adventure, you\u2019ll be joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment, you\u2019ll learn about the different rules that apply to each realm, and have to deal with giant ants, fungi & tardigrades taking over the city. "}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_
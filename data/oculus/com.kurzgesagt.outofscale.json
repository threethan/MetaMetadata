C2h9tZJY3YTLOkRr9S7zucEtlf6-MDbK-QkZYwrF5M-5VHc8fixJT35-E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS94N5OFHtMkw1Rada5OGV6f-fZdLPXdL_HNtwUFiPaaA&oe=6B0DB2C6"}, {"file_name": "OOS_screenshot_03_upscaled.png", "id": "530450869259112", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974817_530450872592445_4546489165101483964_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJ4ifmLCUH4Q7kNvwGk_nFF&_nc_oc=AdqvQ0rM5IqBz-MRfojVmsGtX67iKXXxvxvbKwopDIf6hidNw5vo4Au_KOL1GfVrHEQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzB81CeenDFt9jDWPkMrE6hX5JVE7oz7MuGuFQDT_M9g&oe=6B0DB35F"}, {"file_name": "OOS_screenshot_04_upscaled.png", "id": "2413585818811372", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974703_2413585822144705_283527615879611919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4k7h7DjVT4UQ7kNvwEYZrfW&_nc_oc=Adpr5nJNjkyBV4R9UMh3cRMKd_1cBnx8UcJhKU_F_Crk5Xpb-MvjJ98BfP9NX5IGK2E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRKan7fSLzgckgdtNrIZvNGdV0TcBa1F75ORn_Z4_PJfQ&oe=6B0DAE3E"}, {"file_name": "OOS_screenshot_05_upscaled.png", "id": "835945201247963", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974716_835945204581296_1812723864895900787_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wzoDy0LR13IQ7kNvwHZf1wl&_nc_oc=AdquEJ4vbnFjzSzypFflRQ94PeTVUzCwqEf0K2Yb19ObhxzYvUD-VO8m7AGJKLj2uXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSW4Y9olKv52UHdjNCF3D29QFpSwA6XlD1VAwjrYMcJag&oe=6B0DD183"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK73uQH4_OEQ7kNvwGUioFQ&_nc_oc=AdrwttB20F9EsRMjlsp-4i5uTdL4ertm7VA0FZmUdg3JWPTCtbDxfLIvCMtVF1uLAVU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQe6lPYtXk2NY3OGyk8MPoatJL1bC34ZXgkTGr-sQnXcg&oe=6B0D9C7C"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["science", "education", "puzzle", "AI", "laboratory"], "long_description": "Explore the worlds within worlds that surround us every day, but usually go unnoticed by the human eye through gamified learning. \n\nAfter a lab test gone wrong giant ants, a protist and even fungi are taking over the city and  it\u2019s on you to use science to your advantage and clean up the whole mess before anyone notices. On your adventure, you\u2019re joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment over the course of 4 missions, you\u2019ll learn about the different rules that apply to each realm - molecular, bacterial, insect, human, and mountain.\n\nIn addition to the base game, there\u2019s also a Multiplayer Theater where you can watch your favorite 2D Kurzgesagt videos in a whole new way with friends. And in case that\u2019s not enough - you can even bring objects and creatures you collected in-game to life in the comfort of your own home via the Mixed Reality Sandbox.", "short_description": "Journey through 5 levels of scale ranging from molecular to mountain to clean up the aftermath of a lab test gone, well, slightly wrong. On your adventure, you\u2019ll be joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment, you\u2019ll learn about the different rules that apply to each realm, and have to deal with giant ants, fungi & tardigrades taking over the city. "}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_
pEiDr_Gq2_96aBPKHIRBYxF5F-0fay2TCaf5xGpsvriTiu0ekIz7l3UFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq3d755clCYAlAy-rjEZ7nqGCvllTJjFhtqtWKUNVGoQ&oe=6B05C9C6"}, {"file_name": "OOS_screenshot_03_upscaled.png", "id": "530450869259112", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974817_530450872592445_4546489165101483964_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQMshroFbw8Q7kNvwFMVDps&_nc_oc=AdpzNNDmD8NegqFpfjjS10OXRvNSbqAJkvGpxwbzLHVVa0SmCq81hIG3p3zrbV9gTTY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSmK2M7MmvVXWeGUTFnwrsdH-q976malFna4ahJarv1Q&oe=6B05CA5F"}, {"file_name": "OOS_screenshot_04_upscaled.png", "id": "2413585818811372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974703_2413585822144705_283527615879611919_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yidxIATZgIgQ7kNvwFpvCVN&_nc_oc=AdqK36rKZ4ir8765M4Nt3Phib1bNI_l4okjRlJDdFYuNb7BifM8QUcVf2nvb_NXuh0U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_J4rjjJ_FcOM5Go4xhtSIpQyI8xUaw-UOVcUoXGBHcg&oe=6B05C53E"}, {"file_name": "OOS_screenshot_05_upscaled.png", "id": "835945201247963", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974716_835945204581296_1812723864895900787_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHQT07CgTQYQ7kNvwFU6CDC&_nc_oc=Adpcd8luvnUzbOY5cjrBpPEPUR_kdHmL7JG1xxmEY6l4HNh_ZqCakJGpHym2o0U0WSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFgg5KH5MYfhkYds52MuGiV71GEJ5Pnpr1en9pQKfNuw&oe=6B05B043"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rf7Wmx82aFgQ7kNvwH9_Kgp&_nc_oc=Ado3l8-BLjG1EHqWsiHCOiz1fn9xFj3Cq8E_W6TFtWTAHx9CoHze78M32SC9gCwGis4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRHavjyNsQ2Qg_04f4NQx529QFxIuuUCpgikfwn2FMfnw&oe=6B05B37C"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["science", "education", "puzzle", "AI", "laboratory"], "long_description": "Explore the worlds within worlds that surround us every day, but usually go unnoticed by the human eye through gamified learning. \n\nAfter a lab test gone wrong giant ants, a protist and even fungi are taking over the city and  it\u2019s on you to use science to your advantage and clean up the whole mess before anyone notices. On your adventure, you\u2019re joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment over the course of 4 missions, you\u2019ll learn about the different rules that apply to each realm - molecular, bacterial, insect, human, and mountain.\n\nIn addition to the base game, there\u2019s also a Multiplayer Theater where you can watch your favorite 2D Kurzgesagt videos in a whole new way with friends. And in case that\u2019s not enough - you can even bring objects and creatures you collected in-game to life in the comfort of your own home via the Mixed Reality Sandbox.", "short_description": "Journey through 5 levels of scale ranging from molecular to mountain to clean up the aftermath of a lab test gone, well, slightly wrong. On your adventure, you\u2019ll be joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment, you\u2019ll learn about the different rules that apply to each realm, and have to deal with giant ants, fungi & tardigrades taking over the city. "}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_
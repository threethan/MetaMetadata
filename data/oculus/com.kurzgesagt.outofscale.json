0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX10BDzSdwp8zHx3zayKdsveCIO5trRU35JXnz-Vwung&oe=6AFB2443"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GageA0dZeZUQ7kNvwEJmmET&_nc_oc=AdrbKO4qHeZU2KxdomRg7qKqG2J4efZhV_KSHvPRpKn4rnG2lydc_SutYxSGep06Bhc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMRpHAjs6sORzz9nldJv6RnKgH73c4Lft7YVpUWimWOw&oe=6AFB277C"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["kurzgesagt", "science", "education", "puzzle", "nutshell"], "long_description": "In this VR app, you explore the worlds within worlds around you from inside your mobile scale lab as you travel to five levels of scale - molecular, bacterial, insect, human, and mountain. You're joined by STEVE, the lab's AI assistant, who shows you the different effects of biology, physics, and chemistry in each realm. Together you'll scan objects, find hidden ducks, and observe science in action. You will complete four missions around giant ants, a  tardigrade, a protist, and giant fungi that have accidentally been scaled up by using scientific concepts and scaling objects up and down yourself. \n\nIn addition to the base game, there is a Multiplayer Theater where players can invite their friends and watch Kurzgesagt videos together in VR. There's also a Mixed Reality Sandbox where players can bring objects and creatures they've unlocked in the game into their home.\n", "short_description": "Explore the worlds within worlds at your feet as you travel to five different levels of scale \u2013 molecular, bacterial, insect, human, and mountain. In this VR app you\u2019re joined by STEVE, the lab\u2019s AI assistant, who introduces you to the different effects of biology, physics and chemistry in each realm. Complete missions by using scientific concepts to defeat giant ants, tardigrades, a protist and fungi that have accidentally been scaled up to huge sizes."}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://kurzgesagt.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "220048910958500"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "2375966539420512"}, {"status": "PUBLISHED", "id": "777685807428529"}, {"status": "PENDING", "id": "388322583548665"}, {"status": "PUBLISHED", "id": "834376001508216"}, {"status": "PUBLISHED", "id": "1280177065980493"}, {"status": "PENDING", "id": "734249811941361"}]}, "baseline_offer": {"id": "834376001508216"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737396000, "status": "PUBLISHED", "id": "2375966539420512"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9293839947299845", "version": "0.0.1+324413s"}, "id": "1023557175456729", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinar
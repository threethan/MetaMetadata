aGw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu0NTKb1lha4H-glrCjUmhLjHJkujk2oKW0JbnIjGnm6Q&oe=6999B41F"}, {"file_name": "OOS_screenshot_04_upscaled.png", "id": "2413585818811372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974703_2413585822144705_283527615879611919_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sBeOHbAM3-sQ7kNvwEN74rB&_nc_oc=AdkORjLz7XmaLhRgY4arEs7lRinI9qiFCeOx41OhyQPuulR4TFCCZOM1L8WVmPBb7yU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvJthxsEkDbxp-RgoQuTzG2WbQPTC62cQkwno1t8ndcaA&oe=6999AEFE"}, {"file_name": "OOS_screenshot_05_upscaled.png", "id": "835945201247963", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974716_835945204581296_1812723864895900787_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DdeOIKpAooQ7kNvwE5CRk4&_nc_oc=AdlbvIlhTxz56fSwN5vdHIUU8Q-ROGscEP5QoQT6Q37WGAYmdoerLsQvHY9pp44MQSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsppjMIUY_Gi9mlk8-vkzG0qxg4uYfuQIgYUFj7ridIfQ&oe=69999A03"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_CoverLandscape.png", "id": "271802505751093", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982642_271802509084426_2859660123564087566_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhmryRdHLMQQ7kNvwG14dn2&_nc_oc=AdlGBq7a7-7z57H5zBy8_YGanFbKpTEvZBZUPLa4wMtrk4W01ZJpNHk6EsFG842GGy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfskMIrDVjc5V67Y9DuQk-vry3qpP_Y5jwO4sx4tQjqrqw&oe=69999D3C"}, "display_name": "Out of Scale: A Kurzgesagt Adventure", "keywords": ["science", "education", "puzzle", "AI", "laboratory"], "long_description": "Explore the worlds within worlds that surround us every day, but usually go unnoticed by the human eye through gamified learning. \n\nAfter a lab test gone wrong giant ants, a protist and even fungi are taking over the city and  it\u2019s on you to use science to your advantage and clean up the whole mess before anyone notices. On your adventure, you\u2019re joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment over the course of 4 missions, you\u2019ll learn about the different rules that apply to each realm - molecular, bacterial, insect, human, and mountain.\n\nIn addition to the base game, there\u2019s also a Multiplayer Theater where you can watch your favorite 2D Kurzgesagt videos in a whole new way with friends. And in case that\u2019s not enough - you can even bring objects and creatures you collected in-game to life in the comfort of your own home via the Mixed Reality Sandbox.", "short_description": "Journey through 5 levels of scale ranging from molecular to mountain to clean up the aftermath of a lab test gone, well, slightly wrong. On your adventure, you\u2019ll be joined by STEVE, the lab\u2019s AI assistant, and will be the first to try out his newest invention, Shrink-o-gen. Scanning and scaling your way through the environment, you\u2019ll learn about the different rules that apply to each realm, and have to deal with giant ants, fungi & tardigrades taking over the city. "}]}, "developer_name": "Schell Games, in a nutshell - kurzgesagt", "developer_privacy_policy_url": "https://kurzgesagt.org/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Meta", "support_website_url": null, "website_url": "https://kurzgesagt.org/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
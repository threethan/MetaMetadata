ocale": "en_US", "screenshots": [{"file_name": "1.png", "id": "2539941679842503", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/596149727_2539941683175836_5520550162720440681_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zl6HpFSWpoQ7kNvwGYKql0&_nc_oc=Adrtee7nUWsq8nvud2rAAzBGhEb1dJgUUzhYHIPw2aCQE16YvbNOnhrAci4CnlrJ1-s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyTILpEM1ul9FyD1iLjWJYM0gUKRL7kwKcQJIS6VzVPg&oe=6AF9D0EB"}, {"file_name": "2.png", "id": "1064125503273385", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/596068480_1064125506606718_2122018245461745211_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaR_FlTGXbMQ7kNvwH7142e&_nc_oc=AdrE32M-irZ_Dif4nzeicJvnxPAJU-ZaB2v01yca9uoIo1S-ZvOq4eu4MZQCl4S9B2Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSK61jufBw4JrDrjOfGjk1ov5Kv8N6cG8vcR5HxnDdq-g&oe=6AF9C765"}, {"file_name": "3.png", "id": "28639109442394630", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673652249_28639109445727963_3381002593697328980_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqYE_BY8q90Q7kNvwEMe0kC&_nc_oc=Adojh6L1J4E8zVIh4-leM0iObzDi0Ts7OpI5KY4ZhsjuSVHN5NHozIg9_fljoJ1tGz8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_c8niod6z2mptmop6lIluY6rwSVk4UrVfk75fXv2fkQ&oe=6AF9DC97"}, {"file_name": "4.png", "id": "1451105566885276", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/596149727_1451105570218609_157775848335273530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3aOFB5ISnAQ7kNvwGZ5Ity&_nc_oc=Adoz_o2LFgXHK4OAfzgToX6OpgVReBFjQghd5_iy6qb2LWBlLakvOQ41RNFvn8F-4UE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_59FOfDkD3HPiQuU1BPCHSlQUWdsuNdDwFScCF9ARdA&oe=6AF9D437"}, {"file_name": "5.png", "id": "971318845308311", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604385997_971318848641644_8403087101255881262_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewxydwzhMs4Q7kNvwG-f-6H&_nc_oc=AdrYGICqkfGJIuA6VsR7eghVaG6oOu1OCYOBJwKa6swybWI-Mo4xpsaM3w6yuUn8Mns&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGII9HjYieX8POrZO-FWuemw5NxzON4Lsfoir48kotPA&oe=6AF9BCDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Roller Coasters - Epic Rides", "keywords": ["roller", "coasters", "epic", "rides", "extreme"], "long_description": "Welcome to Roller Coasters - Epic Rides, where you take charge of the most thrilling amusement park coasters right from your screen!\n\nStep into the driver seat and navigate massive steel tracks set against detailed city environments. Feel the suspense build as you climb steep inclines, then brace yourself for sharp drops, loop-the-loops, and high-speed curves. Every turn tests your reaction time and speed control\u2014go too fast and risk derailing, or slow down to keep your passengers safe and smiling.\n\nKey Features:\n\nRealistic Coaster Physics: Feel every drop, turn, and loop as you balance speed and control on high-flying tracks.\n\nMultiple Game Modes & Levels: Unlock various thematic environments and progressively challenging levels that test your precision driving skills.\n\nImmersive First-Person View: Ride along with passenger views, capturing realistic thrill animations and city vistas.\n\nSpeed & Safety Controls: Master the speed slider to safely guide your roller coaster cart through tricky sections without failing the level.\n\nStunning 3D Graphics & Sound: Vibrant cityscapes, dynamic surroundings like hot air balloons, and sound effects bring the theme park experience to life.\n\nAre you ready to build your reputation as the ultimate coaster driver? Download Roller Coasters - Epic Rides today and feel the thrill!", "short_description": "Experience the ultimate adrenaline rush in Roller Coasters - Epic Rides! Control high-speed roller coasters through thrilling cityscapes, navigate crazy twists and turns, and manage your speed to keep riders safe. Dive into an immersive theme park adventure packed with multiple modes, challenging levels, and non-stop excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Digital Aesthetics", "support_website_url": null, "website_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1361956813665028"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "4207341292892270"}, {"status": "PUBLISHED", "id": "2130586324198625"}]}, "baseline_offer": {"id": "2130586324198625"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "4207341292892270"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1362394283621281", "version": "0.1"}, "id": "921124837492730", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1361956780331698", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1362394283621281"}, "release_
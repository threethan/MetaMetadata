9DC97"}, {"file_name": "4.png", "id": "1451105566885276", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/596149727_1451105570218609_157775848335273530_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3aOFB5ISnAQ7kNvwGZ5Ity&_nc_oc=Adoz_o2LFgXHK4OAfzgToX6OpgVReBFjQghd5_iy6qb2LWBlLakvOQ41RNFvn8F-4UE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_59FOfDkD3HPiQuU1BPCHSlQUWdsuNdDwFScCF9ARdA&oe=6AF9D437"}, {"file_name": "5.png", "id": "971318845308311", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/604385997_971318848641644_8403087101255881262_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ewxydwzhMs4Q7kNvwG-f-6H&_nc_oc=AdrYGICqkfGJIuA6VsR7eghVaG6oOu1OCYOBJwKa6swybWI-Mo4xpsaM3w6yuUn8Mns&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGII9HjYieX8POrZO-FWuemw5NxzON4Lsfoir48kotPA&oe=6AF9BCDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Roller Coasters - Epic Rides", "keywords": ["roller", "coasters", "epic", "rides", "extreme"], "long_description": "Welcome to Roller Coasters - Epic Rides, where you take charge of the most thrilling amusement park coasters right from your screen!\n\nStep into the driver seat and navigate massive steel tracks set against detailed city environments. Feel the suspense build as you climb steep inclines, then brace yourself for sharp drops, loop-the-loops, and high-speed curves. Every turn tests your reaction time and speed control\u2014go too fast and risk derailing, or slow down to keep your passengers safe and smiling.\n\nKey Features:\n\nRealistic Coaster Physics: Feel every drop, turn, and loop as you balance speed and control on high-flying tracks.\n\nMultiple Game Modes & Levels: Unlock various thematic environments and progressively challenging levels that test your precision driving skills.\n\nImmersive First-Person View: Ride along with passenger views, capturing realistic thrill animations and city vistas.\n\nSpeed & Safety Controls: Master the speed slider to safely guide your roller coaster cart through tricky sections without failing the level.\n\nStunning 3D Graphics & Sound: Vibrant cityscapes, dynamic surroundings like hot air balloons, and sound effects bring the theme park experience to life.\n\nAre you ready to build your reputation as the ultimate coaster driver? Download Roller Coasters - Epic Rides today and feel the thrill!", "short_description": "Experience the ultimate adrenaline rush in Roller Coasters - Epic Rides! Control high-speed roller coasters through thrilling cityscapes, navigate crazy twists and turns, and manage your speed to keep riders safe. Dive into an immersive theme park adventure packed with multiple modes, challenging levels, and non-stop excitement."}]}, "developer_name": null, "developer_privacy_policy_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Digital Aesthetics", "support_website_url": null, "website_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1361956813665028"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831964_1636796481306580_7163591498075365238_n.png?stp=dst-png_s360x360&_n
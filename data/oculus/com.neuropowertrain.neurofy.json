U-xow6TMBOYLRExFLHuVGLl6DRddrGkK9ik&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Putx6N0UmMzcz9xrxGq9zjX-3qZLLV1_JyNd3yIHgOw&oe=6A43D990"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ik56iO6U5xcQ7kNvwHlUSy6&_nc_oc=AdpFgu3FbfWa8q8X7aoBxk17EetEcuSFxLhHBgMKY0jsQZngPJEjyYjm9CO8lOBWCNw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Cjm9HQyVho-zGF7g8KzIxelVN1eL14KjLfEJV6KPl4A&oe=6A43E883"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2AVq_vh4AMQ7kNvwGWw3EL&_nc_oc=AdrdfiynmhBFKexUf5XH0qkytsldOVXgM13-h5jQvMpLkWalgFejmZGSD-lE7G4yRGg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d9SwFNuD4eqdhXOepiX8RregGE-_jUHzxn9Itq6Y4gw&oe=6A43B9FA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4hEUFSlmEIQ7kNvwEjXHpy&_nc_oc=Adq54cCvkTUcAPI1e_hWLnKG8_WyE_mfIsvpKXQtZh3OVsBaLU4WJffJ5xBRGjjLZVc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vnubn73BWwQOyHVENta9jx_zPAj7Q09GWHJu-vA-3bQ&oe=6A43E8D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6ri2aWjG_AQ7kNvwGp0knt&_nc_oc=AdoG8K4JeBW0FC2AC7ek9hO8VbQbAhqgO74uboMCkPr61Dwqa3ha0zpqGvrIMiJeMNo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BPe6idfM7SSCGOTRqORfvodDb1DsYVwJi_I4-t6pH8w&oe=6A43C1AB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
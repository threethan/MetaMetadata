A18IU_tBfomeG38AzYHxMpxcnorHj2EfjLo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5qagqbpGHSEPZgqhTM0pKSsqfa0mhi3cutBnjX4YLwg&oe=6A510890"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MDHBi628mRAQ7kNvwGzBZpK&_nc_oc=AdoLKT9VeBXRk_ibcmewoaPMNBY_GJFvFUmu4cYzy5PQCHRGeAGkNE_sP71nKl8qKQM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxGG3A1xYmvwhLEVBpBYvEzKy0eojUI1qQat1zFyAA4Q&oe=6A511783"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D065euVSVOoQ7kNvwFHiAka&_nc_oc=Adqka8PtmD62QH48L0XEPterwQdElu_hIv31pCsAPOz4yIcf2e188_KhPSvf9YiCFyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAe8obScpgh14HcX7MzShz1b6mWtXMzoUcpNUoDwc12hg&oe=6A50E8FA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=742FNQ-lu2oQ7kNvwHNycmV&_nc_oc=Adr7cu7USA56B0tZsc7hfyCf30zRg2kI2liCZR2GFMFSD5xGxtpafxrJBuUDICMHmN0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhhGd51cBYb27CQKX_SvygoucgRyiqZtZ5j0e1VhWdUA&oe=6A5117D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlVx_avw7ncQ7kNvwHBtboz&_nc_oc=AdpXuOL8vHj8Mq3SxqFcixxi4yURYPFpNxe4El1CSXjuEFgF1dLAjRgB37T7hiKv2AQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZaS7VskGdlJ0aYd24w5R1g2BnhsbQ8T04Ey5Xyw56Bw&oe=6A50F0AB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
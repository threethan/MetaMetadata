H6ggOvnNAXhTKxs0ucIwQezONc5NAApiC4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnGSaQaB3YWB2HJhWdXQ-rSy9AU14v5JvwOQgoZ8N_gg&oe=6AAC0010"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDjGnAY25KEQ7kNvwG_8S_4&_nc_oc=Adqmj57zC0Wv9k8Qv_NctUtKfANykewXurX_bJZ2awBokDP9GZUZNNDkxxzlzNyzTOI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeyM2kpByMMNOkRoWP-VpRejdWA6GJYVdQ5P2dNlJN6Q&oe=6AAC0F03"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCnD9kuRG3QQ7kNvwEODNFy&_nc_oc=AdqMOaELhVVd8omo-JRa1dy8V-5NkSL7NE9jN9Yg-YJQ-ePRp7d_JUAHpyk1ymEfEFc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDTQRiV6yZaENxdaQNvBnalr07X-ctkLP1wH2-WZ1osw&oe=6AABE07A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_SBxXSjSlMsQ7kNvwG_Cx9w&_nc_oc=AdpEfwm7uBYExhyAkqgeQhaKcoV5EXB1p8cjsjadDpeR7-lJhmn6PkedGiZU6ApzzU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL31-hb-JJsg5hN702e0_u6nYBS8GHIppCIHRi4uwjc_w&oe=6AAC0F59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMB1LGNZOBgQ7kNvwE5fZqA&_nc_oc=Adqcog487WNoKc8M5u8G_TSIqDGqHuy_75y3qXwoBRN6yWDuNSVyG4zoNJX9IsLVBkk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx_Gjg4d1kHV477ZdiwfDPXfMpFd_ZYIQJZ1be-NTkdQ&oe=6AABE82B"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
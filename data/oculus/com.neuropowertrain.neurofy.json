7zlE0FlG_KUUt2o7DsqowJgkfWAvJw&oe=69F0CB10"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xesSkoQ5ttkQ7kNvwF6oXO4&_nc_oc=AdqviM4aEJztSKbwq41ZtW09m1OEtWgyWh4EHn7RjeglMdgCbIUhJOD3uHTEQssiJRM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af213BbeiAbFNGatvDGgC_DWrrcGFT8t9rMMdtp-E8YR7A&oe=69F0A1C3"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciiNPvtjQNsQ7kNvwEfWhip&_nc_oc=AdqC-Tay2Wpr-HtzfFDK5bO7qBW4Y-gxXwMdouWHbYguZPLQGdws_VXYM7-bh5k-tKQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1Ldup0SIyJAL201BlhqshHh_WuwSK6S_fZQe46wqH_-w&oe=69F0AB7A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6c-r1ZAMnYUQ7kNvwFh_efw&_nc_oc=Adr5piihIlJ_N8ZqRmzD_BWTBRT8fhN7b6L1dsBZjH1AvgXLmK84TAETFZtp4p3zA4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2whD6VOq1N0FgZgtWYMJfbssgue5OsAbtnCM7GJ_12uA&oe=69F0A219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro1U9LRqzkAQ7kNvwGR5W-K&_nc_oc=Adqrg2M7wRO_diZRs-N_qFIP9ohC8bQl4923-rD8LLxvhxj03Rp8Nh3tnvKvdJt8xkM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2wuX98Smz9BTG_VW6na_3CpjAMYXaP_rW72GJC1kkLFg&oe=69F0B32B"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
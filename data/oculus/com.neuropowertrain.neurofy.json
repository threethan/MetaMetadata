5kVmLgr7DuSjUbW73mG-Fk1m0otyp-ivw9FSBsWPcWMPcfoRzHqs8w-GZWN0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FDXQGvawi7Iak8dlyl4oApsU0NPNPGOYjH4FlCMfcMw&oe=6A468B83"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2AVq_vh4AMQ7kNvwGvzKS-&_nc_oc=Adr-fQhGyoXnmdAdb4-qwgp9IY1-skUkBhkbtP4eRjevvBznbBpWEyOiYSp9WtQ8dgI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jNV84WXID4lJSQGCbTxOZqOsRaJCodMP4slF9X6Znog&oe=6A465CFA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y4hEUFSlmEIQ7kNvwG42gnb&_nc_oc=AdoUwt4yf2-B_iGxmz_oyXr2keYXOz1aQyDNQIz8--THVjv1AJfmHEIvT679KMXyx3s&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9z34WtHMjG2lIx_gESgA4yHhzVn-3V3Nvv1xmUEsHNIA&oe=6A468BD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DTq7VN_ysUQ7kNvwFjVHuY&_nc_oc=Adp_brwgKugXDBtDlL_XUdEkakzZaT15MugVvBvdFYToeI9FQadA4BghZw5uUaw8vx8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UjXDrBFb1DlZaCrW5VV8f2xe5uS8Ix4gG87QpJVgU3w&oe=6A4664AB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1131641560982428"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "350679900252107"}]}, "baseline_offer": {"id": "350679900252107"}, "is_approved": true
cdn.com&_nc_ss=8&oh=00_AfwWh05nuKBwQaI205B_lq33E8KLM6aE2WKlXy6KrKJESg&oe=69B2AB43"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SMCJmysRLxEQ7kNvwEUOeS8&_nc_oc=AdnEkZhHciSiOCpTn1ERHAwxwE7xAYn6epf8E6m1t_qx0lXnyFhI4FdBOlEj678Du5s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6q2Vimz7ukiRhnRtMuFnFjqcdJ78uBceSMCdiDydhcw&oe=69B2B4FA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=reAeZs5dxYYQ7kNvwGQwla4&_nc_oc=Adly6BaJyTahz1lFTj6cXY-GSg7FDlu1_2TrBBlz_HPg7pQWy1qvEV0lrWjjpHi9lHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzzn3YkQpl5B_VWu0Xrd4NOV_2HK0CS9qEEnjpoDH5niQ&oe=69B2AB99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXSS07kuIqwQ7kNvwFxvJN4&_nc_oc=AdnfW-XLxVE96w-zeKV6J8Ll2kJZSdSPKF-jkDc2MQUyFGSiZEV3CM7gxNIItH6pg1M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwI3zaA8pmPSwsXbcLpTghf8gFf2g4S7cEJH_1J1t_giQ&oe=69B2BCAB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1131641560982428"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "350679900252107"}]}, "baseline_offer": {"id": "350679900252107"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1644891000, "status": "PUBLISHED", "id": "350679900252107"}]}, "liveChanne
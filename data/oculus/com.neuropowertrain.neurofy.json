6c8PC4g4mOYqJf3DyEajDyGISP4m5iypG1I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzpmF8oJElyZDcKatxa4PUY-Typ-z_o3srOeYQSii6ig&oe=6A6B6690"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSHobhUbKMgQ7kNvwHZOVSE&_nc_oc=AdrHxMAxklreVVOTjiayIbB5kcKdC5qUhSsOXOvXNQm_p68AEkiBe_h56peTnpSmOUc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp8U6IIbUwXd_2TJnTT7j-QcQltsIDElHi1iO8WHEvoA&oe=6A6B3D43"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Myb06lTv2DcQ7kNvwFPKeNZ&_nc_oc=Adodj4K3vdCKfLbKXAc8pUfYHmCD3dHXA37t_dS5YeBcNGJIGX23lISSJ3s9l1bVFM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA886W7Vov-V0-VxliEvcgjNC22s_5n-n89BXMQobfXVw&oe=6A6B46FA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zo_c0T9nPeAQ7kNvwFuYzaN&_nc_oc=AdriwYiMjVNqoyPmWYkCvfIyzv50aWqD_wwi8O63kzzPiXzC_KQvKp2sdoI4Olhajxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDvtYD6U_Mw2xBDrt-5UuJlyPLDmky8oviZRDCGW3mgSw&oe=6A6B3D99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KViq-9TvxwQ7kNvwEZ4Akz&_nc_oc=Ado_uqxY348A69aNUUIZwnPMpHfg6iE3f2RtDWV8OSbUlW6u8NcviBqWwfbKzeGY7X0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCw9NPGdhDe_bKe0uP2VoBENDYz02vxZy7ygSb9gnThKw&oe=6A6B4EAB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
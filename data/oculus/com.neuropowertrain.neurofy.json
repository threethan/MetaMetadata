BsIthjLqMayP71zDMHJimB2BFH0okZ8e7WI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HGyMc1zAU96r93U8j162-Ie4HzBFRfOs_lRX2hxn8kQ&oe=6A1D9E10"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ge0ZLdgUyvEQ7kNvwFRsCUu&_nc_oc=AdqcxxvubGwExSa9V8MEqFqNOs1Yaa6N6iIKvF7XMg-Vwi7NNU9bvcBRsllwQfal2LE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QkYzda1yXi98tDa3VI0Z3NZRx8DeFDm1xIvoLJbcTsw&oe=6A1DAD03"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MosfldRYKOgQ7kNvwEE0tr3&_nc_oc=AdoOeKnz9dxMI2k18ksuUe-8movceU6_Z9H94pp6zcmM8m8Brg0bhbjDMbmPWki2eLk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T-sDhe-kaWPyzFpAi8WcV0we8kskuJa5XkvPd0Ar2LQ&oe=6A1D7E7A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3F1qwelAQt8Q7kNvwHcCP-l&_nc_oc=AdpNVYRM4vSHeanHIMSYLa12EcIu8P12cCSrH917bc6K1-oOvTMon4hVy06yyuiZ1dw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76gT5UQhOhiZ-Ou8tZRT5ilDmNZzAtiJDc5_VsyVn_7w&oe=6A1DAD59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2kl6XEgtTgQ7kNvwGbOqXh&_nc_oc=AdqhfYel8KNVcyQFx8Vj6aK7O8wyIyA-CBA1O5QhTYkUyWADTN39zesYAGxq3AEwN7g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rGKzsVwkvtZ9Fd9v8xK9pqhtH4jcgVa6fVQwsEEHr3g&oe=6A1D862B"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
_LLpxBcrl_pLYCmkZNOi8osbZXtCoz3OJVc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sI5ej0IP47v14it5eKvWPoIL_g4sN8MyQXcJNE0Rq1A&oe=69F36E10"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xesSkoQ5ttkQ7kNvwF0XOo8&_nc_oc=AdpO0vwrAXoWk-xxSDYrsSTsCb6OxdD4sA0t_Ul7ql9yLbw34cCPMbAlkav_K1ezdYM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2KU_lZ7m9t2ya_gaf5_pvMBDks9pdg3Dzr8XnLZpqqGg&oe=69F344C3"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciiNPvtjQNsQ7kNvwHMxDEG&_nc_oc=AdpS3uDTDx4xYFLr6Ur05Lq3wQAEXH-QWXcq6lk3EslBeVEj0hnaq5gKeaB1vN1QWvA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0sTISSuRfI-GBHQ_iX7OONu3w5zKIL2jW8BlYfICyYtg&oe=69F34E7A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6c-r1ZAMnYUQ7kNvwEEPjJK&_nc_oc=AdpaaR6U7w_HEAv-dQXa_oZcDLD1slpcBveWjSQk-5FSgGeSiKSHVoFqZ-_jkEkqrxg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0fO9z2bEZ15jOWcI8EOYzadWkfu9gjPGdzMPijfRZdhQ&oe=69F34519"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qmw35h4oAgQ7kNvwENPWwV&_nc_oc=AdqGvi3RESkORP4Gh8D3SrdJWC9aquNR5wCS48HjE7aUXwmCug1iP24IiGk5RgMZu_E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3d5PJaE0J6GK2vFc7mn0HYd2ADnT9Y5zcBHTiZPEHygA&oe=69F3562B"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
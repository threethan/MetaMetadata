nMYVx2ohE-zT2856SYf0KWIp2WV0NxTwNuE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDlGtOOr4OYbkXKaO3QjE49-GL-fsJc6PURYEw17D1YGw&oe=6A6F5B10"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tw26uMxm6nAQ7kNvwFSAHeu&_nc_oc=AdpTaxHkzkidGfPAIkitGxBdS8_M7mNM_ERtDv5mzaF7jtylidc_pcgetqtmRqI20gM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFelMeInLSUPs4yELqI-1IYPfgxPUqq_I0aCa50DuObw&oe=6A6F31C3"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6c7mIAFBsB0Q7kNvwGqpZXX&_nc_oc=AdrZYGOq2oiBm1n5L5z53MaOgd2BUjq6uRaoMtl2WsUlT2c5SxfvmPREn3RT7GmhR_4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClM_0XkvmyOWERCCTZ3xYK2s-VzLbISsE-Q4SRMHGopA&oe=6A6F3B7A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AMalvbK6UIQ7kNvwHXyOwP&_nc_oc=AdofTw4faFUZQpS69x50GUjkALrdZSPxokTdLgALYPpxBu4mibgIwWRyVNvulx-J3tE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCfJZY_9QnvDZ9upsgnKhdhlcH3HqecmcscTftGQCJ9tQ&oe=6A6F3219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olLvpxM3H0MQ7kNvwHinSU3&_nc_oc=AdqNtQn9gKpDm1awhs0DXB7ddY-uX-z77epR80UgEhDvU_XKCAiW_DQZxmMHv_xgG_M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDt7Y7vNZ9am8zMaAUycMVk8AO30brRHeSVPQfrIo4umA&oe=6A6F432B"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
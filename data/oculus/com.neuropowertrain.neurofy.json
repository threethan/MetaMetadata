cdn.com&_nc_ss=8&oh=00_AfxnKxEDeK3hA62Kn5a-bXS0Cw2Jt96_0TlNVbCyvskGKg&oe=69AC13C3"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2iK9Fgx6i8Q7kNvwHnaQt2&_nc_oc=AdlLUpNybXlpw8pNPAs4Zo1yt0SwXa4gE4a0Wm9kjZZND6pq9MIJktczdlyV_2FJzEE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxeda_STTYpTVB5YTiF9q3pRzfGUHfakOP7rcc5oL1n7w&oe=69AC1D7A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51hazGY_MQ8Q7kNvwFqZjhy&_nc_oc=AdktQAhe3WAe-Pf2QYXPJjEjfXCBxd_E1SSIpWfE50AStNkK6alPvwa5v-G4uqg4YVc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxDoLpfTyCR_nDXlI7DYapHGtVYtopcfeGOuEbw21N5gw&oe=69AC1419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f4SV3Jjalj4Q7kNvwEhPDY_&_nc_oc=AdkoMFHC6q-HivS3ZlFDUa-nQG-16Zaf_BaIJe-uRzBaf4vs6EpQijz83pkCX428eR0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz2-bBOJIHo4GzXlPDlYTceD4u4adpPJYmGSbBvToUx0g&oe=69AC252B"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1131641560982428"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "350679900252107"}]}, "baseline_offer": {"id": "350679900252107"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1644891000, "status": "PUBLISHED", "id": "350679900252107"}]}, "liveChanne
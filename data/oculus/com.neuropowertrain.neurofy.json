KiMwTt5ZZ3M_EZTS_DIu5WBMr8exS7hLRMw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjgRMFtGUDqP0vICYrXt3jYr10Aemp2VolKUkTZfCLQg&oe=6A9ADC90"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eECydD-G32QQ7kNvwGb5tao&_nc_oc=Adp75ino_VrifokxcTB5tT-OfaTYqijxORdoMzlihgYgOGmReC2oVIhoSc8op235Si8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdYsuMmMeLaWWGoaH-2Cg3zxTCbzsPZrIzbLiDmkvUwA&oe=6A9AEB83"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tpj7vqWMJoYQ7kNvwHSx8mq&_nc_oc=Adrpeyiq5YtXq2VXjvMwX8tt2A2_S-whvRmVDIOSJTttxX9_N8nVfpheAK3s9UF1Se4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPgAAMcXIIVQvN64ReJd1snpYVnXzfg2kHCyYL-5zRrg&oe=6A9AF53A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NCV2Vx7olWAQ7kNvwFMjRez&_nc_oc=AdqG-n47T3BTRs59AaJr4pa0PbjlGiUHkH5-AoJMsXZueVO7p-lRNHaG11EJso3tMPU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-2yJ9LGQKWCuaIF-demUNkXrSRuOxNyNrWlS6RyZSKw&oe=6A9AEBD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhuUFQFkgnAQ7kNvwG698Bn&_nc_oc=AdoJSFB9vNoRuoSi-RnSRgILMWx7M8-YKM8oztoAJjiO55pKeBzKFW6BjvD6G_zRqRQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4j3_wUiboSxSIHEo7dCM33ZBC5CfwYfvTw0N0CUUg2w&oe=6A9AC4AB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
azJWOH98OO0J6loA9er-W_1PacMKboUUWaM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16DqDZEXEwqiXWVAft1lfX3d1veJEi_OKS-y86F2WVkQ&oe=69D78650"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hD3zYr6IUPQQ7kNvwERZaaN&_nc_oc=Adq7m6a_WLNKWUSo-9jDKm2d7N0be8FD0UvtGCYR-wjxF6FkS9rLyJCtFIt0IahA6S8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0noQlhtyhV5V0T3JCZtykKqXp4cAEfpaknEYAdoBB6Hg&oe=69D79543"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g2MqCCDq-aUQ7kNvwGqO3KK&_nc_oc=AdrJZ1FekN1oSFkDfSO2Boie2Ef4UTmf0ztaU8m-fgwUAjEYvyFzpopq_w0Y28fHldo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jrUfEixShOJPksi1UAYUyn9y2sl34poklvPvy1URwvQ&oe=69D79EFA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mANWgglpEzQQ7kNvwH8GsZF&_nc_oc=AdovesketpIQbg0ff_LXUAJpLTNotBeg0G9P5kKyLNoZ39IKdZyT7opj-z7C5iICxvo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2N1rGUqkyc_OZ6nnN27NBIFrUTBuavAUjPvXRKHeYsmA&oe=69D79599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6K46dNURQY0Q7kNvwHKvvF4&_nc_oc=AdqnRjwcnIa4LwtCs9nd5uiuoy9tnvlrasRvBpaVRvfWfG1CRH0E4-mXM5HzZybZcy0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cdU1KIGM-8klsOiNaDWF1UsFVliwku-nfaUzLx4wNTw&oe=69D7A6AB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
Z--_8nVCCh7nggDSPGCHZRaJgOaczqbFL-c&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPQ7-iuN2Iq_G-KXQkoTEOtAPqS7e6WgorDfkr1QDhD3w&oe=6AC50C90"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qff7R-E3QgcQ7kNvwFeyrhT&_nc_oc=AdoKVQ16_RZJ85WMtUbrtC6Y9YAk6Q569OsU2a30crAMxrNbSu1wFNpF8f392FLqNPE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSANsHpTz7JfsN4OT7g73f7PZkoU6LYCla9CVw5oTHcA&oe=6AC51B83"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfaCqSlbZZkQ7kNvwHlZtUa&_nc_oc=AdqDfUY568QAPqb_sJCRTNdB1i1tJPP0-z1Gh1Y9rZJfqx2XqyMOKdis3N2O02Yy78k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI9f96CmMAP1dIzURApUNzf8cGYqSEiylLKthVLGRVbQ&oe=6AC5253A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCLCAe_RT7QQ7kNvwE12PX_&_nc_oc=AdpxiO9JKPSzrR2rIvXjefvChXgtOYwptmNVuuLWcyCT5JwdO-FlTgL-e9Qlie0dTBM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNirDu7qnI747B02YpZlmr4Ld3sRt6xJrc7WsCl7VsF8g&oe=6AC51BD9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1131641560982428"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031375_429280495301898_1461604458378816666_n.png?stp=dst-png_s360x360&_nc_cat
yd9ioH-FFyTQMPiaRTH5lqhSzBfbzYxwFzc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2REdj6Uy0gFSLiE8dBkV-Hgd34RObZYClNASvFkRaTYQ&oe=69DA6190"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB4YK8CQnLIQ7kNvwE5w-4i&_nc_oc=Adq71UYLYuXiCO7Xf9fYMNH3GJM9dE8EyNN6siY_f4YEL9Jxud-8xWI_6XQnpFewgFE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DZVeQ5mTGk69iuFS-vswQXwS5CyJCeuaNRma1KSKxAA&oe=69DA3843"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MnB51FEVUlAQ7kNvwG8suDm&_nc_oc=AdoDmlEwQcS-inTHd4MQmkApoIrBeUknK09nEaiGf8JGv5k2peTkWeMxt1XJE95s1Fs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2_qvJi0U8H8_XxLE9ITETMyag1iEQgTGFyJxD1u9qEag&oe=69DA41FA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTtv74HT1l0Q7kNvwHpdYaP&_nc_oc=Adq6KT_hiYVqw6OFbb9FLbnT-Bk1S7P9Bmm_jKMjmZE9nM8_o4r8ij3l3NrA3OiY1NE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Ll9kc7Ex-QW9WV-DIpXFV0g5QuHFyh0UO-MZ1GZ4AiA&oe=69DA3899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10sJ0o8hmtUQ7kNvwHGLoc0&_nc_oc=AdqDKJGaVjpmSsevJ6jOIhEtfgig-w8t3Y4ragNXb-taAmEMUh4n1k5skerXPyECMwE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TnVVQcL0zSQiketCPbLlCkzu2uqbO0YehdZZU5wYovA&oe=69DA49AB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
pSZTdJaeneV5FA4osbEKdj_-i7uip25C4zM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47Ry8J5iegyCUhvzsMuylWsddtVbfA6LFt1FzDHGLIXQ&oe=6A0F1D90"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i1eP2VOffj4Q7kNvwFVtJsu&_nc_oc=Ado4eGeyrf83aFjEVx_WTmHASTMHwpds4xrpzREcbjgHwTp5N4_wPrESsafdZSYUnr0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Sm66A0jexmIQ_p8e9JzfmJQhhOrEw5MvfAK4G1olFFg&oe=6A0EF443"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c22j6hvIE0AQ7kNvwGv0mL2&_nc_oc=AdqWHa6Q64uVI2i1GaMdxIWgYdWuatLGGPETt4xZLXTuxywx1BNU9BPPXR6suy8B3ls&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HfhdQLUNw9azB_jfP7T_AvzxMvTi1JJKeZymPL1Kr1A&oe=6A0EFDFA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQ77Glw4utoQ7kNvwFkLON9&_nc_oc=AdrR7JeXYhWJoAeZ_LeraNbbEA5eRV4v7Z6DfNX1fbnhZC3HNw1vgS1IFUh-mSfolmE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7R7bgZo4MlW3l6Hr3bwUonlsWlXLtcgkKehLwCuflbxg&oe=6A0EF499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=srKf9U5affwQ7kNvwEPRKq4&_nc_oc=AdqaKAR1VEqrkHu-d87OWdbub6uuS8h672jAo9a09JfO586L1ALIKmXGzFlwvv2WBJ4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FkJ00okmsjVGp3paof_wiFH8AabKAh3J4z7pBpO9QQw&oe=6A0F05AB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
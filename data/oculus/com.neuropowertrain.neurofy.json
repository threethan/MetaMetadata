Q7v2yMOQzrK_OxP-ciiw7nnm9DiQz2KJ7Sg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8T1tKY4HO8K71A2VQla58sLLwBH730_GpnPN7HpF_QsA&oe=6A32B610"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IVadDZFf1MQ7kNvwGRf5py&_nc_oc=Ado5Zj9sEygdUsB8HRFGBe_pjdPZ2dsFBk-ZXtjBtVNG2zJ_167Tya9KFK9Pew1ZQqQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_RF7KdSKttqFPFxF1UZoTf0XVItSu1P1HSVraAYgtwA&oe=6A32C503"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qAeAsQZHCoQ7kNvwGzrJ6t&_nc_oc=Adqewii-9MDEhzKJZggxivUdbD3i8c806jDC06oeXGCccU2qVQvwuQ5N9EKQcwHFIpU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mktIxSGXFkMpods9csQXdblppxBVKjqPl_SwjZDGdzw&oe=6A32967A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rG8OzPphMwoQ7kNvwGNYaeJ&_nc_oc=AdpkPJBto2-vmdCPAZVBqemG-vZNNP7ih8XC94BMXOgpcGcs-ni3T5IbqfIPSm4ouJg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SvIgYEABVF6PsFfN8N-XeZMSkdj9JRg0CT35azwAbgg&oe=6A32C559"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWQ-fNV33j4Q7kNvwEuSDUr&_nc_oc=AdpHRXipxDHrDMdDweMoHqGbpH4XpEOOPVZOPgopoZgJowimuOHCH5UWiAHF1LqhvuY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sKYRJO4FBEs67w8tvvJaDDfUx61eL3QfuHXAXl_gMZA&oe=6A329E2B"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
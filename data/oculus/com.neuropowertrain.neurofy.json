_J6RXsCnhikIHN8VmEdBbrRFfdilAEuPs0Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZogmNhyZESay_Gpr3qISg2TPXphEJGWi_LPilwBUnng&oe=6AC7AF90"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42EWQ7i_p6AQ7kNvwHBkjKl&_nc_oc=Adpz1pTub6hXCjqkB3bY0Ekq3sWhIXCe9OoQ3IqXcXqfT_jyODusC30Ub2waCMROU5Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNX7seN_PIcnBWul93rmS-bu0wdLtlKIcjS5IY7uvJFQQ&oe=6AC7BE83"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qe4rDs7zOXkQ7kNvwFxxCiQ&_nc_oc=Adp4rxEg9_JT_V_b2d5tAb-IPySDekgc576J29lcrd_hEDjkFGwb7tQMm5jeKUYjMCA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMI0R9wQjtHRzQEUYlr2PBLXXrW5iCq8chVMDBbae_3eg&oe=6AC7C83A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e6371PaWC30Q7kNvwHbQ75M&_nc_oc=AdqctYCsko6NCvVsoU6OnBWrKJxiX6mqhrzQxVfXoBUqWpoIHUnFxpWtlOwYAEV35oI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe0QZg-hKBrPcsI21LR6K2WPPJQG4PycTx9z5Ttxe6iQ&oe=6AC7BED9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1131641560982428"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031375_429280495301898_1461604458378816666_n.png?stp=dst-png_s360x360&_nc_cat
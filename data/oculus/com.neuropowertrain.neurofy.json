csE6XtUzZe1jWXU4bkijauEPl8JFhz2X0e0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPH1k5XY5XPymRrebE3ThD9VcK2FjfMol0ph1JhjV_MQ&oe=6A82E950"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ECp5Jfgx8MQ7kNvwHRjgil&_nc_oc=Adoh5jAgmmBrweZYnwn06t2BL43yJuqCd1Xf4GY7FfMAlzC3nIHH-CK-RErLPShXHfU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSgoRgqgNplR27-jE9CN0Dg_buT2ViSh6OZsr5mgyqmw&oe=6A82F843"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cV9EGlXZiicQ7kNvwGXU2yr&_nc_oc=Adopc1k-RXNWjWCEMzd1gmRdVs3-QOzwbcRhNzlXvx2e3i8wB9mqcuobscWxrGCPgGE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEg2BiKa-Zzi3G0hsZ2hOAWok4Cxycq7FUfqO-6Jx8QlA&oe=6A8301FA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WMKkZ8Z-XAkQ7kNvwFvJ6uW&_nc_oc=Adp6fjTvu8yx9ADnIOWBk9zKVro0JIRWt4gcDdiLPv6_Ov03vL5etrk3r-M0kIP8HLU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfuLPq6E1UoHQxZviPWkMolBiK5CJhfaXRAcYIj4kqPw&oe=6A82F899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u28SyW_RUuEQ7kNvwGpEfsR&_nc_oc=Adr86nu4hZV8JOtU8SiYkzTsdVEjjX3DkhhAgQ_3k9BZNAZn7sTFsZLChYSM_spT6UU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSYRjYO-IkPpFlXQzLfprzGNvW2udVvGBbl_J6oc1bdw&oe=6A8309AB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
i5A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVE5kejSPO9S026IERf6FVNmPT14kQj99O-tiTmjf2PA&oe=69BE79D0"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-krqedlx0XIQ7kNvwFpSmxi&_nc_oc=AdkxzL_bdYWlB5nFGR70jn50PA4vcZnv1y3H3t3Nsvvw1fg7HIcD_O8P-N3lOQx_lsM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1CarA5_n7us9E66RjiFPfLgt2Q5uRovyw8i0hBpck5Q&oe=69BE88C3"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6SSLEL4VLWwQ7kNvwGJFHM4&_nc_oc=Adl2g8yGE-hftUHV_BEz-BGgsDOjMeRJbe7Q-zxWJWlED0jXbHkzU02TQPKLgBXh2yA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxG03c8AQ3jHabjpEolsJooIFFIvfiX6IC79tBLj9Mpxw&oe=69BE927A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HeIp9bmNQcYQ7kNvwGqtTKG&_nc_oc=AdlAQv9AzhtU3_KcWKvHBCoexKV8FuoJEOOjlknjKROm_ahmeyPLnJEnH2E1cwkl5iU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxvauibrDIARExu37IiRC6l235_lRiwn3gnhYGT-gK7TQ&oe=69BE8919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KrAotaRiTd8Q7kNvwHA6_lo&_nc_oc=Adlgx1Aix7evuMVn9bipDM-mfeph-62Lb0JJbIx_77QTPxip64P0792qsngrNSy8_qY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afzpd-zaoUk9sLpMNvzto0t0ewojB0k6gebQqoswLTrM5Q&oe=69BE9A2B"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
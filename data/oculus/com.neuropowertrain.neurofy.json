W38&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxt8Y0gtXywTQ83NfPrz0WpAANNWGLSZFTLJfZZ7pHMOA&oe=69AEA7D0"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edowpgH3CF8Q7kNvwFJlkf0&_nc_oc=AdmTCt47vsJct9lyvVUnLK_NR8K6NH9fuVDpXsQDL89bdDJriwi-xmVtUD7Yd7kpaKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afymm_nms_-KYr3yak7WEWaf1RKs6se7CL8_nET4kIcJYQ&oe=69AEB6C3"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EllknmlhYyMQ7kNvwH9ZuEs&_nc_oc=AdnicE6LM9S_vAwfCUjYyl1o3IhtnagM5Quxn5imoeRZiYGtA_n-3GaCx8bWCySHXHk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwNiOh8QO82hti8zaV1lFXrgEOvFCRBra0NMOK7NSI6vA&oe=69AEC07A"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJZ0Vf-CVC4Q7kNvwE5_m3t&_nc_oc=Adluyd2HljJyg0IU-iJb789T4NN_kjta0dXTR8UCUL9hffs-OthCgojOv_3vVy5LmTQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwoHBF5eUumQf-GSMGssvY0PjpTYQNAa_b8OKE2eOqdOw&oe=69AEB719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uzFerqI9m8Q7kNvwESfTl_&_nc_oc=AdkXRuexwa9i1NvyVQTlZPYI_YW2B0JhWp--N6tWPGzi4bJQaC_XiINgyItSXt3uwZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyi6UdfmUrOLjpD9Zoyte54YzyKrRRLa6q0x_SP15z4fw&oe=69AEC82B"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported
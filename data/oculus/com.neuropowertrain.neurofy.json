9Lg89tJHuOP9eUiUJ2Rb4aagVH2LPYdeygE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uoHmuXKAiqAk76uKAMdRQnA3FT4bjLVUEUCJi2kV8gw&oe=6A170690"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E28PKN7Dw2MQ7kNvwHn4vfb&_nc_oc=AdrTY3l73bQIZ88mvyqtCW03hylyNicWrlF5CSZXtqTgGJ3nUVoWuZJtWz-krzTU9l4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JulbiUfP4wLEjFqCkeacy07lV9p--TlLsOMgZB0gLNw&oe=6A171583"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJQr9HV_KKcQ7kNvwGZKggj&_nc_oc=Adr0ggIoaNsrt_XJZj_aD7UFlE8ugRHauS4jSZyZTi9d_6sW2K3flV7KEt34fRSHEa4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BSrIxrvmlM7dE2DgxMLIdfIvLb6QLGOqLR52iO5GoBQ&oe=6A16E6FA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TZODrwCX9IQ7kNvwFiYufJ&_nc_oc=Adr3ighAFuj61JDOYjatlvptfEgUs4iTN0DmPT0M9fnlnn0kHbb3b9IJcbuePOI8bB4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41jVMBY8pzpzrB5c7pTUPgK7FtDZfkW8J7cfWwPWDubw&oe=6A16DD99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VKMuvWrsB0Q7kNvwHZqXuN&_nc_oc=AdrOy4Ua3yHzHyAbi_AQ2r-7SL0CDlzyiRA4SyFPVhS2JenmG_RimXjyem79tEdTYNI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aycVoc7SKx9ZhoM-9Wp67a6A5Nl8W0_T06OBOftKm5g&oe=6A16EEAB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
TNOE7CiuQhjV_Huj-FAwc7tc_h7qr4X7Lk8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOfWI6bNilvLpn4SFneqaBp3x4EGP9Db5FLte3iDwa_tw&oe=6AC3BB10"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qff7R-E3QgcQ7kNvwHIZSX3&_nc_oc=AdoaAPuV8zA-_CFyrfL3OMljp7FHsRQS2VQu5vOdiOSV_XQJl37c8U7aUO3bbO5CZB8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkeyLPyr4pH8_-ah2nRJ5zATVaV9B1gMAe6FXkCEeBzw&oe=6AC3CA03"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfaCqSlbZZkQ7kNvwGihMr2&_nc_oc=AdqDBW3T0fe93jjgyySLOGHCZdr-egUZKjIBISGIEE44BjpbvQQME5y0fC5RW8yAdLI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNc_OFMqQNerQysTIoVCDik3o-NwwQ2lupPohcmyJOzFw&oe=6AC3D3BA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cCLCAe_RT7QQ7kNvwEwR3_v&_nc_oc=AdrXx4deBsfzWKkUOLg8LESDqAMEHfYj7WcDLvzuUA9lB1OdilwX0Y0-tbUyBY7GDZs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5MmvW68lB3sAsKjob5zzWrVrUoLpjEegtUPPSC2a_-A&oe=6AC3CA59"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1131641560982428"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031375_429280495301898_1461604458378816666_n.png?stp=dst-png_s360x360&_nc_cat
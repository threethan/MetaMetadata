4Ty8UqrAsUGeRZsm0UwL2LXWmSe2jwfToCWoc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFXMAPhepCRuzR_8HnZE8SNlY-OA7M4Cn6v0gqH-3Py1g&oe=6A7DA350"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvnmH4kUTy8Q7kNvwEOzcDI&_nc_oc=AdpTgbCJd6cfi8iYOY_dquRDZ0ycAeXvMFVe_HmVjlj0HDlphi7hrp4K3jLb5W57FDs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENWTiWLMDIS7ju2108En-lGEWQU1-8ZFR5i_xpa7BuTA&oe=6A7DB243"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUHSe5GbguUQ7kNvwFwwevS&_nc_oc=AdpnM2fVUQav_N6Pey1bGW009xFVFxkKPxqh2Wm8-eU34Cl7DGqsY-pDn2FNFZIs-Zc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHi7ko1bi_QNPjcDbUSYzqpRs7u0Fv3KJDRIMZ-ybojQA&oe=6A7DBBFA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGyRBZ366qkQ7kNvwFHOk-u&_nc_oc=AdqBqpSCk1rW1RTQDog5iGy-LgOUJoaHttVXrD4IICJiJw2FGx5p9inCQUhYmkQWttU&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7XxAtM9VaVf3OCqOtwGIDi1UOXu1o_x28gXR-a_YdvA&oe=6A7DB299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qVu9JqylGE8Q7kNvwFqHRpW&_nc_oc=AdrHGBXRmOAy4nxgX7Ubmf9p55sXmDlp4HPeGEcuVXxbcqRFnLUe49g0XK4AoXMWByU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfBixHNy8oj_UtZibptP2T4ahRETQmuOak_EQjEuTAFA&oe=6A7DC3AB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor"
cdn.com&_nc_ss=8&oh=00_AfwMLEzibvOiFQWukMEcF0u1WQQMLCvG4yl-PBADouO9Sw&oe=69B00843"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EllknmlhYyMQ7kNvwGnPUHg&_nc_oc=AdlGPkT1VXnxUYN-ppXmdqEOJIa_pXOmXF5GWedo0EK-yJv3rieC88CbrQLnWUnQEAU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAHXVuFItbMCRWreXKsyBTkpxKNEGAkXQAyWwfmdvwAA&oe=69B011FA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJZ0Vf-CVC4Q7kNvwGBeVdh&_nc_oc=Adk9kcBY5iLZzOI86Yl94HGOjs9vU8jlEQxkgIpJ3E6BlvGHLeAJ2OI8HO336gXd4SM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwN6X-Rn7fCPq_I1eFjPuEt9Wzj3WUbtO7pN1wCdR0yVA&oe=69B00899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0uzFerqI9m8Q7kNvwGhbdLn&_nc_oc=AdlLt53vsUkTaLNgDGovIVYji09SVJ0qqQw2EZCE_M4ijQlWVEVOY_sIKjVjA3eFgxE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzG_R3KITOs4lHhL52bDKMGc3i-Wh6ChFCai0h0kkh6Kg&oe=69B019AB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1131641560982428"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "350679900252107"}]}, "baseline_offer": {"id": "350679900252107"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1644891000, "status": "PUBLISHED", "id": "350679900252107"}]}, "liveChanne
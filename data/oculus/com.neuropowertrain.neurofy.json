Jh5ikjH8o3RSkIc_j7wVyb9duQK-5sykFj0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDv9o-lj7rQQrqRQ07ROwlRkzrtk_WF7B6Gu2HWtTJhjw&oe=6A637D90"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wy33hafBtT0Q7kNvwFDpwNM&_nc_oc=Adr3T9YlGoyqsb3BtDkh1dfe_GkA49HHekWFRVl-B1pPxE55z0hMEnlWFZxspfthXUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL0CK6TLrWeI_QRUSGGKGHGOsijMiaCIMQspN2s-Oj9A&oe=6A635443"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lXMZb0ZW2LAQ7kNvwEQMk73&_nc_oc=AdrKMgZfsRlaOhETxwTo0TChwanAAbIsQqi5brhHNA8DEs7TglTAh9O-KM_x5wn1AEI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4DogZK01bS3T79Z-8ho44Z8nhHPbT-YX5Lnp8SKeD_w&oe=6A635DFA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mBXnAsmfccQ7kNvwH4GwHo&_nc_oc=AdrjNshhZOhWeDT4IG6pSRi_i8FhA30Dx7bUNh7gFV6BbmYrBq6PeTH2ka-zJgulnRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-RoNdSGfJXykNj5Lz6mCeetuJJUWB1jm49yhKAJt6KQ&oe=6A635499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2UjnYJ1Sb4Q7kNvwGiKKEu&_nc_oc=AdqGn8lzyGQfp7QlL5KEqSLYv1Fw0fMg8F1C6vcckiZ5ayEDmfqEs7t_m8EftMm5QCA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBIAF3HsU9VXf-LpQkAUPTNKeTg1mcG502gTGi1mtd8wg&oe=6A6365AB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": nu
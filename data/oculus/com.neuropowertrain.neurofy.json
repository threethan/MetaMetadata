3SHvR3kXimLQ5k3RmpIo0TD_WpHKbw&oe=69A2CA50"}, {"file_name": "3.png", "id": "967794083773102", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982452_967794087106435_6456103969462276635_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tddbxDM9TD8Q7kNvwFc39Uv&_nc_oc=AdkdoPSIGo9exSDnbPrDq1-C1GUZjptg9G2e21iWpKPPIug2RWMwbPTt1l2auFScKzM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftfO7DevSQ7i9wLgNporgVJWHhbDqsuIH3jyiVTnFzH8w&oe=69A2D943"}, {"file_name": "4.png", "id": "251315460388406", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575346_251315463721739_2754552499037550654_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYswzykZ8jsQ7kNvwEQ5Fvd&_nc_oc=AdmdVzohDCYEJyuRkmoYF5YlPo8jhUB5Bc6eE7lBRd2z-kZWv5n07VPwE3VRHykNT9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZIauzChUM6h7fLnOcNG1YauG8fYtfP_cDUQqr9ghTFA&oe=69A2E2FA"}, {"file_name": "5.png", "id": "1181559665699332", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57572940_1181559669032665_897008458602876547_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw9oXGKg97sQ7kNvwENJSOx&_nc_oc=AdliXfzL5QwtRUo_tUrDvu5iGRJ0TUl5B24DFjOI1PN0hX0XV1pvIzgFqGEfKsldh3Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfufhUClUJDo5KA_X0LjkfBws2kGPcjYDQFQHDbeOneVug&oe=69A2D999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1051931178979053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974537_1051931182312386_6156612661351531144_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7q83_QUCUyQQ7kNvwGzP5-y&_nc_oc=Adknk4rMEDpFLSFa0sTy2iC-4dqBZj_8gmtSHkJOAWIHX8g8DHoFy5t6xTnXjfehu7o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvxdfnua-jTqiBG8kyMXtMAU0-RxsyiU7BXNyBLctc8tQ&oe=69A2EAAB"}, "display_name": "NEUROFY - increase your cognitive capacity", "keywords": [], "long_description": "At Neurofy we are committed to advancing the science of mental performance through clinically-validated research with our product. That\u2019s why Neurofy is currently being tested at these centers to help advance the state-of-the-art for attention. \n \nOur platform allows users to hyper-customize their training program through a web application. This platform is especially useful for scientists, sports trainers, teachers and psychologists. Through the web interface, users can create specialized programs, manage their users and devices, and track the progress and improvements of each. Every user has their own access to the platform and can use the headset independently from the web interface. ", "short_description": "We always try to be better: at the office, at school, at sport ... go further, higher, faster ... train our body, our muscles ... but what about our most important muscle: the brain ? \nFinally, there is a way to move these neurons\u2026 reconnect them and increase your cognitive capacity.\nWith Neurofy, you will be able to train your brain in a difficult environment\u2026 and obtain verifiable results.\nWith 20 years of clinical studies, Neurofy is the future of cognitive training: try it now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://neurofy.app/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "Neuropowertrain sarl", "support_website_url": null, "website_url": "https://neurofy.app/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPORTS", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [],
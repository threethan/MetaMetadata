kNvwEJkRtn&_nc_oc=AdnMm7gawTK-nuIN9NVK4T7usQHN2s77W3XRgMOi9wVSD4-MQfrXE6uVrwx814pTq6w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwMfFFxjraxp2qJ72RgCrmkfJNlxcuGNPJNNkv1XV8B7Q&oe=69AEDB3F"}, {"file_name": "Untitled design-65.png", "id": "1931969893889271", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982469_1931969897222604_8530448425778764889_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns7dHQOz130Q7kNvwGUm-HC&_nc_oc=Adk5bnLQq_Sg4Xvp-1wd8NO4qCeSXSJN63ZYuwYp2vW9HA0otQzEgIkGfLod4gmfMgc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyZfuNXsgm6ZdRDXfq5Et6qDgU-CiO7BTbcvpUIhKBS7Q&oe=69AEA4C3"}, {"file_name": "Scales to any size guitar-3.png", "id": "222599974216860", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/65228806_222599977550193_1783402009710633868_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KChvqygvCYQQ7kNvwHyr5hF&_nc_oc=AdloWdAIZmHTqU7wlGo2okxmUpJyE-wNv0vPS_3Bo7HJYVOfeBPHXQE0-MGZ7RsCo_k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwyo4--ti4oLhrfUkmUujM35ezEN5eHMEQVV26Rc4p2Ug&oe=69AEC07E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MdGODlWljwwQ7kNvwFW4w-s&_nc_oc=AdnaOVlWhW4x2JvnT10otSr169nyzYIOnZ2FppQbdH1rymaeUO09yk0CcHPnmGsTATI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwzx6KlPkNDKv7OsqfJU_qz9efJIYhEtV9gKxx-kAEJLQ&oe=69AECD5E"}, "display_name": "GuitarXR", "keywords": [], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Oculus Quest 2, Quest Pro, and Quest 3. Discover the art of guitar playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar!\n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to mastering the guitar in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else out there. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7203991549657867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1034465598258009"}, {"status": "PUBLISHED", "id": "839022478236682"}]}, "baseline_offer": {"id": "1034465598258009"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725568260, "status": "PUBLISHED", "id": "1034465598258009"}]}, "liveChannel": {"nodes": [{"latest_supported_
_sid=6e7a0a&_nc_ohc=oOZO6pSO8GkQ7kNvwGnOHi8&_nc_oc=AdqE1Ayah1ZnkwNy8Ock2qtlN95n7ERbAyctl0okdiVJz7vYOQE8jSPuoEOQ0tfrAkY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mT36-vwhiOlISb4d8xl8hMqVQ7PdqNkaoqt796rV0Sg&oe=6A203B73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uC10HGp8JPoQ7kNvwHMlLza&_nc_oc=AdpQ3u3nnut5dorKFhZSq6QHxPIhdxAwFpIEzjg5LbK2-GHyGk-6tkOQtJkQvAw5i-0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78tv8NAb8lTPFU-ZrwZEuZeUulKYQQg2YGIyrNUavTtA&oe=6A202E26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF8QC2UIiO0Q7kNvwHMXG_h&_nc_oc=Adpcwa6p5wuppYCfTNwNEJejjwe6ukAEDAYBFrKF321LiRtYjaEFvN5105vilGLpc0c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tr2Zhn9_kqUZWFAwirah-i4eDwJoUcXy6ldLGAtAD3w&oe=6A203C3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2zjoTDGP1YQ7kNvwHIUKQk&_nc_oc=Adp1kmqF7cTob3FjFmPBzytdIFrKMx7GCUdGl15ycFq9f2M40W4Z_nrMloc08KHnCTc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6hRLZ9GYzynV_iuZmjFzgr2V1QSUCO3IdGSOVDPzDkAw&oe=6A2029ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNAxEFxgc7YQ7kNvwG5biDk&_nc_oc=Adq0tfASlBxBgyijJRpG25g7Y9cOJORFypFkGas_8gpYINQ3K2bw0VeW1ONjuNAiMDw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CTwITUJ7pJ2THjVJCy59yCiJ0RR1MKwOeJFhowqx57g&oe=6A202E5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
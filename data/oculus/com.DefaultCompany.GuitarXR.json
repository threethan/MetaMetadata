_sid=6e7a0a&_nc_ohc=520saUP3tuEQ7kNvwGeS8h3&_nc_oc=AdolrkVNNnpFoum938ZKRj2dcspy4dE9cC4yRmDq2eUChN-SqpxTTH5GurW2cziYV2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzjDPeES-aeiHbXJZ171_Z2Yk_-ut9FjoQia_mw1VSmQ&oe=6AB534F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSB9oh4l2K8Q7kNvwHwrXxR&_nc_oc=AdodpjtOf4hgbGPYc0KNz_-X_zhq6zcWnzqKXmFQUUg2o1OQZtwM5xeK1aYkdPGTBQM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyNinD7YLU67mT2-_ZGfdOnmoNnYc7Els1dp6If9KEHA&oe=6AB527A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZL3E7oCUkYQ7kNvwF8JtoB&_nc_oc=AdpjjgpXyloPj3DFh_bw0HJQD_8ryLe_aQsTACQMjQY1buz1KKoiwZDNwFgWridO71o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpg7LFq6_DQVABWhaGi0hagEsBqGAXM29S22DjrcRK3w&oe=6AB535BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znwvj1D-nYIQ7kNvwHusUmP&_nc_oc=AdrPm3jQwUjbvRvzBcWV9ukas9Sk1BmwBYGM54YAV5gYzmdXM6Oz2eBDJ-NG1VGquvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ66Tz9aR0Fm9y1NdG4nhUFS1AklC-T2v_Y1cTxVW8e3A&oe=6AB5236D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5RFgNtmUsYQ7kNvwEUO5dj&_nc_oc=AdrvClOC_iAKztg-v4fTyv9eT8KrvRrpxYwzBc13DZWzqCT7kYR2DN2yURPTBrApFww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2PQrmi7zRYYgu69tYnK6HCM3xPR_02-HZ_WA5MLPwzg&oe=6AB527DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=3_jnDZwtGwoQ7kNvwEUDwYI&_nc_oc=AdpOdsGE6kTkcwcR1IMhqsUk7YzylNh_Uj6wcCjmktk46CniP2jt1ckculuPcf4DcBc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHUi_2FO1WVOlITnHQKPnkOas19d8JXDMNSYpu6AXGgg&oe=6A58EBF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_N_yNwEC4EQ7kNvwFAEMDD&_nc_oc=Adp2Dnkg0IEF-hWZ8aJ58dQfVI-bR1ZlSUQ-0nYajalim-nWYsixdFuFbMdcxMvv_wg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeEhvfgRItfPYDdN1pXgmLg-FuZKQpWn6xsytP4Kl9eg&oe=6A58DEA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr1HyMBVtfIQ7kNvwEWGOtP&_nc_oc=AdqxB3O5M2jPLpqLxlIkLFL0ivJ1GgLiRM8TCDAvvR0hanR4kbW6-9H1i3cVg3ezu64&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6zaONnYMVnwXrdA6H-DYN_umi1Nl2_gExNhCMUcnO4g&oe=6A58ECBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRPfP-4S_OoQ7kNvwEl9HE1&_nc_oc=Adrs1cV1mOh6Y4syhsF45pB2AsnX6GWAAN0KjoNwPkApBe7sJt90HtVlwSKRRCAb9Go&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtYwE7sQw3eeB-82nyDAU7T6NGcxSPFXNA16Dt6IzrWQ&oe=6A58DA6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erCCfT5amKEQ7kNvwGc9ha4&_nc_oc=AdrCVjP5C7gy7pimKYYTBbK0v_1QCCJtkjM3qUgDllzShXiBmbL0QbHWwkdhj_m-iiM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJeC_oW1vJp-2NghgzWQR2C91nCOma2SAwnN1XBU2AkQ&oe=6A58DEDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=EtuSRtCRLKEQ7kNvwEL5SrS&_nc_oc=Ado9fswdmJQs_WwVZVLWTr2xYJvdoESUbA7tNzXdgLDAuk0ca9W4HvfIe8u6KUECT84&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6iHWPUD3pRCtmugqsmCJ4EOFeK4fY535An-C_RUUWCA&oe=6A75ECF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8uI-uYwgWcQ7kNvwEt1YLl&_nc_oc=Adp-AayrqNo-zmguAAFCgfNS1hxReZjtIyLqw4UXA8MxvlJmwxeQo2-xdldf7OLvokM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2TQVOV7ago31RIczBlHWYpvgeV-4VjlHKLaYquYRRsA&oe=6A75DFA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QezS8gez_K4Q7kNvwGPEmnS&_nc_oc=AdqVxpE0BdhC_eIxqH-Nq_t69ucGZG2ukrt3YcIXPiQQH5NMIN30IkS4Z3aJyDtPwpg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE81RYj2H5sfAGimA_eYkzwvrd_E9fimcmszaTetw09Lw&oe=6A75EDBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6xyIOBRsywQ7kNvwFhWXU9&_nc_oc=AdrHMAPh-CrRN6RDXyTHT8-850wiDIGWAyO41U2HPXPKFaizgrvrbJHXE9AClAMXf0I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkk0SNxj4k4sse8ReHr6vIOAwURidZwrI8sxINi6j6hw&oe=6A75DB6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i5yahwFf8EQ7kNvwFWFdrO&_nc_oc=Adr25Pff-XG5b9f3doRGq2k09S06P__A8Ujo7eOFInfRO8lhN8jmb-RTaMgYVTT8LwY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtoGWJJAp4o0e6Cxr2P2GdFd5GZsLh1thdGxaszFVizQ&oe=6A75DFDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
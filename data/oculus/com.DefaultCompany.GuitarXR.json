_sid=6e7a0a&_nc_ohc=HsFfDCOsVQAQ7kNvwH8oW54&_nc_oc=AdpHqLrE89OxCRRrF6U2JSX5AcHcmsAs-wGA5EroW-gujEAOLYcSlDr8rAJaAAdmIC0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eF9focy0MDSIaQFJiqGgKBaekhHlT1hz6TuLH7pNcPw&oe=6A09D1F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol8KUMqmJ8YQ7kNvwEqnKUy&_nc_oc=AdqEr9TljRnoTY6fuMWhsRW0GFD2HIUJYqQY7b_vY1_vRFmoT2rdOcrxAblbZJJm2_o&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xg1SzI4eqWJFnva__m-2fIulon42YqUvphrjjT_7qRg&oe=6A09C4A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRKNEKIPU4MQ7kNvwGidAdm&_nc_oc=AdocKQMuF1uYyXQmBxNthJolxl1r2YCnYawYKIDaz6DUWIQZP1PwG8eH5I6F3B_kOFw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XyI3TgfJy0Y64l2ANUIQQ2VBmtWeSv11tmpYcuRFP6w&oe=6A09D2BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2__kUryAFAQ7kNvwHUddEU&_nc_oc=AdpFyCrWt6kgKePT7aUjDMaD05DLIiwWhtON0JRpiyI4mYnBq0QolrMuzaB5Hi93XjY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FcYIEygg-ZJuPbUDa0R1i0fexgoB2JcCQT_Wd1Z_X_Q&oe=6A09C06D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yTXtoMY-xQQ7kNvwGYxaRA&_nc_oc=AdoEpeA5NKwWE_M-dufxmIloOdPHaUvQOeK0gdw9lDxXxafvXDRLfRpkrGkfsGPNNE0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uND_jQLjA8yZwfrVt396cz9w_o76k7c8GjOyRys5TDQ&oe=6A09C4DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=HQbZr-yWWHsQ7kNvwF0eeik&_nc_oc=AdrdZg50WZBWm3Q4ayY1lReXCY1cyHI0mE3v2VINhFeLsb1GcSeIpUnVcMGPypTmiaE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOscVX3sNsLF0c-Us8Y-3SaR83Gk-f9DAaowMQ6usEHnA&oe=6ADCC1F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqMeTyZctbYQ7kNvwE-0x2Q&_nc_oc=AdqGbyy3S6yjW6ApIgE6aBDF6eXXR_hE_OQNLs-2iM0LWXACif-licPR8pkIeUlryz0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4osalGlhkTPNS9DklasF5Yo5SlfRTQmFWNcUvCYGcXQ&oe=6ADCB4A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOTP6nLWxWYQ7kNvwFARS0C&_nc_oc=AdoYrEqSpOUc_iGE908s1DFO0kmiIOIE5y8mPLkRbTlLRpW_2bWi7ZnXnXneytGwSvY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5QS7OzKsKYbWrFis6z1_bIJoHqAwH3WvDVFzLJFOdNA&oe=6ADCC2BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKxxdJO-X78Q7kNvwGGG_I_&_nc_oc=AdqsQCCjscKui5v_N0w-mVxmqWllDRW8hWUsn4NRzCDGwslLGHs13w74POTko99ZSQE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6cxULVr9_PGMzsPDmNqdN_XzhzyAP10ztC4TU7SPvlw&oe=6ADCB06D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r86qOkE-pWAQ7kNvwHVo5Ff&_nc_oc=AdoYVV-NcSvx_YJOoT_-Exxwe14-37m_urpTHu3uxzgd3QwbeUaG0owLOd4pGovwWfI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQND4pyuXWl_CBCJ5by3AKXkR3ziTKq6KBYvI4UdlNZzUQ&oe=6ADCB4DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
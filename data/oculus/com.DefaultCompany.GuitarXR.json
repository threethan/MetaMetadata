ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdhUjkL8P3MQ7kNvwG_EoCV&_nc_oc=AdoLRO0iNbvo3C1oF0a6906pda-1ypYs_4gi1CLEC1MOp8qMvGENILHLxU5AOZNDsIY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8t8KHJwjJvTFGpVEKbdxWzTxQlq8j-OzVHtjhZFsAxkQ&oe=6A4676F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd0e77cI2mEQ7kNvwGP1kVP&_nc_oc=Adoz_B3HoTNpNUme0ad5FuPdIjYBBuB8BmvjDlR6kEe_m4QsgYcx4t6nJMbhw6Xg-y4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99g2K3D1cjN_vc7YgnmmXJEZ4-_qRoR37zyzHNI67rHg&oe=6A4669A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6-Hkn0QNBAQ7kNvwEfa5sH&_nc_oc=AdorhdOl03JuFM64oQQVGkVZc1JNWGxDmQDhhZWeADtcEbuKvRKFHs0V_-uSWcKbeC0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n4ixiJ0rIxwWULq-AbDW_0U541lWUn83Hr1zUw2kScg&oe=6A4677BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXr5l8bVxvUQ7kNvwEc6tn2&_nc_oc=AdpJqI_yyxr6RKeY-vZyUno77gzDyL6o4nXm_DhSHbY5YrNADY9EfEKiNjsNgWj029c&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af896xorUIEYr-NKBcs_GIskCRQWfH-jqDUNvYc8luDrvA&oe=6A46656D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPK3bfIYS_kQ7kNvwH_Q5gW&_nc_oc=AdoSk8jy80H-6XC54zxnslp-zyCK_ETGdrfgzAnvIDjXOJ7TauYVXkW85cg7ynm9K1s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VkMztvrAPQZEzcXry-tp5gwP_KhY8Sw8lfJE4qIQ93Q&oe=6A4669DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MO
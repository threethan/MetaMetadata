_sid=6e7a0a&_nc_ohc=5--34bSa5wAQ7kNvwFAsXtw&_nc_oc=AdqYS5Z33kz67qLZSDic2HFeFXll7wx8cI7VcVj46yrl-EtUaGb0Zo0ObWebiyyX9y8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd-UbworkRW8miqyzKooIvhfRxNz47xpxWPEpiPJ3tpA&oe=6A79E173"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRIVXIs-dH4Q7kNvwGzb35l&_nc_oc=Adrci8KrIXnE_ne4YVGTr_7FpBGaPxN7tb_wt8J6f3F3iXy5-coqGVoiBtt6lF-9Tfk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGsqQVp39G6SdsyJOrvxMbsZg3e4SX1RdzKOJNqPsnhA&oe=6A79D426"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc_yxqAVOBEQ7kNvwE_xaQ3&_nc_oc=AdpkSBBeDSKHKMZeex9KCSqHO9ysJFORmgB0wrMGC8Ij7lTMGveXmXdR9Vup-mStlsc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtQwbYNCqLaihtk_jjW_abQtd4D8QD38AgEN7kz9kLHw&oe=6A79E23F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3y7QaivdQkQ7kNvwGytryn&_nc_oc=AdqpRrWYD-SWJXW_jUlTj9T-NhDiy8nndLYiq1B4WQgt5fZXkpy2duIo6grdn_SOJLM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHO_m43txNg7vWOdTamq1PUU7isSh1b_lfbS01loWjGzw&oe=6A79CFED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8x-P6WgzCEQ7kNvwFvw6fp&_nc_oc=AdrLN7MlX6r_BTy6R85EXVJbslfc1kbb8_KJKH4CZ8SOjvpu-ZCxdfFXQPpuHuzbCrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxOhvn4BonRGlVl3fX2LSq6EyZeSslsUf1ie4FKocZBg&oe=6A79D45E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=QU6lttGG0sYQ7kNvwGMyoTx&_nc_oc=Adpdm0Xr2MP1fqd0eIqeYNbOS3QLRUeZ1K9--xPpl73G8jWongTqRm46GY0sHyTp81s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOmAfYEBQIB2Xzyj7jzI7J6QWcWZAj1dxjCur7yDEg9g&oe=6AF9C2F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b74Ac1Vw9I8Q7kNvwETYlyj&_nc_oc=AdoxTXVy7MgyU4NrHZZ-AZO7wkSlZn_MfoFlf8xUOXZ-YP6tZhOu9BBYwt-wzlpSDcE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRssmhr7Ga1YMmwwuV3jdVAmXVQ_YsysM1kDrr1lYRMEw&oe=6AF9B5A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSRaYT0IDcUQ7kNvwEEcIg-&_nc_oc=Adr-CAvqUGuN6ohdkvVd5O-i6lr9cvgr7a15BVjzrZCXLRtvgiAXTrQlIU6E6VDvhQk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3d_REWGsDDyNOgX1LZ0SwYDPVodfKoU7688ycNzyssA&oe=6AF9C3BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f7K4E4UqfUQ7kNvwE5L2jv&_nc_oc=AdrPWqbER4btwNSQ_ba-6nc92BVS9ySwVuIozwg9ZxAo4BMMlFXYBheLUKYCbXv9kW0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2G_HyqdBPi4fCmnjW_A07NPy9NV2RsqkkJJlvZr0BQw&oe=6AF9E9AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLUrmCut0ZYQ7kNvwFPqUxH&_nc_oc=Ado4bfv9WXQsfl1fNMUUdp2dK4WXXlmHfAgM25j5HSxQcvmYB_poopQvdnK5x4_Jxg4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9RWPmFHcTXuTO7qtM9xBygRmDnmcO029LxmWzXWlSyg&oe=6AF9B5DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
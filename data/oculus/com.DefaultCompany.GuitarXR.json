_sid=6e7a0a&_nc_ohc=BFT3Gqr2h5EQ7kNvwFEPxQ8&_nc_oc=AdrkWvt00VCf_fAt51r-PRtb1t7HtCT-oNAjpFwuY7tokDcrPxq_dKL--ftq94lpNLw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVAQ0Pv3226IA8oTO6wzvHGch66w8177Ye8FN4V_SttA&oe=6A95C933"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z39nAhExWoQ7kNvwETyKI_&_nc_oc=AdpvJfqEMkE9ihhIII6CK-Fnfpx2nz8meqS44zyEZ8RktoLQ4KazedMf4rREcip2APM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSCQyl5bkgKbdHP2UIk9hpG98IC-rXXMDJsYTGLq_CEw&oe=6A95BBE6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fof1MULotLEQ7kNvwFMhcb3&_nc_oc=AdqYRJXOussBYg8vRPUEpyrJSwFrY3QwVVd7S9urxwaaE7yydzvcszN3SHeJ8jt-m3c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6_Iv806vhedBasOohSbpZ2OJabqpzaKgU9S2RI6QGpA&oe=6A95C9FF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1DUfpVG5-sQ7kNvwHWY6mn&_nc_oc=Adqu4ooeaEQITUoR8y9sazaTGFVBjzDTU3ZCOOYSWiFYrUN68yXcHjnQUvnYGtoRLE8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzlsbtMK9qUiYk2Rwj6yxImU7ftz_dQW0rFfIvxR-Okg&oe=6A95B7AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOUKLpJQggYQ7kNvwGQwBbZ&_nc_oc=Adqavjdg4NLtNFWhgMaHWzmX0niNiKos0300vmneqq3TKOdgYGNfBg8k96HVdQuHhQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvlYE4gryPMyj-YAopMnIMJBGgm3iGth3P1r8E7d1R2g&oe=6A95BC1E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=jmsQtuStRwEQ7kNvwFFlDGn&_nc_oc=Adou_44Ep8GdPEO9B-yNTRJjlj7wOwBDVecrqoqGjounaf0Dz1KkO_-jnwMhW8ZFgbg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iu7zl9m-54sAGj4btD5EMIziTEvW-RGKXfp2eadu-Hw&oe=6A1C46F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7JOtLXgxZEQ7kNvwG2vh_W&_nc_oc=Adq0JjNNsNt3ED5Ed3wuvlUiMJI1ad5bPfFZ6lo1hgYddJAxWSV-vJMPXa-SSEdjNhw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7t_XMk8fPPSi-xg_Un3HWVEjJbJq5CZCiD10yImNQ3QA&oe=6A1C39A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHsqzVRf5KIQ7kNvwEUtSyc&_nc_oc=AdqYqKWg_FU7udiyeNWcMCJo-6P1Le9Y8uwlqVdQIJFUq0ldF5zBxXhMVSpS8VTpeiI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qNroTxYnOBR7x3bGhp_oGDsN1Fxygvpo3QSVIAXpXbg&oe=6A1C47BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDURBI6jZrsQ7kNvwHV2VMz&_nc_oc=Adqig9QxIzdruESSm2ngKkYH51bMTxJlgUjugXUIU-cVJ5Pi1aZcXVDmQnwQxU_ApEk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59HXg4YZehQptA1NGfsYpFKD1xaq75pft7MOA_sYBahA&oe=6A1C356D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwHDlDBTOF0Q7kNvwGEqxSw&_nc_oc=AdqJJKszsQ62w2LT5t-qw7aMTA3A028b8DEGQ9FpQWfaJnHiTWNdpagXjtc9EJb-TcU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5VsPM6H38SoQ0jLkakvIcA0qMewMnQFtGDuO9SmQ66Qg&oe=6A1C39DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
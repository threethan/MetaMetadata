_sid=6e7a0a&_nc_ohc=5hTyJQ7DzU0Q7kNvwEleX1c&_nc_oc=Ado-76-UE_fCVyqsKgRfDCug0KGGXMGPRU0_BD0RgaDibcZBKnoYiN_3ZHVMSyKRPX4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sJsBCTGnt3pDHMAanWMU1G1LzOUfMIy24yoPdoOhuVg&oe=6A26D2F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bB3GXknlucQ7kNvwESbr0x&_nc_oc=AdoaVWqaV4Mi6rWyylJ_yg7ed1sr6ycpFbYyWyhf33JmYKhAKy-J3m9ffwd32v1ebW0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IWCcBdXj-DzIEHdPYrfqU-Reb51aJErpW08JP-J-4cw&oe=6A26C5A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOSB4n7mK-8Q7kNvwE7OBFF&_nc_oc=Adq4o5ZqNIw7nZPPIyHU76sVOfVWsE3LS3weL-LKhMe1e3nC7A6YUeiAlAErfcZC4Sg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90qepbYiBgHXtILXaAtrvQk9-16KZ6akkW_xSVZwdEyw&oe=6A26D3BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kg0DZyz6qqMQ7kNvwHPP8hK&_nc_oc=AdpJAsUVV4OmGfdDvKpNbMonONDcnc6hjHFnaYlTg3ZNZfo29CHzPKw-W2CI_IwG9nI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-lCLL6WDwl-yWGzgYorXsFSFlmoy2V0zWW1iBG4SPajQ&oe=6A26C16D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFfUO4dKI9kQ7kNvwG86FT4&_nc_oc=AdqW4ZrUA4V5-CRMJUhoS3vVi682zPZoxSoRbRw-b9cwICjw0a0Myu6etXc56XbTW1c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uv6in7UcjkKrY8tbYTPQpFomHltdWi7mKQwKIrTv7CQ&oe=6A26C5DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
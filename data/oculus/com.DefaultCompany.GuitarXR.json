_sid=6e7a0a&_nc_ohc=Sn3KKl67rscQ7kNvwEgWCK1&_nc_oc=AdqtLvO7WO9_v6EKtHIa3wLikLVYLfnH3emetlr6KIqpw5WVEQ19VpAL8rJZtLbZo4w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuhD78oJi0ioOSMAw_MpvaDlKrDShLjUfu7XbSvorMYg&oe=6A5102F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCNjQyzphFgQ7kNvwGat_KM&_nc_oc=AdoQEVVVrtRLcIS6REyhUiQZw19SIA0r_WuQphhen_zYsnQThwCqEo2AqgRrvZbxchs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBNl3y4A_AwkRlGWr6kAnfgkORHZY4hPF4CDrzopPkR_A&oe=6A50F5A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoLRH2goGZ8Q7kNvwGyEPIw&_nc_oc=AdredI2D1gRwYQrQAdejqKCazozPJ07LBXA_-pn3wouW3j59rSy_nviMLIcni8uQh-M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJU9todwfQHR7TNzwy7nk8v7atjNLoySYR-VNEUY_x3Q&oe=6A5103BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ht69jSXrkwQ7kNvwHvpmY8&_nc_oc=Adq7FjbCwXc2Zh8Fq9WYMcDXpo6CPIMOv6l23kjGX1DZY6VKaTwmJnRsr2xdlc1ZlLY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3yQeiBZrl2tSLOLygCFF2A24LGOZaknY3JTxCvi3NKQ&oe=6A50F16D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b64X4wOnmpMQ7kNvwGuzfIr&_nc_oc=AdpJypExl1Pk3uK3Iqb0a5ATIR7i06BmmUCb3sF1CUsA9-aDUK2T97Ah6BtecfIM0Gw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMf-hfMZ9hPSekfLDdLRC29gqrxiWFuAVGPoGZKZK4OA&oe=6A50F5DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
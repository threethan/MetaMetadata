_sid=6e7a0a&_nc_ohc=0a2UF-bYmg4Q7kNvwE7Dek8&_nc_oc=AdrFarSl1_oZNkByO5c31rWtvFwDA9pAa_icNIB0TFp3kLJKGHDuegO1dY_E0OZEJ4c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cXPmsapVC3JxjR0S-QcEl7XNTM2IvyCLO2ql-RuZ_8Q&oe=6A0C74F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NW5UjsyPkr8Q7kNvwEI6YVl&_nc_oc=AdpggYqcWwd_NARuVOlEcCBpI7NtSjJrTPr-5ktiGYBWunHV-9akMfL4SknCyyrD5nQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qhRbcdxkWQUI7dOZmsXc-aeZwKhObsbG4Ltlp0c0r_Q&oe=6A0C67A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB7CDPfG_EwQ7kNvwFvUlOF&_nc_oc=AdqdV0XtR0zgTQ2PKbNKGc5-iebMS68gGSxYVl1bYj83BpUFr9kQ5aF53bmVS1HghAo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WCbhlBmsWw8_98uIXxj1JRgBMFh0EeN72JI0ef2Kctw&oe=6A0C75BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPapNwdvBDEQ7kNvwF7DRT2&_nc_oc=AdoDQoFqDj68sZ_blVd2x94pEGya9UDklGCv6qWPaRh1vMqV_G79t3GY5QqgiS2Z1n0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6o7fNT_qG4BzWAL8U8nmrWGBabkBXTrBADHPsntuCkQw&oe=6A0C636D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yTXtoMY-xQQ7kNvwFtSTRK&_nc_oc=AdoTkZNFhKbxcOk9_jD1PmutbKH26Qz1rT-f03UdjOKXL6PT9W1jTcsUr7QE3iq2LM0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J6_MMlf5HaBzJpIeTwoqiviSufPOYoLwsefQ_ZzHEIQ&oe=6A0C67DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
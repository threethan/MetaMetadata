_sid=6e7a0a&_nc_ohc=h2Wisqqh4z0Q7kNvwGLmveO&_nc_oc=Ado4rBSfXFr7udMdCznot2HvEjRHG7T04LD-fuJT6HZ4Dc1YHZdezUzPIL6kpQTrUU8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsQZDJoh-NHzksuaRIMttcNZLKQ6PlQUhaXRp2pUxEHA&oe=6ABD1DF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v3GibJUYY0Q7kNvwHHpbZP&_nc_oc=AdrOaESam0iB-4x3p-_ldlJP4ZVDtxK_eLwUJMvU_CDtpD-KnEFLq8wAl5uq3Hvkuxk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7SeJ9CrQBAxYL0UBnxoAdWEECNqGt4oqCuF4UA_wdaw&oe=6ABD10A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5dQSE9v2WgQ7kNvwEjYSnE&_nc_oc=AdqeZRpDNv6Vxi5odk1rKjRsUKlBJG6HX02vPyxtoXecijBxtdaG0-Ho6TAT3OCoHyg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxfL0PrfaoVwZpR7N6J5h2XROkSW0HfR4KzB8lJw4DJA&oe=6ABD1EBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bd59NmmapiAQ7kNvwHelfSR&_nc_oc=Adq42EvIhzc_e6drGEszSGcBfDSEi49I2SrdrLrwvAhtSrAhi04di-z2ZCwjcs_Kjec&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKmCZJOXJAnVH2pOpIQnBlxGnmLobBjHsM9wTXKVBxXnA&oe=6ABD0C6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT1X4ShJAZcQ7kNvwEing8a&_nc_oc=Adpu9ywq0Lsz9uoDXZie55PTmdyYLEiAKRVLHUiVHbtKDE9H3bEs0319VTusgEk-Ue8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRkHpcuZHcWzS3X_MWuPm1Hp-C4S8uWnm4FOdSrJQdwQ&oe=6ABD10DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=x2cD-Q_2z2cQ7kNvwHMcSnz&_nc_oc=AdpT6a9K07f7CbLrOXxtl4944bQXG6B3aZFitl965P_XO4whO-JIkCPZByaBPdztxms&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSyLnoq2vQOm3j43LPNjsWgiwwvxMq_iSEBtY0c100LQ&oe=69CFCFF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AETCiWXRqoQ7kNvwHk-1Gm&_nc_oc=Adrb-3wsMW_8AFj3Zjh2bLNkAA7AU4P8c3Uk65oL6Ns2ncPJQcNDgQgg_wIfocpSW20&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyA9-5O1qnFxeTPPibPNHSLq3xHfnyfU6pOM6LJrhsgDg&oe=69CFC2A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWSMSg0vJ3kQ7kNvwE7iSAr&_nc_oc=AdrCTwJtTuo8HoM9V-MpQCcquT-2QtTv_fvKfKwDx9daNG2-YZHc9YWQoeskoEBkEIU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHUFQypA_ik_EfglIk1F3vcyQJbTQxGIjDLBvPnR-fPQ&oe=69CFD0BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqNtziu3IRQQ7kNvwGq_K06&_nc_oc=Adp6AWtcVieVR6gT_935UjP2Xs4dpd-1Q_wvqsdfXdVX5x4qI0FbuGEyF3Pg08T3y-E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCF3230HCL-Ar0EKUs4amILT1sOB56Yz9i1SL9Ko2rEg&oe=69CFBE6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GenGXszicU4Q7kNvwHY0pKe&_nc_oc=Ado8Zf5qbf0DVLmVNadfUINsGgnFEdXg71hOngaFKxH7yoJalDexB2LFo-bCDhs8ptk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwcl4eugaC1KlrEeYgKXlEeYSsZzACL-wpeuE3l7nYLPQ&oe=69CFC2DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=2NB0LSSLvRoQ7kNvwG9pOEI&_nc_oc=Adr11Wr8vWdd_SGXPNTeAh0sFcbAgetMPxXcDYQ8gy5WR-Sl-oTjysf9KOadfFvXPB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi2wxWhrfZ8Df8AGwlERjBkE0dgTkBkVmHxDCXeVLPGA&oe=6A4BBCF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajp0FgbJrOsQ7kNvwEH3Ait&_nc_oc=Adq62Smg4B2t8eZFG4064hu0DpNRuueyqmfjHRitzU6oOhJL7UOHBC5IfvQF1xacyTw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfisn4wUmgDOip0V9CCpojIZKC2uNbmxCF4x7Sudlxsg&oe=6A4BAFA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfTtugXIE2cQ7kNvwFSkYiC&_nc_oc=AdoCR6UEG8gdBySc8kbVXY1GT5IpVyNjGH6-2r1uiJsWv6g1EHoVYZU4Nqt44iHNGNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCa-8aS6mBKoxt4ETYCIfFuE8aWQn-kR1lRWYUVODHubg&oe=6A4BBDBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-B7M5AWF3QQ7kNvwEAiuwU&_nc_oc=AdpZ4WBUhMaJ1sDUdpCum6O3RL0rv03YGOdFB55GsHVfzsD5AAxFfo2w5M7HOCwp2Nw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqkj88v_v8dpoWCgtjABTzcy_X0N4DNh7jMpvcjAnd8Q&oe=6A4BAB6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUOAXI07Fc8Q7kNvwG8GIlJ&_nc_oc=AdrzFvdD8VhlQcxGd1NcyYGUn74xUCE_m8v1U4FYmCaRa3JLex14KzhmwRJY6l0Vllc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBRFCa1hlAiaX3I_6vTlP7UlZKxYtSSk1mlArWm5I9okQ&oe=6A4BAFDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
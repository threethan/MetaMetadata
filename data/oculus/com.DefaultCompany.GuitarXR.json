_sid=6e7a0a&_nc_ohc=thFixTrxXmQQ7kNvwGDn6RC&_nc_oc=AdoIQExPlTeGfRlwIp8B_BA3m1rvFChHQ_6NcBgXBtLprb9UAjFS_xbaEn_u13BorNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6Zks7i-w_B7_RBxkprtvlCVptnx3qNnPEdjukC1y0AA&oe=69CD2CF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AETCiWXRqoQ7kNvwEnCIx1&_nc_oc=AdpXRiVwtReCG5Gq0-C09KEio8H7-0UhdNzqWF5pxTD8nrNRaGZjS5whQBTkWEK2UFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8RNUnu7HxZFFDfDbPiNh4sf-2D2EMkZqgJ0_nws4vRg&oe=69CD1FA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt25OP7-LjoQ7kNvwEbUzey&_nc_oc=AdoiEySmqZDx3w5GG0hE_5csEXWQLjm4s8lv9LjgM2mk2I-0WpH_Jp5qCuYZgKCQuiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwy-95NHj3dL7urRVN3r6S6GfRrN23SzZxL7SjDTVbAlg&oe=69CD2DBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkaWpUGo-ksQ7kNvwFtQJAw&_nc_oc=Adoe4QJqRqY3cNkayRxn2jhhwhfuB1ZyMxMiM8hM2UfffYkjYuo6HgUNfhtYoYSOCTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-ETnrrRKFw6GyuTZw_Kld4sP9nRJ7WS2d-khi-cKASw&oe=69CD1B6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Lkj39JNDdMQ7kNvwGRmpTT&_nc_oc=AdoCVC4C6VM56ElVwA9BReeFthnJ3bwPO1gqaV6A0GBawAkL5QBwAOafcmESw1huB-c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz60sM5gU-H8iJMsc3RHJqpUVqMzCV1m1SKGGR9skXIRg&oe=69CD1FDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
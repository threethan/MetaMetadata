_sid=6e7a0a&_nc_ohc=cpIPYiQEEIIQ7kNvwGLQXVl&_nc_oc=AdpH0zXCMA1AW2ZYFUzEtImqQT4-NuWG1rjv9Shk8D-iO04thM6uWnEO5hGIV-Z6HIY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nSweQEHcwDv97Ef-3pjt-DfBztA6OpIlyn_jnKlXngQ&oe=69D7B8F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPLbAPV5geAQ7kNvwH7J2Y0&_nc_oc=AdpiA-vrYT_NCc5bZ7XgLS1SLtCyF6mFQgyqkylps1UrQZwgmETYnPQgnnOHIX9-sI8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qHGcJoHvAidEunWyM_cawb68lGHE7-D5BZL92Kix2Xg&oe=69D7ABA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnf1RW4qeuIQ7kNvwFMV7eh&_nc_oc=AdoIG1-UKMw3URInutebuySVuIwoJfKzBwRRbimSR0JK_8hHS8xlqE5ts_ko7DG4_oQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2L5FrnpipN_1zt9J0qfM369CAv7GqgcTLs-wGENw6YUA&oe=69D7B9BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKcw55oJ2noQ7kNvwEQW4UH&_nc_oc=AdqabGEkHUd5O4Dh9EXsnXDlahAiTz3dn0IfpprqKIJe6PXSTCSY76BBjhdn63594YI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2DWa4FeSZ-5Rsh2cDKG9mDIY5IKUL-yvuZ1Bwfyfhp7Q&oe=69D7A76D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1gagd-7gcQQ7kNvwEce4r5&_nc_oc=AdoISwr1NwDudzaa5RENH9rN5KF7imbNxkUngKi2FGI2Cb9qdTAtAU3WISW6m2iwNMU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ROqIGoSVoKx4dCjnJGU3nNSin9VROv4A5rdLJiYR7cA&oe=69D7ABDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
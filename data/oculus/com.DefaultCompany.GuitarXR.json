_sid=6e7a0a&_nc_ohc=0tckTTVR74IQ7kNvwG9xrhI&_nc_oc=AdqYE2zjb_ALs1QBjNNLHZUF1AxVxRPbQbjch0bE2MhmLPinbkRTYKS1fW0txy5rlro&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQL7lGutuDpzKmgRZplOBkd1yS6Fste9MA6W2BGxPdXuQ&oe=6AE89F73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uvdp3REEjIIQ7kNvwGchDKw&_nc_oc=Adq-BLba3Bmq_fXBwRbvZjlPPpHlMnnT4aCntBuUS5-UpEQaNhi0B8Nce7ykc-nyCIk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfJVDZwMKXR0POq4d181x3YK-nbU5elIAJgd6_X5eV9A&oe=6AE89226"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujb-pDw6xNUQ7kNvwFaaQO8&_nc_oc=Adqr_vlgjHCEBxvTrX9ppo5kkr2BWcq-EWz86Mw3NSlRvqWzHJ4KUHdhFsI_k3zxWCg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa7_QJO_wjJrxOcfS8yIkCmTmDWIA5qrOjN_pJ1lEWcg&oe=6AE8A03F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m3SQ4gfoxgQ7kNvwF6_r5C&_nc_oc=AdoSM3hnvTLR1jBixWMkRFpQl6l6g0zYwd5880MI9cpQVlMmXkEsJI3Qg7etGAHNLxA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSk11GZ3NA9HrFwZAGoHSYhh7KmMQybAuz9KUvlt8Dbnw&oe=6AE88DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urBFdtMnAw8Q7kNvwGWqJlD&_nc_oc=AdrPFM_IshDhXWU0Wa6sDutXNP1y-BzVo4VMcz8gxd7kSH7Sgq5zwKdn8ZAQpTJxOW8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSh7Ayv_qPvK-XPe-NzYAdtM_4Fll48EMHa9A4kyxqAA&oe=6AE8925E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
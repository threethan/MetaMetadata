_sid=6e7a0a&_nc_ohc=3oZniPfImjoQ7kNvwETGtn4&_nc_oc=Adqs0f_QacgAK0AiYIZ8Bt1ijX2-E07ZIFrkTcVVykzwKq4f-q-RMNz2tQY7fA00_hk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVbzK1ES2aQVKhDJ7jnYqeTf102IdYvu0cFd_feoI0TA&oe=6A64C973"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyHHETOHPt4Q7kNvwEpOl6Z&_nc_oc=Adp7l1I8tQUsncCLkLwbeBTXEGOvEhT7BGtF23uMaQ-CV49apxF4IKyDHPQhLBIy2DA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjuFL0w08xQFrrryhIlhyXvku9i_H_1B0TM-0W0lmCRw&oe=6A64BC26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbneNV06d1YQ7kNvwGUoshI&_nc_oc=AdqfQuRVsPqAhoGJlo6M-1qdgfDcRnnVNSeE6LJvuhWJ1DAIhZbE47RYJRRf1Tu2ZoI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbNMhEqQ7oj46uxHJ8z8SGZhcntew6z2-ICAaF0riHMA&oe=6A64CA3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6hZ1ZafBcQQ7kNvwGPZDgl&_nc_oc=AdqICcoX8vy2nwXLMz2y1tJYU0aT54Hxbize_iIjM_AQw8aR-uHxwlfdaItgSJnl9iQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhOkqEQTTa1GRQSQcgzznbafujOgAwIdNR9ygiHUeJQw&oe=6A64B7ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKX7efOfeBIQ7kNvwET2w8w&_nc_oc=AdrWB6bK5sgjgJsp4DUxVa6QjmcRS8b5ABqF3W-PjxadDZMnHzxvMXp9f5cfWoU8IlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBfmdrVonuXR4Po6IHopC9AKZ4GYL26eoR7X1p-vuo-4Q&oe=6A64BC5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=K59i5RVL9TwQ7kNvwE52vDK&_nc_oc=AdrtZj8NJ7vV9PqJehrI5TwOFJSH_eSaKLWTtcONpOW753Id1nVgVGm3QhOM3Vc2Kd8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwGpRNHcvOJNjlB97s5Dz63ri2Nu65FpcH1RixYeckQQ&oe=6A8829B3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKHw7zJrw-AQ7kNvwEaNoT2&_nc_oc=AdofeEiBo26Qvhcawyg77gQQ5276ucCLPf9LtdefV8NnMPgAQR4fDhde4CR-UsWPZcY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrqlMFJW7YUDku2d1XtEOsArmi4YhuLBe-CKdMbNvzWQ&oe=6A881C66"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOhEcfCTlmEQ7kNvwHLm1JX&_nc_oc=Adqh4uWLSqoODrefZI0jP-vdI0_eNOnhKqoDEzvDzPLo8XiZvbG0YJj3yG5ldG3dbc8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvMp0QiCVJ5HNr-quoFzox6r3Gr8tspWVfy33xHLxl-A&oe=6A882A7F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QkB_m3J2NUQ7kNvwFnTxR9&_nc_oc=AdrO0E4IEz6dum1LjjI837Wpc3a7xz7R2LL5aEXUw2SlJTQGXpqtsLWzCO2kaH8XUqY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhOP_WVDkAMpkT8zjWYrEdKtYyKdwFFiQ4J07IEBXWXg&oe=6A88506D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfxbzLm_8T0Q7kNvwHTCesb&_nc_oc=AdqOoRYrjxLlkphpCLGTZqZtCyogvDtwiYcjgEVYpHK0MoA7LlMfjtFqKT2Pi1PxmL8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBKy6I41o5YZBANJ_OhYrgnUWy69Q00LYRvgUJvXsLaA&oe=6A881C9E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
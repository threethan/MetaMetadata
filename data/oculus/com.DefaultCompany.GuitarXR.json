_sid=6e7a0a&_nc_ohc=520saUP3tuEQ7kNvwEuSYOn&_nc_oc=AdqHf27X_YdQfUTowb6HbVVx1Vzz8kJ6-Ez7WRGQc1_ANGFDjfi3Ofk6demux7KmGbs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDGlmzh2kZwqadJ2Zk-RBeR8G_nU16xWpRvwNbI3cheg&oe=6AB68673"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fdcPBU4nFAQ7kNvwGvjxz5&_nc_oc=Adr6c0PYNEWF6MiOG13q6CT3-OLf7_kTNAzDDkZWQLaX0X1N2UcKWbg7ham8vcOMvFY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc9di-W9Xbt7U6DVmOB4NJZEXxVQW7_3IUS6hZ0KByMQ&oe=6AB67926"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZL3E7oCUkYQ7kNvwFyKJ8u&_nc_oc=AdocXaVjx9TGPVhOEHa8WtDPcuLFGiOM0MBCyc8iU6oj70MGddIGdB2nKuqn_KM623A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVahjw7MCYGycbp56as9B_p69Bfm-lObXliMfQp7ecpw&oe=6AB6873F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znwvj1D-nYIQ7kNvwGhqfSV&_nc_oc=Adp2pxTZbO9DzSNbfALpVLARXpTImJOlOBNDaXouFxRshpqdg5z3tb9dZCvgVnLYi70&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT_Rvv8e_q3GvJh7SUT3usSB1pvpHidIFjy7VsRHC0lA&oe=6AB674ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5RFgNtmUsYQ7kNvwGyUSnb&_nc_oc=AdrzRTssneKFgyQq-zNpPGZ1HesHq74OQRAjFyC9-jWX5qzFp3puv0G4fop2bvrXmcE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfiiMh0iS2Cin0MtGvVo1rVIV9CE2vRKZsCDbhVy0B1g&oe=6AB6795E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BXpj0aPJ78Q7kNvwGbz8DY&_nc_oc=Adpzz1SLAByT2qUHT7lmbOtPuBhbZ-XIQeKU2Ma_Qh9INfD_yBT9LPFRZmP8ty5hfhI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OLdfCPAu7doNHJJcTUTx66k8bFREou8P8yCnuDi4J0w&oe=6A11BAF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0bVRpneMmoQ7kNvwFnxj1J&_nc_oc=Adp2CNIWAr08BL_BDEuCFBkzNJdHEfSBkFHuByvwUp1GZBkVfO3c5Ba4XZ-GfJJ0XYc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CkMbF_DNmEMTPAmBkipejucW5mo7pseDO3_sdclRH2A&oe=6A11ADA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zjkA-FPF1AQ7kNvwEstOEB&_nc_oc=Adpi2e2rQlZ057ajEdD9sq9Qtr7HFRDwrJ9MAeS3rgwsFSo74YjGJKY1_yJSgLa1eo8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tKPsCTdXwIThfyzN00FJMPgwEX9A9ax-FFn5iL-I7Rw&oe=6A11BBBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ejhUjxx9PAQ7kNvwExRTR-&_nc_oc=AdoVWdYZho4x9aVz5VdvvJH2f6pd-f1hpSK35avearLMtmByWQircjrU25yyjlX5CSQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ra5hd82xS8jEYzLQAuFfYNO8e0BwNVGG4uz9q7oGjxw&oe=6A11A96D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zniq1BQGQUgQ7kNvwEyt4cD&_nc_oc=AdrKK0wL1y8p5YAELtbWVcMI8h2b-gpH4n414CVF4WDMirvalguHsPQTbitneS6Xu0k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5rWsf3OnkklkF0_npgGpao299qumZUwwBu6dJt3DJfkw&oe=6A11ADDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MO
_sid=6e7a0a&_nc_ohc=EtuSRtCRLKEQ7kNvwGBkLPA&_nc_oc=AdpvkmXt8zJUnY49Knsl7cSW0IOdKC7Qo-LQLay41zpV9wP9buYl3t-GeqKUZ78Jyfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGd-bYB_Oy66KoRd__TmiH2lcZO_nYinnV6uax7YwFTYg&oe=6A788FF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRIVXIs-dH4Q7kNvwHvQ-i5&_nc_oc=AdqljPug1FOjmS_eo_lkIZ2zvUFidoDDdyahWmFpm3bRfmmTxgmNKd3LaSZgmGc3vwc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMwEkEj-B14DKSEXN4mQ2JA1qq-TwLb720L91iAu91QA&oe=6A7882A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QezS8gez_K4Q7kNvwG0ZIJs&_nc_oc=AdqK1MnRNptiLpZS2lScaak9jUR5CmHNfgUvw22MwTA0IP6Rvk_mHiJmVcmM_MXOCOA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlga56-eW4mUfAGH__vCu99_HnkGBBQ7pS-LTyUxTrXQ&oe=6A7890BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6xyIOBRsywQ7kNvwFvLe37&_nc_oc=Adodd4Zi5KzF2zdsPVUcOEhrHDqlf-CH5zxlD7Wc27sMDb95HZpZr-a8qwzCcLJEqTM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA-avdnnUdMnw_-dA3cHgTlv0UHkJx3k-qbgBNfEk8XQ&oe=6A787E6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8x-P6WgzCEQ7kNvwEMKRDE&_nc_oc=Adp4zanJ58ubDfDowQJAgyONlF38JSik56po-7DNBt2F7sTOdhO38GoBFbQ1UAzznZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElnF5eW4xI6ygLMA4AfD6GUgicpvXRvO8i4KhPWf8AhQ&oe=6A7882DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
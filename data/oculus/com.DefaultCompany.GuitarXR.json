_sid=6e7a0a&_nc_ohc=HpiQ8ora2hQQ7kNvwE0iKEX&_nc_oc=AdrB0Ysu2sW7l28fzb3Pr44VOQnUR9Rv-FDKc7hE30FPO2GRQL0hkLltPCeKXES3Png&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Xq1w3awGWd_IOhpuz4hjVXHqjzi6veCnDtzIO_hqSEA&oe=6A009773"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hj5kpq5hhpgQ7kNvwEr960o&_nc_oc=AdqY_ZBqIPziPIN2XNfOXXqOKcAelvJXGSbjzcm0t0db10ES3xCZ5xcGLNbvOEFxe28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gSsfzxKeBrL35Ftb56mYaB2J962oE3RXwBPdrFt-5Zw&oe=6A008A26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRR6TEmFc_cQ7kNvwHz8zYl&_nc_oc=Adr6RZ5Yfi8Yf4O7M2jQm13Sj1UUOp0inAWaoQ3zXcIqtobTmjORdk2M4tuG4gbcQdM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kcjrEUexdX93i9JswqDMUNh_4paN31f3J0Hw_w3T0pw&oe=6A00983F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8hMbNz5RmUQ7kNvwGTIPPd&_nc_oc=AdrvYYlRuKvRyrWX2SBETfz0j1P_Kpbrq3ZOJu6pTFghCH-CAlA5Icx-i0wvMttwX2E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bW7lqIeDie3DNhni46YyzYnNPRjXsrZ7nsxxGr9rE7A&oe=6A0085ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDyRl8v-UvcQ7kNvwEjYAjS&_nc_oc=AdqArNyJqevD33eBh8D59XMNkwX8Dyz9tjBYV_NsOivrgiLMtkZP2PtR8SRtYKlrAg4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7waPQiIDUsd_Wf3He73oRojBaqeBm_xSkhRfWZ3IHUtg&oe=6A008A5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=thFixTrxXmQQ7kNvwH21_UI&_nc_oc=Adq3aQGH9S65tKXtWJ3C-mwbonrubu6NkBgMJYg62BmLJbuyQkYBKF--3yRYb11vNxs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGhcJpXSuj4_yjN0Qz_nR17_0WKKsLuM7zKaDBD5b9HQ&oe=69CBDB73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqaFz8C2imIQ7kNvwEl0O_1&_nc_oc=Adp6tPnKDuJOM9JTDSKdWsZmnIxNM0Z4QE8_PEo3ukic2pnoe6rHFfGRRdYM0wSFRJ4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZ8K7jSoPodGquE0eRSTTI1IdUgDVJ_6Omcjf9K5D90A&oe=69CBCE26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt25OP7-LjoQ7kNvwEkO0Au&_nc_oc=Adqo-Ljl-PjD1pcNncuFHcZhE-xU1WvHp4tApimRic_2tvF5RBRxhCWxF_2khvl20lk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwW2lm2DJPK0QYsz3ymk_R5KJHz46t9sDuPnmE0FW4NlQ&oe=69CBDC3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkaWpUGo-ksQ7kNvwFiP_sm&_nc_oc=AdrsgL2VUzMHNV0R5cohy9YejsigjJE2OBX6TTAb-92zmxJzCDfFeMCWt0KZsJGuUo0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyogVGBHxyhZNAIozKptng0pc3wJLd51YeWVWXu9uxrkQ&oe=69CBC9ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Lkj39JNDdMQ7kNvwEAYgP2&_nc_oc=AdpiYuteEEP5BSrFMdmPwzUpM53EG6XnoQbNBPYrJrdfOl8GNXHZBiBtvl4zVlY2Mf8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxbht7_rFE2DEc84scOM5VeGokWVbsZPPsTNLXuOy3Ntg&oe=69CBCE5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
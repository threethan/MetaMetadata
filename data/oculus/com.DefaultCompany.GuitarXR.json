_sid=6e7a0a&_nc_ohc=SJG7jqSlNNMQ7kNvwGuRMeQ&_nc_oc=AdqLtZQS-hQCS7SkmvuHK2t-E-zHYHww20W6ktmDfQb4h0DdrgwGbdzIT3yUlD4Fnag&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38h_nPv8Re4IieN3bGJdd9t9R6CSy2302USX7rdad7mA&oe=69E244F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0db-BXRcCn4Q7kNvwHQ2iwr&_nc_oc=AdqFHDQ-RPQsq7j9Hsw04qufh7W5vh8iYNdmKWnwjmDgvxcZQC7nljOKr9zCYd-hcOU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NVsFtO5wpntUIDAKQQZmtW4riIh_jUNwmoh-rChCgMw&oe=69E237A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YslAHZrRstsQ7kNvwF5BR3G&_nc_oc=AdqqLYV_VfpsrLldFzneObgP4v5Q2WbwAfkZdfdSGSwB7ZjSCjDVkEu_cHuU6bP3ieA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UqZ1ANZGERtVTLsH-LEUjLn4DNrKwrtaMJC9PzK9lmw&oe=69E245BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SVf5c2dBXsQ7kNvwHZAkDP&_nc_oc=AdolbXmNuTmLnl0oZnPkxs1L0k38OfQwlHtewx3IlSyhMyLn9CJ63Jbmzz6NB4SDObQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EUQbhvIVGIZRb3VJ5Ml0plIu8hEvY_TG64j_td2ENng&oe=69E2336D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLZndpWhcmcQ7kNvwHWzcb8&_nc_oc=AdqFmyl4zQrbTIQEGMYOtQR-SjMmFpN4h_W_OPP1JQt0PS6JE03BSTRJlHo56ai0A1o&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ll0CXCaxecKsH5dn72ZmJHBXFZSwG6Vr9CxXJQR8JNA&oe=69E237DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=AI3Q_z5yvk0Q7kNvwGKKz_W&_nc_oc=AdonbLlqYzX8TngCrao5z4UdlzHtM8jCt8Iyx-HzPKE9vUOzURGLnZBICJXtA0GAt8U&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8eOoOrv3tdu9Ug0uIL2hRM4Cq9HN0JPEElkJWycEWew&oe=6A71F873"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwsPlhg3xJEQ7kNvwFf8Ew_&_nc_oc=Adpm4BY8djPk-JacixHPbKTV4tT5wyzyEcjBTUcYHdCnKCF0Kxxcji92ZydiJNVHZr4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgP8tWsCjr7QHURvx_GXxd0oWmN8wDdyYbnGcvfRDHvA&oe=6A71EB26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHZVX5K5pgMQ7kNvwF2czhM&_nc_oc=AdoACp2OZiQCrC5ukCIxpvXjXdDSgdpyCNm1eTWzWttb_mlpJsBYFmmesy7IC7NaLtI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG709XNN3je9BzAo3uuVuI9wlrxdmH5BD2h4GqfUL5xvQ&oe=6A71F93F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWa0pZwn51IQ7kNvwHC85x2&_nc_oc=Ado7sGGN9rTXG39vvlYDCJUoI3dN8fnwaFnLXr5jwNL3a66q3spdqPG0yhqhqLbWcPs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFylpXk1rf-J2bZgcvgKO2hvIKxcNhMvzFDyGxExJBosw&oe=6A71E6ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TcHj1Ex9EIQ7kNvwEZgqTQ&_nc_oc=AdpYnRRGMF1RWyi_ZvIwJHFimy4z1ihproYudTICcqSEtN0l_ZZd7eZdyA0IQxRb0-8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHr9xE5GN4HxhHsqWy2qxX433TcG1G3GlX-cPZ12MWlg&oe=6A71EB5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
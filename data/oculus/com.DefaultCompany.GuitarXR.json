_sid=6e7a0a&_nc_ohc=AI3Q_z5yvk0Q7kNvwGlndKX&_nc_oc=Adr8kFea66cV5P0eXFNjEkj4rrJNTN7yztaAOpEDqyt1PZGMEhBpYO8Y30v6RfdRu_I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYe8zJ8LpV-QbBX8ImHmGwc3coYxkydo3lpn6JXwrniw&oe=6A749B73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8uI-uYwgWcQ7kNvwEOIDUu&_nc_oc=Adp9sUKaACZn6XywsL7H5n9Zs1VLqsqpjVlj2bIRqzMNtX9TeyXDFvyx5mXgWNbhZUg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9UTPMYCi9rwtxJqe6y3Ttp_zG_PWnwJ7UpCuk8CFKAg&oe=6A748E26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHZVX5K5pgMQ7kNvwHdxQnX&_nc_oc=Adqy00gkU-Xz0z6qgwOvxKPrZWvk2nx-wrxodwZYDpOf1SdSMehDPPvlk5eDwJO9DZU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5Wuw1wWs1jg5bmLRcexk63vM3wjFk20DxCCrEGPo3oA&oe=6A749C3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWa0pZwn51IQ7kNvwFzN7G4&_nc_oc=Adq5Up-gTgUWl4Qi5uBWQ462ozz59oQKhLU7Q9NZ78t98yCo7fKMyMOK7Us4y2JoUrE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnGNGd-P03yQ4cvys92gJSwer0t038hlPjZLbFTCAx1g&oe=6A7489ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i5yahwFf8EQ7kNvwG-cXln&_nc_oc=Adpij_s1XusR3Pg3DjNaXxRtRufwv3TRfxaRYiEJCIGDUEXst14beXsHC2yt1Uxkpko&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2_uABeGOjI4Tx9O62PgIcHRguoRQcK0W06sGayyECCw&oe=6A748E5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
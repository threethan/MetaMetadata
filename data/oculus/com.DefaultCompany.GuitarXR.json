_sid=6e7a0a&_nc_ohc=GKJHPNuUh4YQ7kNvwEGmbGP&_nc_oc=AdpI336NPHroRjVw8Zc07XMPmEvmyOolpo6sB2Bb1Pp3CKHHxAqakfyKGvcU6RU2y7Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQwut57-gPE9TwN18p1RgL039VLwnXr5y-MYWfEUucBQ&oe=6AC8FB73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwC570GRHRMQ7kNvwEDBfAc&_nc_oc=AdoEfCCt7EMkH02B7dF1Zn9EVoVVdURmOFuGErUcAHduG6n29FMkSaAUqqmEgXjnrIc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhzwUpAoYSD3eOEgepix5vAY4otnzZgBS4VNnLdTxciw&oe=6AC8EE26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsZFSkqtes4Q7kNvwEmJaKp&_nc_oc=AdoUcRpGT0nuS5Ygu1vE3niFO9URvFJax8k96WoWOgI-IYIdVOfMik1tXHjyJ6p_wP0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOuugGFmkL9Ayb4BCndg3C7FhVu8VgilhnVIe7uf6H6sg&oe=6AC8FC3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0PufWY65vQQ7kNvwGkHLz0&_nc_oc=Ado_Q04zk-J669btM9pKbubMzNsLzvaTiDYUlVTsH6x_JceiOmTxjOhcWmIw480u35Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfqQIt5r3irlCueVCZkEJlIRDIMunYoVMW_cvdM3KVxQ&oe=6AC8E9ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxGAN104taUQ7kNvwEkcSxl&_nc_oc=AdpbbrZb6ts6ygtZPxAQqjp4p0_UIe2xG5p6sEsMRvWwIRsEUemR-H-nRgZQSDOKn-o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZaBYFNaxtCMJdYh89MzDMPibqZ6D_HWGnSdTdJ3Lozw&oe=6AC8EE5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwW5ZBngBWQQ7kNvwGCIhQZ&_nc_oc=AdpCDqM7Qlr4W-qVWA5i6H9OvUrrbJ2gZMIO0MVfetOWaEOqFw_aER5VXy8oTv5mnhI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Gl-SiBditeHlkBP_szohCv-JZO2zfRtQwDyc05Pd5_g&oe=6A3947F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fleHY-3UKwQ7kNvwHa3a2q&_nc_oc=AdqYh_6da_iTiNrD8kafH9jqR27SlDKJ-WrTu7ZW3x7GOTAqtFfpsbvHWPBl02diWbs&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cqRLNXkQwdun2I6UENpYFxTlokvQmgKV3qZ-NTED3Hg&oe=6A393AA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsxdHAvu2UoQ7kNvwEoNRlp&_nc_oc=AdqvR3-sV66X1ovNTztZDblDJ1VsWvMFCWReOFmOhF9XQnGO1ly2GPS8Uo9djOQ6L5s&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aWR_SqpvYzPO_BVUIO_t6uCzCDcvKd-9oaT6gUIStlg&oe=6A3948BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXb5-Sj_rDkQ7kNvwHJmojd&_nc_oc=AdpUs4pBKw5VBcyz_-FuSuBn9on1-bSJMCR7CpX0YOWMFbq4uXDGfCu5uK8w561jrw0&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iTOwQgC99QNDS-1Oi02qB0o-Ljs1x26BQVfWYhVuzVg&oe=6A39366D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg-Kc7Dc4NAQ7kNvwGv6O2I&_nc_oc=AdoedTzDCLEIBgdGpPCI1PJTRk25oISqDP4C4oHWbg1ODerKAlbUpTy8wZr4x9B3WIY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93W93V-iTRwY6rUa-nOfQibIW67vKLUNnKiIZEcWYrcA&oe=6A393ADE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MO
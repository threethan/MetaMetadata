_sid=6e7a0a&_nc_ohc=6eKX9YEiWM8Q7kNvwEPwAcJ&_nc_oc=Adp7Je_YhXD2_Aw9sEJWH5_wPFh76TH8ost4dyC1vibnA4VTP4RFCbFnU3R1CFLm3Xg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlQLPhNQkZJoMm2wYD9tVw2AdmWrlHBl9rKCKM0uYDgw&oe=6AA01CF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCzHyautv8EQ7kNvwEBF5-M&_nc_oc=AdqhR2pnmKbgFCfhU0karbZnAszAveO53UPU-KJN04K3X7ykStLpv3iIlKFqx3MOboc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJredpib7wcAOVbw1IXhoUSsuqGMHXajkbwrWtxn4_K5w&oe=6AA00FA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-pOgGIRkYoQ7kNvwG321Al&_nc_oc=Adoa8mMVZFdEI3ZuSPsprRZFgjn1bMhOaYfHxCWjN2os2wsfQ3nH5EJoeh4K2u1kbKM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIcHAOTBIYxNStVpxV33ui0ObA29Cuie0idqQmGxdHHQ&oe=6AA01DBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-GSLZM4DYIQ7kNvwGolut3&_nc_oc=Adp9FmyqUWgBhUpYp8_EGUC7NDeX2HO4qwcqRXZ-iOnQBnKPgK375c4D5sZSl9Ap0Kc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkX14GQ1iFltOdCXKPFe5r1gayp7bBTpmiegoP2kvEAQ&oe=6AA00B6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G6x6IVnWD8Q7kNvwHClhMz&_nc_oc=Adr5mb9QiHtO8g81fmW-GTo-Osb_XpmuhiH_yfJ4LdYx_kkX73mYCgZqh9F69QwbrQk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4DL6MdTOjbRV8kPare-9bQwzMqIBRtB14hY8NmUFHNQ&oe=6AA00FDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
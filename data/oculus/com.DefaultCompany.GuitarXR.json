_sid=6e7a0a&_nc_ohc=Juz3UqfcCU8Q7kNvwG4ofaB&_nc_oc=AdrUG6DD2Kb6jBMFXnz4kIdfJwJISeQo08Ui1MPhCcFbvFAspEuqoQ9nSYuto_XDk5g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IRIp4DiTLD1DvDYc2e75bPep_DAJVkVo-fxjxxYj_XQ&oe=69D515F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPLbAPV5geAQ7kNvwE3-4DR&_nc_oc=Adr9uM3FrVQ2pnPMjf-j8sMI_yZKhJX0nwrOJzy4D1uzf0psrC01aRQxvznyqLSSD1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1l76GpTxM2uiR3-CCDFqOCes1ydWnb1QezmOvuohIGBA&oe=69D508A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EnmlBjc5I0Q7kNvwEUD_q6&_nc_oc=AdqYN7Sy6GCV4l-hZswjZfsgHM7Z5dA61aY30QW6t83swuYyQOltmTk4YPhpb_46uWY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XkEqLeQ42uBMwj9q8nNMl0PPEVwcXQLaDBFh27Z4a1Q&oe=69D516BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFlf8Ot7HsoQ7kNvwGijzTb&_nc_oc=AdpFvN_YHT_W2GttT-97ENprm_lL_S8WWlNevQjxwLxIPFHBih0_6yA1FdKR_fgNvB4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13qvDGk7I9qY3v3STT_nMeHYroiUsCbKYyxD4g3N5MSg&oe=69D5046D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWErNQBKftoQ7kNvwFn-pbT&_nc_oc=Adp5Z-QXQpE2ppXJ3-ijLAHd7-jMivJ9_-kcflONuPoj8rxBcZkhWG9IuOfEmbVx9r8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wL38Tbss-Ruwm44cdkv6fFbbpW1x9__MQdvdgIWXHLQ&oe=69D508DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
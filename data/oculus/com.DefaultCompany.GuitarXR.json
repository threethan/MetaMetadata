_sid=6e7a0a&_nc_ohc=Juz3UqfcCU8Q7kNvwF8yAfn&_nc_oc=AdqQ_izHZOUXaCfyHEnkpZdncLYbDKv4YaoBw4OfIl5q6lSWB3po0x1HPZeJN84Ld4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2g5LLS83kj-uPx0JCAJPc1WH0TSHyhEcB5sRsKudtd_A&oe=69D66773"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPLbAPV5geAQ7kNvwG4ZH45&_nc_oc=AdrIvwrFhnwKoUZu6vyFxHyWOWWugPAsA5uoBSp37HPYbYBZg5lMTWX5-CTw3egq9G0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05z4DBP2I-v5hgLoMnJiW0Y41kxJA7IU-Kk-Q-zZtdPw&oe=69D65A26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EnmlBjc5I0Q7kNvwESGMzh&_nc_oc=AdrVAn8bt4wodrdx8kxTebd_m-5Rhwk0N7zKBl9cMLxHGKYX6-M7RGOxhh6ZRtu0cLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vm1WDX9zHarEVfzsRCrLATX5IK40u3EJ9wSI7-eRkhA&oe=69D6683F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFlf8Ot7HsoQ7kNvwGUvkCy&_nc_oc=Adpyh0FaH0I6U3N1Yd5IlvZ2C0r-HTGe3XEu91P__DzGOeHoXDQlm7Ji7yLuypGc-Ms&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jEyQ3DAyLvJ8a3-g1AeKTvMLCJheFeGWBu8mwGpfTqw&oe=69D655ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1gagd-7gcQQ7kNvwHel16L&_nc_oc=Adob5ZsZ4wVw4Mc95eMfH8HCAMC6SZt-nD8x3BIc-gsmvsIA1GPPH_Jqiz77CoNsSKo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-eNxs32hxVuf7t99aEC0ANZaETd6xHKlRKsRnpYrI7g&oe=69D65A5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=jBzqdVwJStwQ7kNvwH0K58P&_nc_oc=AdqX3gQHfv845nnVCWjlh8vIrij24Eu8zPQcz4iWPRDFWqvYcIcmPFz5BZcX8mnUsLQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK15I422-iQBG8J27KqkNsJYOWykPw_JT4OUAcOxXfdDg&oe=6A9AD6F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d23aBGODdiMQ7kNvwEtiU2f&_nc_oc=Adrfpn_1AIpHIgzQeONpszL9eRzMwhye6mFiFYjB4w7DlZk6WIg9gsNWvn1PZUwp34w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgpSBqALm5z7lUTrEwv4GliP0IrSHEyXNHte69_HSPiw&oe=6A9AC9A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBmIVdK9Ji8Q7kNvwFdyyEU&_nc_oc=AdoDt5djJrpT98tmfnLH2-saVISCF4JjzWjolCWKXITjy3Yo7Bvrh_fXlY87BX7TeJw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDnF0kxtw9LCv7w23BVnY6A6-AW7kEY_RGtGPABfKvTQ&oe=6A9AD7BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6Ndn2Xq5csQ7kNvwG1mF75&_nc_oc=Ado8PHsFuu-OUNq7zQ3dMPmxuMT0lY4L7xDRcPhqkhhk5kAN_XzEnW-7F6_oC9WddeA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_krkd8QehdVTa1d7SJUq80bitBt3yGdvBL6ns6C2Y1A&oe=6A9AC56D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUevDnxuVtQQ7kNvwEq_Qcq&_nc_oc=AdoL4lJvy1lBx0YS4H172TvHDgQUFW2XOXss5xBpvxztaQp20JRPYdhz58RS8v4jyvw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoRgmoefwIhuLe7uiy5tEK_GDa-4A0O5-xn3uweVPmkQ&oe=6A9AC9DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
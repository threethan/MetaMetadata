_sid=6e7a0a&_nc_ohc=5--34bSa5wAQ7kNvwFYUq0L&_nc_oc=AdpAt71VzCubsy0-E_Dv4OC7iLUGQLfwadBrbi4Bm54O4F3JN9SilkcdmX863h4dObY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0bPsyRMWLL1qZLOqHHJ1MtynrpdylBnyXgZRD2ghG-A&oe=6A7B32F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otlQxUGFExQQ7kNvwFQIWEm&_nc_oc=AdqSWbfpjqBM7s6rPqoH3o6YP0vUa5vnnkc1IkOWRUh5qsMlbPPYI9hzNlYp8W9nf9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXGzIITfhdNjCDcC4_1u1S0I_txffj1Paiz4c6v_VDxQ&oe=6A7B25A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc_yxqAVOBEQ7kNvwG4F7cM&_nc_oc=Ado_2oCBYic28ZwywrBJQmchb_kzADc0R_wk5ph14oKSOE8kBSaSfPiQz5yT4IxK5WQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLBi9I2hbhSsa3ppuLN2juxW1oQfGIU2t-vpZdwGLhUw&oe=6A7B33BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3y7QaivdQkQ7kNvwGncoIp&_nc_oc=Adq3vwUH-F-UOQ7dblW3QAHcYAmUh4-65CmunZv9SaqOPxRZZAUPjKZRBGAYKxiip5g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2D87gOqYoCCO-kyrHWlDbIfBUUnaWDLWL4JoeRl0w0g&oe=6A7B216D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d8x-P6WgzCEQ7kNvwGMg1IE&_nc_oc=AdouG5f5kg5HtcsUcKgADmfl2jzOTRuANIsQORTbnfpzS1j5DG0TTwG76osmmIrCkyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH0NpLIS37qfQbF6hlyA1sQlyQ4piYhhQcIj_atJCmSFw&oe=6A7B25DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
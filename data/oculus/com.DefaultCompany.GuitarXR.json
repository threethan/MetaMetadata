_sid=6e7a0a&_nc_ohc=4FL84PF8P4gQ7kNvwEEJskJ&_nc_oc=AdrNDCNaSUhSPCIJ8KypZ7zYcbxmNskrVM9dRnjz8tiKIiV1gl-g4Df4-997meWzEPY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8NojPQascraWuFCJKFStEKlwKC4l5YyYaqHsEKMttzQ&oe=6AF47CF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUOyaw9AfWYQ7kNvwHC9XPQ&_nc_oc=AdomUKhZm9WFEBQCXR4ESPaskTRnlY7lYTDmfN3ji5Mta-mkrCQ6J9PovA3u03PwOQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwIUD8nDb0siYs5YelNlLCWOS5GAg1C9xNkBp8I8Q8ww&oe=6AF46FA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8nHVBbaauIQ7kNvwEewvox&_nc_oc=AdrFdfCczOit2brJ3RpDoAmE4eLnrxpbyEawGQrFzklMtcINrmp7zLvOSsC1TtnnpA0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSn_xTWPFTHYHkfmnVDM3Sq17v6dpn-uGdr2BGYMjr0_w&oe=6AF47DBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uwehzTEB3kQ7kNvwGu4K5p&_nc_oc=AdpHjVjuE9O9emB2yp46t71_AG4FjcA2HCrR6RFcTTREH8xApyuFg0_W13QhlIFZKSU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN_Mcay7zfuAb811UaxphMAS0UXOfCCHrTkW62gmw6PQ&oe=6AF4A3AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCq8mnToxZEQ7kNvwFpvzMB&_nc_oc=AdoP7ZxccciHoXo6DUvLsOPA7ilZu0Z9nAPJUIClK49tAUagkn3KD4nn7MQo6_kbA-4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv8-S7NsypzQ-Z1tMjDgrVk4ZOJw36btVCDdL8jptSOw&oe=6AF46FDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=zUWhdnPiqxIQ7kNvwGE7pXq&_nc_oc=AdqJveqU8-zFfbuJ71IFjQ04bSwOMLk9xd-UJDANANy5ofOAhC35V_TYT7o7HktMRlo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0JsjQHl-cN-9065rYAtbY9yZC8BmLvccSsR5_-v9FSA&oe=6A300D73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wXYo0JrJaEQ7kNvwHz3tgY&_nc_oc=AdoO5WBxsqOKvYWg-R1eCokwfI-YQxiXimxYdFSn1jd4FDjr9QD0zNpgsRipora7XZk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e1GLFOhkWAFyKpggvmbYAfkqd-LOxYxv2803CTYcdow&oe=6A300026"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf9OblNfHRAQ7kNvwG-XkQy&_nc_oc=AdolpeB9kvcgKiDL9xc4cFGplwA4bj-ArJfrukIaeLkQOdgmXbCfRJy-DXkWT0h5M1U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RVwqcKA16UQGglaNpODnnS81AK-n9fvXXHszuJd9VKw&oe=6A300E3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hF1ZwgQyqEQ7kNvwEwqDYS&_nc_oc=Ado4bY6nwux068CBWTp06e0PZb7adEAhkZkbmCeYfcD4dYszggUA7j5NXXPuEDBrQak&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZQncLD4cgiHpw6M8SiOPOi2EMiCIRy4317QKef-zt7g&oe=6A2FFBED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9CuR2urKxgQ7kNvwG0teVt&_nc_oc=AdqkYtyj-OgZf3PX-r1gonJhZlOoB8_x6iwdFV0Ay1c2BZDzVTp-uTJQ0635ilcxS5E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xuisKwAbkBrFdZwQEuedTNQv1HLLDOqpQ8xgVfAIxHQ&oe=6A30005E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
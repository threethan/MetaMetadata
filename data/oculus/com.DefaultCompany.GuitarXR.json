_sid=6e7a0a&_nc_ohc=oOZO6pSO8GkQ7kNvwGGs-Ck&_nc_oc=Adqv5uV-qOe5E7fev54mncDMViHyhsuetql9Fe3F5DCFvNTMgFTl_DqWXE77aJmbt_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7QGLKMObE0GrvhhO2x6hoMk77kNyQnrVBNqpHef8cZ7Q&oe=6A1EE9F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7JOtLXgxZEQ7kNvwF2S3JA&_nc_oc=Adrjfhxpzmgmn7ZLQ12xBFhRxn55_xActbWXaB_7qAWHQcgRWot6-I7O-O9fr3DNsY4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vjaksNoGwpoE5O2JBMQfoEGuTewUY0zlnlcv0NfAAEA&oe=6A1EDCA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF8QC2UIiO0Q7kNvwGeBJjP&_nc_oc=AdoRWzzLiX7oWLHtRTMiAnxc901rIpTodNuVXEXlX7KHHvesn7xYCeF0TMt6JX2ZQu4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6iQ93R3Yf0JYX2uaZnFi_JDmmKXyQLowJozQTGpE-E2g&oe=6A1EEABF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2zjoTDGP1YQ7kNvwE_NyLz&_nc_oc=AdqHy0Xg4UTTYBc78oQ-iGqbsoZa6LTByNlUw5LLnzBXl9VM_XqUPekHJKKO9_UKwsQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74bFaM3bKHMTMfS-jPvCVvYeciPtQpTLH1Hq15yrKd6w&oe=6A1ED86D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNAxEFxgc7YQ7kNvwFOFMr0&_nc_oc=AdoRvXrnquNwnW2b-QxtbzSZqcjJcAEmYpiVrFHCHF2sM2xLR2GxqqVV4CU3DePkWCc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4h1ONvy59WG-GFmsO5QEKMmYwTsCSqJxWFJCH31h-E4A&oe=6A1EDCDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
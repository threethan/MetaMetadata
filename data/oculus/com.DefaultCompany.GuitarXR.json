_sid=6e7a0a&_nc_ohc=4-9ShIcFfGAQ7kNvwFKrBTd&_nc_oc=AdrGO4Pt0zlIU__AD6kKFBcF9OAxJB7K5lnYTz9SLn5zkWsbWVK2AsxOFtf-0sO3dNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aiv7JvmiTk-YWzsQh_ojpA7AIJrQEHAKou8STBsi-uQ&oe=69F9FFF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EFBzpbXescQ7kNvwGPnwu6&_nc_oc=Ado167NPw3j4s7Fw4YdAoaHZnKgs13UXmDDPEotOIUPSRc92f2ahac-8THnFYA5NIxI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Dw7DhsEwRJIeMp77jJElu3KWmaDYMZF25_QfQWGLq7w&oe=69F9F2A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p2qoBryo-L8Q7kNvwHoe10z&_nc_oc=AdqjNV82dJbZ5lPX_8gCp7oLBJGIjwPENTfQfeKpz7GjmqFa0XRPD1x4rV87lfXcFGI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6l2MK1f08iHiQtuPxG38IR1erRvH9Hm00CzRuBx2eQ9A&oe=69FA00BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nwHz6799A8MQ7kNvwED3fGe&_nc_oc=Adojhq1W06Cj8jXem0bxcp5zos4rHTQtg94iB56QAWJVrxjBKhwYddCakfsohXoNDpk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AdA5mVc1_rLGlhGurLmbE5NyjG2kENgtb-QjL1O_9KQ&oe=69F9EE6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmQ4kLkLFt4Q7kNvwEIZJZo&_nc_oc=AdoVAJfTuf4-gJ_6FQVhI4ADk7qB9BDhXWUP55QSlaw0qShPopcMuO8ORYDYKWXOsCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mN0cMBZPAyK4nOOZvpYmBhZjIog9UY5nAoqfYOLMIhQ&oe=69F9F2DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
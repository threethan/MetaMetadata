_sid=6e7a0a&_nc_ohc=_eQkDKbsS6gQ7kNvwE666Oa&_nc_oc=Adq9aWguzfU36fyTuuKMtYYeT32Xeg79rQZ67FYvnVMpkzWiZrrahn5VzkgjF-Ukppg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cbg3X_I5gaOd2IobYzt9C6sCpmUf4u5IgtoOgnrEgbg&oe=6A4130F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNhJZKpyZmIQ7kNvwHGm7sn&_nc_oc=AdoyuBK6ZboxKGl5Lcps0xwoFdq4-1bIcgIQQLKz3m_bhgKWi3iA1xudL0y2uno4Ii4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IuS0ihvZVuylTs_pjJL42oe8npyWnVtojO1iLM3M3bA&oe=6A4123A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Esp00e3_J94Q7kNvwEPyqeb&_nc_oc=AdqDnb32pRcjyOQn_TrrUaHycsMFx1QExZRQswHQDdjoy5hQdzEZXvEBsVTTFC7bAhk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qGq4R7K75NJPont-xLVzGErUAxj9XmL9uX-Vp7yu60g&oe=6A4131BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOJINCbDbSIQ7kNvwG7vfI_&_nc_oc=Adpq9Yt7-43bRAA_vglQF0Wf4AyFoNI3W6JjFL9Dw5SUreptzgoedeL4KpWfL_Wce2o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QMZ_1Bce29S0m1CB7sxulIaCtel8O_uPd0TND_EcrmA&oe=6A411F6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Umi1OCaXeLQQ7kNvwETVttU&_nc_oc=AdpGBz66rxl0hiw5vbwR3JDer54vBBRfW_zboAPygrcvnc-6xjGfigcesPNB7FYPUmY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JcoBVgt3z3Pe3xXFrqUMhlVOpA7zMl23kduRDyBaFMA&oe=6A4123DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
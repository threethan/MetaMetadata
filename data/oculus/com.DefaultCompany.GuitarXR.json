_sid=6e7a0a&_nc_ohc=6YJlodLpNIQQ7kNvwFeEqYT&_nc_oc=Ado48b2uJxJd7bgwuMBoLGryYlCx2k_dhtqiwHzpLo1uUEQH6l1cMhxYD4O7H26UESI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QwNpDfJdOzZ5TkD3cu9TWsFc2vqJkfsUoN1oRkVU-pA&oe=6A3401F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpH0FsaaMJ4Q7kNvwHbm2v1&_nc_oc=AdrcQzaIkjHtGHwDiIG-yRA-vkLJwsQ5I1tGenxY8ymZYwjxKq0UnGjO6vvGErTkFpM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DAu30C7ewjzSTgRKXvnevZ46VyKrl47_01olvJ3dDpg&oe=6A33F4A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5WihzD8o5gQ7kNvwF9XJxT&_nc_oc=AdqySrPlhqMDJpWeFZNPOfta-ent2bx2A72wJc0VSrJO4O9_zO5DewD8PKy0yR-dW0A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9J9E2jOW0CRxWj1Il-vb_i1bQW7tPTX5wQX4B7gw9e0A&oe=6A3402BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqoc1MDJKg4Q7kNvwGe0Jgg&_nc_oc=Adr4_FUEmXXK8txfFHp_KKtVfwHEDfXGTrR-G2j6TGX6XzOgKzPnpBslKLCz6sxCacU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FLUrn7JL7vwaAXl7cT2kELiLPO-Iq_7hqeV36sIQDjA&oe=6A33F06D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogRnf-HpwRkQ7kNvwErM8n0&_nc_oc=AdrnHqD8u3WVSVoYBLJTt2Ud0QpQgweigRRXxLnpywR9Hf8zXopYgEn1hesOnqnCVtY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81iao9PFUVYLRhx__1MrdzWh_KDeVhILlZZ2H7fehnUA&oe=6A33F4DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
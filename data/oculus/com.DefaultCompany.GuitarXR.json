_sid=6e7a0a&_nc_ohc=-jhzQ8R1vHwQ7kNvwFeIlmm&_nc_oc=AdqKpjgObahcior62U6GhR2kRUb8lVtTTonBET90V86y5a8ad_bfB-kM-6GXNHABLGI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXr94PEhphgDh1hfzYXm8cG8bmD0L3ZhvcGK1yalsRTQ&oe=6AF32B73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUOyaw9AfWYQ7kNvwEj2Omj&_nc_oc=Adrqwp4i1M750fOLDS_brPx5yGd1IB35zuPJYa0e34XHca6Px21TIfj37LQWZ9RQM_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTy63ab1euIyv91OlCNwQ_GTwFripUgh4btQb34yWRONQ&oe=6AF35666"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDRXYEaquVwQ7kNvwHXudYS&_nc_oc=AdpU4Ey6rXFrlcZ26lC_nOrVWSKAv1W5GljHrLF3B-0OrDUV9Qts_K_6gNsCCnjg45c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRpuV10G9q8pzY-GeY-UBycpemmjKdh3yl98AH57hYYiA&oe=6AF32C3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQ-FjyTZBlkQ7kNvwF3tZIN&_nc_oc=AdqzLocKMfQApifLBBhAdTtQ0kp0vg2n-kOMwbPESUuMweIkgDoLJ6pfpxMYNxS8Wto&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAqzIjYSXnGaDghbk6I3NMb3Gez0Rx2ZqbxTDSXYtg7A&oe=6AF3522D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCq8mnToxZEQ7kNvwEvnkso&_nc_oc=Adrrd3qoe2EDi1aDl8IJTdR7_MNPOjT7SycMpOxu9kioUliod8Gfa-HDl--po0gVbOk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNPyoqbvsdJJVJCYtoDV44WV9SM_VnydFfwXiQYXwD0g&oe=6AF3569E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
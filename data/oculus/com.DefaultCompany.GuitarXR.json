_sid=6e7a0a&_nc_ohc=6eKX9YEiWM8Q7kNvwERr81o&_nc_oc=AdoLOSV0bclQ0gqbrBJTpCD59_5E1UEKxxTKW_9Fs8yzp6avmwRE2b6cVb1fHOSaiX0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCjOdCvT8AhlJ4_QqbkliGjSVloG0MufC9r4_cLG2HwQ&oe=6A9ECB73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fCzHyautv8EQ7kNvwFXGosm&_nc_oc=AdqC56NLnPtdvqZhoxTVQiQLlGwGcJCX0MlyVkNuwuZ5-ju7d8yW3oGLIQ623tpHDgk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIL9rVUor-UqVfsI4mhKQhwXY7iq4Cw7wP-NnPds33wOg&oe=6A9EBE26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-pOgGIRkYoQ7kNvwFxyyp2&_nc_oc=AdpeQob7UYgT27FloWYXa8YQDHfWUiOPXn3ddiMdAjNNVolh2Y6V0rW5h34RIaSrBBs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLI0C4SZQbQdbOxtm0RaTENqVljQEYXnGVliR24R7d5Lg&oe=6A9ECC3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-GSLZM4DYIQ7kNvwE5PCWi&_nc_oc=AdqQ-jlogl7Dh7lMjgaYSl1EAZoNQlfw-g9liWYkYvswY3z0gCxTlFdIO613saSpoDc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwsfMAoTo0g8lK-c2wtLhwjpRu7gjz_Hcfxmy6xL9YyA&oe=6A9EB9ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO0TAqC9DKAQ7kNvwHduGSD&_nc_oc=Adpk8D170LEHtyREgI_f_MJdjVeTnQHWejE1a3Wl0E5J1Fd1ldJHf5_RfZf8GHzbUqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBOKDVFpUC0eyImkar5Gr-sTmkuu7EiU_IwyeMrWuhkQ&oe=6A9EBE5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBmIVdK9Ji8Q7kNvwF4EuM9&_nc_oc=AdpB8CBKOH2pwa7MVcMgswP6hPyhYwvfju8rezQ8TlZrBW29PYkSl1RIcMP0FFgdTWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6FlZYHLm0DoJHF3erj8m-b1Do7edxagRIrPlBlnk_gA&oe=6A99863F"}, {"file_name": "Untitled design-65.png", "id": "1931969893889271", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982469_1931969897222604_8530448425778764889_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsAZ7FflASEQ7kNvwFYjzpo&_nc_oc=AdqLmbhn1xZxHnGHqc0Iv3WvV858TyaXIP99-qYQKD5EFQk0LuhODbR1dJgkKDwjGD0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpfiy7rFzs-xT5iV6GI3Nm-UWvLI_HnJ5Gq-Fmn6uziA&oe=6A998803"}, {"file_name": "Scales to any size guitar-3.png", "id": "222599974216860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65228806_222599977550193_1783402009710633868_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rqaWZ1PP3HwQ7kNvwHO_78z&_nc_oc=AdpDI3evBZvjWRRj9aSbg7PG7evDcHdya2kCOvEDKlKQ6eHfrXds52ZUMfAxBM3Prqk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIV8fPHGs-2XduDuhK58RL_NU2HpelNAOEYIegUNfPtwA&oe=6A99A3BE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUevDnxuVtQQ7kNvwEGw6Ju&_nc_oc=Adr4igRmGmAepwTTvq_hDdhZxIhtnT_j2MU8_HDEtV4wKJOOAJgudtzmh321E7NRxBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP-i6m_OGCbH7X1E4x7A2ERPvHockz_uqn4WFCMZDl7A&oe=6A99785E"}, "display_name": "GuitarXR", "keywords": [], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Oculus Quest 2, Quest Pro, and Quest 3. Discover the art of guitar playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar!\n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to mastering the guitar in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else out there. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7203991549657867"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes"
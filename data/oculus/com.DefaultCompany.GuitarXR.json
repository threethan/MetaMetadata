_sid=6e7a0a&_nc_ohc=BMY3uNlTjPQQ7kNvwE0ieLm&_nc_oc=Adr-24Vh2zbq0TxY_saDVp9gW40KWuJDuUVZ-eZ5B9HTGH9CjPGYTsoMdW6W3R9x_60&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QoguKokdZpVgXWRxol6emK0tXYFH7oenVGy2rK7IHQg&oe=69DE5073"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKXzOCRNMEkQ7kNvwEoaCJC&_nc_oc=AdqetWaxBCf2vt0jVArGQi9R0kEKiXuU8_PBQcJpBcJSrWKfE-3U8jeHXXkw1iNmCHg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mqHpKC6KwZGxKKVEnDM3txoOxhmLEbD9jVekJ9qSfcA&oe=69DE4326"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb_To9CLfWoQ7kNvwGqF-sV&_nc_oc=Adrz7H86breogYi8cx5USTWUJkSEfkaPZdWidRFCxe60f1_XaL4fNzj5KoBmmYuqTe8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0RSl0fGlmooWnGytNwM80g98Yy9QtdorFwoE_PfiIz_A&oe=69DE513F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liNjmeR88jYQ7kNvwGsS4R9&_nc_oc=AdooIbtlLW6ScU88tojy8I4yUiNNPKrvu09NXdJ2ZGKac1gAb5m09IzW4KeR4v0LB2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0OnTj-C4xitbfzS1m-GwX9nP0pDf2tMJHwuOkL0Bi9iw&oe=69DE3EED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJJ7FUWtCyIQ7kNvwEp4zS1&_nc_oc=AdqyCzZ053Irq1R6Qiev7xod4dxcA_2768E9UkkOoAO6_WasZQkH2tJTgYEM2aTcpNc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CsKMCl27TxhcAqhAM0OG_3yL5xqq1GmpigR1E0QWsXA&oe=69DE435E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
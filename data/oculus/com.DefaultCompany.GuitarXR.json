_sid=6e7a0a&_nc_ohc=0T3VmL59gXMQ7kNvwHJtyAW&_nc_oc=AdoIbEJGoFMpk5t_4ZlWtA2G9z3FIbyzJUAPXwV0RiFd35t0z3hDxuODCRIRSGG4qvM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vAMSbP__xgbhG8Mh-ka11m9XUEGbz1aZ_UN2XrpNXtA&oe=6A2D6A73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f51RHuVA56oQ7kNvwFWTsBk&_nc_oc=AdoIBId8suaXAPb4gzXImc15HZ-ToiiW79sP3H_E-xdKK6HPUN23fPZ7xd-_ypOjJVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XJHklhK_ALmIfphrfm-_LO6y0xyl4xdM_qEIJSrWyeg&oe=6A2D5D26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktFW7KSwpMUQ7kNvwGwO7N4&_nc_oc=Adq9x3ZxDfRz_SzHW3YE34goXJxMZM3e70YV7F6YPD6IIv0AputRYcesWH3Iyp1eUUU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NpjJ7yhNjcEtoZmxQI360uHRcINbki1SRmVKQvyHkpw&oe=6A2D6B3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqP2d2DG4AcQ7kNvwHb00sK&_nc_oc=AdpTwFbuGXvtneaODiX3KHno-ZN8qh2X1UYYLopvfamMCdfmujmbuFQq69MjTDw17H0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_NSX8-LNY1RCvmkphDRAMK_3L9WDwi2tANlx-iotysWQ&oe=6A2D58ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v9CuR2urKxgQ7kNvwHYmcMy&_nc_oc=AdroD1Itst43hD-RbB3P084JMtFDkpzqrR_qBzKdsHKI8M0gTZvBG5eNtjMdCNJewzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81ir08ddJezMs5LcL9Ij4FbE8bcrW9pW-sqvSgJTWqug&oe=6A2D5D5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
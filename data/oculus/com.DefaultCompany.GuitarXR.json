_sid=6e7a0a&_nc_ohc=GKK9HA6hGZQQ7kNvwGV4599&_nc_oc=Adp-wpWYPGVyG_RiQQerqBI5fIF80iXCiWyjGdfjpx5-8xs1IB7tgsuUKrVhyv3tPWU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC3tiYlHdzHUmYZPjhutaO4-1-HU_AqY68wHeYMAsVWg&oe=6AD38773"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nws2QU8ayI8Q7kNvwF7WeKx&_nc_oc=Adry_cA2dCWQHaAjPaf6uYnUl4LNWfs-5nMPDPaztSX603Gwe2WDubJLrlRLUY7f-U8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHCHHuiE4Ah0oSydF00XmraoFLd_8a2bAkkqv9BnsRpQ&oe=6AD3B266"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XDESdvWs80Q7kNvwEneYvm&_nc_oc=Ado2G6ZlpVgynCX50Z7avLEdZK5-7EmGbBARCpqKVyke8gHhL-PlyhJUXve--9bQ0Rg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYRWDz-_smuRb60nSDM0vV6s78X7KeIFEk0uchoCyouw&oe=6AD3883F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLnRWRUSR84Q7kNvwEmwlsP&_nc_oc=AdpT6uvqJUo5nhH0tkZXrhcg064nWkS5kJVAnHV1CxT6JcIuoQ8TzTHsacQHZNzB6RE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFn2BVSbqxwq1Z4GufvLa1sA3gV6OVbpcFVjvVJVFuVw&oe=6AD3AE2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FbgZlvKcusQ7kNvwF8G1qH&_nc_oc=AdqKkHHbugG_8iFTMeTq5xoO9Ih76cDJx54YMhEOd7I4D0pXIlziXA6CGnNOQ6iu6ag&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsn0ztqlrryyyQC4qRrKKV0DuiR-4PSkBot4QQG5jcoQ&oe=6AD3B29E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
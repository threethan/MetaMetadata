_sid=6e7a0a&_nc_ohc=6eKX9YEiWM8Q7kNvwFolZyr&_nc_oc=Adrxf85DvJ79Ipny5kBhyHMIRI5MZM9Lc7mo6F5BfcNkiy4KyXwTHCjQKAIfML2DG9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKVmRjlehIJj-s_kcS0hfjZwCLTeIDkZMnAIAQjaLzGg&oe=6A9D79F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d23aBGODdiMQ7kNvwECirVd&_nc_oc=AdpkGxzIxbSdHIfWRiQ2sksd00GZrzHMlZRZgqLbGmjH0YbkyemmjjiE8TmjvuVb_Jc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLVCmrY2JpCGvXL1zrlxTewBFk3SejMrMG3gMxqthWgzA&oe=6A9D6CA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-pOgGIRkYoQ7kNvwGWkOS0&_nc_oc=Adpx-WBWtChmGr6OMcR1ssF4iRMys6YpZuoTMY_dw1euMLIvOtcJWZWJGuDPXEx1Uzw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFSRAVyENOpa2uhWp4lDOLKvJkJbAAg0-805shoDIXLA&oe=6A9D7ABF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-GSLZM4DYIQ7kNvwFPviEQ&_nc_oc=AdpFSfonUecN5TJP-mMX87zJF6NcLfts2ayFt0KMUSTMxDFv2VtXLcIPhtuqOcPTe1Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiIzziUNDHyYDtx-KU2-dTmHfavQtQFQ6Je34YmSxQhA&oe=6A9D686D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kO0TAqC9DKAQ7kNvwHuKIdI&_nc_oc=Adr5mckrzNxSbhm2ObR651N3T22kgeYq3IfvC4EHtNx9gK4_fSVQSglngVld2dDTu3c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwgEckR9umeYocxFc9rF0atoVSlaWZ2CKwc6_d7KkvrQ&oe=6A9D6CDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
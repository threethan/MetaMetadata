_sid=6e7a0a&_nc_ohc=ryriT4O4MKMQ7kNvwHaeLDi&_nc_oc=AdrG8iGRyUbWh7XMXeMJ0vUxJOtPla1wORPjK3D4_Y5atGywAN_tfa9iNNcc3d2ID8I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvy097G84800Mp3ckbBHdGkufYtQY4ZuUAzdXT4gzq3w&oe=6AA2BFF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq_y4oAiSWEQ7kNvwEI-yMN&_nc_oc=AdrM80nbIpg4nNFocoXF4xlaTV0cNL_-c_3mHr0AwOOJEZD2CYQdXOPxhQHwGkAq09w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs5GPiF9NvSksxuE8kvZSCRho1093JvsSXg85WNx3hNA&oe=6AA2B2A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqtgbd3U3h0Q7kNvwFbwlGy&_nc_oc=Adq6rzA8psE5wi7upafgf330JWRoC6NIk0zLSj4fPiaJX8JcbhVpjP1uUl0zkYESwjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIfs1dtz5MtkJTw20txiGr0rXAqqpC4E_PlhHZBlaNpg&oe=6AA2C0BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rDqYQRvLzkQ7kNvwGOGlst&_nc_oc=AdrYICsJstCwOyJHA-WMbpqIqNRGIF-ABXqugOWjy2zPUMaG_07CqDNl7CUcT833Zww&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8_PRZ3rWxBE9RCVsh39Pk2WjIIRstzI6PW5pFY2bf5A&oe=6AA2AE6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4G6x6IVnWD8Q7kNvwFO8lla&_nc_oc=AdpZR_VU9GnkC-PhvAwaVb12CZXq3h8y7BzAzS0hqnN6gRdsQa8-UEWlBi0HIQTetO4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtX5XzSVz4H1l_U78RcYGbAMpPDixOH9WbG-JpzferjA&oe=6AA2B2DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
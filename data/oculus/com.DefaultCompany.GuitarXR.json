_sid=6e7a0a&_nc_ohc=LEYd4v8XlugQ7kNvwEsEMTG&_nc_oc=AdqbGF47xLq0Ma_90vUq6Ek2Ej9Io27kdN9ZHwCY4eMcaCC0iKtKOJ5ImcIG4bWCDCQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcraeUFdcX1mBZlVaxVSXVcVk_yjMl6w8_n4pMnAqUQA&oe=6AC3B573"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53FuTJWHooYQ7kNvwE9bseZ&_nc_oc=Adpb1Eu2DdgpAYV-D7TNGBoXfD2rN7QMWbgIJZTrTSJr65mCs1ln7Hh2P19HKkv4ZbM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUm345aCCLYt8JN2O0-0XOF3ZWh3gEKLD0w5JOgSNlLw&oe=6AC3A826"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saPg5tOYXqoQ7kNvwGPx8Rm&_nc_oc=AdrPYzf6MiiJQriOU5die7xasLeZxLP3sE1szilwLE0tZfhoFF_0LNaMMMO27fw_yqw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNUtg-4hQ2HpqDYxPv0Xz20AJvINdIHvKnf1nwjtPH7JA&oe=6AC3B63F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iC2s_Y4OImAQ7kNvwGIWIow&_nc_oc=AdpfdZwkb3kvPWGcN2giX7jTYEFENSd65jpwRvpKSBQ1W7ovl4PcCYnulvYId1Qk44E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQFTkCQluCajJthVHWCM1WzhAF5Rxl1LzeGJGI7ITuVQ&oe=6AC3A3ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fqV7nyk3rQQ7kNvwH6joG1&_nc_oc=AdplBxGJ_eADezZ-tNuIAskzloBaX3zLZ1usSR0gwcAgoHBurS3D8_Gq1cJxUZOYMF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNGwCnWAijg2b10jeuEEeawt9EPMJz9IqZWMfh0xlBYKw&oe=6AC3A85E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
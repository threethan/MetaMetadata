_sid=6e7a0a&_nc_ohc=3oZniPfImjoQ7kNvwFgZJmI&_nc_oc=AdoM8blF4iuPEg41eeuP2ncIVcmPUir2FOn9LY5HyvKX54gzcjNenKJO6vty9hzS59A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbGnjROO2PAYBrV2zPjFMtpAOUFwnXBykst_yrTcT8EQ&oe=6A622673"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s525BXY4YPQQ7kNvwHJ7BN7&_nc_oc=AdqHymu6Wq6K1t7mKE8cyw8FUvGgQ_mxEc7O701ThMn5DWccz0G9icwYO2TbwG873jE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7TYJ0siyMtSSIJiIKfauUp8C-Gcb1IOwdARqoapAAYA&oe=6A621926"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbneNV06d1YQ7kNvwEtbb-V&_nc_oc=Adr8s58It3VMNdN9a4syhmzU7gk-P-FEvuzAU8b1HXWuawjsS9RKdrafI71BWRwuJUw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0Ll_q_bi9LsRiYGoSgfoEUNG1ddg5_DIs0GHAZKPqog&oe=6A62273F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6hZ1ZafBcQQ7kNvwHcPr7q&_nc_oc=Adrc86lCNU1spBbh2W9udOFrHCG8LRgZO8SYg3KNhSJ0jR0k24I7Utqkys1CvUu_vYE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd7Y2PAVWPmKMBmcBwSfqYU8lVKllYMCR8lAUF-5cDzg&oe=6A6214ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UueRnxKvBwQ7kNvwEmDa8j&_nc_oc=Adr6ujFpaEdcDGQTptC8CEH8VveMNUdyzDpqqoRDSPmkqaprLmi8GNlH5um89xf8FMY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAthsuCfJRmcyoM_p5HuCbma9uV2aa3ufH9geaAxn_v9A&oe=6A62195E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=Srbi1mu4Sc4Q7kNvwGjZ7PC&_nc_oc=AdqAFR5mILVGumHJqFgnMiCMDvCfbax7LkD-cFJzzgEcfkJmJpbtaU6Dmtp652M_zHA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_Evdh8QKRIvDY9CalCHR72mN3zCHeEJTJj4ghb4Tvtg&oe=6A3BEAF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPzzUKkhD3UQ7kNvwFo50kK&_nc_oc=AdrDncJqg2s5P6bJk480wgY9t_4OC0k04Ice5plc4pkydVo9xUOulV3u16u8VzJewEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ivm0P8cKBcbOR3VVl-z7u7ottBN1nxYv6RDqx-oZCtg&oe=6A3BDDA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE_5DN5juw8Q7kNvwHpWFgI&_nc_oc=AdoUQEH6C_-TXuycZL_IfKG6emwBTypTBppTU1kYeJKx9WvGUhEMM4oRd9DV1LU1eQM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-8ttUV5mcZJrUE5VjkaCjXEBUXKnOe1WGNH5TQaS1b2w&oe=6A3BEBBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCuF0IUZhGQQ7kNvwEvT17D&_nc_oc=Adrxk2z_nXvB819-cbGhEKnXbTSKx3BKr9bhKyX63Z04G7zPc_coa3jIibu0b-pEKy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r3geP8gwYl4E-RcxXZBGfLcmhXUvvDSDe5sZ9e236nQ&oe=6A3BD96D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg-Kc7Dc4NAQ7kNvwG1lLiz&_nc_oc=AdpjXpK8URpGkfYZeHlFHSyWpj-vb3ggdCwuZnqsZRYDKzTrBdHzx_jH4-WRSSQ4dPs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l-65AQwpDAJdyScnYuf88BHK38xcZiW21tRsgghwHqg&oe=6A3BDDDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
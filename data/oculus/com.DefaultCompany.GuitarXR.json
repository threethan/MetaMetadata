_sid=6e7a0a&_nc_ohc=ra7Kx_Q6gH8Q7kNvwGbdOml&_nc_oc=AdoE5ByyIYqbTaUPT6ZZyBWJZaxIM66HSzpxcyXQ-2XxRkFdAW8KUeNpDbxit8eKuck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Wjg9Qt6yqXZHatTMdCGX8WyAG5vFghPGuTGsRR87p5g&oe=69EB7F73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6ARQ6C7oCwQ7kNvwFpXZzk&_nc_oc=Adq9gNhwWwlBrGCh27gJCwmKoY-mPR3-4BMbzAzeZ23Utp4NOQtG1z5mwmQPd0dzOsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0S6c3S_Ft09G9o7hlAsYvxcco7g9lRe5CKlqysCiZZJA&oe=69EB7226"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlNG4sCRt-IQ7kNvwF3kTqv&_nc_oc=AdrrM1QWNS-9U8IjEkU8sjthoY-m0cPUpS4iJj3a0qyT3HarHURF-dmcCvs7IetZE1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wGUM01rDBsYB5gJj5EDzSEfe9hUHt3i2ePcCVI004CQ&oe=69EB803F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bJpr5niBnUQ7kNvwG-CsMW&_nc_oc=AdpPz6ST8JgqKGEVVseNXzJ2HCow4fK4yUPDnHTsPul5WgDbyubGPNbb8bLcmZPCDnM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vynOhsb7AEmrHMAKU0i84kiKGB0Bpf1jJZKB-Sc-0kQ&oe=69EB6DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pqb02aSTwD8Q7kNvwF1jP6V&_nc_oc=Adp4ICJ1YIc0rAJs48vLbZwZf5J3LKHSWpdiqomsPXsX4YFM5RVmoxSJh0vbzcpj0aY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ir1RmTu5o5kA-Bx0vhg8W_dHv7ytquHLnIkCQixf9Ww&oe=69EB725E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
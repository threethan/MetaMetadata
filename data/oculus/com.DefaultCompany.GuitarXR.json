_sid=6e7a0a&_nc_ohc=N7JGJKrNB0IQ7kNvwGu7UBG&_nc_oc=AdopVs1eE6L2DrOdfRE4OnVZLZq-C9B9wZjslGPaRoGADTEq72rNtZ2JomyAZTXVgBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOUyhTyBvS3N2Z6JR4qKCOwQo8VlOcrbn3m2VPmk2RN1g&oe=6AE4AAF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGHuZDBCYcEQ7kNvwFR_FXv&_nc_oc=AdpYyCe8-s1snICrm9Nkk7uKw9ujB7RE3h1buUnGV9EsTyYriGgwPSAIlhmdgKxZuXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkUJr8vbtEkv9tQ0SVKP1K74zv-qz9XI7TpzF7tjuG6A&oe=6AE49DA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENufpooyKsYQ7kNvwEAu8f2&_nc_oc=AdotDC1Qmkwqjh10pOzLFKDipwAQuSp2vp8xf3zl8TO02HR_QRYt9qhmB3FmTBlGWYM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9tSppWcfNWSUmFt5e8tq21SZ5lL89bFHA8DzNVP325Q&oe=6AE4ABBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bPa2B_1T3wQ7kNvwGRMiEH&_nc_oc=AdrI3x-gDHJtaV_Uy_DVMXB9iGEk2LzsAsXU_REs8_wPsR7tmxqzdBvRW1jcAjiWkhw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_i3BhXACixNs-0SYyDOwST5ZYxbJSq5ePdKOENeMKPQ&oe=6AE4996D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U97ZJCafUdIQ7kNvwHgpnoZ&_nc_oc=Adra-hRJysFMwO7cZDqCHcaUVjNHuIANQKGrKgo7TgEWXw-lcLkuqhAfm-79LrNcnbc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-0qer2nYyOWBabed1WTsEPYcSKmEZRGhjpjSwMNjebw&oe=6AE49DDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=GKJHPNuUh4YQ7kNvwEiTWyk&_nc_oc=AdpY4jplHHtvwk6_JQe57SUUAYZXfT_lp5iU9gNs_hRZ7QfLf6yrnUCGbyrIECZWqqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEKWRwK0smB8Gethxs6mugot1hY8LEKDNzpv_VCMZOBg&oe=6ACB9E73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xveuC__NQcQ7kNvwFVoLeK&_nc_oc=AdoPUxyFsyekrgCtBI25BgZc3WDHmtgX0znrx-Di0CH65O8q7r1gGMqCTjgWuPpuIXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6q71Qfbs8YYjRpL5Beu4NWM0GI142YS7MqBKl7ZI-Dw&oe=6ACB9126"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsZFSkqtes4Q7kNvwExn2cB&_nc_oc=AdqBY0eJgtvQ-9-WuSBMsNybBT5bcyUnRL1hFUGVDNVy_PVlCFQvkl4x2oGtsfM4vds&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIusmgP-EzjqmL0FD4qs_k4SskGI9NNN0GgD7AgeS0Nw&oe=6ACB9F3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0PufWY65vQQ7kNvwHRhDZt&_nc_oc=AdoVuXPfvgHcvh1kD_brlG5GU2gjZ9aQtLbqMVuPxg40jmEH8DUSXCH1UmFzYlRAYjM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMLT_CzwWpcwkEVbdoZyz48827muqjw7dFnFyiR6cZLA&oe=6ACB8CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8u7ofOgRL4Q7kNvwGaM7TI&_nc_oc=AdorK5swaSjCf3sGIdc-HL-D55uFIP5Ha11lCQDs8w_wvpYKySaFZvIpCkQBBIE3fI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8DH1_P8EcCawmCtuQZzDSDpXrWSD3oW2BCul5E2juZw&oe=6ACB915E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
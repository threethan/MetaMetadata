_sid=6e7a0a&_nc_ohc=Gs9ZpYd3rK4Q7kNvwFIwXTD&_nc_oc=AdpXAW1a1CGOzP0Ke4IeW_AROzKqmi7mkYzKStqrPielGOFYG-dNj2gvqgxhoK9Swxw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7G5OTHithqvxzb9y8wLuNciamrpSzXVQc62VFgcowo9g&oe=69FDF473"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_HRaYlajc4Q7kNvwFn8Rye&_nc_oc=Ado8FQE9fFtsxMw0uZtd8l_r5W4Qi7io8tnWuzZfdOs9U9dklU9A2ch7f29bbz3R41I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eKl2OF2Ndp83RaxftTFU5WZmxQk_wmj_OLlGW7sC2NQ&oe=69FDE726"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzWmCcTBQIQQ7kNvwEffnB5&_nc_oc=AdoZyYAhYpUWQrXWGYUYpZlMuNiW8aRDt4DnkZf4_B2kiJmrcMsfXtlL9CyCKK3_VyU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MLsCBxkbkCQZ2vAnF0K0BqOgLB_DQzKhNQx-uyq3Uwg&oe=69FDF53F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_7N5o1GDdoQ7kNvwGD_xCD&_nc_oc=AdosLddS3vxTlPA7oH5kbpg7oPYwwS2kVFyFUbguy8scpERx69LTo6UwTxkhQ1wyBr8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nTEV0-lOpnOpnVzrENMmtpJTYGUTqZkr9x2Ji9vlyVA&oe=69FDE2ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDyRl8v-UvcQ7kNvwGf5gGp&_nc_oc=AdqDLUnPTdLLnDLQEZtao7GnKzD3ISBFYMESrSjLBT_Ei87bS9EcU7bWeH7-RKNk9O4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ygP_1SYAHyu1JMGB7hLP74kWbchiNVF5N4Kxfp54Iow&oe=69FDE75E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
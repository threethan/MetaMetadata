_sid=6e7a0a&_nc_ohc=_Pnuu-Re8f4Q7kNvwHTJfTb&_nc_oc=AdpGnY_Vc0ZecvSYqH8Kiub3Dge6kE0MgI6bF7vCxAyFPtg912ZI_ls1Hqvmn-Ow2hY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOav0TUsuH7JCEqQd4JdZByMBustzV6qMFm-AzkCIoJdw&oe=6ACCEFF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xveuC__NQcQ7kNvwHLmZbc&_nc_oc=AdrH2rxSZ4kzT4Uo8UWy6nanrfgXKBzKq9b78DXBG8qgKcz7okWU8hzJFY7egTr_CzQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNC1ycWy7zv9bAzHJjMAVlKY2yjfJXwBWUX_WACk3AqXw&oe=6ACCE2A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SztD8XuV-QwQ7kNvwEXt5Ky&_nc_oc=Adphf3rUFUKu9qxMqvEfvhTYO2ItBjQifNSk5gCGcmKNRLTXL8isXso3y3BRmAgoMCk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmmgVCF4-8AKFfJhauz9sHFU1996OYv1cllOEqgqqhow&oe=6ACCF0BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGdDh2K7cfoQ7kNvwGGA1Cg&_nc_oc=AdoOCZxo98R2elAzR8ygtg4DjQbIE8XktP1-soKeh5v2Lwig_y2zqy-AKK5tpGiWcts&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKrIGQkNIaLSkjoN--fIDNyw6b8pCa57kqzg3zTwq9yw&oe=6ACD16AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8u7ofOgRL4Q7kNvwHc2tRj&_nc_oc=AdrKVBba_SiD1KcpSjn8L6ILNc0brT6cgHyWYiAlrFtxm_wpMbuC4-kdHjsooaR8EcM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLKD9V6Q56mHqXOsKQ97MQT6apf-5LrYtJM1Fv8h8sGQ&oe=6ACCE2DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=EtuSRtCRLKEQ7kNvwHtals5&_nc_oc=Adqe30QAU6fAK0nVIJYbP81nAKc5ovYusTyTqfjCWxuhbaAEKfbD5pQWxL9GHirE7aw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO5Ch4sZ7FksX12SlxKSoae0ClG0z_dbaLEwyZ4uACnA&oe=6A773E73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRIVXIs-dH4Q7kNvwH3ufFy&_nc_oc=AdoNzK47v3PMjvIt36ruFVTiOFcWmbmhL-rPQ3KuAlF1m3VYvLkPBkJ6FyUm9sz8c9Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3TrGyZf1LpmLtsIvf_nJS1ggIyZDd8PygESkeFw9HTw&oe=6A773126"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QezS8gez_K4Q7kNvwEvvsar&_nc_oc=AdqnBk-4pC7j5sa5LFcUbfCtXtTWFMST_iFXd-PU1ofvdRcrUwY0kdXNAEzbLyZlu-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtdH3cOosPxv3VBiGKAAa4WzqUAx8kxccgkrgsCPY9TA&oe=6A773F3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6xyIOBRsywQ7kNvwE-KXie&_nc_oc=AdrxypB5Yh89cdoUTrMVrWJcCWg042RhXYL7jzr6U_R4GUX4eYRJLUcAL4koXBhDEHQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3qXVBb2OLUsRV-sLC4XBXsXSAM2i4oguf4RMIf5Lf1A&oe=6A772CED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4i5yahwFf8EQ7kNvwHbdrRs&_nc_oc=Ado1PaQ_NxV_hi2eRdsnIcp-vNA4FjKlHrPh1piIZ4l81Oz6EATagN3OV0ujwo6RUwU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEq0rbszlCkEXrlUVAIVbHLOY03B56jZzeWATc7hFVHpw&oe=6A77315E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
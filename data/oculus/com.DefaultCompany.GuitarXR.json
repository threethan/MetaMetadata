_sid=6e7a0a&_nc_ohc=dicynaiKuOwQ7kNvwHn82JL&_nc_oc=AdoqWvZ0hqR7yKRsHAEO6mQ8AwRDu6HAW0odVqHkXd_a2MDJoP8ojSQa7yf7AGOcL20&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwDKobXEpkMjDHU8QrhSBB722Q37lRl5DJh3cUbqyJvA&oe=6ABA7AF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v3GibJUYY0Q7kNvwH_BCn7&_nc_oc=AdriVu-aH8mQZguxl1OwZJ5OIEwomJR0hHiMblAquNzX7vP-86uIyPYs9_ToAd-_NJw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLc5SbXkwOMzL1avUG5ykoMenHDdDnkAMSqWF9m03jarQ&oe=6ABA6DA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rtSmNDfU3oQ7kNvwHd2Wrg&_nc_oc=AdopTFZZaEvpWK8tfHz1MypKDMbtefK8pr7atdRqI8I1mDgiP9nxubpBVTKPTSadsTs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLt13kovyY0L10hnHCNP_XQ0qzTvrQMLWoez_upKS-tpw&oe=6ABA7BBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALV4iZg6br0Q7kNvwGXA0dO&_nc_oc=AdoQf7pkOCquQWR5JWPAIGu-h1A2Vw0ByqKlka5h8wOyL1ndLwZQpVxK87p8HPcy9eI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIirwdlRRik6sd38VH6BWZVdqDDrlv7kQIiv_PY-S12FQ&oe=6ABA696D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPLble6og9EQ7kNvwFUD_cI&_nc_oc=Adqg9aZSOpfCUmACrnRbvskPdjRzOnOuon9KNK58FdfL-0r8rNtw09Fsr9uYDzGUdSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIwk_IuTyElrZxUj3Mq5CpPhqmG2McGG270FfamlFf7w&oe=6ABA6DDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
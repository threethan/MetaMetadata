_sid=6e7a0a&_nc_ohc=5hTyJQ7DzU0Q7kNvwGu4uAU&_nc_oc=AdoCqyumR085gHair82One3jNtHeoJCQHeu5XZhdOHHF1JQF5EJ0_ff2_BK9cbChxXQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LlAF1s9qt8WKW97dN6g9IFndc9ZVoME4GwvCXQoez6A&oe=6A282473"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDd_f50-CFsQ7kNvwHoFm-W&_nc_oc=AdrrhGVzNZEA6y8uyPc7WarI0YifxePbXCePJtpZNOOthVVFqm5gVYc6kbCOSYwcQlU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uPdNF7rw767YQb1kkHKWv5WgexUvgGgDNZgAiNgnrBA&oe=6A281726"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOSB4n7mK-8Q7kNvwGd0DBX&_nc_oc=AdplgIjIj3EPaj3-7Hey-pl5-gdowoN_CKQMtuT4LyWHdWsejoE5muI9MVM7SQ9H6yg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wdRBxf8qC2KG7dRwmZBwx4125le07z8o53CQIjzSvnw&oe=6A28253F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kg0DZyz6qqMQ7kNvwHsfMW2&_nc_oc=AdrO6ynMMocaaSR7DuXv7pONF2ewcKgZU3ENCPudM7iYz5WvlGTpWnjj07WLGkb1y5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-242X7RLntlvl1TwpTXdvBQMzx2N2oa2EAMa8pnTNAA&oe=6A2812ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFfUO4dKI9kQ7kNvwHPG_D9&_nc_oc=AdqCNFaInvx2dtMHixlodlUgt1bOSW4PvearLUA6_U13zPqIC5aR8m4-QXTSVmE-3hc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w-tzW7AGvbp3wxjnXcT2OQfKxJmQeKf8kJOtkzjvZSg&oe=6A28175E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
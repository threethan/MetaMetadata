_sid=6e7a0a&_nc_ohc=GKsgwcXkdIwQ7kNvwGTLOMx&_nc_oc=AdpMzWJ6Ke8etFczaAr21qX2dAQUBVLwnaBh-ZZXQ8r-CC--c1XryexgpINCSTQRyjg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3L-1CfIidjjANa2ld_bmD1BW4mpwEJMBEm3XO67aW9g&oe=6A70A6F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwsPlhg3xJEQ7kNvwHgyE8C&_nc_oc=AdqQIBfuMe0-0hje_OlimEa_ieaQZVmZxsPuZ9NwB88YIy7Di5uHXITBKcHs68n9QsU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8R4Y1QXgsQdEVQ_zSFw-fDTUG1CAKpsPzJrImMNXJCA&oe=6A7099A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tp-9WpXjY4YQ7kNvwHF-9LS&_nc_oc=AdqN89gxqnHxuxEkZhbKm4EzXQtRxXh7LVDVzhKlcSLQwIXCofAq4HEPN1FGX_Nxv2o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt4gZWmpoGw4LeydWYqTW0rB4egTXQykH5cJO8gwKQrA&oe=6A70A7BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTbeDxecYasQ7kNvwE-cWDM&_nc_oc=AdpiVCRFN2ztZ2m3BBKY8ztOFLkgyntuCY4bblu807fUZMvGGh3ptQD9xPJdsv7-D6M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrAwu1vfdqK6H-uUiGRnKcUSlLrU_mVWn25tSejexoEA&oe=6A70956D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TcHj1Ex9EIQ7kNvwE1NdeV&_nc_oc=Adp_y08XVxx1Mfp3sQO03nTW73tBdIcF7PwDn2ZIXCdzaITP9Ep5wfF1x5J3lRBQm2s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzLgh7Vydj2Jrrmu808eQhManzzvY9XchORvoYaHmhuQ&oe=6A7099DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
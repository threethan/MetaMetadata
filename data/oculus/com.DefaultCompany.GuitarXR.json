_sid=6e7a0a&_nc_ohc=IyYbue4I4EgQ7kNvwH1e2-5&_nc_oc=AdoF0zBQclXGOJ1qtIvO1JCMQChrnBbvunT27PTy2gx4LfxlWUvHiEiFFX7SxbSKyNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxx9ckJnhW7b1VexbTGImgBwyZuPef1gH0rfkS4apblPg&oe=69CA89F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqaFz8C2imIQ7kNvwHciwzC&_nc_oc=AdoFlCzW3lJhJ4Y69RjVia7KU91LCBABxUCe8__rNQeLalBI69nSNtZ698cbvfKS7Hc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCjlDbs6wzMR4zzBCCdEZk_IT-AMockj1Hr-UJ4aanDA&oe=69CA7CA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvAnWptvAxcQ7kNvwHGph9M&_nc_oc=Ados0hysrgiVVg9druBvYGZcKrMB476zYXcQnqVot0BXFr_cFOk2SwAHnvkWt6_wOAw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwd18oF68-jHswd7xedM95cykuRFn3gBpCh_8Oihmd94w&oe=69CA8ABF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7b3PS6EF55MQ7kNvwH3oAz9&_nc_oc=AdpTFoe-os2LCyO7i7XYmxxdOnP2F4fRRHmSoqPUx4N0YuR4ZtilhT6H_YbdD0kJHns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy70uzgKo4zGGimqv425WIX1ju_z8a1vyWlOByiSuDy0Q&oe=69CA786D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Lkj39JNDdMQ7kNvwHb7GIR&_nc_oc=Adr23yCpjHjXt7nT1eNoMOLjoMqL2q8gLoT1NJ33D7DJgRNSwvgYSgzVZex3KqZjxqo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyW_iZSoPZ8VdMPaGrvtM6s4NMXndxKrUOm9S-D57AwIw&oe=69CA7CDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
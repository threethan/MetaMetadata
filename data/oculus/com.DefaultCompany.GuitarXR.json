_sid=6e7a0a&_nc_ohc=IyYbue4I4EgQ7kNvwHWxZKj&_nc_oc=AdqGHTd8CNXQUZrg0y-hMDHF6EFnv5pZdsmRVH1VYxJRZj0LBzqV85DSjKMJuKW3GFA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxprOn1ierSuimsj6hW2DtLRf43yQS6F_c_WqgUB5H2hQ&oe=69C93873"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VqaFz8C2imIQ7kNvwFpRDj5&_nc_oc=AdpQQXkMf_AsVAXnA5kdITpEhMrg_thAH81D4o0oCfUzjlXXxM9_xq8jGl6rfpDvRMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afywl6_TE8M6jMCli-jON0iuaFHTO5LvquSSiorXo3Wk4g&oe=69C92B26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvAnWptvAxcQ7kNvwEJIQmC&_nc_oc=AdrFvHHhkodho1VGVKthsLs2IOJ2GJLonX1jWocDLYYBG8FTZCZuBSMILqI_ZJhrmno&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy-WX-mi3hjcm7ecYnmdATs6zqQP-tYmkI_G48Jz2mz_g&oe=69C9393F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7b3PS6EF55MQ7kNvwHErCnF&_nc_oc=Adrw4lLSNjkPBWYJcpS8Rokw-4SeozF5agMZzU-_dgfPw52-wKbu6e4YU72SXRqlwZs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmahT89Yy9aVsWD7wxtgY33TaMOfeV9UpdhorKTZReNQ&oe=69C926ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L08hWoTm5YcQ7kNvwEQAGmP&_nc_oc=Adr6lbNl-njWoXq7uX2BC8K0Qv_wMMpO-hFuWS5NfJDCsaImhIXZwNapphVx5LDT-_A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwu1L0mYHXyNzROYkm8nW7v_9GjleRMZw5UiZphx5U07w&oe=69C92B5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
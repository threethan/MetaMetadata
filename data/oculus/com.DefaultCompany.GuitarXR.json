_sid=6e7a0a&_nc_ohc=0a2UF-bYmg4Q7kNvwHdhZuB&_nc_oc=Adr1lSs82MMRoZl1wZ0QTAPX3YP1IKQB0d15SnrC5SRZV7tWNyl9UKYXBooEj2VT74o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DQJyzWWYKkpJYPH25fm_fEuqeXGQYlFc2I5E051ywbw&oe=6A0DC673"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NW5UjsyPkr8Q7kNvwEnWG9z&_nc_oc=AdqzA7RsUweD1VIJsKJOgovnaNvnp1zHZ99mloCTaqGEaZmc4iueKbdCphUfaqQP5qQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L_1fHIO2gtSVS7-2ywxE7uidiQgcTI5yDRqrwvddJuQ&oe=6A0DB926"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB7CDPfG_EwQ7kNvwEmzPDa&_nc_oc=Adqwh0WXgQQlWalKFh_T5H4awFbzaa-Z12cbuwkPhmq1AgBmU9i5VZl6swsWfINwzwg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PUQrPFyg9J72njadJE4lh-N28K21INxf118ZEKhxSvw&oe=6A0DC73F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPapNwdvBDEQ7kNvwGqUPtz&_nc_oc=AdoByi92hq-dL4nMhT3Mx8B8GjV753KpKAVHLldJ0Fa6g_wJ4MZUamBaGUVTmo8Xhgw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KLjExM3imTepS8d5TNHuJsfo38CtasibBrJx8Sytv4A&oe=6A0DB4ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MTjiCK6iOEQ7kNvwHgx3s1&_nc_oc=AdqtUPPmv0AxS67QJcleG3kUDL5tkDzSF6jDQzHh9ekDDDVO4V7cUlu2X5e1gSAskSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7esZBwqCys8cRiQPltJDi5GeXwwJhMyZMbGKCO4gm5zg&oe=6A0DB95E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
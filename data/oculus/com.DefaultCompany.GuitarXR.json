_sid=6e7a0a&_nc_ohc=2NB0LSSLvRoQ7kNvwFrW5Ds&_nc_oc=Adp2KFUA8vyh4I-6GUiej54lU583unhXjVVJ-7w0OxOEU_NKmV1chrHtmxLRGPL0IqE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkDCOMVsC7vHccndPqa9QegYxBW9Sx276Gukg-uSLibQ&oe=6A4A6B73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Txr_OVk9HX8Q7kNvwEyfzvG&_nc_oc=AdpoTBp9OUjOZL1zR9rNz9WiNBhNss8rok5JSf3M4_zlwNB8AMUrThm0Zzjbq8JCqi8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5n3qjeNLOWZ2ke3x6DFVtbqQVVrj6K6bM0NXFgrpV4g&oe=6A4A5E26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfTtugXIE2cQ7kNvwFUPqKD&_nc_oc=AdqjNx4vucUu8bio32IUBYHppA8WOhLOVnWKkqrF_dD-P3bQjZCabUcEs2QzTTNRmNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmjI540ZIrgRZhOW2FzwIyuBgExZa6ivoL_lcFHQxe1Q&oe=6A4A6C3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g-B7M5AWF3QQ7kNvwG4KcCP&_nc_oc=Adp0XJlVqw6oU0KFLDeEYS9QAwXfUz-61iezba55PVkLwJXsa8vbfdOFVZ9TqrvOSjM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS7KC4qGRLkBDZMNRAUVfAWc057reFwaveXtGxnTBC9A&oe=6A4A59ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IUOAXI07Fc8Q7kNvwHfJhia&_nc_oc=AdrxIuEFVdfrCf76HiIQ3MU32LlyXzrFf6G7j8RZvCGtr6uFXuKuxzqzUclDvaf0_EU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7IyBOfbucZoit2MJrF1XOiMQzNAmHIc7_OUsW9nqnIg&oe=6A4A5E5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
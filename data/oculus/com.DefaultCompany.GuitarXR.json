_sid=6e7a0a&_nc_ohc=K59i5RVL9TwQ7kNvwH2B1Qi&_nc_oc=AdrM3HUstNRy3V2YntR5OGPqBvS8m5B00kqaeSP--demqN-d2YWvwsvzGVlG_aaJolw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbeK9zREgoJ06SjdKonX_4-N0pMrLwvRDZbMTjN-6XKg&oe=6A86D833"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKHw7zJrw-AQ7kNvwENzIIr&_nc_oc=AdpuPi58B7XhPKR6Fohuvmsd0RD9l19rZWbQpluLQDxSLruLyokV6IAjdzXyNZP20Aw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgGBQImsS26rxkHuBDrzZh8GJUXCmXu-IE-cQYaYrWPA&oe=6A870326"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOhEcfCTlmEQ7kNvwH5tOmY&_nc_oc=Adqr0P7fa3DoBZrqnXxxdYnWj4KBm7jbZvtbaXpOnSRjwgBY7-Cio0bgrj_fLVg48Ek&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmg7G0N79ls9nJ7fIjo-RHYEi3kIbERQOGdqUBqSwTww&oe=6A86D8FF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4QkB_m3J2NUQ7kNvwFkhlPW&_nc_oc=AdoZDztOKhs03Y3-pas99lXZ7Dur0OmvOf_G2_gNTTbZt7vXRyfXng6DKKXBmm4eSqI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGZ93iF71UpRHsZ77Yus8YDTqOqUGhYhligBNgtso82g&oe=6A86FEED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPDRHDxcMqkQ7kNvwGVcP8Y&_nc_oc=Adp54C2QXvdRzDWStMuDFemxKCVd4Wt-RysvrbpOjmKrfJpTd9Kpz2kuKl2sgccuKOc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAIUbASkRSivLxp2-v-0ymd-iVbo132ikOYpuEoGHlhQ&oe=6A87035E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
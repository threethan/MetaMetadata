_sid=6e7a0a&_nc_ohc=HMfTsbNisH8Q7kNvwGF98AG&_nc_oc=Adr_IOdjYFGz79Zu3ioCpA-Jk3ZxhW-I7TNBl5muIFfh2FhdJ7OyDUeZom_mGFLKLjM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHfFwN0Cc3yB657kZwMjvFYh8u1_Xs_VPz-dgwBF4FkA&oe=6A60D4F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s525BXY4YPQQ7kNvwE-FfwJ&_nc_oc=Adp_CAPulluay9v9pLFELMOVyyWoOtTcEJFZVBzjFd8G3nSGEBD76URcjVTy0cUK5j8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAodlu_pLLsoRHxFQ-Sq6-ePgiCkAuE5GWwGad23lVPUg&oe=6A60C7A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfS_-GmkQy4Q7kNvwEdtbCo&_nc_oc=AdoJZC-vJrfw0as-0b3_ggsw9QfpybRw7h-HWFAgV6GerP6AM0cqWBzFgFhPTCKooyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2_ykc5KXsJRwxEuCumRCTVHY6iYNsy-A3sUjjhcxiBQ&oe=6A60D5BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXFwFd4SV1wQ7kNvwGSXsOD&_nc_oc=Adr3_DNDMsfE3TIvZKYm00OoswcvxK7Z2uAruP4I6pQSpv_OTk0lePsQD9YcsIku4qo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSaJp6XG3bNvm1flhFxjwM1xZz0G3RaapxS0KBlWJtpA&oe=6A60C36D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UueRnxKvBwQ7kNvwHI9Vo8&_nc_oc=AdoutrTi7ofjnRveGIXqrL--W4hRYmBBrf73tHiRnXqV4fY4bgplNP8Jl80vqFvnEQk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDS0WRGXwZWGsJbJsmpLdMVtkR71VeVHG4m_hW5UvmEgg&oe=6A60C7DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
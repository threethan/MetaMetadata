_sid=6e7a0a&_nc_ohc=AI3Q_z5yvk0Q7kNvwEOces6&_nc_oc=AdpQwaKuz2Q5z06iMBXJ-KnYCPUynpAUqeDXaGJUdUIftoenkueQo1X_yMs4uP4cf-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-Je2ZJ9lqVJWW7wFkgvFjoXmxG_abTzO_cZkqkgXwCQ&oe=6A7349F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8uI-uYwgWcQ7kNvwEI67C-&_nc_oc=Adr5SNdA7um683CjYHFY7dlvlEXRA7bCpitCO-sOa7TA-mOsqXDLrIAr5IAqMT_4Ahc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET0iFxjzrvPYkRrAvGw4ULG52Uwdt0rdQskxermhbgHg&oe=6A733CA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHZVX5K5pgMQ7kNvwGPDrMb&_nc_oc=AdraqZTZCUXsOEtX6lbIxpvgiRO3LEKXZw--LkrtBvZze7MfDMLKGuK1iBzPwSxN1ms&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX7nKfEBbUk-4IhQG-5xpA3m6ELsxntK2szo9f04TKOA&oe=6A734ABF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWa0pZwn51IQ7kNvwGaKcJL&_nc_oc=AdrbzfrMOC5Yi_nKgSyPzah6l3MDIxhCOKnaIjVx9sHTaZp-jWfQLJWPjKG6e0x_ees&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs-nPQHQFTo1sgyxd5fknFsQ83nghQ4L_AZ6cNeeCeDA&oe=6A73386D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TcHj1Ex9EIQ7kNvwEfWmTi&_nc_oc=AdoviM_XLUFlSL9nzm8Hg-BW1Zitr0tyii6rZqwBAOTFk7aITvjwWquv0dljdLsfm-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZdSCxX9o9-c05abrg5diymaqVsA80S9sgfR0YjTxKKw&oe=6A733CDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=G_bYR3y4P-UQ7kNvwFINVXs&_nc_oc=AdqdfrIuGkiVcN8kdCfNkfaGsCKRAoOF1oKZIhAQ0o5KWPQW72kbxWCqBqiZ4RMrVsQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wxjJ3xyoS8BcSjnYVFJjGZWVoHi8kgm1oVJPaWYbgOg&oe=69E78AF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-y9e03CV1IQ7kNvwF20s-J&_nc_oc=AdqtEoHLj_GJT-iyocg0yUWl-l7msFHbKot5irS8ghMxgE5KTxUD2UhhRizLRGozj6o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sGNZZ5DOYgSiduS2i5cMR7zyFtpvuuIr-y00LmIq1Pg&oe=69E77DA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQFCn5d744MQ7kNvwGOes1A&_nc_oc=Adot359_vSuSnIrzA-8V-h6zOU0iSTFmATfY0OCm38b-MsuMixG_nsrIl_-Cu-k8Rww&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-nklimswzApbPdUirSJndCkfDJ97HmolxDzMdt9mLzg&oe=69E78BBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-SrVYVR-90Q7kNvwGyQZUR&_nc_oc=AdoKtjYPpYqzb8Ietb5XpoPFMPDSpj88C72pF9PDm4kX9WDcRzBLt5agOasLO5STXn8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JQ_iVCrhRTzJTjnF9vfG-bjYE7qSj7UfT3ZB33z6vRw&oe=69E7796D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQzQX67GVZwQ7kNvwGouUwt&_nc_oc=AdqAhZulnJVVye9rN9aHYAh4ex_DVLFY7WXvQTIhDS-5pyRRsK9gILkxpDMRzrwvxD8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30OdwJ4pmkFTFizKxHjQxKrOlgT1T1ydsZ7JmtDl7MnA&oe=69E77DDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=Gs9ZpYd3rK4Q7kNvwEYEJzz&_nc_oc=AdomDozv60_P4-VNoVhDZxKEJcE-EuuGSQoMCC9le9Heuw8WYuz4f-n4KDKoy4D5yGM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sXtzrXHMbBuKdwxagis0fGuW1BNrtgeCPQUwxngJuxQ&oe=69FB5173"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7EFBzpbXescQ7kNvwESATq5&_nc_oc=AdoHZ-KyfGTjyFYNpexmtKrprMDUSJA18y1LlOnzkwQ-Zp4-HL81ItNNXqa_FxA2huc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42btd98C7Y4JupiB-Th7FI-g_5QcqhBQeEjolawfVjkQ&oe=69FB4426"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzWmCcTBQIQQ7kNvwHxuPx8&_nc_oc=AdoHFqoGlIOS-ZZcCSl8NoHThIeMB0ZSJeam33eMXvUHLa8-DNENhxyi5nbN4etxN2U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vQ7HfGK8oQBIkKW7AbOM0xxUsoo42eq6srHTyuGJ2TQ&oe=69FB523F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_7N5o1GDdoQ7kNvwE_PeuC&_nc_oc=Ado1Yt56HK2hYNvaG8p2TPP_lZ9pbd2ER88MaZjgOfaPBCtjr8Y13zsL846Xb3MQrZQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Eb72LBPvIHnjp3_o1_yu3tQ3MW7pjQkrP6vUsqpLMhg&oe=69FB3FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmQ4kLkLFt4Q7kNvwGbzhUy&_nc_oc=Adq4flsh0XC0YI7CIuVXucPBwtI9deAN6mYcOGzt3vxgSf5DyfdKvdUdPrf7R4Rm9Us&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af771tFIMupG-05BhVRx943SorfYmBNFj2GDAIWJ4vrcWA&oe=69FB445E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
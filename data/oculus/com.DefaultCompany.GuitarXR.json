_sid=6e7a0a&_nc_ohc=vMd28QJuFSYQ7kNvwG_Kfuy&_nc_oc=Adpt3-merMsERs05TKMeSE53D-7YznkSYLMRaYossuaYnEVDYdtn8omlNSqPP6UokaA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2XSZn0WNrurogli-t_7OdL3vXe6XYTNlVwDqobT24WQ&oe=6A258173"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bB3GXknlucQ7kNvwHO3ppD&_nc_oc=Adq0f2YkJOpBK8fn0y6VpYOtAtOO5OvhYSDYTzcNqbZSwuD5XXSHTwPfKjMA9Rgs190&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xk1RvsDtwkG1IdbiMRBphe9jsBJ-SQZS8mZ2sQelm0Q&oe=6A257426"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4weV6-282QQ7kNvwG_5NfR&_nc_oc=Adpx5j8LWuXIFqIrZWMyr--FiB1f3Ug7-_KAcpwKw2vdcR3HO0M1Apmu74PlS9KgYoY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R2vVO6eZ3bRe5iGYv3fdDtVrQTvQFDmCuaeaTKKEDjA&oe=6A25823F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFxjDAUH6EMQ7kNvwGGbbKs&_nc_oc=AdreLajlmVLcFQrtDUE__l3Qh7OckYQmUmXzNY9uijMPf_RcBA5Xis41pNyjdTGdlKI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Eaz55fz9bi4DYqLWSRpT9xsIAeof_UYa3oKetlTjbLA&oe=6A256FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qFfUO4dKI9kQ7kNvwFkVk8O&_nc_oc=AdraL_qf9Q6zMMxCcFzhCR5zgIFrO1VBWCJK--gfpUcWurVQ7QA8_5ZnJrGND6YpTBo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__Ba_0LTo03ywR1NaiT9_FCW3FHTI1PYyfRcV3mnlH6Q&oe=6A25745E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=s_ihILT6XDkQ7kNvwEiCRl5&_nc_oc=AdqrrjbjO1BrdcVVAW74Iui8sjOFv9Rl8T9zizFvE2derEtUl2F8bG0iPZ7ciSyilsw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNkeBUqzN3VMud20zRpXdpszkvqINGNMaWfGo9EwlYUJw&oe=6AE0B673"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVmoILdw8YUQ7kNvwHSB3xv&_nc_oc=Adp-lBKkdF1pqnrckcwo1HOzIsNTqHps7sV2wbswdUTsA3I-pDf6yFbU3ovso2kg0CY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORu1Fl4QLf5zVgrTIEhU2MhQxDhr4rd604Z0iXoKXh3A&oe=6AE0A926"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeLz87llZzQQ7kNvwGlmlPl&_nc_oc=AdrTeJ07LnXxHp29QPxVbvYxDTXaBtihXZQ3c8SJd66F-gnPDvd0ox_GCXmS20Aj5aE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPq47_Mi-PU_IwmS8VhPh1Y-LT3Jg1jaXj62dpEGJBP0g&oe=6AE0B73F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0KACH_bBpYQ7kNvwECCc45&_nc_oc=Ado9Ov9JKq8MplikmGjnWhGr-tjHFmnRRkoAD_-mhxTkfDfQK-NkiJ0WgkzAjJGcMac&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOQiwzGLY3-JSeLSN7GWNRUoAjLYYUukc1n-v9r7jPw9Q&oe=6AE0A4ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcPyokGD2oEQ7kNvwFEpIdq&_nc_oc=AdocaGW2suS-5fY5K0fsSpO1DfqPSC3vncKB3zEd6mRqj8tPAZV9e-vDGkZvSsOm0eo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRF4pCRtgTqauYW8Y1394YvBRXYaRb6mT9L3djyFyKHg&oe=6AE0A95E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
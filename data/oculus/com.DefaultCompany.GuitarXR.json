_sid=6e7a0a&_nc_ohc=0tckTTVR74IQ7kNvwHFD2qe&_nc_oc=Adrx175c7EHPU2irEwoyIoPyVMEOahpc7DDgi0LWeZmUQZkq_toa1Pd_4Oh2rtwqMSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAqVHjeHEM1uWy-zvWfXL-fqfnOR8F5xoQbqLlClBl1g&oe=6AE9F0F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h39sMNfxlSMQ7kNvwHYXFL1&_nc_oc=AdoplP6MU3Bl7P5M8Bm6SzWwX-uuYKpYAbP2ko0jFZikuFWwW_f3qxDXI_arNNKPS2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdkt4HpDW7ULZV3PXMQ6B8Uo0yop4IoMw95-v04JnvvA&oe=6AE9E3A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujb-pDw6xNUQ7kNvwGSBRMC&_nc_oc=Ado6IMYYoEFYfQ4AymjDxQ7ZqBGJGcrmoVEUGy0gh_7gto_V4pEU7oOd7dDuXHgHhqE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1z-V4RW89ZJ-xE0oqvxTBF9g5VJUd1bI4nnrkcD2KMA&oe=6AE9F1BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m3SQ4gfoxgQ7kNvwEbBgTX&_nc_oc=Adq-oh4OKO5Qi8VTxY589K3fg2yreWcLMEC8imJlpbri_UFO_1dZQqBIXz1DJgHjs7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlqrBFpSNytQamyO6xMLvXL9KRkXQcHCoewUDnPf9mQw&oe=6AE9DF6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urBFdtMnAw8Q7kNvwFt8yFm&_nc_oc=AdpWsadD0ZBNp94rhEq12ZRsTlf30j9CpUmfl-FP59n42P-ee-5PVqokJnDZVX4Uap4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDj_ky_nvm04K-8AKKSRn8U1KvGtxUTyRRHW2AbZY8Kg&oe=6AE9E3DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
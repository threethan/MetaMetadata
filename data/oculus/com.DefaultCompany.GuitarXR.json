_sid=6e7a0a&_nc_ohc=JrciiieGGkgQ7kNvwHTXubF&_nc_oc=AdpBZsWuwm5Q_8cdoznBMnQ1Ulrk8Qz6Hemks3ikrfJSkhazElqKVW-8xod7s3ibnYc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxiC7WmbTynDLK3JIfFjBVBr6_GbJNop3TXVJMeuzMiOA&oe=69C268B3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJOsuGKQ0e0Q7kNvwEEzUUP&_nc_oc=Adqb3WSudgC-c5Dk_fdJnBloH3yL3Yprl1l4wX2-dRMZ78lYthzBSw_OHHa3DvSZsG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGGoJcwHeaZfNrWd6uAEOJGd2hbDZECy2AwSUCFb1JpQ&oe=69C293A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQhlD0mo5AkQ7kNvwFjjnVU&_nc_oc=AdpmLawhAIs644G-GA8bVi1mo5ALQZVKzX-s_n_Du_70asGbFKdCmY0kXMYcwHPBvE8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxv6sTxQfpNc_fE9oA_BMuXWcAoO1xRWAPr0vUqJ70ang&oe=69C2697F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcDDxujGkhAQ7kNvwFME3UE&_nc_oc=Adp5Gj0oQ3ef2xxuwwlGJ6vt4k2nHMkha-7pjHUBe9Lyg7pFjiumUJiYetMMtdP_Xe4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxziBjp2dDy3zBRtPOBvnqk2jqNINLTpzOXI754QANnwg&oe=69C28F6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcrVD_oAegYQ7kNvwFYg8Uv&_nc_oc=AdqPirXvWMbg7uwR9wGSUlpDJQk3uCKf_aBq2UebqP8reiVjzrOC731MT-5_tm-LLn0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzejMx2-Sn2Sxvb-FQdwg5008CQByXU0sgf83klM7S7Xg&oe=69C293DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
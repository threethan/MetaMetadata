104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwTDXcW-RHAQ7kNvwHkNIcO&_nc_oc=Adr6YHEF6k5X2rOQTkFaaORZamN4o7xyYzoOL2E-0YfadXJOk-SwPmOQbRPHSpZGCgU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGehYCEQrLwCX0X6Zof4VacoE7Fd4Ykd3F5KiM617CiIg&oe=6A8D6FB3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTD2vPKRRAEQ7kNvwGcxwyk&_nc_oc=AdrH5wVm8vQOBwiaG1Ii9PupRkUjmoiyQpylK5RfH0WpESHeGa41JMBtWRs-nJvju4Q&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvg9QnenQD6v1apt5M1HqMaeRNaN0jzyddJbkSg4Fi2Q&oe=6A8D9AA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jj8gc6JEe3cQ7kNvwEnaP9d&_nc_oc=AdqmuzqNfDWsx6KOYvORLzP8hHsrJ_pFp-3Jrb5gUF_sHoXONbyc2j0jU5OJbYwo8CY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9tIQ2lLn8cJPXR3gmCnhHK762LatQ-F7XpZ3B0cOR5A&oe=6A8D707F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GlAaPIoWjV4Q7kNvwEoSBto&_nc_oc=Ado3MfEAHr4bxP2S_jZwne8t64eCshH-QJ-BNtaBo-VOM7a0Yuv9GYuldG85NikrsLc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEGQ7mRXSqwOb9fdG3onOTQtjzD7emKkjqftmmiUP-Aw&oe=6A8D966D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TrVdal7dJMQ7kNvwGCcDt4&_nc_oc=Adq_7u_Aw_J-sMHyiRhOwVMq0zonHwcxhGU-3okGtWeS_Y7FH4XjGOUdME5gdKXhVaw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqHGYqwZO_KY-cbmoyMBrO_9kFfghYu5UBOnbRx1vunA&oe=6A8D9ADE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area":
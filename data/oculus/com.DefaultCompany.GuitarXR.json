_sid=6e7a0a&_nc_ohc=dttYfg8WsSYQ7kNvwEcGWs7&_nc_oc=Adr8NZTL6t2VxbHKpz37BqonEHpoKSbrflRP0o4aioXRX4ltsx8RysW2HxchYKMSpg4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGIZ-Ggl9WvGb1pYVlseER2hzdlDiUF34RC2FeloxvjQ&oe=6A5B8EF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0jKu0DxJ0sQ7kNvwHOql1t&_nc_oc=Adqq46I0xRTaO5tAv2zalXZgu3PiN3qhF_7mu_HtUd-4hfd13cRONP26D8R2Qk99bJI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc7-qI4TyQLFNKbMC4dDmU2Fma8S54N1US5ucn7ikwsg&oe=6A5B81A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWxH7E1NhWkQ7kNvwHlWtmQ&_nc_oc=Adqqr3TXOwRlEoBrzO6jYGtMByjU_y2qcWWD3oiWwKse3zpX6WHMHKe4D-4vA3aqYz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBPUTkKlqYosmuJshknPF95Y8YnGJGeSBsHkog9xHL0w&oe=6A5B8FBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbMHd8CTnGYQ7kNvwFSvaSw&_nc_oc=AdqRwfNutUuJjODwfMDKLpY9I8q7LCxj9L9BXVs30Yv74Su6iagbeYDWe5fkHxh53QU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl2FjObAoeGwpvh6ddeoQTMYFLqTNNaAe0Vuyi8SeDHQ&oe=6A5B7D6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erCCfT5amKEQ7kNvwHj4nxu&_nc_oc=AdoB-H8vXAtvYXJLoIm0iR-MPKRYEakGkdm_uBApxB7jlUsUnE0JqLDkBuY3CGUL2-0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSJs8L-CgiplRWcHusALB3b-Ld7zarrOwqkjfnd-uMeQ&oe=6A5B81DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
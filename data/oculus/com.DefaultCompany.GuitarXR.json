_sid=6e7a0a&_nc_ohc=lUd5BNbAjMIQ7kNvwF4rPci&_nc_oc=Adq_s6EwTkoJXvHrp-u5QpjFwl72OqihOUBZ7sTjYE_CoS8hOO_QNHzmelOEzUwYvSk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4926Xd882saPrjxYUY-nWA-EQcA1lXxAMOgumA4tQtDg&oe=6A185273"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lOMjsGsngQQ7kNvwHI8y7k&_nc_oc=AdpPoOKo5zkDaJ_P15Bpdcd2gqwyfXR1F6TfoNxo1mQdSPAra_q8SkC9COD3Djvlttk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IG8fantlR4yiFZYXAfshDknWIr69w4RCOZRxXE-v3HA&oe=6A184526"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elaZ-Q5Ux5IQ7kNvwEmA6s3&_nc_oc=Adp3QNfXGl96j8FQHSEFPLzhfIAcJBeyu3NetBEwiHDpPZANwf_8gNwg4fRfPimXIac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4loN2udHmaGWBSK7R0U7A7Tz-QH7996w6aFg94rG9EsQ&oe=6A18533F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQomuqSSK-YQ7kNvwHoizAc&_nc_oc=AdoxzW9nt1oFnDxDfSAOg2VxY4yLLHhoNzyKPSfIvvZdci8AFWylyJjH9ByNeq3Smrg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7c4NceTEpm6kiuICVmR371Vf8p1h0M87SPd0GCmO0z8Q&oe=6A1840ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeJe-xItsBAQ7kNvwFHnIWv&_nc_oc=AdqRwnrpOu5X99S5TmvHneSkHnjdtfYxnNmzACYqRofu0oQ6jXkPqNnxQd32yzWZrGk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lK9xy1ovKBtj9AoXqR69mlnrzjGMpNXSW3064xC3HPw&oe=6A18455E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=BFT3Gqr2h5EQ7kNvwHEMWGN&_nc_oc=AdqluwdQUCstelLr7nhGZ0DGL0VI6uMd-qzPF6SsfX1fN0NnLG9hYTqCQ2Kf6oN_RWM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVYnoJqNlHyh0_cUv7JRurGO5QCOP48rl4yDGBfGE73Q&oe=6A986C33"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtLZ0msUlVoQ7kNvwHwYIs_&_nc_oc=AdriMkHFYY4Jh-foPu4CRho6I6ELL2W2ZNY2Y7poh98xWnQDikU4UUBtA2lyYBnKf1A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpCAlWyHC9NIzF7vjp5WvbsgZjxNBM5tB4qXXyLki5qg&oe=6A985EE6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fof1MULotLEQ7kNvwHr5kW5&_nc_oc=AdpiEu3zWgsBR3NZUDfuJ5qIfaIPURWCtLxmNTNzAsLV8cFuEv3Pph6vHO2eCYR-buA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZb2VWXDgsl9vwDLBI4EDvOaThv2qYxLW66_DlFP8E-Q&oe=6A9834BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1DUfpVG5-sQ7kNvwGadZmu&_nc_oc=AdqvHhhuC6jcWEWYCz_hpMSPRMmal0YO8Zr4aMk84HwmGUplLqO-_m8ewUw3P5fGb3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2qHBlSCvDDBcVs6_qQDZh3JI_Oc2Q-pljV_wU2zTuUA&oe=6A985AAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUevDnxuVtQQ7kNvwG2eg5Y&_nc_oc=AdqiyRDoWj1Ka2ROuYbvwuvRHyzrL7M6Bp7fDITXYjFk-eYdLZSAm7oyam5vyAJwYGE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIms-3LSJMCtqfbCxyVeF-tnbAnTX-QFbLLWf07Oe7ENQ&oe=6A985F1E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
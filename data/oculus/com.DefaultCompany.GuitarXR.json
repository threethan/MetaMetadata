_sid=6e7a0a&_nc_ohc=SJG7jqSlNNMQ7kNvwH5ctnn&_nc_oc=Adp6hviGLO4j41HhcqHRLVZSSIcw_AXZnuv4x8FxJgzDl-oiXJ5Yz4q0nsDjUbzJoWc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af39b4pMSqXpFf6bUPP06UUBBds-yvmsmCPlaZZH6H4GhA&oe=69DFA1F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jKXzOCRNMEkQ7kNvwGbHuBg&_nc_oc=AdoTPCk1WjfgPY9xDjzk0oO2Ev3YcJX28o_Jz6MBEAxESXirVxMi_BoxhD_jWR_JxCE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1dbjdCUGSgdaTeL0x57mfJ5UhfrzjVhgG1QFXu69mtdw&oe=69DF94A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YslAHZrRstsQ7kNvwHBvEcW&_nc_oc=AdotkRHMhbPmRHIT4Bf0KvFJHIhVnjqEN-4JDFS52iIxGFnSZtpXBCKVvNhyMB5iETE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eoTjrFVm6B-TNBstS2t2mWBRDxgZ8todmfHdA3whhog&oe=69DFA2BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SVf5c2dBXsQ7kNvwHdiqxs&_nc_oc=Adr2gdKwe2wjkFuHilx7_WVKa1LoxP5W3BQuzBxooErC5tw0i5i8m_ShKRDO29zEnwg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wk-MG0sN6tBFHZ1Fc16sMSiaiDmifcyvArfuIFHbW1g&oe=69DF906D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJJ7FUWtCyIQ7kNvwE8kvZz&_nc_oc=Ado9EqqqSXuPeqUnn4-lpyMFdB8NGbyTH7wqL8PMeDulmq0Xo6IBAJ47i4jRPj5pyqU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rPIE-0Va_fe-2LujGTpF1_8XfMHANjQrx--Hu3A7hwA&oe=69DF94DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
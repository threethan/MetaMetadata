_sid=6e7a0a&_nc_ohc=cpIPYiQEEIIQ7kNvwEaCzNs&_nc_oc=AdozAg4LUAFbC-zhgVsjkBOLGoYwYDpU_LDgsUKQfMHkReEnvaWiW6dFAj0jeWiTpw8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FosD131869o8M9wVhH2E-xQjEZLGaGjHSnPxnLpB8Qg&oe=69D90A73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meJ1KM3xilEQ7kNvwHUIsE3&_nc_oc=AdoVU65N2wJvBExrL3MJUlAWh2dXmN5z6KVwlSlxQZ576dkeZt7APlvcb45fi0fesj4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07wFxM6QJmHUmXzoJ5M6y73d2EKrK9s3HikkjJ3JsAPw&oe=69D8FD26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnf1RW4qeuIQ7kNvwHPTxYV&_nc_oc=Adp0K_z1MSC92mMQ3gpD_byKpLAvqG1PBxp-2PtLlZN-M1MZt1Wz3NBnUA01itguqdo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-3J9v7jxMV03l5rbz4V9aVI4WOJfS7FjGm7rhVDKoIg&oe=69D90B3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKcw55oJ2noQ7kNvwGlrLlc&_nc_oc=AdoyeXiLX73nF0T3GQ_l8x3IBjWh03jJugueLn13Wu6pqHepG48bb6fccjGkC4FW4gM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24xROI2spWtLvLow3KBZoZdPRz3Z1i_I8Nd1sq4-2p6A&oe=69D8F8ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1gagd-7gcQQ7kNvwFM_V8G&_nc_oc=AdrbBeUGQN4210NicC2HWV1xHy7pNqaLsGrqS0SWQRAtfYh5CGM42_tLB2jSUOuo1Jo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wZWwr1LZu5PQYqPUcdwGHhDEhjWxEmZrIkuoV7lyknw&oe=69D8FD5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
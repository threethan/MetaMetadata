_sid=6e7a0a&_nc_ohc=HMfTsbNisH8Q7kNvwFQpsk0&_nc_oc=Adr5NlLUN9ee-eskA93YbQ8DqKue_ufGgXfXzKS5aFnijMzQhPikIEfxXu3wiZzOWlY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiGgiYK5KTuaH3Nt9lhnW6v0miRP6LcVgKtAK2tAwR1w&oe=6A5E31F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0jKu0DxJ0sQ7kNvwH1rOof&_nc_oc=AdppTxZ8kIG8QAqU5ngJUszAHvNlTwloAXwIhltZzR6zNhyrAJrKXCLpzqC0IUW4y7Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPHsWJhAZqaXwLszosNu8by3U2zoy6wQzZNM_Um9UAgw&oe=6A5E24A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rfS_-GmkQy4Q7kNvwHyM7LA&_nc_oc=Adqp5oZA09Ofm9AoC_rqMwuR8uhqw5dfJSWSMI915zkVYZ037O7qiO7vRAeA3ncYx_E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXuziEzNxWLu1zDTFgvPVNxFNWq2gOTefAhb0oVwRIZg&oe=6A5E32BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXFwFd4SV1wQ7kNvwFf4HJ4&_nc_oc=AdorKYXsR9siOkw20ugRW1g3o3KnDjpiu_fcMVm7VdGSRMYE5nA9yP2Jre8TtrMcZYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaHnrpy3GFsRfASp9t7cKghKFIry6s_notF-6-8tsrMw&oe=6A5E206D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adFOm6bOLMcQ7kNvwEL6AiZ&_nc_oc=AdpDIHVtjp7S7l4Xzd8tLtLnNK37VdTRlRARyBm_en-SYFGE2qerW0I7S0ht_pbyAis&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZHiw8lwmtqnOxbm5iXOfaPzTh5eRMVSiM_2TdSh4rRw&oe=6A5E24DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
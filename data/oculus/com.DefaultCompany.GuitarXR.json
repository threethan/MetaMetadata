_sid=6e7a0a&_nc_ohc=x2cD-Q_2z2cQ7kNvwGOiP0r&_nc_oc=AdphScmGQjNj9c8Tu2oyT232I-7lNwTIR85avSN-aTxOLniTUX342U9hKrVLHNK49Rc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfylL1Zvq9YZ-RAK-hhC_g3i2Knmcrv28KaQ2gcgEYwiuQ&oe=69D12173"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeaSYZTuoksQ7kNvwECZr87&_nc_oc=AdoZZioDzc6N1_ul2Ofcr8n5Q_ql7FQ7Sh7JAStI-uEH6TDrns4IWtK8S6RE24iIBxA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzhI3XBbYJlMlyrlKFrn62xBD3B0uM1B-MVZ2LnXJlIxQ&oe=69D11426"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWSMSg0vJ3kQ7kNvwHhB7bA&_nc_oc=Adrf9tMKRrrv8lYFHevwUsQrtFDUFU9zbWKVaTQAGiqgkyrjhwk9QSjXXRP5YWjSzlU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyt03R8lBWYG67P0-_xvcD9EEbTtnSiaCtKYUZkm2C9oA&oe=69D1223F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqNtziu3IRQQ7kNvwFpLbUN&_nc_oc=Adp3eOZWhv3mIgUR36gOJKsQjqTtWQ5viqKk0ZxkqWP7yamg2IERM5zOZ-FsFr69tdo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8n4cy10PPLn50r8mMIlrn6JpG_MQvgKrEquK5-iIwyA&oe=69D10FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GenGXszicU4Q7kNvwExL4YM&_nc_oc=AdpvTsj_kINOGqW29KxHUDHhvQuN5fkhYmMu7CM2Evux8rxPFTp1952StGRvgof7j8c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_-zlCmH-5QjQeWYwZOv0YOZu5CuldzO8TGg2gIUwYcw&oe=69D1145E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
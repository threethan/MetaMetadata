_sid=6e7a0a&_nc_ohc=GKK9HA6hGZQQ7kNvwHb-5Ds&_nc_oc=AdpmjWzWFFOdSJg1aRG5mQJLX4PaAYyQX-sar6Bz9Cu33svcswyVHhJNdqIIN9mzUpo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-vmA2234bq16NEv4nJ03hkuKxgEXgIqonUuKTTwUXcA&oe=6AD0E473"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoKg2C75DYQQ7kNvwFqEhOM&_nc_oc=AdrW1BSKNZEBv0R2R1OoLZ_nbFh67OMEgGz9HyPte8LjpdHq93RU_4ZYdoyVd-Ep6FI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzKECE_GzLJqZwX9x3tCGb9B7TIvxuAQcsPTIK66E5Rg&oe=6AD0D726"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6XDESdvWs80Q7kNvwHGEltY&_nc_oc=AdppfBVYuNhOcgKRojMY50lQ4LbEuO_cvvMgxGx0jeXlTmIJG2T4rkCTs66-lGJvqnk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPM5Bmtr3IDkZolBR_lMuVjMUdhJPviq069YKBH0Vb_2A&oe=6AD0E53F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLnRWRUSR84Q7kNvwH9wUaO&_nc_oc=Adrgl7UxDpKBBjh07YGQZt8Ut0Ij9XbUj5HBZvUmwupcysBN3GbwxVXMQ3HoOA14nmg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlntKQNEXKGQpOF6wJHj2fb17EgWIMwRfx6oOA8icdrw&oe=6AD0D2ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miiGjbJq2DcQ7kNvwHd_esT&_nc_oc=AdqHG8sbRdZ4iwNezlgCYt4I3AZK0rX9ic6UPHfzQ_G335E4GHFkzgf05_uSyjv3dIY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLPkZtb4wZCr1O-CFZKw6yRwYZGLNEeDAXrS2SpC4OYg&oe=6AD0D75E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=BFT3Gqr2h5EQ7kNvwHo_HFs&_nc_oc=AdpL-hYpf8UJqfNeP5syR4aKyN7tmRILWP9vDSy6PXdv1iwcQGovxlnlrtcmZXl9sN0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_N9fQwu7NdvumOOukiOqBMCIPA-gddRdNiNV6ozuQbg&oe=6A971AB3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtLZ0msUlVoQ7kNvwHO4iN0&_nc_oc=Adrdv9m971ZEGYgzttCky1nhgAdBWs3cxZAlC_FjBzYtYrdyePrVp3s780sD-EI50do&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEW60uAYUstsAC3RlykTW7yOYLTHfVNf-hK8-WKUJxAqQ&oe=6A9745A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fof1MULotLEQ7kNvwEck350&_nc_oc=Adox0AZPT0ypjavm7LjYHXZzr1OyNlXf3HM8dcyESk9bQhtfbDjZmP-K54gMBxvLOyg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1Z90eWZlsrPgfLUAxDsFQX28aBHKQu4EVfk480S7Egg&oe=6A971B7F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1DUfpVG5-sQ7kNvwGZFYVz&_nc_oc=AdpYjvA_xrP4hoV89Jr9zi5qOVUAd31GK6xYld22V4-UJ8xSM5Han_SvCcoeCMEt6ag&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2XQv3QRBuoRbaLwChAm_bs7eV2xZKkHbdnN_t7nmHZg&oe=6A97416D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOUKLpJQggYQ7kNvwGI9c-a&_nc_oc=Adp32r5vJXZj8BeGFFtuRMiqKde8L78rmoL98lCpRJcoxtk6JNVaa3KRQOtLXbLHKwk&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGE93VlhaiyDkBA_igGon58Y-PRaOM49axAVONgiqqmvA&oe=6A9745DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
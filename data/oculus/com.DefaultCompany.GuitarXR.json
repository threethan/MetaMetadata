_sid=6e7a0a&_nc_ohc=n_2fhr3YxusQ7kNvwH0ibkw&_nc_oc=AdquiL8MePRaWATtbNREUnAAy86tiJRncbcei0RijZoxZH_821_SUkBRY8h7XljbuQQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtx3jFriJKZsFAhmb2PDcH9rafCGlMscETTMVj0ER7dg&oe=6AAD4BF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7x2djiNgYkcQ7kNvwEI770b&_nc_oc=AdqJGKKvl1E5l2twudGOj4z2kwdVNsXToUblynCQp3FN2U0xaZcsGpm5gycIPULx0w8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3sT3_UXtgIeCIuyEmTW7t9M1d9qUI0ZI1MDrxnO3NgQ&oe=6AAD3EA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFjmi0SZ0p4Q7kNvwHWY__X&_nc_oc=AdqK52GrcsQSzcVg6uyfQi_EnZuwaE3bZkzKNoB0aGqGRrOXYeEUWKYWrOTHM-K-NrY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvmE2BIZvFTuit1mSbR7U5UfPGIJlTuyOq7L0vUcRZCA&oe=6AAD4CBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owSxZnQ35o4Q7kNvwFocEWl&_nc_oc=AdrspNeTsEkrio4EudQeOYDYLoA-Y2iBicf40vRceDrnIKJaJfDFZtet7shs7ssWZ3o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLRX-yYQ8iTgblUvM_jHMKAICWNMAafG_Tiz-Vxtt1Xg&oe=6AAD3A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNyPvu6as9wQ7kNvwErzAF2&_nc_oc=AdpGeRkGxQEZwSK7aH7YQewWrQlzxjptTmfe87Y7X4AS0KS6X10TxQW2Kqlr-TYKjDA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGxjf89S7lXShPQfxExxDtEHu5XkDDACNb1P-CH0ISww&oe=6AAD3EDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
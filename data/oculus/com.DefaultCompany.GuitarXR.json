_sid=6e7a0a&_nc_ohc=EePx6wS_H2cQ7kNvwHERoD4&_nc_oc=AdoRvJSbbxWV0X1TQTBEbdodXkELxXzqx1lfTi7FHLXX7BJnltCahgnXIC6fByQrLxo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDPgvvIDVie0ybBFXQ61T41CpqVuKaw7u1FI_CdRZXPnw&oe=6A6B60F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkxpFmUhyHUQ7kNvwFKmn-2&_nc_oc=AdrPd1hGHsnwjqHsvaw3mXnUy2o8ut0Sdq4g0FblqRJlxi46k08OkJNfXds00ODALao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5d6aS2dxj2PJ26n3OJ5BSkQSw74YOslGCCi3ZHCn6CQ&oe=6A6B53A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgjeEq-jdlIQ7kNvwF-0D3Q&_nc_oc=Adpq48rQvuIqL11wH_M0fkGA4Duf29u_4aPApLygvVsmpT8Aov4U5P5kPQn35Ziot44&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbojQgri7QWsFFoHc5Ca8mruc38yoOmXK3T2Z34z6t3g&oe=6A6B61BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9B1_vXBSjDgQ7kNvwFeE909&_nc_oc=AdpFkxbeOwQ7nDb6tQp781sQn85I_UCeHRCyDGkJqlWcQnvTlC3TfbJP-CdcT6SKl6Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8zMt0sIU0tpVQALZalVcqA8giUT899FlTPtIQJKlMAA&oe=6A6B4F6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoABidNCJuAQ7kNvwFEEPbk&_nc_oc=AdrpkDSY2HLB6S8KdpOXcYitB_9IXZxLEtNWnzI7x0i7Tv-aLbwHdbB0SnBosCWwYRU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSm0bbicIHESoHvm8p4IEe7DiVBO4G6HEoi_BejgXEzQ&oe=6A6B53DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
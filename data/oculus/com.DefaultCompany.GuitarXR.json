_sid=6e7a0a&_nc_ohc=WhWLEhUYoacQ7kNvwGmmyrC&_nc_oc=Adp1kz0_gI_mvXt8zf4luAXeSSr2yxBiX8ITKeFAlDdDUqoUx6NQ45B58A8XcUkUGbw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExTDKQf8T4-WfQSU1SDxJNFqfKZYKBt0bU02gMZtk51g&oe=6A940733"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Z39nAhExWoQ7kNvwHLgiy8&_nc_oc=Adp5F-P67L74Ydju35ZWjTAU3YMIXWVA3iLBfY05nVt_llfyb9ALGnwdkeW96sAwvGM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSBhgkOYgo8wt7KPk8z1ydusxpVC9miupKXMDk7ak7nA&oe=6A943226"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGC61mOUT1kQ7kNvwGqck5z&_nc_oc=AdozlXvprEPWbATyCGQU2KIR2RvXjSPlNjCShI3WcSw6H3IW26qzYckyJD9KR1iJeNg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqj8xeH6VDJEYVtbZeTsbNFCT7ihqtnx77HNN6iMD2XA&oe=6A9407FF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEPWphcvhHAQ7kNvwGy3zJ4&_nc_oc=AdpzSbVScBOmy6ipW6m-rtDQiHupNaB183gpum9Sed-GPuM1cPg28mtkTosb-8F7JUQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2knyMyGJSnVTJ47BcGx_0Pr865fwZaB8Vk9Xa7KUuyw&oe=6A942DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uOUKLpJQggYQ7kNvwFqLSux&_nc_oc=AdqYy_bjM4jQgIfhUYIbcNwJW1YyCbyeixTCx-dbPtlfUEUU08P1q4xP3oFjr1ypMek&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJnXcSVQM3GL009yt_CGbplpWzMslIUCRZ7qXTV5N47A&oe=6A94325E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
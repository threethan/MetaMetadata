_sid=6e7a0a&_nc_ohc=jmsQtuStRwEQ7kNvwG7WfDu&_nc_oc=AdoPDdSDgb18-t7_ZkjT9jvpPytzdJYC0GABFofgK7kbZxcWEc3OxWQNIAq2WPaI_yg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qiuqeJOv-MeHfUdjV-avLYwBshxeYIBMhSqg3aHRN8w&oe=6A1AF573"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lOMjsGsngQQ7kNvwFGFIw4&_nc_oc=AdowSeQRMi8xsG8F0izGdweDB9LyXqPkyAQYBESwabs5O7mcvuXDXX3dhGCK_WTXLMI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-LdWu1gwsHT0IkVWE-4PGpXJHFhH06O5SNEnOZxcc6Q&oe=6A1AE826"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHsqzVRf5KIQ7kNvwGTPCqf&_nc_oc=AdrijxYfkPBBPklygP4IBvaIKAF4jWlNprOQJSQvyIG7jP5-LLFq5NNPABYaSFvcGMk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nKE6gSz89I9M9egnan74cTsnJhESOyZcjn0-fMCLsxA&oe=6A1AF63F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDURBI6jZrsQ7kNvwGQbkjU&_nc_oc=AdrUtBa3G3xclHqOCXOM_8X5x9tvPBfXSK9Txi4Jhz0FbF1XFcf4nSgPD-tlMu3R55Y&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55GlwtFi52JWCz2Rwf4zrZ0SLM7aG6ScFeJXF6V_4iIg&oe=6A1AE3ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwHDlDBTOF0Q7kNvwEKdKiD&_nc_oc=AdqGEfaDLL2Mr4RMSWklX73dQsNrmJGn2u3QbCP_sT8Yrb2Wg0z07m3XyaRR_VS8h8Y&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4epb7HM_7c7IU6Yt5-dImQCu-l2nT1K9Ku7gF3IxGxtA&oe=6A1AE85E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=x66_2gudQi0Q7kNvwExKu-d&_nc_oc=AdpM3-B-pr6qKopsW_a8JEpwh6YHFlrbL6kJGQe4ZdakDgaz2o46uwWwWykvwDYshVk&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1fOp0IHuXGBIK2YA6D3q2DEmH-gc-gtKNXkC25uDiyGw&oe=69F60B73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi7xpFwvTl0Q7kNvwEJItPc&_nc_oc=Adr5NWXCjS6oWQWhDf3hESeja4H6pgUwoFPlJr4BA5GYAprT0QwGOhEW8Cbl6Gl0ISg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af10lEHDtyatWhvsv4Y6FnwADj3pNYNeD1tCqzKBszii7w&oe=69F5FE26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM7-HDnhgYkQ7kNvwGnIQ1S&_nc_oc=Adrr7ar-R39pF4ZmOBcjs3LrKci21pQ2wxVjcpq_AbgtcxZgzbj-IUXHNby_qlyfJyc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2zRItD_w3Z5KMQcVm14ndJ_RMj2dLWZIhaMzmwW2Utkg&oe=69F60C3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sSjtW13VIYQ7kNvwF27crZ&_nc_oc=Adqn33iug6OgJKmsWfSjT8wEJirp6v_JnKYgoMx_z_UzzeqyeNOWJMTQYGp6gXbehZ8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0lpy88ZGouqxycF8R4CvQGowILu4vg9KPNBjyJtHhrfA&oe=69F5F9ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dovw-wkqlNcQ7kNvwGQHiy7&_nc_oc=AdrL_7a9lgYoAWUyimEKtNBjMskNGDoqASIFlQh11xVnmTNHSZMDY8J8aQAfHT2JeFc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0IB49XKK5TNSF6Z2p_NVqDEXpWVftOCHcP0pSenlAKxQ&oe=69F5FE5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
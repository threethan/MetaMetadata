_sid=6e7a0a&_nc_ohc=GKsgwcXkdIwQ7kNvwHwSWXI&_nc_oc=Adpu-SdGBDJuQdgNMNui3CiKCdQd1MzP8UfUj1v2AsORealBa3j72sl50GFSgUZMVDw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQByps3V9FJHfNxJNmdTD0xIVlnsTPG8IS45P3QgvfdGqQ&oe=6A6F5573"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwsPlhg3xJEQ7kNvwGml7ck&_nc_oc=AdqdfP0N-oLIGM2tkIl51iG2KNyMY2r3Lm_gnX2jhEKs0mV9hM6QbFuaq0wGTLpUEtU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1Qw5m6KsmX96cqs3detG6XoN2W_XWKUNSZHCfxJPGrA&oe=6A6F4826"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tp-9WpXjY4YQ7kNvwFfVyVj&_nc_oc=AdoUWZH1Jgrs1ewZnU0JNdh4SXzEiWQcg3wfUpYGa-sf4egclJbtybtQ7Nkux__AtgU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4kIpXwYgyuYgmciWVdRNmdINDqndg8hB5aI8zV7MTTw&oe=6A6F563F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTbeDxecYasQ7kNvwE39fsN&_nc_oc=Adoc8-7g6a2l4XPQUxf5eQ2gVXQce2U7rsIft5QKIgS0ZkDMZ8Bg7VEOz8ewb8Yk7jU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDyUdJtA1Mtuh6NEi1tnSJO0LqZvEAsKLiVNFi9_sZRvg&oe=6A6F43ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRYKvhK7StUQ7kNvwG1AIta&_nc_oc=Adr3MrZRmWQ_Q6i6BSTsSOvj2NboD0quzsg3ahvF6DpFrt2xE7uFrqDJNUwBZ9VVHY0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC0F31qkc57ZQkuUlMISc0wAuGbv5tT7TCBiGBlCZfMbg&oe=6A6F485E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
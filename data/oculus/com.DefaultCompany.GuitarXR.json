_sid=6e7a0a&_nc_ohc=N7JGJKrNB0IQ7kNvwFY-j_I&_nc_oc=AdrEyWiZv9SoDKaSVW4d_mqSPhVtGWY55JAER2TgeTEn9rTTvH5I3o51rcPRLTnjXIg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOz3wRJ9naQBlZh_Evlj7XliaOZ4QGu298FzRWBefgFDQ&oe=6AE5FC73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uvdp3REEjIIQ7kNvwGvLjCZ&_nc_oc=AdqLD3XJFTjYcRNjavwD9fJ6NL--jMSi-nF-GAOJs1kn4Nh_bvh1NE9ia-y1-zdFUbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZsFK81D6XiY4E1ISnz-QIPUEnEdPcD9X-wE1hO-Mbpw&oe=6AE5EF26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENufpooyKsYQ7kNvwFNl9lz&_nc_oc=Adp-CE5Xxuh8vKmf-EgG176WRwRyIdfzpN1GMdIC-HSVEFJc2Z8BXfhCnFbWGkN7qN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnzom8m3dUe-RKDxrUfnInjg5DnI31cyZVBYRJSJO_Ew&oe=6AE5FD3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bPa2B_1T3wQ7kNvwFIg-Yr&_nc_oc=AdrOJc6ZdkbcniJwP6IIC9eA8d3EXtLy73Ngz2xHoHCgmnq3kfXozKTqj7i2WTODa-I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXZ_vxolt5kswGgQMcPU0A6xwmblG2itCjae4cMuitdQ&oe=6AE5EAED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U97ZJCafUdIQ7kNvwEem5Yo&_nc_oc=AdqjuazJmdsa1NN98hU6EZMrCNsiCGHtO1WPsytaEeRTAotC20QRNPQ91xOfxbTEsgA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaadVlD3dKeleBC2FjElPK_UZp0P06i3rwc0xrKvxmvw&oe=6AE5EF5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
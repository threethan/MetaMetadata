_sid=6e7a0a&_nc_ohc=qk8fouV7QosQ7kNvwEcdaRs&_nc_oc=AdrqHE3-GBh8L65jnNYfzdnVKKiOGTB0HThk84yi1q9VI1Ytqm1YUzU4Q_hqXK8akpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTtGOkAce-77C3P3lrP5fC80bL1xI-N6665OJ9wncI6w&oe=6A7EEF33"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO7eWxsLFNQQ7kNvwFtG5Pr&_nc_oc=AdrLSLUb4LMhaThsgZMOmnzEupR86viGiCdxehGHpP8NP4q_ps75zx-CV2wA7-707ag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXdAarhQCwuJPyaDuzusDKhUXXL2j4LT7nUPt2bdW6lA&oe=6A7F1A26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfaHNfAwOhAQ7kNvwFEgvuV&_nc_oc=Adp7zPw6L4kkTgKpZrn_r9tixZY7bZGPUyJekdreiSWKa5sZnXjGKuDLkJ8PmNJRWrA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuYi82eNO2R3EEoXyd81kVvGdbexpl8Hl_D9iz6xLFtQ&oe=6A7EEFFF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZZ3hxLcc0sQ7kNvwGbnZqY&_nc_oc=AdpGa4gaSPNMlakVqiv4f-YdOsEor0EmUPnW2qCkZGYAW5cBiirumdix05m_AD3nW8M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrz8oEl2r06SXzfBTRCbtk4sVOZnNBh6SIHXTXS4HrXQ&oe=6A7F15ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj45Dwy0cpUQ7kNvwFb-iSL&_nc_oc=AdoloDWpBXTAbqTzIvMlWvcpwB4P95WEKovVH9CXD9R9cFqk2OZUEqgI0fdBr91oE_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5w_KewWHvCAa1FYQ1A1pEB8zFL9T44Rt8aaHo70k_Mw&oe=6A7F1A5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
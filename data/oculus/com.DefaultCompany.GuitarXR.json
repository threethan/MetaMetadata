_sid=6e7a0a&_nc_ohc=QU6lttGG0sYQ7kNvwFjtO1h&_nc_oc=Adq-Inm5JBGPWMyf7D03FtacoGj7o7QstmwkDm83DsckunEqN8D34lYhrfTaSpzr_bc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmzApIj_R4Ltko57sV08Pc3PG0Q2e-FaxtvweKWJPTog&oe=6AF8A9B3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxu0CqJYx5sQ7kNvwHSgrKh&_nc_oc=AdopKZZwfSMuPQPCH6IJnm7TLOrvfNrRzrwlDqkIhib6B0hjpxNp-m2X8pcuvcUeC3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCCHk3dAVSbqtmsXcQPuSSONV8W-_HQshWoe6wGrDYEw&oe=6AF89C66"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gSRaYT0IDcUQ7kNvwGHYPnx&_nc_oc=AdoRbHJXoxuq_hUzrtLQZ2TW5mrWamVeDw12_C1OPHxWTjgFh3h2MlEGHgkE6XSa07E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmudzip58jntO0V61fF2OyXhKfq7l1d3aG2Z_zENb1hA&oe=6AF8AA7F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9f7K4E4UqfUQ7kNvwGRtZwV&_nc_oc=AdrR4smIHD9zJ3IdfEp-8kZ6YR0JmBWShajCrLELfXgKnh-UGdblWkEEl-01tbP5l7g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkW-O_gavKCovlifSe51dfIeUX8rTJq2hEoZ0TDqV9Dw&oe=6AF8982D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLUrmCut0ZYQ7kNvwFXdbgZ&_nc_oc=Adr5qy1I5uRUJmgDxL1HtbgtOUhh24-djALHuV-UVTplJnQuJOr-aStKl3-oSmif5sM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ64zKfVXVL08pmZGVJfTCMULKnqJP7aGuNOUFwjPH4Cw&oe=6AF89C9E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=-jhzQ8R1vHwQ7kNvwHqQR6T&_nc_oc=Adrqk8JwIhNo5-1QkDBLlzjKloJrRoKR7y-ECaZml44E_48gLIE3coZshc0YacRT0CU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiFgG1ztLFkExd5pwuc-eocliEXPeKpC6Zz116a2wOng&oe=6AF08873"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbcL--Y1FUcQ7kNvwFn1nwJ&_nc_oc=Adqf2Nc9_DeYlEJ4Gc4gQiM_PcwAsjL6lE1wHrevio8xHW4ngC9ajh8SJ9-OyiAtxSA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZ5eAauUZjAUKSPchXmzue_fzVq0tOmJfQvWfuIFbPag&oe=6AF0B366"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDRXYEaquVwQ7kNvwGl2Jar&_nc_oc=Adr73qWzgbU8c_cUXxPviLcX2b1P-NFpI_VOD9cTgHb8-bVqWdJ2-UXFN4JpDJp3p8U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrJFve2GjA4h27noZI5Ncx7acvikgpyenmwpiZl7-Q-w&oe=6AF0893F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQ-FjyTZBlkQ7kNvwFH1rDL&_nc_oc=AdohFzsJwIjFjtaPmGe_7g5zcYylVQ5gkelYj2O5-xsMp9KcSmlrBUXQalySfX4cr9k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnQchMbcssMYZqMFHWMfxzP_axp6Zj8GmFr34n2IQ5TQ&oe=6AF0AF2D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpawMl92xrIQ7kNvwGxOsMK&_nc_oc=AdoklHA9HfnahmWQ5M4w0hLnpi-QxMBz5KIx5aW_ncpN8fmipvJhv5JyrsA8f4Bu1iQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaU9H1mBSmx6hTrqAAPIlNQ8_4iNRcEBdoRyQGUEW8qw&oe=6AF0B39E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
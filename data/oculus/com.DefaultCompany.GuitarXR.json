_sid=6e7a0a&_nc_ohc=N7JGJKrNB0IQ7kNvwG5R_rB&_nc_oc=AdobTWfLJxT2WBDUiss2j5sjY_yo9BbadorhDGp0LrEIIPvFfmsa1-q5no5pyqxNevI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqAGMV-RVODGGcZkSA_vQnKiYeUa7Bolnm_CWHaROJiQ&oe=6AE74DF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uvdp3REEjIIQ7kNvwEVJ2TX&_nc_oc=AdoUKfTyCrIS-xAK007TOEYz1e0rQiyRMOZMRXV7mB2FYZaLl6Z9ILC5S62rNoSBxTU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSshU5oI20wqzpAjltdwF8TVfJ0XmjHY8Xc901FlAS29w&oe=6AE740A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ENufpooyKsYQ7kNvwHMCUvy&_nc_oc=AdooLbNNvkAjbUgYsK6AAScOnd3mLE9vJaO1VXenpmjTIQtBgBum-DR62htrUzIsa2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-zx4VNmdHhrutF9qG1XZpF-I4izvp5yvwgu6VCqoNJw&oe=6AE74EBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3bPa2B_1T3wQ7kNvwEYTmtK&_nc_oc=AdpKiORuRkAoZjUVZSJv81RS1mq19Ju8XJ-WAUZjurkhAU7bQ_4xoSwBgboEfpRBjTU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo8kiWYNPPyAeGRorkxbaaz5c5Djv-ChgmE3Gzii5q8Q&oe=6AE73C6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urBFdtMnAw8Q7kNvwEQfnTs&_nc_oc=AdqAzfOQrwYJdMm7N9BWVuA-hcQQyQ3joBJcjxv8s41954R4v4Z9pbfhI428ujbgr5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTahbAilja8r4d-XGX8Zyf5qLP9RJ0fVZolgVfXUoSLHg&oe=6AE740DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
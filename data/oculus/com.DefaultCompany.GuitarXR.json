_sid=6e7a0a&_nc_ohc=BMY3uNlTjPQQ7kNvwF6102k&_nc_oc=AdqmtoOwfgJNFveeTop9AG2IJsY4Mi3h-m6HebaYGgsB6THGJdyod2n8PEhYbOR1B6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0XTsLYl0rDz5RM9pRXnOyLWLERcNYo0_BGFwP5cL9oJg&oe=69DBAD73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meJ1KM3xilEQ7kNvwHvbNY_&_nc_oc=Adpo_cTBUbNJNkaca5bet4krd7gMzUYJJL0l2cfB_LAGgRAbGxCRmdcP49DlUbSGnIE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kc-PII3bTOQ3b4_dMtFrUqkzQsu8VHB_5CN09uL1vbQ&oe=69DBA026"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fb_To9CLfWoQ7kNvwHTzii8&_nc_oc=AdqUA8mj7LdoSGL7dTBthYqKodKDZgo99ipoogIVF54LC8y2hq2NnNMInZ-4jah0tBg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MK_t15Z020-wD0hoYJiloP-Hmug3M8ZPWQCySPp9ENw&oe=69DBAE3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=liNjmeR88jYQ7kNvwEPvGJz&_nc_oc=AdqvRMBLLEK_7xAUglOHVbVCMBVM9CRgJ8fdFPG52_9PslCH_76dDYNJAuvtYwFLIAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RxkdBVlHe6tJmLeNDplporHLbKFx2S6HbBYSjJC6udQ&oe=69DB9BED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaYmavMoiJMQ7kNvwEAO2lx&_nc_oc=AdpcaesqYWK9q6VA9vwt-QMUY65r8glBvXBWHHrl5YHpb1QA0zdHVJJvFrt0w-AozSU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33Cr5wPgm2dj-9hgkPWIUKRfQSXH5d_3jmKmKjiPl2Lw&oe=69DBA05E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
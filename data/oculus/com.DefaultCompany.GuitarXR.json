_sid=6e7a0a&_nc_ohc=ua5zc8RPH6MQ7kNvwGeKxjc&_nc_oc=AdqcYoEgbJTkRtuquinyrShsIHDBLKKz7iYNeddbo2BR_XRuPd7DV-DXaVSD2rnnlm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6i19eJZOMpM9-Rc-bcYLf5RcF4lbB0zKGxdeZO9gAHgA&oe=6A145DF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRAhJunMbHoQ7kNvwFGzAwi&_nc_oc=Adofyt9v8NMsdPB43IwAW-3mXUdmVUIWtlSrhmxNb07RfXH01GYXv3faMQnXaWaUouQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Fw1o1EYfK92uPLSXYt0dFIG2xPXE7YrN5hj052fNm2g&oe=6A1450A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uK3EEBCnDs4Q7kNvwFC3pVB&_nc_oc=Adr56dyJEbZXcmkw38DvWD_d0DP11a-n27lEphqx2sI79T-3Dl9_KZUW0E612kF1Uzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55sTquEhxhj-k1_BGcX3o4AN7-74gxowa0tZ4KywBQCA&oe=6A145EBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckdOazuhHvoQ7kNvwE74hId&_nc_oc=AdrNvFYxj8igXunIEJWX9it2X9RqPkbuGAW_Hyah5XIXyGB4IeEWv80vq6pq0pK2zVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pLuByqx8CjZU5VO0U2gGKvCRMytOMwSscJYhgsKm49Q&oe=6A144C6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zniq1BQGQUgQ7kNvwHEwV5_&_nc_oc=AdrU6YuIuO5es_qy0j79GfKfzbOb9U4kcrGqNpK2KC0TafymHHVXqbXdELJn1_HSXyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N2WKAlDC9GiyBWmyLpNN5FDtA5wDtQzOXKqFoqSBA1Q&oe=6A1450DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=_VxlqyC4NvwQ7kNvwF27uWI&_nc_oc=AdqtoszHhWez2NQXac7UkdurDE4vOqsROMrxVBkLv32o3abAppA3Jb7UjoroTX--03A&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jLCU0jzPQntsbdq7V-jI7NHPrkJz_yEvl6iteJaPc7w&oe=69EF73F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BLLmBzps34Q7kNvwGAHXvQ&_nc_oc=Adq0qkr08jpioZQPL_aZWfPa_ldUozL2G0RLS_lv3oZA3mk_4iZu6-oIi8pq6Q0UmmQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3msqY65_MVFmdTR4hDtnqMsJ1Asg2wJkQUQ3Ee__ZrlQ&oe=69EF66A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWnh_QPt1YAQ7kNvwFtN1iw&_nc_oc=Adq0zIzouTlIw-nbwyI06ioGyf-eLkniuSiG0_7ssLArDfWF8hc8FFt6NOvU1W-SF3Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3myxSwVZFajb-rDFBmj2cCVkH5K3qcG3rdmscRLdYXbg&oe=69EF74BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=csHH1pmyWRcQ7kNvwE70DhD&_nc_oc=AdpKV17dWoLHhhhNubcIiznzjpGlA0jgnoSlMZirKBXlvIXLKqvHiRdZJIv0aANT3Jw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-zjCaX9eMGpHeQGHsJHs9CtWr3aoKzfSdyqh1ch4tZg&oe=69EF626D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtO7LsXKKbYQ7kNvwGzikBD&_nc_oc=Adpr8GfGHnfiHaDGx5CEmWnYjfy8aeR7mHjeulrXN0b5lp-8ZgX4AnzO_cLHl-ybDvE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3j4GDwXirO4tz7nzMss9CWIfVSmt7eTscyMk9p6dNshw&oe=69EF66DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
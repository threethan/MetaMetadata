/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uK3EEBCnDs4Q7kNvwFC3pVB&_nc_oc=Adr56dyJEbZXcmkw38DvWD_d0DP11a-n27lEphqx2sI79T-3Dl9_KZUW0E612kF1Uzs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af55sTquEhxhj-k1_BGcX3o4AN7-74gxowa0tZ4KywBQCA&oe=6A145EBF"}, {"file_name": "Untitled design-65.png", "id": "1931969893889271", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982469_1931969897222604_8530448425778764889_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6WvEKyD8dIQ7kNvwGhr2ZC&_nc_oc=AdrxTzTUilcx0TnvUQuyxe5U_xDkAu1c81Q2lfp5Y-GQ6EmjbQZrEV2mI1viaOZb5jU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hP1K4ZQz-fvh5YQ0ZT02K7701i6P5nhBIizgrxwfJ_w&oe=6A146083"}, {"file_name": "Scales to any size guitar-3.png", "id": "222599974216860", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/65228806_222599977550193_1783402009710633868_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytM1T6ilZwkQ7kNvwEvhD8U&_nc_oc=AdpMGsUGvh6ggxopPceDvE_iGl8XCLoNWfj4XVM_2ikESOPup2zEgt0tyQ8lrhvAvDI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mOc0bbILxqWHggz_jbkgXMtRN8nG0S07sUHPkykl3Uw&oe=6A1443FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zniq1BQGQUgQ7kNvwHEwV5_&_nc_oc=AdrU6YuIuO5es_qy0j79GfKfzbOb9U4kcrGqNpK2KC0TafymHHVXqbXdELJn1_HSXyI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N2WKAlDC9GiyBWmyLpNN5FDtA5wDtQzOXKqFoqSBA1Q&oe=6A1450DE"}, "display_name": "GuitarXR", "keywords": [], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Oculus Quest 2, Quest Pro, and Quest 3. Discover the art of guitar playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar!\n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to mastering the guitar in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else out there. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7203991549657867"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes"
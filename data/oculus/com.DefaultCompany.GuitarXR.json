_sid=6e7a0a&_nc_ohc=dmLpm6AlKsEQ7kNvwHwChtn&_nc_oc=AdqTZg9ZK_XK_DmEw7zMl6YDexI5sYfZvR15JAJRI_7NEqi3aW7v5i5988dCv5y5zFI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVEkUxBD_JX6bgl-eNI0h_tG1OytsZCv44vLoQcGhmNg&oe=69C3F273"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJOsuGKQ0e0Q7kNvwHl8rVh&_nc_oc=AdrhFqtvdvWRm7cG0ak4MHxOXbH0MPsvieiBSRlkexnu5okY2OCYXWmprm693NNqLUE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygcTVQTFIZa8c-SvW_jr2bBnN9x2PO_IvB02zwAmjUTw&oe=69C3E526"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4peN39_CWoQ7kNvwGsjkMX&_nc_oc=AdqGBbdmYlprRCsHCwRQpYVUZxj7bZHdriIUjLs-5pYNNdjK5lARWa9qQsTP3zdbnBI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfygBh36k2wlQdw5APkguJ_7AVlHkhYzx2bYb2f5wZCUUg&oe=69C3F33F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_RyPDXUs4wQ7kNvwENo2Ko&_nc_oc=Adp_uTsZPCijwwyv2LJ6Su46VZxObUUMThEZe21jj4mD40lXVL7RBVO5oHRkpEMJ0fU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHsgZmKmEsDaKrAoOVPQxHJG4Omzuy20WlSSnY5o2SIg&oe=69C3E0ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcrVD_oAegYQ7kNvwGn2Qek&_nc_oc=Adot_V12ZgyOvwVDAfGygzFMhsOcrPVMvFFws0V2Y1_fvTj35Upqw2B5zlHC-Dqaj10&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyezOWe40yuHhXW5J0ZIgl3pQKsSohsta0CEynVafzwLg&oe=69C3E55E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
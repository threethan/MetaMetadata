_sid=6e7a0a&_nc_ohc=4FL84PF8P4gQ7kNvwG14JEC&_nc_oc=Adon-59tUkzrV3oH2v0pd92QZ3ZyjcGpJ97h9eZ00TDLY3qco2lSIv1LY9VexPlMGd8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8XkFk9p0OeYD3ghJpoci8QBLeBELsA7dE4CPZzYko8A&oe=6AF5CE73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxu0CqJYx5sQ7kNvwHH_KEi&_nc_oc=Adq830B8Zei-gS1lF6GJ-k8hhGtqWTx7IauupC1uvLxnI0A4HPaJvsXNu8XM7V1XMMU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwT7_ROMK2_5XJ-_w-x1fF60HquWAJt3sNscqzt4lEfQ&oe=6AF5C126"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T8nHVBbaauIQ7kNvwG18Qq6&_nc_oc=AdokQgqKggcAE-Ah6-qH-YfXX963FIGfxNn3kEWVgAzcZDdveoWC9k6-IegCtvh1D1c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRii84NKdBxaesRSXaYqaPpz0h5oAIAVP_U0LGFYqJTyw&oe=6AF5CF3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7uwehzTEB3kQ7kNvwHAgAFk&_nc_oc=AdqyZoMU1JvifPiblblaJTqLja0l3uRXAMSMPsT8mY9tcLGU9KKuZtafusuNjbdn0fk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMLY93KYMRjxeLf-KmegRw8O0i4Sp5SimcMOcAahwbYA&oe=6AF5F52D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CCq8mnToxZEQ7kNvwGmxV50&_nc_oc=Adpk65i7IoYIZTUYmycmY7cD2gzmilhytaeSjMRCn58Veg6njZj6cWT_81YOsjtcMHI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqULQbqBvx3XFvTkrnfgH9roQ4KUpAOvWROp8UyiHMYw&oe=6AF5C15E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
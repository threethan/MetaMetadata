_sid=6e7a0a&_nc_ohc=Juz3UqfcCU8Q7kNvwFFn3Yn&_nc_oc=AdqesoG9CN-a9hOHzFIBmP8wPFnmbt2AyS1juMTWmliyqNamIdfytMr5UHFZa05E568&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04KUyFN3ItqmGd_VftCJUpMRjqN6g7X14Fya5bUFxCWQ&oe=69D3C473"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeaSYZTuoksQ7kNvwG6-N-S&_nc_oc=AdoHWWbxPTjarf0v_kQQd1wE6RUOIwmXCaW0rNWxtINkyEIh6gVvH2HQmE46_V54PoU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NB_Nbb682J6QLYAZCr3bF7I0pcPhT1mN3fzz72huK8w&oe=69D3B726"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_EnmlBjc5I0Q7kNvwEucjkO&_nc_oc=Adr11A7NBdqyLWC4p24LkwXN0e57Z1PeApk0bxTDa9t3G0sGfVjwv9H_a8MGP--eO_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_aVYP1snlU7VVR1MyDoZlYNrE2u8MiBuarKx9odk5Pw&oe=69D3C53F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFlf8Ot7HsoQ7kNvwH8KNFw&_nc_oc=AdoJL3BBr3r1ahu8MR2XAZs-0pmZIWPCvsjUz94G3_L1EEAO1UvLxziw0NgwuDlMtqc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GgoPv4KdzxyD6EfH4cIEUr42BisnhKuQsyCy2Lgzcsg&oe=69D3B2ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWErNQBKftoQ7kNvwFZ_nEJ&_nc_oc=AdozMIRdtv0JC1tCjW8NBD-9xspSeWmBLne4WHvO2YtbAuT0gFoTiDBm7qT8T-REiiM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ijZsqutAVaR-rGInF1yB7tnPbG5oENhyuYbPct4xQaQ&oe=69D3B75E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
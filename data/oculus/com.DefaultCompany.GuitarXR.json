_sid=6e7a0a&_nc_ohc=0T3VmL59gXMQ7kNvwFCQ4bV&_nc_oc=Adr48pR0X5MEF0ObZYeaTOiAW4wkc0bkVIci2SnOHjQ2-pWhfR0lvmR78PrAhCgZa_0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2saz92ASsknl5yXAVUycSu2xndyMdDllXtgCpCXmpTw&oe=6A2AC773"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDd_f50-CFsQ7kNvwGD7T3K&_nc_oc=Adqg9l4O19H2aqlZ03YSfJ_54Ntsg40RBsFBkCBozgtrN-NFnygm5HaVb_X0-8O5iZc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aynl7H45cihQRZBMxrJn8-spRhnwteMycFazwuUJwMQ&oe=6A2ABA26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktFW7KSwpMUQ7kNvwFbDw9l&_nc_oc=AdpU0J59blbK4y15sbLjIrYo5ZKN0drO1kGD_i2rcNPKauyrUYbyhSKsLBlup6lORns&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9HQbHrSkZo58MMUyeFGguGqgz6OB2TU2BJBsVtHz-Dnw&oe=6A2AC83F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqP2d2DG4AcQ7kNvwGKwA66&_nc_oc=Adqv31DcNAgdkcJ2zDnrGJChK_qvIt1UIHPQ6BBBTgiWYnNn6dPu_39KeR_cSklktSw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9j6Q7sPD3j6GyYkYZqIV4M6fj_G1n7PTSKqFQh37ZgqQ&oe=6A2AB5ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nusKjaBS_-oQ7kNvwFadCRE&_nc_oc=AdoJLEd-tRZO47vDEAebaPmtIma9VrHveRU8wO3PPlSIRrhFF4YDf8rx1VGEfPLR-P0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5gQsbsSdq8EDz3azkbaDJYW84ITCkGMmD3KE-W9kO9Q&oe=6A2ABA5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=1SKQpWG49FwQ7kNvwHMcKnI&_nc_oc=Adox2t28j5KHqKYadQaTcUXFKNNkkSnYyvwoFnZM1XX4izZyDJrR8k9MHh06hjYPjvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqgtxtPmFDwwXVYB2_hpIAxYZ1e4rB8mG8d41hfT0Lyw&oe=6AEF36F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbcL--Y1FUcQ7kNvwE6_oa4&_nc_oc=Ado6CrWVMsFMSxRa2laSh6zY4OItHK7n_n1zb-bIQqB40Q_SIAZzk7Z9qAIRBitu2yw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaXODu8rh_1FcYH3hdDHxi8drQe9CEL3DzNIBHBybX-A&oe=6AEF61E6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xFtCim67zZUQ7kNvwHYCgT2&_nc_oc=AdoVPhQJuLOQeMW2JpSzGB1L47scXkrLXbX8mB35IsvCgscQm7QyF_QdH441RS5Okvg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGauJ05AS2g4PkwdGRMAn3YRqPLUTh-feZQavcJkb1Rw&oe=6AEF37BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DmAbkOos4l0Q7kNvwEFiZCv&_nc_oc=AdpmdJv9XoyVQnAlfdMN_3f9dJuwwLfNgQIIY8RXDUAJquhMK4_De2awd7BnGd32GxU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhuTmc7PFVYQe-QDivyE4c_iOmifj94hoy1GrrBmay_g&oe=6AEF5DAD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpawMl92xrIQ7kNvwGLlBKN&_nc_oc=Adq4KKUvNiou4M6OAJW5GrfAgmq4AjSV6sWaatSy1u4vniqnpEYOkDyJem7dECz1Gd8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNGimIQDR-y462iD2SbBbCt6KluV9mB9hpVkJMCy1qMQ&oe=6AEF621E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=L_mSKHVhZoEQ7kNvwG5b_IY&_nc_oc=AdoGrjX9qlZd4cIRaypnbZH57ByNiHZkGHO3NGtYh9L7scVk7HnzCU51VfFxOkpDKDE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQ83UfFGL9gZNAhG68egF_ZgtOHunOW344I3Uk2q9jVA&oe=6AA805F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL-dN7iCUjAQ7kNvwEBhpq_&_nc_oc=Adq9QykbjU_ZKzcW6Bacxrx_lMCcU0SH942Km5EaOTJudUxB0c0PK5-hkRCa3JmL2EM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2fH73ohahsKlJ5veLRNENdbNK0ViPJExfutuoo20mbw&oe=6AA7F8A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vplGXVSb_rkQ7kNvwFMsHT8&_nc_oc=AdoScIfK8do3c1fshaVcJ2MJuL-FsM63N2FAAjNYGJ31bCmh8WAIij14Cf7Y5C7uxq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIG-ebyZenUdlWWOO9jIK9gDZNUPWTKvBQsmtS9T6RXAQ&oe=6AA806BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LcaAsRA4IsQ7kNvwFgXWqK&_nc_oc=AdqSjR05s9B7Niv_CiI6bnmBWbR4NRHhiGhGaShUSWZEJARksgc1BZwswzAS-IH4Z3M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBS0GzfYyANJ6YEYyBLw1gvTnMS0r92YqWGCvfeR9iUA&oe=6AA7F46D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LT8OcVxNP8Q7kNvwFSi32E&_nc_oc=AdpmpxmmgTwvPDAypVIUsEGqvYHTlRJRT9RRXQ4FNPOKZ0I-fDuKYNdePnPGVAsSz2Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXfZVr3Pn8HKsq3xQ0ko1SQ08xBuns8RKo1ECu1Fdz_Q&oe=6AA7F8DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
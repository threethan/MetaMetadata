_sid=6e7a0a&_nc_ohc=dttYfg8WsSYQ7kNvwFLcuQG&_nc_oc=AdpziXF6GbyhyCvAYO06qH9EyyirGC6tX_3blwRwQfoWvufJ4kRBZFNnWMC0uRoOuIc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-HrmxKWDdgoBrLNe14srh594pSwso_g0kX926plEC1g&oe=6A5A3D73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_N_yNwEC4EQ7kNvwHBDw8F&_nc_oc=Adq1R2imr3vhCMp5G7MgL6ATLHF4Rygy6bPfTJVYsJQmn49nYuJyz3jCXzcVg33yoVo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGCAZqn65FzgDEr32sOk6c9PKp4HO-2INXwiY9COxNdQ&oe=6A5A3026"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWxH7E1NhWkQ7kNvwHAYP8w&_nc_oc=AdpZ8Yl4HPo94SKsQcNGWXhwC5_GnrdMroyGKY4U4ZN8G6jCKNhSoDTd2rKPBlkewNg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl4S6ooICnc8QWMkbE4RYHR-Ib71ROsZw1m-uXPKTZFA&oe=6A5A3E3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbMHd8CTnGYQ7kNvwEk2y6A&_nc_oc=AdpXiqWmKGxJNRQxx9fKm-Pz75YXCpq7ncZmmlBh2CSdNS6YhJdJBfD_IasOg4e9zmM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcgJtPKG1H6aI9iil9r0aFwyQgVbRJW1a2EbjE6AKeXQ&oe=6A5A2BED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erCCfT5amKEQ7kNvwGc4Rwz&_nc_oc=Adoo169gSxf1UqltQ3EtgzVFY8wNy5hhGGvuna-n6itA_z_vFdgzhagZ0Tjm2izoKak&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG8X-hl16buaT-y1crBFTrjW0AcOacjnIIB-MO2OFbig&oe=6A5A305E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=RYbZHEytmG0Q7kNvwEZw8OY&_nc_oc=AdrGDKQd6W5iDZmwoqa30mD-Hoj7O14nAYRBU6X20irtmGsAnXb4WK5XMCAPB7EHb9M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdjtTx3KzS_XQGkzz20jwC0mZ3DBbvvwCWfI4-uXldtQ&oe=6AC506F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53FuTJWHooYQ7kNvwG6-BYh&_nc_oc=AdoN8RjpBzLUEbrXzH909MuL7F8nMG93MO7118FZ8qkdUqVexubQ5r1W06xX_t1Z6lo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpkSeCKN87u0ftb9sOnLE4wVePgMUVfSvHqFOenv9WPA&oe=6AC4F9A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWUZkpsZmkcQ7kNvwH8JZG_&_nc_oc=AdoPS84V0-fSaHwET_ZvLpxzEUZRlvJWJl4LsIoGnwB2EWFaPH-QI6FQxZT-WIP8I9A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJpOzZ1EyamF0uC844l1Nax9zW_8FglpcJ04bhsEkmvQ&oe=6AC507BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y9PN_y_HTcQ7kNvwE_7OLG&_nc_oc=AdpK4lyVnJjhlihrHYMc2TCGKyLAvU4u6FB-koS88wXnL4UUwN7hTlzLZ980MiFcXpE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQrPa7TXbdSF6Sxch7Rck9lD90vH4ckMB52mcNFG7LcQ&oe=6AC4F56D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fqV7nyk3rQQ7kNvwHLFxaO&_nc_oc=AdqtoAyV5H_oh8QiY1nlUYdBIBtgTSQorqs04UtgqZv6Ylw2fRr5zqJqcuuWCfpszzg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNDx4xeB9_v56jihFb28GsnMcm2t539vfr-dVQodM6ysQ&oe=6AC4F9DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
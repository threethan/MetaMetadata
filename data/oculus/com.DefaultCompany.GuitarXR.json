_sid=6e7a0a&_nc_ohc=oOZO6pSO8GkQ7kNvwH3dQcZ&_nc_oc=AdpK7OkgjSaWfr1PsDJkhWuB3QJU_SVwPQptQiedr5o57kpG_C3DXny82ds4Ytltr4A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rLw7s7TwJpAnSoRfl0QRt20872NdiHMP4DO6fNEHhlg&oe=6A218CF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uC10HGp8JPoQ7kNvwHcM89y&_nc_oc=AdrTgdMKFnJ2naVhVYqlq4vt2QtlSfDdxkThygGDXIFmj5WBNmC2gdTFImp7v5vXCl8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xbhrENFo088V1x2jqvNTKmh7OhDtxLXTpxLRkJGXi2Q&oe=6A217FA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF8QC2UIiO0Q7kNvwELbhOt&_nc_oc=Adq1NiEeedXZRpkReWULhL04ciW10QlcYS6lBdbUHVE9SKSaWF6CwWWvZW76BrO91yA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-EFuirPAOHpk7FX9_Iig-fr2zoJi7isxA12I81q6w6w&oe=6A218DBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2zjoTDGP1YQ7kNvwG7X4NN&_nc_oc=AdoCxcl_NdGwVvBic0w2BVudSOISzIjQsMiwHpSm8Bqtt5R_bCyW5by9CWuw7IQ3uCE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8I_SAONl6YcJ_LQJ3lU9ZvypcuXbzOn1zilI8YUzwlyg&oe=6A217B6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrVqPzfFzrAQ7kNvwEQcyp6&_nc_oc=AdqK1EYXE0cI6FtLJD449aEuLUC-m5LEjdtXgX7qo0byvnKi3mKlOJDI2qdfi0-dC1I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uuqxy2kkJoxd0dgeXtmuI6OaI1kpTmvrKexV_O7FNIA&oe=6A217FDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
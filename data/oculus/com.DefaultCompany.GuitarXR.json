_sid=6e7a0a&_nc_ohc=IyYbue4I4EgQ7kNvwHWzZj5&_nc_oc=Adp_cvfgPl3VgPdKUaKfbdSZ2wP28cO98hoagyxLMuEvTAi9_0LUXoxA-vVg6M2maDw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPSIbPIr4XoWAs1K1k59Ijw9QAXM1-JTtO61H_6PRihQ&oe=69C7E6F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XosYPz16iN8Q7kNvwG1fMBi&_nc_oc=Adqm67Jein5jCsF5ugRMsByBVII_5O0EpWQLQjgUaWNxjg0C37J7Oikb16wqPa_RJTE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEWDGEkiuemSs09FyWu7JdarAWnwyllUe2v8bS2KwfYw&oe=69C7D9A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qvAnWptvAxcQ7kNvwHFJKuY&_nc_oc=AdoFfSBwLHU1tjdpEP_slGt0J8juV5o23PjmoghStJ3yBRfe7UAz6Z4Dksv-wS1ELa0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzupXs2pgTNccnVVVQQqReQxYV0gqxwFR5jWkfHmqJ5tg&oe=69C7AF7F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7b3PS6EF55MQ7kNvwH0pO0B&_nc_oc=AdrHSHqC7An0kB_E-eHzgr6SLXK7xU3DvCR61Dz4-q6F2LwrqpQ0T9KZMb8bcq2TGsY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfykR_z6bZG3sepvMONHt9TBwlaiAtKcB9nlxqlJ2CQG8g&oe=69C7D56D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L08hWoTm5YcQ7kNvwFUYQRA&_nc_oc=AdqyI5maY73J9_2UyMRVkOiHCtIboQwiZOHSwecxgAhGFWfYPEHd1gE5H2Eo9DUZ_wU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx9gUtJT1V6HHaTVA7zK34lLNWIHYZX_JMEwfBetKJ2OQ&oe=69C7D9DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
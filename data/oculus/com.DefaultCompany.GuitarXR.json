_sid=6e7a0a&_nc_ohc=h2Wisqqh4z0Q7kNvwHs2iEY&_nc_oc=Adq09y7pyMhkzuCCw5sSfaUImzUGdhKhPn4bVKbD6T6SR843xLRRc4CYLthM7PTYwq0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIfaZmT4UZjbW07Wwz1xjiwqsg7jUogtkR0gUJeFW3Ng&oe=6ABE6F73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DpEISMByZ8Q7kNvwGwOX5J&_nc_oc=AdoVcrffeo6SjVOQGJAKoeoTs0ODdPoIZQVjcleB-GazNNZcWRx_MCIqMMGIJPUGfoc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4oWL3h9wIVcxxlQst0G_IspMRuKEIteMH7XLJ9yoVHA&oe=6ABE6226"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5dQSE9v2WgQ7kNvwH-rkwE&_nc_oc=Adpdkb8eJMESUSSWVvYWIItL75ED66A2HzHUBZrl4VcDAaN24JaY9PbnHo6u7getGWg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItBfh9-YupG2bzhCLEEWbMk6vMqwERLQ0U3tDXLBzZSg&oe=6ABE703F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bd59NmmapiAQ7kNvwHsdh4g&_nc_oc=AdpRr4_WotwSE1X_UGqV4ToIz3lp2o8ol3de6H5V3fovy2lRRoGMXaDm4zYd2uEtsC4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGGouw5vijv-BzT5cegnesv_R6cFG2fGW_8yNoo4euAA&oe=6ABE5DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT1X4ShJAZcQ7kNvwG9C_x-&_nc_oc=AdpjkylJ979WIIz2W3ozmxSfzdM4QIyBLLayuIV_Cn1md9Fe-zBAsbJ1Ck_1_r-RRe8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXApRdWXcOhtD9FnwxjXetDaX_cb6jIf4vs14Zu_2PAA&oe=6ABE625E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
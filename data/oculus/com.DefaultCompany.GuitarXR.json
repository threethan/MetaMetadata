_sid=6e7a0a&_nc_ohc=GKJHPNuUh4YQ7kNvwEhcdHO&_nc_oc=AdoG7mBJfQffylr6nhkWf_mXIBA1xF40Qe-P7iYqzna0Z_Dex0PlAJlrN7r9nt57kqQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMXSu3P1LwlUlBNg1LyRc94KRcnlOPwvpKPQw9VayIeQ&oe=6ACA4CF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xveuC__NQcQ7kNvwH9haVS&_nc_oc=Adpgx17tOsUDY3ZZEsVjIO3hZklY6ND8J54kPS2Uw4WM9xBTuF8_CZuUiDhOCKHkFcI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPSDmw3jFnlh2_3FiUE4FrGUveW_3wSzKOWuIa3WP652A&oe=6ACA77E6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsZFSkqtes4Q7kNvwGl5eW_&_nc_oc=Adrae9_v8mgSIqJl7DC6JP44xhNipvg3nydihCMEBMXHwcVBVYyvoPYQsMyFOvVBv2I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOX5N1x3a98HkG7KQvUP6V8yXeTR3hB-G5lY69Yi-epjw&oe=6ACA4DBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0PufWY65vQQ7kNvwGfkbJ_&_nc_oc=Ado_LHenVPJ8HgmgufCiCaDguQpkT-WrIMkiO8urHmCFV-7zdwKCl4AX_Hzy2rNSxWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOShtT3NiEAraJMSCr-DOP0Ql8H-qHkpXmlko4F9OP78Q&oe=6ACA73AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxGAN104taUQ7kNvwE2ab6I&_nc_oc=AdpG7WNaI5TCFl-zPRn0V8m-IlsiVI2D13rK5pTvtyai8pJXcHIp7Y7N7dPRFbPIwWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQhKXPTehJrx-2t4gF78qJOT_w5v9CMEIzUmUW30roHA&oe=6ACA781E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=9Ihex0BslVIQ7kNvwFiSV0N&_nc_oc=Adrlh18AKTB2TRCGzIGgA3SMc8urlM73jE1D8mp9X9khUv-vPXJQPMguW_pUJ8TZPYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIucOJno60HC2wVPeFG67GPeYOoAriTbzkPwKRHNAsX6Q&oe=6AB14073"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3AlYv5RUYkQ7kNvwE67Ror&_nc_oc=Adorpnw_m_j3cxrmcFNv5tpFBpgt7fMcPkpMjxIZKQsDeetr5_2FOHmbMO-A3LalrG8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxbDDM1bjO8BxdjuDgEgwA3XQ-VpZ-l21uunCaSD5DBg&oe=6AB13326"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tMYImsRqUcQ7kNvwHQghys&_nc_oc=AdqZahm6bof2N1zvz1fH7cr8uqzrT6586kX9NKXktFe1MrMpKPXqVZfjJsbc-YpKnbs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlfWoO031qPZNohEmA15Op5v4cSoV6qN6Uy-aOlq2jew&oe=6AB1413F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StmUvPEYYwUQ7kNvwEGmGf0&_nc_oc=AdrQnFxDw7zmcJEknbtTP4dLEUunvGSa1NMoO13sqjrEWxH2xpw_qjrvakKkTwt80BU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGp3NcVQadT2ab5odLRZ8XyH0nZZl_UeXrdsAb-_4QWw&oe=6AB12EED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wN_TLs3l4gQ7kNvwHMtUVG&_nc_oc=AdrwZs57okmvvLdNiYkHFBNo5VrMV_ZO181B1YhEYVxrnfyPo0S9rrrAiBTeg0d89GU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnzy1Gj5yabrWhtsCxjNNJkZ_Dvncwdwk1z8ivVaAEqw&oe=6AB1335E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
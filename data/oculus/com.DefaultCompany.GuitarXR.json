_sid=6e7a0a&_nc_ohc=9aOsRLFhFJcQ7kNvwEt5fPm&_nc_oc=AdrQ70BLSjLhPBEL2c1USu5FzwdKXZxU1TgKcpH8DslkHimVML5l53oOJ3XkERpPuOE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdUA2kpe9zhRV0-Jei9a5cWjLIMX2Va7YMHsbL705Rbw&oe=6A54F773"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKj7qvKwPJoQ7kNvwGBx4j_&_nc_oc=Adol5h6AkabLL05nMVDumB3aoW9OUejLrqzAu6TMFHFwc7gvhmkuWMGQ1A8IwhDm7R8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJ17LPwQqwV35uZnnkduf3cWoFyiYbYslCMhwbwM3Kgw&oe=6A54EA26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PfVWKRvxqQQ7kNvwHPL-Jc&_nc_oc=Adrlb6qr8UeNmfzabPMCH6uiLVI_f7I3AwFRaTr6xNoxmWH6R5ppEzXVHblWulmPqW8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhOMeGh0ytYSDHkan33w-x_GuWQK4XzgSsrHMzk0G12A&oe=6A54F83F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYitkfnWHAoQ7kNvwHtg6nD&_nc_oc=AdpLYKpWJlBPOg_Q2g1DtsaGV0VJFi31X8Y1YNDl7eCI7QCv1yaIjDXpwUd_cFN08Xw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEOM0jZEut8S-vTeGwDEvKVybc0-cKCCBBNNqvDsz4sg&oe=6A54E5ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7zLKumDcowQ7kNvwGiigiW&_nc_oc=Adre9cMBEHMU_Z1rD935CYYKZQE3_zxHDUskBdLUrRATxyDkNCPfpMXs8B4JguXT6aE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgxemiFuETki2sfKBmZnEDMSw3lu4HHDc3m25ZWpFaXw&oe=6A54EA5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
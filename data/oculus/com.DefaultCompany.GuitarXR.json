_sid=6e7a0a&_nc_ohc=SJG7jqSlNNMQ7kNvwESp6Do&_nc_oc=AdqjMUscbHg-sK1L0ZDBkuznLqcMt43pJXKABNf5NvnyA7ZzwyWfevpWlQmOuopszLM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mdMQdulvjXRmpc4lRu3LhjcL6GLu94KE_8vhKpfST1w&oe=69E0F373"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0db-BXRcCn4Q7kNvwHGyyZ4&_nc_oc=Adp4m-IP-DxekWy-RiupLyySpjyV5E2ZQGditV5qrCIQURNC38zRQ2J6jwb2fZYjW_Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MK_v_aOoCE3cO1i9HqL60bjdLuPncEVbtLPyG9pN-Jg&oe=69E0E626"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YslAHZrRstsQ7kNvwG8Fp3V&_nc_oc=Adohv4UvQxKsxPD4nOcoKargwxNPAybUtdP0P0XMPwNmIX34MgtKGbP0YFIIE1eHz1c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EPIiJePRa7SoSX5lj1S02GPIwIrr81M0XpUZdZ9aXwQ&oe=69E0F43F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SVf5c2dBXsQ7kNvwGzfsA8&_nc_oc=AdqigTMM4rADg2aCrYlkpOn0ygKb1ViFDbQ0jIsDtpEwS7HubdULjmXoNils5QjLBT8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0z2XLGGvMLn49sOeztpqeg0K2Aej7NxoY8NkIzAKn6GA&oe=69E0E1ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJJ7FUWtCyIQ7kNvwFZ93DZ&_nc_oc=Adp8g6drUdTefC7kHBRAdjHA7NlwjP1SBFEXMmQbich2GPYDWXM89p2o7VTh6vGnDes&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bwIoe7OiixgrfQh88M3dR2I2wyrjGPOZSwSOrblAnEg&oe=69E0E65E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwW5ZBngBWQQ7kNvwEaBIOy&_nc_oc=AdrUN2tyUOC3pLuuPzEg3WHrO_7FOq-9uaGcFAUtodrOR-pfSZtjedOzYs6doBqwXlg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n_yUUFudPudV2Dz9d9w3XSqhOIgDGmSj9cnztou6iCw&oe=6A36A4F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpH0FsaaMJ4Q7kNvwFYIk5R&_nc_oc=Adrr98AvxuQMyEbCTDX7iCmi6u3X6k2TAbPrUEV-pXXOvTU4K7VIweYAFz8vSCeq6MY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8o93tFoiPvrqmLS9AOmBqv5IAG8YqPRPBeiSzE4jW2-A&oe=6A3697A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsxdHAvu2UoQ7kNvwH4m9DW&_nc_oc=AdqUBcHqhCO52YjzGIH-KbOH0W5mOwTgBvlFbyGTYjw43BrYPfPtIBB7rlLToXbny6E&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90Y3EcxNBj4sWVsTNWBFTJhzygrTatI9kYAx1r8hk_gQ&oe=6A36A5BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXb5-Sj_rDkQ7kNvwFSoVpF&_nc_oc=AdqvClf7Fn3F6tb5QGGzf4aUmzoHz2pPKkTPrcA71PHbTzvQUs43Qe3Aqvj7h55eDyE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mr2ROiJAcfoWRW6S72nUb-Wp6VEmd30kBJQ9aCI1s2g&oe=6A36936D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDRXpJuZLkEQ7kNvwHPbGRx&_nc_oc=AdqJlZXfjATpCPZZZK0jITb1zt2zw4lYVMdreZJL7bOCaM_CkueAhhflhp6Ghgj9VTk&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y-z-gQ0t4oBvdyWfV1bu2V7wFy6bpNEIdYzNq3bkI4g&oe=6A3697DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MO
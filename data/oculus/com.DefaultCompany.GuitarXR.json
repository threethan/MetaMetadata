_sid=6e7a0a&_nc_ohc=lUd5BNbAjMIQ7kNvwHBWbDa&_nc_oc=Adr2U47UNO46d0z1v3FLsITzfNGtPYzvAH89rkahA5tPh4BVfh4Hhlz9_BD1ewudwxM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XNqOq8fsSgon7QkxMi2GqyXdy4kJkypgfHq-IlOC4Bw&oe=6A1700F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRAhJunMbHoQ7kNvwE5JKLN&_nc_oc=Adqh_Sw8GvAxFn_ZGRVln69GHkrxPzufQVXQrtEsTiPHuMxrdLFSMZRo3eIaov_xUs8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sYhm1A8IcQC4Gi8hJ2hQTXbruO4iyWrSb4XfihdV87Q&oe=6A16F3A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elaZ-Q5Ux5IQ7kNvwE7aj80&_nc_oc=AdqBYqNPo_S35VX3Knzt9zCpRAFHHxErYYc9Iwl3rfLcQtuZVaPjGF7qpIsR7C6Uu1A&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dR9-0uWQYiMTzumhEnvr38ZfT9hgM67Y4qzxiEL25RQ&oe=6A1701BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQomuqSSK-YQ7kNvwGA_2Ue&_nc_oc=AdpHmAFzW1RLd8oG2Z0rhn1LEjJ3cYgjf7bLZq64P52Pi0eEVpQOaEUPaa-JOTF3TCc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jr7kmKYYrotyvOMXyiDSTooy54t3GpXy7_P-6dsfVwA&oe=6A16EF6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeJe-xItsBAQ7kNvwFUWAmS&_nc_oc=AdqBccwu6zSn_VMwwH2JslrUMZ3Qfx0pNkJ93da30sbX_SANrfHQuPxeQ5B4uDGEsxk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nafnZW7hvARxSSjAcQj72F8J8tI9sdl02wurmRVRvyA&oe=6A16F3DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
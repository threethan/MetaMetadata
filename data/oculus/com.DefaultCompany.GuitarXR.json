_sid=6e7a0a&_nc_ohc=J5kDsAvT1CkQ7kNvwFB5Nv3&_nc_oc=Ado90q60F49yAP3BYk8mBProiqd1rMIcRDI3BTl_xr7E1-idvPI71knqYtJStdKMoqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEM3c3pYYvYFigRFz64K0KjhkvQdbGnspHWpYEOSbfFdw&oe=6A82E3B3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWeajwg-tkUQ7kNvwEDrBtE&_nc_oc=AdpSY3y_sEhkpqS42gn3TOAmOyJZWd878LREzQ6wcGCoDhdZEJZdmOq4XKVGIkUGFn0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHSchXv-JuF5Zxr8sedB8xCZGGOpIlqSLgnu2WfFVu7sA&oe=6A830EA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V9mgGZtMHQQ7kNvwGgDLTJ&_nc_oc=AdrZnSDqlLdMx9GcL3v83yYJ9042c8lx12BFp7jmVZ9ogfbSfhvGEqOhNkFN7B9Jvuc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVou6__4sGTcwkh2FRfMVVpy4BZi1zJPXcSGoWI8hYZg&oe=6A82E47F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYIyrcueihsQ7kNvwHPbshq&_nc_oc=AdqMz8iuECpK7ZrcDloQjGSULOmGEK4BRKPDz8FyRRwe7gQszTHYIlaR3tfP9dHNpP0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr73-parCuocl7n69s9GOy1ObiTXQRGjvEt5NL7pVmbg&oe=6A830A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hLVjyNs61gQ7kNvwE_pwdl&_nc_oc=AdrHJx89mjGtXEIO_E5ol2-vSbXtrmxiVeRj3_kHXVrYfGp_MT7GCZdL_l-prfOI2wE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHw0AUP-br8hVf5PYD4fkfo7_2BvY9Xa4lW310cLH0fxw&oe=6A830EDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=AtXqzVMi78oQ7kNvwGKJsBP&_nc_oc=AdqVUmkAO4aBkPbYaUzCy6OAbNTkgYBJmB_AhUrRmK7bF-KvShD_kCmCAKr2RHjAwLE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4ybmmdIhIUZvENu4TycSZ23PmVZ4vUp0s3kikMIuZjA&oe=6A8C1E33"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTD2vPKRRAEQ7kNvwE3-i0k&_nc_oc=Adpy9Q_wDJvJwOcqGULlCTVvu2vpq6D6_2LQ5w-hKzx6w00aF_2hxhIjaBKzUk35VRE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1BXxPdV4ZpNBwIBLU0F9pJjrn2RW2HkeaK4tEs5bxGw&oe=6A8C10E6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=855wjqc5zYsQ7kNvwEDG-IE&_nc_oc=AdrxSHIlrRFZ79BTJ6CahFm0fwVxb5TfweKRnfxix4htlTe4PFeKxg5nLvTJBPSo0as&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwz2MYJFXrdHBQ-2tRBTux6yGoPJx8Jkvh0wSlgN2-Og&oe=6A8C1EFF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY8M7rNYy8kQ7kNvwHP10s5&_nc_oc=Adr1FYfwEwNUasIF8QjF6ZmXI3cIN30gpUv1jgNoWY_lImGcUf1DG_A2LgoQaoe5D3E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGlTnq_fvLEuFVu3vVG6ftGnMH7Q1P5YADKY4hf14fDg&oe=6A8C44ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TrVdal7dJMQ7kNvwFjJs0o&_nc_oc=AdpBH56ky0WQBbRHSUSbOfmgUB6-V1fLqwqZCLXIKuhLJ2XG-xetI5HWDXPMwYvNZUw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbLKKhWj0JVIgE4QcT-fmj-4iRtid181OKLf3y-z6cJw&oe=6A8C111E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
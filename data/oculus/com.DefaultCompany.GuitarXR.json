_sid=6e7a0a&_nc_ohc=9Ihex0BslVIQ7kNvwH7p_kp&_nc_oc=AdqIYsPGPaou_urmitXU7X5TJHiAN7-kY4uR96XBHRIHVu0PJGSHIcLOgkXsI0sboEg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBnWi9o2Ajh4iDDj4RoPyYoVl2heG-Aird4Y0HFrpShQ&oe=6AB291F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OSB9oh4l2K8Q7kNvwHTtquj&_nc_oc=AdrR92p52hSWRltPjjev8-8VNEPZBfruE6wVmKjA7FKw1Y4-27T8IW8_bMvbF3oFdRI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8YLtFf0_X9Rm2SpsiwKdsU-X0KYjC9KiZoUb5KQp_PA&oe=6AB284A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7tMYImsRqUcQ7kNvwFDafFn&_nc_oc=AdoaSe-7Fqr1WcKgA84vuXPEzRI-dyp8sbkXlB9twiB5Yy1fdNNOYvt3fo_T5hcjH6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv5AW11ih43KGdeH9zvHuSSNBvoEe5f4k26J2X08yykA&oe=6AB292BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StmUvPEYYwUQ7kNvwGyZ6BE&_nc_oc=AdpTPLuOdPyiXF_UTkg_I_vh5Tim7LPme9oFSxyx6X6rq91gcta3Msdp9oLD-EqAgKg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvkl9GCG1qnYqVeqzZUm5bXTZzj0QkdvpnAZoTR8ZaYA&oe=6AB2806D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0wN_TLs3l4gQ7kNvwFJ59Sf&_nc_oc=AdquqJqa8Opxy5gneXq1Mk7qXP1uUj2tDZ_NrvuY4aAkXL1NG0_XUk_P4v4EjYVLtIg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCdd4dH71_PfgLj_cnKUlSz_Z8NWpevIC_qX5lZDmCoQ&oe=6AB284DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
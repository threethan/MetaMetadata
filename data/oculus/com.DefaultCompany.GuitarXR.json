_sid=6e7a0a&_nc_ohc=vMd28QJuFSYQ7kNvwGv44-m&_nc_oc=Adp1mWC659IJ3mfxs1xGBIHNimgXydQKo8MeBOq0mXfo9LM9vN50RnBCWcmVhOk6A6U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kZzfffMkYGjgCbS9ZTJtB1AmJPVUZJJ7DKgAhET7v-w&oe=6A242FF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-bB3GXknlucQ7kNvwEWq7_5&_nc_oc=AdpfE_LqCU4MRQa60xYvFC8IsGng1hQ18NN8eQbTW0liywAOOPJUVjoc4LJDW9bSTEs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6dP4IEbxXDBYsNP6OM9IFxD7brcibkPVL_jDW8OhTOw&oe=6A2422A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4weV6-282QQ7kNvwHUtNU6&_nc_oc=AdqY-YnMbQ11-oD_5j_eC7z-uz36xd-EbFwUXW3zpjdr9nZjtz1MBWYgTaCR6QGl8KU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jWUH2_ZUc_m3lbyE7HVKYfJt61SzlUcJVlxdefcTgfw&oe=6A2430BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFxjDAUH6EMQ7kNvwFPbht2&_nc_oc=AdqJnqOGHrOvvcl5cK9IkoKlJhxO1ttV-YXgYGPthh0q16L1TDjdRhcAC4mHUCG1GMg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vjzkWxq3qdfgJdEZBfxSnGx_mFkQgiwhxn4fRDYetQQ&oe=6A241E6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrVqPzfFzrAQ7kNvwH8yeie&_nc_oc=AdqCUjEgEBqwlGAQ-SLnqG86VTJjcdQQO0_T3HqSewUOxyrQjMDPC07tn00iBxOKp04&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8seZAPe8NM24EG2RL6fqWM2xiuZJv4CcdZs-QgGVwckw&oe=6A2422DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
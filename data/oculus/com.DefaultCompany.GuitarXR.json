_sid=6e7a0a&_nc_ohc=ra7Kx_Q6gH8Q7kNvwFNpt3R&_nc_oc=AdqYNyDykpE3BxnkD8P4LGHG-tvjiTV17jKJGL2P8KWQDheUkUZBRHMC5-huD2lhuw0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sS3qDFo2peCmI_C48ReBhKELSdTMc5NR16lW-73_Pxw&oe=69ECD0F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BLLmBzps34Q7kNvwGzN7ew&_nc_oc=Adp1QYjppqX0kH9BOSqmfkGjis_I9qjCp_FYF1X7eOO8QafS0FLyv-mOGuLL2Mwo0Ic&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JEIX45X_aIKM1brD2jLEhvFcny1xa1AqoiqZz3g9m0w&oe=69ECC3A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlNG4sCRt-IQ7kNvwEsSg0a&_nc_oc=AdpHZCvBMsdJIL08T2Ds5KxR6TPeYNk88xbcxlziaGGxZxHeCEAJbO7pdMW4ZF7-nvw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2k0Wxbi-lUs1XNkIKKVN5bYFNLBiezpykohMCxtcQjPQ&oe=69ECD1BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bJpr5niBnUQ7kNvwELvsCC&_nc_oc=AdoKnOqeCB9QN29hHqpfasZyMUsDelaH0_qBhI2oo3UeIHAXW3OgbCzy4ZJCQl5GVwQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3K_JJcJFVhJf5dmistbhBif9CdeAlprgBx75bJ9KVbAQ&oe=69ECBF6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pqb02aSTwD8Q7kNvwHNDUBE&_nc_oc=AdpHwdxTtmHm2EFwqR0EHcf6TAQ8ZiMhrsHdTwjMalsOvTZqIQexhkMm3S3d4WO_4NE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1N156-UC-Ck1cIaEs80pFDXbrsNsi519sfSshF096zug&oe=69ECC3DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=jmsQtuStRwEQ7kNvwGSQB_X&_nc_oc=AdoQBfm510UIcBc4-zXCqrhDt_-9dFd2L6aj3yLPEM3yqpmLYFMRggZl9r3y71uHaKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7b0A9RFDJkcc7_-ilOE4g3wzDCLLltTr9q6rAKQkGq2Q&oe=6A1D9873"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7JOtLXgxZEQ7kNvwE4wj2I&_nc_oc=AdpsRC9gWJcvK8IYnPP5G0mRr2iIwfbcxP8gQU0BOCgx6XsIxVrqRXtsIkCNZ0yQ4zQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bylnCcR7AQmsAY4HImnzHntn-QpEZVNVdhRuj7TWHoQ&oe=6A1D8B26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHsqzVRf5KIQ7kNvwF8MwlR&_nc_oc=Ado-VN2dODGb-sIFzl_TBFjACaLQzCyRnr35bFl8eY70bK0jl7UPTS-l0jXmQ310TOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xBeUa7ipTXErKVQbU71-ANoNQeexApsQKOX02N5huYA&oe=6A1D993F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SDURBI6jZrsQ7kNvwGvyEym&_nc_oc=AdqSkGx2ax9varcQKEQeu56F4m80iIh7fG1XqioSNSxTtYLi00UmhgiL6Yovq3nyqJo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54TDEP5MnUzvPRkWuxSfW4py0wHDEHuR-3zNz83fqG6A&oe=6A1D86ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNAxEFxgc7YQ7kNvwEUw05i&_nc_oc=Adokgv_HOnlhiYmBX-x-CNddKAdVvcxxkRv3q-v_ajwYHAJTESftXcD8dNwkiEiNbow&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GHMYWh69tSVlWlFlpP0Q2rRi7l6UKAfDRZ5GlvXJ8iQ&oe=6A1D8B5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
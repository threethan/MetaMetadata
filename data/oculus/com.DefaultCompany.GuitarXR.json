_sid=6e7a0a&_nc_ohc=cpIPYiQEEIIQ7kNvwENsjMz&_nc_oc=AdpySAj1mShM2WOJ58LlUMhwU7KCPFhPZ2wjRpFEhRwWhPyAmhljd1HdYEgSDV19qBE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VOAaCyYNLSt0WGAAcgpWORqcrz94hBew1Gt83plBAag&oe=69DA5BF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meJ1KM3xilEQ7kNvwHexVoq&_nc_oc=Adq7QWHKLTPKxb3sKzwAANsuPvOUXCaPzFGlq2yBVOUhT7hPdd_1PRVmU70EChxSTBs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ph7FWFSt-IFBhHOCE-oYQstfNm-kVGJQ58MXfL6Vd6Q&oe=69DA4EA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnf1RW4qeuIQ7kNvwH9EvHY&_nc_oc=AdpfnBUPqoGg8AQo4VGSpXh6zjR_Zfp9not6_Pfe1FAgB-ppR7pkDpyNSLJhFDnVItw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zOlu4LfxiVh2LVb0mJiSrCSI3zoln6RVOgmrTGLoX-g&oe=69DA5CBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKcw55oJ2noQ7kNvwHN4m1k&_nc_oc=Adp8h45VoH2IdwJvmmY2aS8izWps-BTGQobHNlzA01APrHxn_F_ETIR1s3mWH4mFYF4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KOaLKYw-TJqTUQGelUfVts7git65V2Tbox1VE3U3hig&oe=69DA4A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaYmavMoiJMQ7kNvwFPyI12&_nc_oc=AdpeFFb3L45m_GKH628R8qZ2IVo6Vb9yBFvBo6HGd1E011vk7W4vNMEq8PV0Pk6kNnw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hhK-hvsSiejAimrXkjiphz-7ruB9H8pif5oNql1nXhw&oe=69DA4EDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
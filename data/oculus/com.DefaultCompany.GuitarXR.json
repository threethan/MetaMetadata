_sid=6e7a0a&_nc_ohc=RYbZHEytmG0Q7kNvwH4wUfM&_nc_oc=Adpw2O2uPTEpzQqtsgeglvkCvV1yVYBVWxsmYnUrb0BNvsrnY9fojZztf2qPgePY-sg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfYcJRks0CpvyoG8OFK83QztXOoCcyDRzDX5edVOtXXg&oe=6AC7A9F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwC570GRHRMQ7kNvwGGUmKU&_nc_oc=AdojfMTj9Skd5S83Ym8vG68vFnipNC54EXd9i9y8e0RTwWHjQW1MCZZIa2a6P0uKpoI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPttzOmrQfoH8a338Y6wIToItfI4lFYcuPPQfDQM4lmug&oe=6AC79CA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWUZkpsZmkcQ7kNvwF2jltE&_nc_oc=Ado6VQdoTEiGYTimQ3qdsQDja1j8XlHdFs8Qg5EQOef_-RRFrgeLRfuMtZKtKX35cs0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPptkDY1hW-LOX5G2o07HR4yJTPP35gJMpvpj9z18BWFQ&oe=6AC7AABF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y9PN_y_HTcQ7kNvwFbDQOg&_nc_oc=AdqS_BjvagsoH9gl_Cgk4bUH7LETMCsHjzRjxV4tKdBXydWCeAQPcTnmtu6ysIM3L14&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBLggZFeieyxE0_9iypvlgaWpRb1zFDWdsFgoD2w65Fw&oe=6AC7986D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxGAN104taUQ7kNvwGBx8q3&_nc_oc=AdplVGtRv58D2BFFQTrDda-VIfXGDTqG3tm476xb8t2th2isOMKg1L1ba3lZtVRFr4Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhgq6dgksogW927FrfrnFVphoZan3gTsd7OlXAVP8rUg&oe=6AC79CDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=4_rBf0g5hBoQ7kNvwE1DHGk&_nc_oc=AdpOoX5SWRkSwYUjBzaUH90aY6XXZfRXh1xEc9KQPkkBsdM0QwDw-CzSkHOphZjkZfY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VN1ABB0RSDMOKxcQCH_zIh-VzsfVc0S4iYRFfRx7jnw&oe=6A452573"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd0e77cI2mEQ7kNvwG2n13o&_nc_oc=Adqc1oBGoEMQSWSNYqHv13vqh-cuZkoVhe55OGLW-cJg8niytRTlxn_d6-43X6QsHJY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YVdECpGNXGboIJTZN-WFUdZx2dQJyGl5kh4dwJ_nuIQ&oe=6A451826"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcuFbDRhAtQQ7kNvwERuVlV&_nc_oc=Adq7QkqtdVsh73vGQcCUsTkAeHD6aoA-Z2-vdVpdDxLrW9fYU7vpMFg4MRyWtPaan7Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Bp_NMCekYEt6J8g0fnh14ovuykPG6hle6F1Bl364Clw&oe=6A45263F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyO4sJnhoM0Q7kNvwEdMsHw&_nc_oc=AdrM4fo1QBUWPi5Xr0UrXfV325NJ91SPyBuePOTHb0ihkx_3h83nKLhMVgA486eu0_8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GpBqbehk5LX9a8_Ll8oqP3nZ0cSIRM9zBg2xIFUeVMg&oe=6A4513ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPK3bfIYS_kQ7kNvwFL7LI9&_nc_oc=Adpkl6HwvL8U3ck7uOz_P24RDWVBO3e8kQEcxcr_89s0ZWUvjzexfZNk7W-X56vUf5I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-F8MZWIM4dSrtqn1XeB1uRStSsVzLyaIHKt_zEG67gw&oe=6A45185E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
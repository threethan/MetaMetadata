_sid=6e7a0a&_nc_ohc=6YJlodLpNIQQ7kNvwE_JALm&_nc_oc=Ado1knc1l-BKtseMy2GlzLMGYDYuc0XAMYMUzMQHdo6lAj8G6rrcTHzxDFBfe1-CmgM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9i_KjPe46T-0PFBIpkR8JsSckT9gukuDYaei3FwK6b-Q&oe=6A355373"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpH0FsaaMJ4Q7kNvwHvJkMN&_nc_oc=AdpQp2fDuFVGk51ISIk3W8X5YMuJur-pVurk5y9lgGbdKTJsyWx6lZg-BZ5Fs4dg_QI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dA-RGEPAI8H9wtxP4fISiKj9jJhsKIUgWJY-t4FCPyg&oe=6A354626"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5WihzD8o5gQ7kNvwE-tmvm&_nc_oc=Adqcy6wQS9q3AuEdHAyZxjdSDP4OJJLDqCPWef_vAH37VBPBBOQZHPXXegnPmVuy0dQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84t26_NhhmjQo7eY5OwDbqRId6NuctvzlFtA85busk4A&oe=6A35543F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqoc1MDJKg4Q7kNvwFk6wvl&_nc_oc=Adr54JWzbdkucmmlr6T2l8sPWSumrdJcYIcdN9Me2hcnrfM_4DtIYTK7Z5VS99hDFkw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ixe9QWNj4LZyDKBwSm-5EDw2ZDkJ5e7A4pPiZx18i4Q&oe=6A3541ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDRXpJuZLkEQ7kNvwGi8CO3&_nc_oc=Adrn9dxU5PV68FawtNnfXOG36BX5gn4qWMvD4SaB0PvQISOmG0-Bj4IF90x4TtGZmt0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Koh-_ms37zTVPBT2zuXOgRE66mgvGct5TKOIyUcue9g&oe=6A35465E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=dicynaiKuOwQ7kNvwF_IjEc&_nc_oc=Ado6itfJCSkW4Lu_hDwJc3AWWXMWEzCy6u_BSiEIK_zUx4XlDUdhPdwqrbuZL2-dEec&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpC1pEq_4rdPU-mcSFjYeFtzalBMLgmf_qGZW_PiNgYQ&oe=6ABBCC73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v3GibJUYY0Q7kNvwHXb9Tt&_nc_oc=AdpolUnqT9-2XOyftRsiLCZKjOO-XOJ78NLWo59SzfIEC6YE6H9SeKD5c445G8UNaEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7BU4RYctWK04HiKNA9XeHr8-6W3MpWBIdGjbsg6QvTg&oe=6ABBBF26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rtSmNDfU3oQ7kNvwEGAe4T&_nc_oc=AdoQ_VE0D8NhPpCz1FNDdF5Lfp_FMgFVRBw7Sq6LZqC-myZi6-ybxbz7EJPa5dkLkq0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr4aAplmKOf48JIGokcefm7K1G47UP08h7-0ru-n9Aqg&oe=6ABBCD3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALV4iZg6br0Q7kNvwGqPhPx&_nc_oc=AdrxEwWDv7mA484SB75KJVu29RBiWSg5qy9ey8t88WmMzhbGB8_TooEcgtYcm8FRQU0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsarPdpJ6Z8hVKhbAaONjJZ2xGGYyacka0G5pI2XEgsQ&oe=6ABBBAED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT1X4ShJAZcQ7kNvwHM4UA0&_nc_oc=AdpwX_U7Qdglnet1XmMEZPEfhj4P797X7Cott6gDxfSdcylrkSJygo821JUuOR_VTFo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk_3as5RX6SBP4lC3zJwul9KEJUSanm6hZbz64ixiniA&oe=6ABBBF5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
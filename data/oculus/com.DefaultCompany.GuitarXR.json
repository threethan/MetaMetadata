_sid=6e7a0a&_nc_ohc=Srbi1mu4Sc4Q7kNvwFq29hq&_nc_oc=AdoBBKLCbpc6QOK92giD5jnPJQIjt4PDw_2W7kyUcnoxpEzAVE0uwYQkzNtoeA0ug1o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DDy27zEyyBBovWQC9VFQOCPwAu3tYcVnxu0xNflUiYA&oe=6A3A9973"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fleHY-3UKwQ7kNvwHHWMjr&_nc_oc=AdrLxVXJyG0gsSi9NB0JeezQyqScCo0NSy-U4ac2MhDK06RHjcqkCrJyzgOSZBZCHM8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SLbQMiKR_D2lfrXvsCMCgHMtdRfYwzgOPe49FIBuXVg&oe=6A3A8C26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE_5DN5juw8Q7kNvwFQBnjA&_nc_oc=Ado2zQDRoc6eKKaIGPpaJttD35iyHVEokFdIvg3LFYBeG7WplB-7dvMtImiGtacUDYo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NnU6sA1K2TqDntGK9pjQHK-7a3_xXrLrTnNjusda_7g&oe=6A3A9A3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCuF0IUZhGQQ7kNvwGMzdb8&_nc_oc=AdrSvcq89AKQXNdGbahuNyeh7oQLn6gkLTcsi5XBcgf2bS3bMwlojjf_ZztyoXAZlFo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dEhUgv7FAa7UT2pEGWXdsN-sRX1f8kO38b9b627QTYA&oe=6A3A87ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pg-Kc7Dc4NAQ7kNvwER_NsM&_nc_oc=AdrKP1LXT4ZbbkIfn-naecnJCgxRxW-wqv56vYw1qMuzSU4DzsCy8epZmX0wp5hgJEs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8XO84onewVQL4BVlVV2MyN-wCZ0aKf1fZLc3CiBmtihQ&oe=6A3A8C5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
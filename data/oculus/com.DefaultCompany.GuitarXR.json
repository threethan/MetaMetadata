_sid=6e7a0a&_nc_ohc=J0J5J-GWBFQQ7kNvwG3b6kA&_nc_oc=AdpIjhFri2I6N5uJG-TwCGSNQxZvCgV9kvN4PX5gITHNfcrDbDwELmSSZRysEzT3h6M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7FMqSNisYVMX5hNta4aEMJSIQjQ345rOG4RJ5woGiHw&oe=6AAAA8F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7x2djiNgYkcQ7kNvwH2IGCc&_nc_oc=AdrdaPrKtrKYx6BcxpUsLXnZsvzas1BtfDN6lJj-WK90d4RgRzXUxHP5j5nK99-EGbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJ9AjnufbzH7Ipxku4UVB4HwfPB4nHvNaZtvzEaPC_jA&oe=6AAA9BA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyTbmT4MDY8Q7kNvwHRNLrr&_nc_oc=AdoS4DQNVvULK2M1hr7ew_ZO2qbsGnxGVFVR0KdEl_Z1-Xg4RaPQoI6hL92KO_dL4jI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK26WwhgOhYVFe84gXaC4znuIE6MJlMhKY8r5JNCyEISg&oe=6AAAA9BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t8_bsmDZTA4Q7kNvwE10Vtq&_nc_oc=Adr2FaOGwo8yf1EpsPbflZcIDqdVBCgxTi240uux1J8rNOeFZEkyvFF5JG1AR72bbLU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpRGAU-6Mo7oYYbnKKTYpCGyLB0GouHlE_eoR-7rIagQ&oe=6AAA976D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LT8OcVxNP8Q7kNvwGM5Hso&_nc_oc=Adr1OmRLVaCIsOx33xYeltQX3KOWNtffP6b6rapIzXt7Jyuf0hFv-u8gCTQ3pf6xIB0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJED_gBWzNcBkq3g3vOEXNLM7RvrKmWIZd-dWSB0z3Tkg&oe=6AAA9BDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
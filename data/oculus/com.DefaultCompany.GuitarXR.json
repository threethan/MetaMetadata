_sid=6e7a0a&_nc_ohc=LEYd4v8XlugQ7kNvwHzQ33D&_nc_oc=Adqwp7deeAGuJnWQnQttQ_NMmHgXjdfaQ7YUpgQrH1nManIyiLsAgGGkK3ZMWkpospc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiO26qvQrSqKva2aBaYtmGhmzup3VnNKAQLeOxPLqyzA&oe=6AC11273"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DpEISMByZ8Q7kNvwHhnFQl&_nc_oc=AdouhwfD_kS6ubdfSd_8E6OlSgg0al_Q0HwPMtK9ZCTn9chYar1Pulj9oY6vtJRTBR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHBnhMRJXCmAWsR-GUdIOcd8_pCaPeGzNIz8lVIqYRFQ&oe=6AC10526"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=saPg5tOYXqoQ7kNvwFn7a1U&_nc_oc=AdqrO7eUM9_7-N-udfFS_RIScXrNagY8z7iWBZjDoU5ZAVvBIkOAE3LjXZRA1aNK9pw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNEfI9VsODDYyWtATjgAhUWUko6imrMherFpMNs8Atbjw&oe=6AC1133F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iC2s_Y4OImAQ7kNvwF5wFTP&_nc_oc=AdqJX_dgnXko5uTUcLemee6TP0om7pj9zucYuhJ3EHd7bPX-ZDgTb6n_sA_G7gH0fyU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDqYRJyy01y6ciDSmznMLBW49eZJhG72OXxHwcqagygw&oe=6AC100ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H-IkV1-0gRcQ7kNvwFSL99K&_nc_oc=Adr5X9HGZCSNLR9emy4_Sl0oSSSDo6vndivnBMI41fyAKMcOeRpYNFtJ2MBWEyLRw9w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNrfFNl3qAsBwVeGVArjj6b6gsChZFukia_cAWw6GeaTg&oe=6AC1055E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=-jhzQ8R1vHwQ7kNvwHd1DlM&_nc_oc=Adr_5eT_RNdRmP9Pe7Krk68fb8PdqV1GqJxo8o1ZlyFKG4-O-HieuJF81nNTgMlnUUk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTukCF0_UgVzDqypLISc34nJz9TXNdU5_EtU4yi8_4HTw&oe=6AF1D9F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iUOyaw9AfWYQ7kNvwGLARKG&_nc_oc=AdpGOk46x8eOQAHZtmnnJov43ESZPllKTKQnVRSL6yr-nUV2P5j5scKAx-qf1Vr_Zxw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3d1P-cWCMwBUgfImgFMxHeHKiI9JcgYrfMtKeWli7Yg&oe=6AF204E6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VDRXYEaquVwQ7kNvwEH2ZzT&_nc_oc=Adq1nN3Reycpr7RHKHZceDnbaGLn8o4z1Zmt_6YCzxGMY9O8wtI_X1xEdqrbE4Tc80c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlC9yUOQ2WWdKRMFUCszCMPtuTuXt48SwlfUhypHy2nA&oe=6AF1DABF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQ-FjyTZBlkQ7kNvwEX6x6s&_nc_oc=Adofwo0NCzljHxGBSnjsD2UoFfD4Z4JeyRaZP4O9hJw6maZW0mDq0ax4naE6LY_XCPI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDF6bimhFjcQh88gOpl698jL1qf6vcNzjY3RMbR1kvKQ&oe=6AF200AD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpawMl92xrIQ7kNvwGUsEG-&_nc_oc=AdrXpggtDgE0KIBm7Xz1nO1D-MpV-69Wd4e75wFIx_rD1S9pfa4eLjM1GFEbwsMVnWY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk95fpkhwVX2Oo88yprGTviKr-skw0YDYAg1nG9kdZ_g&oe=6AF2051E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
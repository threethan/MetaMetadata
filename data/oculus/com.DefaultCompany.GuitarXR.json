_sid=6e7a0a&_nc_ohc=HsFfDCOsVQAQ7kNvwGyWKEm&_nc_oc=AdpeCjNUubQujwfpgWC8amCmzC8CMJ3hOhD2-fE1xlBB-O2h_ApQew1y69jb5YyW0VY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-6MYEM91p2tGvK3cZZRHMAgj72wrnQ77yJwHr2eD5Ng&oe=6A088073"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol8KUMqmJ8YQ7kNvwHXPOh2&_nc_oc=AdpQiWKCc7iQqGY7wDmrZp70ClVJSqymJS_MoUL1HE9BOhUVq2YueYofC7vY9f0h8KI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6QYqBaNX60MtWljpVf7Cz9ecx4NetDpmkBiIIQSVRPcg&oe=6A087326"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRKNEKIPU4MQ7kNvwGlRNg3&_nc_oc=Ado41UbJ0PC07TgRBkuWWZ68X3_LO7Rkj7H3KIQvUyri3PVYLYTITECAo94w70MnHJA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bErxR9CiAYQrSvecEQFUR2MOAgQUXzk6pw-2DdxsdoA&oe=6A08813F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2__kUryAFAQ7kNvwFX5g0u&_nc_oc=AdoOy1mM9PW1A9YsX4z8fVm5_eUJqPxov487td2ChDOtstLM-5-ojj5S4tzHrxEi7R8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IK9b2pwtb9b3YafmCe9GeV9td3Pwe0PtV5QMbwmRArg&oe=6A086EED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ__5OskLUwQ7kNvwHpHfY4&_nc_oc=AdqIN6aj90IpxZKSmyVrXWXl0P4iO5VSYD1imWft37oz1LlF6_aIR2zO-fFDRvWakCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5V0snRhJZOsQ9kzNmSrcO_br27Se4FJQ1wRL7B2SIYPQ&oe=6A08735E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=dmLpm6AlKsEQ7kNvwEvqD3H&_nc_oc=Adrvus2oJGIXOL_EMUVny6nHA-mKnhCahjYW4KquXzt68Vn8A4KDdnvN3eK90dj_j4c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDPLoxXCDFCX7gkuJgT2e1BsVPaour_5biMwoeH-EdIw&oe=69C543F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XosYPz16iN8Q7kNvwEDq3gx&_nc_oc=Adrr-24rXQxcESg4vA-KPhFlit-Qx_Z3OU3PD9SGqcowYlP4uJqLTxHYHpHtKcl2_-U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8ZCDCEbUxjO2MHTgdpT7Bojd-BPA9PH-FEJlDt8Ux_Q&oe=69C536A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4peN39_CWoQ7kNvwF6-DHL&_nc_oc=AdrEQRpjVJHC5AbWmTTjAT63UXnjhHRhGc-__jbX0jrab6gTtTv1UXESxmnVJPCOOJg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyyhp1CMIAmmHdytKDVMc8Jewk-9NTa-n_m8YGO_n3zFw&oe=69C544BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_RyPDXUs4wQ7kNvwHEXgMg&_nc_oc=AdqNL40H8TBvSf8U6fgO37050gpuHGDhEhbZ3bIAEOVq84WbASF8Bs3U-Bl9QnV0HU8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQV5XuaI_addsp6lt91ChHtPruOViJEbD8nPyRxTM-yw&oe=69C5326D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RcrVD_oAegYQ7kNvwGymTAJ&_nc_oc=Adp_D7sCHgvtwcX1MpN7rizH2gb3AZJGXFmwm1bdTRxlmHXBpMhNjfLQ-HfHlTNy2QU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySuWosw9Sk02XERzhrLGh0Zjx-_kmWKuM1Mr2UiRXIkA&oe=69C536DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=_eQkDKbsS6gQ7kNvwEnXBv3&_nc_oc=AdoeNbhPx9wKCvWdfkM_OXWH-G6j1H-7jyn4jMJ98aPfiJa55eHkym1mn5PLrodIWnc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96dz-lL_fYG3L9R7I4NAjppOO4r0BBbiaLLsisbKHHBA&oe=6A3E8DF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPzzUKkhD3UQ7kNvwFIJCOH&_nc_oc=Adr_wrKFnb8alHplRxO-84IDY6Vn0_MoNg32iKBuevnP7PycKERx5XhyO5xqB9742j0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9cGAozYFAnIx4hGD1VeprCjyMiB8Al6UptTLoU8pNZrQ&oe=6A3E80A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Esp00e3_J94Q7kNvwFWw7Yy&_nc_oc=AdqFet0YUkwZtS653qJLAGN5vfWKWGKJYaW9HEOFfXeRPpqbVy6SpfOfsDjO8SbKP80&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KX_MShtbVkFKQOqO_kq8HNwhy7qBJ1nySC4xD7Gn25g&oe=6A3E8EBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOJINCbDbSIQ7kNvwHExn9-&_nc_oc=AdoAgfyRnEIzsOJc_NHTyY0HrSBSXAzXNfHGLnN2kc3QvG3NcJv_tmxR4N_GYVZ5eM0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a0B38naugynUrha-X6clf23ajvbvEpNcc9KXonwIKag&oe=6A3E7C6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUXfx27T9zYQ7kNvwEAUo_p&_nc_oc=Adq-CmELQGtqUT7nT8kO_CTa8WWZaekUdbs1eQHtu-OlvDGvVRwaURqSt6R8LbsL8XU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ukyzhwzg29A21c_G0kOTWA6zvG6pAJ_CYbLbRLROsnQ&oe=6A3E80DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
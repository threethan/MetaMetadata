_sid=6e7a0a&_nc_ohc=0BXpj0aPJ78Q7kNvwGq89ZS&_nc_oc=Adr6_nS0lXAbvxKeHTR_WiG1JH6OvlXcfhOyy2kHi-dd5OrG5Oaz4xdQBW8rGJgeRZM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5utdoQYQk-Yxwd-72TkruEI_irBlQdTWETaNuKB5j_Hw&oe=6A106973"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0bVRpneMmoQ7kNvwEX_OCM&_nc_oc=Adq9mGNIbTtHJaa-uI_IiaUc-J057q5Dt7F7gaR5f7pPf4UpjAjl8anwxyLqX810keo&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65o4U0gEPOsLUSe0-dJAO0K3O3RYSZht0d_jpaJXF7PQ&oe=6A105C26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4zjkA-FPF1AQ7kNvwFAbs7H&_nc_oc=Adr_mXceov8bLi360bI2xA7tfFLWUW5Dtd3RmlAWSBHV8FxdO1H46BgPBOdba3Zo8iI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LjVlGYozlhXwPuiHCczBUjElv0WkTKyk0XDoIaiNleA&oe=6A106A3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ejhUjxx9PAQ7kNvwHR4NVl&_nc_oc=AdobivydM-oBJFGrvuECbwXBoN_XBeqkciXGql15DDvuoKU6HwZDQ3qGY6ffOv5AFXk&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Cq163W_iNFF9E2avhGNGdfWjetY1XXVuyJKtfQOu7WQ&oe=6A1057ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3MTjiCK6iOEQ7kNvwEHyqqF&_nc_oc=AdpeP6kiMLxEtPKs-byr-eAC7u-Qb7wRuPTl6w3RHUQiX0IWAhUfQyitTYICopvmboc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vi3BjwNZ7MzgzylslHZXrjhLgceK0FOfUUPFLOhU7Tg&oe=6A105C5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
oc=AdqkGBKHSbBIYR-v_OUNwtkJV8bg_6dDsWpxSWwFum7jxFPM5g7WN62TgJ_fqnWOJew&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwd3PUf9scR4EFtmYxcxDXRIj4OW8A7rZm7mcJXqAf82w&oe=69C14F73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJOsuGKQ0e0Q7kNvwHsxaIa&_nc_oc=AdqOYTIr_JOMWR3c6RfFFAk4PraT456r9BeaN9s02YFYM-LNf3R2EK0GolrHDKsJ2HU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw6gu54DFgJT_X7qYJr-5hndoK9Q84t5d8SwOW0No_uyQ&oe=69C14226"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQhlD0mo5AkQ7kNvwFci0Lt&_nc_oc=AdrKi2Qzqj2jgfve8_rYlxl1kcDY9a40Vli-FO4Gwrf16madqaziVq1_RT6xG30p9tM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx_vx76GkRZr3zQ3Xp0wLpz8Ku8Iv_WYbgtPVy0ydNdog&oe=69C1503F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UcDDxujGkhAQ7kNvwFcYhGH&_nc_oc=AdoYCkskYQFtSjhVTde2E8iEp3eCTztOv3B_U56aEBDK8fRJgDt0UvNBlVVRIy6KDAk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwAMFXjDlAXK4IhwRJgkfZTm8p0VWHm8P2VfAvje0Qc3A&oe=69C13DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2PpbvG9LeTwQ7kNvwHVI53c&_nc_oc=AdpH8JotaqC7oAaMqxdYLG54pGJYHXeFVyPjOAK_8jj--vqN9KqekGRierRkip1EwRI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzPEKun3IWsCzK_RJvtF4aPcJJ4wsMVOMAmFLpJemKVsQ&oe=69C1425E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
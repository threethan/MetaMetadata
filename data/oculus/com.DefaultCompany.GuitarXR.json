_sid=6e7a0a&_nc_ohc=L_mSKHVhZoEQ7kNvwFC5rm9&_nc_oc=AdocVs_pE-qsOIBGo0sgl685ribzuavejx3sFNxeCra-SQz2g1B6XaAg1rkfwaQIQ4I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLE5S4TjahSQb0X4aCu_vEI_LIZ7-R4zmct8NmI8cmWZg&oe=6AA562F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq_y4oAiSWEQ7kNvwHBq_6q&_nc_oc=AdqWghdHaz2d7_Iz5fX0qA07zs6rWNNodGxUWXwNnDcw7ulIPpdwKoOOPTRsl82c7GY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmgco9gS062Oobkw9LlOwKL_w4gk7-Q3Rq51lOhmN9Hw&oe=6AA555A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vplGXVSb_rkQ7kNvwF1xQmC&_nc_oc=Ado_xqmNLYA3ZSsL90dq9aX1uJbDPCMNLd7ziEvXYlZYccB7Oen6Vfi3IVWR8dclRek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv2GEB0Cw4aNGtqQR7xuMua7jGvKy_7Bh7F9n3cyqoHw&oe=6AA563BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LcaAsRA4IsQ7kNvwGqek9A&_nc_oc=AdqPpsOZiv67gXRcpQ6blIvc1b1dBI2pGTtsTv4i7gMdOXUzBRF-nMpVASPFy7sfbcQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKUGs3fuQOysGhOvWsHmc0XXHzuGum7m6HMKoH6MDLrA&oe=6AA5516D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9MHawkfnO8Q7kNvwFmVOG9&_nc_oc=AdqMmhYU7npq41ejaPXKfiWTEjUgaoAehryNMH8zt0qI5R87yGabJSGIigl5gAKARQk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6rOT6LAwLH-JDDyxpkX7ImTf-D0cR5kl90-nz2aPW5w&oe=6AA555DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
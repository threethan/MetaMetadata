_sid=6e7a0a&_nc_ohc=x2cD-Q_2z2cQ7kNvwErfch7&_nc_oc=AdrxyVjLbwWO3yUCwZ1T6Srkk_cUHmAemSUVTfMRmjZ5Wbj6b-Yzhv9CEnWCZoTTviA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jA0XzmL9KbHBBxKWCEI_liaLqRnE7BVLJbb_bkhRDjQ&oe=69D272F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeaSYZTuoksQ7kNvwEHVecK&_nc_oc=AdpobeN4JPL9rvTCzaxWh9Cb9oslqHzd1_5yMjIjU4AeTns5-QbYgnbXEeLpj3N8jdw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jPrzeFjTOQDOefuhEoQXyqxvlX_7NOVnRvqF415_xVw&oe=69D265A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWSMSg0vJ3kQ7kNvwF69QCu&_nc_oc=Adpe4j-NsPRspakc3A309mSdsOEUmNiYkiZ7P3rwA4zF5ZXYdZTyVBa1p2NCe5_Q3fk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pKrBcX80J431c4qKT8x3p0nI69bzJSjEpHrNoEOUotA&oe=69D273BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqNtziu3IRQQ7kNvwHe-e9F&_nc_oc=AdrgJZAR0tPi9pgl9O75eievxdGhnyROX1AWQbCWXjhwwA83Jy-J6heosZ-ph-kTSl8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AvBKCSLlNChYmLYbtTsfFNRQGvFB-6fo0K2wuaBNYOg&oe=69D2616D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWErNQBKftoQ7kNvwGCR5wx&_nc_oc=AdoshqCuSfbNnvZvybXVtKgHJIuP3FFjGHCDZgbGt8s8zsLrPvtUkK0kQYZJvZJcUy8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kWb_ND0wTKaembEiAff2vdcuzYbVnaEFjh161uZ-3sw&oe=69D265DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=EePx6wS_H2cQ7kNvwFfy2vR&_nc_oc=AdqOESwHezpwPq9kSSjJBB4koWx5rqOs39Tr5EcCcazQXCtXQ7M8i3p5E_Mkgwk1YYY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChlnaFkOiH_BHnZV4wCObuFW6aoT9H6anvErWMgFztrw&oe=6A6A0F73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqukfUdT4_AQ7kNvwGViPIQ&_nc_oc=AdqavQea9mTAD1aY62yfjFwVctUqhoIPq4xzSESsF8XpM3xZOtNRT5QA4fAn4JIIbog&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgEoCZTlHPZLSAo_TWD220o51eKC1tg4W0g6-A70-FJw&oe=6A6A0226"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgjeEq-jdlIQ7kNvwHud9kH&_nc_oc=AdqbWu6-QiqOSNai_gcASSOM_tNh9-uLfv-r3mEAW6ldKjjfBHo5GBdoVn9AVUYVaEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYj4E07vhaRe6L16KAj3WfvHIVPWsdxBX0vphLiXfsOQ&oe=6A6A103F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9B1_vXBSjDgQ7kNvwG6yYqM&_nc_oc=AdpgPK5JJDyuIFSgQdy8evqDNz04Wq5hQNl1a2m31LDOjQ_PatAVg3rJoT7sx8-6ZP4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKmrcaQKpXH7ngHX74yqasTm98AR_0Euqm9Uv4krOg5g&oe=6A69FDED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoABidNCJuAQ7kNvwHqmQZZ&_nc_oc=Adr3EoaiN7tQgIUNSYV4IY9RPJ3663mfOcrKxdFjK10PeC5lsbPyUrajhEd9Ud1FNwo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARIgU-_GI-85gPlrJd9UZsHWqElFQxoUKAHgxH9SnDWA&oe=6A6A025E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
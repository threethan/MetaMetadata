_sid=6e7a0a&_nc_ohc=HpiQ8ora2hQQ7kNvwH0g_AB&_nc_oc=AdqWPT_pyxiXp9QDBAWJr3KwRp1cxxIyDS22kYyS9XFdoIvL_6ubg_moEmemnW5wb1k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sv3koND1gQzyMxFmLlcMXylimB6hLXisfTEgwfNEaxw&oe=69FF45F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_HRaYlajc4Q7kNvwEoo7lQ&_nc_oc=AdpK0K5zG-C_omKxnSQ-dc64ycmCD1ahGuv7kWFKZFcy-z_wkX64WfheyUxkPDU3U7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ms3JE55MNygU7kWFA4911JQPrZwXBwKBxlYQZ2N78CA&oe=69FF38A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRR6TEmFc_cQ7kNvwEr_L6K&_nc_oc=AdoSSMFS8syJfnGn9WrBjdBV3wegGQx27eRfz5Se9S5TLtLtf--2arBsG8k8a10BG74&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Fu0-qOZDVUjvnZc4y5Fc-jah4Otxvq6pRYSr2jksDOA&oe=69FF46BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8hMbNz5RmUQ7kNvwEfNF_G&_nc_oc=Adq1rmveRtV0lIbZsuPQlpF23GCGK03fvrZJ4fnpVkOz1bAahtylCrxmcKgooGlblqE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S6fZ8fjUzOINVIv3w0IfXcceIb3w3nbO2WDhFV-O81w&oe=69FF346D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDyRl8v-UvcQ7kNvwFUoPQL&_nc_oc=AdrMLvYh2XGILwTJJziauuCO8D_zks7BpC35T6hSW8EONbdripEQ9Ue67hTSYFURBm8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44JoR05ikDx-nY3k5afP-m3I7JxEjXUZE_BZ1UfOi6Mg&oe=69FF38DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=WhWLEhUYoacQ7kNvwHBP4Zd&_nc_oc=AdpTYalZy1cGurJ4Y25hbj7vh63zaFgBC07_NI9WnWQWvjojVSelS8pcCe6eHq6dCHg&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTRF5ZAByfdn9fhX37bdIRMZA5ZHf87LmDI2hWyXHdQw&oe=6A916433"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cybJmw9vmooQ7kNvwGcob_B&_nc_oc=AdonfG4MUkSewk2Jh7aqqtkBmyhK1m1cP3bUHtTDgHi99GiqVxLbPOKIYxWxf1bisKU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4p_9U6sbCGY2MnwFNQYR1lstZw45Au7-FlDjcq4u7pQ&oe=6A918F26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zGC61mOUT1kQ7kNvwG3z7nd&_nc_oc=Adq8TlcmacLrQozDCwQpZxfOP05O-zy4nJaTyD7njJs_B9r3CsEwSW5_o_m58FHUa-s&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHo4HMfzZxhUCQ76CMLerw1wuyH45ZE9FfsedEpEMC_2A&oe=6A9164FF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nEPWphcvhHAQ7kNvwG0Uf51&_nc_oc=AdrE2TLpIbFSg07NRQOuIjgwcR7e7RyyoTui64lQtLm7wGSceldgr6NTyINpYYo9uos&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWv9-yInmL5Ab3qyD2CmVvcLsmoymASFHwXuA32FfkFw&oe=6A918AED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Uh5WYyJkhkQ7kNvwEBDScA&_nc_oc=AdoOKfq9mYO7nUYFm5UfR1e7AqZEZfPx2c8eB9ot9oYgnG8rFcgFPajyCNS4lo9uq_I&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoDkhOMuJW94VGacX9Y95cYICxYYsUibCukuGK5LSk2A&oe=6A918F5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
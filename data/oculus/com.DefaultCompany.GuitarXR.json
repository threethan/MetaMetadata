ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_2fhr3YxusQ7kNvwEUTAt6&_nc_oc=AdpFPN6QmyzWhIX4sfHsrfz9LpvJ6Th45NKlltCO1yDnVZqfamw-0r7RZLrslLyyQZM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjBme9nyahazjhhIFq1-wBI3BT86Kyuj4OJ7MF-spI2w&oe=6AAE9D73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S3AlYv5RUYkQ7kNvwEFw6T6&_nc_oc=AdrnG4R-zjaWOZ7rpMGpsw9zqy1VwKsYkZ_x33NnibevVOrZ84legekpHumtwAuzgvA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLW8rA2xnjsyBQsiJCds-mDH3henmiAyZZVfG6NKSu9vg&oe=6AAE9026"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFjmi0SZ0p4Q7kNvwEpJX7W&_nc_oc=AdqqVlnIBMOGgpsDv-Ktx1XlewSXOE1e9sFbHUhQ6zPNAkZKKw_XJ-GXwh70TOCkH_U&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOKV9THCbOzu3SXN7vl2w-n9D_KwuEvMx3wmDJ9UXGdw&oe=6AAE9E3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=owSxZnQ35o4Q7kNvwGbV6H0&_nc_oc=AdqMTRFKB7cp4NTG-r0aI0L3uq-WThy29l3yvmF2kU08z-Tsf7z_rOzTBNqfwO1ikq8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKPpRxuWy7JNJd1OGBkO1b6Hn1jqFSrAy-bKXZ4-LRCw&oe=6AAE8BED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNyPvu6as9wQ7kNvwERjDq8&_nc_oc=AdrlD9Lof3eSA7ecRJiGvUfopRuT_usRPt6VlruKwZfIb7-v6zYimV599cyzNJPnb4o&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSeV9YdUjN2pSxJ7KpLwYz0awP1jESNcJ6s2-CE6Zx_A&oe=6AAE905E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MO
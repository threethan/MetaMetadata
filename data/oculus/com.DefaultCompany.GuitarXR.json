_sid=6e7a0a&_nc_ohc=jBzqdVwJStwQ7kNvwFgq6Yy&_nc_oc=Adprb9ai3LRfx8kfre1AxIVJYnMyuNj90GLdeP1BwZClJu7ubPF5lah5OkbNX6u2DDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0UO3R4MaPbSqSa6CdSBzewOqgzlgigXzFdNdhs8WOAg&oe=6A998573"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtLZ0msUlVoQ7kNvwHarw9M&_nc_oc=AdpoWIDpcwWJR54vYSi5uoOfqjFY91js_XW8kaqR5fgvacbvjpzk_6jrPDDd0MkWSRA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtFLoXwPKeoEgWtI_Ep7RxsYwrLGoCjYkJ2Hgfa2TlZA&oe=6A997826"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mBmIVdK9Ji8Q7kNvwF4EuM9&_nc_oc=AdpB8CBKOH2pwa7MVcMgswP6hPyhYwvfju8rezQ8TlZrBW29PYkSl1RIcMP0FFgdTWo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6FlZYHLm0DoJHF3erj8m-b1Do7edxagRIrPlBlnk_gA&oe=6A99863F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6Ndn2Xq5csQ7kNvwGSmzf6&_nc_oc=Adrwq1QyGDg2Bozz8U-hipuKY_Hk8qPNpnXPYgz1resIEMJTCRrBxCvufCHqnVfQsb4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_vf_cbl8GrVDppdSBUJ0oD2f7TwL568myzbNrNfxong&oe=6A9973ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUevDnxuVtQQ7kNvwEGw6Ju&_nc_oc=Adr4igRmGmAepwTTvq_hDdhZxIhtnT_j2MU8_HDEtV4wKJOOAJgudtzmh321E7NRxBg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKP-i6m_OGCbH7X1E4x7A2ERPvHockz_uqn4WFCMZDl7A&oe=6A99785E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
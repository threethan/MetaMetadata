_sid=6e7a0a&_nc_ohc=5hTyJQ7DzU0Q7kNvwEJSTG9&_nc_oc=Adqx-KzxKm8oivVKDDuQhzhQGsI2wyRFZLvrTB6RQ2CfmM--5WZZCo5pMls4NZSO_Kw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oT6igp_5w6FCgtlSIVV7SmoSDAnmdsot64IY0pDrplA&oe=6A2975F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDd_f50-CFsQ7kNvwHKH--a&_nc_oc=AdquzRGxg_VKCXjSJ2jwk1qJTmW0JGQMN7vms7LXz4IgkXXy6WVIVJ7vRd9XHjiXJqo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-S8_izk9tCD3ccqoWssozaidIUEUIUf0vcBAyX1uxchA&oe=6A2968A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XOSB4n7mK-8Q7kNvwESC8u1&_nc_oc=AdrUDZvpRqpoUgONFBX2yFgmvhRn78qNQc-Rx1vLAF0y0Kr6qcE0TS1neiVygsRKGeI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8KVQElUDR9_5bkTmZ8LLXkB2cWn7SDz-Db_O0Gar_1Hw&oe=6A2976BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kg0DZyz6qqMQ7kNvwHITHIU&_nc_oc=AdqoQe97sIk60sYmTIItuSQW_FDrj8AJlG6oJuzPNDn3-I7f-PRCtSYV5DoLTGE80T4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JJXyhrO0r5WTPkwPSms_VE26rElUkg5a8ANz6fY6IoA&oe=6A29646D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nusKjaBS_-oQ7kNvwGsuNeO&_nc_oc=AdrYlP7RGHNpNYVnRUbV_oTekBSwjRgGY1wcYL0osmsLxd7fBV4YHJBBS-nVb1-Sbrs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mRE-mjim96t6nsgwKDuROzfOoW82SY4RAuuO8zgDixg&oe=6A2968DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
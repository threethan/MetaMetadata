_sid=6e7a0a&_nc_ohc=0a2UF-bYmg4Q7kNvwEmJM7H&_nc_oc=Ado1ElGFgsUDFZpM1BqFHiqHGgWYXbA4AaQuY49P5_ZcjCrEBGcy0-652Q5oAaG0-C0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DJpBbrq21fjcv6zNCoQ4TfGSQEG-_lo_25QdTT5HWTQ&oe=6A0B2373"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ol8KUMqmJ8YQ7kNvwGf4uF9&_nc_oc=AdqdD0O71-5IVhC4UZkCGUUIm4hGHY3kjS1BFu9k6PHo9gBolgVgUwSVlZyW8SFeWgk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SNRT8eKhMQLISswcWIoHkoRTqa-W8tlVAI5cUyDvyTw&oe=6A0B1626"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xB7CDPfG_EwQ7kNvwFbKPoK&_nc_oc=AdprHprfsexScy98V-gobvnE9rQPlYLOqyrAd9eIxfKdZyVql6US8z5mMxCERHib-Hc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6j9h3zh-Uz_bB3iqVCI8MckyYYpAQjm4SJ3lFmlCuXhQ&oe=6A0B243F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPapNwdvBDEQ7kNvwG-gjQw&_nc_oc=Adpy-5WmBJbRexYOaoU2TjwAqvCmn7ROQuiCInB8c88HgJuy6P2lURUNuPKL29RP3jc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af620zSoYkIws5_IJeTdJukZ_RhhRO8V0rSO1Te6Hmu6GQ&oe=6A0B11ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4yTXtoMY-xQQ7kNvwHQ4zRY&_nc_oc=Adp4yVoS8Kpm2odnsGdyu2CrbZY7h00LhMTD7H63CGtn0AQZPV2XvEkza3NmKijS4Us&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5voMYwSJM25KLdK4vN-OjBL-BUNgfMFd2lqYzkN0sVbA&oe=6A0B165E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
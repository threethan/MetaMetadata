_sid=6e7a0a&_nc_ohc=J5kDsAvT1CkQ7kNvwHe5SvR&_nc_oc=Ado4jmUrT44p3Bs5MklBGpiyGo3UXICR0V6kV0Ni6cqkljlaTdBy_UK_D2NSlDjmeg8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBq4O8pykMnOSEmMxh55by9U6-UR9B3nUXUBydhHA-WA&oe=6A819233"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yO7eWxsLFNQQ7kNvwHT6y2F&_nc_oc=AdqTUFy6dawvXfyEN4mBX9LRdXRwPzF8-8Hy44fMOQyfxa7kHCsKE4_l-gmyqipMygg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMABm3dyQ4bxUIeOzJVERgAyU9OWDy3ilO3S-lxtM78A&oe=6A81BD26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V9mgGZtMHQQ7kNvwFeFt7A&_nc_oc=AdrU5comrVNycP8WY51ITMB-t2BN55anceHXeN_rLtfX54NYggBBDkg_AX6CIY-jVCA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdXEzS26MZm4sufFokDtCCERuO7G-EOt3T-cclhTcfcg&oe=6A8192FF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYIyrcueihsQ7kNvwEYIrKj&_nc_oc=AdpHI2ZJObFZN7XM9N1dgZJdLNB1XshasSiSXPIWiLM-dViYoaFvDsf14Bf7B6EFi68&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFb0hRFBO0p9RFP8PQacto_GJm2BX9C-wwqsrW1hPY2g&oe=6A81B8ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hLVjyNs61gQ7kNvwEN0wmo&_nc_oc=AdpneatKhU4M88Dps7_9LmI5Kb7FUb0ctycZyiPLMBgxJ8RsNrbryCUcjXVKMux8NoE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgMCq-Wii1dEBwLLP-qdoFRiVO4OBqR8m2pgZjlNeErA&oe=6A81BD5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
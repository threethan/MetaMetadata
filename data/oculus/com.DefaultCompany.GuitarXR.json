_sid=6e7a0a&_nc_ohc=x66_2gudQi0Q7kNvwGneADD&_nc_oc=AdrHV9XADkAoZ73QrSEOvfn19MkKBxIhBBTNWabhqu9rDdk1dA0iUA8W51BrcqfeIi4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3raZdOb1Yve9toGeOVXtQP5bAWjEM3dN3KfbGeMYYSkg&oe=69F4B9F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wi7xpFwvTl0Q7kNvwEzf4t_&_nc_oc=AdqBDpTQiroRD3ufeHvxGhBlGtvi0VsdkmcJrwEhNRRjjKDf1MRk-HGxyJRpmh4VYYA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3G2UK7egcUM749yfPhDn2pQn8whMSnhwBpO9dgNSTxww&oe=69F4ACA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM7-HDnhgYkQ7kNvwHcqCDL&_nc_oc=AdrpbZGdYgHJ_gfkpeSnvVx4GLOYSqLSLCMjI998q83cxHIOofD14Ju0yD_3hWp3ATg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ALiK6wThgAQ2MIPaGhhVDPTRmEoL_RsEn3vC8X7uUyg&oe=69F4BABF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sSjtW13VIYQ7kNvwF2KAHO&_nc_oc=Ado9J3SF2N1mDcSq9RR1FeaYPe683hX-QX8ejfNOjjDXcEe4Kv8EthfqwG9xrA7euyo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Sn4LOedKWWfb2XSFTPRrTA9ZYyBpmQALM2rIb_8lOdQ&oe=69F4A86D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esnE8JvDsmsQ7kNvwFzPVLc&_nc_oc=AdpJmOWQ0VZEk611mFi6b3DFGRidUiok9niXQBbLXG8-Dn0d8xv_Bu6C1yzu25-ZpGs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0dwIDdroaYLccYSZHVWD1YXKCKmTPyA0AhGJoZ24ojHg&oe=69F4ACDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
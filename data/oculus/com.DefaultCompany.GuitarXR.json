_sid=6e7a0a&_nc_ohc=4_rBf0g5hBoQ7kNvwE0rIIV&_nc_oc=AdoXs7f_fpzSb6Y9iAcLdr-Cp6PeI7VhTAwc0zmXMFF6zfWOUmaMGX6aBRVmo1LoiQU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uhXoksoDG8jKuq7ZohxwjiSx8kvNJnVwpuH6Q6DQRTg&oe=6A43D3F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fd0e77cI2mEQ7kNvwGTNnEL&_nc_oc=AdoWM4RBoZsmadutgiYGCq_nlJR8LZYblUQQzBLuNilahxydRgYx9B4ddCbOW2Vda1Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94xPYi71RpaY6gf8XysMWSKHyQAsQWTG4J8X4b45cRWQ&oe=6A43C6A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcuFbDRhAtQQ7kNvwHuhdl1&_nc_oc=AdrOpmiFpjF0cHaoxteQ_1-nf-6CHN1dH8I7H3KXIFGX7jJad-gjdQbRS17yM4ctPt0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9y87H6yQsQXsWoui-r8CEG2wsm6UZqfmcqrmZgizbSVA&oe=6A43D4BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyO4sJnhoM0Q7kNvwHTQL2t&_nc_oc=AdrEk58iCNh3D01PRg8YxZgxF-2HX43QFPBOEMdzsrbeGVw4-rLtyB1olsZ3XDjKnC8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QVObjRhfTAcp2ELNrMU-zVZX6yeX_PRL5kKIlmp7gPA&oe=6A43C26D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Umi1OCaXeLQQ7kNvwH6UXCv&_nc_oc=Adrdb2yZtKsLfwtzt7cofSWUvzB7HXlfqQIA54W6tEeD7s9Qgg5kMr7gQbFplWVOfro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_8-eth6YzNsRv2TrCH2Z8F0AG2Vxn8qe_46RZ9AInDSQ&oe=6A43C6DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
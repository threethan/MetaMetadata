_sid=6e7a0a&_nc_ohc=ua5zc8RPH6MQ7kNvwFjbw4i&_nc_oc=AdrTtj7NdSbAk54cRjsTk6mInNYzFntNZIS1Wrxl0hKdrEmz7NhM_b7U0CueSBvmtxY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SBQ_WDJPg0b4QLD5DlDYxB70ZdGbBUdQOTpChcZaa6A&oe=6A15AF73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SRAhJunMbHoQ7kNvwGF6n_A&_nc_oc=Adp_pnNV20DW8L4IW9DcJkfVtKbzXhF-yt8N1XXBtScWoEuDZtzr8gEMbPGkwQXBCEU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6YJbpd8AQ9QDX_RsC22AuV26Lh4xw3OUrsd_e2e1vYsA&oe=6A15A226"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uK3EEBCnDs4Q7kNvwGXbgu1&_nc_oc=AdrFMn4rtnDFoXRidUWBYFztXum2Q-_ZID_EhDv8IeXgSPwX4nAFY_T8fyy3BFEXfrs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rUAjN-YCUFB1GidSPyDkW_u_DwVHyAnuiYi4WbDfahw&oe=6A15B03F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckdOazuhHvoQ7kNvwFZ2nnx&_nc_oc=AdrDYG4rpZBhK4CoxUc87y7Chb4U3u8Z5DeKSQv2LZsMW2P-Vi-x0dRfoJphLGvSUvc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43ZUvkjuQXfcC9U6gBuTx9jcBlE04gDvxo7mz1aJw25A&oe=6A159DED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeJe-xItsBAQ7kNvwFFtoZf&_nc_oc=AdrJrz70QR5Jl0LRErEqc4faEiMYvQHGDjrdcmTBHN3prKByoiPT_eokOFJVbNg-ULU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kDfLEG5ceDkJGMRfEB00IYU7W8cGOiqzdeXcx42AYWQ&oe=6A15A25E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=ra7Kx_Q6gH8Q7kNvwExe6NM&_nc_oc=AdqmKJkVL9WMHsPVA-pWIMLAq7lyPCBR87ZhVg1-tjE-ztoUi-9QJZtjxNOXHdatINQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1D0FKzp-0wpP-qrS-clb388XAWyy7bKeaodmfp1JNsqg&oe=69EE2273"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BLLmBzps34Q7kNvwEOzNYZ&_nc_oc=AdpB_jvar8uGAiIs36X2jTY3Ys_VLZwTwdEQNF_a15e-JkyMpX81r2qO586elDbHTgY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pqNPSpLkjAJ_SH6xvyIRyNF8ecUuwk1V7XJ2ieD1JPA&oe=69EE1526"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlNG4sCRt-IQ7kNvwErfJMU&_nc_oc=Adoq_M8uR0IfZy66P9lvS9c4BYKC8kYNFSUtQ14Vw9adAx9kPRqK_YZpwX3U8KrtpYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0G8j7kVEU-r1Vfsj0S58b6lMCp6z7o63c0Hv9t5Dh0qg&oe=69EE233F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9bJpr5niBnUQ7kNvwFQjAZG&_nc_oc=Ado85Cp-lgWJ-ZNvSxCs66RDuVDQuntPC6UFw8iULe_sUhEF5S-V3Q-cMuJwJ7Jfg4s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AcUJfevuwW1bvwoG6j4ay3r4f_jMjTtPYXry_ihKLPg&oe=69EE10ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtO7LsXKKbYQ7kNvwGlLwCY&_nc_oc=AdrbQZ5AUraafA638TdHvVJi1_gO_tIQXXTrSL4KviVF_udm1J4ojYAXzWQTkJ9H1ps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0lXVCU3uCum69OV9_QM12h4PKPuxquLfV7FfCT4gIK5Q&oe=69EE155E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
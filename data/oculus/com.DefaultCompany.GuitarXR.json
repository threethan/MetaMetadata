_sid=6e7a0a&_nc_ohc=_Pnuu-Re8f4Q7kNvwGkWu7k&_nc_oc=Adp8xBPaKHMOlJEkBRdSsTnr8YqWF-E22hL0kgfbvlBDx3NsmjeySeLx-1Lc_VQ2O6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMi-3PtZcpZwxH5XmQ_TUfLYz_6h2N2lG3vemncNrOx0A&oe=6ACE4173"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aoKg2C75DYQQ7kNvwH5Ud5I&_nc_oc=AdqVmvfD_hrw2E84_pimUW9Zey8WuJpD-FDT-8LwKpofxQsxdcMvZIcLY-sqLgbYZMw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhellkBNujCciR90F7bK0zNhvR0wdj0kfyS3Cwm22lpg&oe=6ACE3426"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SztD8XuV-QwQ7kNvwHuYCgQ&_nc_oc=AdrYYvI2rvpeaVD3HWUKDMBuWgcq56agSjN_4Xh6ckf0FBi4TahrqOWKhRv6gyV1V8k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj971-Tqor1C5orDFDrYdeKGEKHPmvXm87ysYfgG2U5Q&oe=6ACE423F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vGdDh2K7cfoQ7kNvwEob7T7&_nc_oc=AdrDlxOZd6C280Dl6t8pR1mQtXvUTUrzCuXFVk1DAWt9voTN18g6De7Of7Cv5aqKkPU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWOpMjcSFXVmxDBKzgdafbXJkfSNMy31w4TpvoVVCgCQ&oe=6ACE682D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8u7ofOgRL4Q7kNvwH1YkO8&_nc_oc=AdqqkaJ9lq2fkX2JzuYSzilTze5TRgrSzSmAwYVUjtfXWIsdLP4WHK4jS9BLovuS6is&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcoLm7u51rCG1Owg8YueLmyKxBoZ6SAg569nFMTIsPBQ&oe=6ACE345E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=Srbi1mu4Sc4Q7kNvwHAsYVD&_nc_oc=AdrpjZ73OAwdmajZnk8okqezWfZyTXJhmti8opwen15IJSibKeL8rrGC-OWoJL7G9cg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uAlsstVs3rEVhm3sSTMBuQTDaom6g4VOo6JUjWptvyQ&oe=6A3D3C73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PPzzUKkhD3UQ7kNvwHBtOmk&_nc_oc=AdpsI2cTg8HIC5kuxikkvHLJ9neVoTL5R4EVjMlIgREspxxbEs_d8g-rQPeNtjKJJXI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AgG_SFpqnFnfIgBfndzz-tLnsGawpKTd7L_S3A7MhFg&oe=6A3D2F26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NE_5DN5juw8Q7kNvwF5pbXq&_nc_oc=AdqOq1Mblmgf6-50blWmfdd9n5mIDpl4dEXqiCm4llBH9Bu669LsmSQPks-1Ie1ZOVY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XeeRUc6KZ_RLozseANByo2O9GAXDoNIkT2_lZaMfmRw&oe=6A3D3D3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCuF0IUZhGQQ7kNvwH7t1eb&_nc_oc=AdpHUOsME_deNj0w1vtkeFqnKwXzpSjnHE61AL8eqPqwSUM_68F1qlLSfI1HDnHxzPE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-X3GWC9pkHLqOmF4Oq8ZbSvWJxhLH_i-6OkSkni60GmA&oe=6A3D2AED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XUXfx27T9zYQ7kNvwFnwFly&_nc_oc=Adr5x5YZCuh0dSvTjXJOMR4WnlePdidkbpKFsO2eDiv1oSs04Hc9yBBYu1LqQb7IJC4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xVbrGGyXA_XXI0NyAVnjUokxDdlLzMj2GpE10Lo1wpQ&oe=6A3D2F5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
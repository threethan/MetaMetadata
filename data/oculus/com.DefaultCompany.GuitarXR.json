_sid=6e7a0a&_nc_ohc=RQqaytWo4fsQ7kNvwHEfPfL&_nc_oc=AdrPRyOOA9G2585mtHL2XzrSgbi7hM51hklhJpA7mksfuezK-UsqyrgRT2Zr7oWyR5I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-i5lZ6j_caJGyt5VBxHrlRdULoUJdW8ortbxYcZ4Zjw&oe=6A68BDF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqukfUdT4_AQ7kNvwHUsrfV&_nc_oc=AdqTsl_dUf73akZKxxZ0QftGMkwP9NG44ej8IlItUdCUtNOnFTra-Eg0ELp_k9YjRlo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7tJ4qvo4vQEbOTyqFRnFzcab94YOyWSG2dW1dSAydnQ&oe=6A68B0A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pYkdK_MUi8Q7kNvwFGjbXI&_nc_oc=Adrok17EfQ79KXtmlHhISRy6NN-NshtBps1-RSr00umIO9L1xGGs958tvRkcyw8wA4c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlRr5DZNbajI-jD5RAl8-BpOKPoaiyGATUps8HKchHCw&oe=6A68BEBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYnfjEzyU30Q7kNvwESt6su&_nc_oc=Adr7qQpvUYFHDXZoQQrI7X7BNhuS1ffnhKM9qmoHyd8KrwAkBUv419yrvk3ivj66vzc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjmYwotScK-R4Otep8xDyIRQEJ6vwbA8BQ4pXaebyfPQ&oe=6A68AC6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YoABidNCJuAQ7kNvwHN6jxK&_nc_oc=AdoGjCuHEbQn4xZB3fRXxoDJAG0jGyBB2tM07dVoabI7oonkYves8Et9LBmOAbtZ_hc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYY_E_JC-ARW9vUt0TOkOxtlvo1jNFJCUfOPyHqhtj2Q&oe=6A68B0DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=RQqaytWo4fsQ7kNvwGwDhIr&_nc_oc=Adoa4Hpo5N5B1Ix3HaQzF34DA2Y3G2GvfXD-4oRDqudqiQKGYNSFO-C5p_ClBWVhBk8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjeBkK3AbI35j8oSdL-Bn7IebOvwxlDDGpWHya_kiwSw&oe=6A661AF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyHHETOHPt4Q7kNvwFIjjE-&_nc_oc=AdqWen0DjI0M08NScHJ5A9FDIsnETqz-LHuODeqVF8zJk8GAYS1vtYefL1D3XPP6zeg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtZ67w-UhOOP4qY_Aq7GvWpv_hEM6Zi10YT5RlbCDk5Q&oe=6A660DA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pYkdK_MUi8Q7kNvwFFhDW9&_nc_oc=AdqnvaVRGexVwlTzAhYjnbbFbEZRlbQo-VtiYZloXxvPekeJOhe-OFsGFAiSiJP2aR4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBkTBwtaLR-b4375Qw48ljqvDI0UKnJ63fdlxdwz5217g&oe=6A661BBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYnfjEzyU30Q7kNvwG170Tc&_nc_oc=AdrvWBftbBIerJM7lLgOK_TskXHhUDdTZACiuE_YjdihDqxjnCi1-E8Z4vbo3uPvD0g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAxzwMLOiIIrI_tNiZk31w2X_OPd5jnVvNt9f3lzCSqlg&oe=6A66096D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKX7efOfeBIQ7kNvwF8sR0i&_nc_oc=Adr_BERgozBXVfekOc6cd9rSgzBJwXu_FLcaG7kR1TGp8z79-tQIVubU7FgiGPEFEt0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuHpSZpdT0IFH-ICWwO3spGafIyTLsu2yOuYtxCMdO1g&oe=6A660DDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=lUd5BNbAjMIQ7kNvwF0dilV&_nc_oc=AdpbWbJ_eyv0BaHt95lqvTaE9wTee7pV2WP4wuiwSRB7Ej6-7bcAk9DybfWbOEp1byY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qt5PvjZgz0WbJRHM5rQaJtVxgM7ZEh2z25REEdr8hZA&oe=6A19A3F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_lOMjsGsngQQ7kNvwF3dcqD&_nc_oc=AdqRZOXeoj3LCIEsUfHMgYoq1qT_XqcgMCW0DIQ_9QqtVi8xTvZDjf-ulAkoKnH3HuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T_9s06viG0z_yBSPlzljOugSmD64ACs9_aeomrGqLZw&oe=6A1996A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elaZ-Q5Ux5IQ7kNvwHTx46Y&_nc_oc=Ador6QjlVATplByUyFJ_2ZdK1X2foac-peG2ryU8vvDnaWYXs--bcrcSazX4WrIxQvg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7GPChP9Egu-iXH-mnyRi6W76Pb0jHr8041_KmpPqc8Hw&oe=6A19A4BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQomuqSSK-YQ7kNvwGk4vT7&_nc_oc=Adpjk4VNDM-vPSxk3LwMXIYzSO4bjkxm6t745Fx9Krf0gkMGtfNmCvPWqGQ0fdax4P8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ggqy1fLZsUNiYky7xBcYeqwZ0gCBAW2xpHxKpFbLu7g&oe=6A19926D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwHDlDBTOF0Q7kNvwHJuAv2&_nc_oc=AdogHTc3JtJVTqiozA0olEoWS2GahZBOB0g_EEzmioq5DQunfLvyRdXeWpb02n_8D_M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Oi_wPXUgCmd_yZuJKCZQ1fWKwVBDtt4qYBg5rHa97CA&oe=6A1996DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=4_rBf0g5hBoQ7kNvwG-YoTE&_nc_oc=Adr-VFEYDKnE1Wo-tmNk2HtRapOGTyUJdbHhJDSw-yCTbr7hDjCx60f2y0tne8Xs2OY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tOZaoP77gFSGKbGvyYoeQVvDG3R9UVs2wWhet1XDOtw&oe=6A428273"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WNhJZKpyZmIQ7kNvwFoP3M7&_nc_oc=AdqIxXSEi-_v7SSy1VE6ZMb-O0vwD95qDNR_acu2QpwCOCp8Euo0y1FjdJmEa9IeFqg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KfXKNAgW7QnlU_DHqxm8RwjqfNEPknvZhluKUXfGpkA&oe=6A427526"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcuFbDRhAtQQ7kNvwEKC9mm&_nc_oc=AdpKj7yVFuAGtAtg48zB089KscqwbQVDJ7-UGwj3mzlRLBuAgum-z1ixVm3-YJnjoVY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kChT5K2gX1t5WYSimY64HrU4vYYgN3rYmEHrc3K3FUQ&oe=6A42833F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyO4sJnhoM0Q7kNvwE5Bvgy&_nc_oc=Ado78Du9rLpiBqYo7Fj3vBURPKgVLqss3idLfnuS4rgRNCnjf0FrXnYPqxil4zgQpdM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92HNzMfOcKv4UcYsKJVEFsNpZLldoAYshGd3GC86HAqA&oe=6A4270ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Umi1OCaXeLQQ7kNvwFiuam5&_nc_oc=AdqAJ_VK1hz6eKIDe80lNT6bWb4glIzI5Zkhqmc0IJPAM4cojjA8OaiRYSihlw65DHg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fHp1y9vh1tSUi9c_7f4TtlHX4ZDXJ0B9F8rIo8bzENQ&oe=6A42755E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
oc=Adn7Fv_RLEvus0zqqEiIjV_xxmYOkNDdPIIKVjJ24jGtWuGZJ5B5lv56LJ5Cm72Ri1I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftzMjQXq7JJT0TtxnUfBXpISI88_AHAd1Txq32ofYEAQw&oe=69A80AB3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yPJ9xBnviOQQ7kNvwEkGWlB&_nc_oc=AdmGDJAVCxIgKmh68lxbmyxfTN0htn3IKSUxZrxlbpMqvQ7Xp7EkpDN3OL28tA4Tzbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvmWZ_dztGTl6EZ1tHxhJVejF5Urxp7uFm7D-iHOE1xrg&oe=69A835A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PR4yQByzJaAQ7kNvwEk9W7L&_nc_oc=AdlHqN580IjWYKz3z2QP3_akvPTYT23G-zhC9cwpe5zu1HJ2oM-sQH9q6U4cb_7uSaw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftvyKwS6Drsi2UYIc-_W93ZZnfjmazKDs0kp3Hx-nyDXw&oe=69A80B7F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I-lr3X9YPYIQ7kNvwE1uNEp&_nc_oc=AdkZ8QDeWPDL3MZdxoYmjM2iAlGTEwcPgG80-e4kLcibpQvr-l5MaflJyhA8n6yO1FA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs46Pfe3uLLymrCOAXmsKzh27mSCGvP2aw8kuTnpVa5iA&oe=69A8316D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llBQX6N2nwEQ7kNvwGFX62w&_nc_oc=AdmLvkRYaC4auV5xtQCP5TXDBu4MuxpurhmlCoPwQFEzJwUcgsYeNBOuT02-Z8dZJLA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afse752dJnYPqT0vIpqzaR7GzB7PI7q8Z31vHIH6ky623g&oe=69A835DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
_sid=6e7a0a&_nc_ohc=x66_2gudQi0Q7kNvwGCVxvf&_nc_oc=AdqNQ_luX9605wavCElrsJVkjBIIClJp6qCrD_VhQEsR7VUxNErPvna4x-BBcKvrjro&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0OdDC_CNrxE72y6CaQAWf100meh6Yq3Oajr03LF2_vZQ&oe=69F36873"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n2_kPfuFlU0Q7kNvwE8nzzR&_nc_oc=AdrMAFyOJ3ywtyi-TYGykTJWNEpQnbhRziugpeG81_2e2D0H-p5U7HA-LEa-tBWpfes&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af24ID-o8v_ytyGSBA0DD_KXhHyPCWGdcRE7N0ZE_qbQLg&oe=69F35B26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iM7-HDnhgYkQ7kNvwHrJXv5&_nc_oc=AdrA6HC5n14UcQS6Yu-jBAHcdnVXF42HZmxQsbRnxIWHa-BOrW6c9Gkbu-1EO-dOBAY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1d60mdsG5Y2RQCWWFIIyep01gcY0OO7-moEuWfGjaKgg&oe=69F3693F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sSjtW13VIYQ7kNvwFguBHf&_nc_oc=Ado8Hv2jl89xZvz1UkrgoI1zHeWaTBD0p9myflByXtB25KWdfCmC1ILfCxgYIVSNpHI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0zLsiBQC16zreOQh4uWX2VmmA7Kx3nV22fbg4vLIAJ7w&oe=69F356ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esnE8JvDsmsQ7kNvwFMwY2w&_nc_oc=AdrokP3N_krZU_n7t6ivX3YXmsiMfUKjNbLwHyv5Aq_F1xx5cLS0GSpMUF3TAZRh6KQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0X2L-MQGYP8Fb7lcsZWesXiF97-65M-Zw8qFGmVLfDxA&oe=69F35B5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
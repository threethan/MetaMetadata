_sid=6e7a0a&_nc_ohc=dttYfg8WsSYQ7kNvwHFimQS&_nc_oc=AdqZiwAsA9KbtTo9yuyf-XqDChI9m5aAZstumxTaMMJuSJ1lLyIeR5JZ7PZr64-BtxI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeijPHvCzk11SDQCVkyB13Tj-uasDbn7KN6GMObBpOdQ&oe=6A5CE073"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h0jKu0DxJ0sQ7kNvwHBdoNB&_nc_oc=Adqjkfeiwx5-0d29wWaSBjH9-Z7qbrGqvOqylTwQ3JaMAv8ZUHzDlyXwIbctV15Ox4U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCIhqAVTxij3Lb-umWNf3WLJkb9iq538_T7L037tgmeg&oe=6A5CD326"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWxH7E1NhWkQ7kNvwHYfua8&_nc_oc=AdrvL5yqO1_RMkPQemQ-AOqbGGFK7pK1b5qlL9FoWccfqnK6pubvKPy9MmDW_HOcxA4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBSrf34cGoeIr7mLiqr3c1Yo0bUf-yvmS9oMWubNQ-oDQ&oe=6A5CE13F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wbMHd8CTnGYQ7kNvwGK0ug1&_nc_oc=AdqRMQRb0_lziEYkaTRR12GcoeQbs0bNa0j_pI14aancsjZHAPcLDrZz5uSjJweofPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBq6rO44dnhx6z-kU94CfuwvWNugKXFr-POdYWtGQ_gEQ&oe=6A5CCEED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=adFOm6bOLMcQ7kNvwEj3-FH&_nc_oc=AdqYK7CDz0JJYjogzKDsA8HK6936k9fuwQR5gRfImqSQ5vJtMX1Lt2mN7566bPODzwM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD93AZZKCeKAS66TkTZBKpEqKLIYkMeNipdbfMAQZWeBA&oe=6A5CD35E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
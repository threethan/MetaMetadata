_sid=6e7a0a&_nc_ohc=L_mSKHVhZoEQ7kNvwGgr-Dc&_nc_oc=Adq-oen7CGFxJOQv1OV-1jZCvVObPNZcX75PGz3sMGRE7_yQp1B-c6d4LqOINo7V34Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKs7lBGORAEwQh4MUprJ5oSoos90vbw2vw3PACMjA2RdA&oe=6AA6B473"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gL-dN7iCUjAQ7kNvwE7DnQ4&_nc_oc=AdpAUyCss76EwQc5JM_gjY4zgugN_p7q_640BKyzwVMUJjc5xh5jsBP-yknuOLGuQuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0A4Iv1WRQmDUPgJYkzHcGrffNi776tTFxe_zYUTyULw&oe=6AA6A726"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vplGXVSb_rkQ7kNvwFYlqQi&_nc_oc=AdpB3EwYk0IeB6sw5boBUk3yIekcQvANjr1HIrF3UOyB3uQT6xfBTJAWbsXReL7Qz1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEq00z_I6NDIZ-gbKARpdyzdQWdVJQms10Axw9Uw4Q4A&oe=6AA6B53F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LcaAsRA4IsQ7kNvwGw1mEI&_nc_oc=AdqYhTq5K2OtcEgg14vEvjGt0LxcIciy5M9ouu5n55yNMa5Q_UqnLkxhQ_-hnhovgGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRKeHf8oPCRvM6oyaLquYkGYUXYY4ZEQpjbkGVIL6QIg&oe=6AA6A2ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9MHawkfnO8Q7kNvwFnIwN5&_nc_oc=Adp07tzAe6IbMDpML9VoouPJzhto_5_VcSTjkFUs5ibPSb8RwW1rfGN8zOtmW-PDeiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTLJuVo2bOPNK_FdOuV8TDeuCDRPpvb662N1zxqHGBBQ&oe=6AA6A75E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
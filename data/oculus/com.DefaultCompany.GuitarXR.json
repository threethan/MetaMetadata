_sid=6e7a0a&_nc_ohc=G_bYR3y4P-UQ7kNvwF5bIdI&_nc_oc=AdrfbWFoMOFs5ZpgYfkIb60cqenEO7t_5C49VRZAj0QEmBBltVBjywFboQnJfGLsbA0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2b3hotuM8XTLtb6mlrXVUsT7BJREAsjHsn2GV60fNEsQ&oe=69E8DC73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o6ARQ6C7oCwQ7kNvwEamHDE&_nc_oc=AdryhBA_3jKyxg-O9k6HNAkAAv32DKv91ISya9XCahbT5g9PVdd11BCOLFHxHeO9UGE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1otXPUqJLsUCvqV6vG3Ege_9fyH2JWyTF8AEHY0DrCxg&oe=69E8CF26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vQFCn5d744MQ7kNvwF9AIST&_nc_oc=Ado2q479xIJNYKyOdWsc_kplrHdSz-rOARHD_WuCUIx351CSp5fjVbQ6mJlFzZPjw0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SduyNasQjd32y1yxwf9qZxyeG0kpi3D3j6BrgN1eq7Q&oe=69E8DD3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h-SrVYVR-90Q7kNvwFkXbGm&_nc_oc=Ado3GGJwAR4aDAN6pWVMgOWz56C3wY60PA_8ods2qVOpKvjmD-pGWIW8nD0bbgn2Mwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3npKHuMF8Hsks7kcriLP6N8Hc4Pq5-4EVnsAGiZvGR4A&oe=69E8CAED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQzQX67GVZwQ7kNvwHNl9M3&_nc_oc=AdoDZJZFjBlnolFDhueKH3VmbMZs5y56Cebv1Zq5G8-QdpYO0Ulc2wnvayg3fQFeq1M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NOUiCwPWV_mdZLv_Yu5pXhPFwMcD_ILrygLT8EcjM-g&oe=69E8CF5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
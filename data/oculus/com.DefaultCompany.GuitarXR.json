kNvwEtArRL&_nc_oc=AdnrWEET5WFtotjQJUPGbuiN4V3Hc6wMP4vdf6Fx9E_fungN3U-ClhSNSuhZlF1vgh8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGIfN4_-n0f4jNHQQJfiAjxXmYOLrlSvIxwPra26y2zw&oe=69B2CFBF"}, {"file_name": "Untitled design-65.png", "id": "1931969893889271", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982469_1931969897222604_8530448425778764889_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdgLB5K8isUQ7kNvwG0yi8n&_nc_oc=AdmvT2QdJeaZwfszHc1P8TZCawWc7GsZ5M8JTn2uvrJnhRDJJXzTxDEhjCPBTLzeBxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afybmqc_Ik0fVy2ebg7_rixr1-DewRAlkkJ4j4BUQ9njOg&oe=69B2D183"}, {"file_name": "Scales to any size guitar-3.png", "id": "222599974216860", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/65228806_222599977550193_1783402009710633868_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjcUN7phgTwQ7kNvwHCZqeV&_nc_oc=AdncGpH0F1el6LyACvl0zDYOptK-PAZXsaC6-EI0uoVPPIr-0FCGK-k2KtQ5W9XNSWM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw5gxpbbT7TJ4pv6iklMJj-mCq5qxBf7aef84rSY3mcaw&oe=69B2B4FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEKikLbQDykQ7kNvwEp4rcj&_nc_oc=AdkmTDHaPlUxFCD0o068hf6FS8FKRDJTjN5ms1qlJg9tNXTkjd_T46zZaKI6NiDb0Ww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwud0Lv1Y-Y8NNgWxtg0Njvw1fXVktFXJkSYaiQsOUBtg&oe=69B2C1DE"}, "display_name": "GuitarXR", "keywords": [], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Oculus Quest 2, Quest Pro, and Quest 3. Discover the art of guitar playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar!\n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to mastering the guitar in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else out there. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7203991549657867"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1034465598258009"}, {"status": "PUBLISHED", "id": "839022478236682"}]}, "baseline_offer": {"id": "1034465598258009"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1725568260, "status": "PUBLISHED", "id": "1034465598258009"}]}, "liveChannel": {"nodes": [{"latest_supported_
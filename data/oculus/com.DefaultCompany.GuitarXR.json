_sid=6e7a0a&_nc_ohc=lwW5ZBngBWQQ7kNvwEFkhlj&_nc_oc=Adr3ttRRShc38Is5bJrNmhncOack9b1_x0U7CWSL3Tt3qBdv0KiGUM80l9jCeOgDhwI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_El3HAyt2MfJYRmN18Rzpvdy1P8gMPJCNeDnkTuhI-ww&oe=6A37F673"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fleHY-3UKwQ7kNvwF8VCAh&_nc_oc=Adp5B4fyTVWvZIpwaUAsCW5jM1NUgwsGw7nm9-cKZKl8ssNYMeZZBieIiQ0pwOt__Mk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Sfxh8oeUNlCC0L9wBzIifEIle7Tuucxy-GvLzpPtpJA&oe=6A37E926"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsxdHAvu2UoQ7kNvwH2oS0Q&_nc_oc=Ado8jC4VK5l4MKBSCFZMljviGHAqwkjCj4OTer6rLiqP5QxH7Ii7DqJqjFcL0bhUlAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iQhsuBtLdbvEtI0VxE9UwnPLIsym-9Aq1WiRSyvClZA&oe=6A37F73F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXb5-Sj_rDkQ7kNvwHPqQb4&_nc_oc=Adp7DJCUO4eJ9YZIRiKm_sUijTD1xCTO9ifRyxoH91fPAj2TB0OE8vHEReet2eRoCYg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uz-q2MhWaUymPLcJtmzUtjkZC0yT3XattacnZcTY6gQ&oe=6A37E4ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fDRXpJuZLkEQ7kNvwF0WM1O&_nc_oc=AdorwNnauNHZ2pxM-ZXxgM3Ip6Khc6f7NVl51oAlIukr0TQH4ilCkVppsQ9UuPOaz2w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_umXx4RDn3paSEEvvDKEtfuP5ZMvY3NlLhfMWmDJCt9w&oe=6A37E95E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
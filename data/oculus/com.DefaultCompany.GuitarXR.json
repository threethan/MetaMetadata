_sid=6e7a0a&_nc_ohc=RYbZHEytmG0Q7kNvwFAbGsE&_nc_oc=AdoxkgCZBjkH03G_eVCLPMRHg0pqb4QR-Fue-eUz5oJ9Ix5a3bITtPuGJkPL7ut9yEY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5ocmbh-Bl_UdURYL0SjGcdQDmlT8wsDm9cEfRPHAukQ&oe=6AC65873"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QwC570GRHRMQ7kNvwFYa4mB&_nc_oc=AdojuzYZrSCwXc5cLsuIpCu9ujLLfwjWhyjBPRisYwkZQdiP0YdRntdqFohgZ8xYZuM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOnB9ZAzP4lRfwiVJl94rbAS5RTmn_MN4xsm4QSHBUMKg&oe=6AC64B26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lWUZkpsZmkcQ7kNvwEB_AkY&_nc_oc=AdoDWHvfTdg_RngkgsHdhngkvX-rJhSAFXc_X6qXWQPaOW0AF-LQnpWHjnRzdaBCOV0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvF1EDLr0_aNF_xItepscK7vPMaAgpb2OGPalQ8HImlA&oe=6AC6593F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y9PN_y_HTcQ7kNvwFYOQB7&_nc_oc=AdpCjbrW4zhiYkBiQ42btb9EVzcIPoV7HDx7RYVyhnuCIEZ0VMcE2czvP9qzdb-bNUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyiW4JMHUDQKupTJGxK2oPvTEqH2dz7n_9qKNozqOJJA&oe=6AC646ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0fqV7nyk3rQQ7kNvwFrGUsz&_nc_oc=Adrwlb4bnSEK323pbmFdjtG3ph_JdIHvu5H0dYS8D-0U_BDGvZHt_3pPcuJfoeNIlRo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMWwXs9sbu0S-R6nxf45kVNUo25_Jrk_RTfFrIihUiJGA&oe=6AC64B5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
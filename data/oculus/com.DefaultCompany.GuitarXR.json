_sid=6e7a0a&_nc_ohc=HpiQ8ora2hQQ7kNvwEXW_kz&_nc_oc=AdpxqObWsItSmAk6EZiLpYq7kPnH6J-tjZVeDCACq3WfZDesp4paLlCSAqS2twRXQN0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yrY_uvYs_Y4R4ZwiFmrJMFdQ8DjoJtFz03xljUPixYQ&oe=6A01E8F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hj5kpq5hhpgQ7kNvwF7Ez67&_nc_oc=AdoJZ-1dEGjzxWhrX3nAeNogMLW455rvw5DFhBV6v_mMN_pbc6jxzadvv5_xhr0uy9Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40vxO0gBGhTYNmJUnlvp0kDY0mckcFlrtfeIyqNNI1eA&oe=6A01DBA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRR6TEmFc_cQ7kNvwH7_kBP&_nc_oc=Adq19W3V-n2v73jzq3yrhezf3xy3nwhVlHsaceDRpmvX_I1DsXh7QsETxEQeTpFDTCQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pCkxU-ekWsKwFqObQbD4YRYxxZIpdo0V7Vh5KMzegRQ&oe=6A01E9BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8hMbNz5RmUQ7kNvwHJyNmw&_nc_oc=Adrm6sS0ND_Fuyg2zwpU64j-TDbdL_bFXsudZZVgdyyxnO4oGeiD_t87b-KoU_aOSYs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-bIwLlI7U6yQEEsOsApDxfzZriik1y_Duc3kRo6waqA&oe=6A01D76D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWngAItjVs8Q7kNvwFVFH3K&_nc_oc=AdoXHUz1VOIQAkD-YF4VkUeuXFvYifFrcFEPxz4jwsQ1urfLAW8yheKbeAo2rRNrXpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dx7yztCPi5dV-ol5nWKpiYypT4C8HsXjzstgkNkSkGA&oe=6A01DBDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
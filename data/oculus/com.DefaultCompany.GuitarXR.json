_sid=6e7a0a&_nc_ohc=0tckTTVR74IQ7kNvwHvFYUU&_nc_oc=AdreI6M9AOyCamnonSyKz79wX23apEi8Ot8SUIsaXzMxAvsoj2oGofSEl8Z0gSEPDjk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTM5b8N30N9D3DOWJqLrJ6LlD1pQLiwJwoB00ZOQkGAA&oe=6AEB4273"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h39sMNfxlSMQ7kNvwEZhIUG&_nc_oc=AdovuPolNNhJK3bF6OA0OwN6XoVgRRHDRqh3f53OH4sjkfF-lt8t4QxR1f0XS2eok_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-EBiaMiKUXz95vJJ8kkJgeTwC9GeTLOOrUnZAfY1wCA&oe=6AEB3526"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ujb-pDw6xNUQ7kNvwFjcPMf&_nc_oc=AdrOq7uVZpIT66_Q-F2SPw-rw0U14sCOSdUF8h-xOtc8hcByPyWjNFMHLuUBFsPDZas&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTAzL_nrwqFAz5tDvHSDWwXNmOu42i-j1uw89cKPobFA&oe=6AEB433F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4m3SQ4gfoxgQ7kNvwGrtx5g&_nc_oc=AdpzMbJzq1YB05dedcKVXtPNRVyf_9HLKlql0Twt9ZiJizt63PVZ2GL1TWRhdo7Fu9U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB9qkTSPSlBM91h48Lejmz7W9lWSVVpGU-hctL6qkBmA&oe=6AEB30ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G95cZ3pjuXgQ7kNvwGrhOIv&_nc_oc=AdpcDaY3QEx20KeSepNUOj5iQ5vbyOuaQm1D6bePgd1pPbkfldTMkEECoxLzm5g7YHo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTt__NXuZo6xcL1RlOXm_XqTY-Xodf4g_EgBBgvXoTv4g&oe=6AEB355E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
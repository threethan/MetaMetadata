_sid=6e7a0a&_nc_ohc=0T3VmL59gXMQ7kNvwHtRYAy&_nc_oc=AdqlwX18BOZTl14rBus6uOtZQoll97aIA7OMVeJ1PNRa_PKwQ3NhbarQLueXFaMIaKM&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cj1hdiIsns8Zuxe8BwDEBkXN4niWCOxwAaYP8z8EAlQ&oe=6A2C18F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f51RHuVA56oQ7kNvwEl0nSW&_nc_oc=AdpdlAmTIa8lZ5MUhuBDe9tHHJBJXHGClbnj9lbOqaySQhHkZTF6Nz3kkxrywTPxD-w&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MbR26F3jnp6T5Xcmn2_fvXJ52pNFV9Jk1jLX9itd1hw&oe=6A2C0BA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktFW7KSwpMUQ7kNvwFvldKO&_nc_oc=Adp0obMtjqJILH30g5RV3DP7COyNn3wAg_0nWSG4gyZXETN6FqJtuDankndnNhYgaX8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yVjm3xbd5S7oEtLX7DlxEQfTe-80iGVPUkQ5pyDsa9g&oe=6A2C19BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqP2d2DG4AcQ7kNvwGbd0HL&_nc_oc=Adol2tk7wBrmNZN2Pw5VnycYkJaVezE71fXU8gclYSlF8RBPLzXVKYgtEhHZSCqGtKs&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ayYTFiQIH5REo_JhKFs8ThpNyyM2C7jmFVSC8ambkWA&oe=6A2C076D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nusKjaBS_-oQ7kNvwFvXt97&_nc_oc=AdoAJIPRI34MakKkGZi3QDXLXBtdAmIuiFsACQO3PvzBysP0PLriVhm0YutdokvzW_8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7-0-Zqn1G0w7gn5Fc51QvjZghcXDtg9TfoWbknQcfvA&oe=6A2C0BDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
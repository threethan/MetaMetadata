_sid=6e7a0a&_nc_ohc=520saUP3tuEQ7kNvwFHHeSh&_nc_oc=AdqEU0gh4fiCsNs1L3cI00_4L6I8OfOhNAwopTZwwcGnTKDD9SgrQI20tLQS96csjmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITRViMgYG3KdTiAEf7-EWo6Lhji1FVs7qCa9yDHNpzIg&oe=6AB7D7F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5fdcPBU4nFAQ7kNvwGm5o0_&_nc_oc=Adp2xWnmJ4OqiSVBiUsTUVS4-_ahilGCXkYfgM6ACFtUMP-8EvDOxPYOlcRAMH2T9nU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxl4qmEpIkcljJhACSEc5VVAr_8x7nt3VbKIb_ip6eAA&oe=6AB7CAA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZL3E7oCUkYQ7kNvwHbnyk3&_nc_oc=AdpiMdDW0CD_zrshAj_e_YREFsUF6Dy4Wtgf5l8E657c6pI3QF259qyuhd4BmVkBtd4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzBrlD25XeMOFqPCDjDHGR_-dmN8Ot-pEWBwcsJP4wpA&oe=6AB7D8BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znwvj1D-nYIQ7kNvwE84QAa&_nc_oc=Adq-0sVtm1dbjEwMxWwoX2BRYc1iwRQHTaFf2bQjPQVHlX4pd9LTkIV6n9ModMtSwao&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI8MrBiNmofFbo473r2OWKcMnao6niuZEyw8sj_fuizrw&oe=6AB7C66D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jPLble6og9EQ7kNvwH1Td14&_nc_oc=AdrYHxYPwZ8iQR-soTGLnWYH6l8xqu_QKvKzLuCX1Wza-cYbKyzMsiFBOyYskDQQ0J4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKULtnaLbDIrTYuNoEhYkq2qmrSHC41ai6R7zazO73ceg&oe=6AB7CADE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
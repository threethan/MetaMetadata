_sid=6e7a0a&_nc_ohc=J5kDsAvT1CkQ7kNvwFaS4mV&_nc_oc=Adr6nhVclnjMNAFRvwbCglJbJ9XMGui0fM1QpQxANsvLIIAgwv5ndWmxdia6Yr-YqfM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWLMru3y71AykAbILa9VVks8R8zTlJ37JOUqXL2zASzg&oe=6A843533"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PWeajwg-tkUQ7kNvwEG_Vkg&_nc_oc=Adr-8dS8BRo6YCIQ-A3IX4lxaR_FG8p--jYPZF9POc2j4-0HVKK08X1TKmdGJxoHxJ0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcyvx-bqOuzsBPxyqgO1FGDa2csKQZ8R8j7IPCRzMd6Q&oe=6A846026"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-V9mgGZtMHQQ7kNvwHDZtMw&_nc_oc=Adr9R99urtBA-M3lUiANcg9qZ0jZFvF9gx387G1BHI1YqC0hwRDTZbVCcnDZbNDNP9I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQXtRid6yUlbd5hK8hyO54stY6ilrKsBXNt4Y6TheA0A&oe=6A8435FF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYIyrcueihsQ7kNvwGXAMNG&_nc_oc=AdporDRVp9l-gDXWb6eMfJIcDHNjU_NmIyjx1agLlYB7aTBh-yd7FrwmbnLsE_GGsg8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqE5xn5Omo-9q6KZ49q0Y6bh5mxEmTm5NoLzp2o2_emg&oe=6A845BED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPDRHDxcMqkQ7kNvwHBRv-Q&_nc_oc=Adr1ondMR226EV7PilaldNZhdFhIQttbDav9O-D4xlO6m6W6955kQgqPkh8JOsr3Vk8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExfhgDAH9t2oCppr_m89K7CDcQFcWWyXTjvtb3q_xQWg&oe=6A84605E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qk8fouV7QosQ7kNvwECj53O&_nc_oc=AdrJvBavQf8MRgUPLs_jo5jmnsbTHzKgnCP7knTNtPHDxwBPRzw1fVT1ujDZicgGWLU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgCu9keiuCcRZyq9LiYNd-kvPJ2doEIu7jv37b60QfLg&oe=6A7D9DB3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otlQxUGFExQQ7kNvwE5X_UK&_nc_oc=AdqJ3tnLiTPUnUc_X3WANmNKsGjKNgRjtTjPy5bT-hsqWTGQtWD8-1CGTk4-ITqTOqg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIYlIcrmf3QcVkMFA9qWMmkqWEjcA-pIHLHvg-oHEXTg&oe=6A7DC8A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfaHNfAwOhAQ7kNvwF-mcCi&_nc_oc=Ado1LLGR_VbWBGVBA19rEZFM7hVmzM00ACbkgPH8rDm9_yG-yvO9bdBFpdQZPxhSiSE&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvhxfWrRaVLFhAgCyknDMW69xG20WzVYZeJNDCC8x-Ng&oe=6A7D9E7F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KZZ3hxLcc0sQ7kNvwE5mslX&_nc_oc=Adq53_0m26RwGH_kNAZZDkttYcSg9dJhBJ-3wgUX3YoCH5pwgRRr6qeEOe5fytVUVQI&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2mvufA6QknLldx4WoUWteq6itmQyr6XIivmdiB8RERA&oe=6A7DC46D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj45Dwy0cpUQ7kNvwF4phma&_nc_oc=AdpICF3kBkntpFiEqqTfF8JmcO2h7fWALuHE72EFvCozuKvbzz3Q_QfWwu74nU_DR7U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEemLkXp-AQyqVrmz1PnxGoB7sI8Otf4UktsCltSel5dQ&oe=6A7DC8DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MO
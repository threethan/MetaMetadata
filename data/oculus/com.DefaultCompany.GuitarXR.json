_sid=6e7a0a&_nc_ohc=QdhUjkL8P3MQ7kNvwHs7Qhs&_nc_oc=AdpQIwIws9boJSzKq927G2z8Gf0XoYMy8tYZXjAqJfFX3BepTplI6L6I8FhijiLOT58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__TFXHH-hEwOzul2xpO9vqaW6IgS7zMi9bebSVQpPiGg&oe=6A47C873"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Txr_OVk9HX8Q7kNvwG7rd_V&_nc_oc=AdoWprO5EJDzYwlRGv3xvUW7aqbvH8vD3ge5H7kdel6t-aUAVvLr6P2T8F9jrbl3NYw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XZld-vCmuYIMvwA-HJo3C_7kj6gk6TjOWkD215Vzg6Q&oe=6A47BB26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6-Hkn0QNBAQ7kNvwFSbMsF&_nc_oc=AdqT0e1wwYgBactBkyQ7ZBgSWNRIHDQKl15tlpWLHVFt8GACKTDhntDvHkzPcDSmHo4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-md0yMd-GDFC2xhYncfRdwDthDW_0U-ZC-VodQACWqDw&oe=6A47C93F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXr5l8bVxvUQ7kNvwGvJhhy&_nc_oc=Adpf87N3TkouPKD-DUGgzG3_YNfUO96Bnj3u3KAXk2dmhbusKX_-4PqHJE8vEJ6-z-Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jQzPTOXiT-2YDqIpzscitLefy7R1DKkBR4ca2qQewzw&oe=6A47B6ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DPK3bfIYS_kQ7kNvwHtQyIP&_nc_oc=Adqc6-HZQ9KnQkb4RlsqmlE06kgermakbqoC4XAfyxfxJzRBT2gc9yJ6WOTZD1JV3kA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OHBtATdRV1Lk_IRQGjJQBP2FpY7M3l9IqFjKEfY19Og&oe=6A47BB5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
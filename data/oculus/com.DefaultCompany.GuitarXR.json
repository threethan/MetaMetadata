_sid=6e7a0a&_nc_ohc=Sn3KKl67rscQ7kNvwHW6VIF&_nc_oc=AdrwdBLeKt7xmPLjk6SbqjwCZDN3FoWvvYG8Ng5T4rxqCkRiJnmyuNB2NTNg4dZpFCw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhmPC3QXnVWtxvT6g-6rYg3H8bL7WtviDty2xPxgp5Lg&oe=6A4FB173"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCNjQyzphFgQ7kNvwE-viMO&_nc_oc=Ado4eBhgZsy2Zf12DcOaAK0sa6ZsNoA4nR24J0-Jn1d3EOwHCWQ3VElCW-U5V10Ffbs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDXPIyF8ZdipAGMSUeHXBHZRMRYI6YUcASo0rWZg1PNw&oe=6A4FA426"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoLRH2goGZ8Q7kNvwGs2YvQ&_nc_oc=Adr6HIc0aSvAIZH5VEuwttoYTSj14wBH1USISFXqgrkSh2xmhN_KCAdIhz-uLCmMCvY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDf7joLLSHx4Wr4SLjK3fZ0xumofSeM0iCsCxU9r1JxOg&oe=6A4FB23F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ht69jSXrkwQ7kNvwHZsBMo&_nc_oc=Adp44KMk6dPlNvNGwSqBYtuYIS6dIXLBMHSe7W6O6mUUEkupoTilmgCc_SJXcQ1BAQI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW3nu_IGHcRs__D8_Itwqf4Nrw7OTwt1A-3RCNbabwcg&oe=6A4F9FED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yV_VDUrxRwQ7kNvwGTFnUA&_nc_oc=Ado3ZYYyxMfh5nXK7_zTSxobp-XEfosFpyYSua-pwpDm3iq__1x9ekE3vIOjketusmU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQ9mp8PoZKOeZ9mM8cKZqdNDDAPM9jyJppPrQ9ZtBSWg&oe=6A4FA45E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
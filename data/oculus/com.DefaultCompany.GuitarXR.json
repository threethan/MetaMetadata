_sid=6e7a0a&_nc_ohc=HQbZr-yWWHsQ7kNvwHNMuKW&_nc_oc=AdrS8eh_LzPA_59QqyYBoygk_GI9_sQixT4D10oPXhY4IuM_BI9dnrUwr2fSGi00TR4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS_KR1Ep8dDbPznKpLWsm3Jhzb79v1XCq3qZtYCq3neA&oe=6ADF64F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVmoILdw8YUQ7kNvwGneD6o&_nc_oc=Ado37WyTHmIt_ds_ED490MS-EiBWIazJkD-N4PeZtFm94dgrZ9f9jF0LGcWaFVOFa1g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMgq8JMM6Df44UEJZmTCdpG1Uf7QyRsfwmFXxlIXoY06A&oe=6ADF57A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOTP6nLWxWYQ7kNvwHAL6sn&_nc_oc=Adqh8YFhlMVmaOgQywOCHpDfv5gnMUV-Zzcj8FJq78GzVeIbV5dS9s5ej4nRNJDNMy4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEu_iilxuWMAMMhPnQYOGUQQvvzfo_h2OlnfFMdqeUWQ&oe=6ADF65BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKxxdJO-X78Q7kNvwFHNZly&_nc_oc=Adr6TjpzFv0mQiTIVDm5bw2ICGKFKTVeDwo6rFppSSJUlTS3xUKL4BzA6NrxEbnZfJc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTXWEg5LnYEVZq70myR7YU8smBShPBFNxTPVfhfCMHJg&oe=6ADF536D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcPyokGD2oEQ7kNvwGmN5zw&_nc_oc=AdowFaQj8ziR7HNZIHli5TTGRzVDF1w89N5qJzrRGlHID-Yf5jT6rmgFbQYvz7rkGZI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSOVWDuoeVMypVtFBypffZRvnYXFiEbhtaC9Zit1FTSA&oe=6ADF57DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
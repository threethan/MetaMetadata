_sid=6e7a0a&_nc_ohc=ua5zc8RPH6MQ7kNvwFzXk4W&_nc_oc=AdrIuFAOwS9OlYDaNx-2dAtsSp26JjFsdPwvU22ftdJaxmmcZT0P_uPXrXD-HsnjykI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71NaQZghw_AUdkoCKbCVJAE2x6hAW49_UjC1lKBAWKbQ&oe=6A130C73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0bVRpneMmoQ7kNvwGmYUqj&_nc_oc=Adp1go6DCU4-VNqkJyS6FA2OPVZDUyvZtrEiKWXO3kNMBziTokTUdgoGRQ6kZRuggvc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5_XUkwz3X9_M6ydJYSZRbM5TyVmNNpGS_rNt-8MAxYYw&oe=6A12FF26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uK3EEBCnDs4Q7kNvwFGCDVX&_nc_oc=AdruCAvylf3zM32HkUGLyXlYUdKGyuQOyma5M_LmUlG7lPwG88IuPXBMF7EwKWjRvm0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46apGQ6Cq58XIT14MRslPVrfcFcRgNssY_c34nZI4glQ&oe=6A130D3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckdOazuhHvoQ7kNvwEYf9Z-&_nc_oc=Adp5CoXtplz0RVGqYuA_VdAbbx6SEfILBEV5OFwmUQZf3-ETfNKvZ68DDBow3g8ySDk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OMsVBYCVay2aKZbi-lqlgy9iNcNSL-kWhKW7XFQrtmg&oe=6A12FAED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zniq1BQGQUgQ7kNvwFPSljp&_nc_oc=AdprsTi27P63q2-aq5Cvt3S66SY_2OavAFkgqWxDdmTkUPMrV6VV8Dt9VugIQ3qryNA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HKz64gjPyxnFCSj3VzRgVHl9ZxIwDAgpoT9JG3uh6Yg&oe=6A12FF5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
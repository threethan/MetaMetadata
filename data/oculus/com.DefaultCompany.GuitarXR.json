_sid=6e7a0a&_nc_ohc=-INL69SDu2gQ7kNvwFT8yWj&_nc_oc=AdpWneWW3JL4uSGcm-cEPzex8Yfs--5vy2jViAeVaXdlJYSiQsEXSBQH40dZiDeO_oo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HU1e9b7CpbwZ-PeQrQ6DLPAH54_CjCyuEBG0F3CkTHg&oe=6A05DD73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbZw5Noj1OkQ7kNvwGTBm99&_nc_oc=AdrI-rfsJXejfXq3DXhBPGoedh3kO4JnYt5CVy4xQJCw2WP-Efc1GjHEwt7MVyziDgA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JMiDcur_zAE-ifLJB9cPFktCkgFKGZg9k4Ox20G6vlQ&oe=6A05D026"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfqKg4DKQVEQ7kNvwEGZv3h&_nc_oc=AdqVFA1IB0LtOOgfR3mczOG4-Uv55KAEPR5O-pNfNtBy2ChJNl-FcaOMAu9HUKY6Qxc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5NH6UKtNC3MYxgWLBUz7nbocSODrVRghQf69GFuJ44tw&oe=6A05DE3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYBTs7dyfMIQ7kNvwHwpi02&_nc_oc=Adrsu_NoQynueQkSNLpcyPAj9uvQ9enpI0Kkem52Tf7WN673fULW85y22PN-I5SN3kU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DUJdCwpWAK7tHEGdeG4Py0UDJrfj30mpgRXDDc0mKrA&oe=6A05CBED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ__5OskLUwQ7kNvwEJ6gdx&_nc_oc=AdqzRiF-jzMiL8sYsfpdtBcSN_KFnaYAHdrK-baBCFEwPpz1gINn1mns5hCWxFtGttU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jYkgbuz5vCf72zI-R4-LgSOCJjhgnNdXk4HPPza-ctg&oe=6A05D05E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
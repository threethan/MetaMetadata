_sid=6e7a0a&_nc_ohc=Sn3KKl67rscQ7kNvwH2HpRQ&_nc_oc=AdpZJ4Tz32lyuPOcwvjIaB2IDXx7SjYsemRgxldaGtP7xvHFozdZvHIyelOCsp1UHDw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJFNHSqNnzRXxyy8LaPPikBKdOSdf6pLrEePMzXYQ_8A&oe=6A4E5FF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajp0FgbJrOsQ7kNvwEP8-kq&_nc_oc=AdrRq-lv6yh0H7duWvvg0NhbZg6XxXLHKCzj1J6amcWHA4aT6O7G6LopBdBSM-kbCXE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8wSQ36PzayEBuuK2vV9N-UZ3BoEJvr9iyCOOK-KjZJQ&oe=6A4E52A6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoLRH2goGZ8Q7kNvwEF5YLN&_nc_oc=AdqXUylAYQ4vSRc9fzynG_OaIB_L5VZdGez2-JyX4qpw31xMB3is_D4HepHw9MJDvus&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3FYjuDOqrFpRtVeE6HwKXEyKOoiiGQbTVnNjVH8RpRw&oe=6A4E60BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Ht69jSXrkwQ7kNvwHSA42k&_nc_oc=AdrWYRlXy4LRlmELP1A30NH1K5r2hQAO5BPfbk8bKFbhYBmYxPqy81hFaoFNdYiELio&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJwtMWjcRM4ecc9ej0UkEM08yTGF101PvSMEQo5hyWgA&oe=6A4E4E6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1yV_VDUrxRwQ7kNvwFxZtQ_&_nc_oc=AdpQD25duXfX3CsRfY_1d14bnYq46S8hqxzHLhXEhP3MET8k76g5EHUTmLXA5BDmltw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpwKP-NxNbIqzbezJNg8Zxphg9FUtsJWZ98BorxiqbTg&oe=6A4E52DE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryriT4O4MKMQ7kNvwElqlYk&_nc_oc=AdrgDkKIavaVfFo1E_MxP6tDDGflHpqIh18rw6u9R6pOAY_XeRNXhGrj2hlxrH7zrxc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLD1IC0U8wIJYRkR_1A0YZMe9l3wPUdveW7Q9M1CDVkfg&oe=6AA41173"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mq_y4oAiSWEQ7kNvwGzTi2g&_nc_oc=Adp7IhlJ1PrJXHpv6sOUVS4WABaZTiNCdlGfC4n59laCRSFVNxxxrFFqvATyVUkWLaQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgOE3YGfCwOukKpjdog3-ZpqNOXMg2e-Ur_KcunG-6rA&oe=6AA40426"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqtgbd3U3h0Q7kNvwGtuCRB&_nc_oc=AdoS72lFy0CHu-3aw6U5SIbiPIYcy2xt_SC6Ae6BemT9J3gAWcDQN2N7SG3qsMpz8pY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqhQIKKo_GZFveUm6Mm8DWKDcGkaq3qtga7TDExFOSIw&oe=6AA4123F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rDqYQRvLzkQ7kNvwG9IkUg&_nc_oc=AdoVjqk-gS71trzhjnDIwXKbLED1qS7Ad0gPYlhgDi9zWuDfQNi4syWQcVHjBV16ZlQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC7jQBPV4g0z6Vq2iqpGHtSDxT4Ru9NhvivNp_HNfN8Q&oe=6AA3FFED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p9MHawkfnO8Q7kNvwE5Oeb2&_nc_oc=Adq1EyQY9lxeTR3ErO6ABqrHulOqeqZfJ23AXwbjL968rSFf5Jrqw6_OLw0gJTJJ8ag&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAybSzMBhdAL4OURD3_lxQNiSQmKHHCDotj5lPU_ou2Q&oe=6AA4045E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MO
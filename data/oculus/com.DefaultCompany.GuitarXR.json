oc=Adme0FTFUzGRtl4ZTsdL5iT7qBlnhVHnHs-ho4z5IAZ92b4zWJvdveieiqeP8pO28jY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzzx1novVsIel4-08jLzPDY_RNcZ8GjgAZKX_n5SwQOMg&oe=69B68B33"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67FD8alcSMkQ7kNvwEYYWh5&_nc_oc=Adk19CQY4v2AyycXVdPRvo0KrlDG6i_6E_cQa9C7jr4C8YM3kSN5fTcljNRA5vUAQcE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHhTrMpvHyiEIuEZE_qgtFioKcXz5NRFr9gnUbJGtjhg&oe=69B6B626"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EWgOBNLTHVUQ7kNvwHYCvvc&_nc_oc=AdmTMgIMcZn2oKDrpn4rL7yjMMvtjy8eXzxFr7cQih2zDvrBRTRuuWytPDnor5Mi28Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfydhgqWMftmaDLRtexLe017Bh13xvkHi1ZUqYXNukMjiA&oe=69B68BFF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLY0qwiOk7oQ7kNvwFuGVvy&_nc_oc=Adl_3iNImeYQYEbXPlcOoMR61oMbN9f6HPqBRS6zALFNsfFN5fzeEHaWtm_mwPqYoqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxSOUIPhQuQBHi9Xl1tbBDXzYFJNizH59_dNmzJsGqTPQ&oe=69B6B1ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfpUtnccqZQQ7kNvwETbzgv&_nc_oc=AdlCU3TA3ieC4IHsDXMq6KNSwbkhTelK02sEkxGvQxPimbR3bIh4U1fPkK8jcY0tw-0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwo2zXatzJz3GjDR_31hlTzJZ5Hk5APyhpYmGu0mmwiMw&oe=69B6B65E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_p
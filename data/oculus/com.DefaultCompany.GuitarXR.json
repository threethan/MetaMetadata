_sid=6e7a0a&_nc_ohc=-INL69SDu2gQ7kNvwEoHyFD&_nc_oc=AdoRnzKSHg13xxxBmn0XzuM72P9xr5SPEO4ndrT3znMkokkrmkHe36mlh3zdPiEEa6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DRjxGL1l6C3kRQLAeq621qm5RYb5CGzbl9NSY1q7vxw&oe=6A048BF3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbZw5Noj1OkQ7kNvwESxEU0&_nc_oc=AdpDU2PYSgJH0CVFqI2ozkpbrjDAs8w-3Ewj9ztLTTCkqDuJ1IUMbsqTsjWlI8ffuCo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pIWo76LhcfNIUSuXZkHXdU-FN2_6Q6Fx3Uf_pSsbSug&oe=6A047EA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GfqKg4DKQVEQ7kNvwGhOokk&_nc_oc=AdrC-pgzzum2klKnTQSvYCuYLQIMYRt5TsUcAGL1gJh3_sISIb1LU1v_MNGDI27Oukk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lXjFvS1r4tBlpOHkgMsbKik7xEE3tqvQ-mJ-quCJj9g&oe=6A048CBF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYBTs7dyfMIQ7kNvwE4Rd21&_nc_oc=AdporchvDkIyqqr6nyOVy-EMwWxx_bBYZmQN6vkCKzcAvw97PSVG3g6oWp8HV1jC2wc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QxGmIPiAqc1thZypI1tpuNJ0x3zF9oHqwBHV6jQTalQ&oe=6A047A6D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qWngAItjVs8Q7kNvwFpX-ga&_nc_oc=Adp4cEPNO0Oa9K0IGz9MIdbtwHBgsRPuRNcDrgYSRU8-pi8i5r4xR85lDJs7Hk8H414&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42bC_q9p9NCnHP9F7KQLJlbp4NZfSiUGAlOdTc4Q5klA&oe=6A047EDE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
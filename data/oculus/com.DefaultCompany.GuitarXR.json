_sid=6e7a0a&_nc_ohc=AtXqzVMi78oQ7kNvwE7o5I6&_nc_oc=AdqlwAYzcPzjNzAS0SDSUC8Z9C2AMgwLvCdEHxzLzjrlIjJ0DyAipHQtuAKSSHoNGgo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoMWQCJNiCSoO4j2vMyiKQfFvsAiTV_g0b3io-d7PHUg&oe=6A8ACCB3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTD2vPKRRAEQ7kNvwGAJJX1&_nc_oc=AdrfOlX0_YLD5jASbZOaimbJ-xVK-wc3sTPpYNWlRloqJqQEoqwYckgpsMKuhxoj6kw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvwmajz65gTiAoDtjsUQqOjYrN3RP2CLXWluch4SiSsQ&oe=6A8ABF66"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=855wjqc5zYsQ7kNvwHVc4Yw&_nc_oc=Adr7tZdAV8uGT7llS8YZiIitUmjmcFLgK0U8SYo_65-gqBdkiHgbHUKe_BvAqLx1s9Y&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEi1Vdd43hd2A0Q_P8uOUJyJSCJjwz57VVYOP7EEXS0Wg&oe=6A8ACD7F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY8M7rNYy8kQ7kNvwFeU9jl&_nc_oc=Adq-ilYzOlIVhmnRkGMNmsi04Xy4h7RWkyshLmVwJzDEc7Wtd65hvzoUUrU3SDe5SQA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyw1vry6kyN7eszLa8aghwTzHcXfGwhlmoke7ezKKOPQ&oe=6A8AF36D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfxbzLm_8T0Q7kNvwH7aTI-&_nc_oc=AdptFVBSRZ3Ckb9WoqHjDibidsjijLwQCibhibXQp5GNeG6b6sEoYfGal5Tu6TOQ0Qg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaqfpbYDUBNzEnH9XdmOtm3QqorgrmEqqvyMwt1ne-jw&oe=6A8ABF9E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
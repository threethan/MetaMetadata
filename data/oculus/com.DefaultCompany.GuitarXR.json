_sid=6e7a0a&_nc_ohc=EePx6wS_H2cQ7kNvwEwiUSm&_nc_oc=AdpchzxPxSneKNkoihnwQJJBJn00uDV2vJ54cs8byrt2pdJ5W44YrfPCboBGynuh4E0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATRcISlWiNOe6-c-94rTEMUBgWJzZfDATmDbcVgf18JQ&oe=6A6CB273"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkxpFmUhyHUQ7kNvwEQAy_8&_nc_oc=AdpsYGofY6F_2MaA20VoGV4Q3SZu9rqsqr3uAeSZRm-abU97xDCMbevyo7-nRmQ7aD4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFRcYzh0HReXjKq172XKK_VpE7Bo4-hwzSvN2HnR-DjQ&oe=6A6CA526"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgjeEq-jdlIQ7kNvwEzTpkB&_nc_oc=AdpOp4EQzxuplweSv-VG4OJ46WuMx-5tp_UVx7YP-7qBFfnNcBlCyw67eQ5lKOKkpNo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiP4OknUcnjuPy7ArkDTlHUQroTyrMbnFx0PeEtHBiHg&oe=6A6CB33F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9B1_vXBSjDgQ7kNvwHyNEI_&_nc_oc=Adop5VM_KluZIL2UpDgKYMo35YCqhDoQU5koW-XaWf8jmtK34CJwbUMlyrWaUIATtpo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2Pl5m1AzsI3ZXixvxydd6EOrpLxPekwW5Splqi-QytA&oe=6A6CA0ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRYKvhK7StUQ7kNvwErJka4&_nc_oc=AdrghU8YWSyURlqvgy0HbMmbAwzkkgo0SntpF5vT3jpdgNxICvD8fqM4ZQ515YpJnI8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAESUjfXdg-9nPgId4jh9i8ynK1SdNTeHfIuejhIbFshg&oe=6A6CA55E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
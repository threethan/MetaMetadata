_sid=6e7a0a&_nc_ohc=s_ihILT6XDkQ7kNvwHouSLl&_nc_oc=AdpTSpx53llJzoeAdUg8D_HYgMfrVJQYRvId5PAp-_q-eRU0WhFmmz_GssamMzENAu0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLoFntcoWtPd9d5_-g4W2qeDHpjdOKT6caIwPZX9wtqw&oe=6AE207F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGHuZDBCYcEQ7kNvwH6irY1&_nc_oc=AdpZBla2rJrFX103PVp6ktvTtH5JeITVojDqvgktrLdjB1ykY1BHeI5B5d1QEr6QUqQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlpp3tXz-x39SDO9O5vqvJxF7nUxUb0bWva51-9Mh2Ng&oe=6AE1FAA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeLz87llZzQQ7kNvwGLMU_L&_nc_oc=AdrBOwcfD7ikZ2cN9W2tNTIwYmT28AIhq8vxVhZIIwr4CvgnSXnINNVQZklOUIcbyFc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO9JTaNFk9DSa35lZtQplarFVhgb1rsZHVfj-hMyRGcWw&oe=6AE208BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0KACH_bBpYQ7kNvwHJhsDq&_nc_oc=AdrSze9ySan6mqYrUgZo6ujJOL0WkiVvqnHGzR2dyqLY4iEBYokr1jfrugSjMKJvyKI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHZWe0BqkdBDW3yOXt930Eio8HqIlHlu68P5rf3Frz8g&oe=6AE1F66D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcPyokGD2oEQ7kNvwHylDRw&_nc_oc=Adpv9Tr703G8e4Cr3J83QarZrOkEa9bigxA0_CJ9Irndx00NXSCq9lw2ef2jXNFoMJw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0PvSj_CkRyB8dQ7ZBQILZmVEyXXawxbAlHb7EWzg25g&oe=6AE1FADE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
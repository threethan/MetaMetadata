ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMd28QJuFSYQ7kNvwFUpBGH&_nc_oc=AdqNHjEW62iD8hBC5oooX0V99EW_NZUSwptd-9jX_eE1MFzf5mVXl1EbEVH_mf8y3v0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gwyfNZSllXgXjF9UavTpIBcAHmfpUG75Zf5SGyYGwBw&oe=6A22DE73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uC10HGp8JPoQ7kNvwH00-Yw&_nc_oc=Adow1RpKZWv8FPkWlEpXHHQgqxJtHRQaMn28VpCLLqlhLA489fC1I-WUtppUqTjHJa8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V-hKBeh0kzpI0ncsBRGcc8pLo53U1JYETsQ0cUPNRFw&oe=6A22D126"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G4weV6-282QQ7kNvwF0r_B3&_nc_oc=AdokUTBNs_gj25orW1M9i5mMOaUUFZwZSrCkXJ2vepMVavRDlA_Iz1ZAQ9u3ujwixn4&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kTCebq5yRTrEqz3g2gai8zHhYFO48F3aUBnHL6CuflA&oe=6A22DF3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tFxjDAUH6EMQ7kNvwFBqTw3&_nc_oc=AdpjCTjgFq93z_yGB2MxMZMwMLoVWp-IVT-JbrMT0OY_dbP7p6SLr-rUu4QbgUlAPxo&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4_NYrj_XyzkDkFBRKluf412wCTCu5w0_uK3adPjuWVw&oe=6A22CCED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mrVqPzfFzrAQ7kNvwGiMwaz&_nc_oc=Adoc0TkDeo-D_GZw8XXcLcav3AilEmhYG0-mtRgJ3ac5lpCjE8aj-i3R65ypeZ4Rr28&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uGUqmPi48Bv36lmF6CcAFg9A6LYK2oPgG1XoLl5JDog&oe=6A22D15E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MO
_sid=6e7a0a&_nc_ohc=3oZniPfImjoQ7kNvwGKOay2&_nc_oc=AdoiDyXtnD4beGvPU9ljqByqDFUFhANVF-xJOmcxWVoDr-ICCmODy1SHwzR-t_l111o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCW6U3bPTZSYJb9P5dAvZ4qJ89tRHGUFVNWKdhVwdeZQg&oe=6A6377F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xyHHETOHPt4Q7kNvwHArUnq&_nc_oc=Adp6DyM6AhGGZaZH0KMixlujAYMMJu9n9SnFlaDqAWGFqwdnmj6VW90QUuLSEwj0FQ4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmtPM1nqxHpscZoEI1Lm0aCSY-WZDsjnCVRIWKHbtQRg&oe=6A636AA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbneNV06d1YQ7kNvwGvcSr_&_nc_oc=AdrD381GSbYXLP_-pbIe4MA7uyBpvzXVVtJDlIqGiVRYHUcCdXhsO3oElCJFqnj_HF4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwNXzOXCm639x7CG2_DGHg_mK5JWR6MhFdCGi37MGFmg&oe=6A6378BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6hZ1ZafBcQQ7kNvwFSvAx4&_nc_oc=Adq_bNb3U5k8grPhtIf4QOuEBybRDfn9-HEPpmGdg3qR1VM9zuOfDGo5BA6OLo0jho8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtOXMKoS-9LgJ4FMLC_7bKQMqk5cGWtap7BA7UxybOcg&oe=6A63666D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_UueRnxKvBwQ7kNvwFkaxNM&_nc_oc=AdqctHvh991FVl3IISj9RoTzVsfq1PiSd9aH4i1Aeiti9uwdqOGgzUpeSdS6v6jkceQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVwktbxYhcV8C2KrxEO7aH5URI7v9S64oubmG21w_Ncg&oe=6A636ADE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
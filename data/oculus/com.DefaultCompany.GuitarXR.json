_sid=6e7a0a&_nc_ohc=21xJ93nS3UcQ7kNvwGlGES0&_nc_oc=AdqtpZ2huC_IUpZMXW1XNSaZ12TYQSj8aOfs_CYwQlcCvZ2J96KyPgxZ3Y8LyVmSKM0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EFEz2F9j9kkG6_vqG8X5FsCxnMwQv2z2Tw-2aAGmJPQ&oe=69E4E7F3"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-y9e03CV1IQ7kNvwEMDshK&_nc_oc=AdrzCfweeljqvKtx2JuR7tOLQE817kT1UahWGbElyiDv3EBDlWwfFWr293XX1mZV9AA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1y1qFGPuw2WyZbchrpvSuLYAs3mWxbwKIJYZqEH7rPWw&oe=69E4DAA6"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQbcZmgBzzIQ7kNvwHc4gpW&_nc_oc=AdrAXQMklCzahsDbAA5euggDYD7LYJE9E7frwGWkwH5-L8E6owujaIA38B6gzrbTXGw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2LAMQzr5Y7YYbuYUn5gPVuP77GxsLRith1GnheJubmvw&oe=69E4E8BF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3dPOb7Gtk1kQ7kNvwFrPTu5&_nc_oc=AdoVoTZv12PsEJ0tZOikCgm_gzLe_0YHrKrFJM47ohXkXZYvETVs_mjJdOdw5rBBYjA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tTfFXW-6Shw1NY51wv4jSJvC_h5_iJirPxGDkCvDTaw&oe=69E4D66D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eLZndpWhcmcQ7kNvwHT3ybh&_nc_oc=Adr1C1flyjHF4WaE6AmO-wDJatgiCPR9I6nagan_9SZ-vsWDAzn8cfU-xdTDJh7HVSo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16y6pmwclvy3bmqKOAs9wURIx20MHyemLGuOs_McEmoQ&oe=69E4DADE"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
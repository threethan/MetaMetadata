_sid=6e7a0a&_nc_ohc=3_jnDZwtGwoQ7kNvwHi-RU7&_nc_oc=Ado5RHb4rPeTSHyFv3hrIoQZZFOpjrUawTAt-CWyk0X0tmi24qEaiHpeRqsO50S5vpA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBk-U7--q6-zOQ0Es40iNuvz8eTiDoDXVTsqeTmB3jMQQ&oe=6A579A73"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_N_yNwEC4EQ7kNvwFC5UvO&_nc_oc=AdpXDpj4KryY41tG6EbjehygYdxI6QymAUV6mdV_kdICtxgxX4jeuf5ef4TjdBhjVOM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbDxpifoFk5cLlX7HCtt0WeUg9QcUbdcfEVASRX7xv9A&oe=6A578D26"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr1HyMBVtfIQ7kNvwHurVc4&_nc_oc=AdpSrVuoay4bb6tIedV6TpiikJ3e3JFtGWQU1uw-N9TlIst2lD0SPkdalALCZ0HNJjU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkId-aOSARxHdeQOO8w1fMCH3qQvIu0SbnkWK5i4UcXA&oe=6A579B3F"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRPfP-4S_OoQ7kNvwGFDUNP&_nc_oc=AdrmuOep9w520OjW7Qz5VA-1ufzfLfSQmfJNezJNtM0s3djXyWv_S7BFoetY5fm-tW0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA8bvlXxKyzIB9cdzsGcB0ATqqx_Aw1KjnsPhFr-jt3tA&oe=6A5788ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7zLKumDcowQ7kNvwFq1jkR&_nc_oc=AdoiuTx8mXDat7ERLR2tmv9Jr1cuPrik78HzHBPJx_Q56VQ84K467PxEkvvMfd77Huc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0_8W7wHPXo1rXTLUGC9aHkj_dYujnfI7Gmf7OL03VGg&oe=6A578D5E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
_sid=6e7a0a&_nc_ohc=5--34bSa5wAQ7kNvwGtlTNV&_nc_oc=Adrp9JGIfYuYKwJ7NRzAr3eyuATslaq17WAtSAVHX7m0wnuboBFKs6oP-Xtd6T4s8JA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo2cBID24apTAIMvuxVywwWIj-LZjqAYff1CKjeuXaCg&oe=6A7C4C33"}, {"file_name": "Scales to any size guitar-2.png", "id": "1008495323548283", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031648_1008495326881616_7981785651870633649_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otlQxUGFExQQ7kNvwEX_nCr&_nc_oc=AdowyROlY3WrFNC7-9e82U1GE9XqU7QPoa0zInaErIjD869e7osGvPG7UJHuDv_CLi4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlm_PEBhYW1sw1hmUagXW5gZMRTnroDmJYBrkn22roNQ&oe=6A7C7726"}, {"file_name": "Scales to any size guitar-5.png", "id": "891671159656395", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974919_891671162989728_5300727336526854052_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bc_yxqAVOBEQ7kNvwF1ozoo&_nc_oc=AdrRD45KjWIVZZTM0bSciUH4_reVTuLAfNXRPh7WKULFCe3fwtArDnhMa04DHPiaUBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGL5Tkn3PnsgASZS3NSp0CU7Ae7gj472fC50MBxi0wW0g&oe=6A7C4CFF"}, {"file_name": "Scales to any size guitar-8.png", "id": "508705728465560", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75630188_508705731798893_8123620820432244687_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3y7QaivdQkQ7kNvwFQIC7D&_nc_oc=Adpw40rl_poetqC5SzqGudEf4FdVEEgz6ZIxEhj2DMZluo11kSEosDX1fBm66mwiIrg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwjIuTpqyjpTwApDAg17tkGfFLNFYwypTGU0jmdJ7nKg&oe=6A7C72ED"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Untitled design-91.png", "id": "1091148162205468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75258660_1091148165538801_2047076656173240107_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj45Dwy0cpUQ7kNvwHg5YUH&_nc_oc=AdpHIo4cy06YDmoC2vNjrOAFbnzOm2rB0_x0AA3OtRzGT1fVs6Jkr1bkZ2XHuLgwV7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYpyG84EXPvMELJEgRizA1UZlasA-imxx-wDIA8LvHQg&oe=6A7C775E"}, "display_name": "GuitarXR", "keywords": ["Guitar", "Bass", "Instrument", "Music", "Ukulele"], "long_description": "Embark on a groundbreaking musical journey with GuitarXR, an unparalleled augmented reality experience exclusively available on Quest 2, Quest Pro, and Quest 3. Discover the art of Guitar and Bass playing in an entirely new dimension as GuitarXR seamlessly merges the physical and virtual worlds.\n\nGuitarXR uses your REAL Guitar, Bass, or Ukulele and displays virtual notes (Converted from Guitar Tablature) directly on your instrument. GXR works with both lefty and righty guitar playing and calibrates to any scale-length guitar! Our latest update allows you to upload your own TABs directly in the headset and play on Bass and Ukulele! \n\n\n\n", "short_description": "Welcome to GuitarXR, a revolutionary musical experience that transcends the boundaries of traditional learning. Immerse yourself in the world of music through the power of Passthrough Mixed Reality, exclusively on Oculus Quest 2, Quest Pro, and Quest 3. Whether you're a complete beginner or an aspiring rockstar, GuitarXR is your gateway to learning Guitar, Bass, and Uke in a way you've never imagined. GuitarXR is not a full-fledged guitar course, but it will keep you playing like nothing else!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.guitarxr.org/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "GuitarXR inc.", "support_website_url": null, "website_url": "https://www.guitarxr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recomm
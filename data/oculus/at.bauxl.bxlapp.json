0f&oh=00_AQQdMmGTfkJSiNbpluZ9DAkgnae_gdC53_fDVMZ5zkc7BQ&oe=6B0B185F"}]}, "id": "3457576561087403", "locale": "en_US", "screenshots": [{"file_name": "screenshot_04_galerie.png", "id": "1373666998286460", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491828050_1373667004953126_2867180764615315041_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVr9bZKjJCIQ7kNvwGhY-gk&_nc_oc=AdrHUgC6aVL25VzNi14TXF_j4cBsOOhW7_eujtEdHXCiHA14cUrbeBA628cawJXINbE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcqTx1OSWM9XTVfHjNsVQmDg0OQAd31VGm43lYAxFmJg&oe=6B0B3E8C"}, {"file_name": "screenshot_03_innen-ausblick.png", "id": "1772487557113649", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824328_1772487563780315_7881085340777807528_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LdCXF1uAMJMQ7kNvwGWsmKd&_nc_oc=AdrFewX7pB999qDT_lbCsjhAcoIX_ouzQ-CICL8oLIEQmqbHg-RyA8XvkRvb498AGKA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSMmd5uLMGbM_qqttHzG8iv4hAcEHtXrFiiz3G1d1I-lw&oe=6B0B4152"}, {"file_name": "screenshot_02_grundstueck.png", "id": "1310434444293415", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823901_1310434447626748_7065870644914890575_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lvZoCxPxhMQ7kNvwFiToL_&_nc_oc=AdoUJfexZyL1_jOv7jmvIFk-k8lTIfHcxWNGsXrFGxd3huN3rstEqjfVcp4bGxGpuEA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSoswObHByuHnQyaqRrJCHZ_yudzkMihLTeaqcHDktBCg&oe=6B0B348E"}, {"file_name": "screenshot_05_licht-schatten.png", "id": "1769537794074065", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821704_1769537800740731_4276319836496204622_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QlabkkuapYQ7kNvwG-qvmS&_nc_oc=AdrZNFq4KFZdGbxBmxa49Y_LFDYJoIWtJ_B0ztE34oPfYSc7Me0jDjb7xTGicViSb6M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRDl0e2WiAdyl4cE4BUUFb0BTbmGSvaOh5xWcPso48QpA&oe=6B0B1446"}, {"file_name": "screenshot_01_tischmodell.png", "id": "1092099916609440", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825257_1092099919942773_4153275664135424554_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqbzH3BswrIQ7kNvwFkuhcW&_nc_oc=AdqqWlbcM5yqrBuX_7RNCN2fHNEv6D0Md62wAtU7giB_OPfua_CB-6zh05bMwjNSWQ0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQWLi5i7kvHIvjZbN1Ttzq8RcBKlfcjAlRJUju0-93Rjw&oe=6B0B1F1B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "bxlapp", "keywords": [], "long_description": "bxlapp brings your building projects from the bxlapp web platform into mixed reality on Meta Quest.\n\nLoad a project from your account and walk through it in your own room \u2014 at true 1:1 scale, embedded into your real surroundings through passthrough. Or shrink it to a 1:10 model and look at the whole building from above, like a physical model on your table.\n\nWhat you can do:\n\n\u2022 Walk through your building at 1:1, or study it as a 1:10 table model\n\u2022 See the real sun: the light follows the coordinates and true north of your site, through the seasons and across the day\n\u2022 Judge daylight, shadows and where the sun actually reaches the floor\n\u2022 Materials and surfaces from your own catalogue, straight from the web platform\n\u2022 Cut the building open at any height and look inside\n\u2022 Hide individual components to see what is behind them\n\u2022 Shared session: the planner hosts, the building owner joins \u2014 two headsets in the same room, looking at the same model in the same place\n\nbxlapp is made for planners, general contractors, tradespeople and building owners who want to experience a project before it is built.\n\nAn account on bxlapp.com is required to sign in.", "short_description": "Walk through your building before it exists. bxlapp brings BIM models from the bxlapp web platform into mixed reality on Meta Quest \u2014 at true 1:1 scale in your own room or on the building site, and as a 1:10 model on your table. With the real position of the sun for your coordinates, season by season."}, {"images": {"nodes": [{"file_name": "02_cover_querformat_2560x1440.png", "id": "2556896671403333", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823310_2556896674736666_4452628967916481764_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yl6d3RV5fo0Q7kNvwHPnMnt&_nc_oc=AdobyQZIciGRo4ABnwnUJzQFU5wGIUh2YFKrB96p_OJNlLHV_yNMJpbx4G8q03mvojY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQShMwbsKpbI1284Y0GcUp6r31TLl-fk1JpFtYnPf5tKjg&oe=6B0B161F"}, {"file_name": "05_hero_3000x900.png", "id": "2179227189310850", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823905_2179227192644183_1475839803926628904_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rnu05c2u_dEQ7kNvwGq6zel&_nc_oc=AdqYRRrcjqjYvVHSgoQwRMtHaNJ7Yvq2FN8qTqPyLfIzKk8KDld7zhCx4oosGmjwJ-8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHL6fpWCNAR9MlfMATAPGebl5xgVF7tfLrqfYlDnur2A&oe=6B0B3406"}, {"file_name": "04_cover_hochformat_1008x1440.png", "id": "2145323519354669", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827646_2145323522688002_6755504842083588267_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nl7kZnbV1bwQ7kNvwFnzrzr&_nc_oc=AdrGNvsoV1l_uz_HbCR-iRdMkuJQ_JpP-E2AMf6NN4aMz3DOCHCeMYUvxz9ApM8F1mM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTXia8_yNJH7Jx2xNC8zS7Ue7oGMPPR6KKr30Ww6h2z0Q&oe=6B0B0F99"}, {"file_name": "layered_icon_composited.png", "id": "2039557000262457", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823296_2039557006929123_6275830266819501704_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtPhgw7MKSEQ7kNvwH6NLhP&_nc_oc=AdqFQPCf7JZW17YV2-GOVlv8vahjgR9C38qxyLsh-9UcikHrPcz47-CeLDRxjbmCNCo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9nLQps3ATef8VKggCH1bo4RGC_3R0w0di8qZ_eeFgfA&oe=6B0B1F6F"}, {"file_name": "03_cover_quadrat_1440x1440.png", "id": "1381474673431847", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/673607600_1381474676765180_7763594510067850234_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gXgOTekE72UQ7kNvwE6kBiL&_nc_oc=Adp0u0ebUnif1VqJZpDqRzWneLGR4yXeGJXVy1C-yS35mJdYJgwSZUtKZzrv7AFA4Ug&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNR3NRnukGCXxu0KZPGJaLl869pvkHaRs1L7RJ3RYcLg&oe=6B0B14DE"}, {"file_name": "06_symbol_512x512.png", "id": "1323753686263230", "image_type": "APP_IMG_ICON", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825257_1323753689596563_5701743680785614112_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhahAOFU5iAQ7kNvwHPf1PV&_nc_oc=AdrXAQ5tWUJNoyah3-5tO8HzB17uowWZbrQcs4EsbQIyNj_AQcPFYEEjk5T5ISVcB6A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRfz841mFPORl8qif-hk-Z1eQosWdI9hSa1tcaZ3BiKtg&oe=6B0B2519"}, {"file_name": "09_kachel_vordergrund_180x180.png", "id": "1090304660616861", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491825345_1090304663950194_1740647570567422268_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llNvvHLzlrEQ7kNvwF1zBgj&_nc_oc=AdrjUAdXIeYyZ2ZSXi8MWLjZOAvaZ8ba6VYx3BEIKH_9zlgHb-BYzNhPrc-FrT0I1Lk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQThWgXqodA7WJxCYDSVyCc8cTW42V1XtUomTz8w5_SGTg&oe=6B0B244A"}, {"file_name": "08_kachel_hintergrund_180x180.png", "id": "1061609036248902", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823366_1061609039582235_4970759050879903634_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dYaCIYYogQQ7kNvwEXTFxQ&_nc_oc=Adqde4tpLJi2ccJ_FCOcnDbijUpjWwRGBgmUEVs0h2emcqvBwCMDfnxPFR7k7wLsEbY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSnspw21KFOXAikq909gSyvMHO0aUREq9u6HVd27eWkgg&oe=6B0B11CD"}]}, "id": "1080948994386832", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "bxlapp", "keywords": [], "long_description": "bxlapp bringt deine Bauprojekte aus der Web-Plattform bxlapp in Mixed Reality auf die Meta Quest.\n\nLade ein Projekt aus deinem Konto und geh in deinem eigenen Raum hindurch \u2014 in echtem 1:1, \u00fcber Passthrough in deine reale Umgebung gestellt. Oder schalte auf 1:10 und betrachte das ganze Geb\u00e4ude von oben wie ein Modell auf dem Tisch.\n\nWas du damit machst:\n\n\u2022 Das Geb\u00e4ude in 1:1 begehen oder als 1:10-Tischmodell betrachten\n\u2022 Den echten Sonnenstand sehen: das Licht folgt den Koordinaten und der Nordrichtung deines Grundst\u00fccks, \u00fcber die Jahreszeiten und \u00fcber den Tag\n\u2022 Beurteilen, wie Tageslicht und Schatten wirken und wo die Sonne wirklich hinkommt\n\u2022 Materialien und Oberfl\u00e4chen aus dem eigenen Katalog, direkt aus der Web-Plattform\n\u2022 Das Geb\u00e4ude auf jeder H\u00f6he aufschneiden und hineinsehen\n\u2022 Einzelne Bauteile ausblenden und dahinter schauen\n\u2022 Gemeinsame Sitzung: der Planer f\u00fchrt, der Bauherr steigt dazu \u2014 zwei Brillen im selben Raum, dasselbe Modell an derselben Stelle\n\nbxlapp ist f\u00fcr Planer, Generalunternehmer, Gewerke und Bauherren gemacht, die ein Projekt erleben wollen, bevor es gebaut ist.\n\nF\u00fcr die Anmeldung wird ein Konto auf bxlapp.com ben\u00f6tigt.", "short_description": "Geh durch dein Haus, bevor es steht. bxlapp bringt BIM-Modelle aus der Web-Plattform bxlapp in Mixed Reality auf die Meta Quest \u2014 in echtem 1:1 im eigenen Raum oder auf dem Grundst\u00fcck, und als 1:10-Modell auf dem Tisch. Mit dem realen Sonnenstand f\u00fcr deine Koordinaten, zu jeder Jahreszeit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.bxlapp.com/site/datenschutz.html", "developer_terms_of_service_url": "https://www.bxlapp.com/site/agb.html", "publisher_name": "bauxl e.U", "support_website_url": "https://www.bxlapp.com/site/impressum.html", "website_url": "https://www.bxlapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1247634261772935"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/654854429_1052024710743008_1070368870976649619_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xM1Ki3UHTZ0Q7kNvwGmBRWw&_nc_oc=AdoZpLGvSvOXAskNrgq4Yoh-JDlnf4XqCODSagGd60PSqqFyf9zmco7KG5eNA6MpqxU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSmVqeyUvYSOaWzBS5ry8RUv5aUOl4XHLjGdDKZWguT7Q&oe=6B0B185F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "bxlapp", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Creativity", "id": "1819021644882647"}, {"topic_name": "Pro
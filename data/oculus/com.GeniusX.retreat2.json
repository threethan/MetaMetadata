5zsdz-SduNoA&oe=6B09CE2C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031642_1107542336615473_6053581035555005591_n.png", "id": "813181176440829", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75203623_813181179774162_76645970692002799_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Unlj6lMRD-8Q7kNvwH7L72R&_nc_oc=AdoiK0Nbv72adY4BOYxIZo3PGs6xhCke6kNXjSD8wxA8tmizQXwepjU8EYPAQ9WsifM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyYDFTZJYtsIo4LlHBIVFDhYY4ciUTDcaHge5R5sZn5w&oe=6B09A078"}, "display_name": "Retreat", "keywords": ["education", "learning", "mindfulness", "friends", "community"], "long_description": "Ready to level up your skills, have fun, and meet new people? Don't miss this amazing opportunity!\n\nEDUCATION & PRODUCTIVITY\n\nThink of it like an adult summer camp - with courses from top experts in Art & Creativity, Career & Entrepreneurship, Financial Well-Being to Holistic Wellness.\n\nINTERACT WITH EXPERTS & LIVE EVENTS Get exclusive access and ask questions directly from world renowned instructors who are sharing decades worth of their expertise through immersive experiences. Don\u2019t just upgrade the virtual you \u2013 use this chance to grow into a better real life version of yourself!\n\nSOCIAL CLASSROOMS\n\nLearning together is the way to go! Get your friends and family involved in mastering new skills by studying collaboratively in social classrooms. Studies prove it \u2013 group learning helps you remember what you learn better too!", "short_description": "Ready to level up your skills, have fun, and meet new people? You don't want to miss this amazing opportunity! Think of it like an adult summer camp - with courses from top experts in Art & Creativity, Career & Entrepreneurship, Financial Well-Being to Holistic Wellness. Get exclusive access and ask questions directly from world renowned instructors who are sharing decades worth of their expertise through im
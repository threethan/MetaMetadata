h=00_Afteqpv9NNz31VUjDzjPcDgvZjMuYZWH2vY1us0HkiYpLQ&oe=69A967B8"}, "display_name": "Retreat", "keywords": ["education", "learning", "mindfulness", "friends", "community"], "long_description": "Ready to level up your skills, have fun, and meet new people? Don't miss this amazing opportunity!\n\nEDUCATION & PRODUCTIVITY\n\nThink of it like an adult summer camp - with courses from top experts in Art & Creativity, Career & Entrepreneurship, Financial Well-Being to Holistic Wellness.\n\nINTERACT WITH EXPERTS & LIVE EVENTS Get exclusive access and ask questions directly from world renowned instructors who are sharing decades worth of their expertise through immersive experiences. Don\u2019t just upgrade the virtual you \u2013 use this chance to grow into a better real life version of yourself!\n\nSOCIAL CLASSROOMS\n\nLearning together is the way to go! Get your friends and family involved in mastering new skills by studying collaboratively in social classrooms. Studies prove it \u2013 group learning helps you remember what you learn better too!", "short_description": "Ready to level up your skills, have fun, and meet new people? You don't want to miss this amazing opportunity! Think of it like an adult summer camp - with courses from top experts in Art & Creativity, Career & Entrepreneurship, Financial Well-Being to Holistic Wellness. Get exclusive access and ask questions directly from world renowned instructors who are sharing decades worth of their expertise through immersive experiences. Upgrade your real world Avatar, that is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retreatvr.io/privacy-policy/", "developer_terms_of_service_url": "https://retreatvr.io/terms-of-service/", "publisher_name": "GeniusX Inc", "support_website_url": null, "website_url": "https://www.RetreatVR.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "con
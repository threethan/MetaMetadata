-25/229075105_5587374521369133_8644124343661032589_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NTTyJdCRhokQ7kNvwGMe0oU&_nc_oc=AdquYC9FJtLSvm3QhGffqrIkMSOUAQYBjnwMqLiyLVAU1XNn79qG3byMbPHpAEfCQs0&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0fHwzC-AkV2Nh2w5DCNDJEbNaTYcBsWaAD_gRSfoGuA&oe=6A85926A"}, {"file_name": "Gisele2.png", "id": "896279524812499", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974866_896279528145832_3197045305338293507_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BC00p0WvVdMQ7kNvwEpNplf&_nc_oc=AdrH2SPZ0xQneBATAxJLw0S710mbYcc9GyM5lUACuB3wuVs296CQz6u4nE62Tk8o4hk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYVTx6yPIeqrGhbSGIKUDy2zf5NdzzvBHUbWuOBV8yUg&oe=6A858CDD"}, {"file_name": "magik.png", "id": "3380886502142785", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974873_3380886505476118_5456871104442413335_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH50U1HvNmsQ7kNvwF3rEFV&_nc_oc=AdqIWgi1FMoj5WOucQr9qYNhXp8BS7pGrsXaF2GwuYxkjRE8JAfIO9hRkeLkcxBtcpE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5FvRJfuPCvwvNlxiP7pw9xaW5M2KZ7qBJ0OORGMLSGw&oe=6A8582E0"}, {"file_name": "menu_screen.png", "id": "207037745267399", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974886_207037748600732_3890591922775185940_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXuMpDagW1MQ7kNvwFSjYbX&_nc_oc=Adqu31T_pUjJFAMfCU0eXnN80wrilZUvf7sYwrgPBGBTJ1zJ-XILHchvzjVPHFOHzDk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHulFOTxNZBNT9dtn990BnSD6o_z_2XHYNt9ufv-Tw2sg&oe=6A8587AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "39031642_1107542336615473_6053581035555005591_n.png", "id": "813181176440829", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75203623_813181179774162_76645970692002799_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5ad5N9o2bxkQ7kNvwHZa6-T&_nc_oc=AdrdMbXQLmlA2TD0JIPAHuYa82sVYcbHVc5E5721u1rH_hSlKFZaIwtAmu6tp-vJs-I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHakCzRvm-zvb7QIq_ML03-x_gq_tyZ9gXQBLiDxIqEaw&oe=6A859238"}, "display_name": "Retreat", "keywords": ["education", "learning", "mindfulness", "friends", "community"], "long_description": "Ready to level up your skills, have fun, and meet new people? Don't miss this amazing opportunity!\n\nEDUCATION & PRODUCTIVITY\n\nThink of it like an adult summer camp - with courses from top experts in Art & Creativity, Career & Entrepreneurship, Financial Well-Being to Holistic Wellness.\n\nINTERACT WITH EXPERTS & LIVE EVENTS Get exclusive access and ask questions directly from world renowned instructors who are sharing decades worth of their expertise through immersive experiences. Don\u2019t just upgrade the virtual you \u2013 use this chance to grow into a better real life version of yourself!\n\nSOCIAL CLASSROOMS\n\nLearning together is the way to go! Get your friends and family involved in mastering new skills by studying collaboratively in social classrooms. Studies prove it \u2013 group learning helps you remember what you learn better too!", "short_description": "Ready to level up your skills, have fun, and meet new people? You don't want to miss this amazing opportunity! Think of it like an adult summer camp - with courses from top experts in Art & Creativity, Career & Entrepreneurship, Financial Well-Being to Holistic Wellness. Get exclusive access and ask questions directly from world renowned instructors who are sharing decades worth of their expertise through immersive experiences. Upgrade your real world Avatar, that is you!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://retreatvr.io/privacy-policy/", "developer_terms_of_service_url": "https://retreatvr.io/terms-of-service/", "publisher_name": "GeniusX Inc", "support_website_url": null, "website_url": "https://www.RetreatVR.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comf
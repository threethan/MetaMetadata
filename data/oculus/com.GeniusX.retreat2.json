IAL CLASSROOMS\nStudies show that learning collaboratively helps you retain the information! Share your learning experience with your friends and family. ", "short_description": "A safe space where leveling up personal and professional skills is fun, interactive and social. Learn from the world\u2019s top experts to upgrade your mind, body, and spirit. Find your flow and recharge in Retreat! Download for FREE!\n\nUpgrade the real world avatar that is you today. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://retreatvr.io/privacy-policy/", "developer_terms_of_service_url": "https://retreatvr.io/terms-of-service/", "publisher_name": "GeniusX Inc", "support_website_url": null, "website_url": "https://www.RetreatVR.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1323444675136463"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3354721968148678"}]}, "baseline_offer": {"id": "3354721968148678"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1669917600, "status": "PUBLISHED", "id": "3354721968148678"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7077799415579868", "version": "1.8.14-prod"}, "id": "870961437367983", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pri
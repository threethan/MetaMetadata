yBNAAvpUg&oe=6AFDE0C4"}, {"file_name": "leila.png", "id": "516333337200293", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974840_516333340533626_2589770388927545657_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHgAZk3YsJsQ7kNvwGO8s7O&_nc_oc=AdoCqwRUhxRMR_v3B4jsnG4JfDiKgc6btnF96gpE-1YNucZMKmRnV7fV2DWkHCroMyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ55JiK4n2aknElQMEueBEVxBrv-JXamsgRVjh8jWYFDw&oe=6AFDC2CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Retreat_CoverImageSafeAreaTemplateLandscape.png", "id": "1107542333282140", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031642_1107542336615473_6053581035555005591_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MKaflUeLMsQ7kNvwEMKN4D&_nc_oc=AdrKxSeMPES3S6oAXfn1qi46GQjNSekADj8X6b2li6hwxiqFeGZG4VGoKg85RU3X1lo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtC2JyzMKlBJRJpy2r2Y3iYRkDvJHkRTiyA7MQ33b8kQ&oe=6AFDAE74"}, "display_name": "Retreat", "keywords": ["education", "learning", "mindfulness", "friends", "community"], "long_description": "A safe space where leveling up skills is fun, interactive and social. Learn from the world\u2019s top experts to upgrade your mind, body, and spirit. \n\nUpgrade the real world avatar that is you today. \n\nIMPACTFUL & IMMERSIVE COURSES\nEnjoy your pick of courses from Art & Creativity, Career & Entrepreneurship, Financial Well-Being to Holistic Wellness, Mindset and Relationships. With new courses added every month, you\u2019ll always find your next skill to learn.\n\nEXPERT INSTRUCTORS \nOur instructors have spent decades mastering their topic, and they are sharing with you their knowledge in immersive, impactful ways. Practice public speaking in front of a crowd, meditate in Nepal, even find your right fit job!\n\nLIVE EVENTS\nAsk questions and get immediate answers from the experts themselves when they host live events!\n\nSOCIAL CLASSROOMS\nStudies show that learning collaboratively helps you retain the information! Share your learning experience with your friends and family. ", "short_description": "A safe space where leveling up personal and professional skills is fun, interactive and social. Learn from the world\u2019s top experts to upgrade your mind, body, and spirit. Find your flow and recharge in Retreat! Download for FREE!\n\nUpgrade the real world avatar that is you today. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://retreatvr.io/privacy-policy/", "developer_terms_of_service_url": "https://retreatvr.io/terms-of-service/", "publisher_name": "GeniusX Inc", "support_website_url": null, "website_url": "https://www.RetreatVR.io/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1323444675136463"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3354721968148678"}]}, "baseline_offer": {"id": "3354721968148678"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1669917600, "status": "PUBLISHED", "id": "3354721968148678"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "7077799415579868", "version": "1.8.14-prod"}, "id": "870961437367983", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "pri
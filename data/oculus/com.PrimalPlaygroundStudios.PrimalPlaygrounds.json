ler": null, "video_trailer_thumbnail": null, "display_name": "Primal Playgrounds", "keywords": ["primal", "playgrounds", "multiplayer", "game"], "long_description": "Primal Playgrounds is a Gorilla Tag-inspired VR fan game that lets you unleash your inner ape in chaotic, physics-based fun. Run, jump, and climb using nothing but your hands as you explore unique maps built for speed, creativity, and wild movement.\n\nWhether you're exploring the lab, which seems to have some creature lurking down there, or playing the iconic maps with your friends, Primal Playgrounds is all about freedom, flow, and pure primal energy. With smooth multiplayer action and handcrafted environments, it\u2019s the perfect place to monkey around and have lots of fun.\n\nEnter the playground. Go primal.\n\n\n\nGAME BEST MADE FOR QUEST 3, QUEST 2 WORKS BUT IS LAGGY IN SOME PARTS.", "short_description": "Primal Playgrounds is a Gorilla Tag-inspired VR fan game that lets you unleash your inner ape in chaotic, physics-based fun. Run, jump, and climb using nothing but your hands as you explore unique maps built for speed, creativity, and wild movement. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1X56RDTjxrAIYyq3k6JDmGV8_wTYGWy-Ygm_xRgG8dBw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Primal Playground Studios", "support_website_url": null, "website_url": "https://primalplaygrounds.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_language
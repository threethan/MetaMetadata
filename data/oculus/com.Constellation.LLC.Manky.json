A&oe=6B032194"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "MANKY", "keywords": ["manky", "fangame", "monkey", "gorilla", "horror"], "long_description": "Manky is a VR horror game by Constellation LLC, using gorilla locomotion to explore a chilling research facility. As a player, you\u2019ll uncover secrets, collect research on escaped test subjects, and analyze their disturbing behavior. The game features a vast number of unique, interactable items throughout the facility, each offering clues and adding depth to the story. Every corner holds a new mystery, creating a tense atmosphere where the line between discovery and danger is razor-thin. Get ready for a nerve-wracking experience!", "short_description": "Manky is a VR Horror game by Constellation LLC, using gorilla locomotion to explore a chilling research facility"}]}, "developer_name": "Squid Studio LLC", "developer_privacy_policy_url": "https://sites.google.com/view/mankyvrgame/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squid Studio LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/mankyvrgame/home?authuser=0", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "27226659556939120"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscd
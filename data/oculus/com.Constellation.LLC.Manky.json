, you\u2019ll uncover secrets, collect research on escaped test subjects, and analyze their disturbing behavior. The game features a vast number of unique, interactable items throughout the facility, each offering clues and adding depth to the story. Every corner holds a new mystery, creating a tense atmosphere where the line between discovery and danger is razor-thin. Get ready for a nerve-wracking experience!", "short_description": "Manky is a VR Horror game by Constellation LLC, using gorilla locomotion to explore a chilling research facility"}]}, "developer_name": "Constellation LLC", "developer_privacy_policy_url": "https://sites.google.com/view/mankyvrgame/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Squ1d Studio LLC", "support_website_url": null, "website_url": "https://sites.google.com/view/mankyvrgame/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "24674957058776062"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473392010_1165558988487345_3741374873285729427_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9UxHxkSsqcQ7kNvwEbdMWs&_nc_oc=AdpqAtmM8iEEUNdNbqTG3NFYhsUhw0p9T-wdtYbSHQtl5J7zbaUs5IMTLKCgEnvjR20&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_
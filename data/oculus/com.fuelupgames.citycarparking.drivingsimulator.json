0_7186517811169342352_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58671dx6rP8Q7kNvwHiWkG5&_nc_oc=AdoMhyLhncIcpoD3zF70JjZ5pxDIvAObT21rwfDsq51xF3OjSc1k6RT6-uLtH3paGB0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2O8TddGNAdHNc4Wc3gZCeNcTinl-RNyKujdqfHKsfqQ&oe=6A942AF2"}, {"file_name": "Screenshot 5.png", "id": "2055372978642810", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491824307_2055372981976143_414142500303450902_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucmSeji3FkoQ7kNvwHj3vSd&_nc_oc=Adq1Uj-6fS1OTGTwcxGM9lGF9DbB2sQYHCl7-82i8eROl7VQfeU5GvQkRICk9rKndpM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-6vYrqRvyKc9SjmMRNkKl3MTo18CZD-_yOgYePGNVuw&oe=6A940EE0"}, {"file_name": "Screenshot 4.png", "id": "1407373401181151", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821696_1407373404514484_1540958683988993361_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzywz-DsNoIQ7kNvwFM9Xnh&_nc_oc=Adqf92X9hKWgmO5hIxG45HW0ez53LYA55i_kKeBqb-hD0tPD-u6maVoPtek-_rd7zXo&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeiEGG1sDJUzeQNC00nz39bHYj9UAAawsaNVEtHH7e7A&oe=6A94199E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "City Car Parking & Driving Simulator VR", "keywords": ["CarParkingVR", "DrivingSimulatorVR", "CityDrivingVR", "ParkingSimulatorVR", "CarDrivingGameVR"], "long_description": "City Car Parking & Driving Simulator VR delivers a realistic and immersive driving experience built from the ground up for virtual reality. Explore detailed city environments, master real-world parking challenges, and improve your driving skills with precise VR controls and authentic vehicle handling.\nNavigate busy streets, tight parking spaces, and complex road layouts while following traffic rules and completing progressively challenging missions. From basic parking practice to advanced driving scenarios, every level is designed to test your accuracy, awareness, and control.\nWith smooth VR interaction, realistic car physics, and multiple camera perspectives, the simulator puts you directly behind the wheel. Whether you\u2019re a beginner learning the basics or a driving enthusiast looking for a true-to-life experience, this simulator offers hours of engaging gameplay.\nKey Features:\nImmersive VR driving & parking simulation\n\n\nDetailed city environments\n\n\nRealistic car physics and controls\n\n\nMultiple parking and driving challenges\n\n\nSuitable for both casual players and simulation fans\n\n\nStep into the driver\u2019s seat, sharpen your skills, and experience city driving like never before \u2014 in VR.\n", "short_description": "Master realistic car parking and driving challenges in an immersive city VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/fuelup-games-privacy-policy/home", "developer_terms_of_service_url": null, "publisher_name": "FuelUp Games", "support_website_url": null, "website_url": "https://sites.google.com/view/fuelup-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25528851786742991"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491824665_1380128863250092_4021960656701685655_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=
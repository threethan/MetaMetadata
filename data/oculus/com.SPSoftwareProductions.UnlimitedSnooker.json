F6"}, {"file_name": "Screenshot4.png", "id": "721869560393391", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819356_721869563726724_7772536991879678320_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cuDRi0EoXvUQ7kNvwFqnEj7&_nc_oc=Adqm4secnWmcQ-7DGw8jiQO1zt_qnK-vTah9zOECYbwLYGIdMWfwlg1mjwCyidUQNXI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqNIMM_AzC5EQCioMBBmdpC6G7uW3EWYwARr76uw9-VA&oe=6AB6816B"}, {"file_name": "Screenshot5.png", "id": "1219725742602781", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821115_1219725745936114_3792285773084007543_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6ztBq7qV5IQ7kNvwEB-Dpf&_nc_oc=AdpKeckDeaSgohGma4ZHDadwJsMEtK09M9FVDZCVcozYZxkx2vPMvkh6Wf2IUMWpg6A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEESx-FHQ4o7qPH3zDN-5eEShL9zzICofw7-kPmZ4ISA&oe=6AB69C18"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Lanscape.png", "id": "2120641551786432", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827567_2120641555119765_8299533070416042438_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5f6-u7lTjbsQ7kNvwF_JBj8&_nc_oc=Adr-T6zbEAA_0HpSuyepqDJPsLwkXw2n9q1vUVPJL5O4omRnPaj8Zc-MIuORBpOY8S0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIevm1w40wRCZD1HOONewW7me4Dogh10p1r-H8GEu-xmA&oe=6AB69CFE"}, "display_name": "Unlimited Snooker", "keywords": ["snooker", "pool", "cue", "physics", "versus"], "long_description": "Feel the joy and excitement of real snooker!\n\n\u2022Bring the full-sized snooker table into your home with Mixed Reality.\n\u2022Novel table alignment system means you can play your strokes just like in real life.\n\u2022Now supports Real Cue Attachment. Play with your own cue exactly like you do in real life.\n\u2022Free Play mode enables you to practice with your favourite routines.\n\u2022Pass and Play Match Play lets you enjoy an exciting match with your friends on a single headset.\n\u2022Online Match Play lets you play online with your friends and players from all around the world.\n\u2022Climb to the top of Online Leaderboards and become the best in the world.\n\nSee you at the table!", "short_description": "Feel the joy and excitement of real snooker!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/13372250", "developer_terms_of_service_url": null, "publisher_name": "SP Software Productions", "support_website_url": null, "website_url": "https://spsoftwareproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25768716436144869"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821682_1106209347985169_92567948676091730_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS4zWvW3QewQ7kNvwGzfvFX&_nc_oc=AdpAZZwowH3eTVqPN3cPc2OfMpZrJKAlRyl6VLzX1-e91bZ7WTK0NNpFuWzD-bdCCjw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCEJMYAZhbrEHoT7pyNVwpFNCv9GibWpO4SeGX0_1Ejg&oe=6AB68DBC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Unlimited Snooker", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "27765
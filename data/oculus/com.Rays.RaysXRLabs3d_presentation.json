0a&_nc_ohc=4dHlqVAnZSoQ7kNvwEjz5cV&_nc_oc=AdowGb0JD3SBPAbtn2FFnbnpZ7do3tsVhNiN4nj2sr-TwRDsR88bY4HTfm04JsAwqFk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJycB6d5gFGrGfckpq0FeGbXD1kamffX2DKLjgS2YjlZw&oe=6AAD5E8B"}, {"file_name": "2.png", "id": "888982707387111", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298298_888982710720444_3639949359647079272_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0WX0JxMB0AQ7kNvwGcmk5r&_nc_oc=AdozVsRPgmkxmF94L910s28TbQR8BtKYTMcL5wLfsxFlVB4JLODDMcbia4m75f_WrCg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZxwSUIO0cAsWoXb1gXlZhnE_KGp19Sld2keDOdSTgIw&oe=6AAD4964"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": "Adreonix Ventures", "developer_privacy_policy_url": "https://medispherexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adreonix Ventures", "support_website_url": null, "website_url": "https://medispherexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "con
uP1tdDoekGnMsovrSWhv-Q&oe=6B1043A3"}, {"file_name": "1.png", "id": "25960335506950402", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623345_25960335510283735_2894777350078323348_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BgpNkv21yasQ7kNvwHETdpN&_nc_oc=Ado74Ng-emfFa3VTat5o9E8-hzHi6bL1jYQWmS-4RZomyGLvw6jtiIy33kxatDdCTSk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVHjKd6UK-D4-uRyQTrWil7rgX1vLgwk3C0YQTHnAyFvg&oe=6B103F0B"}, {"file_name": "2.png", "id": "888982707387111", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298298_888982710720444_3639949359647079272_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtW3GIZCI0IQ7kNvwEkzyEH&_nc_oc=Adr6IKibq_sNP7PXlD1BgrV9KPjKOd02qprD4xsdg3wdyfJlzE3C0CE3_pQwue8bXxA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0yjsG4r5Da5KrWsjDGhqLAA0YZR5B4lhFN4nXHimuKA&oe=6B106224"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": "Adreonix Ventures", "developer_privacy_policy_url": "https://medispherexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adreonix Ventures", "support_website_url": null, "website_url": "https://medispherexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26441839558747073"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819983_1857175504983886_7439686089818648352_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bsrKgMkfcNwQ7kNvwEEx7Du&_nc_oc=AdrUlmZMGc6D_nUM_cpF7cN3VCOPzc2Yl4hlzLx-WFJzT-fURaRc2ifNwJMy9C7wLC8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUs2F3oXj6uWzQMbj-NEhsIIIlYVmRBsU2VILJkL-XSmg&oe=6B10405F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Medisphere XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1770810120, "lastRevision": {"nodes": [{"id": "24060098173587902", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24060098106921242", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {
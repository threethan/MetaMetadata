6e7a0a&_nc_ohc=LGsu0bNKH1AQ7kNvwFk7lY9&_nc_oc=AdqitQDkV5vvK5AtILV628p88CjwRm8nTlxM0eS2PikEA5j4SKO3zsnb8h4PgtJEETY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFescHW8Z4q5m0mMmed8g6rMmGzx0uS_1R79fMkHn9Uig&oe=6A7DB04B"}, {"file_name": "2.png", "id": "888982707387111", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499298298_888982710720444_3639949359647079272_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8GWf28PHewQ7kNvwEXV1pu&_nc_oc=Adr7ANDXRqncHMJ-6Gyo69W4-ujPs3Xpzew8_XVCcsSXTCX2unFtZ9HgK0ZffA7ml7o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbdGdTY3bILBMpRELqggBnB00ZbnsbE_4N8G4qDjK1-A&oe=6A7D9B24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": "Adreonix Ventures", "developer_privacy_policy_url": "https://medispherexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adreonix Ventures", "support_website_url": null, "website_url": "https://medispherexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], 
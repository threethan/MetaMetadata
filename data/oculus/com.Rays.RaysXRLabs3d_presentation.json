ity."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dashboard.medispherexr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rays3d", "support_website_url": null, "website_url": "https://dashboard.medispherexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25067273082870401"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1021043896785158"}]}, "baseline_offer": {"id": "1021043896785158"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770810120, "status": "PUBLISHED", "id": "1021043896785158"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26965005886430435", "version": "0.1.14"}, "id": "705136192037310", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24060098106921242", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26965005886430435"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "705136192037310"}]}, "change_log": null, "created_date": 1776056582, "id": "26965005886430435", "version": "0.1.14", "version_cod
0a&_nc_ohc=oEmc3WAiPskQ7kNvwGrixxG&_nc_oc=AdoeRFVMch7au5do9gX30HT9ATJedaipSoTVeUG_8vTkSioS_nUZ8hfiStEwkT3AcSU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPXCV0AMR4MWJZKa_7xv4zLfW9UBUgAjtnwR3q5X7YbA&oe=6A8ADF4B"}, {"file_name": "2.png", "id": "888982707387111", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499298298_888982710720444_3639949359647079272_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lsll4duZwXwQ7kNvwHTvNZ0&_nc_oc=AdpptOlj7DTImkNObzE77ddStw0vOM6aW_w3V5fW6nia9m5xwrWgLBmgDN38OT14mMg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKFG7Hi26ZdWzmTcL0fmSb-jyHwDXQFsYH-Msfrq95_w&oe=6A8ACA24"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": "Adreonix Ventures", "developer_privacy_policy_url": "https://medispherexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adreonix Ventures", "support_website_url": null, "website_url": "https://medispherexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "con
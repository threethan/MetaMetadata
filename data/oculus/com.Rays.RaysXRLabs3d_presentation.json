0a&_nc_ohc=o0bHgAJUcx0Q7kNvwEICIVe&_nc_oc=AdoQMGNKgctiXfd2Po2J0Zo9SlVQOX0QUGnBFX5vZG74oZOR57KD-4EMVdvGSKR2l2E&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6LOK0oHPp-QQ0k8BymgxdXzeqoj6QjB8WW7Jhp70Z1g&oe=6A9176CB"}, {"file_name": "2.png", "id": "888982707387111", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499298298_888982710720444_3639949359647079272_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rVHTxYWxW8cQ7kNvwGELXBh&_nc_oc=AdrItvpvWVjU63lL2RIYwWExu7qoWZ7BNNiJJz8bee_zKzuCIkEmgaxORBnyCdXau6Q&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGl2E-hKCEzBb-eiA4qn6Wk9gqozZ7Aodu_aiSICv-dPw&oe=6A9161A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": "Adreonix Ventures", "developer_privacy_policy_url": "https://medispherexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adreonix Ventures", "support_website_url": null, "website_url": "https://medispherexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "con
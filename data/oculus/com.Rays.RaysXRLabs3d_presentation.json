RRmrijD0mdIlYDKhxj78Tg&oe=6AFC7D23"}, {"file_name": "1.png", "id": "25960335506950402", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499623345_25960335510283735_2894777350078323348_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WjTyKwWvibgQ7kNvwEknrXe&_nc_oc=Adorl8ehDLk1oPKGCle4l0pKtYZnnCf_D8aFwQU7SyQ0qzi8s3QbvSb5QCvtlFxKy3Q&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs4ND-NG-PYQU3DtWVvG6D6s87bg4ha8K6omK-zHjJTQ&oe=6AFC788B"}, {"file_name": "2.png", "id": "888982707387111", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499298298_888982710720444_3639949359647079272_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8izzp4LM9EQ7kNvwE2UW_Z&_nc_oc=AdpzDeMjwGdMS0kOAWe_XQpohspxxA5lHo-D7V63RmoB-mQxNsWoWMUedHGvFOcOfL8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv9cX3OfOKvgUhknSagg7_W7-utjEIlEf7wu8sAFZq5Q&oe=6AFC6364"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": "Adreonix Ventures", "developer_privacy
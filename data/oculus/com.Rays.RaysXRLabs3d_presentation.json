0a&_nc_ohc=ACsjrtab8-sQ7kNvwEjaENK&_nc_oc=Adp9_z6a_J5poiIKE9VDKsRM9jn9_lG1-FP6cCWzOGIYTr9TSsb1wiEL4o3EStT4bvE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0oVwM1bvhetM4Tv_efsGpflRL4ezlMKG_DaUVYTEt0Q&oe=6A9419CB"}, {"file_name": "2.png", "id": "888982707387111", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499298298_888982710720444_3639949359647079272_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=de-ixaRy-uIQ7kNvwGPQEqR&_nc_oc=AdrwMyTi4AXMhWlwHzXUOmxW1jNkYT7ua7dH4UmWxYoAnxLiKrw-pwMTfPmSGq0H7Ug&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBfrsKDfrXoLPkD08vyEPnudG3W9KAFOPMeYohtloLgw&oe=6A9404A4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": "Adreonix Ventures", "developer_privacy_policy_url": "https://medispherexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adreonix Ventures", "support_website_url": null, "website_url": "https://medispherexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "con
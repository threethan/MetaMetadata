/499617729_1263068545862767_8921509389236298976_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxbSmAcq2eoQ7kNvwEEKgq8&_nc_oc=AdmSBlFb_-C7kiHFD1MCOjS2CghPam1OC_kGruQMPWRC0xJrAd-gqhmuxztlgQf65CE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvzzS0-scQvjbqhSmUNHAivtSINR1j-lBFCvf1r3G4wlA&oe=69A03917"}, {"file_name": "Screenshot 2025-09-23 143242-2560x1440.png", "id": "663778693011508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622315_663778696344841_846455849007680303_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-aqQ5bdCcoQ7kNvwGzA9wE&_nc_oc=AdmmFfydIN8facG7qsYl_votfdwo_n75myRDcPV8pNXU2Wl460UJHa4qwRbfUvt7KW0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftdvKjGMYzglOntcc-XfrrasDIK-mAFThF31pbcRXZgTg&oe=69A0363F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://medispherexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adreonix Ventures", "support_website_url": null, "website_url": "https://medispherexr.com/", "ca
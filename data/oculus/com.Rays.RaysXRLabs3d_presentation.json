oLVzFLiXz5v0gTJjDFMcCg&oe=6AFDCEA3"}, {"file_name": "1.png", "id": "25960335506950402", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623345_25960335510283735_2894777350078323348_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dw-vJckB4WUQ7kNvwErxDH1&_nc_oc=AdrVo4Rf9M-NVIqgQ35s62vyUbnzqJT5tFgXllJPHUaHFxDpoI3FNqSx0kLx7lSrNao&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfpHQ_WNrqo0g9otMSIm32FFf3icFB2KzB2hLzZ7eHVA&oe=6AFDCA0B"}, {"file_name": "2.png", "id": "888982707387111", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298298_888982710720444_3639949359647079272_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8izzp4LM9EQ7kNvwEfEhzL&_nc_oc=Adr71YbFrjzrVje0rESCkPhMxeqb9LgAG85EM-KDla3YkQm-ONnrhn6IrxaSiru0OO8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfU5LO54mL-tW68zsP68EVwXCPqkSIKwFtNjamRLqaYw&oe=6AFDB4E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": "Adreonix Ventures", "developer_privacy
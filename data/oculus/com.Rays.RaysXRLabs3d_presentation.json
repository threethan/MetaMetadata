734604_40342539866842274_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuE10GwQ1WEQ7kNvwEKwzED&_nc_oc=AdlDIdTb23w8DYa9ok6AN3W2s0swkkpNrZZ8iHp9MobQQiSi8uX9aWVgplvyzTcwq9g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftxrmdu8IuCtzCJ39Z6Fxn0yNbIXwLemQdj6qmhIyMRlg&oe=69A2D63F"}, {"file_name": "Screenshot 2025-09-23 143226-2560x1440.png", "id": "2633720903658750", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618252_2633720910325416_8945801192367491587_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hzajxp0Pc2kQ7kNvwF6lvOL&_nc_oc=Adm7lqPAYolnEzciice_RMlnuaAFSjLCSlMwj7AiB-WZfadZuDbjQahmM-R_UsQUWnU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftgNAJq3WhN-JQrydDlDAjZj41yTGJJhM6ymMIxKeAvOw&oe=69A2DB72"}, {"file_name": "Screenshot 2025-09-23 143253-2560x1440.png", "id": "1263068542529434", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617729_1263068545862767_8921509389236298976_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxbSmAcq2eoQ7kNvwHojpB5&_nc_oc=Adl8v0njvN2gag0AFwqTW_noTkbNl3B9I1XtwwCGLTv5dKpvW7H7Qi70h86xaQMw1ps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfviVZtqonI2DQVM77XDZ99htgHEa2Gg-9LrjcvdgxKBwQ&oe=69A2DC17"}, {"file_name": "Screenshot 2025-09-23 143242-2560x1440.png", "id": "663778693011508", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622315_663778696344841_846455849007680303_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-f3aCjr411cQ7kNvwFAWT5B&_nc_oc=Adl-WOAQhlYV2CZDyJacZKdRFWKuwCYDDw99tqi1RpUgzhgh7YWEkBOvVi3Q0312cVw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuiZjUqWQ3X1iY5E1mC03aQhz29KAXgrCQ3nKc4vugO1g&oe=69A2D93F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": null, "developer_privacy_policy_url": "https://dashboard.medispherexr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Rays3d", "support_website_url": null, "website_url": "https://dashboard.medispherexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25067273082870401"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1021043896785158"}]}, "baseline_offer": {"id": "1021043896785158"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1770810120, "status": "PUBLISHED", "id": "1021043896785158"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26349565257
cqgP17WBRMwgL1slHV0bsg&oe=6B0314A3"}, {"file_name": "1.png", "id": "25960335506950402", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623345_25960335510283735_2894777350078323348_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGqZSfBo2woQ7kNvwH1JE4t&_nc_oc=Adry2vz464HzUPQFxBMIXdSbrufRpK1Q-F_VzPW-7BFhbVLLnizBdnOjn-_nQ-G2-Ds&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSDsClBnOw8nYLyzMuAAyvx82ZxjHLyhS5UQaGmmAFDXQ&oe=6B03100B"}, {"file_name": "2.png", "id": "888982707387111", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499298298_888982710720444_3639949359647079272_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AZL_lcnR4DcQ7kNvwF9TnM-&_nc_oc=AdqoPRdjdK4kSPHeelVBYrQa-CuChhFr4fcxVJTU3TShuLSB9C63mzXG0NaPSesSz6E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO786jcPYSUSU7Dkcsg3WmFX9E2OF62sev6otl33wllg&oe=6B033324"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": "Adreonix Ventures", "developer_privacy
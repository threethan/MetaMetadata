0a&_nc_ohc=nJLRpMMvXSQQ7kNvwEgl2tp&_nc_oc=Adomz1Mg4-eB-1wo8fBOmRkYNKoDhXPzBsahSTxPhUdGBNtxv9I4UB8M82J0Q_zjXNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Awrs0sixGA0Qrif0F7HW72GwQ0mkqn8xO40TacDYOfg&oe=69D39ECB"}, {"file_name": "2.png", "id": "888982707387111", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298298_888982710720444_3639949359647079272_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oi9Lc1X3kfQQ7kNvwEq0_5d&_nc_oc=AdporYFW35wKdhu9qJIaZ-6jVzfTGbjg4mTuWT6uoTsroyy1hGo3OlbOqcGPeCGylMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34fCfzWrjB6e64c5b3Bkazj27QlD9l1r24Z9D329f1BQ&oe=69D3C1E4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": "Adreonix Ventures", "developer_privacy_policy_url": "https://medispherexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adreonix Ventures", "support_website_url": null, "website_url": "https://medispherexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "con
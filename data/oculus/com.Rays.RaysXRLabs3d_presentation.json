0a&_nc_ohc=3Us3hrzauR0Q7kNvwGAwBmg&_nc_oc=AdrhQoxg0UGcegv90H9DZyC-Euv23VngcQKlHITz2Ao3UQMjTGKKQ7EGCHUKiYjFu1c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uT_dRPmI_h7lch5kOCnv3nlyDViIRSSbvgm389bWu2g&oe=6A2C2B8B"}, {"file_name": "2.png", "id": "888982707387111", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499298298_888982710720444_3639949359647079272_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nijsToS_fXMQ7kNvwHo-lnd&_nc_oc=AdqT93d-RF00rU92RUXQoScSh6AemGnruVdUEmWDeSfeurKFnlWHNQ2Q8tLU6Ic3RHc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HoRdk4MWcHXG7BDbmlIU9uGiCA968vL3skdHuw45CKw&oe=6A2C1664"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Medisphere XR", "keywords": ["Medisphere", "medispherexr", "medical", "healthcare", "mixedreality"], "long_description": "MedisphereXR is an advanced extended reality (XR) platform that transforms how medical teams review, share, and collaborate on real patient cases.\n\nInstead of relying on static 2D scans or isolated workstation reviews, clinicians and educators can upload patient specific 3D models derived from CT, MRI, ultrasound, or pre-processed anatomical datasets directly into MedisphereXR\u2019s immersive environment. .\n\nOnce uploaded, these models can be explored in lifelike scale and detail, where every structure can be rotated, zoomed, dissected, or annotated. Doctors, specialists, and students whether within the same hospital or across the globe can join the same virtual room as personalized avatars", "short_description": "The Future of Collaborative Healthcare, in Extended Reality."}]}, "developer_name": "Adreonix Ventures", "developer_privacy_policy_url": "https://medispherexr.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Adreonix Ventures", "support_website_url": null, "website_url": "https://medispherexr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "con
ontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZwWGoJ5--sztTzb_Slu4vgaF_Gzv0FOTnVsGpeTrRMQ&oe=6AFDD81D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "coverArtNoLogo_2560x1440.png", "id": "236433623488790", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12504601_236433626822123_9061740529036820480_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n8jiWujDipsQ7kNvwF6Bq4j&_nc_oc=AdqzKOg6xA24GT7Uh2fySzmFCKQX8PC5eQZkSmWvXvY2LQqelypiqbxAJGrruSXM6o0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNvG1KStqfLRwxEJ6hEs7O4xcxTpLt5uld_r4Ag3g-Dw&oe=6AFDE4AE"}, "display_name": "Power Rangers Zords Rising VR", "keywords": ["PowerRangers", "Zordon", "Alpha5", "Zords", "Lionsgate"], "long_description": "Power Rangers: Zords Rising VR\n \nImmerse yourself in the world of the Power Rangers! Behold Zordon and Alpha 5, and witness the mighty Zords rising from 65 million years of hiding in the official Power Rangers movie promotional VR experience for Gear VR. \n \nPOWER RANGERS \u2013 In Theaters March 24\n#PowerRangersMovie\nwww.powerrangers.movie\n \nSABAN\u2019S POWER RANGERS follows five ordinary teens who must become something extraordinary when they learn that their small town of Angel Grove \u2014 and the world \u2014 is on the verge of being obliterated by an alien threat. Chosen by destiny, our heroes quickly discover they are the only ones who can save the planet. But to do so, they will have to overcome their real-life issues and before it\u2019s too late, band together as the Power Rangers.", "short_description": "Power Rangers: Zords Rising VR\n \nImmerse yourself in the world of the Power Rangers! Behold Zordon and Alpha 5, and witness the mighty Zords rising from 65 million years of hiding in the official Power Rangers movie promotional VR experience for Gear VR. \n \nPOWER RANGERS \u2013 In Theaters March 24\n#PowerRangersMovie\nwww.powerrangers.movie"}]}, "developer_name": null, "develope
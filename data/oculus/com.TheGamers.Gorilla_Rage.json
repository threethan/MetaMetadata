illa", "Rage"], "long_description": "Gorilla Rage is a fun parkour game with the Gorilla Tag Locomotion.\n\nMake sure to come play the game and check out the parkour, cosmetics, & community!\n\nCome bring your friends to either compete against them or try to complete it together as a team in the \"Game Modes\" section!", "short_description": "Gorilla Rage is a fun parkour game that you could hangout or compete with your friends!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/13b2a0d2-b829-465c-b8c5-fc0a433f58ab", "developer_terms_of_service_url": "https://www.termsfeed.com/live/187d90da-76b0-4a3d-ba6a-d66550a98624", "publisher_name": "The Gamer1Y", "support_website_url": null, "website_url": "https://sites.google.com/view/1y-studios?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP", "SINGLE_USER"], "id": "9089207787804063"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/427363701_1675058843059163_2996202309803557843_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jULtOIL3R7AQ7kNvwFi1SVF&_nc_oc=AdoVNZTDNVmwxSolB0BarR59adYb9v17rFEVvqP2NTr1aDwfzNu5AcDxoMM6nCRUjqg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFlGyIaf7VEU5WY9JmLTHbjH_I2aYMO09QqBv4d8jL9Q&oe
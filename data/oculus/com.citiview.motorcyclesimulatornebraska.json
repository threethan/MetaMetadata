gcPCM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRGu6_g52exBJx_jvP_fzNljHiuzC896duNV-vCpqKCQ&oe=6AFC8940"}, {"file_name": "screenshot_1.png", "id": "2555885818210217", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593822060_2555885821543550_3534934763801467417_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Fk1z9vu1K8Q7kNvwGzPS3Y&_nc_oc=AdpSH1ys02klNdf056j0xauLOOGkDBmuEKJwNIXGDV6SLr4CrwyhW9QyQh47mCuu0vM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAeawlQjZeLceIVSowIF1KXGITgWjvIjKhCVJdlbQxkA&oe=6AFC8690"}, {"file_name": "screenshot_5.png", "id": "1817990466063105", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593839439_1817990469396438_3725477621670070234_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZMIWFNIcoIQ7kNvwEVP-ZQ&_nc_oc=Adre5Bl_rtTWkVEhfVZOcgP5OwLSxbdCpBhRAMhB1dqc7jWRFeqef8dmI2QdOO5f_XE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbhuimSA484qhvvzirozuknCvxx7dtb-hCX-a3Mw8ZJg&oe=6AFC8599"}, {"file_name": "screenshot_4.png", "id": "2270672356840700", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620403_2270672360174033_4690627195015512537_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEFO9C1FEcEQ7kNvwEO54g3&_nc_oc=AdoMGSS4ErQG8iP5CIOc3zCY6Q6QTOjaU-4kUW1uyDSD6GMfIHLN-Lhhgj13g8Bp15M&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQUwumWhOQaZexpyVP45d76WOnb6AU6XL-2h0czOZvbA&oe=6AFC9441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2220306762247508", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/593784242_2220306765580841_536251560343975954_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qwM9kWU_qEUQ7kNvwEwXLWO&_nc_oc=Adqp9sfKcydcKlCSzTjlQvdc09OHITlJHSfweW6p8O9dZlrS9XNa8nqwgDoPOO1M8Do&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSciP5N13iHLcjM-5gwKDXGk4ouMAt1becSOy2KN_9Vjw&oe=6AFC7192"}, "display_name": "Motorcycle Simulator Nebraska", "keywords": ["motorcycle", "multiplayer", "motorbike", "simulator", "nebraska"], "long_description": "Ride Omaha, Nebraska, from the seat - alone or with your friends.\n\n58 KM ROUND OMAHA\nStart in Midtown and roll I-480 through downtown under the First National and Mutual of Omaha towers. Open it up on I-80 west past Aksarben, then I-680 north up the west side and east over the Missouri on the Mormon Bridge. Run I-29 south through Iowa past Eppley Airfield and cross back on the Ford bridge past the CHI Health Center.\n\nRIDE IT LIKE A REAL BIKE\nGrip the bars with your own hands. Roll your right wrist to open the throttle, brake with your left hand, push the bars to lean - the horizon tilts with you. Tuck behind the screen for top speed, or turn wheelie control off.\n\nRIDE ONLINE TOGETHER\nUp to four riders in a room. Quick Ride joins an open room or opens yours; Private Room gives you a 4-digit code for friends. See each other's bikes, riders, names and speeds, hear engines and horns, talk with optional voice chat.\n\nYOUR RIDER, YOUR COLOURS\nTwelve riders, eight bike colours - your helmet matches your bike.\n\nEVENTS, SPEED TRAPS + YOUR GARAGE\nSeven road events against your ghost, six speed cameras, Rush Hour near-miss combos and your own luxury garage in Midtown.\n\nSUNSET, DAY AND NIGHT\nGolden hour over the Missouri, big Nebraska sky, or night on your headlight. Speeds in mph. English and Spanish.\n\nSAFE ONLINE\nMute, block or report any rider. Voice is off until you turn it on.", "short_description": "Ride a litre sport bike on 58 km of real Omaha, Nebraska interstate - alone or online with up to three friends. Downtown on I-480, I-80 past Aksarben, I-680 over the Missouri on the Mormon Bridge and back through Iowa. Grip the bars with your own hands, twist the throttle with your wrist and lean into the bends."}]}, "developer_name": "Citiview Studios",
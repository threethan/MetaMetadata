lations can take the form of intricate patterns.", "short_description": "Monkey Club, A Gorilla Tag inspried game using their locomotion"}]}, "developer_name": "Fays", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-clubb/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Fays", "support_website_url": null, "website_url": "https://sites.google.com/view/monkey-clubb/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8780083995431624"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/473393425_1375980283397352_4971929538309633230_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9q71mG1q800Q7kNvwFM69f-&_nc_oc=AdqHwedm9UNkYM07fZ6FXSX31Cc_ByVEa2agrlDyVH8Xk19bHvQlXIkDTUeHliF3Vrg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIf_cNoecUzm9OKvSbB5OLv3jY60haQGUlYLokXIeveKw&oe=6AA9345C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkey Club", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Hangout", "id": "1023770785722696"}], "release_date": 17
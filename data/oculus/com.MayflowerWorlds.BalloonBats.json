batsthumbnail1440x1440.png", "id": "552888737614921", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499330397_552888740948254_7033463011874053358_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGdniQfhoVQQ7kNvwFJsUeq&_nc_oc=AdnSjO9zympiTF0qWDKwnwG68BGHbv6XXgWGfOZeE2Fdj-Byok-dK-HNUEv5M4jXn9c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftY0IC3or4M70kn0TKwHRpbSXwYukE7mJY6pg15TVRZDQ&oe=69A8135D"}]}, "id": "1167291805573481", "locale": "en_US", "screenshots": [{"file_name": "resized_2025_05_09T21_07_39_000Z.png", "id": "626212150449337", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499321707_626212153782670_618928230995742811_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vaYcORmyu0Q7kNvwE3rrlj&_nc_oc=AdlI5iwn0ZRRGfB0DZNfnNNEccCm6lLucPnkhIwl_p19VCpg6GfoiavVydCV6_Pq3y0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuVrSUiemmHaTujwlWtNoRsNkVCBWbefk32ybGtQxBc_Q&oe=69A82B80"}, {"file_name": "resized_2025_05_10T20_57_35_000Z.png", "id": "678779508245279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499332197_678779511578612_1589031764797570179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFn9nxA9QVUQ7kNvwETJkbL&_nc_oc=AdnA8FPWxfFgxzpCU8u09RgWHAzqNhyCOtVviv8kYPalBKttwPvbOedSIopqIpN-jGc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftW_kkOtCg5UTDJtnT6vqAX4gM1Ab3jdLHhWq3v2pRoRQ&oe=69A8331E"}, {"file_name": "resized_2025_05_09T21_06_32_000Z.png", "id": "1129033862295478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499317917_1129033865628811_1110732533505182404_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_r7TDfAwpRYQ7kNvwG5Ssx4&_nc_oc=AdkQhAKuFbesZTtdhVV-fJ3QnQ8JcXCyIMKe9FfQafxEhl1dv_nzppVkP5Hnj9lcd7Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftXstXSZsjAwrbzy2G9o7KdeL-7DG5-jfblbB8WwoIqnA&oe=69A83053"}, {"file_name": "resized_2025_05_11T20_51_43_000Z.png", "id": "675734371839997", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499324833_675734375173330_7018018355443987373_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eW270XxP8cEQ7kNvwEeUnRp&_nc_oc=Adl26kb50RLFcwUYsDyNMQf3eaMtSQ0nBYJ1-q6bWgP8NPtYKqkxu9ujokmkFhHTgkQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft1ncfSu29ZIE9Cp9lIBp4FP43vcDSfiRNbdLsnS5krTw&oe=69A8114E"}, {"file_name": "store screenshot.png", "id": "1302603468118052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820470_1302603471451385_7216330326586993359_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=krk_7j739NsQ7kNvwEWLviV&_nc_oc=AdlFguduVEtiIj0lCfj5wobUA564IM948wtyK6alcOztCUY2XRBlMgTggc1gOtkqdtw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvCtHkdCNkmYUf8onW-xRSRq4RSgQqtNnNZz2MlVuYmqg&oe=69A82534"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Balloon Bats", "keywords": ["Balloon", "Bats", "Social", "Free", "Tag"], "long_description": "**Soar the Skies in Balloon Bats!**\n\nMaster the art of flight with revolutionary wing-flapping mechanics in this exhilarating multiplayer VR experience! Take to the skies as a bat, feel the rush of wind beneath your wings, and pop balloons in frantic aerial competitions.\n\n\n**Why Players Love Balloon Bats:**\n- **Revolutionary Flight System:** Experience true freedom with the most advanced flying mechanics in VR. Flap your arms to soar, dive with precision, glide effortlessly, and climb with agility. \n- **Aerial Minigame Madness:** Compete in a variety of balloon-popping challenges designed to test your bat skills and aerial mastery. Easy to learn, challenging to master!\n- **Connect with the Creator:** Fly alongside Captain Oliver himself, share feedback, and help shape the future of Balloon Bats. This solo-developed passion project continues to evolve with direct input from the crew, with every update chronicled in the Captain's Logs.\n\n**The Adventure Continues to Grow!**\n\nComing soon: More minigames. Enhanced customization. Seasonal events. Community challenges. And rumors of an airship on the horizon!\n\n**Join the Balloon Bats Crew! - https://discord.gg/EfM38YrqDZ**\n\nShare your thoughts on the new cave map, connect with fellow bats, and help chart our course through the skies!\n\n**Ready to take flight? Stretch your wings, sharpen your fangs, and pop to victory in BALLOON BATS!**\n", "short_description": "Fly by flapping your arms like wings!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tCPgoPgRwBgRjY6fxQW7VS2PDvB_owVqLglYTOgjHrk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mayflower Worlds", "support_website_url": null, "website_url": "https://balloonbatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33303804069233639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499330397_552888740948254_7033463011874053358_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGdniQfhoVQQ7kNvwFJsUeq&_nc_oc=AdnSjO9zympiTF0qWDKwnwG68BGHbv6XXgWGfOZeE2Fdj-Byok-dK-HNUEv5M4jXn9c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afv4XUTtZ2dKrhI4N91wOvHoUiMUJmnSS2C1ehU5EaBHGw&oe=69A8135D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
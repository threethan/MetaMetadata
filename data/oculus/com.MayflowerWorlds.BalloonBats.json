batsthumbnail1440x1440.png", "id": "552888737614921", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499330397_552888740948254_7033463011874053358_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtxtdgb8cMQQ7kNvwEr89sa&_nc_oc=Adn6ELyAnREl3Uiu9O8_cO7uPEPDdb8GZlQlOnzlIe399ydb3TIX5BuKl7CS73OElbk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz5Jr218J1eulJauul_qeU2cIz0bUfpCYM1pSDOsCGJhQ&oe=69BD2B5D"}]}, "id": "1167291805573481", "locale": "en_US", "screenshots": [{"file_name": "resized_2025_05_09T21_07_39_000Z.png", "id": "626212150449337", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499321707_626212153782670_618928230995742811_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlcp54pV0eMQ7kNvwFOWG6C&_nc_oc=AdngkdB99lvpUHH0VGyjuhmQcaIJ2RGm183x43LVUnJDvVJ8GKMlnh4LG40fbn2aM8M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJNMj77q4WXQYNmdMFOoJ_8GzIYKu1VPY5Wzu90ifTpA&oe=69BD4380"}, {"file_name": "resized_2025_05_10T20_57_35_000Z.png", "id": "678779508245279", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499332197_678779511578612_1589031764797570179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRWTQ_JN-agQ7kNvwFlo-Vo&_nc_oc=AdnXDDO5bN0hfWXqvIp8YqMm5gQx40lVsXzWU65_Y4pujgki1KjFZd71wOS_F1GM62I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwZKHSsgzsolDdGutUb-K2FCXNf8oDdWu86Pc_Gxtv7Aw&oe=69BD4B1E"}, {"file_name": "resized_2025_05_09T21_06_32_000Z.png", "id": "1129033862295478", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499317917_1129033865628811_1110732533505182404_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFw5V7qN51oQ7kNvwEFJ16A&_nc_oc=Adl2rtxdoly__VNZ_AWiB0erMXIIm3h8eCm23-pqJPmLFf_G92MN-ZFetyZy_1AvNtM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxdlkUBxaeaNKMPt61YMrYbMbD70lAlYlqAXFuvAOSRvQ&oe=69BD4853"}, {"file_name": "resized_2025_05_11T20_51_43_000Z.png", "id": "675734371839997", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499324833_675734375173330_7018018355443987373_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZmAQO4BmpAQ7kNvwHYsC4x&_nc_oc=AdnAgvE0aI6DxB-axvLO655K1t23JzR86LG4YFWJtWsTS3CpcKtm1d971J4_Fz9c788&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzoHK_ORv_E-l_GPOe7Z8tyNwJ7Sakqh58sqkaOcyI8Yw&oe=69BD294E"}, {"file_name": "store screenshot.png", "id": "1302603468118052", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820470_1302603471451385_7216330326586993359_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHhG_He3C9oQ7kNvwF8j7lB&_nc_oc=AdlDo1Bgjb8lDJAp7c0Gl_OS7NTqQel7BKGz_b6Bo4m8Kw4Ohnce3Zdh3Z6s1uwcenc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzcQzUTSqdOscxsrVJeXeccq5piYwKPdIqKbWChxrRcIA&oe=69BD3D34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Balloon Bats", "keywords": ["Balloon", "Bats", "Social", "Free", "Tag"], "long_description": "**Soar the Skies in Balloon Bats!**\n\nMaster the art of flight with revolutionary wing-flapping mechanics in this exhilarating multiplayer VR experience! Take to the skies as a bat, feel the rush of wind beneath your wings, and pop balloons in frantic aerial competitions.\n\n\n**Why Players Love Balloon Bats:**\n- **Revolutionary Flight System:** Experience true freedom with the most advanced flying mechanics in VR. Flap your arms to soar, dive with precision, glide effortlessly, and climb with agility. \n- **Aerial Minigame Madness:** Compete in a variety of balloon-popping challenges designed to test your bat skills and aerial mastery. Easy to learn, challenging to master!\n- **Connect with the Creator:** Fly alongside Captain Oliver himself, share feedback, and help shape the future of Balloon Bats. This solo-developed passion project continues to evolve with direct input from the crew, with every update chronicled in the Captain's Logs.\n\n**The Adventure Continues to Grow!**\n\nComing soon: More minigames. Enhanced customization. Seasonal events. Community challenges. And rumors of an airship on the horizon!\n\n**Join the Balloon Bats Crew! - https://discord.gg/EfM38YrqDZ**\n\nShare your thoughts on the new cave map, connect with fellow bats, and help chart our course through the skies!\n\n**Ready to take flight? Stretch your wings, sharpen your fangs, and pop to victory in BALLOON BATS!**\n", "short_description": "Fly by flapping your arms like wings!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tCPgoPgRwBgRjY6fxQW7VS2PDvB_owVqLglYTOgjHrk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mayflower Worlds", "support_website_url": null, "website_url": "https://balloonbatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33303804069233639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499330397_552888740948254_7033463011874053358_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jtxtdgb8cMQQ7kNvwEr89sa&_nc_oc=Adn6ELyAnREl3Uiu9O8_cO7uPEPDdb8GZlQlOnzlIe399ydb3TIX5BuKl7CS73OElbk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwxbvmxwj9gjAImR8f5C-slOuH3QZhPX68aCVEgXf4bXQ&oe=69BD2B5D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
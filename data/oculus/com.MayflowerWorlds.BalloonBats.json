aved checkpoints and correct error responses\n- Two choices for you today, both on your cards\n- I reworked Studio's Analytics tab (card studio-analytics-tab-rework)\n- I wrote the roster review It recommends retiring Dash and keeping the other five, and you can answer it with yes or no\n- I built the question judge\n- I added the nightly playtest bots", "created_date": 1794938783, "id": "40387974530816522", "version": "2.1.3", "version_code": 506, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27706668015613967", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40392041120409863"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794894642, "id": "40372146725732636", "version": "2.1.2", "version_code": 505, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "27706668015613967", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "40392041120409863"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794889235, "id": "40370425775904731", "version": "2.1.1", "version_code": 504, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 1}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer"
7373_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lURM58Yx1BYQ7kNvwGfUKVQ&_nc_oc=Adkr5Av7L2p6Lf5SA039uM96LLFvzbSEAf4vcnpSX7A0MPXBYtCloMBCI30d1TYJnds&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvMxK8zYe8QYLAAnR3jHlvRMp8gZFTB_n7U_M3itE7CPQ&oe=69A56E4E"}, {"file_name": "store screenshot.png", "id": "1302603468118052", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820470_1302603471451385_7216330326586993359_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ninl36DPu9AQ7kNvwGlxQOe&_nc_oc=AdnA6LEYuRoSPqQ5tWzANlWiUzuPNaBvLbmxmvvYY6vNLouuhlqLIoM7L9Zx5guNhGI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuP4AUSruxovNP50zQtAnXwmKsA-LxrOh1fejcLBmqFhw&oe=69A58234"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Balloon Bats", "keywords": ["Balloon", "Bats", "Social", "Free", "Tag"], "long_description": "**Soar the Skies in Balloon Bats!**\n\nMaster the art of flight with revolutionary wing-flapping mechanics in this exhilarating multiplayer VR experience! Take to the skies as a bat, feel the rush of wind beneath your wings, and pop balloons in frantic aerial competitions.\n\n\n**Why Players Love Balloon Bats:**\n- **Revolutionary Flight System:** Experience true freedom with the most advanced flying mechanics in VR. Flap your arms to soar, dive with precision, glide effortlessly, and climb with agility. \n- **Aerial Minigame Madness:** Compete in a variety of balloon-popping challenges designed to test your bat skills and aerial mastery. Easy to learn, challenging to master!\n- **Connect with the Creator:** Fly alongside Captain Oliver himself, share feedback, and help shape the future of Balloon Bats. This solo-developed passion project continues to evolve with direct input from the crew, with every update chronicled in the Captain's Logs.\n\n**The Adventure Continues to Grow!**\n\nComing soon: More minigames. Enhanced customization. Seasonal events. Community challenges. And rumors of an airship on the horizon!\n\n**Join the Balloon Bats Crew! - https://discord.gg/EfM38YrqDZ**\n\nShare your thoughts on the new cave map, connect with fellow bats, and help chart our course through the skies!\n\n**Ready to take flight? Stretch your wings, sharpen your fangs, and pop to victory in BALLOON BATS!**\n", "short_description": "Fly by flapping your arms like wings!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tCPgoPgRwBgRjY6fxQW7VS2PDvB_owVqLglYTOgjHrk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mayflower Worlds", "support_website_url": null, "website_url": "https://balloonbatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33303804069233639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499330397_552888740948254_7033463011874053358_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7HF-xJIp4QQ7kNvwEpnfGZ&_nc_oc=AdkEgRyIfeTgp85bvnDnQ5tJ6cp-kMcjFRkaq7bP53WyMq44JsTY8ErFJHNwnl7iG3k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afupj2-Ic2D2tbvONoHvP7pFAP13tUeTM9WK894m2L8_iA&oe=69A5705D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Balloon Bats", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES",
batsthumbnail1440x1440.png", "id": "552888737614921", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499330397_552888740948254_7033463011874053358_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3At6hggRYgcQ7kNvwHSaC0o&_nc_oc=Adm5yrvIXlyCAczuIt5pjWpSyl2-N-G4xIG6jWXyKhWdFEcZD378dmd15ROHu91TrZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKGudbN21j5_I1EhM_JaGmfNLDZtjFKG6dgKayu98d2g&oe=69AFFC5D"}]}, "id": "1167291805573481", "locale": "en_US", "screenshots": [{"file_name": "resized_2025_05_09T21_07_39_000Z.png", "id": "626212150449337", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499321707_626212153782670_618928230995742811_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dtu-nsUYHJYQ7kNvwG1wwUy&_nc_oc=AdljmN8w7R8idefJrO-X0VxUyd-3MBW60Z0uoc6AWgek8howu4WkMwmQnlr4Wn5jE4c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfweMRKtijvtB11TrMs7kZMvzYEsV-1f8rQjY2kdY0kG_Q&oe=69B01480"}, {"file_name": "resized_2025_05_10T20_57_35_000Z.png", "id": "678779508245279", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499332197_678779511578612_1589031764797570179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dlEjhmTbFY4Q7kNvwH303M0&_nc_oc=Adnyd3IJvgOzKQtBUxT0ZnrG6I3SCl3glRT3zgl_FyOT8GVZCaB5E315bZR3mYDt8-k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw75ODvFCslIJb84JnOM5GhbGUv5H6l7J91ZfwKKLz_Yg&oe=69B01C1E"}, {"file_name": "resized_2025_05_09T21_06_32_000Z.png", "id": "1129033862295478", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499317917_1129033865628811_1110732533505182404_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YJbYbXUCccQ7kNvwHkioAs&_nc_oc=AdlUy7I6KxjQbSX_prCtHX1q1MqKh9DiFhBBOOxFV5eiq99N_nZKnCdLKAHNBV0Noeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzGcPfUOnOGbaeCzQctpfrEly03UZBeq19S9M1mMzRPrQ&oe=69B01953"}, {"file_name": "resized_2025_05_11T20_51_43_000Z.png", "id": "675734371839997", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499324833_675734375173330_7018018355443987373_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RryM0VAsaKEQ7kNvwF-kIyX&_nc_oc=Adlm03116i86DxixBIdha916jNy0yGoMEsR7TYc2bLGVA_am3m5zHZt4RAzXwxXKiOs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoKlFBZJAobZ-qWHTEqzSWROu4_6Z27eZDtGG74GDN9w&oe=69AFFA4E"}, {"file_name": "store screenshot.png", "id": "1302603468118052", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820470_1302603471451385_7216330326586993359_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9roHbn87DFoQ7kNvwE2USSu&_nc_oc=AdlFCPcmXA0lIHYAG8S-lbNLo2qCAKQpvkqwtVMM6D9PiWUkKF0SgWnDRdA6ilVSjPw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_5d4akKOUtEgfp8zURalOxJ1uPeogh0f8JOPaz_rfqw&oe=69B00E34"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Balloon Bats", "keywords": ["Balloon", "Bats", "Social", "Free", "Tag"], "long_description": "**Soar the Skies in Balloon Bats!**\n\nMaster the art of flight with revolutionary wing-flapping mechanics in this exhilarating multiplayer VR experience! Take to the skies as a bat, feel the rush of wind beneath your wings, and pop balloons in frantic aerial competitions.\n\n\n**Why Players Love Balloon Bats:**\n- **Revolutionary Flight System:** Experience true freedom with the most advanced flying mechanics in VR. Flap your arms to soar, dive with precision, glide effortlessly, and climb with agility. \n- **Aerial Minigame Madness:** Compete in a variety of balloon-popping challenges designed to test your bat skills and aerial mastery. Easy to learn, challenging to master!\n- **Connect with the Creator:** Fly alongside Captain Oliver himself, share feedback, and help shape the future of Balloon Bats. This solo-developed passion project continues to evolve with direct input from the crew, with every update chronicled in the Captain's Logs.\n\n**The Adventure Continues to Grow!**\n\nComing soon: More minigames. Enhanced customization. Seasonal events. Community challenges. And rumors of an airship on the horizon!\n\n**Join the Balloon Bats Crew! - https://discord.gg/EfM38YrqDZ**\n\nShare your thoughts on the new cave map, connect with fellow bats, and help chart our course through the skies!\n\n**Ready to take flight? Stretch your wings, sharpen your fangs, and pop to victory in BALLOON BATS!**\n", "short_description": "Fly by flapping your arms like wings!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tCPgoPgRwBgRjY6fxQW7VS2PDvB_owVqLglYTOgjHrk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mayflower Worlds", "support_website_url": null, "website_url": "https://balloonbatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33303804069233639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499330397_552888740948254_7033463011874053358_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3At6hggRYgcQ7kNvwHSaC0o&_nc_oc=Adm5yrvIXlyCAczuIt5pjWpSyl2-N-G4xIG6jWXyKhWdFEcZD378dmd15ROHu91TrZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyPNJbU22nWzRIUEnmj20Kb_NLZZVHPQazU04QrLPQdwg&oe=69AFFC5D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
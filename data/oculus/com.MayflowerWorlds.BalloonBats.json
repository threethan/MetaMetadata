batsthumbnail1440x1440.png", "id": "552888737614921", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499330397_552888740948254_7033463011874053358_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFvqrhtdEvYQ7kNvwFgCiVr&_nc_oc=AdnER4IUOEyrzx1bu4UzhnoZ0xQkezt8eJCN6Vidctw_RjHKJHG53X3ytRdQGauaXjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxFUt35oc4SBKo6Kl7847HbwtqVbTmysrb5R1uWC2UgFw&oe=69B936DD"}]}, "id": "1167291805573481", "locale": "en_US", "screenshots": [{"file_name": "resized_2025_05_09T21_07_39_000Z.png", "id": "626212150449337", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499321707_626212153782670_618928230995742811_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7uagA5894IQ7kNvwFy2gkf&_nc_oc=AdmkVzttTVDGC08qKXdxJxJdaw1frMkrY5JoSZLpyb4p5ufcIQ2rHtE3hEORVJ0DXF8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyI0AjbvvdSlwUThVsqMKXbL2GpjZtMNYvKrgZNcXZgbQ&oe=69B94F00"}, {"file_name": "resized_2025_05_10T20_57_35_000Z.png", "id": "678779508245279", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499332197_678779511578612_1589031764797570179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oLKDp1jAe4Q7kNvwFjBzYo&_nc_oc=AdlzDSSzjW1PAnxBnA-bJCaUipPKxfd2CGV8UlgJ-zCSECEBfVMmQuZdBPU2mviA5IM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyF94OAxNmKrZ3-rFflYSGTh54kkXXFMkIHGa9NHHMvgA&oe=69B9569E"}, {"file_name": "resized_2025_05_09T21_06_32_000Z.png", "id": "1129033862295478", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499317917_1129033865628811_1110732533505182404_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sElnBohqHBoQ7kNvwGBhWRb&_nc_oc=AdlDCUYzvfSqZfvERKChlg3yn6YTfMhKprtF15HI3wD6AXNz_ivqEl_45pc0ttlmPYQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzxVtVwlaF8Q1s2l9TrH-C-wLXELnhYqr2QsH6vPrA9mQ&oe=69B953D3"}, {"file_name": "resized_2025_05_11T20_51_43_000Z.png", "id": "675734371839997", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499324833_675734375173330_7018018355443987373_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DGCq9vB73RUQ7kNvwFY5Gxm&_nc_oc=AdlD3P5R4K7XdlVHqanY0iEwkr7LqSQrOdqZOMflkg0EyY2LYglziLABU-qp8xG3uBI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwnFdQKYbgXarVVG9EGFSoXDaSnh_uJuiWCqYakV8xpdw&oe=69B934CE"}, {"file_name": "store screenshot.png", "id": "1302603468118052", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820470_1302603471451385_7216330326586993359_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFdZ44fBuicQ7kNvwGgZ3kj&_nc_oc=Adm8WtqbgxVAs7ZUP9y0yzlbmuUmKvTm8e7nbkHzDxkCe8bHmj4FdjMndfC-UOkKAuQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTyQnttChSdUleFNo_pnjvZR7xaEKomTVs6uG7cVHT1w&oe=69B948B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Balloon Bats", "keywords": ["Balloon", "Bats", "Social", "Free", "Tag"], "long_description": "**Soar the Skies in Balloon Bats!**\n\nMaster the art of flight with revolutionary wing-flapping mechanics in this exhilarating multiplayer VR experience! Take to the skies as a bat, feel the rush of wind beneath your wings, and pop balloons in frantic aerial competitions.\n\n\n**Why Players Love Balloon Bats:**\n- **Revolutionary Flight System:** Experience true freedom with the most advanced flying mechanics in VR. Flap your arms to soar, dive with precision, glide effortlessly, and climb with agility. \n- **Aerial Minigame Madness:** Compete in a variety of balloon-popping challenges designed to test your bat skills and aerial mastery. Easy to learn, challenging to master!\n- **Connect with the Creator:** Fly alongside Captain Oliver himself, share feedback, and help shape the future of Balloon Bats. This solo-developed passion project continues to evolve with direct input from the crew, with every update chronicled in the Captain's Logs.\n\n**The Adventure Continues to Grow!**\n\nComing soon: More minigames. Enhanced customization. Seasonal events. Community challenges. And rumors of an airship on the horizon!\n\n**Join the Balloon Bats Crew! - https://discord.gg/EfM38YrqDZ**\n\nShare your thoughts on the new cave map, connect with fellow bats, and help chart our course through the skies!\n\n**Ready to take flight? Stretch your wings, sharpen your fangs, and pop to victory in BALLOON BATS!**\n", "short_description": "Fly by flapping your arms like wings!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1tCPgoPgRwBgRjY6fxQW7VS2PDvB_owVqLglYTOgjHrk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Mayflower Worlds", "support_website_url": null, "website_url": "https://balloonbatsvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "33303804069233639"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499330397_552888740948254_7033463011874053358_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFvqrhtdEvYQ7kNvwFgCiVr&_nc_oc=AdnER4IUOEyrzx1bu4UzhnoZ0xQkezt8eJCN6Vidctw_RjHKJHG53X3ytRdQGauaXjg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxel6ixy-cFsojN6TdzUGrYn2BOhblqlIZ8WfDoRAKYDQ&oe=69B936DD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "
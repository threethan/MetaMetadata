_nc_ss=7f20f&oh=00_AQI7xe-USwFRzxil3kFB5zif5O7tszVIdOpG8k06dVkUWA&oe=6AA952D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-01-06 012246.png", "id": "579718308128712", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39031432_579718314795378_2929834221472137171_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UorMz-FObLoQ7kNvwGjRSQv&_nc_oc=AdqDLY4ZMkiWt3nuFBkNB2SG-vxzLPNWvgleKNeWALoFe7-GTZxjrzR6hmxVJOYH8GM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIO-BjixikpF55r8X9PEnRC-ZiIFUabzYzPlT98XZccmQ&oe=6AA95ADB"}, "display_name": "War Of Ship", "keywords": ["War", "Ship", "Comfort", "Elite", "Cut"], "long_description": "Set sail on the adventure of a lifetime with War Of Ship, the ultimate pirate-themed VR experience! Take command of your ship and navigate through treacherous waters filled with challenges, mysteries, and treasures. Engage in intense naval battles, fend off monstrous sea creatures, and explore uncharted islands to uncover hidden secrets.\n\nImmerse yourself in vibrant, toony graphics that bring the high seas to life, from the crashing waves to the glowing sunsets. Customize your ship, upgrade your arsenal, and recruit a loyal crew to help you conquer the toughest foes. Whether you're hunting for treasure or defending your ship from relentless enemies, the gameplay is designed to keep you on the edge of your seat.\n\nPerfect for fans of strategy, exploration, and thrilling adventures, War Of Ship offers a unique blend of fun and challenge. Test your wits, adapt your strategies, and prove yourself as the ultimate pirate captain. Are you ready to claim your place among the legends of the high seas? The adventure awaits\u2014hoist your anchor and dive into the action!", "short_description": "Embark on an epic pirate adventure in War Of Ship! Command your ship through treacherous waters, battle sea monsters, and hunt for legendary treasures. With vibrant visuals, engaging gameplay, and unique challenges, this game immerses you in the high seas like never before. Test your skills in strategic naval battles and explore mysterious islands. Prepare your crew, set sail, and become the ultimate pirate legend in this thrilling VR experience!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/war-of-ship", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9389610384402690"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "27960841216884286"}, {"status": "PUBLISHED", "id": "2197515277722202"}, {"status": "PUBLISHED", "id": "913698307699965"}, {"status": "PUBLISHED", "id": "860679759820635"}, {"status": "PUBLISHED", "id": "670411598702003"}, {"status": "PUBLISHED", "id": "1909504883201207"}, {"status": "PUBLISHED", "id": "2777252832454990"}, {"status": "PUBLISHED", "id": "2106963956427026"}]}, "baseline_offer": {"id": "1909504883201207"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787079600, "status": "PUBLISHED", "id": "27960841216884286"}]}, "liveChannel": {"nodes": 
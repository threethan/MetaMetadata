18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3GUCfarpIkQ7kNvwFCZL3M&_nc_oc=Adqpix8yudA0mTjmZbr55000kgD7vWUzIz85k6uzBaaxSbhXCwF4Thwzs9M_YaepBKo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K8hqlcI0RUuowh42apldO_znwemz2gdhDlafPmnXwpA&oe=6A0B14C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8cMvtVzhWYQ7kNvwGH3Hx0&_nc_oc=Ado0mTyV0ColAq6EkXOIuHZY717ZPtsCZsP22sxpFGa6qUtC1HEwO5mxPwhf6Nifw3c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qd3JAyeVZNwH4iETNs0J8CU29LPvwn8Ctu3UTVTNdnw&oe=6A0B06B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoVejHydghoQ7kNvwFWqCav&_nc_oc=AdpplpOy3qofsMCkqZkb12KaeipEk1UU_WpxCct9qV1bSO8JcL5RyWZ8r5q3mYrQlWI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qrzrhrrVF6FjyhSsBb-WVesjMh1e2K6_9f5L_w4-khA&oe=6A0B2AFE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
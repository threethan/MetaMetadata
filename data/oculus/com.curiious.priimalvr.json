18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XYDo1qm6rrsQ7kNvwE6Z0BG&_nc_oc=AdoLfNEwjXqkHblyNy4jbaMr34859uXXRunNM4SNvEWMnWyPQdIHAxtRieZ7BDlJFl8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7piOrTnjIX5SEBJZFK2HplZugA-anwAEjvFLwldFXZ2A&oe=6A144F47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OmQO8XxwakQ7kNvwHWZ8PV&_nc_oc=Adpk5x7bXfThpHvoNS4jrfHZQLlGUmA6V-pSDy-zsAT6umgKWmyLYQvQsX_DL0_cQNE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WIIwhLvkErHB7tYjZywJskufgsKxYaH7qUb1DPpUplQ&oe=6A147970"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5tkx-5R9f4Q7kNvwHgHImC&_nc_oc=Adr9fc_58jQlgm_wC_dcQOyRnMC26SNBJawi3_mNbFkQGeuaKoMbas4nPkgNTgKgGm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZGa_BCLuY06OQY1xGlSvhurVYaCDLwGUrv4Zpp5D_lw&oe=6A14657E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
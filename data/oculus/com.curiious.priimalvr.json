18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It3880XpyJsQ7kNvwHul64W&_nc_oc=AdpXc9kvDDuGqb1xdx4vs4SRfdeN2Ofoxh717wUMz7EombVKxt1F0C1SA5Op5aImq3Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOt49nDqvCOWVTKpktDHMWDRMCe1944BRjvY05PQ0OcQ&oe=6A4CFFC7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cM2jUo1bmusQ7kNvwHfWr6Y&_nc_oc=AdoMPDXrxjQKr37cVNQ3KkbEA09qSpzZCSr2jU022gPGcYjkLfHmMD25odVhrIjtTTE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcwMwTwyTIHpqcuhru99cZ07sYk6bpWHe-ggTCJhvYcg&oe=6A4CF1B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5kmxwoVBPmMQ7kNvwFkYV11&_nc_oc=AdqevOEyRI6Kv_ggHFmhOauBVKNYZ6e--rMbKb-_9EJu_tLYObHC6TWsjGWJ89dyfsw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9jmHtNMIdgJBLHmqO2ygeYLGpjnBwa9O5ERX9BImSXA&oe=6A4D15FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
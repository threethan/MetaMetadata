18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4EKDUTD1fkQ7kNvwGh0yBC&_nc_oc=AdoSLy3BFlyQAHaplQHZ3EU8ntQGN2NEqEgdZV8DBT407kCkWQtx3GsjjUiHfwYIZzc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LAiMa6k3j7LlMYrC8BsJLfup8DbJ48L-sTNGZnY6xEg&oe=6A4273C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPjR1I2awZIQ7kNvwFc6uE0&_nc_oc=AdoIb54hy1eiogG9ZEG_fFbwP-wM_0Ubl-9apajEKVHo2XlCz5mO1xQmxJFfH0DUFrw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KS5nD282xEv7iBSC1Ujc4f2tceUwex03gVlGdXBYPuQ&oe=6A4265B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnJqfbNo4dkQ7kNvwFmsoss&_nc_oc=AdoZ0gY1LFp_xosYszTP-Q4uv38jkFL5t0aKyD0G4MmT2UloPrRbTWpjILcX7Dc71IU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bvdtR3u7k-kbMuCQJkaX3GQc-G6qRyEzzVeUsWMknTA&oe=6A4289FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxb8M9zygwkQ7kNvwENOh0h&_nc_oc=AdozKzEmrdPEcHow4mbFYGss6m8IGV0hXTh02SEE7rfmN1PsTWmTTRdKsH2Br9Mv0qA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTsPRURFLNTBm-EtGgL79jEcBZm6cvwaSgzxcCWbED_Q&oe=6A81BBC7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQwOLNT8kzYQ7kNvwGrIsZO&_nc_oc=AdrktEb_G4_8JFWUmviJSU_hgTGPY4hFdzPEc_RQBDSAt7XJfi66c8rKiyNWLdUq-V4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGOJHFWHeZjvC1g50h56duSVNcC_MD_cJNE9a7hDLGN_g&oe=6A81ADB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTkaqiFBFlUQ7kNvwFvvXu4&_nc_oc=AdpbQfeLWX7WG2QrNMjKV9bXQ-0LsxqVzq4xLzuS3Kh-zmlESP3vwWmYu0Q1Le6jH6E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdY1gkpKkQkEV_TZW9ayQrsbVtZ4EtWvt9S5yTmDc8wQ&oe=6A8199BE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt3nny1JptkQ7kNvwFA79tN&_nc_oc=AdoZIilnyjbJivpkY9QCaHKUI69KMtSnHhnRM65TH1CLNk4MyNxjTGnZ7hrrfnQ58RA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5snfoayZuY_oXQ92V1vD4a4HLJS656-stxkB_GL6ENCA&oe=69FB42C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30404ucDnigQ7kNvwHXOLB3&_nc_oc=AdoBdWJA9xhP1gVe4Oc16GQ-WhJviN0Gk1lIG9hRwB6kv_wuzEQSL3BEUkQwfXo1kTs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XWFqeMtAsXT1lRmrEOBQY6Y-69KZ57nmm7p-or8TTUA&oe=69FB34B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjSr77GEcMwQ7kNvwGhet2n&_nc_oc=Adoa_H4hFNrtngSn4_fdRuk5zbw6S_fnxa9pRfgUnQOv5Rr3rOGUoxzinDrYUJxb5qI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7viUznrtnzlSmyK7f3BrFuhSdRP-Pfv8MqBsVWi9agtg&oe=69FB58FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
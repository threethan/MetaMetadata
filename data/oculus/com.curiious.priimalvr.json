18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d5CjHSBEqoQ7kNvwG8cIyO&_nc_oc=AdpA7DWXYmtekQRMjeSXWTljKNiwdi1COVRjJb_k_rKY3A5LBCrSmhmmiwgkevECxpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyjUn4X13DhqMDuPj8uzgSliiRScotXHw7Dw9CQ2PK-Ng&oe=69CE6FC7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBiu9ydeC4oQ7kNvwGr-M1r&_nc_oc=AdopLPOcnj_WIEoL4WB1mq4OIuaBPq9NajIMfmdhJjZYl-zKh-luaGSLAyyEVRc73XY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzdSbb0mmKaQRBm8pTlH-L09--CmWRRANUFmlY2ANvEzQ&oe=69CE61B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1aRj2zXqNYQ7kNvwGz68kV&_nc_oc=AdqIVERjgXG572NsEArRTH-YUHWNRPnr_x9M0eg8aA3_-uTP60LOBCF0F9NUQzIQXp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFkBOJrW_RC1idlwyGuLgj2GDfMAn0EESs-Bl6ti1Izw&oe=69CE4DBE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
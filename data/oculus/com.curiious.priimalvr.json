18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKgIEBkjSqQQ7kNvwGNsWRv&_nc_oc=AdoV1fStx2CprpKGeEhkOT_xO7baN71uVSKKVgXLLHlDv6qZ220WqY4kJiPYg5Rh9RI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmt671nCupJInG7FrKkevDEfzwxk2G0NkOEHbSPyuwEg&oe=6A974447"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94VPXlrj2o0Q7kNvwEYeLOg&_nc_oc=Adpg7Kh63Yhy7N1VYEK-IgnFGuc2yfn7sIzWW4yNVAdAfAYKASDAQUx-wMfIDm3SE4g&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQZ1K6MMWUoAUbQT4iNWk253knNhLjapC5FbucKvMgmA&oe=6A973630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SVWQo2T8BuUQ7kNvwElGvX1&_nc_oc=AdovSrIE8O0-B1sATN6dgZqQIwtkQNoJlWq3aMcsiCsYN14IZbabSlQCUR60uAqSr7g&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj32E0-jn_aPVR22W9jujkDu9dwoyi6uWoqkuHfi1OeA&oe=6A97223E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
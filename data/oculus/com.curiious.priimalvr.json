18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJvWYJW4v0gQ7kNvwHpReif&_nc_oc=AdpQst8SQRMuIZihMcKXMes-ItshDn75rR26eHo5sJiA2gOtmTOHoRtXqh3ya_Zon6U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo1VD7ynS_8C9I3dLTxC5qbwrU6JoIGG_vzJ4OVqAAYw&oe=6A92DF47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skv2vy-O0qwQ7kNvwEvg4Ma&_nc_oc=Adq9Yc5q2XIBQEi462imBue01BZ_a5_qqnpqk-jlvNeAWa_npQK_zuEaSM0Ppl2KTJc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFN40mq-sIvOWgIP2AmoAXa3jjmd6LYpdYw0KG55IP5Gw&oe=6A92D130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9tSVsW2YdYQ7kNvwFzzDTd&_nc_oc=Adq668beFYTdLVqO5tq6wUzVeb0IaunmTWskzfonMLMF_DSE0eRSYt2k14OC3KKB_2Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-gVJJvNiGzw82bmYXWUU0QWGJz4CsuX09Uy5J4QutGw&oe=6A92BD3E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVpXBJTj2WcQ7kNvwGz2ZJ5&_nc_oc=AdoGiCcW00kDHZpNnI-xIMG9_aIAbRz7nS4ltdy4aP4IJ8rCdUbgUfdclBbDFekKizE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpEEGYkTsIetwvvJ7PtO_bsp9ojH-WMF9jkH9iXmb4yw&oe=6A68AF47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3AQk5AMJRcQ7kNvwGwsIDv&_nc_oc=AdrQlyJ-5Nf2A89m1P1RcdkftO2Kxt26xAFScpnd9E07l7FHBtUCmLZZryTly6mHwGQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDm90R2u8Mr6OCPklPbIhBtMVFRfF5F394rREJmk5hRpg&oe=6A68A130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzV0mX3VtfoQ7kNvwEbYutF&_nc_oc=AdptPvuCvWowLToovnVHGJAkIJHmo04LlExkbXb-9fvFyGvRuzK6FOavFLcb_Ch_CvY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL-8Ku1Zgu7oDtI4ACky8_Ug60kvPS43S4Q3BLwvsF8A&oe=6A688D3E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3jUUlKNQMJMQ7kNvwHNVDtb&_nc_oc=AdpOnaU382_YxnG_QjB6t_6XwaTC_rh4HIihC3cxieBle-6s06oKsop1N_UQDHdhqv0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLF8s1B1WwAFAi-x8BeQdWfrj6XJDQODtVs2UDPbk2kkw&oe=6ABD0F47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmObdh2HOkcQ7kNvwHopmP0&_nc_oc=Adru3Uegv_XYEAs5lpqssquXqk966aLBoQxAZGQLWqO44ZmHqPK3RDhKkLbuf-w49ds&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIlgqiAqb9lfOaPPZoNDh5dS_oulNL8I2PNK4DUZA9elQ&oe=6ABD0130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mIXtYkHdUsQ7kNvwGzRd4C&_nc_oc=AdoOodyHI0tlgmMElzjS-yElQYyM8dAPP7JXJq6IVX0wj0SXpdizIpq5gm5P2yTEBEI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDtkpWyIEnD-kESX_nZBPtLRg--bEPEbO2gLjIaI1JYg&oe=6ABD257E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
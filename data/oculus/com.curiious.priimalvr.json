18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxb8M9zygwkQ7kNvwGojYz-&_nc_oc=Adp-4H-8XUhZDaO39UPc1ebGQnQpy42KYRqC5HCw1cEiFo7HEee-CQ_1QiCeeqrvrrg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHabXo-2AwOqpxdd7N-JjUUnb3-LIznFOvdMhaW7I_GHw&oe=6A7F18C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HfY0BhSpZQQ7kNvwGR3GEM&_nc_oc=AdoYvNsfhav6aXRn23uecL4p6gAGuICIvciRUDEXFZFUDPcu8qr8Nvo89uWM9TUaMC8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPm7Gxq0BGgfPmKICwAFWuNHGjMteBYBykIKDdGus2iw&oe=6A7F0AB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxPkyQ9IvQMQ7kNvwFnDQse&_nc_oc=Adrdjt0qKOvpW9osb8euL6AIlpPNm4zZ7w9mbWGRl220uHgFGceTyiC6W1w6F7dVJec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZwBuos5TYAM36UzkhunGD1D4Rh6aZoh2THfVeEUdYSg&oe=6A7EF6BE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
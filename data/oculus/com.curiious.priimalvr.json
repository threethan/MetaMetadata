18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aOkyz6M-ZCAQ7kNvwEax1xe&_nc_oc=AdrmLPMKikvlNiKeK8R-JxoJ4b07AwktAjBGgKgaGwZ2M3mR6q2a5BbA1Bd4UUZkSj4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25zT2wsDZPs1tNs4GXmjM8vD5Er1PgamPRaOpbel6zdQ&oe=69F359C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgnp72xMAsAQ7kNvwEVdBp9&_nc_oc=Adpzs53gDa4O3P6Tw5ACB98gh_zlVh-e8Mzh_viR2zr3fREQEAo8XKsjWCDchwZWHYg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2FxSLdY8pg-LapjfNQjuTAAHhecynimjMuAW8uFYFm1Q&oe=69F34BB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1tMrXTaXXgQ7kNvwFXp4tY&_nc_oc=AdpKNihBFeQ-5YFg2KS0GhHQ1Myc1t9_0gVxxYN1I0wp0IR6_uM_IKR1ikPCiuVnnR4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3JOiBz47E9ra35_Or5W-uxTh3XJU9pLKWtXtULDki2Ng&oe=69F36FFE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
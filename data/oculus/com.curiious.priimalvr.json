18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dT14zA5AKXsQ7kNvwEWODbH&_nc_oc=Adq-FL7BSj0hgRGZJ-xxOP0JOdPIRJC12NJbqnbKkNX3yCUoZfm_fsGUCftH_-twRWk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AOx7qSFsN83HE_6DO1ahSY4gNYuYpmB6YjMnhABrq6A&oe=69FF3747"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bATeMLpD00EQ7kNvwFuiEAF&_nc_oc=Adp4YjU74ofIbrJTkfm4YdRWcjvqdE7FNsJfNMnhuTRk7JsIcM_MrTe0YkwlCdiopNU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HezpxvgdwwCTUmQdEtsolDefoBh3-iNcALHNBL0HT3Q&oe=69FF2930"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O2YsiwAkNCYQ7kNvwETnvX5&_nc_oc=AdpK18hm35325qesLTw1X1t0DRqx5i6bV710hbgLMj_0kjCZgU12JFTi759nYPeF7Ak&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ImBGFTsyi5shAcFdCB8fzvz9kFRUW5XTpMvwI83z9ew&oe=69FF4D7E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
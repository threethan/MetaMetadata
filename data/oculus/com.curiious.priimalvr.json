18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EwQPExiCXuoQ7kNvwEE2AHK&_nc_oc=AdqhYqI20GS8BNvl98zRHNj1kZKcZn77pK85XphcP6BQEqqTl6783dkPEDAnJ6RtJJQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs9X22emlYxX-5j0dKKa5vXt4aihnM2q8BqJPHpsa_sQ&oe=6A660C47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3AQk5AMJRcQ7kNvwGDM4ZY&_nc_oc=Adr2fDh1qzWYyoAhmkRi06PNSh6jWptu2-xW2Q-uqCSxOYWaqGgIUzYlEJkK0m_M4SU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAa8zHbw9k24nyEEc_6DKV4Zv3kNdWkC2vm78oEniHmOQ&oe=6A65FE30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGxaiyifFSIQ7kNvwFQJjbc&_nc_oc=AdpjIdrW3kQswG0UDfXV7U0LGLE4u7mOLt_5nUoIiLFz1CFGelMIDcH2QWwZHe7_R78&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANe4EHcs_xTN5WzE4fgWzDXXw2s5DniAMyd_gN2R4Fzw&oe=6A66227E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vezqX1901VUQ7kNvwECIecm&_nc_oc=AdrXml52l2GD6xen5DWfJDpMfrb41C1GxnRBPG8TnqBACjQ6zplRdFvHHcAkUgwCdy4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1jVLK38Hn-JyYLgJ8067cl3GB-moM2Js7wf1X04u2kuw&oe=69EE13C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSueBX60hOQQ7kNvwEucBq7&_nc_oc=AdrzjXJ2OLl1jya__cHuMQMq20y4VmOsQQ3AyJAq-Y8Jk3bEUIQt3KU_rfp3K1jErtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sKNEJAFaG5rE-cYK8ZvkRl195jfezB-NrqLwlZTn12Q&oe=69EE05B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PvNicl2lu0Q7kNvwHxSNTp&_nc_oc=AdpU8YCw0cvXacEpFOEfx6VEmr8E8U34cfAf6jGsaOnv_DURJGpyLqMVam5AS2hsY4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pUTLPHnmK2AnCNS8OERqqnjtTIKR58gc-1hkLe2JYxA&oe=69EDF1BE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
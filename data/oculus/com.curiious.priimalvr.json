18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NgPzaSnPc9MQ7kNvwHdO5_B&_nc_oc=Adq1K1OfkZjzwPBKLdm7VPE4dtqBHJ-vjK3ug9D-aI0t19iXcGeNo1JjYytTiK82OYA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6V0iOW06nqF0n6HgPFn0Kcaptp5n9C0ub8B_fVuaihw&oe=6AB28347"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mh9UmpaRIwAQ7kNvwHNyf5q&_nc_oc=AdqxvlFH6DDkSV-NX6_ZHGqkA_EfiK1bZ7tV8PaTZY0ti3EkCAxAfOdvFd2QSPImxCs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9DsQUAkQsFFn-nlsHQfsvKXhEZz2hZ7spJKm4-tAF8w&oe=6AB27530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kl0t6iTktKQQ7kNvwE4RR0I&_nc_oc=AdodZBr7nxYVToPwdHbpYwb0oPw61UjUiEX02vjB6D291sAARiqb3ye4c1in35yh__I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4fRnfgfCTE5QiUl2dg9NIno968ERksamixG9iyFHvLg&oe=6AB2997E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
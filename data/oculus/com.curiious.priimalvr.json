85_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCIOMlmnvXIQ7kNvwElmaWP&_nc_oc=AdrSLf4UuXfbb7kOkYr_WZVVcSV3PjWfo1SP2Ssa9g2_JWJeSq7onn3wvlGO8qpyUTA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMhzHGgaCDoxuknH8aHm7qovsJ5IlRy2HG19Tt2rFycQ&oe=6AA40912"}, {"file_name": "Image 3.png", "id": "557715432152255", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035357_557715435485588_7157175866805437469_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCQOuo1yGm0Q7kNvwF3h2OG&_nc_oc=AdpfSHL6ww8yg9onWO2HYZcba3ltM0EocKr9DnAGsVxKxag4b_l7Czg4_-nuZuxdMng&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBse_T-aF09kctfoIk0wSvLxSeI15jvAXPp7QiawD1PQ&oe=6AA3F680"}, {"file_name": "Image 4.png", "id": "1434492306947985", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031618_1434492310281318_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qxi5VF2iCn4Q7kNvwHP7LXK&_nc_oc=Adp_X3Yy9Am0CMgp07uKcwjGOm5kFE6zo3tLUSRcFFs1V1BuIpOpiam1o4cKvLRGtZw&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAnu-2CiAJA19gcdAP7I_tG0_i68g1yDBV0bzfPFDZUg&oe=6AA402C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kbq9mBqriboQ7kNvwEB5kPa&_nc_oc=AdoM4Ekx1ORlssOcvpnoUGinoCoB-nV138OgtWOWsbBu1XdVz6aSrm2HSG7VDLQ5EFQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYGDxg8HH72kPPuzyuPuMazBe0tON1hA6XYWhLDyclXg&oe=6AA3F4B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1S01kHR8Q0Q7kNvwGQahp9&_nc_oc=AdpwzATSORDDCvgMVrw3HXmD8LCE7eCzisH1hehrJuljrfvnOzA9zPw6ZjnCKNHK6hk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjJ-5g4kkSb2q0Ma_yrNarYCGSQ2LHgGRhrse8CuzVzw&oe=6AA418FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an unforgettable teaching and learning experience for both educators and students."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.informa.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Primal Pictures", "support_website_url": "https://www.primalpictures.com/support/", "website_url": "https://www.primalpictures.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450317386760213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin1
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PK1Ivp6jmMsQ7kNvwEl63x6&_nc_oc=Adrn-gqpJSecNcCU_g0vw73S4q_g5qdu7-RUp0DH5u0ctkri71_S9ea3JZoamIEEhEI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoYQc51eVKyyQ1eZ_8dTaPGZb6JCQ6GUffCPg00W_KAQ&oe=6AE9E247"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cH99Zj4PBesQ7kNvwFjsunP&_nc_oc=AdrKZtRBNDGx3cgfIMVZD3g7ShkLuPEAKwJrjxl42JNizWp26mhB4djIjRpJc_M5VsQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKgx9QPmGJ848mEF62nvYeLHUczE7D8H2_jqin1-PNug&oe=6AEA0C70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuvQpDjO74oQ7kNvwGTdDrq&_nc_oc=AdoiEHDmR6qHN2ymwtYWrYqLkhgTJRmdiXjsn0LuAEj9gLFusRCfqRFad6wA9MQsuXE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrsvnbkn0QM6wGwUXjAt0jkegB28BlEguWAu0n1B70XA&oe=6AE9F87E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
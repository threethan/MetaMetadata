18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FnNVV3tkACgQ7kNvwFXiZcA&_nc_oc=AdpUekjHkTwL4fjArFhOUJ418sKG4PAtTHmBVnZ69SgvHv5iPM5f-lErlST3uIph4Kw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiFHBPtJS7v2ui4HI3b-zzR1gy1__6BGcSYVHdfl9C0A&oe=6AE49C47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_aEat94yoDgQ7kNvwHhxqCF&_nc_oc=AdpMIY-gx7pSem38Mhny7HQ0-kqaTjfm_p4E3KM2_uoqZvqVie-p-Uu13DW8LnEooDk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzbcv5e4Wu8y4rM5uhzAtCMJXXaGA20YwXgDjt0yWLjw&oe=6AE48E30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ep0wNiKc0hIQ7kNvwGtXNAL&_nc_oc=AdpV2usiAZToSAdBc3aS56dF-1wdd662ZsZRH5n5z81uXc7J1PIzPNX0QPR5OyMYQrA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNY-MVG_hvIKe6uvIstBMBpfRwU4Ulud27N-bo_cNhfkw&oe=6AE4B27E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
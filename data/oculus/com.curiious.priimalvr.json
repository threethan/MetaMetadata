18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmG23oqEmMkQ7kNvwEHQ9vS&_nc_oc=AdoKcA5Z5AHG-V4Lr8QHCuq2QvcncrwimKLrwovcJPckgSQS9DVk7R1Kl9pM0DyXVqk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5SKSHlbafKgiW6W9IJM7ISY9jkzlsYrZC1c9DFwfhFA&oe=6A5E2347"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lL5kgBoVrQQ7kNvwGojcXB&_nc_oc=AdrJF-OX2AxKBH0V2YFu08WpS96-vFSzi6NdxAHAlUZ_uam7zVTUipD0td5sHuA0oFQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBGfI-yX8c_Fy4511GLZ7agvaaQR7ghYnBXz9kQqXaBsQ&oe=6A5E1530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q2hdkRQqlRYQ7kNvwHU5TTZ&_nc_oc=AdoGEgLwWyBh6MVBaSbLj0c1AkYs-FmqguLRydpDU6IRQaBQ4aRNIqOlOA8lqQ9dkik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrgZhiTlioikgBU52D09SsCfvgwx6UEKxpiOAoZ41mKQ&oe=6A5E397E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
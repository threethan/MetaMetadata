18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJMnhZ0TmfoQ7kNvwELHM8v&_nc_oc=AdqEe5vnpCQNDvUj-h9NQNiRgzxkaRHXWsbOv3TD0_mubbmyNTX0NUCLu4m-w8dXPg8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-I6CaDx2KkfTEZ4aOPT9x6S3Xj8t0IOOYuAco56N7laQ&oe=6A217E47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f-_yDy1O7IwQ7kNvwGMOLnI&_nc_oc=Ado_ZfYpX6X5MRgpWMHvk20EjViiRVwUm4mLZyFSOYVV8lVzC822CsHSE6IaIJbkf50&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_uNd31rGRNoWqV3yS8Y_i0mkPSWq68Gy0xAWs2QokbLg&oe=6A217030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYSfBiXG7bkQ7kNvwHZdeKb&_nc_oc=AdoSaRG8nDXVgGCiAPuUiCSkZAPniP0gJ5MGOG8goU3dDa6Zv4dxCpng6cjaUsfDxzg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9GlBwGpCdlW4AAlBg8X8QY7qBDL7YhW-_B5mbTB_XpqA&oe=6A21947E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
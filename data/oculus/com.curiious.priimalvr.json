18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9hqMt8v7Z8Q7kNvwG46yuP&_nc_oc=AdqMFoLJi-uWE5x2JPvQ68sfeGQ9DBC39u3OgYOq-TmqlBU9yFTBrWT_wrmYkTugD5Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-peqcRndOzfFriZo25ATbPxntHrBYG2q26MgiNHY2hHQ&oe=6A47B9C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWTKSKsQJK4Q7kNvwFi4CgV&_nc_oc=AdrjoIDeJecdmYkMHYrE0Bv7rXp8MxhWFLacMgpMikpiRri02xekRlfGKcuLGL0J4V0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vkiND8n8oaRC_Nl_FUn0142sgnrzNCYjsSnZr4KSS2g&oe=6A47ABB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDgrHJSMLH4Q7kNvwEeNBTl&_nc_oc=AdoSR3KJTsjwnWlkLyWo7D9cm2F7HEDK957Qo-Tw-5ibZLIsXIeJ5yLlcfpd3Sg3J5A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LcdZDOhVBKEdtAz-EpdVTXV72MDoX3Fl3z1b-syD0HA&oe=6A47CFFE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
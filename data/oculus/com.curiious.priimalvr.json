18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xC0pLSe-m2AQ7kNvwHu4ccc&_nc_oc=AdoOIInr3MHaEejfNmA718fzkILkJ0DOz1NBp9X5DQJ_9P3iM_hHZmnpdMYoX25nFpo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9VP95rFu1s10d_pSOhU3FT96BGDeMpChjNPwoe7Kg7Q&oe=6A75DE47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Rrw1fVLy-YQ7kNvwFvJJfp&_nc_oc=AdrllBPg4cDT7A7Cd6ii7y5YN9tO4c2ANi8DPaRXxbzJb-bxsApQxenhTLDOeElEl8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtQBYn1Sx4SEy0vTifsx6iEX7YOoyUFeeI93gSh22yUQ&oe=6A75D030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlPZFdEKS4oQ7kNvwEjdrSb&_nc_oc=AdqLN_xRRkVPsR_hzYG5XgI1swNRiPA5oUVswUo9_l9KTx1MwJahcoiFsmNz9DMVLYw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPhfalmMQBJ4kHIv9u01myGEDveKy26MFbhLmlQMOlEA&oe=6A75F47E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
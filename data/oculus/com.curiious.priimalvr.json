18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9P9aNhiG_HYQ7kNvwGjHCqZ&_nc_oc=AdpFNsfYVGci6ZEzbb8UWHbyvsE5703_2eiX-VE3MgLaxK1vYFX465QWoTDvedpYEWc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGf04CKMb-g6rnI3Wp6Ff7uCuvKQIiW6dTxOjFISScAA&oe=6A578BC7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lguTlQ_EXsIQ7kNvwHZD9lL&_nc_oc=AdpfX9I7sguIngyx-1Xm-Awlh2zNRrLDAPFJhWL2JQVvFhRxtNADw6dxBt9Pk5-39xk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDxFwu8VEYkHh2EVYvgPVcMTnGZQc1sKURhqj1iasIZ_A&oe=6A577DB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=00Li2TfjszsQ7kNvwFdTsg5&_nc_oc=AdpU3Ct_piOj6vpHRD-5Z-ZccFL-yMx6ztwPOsux3bfUmOGv0remY90QuTNe_0n63c0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBga4X_VnTE0unBSiAVTcsA9RdOO0Lf9XcsGrOD4lr7MA&oe=6A57A1FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
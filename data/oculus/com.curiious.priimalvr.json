18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9n1HVD1INkQ7kNvwEwQKms&_nc_oc=Adp94dmnpKFKbbwRcFnUhukQd2Mbs4z_E4ZJh0pVQ0pJldhucxbuaTffaeZuq2-xlg4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Lbk3YfluRrn6U3ZpOSjAKAOgoxyznjg-cdqvB-PPtyw&oe=69E8CDC7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pra_JLG2qKoQ7kNvwGIKdo-&_nc_oc=AdrYucVfRQlCirL89B4ErJtT5BHxV_3AgJZNOH2lCCFtSDoFEwplleT7YvkV1MYgF2k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af044ueXKOtzNV9rQY58bVzH6OfZT7swBGkGV9UOSwauKQ&oe=69E8BFB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hJ0seQo5iIQ7kNvwHhpFs8&_nc_oc=AdqaIo3kWQV_sNgdi5TOPE29Cw3XTUkzeRQS7HT24Bg3n_Q3ynXraOHLIweEdPZJdbM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fdJ6V2H7-mJ3DmLBlT1LXaRBnwU_IDOqw6_Cp8REIvQ&oe=69E8ABBE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
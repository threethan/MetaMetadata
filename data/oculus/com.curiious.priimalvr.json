85_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11M81BZeogkQ7kNvwFbXfBs&_nc_oc=AdqD_Kbi_aee25pQRAJWYrW7vjw_zJtVDHxN-FpMqURMDGfOn0WwxyE9jorVsIO5qdE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-xWqH2HAjIEQEC8jWEQgGjO-aOL2KFxQ3wJwGjLWzqag&oe=6A22D612"}, {"file_name": "Image 3.png", "id": "557715432152255", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035357_557715435485588_7157175866805437469_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZZ9TxOjU0kQ7kNvwGMvT8m&_nc_oc=Adoh8uSGHxKrup0f2doU_rNMGNmgEeL6GGH-WGWnRUGtzmrq94EXIQxqQ_yDjQwp9ww&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Cgiofo-FnRVf57EGxFBJqTWj2r1r_Nz4-YUglomrCHA&oe=6A22FBC0"}, {"file_name": "Image 4.png", "id": "1434492306947985", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031618_1434492310281318_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PJMnhZ0TmfoQ7kNvwFv1GiS&_nc_oc=AdqeCasXxKlOwVB883lKedqytMGN7TbohCYreeOMljaz5-5-8o8G_SnbKrGyT4u8dRQ&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94ditYL1j5jIGc-XujTb343PdXlzb_q631BxYbS12oMg&oe=6A22CFC7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piJo2wFO5E4Q7kNvwEw5Cxj&_nc_oc=AdqnHDVVFI-hShsz9wMCxLOKay46k6TM2SstD7fm_NFk9dHaL0I4-iLNQvjwfzzF_Dw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-HHNCNzz-AQ9ddWaMYEzsrOCGio_-QTfoI__GP9mMwQ&oe=6A22F9F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYSfBiXG7bkQ7kNvwFAlJ2N&_nc_oc=Adqy_KRzPXV52ScnG4SZTI-15HaUXYGJul6Z8CjPyBdskRg8fptB-BaJ1frU6vctpyQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cxwbbGH1RzMuQWUHKItLI1XY7hda_NJ7BV3oEeqNWcA&oe=6A22E5FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an unforgettable teaching and learning experience for both educators and students."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.informa.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Primal Pictures", "support_website_url": "https://www.primalpictures.com/support/", "website_url": "https://www.primalpictures.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450317386760213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin1
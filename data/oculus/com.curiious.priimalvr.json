18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5In8kKoOg-4Q7kNvwEVP71l&_nc_oc=Adofg5Xp8ZTWh_5Fv156bEYhJ3JCmQpeH4SPGrmbaCnHQ6f2eTFDCWP9_1K-4jXiFrs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNR-i2wYopKfU9lJWbAQTQczsyuc5iLa8IxPCrTMNqp2g&oe=6AC3A6C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r62Wae12wKUQ7kNvwHUH3iP&_nc_oc=AdpxX8dVuSf0zWrpZHRY7xegj3X1VOR1d4PxJMs_xjLvRn4ENuruoObPP_slQ50Db8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKp0LNLt82iu10-fbaP6nuyw9RtCLxp_I--Ays5TlxLQ&oe=6AC3D0F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O6BouG5XktsQ7kNvwGM6L5x&_nc_oc=AdoJE5Xwoiju89oVAHaMMyXsLdfW8CDEXfM2-Ndrh7Us9sP4F3Q7xVg8KnHnyHPNUXA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOACPUWhQ3iBfbZzF2K9-yiwpNp9RfWACZOCm0tTYEjMQ&oe=6AC3BCFE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
85_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Tvd4sJmMKoQ7kNvwGcks1K&_nc_oc=AdrDKjxG4fTDuOCLTIBUt5HQtUWp-K6ajPQEk9db__ObkQoLN_wo0x-v8rPsEurXDFY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_1a7ud9I4D6DlkVnpLKZJUaummaijRDDARO999JC6VQ&oe=6A11B292"}, {"file_name": "Image 3.png", "id": "557715432152255", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035357_557715435485588_7157175866805437469_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eSrp7uCQGRcQ7kNvwEYbiAa&_nc_oc=AdoI-svT4nO0hSGrjCakU0a_OGoWbLgppod3dbxKNokrmjUXEZRq21XxAHRQJhSHJPE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B_5PCwFiHjuX7omWhWi7dMJh5N_og9Tv_JBIclOBdug&oe=6A11A000"}, {"file_name": "Image 4.png", "id": "1434492306947985", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031618_1434492310281318_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ey1SItoGmpwQ7kNvwEwP2TA&_nc_oc=Adr7PZUwndIz6mF5gnBzZollxAOHYhXWHOzgGXXPJ0vRl4fSG8hKLv2ok8A-YK2W8U4&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59r2HvVJl1purIyGCylqGPRAAQSanAkrsWGsmjtWFiBw&oe=6A11AC47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wenPCMgRot4Q7kNvwHo_w3S&_nc_oc=AdqzosVNREtfRC5ellKpjJdh8AmcxA6x-lt-THSte3pwBnkYauVpq1MDrYR0HH02NZc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QJqWp-dlGl-_cExLfaBWWOIOjtmAa7-uGGSIh5pY8NQ&oe=6A119E30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h5tkx-5R9f4Q7kNvwFd5aC2&_nc_oc=AdotMxO2lt87Tagp0M8VJ3zm69AprxhOvbWTRV0-CVRF6OJYjQOb26qr7HzW0mNh4bA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52OInS9nklpxy7cAI6VzE17ai3142cFGe6T6ajjSQwcg&oe=6A11C27E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an unforgettable teaching and learning experience for both educators and students."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.informa.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Primal Pictures", "support_website_url": "https://www.primalpictures.com/support/", "website_url": "https://www.primalpictures.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450317386760213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin1
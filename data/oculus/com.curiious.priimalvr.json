18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PlWM5YtRdg4Q7kNvwFC84c_&_nc_oc=Adq_frYTh_dMRrq3ZcYU-ib27bV093afOvz6QCqrCdyJA7HNFrKP0f_6F2QCRCYX9Lc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjbZ6fAdQHGepyfBPhTeiq9Z9di58HvP06Z8uDmpi6_w&oe=6ABFB247"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmObdh2HOkcQ7kNvwEXOjDw&_nc_oc=AdruF-5TBdLBq4Rv5fTMRTYoizTfuzmOiJ1CdTszdhbAtMQxkg5_5WgDR4CpacRbDbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPI6vrwwuGT3nne9EjTZjPFr0zO20jNjBTZ18C5LQ5KKg&oe=6ABFDC70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAWpV4xBrJAQ7kNvwHQwbCd&_nc_oc=AdpJ-Rp8vzhz4hXtXu9O2TG20OndSesM9VyqBf8il8znnaWcL8ifBch20Yt8KyuB6io&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW8o4MuLRJG4Tps7TvLOgEAVqx3t8cWAqJL6oAOWgdZA&oe=6ABFC87E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
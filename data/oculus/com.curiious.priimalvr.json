18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4EKDUTD1fkQ7kNvwEvACJI&_nc_oc=Adqyh5eV6MaItxN-Af6PQsZ1KLhWugI7hbaan5TzkWry61fnO26ZT6fpsl4X1ceEIrs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w1QhK-4jhz7PfOBcdFeoS9S98PDnSxEeQjPLBJO5iWw&oe=6A3FD0C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfYaYHDKOpgQ7kNvwFZ--6D&_nc_oc=AdoOni_qS7Am6NLes9iuSaz-fFnTEYWpBIRyAIIaSk-zpzhMTCWQ-QD3e9iXBA7VR2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TOGY90ccjra-KUVXuVTgtLtat5rcGkkoRptk3jGnJCA&oe=6A3FC2B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KjK1WkiRr_kQ7kNvwE62Iq6&_nc_oc=Adp6Zn4haPlfBHWlhNeZJ3GZ48xWWVG847sULop7F88RKWEWmOHXXqiLct4gKZ2yIAg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mQJ9YctBzBOp5cQr7O2zfhbVo0Mdd86iBG_k-HKMBcw&oe=6A3FE6FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
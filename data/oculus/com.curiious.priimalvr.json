18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRuV2yVmGSAQ7kNvwGhocKb&_nc_oc=AdprelrtnNYlAfDM5n2V9R9lLgfFkafSxjQ1FWMOLsGPfTjCwEf0kS843nXyiUH_iBE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLPRi6zoYHeYFsy28OQN843X1sXLL6c-jypMhL9zjXyQ&oe=6AF89B07"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0ww2J6CaPUQ7kNvwFZsurM&_nc_oc=Adrg75h9szyJ1Jc_c9XOWpQk9tLcoxIYQYjq_y_JdH18tvp84lkaYoqcJ5WbNHt5jDw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEMsdIvmXw3VY8rC_8OB04LCVQQRN5Q89YkNpAkfimuQ&oe=6AF88CF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfhoynIas7QQ7kNvwEF8cy3&_nc_oc=Adr5neC6Ci5zs9gBRLD2TiZ7QrnPndAFKNx6OT49WtbWq2eENUItvWaPx11Q0WZ0w_Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSGzrW6ZFzLRHssh8twlXpwAwUhRTiIt7S-bt-RCpC6g&oe=6AF878FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-9-w3Ei-AgQ7kNvwGchXsH&_nc_oc=AdoiROtNiQWv87vNroTDpiMtVg0VeN4vl48JShRIG0J8Evq41R0qPgC6NjAJ2KzYAxA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx80TFX-Z_7coF1hYJ3oSa1PQXBQ-T2pJBfrsAGcyZhAg&oe=69C7D847"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=st1X32mKMYwQ7kNvwE_YeAR&_nc_oc=Adrwc0MJuaTbt_hZnpjKdqst0SUI1ye0gFIUdV3QADovpsODWTWfbn1YWb-I245yYZE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1OdgJOlF7v9H0Lo-mB_Da4NFUZI0v8D6fMBNlqKWXEg&oe=69C7CA30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQyLqnr4d-wQ7kNvwEZn-a4&_nc_oc=AdpE-yTaqYyGg59xXXyvfTeCumRwlPbrewWYqJvogot4pQQa-LcglE4UPFaQkV8DaqQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_orN8WHIsZudaiZiEdmedjDBAwjr4roo6RsV707rW_w&oe=69C7B63E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
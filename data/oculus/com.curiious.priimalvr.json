18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ5f9qpZW1MQ7kNvwGjiSHH&_nc_oc=AdrsSEtEhdkA7Vg6FRW7HGweoOPMEaQeVlpQRQlfjw04S6Thle0zn-mQdLZopN1pq28&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVEAHJksREgvFYQvbEdpk352lizD3XTjUMihgmmFAYIQ&oe=6A79D2C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wth6pyWtewgQ7kNvwFq2fUn&_nc_oc=Adr6ZDSstlBhYCcFih-XI194KGO1Wui7XL9X2S8-4yRIbQ9uPfC01-e5f4mab_6FNrU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGM6bk22ZpXiNrnPckzcbcbXGJwl07hiYy-GKq4JpN9sQ&oe=6A79C4B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUkKqvWR58sQ7kNvwFDOBix&_nc_oc=AdrofDb4DBXMSEaNA8QsaJ2otrIv8RRdzfWvsshyineMoXti8tgFkVs7X7C7oyvvjro&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG464tDNQfzcUWr1c4Cnq0k4wClNECYKTnPeF7vETnBrA&oe=6A79E8FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
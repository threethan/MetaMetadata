18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqdosgiIqdQQ7kNvwELcrU7&_nc_oc=AdpMKWG00RaH0VrOtdbzd4bxvVvvcPuPAsjGGFtEikyz06u54_Y8R0hTWIUsWjgMLUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dxxOMiCML5kSt7-2sN0gtc2YWAVpUfbHCuoEOmQCehA&oe=6A37E7C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEwFIMbi9tgQ7kNvwGH2KFH&_nc_oc=AdoZbDkaD9lDHvmaJQ5RpE7PNl-S2vaPoOJhvsUIsKQtvP84LRtrc_UlddmrVPiNn3U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-j2MfKvRx2OGWb2cii7WknWMUWH1HMQTf9Doa7_UdXcw&oe=6A3811F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WDgErvkGWYUQ7kNvwG2Nrq_&_nc_oc=Adp6Tcbvxk8P4_mNFET4R99_Tjx__txjaIm4eU4XlN-0NQbEUVhUCS6-3Ni4RoeiUZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FYlEDveFNvp7gAbCjm6AZYaWAVh-Ydl6PJgfzlczv9w&oe=6A37FDFE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
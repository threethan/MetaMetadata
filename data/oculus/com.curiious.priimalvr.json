18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vcvt6LYd40kQ7kNvwFCl6af&_nc_oc=AdrSuzX0pVCuTc-BtqsQFGMJu0laDR_aPTPsI2CvbjgEyHElWZtr-_Z_X2ZGDbkxgKQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bM3yG1-C314okWg-vsVpX-Z85tn9xPoFtx_ZbuLuJ5g&oe=6A26C447"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rM-dU8TFhBcQ7kNvwEMSRPd&_nc_oc=Adr8ilwcttcL87mj1991q86hFCEitB360KdUE5Ylw2kdm6hDETOl7lxa-hsfiKBpWe0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97er9I8qpWwaHm-OJyojMamMjqFznF8ak162dJVjIeYQ&oe=6A26EE70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--6aJ5M8N80Q7kNvwGIVX9v&_nc_oc=AdrfQ0qCyEEd397d_W3Y3KhKk8UmnQvKiYyuX6Z7jgT3ZfMw5u3S3ml2pzbcLKp1Txo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-M_DQXiajT3_4HYPB3JEQJOnz7kkU_AZgfi3_sl2q4qw&oe=6A26DA7E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
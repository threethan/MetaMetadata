18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rEABnSZweQ0Q7kNvwFPG_EC&_nc_oc=Adru8AhmJlHoiTPRX8ovvqMiv8iYzrIU-KMuExh8-sIdpguJA-fATe6tnE5ict55YBU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1S60w-H9acd7D5FDC3N2ze9A2DMgf_DNhaGEZJb1tQ4w&oe=69D3B5C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HHUXK88UaI4Q7kNvwFkCTwM&_nc_oc=AdpzAL0P0wr1nLQhpG2fJqpfFVTCfCDeY4gioe9VgMzdYmuv6RnVwnEqXay_iHtc3yY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0tPLptc0rJMjNNI-cJstFJp_xIhPcNf8piz9dCJu8PgQ&oe=69D3A7B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJiwkWy00GkQ7kNvwGRB7fR&_nc_oc=Adrh4Ct06bns18SGPz27bnzIDTwtc8HKBxqdowHnSXhRoeS0yZWJJl99NcpfE-EWgrg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LXYv319oKnayU6Rd01_Ch50fs8AoihOpL_aZc-YfQ-A&oe=69D393BE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
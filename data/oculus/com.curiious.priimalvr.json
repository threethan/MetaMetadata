18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxb8M9zygwkQ7kNvwFuAcgV&_nc_oc=AdqDMgneAZHqQ8RHFeM8B8Jf_e8Wv4IjLvRMXPXlZ_uPv8JnDp31NPbUbdVJCw3SE9g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxBQgp6BpCaHZgBgLaFls4GFBax6Ueogvo9yLTSu2_Aw&oe=6A806A47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2HfY0BhSpZQQ7kNvwGN5QKx&_nc_oc=Adqau8RiLze__QvdIY_8BvrX_lUewCk1NKgCvFzbbulPFCm8X1hvQ3yOKdmnxKmAix8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH28ica6ZqcGVIbBrLVqPSCEMfBkc4UNkPmwPQU-sz2EQ&oe=6A805C30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTkaqiFBFlUQ7kNvwGewtWJ&_nc_oc=Adod9CX5DXPZeybF0I_rfuHFMlrmfSlMLCsAkDIYmKYSuXJ9CH5vLBSFDfolBfQnH2M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZSKzy1ZnQb-b1aV-AYbvpj1_Zngtr2KIR_Eu21Z69IA&oe=6A80483E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
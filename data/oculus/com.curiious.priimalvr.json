18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt3nny1JptkQ7kNvwFYiGdC&_nc_oc=AdqdltnB8h1dxVMrofDd1q53BNpETRNLDDtEE_phr-bpdmxkZ-RIWv2pSzScOkpVFY8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1zAJnSMSXemMUj9bC_sGMVwo7Zj6CyyhRHkYQCcW_tnw&oe=69F89FC7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xA97N-u1bkYQ7kNvwGw2Dms&_nc_oc=AdrF-mnk-iYcQ-os-1ytTCcieVU8TpazGVnuMxx_NTiwVmHSNjVL7rH-eZZ_nxarHdQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37sM5VqncUn71IiS5Ho2pK1ZWIgDFvbKYUb4MUOhw9LA&oe=69F891B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s74OXxn9IMAQ7kNvwH5Y5FH&_nc_oc=Adq4dOUTjz9Oi3zcKqbLa66X9nacPoSX2ZudswQOPhe8AGzBxdqvRt0bM1O4m9R9rzs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-cQjuaSUVwvY67KISbGIUtrSC5QLsiNp9Mbq2pAbPZA&oe=69F8B5FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
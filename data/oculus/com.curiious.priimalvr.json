18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmG23oqEmMkQ7kNvwFwa5dJ&_nc_oc=Adpq_1GT4bO4NaRn8AX0zsYoIczgsG0uBhNe5rEa5_BaAeoguSkoPLCe1p9prcmOXTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2WOpEowpqbvQrKVrRQfsXl99QE7uImQ8NRm99l0ie_g&oe=6A5B8047"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AXBOFgRu0IgQ7kNvwFrQb5-&_nc_oc=AdpAyxHAwRYeLrm_yfFPQ-8Anyk-9MKlIlf5lowvKm64zszO_IzNDdRy0TJovVmLRsk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDmqQJTDHxM706WWATdRSb8YlZIj7bz6Tni4XKzgM0F7g&oe=6A5B7230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9KysLEOrvpkQ7kNvwHP9bl6&_nc_oc=Adr6I2YuUagaO8GVRLk1wyKdnnPNwhYFpnuGy82Cqah5w9OBfOgvxdRnXxRQ1yWFPuw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI-7mzhaA7dO4yjk8IkhC_OuG0tWlSV8FJv3c7gO11Zg&oe=6A5B5E3E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
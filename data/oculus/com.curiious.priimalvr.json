18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xC0pLSe-m2AQ7kNvwEYwBPb&_nc_oc=AdqkFJ_X_d85qI9dlwO1GKiw-dvNbrJgKdOKt75igo73mAFei9k7MyaBVPorekw2EsQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYrSfo6UITUaSju8PmnE14X6092oXNRDuYsUg39j428Q&oe=6A733B47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HlcItNFZ2f4Q7kNvwEnGk56&_nc_oc=AdqUkN8iIx1z0_ZLYO-1AtNb0K3kGPi1tZh24tjSBpQPEZbNuNRNLtdTmqql24Li_wU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlLQbSWLyAiYECltSStO8xvLfAtWO5H7jBUKvvLljOow&oe=6A732D30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m69b1g93BHgQ7kNvwFptSnI&_nc_oc=Adpe8Z6W2DlkRPDOeLw9GKY8au39ikX48rvvtdWIO1koKJKdrHV7HwTSIDpJwt5Iskk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwxjoVyQaJEVEywO4rtXkB9qxqJldy5Dbesgu8VMVFdQ&oe=6A73517E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an unforgettable teaching and learning experience for both educators and students."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.informa.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Primal Pictures", "support_website_url": "https://www.primalpictures.com/support/", "website_url": "https://www.primalpictures.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450317386760213"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1106261083313586"}]}, "baseline_offer": {"id": "1106261083313586"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1649101860, "status": "PUBLISHED", "id": "1106261083313586"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9661787693853246", "version": "1.3.0"}, "id": "266597752042598", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "4736706459694752", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9661787693853246"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "266597752042598"}]}, "cha
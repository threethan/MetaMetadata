18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRjmJnfQLYkQ7kNvwFKF0Dj&_nc_oc=AdohqrcPzv6SOnIEFZX2DLN3R0MlvEmw_mKV26ZNQjucVbIBqyVWzl6b8kzzAXdFhVc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEmN9s_Yx6cmZsKLdtxjNB8jn6W-jyqiQ5X9sijDPcKiw&oe=6A903C47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLoMG1Siu70Q7kNvwEinW6e&_nc_oc=AdpsgG7JZWxAnKVzUrszaVtpNLH_QIDXw7f7sxuIe7AaYv1jg1eZ5zba7NhlTFq9bbU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFci7IlX0x29Geznurq8HFWnynbLqgj2tPfWagIY9S8ig&oe=6A902E30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9tSVsW2YdYQ7kNvwHwFozk&_nc_oc=AdqTMM61uwgAdoBv9y2AVRZ2ALTkHgXdiHxlf0uzRAIwDo_HK9eA3ZvXvxFQt66nXEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCixguFKARs4IZVTHBccPo3qv9AUNMzfIwp3mFwkT6iw&oe=6A901A3E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
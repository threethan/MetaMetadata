18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qxi5VF2iCn4Q7kNvwEB4G0j&_nc_oc=AdopOKDNYg6KVfRLvdV4XXCbgK5XbCbKfV-lQoAT3gmqiVk1AxgFPhX_5w597umUfUQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFyU-MIq-b7PcFzdNeZ1wC-5qjaowZvEIWLXQNlMgIzA&oe=6AA2B147"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kbq9mBqriboQ7kNvwFX5PW9&_nc_oc=AdrkVVKSajl9J0cpQlmFAqIi0aLCDaGce0wWgFuEx1LlikDsHv02t8kQ1sO2HAkczyU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3s9oMMRgOUql4wP4Bg7l29-9xGfsON8o7LTUbaS-AAA&oe=6AA2A330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNZguPhzKP8Q7kNvwEPjK4V&_nc_oc=AdqkzF6x-iYXFd8z_iOBiPL2qNAnSEL-508OQAz7ZztMMzmTx2prt3gWYhAatSsFk5g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6fdQvfQJZUtyq3Kt19wI4spiUbNYfgDluH7lhBlgk-Q&oe=6AA2C77E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
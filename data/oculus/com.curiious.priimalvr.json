18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-T34MFPNOoQ7kNvwHjle_m&_nc_oc=Adqg2ILCXnnGgRtQ0C3DN1OU82uEHQCm510Pbj9PvvCqL_CsgUzDhVccGHZtpxnAV64&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvANtDqVAOcabDRDtv0mllG2_S9kk1Ou5lS4ROOP7WTg&oe=6ACCE147"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QguwZzDaXcsQ7kNvwHoaybB&_nc_oc=AdqbZpmwPJykYg7q7MXityc7Vdl1PBNIYDfU7tsTXU9s-2n5kROGrR9-T7iRN1HP9bs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjNJhnKnPkgm-vJNNUMqY7t12fOr4JvWlLM1NiDz6SwA&oe=6ACD0B70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gwgk_BEtF6IQ7kNvwGppzTC&_nc_oc=AdqSIOCIW3ozz6o6IXRdXA6tby88dhKyvEtQ33WVWcqL3RLTqOsOjtGeG0fROUb8cAY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3waFtNf-DGNpabFz2vODKah4bELtNp_HaPlQpuWVJeg&oe=6ACCF77E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZVxPBRN7sQQ7kNvwGDGTrC&_nc_oc=Adqcv6MKaMR1Js5GxFKzP21a7QOrCYFIYqISoMegusizmv3JQ_QpZkBMnGJfxCl-XKw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFanFhD2HbI1oqULiq5XmdUnru5XF0k2C5qyo7gxxCKg&oe=6AE890C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cH99Zj4PBesQ7kNvwHGkm0O&_nc_oc=AdoHzE9tOXAaC5p03qGr1YThJ-NWHrWpahuSs8wPfzPDxueLgdzIxxr1-bWWOfZg4FM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS0P3vQqt1sD7AGfjS6QJSXKIvRmu4_c99duRolU8XdsQ&oe=6AE8BAF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuvQpDjO74oQ7kNvwG886R6&_nc_oc=Adqe-lrkDBmvqORLy5EL35XXC7h_o52V3iL1OWYJBOXgEyb-rzUDfC9_7wIv3oXPCn4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm0TUIhjKFUeIjd0_qGG8zsvboV-WkeOGr3pKXumznfg&oe=6AE8A6FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
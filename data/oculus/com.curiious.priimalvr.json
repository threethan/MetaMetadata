18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ok8osXn_O_cQ7kNvwH9cLjQ&_nc_oc=AdpwNnhN5jW1U9j5VOwDHmIQiQRvCzAmtK1vf1vbyZjKUtm29fUDEGRBf8m0HjZ6CKU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4INYFSkn0XKBI0A1PIZQcbw3nvoVgBe3XJho785n6zg&oe=6A6B5247"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cYkC3DEN_MQ7kNvwFjjF7p&_nc_oc=AdoZMPcQ8t4TNnbh5NPAzjIrxiOj4rier03lq3-prO4RbreLKRcRb4IWVg7YKZ47JLU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTSdapiOx-RB0iHvd7QkpMZJbrfH-JXNLFiaxYdrHgIA&oe=6A6B4430"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzV0mX3VtfoQ7kNvwFn0m0i&_nc_oc=Adqkoq9uDrNFs83eLsJ4K4VRHQPGXAYt_sAg3rQYKzYtuWGEcQbhXbScgWkQJmPju_I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKJLEKmMYVECMxUWDfHaxZDXl0aVhVOECuzJ6VGC8jmQ&oe=6A6B687E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
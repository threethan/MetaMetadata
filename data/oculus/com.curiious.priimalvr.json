18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vcvt6LYd40kQ7kNvwF908aN&_nc_oc=Adpj2iUdvuMobK0agpYHOxlhssd9ywn4acjdVK3Wf9Zd8h_iXoyarUE4ClzJLWe4mHo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97qD4rYXQkYqn6uKF9_dzrcKQLZGDasONepalko43yVg&oe=6A242147"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piJo2wFO5E4Q7kNvwHqXbZA&_nc_oc=AdoU7R6My0De9EBjUajaOlH-n6mW2noqLmmL31WDNjjb6abjsq2tpd-tc2PkHbdI5LY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m-l3ev4iYb1DxAYoeCp_oz3Lr6ajWk6UuLKY4BJr9Gg&oe=6A244B70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYSfBiXG7bkQ7kNvwGVw6Ji&_nc_oc=Adpr90k_pfn0dP0d3zK6hZeEXQwGiHGO4_LuK77FYy4ZfX6uXWxNc_D8hyE5CYGfJGw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kBjEh3PBukCk_lmVlCDASE3mlRNFF295ReWc5tyhZkg&oe=6A24377E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4EKDUTD1fkQ7kNvwEsjtem&_nc_oc=AdqaOH2hIlXJzGRFZ01HF6K_qdKFZnf6glmoasjPWnaKRGpWNoj21GkuPRCGddU3k-0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZzbLyvf2UGpnSLlB5wiqMBlH-wwpa0CppHnnJ0nrfdg&oe=6A412247"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfYaYHDKOpgQ7kNvwEWNx4s&_nc_oc=Ado8H54u6Ei-t97bjrsdeH_MZjo2O4J9KKQml0MWzS73IzWGluqXFPTNbH2xOIaOsK8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E46KuwPuyumUOxbQ97rUH7l8FBsGsgOzvhPdvWF9trg&oe=6A411430"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnJqfbNo4dkQ7kNvwEc8qS3&_nc_oc=AdpnkFM4OgZjh01Vpusi2d4tyQo2cD_DHS_7Onwvr-9hoZnvcyoGLD1uiWTNiKNJhqI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iYD7VTd5BgKwUQ0KWuU0dFdsYAY9A9vu2LFkXFCBhOA&oe=6A41387E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
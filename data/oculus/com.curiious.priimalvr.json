18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFmiRF7zbN4Q7kNvwGFq9An&_nc_oc=AdpDeJMCqh5CaTjTuoJweRIe37xC8PF6mebg7e1KRA-3xmOZf1jM0dyvw9Z4WDlNzp8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HNxP34GIcS6NoVVyD2ly_OjS80EASpfm1dfe3aJA3zw&oe=69D7AA47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92_jxcGdJVAQ7kNvwETXpLt&_nc_oc=AdpqyPaREBfXzbu1p_BCcrs_x7lZ_hAXugl7yiWoYkQzX7w64uDKwm4QLKisd3fB_3k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37ta3snGA_bWsOIErD0cH-0hDpX2KtF7lcfTrQsZPbzg&oe=69D79C30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiTq_V8Hrf4Q7kNvwFrOJ7I&_nc_oc=Adr94SVS5i9fM7WzomwaVQCLqqpRL09tNKhTzs1k9kWTgf4cCwbBkgnSvOogVwKbFjs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07-G-KsEKQZVG1iRr1HBeHfAnkImzEW3QfO8vhDXupeQ&oe=69D7883E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
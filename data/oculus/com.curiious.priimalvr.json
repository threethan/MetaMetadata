18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NvRjgGkHGhcQ7kNvwEgoa1U&_nc_oc=Ado7w43sslisYGtYj4teQUTJOav18n8Nil9FxSP92oozgxs_fsEcBBsMsZYmF7QOUFM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNh7WK07etJKcK0ELZ7a444LQSlaHGvy0GbAeuIAJkV6g&oe=6AC79B47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXs5q1qNhI4Q7kNvwEsThef&_nc_oc=AdpUtPI1YhDhKuzm3JFXYi_DOz7EKilesmd4LaqWyA6acYPAkNIrvmVLudA3jn_UttI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMklRJVO_LHcC2umtkvVFcf0jlE6Ca-SB5nlKbzt4anqQ&oe=6AC7C570"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zr5aM1s-wpYQ7kNvwGtRiSz&_nc_oc=AdqrQex3VTtV20tab0A9FH9c3XAW8H6JfopIPmgaVoppExXzXj724V1mYua4gPkFP1Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2GfcSqwsCitO3LrZG5QXx9QQbXRiUQVWbEE23EnhybQ&oe=6AC7B17E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
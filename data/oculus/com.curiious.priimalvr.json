18_1434492310281318_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp59NIPWoTkQ7kNvwF4NnFG&_nc_oc=Ado1e_xVqYoeEAr2_j4NelRsDW4HLwjwUhszg6ImimzIroFsTdYoOAYoxy9AmvUYhcU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQELvUVDzxClDa2tG2i3FcE8j3CtFydWAXhhXiWw9o_8EQ&oe=6A85B047"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iladCtu23toQ7kNvwEDx9kf&_nc_oc=AdpFJwP9h__ujD-Fq3EOnbQOsrGqznAhmokQLIB5KbF7BG3bE11PKddAwJOGL-jKw6I&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEa1SPb99s8Yt-r8JWmo3lpBa2mqXUXEi4EuXuNAKRdw&oe=6A85A230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-L5bGAhanYAQ7kNvwE5FHPZ&_nc_oc=AdpUl8WwsPo4qFaU1SADz7l4Q0naniDDirSVAfB9Ao6xUeUdHa2crjeL6HuaPmXW2mg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6kJjqC-Fjau_P_cbdESbJ7ea8X8rYkDhPz7b8XmBInA&oe=6A858E3E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Pri
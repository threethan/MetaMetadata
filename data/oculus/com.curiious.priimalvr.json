18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=peV3IU0i1vkQ7kNvwGvm3Ad&_nc_oc=Adq9_PWV9A54qT9ILsPLWiRqzPR5ZzVKHJc8vPjEwPWPfOr4X0kM44TAZYkK_8B4kUg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE28kr3KAPP1kjf7hjWhwpHYE0B3RWKxqNXUBvj_j8Vw&oe=6AA00E47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTiQoBrMAmAQ7kNvwEY3p9H&_nc_oc=AdqwNdcQ2PNiGiGxsRKqOi8SJh9qczibiQwpxGRGaeoia_MU6mIJnN3CgkqT1e5xhYw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0_bSLv0unMFMYyMRguoqL6I9K4XncoObL0BegdGZgdw&oe=6AA00030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNZguPhzKP8Q7kNvwHqmS2U&_nc_oc=Ado1ynLSLG8UKUJw0CJ6um3pPZTwb0sZWgnOV7nROsrQ4rSO_9pBMNu4CVU9BJHIevw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxKcmi3roShqQw_SzdRDXGsUV_BsW7oVgx50X7Qkk75Q&oe=6AA0247E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
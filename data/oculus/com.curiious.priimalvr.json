18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XNyXME2BmhEQ7kNvwGyytzW&_nc_oc=AdrRuFRgUT5FvPU0NFEe6xsA1I168m9mDsheVfmXLrGaUMDu7tRLYGkUWaTNnCzWj0E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFUYtnWVtdRilwg8cAzIbFzaQZ86qqmy1rHptXUGtPyw&oe=6A539747"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQk-nkxYUUYQ7kNvwFotlSZ&_nc_oc=AdrF17dTf_nXk5ZAnMzKPsXEEvjmjlHLhWL98boe_3ZSZby9_Iy6ce2k9j8oywB9APA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoQHuatl7nBhyHrJl2D5qHdY8YvliwxzFpFLk7Scmn_A&oe=6A538930"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9VmztWQYLoQ7kNvwHP0mX2&_nc_oc=AdrdR_Q3KF3P6ClprjXzcOzrzKDa8VduPi-Z4TEPhCKcqYn8uZ2uaOTmUWZ-flowJok&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAzhJMi-zuLqDK1vjd-iH6yQBdshqi6y2Pssg_FLJjiQ&oe=6A53AD7E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hpUiVCY5uBQQ7kNvwGwISzO&_nc_oc=AdrecD9hLUQHZHIp9-0g5JBbfmxeX_OgeifkRT9OOSrgcq0hRvbrPABbdM2z-990TwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7d8bxaA4vM5pXWyofYzs1NVox6Ro8rX6QI1FHWK_20cA&oe=6A199547"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=14lCQyKtLRQQ7kNvwGwTy6E&_nc_oc=AdodSdxrBTY6EotMeHCEWQT0RzS2JYpaHP0TFp1c1MFHSTkRW1c1SNJ7-6TpGBBnRAY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BnjmOIAlWPPRsymbquDQ1489QkuO2xKCHxFRCx2kFUw&oe=6A198730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqkpIY8A02sQ7kNvwEq9vCo&_nc_oc=AdqiATp4kWRzW0HJs6OzbUbPtX-GGEmD6ugx-QNWxmNJPl1e3vx7COtWh7gse51GY-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Txc0GzgCE9dAS7jymdfAgpc_F41E7E6o-YfnYYEsKpg&oe=6A19AB7E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
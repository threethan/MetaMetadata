18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HYbZvnBHG9YQ7kNvwH61PKQ&_nc_oc=Adoo3KHoWbzJRIzpB50wdwPPsvj5srLNZV33-7pS7fXUABEGe6Zs1R8Z8MEUJRiSpLg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqOU9HgnfffdQ5AcHVo7BqXrsfv-dbNuJrmN0aN1zfSA&oe=6A8701C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iladCtu23toQ7kNvwHTccG2&_nc_oc=AdpRJyxYFCf0XGySWcTnF3qOPLhpuR9vGkqGg791_kKgi9LdkL5IdaboRdVrKfmVCEY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTeOzXHORyEtPoLbk6l6KTEcy_FoeVN0JJ1K5pF59JSg&oe=6A86F3B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-L5bGAhanYAQ7kNvwHeeXNf&_nc_oc=AdpWrMaiMC25KtG7PiPmpBqxoAv_7il21Z3jZyvT7E-JVmyuHc29noPH_FIqJFp6tno&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHT-zXPmVJzMoAQIFaxjpAj9CZQbhaHfkR5X1LqT07H2Q&oe=6A86DFBE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
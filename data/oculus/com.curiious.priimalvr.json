18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9n1HVD1INkQ7kNvwG8XIO4&_nc_oc=Adr8THet9K2XFybaB2JTizjs1SOsrXK4Y_gWM5SRm1NvuijiHiIppfVY83k3UKYWVRg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VbkI4c6yhLlQiE6_mobofNzNSdqbciYRn25_Mrw_yGw&oe=69EB70C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZSueBX60hOQQ7kNvwHCq_lZ&_nc_oc=AdqfCola95RhQOLyY7tx2TrbqkW_-biRbCOxqSddUqfXhYDmNCGHuvMrrbeuaFjDcSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2s99uavjwwKw172w04J5_4jZ9bvnybeESM0p5CdZGBZA&oe=69EB62B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kBB-2qV4JRAQ7kNvwGwRkIu&_nc_oc=AdpuA_tWlox9n0QJwVhT_hUHdbWN0xH2myiyXUiM4JGXKiP18GVqPnZP3agQWfumklc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IqBOS3vMri41yaFQAvWii6N8OK7n7qzfaXzsw9gYv1A&oe=69EB86FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_1434492310281318_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRjmJnfQLYkQ7kNvwGZRCzB&_nc_oc=Adq0Nz8U1pglHpSgu9fd3_Xdn-gLeHMnNpy_Uy0t2b78Mxa36u8bapQ254BLO29aHa8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKPTg9m_iVXBqyictUAGE8cAFY73u2zPXfQPnrR1THXg&oe=6A8EEAC7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLoMG1Siu70Q7kNvwGDzGQy&_nc_oc=Adp9HKRKNbnDYzeLumFK-Dwzbw-iLmrmvtQmTwdSO5vUHqgMJQRI5J_WWS5mnrljyiE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGrWQ4ktcmbM-YLatCt2PJ3nI7F6JypSWzC2T6PHGBJ1Q&oe=6A8EDCB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ec-Il3bQfusQ7kNvwGONV-Q&_nc_oc=Adoj3IJnkEbVXzlc-3oEjYqBLXMdfcAu0tHIYAZlmyM6dRN-0wIq9Vn8rLaJZXB02gs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqzBlcMaz2uHQRXNJROJINPYtAZBDajgKG4pX31n_jTQ&oe=6A8EC8BE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Pri
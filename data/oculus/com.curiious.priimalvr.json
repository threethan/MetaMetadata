18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j32JxPV12hkQ7kNvwH0pTwq&_nc_oc=Adpo5JeJrF1ZKvXWuMkK4an9hFEzeKu2fUwOZyup1hXy4ai-NTGnlChdOPEh75aBx6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12jRL3HFTGo6p4_pV9EzEtI3XEx1P9tJvgc-50OUywVA&oe=69DCF047"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXtHbIh4p_kQ7kNvwFpHvvL&_nc_oc=AdrGGhX4TxBQhMOHd-7Eq2EfKYisDVdiJgyb_0AM0SrFn0Q4-1c22KqVabc7eAcnPMk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0R_lDBxtZ0Lx7o2zCvB89yHmWdTBD4phdVDneKFn_mbQ&oe=69DCE230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lnQA-e2ZqjIQ7kNvwGGPnIs&_nc_oc=AdqssauFktZeC6WKAa7_ECsxm2CGBSMO25GWOFupqQ9tfcGPnu57Fxx5dWpVctU7kmY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09cga1QZNHm0BIG1w_nDeYQPcksdM3oNDf5DeFk4r27g&oe=69DCCE3E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
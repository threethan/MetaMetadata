18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XAzHhJKwhUQ7kNvwGvfgD0&_nc_oc=AdqLnwDrWhaK_dRoNKzqYveliJ-4Z9qwqfTk87Gtb1TuJXdi6Mue4My-UaHgleKFijQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4ChMpBCLbTEfrjmYsElp2Ry7_zZg202Q3LARZdUdjkg&oe=6A33F347"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HotKIngKXAUQ7kNvwEdEWrV&_nc_oc=Adp29h6m3wcJAShw9EgSDU9uKz44Zb2ISycniBrhiPwUL8AfpdeVVagEMbTuPZE9KVE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Fcm0OVo1Q9ereR2kpgT9y8X7MXXYSsC4cgL9FSI3bzg&oe=6A341D70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nvY85jPRr70Q7kNvwGKqNRL&_nc_oc=AdoNJlj0iXaj1n2gNnrb24aUGtvwsVAXJS9FprxbP3Vy5S-2Tc8OI-aDxrcPwx8inVo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lcnxw7_wKF5B1WKqZQkapXowNtqBcjpg-6AbUJ1IwHQ&oe=6A34097E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
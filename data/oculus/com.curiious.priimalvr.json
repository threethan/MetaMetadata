18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqdosgiIqdQQ7kNvwHV28IQ&_nc_oc=AdpS4LfvAk1JilDyMJTFlglUPvhen5o7pr6cwirHsZh9WptjDcmljbXonbi9NNKppCw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9baGGXQ-nOSlJlU0FD82HzK8nyL-VJQEjmKPfoA54j_Q&oe=6A3A8AC7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbtuoGWGvmcQ7kNvwEg9yrh&_nc_oc=Adqiz-_rpawRWbLKGWe2lB8pML-Ui99trGX-4SDLWs4vUWhgeKQpavloFyVV_K0iKD4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PSnc728Nd4oVBN_ZET3R7gHs1dtzhE4FhZlTOQ_mDRg&oe=6A3AB4F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvTomLZASEUQ7kNvwEvS4Nr&_nc_oc=AdpgbcQWnIpisZ_aGOaTkknwODUqNj2MoFBoELvU9w-Tyq-cqirx33QFiU1g27l02vU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-g1QjiU_r7EhYyHuNfDVViyYIxfCD6REaWW2UAsLrzMA&oe=6A3AA0FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
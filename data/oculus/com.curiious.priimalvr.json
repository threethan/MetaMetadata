18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-12Bg34bI6sQ7kNvwG8BM4k&_nc_oc=AdrGhscgqbb9qJmgKGY_n8o9OtRlBOMy_l5lC5T1ffguKtIxuvN_XCR8EI73xtgTAN8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RMIxj-DDnRhzJctqnb9IqsimfE6Dy5WYU8xIcqcyrCg&oe=69E62AC7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKDzn5Eg7QoQ7kNvwGqhl8x&_nc_oc=AdoNZrsyfVvpyCQ2AgRfniWxV0un1ATROuV8XkfWOw3VQd3ISFAyjfzdnGkKYvb3ZLg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vqObPrPcZDtOLmS4LoljziCc5Yp0dLKryie0RpwVBTw&oe=69E61CB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hJ0seQo5iIQ7kNvwEZV4G3&_nc_oc=AdohHKRArrRr0jzBygO5wJn1KFt6g21M4vUtFmeOHz4BFl7lS-v5czg-0DsY7-K-SC4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FogX1oJ6AfbvOpbfb9CtimHjxx8kQimfz--pTZ5X-xQ&oe=69E640FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
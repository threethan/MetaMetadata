18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp59NIPWoTkQ7kNvwHxeyjf&_nc_oc=Adp3ewIY3ik2yFgHZBmRUyswMhUvMgVcOTtJ-6BjtDegwFHumwZadwgeDsuS1aWrElI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4ALah82zX6e7YwDaJAQWsob3liz8zcBl7N9-FCJnWzQ&oe=6A830D47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQwOLNT8kzYQ7kNvwEK4ou2&_nc_oc=AdpGvP9C8nqSHHbdCHdymn6kwz_bESjeUvYokjmMarscBCy8veH1aUDDYw0N7UkeZ8k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGx3Wk1_ObnkLa1sRLhEbC1vV_5Z0NEudVVyxRY8KwB9A&oe=6A82FF30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTkaqiFBFlUQ7kNvwFM40cd&_nc_oc=AdoTXO7L4qQ_48GDhiINQU2rtafNIxL5ZyAtUTflXQL9_ouXlvYfWGDMh6BX0SbFJh4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGYmWJJ0rGlTTlvggxCRvrrH0Ca4B05drgFHsTkRTlYdg&oe=6A82EB3E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-9-w3Ei-AgQ7kNvwEFvD7o&_nc_oc=Adq4N0G6DGmbPfNpFBlmS3UJgdpEKnhR4C-BVPRkF_VEjX7IBQ_kjlbo7-sE68tHc8Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAc8_2tf_JJwBugo5vJeZ8pss8C-VGAs7gXiNAxRySlw&oe=69C53547"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j77NhsZn1OUQ7kNvwFh_nFj&_nc_oc=AdojmWgVkJy32R5RLmSaentu9R67p27PmUUjM_P2qe4l-T8lUE0THQM9cCT5809rp80&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4ml9AIc1QXlGcJM0U5_WD6n3BvJH9eCbZgpVAF4YpvQ&oe=69C52730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uB45wpLs0wQ7kNvwFsGb3R&_nc_oc=AdrPIQlzmV61EoKgMCljX3igvxTBymYGPNk91sPZCVlukgutUN4UGe1MIDvGi-s-eY4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNIL9I5h21tMxc-xB9sc14hG4PvNraqidkUKp6imJi7g&oe=69C5133E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
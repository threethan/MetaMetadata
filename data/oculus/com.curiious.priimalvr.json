18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hFgH_gnq-qwQ7kNvwFkrka1&_nc_oc=Adoovj0LcbrG-qBGJdwejWuXJmXr3rursTfJCcTtcWjC7evI6OkQB_HCs7uFhxrKpFs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhDzcDjDKe6WHpdcRx8UeeOy5iCQSP3L7plB53LF8k0w&oe=6AB131C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mh9UmpaRIwAQ7kNvwEaicOZ&_nc_oc=AdqeEoHGh0eYLRoBdv3luMgOC3Q25OgAnOGpayEhzaunRRelxK5C0ucCR9y7xZMzwbE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqF0AILzmIZG2tMiXi5hgbRBdwdmPLUHPdMghuZBq4Zw&oe=6AB123B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kl0t6iTktKQQ7kNvwEkeN60&_nc_oc=AdpzBJkpqi7FprvAwssXcK3YFO4SBpsiQSjXjy7GX60LMk1tcpXMJjM7LyOejrSvz-U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLM0OwzZSMzyKPs-1CjHpweqJGLD2siLnwR9aYW81m9fg&oe=6AB147FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ey1SItoGmpwQ7kNvwHP9pFw&_nc_oc=AdpmXwGpg0lR3DQ8XlCNorDCeXGXTZne2GSzGWvwRHyS64Tgt3-xITQy3LvvlyZBv2E&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xLOpHy7nxHG08mJ4UqYCuaFMf3KnmgM3pEevMRrdI_A&oe=6A105AC7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wenPCMgRot4Q7kNvwEj_AKM&_nc_oc=AdprjRIGHafp26cphOrasGLYznDWjsGc2-pO_feGDSkXhU1-X76b4BNabx6YDmWKfN0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UBxlYQKqAVGZXI38G5FEKb23Io7pjqc0iv0LMJiF4DA&oe=6A104CB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KknxIv_5M1wQ7kNvwFNgO06&_nc_oc=AdqXWLPF9Alli23eK3TnL9xuo566tnNUG5-g9ARx8uN6WKodZFimsxb98IJrAECfPno&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7mIs5i0PLE_zZ4iL5vUCyb3N4se_ECdxM-WG6QxKdqxQ&oe=6A1070FE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
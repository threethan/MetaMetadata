18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBwKkFfNSFEQ7kNvwHyF-oR&_nc_oc=AdphqP_QfoUT_Kl-Shtf5aJFYh-ukKn8j084iQ_uDSfBvuZRwpg9XNkr9CuZFNQ5LTg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwYkMSxb-P_mRBEXW3thvk5in22HbiX_oKtzF0zILUVHA&oe=69C3E3C7"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j77NhsZn1OUQ7kNvwF9E2Ta&_nc_oc=AdokqH9GOtNL1lQi8d1wuisuniwZD2cjBpNlndoEUWKa18H-xZkUeeNoXgyUz_uO6ig&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzytJh9qQatm4piZZTG_DTX859oaQCMwlOhGwbbjbRV8Q&oe=69C3D5B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2uB45wpLs0wQ7kNvwG9B9vV&_nc_oc=Adoag2TfXiQ7U_dDolLctj3fnwnl4qK7ic_-S6t-CFwsVMlLK8UdCPuxaUmTHMPFiGA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkvV9DcdM-EC3GlKRj8uyJ6b59hLs6YLJZ1kg82Fhsrg&oe=69C3C1BE"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
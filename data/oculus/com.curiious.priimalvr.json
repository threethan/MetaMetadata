18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mRuV2yVmGSAQ7kNvwHBGdD_&_nc_oc=AdpJOOsr1x2j-4QZSYaL1_rAejnZ5rhdxzbUrv1x7xBVRsKToDAvBuWkti4Jk7QJeJM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUDZsWV8dsjbLJlIbSQJAfl45TZnCoEJ3nKyEIZR6f_g&oe=6AF74987"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MixpFj8ReFcQ7kNvwEYx76u&_nc_oc=AdpnxmCTwKtbHKjx9pF0n_nAGKggzeqF11lpUmBcbt8MbAwxxqRGd1wrVetcicD62no&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYni8Hy9gqjgrQgd5JQ9BdjMiDiWcOJDpfkZbGIAAUzQ&oe=6AF73B70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfhoynIas7QQ7kNvwHJG7hd&_nc_oc=Adp2oNePDxbBtoZ00iF-8yiwmS7H3NhPORLT_7R7r674sINOKUpd76lG4BXxxyW6VTM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHhNkyKWpw56mxAynQv6ISCnzikv8-5ZOJXRYdNyevZg&oe=6AF7277E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
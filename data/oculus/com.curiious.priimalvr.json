85_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4DOyDRgpY9kQ7kNvwFhLsxl&_nc_oc=AdpLNt2nIur7gUB1djrZpJ7XzFQiJ_SylWUTA6bTygEq1XhEalEZJ0yvVMOvNSIxG4k&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-E7locKE77TzT3hKaOo3EyCsQhsfyVqzrFoopX8e6WQ&oe=6A393F92"}, {"file_name": "Image 3.png", "id": "557715432152255", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035357_557715435485588_7157175866805437469_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSzuRZ0i_qcQ7kNvwG6kvV-&_nc_oc=AdqMXGgV6kEVe7Q5uOkjbsiZS3hEp9zEiKzHViW8LLmjCEU7elaa_xUs32jyEzPAtqA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ydIfHcjopRNXprDuyZ_DbLCE6FENtaEoh0hxoAkauXg&oe=6A392D00"}, {"file_name": "Image 4.png", "id": "1434492306947985", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031618_1434492310281318_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqdosgiIqdQQ7kNvwHFY0el&_nc_oc=AdpKNp62wirfpv-_2gujn_RU0Hud_QkKWSAGuNEqs3wdSPKMb-5p_lIdehyCCHOiofs&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80FgVstyMjistl4bPjeyTp-bpzr3dGIRRSbus-tDDtSw&oe=6A393947"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TEwFIMbi9tgQ7kNvwG0wjzO&_nc_oc=AdqPG50cSZE-juWfgSD4yyDuiQRfNAUgJVJHs02TOSbEdkGgREI75_D6HFjmOvA4m8o&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90romKDjCM7B7kbIkl3hSzFLI9MwR6ZHHO-ZkJVQ3TLQ&oe=6A396370"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvTomLZASEUQ7kNvwEa6f9h&_nc_oc=AdopASMxTeNYpalbfuqrnrr9Ke3t4JIFleSLA0mZz-btSEAtVl3gZqQpIHS3ZRjvFWg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zOyVALlccUBK5czUnOhCLYsNOrU73UnJapESwKPeNLA&oe=6A394F7E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an unforgettable teaching and learning experience for both educators and students."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.informa.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Primal Pictures", "support_website_url": "https://www.primalpictures.com/support/", "website_url": "https://www.primalpictures.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "450317386760213"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin1
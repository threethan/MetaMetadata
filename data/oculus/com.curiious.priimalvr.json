18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ok8osXn_O_cQ7kNvwE9W48D&_nc_oc=AdqAbWXzfcgaL4v2SFYhGVyOs6ZRLQqP7p62sSMWZLTpBD-99AeQXuhKTxHV0mY9az4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmNJNGao9WJ54z4ns7Qy81yZgmuFw5IxCHTHKFFvvxKA&oe=6A6DF547"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BIC8Zm_rKKsQ7kNvwHkGPar&_nc_oc=AdpefuIPwlonWpFMJcKE0KfHPbksA4xo-kYWCZaRPw0uHSVKfWkek2HWBn85_bEhDBM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoteY5IvPSWNlLYHtkkTI33DCbp3ZoKeu_CciFKY2Lew&oe=6A6DE730"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aIPMJn4HBhIQ7kNvwEY4I7u&_nc_oc=AdopCtSuVXqRxN6aWMn2zaC137zh8X-bNsWoy7bnJWdgyHoANs_yuRQKu1cEI3QGeiI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-86mlzlD5ajpl8lSsx8C7QAWTxDF8ZTi5BUnT-rk1Wg&oe=6A6DD33E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZPORocNApuQQ7kNvwHdoTk6&_nc_oc=Adp6tpPBFpZ9LdQZfeuCBFT8mnPSvTr4utz-tNq5kdEh2ICnJ-UnMEcd0gFXHt-wWK0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfF82FtMZ6oFc4LnjnhGOhO2QVUammeZfgeSp2UZ0MhQ&oe=6AF9EC87"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g0ww2J6CaPUQ7kNvwHGQv6Z&_nc_oc=AdpnFpo7lN7fZt6jpTtglc41fGw1GZTERE6NXRiA0aH_r4QiiAxqFw2yeCl-HZZ8iiI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQr8etD7-cU4asE0IrayevMMdVf2ZCrUgREWKmew1EqsA&oe=6AF9DE70"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5bgsTOJA5hAQ7kNvwGHZvU3&_nc_oc=AdoK8B-I-SdsmBbcgkKfKot_qImzLnOA0a1srJh0S_5QXt9Lsgkk79sNsqr3wRxnBZY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT34UuISDf6kzIisotvbrBoA1iGiL98rR0XwZ4zgigQMA&oe=6AF9CA7E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
18_6416267549354014467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3d5CjHSBEqoQ7kNvwGco7EP&_nc_oc=AdplHa6nX8ZQyQzzDcOZKtGrXyLQU0INvg2NpBC7NIlyIpfEl6HkZ4YaQZQYFX4Jr9I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy06RY_4TBfjOzeG8remjmDcTa05JuzJKEMHJuuJkBTcg&oe=69CD1E47"}, {"file_name": "Image 5.png", "id": "300061901589752", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441577_300061904923085_2495897126178728183_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jBiu9ydeC4oQ7kNvwFEF1Ic&_nc_oc=AdqLV2Sejl6IRElwNuUmSeR5J9VoWCdxKYndjqggvyOvtu7Q8ZWjl3DPtBRc_G_S0KM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiOCHwUCKm66SqswFuARblhFWTyqntG9PZPmVkJNOTEg&oe=69CD1030"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover_2560x1440px.png", "id": "561765221568906", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75395593_561765224902239_4813469306512989886_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jQtsWHPVXYsQ7kNvwHjlidZ&_nc_oc=AdpC_KLFLCtRh8cZpY-Z2yvuSYfitnFcuCoeNv255pOYK8iBsTU654ZPJeEOsco-JRs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYfBUwgSqWb4yeEhaNojNMSsDvjgrTY4rI6rpoVzF0wA&oe=69CCFC3E"}, "display_name": "Primal VR", "keywords": [], "long_description": "Interact with human anatomy in a completely new way with Primal VR. Walk 360 degrees around the model and select, scale, and rotate each structure for a fully immersive experience that raises the understanding of anatomy while also increasing spatial awareness. Highlight individual structures to hear pronunciation and explore detailed contextual information. Boost assessment outcomes with a new way of learning that ignites excitement, enthusiasm, and aids retention and recall.", "short_description": "Primal VR marries Primal Pictures\u2019 best-in-class 3D human anatomy model with cutting-edge virtual reality (VR) technology supplied by our technology partner Curiious. Primal VR provides an
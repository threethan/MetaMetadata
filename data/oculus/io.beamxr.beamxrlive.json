3sLJwXCSaSjMPjmCsRmyeaFnacIIKfyI6fzRUlRNgYiPTC8xxH3s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF769qYHVSkR1ZSVsqza7bz7jluM8IJtgrI1ICARVsh0w&oe=6A80575F"}, {"file_name": "Screenshots.png", "id": "745241581582471", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307954_745241584915804_8130801990786058782_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kz8amjdDijkQ7kNvwHPTvde&_nc_oc=AdqbhS0m5ZeFOOjsROQb2ow5fi86iENLoMBAN6BhLP5QFx-ZyCoc5VMEkOMyG1TxkPE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEiX3vtmoIcNWbYrenXpfyJMQUg52Ai61uo_4WCBiaFkw&oe=6A8060EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape.png", "id": "1087494350011182", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499298502_1087494356677848_7736736768367390228_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wOnsGSQYrhcQ7kNvwFMo1bz&_nc_oc=Adqz0u0GpbWslkRpyjtcbDyr03oixx83WqCr0Bpb4CJKk-Z_K9WTQw9JbR9O1PX_xDs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMtaeLzZoCIogpC8_Eo0NIIAc-A78hZmr2hUY-_Zqz1Q&oe=6A8042B4"}, "display_name": "BeamXR Live - Stream to Socials", "keywords": ["stream", "live", "chat", "social", "video"], "long_description": "**Stream any VR game, app, or experience directly from your Meta Quest \u2014 no PC, no cables, no extra setup.**\n\nWith BeamXR Live, it\u2019s easy to go live, chat with your audience, and share your world in real time.\n\n{752433410655377}\n\n**\ud83d\udd34 Go Live**\n\n\u2705 Stream any Quest game, app, or experience\n\n\u2705 Go live on Twitch or YouTube with one tap\n\n\u2705 See your live chat inside your headset\n\n\u2705 Stream your Meta Avatar to just chat and hang out\n\n\nWhether you\u2019re showing off your skills in top titles, exploring new MR apps, or just chilling as your avatar - BeamXR Live makes it simple.\n\n{1287617452754511}\n\n**\ud83c\udf89 Coming Soon:**\n- Share a private BeamXR Stage to stream just for friends \u2014 no socials required\n- TikTok integration and portrait streaming\n- Meta SSO and friend features \u2014 see what your friends are streaming\n- Highlights from top games and creators\n\n{1964323080997819}\n\n**\u26a0\ufe0f Known Issues (Early Access):**\n- In some multiplayer games that use voice chat, your mic may not be heard on stream\n- Google accounts with 2FA may have occasional login issues\n\nWe\u2019re in early access and actively improving \u2014 your feedback helps shape what\u2019s next. Join our Discord to stay in the loop:  https://discord.com/invite/beamxr\n\nThanks for streaming with BeamXR Live!", "short_description": "Stream any XR game or app directly from your Meta Quest. Link your YouTube or Twitch account and go live in seconds - no PC required. See live chat in-headset and even stream as your Meta Avatar to just hang out."}]}, "developer_name": null, "developer_privacy_policy_url": "https://beamxr.io/privacy-policy/", "developer_terms_of_service_url": "https://beamxr.io/terms/", "publisher_name": "BeamXR", "support_website_url": "https://discord.com/invite/beamxr", "website_url": "https://beamxr.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24021944697500375"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1814348016168901"}]}, "baseline_offer": {"id": "1814348016168901"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754640000, "status": "PUBLISHED", "id": "1814348016168901"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27729630363398438", "version": "1.5.4"}, "id": "24346272171631737", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "10058771020910978", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27729630363398438"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "24346272171631737"}]}, "change_log": null, "created_date": 1786207969, "id": "27729630363398438", "version": "1.5.4", "version_code": 137, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "10058771020910978", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27729630363398438"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "24346272171631737"}]}, "change_log": "- Source Swapping - Change your input source mid-stream, pause your stream, even use virtual cameras.\n- New Live Page - We've given the live page a nice face lift, making it easier to use and bringing the controls you need front and center!\n- Title and Game Editing - Change your stream title and game mid-stream, no more having to swap to Twitch or YouTube Studio.\n- Clipping Improvements - Clips up to 30 seconds are now free to use! Clips can also now be stored up to 120 seconds. You can also now run clipping only sessions, without having to stream!\n- Stream Recovery - Your streams can now be recovered. If your stream gets killed off, you'll now receive a notification telling you and your stream will have been automatically paused in the background. \n- Stream Stability - We've also done a bunch of tinkering under the hood so your streams should stay alive longer, with hopefully much fewer issues running heavy games. Taking off your headset will no longer stop your streams!", "created_date": 1786123688, "id": "27717506987944109", "version": "1.5.3", "version_code": 136, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "10058771020910978", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27729630363398438"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786121787, "id": "27717196007975207", "version": "1.5.3", "version_code": 135, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "10058771020910978", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "27729630363398438"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786055626, "id": "27707225548972253", "version": "1.5.2", "version_code": 134, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, 
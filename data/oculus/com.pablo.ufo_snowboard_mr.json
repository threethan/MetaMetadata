828583_28371419792458863_5191003150010188650_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjqcXWjBU2QQ7kNvwGiIYid&_nc_oc=AdojBDzM035FUCTADqTnX--zqFh0Go50OyVDwf1Cg_jRGaLiHYGLWnjYys_vKeJ6wDI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMCszo7IX3-sE2zIkyzgwv5FWRgYyVhi4tr1CebQ1XMJA&oe=6AC513A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "UFO Snowboard", "keywords": ["snowboard", "arcade", "sport", "snow", "ski"], "long_description": "**UFO Snowboard** is a mixed-reality snowboard game designed exclusively for Meta Quest headsets. The game blends arcade action with your real environment \u2014 your room stays visible through passthrough while the snowboard adventure unfolds on a floating screen right in front of you.\n\nRace down endless slopes that are procedurally generated, meaning no two runs are ever the same. The terrain constantly shifts and combines in unpredictable ways, keeping every descent fresh and challenging. Jump off ramps, perform spectacular 360\u00b0 flips in the air, grind along rails, slide across walls, and use powerful boosts to reach incredible speeds.\n\nThe world is divided into multiple biomes, each with its own visual identity and gameplay challenges. Ride through snowy mountains, tropical beaches, deep canyons, enchanted pink and red forests, futuristic cities with flying spaceships, dark caves, volcanic landscapes with flowing lava, and mysterious tower-filled realms. Each biome introduces unique enemies and hazards \u2014 dodge falling meteors, evade laser beams, avoid patrolling robots, and navigate rivers and lava streams.\n\nA full day-night cycle dynamically changes the atmosphere, and a live weather system brings rain, snow, and fog that affect not only the game world but also how you see your real surroundings through the headset, creating a truly immersive experience.\n\nCollect coins scattered across the slopes, grab halo shields for protection, activate boost and super boost power-ups, ", "short_description": "**UFO Snowboard** is a mixed-reality snowboard game for Meta Quest. Race down endless procedurally generated slopes while your real room stays visible around you. Jump, perform flips, grind rails, slide on walls, and dodge meteors, robots, lasers, and lava. Collect coins, trigger boosts, and earn achievements. Explore diverse biomes \u2014 snowy mountains, beaches, canyons, glowing forests, futuristic cities, and volcanic caves \u2014 each with unique obstacles and enemies. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://politrons.github.io/UfoSpaceboardsVRSite/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "UFO Snowboard", "support_website_url": null, "website_url": "https://politrons.github.io/UfoSpaceboardsVRSite/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1179935200962899"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2284681525615624"}]}, "baseline_offer": {"id": "2284681525615624"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1783699080, "status": "PUBLISHED", "id": "2284681525615624"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1194240916198994", "version": "4.0
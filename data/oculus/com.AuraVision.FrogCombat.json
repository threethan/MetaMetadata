91_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEZmVqhjusIQ7kNvwEgkm3W&_nc_oc=AdkwK6-OvwHQjTnu0QLuERbTqjPFJqidES3sG3hs-ksN10daxS5WvZDld_pmB1P4m_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswyHY_mEQ6IdvChUJi4W6DcKub3ML_H7IaP02cr8UDag&oe=69A04B0F"}, {"file_name": "Fros Screenshot 4.png", "id": "602119818987796", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035428_602119822321129_2322577598304621698_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBpNjxDpSDAQ7kNvwEspkup&_nc_oc=Adl7eLxad8C6D5p5peYhOdwMQpjYIbPv2SzjEWI8Mqx1BX_ZPCs5WfXcIBy49Ap1g0k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsjgZJkQ_y2uWLYpwSDqmVd7qzHS6NtyB1U2npvTZ3E5w&oe=69A053EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fros", "keywords": [], "long_description": "# LONG LIVE THE FROG KING!\n\n**Become a Fro and join your Frog bros in the ultimate battle for honor & glory!\ud83d\udc38**\n\nGrab your sword, flex your froggy thighs, and LEAP into the castle to claim the throne as the KING OF THE FROGS! \ud83d\udc51\n\n\u2728 Magic Spells\n\n\ud83d\udee1\ufe0f Armor\n\n\u2694\ufe0f Swords\n\n\ud83c\udff9 Bow & Arrows\n\n\ud83e\udd87 Pets\n\n\ud83e\uddea Potions (coming soon)\n\nThe best Fro warriors will earn legendary weapons, shiny armor, and **the top warrior will be crowned King of the Frogs** in the discord!\n\nContests, Live events, & Rewards: https://discord.gg/jVZcZkxbwH", "short_description": "Join your **Frog Bros** to conquer the dungeon and defeat the snakes threatening the Kingdom! \ud83d\udc38\ud83d\udc51\u2694\ufe0f\n\nGrab your sword & magic to become the greatest Frog knight in the Kingdom of Lilymoor! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://auravision.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aura Vision LLC", "support_website_url": null, "website_url": "http://auravision.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfor
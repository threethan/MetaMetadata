83d\udc51\u2694\ufe0f\n\nGrab your sword & magic to become the greatest Frog knight in the Kingdom of Lilymoor! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://auravision.xyz/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aura Vision LLC", "support_website_url": null, "website_url": "http://auravision.xyz/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24290125290645922"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821913_1262807022205346_2983946215380615710_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4WVv5ayVWH4Q7kNvwHYbYoI&_nc_oc=Adpk56ySJ5oROSJM_lQ1Psf6W0dqx1oFwe2j-Xs4fI6bWtARahAjBKPM4x_Z7i-4s4s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1fZA-4p6ZDEsZt6eDLpTwS-k8gbo6IACMeDmhiDhwGw&oe=6AFDE219"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fros", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}], "release_date": 1735945680, "lastRevision": {"nodes": [{"id": "8562631360488568", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
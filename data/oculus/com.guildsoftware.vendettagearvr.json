00_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSwWq-Nj8VkQ7kNvwGc_Kb2&_nc_oc=AdmJhliI8wkm_fHajlMbz9Qc45Xf17j7van6VBrjKQkjZgQam_IeZt8dU9Ou_bMW2UA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxYIQxwEEhZB7gavSRQFlHag7ZlNdpOYjs_BNZxCM0Ggg&oe=69B6AC93"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaC1_A9YWuwQ7kNvwGQqwQN&_nc_oc=AdmJ0SfAzB2FZbb39sqSZ08rSEVOxwY1I_KhlkR7th1pR-YDqv8fjdDDFIc8sLhh71E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afzp9eBJvIY3r8pUDt-LhNM14fXFOy9C9aVoTzAS9OMhMQ&oe=69B6A66C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MudAR-EUpxcQ7kNvwGqdD8X&_nc_oc=Adnvh3AZDMKnhGFqwbnNPG4joeQ9UeAqQLWvo8KBF1vkCLCNHRkbahTrf7MtHznkrJ8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAGQfEuT-72byFH_xrk5OJt-R1fO4UCfDv5xN-TMLpTg&oe=69B6AE46"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LeJsnPkQS_0Q7kNvwEQ-gEu&_nc_oc=AdnzTKWwg86WaYVGvWmIcFTCcBbUMahO_8Bl4AxHrHOj8j-eXMUuG5UquQ-lV94CHmg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwwLQEnNVmw94MyBgRE0fkWWxRQ0Z4tTD7sJClATCXRuw&oe=69B69479"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_m
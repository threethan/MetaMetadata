2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQeGqcvRY5AQ7kNvwGdSpzZ&_nc_oc=Adr8UoSeJmzDyBJhS3VAO4TKiUcIpM7oAuiZHGYZ2_tphNDYchQvvcK-ZfTs-0QgIWE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WSlgWv_RaMU4kxqdBXyWygCPlIia_aepjUAMLyzBZSg&oe=6A2C0213"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ynrrT9o6xhMQ7kNvwEPx2Ti&_nc_oc=AdoHSEdozk6hqL0SQcUPkzjotup-Uk6kLSNbRrUQk_zjYF8gShNNzkh2EWM_gm4qzQ0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i2qo7pBKUX9qdRCl6y3wsTkh6TmUk6B5lKdqpwOxvPQ&oe=6A2C342C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dFaAt-YtisUQ7kNvwGTRion&_nc_oc=AdphTy1EJqLzG_uyjeT3j8oy5zBj7yQcmfugPPpz-cUheNapOgmGZRioUN9_Ts1Qm2g&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4tlI0O7w3Myq-76Th47t05szarBwMv9QnZ6DG3sfpSg&oe=6A2C03C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=USrVJrduWb0Q7kNvwH6GS5m&_nc_oc=AdqELG0YpwWHFeurVIqdV1hSgtYeIiAe3MwPWBy1hw42d-5zoYeMflqte0ghARGBNVY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zUxDa2sC4O-jkgsqpX5sdBJnTPm-EfyqoOdRMy7CdPg&oe=6A2C2239"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
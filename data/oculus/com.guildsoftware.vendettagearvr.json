00_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6JPbsIyx1EQ7kNvwEGDYHH&_nc_oc=AdnFerg8jp_nGlZjSJrV_FYNVCP3uJIBzXNyAp0XCsF2MUwZsF40Ag4-thogwv1vEqI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyNqMMS_dsIGJ5WJ50R5O6KxdWnkzvRFE2cyoUxzVAxHw&oe=69BAA113"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIntbyiTpBIQ7kNvwEZyI26&_nc_oc=AdlbrC6phs21pUaXpElVPgKYOfpd-PmJ4zJoHkyep8e40nCtIu4qUoILF3yaxX7ZUMs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx2kaMHh6W550u88eZgYBbH4kmSU5zFzVk_a_lSRAyo-w&oe=69BA9AEC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Tg-erIiTi8Q7kNvwGdS-ED&_nc_oc=AdkxQRTBPZRVsKdNhWjtofYe5C-vqHVO38N1izqQqbgFBqmUujiW6GOsX4Vd2_PCL1k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzBDWug_34nJKrNS08Y1SUl5m0HZLlDtdu5tbFcgBdlNw&oe=69BAA2C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l10fbwT6BBAQ7kNvwH7hRSq&_nc_oc=AdlFndFeUHgIFREcRTADHBPWBc11u71up35Yy4IIMqhTa02VNHUMQPd8gHtJvyII4X4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzeY4ufXFpw9y8fwLCdke1YOnuO64rKUWMMbcP2HTrbSg&oe=69BA88F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_m
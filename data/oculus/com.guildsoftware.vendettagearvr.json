2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GOZsKeh9rf4Q7kNvwHyNqJw&_nc_oc=Adp4dGJaQglvex3FB4TJYQNc2WtRSeoRm-ZYyMXrlWZqRrlebBqTrXapsjsT8f13SJY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHT6_eGXiW_GmJ0kGUafgoCv-erxL_oaso9h_rjT3crQ&oe=6A5A2693"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hb484Api_IAQ7kNvwGdVeww&_nc_oc=AdpRuXNVW00t4IjLfg36vsI7bDyXG95PPWJ1NwnkW03-2RggK-1vTtvXA8ecFxfCwg4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCURxVHEaEyVcv9qOKPG0keUMmXMsNZ2J78FINoh2_Yww&oe=6A5A206C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AQCAqdC25EQ7kNvwEnQIB5&_nc_oc=AdoVaUA7C0uAeXW7fh9ZjAKU0T5_vYkIQtr0IBPUR6nzqO8yFlt2GZlziOc-JK173Yw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnXGs1l373InBS_SsTu0xp_DqueGZ9QB_jQy5Lcl0FuQ&oe=6A5A2846"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jJGHLJqje68Q7kNvwG2jGzc&_nc_oc=Adqt-W_o9Bl3wcVLRtIeCm92UHtH0Q8X__zLsY5EygRKucxvvoP0urp9Icx98Bql08U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc28TV3-e-a1KQqzwnHqZ7NimlgKyLI68YJ8z6Q5UAEQ&oe=6A5A46B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
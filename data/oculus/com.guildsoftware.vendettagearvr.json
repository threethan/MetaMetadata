2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g93Yybuy-SUQ7kNvwG1U5nH&_nc_oc=Adp8oe9eegtDojhf08FZkjOwAtKvQcJnOHdLWayL5wMXlOtPLQ6udd51ycqdP7J0gQM&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IOXphyjARuPzkrsPDzuU443pNKqCSuZ1dGKwBuzQj5w&oe=6A105293"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoWc2p4zw38Q7kNvwGfJwBA&_nc_oc=AdpKuA2o-KG_LotNB3MHCtZ2mbtibqO6ANJPUO48SsxcAsbRdxw5v5EpJCSzK7eIApI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xkZDzvv4gX1MAqOyrqim-JwxmVdqW3McZEfvXghLftA&oe=6A104C6C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jASFpT9iGB4Q7kNvwFW4fnc&_nc_oc=AdpDmeoAKeq6RWBW6i2qVg7pVc0DJjR1GOWNKFvdxoA4x1kpXAk_ukPJbXPfCW1AFs4&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7eQwW1fddvTkAKLgdYFEVNPQ9htK_3DbNvXTvQErQFmQ&oe=6A105446"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKExKwVHPrEQ7kNvwEYTXxJ&_nc_oc=Ado1oMSkvM7nJodiqrsGaNNsyNd1uWULig8MT-flkIZDnTjSyfWPJKkClkjgofzwCCQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yT8OEjWXp0KgdUvlfnUKtCxv7EUg-ngvsn5JlvjKtMQ&oe=6A1072B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
00_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_T9ET6CDDv4Q7kNvwFHD8lq&_nc_oc=AdnC98NMOC3tgPa2-Yg6hHKXBOuiPwyTMrkIomIvhT23ft6HQuIdx58-fIvri1-nCXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxMoO9kAQ87DlryjuNcqYyXOZ_2eoqAyQcv8tPBTWJL0Q&oe=69BE9593"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAWgZAjJiHEQ7kNvwGjtfHt&_nc_oc=AdnFxFIZZknPzuy3d-lrGW2PMx4j2kIeurRCO0XBwZOJvWRbKeKU11gnKdG07_haY40&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgcdYQDrlY8gmnurM-0HJKVJJEIRd63xPNmkfRUHq1dA&oe=69BE8F6C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSmZL_G5rNkQ7kNvwFX4dJo&_nc_oc=AdniwOuH5kLlPSjy3aJFgGVKavoe3avv7FLgzdYZ8hh01qMxNKIoG8_WlOtd8yV_AMI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzV4ukCLBvgmlD_JkpMn08qTkrtzliydVaCtUCeLEpD9g&oe=69BE9746"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_YThDo1zKUQ7kNvwH94pjA&_nc_oc=AdnuhlUHEfcD2FBgt5IXmqXZJojw-3b89k9Nbq_j55lRkZVQnkmdZ839CWpXXTh9nWM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzVj0aVZIfD5kLBYCjhY01ez6q6gYdp9_QcZMc9PCbzgQ&oe=69BE7D79"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_m
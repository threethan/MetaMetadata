331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=via1FwpC53QQ7kNvwGNAz2z&_nc_oc=Adrfmh_DJvmbgeaNUBSOTcdzFl14YhpCWtMvc_FwzrkV-b73mZsYPoH96zPFJSAN2r4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJG5sZZKG9FSj63hYQVRibuk1Sqo3U9ybpL6kdk3FBJw&oe=69D10A93"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-4SIyx37hcQ7kNvwEqaqfx&_nc_oc=Adqq53XFvaV2kgOUbXvwY6juASjaxHeoS4QWPNQuT4NUxQMVn1etmr7KcSX3NJPc8d4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzenRw5AlgI5Mf2hvnqJpHA6MTdAJopzlcabjpGN46Tjw&oe=69D1046C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpNMdubG8AUQ7kNvwHGjPuJ&_nc_oc=Adq6kZaXlHQ4aM7zoL2Cq43hV_eDHN1NFP3ReLY0StA1uS5Jbp0klNfjrAIEfe5LF_c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyYSjTdVkSjiGQCEb9uwywkNPukUj7FFEucfAe00YRsnw&oe=69D10C46"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBEc_Uc_A0MQ7kNvwEnrYaD&_nc_oc=AdpuZFnnG3a7DSqWHbEau40wwVzPAg5PTWRetTjFniefSwRWFkwAtPS2DBHUYUBdjZk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUz1PVhgCbLxDnT15_HpznIf5fPwrMDXpPUCBcNSkWSg&oe=69D0F279"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCH
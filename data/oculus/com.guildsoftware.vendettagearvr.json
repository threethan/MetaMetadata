2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qHEZVhLS3E0Q7kNvwHHvpb5&_nc_oc=Adp-s8gGMlXqSASArFa6eT6yieTHeNEKvClyfL6u40_r2_jMBc30wa7YRLJ26pErTno&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbo6gWtVIzgPmmIQ-YnPd7GAh8pPWQX7uRSjibovpw5w&oe=6A806213"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cAfy0RKYOvUQ7kNvwFgfKq6&_nc_oc=AdrNl7xFUuXBqRrsPF7n8G40UdrZ6pIgfIiSysXxtKzHX73rBckpZi3L8IpxcvLj5R0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfHNx1ieRtVVt-nqclME57WZf53WsFlV-32lI8Oudy8g&oe=6A805BEC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glfVv7_-TaAQ7kNvwEps2kL&_nc_oc=AdpMUsxIB4whjTbw1hxR0budgU4YmE-UF034zpwZt6i4FyJWK999EjjaSkICmInjbA4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxmlbxKcA-kRlVqQnJzfIeozTG7mNfx0619qLYg_t_Cw&oe=6A8063C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yVJ5ExjfYdYQ7kNvwHkmgJZ&_nc_oc=AdrUxagcfx1cSgI6k8y0zvG_bkiKvCeddes3pdSFTPbn8kaHhcIxztbme6axr23QchA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmLh7x7U3yGRSBXlgGEb3PP2nNshiwH4CF72Q4Dfml8g&oe=6A8049F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
00_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YPgChf4qtHcQ7kNvwEfO2Xt&_nc_oc=Adq2fcwcJWvDNpYZ5B_Ne7617tZjiW4dfger4RyCzksAMvXDC9IeUgIZ3ygPkLqw-hA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwN7TNVMpZD-_20aJFRlqOhJYf_G-jrAijqmHJkKiSBZA&oe=69C13893"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAWgZAjJiHEQ7kNvwHk33Ac&_nc_oc=AdoobHFAOOe6qrDSGtylkFacE3pYWUsbSLDh5uNMsjY2gLmfWuStoXlhSnzhyYd_RP4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwxyPsiPi_Lww0_rgvCm-BCalfRl4NDab3J0GT4TmrY2Q&oe=69C1326C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NeB8kpe3eGwQ7kNvwEFKI9M&_nc_oc=AdoOR0hMznnKaZpYvIymKF3dyUxT5RSWrM8bGiTVB1bcuiDHQUfotAcT41OPnnx4PGc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfykLyo3ic7cB8qH-q8k3qk3uYgCOVu0SKrfcP4jnLlMdw&oe=69C13A46"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg9NL6Twf-QQ7kNvwEoF2IY&_nc_oc=Adq11BIrfVfAO-Fju_lbwxiE9MdzE1Ej6Uz3CuKPPRYqDVAxhvPlG86WpAnn_XSQJm4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyN6iReXUQOwNr9YLRsMxlI8fvvvwHG-E-GzszF0lWelg&oe=69C12079"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_m
2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4ZMcVYjQcQQ7kNvwHCgJ-Z&_nc_oc=AdrF1lO497cjLVE3BmF9oG55NkRxRryMdwCaKoScmjUnI0nOetmaA1aQjwdk22-nF2w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAOJbFeU5WKX7lm9pf1A9D6vra2R17WhJi7u_xynUjJw&oe=6A60BE13"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bv-mIG4rz2MQ7kNvwGnSQMt&_nc_oc=Adq6NG1kIkz1T0EpfC4VxRGV-YlDc1s2cCF6AMx7IuDCvMc3Hbr9YdUn8Inn8ynBkwc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAomvQ82QYpQSpB3lZc1EvVpzZT9SsVDGQVfhYmmwq-4Q&oe=6A60B7EC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wSsTp_u1AwQ7kNvwFOHJ73&_nc_oc=Adobki1ouKcD0H8h3E4FiYAU5eNU2S2OnYhEwvmrhgZ9Ucwu3LfvoBVMLbzWk_7S46E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQARndDaG0wCzTrtywwzm33jRwso2-CqIcWN4I2jvhLEew&oe=6A60BFC6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XaeDdhJq0NYQ7kNvwGfx_aH&_nc_oc=AdqNWdqgFVemAn-OfYinJMCZqGzW36jEi6b3RZnO8htPTFz6qfQzhrS_6OiJaKqnpG8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAoChldxGh9vtN7kRGjYWAZBf8_C-XkjFgRd8fSJE3m7g&oe=6A60A5F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
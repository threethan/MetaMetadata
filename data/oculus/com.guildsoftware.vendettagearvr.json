331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzOD_qWf9H0Q7kNvwFsTrLz&_nc_oc=Adr4aVA_bUCFUqCJYQIxB6KBihOskQiIOL7LtEJOti3lK-_WJOZawieEZDxum1y9bIU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PrqHOUoRgCIHm1hliziYRT_x2Ymk4i6Fxt7y31U2QGQ&oe=69D7A213"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nO3BYcRWiVYQ7kNvwFu2Mbu&_nc_oc=Adprp613M4wcvmVSIenRVIY1Mpz3J3M5mgP53Qgcr5VS8uCxDxhVvdgAglggLp0JPdk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1s1THWzYPvxiwupUofgVG3YMRS1XExgvaBJnx22mYQjQ&oe=69D79BEC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z3g5qUl1P9oQ7kNvwF9liLk&_nc_oc=AdpLfzPB02Aa17D7weeoKIwqr12MMGys9PGCSidRuT2OoRMTxszrxosxy73gaAlAUYA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xke-tkTgGtpRZEqrXe41-gN0Ag4ofjJYBnal-W6jAHQ&oe=69D7A3C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OVfW9G4N-OIQ7kNvwFcZR5H&_nc_oc=AdqseBv-j_pQa2sCs1f9yWrNsitcZM-5x36l1U9o6zfC_OBvGYaNHiagohSVynVibLU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2AbdTiiOLti_589lEpZh06h9IDUSaa7n_6260Uu5GuKA&oe=69D789F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCH
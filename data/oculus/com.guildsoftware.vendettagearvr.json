2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51r-wiN8sjsQ7kNvwGM-ymG&_nc_oc=Adpnmg_Y-3hthnLZO0OarZeOI6wxqmDwizKo_k8B_TuK5mTTPh3I71vMN4JWB-Ic_sw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhcoeEHabp_kMQy1Bl9mlF-lcrsl_eKdf6VDKgaCTimA&oe=6AE09F93"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WqdxeijQ0pwQ7kNvwEVUbXA&_nc_oc=AdoorHzWcW1wdcaAkeo2x7vsFTvmoV-Ka9wKBJq9TnjkH1quM2wniqhmNpRy4vKlybI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2jpEhxvd8Gk4SViG6WSsW06-Sti3enyouB_516H-Thg&oe=6AE0996C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWy5cL9HUBwQ7kNvwGjuoIb&_nc_oc=Ado99uW5Wtjb2tESRxmVy2ZTbM2Lmc3tpo0WhyI5Z2CKieC9RrmAaZnHE202-Bp1fuQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtGp2Gxo_2yBnrKIlTggpus9mLaVT_FyOqwab6viexWA&oe=6AE0A146"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3AWiEURe0EwQ7kNvwFK6APm&_nc_oc=AdomKrOr1VRLkpuAryyBpcbkVc1xDr-wM81prwemzmq2-gnu4QEJH6KDbZm3u2ALoGY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkFnRLlKjmpCShf9CSOvScv1cJdYd4OnqvYLAt1j6CUw&oe=6AE0BFB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
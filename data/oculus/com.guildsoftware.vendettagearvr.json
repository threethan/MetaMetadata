2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k86DQvWxozIQ7kNvwGDY6Ic&_nc_oc=AdrrNiJhI4DduXgfbRFcOiOFG9qZswrprxA3qPhy50wX38Kn8JyLJgdoWF1K58_WloE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9lbNekF-C_4vw3Bl1mLZfdHYeG1wTIaazVjlbyhC7DQ&oe=6A8AEE13"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=50JSlk1wHbkQ7kNvwGqabbM&_nc_oc=AdrWmxeBXW4rMXbqk-zCuTlKKlnDdBFg7DgdrMhjdcoK7zrnvFxrATwNkMSBYmQ6jCE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHv5RHGPQTPGTzNnAv5JqoAwHIM8J3OPOorUAv2varyHQ&oe=6A8AE7EC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJk6BLjyvGcQ7kNvwF1HMr8&_nc_oc=AdpWZpqel1pP4PIDtdnvQDkWsHtFaRRW7MtRd3qbiUWdzfrCq51BmQFJRbVY7BxpoOA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFd2JoXLy2KnaDkFqIYSXJYcyTF4c_WJd01rBSERgsQGA&oe=6A8AEFC6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5qCVgREQ1oQ7kNvwE5LdHl&_nc_oc=AdoAvxuDoIGkuFs0zV8LSlEM7kojTwqRVC9l4chwVkfDbW4PUAEFy9iheoNQo3UPWKg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYIx0pk-bzpRzkUxaJLCrf43NTxNql346dJbcmgFma9w&oe=6A8AD5F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
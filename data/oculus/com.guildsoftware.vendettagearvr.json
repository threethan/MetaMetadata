2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45VfRQSolZ0Q7kNvwHGxDcT&_nc_oc=AdoKoL244Y0NndWzWQcTV8dBLk_eYjJ_p6tDsLH5a7hC98UcrW7ktTgAQqHahhNhvco&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7QLA_lN3ywC89gsftGQ7IAO44hskcUNEGjM9O7jH7mg&oe=6A329993"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Bq6V2g6bHMQ7kNvwEQBn7d&_nc_oc=AdqvA3jJlsRQlf2MvEXjZmfOm1QrAF0T5J2NRkEJbX5lXW5tNsy3es1HzhIepP5x4WQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LymdAzLyj2HsCFe3S0VIcv6M6avgr6JXpN5psnHecsQ&oe=6A32936C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u0sBzYeOYjYQ7kNvwGR89AC&_nc_oc=AdpsQxUek6F7wFR6BJH1_XO8CF9JDSaxhDrpN06cb1zHzmCgORZdjCiSSJnPHrKfcng&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8129Q7gw-3UpkS_5X9oiNj3kpCVAWDvfdXN-YwSsRf9Q&oe=6A329B46"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=as0Hpu1XHVYQ7kNvwF012S-&_nc_oc=AdpR4Iy-ckCAgqDmkMj2zLiHY_1tQfNUfZlOOlacpxixYN7tOiCUsZRkQ0JjJXYC3Gc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5clnSt_8rk3n3aDuAalKroB1x2PRriMGCIKtnjXljuA&oe=6A32B9B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
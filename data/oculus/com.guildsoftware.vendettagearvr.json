00_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiVUuMUTiIIQ7kNvwElEqGg&_nc_oc=Adlu61M_3BZkGWJjpPvF7YWu5iHjHUs6EJUytiiNjAbSmkvTRm22OEXMDfy0OHPXqLQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afzrz5ymWWA_iiq3eby2w6wEAsgDymztWxnINDBzcAJWlg&oe=69AC2093"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cG6kKzj6IgQ7kNvwEI72ms&_nc_oc=Adn02G-N6jEDWamF1nT1yuyT9jXFuXwz12kTfkikP9ZhUGedhFMeoLnbgcBK_hmoOYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1dkY02r7-J3pGyJpVQnZZ0xS5WDEkGEW_qmMffqIrXg&oe=69AC1A6C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XunNY9TbOBIQ7kNvwFjz_SR&_nc_oc=AdmlrGvDsDxGbjzuC1QIIi8IqyrIcoCtRGGnJz_CzJo9oXWlyEPPklWmUFioEGQmlEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxCRmoiZZCAg-rWZpWJysp_ASwFcNomowEkOsNXK-5EKQ&oe=69AC2246"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSWB6NRf_NkQ7kNvwHwf_0Q&_nc_oc=Adn29NJPg3Y1csQXyfCW9QXEW7rmoF3-B3CB709klKsn-9bBE394M3423-dJ6ySVhVc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyWi6a10M8enQS2FNK78AjsiLEG1nh82YzNIC53VPbnfw&oe=69AC0879"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_m
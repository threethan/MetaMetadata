2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0udr7iXWoIQ7kNvwHb4k9x&_nc_oc=AdrCCsLWrmaIDwON8B4AoM3OOzFL36XhSTn2vL1-qumrS8ctyBnzdLujFmf98MrnYRs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7P4N5poWlCuslQyFG7c5TGM0qoIPNuvrvoK_XKmQa3g&oe=6AAD3513"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SgXffHJw-fEQ7kNvwFs6LJF&_nc_oc=Ado8T7KpBXwFlViPpSnEjf1g4oMohhn7h6DXCSpBwXtQtgSYXi53nhISf6uaofGgJCY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRQZEkf1WyNCRXXA6mpFEoUZReh-A1lKfBC1JkGMWVVg&oe=6AAD2EEC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NHZj3leVo4Q7kNvwG-_1Kn&_nc_oc=Adr_MX1S0-YYrpmiu5lWWLmFog5Vuf1d7yuHVs9MaXzfkzOts6rj7baGtrgy31ir-FA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1PG-azF1-_OM2YJzmipUVjE55Wl70l2kpkLgwvdEY7Q&oe=6AAD36C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W-eaShB6TSMQ7kNvwExEB7c&_nc_oc=AdrqkGGSCZAIfr0_iqFGvDtOsbCZd4Q5Uwzs3GTa3moGigObivEJhPwOmdQhvB6VvNk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyKAhi6dTlU6MdrhfcPGjC__ozz_QdmeEe0-F7g11q9w&oe=6AAD5539"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
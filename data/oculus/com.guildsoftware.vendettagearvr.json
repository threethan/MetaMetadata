2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hJ__xSlD-_MQ7kNvwFFYc7b&_nc_oc=AdqH8wTJEoeqzlHwP6v-NsHjgtLqAVxI0fylrdbPtQjxa4-ihcdWkvW-y9DSiJWpn44&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HQMs_stLUIJ20NBWES-kDGAykMR0AIMdYQMPSOV7i4Q&oe=69E62293"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-JYGnrsWUkQ7kNvwFphjHL&_nc_oc=AdqeF8MjK5uqY1KiITHP60QYX1cVJCRRvd4CjGfJqdXoZhMpFO0_apO_-w-b1y9uNXo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1LDhOD1jsIpXP6Zra6TGj6b9bThJsq70aELKn6YqsFyw&oe=69E61C6C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CcqPhzLhy8kQ7kNvwEAYpWn&_nc_oc=AdqWkl1FlYPB3hfyKwmdM84Jabvz2G1FjigCNd7-IW9zt8gyo8lTTEce7nfEvVEY0lM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vhzkcV7VpeX0RCXtQ3gFEu9VTN9hH_7WE_RsNNYWpYA&oe=69E62446"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hS906U0PAEQQ7kNvwHwqSwl&_nc_oc=AdrMG0SYPFCgB0ES00F2KNbAnBCbwVaiv6Y2etgS79cUSVt2qjRhvLdCuEa955VRjdc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01162d8Cz4A0X4sYAK4fHs39O3lUr5PCAaZUYyRR8Eug&oe=69E642B9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
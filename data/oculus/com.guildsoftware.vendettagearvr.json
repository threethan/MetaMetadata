2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUuw4VXVgY8Q7kNvwGPbYpx&_nc_oc=AdpZhoS9gX3bqGPxd2yJ397Kx8NTYbPOTStHZyKgV_CacO1XdFGMWgtTrdcfz8nalfU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RAyf8hh5s3b0k-xPHAU2MbnvNb_qok6J8TlSGHOh38A&oe=6A1ADE93"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OP1S6WU_ygQ7kNvwHZYM5n&_nc_oc=AdpzJY8wLWo6eVx5TVH_ZQG2lwaHNplKc9z_ma9o7VGDgFkzzSX0FepgS2JTqaVizQQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54hzWTFalAcAOc96_q5FjSBCsnX02Lyp2y8y3t93-0sQ&oe=6A1AD86C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MUdX4ktqTYgQ7kNvwF5xOkf&_nc_oc=AdqDIIzPL1scfSDFZZuTH9ksD7Gr8sZF2NRJsFNWl_Rno1zrVrGM8J8QLjy-sB0w8jk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58TSxzr6OppEheN7DgVS45dD6iUMImPvVEHtOBXwmn3Q&oe=6A1AE046"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6sPvvaMtvUQ7kNvwFGoN50&_nc_oc=AdqCXd-0ZAu9mH1p-ljJyHLpY16fIQ-yS4Avy8BVk7-w0ZIY1Ayz4TKuLYdiJe060yc&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ub7qVeftuO30-6TQjFT11lDEom3Ox8L_NuFFhpTJCkg&oe=6A1AFEB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
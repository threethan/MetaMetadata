331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEvM5GeTi64Q7kNvwHI_nhj&_nc_oc=AdoULLSo15mrZi7EkCI1fTW2M6bWSuttvioc3z44slgu4AUf90_pd0m3IIQU0pw8qiM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7a4FwNDElD0IbxOgRooh7yI7BuY3HHKQEzjIqj2K1bQ&oe=69C67E93"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6cW0O__o8oQ7kNvwEo1pSc&_nc_oc=Adr4kMDxVYxi1wF0B2gJ7lh0Z05mNiYvu7d1jjpu5BEIFITLz5omVk9DCvuAer1VE9k&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwesxXpGHpcUA25VZD4PSLCqmaTYKV4E1jWQViusG1EXA&oe=69C6786C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNnr5ExlwlMQ7kNvwEUBPVk&_nc_oc=AdrRQ1Duo3rTO61kmSBR63BRnHUpH7thzhgCrqezB5p67oAXuTNjgZnrdlEJOv564Io&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwSXGbztL8ubSd4x1PmAfqZ_veP0X3vV4UmkEVsWBqcvQ&oe=69C68046"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-Suya8arwAQ7kNvwFo54Q7&_nc_oc=AdrGF7cJFwxB0Ba4ioKxJfSiZmdhvG8fyhh8Ne_jKjqPoAZxHX55XIoQvx2TUZInf5E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw_eRXFHilHpN8kx9CKnn33ZSLXAm-6NikJWIAx_FQJvg&oe=69C66679"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCH
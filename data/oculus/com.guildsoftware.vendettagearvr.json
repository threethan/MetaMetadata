00_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiVUuMUTiIIQ7kNvwGn6yL5&_nc_oc=AdkSkf7_s0wMFAJe10bzpmUIGi9t-_8Xg86h7t6G_wRMZ_MEWmGVIlSbHyh36ACm5dA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfygBdIOeHsjHhcPMpFC4OeULDBaeiMeEnBOPepy8JrS6g&oe=69AEC393"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8i6NxKu7vGgQ7kNvwEuathn&_nc_oc=Admlxrtkw6EZIRbW7jicUeQfZhgQV1ozHlH7lOQRUTD-wpxgn3Osk7oEA-wZdqc0j6U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzQv3F0oWWh8WqVYaTeVPDYzM13BvjSpdKLHT96vN_oYw&oe=69AEBD6C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TunWA75rfZUQ7kNvwELZtDA&_nc_oc=Adlhqo5ZKETXJGZFTT6VVolJe-fIkWEFdb-LvBE6mUNkCWmy6oTQXigJBeHfQwmLxtI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxtKZ0CdTnRwshf1df8bSTQzE81vqiK2qMD6AYXClrwCg&oe=69AEC546"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKdkHCEaD-gQ7kNvwEQPk4E&_nc_oc=AdlffjYg9sPig_0xIApKz5VYC9gydKoulmHmfz535ipqlWAhXURQdMTrac0NZ4vyCME&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxdcxks4QAIDIcxLHc6zOFeORT4sjqZFs6Clyt_OLDfQQ&oe=69AEAB79"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_m
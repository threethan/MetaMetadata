00_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xiVUuMUTiIIQ7kNvwFtIC5A&_nc_oc=AdlAV2cspLZGPCegauNbYyUGeaJ57ZfarXbB_7a0h8dDPd94XLFuA4_Wc0gwmpOhD0U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzAu_Cj25QfgQbWjIoqlSr1KVuDit3RpZkA78FjfajvOw&oe=69AD7213"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7cG6kKzj6IgQ7kNvwHvN8nG&_nc_oc=AdnAKSTHdGLGVqa6_VCMKzMSwaNre408qMk1TSo2UtO0fBj-o_KSkKIoCcQwhchE80w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzRiHiFewV_tt3-6I0f7YIdaMsDtfnJFfiunNnERpvoQw&oe=69AD6BEC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TunWA75rfZUQ7kNvwE9IyTh&_nc_oc=AdkCQwF8rC2MZy_A5y2G9zk1n9DqlIa8H_UxZAfSbmoQQm-ovM7ffgUa5y-ax6cu-Ks&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxXtPMruMSqAcRQNZyUzT9dbL4yqMS3Jq8zTigy0MeXIA&oe=69AD73C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKdkHCEaD-gQ7kNvwHDvemO&_nc_oc=AdlxhQ9mNt9qWJn9jnmDFSQkGElQkWLGDSKP6Ao2ukQrDKM2-JM05FT3DYVhgBtGHEI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzsXbunj7slKUkLeRHXIgqczrkDwQG8P0YDRvO27q9TBg&oe=69AD59F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_m
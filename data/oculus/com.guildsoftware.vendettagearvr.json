2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AffHu2vgnKMQ7kNvwETTgCH&_nc_oc=AdpzhHHEsRjdZ6ENHqzjjMT6nsYhTNV_ndFXSASNa36E5nJMIMwzzJ2MVwtqtF3Ddsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm0QY6wsl2UfvB25SZpbbVMTDC6cNFu8eYplx33ST8Yg&oe=6AC3D6D3"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9eP2je2xObkQ7kNvwG_nNtQ&_nc_oc=AdpWz-PCM2a0n7lD0YwLqF4sJI3hrQZaZ-qZt6NXY56hzNjUyVJNF6j-N73UHy2qu-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwx3FSyZiam1EKeOIEOhaRvih3F_du9xbwX_eoZc5sxg&oe=6AC3D0AC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5FSRCNTD-4Q7kNvwFPxqYx&_nc_oc=AdrXjiEztBMUy_tnlC0T3bnmyG7eaaXML_SboeQ3bw-hdRM7EOQz3oKGdMA5pySNDRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcGUHdbhqmJHeo1virqzCH1ehlv9t1RD30OLkKNc4fSw&oe=6AC3D886"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TXJrsT-JO0Q7kNvwHoyv2O&_nc_oc=AdrtjF2td2q2LgBA7Ese_TSMjoKg7TbIK2-Xsm3BwYbnqZkvqqWrV1t46Jk5orqr-8Q&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYLUp39bsKOgq13TD21PkESmcTTbew5zjew1qtuANXWg&oe=6AC3BEB9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
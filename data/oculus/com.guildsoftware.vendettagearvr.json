331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=via1FwpC53QQ7kNvwFVnHZS&_nc_oc=AdouNC5ZdF3562YPz3rskk1s_szEgL5V2bjvPQu6m8Z52B8G-Oer63SzrGGSIHjy7PQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03qXLHv15nD9toqs-J5iXa26xgl8W787xnWgrNNzd4DQ&oe=69D25C13"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYg5PFC0iMUQ7kNvwF9n5rp&_nc_oc=AdpiTFLyJYRzZHZTbOf90T5nZnJk_KGptS3vSxfvbVPtvOGD2b50ZYlm_o054iF-3_g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kNhHtZGDudZWbk8k73RoBzdE2d97TiweIDakwoe1gNQ&oe=69D255EC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HpNMdubG8AUQ7kNvwEtWtbU&_nc_oc=AdrC5nRtUQUdKVrwfS8cbmaho_B7nKFkpZ5MXb8mnx_bdW1CkBOsOra9h_RMT4FzGGY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JoGVyn8yYPn2gKcCjIFjnC719tUq3eZ211KeukFMNLA&oe=69D25DC6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBEc_Uc_A0MQ7kNvwG2CxVX&_nc_oc=AdqPtzdTukGXEkAthQ2R0LvAENK5B_oo7sBG8OHw4RvRRhm7xmEeHACBFlrIWoEVhKY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YWtgvvGSGYQTCXxZpSRgURTGZkZfjWDHkg9fHbF8KFQ&oe=69D27C39"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCH
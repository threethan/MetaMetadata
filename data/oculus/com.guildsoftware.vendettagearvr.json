00_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I6JPbsIyx1EQ7kNvwHHQAgW&_nc_oc=AdmOLVS8IS8dFE3S7GItCF9UZg16u1-ipZuy_02g_Q-ZIkObYXnhcg6nAQb1bpN5WI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxGIMiYzEdHVmWMWTgSsFunIMd0tZPKW7b5o51ELnPTFw&oe=69B94F93"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaC1_A9YWuwQ7kNvwGFYzIe&_nc_oc=Adk2UnQCmIVTSDt3t7E-mTFbdjv6M-2Slm_aKvT4IHcaC_TKi1Oce5E7KevAFrWD8b4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afwx4bSEDJ98IVI6g6Wo5qaimKlDmlFlmma38Jf6iK3Clg&oe=69B9496C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Tg-erIiTi8Q7kNvwFSEaDr&_nc_oc=AdmGBeqhK3zOODJJDylj05hng4jUC2_LOrJ3eWtxfleC2n9SxP7Plunnf_nR4TBEglU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyNa3Zix8_uaZzlFK1jIxx8jgy5h0StQi-b4_OpNCW9_Q&oe=69B95146"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l10fbwT6BBAQ7kNvwF3tb7Y&_nc_oc=Adm2IE24QegTaVGW1U0bNk101DW3iTuI32oD_aWZm_npn27JezqtVkTjJy8MZouu9MI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afze7FJVIWGi9WdjmZlBzPCUhaYLvwaj2ihQUwvs8IQexg&oe=69B93779"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_m
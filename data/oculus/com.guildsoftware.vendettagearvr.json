00_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MgYVR5_cogQ7kNvwFTj2iP&_nc_oc=AdmaDyhWs6Vfge-Wxa3WiGGr6rzGXYGlRrGZKujPmcRw0Z-bGd5_GOTvvR75UafFBDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftPMQ6askF4OThzIe09DN81U5jPL6ppb4YeuQ8X2l7-Aw&oe=69A97D93"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T10UqYMiL4QQ7kNvwHUrXl6&_nc_oc=Adnxnnvytu0eOFZY9Tub6Iac2apCzMV20AIlHJhIliWLqzsjWxhW4LMJVo6Pip0nWls&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afuy8sb3niIsxs2VNzxxBfyAFbcJMW9dfoKTJtbBGN3w-A&oe=69A9776C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XunNY9TbOBIQ7kNvwG6CUXO&_nc_oc=Adn6zG1EcBN7_UVRXqz2_tCqRzIxsf-rzcl6kKjdQkFc1KkrKz9FLhsyW1UsGOgpafg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvP9BhvUtTse7Nmk0TU50tyDoTDG_XEP61OumlnuTwvew&oe=69A97F46"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSWB6NRf_NkQ7kNvwE3bBBI&_nc_oc=Adnhj8J3Txovd8dxGmo5X9R1vxUVbXQki-Z9v0TOTr8bekPRETtkjjfDSn_YwqcHaE0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuTKXX1kwiqU6mEN1ZM98uTWYTJ8_-ev0hH5v6MEHobSQ&oe=69A96579"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_m
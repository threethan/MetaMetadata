331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mHYhFl-9c0Q7kNvwE9oXEP&_nc_oc=AdrNNhPb3Pm3kTaULTrAot4JN3OnMtnL95IN7z67FjshF1CbREEdhzsEbWdIqhNk2To&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzP79uoNRqEfzrKni_mJPhs9vlVtq9ZUC3OshfnJgX_GQ&oe=69C7D013"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t6cW0O__o8oQ7kNvwEnzxMg&_nc_oc=AdoBacRP9oBi9u7_mnVyFgYsjVBRANq16j-3xgew-R4qm-t_wFN4K_KWusNym4XhGkE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypHyMjn3Y4dDWj4WECc_FvJOgHE2D74zFFUeKr2J1rZA&oe=69C7C9EC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNnr5ExlwlMQ7kNvwGHj8ZC&_nc_oc=AdoUNk5YEdMYQv1Ef9rANeIQuhCtlYNe7ksIWeuyPgafALDzIuC_JndtRi07BMTTbI8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxfSxet3Qhikr4kXEeEZy7EVtfV3zXAQNPSVz-UB2KrOw&oe=69C7D1C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7-Suya8arwAQ7kNvwEFZ7GH&_nc_oc=Adp9TJfkRwT5uVvVwOx2Iyu_Govj4HstZWo_fNLSKUbJCjUQnPC1wfgRvWPuoQsz29c&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzwyvmMDQWbYWgd_-P0qBtu5i3CLQ2hl7f4MoZEPHforg&oe=69C7B7F9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCH
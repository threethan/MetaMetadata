00_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92JZu31HifcQ7kNvwE2KD5u&_nc_oc=AdmIexMR-i-Oix7NdRPEE8MuFydZvy5hTdk8GE_NVDW8raS3w0hOxZU5KO3AvYMZuLY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9VFifcYTKZMxYoUV2MFFYK5VF8ges9qgN9CZwJ2irew&oe=69B01513"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8i6NxKu7vGgQ7kNvwHn2iq3&_nc_oc=Admg6sqqAEUAwQQM80vrbiEF6nA5jxbkYwqnY_GNzlghjN3fa5HQP2eSRzwHL6Ibjgg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1Xie0URx7JCFczWa36jrSP7I0vPxLiCdFZiSKrSv3sQ&oe=69B00EEC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TunWA75rfZUQ7kNvwGcsOM-&_nc_oc=AdmLrWvfeuZhhjwdtyhIWa0miIrBEt-tO_H6aD_y5McOyU5xTjkdsJynRqGDA6Wv0U0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5EikOscka5_-O8lbzIv49png12Q32LX-_y1gDt7FvDw&oe=69B016C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FKdkHCEaD-gQ7kNvwHWe_Rl&_nc_oc=AdnkKkKW3-6FFJu_HuuQwYeOrEH7wGJVRrvnR37kYhv0Cfxd3JRas-SUFr7fVTzpHYY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9muWTakXYbr8_9joPQBRNPm9kBUBuqMc9a5HQDh9ivQ&oe=69AFFCF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_m
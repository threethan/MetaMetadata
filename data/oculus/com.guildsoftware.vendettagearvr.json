331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-P3I1_cMasYQ7kNvwHxhdlU&_nc_oc=Adp6Fxpp6KRXkgau4-8yeWGWwjdNQa3FMFj_RkqIgfFUEagHZ3i5YaBY5rXZONOl8CE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IPsl3Kh5IwCEO6_ODiMnkLryFjUdGLqf9vxjaeFhn7g&oe=69E22E13"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AOJAZO-ubGIQ7kNvwG1JM6J&_nc_oc=Adon5YcKjDvrPYw9a0Qv4AwyR0KvKFWE46-QFTAldPFuExWrHm2sHi5_GZtz50sxlNg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0q_KD917PPhEgYqgsMvTA7xyt_IklfWSKlUs494PXBZA&oe=69E227EC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eyiJYpxWvSAQ7kNvwG3ts53&_nc_oc=AdqQPrqxOKj2wm0J2RkHAlZwYzXSFAp_8bPprFWxenDyYI3Ag5Zd4zwuuH0MlT6cY4Y&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af216A32kJi_CAmUpdK79Gs4aBQf2X4vW-lhdMEFBxXvCQ&oe=69E22FC6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgkL5dHbRkcQ7kNvwGEaBcb&_nc_oc=AdpLHyH3UcwsdZHHCaonSyrWE8IcYNS29d3bywCYj-RAqXJH3z8KAOayj2O09A80uqM&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1llLfAwijjw4bDVwoFVt6Oe0zkrB7jTol4D1ndnY3v2g&oe=69E24E39"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCH
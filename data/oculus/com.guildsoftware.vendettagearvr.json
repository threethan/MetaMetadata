2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUuw4VXVgY8Q7kNvwEVMXo5&_nc_oc=Adr4TbmU5Eph6uGBWzkM7_Q8tkkLa7ElIHL_kxboYabEpMqkuCe9-CydYz6eDliKFdE&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PslwvbPjsf8Udq75ErAmbbuT83AnpsR4YMtF01fLc5w&oe=6A1C3013"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4OP1S6WU_ygQ7kNvwF44381&_nc_oc=Adr45JCc3Jh_v3oZkYg2kvg69Xi4T_dgadrckEjGZDGrcCUsN-OBJYWNIR254ZmFGbo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6f4L5pc_gXrRXW64QhKas6OEHUpY92GyRoqKp9KdPyiA&oe=6A1C29EC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBIWankmIw0Q7kNvwHR0ZOd&_nc_oc=AdoyMgmEBcJJH2BdLjiU2PNn0gAmdFYYQuWxCRIWpPUU8_DiP8cR3roz3hH5uDFLyjg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i76PxEUOfAwBAOq_XONl-idNiQM9ETZmJM0cnQWcgUw&oe=6A1C31C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePR7VA3DPdAQ7kNvwFxbPkS&_nc_oc=AdoKCqMwpbLy-iUhdxNCYH_YphmEbhINJMrDPbSK6tCnpASaX8f9qjt832NNbALZLMw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RK1M6ykxtDNZFhnHsON58cko6tc-ULe0HBGLOhGu-rg&oe=6A1C5039"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
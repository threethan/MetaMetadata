2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w97Lu5Je3BEQ7kNvwEg7UVm&_nc_oc=AdoThDPCp0ZKlgsNUhptUFtZW6gGACUkuaNf31WJXSg1YM8h8zzCQ2MOnaLVNOyW2uk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLi6n-8qJxEPA3wPPtSg76yVySdSEThpQVLnAVZ_hlESA&oe=6ABA6413"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WAzZYlcAwtcQ7kNvwEOWShU&_nc_oc=AdrPcs-LTQsQQGdYBBF3E3FC6WphI4xmtc3J_rLquvEeLdy-hli5UwPT7fgxyiDNx2w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJga4m-wUU_BE9h5Sv2DvQYYOHIXF9P_IfaHTRSFV8xrg&oe=6ABA5DEC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AJ7RaKpIh0Q7kNvwEwPGmp&_nc_oc=AdrbQWeCIU-gCuNsLZEFusjEtsV-_6oH4Si_nzJVdk1UbnF4W1jEYpaBVG3LZ18aAls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAUWXVgku3k1UrirBU8_exNwrFCI-YK-2hDMoMml2yIQ&oe=6ABA65C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJMs8vDf58MQ7kNvwFK3FfM&_nc_oc=AdrwwEoBLgO4f_HVvnGKryNEo4a_yzE4u02falkIyj2GEx1TJq_-urS5MgRKdSHbmGg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdxnQIzaXCHkCt0XqZstf_BjU-uRZwpIZAgIWh0HXhNA&oe=6ABA8439"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
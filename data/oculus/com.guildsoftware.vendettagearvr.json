00_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_T9ET6CDDv4Q7kNvwFmMNYD&_nc_oc=AdliZgtRHsbWblx1kXPFZYw8NQT53iV-x6Gnjv2-4xGJ4c71kQjN7ym4T0KgbJelkTI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9iBLQ6_aZ1u4cz2OppfX2RgHS-E1VderiarRrs_7gIQ&oe=69BD4413"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIntbyiTpBIQ7kNvwGDfAht&_nc_oc=Adn-AzQKDnLC0oXttu7wAOpj8PFYSy3DPv0aPDcmUASYNQe3AajtLYtw9TqlVxRO1BU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxZFYBxsd5U0mSLTlS5B4_79v6SY32u-mlYtLQCYDFe8Q&oe=69BD3DEC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSmZL_G5rNkQ7kNvwEmyvbs&_nc_oc=Adl50MW5XfSGcKxA3At6G0BJM21Yu8LGwZ2RCZaVTgst9LdJrgIktCwxjT2FZ2tPXgo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyX4E2ebFQaLXGJd3nXaJZLebUMy6aja1yAYFUWFTSGFA&oe=69BD45C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_YThDo1zKUQ7kNvwH0g4WR&_nc_oc=AdkSQzp0DwhMkhbp6_BpAluwYf_dBV-intxb20iV6osL9BtQb8K3R0CPxFpWkqXdK_g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afw8pnUIt6Y5oD6Mv1pxZn1lmC3VUX48Ov01wP11-u1SEg&oe=69BD2BF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_m
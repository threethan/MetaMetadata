le combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "271395045080006"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "285667251980615"}, {"status": "PUBLISHED", "id": "1068900803310992"}, {"status": "PUBLISHED", "id": "319266688652251"}, {"status": "PUBLISHED", "id": "1848328995403432"}, {"status": "PUBLISHED", "id": "1989057234693794"}, {"status": "PUBLISHED", "id": "299238847246955"}, {"status": "PUBLISHED", "id": "502812467141086"}, {"status": "PUBLISHED", "id": "431191451044197"}, {"status": "PUBLISHED", "id": "449538002071966"}, {"status": "CANCELLED", "id": "2008641192713379"}, {"status": "PUBLISHED", "id": "307752726713384"}, {"status": "PUBLISHED", "id": "1822199811350746"}, {"status": "PUBLISHED", "id": "313643042530526"}, {"status": "CANCELLED", "id": "159765137968122"}, {"status": "PUBLISHED", "id": "378571456042344"}]}, "baseline_offer": {"id": "1822199811350746"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1533538800, "status": "PUBLISHED", "id": "285667251980615"}]}, "liveChannel": {"
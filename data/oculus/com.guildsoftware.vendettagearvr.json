2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Buygg-obWcQ7kNvwHdM_dD&_nc_oc=Adr7GgeC_1c5zZE4U-0IUn1ovTwH_JvprHXFLGA_1CJucUAmD7Br-m4LhI1S6Wbcwtk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0yjb-Z_dJM6E4t0vCTZJmS7BnfHmqoEiNZHjU5rlvFw&oe=6A4E4913"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFMslmS7WDsQ7kNvwH65WZv&_nc_oc=Adq73KzTssUKvpfqgQasWUEhlm_6acMkPnJ_vt52HqExS2zZWSDGFlrCuWiRQXSwuiw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBm0bOl9rPMLtgCp45RFTpTGgiQ11aHsDGag-oYEdx1sg&oe=6A4E42EC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xXkVACyvjrkQ7kNvwGicR1n&_nc_oc=AdpEbsrGWluxAcjJld-BSrKhEkus0y-lZIm7obbslgPe6wOhIjn38SFnFzhF8225dW8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFheNHgZhJmk3zcRxEi6-ruR4IsrwYmffB5VXLdnj9Yg&oe=6A4E4AC6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gGUkqC49kkQ7kNvwHJKBwJ&_nc_oc=AdoncVd7xH-OnkoI3FYxJ1ndWQQ3a17KBSrKWp3Wv-pPbFZlIdLT46hd4JFbFgI2sqA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMdtNo6FXnxu20V-oQbtCsOz7qBx29mRc8mWAy2asXhg&oe=6A4E6939"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
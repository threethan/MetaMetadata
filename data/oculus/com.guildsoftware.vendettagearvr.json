331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdAm8k1IKLMQ7kNvwFBsADv&_nc_oc=Ado4-rZX932Vcgm0CWkw0vqJxCOQITwEIppIOLmrHep6qe4tVOai_9D5TMBzyMGZoc0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CnMlpgrqMyTd5W3GlO0wmQjJ94qVYavbujaOOVPrkrw&oe=69DCE813"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCoMTkbVUdsQ7kNvwEJb_k7&_nc_oc=AdrSpE1qXCSGuhcqjrOmiQV5YlFqILTS1YBr4ZTo9tGGAcf55zjJQcfhDf_peAMaz_Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1J-zQE2Bu88d8kgkXiDy714Q3QG9QUDGk0B-HuWxlEgQ&oe=69DCE1EC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2ICZEfl3RIQ7kNvwEb-FbH&_nc_oc=AdrtgRepxCGx1EUzDYZKWHikakjLksbtM25AXUzd370nfkYsSzDjvzef84e2ZCLrUOM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fputQO5seMms7LxwC_DGv1pJa2eMvrG6eh5d3Y2HYwg&oe=69DCE9C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipq9DbYNULsQ7kNvwGLEHDg&_nc_oc=AdqaTuBAN_UOYKWLeR3KASMa7M_My07lXHtgcqbhHzCgvX7d7v4pmb9lG7wbU5SzCDc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nvL9Cbt9rhYUBUwvkjlQ0aCC3R78rhO76SJmM3eL-uA&oe=69DCCFF9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCH
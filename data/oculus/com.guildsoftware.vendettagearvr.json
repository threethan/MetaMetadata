2331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g93Yybuy-SUQ7kNvwHmsdLy&_nc_oc=Adpn3fTQNoiWiz6DIzBOzKrIN0zjifria6M_5Wb76QskUo9scTFA8Wddg6N5s47VLnE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63YX_bHZ_hXFd29iB7PE0TLmPHtmbmxalmBCM2LKXQeQ&oe=6A0F0113"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OoWc2p4zw38Q7kNvwFGNK1M&_nc_oc=Adqyv9AM2T-Uze6BuQVEhdCO69xnyw1-pfU5qcHKrQJEHhp1sQv8Lv3eF4P9obg1Ecs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IqvyJNhdlojx-_ipdx4rYgifiusM8j-6mUGR-ftSjkQ&oe=6A0EFAEC"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ObLAay2atC8Q7kNvwEl6GBd&_nc_oc=AdoZymanQuVeScGL5P-y6H1BaksuLXCUORGmnFyIVMYIcuHNlmCn3VjF2WiVDqTOn0M&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C78l1o8GgNt7DtOrC234FfC7SWN3vgICYBDv_CyypdQ&oe=6A0F02C6"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3mbdnsXdOk4Q7kNvwEcAYTV&_nc_oc=AdowERluYjr3oiFUskYkiGHxECpD12VogZY8cQCQUgTVCeCkWB54AX8f9Q_k0iyLtZw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lxFq5wlPhY3VTLk4w58WqRhZ_YxO82XyPGU1u655QtA&oe=6A0F2139"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUC
31ED3"}, {"file_name": "migrated_image.png", "id": "579423779451961", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12482309_586086974886403_395079475_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxIJaCd-gQ8Q7kNvwFWj4Ms&_nc_oc=AdrBNWv15JHj_Y3dR2S_HGML4DJtKUzBGq_xEjJSqK9TydE0CRXd_xNyldZwvjnfU1E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShZUy8c0R4rzTpoPMhwmsMGbaIp8RLeErDeQeZREXcwg&oe=6B032A10"}, {"file_name": "migrated_image.png", "id": "814921532317779", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eGMhlZ76zjsQ7kNvwEn3RSD&_nc_oc=AdpEwMm7AZrTGemiy7-Kl6VtKNsTY3fbWzojNSQCZCIC4KrJKPvVGFT-Pld8-fvo370&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR4SCMfwRHL75nROv5ixJgwmMF9hBxvfZBeV8JP15jhA&oe=6B0306B9"}, {"file_name": "migrated_image.png", "id": "202132804538375", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdHHO6gBu_oQ7kNvwGnCVxv&_nc_oc=AdqoHKrH3Fzokdo6W5hxvv6po9cH_LY7eF73mOk6E5ru3t8DbUeXivr-ZUbj8-dbdzY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxZUERiDqD8mm7qZeuWDT_vLfs2XaZA108Ldv5bjB0Sw&oe=6B0318AC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "271395045080006"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "285667251980615"}, {"status": "PUBLISHED", "id": "1068900803310992"}, {"status": "PUBLISHED", "id": "319266688652251"}, {"status": "PUBLISHED", "id": "1848328995403432"}, {"status": "PUBLISHED", "id": "1989057234693794"}, {"status": "PUBLISHED", "id": "299238847246955"}, {"status": "PUBLISHED
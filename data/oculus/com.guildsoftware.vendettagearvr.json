331136_1638193663163278_2014892400_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdAm8k1IKLMQ7kNvwE7_TIj&_nc_oc=AdqpKpgLj2vh7F-7ZJa4v_U-ueYOlFKklbaq3WRi5vl1mFyynzQ3XpBSYUcpCQoSFAM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UPHtsqcUWFG7wTWkEtkRlQ5JpKcOGXBE4Xokgaa_EIw&oe=69DB9693"}, {"file_name": "migrated_image.png", "id": "857012898097575", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12139458_316445582025079_523241312_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RCoMTkbVUdsQ7kNvwHkK8ek&_nc_oc=AdoNVo4r5N5pZ6O9acKFv2Vln9roCCn06FHdwoVMLLhDcUPBvlMf-dmE_vYcQSG_yWI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UAblh6G7N2ezhmY9yd4bg9s3fGlu0PShb4_1kZ5tMBw&oe=69DB906C"}, {"file_name": "migrated_image.png", "id": "538842586758933", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12331111_635327123309791_457548879_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULIXEsNSzkcQ7kNvwFgOlOW&_nc_oc=AdrUwA1EIjDJj5F6juiQivGOI8ocR6PPnVpby9e4wUsqeVrmjq6vLhL2X1MJ8mytRjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af03WoxttdE6XBQOsAaH_HpXW6JMUWpJaFPoM4sywRiVyA&oe=69DB9846"}, {"file_name": "migrated_image.png", "id": "239870640385792", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12533746_1088554031181786_1963803798_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rwqej7VO2TkQ7kNvwF62jPw&_nc_oc=Adp0xVd7_bv3svlEh27FeYvAnl9VcUX4d0iIKnuUXKVm6DizbTmO-wxUQqkivavYqUc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AGvSaMVWNgv_nxQ50rxbep3g8qMi-43rbiQsbAkyeMg&oe=69DB7E79"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vendetta Online VR", "keywords": ["space", "mmo", "mmorpg", "shooter", "vendetta"], "long_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy. Three major player factions form a delicate balance of power, with several NPC sub-factions creating situations of economic struggle, political intrigue and conflict. The completely persistent universe and detailed storyline add to the depth of immersion, resulting in a unique online experience.\n\n- Integrated voice chat, Speech Recognition, gamepad support.\n- Vendetta Online for GearVR is Free To Play, with optional purchases to accelerate or unlock certain benefits. There is a level cap for Free users, but it usually takes weeks to reach. We plan to remove the level cap.", "short_description": "Vendetta Online is a cross-platform 3D space combat MMORPG, allowing thousands of players to interact as the pilots of spaceships in a vast universe. Users may build their characters in any direction they desire, becoming rich captains of industry, military heroes, or outlaws. A fast-paced, realtime \"twitch\" style combat model gives intense action, coupled with the backdrop of RPG gameplay in a massive online galaxy."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vendetta-online.com/h/privacy.html", "developer_terms_of_service_url": "https://www.vendetta-online.com/h/eula.html", "publisher_name": "Guild Software, Inc.", "support_website_url": null, "website_url": "https://www.vendetta-online.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCH
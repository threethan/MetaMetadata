rilla"], "long_description": "Barbo VR is a fast-paced Gorilla Tag\u2013style VR fan game where movement is everything. Use your arms to climb, jump, and swing through unique maps while chasing or escaping other players. Barbo VR focuses on smooth locomotion, competitive gameplay, and chaotic fun, making every match exciting and unpredictable. Whether you\u2019re tagging opponents, mastering advanced movement, or just hanging out with friends, Barbo VR delivers an energetic VR experience inspired by classic GTAG gameplay\u2014with its own twist.", "short_description": "Barbo is a game with gorilla tag semi like movement "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/barboprivicy/home", "developer_terms_of_service_url": null, "publisher_name": "TacoTheInventor", "support_website_url": null, "website_url": "https://sites.google.com/view/barbovr-info/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "30730980659881841"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1798167241135406"}]}, "baseline_offer": {"id": "1798167241135406"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767358140, "status": "PUBLISHED", "id": "1798167241135406"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary
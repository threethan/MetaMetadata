T3D9NHksM1FQXk0g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnfOcvPCTWvTyWWXbT9XWpf8POu8Pmo9R5Ib_qU5I8Mg&oe=6A564A37"}, {"file_name": "Frame 438.png", "id": "1506206500038599", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974632_1506206503371932_1010687020742680659_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X_qmqxDw9KYQ7kNvwF4H0lf&_nc_oc=AdqphcFQln1p8nCsbfyXFXOUN1XpuErnDujoZ8guwuJSTbnTG5TfuXNpbtR5F2OtEVo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbKSBbcR-VbrqDZW0uYenWr5LrPEyN-jKuWE_jCBzmRw&oe=6A564D1E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Patient Examination Pro", "keywords": [], "long_description": "Pre-Configured Scenarios:\n\nVarious clinical cases covering common and rare conditions.\nScenarios range in complexity to suit different expertise levels, from medical students to seasoned professionals.\n\nPatient Interaction:\n\nVirtual patients with realistic symptoms, behaviors, and histories.\nDynamic responses to user actions, such as questions during history-taking or physical examination maneuvers.\n\nExamination Tools:\n\nVirtual stethoscopes, and other diagnostic tools to simulate physical exams.\nIntegration of digital pathology tools, allowing for skin examinations, and more.\n\nLab Analysis and Imaging:\n\nAccess to virtual lab results (e.g., CBC, LFT, urinalysis).\nSimulated radiology imaging tools (e.g., X-rays, CT scans, MRI) with real-time interpretation options.\n\nReal-Time Feedback and Evaluation:\n\nAutomated feedback on diagnosis and decision-making.\n\nCustomization:\n\nLooking for more - contact us with your curriculum requirements!", "short_description": "The platform provides immersive, pre-configured clinical scenarios where learners interact with virtual patients to practice history-taking, physical exams, lab analysis, and imaging interpretation. Using realistic tools and dynamic feedback, users develop diagnostic and decision-making skills while educators can customize cases and track performance. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://provenreality.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Proven reality", "support_website_url": "https://provenreality.com/contact-us/", "website_url": "https://provenreality.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "393222478507326"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8020236934746474"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38982637_870569961958474_2546980609285620915_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZyTB0XLgDOwQ7kNvwHiH7MN&_nc_oc=AdpHp-cwWAbAbenvi50CzMuoADo_npYILlYbKK8LTO_AbTgRo1TIiVvie0NctwjstSk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_VIARdGLwqdI_20jcYr5NHWIuyCBKP1kiVfWL3h0zYQ&oe=6A5640B0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Patient Examination Pro", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Utilities", "id": "393222478507326"}, {"topic_name": "Medical", "id": "478089301798119"}], "release_date": 1742793300, "lastRevision": {"nodes": [{"
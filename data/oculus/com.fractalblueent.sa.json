ht for survival in Scrap Age, a high-intensity VR horde shooter! Team up, battle relentless waves of enemies, and carve your place in a post-apocalyptic world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fractalblueent.com/scrap-age-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Visual Purple", "support_website_url": null, "website_url": "https://www.fractalblueent.com/scrapage", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "33217657051211299"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830783_700453072656308_6181444183409649450_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k0QX9sfP4sUQ7kNvwHmNfPU&_nc_oc=Adl0idgn_IgSgVDNYI-AzgEz8IDxMsWsPtYfB4UwCp4GVDYUnuZ_TehSjFwYLd3yjRs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftBi-cotuwukzZWaMacUKzt6M7SxJKlDATmfjT4tvFY_A&oe=699C4D73"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scrap Age", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Hangout"
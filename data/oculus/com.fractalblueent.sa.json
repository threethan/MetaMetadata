t-dfw5-1.oculuscdn.com/v/t64.5771-25/473392019_1013462664036844_7976512061164988143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nySXe8j3RUkQ7kNvwHdyi1J&_nc_oc=Adoes5LxxDCqqhVUH-WfDxpQCymF7yfvmoZfBE3sgcUX9sGzEGH8aPkMnEf0uw5Tbws&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-XBn349F54QezQsMHmLnZ7eyJWHlmUFz_36oo5soTMw&oe=6A8AC7B1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scrap Age", "keywords": [], "long_description": "Step into the post-apocalyptic world of Scrap Age, a thrilling cooperative multiplayer horde-based arena shooter that puts you in the heart of intense, adrenaline-pumping action!  \n\nTake on the role of ORIN, a bot who crash landed on a mysterious, junk covered planet inhabited only by other robots who are just as lost as our hero. Awoken by a small fox-like robot known as Smol, aide the Rust Wanderers, a band of misfit bots pushed out by the Dominant Hand, fighting for survival and a place to call home. \n\nJoin us in Early Access and fight back the Dominant Hand in an exciting, high flying VR Horde mode across 4 maps while working through 40 levels of progression, earning rewards as you go. \n\nAs the early access continues we will be adding new and exciting content such as new maps, game modes, weapons, and enemy types. \n", "short_description": "Fight for survival in Scrap Age, a high-intensity VR horde shooter! Team up, battle relentless waves of enemies, and carve your place in a post-apocalyptic world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fractalblueent.com/scrap-age-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Visual Purple", "support_website_url": null, "website_url": "https://www.fractalblueent.com/scrapage", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "28637070909269959"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "673956205134064"}, {"status": "PENDING", "id": "872753660768608"}]}, "baseline_offer": {"id": "673956205134064"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1743459000, "status": "PUBLISHED", "id": "673956205134064"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "34437886812521644", "version": "0.7.89.16"}, "id": "560923896057564", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9621531667917169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34437886812521644"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "560923896057564"}]}, "change_log": "# Patch 0.7.89.16 \n**Early Access Patch 0.7.89.16 - What\u2019s that I hear?**\n\nGreetings once again Rust Wanderers, we have a new patch hot off the assembly lines for you! This patch addressed many things and applied a whole new level of polish.\n\n**Gameplay**\n- Blackhole gem removed - We have temporarily removed the Black hole gem from the game. The game in its current state rarely crashes, but if it did, it was most likely due to this gem. Due to the nature of the crash the gem needs to be rebuilt from the ground up, which we\u2019ve decided would be worthwhile because we aren\u2019t happy with how the gem currently works in gameplay, which is to say it usually fires off when there is nothing nearby to be affected by it, so we\u2019ve decided to overhaul everything about it. We aren\u2019t quite ready to discuss what these changes are, but just know that when Blackhole returns, it will be a much more entertaining and useful effect!\n\n- Tweaked spawning for Pipeline - Fewer Spitballs will now spawn all at once in the third wave. Pipeline had an issue where in the third wave many spitballs would routinely spawn all at once, this had the effect of creating a massive jump in difficulty on that map \n\n- Increased the deadly nature of Squibs (the kamikaze bots!). They now move faster, especially in later portions of the match\nImproved the results summaries after each match. They now more accurately depict bonuses gained\n\n- When the teleporter at the end of the match arrives, the game now transitions into defense mode. Enemies will spawn closer to the teleporter and try to defend it from you!\nCharge shot begins charging immediately now instead of having to wait half a second\n\n**Weapons**\n- Sword - Sword now properly works with the Charge Up gem. There was a bug that was causing the sword to not notify the server that Charge Up was in use. This meant that while the player saw the Charge Up effect, the additional bonus damage was not being applied \n\n- Bow - Arrows fired by the bow now properly play their sound effect and the bow no longer creates a new sound and uses up an additional sound channel every time you draw it. This bug could lead to loss of other sounds\n\n**Sound**\n- Fixed bug where music sometimes stopped\n\n- Enemy Sounds - Enemies now reliably play their non-voice line sound effects\n\n- Spitball now plays its charge and fire sounds \n\n- Popcap plays a more audible and helpful charging sound\n\n- Modularry plays a charge sound before firing now\n\n- You no longer hear other players drawing their weapons\n\n**Bugs**\n- Fixed a bug that was preventing Popcap from playing his animations. He now properly plays animations again.\n\n- Fixed Popcaps sometimes spawning in invisible.\n\n- Fixed a bug where enemies killed exclusively by AoE type damage were not counted toward a player\u2019s kills. This was most noticeable with grenade launcher users.\n\n- Fixed Spitball\u2019s nameplate not facing the viewer\n\n- Fixed the weapon carousel sometimes loading players in with all weapons locked except the handgun regardless of if they had unlocked the other weapons.\n\n- Fixed visual LOD levels on items throughout the game.\n\n- Fixed a location on Restoration Pools that prevented Wynders from moving after spawning.\n\n- Fixed the end of match teleporter\u2019s visuals so it no longer clips out of view when you start looking away from it.\n\n- Fixed a bug where Popcap would sometimes leave behind a permanent humming sound (yo ho ho)\n\n- Fixed player\u2019s nameplate so that it updates reliably now.\n", "created_date": 1774536783, "id": "34437886812521644", "version": "0.7.89.16", "version_code": 89, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "34437882269188765"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9621531667917169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34437886812521644"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "560923896057564"}]}, "change_log": "# Patch 0.7.88.4\n**Early Access Patch 0.7.88.4 - Tiki Thunder!**\n\nGreetings Rust wanderers, our small team is proud to announce our newest patch, aimed at optimizing the game, squashing some nasty bugs, and adding a fresh element of tropical flair! \n\n**New Content and Cosmetics**\n- **Tiki Cosmetic Bundle now live** in the store! Channel ancient island warrior aura with this bold, tropical-inspired set. Though made of simple materials, swag goes a long way in the Slaglands. This legendary cosmetic can act as a talisman, to fend off evil viruses and stand out in ORIA Station like never before!\n\n**Unreal Engine Update**\n- We have upgraded from Unreal Engine version from 5.5.3 to 5.5.4, \n\n\n**Bug Fixes**\n- Fixed a bug related to engine 5.5.4 that caused massive lag spikes in gameplay. Gameplay should feel snappier and more responsive now with decreased latency.\n\n\n- Fixed a specific bug that occurred when a player died between waves. If this happened, there was a chance that the banner and dialogue indicating the start of the next wave would carry over in the results lobby screen.\n", "created_date": 1772233873, "id": "33952800407696956", "version": "0.7.88.4", "version_code": 88, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "33952796144364049"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9621531667917169", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "34437886812521644"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1771632114, "id": "33832295773080754", "version": "0.7.87.0", "version_code": 87, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "33832291496414515"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__
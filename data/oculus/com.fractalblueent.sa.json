c_sid=6e7a0a&_nc_ohc=uKQOKtza6q0Q7kNvwGvSRjU&_nc_oc=AdpXW7Ukf-coVHqlTfUpdqhG0rBVbOb6m1RjvJtCz1k0ZO7ITgQNiPbgD_E2bg2LE3A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx8Nvh87tLrN8dmU6uGF1oJJ5eSsVs4zDOph8Os0aiFXw&oe=69C6733D"}, {"file_name": "ShantyTown01_1.1.7_1.1.8_1.1.7.png", "id": "1140105124101418", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393450_1140105127434751_7458285714880140049_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_AS-sneTr8Q7kNvwGWJEx2&_nc_oc=AdpTUHFMmeW9sDkuMiU2xSqQ5aSsQDLi_nQ-by05zZSlHav4u47AJrP87ZC_kjWh1Rc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzS7zNEHnLmgnAiBRcHKHsr6SEKUphgfwCq5qs3BgzL3w&oe=69C68AD9"}, {"file_name": "Grappling01_1.1.6.png", "id": "1013462660703511", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392019_1013462664036844_7976512061164988143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qhE4JCk-CpAQ7kNvwGkSC50&_nc_oc=Adpx2r2Jb69gHWG_pdY5X1lqb6Su9Qnc7DSx9D4hkXijBg0Re9ASdaSP6XOWVNwPmGE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVQNbsK6tWJX08nvWKaQ15LXRCqqOlbDl3DVSLjvjugg&oe=69C69071"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scrap Age", "keywords": [], "long_description": "Step into the post-apocalyptic world of Scrap Age, a thrilling cooperative multiplayer horde-based arena shooter that puts you in the heart of intense, adrenaline-pumping action!  \n\nTake on the role of ORIN, a bot who crash landed on a mysterious, junk covered planet inhabited only by other robots who are just as lost as our hero. Awoken by a small fox-like robot known as Smol, aide the Rust Wanderers, a band of misfit bots pushed out by the Dominant Hand, fighting for survival and a place to call home. \n\nJoin us in Early Access and fight back the Dominant Hand in an exciting, high flying VR Horde mode across 4 maps while working through 40 levels of progression, earning rewards as you go. \n\nAs the early access continues we will be adding new and exciting content such as new maps, game modes, weapons, and enemy types. \n", "short_description": "Fight for survival in Scrap Age, a high-intensity VR horde shooter! Team up, battle relentless waves of enemies, and carve your place in a post-apocalyptic world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fractalblueent.com/scrap-age-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Visual Purple", "support_website_url": null, "website_url": "https://www.fractalblueent.com/scrapage", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "33217657051211299"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491830783_700453072656308_6181444183409649450_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSg_6Sr6ecgQ7kNvwHA_Q1v&_nc_oc=AdpPtpekdA70Y0J1YBjBMBlTGpUS049zvrMzhgNgIqN0j3vMVFYZ_3ynBQV6W57_IOQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGrhMRsDsO5iUpHKJUQzQU3g5yD4lD7cBpau8VRfIoDw&oe=69C67D73"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scrap Age", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "27433260359
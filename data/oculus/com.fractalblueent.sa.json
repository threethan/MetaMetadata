Q7kNvwHiDeme&_nc_oc=AdljymMude78ExF4yk2lrsORkR_QVYR_2kXI5hEBysA97UmkD4jR8dSk00qhHiWtiaA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afudv0FOBVzLB0_r2iYLmSiMzNuagpUsIF9TCNcc8UcI8A&oe=69A9723D"}, {"file_name": "ShantyTown01_1.1.7_1.1.8_1.1.7.png", "id": "1140105124101418", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_1140105127434751_7458285714880140049_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=annTpcFALckQ7kNvwGmhIhv&_nc_oc=Adl5iRVNdt0KuQDzC6Aqk_YD5Klz9IsZD0gqesL-qdDqI8Fh5Do7REETa2rxXshb6x4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afu32_uXY0MTLuZUk6iD0ksDrOWLEtoLY4JmfglhgbynIQ&oe=69A989D9"}, {"file_name": "Grappling01_1.1.6.png", "id": "1013462660703511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392019_1013462664036844_7976512061164988143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T_lGcHqp1lMQ7kNvwH4wAdB&_nc_oc=Adntpt3i8xsgLPpB1zkd9emzXAIfPL5c_jVqh01sbtFlWdKTUMHP3_PUATRz78_kCvU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuECvCCDerWjJRlWDIeAFJ7fttSqoNcC-239nSa4DLjzA&oe=69A98F71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scrap Age", "keywords": [], "long_description": "Step into the post-apocalyptic world of Scrap Age, a thrilling cooperative multiplayer horde-based arena shooter that puts you in the heart of intense, adrenaline-pumping action!  \n\nTake on the role of ORIN, a bot who crash landed on a mysterious, junk covered planet inhabited only by other robots who are just as lost as our hero. Awoken by a small fox-like robot known as Smol, aide the Rust Wanderers, a band of misfit bots pushed out by the Dominant Hand, fighting for survival and a place to call home. \n\nJoin us in Early Access and fight back the Dominant Hand in an exciting, high flying VR Horde mode across 4 maps while working through 40 levels of progression, earning rewards as you go. \n\nAs the early access continues we will be adding new and exciting content such as new maps, game modes, weapons, and enemy types. \n", "short_description": "Fight for survival in Scrap Age, a high-intensity VR horde shooter! Team up, battle relentless waves of enemies, and carve your place in a post-apocalyptic world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fractalblueent.com/scrap-age-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Visual Purple", "support_website_url": null, "website_url": "https://www.fractalblueent.com/scrapage", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "33217657051211299"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830783_700453072656308_6181444183409649450_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T7gbILtMf-0Q7kNvwFgf__T&_nc_oc=AdnNEDxNQuk_9h1mxHkrAgc--Z6e_uGqBCJNjOw2gGfQICWsZBvRPNp3HuOTmXJlhgM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftbkfIUsfyeNqW5Bg3iTFdng-lDKUa09YrIUyHRtjI_BA&oe=69A97C73"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Scrap Age", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shoo
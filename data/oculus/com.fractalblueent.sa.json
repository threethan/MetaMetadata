6_1074049364767559_8816760979575901390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XTQQx52VpZoQ7kNvwGfYmgy&_nc_oc=AdminqVqw3WQpSUYn9yaDql0iHwSBTvoS6L0xTHlJBxInMM7-ZWh7d_oZhee0ir3cBw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvLpXEashrFQJqgGYyS2TxhlGzBDyKqmfNwRRS-rsrGCw&oe=69A2E541"}, {"file_name": "Player hub 01.png", "id": "312521744507645", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_312521747840978_4560232021714318264_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiKwEEK1uZ0Q7kNvwGgY27F&_nc_oc=AdnVw_U73yCuYxL7N5q9It0MsdoKVbgEVh7Rcx7nquyI-zyXL2u8LOpbbUWVBVLtsOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afuti-yHyK1HMKPAve6UeaXM43rzmJSH8ppSrYICz-zy7g&oe=69A2CA43"}, {"file_name": "MoltenOutskirts01_1.1.5.png", "id": "647363687698813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_647363691032146_5075446056080703293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhb95DPS66wQ7kNvwGpb2OA&_nc_oc=Adk8VL4TBaOnLA8o-vWYuyXQtc9AOfLvIOE3kIhqEkVABNGnpXwj2_0gJDCwexjeSpY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfveRYQ2XU1tr41UCgtbrn91Jf7t1GtuWWsPsZTqEOJAHw&oe=69A2DABD"}, {"file_name": "ShantyTown01_1.1.7_1.1.8_1.1.7.png", "id": "1140105124101418", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_1140105127434751_7458285714880140049_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQZnEc4EpHoQ7kNvwH7gmoy&_nc_oc=Adn2bN113UfevUX0hOaWOuZUh5O4TCfslymTuTZK95nlTKCRXJTuuArmnHIzmSo2HHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs4MlYrfFDKA1avHJAN8tNSg7aWkgIpnuGMfsiz_zLsyg&oe=69A2F259"}, {"file_name": "Grappling01_1.1.6.png", "id": "1013462660703511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392019_1013462664036844_7976512061164988143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOsXRQmJYwcQ7kNvwGeOu_v&_nc_oc=AdlHkE0CeasE15jKftHQabRlpItCHiVEZ9ymB4BXqq-HWreCNNYq72S9VhHdXEymRlU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aft-3HRSuOlVRETYdguhqobi2Zc9GpfHLluTvZFPh-6aIA&oe=69A2F7F1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scrap Age", "keywords": [], "long_description": "Step into the post-apocalyptic world of Scrap Age, a thrilling cooperative multiplayer horde-based arena shooter that puts you in the heart of intense, adrenaline-pumping action!  \n\nTake on the role of ORIN, a bot who crash landed on a mysterious, junk covered planet inhabited only by other robots who are just as lost as our hero. Awoken by a small fox-like robot known as Smol, aide the Rust Wanderers, a band of misfit bots pushed out by the Dominant Hand, fighting for survival and a place to call home. \n\nJoin us in Early Access and fight back the Dominant Hand in an exciting, high flying VR Horde mode across 4 maps while working through 40 levels of progression, earning rewards as you go. \n\nAs the early access continues we will be adding new and exciting content such as new maps, game modes, weapons, and enemy types. \n", "short_description": "Fight for survival in Scrap Age, a high-intensity VR horde shooter! Team up, battle relentless waves of enemies, and carve your place in a post-apocalyptic world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fractalblueent.com/scrap-age-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Visual Purple", "support_website_url": null, "website_url": "https://www.fractalblueent.com/scrapage", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages
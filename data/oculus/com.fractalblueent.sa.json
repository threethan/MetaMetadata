6_1074049364767559_8816760979575901390_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K_GwuBb90uUQ7kNvwEKvxeg&_nc_oc=AdlsOxKi_xrIxJSzYo-BWOA32rmim5mcairSJen5gUPPD8oVFiW_KjeKzdyU1qSeJis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvxsh__GE0Vu9X6w5y0nGyrLewOmVbEdGowHmILGiE9Qw&oe=6999AAC1"}, {"file_name": "Player hub 01.png", "id": "312521744507645", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974513_312521747840978_4560232021714318264_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYbDyMGCJ_gQ7kNvwE_bMX2&_nc_oc=Adn9BNzBtCJIYcFqWrGMWUPC7TpU2Q7VC1ovI-3gH8yA0Q7xyvL2DTshm5nwyxrEKBk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuD4O4SUcnORd5_dJgxMuQOMlx6EiJFtBPZd_Q7RxWf6A&oe=69998FC3"}, {"file_name": "MoltenOutskirts01_1.1.5.png", "id": "647363687698813", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473393325_647363691032146_5075446056080703293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zdav5hTULUQ7kNvwGqSeZl&_nc_oc=AdnO_K5cu90BfwxHcRmjUpcnvHGTnBSPufpUnwipgvuiYqMGKYL3Uzy03qirlEmIXi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsPorbRfczF52sEAYvxJMvJ8E3XvlBxIelC2IFGmtVOjw&oe=6999A03D"}, {"file_name": "ShantyTown01_1.1.7_1.1.8_1.1.7.png", "id": "1140105124101418", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473393450_1140105127434751_7458285714880140049_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzm8Sczy_PIQ7kNvwEpf6wN&_nc_oc=AdnxV7b0xWRr8E2Ai6Ip3ixEG5IusEzNMaTl2_qfv0UnY_A_6JGWshWQhMmr1Vyfchs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvEuJ9RSaYzWNPa6HrCJ_JzbmIsob223QK66hQ2CGgt3w&oe=6999B7D9"}, {"file_name": "Grappling01_1.1.6.png", "id": "1013462660703511", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473392019_1013462664036844_7976512061164988143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_hADVBQE7UQ7kNvwFKItoN&_nc_oc=Admh0CMMdLy747vJFbcnVCrYW3ziAkOYseUPZI0Nb6DlAEMKl4UjjwXIhhiTqmoFfQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsnD3wWDclswxBA5DRB3pcHbDOK8edqP6mRUeoaQewmAQ&oe=6999BD71"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Scrap Age", "keywords": [], "long_description": "Step into the post-apocalyptic world of Scrap Age, a thrilling cooperative multiplayer horde-based arena shooter that puts you in the heart of intense, adrenaline-pumping action!  \n\nTake on the role of ORIN, a bot who crash landed on a mysterious, junk covered planet inhabited only by other robots who are just as lost as our hero. Awoken by a small fox-like robot known as Smol, aide the Rust Wanderers, a band of misfit bots pushed out by the Dominant Hand, fighting for survival and a place to call home. \n\nJoin us in Early Access and fight back the Dominant Hand in an exciting, high flying VR Horde mode across 4 maps while working through 40 levels of progression, earning rewards as you go. \n\nAs the early access continues we will be adding new and exciting content such as new maps, game modes, weapons, and enemy types. \n", "short_description": "Fight for survival in Scrap Age, a high-intensity VR horde shooter! Team up, battle relentless waves of enemies, and carve your place in a post-apocalyptic world."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.fractalblueent.com/scrap-age-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Visual Purple", "support_website_url": null, "website_url": "https://www.fractalblueent.com/scrapage", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages
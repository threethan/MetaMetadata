20941485", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001729_642219724274818_1692636297105365468_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pQ2WsSNjMYQ7kNvwH3iyWU&_nc_oc=AdrwEbKNQPVXoLb7DN2MM8lKIaCl3_iv2rEUz3ARdsBUsgf-Tti5ZvYJsMld0Ab9Qao&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4eG9o8EuycyDW9A64R7ZVTmakVwB2mal8A7ox47YkTA&oe=6AA93E24"}, {"file_name": "ScreenShots05.png", "id": "1333138094094040", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982559_1333138097427373_774329523838858748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JmUc-tKAycQ7kNvwE7UpFv&_nc_oc=AdrYTsmECmovto4u_pt5aoj66HrVJIo-V-6ZRMogs5EVF7y4M4FY2VKK1Z_YrcLgJA8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2J6I6RIDS8BnF5wDo1O49NBvhOwJNp_UKPiKSRBb_fw&oe=6AA93361"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DreamOdyssey_Miniature.png", "id": "632269985282318", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/75348043_632269991948984_297015910716410482_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYlxq45v7sQQ7kNvwFOPQdt&_nc_oc=AdoRNge9BSkV-q1rvML94dZT5u5tJyPa89t_t4Qek9ZwHZqYl-IMJryBG9tzf1Vyhsc&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9QCvtv7tJU8JNZk7IhFDMhnTn9lxN8wIu9PssVlCZeg&oe=6AA95CB2"}, "display_name": "Dream Odyssey (BETA)", "keywords": [], "long_description": "You wake up in your bedroom, at the edge of dreams and reality, everything is familiar yet unknown. You play as Billy, a young boy fascinated by astronomy who must help his favorite toy, Bubbles, to get back on his planet.\nInteract with the environment to help him reach his spaceship.\nEnter the adventure, use your knowledge and the power of the Astro gloves to resolve the puzzles !\n\nThis is an early version of the game, it does not represent the final product.\n\nAvailable languages : French\n\nWhat to expect for the upcoming features ?\n\n- New unique Puzzles and mechanics\n- An additional room\n- New stories", "short_description": "You wake up in your bedroom, at the edge of dreams and reality, everything is familiar yet unknown. You play as Billy, a young boy fascinated by astronomy who must help his favorite toy, Bubbles, to get back on his planet.\nInteract with the environment to help him reach his spaceship.\nEnter the adventure, use your knowledge and the power of the Astro gloves to resolve the puzzles !\n\nThis is an early version of the game, it does not represent the final product.\n\nAvailable languages : French"}]}, "developer_name": null, "developer_privacy_policy_url": "https://terref.io/dream-odyssey/oculus/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Terref", "support_website_url": null, "website_url": "https://terref.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "454473503409946"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5680267352009025", "version": "0.1"}, "id": "535369215062050", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applic
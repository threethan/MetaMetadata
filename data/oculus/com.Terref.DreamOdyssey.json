A&oe=6B0DC6F2"}, "display_name": "Dream Odyssey (BETA)", "keywords": [], "long_description": "You wake up in your bedroom, at the edge of dreams and reality, everything is familiar yet unknown. You play as Billy, a young boy fascinated by astronomy who must help his favorite toy, Bubbles, to get back on his planet.\nInteract with the environment to help him reach his spaceship.\nEnter the adventure, use your knowledge and the power of the Astro gloves to resolve the puzzles !\n\nThis is an early version of the game, it does not represent the final product.\n\nAvailable languages : French\n\nWhat to expect for the upcoming features ?\n\n- New unique Puzzles and mechanics\n- An additional room\n- New stories", "short_description": "You wake up in your bedroom, at the edge of dreams and reality, everything is familiar yet unknown. You play as Billy, a young boy fascinated by astronomy who must help his favorite toy, Bubbles, to get back on his planet.\nInteract with the environment to help him reach his spaceship.\nEnter the adventure, use your knowledge and the power of the Astro gloves to resolve the puzzles !\n\nThis is an early version of the game, it does not represent the final product.\n\nAvailable languages : French"}]}, "developer_name": null, "developer_privacy_policy_url": "https://terref.io/dream-odyssey/oculus/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Terref", "support_website_url": null, "website_url": "https://terref.io/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["fr"], "suppo
oculuscdn.com&_nc_ss=7f20f&oh=00_Af8A1Tes_aUWc19Isq_Q18UaDVtvAeWCPC4Lp1YY4Jv3lw&oe=6A2ADFFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rat Heist", "keywords": ["Horror", "Simulator", "Adventure", "Sandbox", "Cat"], "long_description": "# \ud83d\udc00Become a Master Rat Thief\n\nEver wondered what it's like to live as a rat?\nNow's your chance.\nSneak through a giant house, steal shiny **treasures**, squeeze loot into your backpack, and escape before the cats catch you.\nBut watch out...\nThe house isn't yours.\n{974791461856325}\n# \ud83d\udc31 Avoid the Cats\n\n{997717225973861}\n**Cats** patrol the house and guard valuable treasures.\nHide under furniture.\nCrawl through vents.\nSneak right under their noses.\nOr be brave enough to mess with them.\nJust don't get **caught**.\n{2492236901194544}\n{27286981687657378}\n# \ud83e\uddb4 Rob the Dog\n{2381673032308062}\nThink cats are scary?\nMeet the **guard dog**.\nStep into its territory and it'll chase you down.\nBut the best loot is hidden inside its doghouse.\nCan you sneak in and steal its favorite **bone**?\n\n# \ud83e\uddc0 Get Rich\n{2468483386958662}\nComplete heists to earn **Cheese Coins**.\nUnlock crazy gadgets, bigger backpacks, and new ways to explore the house.\nThe more you steal, the more powerful you become.\n{3146225005767558}\n\n# \ud83c\udfe0 Explore\n\nFind hidden routes.\nDiscover secret treasures.\nReach places no rat should ever reach.\n\nStart as a tiny mouse.\n\nBecome the **rat** that gives cats and dogs **nightmares**.\n", "short_description": "This is a VR stealth game where you play a rat agent. Sneak through a giant house, steal valuables under the cats' noses, compress loot into your backpack while managing weight, and find an exit before they catch you. Earn cheese coins to unlock crazy gear like a grappling hook gun, gravity gloves. Grow from a helpless mouse into a cat-taunting master thief. Snatch, strike, and scram\u2014be the rat that gives cats nightmares!"}]}, "developer_name": "Smartmelon Games", "developer_privacy_policy_url": "https://thesmartmelon.com/rat_heist_privacy_en", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://thesmartmelon.com/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26244457071894474"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1296208032624594"}]}, "baseline_offer": {"id": "1296208032624594"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1780537740, "status": "PUBLISHED", "id": "1296208032624594"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26275995692073945", "version": "0.0.231"}, "id": "941147691639404", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25523002804039908", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26275995692073945"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "941147691639404"}]}, "change_log": null, "created_date": 1
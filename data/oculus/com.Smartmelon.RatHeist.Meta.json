t-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1kX0QT-Kw5l5XBJ1HfU7cdR2w93jF9OBO03biNktFkQ&oe=6A5380FD"}, {"file_name": "\u5c01\u97622 7\uff1a10.png", "id": "983739767478732", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618938_983739777478731_1398901075121213946_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1Q-Fr7V74AQ7kNvwFYMHNG&_nc_oc=Adpm3tLkcmnDtSqysw_1atnZlwyQ-q3Re6ck_OFlzQkN8QdHOvJvifTlwSsDYCychBY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5aMV3wuEoujSrLuZ-alnGfAgV7YF1reWaDEYICDpQFg&oe=6A539377"}]}, "id": "861984776986430", "locale": "en_US", "screenshots": [{"file_name": "\u732b\u7ea2\u773c.png", "id": "4020956758207789", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619677_4020956761541122_7784354545870655487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wG8rHIPMZz8Q7kNvwGqPDss&_nc_oc=Adoqyzrzclsrt7ekH69VAmF-j1epBLwvNkQWt2oInT1yNvoasoNFCE3XZJ98znHphYw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj92ICZ8JsKMq6XxigjQ7WfIDO7-9LZNrOqbwrb_ZUaA&oe=6A53B1C4"}, {"file_name": "\u732b\u8e72\u4e0b\u5f20\u529b.png", "id": "1015780848065427", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499626172_1015780851398760_2782244150365102905_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTqMzrgMnjsQ7kNvwFAIoFW&_nc_oc=AdqyXBzioT3yi1bRarq96qp8CuPAZ-v98Ejhdu9aNB6vynjJKKBEqZuafEZNm8I_gsY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIFcGkZCRLEFNqmuQx0NRGevSCmhV3bHjuPt5AdNERgw&oe=6A539435"}, {"file_name": "\u4fef\u89c6.png", "id": "1362602532449419", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619672_1362602535782752_7562608473157345320_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V4YmHtnFLRsQ7kNvwEWChWf&_nc_oc=AdqH0acoJeXoKhu1R1swJjpYsGmc0HMMCjT0LErqMCS26LkEe2QZVLaSK1G21JjQoPw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZvqvbvc8utNc1gpYKNArlkgaK5lXOI9BlVnHnH5JfVA&oe=6A53A5ED"}, {"file_name": "\u770b\u96d5\u50cf.png", "id": "4005723776391519", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619187_4005723779724852_4350623939372860694_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhxUPOaV-YkQ7kNvwGnEibJ&_nc_oc=AdrBo3BV3RNH6JwaI0DajaoajH9pqMJWYnnzmdguY4Ovpiw2Qub-fBVnZPprYfB3tDI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCOrsN0wO7Kj7tDYjj8F6dulG431PM-1UBPN3XiS7qN5A&oe=6A5399F0"}, {"file_name": "\u72d7\u54ac.png", "id": "1744896896689883", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622315_1744896900023216_5719792697308216290_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQf9GoX3vbAQ7kNvwE0M2k2&_nc_oc=Adq0AZCOtnlZYaNjLzAxX8dS3p_YKZoZOUKpHeP1fcdcjTWquXNdXm9YR5SRn-m48Q8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCS5PRzjSKzkPvTxKG2bNAlcOVp6Vlofl6JkTVWgVPMzw&oe=6A5395B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499620860_4373918899602783_4538645875800427447_n.png", "id": "3087097821487476", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499299891_3087097824820809_1673088560918173148_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6ijGWVZ8fUQ7kNvwGIUPXm&_nc_oc=AdqLPKzm4ABS0j_MbsLSIHyg9YA6NX5rKgN1BGl2MiqS2Rs1c5a3DhVPwH6AeV8nCXc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH648Th6mlZicLOKyCjr4Nt9Nw-oGGu2I4qXeQ8w49qQ&oe=6A537EF0"}, "display_name": "Rat Heist", "keywords": ["Adventure", "Cat", "Loot", "Simulator", "Rat"], "long_description": "# \ud83d\udc00Become a Master Rat Thief\n\nEver wondered what it's like to live as a rat?\nNow's your chance.\nSneak through a giant house, steal shiny **treasures**, squeeze loot into your backpack, and escape before the cats catch you.\nBut watch out...\nThe house isn't yours.\n{1505273104672473}\n# \ud83d\udc31 Avoid the Cats\n\n{940226755705940}\n**Cats** patrol the house and guard valuable treasures.\nHide under furniture.\nCrawl through vents.\nSneak right under their noses.\nOr be brave enough to mess with them.\nJust don't get **caught**.\n{1507351724204633}\n{2032649500793145}\n# \ud83e\uddb4 Rob the Dog\n{891812757266324}\nThink cats are scary?\nMeet the **guard dog**.\nStep into its territory and it'll chase you down.\nBut the best loot is hidden inside its doghouse.\nCan you sneak in and steal its favorite **bone**?\n\n# \ud83e\uddc0 Get Rich\n{983571990973586}\nComplete heists to earn **Cheese Coins**.\nUnlock crazy gadgets, bigger backpacks, and new ways to explore the house.\nThe more you steal, the more powerful you become.\n{1562345975517250}\n\n# \ud83c\udfe0 Explore\n\nFind hidden routes.\nDiscover secret treasures.\nReach places no rat should ever reach.\n\nStart as a tiny mouse.\n\nBecome the **rat** that gives cats and dogs **nightmares**.", "short_description": "This is a VR stealth game where you play a rat agent. Sneak through a giant house, steal valuables under the cats' noses, compress loot into your backpack while managing weight, and find an exit before they catch you. Earn cheese coins to unlock crazy gear like a grappling hook gun, gravity gloves. Grow from a helpless mouse into a cat-taunting master thief. Snatch, strike, and scram\u2014be the rat that gives cats nightmares!"}]}, "developer_name": "Smartmelon Games", "developer_privacy_policy_url": "https://thesmartmelon.com/rat_heist_privacy_en", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://thesmartmelon.com/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommend
63272_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fAiOd-oxXbsQ7kNvwH1YIWZ&_nc_oc=AdrdBC9A563ND_VTTM9k4vcKCGWdgik2BOzyax4TMyLbzJB2wYaF2Vinj8LkWtbPcJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yGxSgiwZU-xVOcaaz-WhptafT76j7U_6UPbWhRkGBvQ&oe=6A3567BC"}, "display_name": "Noah's Animal Toss", "keywords": [], "long_description": "Help Noah gather the animals into the ark before flood waters rise. This whimsical game sets up a compelling structure for a youth night activity and discussion. \n\n- Noah was said to have \"walked with God.\" What does that mean and can we do the same in today's world? \n- What does it mean that Noah did what he did \u201cby faith\u201d?\n- How does obedience to God's commandments bless our lives? \n\nThe animals going in were male and female of every living thing, as God had commanded Noah. Then the Lord shut him in.  \nGenesis 7:16", "short_description": "Help Noah gather the animals into the ark before flood waters rise. This whimsical game sets up a compelling structure for a youth night activity and discussion. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://immersivehistory.com/privacy-policy-2/", "developer_terms_of_service_url": null, "publisher_name": " Immersive History", "support_website_url": null, "website_url": "https://immersivehistory.com/", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_US
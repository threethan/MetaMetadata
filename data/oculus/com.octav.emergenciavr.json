w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hSuAcz2X4TT6Ijex4bytaON5AMiLajLa98-GMzu62_w&oe=6A47C700"}, {"file_name": "SS_04.png", "id": "539803665211030", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974477_539803668544363_8360156901523379653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vHjnKIA2xBgQ7kNvwG4sB2J&_nc_oc=AdpfE1VJLwHFuQ6cZvW0U1k45PwlC1HsNfK4dD_CZxX4gCzO22gqMlW-qz3iBArXiUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xmtslgPmur5tfF63DKrfObhSiSfnkx018cEr8wJ_ZRg&oe=6A47D67D"}, {"file_name": "SS_02.png", "id": "570345156117440", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031378_570345159450773_6833754845966057782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GtK-lNBHRpkQ7kNvwEjoIGB&_nc_oc=Ado-hL3iQHlBACGG0tWiLzDSuFi9iTiOiE6_y5ubgv_DigLu1517_m0kSHsP2i9J4y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PejVoI-t2RzRTjN94f6sf58o6i2h8lidNFeZHcGb6Kw&oe=6A47B219"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Emergencia VR", "keywords": ["Healthcare", "Hospital", "Doctor", "Medical", "Simulation"], "long_description": "Experience the challenges of emergency medicine firsthand with EMERGENCIA VR. This demo provides a view into the immersive simulation designed to prepare healthcare professionals for critical situations.\nStep into a virtual ER:\nAssess a critical patient: Conduct a virtual examination, gather vital signs, and analyze information to make a diagnosis.\nPerform life-saving procedures: Use your VR headset and controllers to administer treatments and manage the patient's condition.\nPractice your skills: Develop your decision-making abilities and refine your approach to emergency care in a safe, virtual environment.\n\nInterested in learning more?\nThe full version of EMERGENCIA VR offers a wider range of scenarios, advanced medical equipment, and realistic patient interactions for a comprehensive training experience. Contact us at contact@octav.studio to discover how EMERGENCIA VR can be integrated into your medical training program.\n", "short_description": "EMERGENCIA VR throws you into the heart of a virtual ER. Assess patients, perform life-saving procedures, and develop critical decision-making skills in a realistic, risk-free environment. The future of emergency medicine training is here! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20Emergencia%20VR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27092823103696734"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974510_1224992705493007_3929223096849790730_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ys1EcCkcFCEQ7kNvwGYxJED&_nc_oc=AdqXs3T0kg2uv-QlNKORIIOOxYpIZwaRHPV27brSG5VwW4FRqNOetHAfWCDfHNi1Rhk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_E_QG01r0nPQ5f2xX99Ntx41Ch7r4eHef8y7N-rQXp2A&oe=6A47C759"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Emergencia VR", "platform": "ANDROID_6DOF", "context_category": {"context_c
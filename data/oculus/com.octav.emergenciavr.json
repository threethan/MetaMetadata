4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_x-Tet5wY5uH4rqOuY0Tw4YV7KEIcfoVma1SvQvkTTg&oe=6A8979C0"}, {"file_name": "SS_04.png", "id": "539803665211030", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974477_539803668544363_8360156901523379653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G_JbevMvvCgQ7kNvwGRyE37&_nc_oc=AdpYlYDDHDUP68wnTCfSvDIMpMycsyfiE_joxHhIwGiWxjq7GIcWfkVxRD81_YQzHEc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFw78RkZUixMN2Y0n6zhR_gpKJ_dGJXO4eoh2u5v_7lOg&oe=6A89893D"}, {"file_name": "SS_02.png", "id": "570345156117440", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031378_570345159450773_6833754845966057782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fr64CMuKE7kQ7kNvwHf_Keo&_nc_oc=Adr-9Vi9HobmxRVh4HZ9RYV2-WBeh0qGYiuxAFkyQ7kBqU-GjoyGD6xSiVH5WgcwTYQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvZL9p_GhsKbZIx6Uty2f_38zNrBVxlPlkXnTLQJpejw&oe=6A899D19"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Emergencia VR", "keywords": ["Healthcare", "Hospital", "Doctor", "Medical", "Simulation"], "long_description": "Experience the challenges of emergency medicine firsthand with EMERGENCIA VR. This demo provides a view into the immersive simulation designed to prepare healthcare professionals for critical situations.\nStep into a virtual ER:\nAssess a critical patient: Conduct a virtual examination, gather vital signs, and analyze information to make a diagnosis.\nPerform life-saving procedures: Use your VR headset and controllers to administer treatments and manage the patient's condition.\nPractice your skills: Develop your decision-making abilities and refine your approach to emergency care in a safe, virtual environment.\n\nInterested in learning more?\nThe full version of EMERGENCIA VR offers a wider range of scenarios, advanced medical equipment, and realistic patient interactions for a comprehensive training experience. Contact us at contact@octav.studio to discover how EMERGENCIA VR can be integrated into your medical training program.\n", "short_description": "EMERGENCIA VR throws you into the heart of a virtual ER. Assess patients, perform life-saving procedures, and develop critical decision-making skills in a realistic, risk-free environment. The future of emergency medicine training is here! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20Emergencia%20VR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27092823103696734"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974510_1224992705493007_3929223096849790730_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhTsxu-v1JAQ7kNvwGW7M3q&_nc_oc=AdqQKh4L3lzcCztaDyQjoGPzbYOGtsTa0xyloZ-_jbXszFyLiHKFWLApHqvxYX78ENI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAZJHXp6gMtO_NUFLExjeTV-7e1tXDNvwsXVVQn_zr8g&oe=6A897A19"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Emergencia VR", "platform": "ANDROID_6DOF", "context_category": {"context_c
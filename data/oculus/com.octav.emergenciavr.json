w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9JpBN88B2zRsOe-hAlkeSQS7wDJMZ9aFo9hptiByIdWg&oe=6A412F80"}, {"file_name": "SS_04.png", "id": "539803665211030", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974477_539803668544363_8360156901523379653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IYRXi8aT8gQ7kNvwGa1aX4&_nc_oc=Ado8B5eWgaQt3Ub4tEgHUUiX80zqPByE-TC4VhI3MDnDrTHxnJ604l1Y-Nym5R3uozE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8sgeQAUbuhrHRvHUpa7TCZaixlbnmChNpM8pTxKdQVAg&oe=6A413EFD"}, {"file_name": "SS_02.png", "id": "570345156117440", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031378_570345159450773_6833754845966057782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-U-gH1Z9QDQQ7kNvwGlGR3D&_nc_oc=AdrlAY_sr-MfOUNO-ISFPH1iAvxsL3vfjRyPAlEIvdJ-XjSoC302bhi3FtHgREO4Lx0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HHkOS5zYB_iAytWWJwrHTa_HgEsMhwAZs3Xvszl3bGQ&oe=6A411A99"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Emergencia VR", "keywords": ["Healthcare", "Hospital", "Doctor", "Medical", "Simulation"], "long_description": "Experience the challenges of emergency medicine firsthand with EMERGENCIA VR. This demo provides a view into the immersive simulation designed to prepare healthcare professionals for critical situations.\nStep into a virtual ER:\nAssess a critical patient: Conduct a virtual examination, gather vital signs, and analyze information to make a diagnosis.\nPerform life-saving procedures: Use your VR headset and controllers to administer treatments and manage the patient's condition.\nPractice your skills: Develop your decision-making abilities and refine your approach to emergency care in a safe, virtual environment.\n\nInterested in learning more?\nThe full version of EMERGENCIA VR offers a wider range of scenarios, advanced medical equipment, and realistic patient interactions for a comprehensive training experience. Contact us at contact@octav.studio to discover how EMERGENCIA VR can be integrated into your medical training program.\n", "short_description": "EMERGENCIA VR throws you into the heart of a virtual ER. Assess patients, perform life-saving procedures, and develop critical decision-making skills in a realistic, risk-free environment. The future of emergency medicine training is here! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20Emergencia%20VR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27092823103696734"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974510_1224992705493007_3929223096849790730_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mN-Z7BF7FPAQ7kNvwFxTqOy&_nc_oc=Adq3XmK6XyiZ1satqWPGuvibwzZbyzh2ABOaJV6Pn2iYHIs6Uvrd1MLrOd9uSnO3nCI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9yvhVfNdF1vpfC6m-8fVw_kCn2SobRwTq4_kULyb4rBg&oe=6A412FD9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Emergencia VR", "platform": "ANDROID_6DOF", "context_category": {"context_c
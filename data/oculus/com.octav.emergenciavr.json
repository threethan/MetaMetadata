0_Af0Ufvi_6_WFu1WxB6irpLbkRfRArq06tZHRQ12ipAGHkA&oe=69F21580"}, {"file_name": "SS_04.png", "id": "539803665211030", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974477_539803668544363_8360156901523379653_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gk_9DK3oMmEQ7kNvwFA4_Cr&_nc_oc=AdrDKdIeW_yqCHbq_DqraHH2VNxc27GLr4fqGEvHV6R2F-tvU-ELj9CrGKDOCE5IkqE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2IuEIIfmM5Zq3puc4Mww4Lqm2LBKIMfNwMBts4El9MMA&oe=69F1ECBD"}, {"file_name": "SS_02.png", "id": "570345156117440", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031378_570345159450773_6833754845966057782_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b1IA1YbO6DgQ7kNvwHBPiYx&_nc_oc=AdpxM3ysoOem_hcF2T3f66xt6rptw_607P896meAR4cyHRsc8gsBIS1RJ0hskH6BTtE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af13R738SuNoFdcm3CbW_GG5tuJ-1Mi41NWmKUKC9sazpQ&oe=69F20099"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Emergencia VR", "keywords": ["Healthcare", "Hospital", "Doctor", "Medical", "Simulation"], "long_description": "Experience the challenges of emergency medicine firsthand with EMERGENCIA VR. This demo provides a view into the immersive simulation designed to prepare healthcare professionals for critical situations.\nStep into a virtual ER:\nAssess a critical patient: Conduct a virtual examination, gather vital signs, and analyze information to make a diagnosis.\nPerform life-saving procedures: Use your VR headset and controllers to administer treatments and manage the patient's condition.\nPractice your skills: Develop your decision-making abilities and refine your approach to emergency care in a safe, virtual environment.\n\nInterested in learning more?\nThe full version of EMERGENCIA VR offers a wider range of scenarios, advanced medical equipment, and realistic patient interactions for a comprehensive training experience. Contact us at contact@octav.studio to discover how EMERGENCIA VR can be integrated into your medical training program.\n", "short_description": "EMERGENCIA VR throws you into the heart of a virtual ER. Assess patients, perform life-saving procedures, and develop critical decision-making skills in a realistic, risk-free environment. The future of emergency medicine training is here! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://octav.studio/Privacy%20Policy%20for%20Emergencia%20VR.html", "developer_terms_of_service_url": null, "publisher_name": "Octav Studio", "support_website_url": null, "website_url": "https://octav.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27092823103696734"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974510_1224992705493007_3929223096849790730_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_5u9mv1XAYoQ7kNvwHpClBE&_nc_oc=AdqhnEakgT9PbeGVjMvsKd8HLPNYkgp7ttp94ku5TFEukYq1GgXHMulzPGCVmRWg7xQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1-i5xbollNQ9fv7RBlxcx_a3J7W6AddDPpKn3VWy6MWA&oe=69F215D9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Emergencia VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id":
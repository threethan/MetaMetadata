c_ohc=C9b0edcf-rYQ7kNvwGMimdd&_nc_oc=AdoLNrhzff5YkAgbGlcy48aOW_SmmqbvcZ4OJU8w--wmF6iREpAnzKLuj1h9RMTsrlk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQe36hcHACl2YwkxAw6L9RJzn2565nNHhT4vLV31XSPQw&oe=6AF32EA1"}]}, "id": "1901943757840610", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1_2560x1440.png", "id": "2182710483125620", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673759338_2182710486458953_7283906381329804011_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Se8QsgwKQQ7kNvwHSwDqa&_nc_oc=Adq0Y1L0cwx3flNACU5xxKSz3VbKWJ2gmWl9NptwDT5Fen0oS9iixKOgUvd4RirLalI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1KKCGNwniu3-YGDan03pZDP-pik44U6WzRvUMvebYBg&oe=6AF34BC3"}, {"file_name": "screenshot_5_2560x1440.png", "id": "958038146658615", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_958038149991948_397586670255073540_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=34xqVO9aX1AQ7kNvwEFW_Wn&_nc_oc=AdrbO2lbEpBBKVgfAGkNGyWimVSljvuxYcRUaxDXnJyfgkGKLcC-r2QTp8KSdKdaTYc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR12A5dajjPZXm3WpZ9g6DcVbOw3RF2ylhxzHbNjwRQLw&oe=6AF33BAD"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1438870428222440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604347072_1438870434889106_4011278899991919160_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Y6Ws2W3D9UQ7kNvwEOK47N&_nc_oc=AdqC8sWAwURj7va74RVOWg8lD_xvP_jueDsPSu9qX9wjApIG_DBzrgZgDPRDMK-6OU8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvQnGD547n84l-oY16ErcavHjEX13Cc4RbYGup8galZg&oe=6AF3398B"}, {"file_name": "screenshot_3_2560x1440.png", "id": "1641829260878216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604347072_1641829264211549_8499911364637183852_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QP0gFEOTOyQQ7kNvwG9Zz7i&_nc_oc=AdqCxo8dp0Hhbj76Jn10uGdHZ8PxXlGzBXc-iwumgp_gj9rDNSWa59gBo3QypIepcSQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3WATUgM68wGDW-CCpyYB-jts7HFUxuZOfdqUyi4vihA&oe=6AF32779"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1625363782600867", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830441_1625363785934200_6088303651319835066_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etxDWaGBVCMQ7kNvwGqpZH6&_nc_oc=AdqBw6IgffDcKUsynPDyKke1LxF7tf0qJvRFLV2O7Indp-Br27lTjrLJxi42KNjHvtE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWWbglw8LRScXHOW8jMOclTT3xnhPC6O9B4BcfW54Dcg&oe=6AF34C5F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Graffiti 4", "keywords": ["graffiti", "spray", "painting", "art", "sandbox"], "long_description": "Graffiti 4 is a spray painting sandbox in virtual reality. One enormous hall, and every wall in it is yours.\n\nTHE PAINT WAREHOUSE\nA 30 by 60 metre legal paint hall in an old factory, under a sawtooth glass roof that pours sun across the floor all day. Red brick bays down one side, painted concrete bays down the other, three free standing walls you can paint on both faces, and a huge hero wall at the far end. 19 paintable walls in all.\n\nBUILT FROM REAL SURFACES\nEvery wall, column and floor is a real photographed material. Paint soaks into the brick so every mortar line still reads through your piece, and fresh spray catches the window light.\n\nMIDDAY OR GOLDEN HOUR\nOne button on the menu drops the sun, floods the hall with warm light and turns the high bay lamps on. Paint the same wall at both times of day and it is a different picture.\n\nREAL SPRAY PAINT FEEL\nThe spray gets wider the further you stand back. Hold the can still up close and the paint runs. Shake a can to hear it rattle.\n\nSTENCILS A TO Z\nA board of 26 letter stencils plus stars, crowns, bolts, hearts, arrows and NYC. Stick one flat on any wall, spray over it and peel it off.\n\nYOUR TOOLS\n- 8 spray cans and a full colour wheel\n- Skinny, medium and fat caps\n- Take a photo of your wall, saved on your headset\n- Clean one wall or every wall with a fresh coat\n- Six music tracks\n\nGraffiti 4 is a single player, standing experience with smooth walking and snap turning. No account and no internet needed.", "short_description": "Spray paint an entire sunlit warehouse in VR. One huge paint hall under a sawtooth glass roof, with 19 walls of real brick, painted brick and concrete waiting for you. Grab a can, pick any colour, swap caps, tape up letter stencils and watch the paint drip. Drop the sun to golden hour and paint the same wall all over again."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffiti4/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/graffiti4/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1331098333416363"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_2012878833433119_4038780563865535795_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCuiPxA2AmsQ7kNvwFooags&_nc_oc=AdrK9HUSUJTvMOrl2BzFpEWHm4GltMbNNA6vKfsPNpErrILoExpTG8OR6z8EcmysZrc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQbT5LfCrp8KGQ8rZeuBP_5HU-vTRRRG8h
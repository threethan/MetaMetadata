mN-9-3bbGY2kIa43nhulB4g4L9Kmj_ZHXpqpaKVPKdPR3GvOBrie2PcGp8U&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtbbtfyg-QGwiLBu5TtthA0Tz2spE0rnnUYBf6D3JSnw&oe=6AE89C7A"}, {"file_name": "chess screenshot 3 2560x1440.png", "id": "787837117333498", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499623314_787837120666831_7729821160016966471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iJfG_JTwcu0Q7kNvwHRpmUj&_nc_oc=Adq6A8e5DOq_dgfmUKabCJ70LpGTGcINdwQaTFaypV-NvylpHMSqx2c80Zu0tCKEFyU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS32QRqChkZPJrSBFbzzHUhA0Q8cyUMnLyDsVqTe13RWQ&oe=6AE8B20D"}, {"file_name": "chess screenshot 4 2560x1440.png", "id": "2083622009149117", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/654944867_2083622012482450_2505236338889124293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rf9z8vSWuU8Q7kNvwFz-bbc&_nc_oc=AdqtzGeh51QhVJzwCJaTjaoyPgbx1oWtkhPV5KsBbjs7LmUvqFm33GteEhji30QEcog&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9mMnxKm4I7OODP9QuRPYSBjn-BYFe_JtG3wzjy2CbxQ&oe=6AE8BAB0"}, {"file_name": "chess screenshot 5 2560x1440.png", "id": "2311981822629611", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619668_2311981825962944_4746714880216917920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdI8VQ-QjVkQ7kNvwE6Nez0&_nc_oc=AdoKXTZZrchUdlgbyCfUUMzm4zdrhKje9oJZlT9sHNBs5IB4HbmwDBjOAmKxzm40Jxw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMZFZCKNRlESkP6_e__DYyFQLgmaMjQPUCGUSwScia8w&oe=6AE8AD2E"}, {"file_name": "chess screenshot 2 2560x1440.png", "id": "1347645940505043", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619174_1347645943838376_2712618227747767180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HbIcDMZzNAQ7kNvwEFU8Mg&_nc_oc=AdrtPpuB9ORyrKvO9urZ6CRub_qabDfcc6l5HRSV781ALX2uhgj11O3tLtnPrasNMvM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVL26OrBFI-67z_vWTxVt0_u12rMZG2J_rx-17UNZ6Fw&oe=6AE8B893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "chess video cover.png", "id": "1654832269022256", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618910_1654832272355589_5605372163260740678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBKZDQZeg94Q7kNvwHNjZhC&_nc_oc=AdrSX2a1ADS6LFUl3O-FNuDWJbGaZp8ZtWyBEePSjYsl3I2o96MZ3HKYC9YE7GqToiY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgrDqYY7dsB5mWNL5LqpAh0AtamAZ2SnbyBTeFTMSldw&oe=6AE8A035"}, "display_name": "Chess Space", "keywords": ["Lichess", "Strategy", "Multiplayer", "Blitz", "Tactics"], "long_description": "Challenge your friends to the classic strategy board game of Chess. A beautiful mixed-reality rendition of Chess awaits you, with direct hand input and physics-based interaction, so you can play the classic the way you want to play.\n\n{926448820176045}\n\n# \u265f\ufe0f LICHESS integration\nUse your own account to play chess with others in Lichess directly in VR. Quick Pairing of:\n\n- 10+0 Rapid  \n- 10+5 Rapid  \n- 15+10 Rapid  \n- 30+0 Classical  \n\n{1436033288061910}\n\n# \ud83c\udfa8 Customize your experience\nAnd if you're feeling creative, you can use the Boxtree Builder to remix the game to best suit your personal style, with your own custom King, Queen, Rook, Knight, Bishop, and Pawn piece designs.\n\n{2014298275783843}\n\n# \ud83c\udf0c Play your way\nSeamlessly transition between passthrough mixed-reality mode and a fully immersive skybox experience via Table Space's magical skybox marbles. Enjoy the game how you want to for free in Table Space, and let your imagination run wild.\n\n{1901337713825957}\n\n# \u2699\ufe0f Gameplay improvements\nThis latest update also brings powerful gameplay improvements to make your matches smoother and more intuitive:\n\n- See valid moves for selected piece.  \n- Automatic rollback of invalid moves.  \n- Automatic castling to either side when valid.  \n- Automatic check, checkmate, and draw detection for stalemate or insufficient material.  \n- New round cleanup button to instantly reset the game.  \n- Last move highlight so you never miss a move.  \n- Captured pieces are automatically moved to the captured zone.  \n- Turn indicator. \n\n{1065219976668892}\n https://discord.com/invite/nxZZbShGZ2", "short_description": "Play casual or serious chess in mixed reality with full Lichess integration. Use your account to play online with quick pairing for Rapid and Classical games, or challenge friends. Enjoy intuitive hand tracking, physics-based interaction, and smooth gameplay with features like valid move highlights, automatic rules, and turn tracking. Customize your pieces and experience chess your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.boxtree.gg/privacy", "developer_terms_of_service_url": null, "publisher_name": "Boxtree, Inc", "support_website_url": null, "website_url": "https://www.boxtree.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "35984130584566966"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491830822_4232759520309123_9030883972152119720_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDgOsfQlGcUQ7kNvwEw6A96&_nc
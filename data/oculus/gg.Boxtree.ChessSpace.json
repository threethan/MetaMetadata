": "2311981822629611", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499619668_2311981825962944_4746714880216917920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdI8VQ-QjVkQ7kNvwE6Nez0&_nc_oc=AdoKXTZZrchUdlgbyCfUUMzm4zdrhKje9oJZlT9sHNBs5IB4HbmwDBjOAmKxzm40Jxw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMZFZCKNRlESkP6_e__DYyFQLgmaMjQPUCGUSwScia8w&oe=6AE8AD2E"}, {"file_name": "chess screenshot 2 2560x1440.png", "id": "1347645940505043", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619174_1347645943838376_2712618227747767180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6HbIcDMZzNAQ7kNvwEFU8Mg&_nc_oc=AdrtPpuB9ORyrKvO9urZ6CRub_qabDfcc6l5HRSV781ALX2uhgj11O3tLtnPrasNMvM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVL26OrBFI-67z_vWTxVt0_u12rMZG2J_rx-17UNZ6Fw&oe=6AE8B893"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "chess video cover.png", "id": "1654832269022256", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499618910_1654832272355589_5605372163260740678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBKZDQZeg94Q7kNvwHNjZhC&_nc_oc=AdrSX2a1ADS6LFUl3O-FNuDWJbGaZp8ZtWyBEePSjYsl3I2o96MZ3HKYC9YE7GqToiY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgrDqYY7dsB5mWNL5LqpAh0AtamAZ2SnbyBTeFTMSldw&oe=6AE8A035"}, "display_name": "Chess Space", "keywords": ["Lichess", "Strategy", "Multiplayer", "Blitz", "Tactics"], "long_description": "Challenge your friends to the classic strategy board game of Chess. A beautiful mixed-reality rendition of Chess awaits you, with direct hand input and physics-based interaction, so you can play the classic the way you want to play.\n\n{926448820176045}\n\n# \u265f\ufe0f LICHESS integration\nUse your own account to play chess with others in Lichess directly in VR. Quick Pairing of:\n\n- 10+0 Rapid  \n- 10+5 Rapid  \n- 15+10 Rapid  \n- 30+0 Classical  \n\n{1436033288061910}\n\n# \ud83c\udfa8 Customize your experience\nAnd if you're feeling creative, you can use the Boxtree Builder to remix the game to best suit your personal style, with your own custom King, Queen, Rook, Knight, Bishop, and Pawn piece designs.\n\n{2014298275783843}\n\n# \ud83c\udf0c Play your way\nSeamlessly transition between passthrough mixed-reality mode and a fully immersive skybox experience via Table Space's magical skybox marbles. Enjoy the game how you want to for free in Table Space, and let your imagination run wild.\n\n{1901337713825957}\n\n# \u2699\ufe0f Gameplay improvements\nThis latest update also brings powerful gameplay improvements to make your matches smoother and more intuitive:\n\n- See valid moves for selected piece.  \n- Automatic rollback of invalid moves.  \n- Automatic castling to either side when valid.  \n- Automatic check, checkmate, and draw detection for stalemate or insufficient material.  \n- New round cleanup button to instantly reset the game.  \n- Last move highlight so you never miss a move.  \n- Captured pieces are automatically moved to the captured zone.  \n- Turn indicator. \n\n{1065219976668892}\n https://discord.com/invite/nxZZbShGZ2", "short_description": "Play casual or serious chess in mixed reality with full Lichess integration. Use your account to play online with quick pairing for Rapid and Classical games, or challenge friends. Enjoy intuitive hand tracking, physics-based interaction, and smooth gameplay with features like valid move highlights, automatic rules, and turn tracking. Customize your pieces and experience chess your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.boxtree.gg/privacy", "developer_terms_of_service_url": null, "publisher_name": "Boxtree, Inc", "support_website_url": null, "website_url": "https://www.boxtree.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "34379947564985284"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1380150134334331"}, {"status": "PUBLISHED", "id": "1593576835612667"}, {"status": "PUBLISHED", "id": "1373869564163675"}, {"status": "PUBLISHED", "id": "1657473218840260"}, {"status": "PUBLISHED", "id": "1460737452519310"}, {"status": "PUBLISHED", "id": "1632359014724680"}]}, "baseline_offer": {"id": "1460737452519310"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1380150134334331"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "38684187101227954", "version": "0.66"}, "id": "1257771932534358", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34379947524985288", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38684187101227954"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1257771932534358"}]}, "change_log": "Fixed:\n1. Added new \"Fancy\" Chess Set. Can select chess set on lobby.\n2. Dropping the chess pieces to the side of the board, or the capture grids no longer bricks ongoing games.\n3. Promoting pieces in Lichess mode no longer bricks the game.\n4. Pieces now instantly snap to the top of the chess board on release, if released on top of a valid move cell will instantly attach to it, when released on an invalid move cell will be rolled back to the original cell the move started from.\n5. New visualization for move aid with a  laser\n6. Searching for games on Lichess now will always show whether a match is found and start the match right away.\n7. Fixed issue with UI not telling you if the game was Rated on Lichess.\n8. Other Misc fixes for castling, en passant captures, and promotions.", "created_date": 1790722195, "id": "38684187101227954", "version": "0.66", "version_code": 190, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34379947524985288", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38684187101227954"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1790710487, "id": "38681326634847334", "version": "0.66", "version_code": 189, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34379947524985288", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38684187101227954"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1257771932534358"}]}, "change_log": "Fix bug with piece capturing on multiplayer match. Added better controller support. Localization to 8 languages", "created_date": 1787772838, "id": "37825658843747455", "version": "0.64", "version_code": 188, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34379947524985288", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38684187101227954"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1787700532, "id": "37804462589200414", "version": "0.64", "version_code": 187, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "34379947524985288", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "38684187101227954"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1257771932534358"}]}, "change_log": "Misc bug fixes", "created_date": 1781050648, "id": "36098922179754472", "version": "0.62", "version_code": 183, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
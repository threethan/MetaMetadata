_ICON", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618817_959166370396555_745808748839571541_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-ayC51yo3wQ7kNvwG-iLKD&_nc_oc=Adok0uPoiixYw9ddpSETBr_SFfXU_8Q--MPMz1LrhsWKPmnzMvG6ix3OdGtYb_KDiOw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCR7WgyCnUBZdJB84xO1szaOz62MfP25vFX9MbW5BRR4g&oe=6A6DDA42"}]}, "id": "950279934216111", "locale": "en_US", "screenshots": [{"file_name": "chess screenshot 1 2560x1440.png", "id": "1287108649982772", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618442_1287108653316105_2995185149358192911_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7S8qiHJwJgsQ7kNvwGjSHaI&_nc_oc=AdruaXnFcUPeZTAux7vdN4e4SlXBqTpt2m087U5BAorBfcws_x9AwBDWnaOfA-y2WMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBXjj06pTSHhfX1Y7Qlrg_vDl-VjUIzFHIkKgxfX1kJBw&oe=6A6E00FA"}, {"file_name": "chess screenshot 3 2560x1440.png", "id": "787837117333498", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623314_787837120666831_7729821160016966471_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLynOh5oWT0Q7kNvwE9j0Qo&_nc_oc=AdrAjmLj_OzfGIKxboDkPqJHfOHp-6NPFxkZWMil6THRwzFYwkxG5voNl43YOF4DS9Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC23Vl1p3A_uMzl__L-HAa6gCMs4weT3MEETXqT7oapOg&oe=6A6DDE4D"}, {"file_name": "chess screenshot 4 2560x1440.png", "id": "2083622009149117", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/654944867_2083622012482450_2505236338889124293_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmNpv-HzGfIQ7kNvwE7A7xQ&_nc_oc=AdqDScNykSLL5PWWMDBSpX7F7BZpAInxRB3J9zjKln3x-AISdVXbl_HNP7Od5d-OyXk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUBvKIktG2CQZqpCL94PrFlltOsZjXa7hpdwaAzRm_CA&oe=6A6DE6F0"}, {"file_name": "chess screenshot 5 2560x1440.png", "id": "2311981822629611", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619668_2311981825962944_4746714880216917920_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU5EIQ0oO9UQ7kNvwGDqomo&_nc_oc=AdrXrqZdYvlRk2OsCTvJSBY2vqmxoTnDAHTA24BhmhLGMY2Ek-V-trp-pSx2R-5jwMk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9ZzSYfeq6kDCvwYh-Dql9DeFT5W1w-y-5mtSna4HrwQ&oe=6A6DD96E"}, {"file_name": "chess screenshot 2 2560x1440.png", "id": "1347645940505043", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619174_1347645943838376_2712618227747767180_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVVHMnhZh8AQ7kNvwHX1mWQ&_nc_oc=AdqZnPuqX2BiACIi52j2tgZ18dB2GqqDKlHEXWVzpdwQkPyrSNLOES6QCkrRNsS7E_k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6liKU143E8H63m8lh2-RzE17Oz9nUE0t7bDl-ET787g&oe=6A6DE4D3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "chess video cover.png", "id": "1654832269022256", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618910_1654832272355589_5605372163260740678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zr0AS_n4gYQ7kNvwGy7L1W&_nc_oc=Adp3cyhst8Cpzc250T_HSXOM_juhcBG8dr6Gq1Jcnvwk-arzEx0fCpKg2d2lgtXKEBY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDl1-7Epgu_neM17lvpt1d0-sKm_iPOG10DHkbRmgEz5w&oe=6A6E04B5"}, "display_name": "Chess Space", "keywords": ["Lichess", "Strategy", "Multiplayer", "Blitz", "Tactics"], "long_description": "Challenge your friends to the classic strategy board game of Chess. A beautiful mixed-reality rendition of Chess awaits you, with direct hand input and physics-based interaction, so you can play the classic the way you want to play.\n\n{926448820176045}\n\n# \u265f\ufe0f LICHESS integration\nUse your own account to play chess with others in Lichess directly in VR. Quick Pairing of:\n\n- 10+0 Rapid  \n- 10+5 Rapid  \n- 15+10 Rapid  \n- 30+0 Classical  \n\n{1436033288061910}\n\n# \ud83c\udfa8 Customize your experience\nAnd if you're feeling creative, you can use the Boxtree Builder to remix the game to best suit your personal style, with your own custom King, Queen, Rook, Knight, Bishop, and Pawn piece designs.\n\n{2014298275783843}\n\n# \ud83c\udf0c Play your way\nSeamlessly transition between passthrough mixed-reality mode and a fully immersive skybox experience via Table Space's magical skybox marbles. Enjoy the game how you want to for free in Table Space, and let your imagination run wild.\n\n{1901337713825957}\n\n# \u2699\ufe0f Gameplay improvements\nThis latest update also brings powerful gameplay improvements to make your matches smoother and more intuitive:\n\n- See valid moves for selected piece.  \n- Automatic rollback of invalid moves.  \n- Automatic castling to either side when valid.  \n- Automatic check, checkmate, and draw detection for stalemate or insufficient material.  \n- New round cleanup button to instantly reset the game.  \n- Last move highlight so you never miss a move.  \n- Captured pieces are automatically moved to the captured zone.  \n- Turn indicator. \n\n{1065219976668892}\n https://discord.com/invite/nxZZbShGZ2", "short_description": "Play casual or serious chess in mixed reality with full Lichess integration. Use your account to play online with quick pairing for Rapid and Classical games, or challenge friends. Enjoy intuitive hand tracking, physics-based interaction, and smooth gameplay with features like valid move highlights, automatic rules, and turn tracking. Customize your pieces and experience chess your way."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.boxtree.gg/privacy", "developer_terms_of_service_url": null, "publisher_name": "Boxtree, Inc", "support_website_url": null, "website_url": "https://www.boxtree.gg/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [
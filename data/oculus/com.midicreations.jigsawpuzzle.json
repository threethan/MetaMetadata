s=7f20f&oh=00_AQKNXHkX1444sUeH2uUm9PIcNnPhGDJYi-csOm4YjC9D_Q&oe=6A9C3AD1"}, "display_name": "Jigsaw Puzzle Customizable", "keywords": ["Jigsaw", "Puzzle", "Customizable", "Riddle", "Challenge"], "long_description": "A Jigsaw Puzzle is a tiling puzzle that requires the assembly of irregularly shaped interlocking and mosaicked pieces. Each piece has a portion of a picture, which is completed by solving the puzzle.\n\nThis VR Game presents a 10 x 7 = 70 pieces Jigsaw Puzzle with the posibility to choose between 20 default images as templates. To customize your Puzzle you can add you own custom images on the directory:\n\nAndroid\\data\\com.midicreations.jigsawpuzzle\\files\n\nYour custom images will appear automcatically on the Main Menu as an option to choose from as template, the ideal Aspect Ratio of the images is 10:7, for example images of size: 1000x700 pixels would be ideal.\n\nThe game is presented on a elegant library scenario, and the time you took to solve the Puzzle is measured to update your own score of best time (Minimum time to solve the puzzle).", "short_description": "A jigsaw puzzle is a tiling puzzle that requires the assembly of irregularly shaped interlocking and mosaicked pieces. Each piece has a portion of a picture, which is completed by solving the puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/1.html?name=Jigsaw+Puzzle+Customizable", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", 
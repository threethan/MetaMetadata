216131_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMYAc_3_7P4Q7kNvwGV4qx9&_nc_oc=Adqxzd4tDnH4ftEEfBIzX4pw3j8UFCphNEJqU6u01bxL8x9aTbKbIZTOLcC7Ufw1NiU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXc7f1l4W5euoYLpWdKRTqrC7IPqw0sV47Y43iK8lgKiw&oe=6B0EF63D"}, {"file_name": "ScreenShot5.png", "id": "2111422303088730", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499300541_2111422306422063_6826366603124594210_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Net1xkTtwTMQ7kNvwFfuqNc&_nc_oc=Adr191Uerxov2LftbzO7qz1Ulk8K6WjLdXr2EV8xl4hT3P5qoaQO8EMouZmXrZRnxaU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX4PPPsnyheFcFa8zP2KID7veVlxNW5Q99Bqwg9eGn0JA&oe=6B0F13F4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape2.png", "id": "2174284356447643", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604310912_2174284359780976_2381955425695884834_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kxzxqVdvxNEQ7kNvwFWAiOi&_nc_oc=Adqt06aoMMw7qPjm6bz8h0WdK98n5Dk3ejpIIY6Hwo3-mq-QrQAnWPV2UD3SkMbDd2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUeIYOTq6Q3a8pIB078p8L8JauLNCmk73is6ulJ2TgDpw&oe=6B0EED51"}, "display_name": "Jigsaw Puzzle Customizable", "keywords": ["Jigsaw", "Puzzle", "Customizable", "Riddle", "Challenge"], "long_description": "A Jigsaw Puzzle is a tiling puzzle that requires the assembly of irregularly shaped interlocking and mosaicked pieces. Each piece has a portion of a picture, which is completed by solving the puzzle.\n\nThis VR Game presents a 10 x 7 = 70 pieces Jigsaw Puzzle with the posibility to choose between 20 default image templates and you can also add you own custom images on the directory:\n\nAndroid\\data\\com.midicreations.jigsawpuzzle\\files\n\nAnd will appear automcatically on the Main Menu as a template to choose from as a template.\n\nThe game is presented on a elegant library scenario, and the time you took to solve the Puzzle is measured to update your own score of best time (Minimum time to solve the puzzle).", "short_description": "A jigsaw puzzle is a tiling puzzle that requires the assembly of irregularly shaped interlocking and mosaicked pieces. Each piece has a portion of a picture, which is completed by solving the puzzle."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/1.html?name=Jigsaw+Puzzle+Customizable", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "3269071729943008"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1667362057814097"}]}, "baseline_offer": {"id": "1667362057814097"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1782155760, "status": "PUBLISHED", "id": "1667362057814097"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "3287517871431727", "version": "1.04"}, "id": "1339660874255657", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "Android
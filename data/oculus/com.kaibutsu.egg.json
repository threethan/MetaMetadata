at=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SGebge1N7bMQ7kNvwGLU61O&_nc_oc=AdodM45VA2k3lIDOt1kMdTf3_cBIf1sfJcdxn-PycFRoXLYJFcQC40X-cJGOhePxYyU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmCYvmrtkNKykMW0hMYv0Ahl9bzVXBZOxfDBF61qccZQ&oe=6B0858B0"}, {"file_name": "633521481_26109692071983031_7683146145853069992_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "1242769751330968", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499618093_1242769754664301_593469667026919585_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XH4PJ9MnkZUQ7kNvwHhgZC1&_nc_oc=Adr3EVIGNO2eyrIMypFY7d5AOXLVvVHfuB-aq7V4NyeCl9fpzEdLTP8xEU_crRuiWdU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvNZZBb_9hYS8uRoWxOByZKdKJscRZeHEVm4f4dhPDzg&oe=6B084D1D"}, {"file_name": "633192051_25588332330862913_8790559263487048158_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "1219160820404378", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499618440_1219160823737711_3701366384816652718_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IPI308HMkn8Q7kNvwGklmUB&_nc_oc=AdqvzmLyVvHrEEyzJLj1agnJ5GO4wz_W-_YX296WaPxD5RW0LX0F5u3EyNV9IuS-h0o&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST8SzhSGJZNbpIQL7RnOixUePdZeIGNs_kHRcZ4TQUCA&oe=6B085E95"}, {"file_name": "633235117_34888736990725843_4420807181196159333_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "2296616420863363", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620921_2296616424196696_6221667867951282572_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAjt6OzCbyAQ7kNvwHwZB6H&_nc_oc=Adp56OtukiqDcrmhyspM-mAWFnneO58Op30_LLbuQZVJmgj4J91Xn2dz-DvsLP_u4EI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSR4_aBlgnDFI-ZvMynpUAOm9b8fPLfQRgpXEopL5gIDg&oe=6B084467"}, {"file_name": "633928779_25962393286690418_3828834448289551711_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "778256761389067", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499308307_778256768055733_2979951718811995022_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpmS2_DIDbMQ7kNvwHDY3_x&_nc_oc=AdobJx8EaLMH12GYxNaISBwbSBsdkWv0PAgq49ZGhWqzUOzs-hP7JeapgHttjoFTlqU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSG2_YhDQkSg-XeK6688FVGkewzp354yDUoFkZ7X9tUg&oe=6B084956"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kaibutsu Baseball: Egg", "keywords": ["baseball"], "long_description": "# Turn 100 Practice Swings into 100 Real At-Bats\n\nKaibutsu Baseball: Egg is a VR batting training app that lets you experience game-level pitching.\n\n## Problems We Solve\n\n- You practice swings but can't replicate them in games\n- No access to game-level pitching for practice\n- You keep swinging at balls outside the zone\n- You hit well in practice but struggle in games\n\nRegular dry swings can't train your \"see and react\" instincts. With this app, you can watch real pitch trajectories and practice laying off bad pitches.\n\n## Get Started in 3 Steps\n\n### 1. Create Pitches on the Web\nSet velocity, spin rate, spin axis, and release angle freely. Preview trajectories and locations before training.\n\n### 2. Select from Your Pitch List in VR\nYour created pitches appear as a list in VR. Just tap to select.\n\n### 3. Experience Unlimited Reps\nTrain effectively with options like random pitch sequences, left-handed pitcher mode, and pitch data display.\n\n## Scientifically Proven Effectiveness\n\nResearch on college baseball players showed that 2 months of VR training reduced strikeouts and significantly improved batting average and OPS. Another study found that 100% of participants felt improvement.\n\n## Pricing\n\n$2.99/month for unlimited access to game-level pitching.\n\n*Price may vary due to exchange rates or platform policies", "short_description": "Practice laying off bad pitches\u2014something dry swings can't do.\n\nKaibutsu Baseball: Egg is a VR batting training app for game-level pitching.\n\n\u25a0 Beyond Dry Swings\nTrain your \"see and react\" instincts. Practice recognizing balls and holding your swing.\n\n\u25a0 Create Any Pitch\nSet velocity, spin rate, axis, and release angle. Preview on web, experience in VR.\n\n\u25a0 Unlimited Reps\nRandom sequences, left-handed pitchers, and more. $5/month for unlimited training.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kaibutsu.co.jp/products/training/baseball-egg/privacy", "developer_terms_of_service_url": "https://kaibutsu.co.jp/products/training/baseball-egg/tos", "publisher_name": "Kaibutsu Co., Ltd.", "support_website_url": "https://kaibutsu.co.jp/support", "website_url": "https://kaibutsu.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25730706516594298"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620921_1557352852207575_470537493381683295_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDnfbcENOfMQ7kNvwHG7ncU&_nc_oc=Adrh60dZQmG963twM-Un1CEVr5WAMXgGKOYVCQLJ3cThHT6FhCpb_ZJRk9oFDGHahi4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQokrgh415gcNBdlhMmWq7x9E-EyCPuLF4QaPoU8gBNTA&oe=6B085BE7"}, "is_conce
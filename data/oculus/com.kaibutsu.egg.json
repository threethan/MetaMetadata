?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixfspS8wPqEQ7kNvwGXD7tQ&_nc_oc=Adn8yOyA3V0A4skdx0HxiYAhUBSD2IIjLP3FBQb3lhuDkjzc4NpALKzWGtK3ZXAhCAA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwzv4tyK3Kd7pEG-RPRAgTnfuqC7KOcyI6786sL_fyI1w&oe=69BA94F0"}, {"file_name": "633521481_26109692071983031_7683146145853069992_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "1242769751330968", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618093_1242769754664301_593469667026919585_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1epGISr3WxkQ7kNvwHicEMC&_nc_oc=AdkSjqpEtK0YLXD70lwuYHmKu3ggzASbkSP7WNjSb7pFivhzNAnh0EOgeH2xlIjSYS0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFcsFfir0f6MuHjcHhr50qtI6QPYzDewpP56PEnMrqsg&oe=69BA895D"}, {"file_name": "633192051_25588332330862913_8790559263487048158_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "1219160820404378", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618440_1219160823737711_3701366384816652718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6mul0_9-N3cQ7kNvwHS7Yzp&_nc_oc=Adl65mU5ezDX6DDQfJI6SwdBbSu3-EBJzm_H-_cCrGm_cZLeosUU0sqOe83-Ml3hHSs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwV9R4-9h9VLmX7oxV_L2Da6QVspIo0_M_HympBJEjgPA&oe=69BA9AD5"}, {"file_name": "633235117_34888736990725843_4420807181196159333_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "2296616420863363", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620921_2296616424196696_6221667867951282572_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpZaKtaTSC0Q7kNvwG9zrcm&_nc_oc=Adk6jFFisTYt9WXh1KAKSo_jSvPg0fo08OjCqzF0QLJiib2Fmg0T-fmef2C6hhv5N3I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwaSp0gHbPInDLvmBgKpEpFOppSkyTDB-ZgYQYGQ1SI0A&oe=69BAB8E7"}, {"file_name": "633928779_25962393286690418_3828834448289551711_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "778256761389067", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499308307_778256768055733_2979951718811995022_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpjSQ9n5PCsQ7kNvwGEmdEy&_nc_oc=AdmZ-BvFR1L3w9ptFppK_MyuSjwPzHkdKEyXAUrTiW6cNjkeVMSjMvw_YlfIgsUOWLc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzhPbu-m-v3tfEl9sTYR0PKPu16eAy0enIORgnzvdgshQ&oe=69BA8596"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kaibutsu Baseball: Egg", "keywords": ["baseball"], "long_description": "# Turn 100 Practice Swings into 100 Real At-Bats\n\nKaibutsu Baseball: Egg is a VR batting training app that lets you experience game-level pitching.\n\n## Problems We Solve\n\n- You practice swings but can't replicate them in games\n- No access to game-level pitching for practice\n- You keep swinging at balls outside the zone\n- You hit well in practice but struggle in games\n\nRegular dry swings can't train your \"see and react\" instincts. With this app, you can watch real pitch trajectories and practice laying off bad pitches.\n\n## Get Started in 3 Steps\n\n### 1. Create Pitches on the Web\nSet velocity, spin rate, spin axis, and release angle freely. Preview trajectories and locations before training.\n\n### 2. Select from Your Pitch List in VR\nYour created pitches appear as a list in VR. Just tap to select.\n\n### 3. Experience Unlimited Reps\nTrain effectively with options like random pitch sequences, left-handed pitcher mode, and pitch data display.\n\n## Scientifically Proven Effectiveness\n\nResearch on college baseball players showed that 2 months of VR training reduced strikeouts and significantly improved batting average and OPS. Another study found that 100% of participants felt improvement.\n\n## Pricing\n\n$2.99/month for unlimited access to game-level pitching.\n\n*Price may vary due to exchange rates or platform policies", "short_description": "Practice laying off bad pitches\u2014something dry swings can't do.\n\nKaibutsu Baseball: Egg is a VR batting training app for game-level pitching.\n\n\u25a0 Beyond Dry Swings\nTrain your \"see and react\" instincts. Practice recognizing balls and holding your swing.\n\n\u25a0 Create Any Pitch\nSet velocity, spin rate, axis, and release angle. Preview on web, experience in VR.\n\n\u25a0 Unlimited Reps\nRandom sequences, left-handed pitchers, and more. $5/month for unlimited training.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kaibutsu.co.jp/products/training/baseball-egg/privacy", "developer_terms_of_service_url": "https://kaibutsu.co.jp/products/training/baseball-egg/tos", "publisher_name": "Kaibutsu Co., Ltd.", "support_website_url": "https://kaibutsu.co.jp/support", "website_url": "https://kaibutsu.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25730706516594298"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1795329571170769"}]}, "baseline_offer": {"id": "1795329571170769"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1772074800, "status": "PUBLISHED", "id": "1795329571170769"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25721217484209868", "version": "2026.02.15"}, "id": "1456966349079104", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary",
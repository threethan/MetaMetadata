at=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hj4pH_R1OjoQ7kNvwH_f6vR&_nc_oc=AdrW2Zf_RRpVVXR-e7f60imsX3345tYmOooT2K1zMf7UB08cnPuo5pDpVMzqe5q2I-4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwPDir3Xzu-5dGSfqUHYYPrTgwucPTtbSVoIC_ULcqSg&oe=6B046430"}, {"file_name": "633521481_26109692071983031_7683146145853069992_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "1242769751330968", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_1242769754664301_593469667026919585_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0Z4IjyA0B0Q7kNvwGMCZEe&_nc_oc=AdrhMJXSYUboc5xuBtNWjCb8CFZxtnix-cEU39DCs1CBtaNk0YMOoUct0UqKwoZ68S4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKwgfOF1m5fVq4AK24A7uS2gbNNi-z07wcvX_0FYniAg&oe=6B04589D"}, {"file_name": "633192051_25588332330862913_8790559263487048158_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "1219160820404378", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618440_1219160823737711_3701366384816652718_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9XRG4qS3YR0Q7kNvwFrbupx&_nc_oc=Adr7JARaqoE7vMjX8N69r3NcoBgtNmOwu9Ws-14JnsyS0PIEGOfB7WwknyXwYnApTL0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRmUIMT4kW5mKKkEwiU1mSllOAWb-IXqePeQa278kpIg&oe=6B046A15"}, {"file_name": "633235117_34888736990725843_4420807181196159333_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "2296616420863363", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620921_2296616424196696_6221667867951282572_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zP3l4LkK2noQ7kNvwGvqEGE&_nc_oc=AdpJr6QlNHU5I-ZokuAqLKYkoqKJoo5gJ5LTPY45JYwzednLJv3WERXc7_tsxuES3J0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0cE_W99wofOLDKpmUqN4UzHhugenYOaSbNKrtsOfIlQ&oe=6B048827"}, {"file_name": "633928779_25962393286690418_3828834448289551711_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "778256761389067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_778256768055733_2979951718811995022_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tqCFpI7h1tgQ7kNvwG61rPr&_nc_oc=AdqO-Kg7XAhIqyTEJ3JCYE_iTtEG97suWEjz3-lAaV9NaDSS38e_X0j0JLxGrxrIES0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQkLX36fW_A3DIaz9G5DsbI-dECMGoU5khg9ZE2E9_wQ&oe=6B0454D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kaibutsu Baseball: Egg", "keywords": ["baseball"], "long_description": "# Turn 100 Practice Swings into 100 Real At-Bats\n\nKaibutsu Baseball: Egg is a VR batting training app that lets you experience game-level pitching.\n\n## Problems We Solve\n\n- You practice swings but can't replicate them in games\n- No access to game-level pitching for practice\n- You keep swinging at balls outside the zone\n- You hit well in practice but struggle in games\n\nRegular dry swings can't train your \"see and react\" instincts. With this app, you can watch real pitch trajectories and practice laying off bad pitches.\n\n## Get Started in 3 Steps\n\n### 1. Create Pitches on the Web\nSet velocity, spin rate, spin axis, and release angle freely. Preview trajectories and locations before training.\n\n### 2. Select from Your Pitch List in VR\nYour created pitches appear as a list in VR. Just tap to select.\n\n### 3. Experience Unlimited Reps\nTrain effectively with options like random pitch sequences, left-handed pitcher mode, and pitch data display.\n\n## Scientifically Proven Effectiveness\n\nResearch on college baseball players showed that 2 months of VR training reduced strikeouts and significantly improved batting average and OPS. Another study found that 100% of participants felt improvement.\n\n## Pricing\n\n$2.99/month for unlimited access to game-level pitching.\n\n*Price may vary due to exchange rates or platform policies", "short_description": "Practice laying off bad pitches\u2014something dry swings can't do.\n\nKaibutsu Baseball: Egg is a VR batting training app for game-level pitching.\n\n\u25a0 Beyond Dry Swings\nTrain your \"see and react\" instincts. Practice recognizing balls and holding your swing.\n\n\u25a0 Create Any Pitch\nSet velocity, spin rate, axis, and release angle. Preview on web, experience in VR.\n\n\u25a0 Unlimited Reps\nRandom sequences, left-handed pitchers, and more. $5/month for unlimited training.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kaibutsu.co.jp/products/training/baseball-egg/privacy", "developer_terms_of_service_url": "https://kaibutsu.co.jp/products/training/baseball-egg/tos", "publisher_name": "Kaibutsu Co., Ltd.", "support_website_url": "https://kaibutsu.co.jp/support", "website_url": "https://kaibutsu.co.jp/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "810139357995560"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["ja"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25730706516594298"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_1557352852207575_470537493381683295_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7jdvn1sXOgQ7kNvwEBZysH&_nc_oc=AdpGs3RiDeP3JNhvMCF_LDj-i61UyCIcQQ7goiO2MvP7AKRDu3nDeFO8m7C38J2jj3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGFEy7Fs88f1MbXC-tAeiQKL0aE4HOn3KFiQW58kiBNA&oe=6B046767"}, "is_conce
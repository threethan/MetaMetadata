46145853069992_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "1242769751330968", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_1242769754664301_593469667026919585_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhIvqB78MocQ7kNvwHhtaGK&_nc_oc=Ado-6b1tUpMO2p7cKwVJK1TQjsIGPkuSH1W3hzReLHjNk-k9FapPvrXj5Hqt8sZ6rik&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKNGq3O4ZVmEvVJNTbOgmfUpqcbTJsEiYq5o9OWA9rTA&oe=6A5E3B9D"}, {"file_name": "633192051_25588332330862913_8790559263487048158_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "1219160820404378", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618440_1219160823737711_3701366384816652718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3UBFYMhFDgQ7kNvwFIe-3K&_nc_oc=AdqhWvhoFmYzwGvIUteYv-dIzMeA1nGdMtOZP4iquA-r9vH3QwUrHQIB7lc4AA21t98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmISD-tCNFXH0gtjCnszj5H3G56EJBfUZs-h8UhbgqJw&oe=6A5E14D5"}, {"file_name": "633235117_34888736990725843_4420807181196159333_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "2296616420863363", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_2296616424196696_6221667867951282572_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PscXoikO_-MQ7kNvwEtM_0t&_nc_oc=Ado5-lwRxAfPZqnwy_0ApHGtPlrf_qM_1t3ZRARkOWBc8GlJD3thHUj1kL6etc2MybY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5XfU4Z8myY5RXkNLDwTjkTrxk61T5v1Nnf53iuXy9kw&oe=6A5E32E7"}, {"file_name": "633928779_25962393286690418_3828834448289551711_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "778256761389067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_778256768055733_2979951718811995022_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3MyvYwkJUgQ7kNvwG30MqU&_nc_oc=AdoiuxVS7-0kRlwRv0_IygN7U3w47D7YY21YTvuW11WIl9Sm3SoWg_XdqY_oe9YDiek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxFxyHxe03H_GVjjdZA8OGXvF_xhsUw3UuM22aQeJ9Qw&oe=6A5E37D6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kaibutsu Baseball: Egg", "keywords": ["baseball"], "long_description": "# Turn 100 Practice Swings into 100 Real At-Bats\n\nKaibutsu Baseball: Egg is a VR batting training app that lets you experience game-level pitching.\n\n## Problems We Solve\n\n- You practice swings but can't replicate them in games\n- No access to game-level pitching for practice\n- You keep swinging at balls outside the zone\n- You hit well in practice but struggle in games\n\nRegular dry swings can't train your \"see and react\" instincts. With this app, you can watch real pitch trajectories and practice laying off bad pitches.\n\n## Get Started in 3 Steps\n\n### 1. Create Pitches on the Web\nSet velocity, spin rate, spin axis, and release angle freely. Preview trajectories and locations before training.\n\n### 2. Select from Your Pitch List in VR\nYour created pitches appear as a list in VR. Just tap to select.\n\n### 3. Experience Unlimited Reps\nTrain effectively with options like random pitch sequences, left-handed pitcher mode, and pitch data display.\n\n## Scientifically Proven Effectiveness\n\nResearch on college baseball players showed that 2 months of VR training reduced strikeouts and significantly improved batting average and OPS. Another study found that 100% of participants felt improvement.\n\n## Pricing\n\n$2.99/month for unlimited access to game-level pitching.\n\n*Price may vary due to exchange rates or platform policies", "short_description": "Practice laying off bad pitches\u2014something dry swings can't do.\n\nKaibutsu Baseball: Egg is a VR batting training app for game-level pitching.\n\n\u25a0 Beyond Dry Swings\nTrain your \"see and react\" instincts. Practice recognizing balls and holding your swing.\n\n\u25a0 Create Any Pitch\nSet velocity, spin rate, axis, and release angle. Preview on web, experience in VR.\n\n\u25a0 Unlimited Reps\nRandom sequences, left-handed pitchers, and more. $5/month for unlimited training.\n"}]}
46145853069992_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "1242769751330968", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618093_1242769754664301_593469667026919585_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nj1VTAuHoukQ7kNvwErvHuj&_nc_oc=Adpi310C7NJNvDzMtVHxmW4loWv9EhjChbmRdk6MNdBIeTmGlNqOdbN4ZSoFFrQJjSI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCGkfH4QPHLUYEJDQEsp0Qg5YCPhqaI1edu1y1BhPWhjA&oe=6A49239D"}, {"file_name": "633192051_25588332330862913_8790559263487048158_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "1219160820404378", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618440_1219160823737711_3701366384816652718_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nlAmSDqVr0Q7kNvwF-P0if&_nc_oc=AdpHz4l_24Trigq_ZqGF06-CySiY5ZYYdrY8_D4TcW_2RjwRYWlosxBaSfzor0mVX0I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgkaruoPAciFyXlsfAair-nRKTQFhegnxe6esnussVhA&oe=6A48FCD5"}, {"file_name": "633235117_34888736990725843_4420807181196159333_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "2296616420863363", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620921_2296616424196696_6221667867951282572_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOIc8dnIUgQQ7kNvwHgnhFB&_nc_oc=AdroqCNgsqROQZAks6nBfs5XI9s5pEThPfOq2cT3Te_gOa5lLbxOx1JcoFaFacoI4Ss&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqCueKQW7qSoc35KSIwelbvkuasVgCXG8XDAFqOj-S1Q&oe=6A491AE7"}, {"file_name": "633928779_25962393286690418_3828834448289551711_n (\u30ab\u30b9\u30bf\u30e0).png", "id": "778256761389067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499308307_778256768055733_2979951718811995022_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xq3CNB0BzQMQ7kNvwHFc1Sz&_nc_oc=Adp7gbJ2F-2MLOgCgcDleuZ4uuyOTK8qLpGjdySOmnfRacyuhLSjv-mXxkWkoyJQk4I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALglzAzZmyijPs79zF6SA-q7lCNhloDHf4zLKGBjCIpw&oe=6A491FD6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Kaibutsu Baseball: Egg", "keywords": ["baseball"], "long_description": "# Turn 100 Practice Swings into 100 Real At-Bats\n\nKaibutsu Baseball: Egg is a VR batting training app that lets you experience game-level pitching.\n\n## Problems We Solve\n\n- You practice swings but can't replicate them in games\n- No access to game-level pitching for practice\n- You keep swinging at balls outside the zone\n- You hit well in practice but struggle in games\n\nRegular dry swings can't train your \"see and react\" instincts. With this app, you can watch real pitch trajectories and practice laying off bad pitches.\n\n## Get Started in 3 Steps\n\n### 1. Create Pitches on the Web\nSet velocity, spin rate, spin axis, and release angle freely. Preview trajectories and locations before training.\n\n### 2. Select from Your Pitch List in VR\nYour created pitches appear as a list in VR. Just tap to select.\n\n### 3. Experience Unlimited Reps\nTrain effectively with options like random pitch sequences, left-handed pitcher mode, and pitch data display.\n\n## Scientifically Proven Effectiveness\n\nResearch on college baseball players showed that 2 months of VR training reduced strikeouts and significantly improved batting average and OPS. Another study found that 100% of participants felt improvement.\n\n## Pricing\n\n$2.99/month for unlimited access to game-level pitching.\n\n*Price may vary due to exchange rates or platform policies", "short_description": "Practice laying off bad pitches\u2014something dry swings can't do.\n\nKaibutsu Baseball: Egg is a VR batting training app for game-level pitching.\n\n\u25a0 Beyond Dry Swings\nTrain your \"see and react\" instincts. Practice recognizing balls and holding your swing.\n\n\u25a0 Create Any Pitch\nSet velocity, spin rate, axis, and release angle. Preview on web, experience in VR.\n\n\u25a0 Unlimited Reps\nRandom sequences, left-handed pitchers, and more. $5/month for unlimited training.\n"}]}
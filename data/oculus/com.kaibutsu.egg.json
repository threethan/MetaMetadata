lJoy9R9Y7S1WErL-5xHhsoP7p-y36Ymq3iQXmtI7Yw&oe=6B048039"}]}, "id": "1890978958203123", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u602a\u7269\u30d9\u30fc\u30b9\u30dc\u30fc\u30ebEgg", "keywords": ["\u91ce\u7403", "baseball"], "long_description": "# \u7d20\u632f\u308a\u306e100\u30b9\u30a4\u30f3\u30b0\u3092\u3001\u8a66\u5408\u306e100\u6253\u5e2d\u306b\u5909\u3048\u308b\n\n\u602a\u7269\u30d9\u30fc\u30b9\u30dc\u30fc\u30eb: Egg\u306f\u3001\u8a66\u5408\u30ec\u30d9\u30eb\u306e\u6295\u7403\u3092VR\u3067\u4f53\u9a13\u3067\u304d\u308b\u6253\u6483\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30a2\u30d7\u30ea\u3067\u3059\u3002\n\n## \u3053\u3093\u306a\u60a9\u307f\u3092\u89e3\u6c7a\u3057\u307e\u3059\n\n- \u7d20\u632f\u308a\u3092\u305f\u304f\u3055\u3093\u3057\u3066\u3082\u3001\u6253\u5e2d\u3067\u540c\u3058\u30b9\u30a4\u30f3\u30b0\u304c\u3067\u304d\u306a\u3044\n- \u8a66\u5408\u30ec\u30d9\u30eb\u306e\u6295\u624b\u306e\u30dc\u30fc\u30eb\u3092\u7df4\u7fd2\u3059\u308b\u74b0\u5883\u304c\u306a\u3044\n- \u30dc\u30fc\u30eb\u7403\u306b\u3069\u3046\u3057\u3066\u3082\u624b\u304c\u51fa\u3066\u3057\u307e\u3046\n- \u7df4\u7fd2\u3067\u306f\u6253\u3066\u308b\u306e\u306b\u3001\u8a66\u5408\u306b\u306a\u308b\u3068\u5f53\u305f\u3089\u306a\u3044\n\n\u666e\u901a\u306e\u7d20\u632f\u308a\u3067\u306f\u300c\u898b\u308b\u30fb\u53cd\u5fdc\u3059\u308b\u300d\u611f\u899a\u304c\u5f97\u3089\u308c\u307e\u305b\u3093\u3002\u672c\u30a2\u30d7\u30ea\u306a\u3089\u3001\u5b9f\u969b\u306e\u6295\u7403\u8ecc\u9053\u3092\u898b\u306a\u304c\u3089\u3001\u30dc\u30fc\u30eb\u7403\u3092\u898b\u6975\u3081\u3066\u30b9\u30a4\u30f3\u30b0\u3092\u6b62\u3081\u308b\u7df4\u7fd2\u304c\u3067\u304d\u307e\u3059\u3002\n\n## 3\u30b9\u30c6\u30c3\u30d7\u3067\u59cb\u3081\u3089\u308c\u308b\n\n### 1. Web\u3067\u6253\u3061\u305f\u3044\u30dc\u30fc\u30eb\u3092\u4f5c\u6210\n\u7403\u901f\u30fb\u56de\u8ee2\u6570\u30fb\u56de\u8ee2\u8ef8\u30fb\u30ea\u30ea\u30fc\u30b9\u89d2\u5ea6\u3092\u81ea\u7531\u306b\u8a2d\u5b9a\u3002\u30d7\u30ec\u30d3\u30e5\u30fc\u3067\u8ecc\u9053\u3084\u5230\u9054\u4f4d\u7f6e\u3092\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002\n\n### 2. VR\u3067\u6295\u7403\u30ea\u30b9\u30c8\u304b\u3089\u9078\u629e\n\u4f5c\u6210\u3057\u305f\u30dc\u30fc\u30eb\u304cVR\u5185\u306b\u30ea\u30b9\u30c8\u8868\u793a\u3055\u308c\u3001\u30bf\u30c3\u30d7\u3067\u9078\u629e\u3067\u304d\u307e\u3059\u3002\n\n### 3. \u4f55\u5ea6\u3067\u3082\u4f53\u9a13\n\u30e9\u30f3\u30c0\u30e0\u306a\u9806\u5e8f\u3067\u306e\u5448\u793a\u3001\u5de6\u6295\u624b\u3078\u306e\u5207\u66ff\u3001\u6295\u7403\u30c7\u30fc\u30bf\u8868\u793a\u306a\u3069\u3001\u591a\u5f69\u306a\u30aa\u30d7\u30b7\u30e7\u30f3\u3067\u52b9\u679c\u7684\u306b\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3067\u304d\u307e\u3059\u3002\n\n## VR\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u306e\u52b9\u679c\u306f\u79d1\u5b66\u7684\u306b\u5b9f\u8a3c\u6e08\u307f\n\n\u5927\u5b66\u91ce\u7403\u9078\u624b\u3092\u5bfe\u8c61\u3068\u3057\u305f\u7814\u7a76\u3067\u306f\u30012\u30f6\u6708\u306eVR\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u3067\u7a7a\u632f\u308a\u304c\u6e1b\u5c11\u3057\u3001\u6253\u7387\u30fbOPS\u304c\u5927\u5e45\u306b\u5411\u4e0a\u3057\u305f\u3068\u3044\u3046\u7d50\u679c\u304c\u5831\u544a\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u307e\u305f\u3001\u5225\u306e\u7814\u7a76\u3067\u306f\u4f53\u9a13\u8005\u5168\u54e1\u304c\u52b9\u679c\u3092\u5b9f\u611f\u3057\u3066\u3044\u307e\u3059\u3002\n\n## \u6599\u91d1\n\n\u6708\u984d600\u5186\u3067\u3001\u8a66\u5408\u30ec\u30d9\u30eb\u306e\u6295\u7403\u3092\u7121\u5236\u9650\u306b\u4f53\u9a13\u3067\u304d\u307e\u3059\u3002\n\n\u203b\u4fa1\u683c\u306f\u70ba\u66ff\u3084\u30d7\u30e9\u30c3\u30c8\u30d5\u30a9\u30fc\u30e0\u306e\u30dd\u30ea\u30b7\u30fc\u306b\u3088\u3063\u3066\u5909\u66f4\u306b\u306a\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\n", "short_description": "\u7d20\u632f\u308a\u3092\u8d85\u3048\u305f\u300c\u7a76\u6975\u306e\u7d20\u632f\u308a\u300d\u3092\u3001VR\u3067\u3002\n\n\u602a\u7269\u30d9\u30fc\u30b9\u30dc\u30
g&oe=6A7DD014"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "maxresdefault.png", "id": "735983904142580", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39003244_735983910809246_8127394115187789742_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wDe59phbBwQ7kNvwH7tMkY&_nc_oc=Adp2Byn2z8iTkKfveZFVxqTeNEl9LowMgcwQ515WDVARAmbIdhd9lGKrbAizMbvsMlY&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGumarlRvHR4_-poyMQ3W0pvTz3wH4W-AI3W1T25Ioy7g&oe=6A7DC82C"}, "display_name": "WeezyVR", "keywords": [], "long_description": "Weezy VR means travel in Virtual Reality.\nGo on virtual trips in destinations of your choosing.\nFind and explore destinations with simple filters, and pick and choose your favourite hotels, then book them to explore in real life!\n\nJoin us on a trip to the top of the Eiffel Tower, ballooning in a Ugandan safari park or lie down and relax on the white beaches of the Dominican Republic - all from the comfort of your own home.\n\nThrough our comprehensive booking system, you can try your destinations before you fly. Check out hotels, cities and tourist destinations in VR before you commit to your booking. We can help you find your dream holiday by offering you comprehensive 360 views ahead of time - so there are no bad surprises when you arrive.", "short_description": "Weezy VR means travel in Virtual Reality.\nGo on virtual trips in destinations of your choosing.\nFind and explore destinations with simple filters, and pick and choose your favourite hotels, then book them to explore in real life!\n\nJoin us on a trip to the top of the Eiffel Tower, ballooning in a Ugandan safari park or lie down and relax on the white beaches of the Dominican Republic - all from the comfort of your own home."}]}, "developer_name": null, "developer_privacy_policy_url": "https://weezy-vr.com/weezy-vr-privacy-policy/", "developer_terms_of_service_url": "https://weezy-vr.com/impressum/", "publisher_name": "Weezy VR", "support
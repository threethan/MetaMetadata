1-7&_nc_sid=6e7a0a&_nc_ohc=LkpDF2jQQtUQ7kNvwE57fdP&_nc_oc=AdqU7p70iuNxH5NGtm4BuKnwR_z6Bs7mzx4Jc1TvMEFXz9kCmddFPVtrt1ICcKUjl4k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxYfQ2z6fZtVI80Tul1oaGTQ3_eAt5sOQj5yO_stEZBNA&oe=69C29393"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Imy1-Z_IKZ0Q7kNvwF85TVe&_nc_oc=Adq8fj1MlV6EDloGU4ehBjzSXyk5mIx9Wjmo-5T4d6jWtyo_XlQImc2UXdTj3mXnZW8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGh8L77poX9OmIQQj0vudfNIzKvcmpR1JmBeGDqgqPsw&oe=69C26F5B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FoiL12lrnGoQ7kNvwE3zz2g&_nc_oc=AdqyEb1jFsy6a6I68-86Z2scj6nuGuKra4mxj-DqWUry7poMz2lPctnVe8G6Xav6RZc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV-VWPAJh-re26BApNPEgrTgKmC-jJ5G0pvz-ly7caOw&oe=69C2A1CF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=keeW0g_j29MQ7kNvwEWa7fy&_nc_oc=AdqkLJ0cP6uGn3f_JR4GCZPwGefZFx-rxUe-Q11FRzxoDt_PXsQfrywYmTGtQHmg8Qc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwBZmd5q3Ihp2TanF2NhYEp_yjIqFbZ9oaLveU8IGaWhw&oe=69C27E7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
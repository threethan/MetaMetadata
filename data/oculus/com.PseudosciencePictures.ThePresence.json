1-7&_nc_sid=6e7a0a&_nc_ohc=HsoyweZ1sK8Q7kNvwE8K1ph&_nc_oc=AdpwpxB2pfhcY7mwCxTwTgUoGpWwbrd5Hn7DEX_Lf4VEtUnc_u8IqyMuZtET01IrXZA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7W28Yi7y0ruDgT5toysQB7kpL5DAbQy6T65fQ-esiPvg&oe=6A01DB93"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jScxLu0p7OMQ7kNvwH_8dYv&_nc_oc=Adp1_33zCNJXE0n2k10i8sDjVMP_0T_FyBN_tyQ1hqKzolF6w2yw8h71E0SkrGc-VEw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4pJ5lXqDf23VmATf37j1yPL3HjxbYG4cQyfxep41Fvkg&oe=6A01EF9B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fS8EbBZUT-8Q7kNvwFg6y4U&_nc_oc=Adrw30vdb_uo9Em_InuDGDWA_xyUmmxwISzPkOvGgoTK5bp_Ki1AglUXxUhPSLdhmbk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41VMbk8OQU6tNjS6m2UoAof3UmCqODpl5J3CsSukHx4w&oe=6A01E9CF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tw7munzls6YQ7kNvwEGDceG&_nc_oc=AdrwXWnA6ipxoN5MGO4t7waBtAsm0_xRXaHLaMFKQek3iAZOjUSDD6ODrFfzfdH7FoY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6x5bn3djedsHCO_qPE8vuvVOjefU_6QB-N7d0zhy7dPA&oe=6A01C67E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
1-7&_nc_sid=6e7a0a&_nc_ohc=0_VFhASwf0wQ7kNvwFt2KcQ&_nc_oc=Adqgxrk1I2iHNv4L0b-Z4v3xsCohoUd1-c9pIxAlAhgD_U_KCbbeNF_W2p7WQ9AiVCs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yWDJ_fxPKSqLjCFCe3irNJU68_X5AmdmsdDqlJEQLWg&oe=69E77D93"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8c5rppwRHcIQ7kNvwFY7I5-&_nc_oc=AdptnQgXqnkZwQj9qUTw7bK5jFujCt0UbO0TT-sgZsm7G4VyUxHjaRM__YofgPXsqTg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tGRpxmfMaOA-62ZqTLoekg3XH5jnkVaFx9WSLdW1mJg&oe=69E7595B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRENsN74CwkQ7kNvwHA-kZD&_nc_oc=AdoAwLAC2Pvq0uuTZ5-dVqIe1cKIHkxaPHQqHrMTNSxlQp3Szsu_pDepL7jm1GcgVUQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H3PnEYci09KxJWSD3FE_Jma6a1LlHznZj9wBGkcqxtA&oe=69E78BCF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5k1k1VkD_IQ7kNvwHrhEau&_nc_oc=Adpnr2HBCMDJr81suBl0iwAjkKTRmWwmLKVRNARZU8AnDeAuJ_Ve5oLzSXteBQxCaH0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vYIvDiMlvVZNTFuB2_FgbiDGiiiKXyssZLx6M_md80A&oe=69E7687E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
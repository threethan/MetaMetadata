1-7&_nc_sid=6e7a0a&_nc_ohc=BlQIUJMnXvAQ7kNvwFBH5a0&_nc_oc=Adpx1OTAa5Uk1GDfTjBbyIf2mN7emYvCZ4dQ0DDonxrlaLl3NiQ1FXsVmjhUouuOwjc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzJk7tUOcM6ugZm7JbpBlHJEaXgKR2N0bQXi6sxZDwQA&oe=6A75DF93"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LH0blPSEKHcQ7kNvwEXAdne&_nc_oc=AdpSnU4dzkn49B6mUbVkcuPkY_Td4pF6Nsu0KhtZ9mBQ5McJRtxfpRMJPjrkdh1GOXg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzomjRfCAF-dmKPxpGiiiAv7Ma3jlseDicjVps5Rnv7A&oe=6A75F39B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Dew7Oj9yVoQ7kNvwGX3BFN&_nc_oc=Ado0tXZJB3Pq_yxCUdoatCV_c50U_XRbw2U7lOPStbKBT9-_V2Cil3mXCmqllwIEFQI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh0ftsw_ifNVvMWSIZJCxevJH8oSnRiGmeJZzZkN9pMA&oe=6A75EDCF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO3ZJWyZLesQ7kNvwHLKShi&_nc_oc=AdrRKuBxOAduL6JceoJ0WfnGp-UJzEcAXdEX-kDXpabMDIa-Vt2yzZqVgC5tx4z6grk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqozzhpvAMDkpx7ii_a2k1lQilChHSqQcXMd3R5dCt4w&oe=6A75CA7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
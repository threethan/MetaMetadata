1-7&_nc_sid=6e7a0a&_nc_ohc=6E14hPZn_ycQ7kNvwH5jTpB&_nc_oc=AdpBKEVH--L0ygxS4kwO2eNFL1QIoNEf34xEQdGhacJY58vm_wBnLVzbZGPoHCkBDvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJ5vcSj9uNDKiqAGskYcW-_VzZswI0qWw7gtaKj1IX_g&oe=6AE49D93"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uXMHGtCp0CUQ7kNvwGwT_k4&_nc_oc=AdrYrRJ3_dQwjQeDnEZHVlfd1kVEOQjCdT9iKv52OTB0oM0MKEuL3fuwRekkgXDcmVA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOubPlun76-H18tRrHJFR6hAJUu66J4BNVi01h0b0EIXQ&oe=6AE4B19B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlRc6r6iGMwQ7kNvwFZv8os&_nc_oc=AdohnCRnMDNSo-rO7q-cswU4tSm3HXNfmN9e85KR-BUFqQSOt0wWkIaWELnHWZ7PUsk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJK3xfgQ-eeteXeAWMTCE-SFiAT6W1TEst-k1j7vxKjA&oe=6AE4ABCF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddxxCeCGfu4Q7kNvwFpYlFm&_nc_oc=AdqmTmD9ba4hBZ2KiSjsTZS4852Db5ALZk1_RrgwuKEOeD4c1fjxJPdNwC4f5P7XNPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhWXYQSNnbIQ-pnIuWcm_mPhQ-ZFPjJQ2GbMNaRM-6-Q&oe=6AE4C0BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
1-7&_nc_sid=6e7a0a&_nc_ohc=vLUFzPTrJj4Q7kNvwHzXnkt&_nc_oc=AdrYYzjepPwGjJqy5BMjHdPL7wJ-Fup174PPEkjfqi4Q3yZbOIrQEEZnFMNoPBrQ_30&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHbubGX9Ttph4lwWxgU-FkmmTuycFphMhHfK8Nqwa2bA&oe=6A79D413"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aXIx1TtkahgQ7kNvwHEos2A&_nc_oc=AdorcolaOfdzdCmyLxDONf3ont9u5AgiSCyMRYZh3gBzliklbpzVdbMQ_CBapNt9g1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN1Zqlap32d2r_GDqF0QIit5Cs7cxE4wjRNN9fN-MQEg&oe=6A79E81B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcEm82mxf2QQ7kNvwE6MdCp&_nc_oc=AdoFmYkWUSSzcw87J2gg3BqYrNcxncznajvZQAO2Ow8pBijb8skwAmWvH7W7GkuRPZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMYzTU4vP-yKV3kAg9shP-rpDY3mfrse5-OQt_dR7C9A&oe=6A79E24F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6e4tILkokQQ7kNvwHwZZ0T&_nc_oc=Adrwxp8dPRphpeq1M21frKxBpeErxe7tblE8nTzvPcRLmIcdjP29PQIG5Flo4PxL_Hk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWU-k5He_93a45ieVeRLRZSveIMETijR2GJhxLPJLA-Q&oe=6A79BEFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
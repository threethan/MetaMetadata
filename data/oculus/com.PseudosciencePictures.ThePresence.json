1-7&_nc_sid=6e7a0a&_nc_ohc=eXkDqVEXAUYQ7kNvwEE1LNb&_nc_oc=AdomNlh0_MiFGivO2agxdNX8QvIomltFKhGFGirSvxRVulGEmMkaf29tMSp0uYxsm-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RhAZDeH63uuKwauQbGJoNRAwuZTodBzKxshBDcG1akQ&oe=6A202E13"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9G_I8M-dnYQ7kNvwF8siz0&_nc_oc=AdrQ4ce2ie3ekaIRwCRPWnxz_JpT8Gpu8tR9C2z3UBeMkguRDMe1g0U8JSD0g7Y-0KY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5L82Ohc2jpN7qq1-fGtsAU4E7a1mnjW_KUx2VDYePRzw&oe=6A20421B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5r0AX7ykHOgQ7kNvwGsZzuQ&_nc_oc=AdqqhfXjV6oI2NIh538mti2iNchSz8xCpAi0VlOuqQz22FrBHRKqcgMk3qDgJ6s5i-g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sd2C2FKZeU-UCZz9eMrN3svi7p6QG97qyU71RbOW-fg&oe=6A203C4F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aTwMISw2v94Q7kNvwFo9DkV&_nc_oc=AdoLQVc4pGFkI4eoop0xveIqRmO9kZ2-g1UNelgN7x_GbJgPaUKa2R0rAX5KOYUXBLs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54HbAFS8TS4cmcJk4bUyVSkUjDY7O3CtVABUoUs9HB-Q&oe=6A2018FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
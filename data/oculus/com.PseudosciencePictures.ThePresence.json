9cUnZe-36Q1vpNw&oe=6B0B4017"}, {"file_name": "migrated_image.png", "id": "528712977787440", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12427568_556386217897487_81576906_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1JqcdM9AhwQ7kNvwGHmMGi&_nc_oc=AdqSsPLxHRSdILyeyspgp5eBJYNFeT3XkUOgdamsVbBNbi2lQT5gPjI202PSS-Q3e5w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRRAstPMXnX6GzZMikMQi7xeewtsxdtHbaaA9f5BbJ0eQ&oe=6B0B1153"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-BHGUUqQJTYQ7kNvwHKU7ql&_nc_oc=AdpzrRy26BAQiw4oZpvE_HmJL8xC5_ofuSVpoA0lY7zgSGtyiZlVsJspkyap-TmwyUk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRcpLYDpBenMQM7V5rU0eWW8qZD7U-Vtxu9uV8MuREkyw&oe=6B0B255B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I0O_YMS8o0sQ7kNvwENuR2I&_nc_oc=AdrZTorSS0lQmYQn9InKUUAA8Gz75U3obL0B4TUjWagmd3j9GaMthC2lKa2fAQum-MM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRv4VD3Aq6YpWcF87L2VdjBwkBOgqKx11nnewPe2PfYHA&oe=6B0B1F8F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fywyDdhzt84Q7kNvwHsYzkp&_nc_oc=Adop6fHGuuO-Q2lX5rn7h4nL7tE-5H4OYQFgk_9TlVAgsA4vsyoUGKvee7tiJqOJ-MA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQGKL_3OcI0qCE9UQKg0AvI27UQ7tc-oYsD9ofY7uXpvQ&oe=6B0B347E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "
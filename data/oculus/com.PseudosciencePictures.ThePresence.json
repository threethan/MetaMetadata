 roam and cinematic. In the free roam version, the viewer is able to jump between multiple perspectives at will; while in the cinematic version, the viewer's gaze motivates the next shot, editing the film organically."}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://pseudoscience.pictures/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "495579938646470"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1406462432985832"}]}, "baseline_offer": {"id": "1406462432985832"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1467183600, "status": "PUBLISHED", "id": "1406462432985832"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1251649468297128", "version": "1.7.5"}, "id": "1717244798531172", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "862432087218870", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1251649468297128"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1717244798531172"}]},
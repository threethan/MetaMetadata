111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzQdkB1rQBMQ7kNvwHwYh73&_nc_oc=AdqQI7lOF4r2G1g6gWTAOe_ocKH9TVrKFRwwRicWwQsE2jgb-KNyfSoKKpKp8Uoes08&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dEJ8OqocdeSlPxIunCeRUDwdCa7f_TM2L4Zj__TTzKw&oe=6A393A93"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cG0nWD3V9aEQ7kNvwH9qcly&_nc_oc=AdoJ9lDXCdqFmggsmRK77Jmkrvj-4wuk9lYA7Q0HK-PAiJyJ1pEomsXI6VAH-vhrCiQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ac_9ZiUawSUqtomkCIUeybMyapksUgZE2JiwgBytLfA&oe=6A394E9B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MhIx6RsLMBMQ7kNvwELrBZz&_nc_oc=AdpvyJm_h1plgBjUOuk9hCaXkh-QjqNYJjJ0gCWqoBeQb6V_bejk9cOKf31tvWfi4Mk&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9K_wH4CSkiahKr5G-SZamQp7IxbSyh0o1CqTpiMzTxtQ&oe=6A3948CF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCIKDnTkmv0Q7kNvwGk-0XX&_nc_oc=AdqIIlARrq-e_EjaO4Hym4aaJCltqe21x7lx9jPFXbjxvOdvgEILRpvezk2nGbr-m-M&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_16kisZ6rZycBbfLDJxUQ2ofStHfrAQHQaswnAa_w6BQ&oe=6A395DBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTRO
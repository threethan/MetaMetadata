_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Jgtcd8tnv4Q7kNvwHjWdUd&_nc_oc=AdroH-_0MNwzy7HfJrsgLRwq37eIVqpFQz_8IIs1zrcYKY7nwRYBKIYrBhWY9aZ3EkA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGyUDsd_MUeJyXY_A5oU26N4f62ks4qhoeo_kK9Mx6Kvw&oe=6A85B193"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olBuAid3gvoQ7kNvwGd0ko4&_nc_oc=Adoa5DCrCHPF6YE0aevDLr7sTtZGF-_1TjElRW-t9SgHynAKq_ubuF0Ea46GzefWcGU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDMsvubwQ9AFJRapstB30bEYvEMKAwOHjGGf2vXpr5Zg&oe=6A858D5B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSuK2-mgOtIQ7kNvwH9bgWF&_nc_oc=Ado7vBY58WbI_eRXJd6_gQ513c-ZDTM1HP5DqLcZmunJAr3qMM1fHJ72BDHBjDe66i8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGxPLUVVWtSN0rJou6yVvxtH2kOWbmlJ1tmT9PWpyxiNA&oe=6A85878F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFw-_NXzCrgQ7kNvwEpFmB1&_nc_oc=Adozfy-0ukn_PXb__kxqkjawFq2y7VEodiVoaXBIpq4QhMZa-RK713P2XM21uNJlEeo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf21GKUsTxpaigHYDcOk9ckLhbFxOzS1-lWZ289bd98g&oe=6A859C7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_
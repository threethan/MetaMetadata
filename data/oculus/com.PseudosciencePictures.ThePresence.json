1-7&_nc_sid=6e7a0a&_nc_ohc=CK4aF1nZaMIQ7kNvwH_R8wr&_nc_oc=Adqb8isIfK8mSipZLLrX5581J7WI9t5tmuQQ_nxwk61dLATlXXOpTjhUZ4JvzED1XEI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTL96lYV1NEmvL9q4aYxMg9blY77z_M-JKQSFrwTuFLhw&oe=6AF9EDD3"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue7PYGMC6ZsQ7kNvwE6gSJE&_nc_oc=AdqmvJ4nDH7S8zwvFJnO21b6opLm1ko_Sx52SeDj79VMbyCQzzIk2wpO2Jdf9Cbvh5k&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS52zonsq7gAnTtS1U1NZP2ppQR0F0pOIhR-OIA36DGkQ&oe=6AF9C99B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQmREVKrT9QQ7kNvwHKzaMf&_nc_oc=Ado_00zyXPUqM7Dq79klOVOemWQ7sP7JPO9uATbBEhIw5Yo1PCFuMtdMcqn4nK9P3Ak&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvBZ-uItBN6raLSypJmUl3b7xjuZZvutCQAZS3SPvfwQ&oe=6AF9C3CF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jr9wAc7MIFEQ7kNvwFE7DBM&_nc_oc=AdoYu-Z_Ghl2aDGPqxm4dTSEndxPe6n6AJzm_-Qdh6rmZiqXV7Rd9aDlw4MkNqtOIuA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSUeFged70xhBphI0kSHHoR6poIBhUSY5kSlK17KT7rgA&oe=6AF9D8BE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
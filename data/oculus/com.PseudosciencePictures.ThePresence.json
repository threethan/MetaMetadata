1-7&_nc_sid=6e7a0a&_nc_ohc=vFNqml5Lwn4Q7kNvwF77Q5W&_nc_oc=AdqVTMpXiMx_9TROsnLLVkJi5K4-DvWKhYID7cQZZD-H9FVqpyaN1zTx1AkuXoQ45BQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Lrz6MT22zvP_NkQpBFjf0pwZwAYIJpnsjss6oT6iX_w&oe=6A184513"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ery-qR-eOjgQ7kNvwEMx_xP&_nc_oc=Adq9_czNsxVj8fau1zUK0irNT6x0CR4YCSQl8uoMqZcCChCnFcz-qvv4EOMY9k0t0l8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71Q1v3OU1ljSxqbisNnKr2osRebw7M7oStDPpUN7bXCA&oe=6A18591B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrql8R5EOmEQ7kNvwHSfisu&_nc_oc=AdqztuiPmhNiKXetx8wMw3CSNibLPS7S5Rgn0CdBJ26ZMmHE1vvhJD5oP7VSyPj9bvk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5N9GKFwgxdsDGjMp9EJZsi0hgYYUT43AjZLSkLuabtHg&oe=6A18534F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2h7H5OX1xoQ7kNvwHPYM0y&_nc_oc=Adoc6bLsCH93iZonQBGWwEHHeyoS_PQ8oUUj6v7rOt-7pyD-o7hzgZDUvN4exN8Tn-4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EYHxkWCTf0q3wr2lfh2D91RtpE7Q04_82LqYd_AI_fA&oe=6A18683E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
1-7&_nc_sid=6e7a0a&_nc_ohc=zZu3-pR8jSsQ7kNvwGTDxGP&_nc_oc=AdqoMJaBBo2Lloj98jNX9xxfOkuYccCVQDXvh13LdDSxM8TkpNfL_WYsCr_aNTDw1pk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS__qCcVS4KQKxiay2Jof8i1C-g2MPWs7PghA-XytCVNw&oe=6AEF61D3"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Mqt-6CE-dsQ7kNvwGhbKD0&_nc_oc=AdrAYYjaXzGmxnzd9z7jtWvm9MXF4sxkZg3GsROKiUvoHrfYo9LAlTEht6Di74tk0ec&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxwtplYHXOWx5_vldzdoU4jmXwfZ1fIi3S45XUHBdgrA&oe=6AEF3D9B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ax4yoEhf4X0Q7kNvwHKU1HT&_nc_oc=AdqTzFfaE88pFIT1E-Y2wCUcn-BcKKh-MHQAa8G_MpHH_7cVUKu5gJrVIThuJkSmhU4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQywGtDRS4y9zpjbi3tpWtNx7UZm6BJAiKNcEMWYk8lcw&oe=6AEF37CF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fkXvq7gRnWsQ7kNvwGjD56r&_nc_oc=Adq8L7-oIf_8VdgmJ09E-Gg0kTPmB2BrtuPfMeBtvLlKMsNgydtO8Dsb6CZN6jW6k1w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQigRPeeFGZqtEMeGnVGQjQGEkIndlv6ztYdf33jVtiOw&oe=6AEF4CBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
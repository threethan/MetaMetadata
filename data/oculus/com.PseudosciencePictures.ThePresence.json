1-7&_nc_sid=6e7a0a&_nc_ohc=MgLRlx6h0NgQ7kNvwFm1dMv&_nc_oc=AdoVa2A4bRFi8JJsGAL21Nj4fQ25ab9rzAwK36zprh0vnrzhDPDg7hsvFdNCotm_8X8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCWSogA82SOUqJj6A6DgVJo-10MI0dh8leCdsMClBS01w&oe=6A660D93"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dD4ubuXD0d8Q7kNvwHSXp39&_nc_oc=Adq_M3DGQezbrkj7a1x8rENIMaHCMOE2d_21nyCDcZ1cAZIY-uRDP8FWi_XKMhFnS2U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVVwLqROsyEoGoaH9LsfU-A7B6LHah_GVo0IeTI0IX3A&oe=6A66219B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=No9PRRzfd_sQ7kNvwFXT3-I&_nc_oc=AdrE_l2pZJVFwV7wrFfGSHSl7Ga8gEvP6XcIgal9Z8um9rQSiKJ57KwxTlNs_rUvRBM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLPIXWr_uL3ISUniR8d8nbdSVEd64khu5zOjiCPeQ0aw&oe=6A661BCF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sP8o9yWlCgsQ7kNvwEc2c2N&_nc_oc=AdqPbJJ1K3RBioIfhflX5BZ-u0ctQ3oseR8vTPYP2uJ9CT0lRtJpIF8bIkCCTVrZerI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmgUIIt3ZT0i2efciKbabg1Hq06bnSSCdYvoU7rhOVTA&oe=6A65F87E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
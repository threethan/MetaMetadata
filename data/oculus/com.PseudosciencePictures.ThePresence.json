_qIv2AQ7kNvwEHfMuE&_nc_oc=AdnLtUvbjTUux1OrtqSIodjsQr7mxfegjC_iU1Kx8s3aHIRS40wH2KTCjr01Ht5arcI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afz22hPneZGNLoUA2RkT-GOlzKNrB2F-VtzqwCV9lXTARg&oe=69B17013"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3udcRMr1XvkQ7kNvwG2GlC9&_nc_oc=AdkOTlkC1v73m_4yD05S2tisYLTUlNYkAerF7p_ozMoRvqVCYfHljoRXh-TKg7nBqD4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw_Q5283jvTc1AWLrY3KHZhGVP1RAkxOQnvaQVsEJCDTw&oe=69B14BDB"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ZkdoIuUPPIQ7kNvwGof5D8&_nc_oc=AdlWZGSND4Dm2mrUSxW-VPgxgk-hDdRuv5UpRh_sXgjIUiHlkso0yGsXkzALVm7WMOo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwb-XZw3sjuDUx_mywmvLlWC3y1AnwrkiOLRSA8zGIcyw&oe=69B1460F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNjlmRSTUkAQ7kNvwEsdppc&_nc_oc=Admcm-xzUjDZpfOqT3AEi-ehW5LTY13aulZuN9cMn1PoJ8Td8dCem0RvDmcEht2HMwc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqAMpYjjBsjjYon5Za6GkWZN1AjZHYLfQX4qcH-WAWQA&oe=69B15AFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_mo
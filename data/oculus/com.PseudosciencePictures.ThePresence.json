5oHcMEarl6ksLFza8mJPI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afs_ke7rr0wzJsoLaftwvq30DnKVyRfp3Etx-BlN6jzLXw&oe=699C5813"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFm-lQn0CucQ7kNvwHlHJrD&_nc_oc=AdnW5F88WtxCT166iP2mLVsIKyQSFsTvH3gNiSfl0NjrABCdoc8Zbzd03xvQVazndss&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft-rRG2mITQE86bSe6dRyXysuUOCLJAUi5yddvol1EE1g&oe=699C33DB"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZuZWR7IBFQQ7kNvwHsVW4J&_nc_oc=Adm-66xtlLeITCKhw7AxEr5GNfxxyFGwrTp8Aq6c6gvXLoDzp8HcaQBzij7n3hQasy0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftx_KjjrS64PlpnCzb0rQZ6txs_nYXlBr-ZIH3_lNAlag&oe=699C664F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLhCQRh9JCIQ7kNvwEyqIZg&_nc_oc=AdmxGorui6BWnLypaUpKqWU7qf4EgzSX1gRpU_EI7pa0RZOsfH6UhBupO6cJwCuqNOo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftuHqz6RcmebKg8N5Y5rZeVIPVkDJDJbm3Pif2mTN90cg&oe=699C42FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7209422042519811"}, "review_messages": []}]}, "c
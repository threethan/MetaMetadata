1-7&_nc_sid=6e7a0a&_nc_ohc=wuAp5KciJTsQ7kNvwFGdep-&_nc_oc=AdrgrWblg5nEwtKeP_CXxLSOFjVmX7ozQbMU-7o6L3b8Bc1-obtso4jce21JqVkriX8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeuA4FcFo8vWL0iIju-GMh8pdS5UqCTrEjdFnywwxnow&oe=6ABA6D93"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3yxVhcI2NEQ7kNvwGN4G-8&_nc_oc=Adp9LzVcK7eK8_VSQQcWZR-eZygDS9Bql8pOEEBdViIR1mpWqBcwP92P-ME2rXuWjsk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFSF0GzxCd9MhwxKpBYvoo2PphkEMnJXRI0NghGv0-kg&oe=6ABA819B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2CZbvNd_74IQ7kNvwGFniGg&_nc_oc=AdrdAjao-4HWOy-2Txq2oq-ZTi-YChnUdGgVelpfxpu3K1zt7jMtwBBGKDfuo_a2O6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWGzFjkg9CYwOidnBr0SvaIADYwt_jw2ybAM25KHx-GQ&oe=6ABA7BCF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDqk04XYmg8Q7kNvwFmA4qE&_nc_oc=Adqe2dSToP55Z9Aj7-vwv_YQFLWEdFm7-YOFQ5CH-234c_1ws1HIvBj4Y610iwI5Qw8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJziJF2HYjb3G0zQaMAaqf6NtsmS1nwo7xypM62IubvsQ&oe=6ABA587E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
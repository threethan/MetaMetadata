1-7&_nc_sid=6e7a0a&_nc_ohc=MrLNl5SFjqMQ7kNvwEDg9KL&_nc_oc=AdoCDz_LZ-uo-UGl7rIDUlZn_SUU-ggdq77V0Fi4zEHKNnGOr15ISb1tAUltm6yAnvE&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcoYtjQh9Y-X6KhT_vq8ShCJtmxeNS3Xxia8oYp2WkDw&oe=6A918F13"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iwglcz4zKHAQ7kNvwHLNgKJ&_nc_oc=AdqOWEQru8wrpC5cZOCZ-vQzhuGKMO6LhOOsN-us1XFVkv53ZieMkAwIFJ1vmGLf-0Q&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6PAGUPxGYGN0gyof5qh7uKdNAXwP1H1chF-se8v1VDw&oe=6A916ADB"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NyLSHyt_wY4Q7kNvwG0VgBg&_nc_oc=AdqqsXE5nipPnrOVIlbDGYEIgPNMwgXmBTt--wTbrGv2kcRk4sk-1jcqw9hThBB8Qgs&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWWhwNL9cbjuLgkMSX-SiPFd9kGapdnmNhNUlLb5uhiQ&oe=6A91650F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7AkJkwBm4yIQ7kNvwFztIzR&_nc_oc=AdrKe4gY69xood5ty0gmze67jvB-xvzjf5ACQtnziogHkHEJWMQje4DGviY_phXrL4c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg9OiKhRm3rF6H9KmG3doyLRj-Oew7w80BxQky-1G69w&oe=6A9179FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
ciYlPQFJgEPSiWw&oe=6B0864D7"}, {"file_name": "migrated_image.png", "id": "528712977787440", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12427568_556386217897487_81576906_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJ5ITmSuT5kQ7kNvwFr3XBv&_nc_oc=Adrzpx2FTGvns-dAyJXn8Xp1T7EqCzlvCINMrelfr7ZOIRSQzuH5BjGzf1e2zcg6stM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQolCVk87hUnryo5cnWmALwc7bTvPUGBguYx2nVu0QFjQ&oe=6B086E53"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRsUsasuszoQ7kNvwGLEdmU&_nc_oc=AdpQywbcHYxaMjwCbrCnHa2ymoiPzmhO2w09RTwi9H20F-JW-QJWXKr1ySHLYzDyAu4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN0_cSPcgK06eFAvUv9uwAX4znApAJkDjtBKkCvCuOtg&oe=6B084A1B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KcwhGwZyXMQ7kNvwGJTHtD&_nc_oc=AdpCeDV6nzKxrJdENLS3Hy_X3z7h8D_CvTW3AcaHIt0SkbfweIbrKnVvgC-9TCFsGzw&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE48SOUzo9eCkPsD8o0ni17jv3bk4OVqHA8fOunuKr7g&oe=6B08444F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fywyDdhzt84Q7kNvwGR6hzC&_nc_oc=Adqy91VAd4xp_mEipcyZTA1DSKTgWDFAruP2RHnsEOTs2yCXaMySqRDbYCapm9RH278&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQO25J1b9sxWcDKJrNU2l5Svj6kIiW6dzbUtBKvlmNAIQ&oe=6B08593E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "
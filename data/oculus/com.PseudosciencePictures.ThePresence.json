1-7&_nc_sid=6e7a0a&_nc_ohc=Bc9__2X11jcQ7kNvwGodxd1&_nc_oc=Adqb-KOn0bo0uW8KmSkW13Af8S9YT9SS9QvUK9CDYmb9Gdkgah0rWhFtr5PzXlz2a5Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW-j3W8Y1rtM5mEMLjdKq5OG945YsxDcouODQ6Q2KjQg&oe=6A4E5293"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E6JnDKp1ORAQ7kNvwEF3VEq&_nc_oc=AdqZ7RcXoWSwhUTUOmznJ-OCjO__W7wtPEwFqEKLItuIfymBZVW5vqm6fG1AADH2XQY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGIgI94jSWxQ1BlpNsWhIARUAjPnSze_B8HbzrsE5k1A&oe=6A4E669B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2SFDkqAZjsQ7kNvwGtGLqp&_nc_oc=AdrS9fGs1YE2-678GncGQmHkZX8_UvuMJ_5wutgSvzgGgWZUEhSiBb98-MazmWnlybg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKCSTGbt0SBvH4at0C-dybXVgqlJSZm8MPM67pmZTNqA&oe=6A4E60CF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tpAjcmZPOUQ7kNvwGy5IOf&_nc_oc=AdqOuzyM5KzCSjt-TRKzeffpA8E4d769VtZHRT18NiWKkZ-pJibuuzsEES1qN-VElmY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEp1qCY258B7hgVH7jsQSjjIyGXGFdKWc6KtkdhNRJgQ&oe=6A4E3D7E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "sup
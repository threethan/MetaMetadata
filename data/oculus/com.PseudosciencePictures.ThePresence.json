NTHxDCIcrQDLYUQ&oe=6AFF2A57"}, {"file_name": "migrated_image.png", "id": "528712977787440", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427568_556386217897487_81576906_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6L8CJnABL8Q7kNvwFLKahQ&_nc_oc=Ado3j1Ny1AAYY2MnlJMj2VveFF_GekfHZJeTSFoKr3Ajlpjq9RCrC3tiH5etOT_O__g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSO2ZZz22lgt_K2j_suKUZWPMqk2uLvo-5B8tmhDJHMYg&oe=6AFF33D3"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK7urlUZ6IEQ7kNvwGri-_Q&_nc_oc=AdosxnRiAwSyOMmKWIbkJpkapw7g51W0H5ki50_2doFjRoEVIZOIwvfa7fMeh4qVgRY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT_2DNxm-_lqBPiMfO5K47vIDkRUqN-ASNOvWrlfo9Fg&oe=6AFF0F9B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHo2sw_eOTQQ7kNvwE45-RM&_nc_oc=AdoWUBS4_IpO84GxiPLOGVg8jcRNVdSruGIOWp0cH53D9tvxDf-ZPnic5PFBZjvzX-U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD8XNpoaFNads-JPcE75wy6V1K2wylzSWXC8fqa8UgMw&oe=6AFF09CF"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hH8qlMuuWRoQ7kNvwEvmWEL&_nc_oc=AdqAu0i4eaPG1s76IvOqFsWPcEiDAeOrbHo9MK_H6zJTmME2YTgifJ1LioyK2Vyg8dE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgm0AdmYzgcX-zFMLnNQ7GdI5MsQTnnNNtNpnSqfBaQw&oe=6AFF1EBE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "
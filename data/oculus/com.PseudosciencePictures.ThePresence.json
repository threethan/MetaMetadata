tNLdUWjgTtmd8jg&oe=6AFB35D7"}, {"file_name": "migrated_image.png", "id": "528712977787440", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12427568_556386217897487_81576906_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXQ8NzOubacQ7kNvwHwnHu-&_nc_oc=AdpAcMErPIBikNZLyST2topN0VxPuU6sTikhTJCxxXybbftdV5YKVRQ4swynrwr753g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZxhkr-W71vDEJXsY3kZgnabvhUE7w3Oc9OB1inlCwVw&oe=6AFB3F53"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue7PYGMC6ZsQ7kNvwEE-keN&_nc_oc=Adq1gUjGQj0bNug9h-WdZMr_jYC8fWPBJiQXzjrS75c9fqVRPbWXik-EXuJ6VjF9QT4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZTNwG-nn1z7NwVDRgTsyS-rFlcDXyKbFxptMJ70ppKQ&oe=6AFB1B1B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQmREVKrT9QQ7kNvwE-y_WT&_nc_oc=AdqDpVeBywHtdWul6FBhWGqF0BQK6rhSOq5B9KDETmUa6q5B4ycgcGCYOE9Y650hpqY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEYakDHuF0ryelJXz5n7sbr-Nha7r7nKzaXUyPEesvfQ&oe=6AFB154F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jr9wAc7MIFEQ7kNvwFxJMCn&_nc_oc=AdoHBblMmmRhjrTFm1ofzwmd6LJDzd7gL74WQM7wANn5ikT5IsCI_QmpVrqqm0_6LYM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpcY8EmzvfTmpqwPik-YZU0Pl-drjAJ_ZI4ql8PiCC5w&oe=6AFB2A3E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "
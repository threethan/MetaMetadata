7jfGHIQ7kNvwFEqjy-&_nc_oc=AdmQvxFXbNuOXKhpy5_oGkPVeSThRhBfG7zhqXkNCTxHLZa-jobI8x923G4PeVxu_NM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwG5nAftOpaEQL89ZpwAwfjN8W400kIVhuTQskqpWNrIw&oe=69AD7B93"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gUjMteDMp-MQ7kNvwHFfBAI&_nc_oc=AdkveWOSTVLTNgzFPYK5OyJIUL_jw4wV0_9tI8N3tKeAz_Go8uCE1oOkdGB_dkKt5cY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxkQqbD6PD8ggo8j8RTQc58Tbfgj735wUTuEdm8BKfLRg&oe=69AD575B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hu6WiVs8xisQ7kNvwGvWWeW&_nc_oc=AdklwtoSm8Yx42ZDUO0dtx3zTFvXRr7ovquwhq4qALUy6BUN6JL1MnEEPmZXt_T3qZU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5oswNBOsrqgDu_lXS4u7KOxv-bN-SNI5nyL5bwQZbUg&oe=69AD518F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wghiji1HxccQ7kNvwFgsyJH&_nc_oc=Adnwbdt2exep0i2fZ20_8Uht_ou4AkTJsBxIEKPZT2lP5NuBCjb5JolbnigpJcNm4nA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9hz3_S5elojzn0x26nWT0dW9b6QFXqF_ndCUSpUID7A&oe=69AD667E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_mo
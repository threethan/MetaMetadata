subg9Z26Op0SRog&oe=6B007BD7"}, {"file_name": "migrated_image.png", "id": "528712977787440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427568_556386217897487_81576906_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6L8CJnABL8Q7kNvwGNEL9G&_nc_oc=AdppOC9x0Sx-lzvoxc_HBCxPKqDypAxgolXusLB6e4DngV9xk1aLXI9E3gumICpkOEA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuhr6DUBBbj-n7VkZI1tMKvkqxUdxAa0jBapXB5UVMJw&oe=6B008553"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wdnfH8ZS5ZcQ7kNvwFh3x2J&_nc_oc=AdqoZ4k30KxG9UuKn5KQwImFHhQOEOpB-R7rIFJNPiYCZhWZ9WGTZhvOnDF6QeoQu-o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZp9Mt6lklNF8P0Q3wyq-6WxhL2e0wHOgWFMRuksu-DQ&oe=6B00611B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHo2sw_eOTQQ7kNvwGqxbUb&_nc_oc=AdqpdUs87FQitOHiZVcAOOC8ozof0ajGxby9wZC45rxG91iot4JOAFkgogYYavQhJhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROkcLldMTyIcyEN0gCov-V0dNmzfKz11M48ZEoc0Gmdg&oe=6B005B4F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKWnkeZR3rkQ7kNvwFZ4V1y&_nc_oc=Adp9oYrPYhOqnAUdTlS1FRwUHnCgAPT4y69cuyRiJ0NB25W9i4C-73tuCUMIW7rdp7w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFfwmzwaVzP7JlYSm9SFvjoY4BlzfREYPEowamT_jZuA&oe=6B00703E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "
FwJWnGtau3doyWg&oe=6B05C1D7"}, {"file_name": "migrated_image.png", "id": "528712977787440", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427568_556386217897487_81576906_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qO-mJkarWDYQ7kNvwEca2un&_nc_oc=Adqu_U8izeu0WzxTUeTG1xCL68qMWeZfug2pJBI1u_BKwwB3C7o0yl2TPOMpGSWsNZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnkRDOhRncfgRsHgNyE0FKHSlsY7hkSyLYNh_fwAWGHA&oe=6B05CB53"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-ETVdrcVb4Q7kNvwFNZ8PE&_nc_oc=AdrL7jymUcUI_JCXYk5OAWAen9Q-O8LBBrdhbTGARqInqYrzj7hecF9rzBgHs-tMMVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTisuh1RP_3OosqoS6TN6LzGzaa5tLCGcnn_7IN0o58mg&oe=6B05A71B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KcwhGwZyXMQ7kNvwGl5l5U&_nc_oc=AdqyNYpasANe0dJkO1btd7mp7nhbDJrJ6i4eDDYR_aWeVPFjYi306rItU0_u0mBeG0o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_V7axnqeLrThekqae-2QFP_QfTT5XCEO3yw_dpkpGdw&oe=6B05A14F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMnZ63pHm2cQ7kNvwGDsBwn&_nc_oc=AdqCw96GS_uPc9zozH8vN-4TikcZmCKuO0GOJaRxiW7qyQZ1P-ib2gOMg9zmq31Ns1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCg35nsrzqDTJkhMYtPx3URnT8IQFX_A07FYzMAY2DRg&oe=6B05B63E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "
IdmHm4Q7kNvwH3q-8Y&_nc_oc=AdlOuZmgy0um1BQ7KyAOayW3lPDqaFK06pfKimJtNUm7Cbr8sfvmIjSFb1j9a5iXbRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxjtFlvozjTKVpzPLecICTpVShSlBQspucJHq94z0t9yQ&oe=69B6B613"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2A3N2w9TaMEQ7kNvwGrXcgw&_nc_oc=AdnjRZVmcGwz-1_lbBt6EF4r2BVWl1X94Ay6iUbmHeuZAjweYhLb-zG8e2GLLmc04EA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy0Tbwse8Nkq6zjedFBJCjgyN5_k5EtOoaqc_askDw5QA&oe=69B691DB"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nz0AGbL6asYQ7kNvwG9Bqml&_nc_oc=Adl6OmP4OOzkoJ9EspioBEB4CdpnyBkfDBPHffl8ggwm5RHeLs0GdtvM82yOBc-6sE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afynj3a16F_l0upyFlM6eFll_2Us604HFZ6c3hGlHYHCZQ&oe=69B6C44F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rUxk5SCav3oQ7kNvwHREzkb&_nc_oc=AdlrMBVYwILIIU9yxKpAIpOzMhhsEkJJuFZ5S69MdI7aHMe-6SFrqgLFwOkxsg-Bkt8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzNPd0_z3lIOcLaPyW-hffbf5-I1AMd_5-4EOUSd831HA&oe=69B6A0FE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_mo
: "1158133397851055", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s-ETVdrcVb4Q7kNvwFNZ8PE&_nc_oc=AdrL7jymUcUI_JCXYk5OAWAen9Q-O8LBBrdhbTGARqInqYrzj7hecF9rzBgHs-tMMVQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTisuh1RP_3OosqoS6TN6LzGzaa5tLCGcnn_7IN0o58mg&oe=6B05A71B"}, {"file_name": "migrated_image.png", "id": "662276847881858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yMnZ63pHm2cQ7kNvwGDsBwn&_nc_oc=AdqCw96GS_uPc9zozH8vN-4TikcZmCKuO0GOJaRxiW7qyQZ1P-ib2gOMg9zmq31Ns1s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCg35nsrzqDTJkhMYtPx3URnT8IQFX_A07FYzMAY2DRg&oe=6B05B63E"}, {"file_name": "migrated_image.png", "id": "142763513777212", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427536_253589715002993_418784534_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vMuYCu5DSiAQ7kNvwFPcbGM&_nc_oc=AdoLE_zfdCY-uisY-nr8eNNRHJSkQUv4djAkBMYeaiH1F3L0n3E6czoXoxfgrZ3C40M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3LTa2dOKh-RBcR8BrOM4XPTny35BpcRvWhAImDr9YTg&oe=6B05AAB4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is an interactive, live-action, horror film, built for the Gear VR. The story follows four characters through a s\u00e9ance gone wrong. As the movie progresses viewers are able to affect the point of view and discover different aspects of a complex story. A proof-of-concept piece, The Presence illustrates two new approaches to VR storytelling: free roam and cinematic. In both versions, the viewer influences how the story unfolds. In the free roam version, the viewer is able to jump between multiple perspectives at will; while in the cinematic version, the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers.", "short_description": "The Presence is an interactive, live-action, horror film following four characters through a s\u00e9ance gone wrong. A proof-of-concept piece, The Presence illustrates two new approaches to VR storytelling: free roam and cinematic. In the free roam version, the viewer is able to jump between multiple perspectives at will; while in the cinematic version, the viewer's gaze motivates the next shot, editing the film organically."}]}, "developer_name": null, "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://pseudoscience.pictures/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "495579938646470"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1406462432985832"}]}, "baseline_offer": {"id": "1406462432985832"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1467183600, "status": "PUBLISHED", "id": "1406462432985832"}]}, "liveChann
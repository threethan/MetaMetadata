RzGW1hqHN8-h4mcJI9Rdo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu4K8sstNgX8bXXxMin36Jx08EwRGODNHFrfazR07bsBQ&oe=699DA993"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFm-lQn0CucQ7kNvwGIiPk5&_nc_oc=AdncfQOX_mY7SxRToKZUFQzs2I3NsTPYjx3TovXCis5D6tIcEwD4qUghPkL_Mz4rjSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvnJg2ruVddKfx4xTMGqnbnLRD0j2zj6E0My9aCBway0Q&oe=699D855B"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utagi6ZmaD8Q7kNvwG1IAF8&_nc_oc=Admjh30dQjM_X2ML2UtAlZ1WgoSijh3WFeGzA3gn-XGmzEipwfxjiZf9K6c4JBmJ8Ec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsWI01QL23m5ASAF5sEwYeWrLMs-i7C1JlZgNUVyp_vdA&oe=699D7F8F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLhCQRh9JCIQ7kNvwH2KfM2&_nc_oc=AdkgxKTsPVfKArUERaNtBOuNo9iuHRfbeVwbbzQlZ1rpVR7b7VM9PuyGFrFdnj3BnNE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs9PyBNSATGgfOtDCZtXheMQV2-raURnU81tPDzjD8cqg&oe=699D947E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7209422042519811"}, "review_messages": []}]}, "c
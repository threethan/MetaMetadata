OX3H9sFxKi74ORLsbLyew&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afs1n-m0Msqt9FSMnAxFihsxmxtqr-tjgJ3e0WlumYPUOg&oe=6999B513"}, {"file_name": "migrated_image.png", "id": "519560692332425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427719_251143921943150_1723034249_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wR0rSR58WuIQ7kNvwHnA9rh&_nc_oc=AdkMUKFD9QH4HTnvH8OQeS5fB_CqWTf3GzdwF8KS5JwStHFbn81ZXbSiPJSeVdVynGQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu9l7_zES8QIOCCJqU6VUcRyYd0EgQdctLNKMbHJAJeYA&oe=699990DB"}, {"file_name": "migrated_image.png", "id": "516226192374346", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522219_1766462830251061_1236096222_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ZuZWR7IBFQQ7kNvwHoCDiv&_nc_oc=Adlu7a4ahnjeRHc65TEcEBzeL8o4RNx4yTz8ZwfptKTI1g2F_9fNAtDFl7ms1GluzZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvyjD1N5Oc2OMp3_zp6P0xCcDlVPEAkjO9Dcs62KwI6UQ&oe=6999C34F"}, {"file_name": "migrated_image.png", "id": "209845970360475", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162754_933758200077438_514500997_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MOB80mK_N0wQ7kNvwERmyV4&_nc_oc=AdkawyUo6WInyPbCfE_40g5pTpee5GbIBKfqYKpCxw5_mLP0BE_SoQ865xFEUNyUaMY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsIUEma1TbNE9dy3FLCrJaoGkHcfqsgB5TaOOwrwLUSlQ&oe=69999FFE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Presence", "keywords": ["Movie", "Film", "Horror", "Interactive", "Seance"], "long_description": "The Presence is a proof-of-concept demonstration showing how interactive elements can make 360\u00b0 films more immersive. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In both versions, the viewer influences how the story unfolds. In the \"active\" version the viewer is able to jump between multiple perspectives at will; while in the \"reactive\" version the viewer's gaze motivates the next shot, editing the film organically.\n\n          Additional storage required:  ~1.5GB\n          Runtime:  ~6 minutes\n\nThe Presence contains strong language and violence and is recommended for a mature audience only.\n\nThe Presence works with the Gear VR touchpad or most Bluetooth controllers. For viewers who have a SubPac, The Presence utilizes SubPac\u2019s tactile audio technology for a more immersive experience.", "short_description": "The Presence is a proof-of-concept demo showing how interactive elements can improve 360\u00b0 films. The story follows four characters through a s\u00e9ance gone wrong. This demo contains two new approaches to VR storytelling: \"active\" and \"reactive.\" In the active version the viewer is able to jump between multiple perspectives at will; while in the reactive version the viewer's gaze motivates the next shot.\n         Additional storage required:  ~1.5GB\n         Runtime:  ~6 minutes"}]}, "developer_name": null, "developer_privacy_policy_url": "http://joshgladstone.com/tos_privacy.htm", "developer_terms_of_service_url": "http://joshgladstone.com/tos_privacy.htm", "publisher_name": "Pseudoscience Pictures", "support_website_url": null, "website_url": "http://joshgladstone.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["HORROR", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7209422042519811"}, "review_messages": []}]}, "c
oc=Ado58-1Mod6fD6gOVUnWNndBkF8UHcOeqeU6NiXpde5XhO9R5jjoaffxZmTVrMgt0rs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bk0LKgLwUPzO_zr1JM3ywSURMzbLmXAfGNkcOMzC7zg&oe=6A4142CC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Amusement", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Narrative", "id": "1008279844328894"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1776326400, "lastRevision": {"nodes": [{"id": "23905152479126427", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "23905152445793097", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "843577364917199"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "10.png", "id": "1955818188316657", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821796_1955818191649990_8357110229350311866_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hkQSRfHGjkIQ7kNvwEgyeTk&_nc_oc=AdpzbhKhBKQP1znVHJmyrgvUyDT0C07TvDSDKIi8mZsFSSmKlVGa7FSifEPJsk-Gqhs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GN0kmnMFoUUvIfw1-K4GHsOQT0cFuRXuOXvbQ5NCJPQ&oe=6A412F9F"}, {"file_name": "11.png", "id": "1112922317671047", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818890_1112922321004380_6670297556650046627_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zoTelKOSnMQ7kNvwE6aLhR&_nc_oc=AdoWC2oTjRy_OVK3I-zrUME3oiRCw-jeK09hyrmfZPF9s4X6nZmHvteLiwOjNPJH7s4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dDhPYkYYSbdEFGI6esrHLfhymhiZsAmrani_R2fu_hA&oe=6A41289E"}, {"file_name": "12.png", "id": "826615449848418", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820441_826615453181751_8011270034550404467_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLPcwcrfRmoQ7kNvwFVkiEi&_nc_oc=Adr9GblTY0bYr2mt-xlhlMzuJX8QctPx-sWI6p2IDgDnJv4jwQN14x5gyLZxq3phy64&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90c9gQi8LoXcTQujMIp0xzg6jUVCRUP_Ya9FF8XHzQ0g&oe=6A41260D"}]}, "id": "2070312817107273", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Amusement", "keywords": ["Steampunk", "Narrative", "Puzzle"], "long_description": "The Amusement ist ein narratives Virtual-Reality-Spiel, in dem der Spieler in die Rolle von Samantha Burkhart schl\u00fcpft. Die 19-J\u00e4hrige wird von ihrer Mutter beauftragt, einen verlassenen Vergn\u00fcgungspark zu inspizieren, den sie von ihrem verstorbenen Vater geerbt hat, und wird dabei von Erinnerungen an ihre Kindheit \u00fcberw\u00e4ltigt. \n\nEINE FAMILIENGESCHICHTE\n\nDie Geschichte von The Amusement spielt in den 1920er Jahren und greift die Narben der Nachkriegszeit. Auf Wunsch ihrer Mutter besucht Samantha den Familienfreizeitpark f\u00fcr eine letzte Inspektion: ein gewundenes Labyrinth, die Ruinen von Atlantis... und nat\u00fcrlich eine Achterbahn! \n\nREDIRECTED WALKING\n\nThe Amusement bietet ein umgeleitetes Walking-Erlebnis: Jeder Schritt, den der Spieler macht, wird sofort ins Spiel \u00fcbertragen. Die Spieler ben\u00f6tigen einen 4 Quadratmeter gro\u00dfen Raum, um sich zu bewegen und die Strukturen des Spiels zu erklimmen.\nBitte beachten Sie, dass es auch m\u00f6glich ist, mit einem klassischen Controller zu navigieren.\n\nINTERAKTIVES GAMEPLAY\n\nDie Spieler k\u00f6nnen Objekte manipulieren, um nach Hinweisen zu suchen und ihren Weg durch den Park zu finden. Die virtuelle Realit\u00e4t erm\u00f6glicht eine bessere Interaktion mit der Umgebung und damit eine ganzheitliche und konkrete L\u00f6sung der R\u00e4tsel.\n\nFeatures\n\n- Vintage-Kulisse, inspiriert von Vergn\u00fcgungsparks der 1920er Jahre\n- Redirected-Walking-Technologie \n- Eine komplexe Geschichte \u00fcber famili\u00e4re Beziehungen\n- Interaktive R\u00e4tsel", "short_description": "Ein verlassener  Freizeitpark, vergessene Erinnerungen, eine durch den Ersten Weltkrieg zerr\u00fcttete Familie \u2026 Erleben Sie eine intensive, introspektive Geschichte in diesem VR-Abenteuer mit \u201eRedirected Walking\u201c, bei dem jeder Schritt z\u00e4hlt."}, {"images": {"nodes": [{"file_name": "15.png", "id": "4346369625688046", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824318_4346369635688045_9204078318444334085_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rIZ4fLNjw80Q7kNvwHPXWR7&_nc_oc=AdqEVR6JaEMQfGUVxEsdmuAwC1pfV6qP0RMf11S5JFg6YF3aEc9D9DDi16-alQfdyao&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_h9W5LoLehp0hxqQxIcN4YUjm64o4R3oJJ6pG3nd2nrg&oe=6A413D36"}, {"file_name": "9.png", "id": "1142834167938262", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491828008_1142834171271595_1098076437052338993_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=21bZ95PMpd4Q7kNvwHmhumN&_nc_oc=AdoYZdBhjd0TKWOJQgzNTBAk6yjnzv8y_NxtQezwsNIZRZPmsVbezlQtoKsZkbDbCQg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YbI8w9WRtZqu7h2kylRIoks3WKvg2Q4HooIum8tnZrw&oe=6A412E07"}, {"file_name": "8.png", "id": "836704732110898", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821081_836704735444231_3846951666287659488_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6yb9_ukFB4IQ7kNvwHOG3rg&_nc_oc=AdqbRnj7cpshFiGjYqK8KkGSt6HJJWn5pWw4tvN-o34SLFuRo9Yc_lQc6mjNetPRszA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oCfWXyZbFIFmhp3VgBK2T0rz9UA89ZgjPHgBeGtJPpQ&oe=6A41159C"},
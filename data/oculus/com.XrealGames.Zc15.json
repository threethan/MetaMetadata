2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRP7ESSdATTsbWgXgEAcUyNoROmuwP74391BU20uC2I2g&oe=6AF49DB5"}, {"file_name": "ZeroCaliber2_Screenshot_03_2560x1440.png", "id": "688981123354563", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974507_688981126687896_6736655473577228057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyMb7oQoBAwQ7kNvwF33ERv&_nc_oc=AdoxTSK32bC6_K3HR9iYuh-_ybEXtr7pcorsOOmJm9XGIMP_HVpQmpHjrte3yQCYY98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsqBTGNI9lOjTpchBdIWLYewt7u6gaihQHCojbQvfwDQ&oe=6AF487D6"}, {"file_name": "ZeroCaliber2_Screenshot_04_2560x1440.png", "id": "780519374202336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001680_780519377535669_5621174576393243075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQYaaFulIQ0Q7kNvwH2pbap&_nc_oc=AdoTwgsxU8QQX7N57EOMYxR7UDKeGzR7fQ7slHe-Pp4Bcdn-HgsJkEjx1DocNiugjj0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTThwm7TIdc30hXrBWWGcxtGKRYiuZw8PhQ7mYyNham-w&oe=6AF49749"}, {"file_name": "ZeroCaliber2_Screenshot_05_2560x1440.png", "id": "2579849238870307", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031400_2579849242203640_4717901026076490611_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ny9EZ-zjM_UQ7kNvwHCBgfO&_nc_oc=Adr9ZRUebGGs1l3jMc_7haBtcNmndLQjYd2U0Q9Wl6TbQLosukJBfV5EaexIsInMlag&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThZ5L3Y5KiapaeNAeqOT8U6P0DpmhdrCNMesbcwZgqjg&oe=6AF47664"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zc2_NewArt_Landscape.png", "id": "2962008947490451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_2962008950823784_9117324633707168377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ygtk99mKjR0Q7kNvwHRtyIX&_nc_oc=AdrbwhWy7mAQBLqLU3Y1zDS8yuaml64VaHuRZby7uK3BQ16erAFHEfrdq_mjveU7X9U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTIi_U7ZTPL1PXpE13hU3YbbTkL-nuzA7wS4bgcHfsaw&oe=6AF47C63"}, "display_name": "Zero Caliber 2", "keywords": ["coop", "shooter", "story", "military", "campaign"], "long_description": "\u2728 **Now with ENHANCED Quest 3/3S visuals and smoother gameplay!** \u2728\n\n# \ud83d\udd11 KEY FEATURES\n\nZero Caliber 2 is THE ultimate VR shooter package:\n\n- 8+ hour **solo campaign** fully playable in **Co-op** (up to 4 players)\n\n- Classic **multiplayer game modes** (up to 10 players)\n\n- Native **mod support**\n\n- **60+ unlockable weapons**, skins, and attachments\n\n- Gripping story full of cinematic action reminescent of classic FPS games\n\n{888829013066754}\n\n# \ud83d\udcd6 THE STORY\n\nIn a world where water is scarce, a ruthless dictator, Barak, and his fanatic followers threaten the fragile peace of the OSA. Their brutal invasion aims to control the vital WELL water supplies, putting millions at risk.\n\n{1153668505934186}\n\nAs a **skilled operative**, your task is to navigate a war-torn landscape and undertake high-stakes missions to reclaim the stolen WELL supplies. **Fight** through cities and remote villages, face ruthless enemies, and uncover a web of betrayal and chaos. **The fate of the OSA is in your hands** - fight to end Barak\u2019s reign of terror and secure humanity\u2019s future!\n\n{689968696629104}\n\n# \ud83d\udd2e WHAT'S NEXT?\n\nZero Caliber 2's release is only the beginning - help us shape the future of the Zero Caliber IP by joining our community and sharing your feedback/suggestions!\n\n\ud83d\udc49 https:// discord.gg/xrealgames \ud83d\udc48\n\nFor technical issues: support@xrealgames.com\n\n\u23af\u23af\u23af\u23af\u23af\n\nCheck out, and wishlist COVR, our new upcoming tactical shooter here: \nhttps://www.meta.com/experiences/covr/26564910626481959/ \n\n{1475791441029449}", "short_description": "8+ hour single player/Co-op campaign, cinematic action, explosions, 60+ weapons and skins to unlock, PvP, mods, airstrikes, all in one single package - this is Zero Caliber 2, the sequel to our critically acclaimed Zero Caliber: Reloaded military shooter. See you on the virtual battlefields! o7"}]}, "developer_name": "XREAL Games", "developer_privacy_policy_url": "https://sites.google.com/xrealgames.com/aboutus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://sites.google.com/xrealgames.com/aboutus", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28179875318288618"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1091061796786944_1444540195421727020_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEIroyyNzqIQ7kNvwHOZf6_&_nc_oc=AdpMGxS8cqibLiuW51xp4a8o0klOml06Fnz-rIlIuzPHSyzI-r_H-ic71BpInonx8qI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTlgLWis6zUWhnLR10a1VzpErG84Eso6hRMNRJQ5JINXg&oe=6AF4766A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zero Caliber 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Narrative", "id": "1008279844
HtRpLj9ykQ7kNvwFxx0sA&_nc_oc=Ado11q69f1TqQYzpPxr87-TtzWkcLiI2__VDcoVOQyY5WJBxfH8t1z2Fws99vRwiFzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKf830XRhNuzv63Sp1C6ZKG__Nom-Fid72eqCoqNFtsgg&oe=6AAA9175"}, {"file_name": "ZeroCaliber2_Screenshot_03_2560x1440.png", "id": "688981123354563", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974507_688981126687896_6736655473577228057_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gkrZDmFOY0wQ7kNvwHI6bR8&_nc_oc=AdrLqHATFgcv2FT5Sal-vJ1EUZR9YHmYV1KDvvxhaQPr9e2PQ4pLbHvGhw6oczdOqrY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLK9sqAIprXit9DiiQU_oOPlqWoiEw1t83wVep6jayMIg&oe=6AAAB3D6"}, {"file_name": "ZeroCaliber2_Screenshot_04_2560x1440.png", "id": "780519374202336", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001680_780519377535669_5621174576393243075_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTYwpjf7ExMQ7kNvwGrNq8u&_nc_oc=Ado874axUk1nYEVnaOyBzHkdDSA9VidhcrmgeUdZx7fnGYhwE12QipH8by0zbE_ceLk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUPw3yFyyjiVJIoU_ZrSZKxLWreln9nui0hGLcB1VyuA&oe=6AAA8B09"}, {"file_name": "ZeroCaliber2_Screenshot_05_2560x1440.png", "id": "2579849238870307", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031400_2579849242203640_4717901026076490611_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3hNsbORH_IQ7kNvwHrziiz&_nc_oc=AdrP1pJJpYkwRIV2qu6RWxdVdjT2wTvK5HtX754iB8uivB4SMeEBKhK98wlQ8iMQGNY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmH8zzuzW4Jsi-5YB7oAFV0CaV4oYPyt3NDL3OI33v4g&oe=6AAAA264"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zc2_NewArt_Landscape.png", "id": "2962008947490451", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825462_2962008950823784_9117324633707168377_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KxMDBpFdMqwQ7kNvwEohl-5&_nc_oc=AdpPTNU9gokfkV7tl3ZyM0MfEcvwVdAvtY3vvmiv1OevoJFerUyv8Zl2YUG9BMBWpiw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxE7Pi-K_xJh0UwSZQpQMpAJtg9ELnAHfQuL9n-UWu2A&oe=6AAAA863"}, "display_name": "Zero Caliber 2", "keywords": ["coop", "shooter", "story", "military", "campaign"], "long_description": "\u2728 **Now with ENHANCED Quest 3/3S visuals and smoother gameplay!** \u2728\n\n# \ud83d\udd11 KEY FEATURES\n\nZero Caliber 2 is THE ultimate VR shooter package:\n\n- 8+ hour **solo campaign** fully playable in **Co-op** (up to 4 players)\n\n- Classic **multiplayer game modes** (up to 10 players)\n\n- Native **mod support**\n\n- **60+ unlockable weapons**, skins, and attachments\n\n- Gripping story full of cinematic action reminescent of classic FPS games\n\n{888829013066754}\n\n# \ud83d\udcd6 THE STORY\n\nIn a world where water is scarce, a ruthless dictator, Barak, and his fanatic followers threaten the fragile peace of the OSA. Their brutal invasion aims to control the vital WELL water supplies, putting millions at risk.\n\n{1153668505934186}\n\nAs a **skilled operative**, your task is to navigate a war-torn landscape and undertake high-stakes missions to reclaim the stolen WELL supplies. **Fight** through cities and remote villages, face ruthless enemies, and uncover a web of betrayal and chaos. **The fate of the OSA is in your hands** - fight to end Barak\u2019s reign of terror and secure humanity\u2019s future!\n\n{689968696629104}\n\n# \ud83d\udd2e WHAT'S NEXT?\n\nZero Caliber 2's release is only the beginning - help us shape the future of the Zero Caliber IP by joining our community and sharing your feedback/suggestions!\n\n\ud83d\udc49 https:// discord.gg/xrealgames \ud83d\udc48\n\nFor technical issues: support@xrealgames.com\n\n\u23af\u23af\u23af\u23af\u23af\n\nCheck out, and wishlist COVR, our new upcoming tactical shooter here: \nhttps://www.meta.com/experiences/covr/26564910626481959/ \n\n{1475791441029449}", "short_description": "8+ hour single player/Co-op campaign, cinematic action, explosions, 60+ weapons and skins to unlock, PvP, mods, airstrikes, all in one single package - this is Zero Caliber 2, the sequel to our critically acclaimed Zero Caliber: Reloaded military shooter. See you on the virtual battlefields! o7"}]}, "developer_name": "XREAL Games", "developer_privacy_policy_url": "https://sites.google.com/xrealgames.com/aboutus/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://sites.google.com/xrealgames.com/aboutus", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "28179875318288618"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823783_1091061796786944_1444540195421727020_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CTkx4UrdX8Q7kNvwE1JTRg&_nc_oc=Ado7IJiajJ7-3f1yZP6HxUjZ_Ion9kdD2wTJFH5G68lLfBRgwPf1XuoJeLbSPgFeDzo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIh15RCydISMpDqJk9yHc4SMlW1vztDukKKHPYyjzcgw&oe=6AAAA26A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Zero Caliber 2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shoote
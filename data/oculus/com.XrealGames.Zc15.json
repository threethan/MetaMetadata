_ohc=fliNqizrEYUQ7kNvwGrS2S2&_nc_oc=AdqAuIAQONsD_o5l46LPtnLUWfZcaqnplBlyMTeUkO32XEJvDckRUajJjlWscB66W3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNSQWPDC81XoAmcwFEbYAgVPomBq-7bOczMejucZLLNw&oe=6B05CF98"}, {"file_name": "ZeroCaliber2_Screenshot04.png", "id": "798871275584847", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974614_798871278918180_1423763732982701246_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-L8FjgyMsw0Q7kNvwE7ZySf&_nc_oc=Adq-y3HrmQXHpLCCdfBa_a7bPUZiBVd_ASpQV8TyJ1T1Tcy4fga0ezA0Mbn9vgORKfI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWCpEQ6fHNqm1JIoKja2jh1nx5RLuEVbL7uBVeKGYpww&oe=6B05BFAB"}, {"file_name": "ZeroCaliber2_Screenshot05.png", "id": "239766985659915", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75334066_239766988993248_484809953301683563_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XmzGYocr5sQ7kNvwHIlc-c&_nc_oc=Adqct55_4W-Z8OJW9SwhvmRUx2ULZKD81N5s6zmUJZ3nNmlgKqug2Sw6dG0beEvTPcA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpwCnrFKKnoFJbZhQpiTfMJCT2Lyn1UTgGyUFpxlNF7A&oe=6B05D23A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZeroCaliber2_CoverArt_Landscape_2560x1440.png", "id": "219203984540676", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38984447_219203987874009_6483626324491434520_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YeqJwRQBVEgQ7kNvwFW40r8&_nc_oc=Adrsna1bZ3IB5qeduqCbE6grbx-HMSoppAPFXwNVHxlDbv7nHQ1pJNazuib1o1dRduQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3oyd7C8R7Yj48FfAaXXH5zfBA0NE6swxtErb61ISIPw&oe=6B05B0DA"}, "display_name": "Zero Caliber 2", "keywords": ["coop", "shooter", "story", "military", "campaign"], "long_description": "We can't save the world alone, the OSA needs you soldier - enlist NOW by wishlisting Zero Caliber 2 in the Meta Quest store! \n\n### THE SEQUEL ###\n\nYour favorite all-in-one VR FPS made infinitely better! Get ready to experience the thrill of your virtual life in Zero Caliber 2, the sequel to our critically acclaimed Zero Caliber: Reloaded military shooter! \n\nCinematic action, explosions, tons of weapons to unlock, a full-blown single player/Co-op campaign (taking place after the events of the prequel), PvP, native mod support, zombies, airstrikes, more explosions and a VR experience you'll never forget! \n\nComing to your Meta Quest in 2024.\n\n### COMMUNITY ###\n\nTo participate in future playtests, catch sneak peeks and behind the scenes, join our awesome community on Discord: \n-> discord.gg/xrealgames <- \n\nAnd follow us on: \n- Facebook: https://www.facebook.com/XREALGamesVR\n- X: https://twitter.com/ZeroCaliber2\n- YouTube: https://www.youtube.com/@XREALGamesVR\n- TikTok: https://www.tiktok.com/@xrealgames ", "short_description": "Get ready to experience the thrill of your virtual life in Zero Caliber 2, the sequel to the critically acclaimed Zero Caliber: Reloaded military shooter! \nCinematic action, explosions, tons of weapons to unlock, a full-blown single player/Co-op campaign, PvP, airstrikes, more explosions and a VR experience you'll never forget! Coming in 2024."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
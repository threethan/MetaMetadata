stgv-tgg&oe=6AA93E6B"}, {"file_name": "ZeroCaliber2_Screenshot05.png", "id": "239766985659915", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/75334066_239766988993248_484809953301683563_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8ydGPBY3UIQ7kNvwHHW7Sl&_nc_oc=AdqCIm0CRf2r7nDcUIHHF6sqYZj4lU1DHyT7oDDK_NlEr0QAay0Z0QzlgHwQWbZp0T0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeXgvc_Cy51WFSTkixX6QJmFJPdgEShkgrKcPYazaisA&oe=6AA950FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ZeroCaliber2_CoverArt_Landscape_2560x1440.png", "id": "219203984540676", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/38984447_219203987874009_6483626324491434520_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clI120fWOc4Q7kNvwFvJFGF&_nc_oc=AdrgLJtB7wJaZPpha-cqX8KDiZyu4JjCvatbqsx-xyDYtGdhKue3m-kjZjZkkH-LGno&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1ApAwQOg0AOWn_HGw37cBnV-nmQ7tLR7CCcJYvFwzGQ&oe=6AA967DA"}, "display_name": "Zero Caliber 2", "keywords": ["coop", "shooter", "story", "military", "campaign"], "long_description": "We can't save the world alone, the OSA needs you soldier - enlist NOW by wishlisting Zero Caliber 2 in the Meta Quest store! \n\n### THE SEQUEL ###\n\nYour favorite all-in-one VR FPS made infinitely better! Get ready to experience the thrill of your virtual life in Zero Caliber 2, the sequel to our critically acclaimed Zero Caliber: Reloaded military shooter! \n\nCinematic action, explosions, tons of weapons to unlock, a full-blown single player/Co-op campaign (taking place after the events of the prequel), PvP, native mod support, zombies, airstrikes, more explosions and a VR experience you'll never forget! \n\nComing to your Meta Quest in 2024.\n\n### COMMUNITY ###\n\nTo participate in future playtests, catch sneak peeks and behind the scenes, join our awesome community on Discord: \n-> discord.gg/xrealgames <- \n\nAnd follow us on: \n- Facebook: https://www.facebook.com/XREALGamesVR\n- X: https://twitter.com/ZeroCaliber2\n- YouTube: https://www.youtube.com/@XREALGamesVR\n- TikTok: https://www.tiktok.com/@xrealgames ", "short_description": "Get ready to experience the thrill of your virtual life in Zero Caliber 2, the sequel to the critically acclaimed Zero Caliber: Reloaded military shooter! \nCinematic action, explosions, tons of weapons to unlock, a full-blown single player/Co-op campaign, PvP, airstrikes, more explosions and a VR experience you'll never forget! Coming in 2024."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xrealgames.com/pp/", "developer_terms_of_service_url": null, "publisher_name": "XREAL Games", "support_website_url": null, "website_url": "https://www.xrealgames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "6870927629610029"}}]}, "scheduled_offers": {"count": 33, "nodes": [{"status": "PUBLISHED", "id": "1569575884903910"}, {"status": "PUBLISHED", "id": "1731571537996011"}, {"status": "PUBLISHED", "id": "986913017648290"}, {"status": "CANCELLED", "id": "1760515418164813"}, {"status": "PUBLISHED", "id": "4401837690035045"}, {"status": "PUBLISHED", "id": "4245744415673948"}, {"status": "PUBLISHED", "id": "803238236155497"}, {"status": "CANCELLED", "id": "2328727097623065"}, {"status": "PUBLISHED", "id": "1530242358060136"}
4_5793456541900780880_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NXR5bUAksM8Q7kNvwGWQT89&_nc_oc=AdrxBcVPdTeBPRTvQO_81f-02F9O2RSRrU5-Jwn6qIgabUvtPTO4hQ_KU1HgJA97Ku8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7TPFfbTrMrXYoDQDILrobNsBLnoSs6KDO2fdrE6ZMRg&oe=6A999CD9"}, {"file_name": "Screenshot-04.png", "id": "609070458597730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391889_609070465264396_3308108535597157740_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yhKViljATcQ7kNvwG3qp3m&_nc_oc=AdqsgsNGQZMeicm1tgsLwpVC6LUNFbSKBro8HKEknXwOJmD9uzRKdzWm5pVD3GBG7-Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoSKudba_wS7WoNP6Wl-SiV4yrYRTPZCElGDWzPWp2xw&oe=6A998451"}, {"file_name": "Screenshot-05.png", "id": "1159158672287028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391961_1159158678953694_2132414481320873297_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hflpd3_--B0Q7kNvwGMpB4r&_nc_oc=AdpMiPCulTeExCW_LOHMu9AYU-a6keNZk7eSPP5Dts14-RRx_ffqwBdfadx5ejji6zY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlNbe2-xREXUPwIlAr0WDf17cXt6rdWFjARHukP8A7HA&oe=6A9997E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_01.png", "id": "2764468163753905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392317_2764468167087238_4350391818497520352_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCxpYlPyvGYQ7kNvwGMWunu&_nc_oc=Adr8PFcpOQLcQkX4KeERo7tVicl1fIZFk05oeeMoMg0QeSY7w-xz4GlmURkTVAZ93h4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLw_857IHZdxx4vIock_8JZjPGL-uLjZsa39WOp9Nuu5w&oe=6A99928A"}, "display_name": "Archery Master", "keywords": ["Archery", "Sports", "Simulation", "PartyGame", "VR"], "long_description": "Ready to channel your inner Robin Hood (minus the tights)? Dive into \"Archery Master VR,\" the ultimate single-player virtual reality archery game. Immerse yourself in various game modes, including Challenge Mode, Target Practice, Drone Shoot and Survival Mode\u2014each more exciting than the last!\n\nWith jaw-dropping visuals and sound so immersive you'll think you've been teleported to Sherwood Forest, every shot you take feels incredibly real. Our dynamic AI opponents are ready to keep you on your toes, making every playthrough an exhilarating experience.\n\nCustomize your archery gear with a range of bows because why settle for standard when you can be legendary?\n\nBecome the ultimate archery master in a virtual world that combines precision, skill, and a dash of adventure. Download \"Archery Master VR\" now and start your journey towards archery greatness!", "short_description": "Archery Master VR\" is a single-player virtual reality archery game that offers an immersive and challenging experience. Available exclusively on the Meta Store, the game features various game modes, realistic graphics, and dynamic AI integration. Experience the thrill of archery in virtual reality with \"Archery Master VR.\""}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/archerymaster-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE
4_5793456541900780880_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SpnnIn5UriUQ7kNvwHq9nNS&_nc_oc=Adp7v3rXmP8WfF2aACW_vjkAfXhSkmDLDm9fVamNijJB9KOTThn7M55YjAtNbCBfQjU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYPphTWBI57gYS4rk54A16kuE2Aor4hUaZ94GFVaamBg&oe=6A941E99"}, {"file_name": "Screenshot-04.png", "id": "609070458597730", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391889_609070465264396_3308108535597157740_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vcm5BqlIlHQQ7kNvwHUuMH1&_nc_oc=AdrmgQbBXH-MZVjsfsNe69TqnopDYi5LEcSpIbDFCMgAPNMWyEM5Kv6xQSDt5B6NiVY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_VfHqWaqosHpNpkxlptlkEdCXVgs12awKxrQCUo8Umw&oe=6A940611"}, {"file_name": "Screenshot-05.png", "id": "1159158672287028", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473391961_1159158678953694_2132414481320873297_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qg2wheHUUnQQ7kNvwGR4GhQ&_nc_oc=AdpYLfmBeI75wXfauFEiyw_HJi6h5GNpwwJWzHLWNaDSUlGanjoQBZuaoJx3_pLL4jw&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbBmpjEqYOG_8DH_oy--kG0farObOEFLlRxFtPQJSbgQ&oe=6A9419A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_01.png", "id": "2764468163753905", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/473392317_2764468167087238_4350391818497520352_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFa_eHLOfukQ7kNvwFDsjiq&_nc_oc=AdpTySDLxLXh0c9WNgVby4IJtDqmHu1dbs17Nw2KusyhDTl2hYuLv968bNrRFxF8tN8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLtkj5QsMvs7zkBNWvV_bFmUoQUp2cUUS7UdJcxAwYqQ&oe=6A94144A"}, "display_name": "Archery Master", "keywords": ["Archery", "Sports", "Simulation", "PartyGame", "VR"], "long_description": "Ready to channel your inner Robin Hood (minus the tights)? Dive into \"Archery Master VR,\" the ultimate single-player virtual reality archery game. Immerse yourself in various game modes, including Challenge Mode, Target Practice, Drone Shoot and Survival Mode\u2014each more exciting than the last!\n\nWith jaw-dropping visuals and sound so immersive you'll think you've been teleported to Sherwood Forest, every shot you take feels incredibly real. Our dynamic AI opponents are ready to keep you on your toes, making every playthrough an exhilarating experience.\n\nCustomize your archery gear with a range of bows because why settle for standard when you can be legendary?\n\nBecome the ultimate archery master in a virtual world that combines precision, skill, and a dash of adventure. Download \"Archery Master VR\" now and start your journey towards archery greatness!", "short_description": "Archery Master VR\" is a single-player virtual reality archery game that offers an immersive and challenging experience. Available exclusively on the Meta Store, the game features various game modes, realistic graphics, and dynamic AI integration. Experience the thrill of archery in virtual reality with \"Archery Master VR.\""}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/archerymaster-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE
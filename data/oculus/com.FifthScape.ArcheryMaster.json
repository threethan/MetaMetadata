185831167674_5793456541900780880_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3o6ACBhkEwQ7kNvwE65ZtQ&_nc_oc=Adrr14A5CkDbLXZVwY8uKAr6Gf_fe3B22_WLNzgBmcAM5PZhn94nZ73hUZqcAQmC6gc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHeYZtDnIC7PAbAiqRbGjk1WClEWhBnsI4BHVpjiVW8w&oe=6A859E19"}, {"file_name": "Screenshot-04.png", "id": "609070458597730", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/473391889_609070465264396_3308108535597157740_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHxwz9ebZuMQ7kNvwHKQArt&_nc_oc=Adp_20ypDElNksqEdEUEkuRdyuvIRxlQJWF-Vw_FgaZ8U8nBJUH7nDeo9lFgzgjeqpI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqeCH_yyEGjwRMP3mHJasetRSBHTrHv2PPzsu_nAbOvw&oe=6A858591"}, {"file_name": "Screenshot-05.png", "id": "1159158672287028", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473391961_1159158678953694_2132414481320873297_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGdoMbhiR2gQ7kNvwFzu8_B&_nc_oc=Adq57GLv9_zPxXUoDbDpL4iJOUhwj4ZIuBjrf_CtBs8yx2v8p2Fba7UIna1TH6fkgcw&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHldVp_1ugaryMBI3XTgj3FQpc6p4c--cd21jYIU24TQg&oe=6A859924"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_01.png", "id": "2764468163753905", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/473392317_2764468167087238_4350391818497520352_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZYA7OSjpd8Q7kNvwHG3efl&_nc_oc=Adr6PMc_ywNXsgox9Pe002O3Eii22pAhtt0rkEYPFMcvKvYYoxn-Y-BHOgSynXegbF8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpMKf4CkvYixD8MxAanayq1ivycTDSa_4F-er4MgWZ5A&oe=6A8593CA"}, "display_name": "Archery Master", "keywords": ["Archery", "Sports", "Simulation", "PartyGame", "VR"], "long_description": "Ready to channel your inner Robin Hood (minus the tights)? Dive into \"Archery Master VR,\" the ultimate single-player virtual reality archery game. Immerse yourself in various game modes, including Challenge Mode, Target Practice, Drone Shoot and Survival Mode\u2014each more exciting than the last!\n\nWith jaw-dropping visuals and sound so immersive you'll think you've been teleported to Sherwood Forest, every shot you take feels incredibly real. Our dynamic AI opponents are ready to keep you on your toes, making every playthrough an exhilarating experience.\n\nCustomize your archery gear with a range of bows because why settle for standard when you can be legendary?\n\nBecome the ultimate archery master in a virtual world that combines precision, skill, and a dash of adventure. Download \"Archery Master VR\" now and start your journey towards archery greatness!", "short_description": "Archery Master VR\" is a single-player virtual reality archery game that offers an immersive and challenging experience. Available exclusively on the Meta Store, the game features various game modes, realistic graphics, and dynamic AI integration. Experience the thrill of archery in virtual reality with \"Archery Master VR.\""}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/archerymaster-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_U
4_5793456541900780880_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vnQf7paIRpMQ7kNvwGtGZNh&_nc_oc=AdpWiCXMpd2HsXTNw6d63n93s1xZcYE16KbMypfhOun9AK7X8U_eTVGgOzPlccf_tYY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-BFgLX7G6AWfDfadCdw1kmk9TVVS9iLm2SSejwGF0dg&oe=6ACBB5D9"}, {"file_name": "Screenshot-04.png", "id": "609070458597730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391889_609070465264396_3308108535597157740_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8VMHi66WjzwQ7kNvwGuntni&_nc_oc=AdpDnA0HtbqMenZwhrezDmTDDcAtaDtLiQIeD5Y9ByY1UWM8bqN9np3SLpA78fSoF98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAJTNpl4rk8_1P_rCooDCouyK7LbsYWMf_YjctQ_NMQA&oe=6ACB9D51"}, {"file_name": "Screenshot-05.png", "id": "1159158672287028", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473391961_1159158678953694_2132414481320873297_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hIIDGe5YJcwQ7kNvwH8pTYH&_nc_oc=AdpIi27cPBTr3J2GW4FuaYfw8U5S_g4eqqTDrhFZxeUOwh4i4eUJ_CvOqsXvlgyraQI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM-oXBm5LO71mOBlucH1KkEingBlfcRB_Th4E2v2TqYhQ&oe=6ACBB0E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_01.png", "id": "2764468163753905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392317_2764468167087238_4350391818497520352_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDK8XNCtRo4Q7kNvwHOYjQF&_nc_oc=AdqbQYY35bG_QJoVEXy3VqLpGthzLHfTzwpaDURlLMTF56iK3m2d-CzBXmKPRFNuaRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmGvPVfqzf9cY0NwHF7wnDpg3Fa6wAV3zG7D_UO620fA&oe=6ACBAB8A"}, "display_name": "Archery Master", "keywords": ["Archery", "Sports", "Simulation", "PartyGame", "VR"], "long_description": "Ready to channel your inner Robin Hood (minus the tights)? Dive into \"Archery Master VR,\" the ultimate single-player virtual reality archery game. Immerse yourself in various game modes, including Challenge Mode, Target Practice, Drone Shoot and Survival Mode\u2014each more exciting than the last!\n\nWith jaw-dropping visuals and sound so immersive you'll think you've been teleported to Sherwood Forest, every shot you take feels incredibly real. Our dynamic AI opponents are ready to keep you on your toes, making every playthrough an exhilarating experience.\n\nCustomize your archery gear with a range of bows because why settle for standard when you can be legendary?\n\nBecome the ultimate archery master in a virtual world that combines precision, skill, and a dash of adventure. Download \"Archery Master VR\" now and start your journey towards archery greatness!", "short_description": "Archery Master VR\" is a single-player virtual reality archery game that offers an immersive and challenging experience. Available exclusively on the Meta Store, the game features various game modes, realistic graphics, and dynamic AI integration. Experience the thrill of archery in virtual reality with \"Archery Master VR.\""}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/archerymaster-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE
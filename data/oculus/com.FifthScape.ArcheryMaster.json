0_AQRyKzNx0HimbotJEV53I10y7wMKbE5SHdamIFfJVbw-lw&oe=6B0DA9EF"}, {"file_name": "Screenshot-03.png", "id": "646185827834341", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473400726_646185831167674_5793456541900780880_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BNl-KyayGwQ7kNvwEkjOHJ&_nc_oc=AdrCwur5JpTgyF_7TNj6VY1dqZCRyIKCJL2wVUsSqOPpmWO7yZK6hP1VU8oV0Y43f_M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTc1LZDzRhR3qNbJ2H2YftD83U8r0iHQyZ7I4AtSjDFQQ&oe=6B0DA0D9"}, {"file_name": "Screenshot-04.png", "id": "609070458597730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391889_609070465264396_3308108535597157740_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39vMmSXqSeEQ7kNvwGU8iUC&_nc_oc=AdqOQXbIcxp2FZJ1fWYVVXvfk60p86v6o9CTf9MBGqjldhV_Nb4iOj6D45T7yWWEVJ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQB9vVV9oDamZwnWn5A69fKO9-6--WZMEU_B3IKAuExaw&oe=6B0DC091"}, {"file_name": "Screenshot-05.png", "id": "1159158672287028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391961_1159158678953694_2132414481320873297_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zaPMWNb__U4Q7kNvwGItaZ5&_nc_oc=AdocmTUDUxvY3rb5q3ZFe5sP5_zfytsg2DSP-VIZGxPJobISDJtVl4rtrdDTwm0TGOE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTCvPuRECnZ7sNiu6M23SKu0gA9Tj38pll_I304a6DgwA&oe=6B0D9BE4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_01.png", "id": "2764468163753905", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473392317_2764468167087238_4350391818497520352_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XALvkcRizzIQ7kNvwG9G1du&_nc_oc=AdqgyNCOhn6JPd90w6YyBtOVkDEb9w0L8kOwpwhHFil-BRZ4FDB6aoWwExP_6uvzkZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSNrR0DQ6H2JkJSFCNxAbrUaYZ0-pDV05lK4fUP4D2yvQ&oe=6B0DCECA"}, "display_name": "Archery Master", "keywords": ["Archery", "Sports", "Simulation", "PartyGame", "VR"], "long_description": "Ready to channel your inner Robin Hood (minus the tights)? Dive into \"Archery Master VR,\" the ultimate single-player virtual reality archery game. Immerse yourself in various game modes, including Challenge Mode, Target Practice, Drone Shoot and Survival Mode\u2014each more exciting than the last!\n\nWith jaw-dropping visuals and sound so immersive you'll think you've been teleported to Sherwood Forest, every shot you take feels incredibly real. Our dynamic AI opponents are ready to keep you on your toes, making every playthrough an exhilarating experience.\n\nCustomize your archery gear with a range of bows because why settle for standard when you can be legendary?\n\nBecome the ultimate archery master in a virtual world that combines precision, skill, and a dash of adventure. Download \"Archery Master VR\" now and start your journey towards archery greatness!", "short_description": "Archery Master VR\" is a single-player virtual reality archery game that offers an immersive and challenging experience. Available exclusively on the Meta Store, the game features various game modes, realistic graphics, and dynamic AI integration. Experience the thrill of archery in virtual reality with \"Archery Master VR.\""}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/archerymaster-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT
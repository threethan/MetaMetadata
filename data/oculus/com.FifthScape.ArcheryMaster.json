4_5793456541900780880_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qovDQzyLU00Q7kNvwHbsjzn&_nc_oc=Adotf3f789xvPCfVpd0t9j69XDRmo6gqaxwXKFZ50M-uotzP9flfVZjzVfaJ1E3t7l4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIs8laZkxXL35oNuN6b8XmMidk3zKSTdMlO1AF-kSpJTA&oe=6A9AEE59"}, {"file_name": "Screenshot-04.png", "id": "609070458597730", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391889_609070465264396_3308108535597157740_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XkGc0QAJfqIQ7kNvwG9YzLA&_nc_oc=Adp3XeHDlikswL-HIpOI95BuqaeWgxs5QUY5S_htkUfM5CwEA75q6fxi5gVwTtOvXGE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoNBZvZu3NrK9ewCeAYnea96wkkfkZo8cu-NB_7pmlWw&oe=6A9AD5D1"}, {"file_name": "Screenshot-05.png", "id": "1159158672287028", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391961_1159158678953694_2132414481320873297_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hflpd3_--B0Q7kNvwE8dbkr&_nc_oc=AdpdQhY0pfofCNz1_cWM3pflTZGz3wiA2CQx7GKw0ImiuQHDS6v21GgODIuZQM21Q2M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9N-3iSCwIFBqR5iG-u1BbN0921onG7a-s4iNoJCCKOA&oe=6A9AE964"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_01.png", "id": "2764468163753905", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392317_2764468167087238_4350391818497520352_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sCxpYlPyvGYQ7kNvwFNvi_z&_nc_oc=AdqB1b_0-LqnnD7zPDHoPdn3FnaSJjW7yNLszaoT4qi-_FPCt1W1dft_oQ6IMmi_tsM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbV-1-g_9omW0iuZzNlujhM0Qk252MkOYU5dpVqNhCHw&oe=6A9AE40A"}, "display_name": "Archery Master", "keywords": ["Archery", "Sports", "Simulation", "PartyGame", "VR"], "long_description": "Ready to channel your inner Robin Hood (minus the tights)? Dive into \"Archery Master VR,\" the ultimate single-player virtual reality archery game. Immerse yourself in various game modes, including Challenge Mode, Target Practice, Drone Shoot and Survival Mode\u2014each more exciting than the last!\n\nWith jaw-dropping visuals and sound so immersive you'll think you've been teleported to Sherwood Forest, every shot you take feels incredibly real. Our dynamic AI opponents are ready to keep you on your toes, making every playthrough an exhilarating experience.\n\nCustomize your archery gear with a range of bows because why settle for standard when you can be legendary?\n\nBecome the ultimate archery master in a virtual world that combines precision, skill, and a dash of adventure. Download \"Archery Master VR\" now and start your journey towards archery greatness!", "short_description": "Archery Master VR\" is a single-player virtual reality archery game that offers an immersive and challenging experience. Available exclusively on the Meta Store, the game features various game modes, realistic graphics, and dynamic AI integration. Experience the thrill of archery in virtual reality with \"Archery Master VR.\""}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/archerymaster-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE
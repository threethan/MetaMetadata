0_AQRKPjFj9rmCqjdjsxSqAerYKf6Y2R-42ynRUCs2WK5G-Q&oe=6AFC866F"}, {"file_name": "Screenshot-03.png", "id": "646185827834341", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473400726_646185831167674_5793456541900780880_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOe4FTc1WXAQ7kNvwEJsOPw&_nc_oc=AdqtwmJiR75Fz3PjBsRstzGWkqNa3SagT3o1D-bQNLmhU67UTkk8PRpXDuhqrrSa6qc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZHYt-PR7g6C8kJYOmu5ho-1URt5EWvwZfg1Ho76yJLw&oe=6AFC7D59"}, {"file_name": "Screenshot-04.png", "id": "609070458597730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391889_609070465264396_3308108535597157740_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06Kn3rYmtkoQ7kNvwEAseIR&_nc_oc=AdqcTi85yqQo2G2O4c7O8hDAFwkcyDntkHW3h-9nDmZLRH2ipSYYcqMcyubV38MY2uA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEeIinTh9Fwuo09aJIJHa3OJVzcjU4b4QDuWdwX-ziLQ&oe=6AFC64D1"}, {"file_name": "Screenshot-05.png", "id": "1159158672287028", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391961_1159158678953694_2132414481320873297_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V5ZccjWYkUMQ7kNvwHgmBfK&_nc_oc=AdpL3qLPqR-R0LN7dzt6zhRGBoT0SAUC4NVs_TZZ3sxBOwGU7WqBRuSn3NDvF-jSljE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5rYhHISrKWJ1L_V3mWm05x5QuVFJ9bebYhjM58lWJzQ&oe=6AFC7864"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_01.png", "id": "2764468163753905", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473392317_2764468167087238_4350391818497520352_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PB0sk4-byFQQ7kNvwGea2qa&_nc_oc=AdrUzMYJXdOdH8wem6ubiesN5UzZYQpvRpsTy7fSbGUeE7DarL0pdPne1hVw47l3k2M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTPIGsONasPC-jEeqjXr5hXKwfM4gPnud2l_oxKBzDJg&oe=6AFC730A"}, "display_name": "Archery Master", "keywords": ["Archery", "Sports", "Simulation", "PartyGame", "VR"], "long_description": "Ready to channel your inner Robin Hood (minus the tights)? Dive into \"Archery Master VR,\" the ultimate single-player virtual reality archery game. Immerse yourself in various game modes, including Challenge Mode, Target Practice, Drone Shoot and Survival Mode\u2014each more exciting than the last!\n\nWith jaw-dropping visuals and sound so immersive you'll think you've been teleported to Sherwood Forest, every shot you take feels incredibly real. Our dynamic AI opponents are ready to keep you on your toes, making every playthrough an exhilarating experience.\n\nCustomize your archery gear with a range of bows because why settle for standard when you can be legendary?\n\nBecome the ultimate archery master in a virtual world that combines precision, skill, and a dash of adventure. Download \"Archery Master VR\" now and start your journey towards archery greatness!", "short_description": "Archery Master VR\" is a single-player virtual reality archery game that offers an immersive and challenging experience. Available exclusively on the Meta Store, the game features various game modes, realistic graphics, and dynamic AI integration. Experience the thrill of archery in virtual reality with \"Archery Master VR.\""}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/archerymaster-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT
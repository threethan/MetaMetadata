_5793456541900780880_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EvFi6OjGPY4Q7kNvwGU2tIC&_nc_oc=AdqWAcfXnyihE2wz4hjMhtsTDucI6MEWDD2dd_UvpGQK3Krt6D1r7wY8J7cTO5C06SE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHreyK9XA3lGwyRui56BNelUlq1g2-N3U-Tf_nTRFAXQA&oe=6A86EF99"}, {"file_name": "Screenshot-04.png", "id": "609070458597730", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391889_609070465264396_3308108535597157740_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3rXajVw_ycQ7kNvwEdxdTZ&_nc_oc=AdoilzV3r9ltA6QxSnmvi64lhLSZjGTKayafFmilMB95iBy7mvTF_Urdl9XiXGifaNQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwm8xzE5Syurqv1-1XLw8QEQ8zyIxSIC1P2oW39bNssQ&oe=6A86D711"}, {"file_name": "Screenshot-05.png", "id": "1159158672287028", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473391961_1159158678953694_2132414481320873297_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hGdoMbhiR2gQ7kNvwHiP0mm&_nc_oc=AdpUft4fQwRNP2B-NT_9ijK_6vExqb97__scuij3VRRW0o6p5U5Tcw-Jt6lWjfmHQ5g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbWuyDze6IPlo4imGEwzlGclQkE7i_T_E_1ks46Aa30g&oe=6A86EAA4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_01.png", "id": "2764468163753905", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473392317_2764468167087238_4350391818497520352_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ZYA7OSjpd8Q7kNvwFWJ7jq&_nc_oc=Ado-fzf5PsIDJV6Ply6el87oOpH6AXQ7Qi7dmAinVzKXq49-3l5ordTL2YWX1um2NzI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqk6mS_oekxuM-G5SUnsI4W2z4B24yHMVie1TaS1_Kyg&oe=6A86E54A"}, "display_name": "Archery Master", "keywords": ["Archery", "Sports", "Simulation", "PartyGame", "VR"], "long_description": "Ready to channel your inner Robin Hood (minus the tights)? Dive into \"Archery Master VR,\" the ultimate single-player virtual reality archery game. Immerse yourself in various game modes, including Challenge Mode, Target Practice, Drone Shoot and Survival Mode\u2014each more exciting than the last!\n\nWith jaw-dropping visuals and sound so immersive you'll think you've been teleported to Sherwood Forest, every shot you take feels incredibly real. Our dynamic AI opponents are ready to keep you on your toes, making every playthrough an exhilarating experience.\n\nCustomize your archery gear with a range of bows because why settle for standard when you can be legendary?\n\nBecome the ultimate archery master in a virtual world that combines precision, skill, and a dash of adventure. Download \"Archery Master VR\" now and start your journey towards archery greatness!", "short_description": "Archery Master VR\" is a single-player virtual reality archery game that offers an immersive and challenging experience. Available exclusively on the Meta Store, the game features various game modes, realistic graphics, and dynamic AI integration. Experience the thrill of archery in virtual reality with \"Archery Master VR.\""}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/archerymaster-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_
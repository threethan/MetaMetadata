c=AdrYv-AONOHjYa4vcyFHiBJFejfxkLKT7IcnT27I8o7KJBBK6iKFf93oCuAZp-S__ao&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQv6LouIxFanZQ2ZjKJslfbwgJqX7SV3wxIBeLEalcw3g&oe=6B0B3F2F"}, {"file_name": "Screenshot-03.png", "id": "646185827834341", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473400726_646185831167674_5793456541900780880_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsIgDa61kDMQ7kNvwHRFN-E&_nc_oc=Adp2nj_6wrlcp66hIp2cIvZo3a5ERAhibnaSMSYDMWxWLR_Qast7tsGYcje3UNnDdQM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSIKwaIqAiRVOqcpTCuVpqO3185Fn5GJW1eZSnQsDHhJw&oe=6B0B3619"}, {"file_name": "Screenshot-04.png", "id": "609070458597730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391889_609070465264396_3308108535597157740_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8LSB-S0Vq2AQ7kNvwH9h2ea&_nc_oc=AdpiWF171c2_JvJDN95UcmNJcPqJYPIX9hV7U5bGIfG5voc1eN6JyAYMf3g0Zay0ROg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRJaiOqWRkOsZhdEG0QdnbsEXXCN98DBKryk6NuSTco3Q&oe=6B0B1D91"}, {"file_name": "Screenshot-05.png", "id": "1159158672287028", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473391961_1159158678953694_2132414481320873297_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tQQHU8LvNrgQ7kNvwGgrpAU&_nc_oc=AdoPOlZMHDZ_k5bzf1tCaK_BbrCW3_N6FD6RvZpfzEHJyk3pK5SWY8b_Zk5-OP9lzfM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQREOq3z9G4JIbhn7PttWnGGFxjHNjFztDLApvHLT4iosQ&oe=6B0B3124"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_01.png", "id": "2764468163753905", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473392317_2764468167087238_4350391818497520352_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M6CXngz0pGMQ7kNvwHLuHYs&_nc_oc=AdrMtY0iPQE1bYz4ghEmms5pdP5Hn7GzamW0xRwjqU8Iec0KO2thMNcL-wE9g5UYl7A&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS0xYVWsbn_JnJB8nvJIgPbzFtg5nicmdMp9ds46WAB-g&oe=6B0B2BCA"}, "display_name": "Archery Master", "keywords": ["Archery", "Sports", "Simulation", "PartyGame", "VR"], "long_description": "Ready to channel your inner Robin Hood (minus the tights)? Dive into \"Archery Master VR,\" the ultimate single-player virtual reality archery game. Immerse yourself in various game modes, including Challenge Mode, Target Practice, Drone Shoot and Survival Mode\u2014each more exciting than the last!\n\nWith jaw-dropping visuals and sound so immersive you'll think you've been teleported to Sherwood Forest, every shot you take feels incredibly real. Our dynamic AI opponents are ready to keep you on your toes, making every playthrough an exhilarating experience.\n\nCustomize your archery gear with a range of bows because why settle for standard when you can be legendary?\n\nBecome the ultimate archery master in a virtual world that combines precision, skill, and a dash of adventure. Download \"Archery Master VR\" now and start your journey towards archery greatness!", "short_description": "Archery Master VR\" is a single-player virtual reality archery game that offers an immersive and challenging experience. Available exclusively on the Meta Store, the game features various game modes, realistic graphics, and dynamic AI integration. Experience the thrill of archery in virtual reality with \"Archery Master VR.\""}]}, "developer_name": "5thScape", "developer_privacy_policy_url": "https://5thscape.com/cageconquest-privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "5thScape", "support_website_url": null, "website_url": "https://5thscape.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_sub
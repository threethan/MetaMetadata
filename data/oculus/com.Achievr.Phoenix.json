inguish", "keywords": [], "long_description": "Feel the rush of extinguishing fires in the middle of an everyday office. Achievr's Extinguish offers a safe space to learn from your mistakes and gain muscle memory; getting you ready for informed, clearheaded action at a moment's notice.\n\nFeatures:\n- Face a rapidly growing fire using RACE and PASS\n- Lessons based on compliance with Australian standards\n- Powered by Achievr's student, course and device management platform\n- Automatically record attendance and achievements", "short_description": "Feel the rush of extinguishing fires in the middle of an everyday office. Achievr's Extinguish offers a safe space to learn from your mistakes and gain muscle memory; getting you ready for informed, clearheaded action at a moment's notice.\n\nFeatures:\n- Face a rapidly growing fire using RACE and PASS\n- Lessons based on compliance with Australian standards\n- Powered by Achievr's student, course and device management platform\n- Automatically record attendance and achievements"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.achievr.zone/#/privacy-policy", "developer_terms_of_service_url": "https://app.achievr.zone/#/terms-and-conditions", "publisher_name": "ACHIEVR", "support_website_url": "https://support.achievr.zone/portal/en/home", "website_url": "https://www.achievr.zone/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1043107547362485"}], "external_subscription_type": "REQUIRED", "genres": ["EDUCATIONAL", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"
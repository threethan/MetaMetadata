h=00_AQRP_kC2sugkEMEQuLgt-W2jv7LmJzbFv4dN475q-WUf3w&oe=6AFB18FE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u9884\u544a\u7247\u5c01\u9762.png", "id": "263012936075705", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39036689_263012942742371_5220952781350243514_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D3ROc-gFfBQQ7kNvwH44quD&_nc_oc=AdrN4t15vrPuYQb77r3rsEcd3OTnux1oqJbrfa6CHB-BIlABda7tjG8tSs2eBYWc2pw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ79lGznWqXYOyqpbcXfHRthxxa1dMpWCe2-qTEocpHFQ&oe=6AFB1A37"}, "display_name": "Grimlord", "keywords": [], "long_description": "Grimlord is not a battle arena, Grimlord is not limited to hack and slash. From the lowest of beginnings, fight your way out. Your fighting style is unrestricted, your crafting options are limitless, and your enemies are versatile and fierce. Your future and the future of this land lie in your hands.\nThis is a story-driven, classic action RPG that is native to VR interactions. This is what\u2019s been missing for long. This is Grimlord.\n\nKey Features:\n-Creative Combat Styles\nHold your weapon wherever you want, however you want, and use real-life fight styles to defeat your foe.\n\n-Be the mage wiping out enemies.\n\n-Improvise and break your enemies\u2019 guard. Hit them where it hurts!\n\n-Explore Dedicated Map. Enjoy Grimlord's breath-taking views\n\n-Climb your way out of a dangerous area\n\n-Immerse to good-ole Souls style map loop, where every short-cut and fire point gives a sense of safety\n\n-Find legendary weapon parts\n\n-Weaponry Customization\nDozens of weapon parts to unlock and hundreds of combinations to find your own favorite combat style.\n\n-Variety of Enemies & Epic Boss Fight\nMemorize their attack patterns is the key to conquer\n\n-Be prepared for the difficulty spike\n\nIn Grimlord, there is a reason to fight, a cause to fight for\nSee the world through bits and pieces of information\nDelve into a land with a sad and bloody story, make your choices, and face unforgiving consequences!\nGrab your fate by the throat and bend it to your will.", "short_description": "Grimlord is a dark fantasy action RPG built for VR. Use every type of weaponry and armaments with full customization and limitless move sets to annihilate anyone who dares to stand between you and your destiny"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.kylinhall.com/privicy-policy-grimlord", "developer_terms_of_service_url": null, "publisher_name": "Kylinhall", "support_website_url": null, "website_url": "https://www.kylinhall.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "821934236779161"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "581955907248595"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1401076143990002"}]}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1687363200, "status": "PUBLISHED", "id": "1401076143990002"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6946387885482327", "version": "0.4.6"}, "id": "717784422898985", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5015212428599892", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6946387885482327"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "717784422898985"}]}, "change_log": "NEW Demo", "created_date": 1705295834, "id": "6946387885482327", "version": "0.4.6", "version_code": 101, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "6946384872149295"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5015212428599892", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6946387885482327"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1705059511, "id": "6936418636479252", "version": "0.4.6", "version_code": 100, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "6936409339813515"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5015212428599892", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6946387885482327"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "717784422898985"}]}, "change_log": "V0.3.2M Patch Notes\nDear Fellow Adventurers: Thank you for downloading Grimlord\u2019s Demo. We are working tirelessly to bring the game on Quest! We do apologize for the buggy experience in current version due to the lack of resources in early testing. We have reviewed a great deal of feedback and have solved several targeted issues in this update.\n\nNew Functions:\n1. Steering by Stick could be turned off to cope with shifting issue of some controllers. \n2. ASW can be turned off manually by pressing the stick, so there won\u2019t be any tear on the screen.\n\nFixes\n1. Fixed an issue where weapons would bounce away when hold with both hands.\n2. Fixed the problem of weapons being stuck in walls.\n3. Fixed height calibration issues.\n4. Improved overall brightness.\n5. Improved overall brightness of the UI.\n6. Special effects are now displayed correctly.", "created_date": 1692341379, "id": "6398965416891246", "version": "0.3.2", "version_code": 13, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5015212428599892", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6946387885482327"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "717784422898985"}]}, "change_log": "test android sdk 32\nfix some bugs", "created_date": 1691637047, "id": "6372609932860128", "version": "0.3.1.4472", "version_code": 12, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "5015212428599892", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "6946387885482327"}, "release_status": "SCHEDULED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "717784422898985"}]}, "change_
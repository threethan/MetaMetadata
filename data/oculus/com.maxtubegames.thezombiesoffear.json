5771-25/499307435_1721402761909172_7857648168550701072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BWKow7KUosMQ7kNvwGfEVW3&_nc_oc=AdpWUzxoyVITtNj2TLBFMOeE7vjwp322gOz8CAyHOV70PGlVa-E4TIs5g_zj8zDJJBA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOzJaLLb1Ku9_M7Yc2ulmEIAjcXZmdX-6fzj4fGnpwWw&oe=6ABA5B21"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zombiefearcapa.png", "id": "1998253820932257", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821849_1998253824265590_8525836150775444128_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLTIEbntbfEQ7kNvwEpTob2&_nc_oc=AdoSLsawE8OyeAbqt9DpUDcmViNzBkqdZYjpERAypKcXTINYN3wWvWGptF4zNmStVIo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYe62FZm6rREtzR9Z17bZU2ueHUIKROviKDI2iqjpEJA&oe=6ABA7516"}, "display_name": "The Zombies Of Fear", "keywords": ["zombie", "dead", "walking", "horror", "suspense"], "long_description": "Step into a full-throttle VR nightmare built for Meta Quest. Hurl an axe with deadly precision, sprint through shadowy alleys, and scour the map for diamond-filled chests\u2014every chest holds one. Collect five diamonds to free the princess\u2014if the horde doesn\u2019t corner you first. A relentless blend of action, adventure, horror, and suspense, packed with tense chases and sharp jump scares.\n\nFeatures\n\nSatisfying axe-throw combat with weighty impact.\n\nRelentless zombie hordes and nerve-wracking ambushes.\n\nExploration & progression: open chests across the map\u2014every chest contains a diamond\u2014gather 5 and rescue the princess.\n\nAtmosphere drenched in terror and suspense\u2014never feel safe for long.\n\nBuilt for Meta Quest immersion from the ground up.\n{778143608440090}", "short_description": "VR horror with relentless zombies and a diamond in every chest. Find 5 to rescue the princess."}]}, "developer_name": null, "developer_privacy_policy_url": "https://klebbermax.com.br/maxtubegames/", "developer_terms_of_se
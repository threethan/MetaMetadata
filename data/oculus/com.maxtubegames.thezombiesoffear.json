5771-25/499307435_1721402761909172_7857648168550701072_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mqwmBybtf5YQ7kNvwHCzF0h&_nc_oc=AdrPjkoXRpbNCucR2nFC_DT95c9Wh0Ekrn-GOq_sXL0iaAHolDb60DcW1XGtwLo0FMI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCnF04CJX_G1xTK6xrkjt3a5KOsxGYh7G_NzL2XrfFNw&oe=6AB158E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zombiefearcapa.png", "id": "1998253820932257", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821849_1998253824265590_8525836150775444128_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5sFYJWXyf8Q7kNvwHfNQNz&_nc_oc=AdqFOaKpZghMVg-t258_D9lxeDzTG-5QW442hF0PNd4DgYe2tep47H-_T9VzwPBLr6Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTWCNnEtgolgFn1rR5d4jzAPbiZ6nom9fcyNcNxqs2FA&oe=6AB13A96"}, "display_name": "The Zombies Of Fear", "keywords": ["zombie", "dead", "walking", "horror", "suspense"], "long_description": "Step into a full-throttle VR nightmare built for Meta Quest. Hurl an axe with deadly precision, sprint through shadowy alleys, and scour the map for diamond-filled chests\u2014every chest holds one. Collect five diamonds to free the princess\u2014if the horde doesn\u2019t corner you first. A relentless blend of action, adventure, horror, and suspense, packed with tense chases and sharp jump scares.\n\nFeatures\n\nSatisfying axe-throw combat with weighty impact.\n\nRelentless zombie hordes and nerve-wracking ambushes.\n\nExploration & progression: open chests across the map\u2014every chest contains a diamond\u2014gather 5 and rescue the princess.\n\nAtmosphere drenched in terror and suspense\u2014never feel safe for long.\n\nBuilt for Meta Quest immersion from the ground up.\n{778143608440090}", "short_description": "VR horror with relentless zombies and a diamond in every chest. Find 5 to rescue the princess."}]}, "developer_name": null, "developer_privacy_policy_url": "https://klebbermax.com.br/maxtubegames/", "developer_terms_of_se
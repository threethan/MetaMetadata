=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RyR1PJ_eS0QQ7kNvwEEq14q&_nc_oc=AdrPVSbP1pwJFwTl4NjyfDyT2haMwzc-L3NjKZTL4VGhmhsBYTUEOoA057ebyEJov8s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRueNcYKlB4lKjMbMIRU1nolsFcAz2cqH7RnqzoNHA4uw&oe=6B045CE7"}, {"file_name": "com.maxtubegames.thezombiesoffear-20250923-205204.png", "id": "1721402758575839", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307435_1721402761909172_7857648168550701072_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkfzcFy773sQ7kNvwGsCfTV&_nc_oc=Adq9iFfibcpWYuvg2l9MLi8iMC70eIqV1N7g8JBa6qyOTX7tOfc6Imj-VF3C3xKvCHE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM9VjydhKPjjAi1mkw7_K9NTxwkFqedhczGvCD8BOwWw&oe=6B046761"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zombiefearcapa.png", "id": "1998253820932257", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821849_1998253824265590_8525836150775444128_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRrSBwuAKTQQ7kNvwGJfULH&_nc_oc=AdoiE0Vfcwf7Ag3xyMOi7UboI8_PAemfrZDHW4wVgeinA98sIkVclLC31MatVh8Pmks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSckkyJ8jQDFDoLI-REh4VtQSZ7WNcAeO3TIMMjDtw_kw&oe=6B048156"}, "display_name": "The Zombies Of Fear", "keywords": ["zombie", "dead", "walking", "horror", "suspense"], "long_description": "Step into a full-throttle VR nightmare built for Meta Quest. Hurl an axe with deadly precision, sprint through shadowy alleys, and scour the map for diamond-filled chests\u2014every chest holds one. Collect five diamonds to free the princess\u2014if the horde doesn\u2019t corner you first. A relentless blend of action, adventure, horror, and suspense, packed with tense chases and sharp jump scares.\n\nFeatures\n\nSatisfying axe-throw combat with weighty impact.\n\nRelentless zombie hordes and nerve-wracking ambushes.\n\nExploration & progression: open chests across the map\u2014every chest contains a diamond\u2014gather 5 and rescue the princess.\n\nAtmosphere drenched in terror and suspense\u2014never feel safe for long.\n\nBuilt for Meta Quest immersion from the ground up.\n{778143608440090}", "short_description": "VR horror with relentless zombies and a diamond in every chest. Find 5 to rescue the princess."}]}, "developer_name": null, "developer_privacy_policy_url": "https://klebbermax.com.br/maxtubegames/", "developer_terms_of_service_url": null, "publisher_name": "Klebber Wallyngson Hosokawa Costa", "support_website_url": null, "website_url": "https://klebbermax.com.br/maxtubegames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25222982973993851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822924_1292093588677608_7096333709289498014_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMwz7ic2bOUQ7kNvwEpSeoZ&_nc_oc=AdpyzTUd47DP5IqwEp6UZzf-kg6NBvRiKvnXDIxmOiNLqu0RxJh2wqu4HM92_X_wigU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFLZKZjKjIF1JexaIdULN-4ZZKx9jxMv0zM7G09wR0Bw&oe=6B0485CC"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Zombies Of Fear", "platform": "ANDROID_6DOF", "context_category": {"conte
=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyKbBQFhV0kQ7kNvwF5_r6x&_nc_oc=AdpNSVU8YtghibxKZTg2nWv8QMU_WJptB7p9uJXcB7SIorlsKzB75EtR94sBtR5f1I8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSVbs8H1YjMX0dbQc7PgoERJUtZaKFdfEO0g8ji9NurXg&oe=6AFDC567"}, {"file_name": "com.maxtubegames.thezombiesoffear-20250923-205204.png", "id": "1721402758575839", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307435_1721402761909172_7857648168550701072_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGt2OU9siO0Q7kNvwF5QWjq&_nc_oc=Adrz3ET18X4Ccc9M1gUZysCFJctvj2k58zrY_NJHWil7urelyZrznMfQSNB9jzYXzKI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQW0vTePcr_7yltQKfJNrKOMEmFPTcFlX1eZF73E0oHrg&oe=6AFDCFE1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "zombiefearcapa.png", "id": "1998253820932257", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821849_1998253824265590_8525836150775444128_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNsLmWw1kA0Q7kNvwFAxp8C&_nc_oc=Adr-gT9nmwFokWS25FcTrOFu8G00fSSujLlfk_tDXZqddfX-IcWzxxLcyH56TAVXfns&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSo3R5jTUqVly1Dw8rB3CAbqmfY_buGqam68zm66pbyGw&oe=6AFDB196"}, "display_name": "The Zombies Of Fear", "keywords": ["zombie", "dead", "walking", "horror", "suspense"], "long_description": "Step into a full-throttle VR nightmare built for Meta Quest. Hurl an axe with deadly precision, sprint through shadowy alleys, and scour the map for diamond-filled chests\u2014every chest holds one. Collect five diamonds to free the princess\u2014if the horde doesn\u2019t corner you first. A relentless blend of action, adventure, horror, and suspense, packed with tense chases and sharp jump scares.\n\nFeatures\n\nSatisfying axe-throw combat with weighty impact.\n\nRelentless zombie hordes and nerve-wracking ambushes.\n\nExploration & progression: open chests across the map\u2014every chest contains a diamond\u2014gather 5 and rescue the princess.\n\nAtmosphere drenched in terror and suspense\u2014never feel safe for long.\n\nBuilt for Meta Quest immersion from the ground up.\n{778143608440090}", "short_description": "VR horror with relentless zombies and a diamond in every chest. Find 5 to rescue the princess."}]}, "developer_name": null, "developer_privacy_policy_url": "https://klebbermax.com.br/maxtubegames/", "developer_terms_of_service_url": null, "publisher_name": "Klebber Wallyngson Hosokawa Costa", "support_website_url": null, "website_url": "https://klebbermax.com.br/maxtubegames/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25222982973993851"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822924_1292093588677608_7096333709289498014_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vqY1CYRWMRMQ7kNvwGbDF7x&_nc_oc=AdqH2cPtXUVY762mwfkDTl76pg294D8S0uI5yIIr-J_40ZQxv7IuKGmPB7eNArwW41Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZz1gcnw38VnBIhos0HyyKwznPXnm6quLCQQtDo6iq1Q&oe=6AFDB60C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Zombies Of Fear", "platform": "ANDROID_6DOF", "context_category": {"conte
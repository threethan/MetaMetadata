oc=Adqp6PPHhfgKVlqbMzaRRUXfNKZ3WTfdck50bimjFCyOfYAtm9VYYagXxOT2rx2Eweg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VV3fFj7YRyId1FgL4Zd7qM5sJXJGBAQfFaEYO1-i3Qw&oe=6A05DDC9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "553887475822150", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75572755_553887479155483_5164197311620824925_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dVGvEZEXDwQ7kNvwGOD2KP&_nc_oc=Adr0tMh-AZYUq0vOiK0mCz9Tjy1V26RM_-Q2Rr7wD3KPcA3lBTEa55TR_grL0Gv2MXk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wcAwCbqf3A7p42aNstHt-iM7dKIwjS26Ug0Ph9Lk_4A&oe=6A05C6F4"}, "display_name": "Clay Hunt VR", "keywords": [], "long_description": "#1 shotgun shooting simulator from mobile is now available in amazing VR! Shoot clay pigeons in skeet and go hunting pigeons with your trusty pump action shotgun.\n\nShot string physics are accurately simulated so that you can practice your leads and target acquisition with this game.\n\nIn skeet, you can shoot single targets rounds, international skeet with double targets, practice a specific station and all new infinite skeet mode with leaderboards!\n\nThis is an early version of the game and only skeet and pigeon hunting is currently featured. More will come shortly as trap, double trap and sporting clays are added.", "short_description": "#1 shotgun shooting simulator from mobile is now available in amazing VR! Shoot clay pigeons in skeet and go hunting pigeons with your trusty pump action shotgun.\n\nShot string physics are accurately simulated so that you can practice your leads and target acquisition with this game.\n\nThis is an early version of the game and only skeet and pigeon hunting is currently featured. More will come shortly as trap, double trap and sporting clays are added."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clayhuntpro.com/privacy/clayhuntvr.html", "developer_terms_of_s
PaiYlX8AH7Bgz7ds3gb214J8NlSipguiuomjQ&oe=69EE2288"}, {"file_name": "CreativeScreenshot.png", "id": "1155839540094540", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819859_1155839543427873_3101868880310076803_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-Rb7ZuyjGUQ7kNvwFgIRVn&_nc_oc=AdpT56HUXTHBg5xqBHFPuiMtdUISNuGCa3YLMowhxfFKQNDqO7KB9pSKL7J11Wlb50g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pdGmZtE3Y8mxtBCYCI5anx0t7zqKtd2qxxj68jGTqDQ&oe=69EE270D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "herocover_landscape.png", "id": "615524579934890", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974892_615524586601556_3216826616013096842_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_IVDb6jiIroQ7kNvwH4pzYF&_nc_oc=Ado886UFIcUR2bSHjqAfqVL-ImJgeoGnaVIoLYyj5Dk30XjzEMcLfgEaD_lQVij7Xw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00548N8esVbp7jMZUFIbPkKzLd_j7oYqv3Aaj_JXkfng&oe=69EE1155"}, "display_name": "Clay Hunt VR", "keywords": ["shooting", "skeet", "trap", "hunting", "gun"], "long_description": "Experience the thrill of shotgun shooting like never before! Clay Hunt VR brings authentic shotgun sports to life with clay shooting and hunting modes \u2014 the hunting season never ends!\n\nHone your shooting skills in realistic virtual reality training and compete with friends in exciting multiplayer matches. Play using only the controllers, or attach them to a gun stock accessory for a more realistic shooting experience.  \n\nClay Hunt VR is designed for all skill levels: start with beginner mode for slower targets and more forgiving hit detection, then progress to professional difficulty for true-to-life physics.\n\nCLAY SHOOTING: American & International trap, double trap, skeet and sporting clays with multiple courses. You can even design your own courses in the Creative mode. Clay pigeon flight paths and leads are accurately simulated.\n\nHUNTING: Ducks, pigeons and pheasant drives in varying bird hunting challenges!\n\nADD-ONS: Expand your experience with new add-ons: sporting locations, dog-assisted hunting, and the exciting boar hunt. Test your skills against fast FPV drones\u2014now featuring the automatic rifle!\n\nMULTIPLAYER: Join the community and participate on competitions or go shooting with friends on a private room.\n\nGUN STOCKS: Play with just the controllers or attach them to a gun stock for a more realistic feel. Learn more about the Real Stock Pro shown in the trailer and other options at the website: www.clayhuntvr.com.", "short_description": "Experience the thrill of shotgun shooting like never before! Clay Hunt VR brings authentic shotgun sports to life with clay shooting and hunting modes \u2014 the hunting season never ends! \n\nHone your shooting skills in realistic virtual reality training and compete with friends in exciting multiplayer matches. Play using only the controllers, or attach them to a gun stock accessory for a more realistic shooting experience."}, {"images": {"nodes": []}, "id": "850778527822646", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clay Hunt VR", "keywords": ["skeet", "trap", "pistola", "caza", "tiroteo"], "long_description": "\u00a1Siente la emoci\u00f3n del tiro con escopeta, perfecciona tus habilidades y reta a tus amigos en las competiciones multijugador! Clay Hunt VR es un juego de tiro deportivo con escopeta que incluye modos de caza y de tiro al plato. \u00a1Aqu\u00ed siempre es temporada de caza!\n\nEl juego funciona perfectamente con los mandos, pero tambi\u00e9n puedes acoplarlos a un accesorio de culata y disfrutar de un mayor realismo.\n\nTira al plato en distintas disciplinas, ve de caza o desbloquea nuevas armas y modificaciones, como el cargador para la semiautom\u00e1tica. \u00a1Empieza por el modo Principiante y ve depurando tu t\u00e9cnica hasta que consigas superar los circuitos m\u00e1s complicados!\n\nTIRO AL PLATO: Foso americano, foso universal, doble foso, Skeet y plato deportivo en m\u00faltiples circuitos. Incluso puedes dise\u00f1ar tus propios circuitos de cinco series gracias al nuevo modo Creativo. La simulaci\u00f3n de los platos y sus recorridos es extremadamente precisa.\n\nCAZA: \u00a1Batidas de patos, pichones y faisanes y otros desaf\u00edos de caza de aves! Con las expansiones, tambi\u00e9n podr\u00e1s disfrutar de la caza de altura con tu perro y de la emoci\u00f3n de cazar jabal\u00edes.\n\nMULTIJUGADOR: \u00danete al servidor de Discord y participa en competiciones. \u00a1Tambi\u00e9n puedes quedar con tus amigos en una sala privada y divertirte con ellos!\n\nCULATAS: Juega con los mandos tal cual est\u00e1n o ac\u00f3plalos a un accesorio de culata para disfrutar de una experiencia m\u00e1s realista. En el grupo de Facebook de Clay Hunt VR, encontrar\u00e1s m\u00e1s informaci\u00f3n sobre las culatas disponibles.", "short_description": "\u00a1Siente la emoci\u00f3n del tiro con escopeta, perfecciona tus habilidades y reta a tus amigos en las competiciones multijugador! Clay Hunt VR es un juego de tiro deportivo con escopeta que incluye modos de caza y de tiro al plato. \u00a1Aqu\u00ed siempre es temporada de caza!\n\nEl juego funciona perfectamente con los mandos, pero tambi\u00e9n puedes acoplarlos a un accesorio de culata y disfrutar de un mayor realismo."}, {"images": {"nodes": []}, "id": "833250826295370", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clay Hunt VR", "keywords": ["skeet", "trap", "waffe", "Jagd", "Schie\u00dfen"], "long_description": "Sp\u00fcre den Nervenkitzel des Schrotflintenschie\u00dfens, verbessere deine F\u00e4higkeiten in der virtuellen Realit\u00e4t und fordere deine Freunde in Mehrspieler-Wettbewerben heraus! Clay Hunt VR ist ein realistisches Schrotflinten-Sportspiel mit den Modi Tontaubenschie\u00dfen und Jagd. Die Jagdsaison ist immer er\u00f6ffnet!\n\nDas Spiel funktioniert nur mit den Controllern oder du kannst sie f\u00fcr ein realistischeres Gef\u00fchl an einem Waffenzubeh\u00f6r befestigen.\n\nSchie\u00dfe in verschiedenen Disziplinen auf Wurfscheiben oder geh auf die Jagd, schalte neue Waffen und Mods wie Magazine f\u00fcr die Halbautomatik frei. Beginne einfach mit dem Anf\u00e4ngermodus und arbeite dich hoch, um die anspruchsvollsten Kurse zu meistern!\n\nTONSCHIESSEN: Amerikanische und internationale Trap-, Doppeltrap-, Skeet- und Sport-Sandpl\u00e4tze mit mehreren Parcours. Im neuen Kreativmodus kannst du sogar deine eigenen Parcours mit f\u00fcnf St\u00e4nden entwerfen. Die Flugbahnen und Flugbahnen der Tontauben werden genau simuliert.\n\nJAGD: Enten, Tauben und Fasanenjagden in verschiedenen Vogeljagd-Herausforderungen! Erhalte mehr mit Add-ons: Hochlandjagd mit deinem Hund und die aufregende Wildschweinjagd!\n\nMULTIPLAYER: Tritt dem Discord-Kanal bei und nimm an Wettbewerben teil oder geh mit Freunden in einem privaten Raum schie\u00dfen.\n\nGEWEHRSCHAFTE: Spiele nur mit den Controllern oder befestige sie f\u00fcr ein realistischeres Spielgef\u00fchl an einem Gewehrschaft. Weitere Informationen zu den verf\u00fcgbaren Gewehrschaften findest du in der Facebook-Gruppe von Clay Hunt VR.", "short_description": "Sp\u00fcre den Nervenkitzel des Schrotflintenschie\u00dfens, verbessere deine F\u00e4higkeiten in der virtuellen Realit\u00e4t und fordere deine Freunde in Mehrspieler-Wettbewerben heraus! Clay Hunt VR ist ein realistisches Schrotflinten-Sportspiel mit den Modi Tontaubenschie\u00dfen und Jagd. Die Jagdsaison ist immer er\u00f6ffnet!\n\nDas Spiel funktioniert nur mit den Controllern oder du kannst sie f\u00fcr ein realistischeres Gef\u00fchl an einem Waffenzubeh\u00f6r befestigen."}, {"images": {"nodes": []}, "id": "713707415123045", "locale": "it_IT", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Clay Hunt VR", "keywords": ["skeet", "foso", "fucile", "tiro", "caccia"], "long_description": "Prova il brivido del tiro a volo, affina le tue abilit\u00e0 nella realt\u00e0 virtuale e sfida i tuoi amici in competizioni multiplayer! Clay Hunt VR \u00e8 un gioco sportivo realistico con fucile a pompa con modalit\u00e0 di tiro all'argilla e di caccia. La stagione della caccia \u00e8 sempre aperta!\n\nIl gioco funziona solo con i controller o puoi collegarli a un accessorio per il calcio del fucile, per ottenere una sensazione pi\u00f9 realistica.\n\nSpara all'argilla in varie discipline o vai a caccia, sblocca nuove armi e mod, come il caricatore per il semiautomatico. Per un inizio facilitato, scegli la modalit\u00e0 Principiante e progredisci fino a battere i percorsi pi\u00f9 impegnativi!\n\nTIRO ALL'ARGILLA: fossa americana e internazionale, fossa doppia, skeet e tiro al piattello con diversi percorsi. Puoi anche progettare i tuoi percorsi a cinque postazioni nella nuova modalit\u00e0 Creativa. Le traiettorie di volo dei piccioni d'argilla e le piste sono accuratamente simulate.\n\nCACCIA: potrai sparare ad anatre, piccioni e fagiani in varie sfide di caccia! Aggiungi altri elementi con gli add-on: prova la caccia in montagna con il tuo cane e l'emozionante caccia al cinghiale.\n\nMULTIPLAYER: unisciti al canale Discord e partecipa alle gare o spara insieme agli amici in una stanza privata.\n\nCALCI DEL FUCILE: gioca solo con i controller o collegali a un calcio del fucile per ottenere una sensazione pi\u00f9 realistica. Per maggiori informazioni sui calci dei fucili disponibili, visita il gruppo Facebook di Clay Hunt VR.", "short_description": "Prova il brivido del tiro a volo, affina le tue abilit\u00e0 nella realt\u00e0 virtuale e sfida i tuoi amici in competizioni multiplayer! Clay Hunt VR \u00e8 un gioco sportivo realistico con fucile a pompa con modalit\u00e0 di tiro all'argilla e di caccia. La stagione della caccia \u00e8 sempre aperta!\n\nIl gioco funziona solo con i controller o puoi collegarli a un accessorio per il calcio del fucile, per ottenere una sensazione pi\u00f9 realistica."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clayhuntpro.com/privacy/clayhuntvr.html", "developer_terms_of_service_url": null, "publisher_name": "Shotgun Gaming Oy", "support_website_url": null, "website_url": "https://www.shotgungaming.com/clayhuntvr", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "25342749682053217"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75540505_506254204670103_863853155680706064_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=862tNlacyHgQ7kNvwFzd6ps&_nc_oc=AdpTTpNXJMgk5cYkff7I5i0boPZ688uVtm7kb9l8HxhFyzts30T1JAK_Q_0_A7GSYgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Jfnf9z0PiDas89QjXqH-lqcKwS0ziEdkKkiU4mUQ5Pw&oe=69EE2318"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Clay Hunt VR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Sports", "id": "2776542286000603"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Simulation", "id": "3315
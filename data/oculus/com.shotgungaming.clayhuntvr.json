oc=Adql__bHmfDAHzC4GBgUggAH-u5G1RoI1_DQeqqh7B6KlC5paOhYpMDlZTvlScop2Gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52cm0wgU5CTxwRFi3sd1A3gqT-kZ10QfW8gO_XA0QBiA&oe=6A048C49"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "553887475822150", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75572755_553887479155483_5164197311620824925_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dVGvEZEXDwQ7kNvwG2fmVt&_nc_oc=AdrmddbTw84Q4kTeZq9UMHECuKX8Oysj_a1h7NTZgVDRMhSefjhIrcPX4H5Vk9yXqFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xE598xqY-OWgMfnZ0KGRUlvkLv50LxsxEU5IwQyyMmg&oe=6A047574"}, "display_name": "Clay Hunt VR", "keywords": [], "long_description": "#1 shotgun shooting simulator from mobile is now available in amazing VR! Shoot clay pigeons in skeet and go hunting pigeons with your trusty pump action shotgun.\n\nShot string physics are accurately simulated so that you can practice your leads and target acquisition with this game.\n\nIn skeet, you can shoot single targets rounds, international skeet with double targets, practice a specific station and all new infinite skeet mode with leaderboards!\n\nThis is an early version of the game and only skeet and pigeon hunting is currently featured. More will come shortly as trap, double trap and sporting clays are added.", "short_description": "#1 shotgun shooting simulator from mobile is now available in amazing VR! Shoot clay pigeons in skeet and go hunting pigeons with your trusty pump action shotgun.\n\nShot string physics are accurately simulated so that you can practice your leads and target acquisition with this game.\n\nThis is an early version of the game and only skeet and pigeon hunting is currently featured. More will come shortly as trap, double trap and sporting clays are added."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clayhuntpro.com/privacy/clayhuntvr.html", "developer_terms_of_s
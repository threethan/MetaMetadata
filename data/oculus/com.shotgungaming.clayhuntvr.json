oc=AdpFDvYXsrNV-GEdPKYLHzI0XMq0lHbK0fPxf-86dPIG8Zeqfc6KSs2lEGKC495IX9Q&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lN4NRSpnFyxhdGiFjY6eczJvS8WUlxD6uQU5pB-Md5g&oe=6A1069C9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VideoCover.png", "id": "553887475822150", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/75572755_553887479155483_5164197311620824925_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hL3NAHu4hO0Q7kNvwHiAa5O&_nc_oc=Adp4rdGMjkhT0O_yaCwCr0VA-VsgtKIWXIReQ5O3bvoytCdwv71YXdvdbFiLo37pknA&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Rg37xAd5HBTJ6iu2XecciI4GUodVHcn6QrnqyAqHkVw&oe=6A1052F4"}, "display_name": "Clay Hunt VR", "keywords": [], "long_description": "#1 shotgun shooting simulator from mobile is now available in amazing VR! Shoot clay pigeons in skeet and go hunting pigeons with your trusty pump action shotgun.\n\nShot string physics are accurately simulated so that you can practice your leads and target acquisition with this game.\n\nIn skeet, you can shoot single targets rounds, international skeet with double targets, practice a specific station and all new infinite skeet mode with leaderboards!\n\nThis is an early version of the game and only skeet and pigeon hunting is currently featured. More will come shortly as trap, double trap and sporting clays are added.", "short_description": "#1 shotgun shooting simulator from mobile is now available in amazing VR! Shoot clay pigeons in skeet and go hunting pigeons with your trusty pump action shotgun.\n\nShot string physics are accurately simulated so that you can practice your leads and target acquisition with this game.\n\nThis is an early version of the game and only skeet and pigeon hunting is currently featured. More will come shortly as trap, double trap and sporting clays are added."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.clayhuntpro.com/privacy/clayhuntvr.html", "developer_terms_of_s
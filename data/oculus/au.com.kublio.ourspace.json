66qaU1w&oe=6B0C800C"}, {"file_name": "10 Screenshot 4 night sky milky way.png", "id": "2030314397683350", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622202_2030314404350016_8767932231973628533_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8DrS4NWOQQQ7kNvwHY3cNh&_nc_oc=AdrHBGgddIoKjq0QTu6ylRY7Da-pWmSe9ULg9Qljgrc5ElW4QypCf3cg--d9vEBPnXI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSdkZ6XOIjQm841zajL_LQdqBZqzgP3M8sVxoCMZWNp2g&oe=6B0C70C3"}, {"file_name": "11 Screenshot 5 sundial and gorge.png", "id": "2341149609761092", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619382_2341149613094425_2608037681381810823_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QXq5Z2duS2wQ7kNvwHqr7EX&_nc_oc=AdoVjzvGfqVOKhzZT_C_ZahNIWD19RewtMjrDCRqeKZiTTZ3x9gY9vwr8Hdut0OIWdo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQf-aUgxSk0dA9Qhp-b4yrWRB38WT54qoxC19WgpO-KnQ&oe=6B0C83AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12c Trailer cover picture 2560x1440.png", "id": "1637135787344278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/593727470_1637135790677611_6949751435583396170_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EEMDCXV5ycAQ7kNvwH8MA5K&_nc_oc=Adpzr8f4fs88tV1eX-gzyF63htbYov8HJANbzie6y6kati5qd5rsB10LNgDWgUllF8c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQp68Kx9HFaB5aMtUMQO0BSVCQEvyhTi872XBnvgdH9-Q&oe=6B0C77DF"}, "display_name": "Ourspace by Kublio", "keywords": ["Education", "School", "Coding"], "long_description": "Step into real  places, and make your own.\nWalk through the portal on your island to Kennedy Range and Purnululu National Parks, built from the real landforms. Come back whenever you like and explore them again.\n\nIn the Playground, build anything, just for fun: shape the land, place native plants and animals, and paint with brushes like glowing lava, rivers that join up, waterfalls, glaciers and electricity, many with their own sounds. Nothing built in the Playground is saved.\n\nFOR SCHOOLS USING KUBLIO\n\nWith Kublio Code, students build and code their own worlds, keep their work, and step inside it with invited classmates. Invited classmates can share a world and, if the teacher turns it on, talk by voice. This part is for schools that use Kublio.\n\nNo ads or in-app purchases.\n\n{1901906700792933}\n{2476722349524805}\n{28680122951688824}", "short_description": "Visit real Australian places and try building a world of your own. Walk through the portal to Kennedy Range and Purnululu National Parks, then shape the land, place native plants and animals and paint with living brushes in the Playground. Free to explore, as often as you like. Schools using Kublio can also step inside the worlds their students build and code."}]}, "developer_name": null, "developer_privacy_policy_url": "https://kublio.app/privacy", "developer_terms_of_service_url": "https://kublio.app/terms", "publisher_name": "AirbourneIT Pty Ltd", "support_website_url": "https://help.kublio.app/", "website_url": "https://kublio.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "1506761329179988"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sco
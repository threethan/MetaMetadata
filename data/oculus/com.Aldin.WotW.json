25/38974535_2588653668031688_6222245475358081024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9X-3GtudYYQ7kNvwEglveV&_nc_oc=Adqch6frQ4HG93U4Mme5K_T4qBMcKWBbjataFURj2e6fVDmFhA42YxXDlEnD_Um__Fo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5IW3JWaHz2jv75jujxfCocDygdSsQ3f3W1Vg8nnTK4w&oe=6A8EC705"}, {"file_name": "migrated_image.png", "id": "636685530442550", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031544_545547256241139_4582153892019568640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8SXozb3Ae8Q7kNvwF2twuj&_nc_oc=Ado6OilFf9jU8MgzHZScvxf1UrPhTKTSYZWlkBdFG3MA4v62zcb61wk7GE4RWE21IZQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH2F4G6e7svj3BX0Bx1G0OnLjOvBiZ42NfmZe1eZmrikQ&oe=6A8EC011"}, {"file_name": "migrated_image.png", "id": "3163265210565748", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974616_555608881893659_4295527827886833664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvdb_M15nyAQ7kNvwFu1qqZ&_nc_oc=Adq3NWUWwZC9mawcJwczxq_l9DjqRrmfhicpQmomEcXp5DjbmSr4A6YhKYUT1BOTlYA&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhD7QEENhwGoawqWGB9XUoj0SVZ4Nkspch1jqUS7IbnQ&oe=6A8ED92C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/yqePnq", "id": "2144472652514970", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036684_2144472659181636_6421205896860270592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpWOHHVOFwIQ7kNvwFaLcw6&_nc_oc=AdoOUs2q3Xw7zLJsiVXKV5djLIdow5Qg6NpLBVoxAy6xXBQjciu6d7ndl66AZYKRb24&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLN78e8irSiApRp-c-ig8d0R7Bdwys8Wqmd0q-4tMEEA&oe=6A8EEF92"}, "display_name": "Waltz of the Wizard: Extended Edition", "keywords": ["Magic", "Wizard", "Waltz", "Introduction", "Fantasy"], "long_description": "Waltz of the Wizard is a joy-filled introduction to VR that anyone can enjoy and a sampler dish of things that make VR unique! Feel what it\u2019s like to have magical powers in this remaster of the original that introduces more spells, interactions and secrets. \n\nCast creative and diverse spells in a fully interactive world, discovering the many details of a world designed to feel real. Combine arcane ingredients into a boiling cauldron with the help of an ancient spirit trapped in a human skull. Travel to new places, finding yourself in mysterious circumstances full of detail and unforgettable atmosphere.\n\n\nFeature Overview\n\n- Brew magical spells & wield creative powers\n- Defeat guards & dodge traps in a labyrinth\n- Interact with strange artifacts & fun objects\n- Play minigames & collect trophies\n- Travel to new places & experience strange situations\n- Discover easter eggs & surprising details", "short_description": "Feel what it\u2019s like to have magical powers! One of the highest rated PC VR experiences comes to Quest in this remaster of the beloved original. Combine arcane ingredients into a boiling cauldron with the help of an ancient talking skull, unleashing diverse wizardry upon a fully interactive and mysterious world."}]}, "developer_name": "Aldin Dynamics", "developer_privacy_policy_url": "https://www.aldin.io/product/privacy-policy.html", "developer_terms_of_service_url": "http://aldindynamics.com/product/wotw-eula.html", "publisher_name": "Aldin Dynamics", "support_website_url": null, "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
8653668031688_6222245475358081024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xU940na0IksQ7kNvwFDkvYi&_nc_oc=AdrcT_x3NFOxX1ddH_mT9mCR7pCGxPanMO7wXlspUfALDA_1gGMWTbJayLb6OGn6kEs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdqd5LaVSAkBrWfqF1MYuhZe57TkMIv0hBPNQkvpQNIw&oe=6AAEA345"}, {"file_name": "migrated_image.png", "id": "636685530442550", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031544_545547256241139_4582153892019568640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oV58pRAM6xoQ7kNvwFFqJ2r&_nc_oc=AdpLv7W-WFQhDPrQIdFm3fGX992x9BnVqyOOO8ndIlIdERo4hALfZid1R8v4sg36EV4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLaGQIA8uAs8XeX7BVYitGgkUhv6urj3ZSalfkBtsbyw&oe=6AAE9C51"}, {"file_name": "migrated_image.png", "id": "3163265210565748", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974616_555608881893659_4295527827886833664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yjh4x-BZryMQ7kNvwF6AM5n&_nc_oc=Adr4KnT1oMNva4yTZLT1SNZyIKQD6_qyvLQJaxaBy6RuPc9wR0gzyl-hCBPRhY-NHnc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsuBBfpMm9VRTWLPaxmDIygudKIyJ6AP8BoPgVFRoQ5Q&oe=6AAEB56C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/yqePnq", "id": "2144472652514970", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036684_2144472659181636_6421205896860270592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y5014ARsGuAQ7kNvwG78uf8&_nc_oc=AdoUpX6PPl1RrA8C8k-kBwXDNho0S3NDe7cc-XU-3M1796hZUPMs1C146Aj7QYrL1hM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL98nJyrpSJL0KUPdTcaEMEULkm-0ZcIiAyUsQq_LF_eg&oe=6AAE9392"}, "display_name": "Waltz of the Wizard: Extended Edition", "keywords": ["Magic", "Wizard", "Waltz", "Introduction", "Fantasy"], "long_description": "Waltz of the Wizard is a joy-filled introduction to VR that anyone can enjoy and a sampler dish of things that make VR unique! Feel what it\u2019s like to have magical powers in this remaster of the original that introduces more spells, interactions and secrets. \n\nCast creative and diverse spells in a fully interactive world, discovering the many details of a world designed to feel real. Combine arcane ingredients into a boiling cauldron with the help of an ancient spirit trapped in a human skull. Travel to new places, finding yourself in mysterious circumstances full of detail and unforgettable atmosphere.\n\n\nFeature Overview\n\n- Brew magical spells & wield creative powers\n- Defeat guards & dodge traps in a labyrinth\n- Interact with strange artifacts & fun objects\n- Play minigames & collect trophies\n- Travel to new places & experience strange situations\n- Discover easter eggs & surprising details", "short_description": "Feel what it\u2019s like to have magical powers! One of the highest rated PC VR experiences comes to Quest in this remaster of the beloved original. Combine arcane ingredients into a boiling cauldron with the help of an ancient talking skull, unleashing diverse wizardry upon a fully interactive and mysterious world."}]}, "developer_name": "Aldin Dynamics", "developer_privacy_policy_url": "https://www.aldin.io/product/privacy-policy.html", "developer_terms_of_service_url": "http://aldindynamics.com/product/wotw-eula.html", "publisher_name": "Aldin Dynamics", "support_website_url": null, "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
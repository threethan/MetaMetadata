FF-Screens-Oct-01.png", "id": "1313712656589454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818860_1313712663256120_5100379216889933497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmnhIJ-Z9W4Q7kNvwG5vh5B&_nc_oc=AdqQehUpaX2q1F0GhIyDg77PWym_PL1wa177rhhi8jzQOUheVK-HcxHi-LQiFF2si1Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyE7qxAeoryiGg6U920zN8XjnCTuo8vz23-h-ocrXO43Q&oe=69C26A9F"}, {"file_name": "Waltz-SFF-Screens-Oct-4K-21.png", "id": "2078240576323325", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831056_2078240579656658_5593413265521317010_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQVNS9NPiKMQ7kNvwGCCVNv&_nc_oc=AdoapnzzK3a0zmeLma0R8YzKsD5DEpLIBjrwvzszfv83g9HL57Ubo0WbXWKtfeHk-wo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymqsqYqT6d8maezKMFJUzlAiEF60seHPFA5sCJoH3I2w&oe=69C27C1E"}, {"file_name": "Waltz-SFF-Screens-Oct-06.png", "id": "4352790001712089", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491818852_4352790005045422_6180061478550186019_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IcSTUZMwe58Q7kNvwG71Sui&_nc_oc=AdoHbDWgjpjpt9Ag_wdi6R5Hh6ltci6oUrBcPx7fuaMSr6LpKaQE7VeR1Xy92ceDb-Y&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQVwhYhQNLDEpSblKEYzhT_V9Q7LX4J23SoLyrhbkWRA&oe=69C2732A"}, {"file_name": "Waltz-Courtyard.png", "id": "847903511562122", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827063_847903514895455_8424544018859386936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6QqLzyJ74AQ7kNvwEdHarg&_nc_oc=AdoCGLZhUFTPhD_7UsX2wKcZZwvDzSK8yV-09b7GZEbVwAmwcY4eXHParudfhfijWgY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfypVlgxqgCt83xDCa5SnlxCVOZZDsQIt9fmGH4JNAJliA&oe=69C27BF4"}, {"file_name": "Waltz-SFF-Screens-Oct-07.png", "id": "1891817691459153", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499304938_1891817694792486_1753023146048352156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UNhnIgK3vigQ7kNvwENejsN&_nc_oc=AdpFx5ja_b_xPvSalcxFa1yGY0O9eZlBXb8ckdClmkwWa8X9ODeTHitUht8nGoV9XyY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjkxdanSQU_BUWECXi9RoDPRUURAh9gGDTY7wLieKNvw&oe=69C26D75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Waltz-Title-Graphic-2K.png", "id": "1559315708706504", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827567_1559315712039837_35591179336997646_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=76794w71PfcQ7kNvwFF_UYK&_nc_oc=AdpcmIj0C7Vox7WFwgqKxbfs1ax8QBNN2QKMtrSKLdvtVvFEhXEhqdGsPjvig0JeBhI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1WgSYYiqtl0G9HQwCfC2i9qVI10MCxWNKb6JLDrCedw&oe=69C28669"}, "display_name": "Waltz of the Wizard", "keywords": ["Waltz", "Skully", "wizard", "simulator", "sandbox"], "long_description": "\ud83c\udfc6  Top 50 Best Selling Quest Games of All Time - Meta\n\n\u2b50\ufe0f Featured in \"New Games We Love\" - Apple Editors\n\n\ud83c\udfc6 Winner of Best Updated Game - UploadVR\n\nWaltz of the Wizard is a Reality Experience  \u2014 a new form of game where you can do anything in a world where characters can talk to you and have thousands of reactions!\n\n\n\nYour journey begins in your magical tower where you combine arcane ingredients into a boiling cauldron with the help of your strange skull assistant, Skully, who you might learn to loathe or learn to love... which one will it be?\n\n{892716639889901}{3002450859954812}\nSkully features thousands of voice-acted dialogues and an enormous range of unique reactions. Skully is intensely aware\u2014responding not just to what you say, but also your gaze and gestures.\n\n{726877533808548}{731893429438281}\nYour magic abilities are dazzlingly diverse; summon storms of fireballs, manipulate time, transform objects into frogs, master natural magic particles. \n\n{749199877553351}{1261484555787771}\nUse voice interactions with blazingly fast responsiveness to talk to characters or use voice commands to magically modify anything to your heart's desire. For those who prefer to remain silent there is always the optional Type to Talk.\n\n{1362009512334229}{4301160073536412}\nDive into a fantasy world filled with bizarre curiosities, hilarious secrets and many hours of gameplay. Whether you\u2019re navigating Skully\u2019s past memories, hunting for glory in the Observer Fortress, or strapping Skully to some unstable medieval rockets.\n\n{1207215651375694}{1339838997892743}\nWaltz of the Wizard has greatly expanded with multiple free updates since the original release!", "short_description": "Waltz of the Wizard is a Reality Experience  \u2014 a new form of game where you can do anything in a world where characters can talk to you and have thousands of reactions! Your journey begins in your magical tower where you combine arcane ingredients into a boiling cauldron with the help of your strange skull assistant, Skully, who you might learn to loathe or learn to love... which one will it be?\n\n"}]}, "developer_name": "Aldin", "developer_privacy_policy_url": "https://www.aldin.io/privacy-policy", "developer_terms_of_service_url": "https://www.aldin.io/terms-of-use", "publisher_name": "Aldin", "support_website_url": "https://www.waltzofthewizard.com/", "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_playe
GYY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af37UMhVWBHX7ZgQtz4ejDKW5OjkrxLuIstgHLNzPWik9w&oe=69F0C451"}, {"file_name": "migrated_image.png", "id": "3163265210565748", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974616_555608881893659_4295527827886833664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gJNENV_9q2AQ7kNvwF-AVQl&_nc_oc=AdqTkowPHvV8blpQiMhAW-aCJJFC1diX7FVNUALHXk2F1KonSR1LrG5E3Yc3_YijS7s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2p2mTHKurpUJSZHI3vtE09CNUrDdgjo5Sn5q5wNY220w&oe=69F0A52C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/yqePnq", "id": "2144472652514970", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39036684_2144472659181636_6421205896860270592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E0kPn-gFRJQQ7kNvwE6MI2x&_nc_oc=Ado0MNsCGANQDTdhQkdwZRlUmleSMMdisEWEPySZIc1rTM3tb3YInAjHyj2GsA6pSro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1l_swSfej75LIkil8Lxd7Hb96UP_tTFXiFd5G-gYdcDA&oe=69F0BB92"}, "display_name": "Waltz of the Wizard: Extended Edition", "keywords": ["Magic", "Wizard", "Waltz", "Introduction", "Fantasy"], "long_description": "Waltz of the Wizard is a joy-filled introduction to VR that anyone can enjoy and a sampler dish of things that make VR unique! Feel what it\u2019s like to have magical powers in this remaster of the original that introduces more spells, interactions and secrets. \n\nCast creative and diverse spells in a fully interactive world, discovering the many details of a world designed to feel real. Combine arcane ingredients into a boiling cauldron with the help of an ancient spirit trapped in a human skull. Travel to new places, finding yourself in mysterious circumstances full of detail and unforgettable atmosphere.\n\n\nFeature Overview\n\n- Brew magical spells & wield creative powers\n- Defeat guards & dodge traps in a labyrinth\n- Interact with strange artifacts & fun objects\n- Play minigames & collect trophies\n- Travel to new places & experience strange situations\n- Discover easter eggs & surprising details", "short_description": "Feel what it\u2019s like to have magical powers! One of the highest rated PC VR experiences comes to Quest in this remaster of the beloved original. Combine arcane ingredients into a boiling cauldron with the help of an ancient talking skull, unleashing diverse wizardry upon a fully interactive and mysterious world."}]}, "developer_name": "Aldin Dynamics", "developer_privacy_policy_url": "https://www.aldin.io/product/privacy-policy.html", "developer_terms_of_service_url": "http://aldindynamics.com/product/wotw-eula.html", "publisher_name": "Aldin Dynamics", "support_website_url": null, "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644450513424858"}}]}, "scheduled_offers": {"count": 52, "nodes": [{"status": "PUBLISHED", "id": "1466306311886906"}, {"status": "PUBLISHED", "id": "1395838422006706"}, {"status": "PUBLISHED", "id": "1680588373255428"}, {"status": "PUBLISHED", "id": "2006771350159473"}, {"status": "PUBLISHED", "id": "24043267771971201"}, {"status": "PUBLISHED", "id": "742098301592279"}, {"status": "PUBLISHED", "id": "1094416219188173"}, {"status": "PUBLISHED", "id": "1138673704308575"}, {"status": "PUBLISHED", "id": "945450060817514"}, {"status": "PUBLISHED", "id"
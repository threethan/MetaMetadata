8081024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WbAHPB3EYfkQ7kNvwELViI5&_nc_oc=AdowD-DlXJqulWbd55kzDh4ROuQ-DmWNfW-mkBH3XzPVowb021Gbv7bE_-odvhu4Cts&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kQi5MxxFXYcXc5cnX0LmR5TWHMTKWXu3FEba9LLgPNw&oe=69E24AC5"}, {"file_name": "migrated_image.png", "id": "636685530442550", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031544_545547256241139_4582153892019568640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YRkBjoC-n4Q7kNvwHXJWe9&_nc_oc=AdpUYw7ZBNLuH9ygmKVGQ4wPbvbUn98pCJl832Be2wVHKDcKwktpQ-bCmN_6ytn5xdA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Nl1gVv_jAp46qEMS6rtLrBYdjgbrYY9UGSzBDrfpdoQ&oe=69E243D1"}, {"file_name": "migrated_image.png", "id": "3163265210565748", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974616_555608881893659_4295527827886833664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g5_H-1xwvdcQ7kNvwEoJMsL&_nc_oc=AdqxVpH2FQSJ4Qdqj1QLtfWKFPcpWUd_Jk7VliupTL9DU5NTsoyUHXwL2hNW-NKaRKY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3yS5nsb8b0xDlRzYINyp2VH8TwdcZ8dfM2GDSU57sHSg&oe=69E224AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/yqePnq", "id": "2144472652514970", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39036684_2144472659181636_6421205896860270592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1OJtmgcCqsQ7kNvwGFNYKE&_nc_oc=AdpjU8ZTqXciCeOu3qY1dEEN1vVP1uzdwpYTs8l3rJeR9tCMhtfsLIDqYvClvfZDQ1I&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rVray9mqHIleSed0Zehf3JrKT_kB2bccCYsYT3jGIeQ&oe=69E23B12"}, "display_name": "Waltz of the Wizard: Extended Edition", "keywords": ["Magic", "Wizard", "Waltz", "Introduction", "Fantasy"], "long_description": "Waltz of the Wizard is a joy-filled introduction to VR that anyone can enjoy and a sampler dish of things that make VR unique! Feel what it\u2019s like to have magical powers in this remaster of the original that introduces more spells, interactions and secrets. \n\nCast creative and diverse spells in a fully interactive world, discovering the many details of a world designed to feel real. Combine arcane ingredients into a boiling cauldron with the help of an ancient spirit trapped in a human skull. Travel to new places, finding yourself in mysterious circumstances full of detail and unforgettable atmosphere.\n\n\nFeature Overview\n\n- Brew magical spells & wield creative powers\n- Defeat guards & dodge traps in a labyrinth\n- Interact with strange artifacts & fun objects\n- Play minigames & collect trophies\n- Travel to new places & experience strange situations\n- Discover easter eggs & surprising details", "short_description": "Feel what it\u2019s like to have magical powers! One of the highest rated PC VR experiences comes to Quest in this remaster of the beloved original. Combine arcane ingredients into a boiling cauldron with the help of an ancient talking skull, unleashing diverse wizardry upon a fully interactive and mysterious world."}]}, "developer_name": "Aldin Dynamics", "developer_privacy_policy_url": "https://www.aldin.io/product/privacy-policy.html", "developer_terms_of_service_url": "http://aldindynamics.com/product/wotw-eula.html", "publisher_name": "Aldin Dynamics", "support_website_url": null, "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "s
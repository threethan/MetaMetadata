25/38974535_2588653668031688_6222245475358081024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9X-3GtudYYQ7kNvwFC9iXl&_nc_oc=AdqM08Jfc4FEnFy7SO36CB_uiwuQl88h4OJimMXQiDb86-tACC-NhoSlfkxkx2_l7-M&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6ljP-tIj07HUhnfv7FydjeV1tqpYr11Td71CwSglHYQ&oe=6A8D7585"}, {"file_name": "migrated_image.png", "id": "636685530442550", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/39031544_545547256241139_4582153892019568640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y8SXozb3Ae8Q7kNvwHTlgG2&_nc_oc=AdoHzyJOBlF-Kb5pCj9J2ahkHgqGUdtX_NfEGgTYITJxY8ZOFsRcl06o4GvfYIMfPck&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFOtLqREeBppGWHjZlextEO7ukjE4D7EusCIcsMENWxQ&oe=6A8D6E91"}, {"file_name": "migrated_image.png", "id": "3163265210565748", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974616_555608881893659_4295527827886833664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvdb_M15nyAQ7kNvwHhAJwa&_nc_oc=AdrrqocUbgYMVaH9YA8hXnSQsxZSyBtOrNPWoqySz0PN02ITFEhB05oUrglKi6_nHYU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLzBKDTX0aA5hs-1SaqAoqhmM2VqqO9ad3SoE8uVz8Mw&oe=6A8D87AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/yqePnq", "id": "2144472652514970", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39036684_2144472659181636_6421205896860270592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpWOHHVOFwIQ7kNvwGuMopn&_nc_oc=Adqwosuzjiihdk26lDauBnk70imazJirxcijvEtI4lGXMnpGURuNI2vJtPjxydyb8i8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtd5wbFvB9sxc22QFBAl6r8OAnoAmvlFYe8UZdn5-Rzw&oe=6A8D65D2"}, "display_name": "Waltz of the Wizard: Extended Edition", "keywords": ["Magic", "Wizard", "Waltz", "Introduction", "Fantasy"], "long_description": "Waltz of the Wizard is a joy-filled introduction to VR that anyone can enjoy and a sampler dish of things that make VR unique! Feel what it\u2019s like to have magical powers in this remaster of the original that introduces more spells, interactions and secrets. \n\nCast creative and diverse spells in a fully interactive world, discovering the many details of a world designed to feel real. Combine arcane ingredients into a boiling cauldron with the help of an ancient spirit trapped in a human skull. Travel to new places, finding yourself in mysterious circumstances full of detail and unforgettable atmosphere.\n\n\nFeature Overview\n\n- Brew magical spells & wield creative powers\n- Defeat guards & dodge traps in a labyrinth\n- Interact with strange artifacts & fun objects\n- Play minigames & collect trophies\n- Travel to new places & experience strange situations\n- Discover easter eggs & surprising details", "short_description": "Feel what it\u2019s like to have magical powers! One of the highest rated PC VR experiences comes to Quest in this remaster of the beloved original. Combine arcane ingredients into a boiling cauldron with the help of an ancient talking skull, unleashing diverse wizardry upon a fully interactive and mysterious world."}]}, "developer_name": "Aldin Dynamics", "developer_privacy_policy_url": "https://www.aldin.io/product/privacy-policy.html", "developer_terms_of_service_url": "http://aldindynamics.com/product/wotw-eula.html", "publisher_name": "Aldin Dynamics", "support_website_url": null, "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported
ens-Oct-07.png", "id": "1891817691459153", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304938_1891817694792486_1753023146048352156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HvsGLKqTkh8Q7kNvwG1yGDU&_nc_oc=Ado4bkVtSsy5wTO5qpgJ151TAbOLY6qJPI9E11i_INmyryd7RtIbQ3AVQ6eyBeq4Qiw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaov6JcADDBaQPFww3W5uBWc2-E08VGU8P3we-SvyG_w&oe=6ABE7435"}, {"file_name": "Waltz-SFF-Screens-Oct-09.png", "id": "1481400783375278", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/654854429_1481400786708611_5908143282131239403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_qFiK0JMgYUQ7kNvwEdOnvQ&_nc_oc=AdrqBuURwcDRRR3vIlnJVP6ZnCkU74mzusgitXdfAviKfnT5HhuzHVmV8GY2N-XoWYI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJLMWD8FYqAubEAiRsT4mlHiLkdKYNSnqQNxXCsWgSHeg&oe=6ABE68DF"}, {"file_name": "Waltz-Courtyard.png", "id": "847903511562122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827063_847903514895455_8424544018859386936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RfRb4t_55fUQ7kNvwHUzIHJ&_nc_oc=AdpN0JjUgOb2RdRwJNPl2gFFUgiRCzMC0PH82pMu5rW_SI9yEaSD_uII2KnlbHF17Oc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbuHudZfttiootS3kE_-1v7vkb-amNl82zMnvQB2wpTw&oe=6ABE82B4"}, {"file_name": "Waltz-SFF-Screens-Oct-4K-23.png", "id": "1275239621369967", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828028_1275239624703300_7789817690956169438_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESpJh4W3m2IQ7kNvwHjWh9h&_nc_oc=Adp9ubHH98dh71DoZPOaZolIjC5uZuoMXahKNT2sT_-BF7H05BM44936L9-xxzN4E3Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1OcRAfoMJY09x4agzAZRu-cba4LZl76T7qC4cRap4ow&oe=6ABE79A0"}, {"file_name": "Waltz-SFF-Screens-Oct-01.png", "id": "1313712656589454", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491818860_1313712663256120_5100379216889933497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gh_09xEeoxoQ7kNvwHg0bYK&_nc_oc=Ado7Zi8gYSj0qD3DY1wg6x_KcbTsItWqVYni4iFIzl254nD0Kb2fyPYg2OfHozhIXrM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUFyembuerwObDVWLndlcveD4PaiB08KtsLU5SPXKNZA&oe=6ABE715F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Waltz-Title-Graphic-2K.png", "id": "1559315708706504", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827567_1559315712039837_35591179336997646_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-2-YoGANDtwQ7kNvwEHQRSe&_nc_oc=Ado38ql64auedxZxq1TLo69V4uSAyZfP25PqLEG_0qRm1l-KLHmSDI9w2y5-SSQog3E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKa0lTqZHQ5IJRWs5gBQyEjwTynX4_RbmvtERqph2T-8g&oe=6ABE8D29"}, "display_name": "Waltz of the Wizard", "keywords": ["Waltz", "Skully", "wizard", "simulator", "sandbox"], "long_description": "\ud83c\udfc6  Top 30th Best Selling Quest Game of All Time - Meta\n\n\u2b50\ufe0f Featured in \"New Games We Love\" - Apple Editors\n\n\ud83c\udfc6 Winner of Best Updated Game - UploadVR\n\nWaltz of the Wizard is a Reality Experience  \u2014 a new form of game where you can do anything in a world where characters can talk to you and have thousands of reactions!\n\n\n\nYour journey begins in your magical tower where you combine arcane ingredients into a boiling cauldron with the help of your strange skull assistant, Skully, who you might learn to loathe or learn to love... which one will it be?\n\n{892716639889901}{3002450859954812}\nSkully features thousands of voice-acted dialogues and an enormous range of unique reactions. Skully is intensely aware\u2014responding not just to what you say, but also your gaze and gestures.\n\n{726877533808548}{731893429438281}\nYour magic abilities are dazzlingly diverse; summon storms of fireballs, manipulate time, transform objects into frogs, master natural magic particles. \n\n{749199877553351}{1261484555787771}\nUse voice interactions with blazingly fast responsiveness to talk to characters or use voice commands to magically modify anything to your heart's desire. For those who prefer to remain silent there is always the optional Type to Talk.\n\n{1362009512334229}{4301160073536412}\nDive into a fantasy world filled with bizarre curiosities, hilarious secrets and many hours of gameplay. Whether you\u2019re navigating Skully\u2019s past memories, hunting for glory in the Observer Fortress, or strapping Skully to some unstable medieval rockets.\n\n{1207215651375694}{1339838997892743}\nWaltz of the Wizard has greatly expanded with multiple free updates since the original release!", "short_description": "Go play in a wildly immersive magic sandbox where you become a mischievous wizard in a realm filled with spells, sarcasm, and secrets. Your sassy companion, Skully, cracks jokes while you unleash chaos\u2014just remember never to poke, dunk, or throw him. Dive into a world of bizarre curiosities, hilarious mysteries, and hours of gameplay, whether you\u2019re navigating Skully\u2019s past memories, hunting for glory in the Observer Fortress, or strapping Skully to unstable rockets!"}]}, "developer_name": "Aldin", "developer_privacy_policy_url": "https://www.aldin.io/privacy-policy", "developer_terms_of_service_url": "https://www.aldin.io/terms-of-use", "publisher_name": "Aldin", "support_website_url": "https://www.waltzofthewizard.com/", "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supp
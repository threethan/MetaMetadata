ens-Oct-07.png", "id": "1891817691459153", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304938_1891817694792486_1753023146048352156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-kj7pi2xeJ4Q7kNvwHpIu90&_nc_oc=Ado6IF0ShabHu7N7zbwZh8Th5-6ldCxiRXLD6CoFP4aKxC4vXErufiij6nLJ7w91zLQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2jO8MaMtJHr4A-D5ek4pmHVnHVPS3O8t9aM7J0E55Mw&oe=6A901775"}, {"file_name": "Waltz-SFF-Screens-Oct-09.png", "id": "1481400783375278", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654854429_1481400786708611_5908143282131239403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8BiKerFIq4EQ7kNvwHhzmwD&_nc_oc=AdrQFcy3M6PI16T1z4uTHqWsb8jMZahAZp4ezyKfaY_zZ_4nHf8SV5j5wlUMq3bHnG4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHumqGrSMuTEQXT53dNC7lXPNuvp7cbSHfpUAiGWvRt9g&oe=6A900C1F"}, {"file_name": "Waltz-Courtyard.png", "id": "847903511562122", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827063_847903514895455_8424544018859386936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPZXD6aH3UEQ7kNvwG7SZ8m&_nc_oc=AdrO13YmRRY0b6DUbYGB7J3gnJiNNkcE99PiKKVmquLmL42LQoxZj1EBVX77JBzLi9I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLrvXYypgcn_4JxUq0g8JJZQxJ_AXn0__DcR0R6stCjw&oe=6A9025F4"}, {"file_name": "Waltz-SFF-Screens-Oct-4K-23.png", "id": "1275239621369967", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491828028_1275239624703300_7789817690956169438_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uAgfg39thEIQ7kNvwEDBmxs&_nc_oc=AdpfOF7ZcitW-zjzuW4WBtyTIpNVcIAl_4vIJuxCtmrxvRPBOJLJPZo6U2G8iZ8p_kI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcNWqSKYVEO9Uali6NNnc51_1mruzzXSlOLPewHYcT_w&oe=6A901CE0"}, {"file_name": "Waltz-SFF-Screens-Oct-01.png", "id": "1313712656589454", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491818860_1313712663256120_5100379216889933497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-23KfsUb_0MQ7kNvwHViHWf&_nc_oc=Adph4OOIldj1L4JEYw6LJAQJTL0ydGb4dg0J_V3XGK5ZJ2I-ci8jmzroNqJhD7kTENc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3flmkGSQqKoZk_BBpsdxoWBP6qSRKhkH6aw5l4AvDrQ&oe=6A90149F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Waltz-Title-Graphic-2K.png", "id": "1559315708706504", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827567_1559315712039837_35591179336997646_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtsWyFC6YTkQ7kNvwHA0R3Z&_nc_oc=AdqDNNh2RWoj5Y_n9WFPz2cqEaU47S5doUhkMOHw1lcDU8HBsxD02BFwoHzpnMuXre4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGX5PojW4IClOhOtlUrqqWRmIL58jDIHzpEbWT3jFFlA&oe=6A903069"}, "display_name": "Waltz of the Wizard", "keywords": ["Waltz", "Skully", "wizard", "simulator", "sandbox"], "long_description": "\ud83c\udfc6  Top 30th Best Selling Quest Game of All Time - Meta\n\n\u2b50\ufe0f Featured in \"New Games We Love\" - Apple Editors\n\n\ud83c\udfc6 Winner of Best Updated Game - UploadVR\n\nWaltz of the Wizard is a Reality Experience  \u2014 a new form of game where you can do anything in a world where characters can talk to you and have thousands of reactions!\n\n\n\nYour journey begins in your magical tower where you combine arcane ingredients into a boiling cauldron with the help of your strange skull assistant, Skully, who you might learn to loathe or learn to love... which one will it be?\n\n{892716639889901}{3002450859954812}\nSkully features thousands of voice-acted dialogues and an enormous range of unique reactions. Skully is intensely aware\u2014responding not just to what you say, but also your gaze and gestures.\n\n{726877533808548}{731893429438281}\nYour magic abilities are dazzlingly diverse; summon storms of fireballs, manipulate time, transform objects into frogs, master natural magic particles. \n\n{749199877553351}{1261484555787771}\nUse voice interactions with blazingly fast responsiveness to talk to characters or use voice commands to magically modify anything to your heart's desire. For those who prefer to remain silent there is always the optional Type to Talk.\n\n{1362009512334229}{4301160073536412}\nDive into a fantasy world filled with bizarre curiosities, hilarious secrets and many hours of gameplay. Whether you\u2019re navigating Skully\u2019s past memories, hunting for glory in the Observer Fortress, or strapping Skully to some unstable medieval rockets.\n\n{1207215651375694}{1339838997892743}\nWaltz of the Wizard has greatly expanded with multiple free updates since the original release!", "short_description": "Go play in a wildly immersive magic sandbox where you become a mischievous wizard in a realm filled with spells, sarcasm, and secrets. Your sassy companion, Skully, cracks jokes while you unleash chaos\u2014just remember never to poke, dunk, or throw him. Dive into a world of bizarre curiosities, hilarious mysteries, and hours of gameplay, whether you\u2019re navigating Skully\u2019s past memories, hunting for glory in the Observer Fortress, or strapping Skully to unstable rockets!"}]}, "developer_name": "Aldin", "developer_privacy_policy_url": "https://www.aldin.io/privacy-policy", "developer_terms_of_service_url": "https://www.aldin.io/terms-of-use", "publisher_name": "Aldin", "support_website_url": "https://www.waltzofthewizard.com/", "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supp
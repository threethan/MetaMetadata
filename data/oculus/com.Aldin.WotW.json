ens-Oct-07.png", "id": "1891817691459153", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304938_1891817694792486_1753023146048352156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gZDhUeiAiqoQ7kNvwEtYOaA&_nc_oc=AdoWIhV-y2E6tWAZgou9-1-i0V4jcKWn9I01bXmGsIq9WnlUq7ODczKsovnuk272wUA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCc0g-ghsfWrGDhaq4vscdinlfEIvhhLq8ormr4kN_TWQ&oe=6A579F35"}, {"file_name": "Waltz-SFF-Screens-Oct-09.png", "id": "1481400783375278", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/654854429_1481400786708611_5908143282131239403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aMgi3pEZngwQ7kNvwH_1PAw&_nc_oc=AdpUB8EqdeGDPYZs2aPb_t3vQyT1X7NYgvB-OCyJoSVjJVk-fZyf0fMu9TQ8vVVt4Gw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDN4jZbK9cnOLd29bQ4Qiu8HlL0loSr0XTVYhW8nC2JGQ&oe=6A5793DF"}, {"file_name": "Waltz-Courtyard.png", "id": "847903511562122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827063_847903514895455_8424544018859386936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9avAm8RVOq4Q7kNvwGNdw29&_nc_oc=AdpoC5kJ14eUHRTVjEefYS5kELEfSJY9WSxOcjB_Gnly_9k63CE7eCNgvHF3In65FLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP-DnQf7knCRv1K3rqIgqEqqz5zBqiKF3oixj-0HpHRA&oe=6A577574"}, {"file_name": "Waltz-SFF-Screens-Oct-4K-23.png", "id": "1275239621369967", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491828028_1275239624703300_7789817690956169438_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ACT9_AbpdsQ7kNvwFWiSF0&_nc_oc=AdpB3Vwb0dsXfgloB5eZBiB0FDaMEezvCsVdfkvmzqd6U-GXtMHknv_w88ZOCbAPt7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUwlhHyidY8c4sa79cgSpKK8sZFrbg4vq6bJxvkAObvw&oe=6A576C60"}, {"file_name": "Waltz-SFF-Screens-Oct-01.png", "id": "1313712656589454", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491818860_1313712663256120_5100379216889933497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQ60BvPhGKsQ7kNvwHaqamZ&_nc_oc=AdqiKb0C3ejjiE8N5iYwNCedklxWYLoUxguAbtfyKRHCX_VlRovRMD2mYkY6353Cw54&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOgnx9mdgFJpVhSXvovr-UjXTj_crtTUADVWh_Zj_OkQ&oe=6A579C5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Waltz-Title-Graphic-2K.png", "id": "1559315708706504", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827567_1559315712039837_35591179336997646_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbxG6aJpGhQQ7kNvwHN53s-&_nc_oc=AdpydJ1lLI2XrbAzaOvXsGERxlaJ9qmrpl1k38yf4kmtD8el6XpY2yKIK8F7LQ6HLX4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-arsL30COvkrxCQCiRq-H2G7IUXDFQwKr2Qk9LuSCWQ&oe=6A577FE9"}, "display_name": "Waltz of the Wizard", "keywords": ["Waltz", "Skully", "wizard", "simulator", "sandbox"], "long_description": "\ud83c\udfc6  Top 30th Best Selling Quest Game of All Time - Meta\n\n\u2b50\ufe0f Featured in \"New Games We Love\" - Apple Editors\n\n\ud83c\udfc6 Winner of Best Updated Game - UploadVR\n\nWaltz of the Wizard is a Reality Experience  \u2014 a new form of game where you can do anything in a world where characters can talk to you and have thousands of reactions!\n\n\n\nYour journey begins in your magical tower where you combine arcane ingredients into a boiling cauldron with the help of your strange skull assistant, Skully, who you might learn to loathe or learn to love... which one will it be?\n\n{892716639889901}{3002450859954812}\nSkully features thousands of voice-acted dialogues and an enormous range of unique reactions. Skully is intensely aware\u2014responding not just to what you say, but also your gaze and gestures.\n\n{726877533808548}{731893429438281}\nYour magic abilities are dazzlingly diverse; summon storms of fireballs, manipulate time, transform objects into frogs, master natural magic particles. \n\n{749199877553351}{1261484555787771}\nUse voice interactions with blazingly fast responsiveness to talk to characters or use voice commands to magically modify anything to your heart's desire. For those who prefer to remain silent there is always the optional Type to Talk.\n\n{1362009512334229}{4301160073536412}\nDive into a fantasy world filled with bizarre curiosities, hilarious secrets and many hours of gameplay. Whether you\u2019re navigating Skully\u2019s past memories, hunting for glory in the Observer Fortress, or strapping Skully to some unstable medieval rockets.\n\n{1207215651375694}{1339838997892743}\nWaltz of the Wizard has greatly expanded with multiple free updates since the original release!", "short_description": "Go play in a wildly immersive magic sandbox where you become a mischievous wizard in a realm filled with spells, sarcasm, and secrets. Your sassy companion, Skully, cracks jokes while you unleash chaos\u2014just remember never to poke, dunk, or throw him. Dive into a world of bizarre curiosities, hilarious mysteries, and hours of gameplay, whether you\u2019re navigating Skully\u2019s past memories, hunting for glory in the Observer Fortress, or strapping Skully to unstable rockets!"}]}, "developer_name": "Aldin", "developer_privacy_policy_url": "https://www.aldin.io/privacy-policy", "developer_terms_of_service_url": "https://www.aldin.io/terms-of-use", "publisher_name": "Aldin", "support_website_url": "https://www.waltzofthewizard.com/", "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supp
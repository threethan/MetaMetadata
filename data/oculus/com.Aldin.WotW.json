8653668031688_6222245475358081024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C_4qlt3-g1IQ7kNvwETnPXv&_nc_oc=AdruAkEUcmE-52iOFjFjViuL1o7rYjdymP3UCbAH_vfU9wX20GgAM2utxPX-t2IrjOs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInueA7TH8iJeRIa1H6OMYIc2uST7p6ybp57XOshFWc6g&oe=6AA41745"}, {"file_name": "migrated_image.png", "id": "636685530442550", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031544_545547256241139_4582153892019568640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bR_Uy8DKMiYQ7kNvwF4_Vfz&_nc_oc=AdrSFyw3ONasFD2VoclpYdOEzFHtQzkK1IVxmKrU1Dxjxb47Nwp405VpaJu_Ed39ITw&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH0VtFNfVcqiCbcJHPV3N3sT3oxQipyun7x5DTrCY-7Q&oe=6AA41051"}, {"file_name": "migrated_image.png", "id": "3163265210565748", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974616_555608881893659_4295527827886833664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAMreUWhxBwQ7kNvwFAJkPN&_nc_oc=AdovTmRRXcgoscuhm9hQBZ3LvjA3Mi5y5hirn05V8qW8bhI_EN-sb62Qbb0J0Eb4BNw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZt1rNIaU5LK1_irhklGufW2jkoNRJ6luvRwXQDpEWYQ&oe=6AA3F12C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/yqePnq", "id": "2144472652514970", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036684_2144472659181636_6421205896860270592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MZlXvKp8jcsQ7kNvwEDurni&_nc_oc=AdoCnMCmayR-wpMxC-ZafnFryyi0xfJYtUaVS5UMg6ZojgbZrfw_AQvvX6TkHTQiuK8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgrMlZ_Vk6XyxhLOgg3T4R__jzsfWblYGZz2Ym2E33og&oe=6AA40792"}, "display_name": "Waltz of the Wizard: Extended Edition", "keywords": ["Magic", "Wizard", "Waltz", "Introduction", "Fantasy"], "long_description": "Waltz of the Wizard is a joy-filled introduction to VR that anyone can enjoy and a sampler dish of things that make VR unique! Feel what it\u2019s like to have magical powers in this remaster of the original that introduces more spells, interactions and secrets. \n\nCast creative and diverse spells in a fully interactive world, discovering the many details of a world designed to feel real. Combine arcane ingredients into a boiling cauldron with the help of an ancient spirit trapped in a human skull. Travel to new places, finding yourself in mysterious circumstances full of detail and unforgettable atmosphere.\n\n\nFeature Overview\n\n- Brew magical spells & wield creative powers\n- Defeat guards & dodge traps in a labyrinth\n- Interact with strange artifacts & fun objects\n- Play minigames & collect trophies\n- Travel to new places & experience strange situations\n- Discover easter eggs & surprising details", "short_description": "Feel what it\u2019s like to have magical powers! One of the highest rated PC VR experiences comes to Quest in this remaster of the beloved original. Combine arcane ingredients into a boiling cauldron with the help of an ancient talking skull, unleashing diverse wizardry upon a fully interactive and mysterious world."}]}, "developer_name": "Aldin Dynamics", "developer_privacy_policy_url": "https://www.aldin.io/product/privacy-policy.html", "developer_terms_of_service_url": "http://aldindynamics.com/product/wotw-eula.html", "publisher_name": "Aldin Dynamics", "support_website_url": null, "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
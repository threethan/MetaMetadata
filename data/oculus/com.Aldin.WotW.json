KZowFnuPUVmTJXMMswMRpIxkTHjQx_bgysyQ&oe=69AAB385"}, {"file_name": "migrated_image.png", "id": "636685530442550", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031544_545547256241139_4582153892019568640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2MHy8i9GBxgQ7kNvwFGaQos&_nc_oc=AdnGiuLJcQNbJsEFNr6C8CLavURAPuEziA0r13txDhrj0D2wl_HwXGXa46Nnt9d8JFg&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwbCZ9gbuaB5LlV8ffOQ8zwWN13yfpIFX_0GyH7Rp9p6g&oe=69AAE4D1"}, {"file_name": "migrated_image.png", "id": "3163265210565748", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974616_555608881893659_4295527827886833664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFiMp0yLxqMQ7kNvwFFX5Ya&_nc_oc=AdmHF96JY2S7CW7Ub2wLkl6iO7vfLMoiACx4ofNaeQrkRPmYqZiOCN2pUbbo73lYnCw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_AfxACAu2Mcd2GUpspuyCuycBMafWU3Rc-jfwufwNkp6-qg&oe=69AAC5AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/yqePnq", "id": "2144472652514970", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036684_2144472659181636_6421205896860270592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9JCmNExH2QQ7kNvwEoXdsc&_nc_oc=Adn9OXHoxVk9O9SbE7Uda6jA0Qur6bdk1W1lc-qPKP_AvUVx6KutOkFwJrIzPeaQeXg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afxy9WhwZ9t7oxk5JtlOOB-y7qGhUleZ3TGYeS_A1amcRA&oe=69AADC12"}, "display_name": "Waltz of the Wizard: Extended Edition", "keywords": ["Magic", "Wizard", "Waltz", "Introduction", "Fantasy"], "long_description": "Waltz of the Wizard is a joy-filled introduction to VR that anyone can enjoy and a sampler dish of things that make VR unique! Feel what it\u2019s like to have magical powers in this remaster of the original that introduces more spells, interactions and secrets. \n\nCast creative and diverse spells in a fully interactive world, discovering the many details of a world designed to feel real. Combine arcane ingredients into a boiling cauldron with the help of an ancient spirit trapped in a human skull. Travel to new places, finding yourself in mysterious circumstances full of detail and unforgettable atmosphere.\n\n\nFeature Overview\n\n- Brew magical spells & wield creative powers\n- Defeat guards & dodge traps in a labyrinth\n- Interact with strange artifacts & fun objects\n- Play minigames & collect trophies\n- Travel to new places & experience strange situations\n- Discover easter eggs & surprising details", "short_description": "Feel what it\u2019s like to have magical powers! One of the highest rated PC VR experiences comes to Quest in this remaster of the beloved original. Combine arcane ingredients into a boiling cauldron with the help of an ancient talking skull, unleashing diverse wizardry upon a fully interactive and mysterious world."}]}, "developer_name": "Aldin Dynamics", "developer_privacy_policy_url": "https://www.aldin.io/product/privacy-policy.html", "developer_terms_of_service_url": "http://aldindynamics.com/product/wotw-eula.html", "publisher_name": "Aldin Dynamics", "support_website_url": null, "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "644450513424858"}}]}, "scheduled_offers": {"count": 51, "nodes": [{"status": "PUBLISHED", "id": "1395838422006706"}, {"status": "PUBLISHED", "id": "168058837325542
DI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7r5CYkytR5_uUKivUtS5hRb8t8hks8WqIgBJx_LB5yQ&oe=6B0856B4"}, {"file_name": "Waltz-SFF-Screens-Oct-4K-23.png", "id": "1275239621369967", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491828028_1275239624703300_7789817690956169438_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xjew5Fns0skQ7kNvwEC6nwy&_nc_oc=Ado0UPTy93_1yejF8M0jwPsJP_bugXqpPb4LSZCbdMJZ8y7BCY101V4UGF0CMkJJoeA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBWb_pwXKU8EPAQ7D9ww4v6dl3FgxEhkzy4BDe1PGSOg&oe=6B084DA0"}, {"file_name": "Waltz-SFF-Screens-Oct-01.png", "id": "1313712656589454", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491818860_1313712663256120_5100379216889933497_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5rt0kmlacYQ7kNvwHgtryV&_nc_oc=Ado-VZyIx1IVLtjtEWS0wBsJ5Kv1jP1X68QKMP-ME_O7A8kU4eGJpjklxjnyWQWYZ4c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS77f0zDbaZfQz5GprjGMlGh7PB2We8dJjbJYa8lTjWfw&oe=6B08455F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Waltz-Title-Graphic-2K.png", "id": "1559315708706504", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827567_1559315712039837_35591179336997646_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nd4bOFlaNiIQ7kNvwHuhdj-&_nc_oc=Adrj8joyn70p2LYsVF_uBA7HTcegQaJIxFixMw_SKZX0xTGMfUFAzpd1s5rkfq1g3UE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbRKpsoo5zE2-Cp1Tytz8WyReWopB8ptmAC_la6LpGOA&oe=6B086129"}, "display_name": "Waltz of the Wizard", "keywords": ["Waltz", "Skully", "wizard", "simulator", "sandbox"], "long_description": "\ud83c\udfc6  Top 30th Best Selling Quest Game of All Time - Meta\n\n\u2b50\ufe0f Featured in \"New Games We Love\" - Apple Editors\n\n\ud83c\udfc6 Winner of Best Updated Game - UploadVR\n\nWaltz of the Wizard is a Reality Experience  \u2014 a new form of game where you can do anything in a world where characters can talk to you and have thousands of reactions!\n\n\n\nYour journey begins in your magical tower where you combine arcane ingredients into a boiling cauldron with the help of your strange skull assistant, Skully, who you might learn to loathe or learn to love... which one will it be?\n\n{892716639889901}{3002450859954812}\nSkully features thousands of voice-acted dialogues and an enormous range of unique reactions. Skully is intensely aware\u2014responding not just to what you say, but also your gaze and gestures.\n\n{726877533808548}{731893429438281}\nYour magic abilities are dazzlingly diverse; summon storms of fireballs, manipulate time, transform objects into frogs, master natural magic particles. \n\n{749199877553351}{1261484555787771}\nUse voice interactions with blazingly fast responsiveness to talk to characters or use voice commands to magically modify anything to your heart's desire. For those who prefer to remain silent there is always the optional Type to Talk.\n\n{1362009512334229}{4301160073536412}\nDive into a fantasy world filled with bizarre curiosities, hilarious secrets and many hours of gameplay. Whether you\u2019re navigating Skully\u2019s past memories, hunting for glory in the Observer Fortress, or strapping Skully to some unstable medieval rockets.\n\n{1207215651375694}{1339838997892743}\nWaltz of the Wizard has greatly expanded with multiple free updates since the original release!", "short_description": "Go play in a wildly immersive magic sandbox where you become a mischievous wizard in a realm filled with spells, sarcasm, and secrets. Your sassy companion, Skully, cracks jokes while you unleash chaos\u2014just remember never to poke, dunk, or throw him. Dive into a world of bizarre curiosities, hilarious mysteries, and hours of gameplay, whether you\u2019re navigating Skully\u2019s past memories, hunting for glory in the Observer Fortress, or strapping Skully to unstable rockets!"}]}, "developer_name": "Aldin", "developer_privacy_policy_url": "https://www.aldin.io/privacy-policy", "developer_terms_of_service_url": "https://www.aldin.io/terms-of-use", "publisher_name": "Aldin", "support_website_url": "https://www.waltzofthewizard.com/", "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26773074268996014"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/491823270_2058147135123361_3542769960660892499_n.png?stp=dst-png_s360x360&_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RjsYlmYfSsQ7kNvwGFCRy2&_nc_oc=Ado3khhEFqocHrw5OOlRnk2kiA_uCw05BDVMlTSASdEIjJcv9YH_fRm15Z8dxMohe84&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNNmXkJA-JmQRk3M79tvkZP5FarFrULJzrBwlX9iTTlw&oe=6B08643D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Waltz of the Wizard", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Sandbox", "id": "1990104051447093"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date"
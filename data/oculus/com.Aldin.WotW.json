8653668031688_6222245475358081024_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hDiQ5sjLyo0Q7kNvwEtZ7Qh&_nc_oc=Ado4ZMcg9qb-Kt9f0qK6IcdCYp8IIilxBI54oMqc980Hl4Cv5QL8k6Psw-ple3Y1UdU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYyUhJRlUn7D_C4v8Zyiz0RnIJmlD0HtP0HrvRX1aqQA&oe=6AA95D45"}, {"file_name": "migrated_image.png", "id": "636685530442550", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031544_545547256241139_4582153892019568640_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QC04w9qPAH4Q7kNvwETn-zM&_nc_oc=AdpJlUnMgL5BfdTikdiasiM71D4bMN1QYh-AB84hCxpgT1YsAGjQc0R9DBnHLCIKkAo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK11L4W6SV2_Rr2r0l5wofx2NDN0V78l15VvLJquIZyQw&oe=6AA95651"}, {"file_name": "migrated_image.png", "id": "3163265210565748", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974616_555608881893659_4295527827886833664_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1XrG-2xBdYQ7kNvwFS97l1&_nc_oc=AdpPFEIALderesSUMb7S4Qit2JptzwIxEAhni_9lGgYKfGSElkKIjF-rSoEVrcLeEII&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMcRe3KciEPp6xV2sc_dke9CnxvP6l1j4awbzOsVylwg&oe=6AA9372C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/yqePnq", "id": "2144472652514970", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/39036684_2144472659181636_6421205896860270592_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rcXnheTRlrAQ7kNvwFU1Si8&_nc_oc=AdprrA_HQ29ZoWHMZy9z9BDiO_UZBFeZd6P2tnKAiQsyMNHxDsoWMP-ZvwxPap_eDMo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEJBCs3wSBPbnQur70zbetErXxB1e5g4Jgo8we8HX5_A&oe=6AA94D92"}, "display_name": "Waltz of the Wizard: Extended Edition", "keywords": ["Magic", "Wizard", "Waltz", "Introduction", "Fantasy"], "long_description": "Waltz of the Wizard is a joy-filled introduction to VR that anyone can enjoy and a sampler dish of things that make VR unique! Feel what it\u2019s like to have magical powers in this remaster of the original that introduces more spells, interactions and secrets. \n\nCast creative and diverse spells in a fully interactive world, discovering the many details of a world designed to feel real. Combine arcane ingredients into a boiling cauldron with the help of an ancient spirit trapped in a human skull. Travel to new places, finding yourself in mysterious circumstances full of detail and unforgettable atmosphere.\n\n\nFeature Overview\n\n- Brew magical spells & wield creative powers\n- Defeat guards & dodge traps in a labyrinth\n- Interact with strange artifacts & fun objects\n- Play minigames & collect trophies\n- Travel to new places & experience strange situations\n- Discover easter eggs & surprising details", "short_description": "Feel what it\u2019s like to have magical powers! One of the highest rated PC VR experiences comes to Quest in this remaster of the beloved original. Combine arcane ingredients into a boiling cauldron with the help of an ancient talking skull, unleashing diverse wizardry upon a fully interactive and mysterious world."}]}, "developer_name": "Aldin Dynamics", "developer_privacy_policy_url": "https://www.aldin.io/product/privacy-policy.html", "developer_terms_of_service_url": "http://aldindynamics.com/product/wotw-eula.html", "publisher_name": "Aldin Dynamics", "support_website_url": null, "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EXPLORATION", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
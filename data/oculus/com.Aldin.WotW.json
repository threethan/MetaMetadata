uscdn.com/v/t64.5771-25/491818860_1313712663256120_5100379216889933497_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6QxFb2Nx9IQ7kNvwGUG3gm&_nc_oc=AdlZ6QeEjnHqKqGna_SmuymGocNDMcRL_frvJsxrIYAaTBrCTsfGzgTV05cHl3PGo9s&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1hc5H5iE0ayiMFgXrRxDfIaJ1aBOtccTPAtq8YAK1eg&oe=69AAE7DF"}, {"file_name": "Waltz-SFF-Screens-Oct-4K-21.png", "id": "2078240576323325", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491831056_2078240579656658_5593413265521317010_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GF6yrdKNdawQ7kNvwFdOGVt&_nc_oc=AdmoFePMNxxuNb1CSAEcNaKw906UBnTZXQW-ZXgejrRxlOEt8cjikjvQsQN_Ia7i_1U&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7zXm2M-MXq1sAEzgysXsxqkNvEvz19xS4SinD1xg0mg&oe=69AAC11E"}, {"file_name": "Waltz-SFF-Screens-Oct-06.png", "id": "4352790001712089", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818852_4352790005045422_6180061478550186019_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HWynmc8xz4AQ7kNvwF_e4wu&_nc_oc=Admvvwaz-mowGGlg_0LOJIC6Xyix4graOFjrZwvmKCk0yj2MbuBKERNkgcSIa6M20ZE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBTsuiiAIh3fR1NcV_y2dghrP61z5GHOrhJ3JkLixiog&oe=69AAB82A"}, {"file_name": "Waltz-Courtyard.png", "id": "847903511562122", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827063_847903514895455_8424544018859386936_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hi1Yw14OzpIQ7kNvwHZPa9X&_nc_oc=AdkhlZw2OOArAnKLV8COVcw5CpJvQ5ziS0XJ-0k5nucuEBGUtj4kr_k6l-xWjVvtSfE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyOyxRty4f_8tr9Z0fx3lAuSaR8WGOvQfVv_dLrFL_A4Q&oe=69AAC0F4"}, {"file_name": "Waltz-SFF-Screens-Oct-07.png", "id": "1891817691459153", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499304938_1891817694792486_1753023146048352156_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zgawHxYEVGMQ7kNvwFN2EvA&_nc_oc=AdnUWYS6vZdr91R3smkqfgrLMYWO99FMSogECL9r6nz3_27Xx6HmIv-mwDPbePnd5gQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afx4f6bR_kTBRwsLeEzVOOuFdNaocD9mJS5zHAw8MjiEpw&oe=69AAB275"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Waltz-Title-Graphic-2K.png", "id": "1559315708706504", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491827567_1559315712039837_35591179336997646_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3OUYUzKhHsQ7kNvwE9EEWN&_nc_oc=AdnbDqhmDbfy18SF9h5tyZ3Pa5JnmsMsUJEmPPq2GZbiEImewLLhLZ-INoDv6CvBYaM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_AfwxO9hkhVmLeiVdtY7DrhiH-3pCgA5lJeDi-bMAhuG3kw&oe=69AACB69"}, "display_name": "Waltz of the Wizard", "keywords": ["Waltz", "Skully", "wizard", "simulator", "sandbox"], "long_description": "\ud83c\udfc6  Top 50 Best Selling Quest Games of All Time - Meta\n\n\u2b50\ufe0f Featured in \"New Games We Love\" - Apple Editors\n\n\ud83c\udfc6 Winner of Best Updated Game - UploadVR\n\nWaltz of the Wizard is a Reality Experience  \u2014 a new form of game where you can do anything in a world where characters can talk to you and have thousands of reactions!\n\n\n\nYour journey begins in your magical tower where you combine arcane ingredients into a boiling cauldron with the help of your strange skull assistant, Skully, who you might learn to loathe or learn to love... which one will it be?\n\n{892716639889901}{3002450859954812}\nSkully features thousands of voice-acted dialogues and an enormous range of unique reactions. Skully is intensely aware\u2014responding not just to what you say, but also your gaze and gestures.\n\n{726877533808548}{731893429438281}\nYour magic abilities are dazzlingly diverse; summon storms of fireballs, manipulate time, transform objects into frogs, master natural magic particles. \n\n{749199877553351}{1261484555787771}\nUse voice interactions with blazingly fast responsiveness to talk to characters or use voice commands to magically modify anything to your heart's desire. For those who prefer to remain silent there is always the optional Type to Talk.\n\n{1362009512334229}{4301160073536412}\nDive into a fantasy world filled with bizarre curiosities, hilarious secrets and many hours of gameplay. Whether you\u2019re navigating Skully\u2019s past memories, hunting for glory in the Observer Fortress, or strapping Skully to some unstable medieval rockets.\n\n{1207215651375694}{1339838997892743}\nWaltz of the Wizard has greatly expanded with multiple free updates since the original release!", "short_description": "Waltz of the Wizard is a Reality Experience  \u2014 a new form of game where you can do anything in a world where characters can talk to you and have thousands of reactions! Your journey begins in your magical tower where you combine arcane ingredients into a boiling cauldron with the help of your strange skull assistant, Skully, who you might learn to loathe or learn to love... which one will it be?\n\n"}]}, "developer_name": "Aldin", "developer_privacy_policy_url": "https://www.aldin.io/privacy-policy", "developer_terms_of_service_url": "https://www.aldin.io/terms-of-use", "publisher_name": "Aldin", "support_website_url": "https://www.waltzofthewizard.com/", "website_url": "http://aldin.io/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "SIMULATION", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": [
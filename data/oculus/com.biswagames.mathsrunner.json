, {"file_name": "migrated_image.png", "id": "265308111143921", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974915_2838734949491052_289091929411420160_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r12essZzMQ8Q7kNvwEsxT78&_nc_oc=AdnQMQmV-sjboJAKAhUUHcyzUC4-nF8EwhafEhBIJ3B54DI9bQ07-XHFbBnpPKTxo3A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtfRWg-WD-R8sOv_VrAKwf-sM8SFsV_hmtiXJs4d3Imw&oe=69AEB946"}, {"file_name": "migrated_image.png", "id": "1063157350716135", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982458_602582763884763_4254057895714357248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u7wWzhZgDUQ7kNvwE97Hkq&_nc_oc=AdnATtJK9X5_tQBSNbKNwb92w1HbrHpcWeUTofDShrFACzSwEri3ohBTbuW7CSjUsJQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz2kt-0xldRNv6kPsHmjVE39J6syXvJELRjo7CwGjxMRQ&oe=69AEB759"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MuGxlQ", "id": "748047012367967", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974895_748047015701300_2758205324358844416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ul9QjEHMHKYQ7kNvwEL9GdE&_nc_oc=AdlsBjJa4twJtc3h3v6TaqS5U5smmWhtmtdmqwf8_2OwyZHjrLi6CuogG3uTmU3KtSY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJG1zOVnEUcF9RihvChfv8NeAfkwdNvLlYXrHFsi9AXg&oe=69AECAD6"}, "display_name": "Maths Runner", "keywords": ["Infinite", "Racer", "temple", "run", "Kid"], "long_description": "Want to check your Addition/Subtraction skills? Then Maths Runner is the game for you. Maths Runner is an infinite racing game. Player needs to run through infinite environments while solving the mathematics question. Doors to the next environment will only open if the user solves the questions correctly. Multiple choices will be there in the environment to choose from. You can use \u201cCrush\u201d power up to destroy a question and move to the next environment. You can also use\n Revive to continue the game even after a wrong answer\n Magnet to collect all coins for few seconds\n Wizard to disable questions and move without any challenge for few seconds\n 2X to get double bonus coins for few seconds\nYou will experience\nLovely Fantasy world\nMultiple Complexity of Mathematics\nConcentrate Avoid Obstructions created by Fantasy Worlds \nAttract the coins using Magnets", "short_description": "Want to check your basic Mathematics skills while concentrating for obstacles?"}]}, "developer_name": "Biswanath Das", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/app/MathsRunner.html", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476539040547748"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1605883170233182"}, {"status": "PUBLISHED", "id": "473292573358617"}]}, "baseline_offer": {"id": "473292573358617"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1605883170233182"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2903193179717916", "version": "1.02"}, "id": "734720470379919", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary
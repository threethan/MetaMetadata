, {"file_name": "migrated_image.png", "id": "265308111143921", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974915_2838734949491052_289091929411420160_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AalyG2uU8SQQ7kNvwHxB2-i&_nc_oc=AdmvpmK6ETZ-giLyetPqlcMyJ0ouIe6fII4FiXRg-hisMH73UYnm--h-s9Iok0YFN68&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrHpWbgZ_Ztz6ytqn6onMjwfL5mMo6Xm6z5eNBPnIAKQ&oe=69BBE846"}, {"file_name": "migrated_image.png", "id": "1063157350716135", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982458_602582763884763_4254057895714357248_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1HlT7-hosEQ7kNvwEhJ9sy&_nc_oc=Adlc7QnCsC_7lgTFaySTqAzSd12acdZXUKifEuXOo9a1hfLjdHOdoLkS7pov1mix2ew&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afw96goUkworkqqzBetajJeC3Azcgl-8TKwM90QATL6aTw&oe=69BBE659"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/MuGxlQ", "id": "748047012367967", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974895_748047015701300_2758205324358844416_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=paA-iUWDyucQ7kNvwEvWWTm&_nc_oc=AdmQ0wuzceEtR53gcday-oxN_cag7IT1sctMd4p2KqMJPXiORjzL0eTq-vWcG5P2Ojk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzvbZVh6lB3vfnpMGRXLBHz_Gykoj9iI5qPu2iCD98RKg&oe=69BBF9D6"}, "display_name": "Maths Runner", "keywords": ["Infinite", "Racer", "temple", "run", "Kid"], "long_description": "Want to check your Addition/Subtraction skills? Then Maths Runner is the game for you. Maths Runner is an infinite racing game. Player needs to run through infinite environments while solving the mathematics question. Doors to the next environment will only open if the user solves the questions correctly. Multiple choices will be there in the environment to choose from. You can use \u201cCrush\u201d power up to destroy a question and move to the next environment. You can also use\n Revive to continue the game even after a wrong answer\n Magnet to collect all coins for few seconds\n Wizard to disable questions and move without any challenge for few seconds\n 2X to get double bonus coins for few seconds\nYou will experience\nLovely Fantasy world\nMultiple Complexity of Mathematics\nConcentrate Avoid Obstructions created by Fantasy Worlds \nAttract the coins using Magnets", "short_description": "Want to check your basic Mathematics skills while concentrating for obstacles?"}]}, "developer_name": "Biswanath Das", "developer_privacy_policy_url": "https://www.biswagames.com/privacy_policy/app/MathsRunner.html", "developer_terms_of_service_url": null, "publisher_name": "Biswa Games", "support_website_url": null, "website_url": "https://www.biswagames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "476539040547748"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1605883170233182"}, {"status": "PUBLISHED", "id": "473292573358617"}]}, "baseline_offer": {"id": "473292573358617"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1605883170233182"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2903193179717916", "version": "1.02"}, "id": "734720470379919", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary
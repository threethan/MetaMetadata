29V6HvFGC0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqe8P7NOOgroOAk-WQHMWc79wMYoQqvqhgCqvtcBNmhQ&oe=6AEB54E1"}, {"file_name": "screenshot_4_extintores.png", "id": "1809414633542111", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_1809414640208777_3150196199529904157_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eSmZCXcXj4Q7kNvwHkKOV7&_nc_oc=Adom_hC6fvqF6KGxsILlGElexnLndmbg64Par1vjh9liQSjFNbo8NQE_sbnYojUH1gY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfr1zjNJVzO0Ogl_ePHPCEN9g2dPK_JQz6jmFBxDB8Bg&oe=6AEB4AEA"}, {"file_name": "screenshot_2_hogar.png", "id": "964318546748885", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673573223_964318550082218_4317553278397688131_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hyJkUM226PIQ7kNvwHL0yz8&_nc_oc=Adpp7nF3Z7PusYRH0Rbyz8yFcrvvrH9JT1BrjgBvxL6e3GLQNLSZ9U4wkslJoZpqVH8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQE2gEaiD3UvUEtZu6NZjSjyTSTHDP4x2fwhm1Z4f8bqw&oe=6AEB39AE"}, {"file_name": "screenshot_1_seguro.png", "id": "4435787426681551", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/596068480_4435787430014884_2005443197244827102_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J0DjqriBOMQ7kNvwFERuu5&_nc_oc=AdrJFL_TjKcgPIqIH0hzoUz1L_sFvg7zuCJwj8G77GLSldr8xFOz6O4dCmQmlwVrEiw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNFnbCjocGWvjUCLr7rxmtXZZ0K4csaLOnmEpRSvddXQ&oe=6AEB6092"}, {"file_name": "alternativa_resumen.png", "id": "1472490001458684", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831279_1472490004792017_1402957174549615280_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM5VPA17OKcQ7kNvwFzhYCj&_nc_oc=AdpXJQqOHMiqXm3Slj9GxEhAK0MywPEuXlii23FTdbVCbKfo-_Ji_mhIF-JwfPh1eCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRh2b-KdL95ONwLQK0RpgawBcE1MXSyf3fQdTywvQJeyQ&oe=6AEB55A6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simulador Profesional: Uso de Extintores", "keywords": ["extintor", "simulador", "incendio", "amago"], "long_description": "Simulador profesional para capacitar en el uso correcto de extintores, sin fuego real, sin polvo qu\u00edmico y sin riesgos para las personas ni las instalaciones.\n\nENTORNOS DE CAPACITACI\u00d3N\n\u2022 Entrenamiento: tome el extintor, retire el seguro y descargue.\n\u2022 M\u00f3dulo te\u00f3rico: tipos de fuego y el extintor adecuado para cada uno.\n\u2022 Simulaciones en hogar, oficina, bodega, sala de clases, cocina industrial y zona minera.\n\u2022 Quiz: elija el extintor correcto seg\u00fan el tipo de fuego.\n\nEVALUACI\u00d3N EN TIEMPO REAL\nDetecta el retiro del seguro, la distancia segura, el ataque a la base del fuego y el movimiento de abanico. El fuego se propaga si no se controla a tiempo y, al terminar, el alumno recibe un resumen de lo que hizo bien y de lo que debe corregir.\n\nC\u00d3MODO Y F\u00c1CIL DE USAR\nManejo natural con las manos, sin botones que memorizar ni joystick. Todo al alcance, incluso en espacios reducidos. Usuarios ilimitados por visor, ideal para capacitaciones grupales.\n\nPARA EMPRESAS, OTEC E INSTITUCIONES\nApoya la instrucci\u00f3n en el uso de extintores exigida por el D.S. N\u00b0 594 (Art. 48). Complementa la capacitaci\u00f3n presencial, no la reemplaza.\n\nDEMO GRATUITA Y LICENCIAS\nPruebe gratis el Entrenamiento y la simulaci\u00f3n Oficina. El contenido completo se activa con una licencia para empresas: por horas, anual o perpetua. Cotice en www.digitalstudio.cl.\n\nDesarrollado en Chile por DigitalStudio.", "short_description": "Capacite a su equipo en el uso correcto de extintores, sin fuego real y sin riesgos. Enfrente amagos de incendio en entornos realistas: hogar, oficina, bodega, sala de clases, cocina industrial y zona minera. El simulador reconoce sus gestos y eval\u00faa el retiro del seguro, la distancia segura, el ataque a la base del fuego y el movimiento de abanico. Pruebe gratis el m\u00f3dulo de Entrenamiento y la simulaci\u00f3n Oficina; el contenido completo requiere una licencia para empresas."}, {"images": {"nodes": []}, "id": "1079693765051561", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Simulador Profesional: Uso de Extintores", "keywords": [], "long_description": "Simulador profesional para capacitar en el uso correcto de extintores, sin fuego real, sin polvo qu\u00edmico y sin riesgos para las personas ni las instalaciones.\n\nENTORNOS DE CAPACITACI\u00d3N\n\u2022 Entrenamiento: tome el extintor, retire el seguro y descargue.\n\u2022 M\u00f3dulo te\u00f3rico: tipos de fuego y el extintor adecuado para cada uno.\n\u2022 Simulaciones en hogar, oficina, bodega, sala de clases, cocina industrial y zona minera.\n\u2022 Quiz: elija el extintor correcto seg\u00fan el tipo de fuego.\n\nEVALUACI\u00d3N EN TIEMPO REAL\nDetecta el retiro del seguro, la distancia segura, el ataque a la base del fuego y el movimiento de abanico. El fuego se propaga si no se controla a tiempo y, al terminar, el alumno recibe un resumen de lo que hizo bien y de lo que debe corregir.\n\nC\u00d3MODO Y F\u00c1CIL DE USAR\nManejo natural con las manos, sin botones que memorizar ni joystick. Todo al alcance, incluso en espacios reducidos. Usuarios ilimitados por visor, ideal para capacitaciones grupales.\n\nPARA EMPRESAS, OTEC E INSTITUCIONES\nApoya la instrucci\u00f3n en el uso de extintores exigida por el D.S. N\u00b0 594 (Art. 48). Complementa la capacitaci\u00f3n presencial, no la reemplaza.\n\nDEMO GRATUITA Y LICENCIAS\nPruebe gratis el Entrenamiento y la simulaci\u00f3n Oficina. El contenido completo se activa con una licencia para empresas: por horas, anual o perpetua. Cotice en www.digitalstudio.cl.\n\nDesarrollado en Chile por DigitalStudio.", "short_description": "Capacite a su equipo en el uso correcto de extintores, sin fuego real y sin riesgos. Enfrente amagos de incendio en entornos realistas: hogar, oficina, bodega, sala de clases, cocina industrial y zona minera. El simulador reconoce sus gestos y eval\u00faa el retiro del seguro, la distancia segura, el ataque a la base del fuego y el movimiento de abanico. Pruebe gratis el m\u00f3dulo de Entrenamiento y la simulaci\u00f3n Oficina; el contenido completo requiere una licencia para empresas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.digitalstudio.cl/politica-de-privacidad-simulador-extintores", "developer_terms_of_service_url": null, "publisher_name": "DigitalStudio Chile SpA", "support_website_url": null, "website_url": "https://www.digitalstudio.cl/simulador-de-uso-de-extintores/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24219303147719333"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1125179853282867"}]}, "baseline_offer": {"id": "1125179853282867"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793110080, "status": "PUBLISHED", "id": "1125179853282867"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28765425506440385", "version": "3.1.0"}, "id": "1416186062829393", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fa
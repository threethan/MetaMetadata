iler.mp4_000030.066.png", "id": "976069656931239", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75207239_976069660264572_2757592674545957932_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kwRTYl05VEYQ7kNvwH9sxZ6&_nc_oc=AdqBU0zzqY2OWQfH9YLnKdSUNWzoTI4sLJu6M6F-A7BdBcOuBWPHExyHyjoPJofqZ5M&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIIoOXcqTk4oDwTdYrYRunkvOQEypkp3FStlZVe4wFgYw&oe=6AAEA7FD"}, {"file_name": "Meta Store Trailer.mp4_000132.933.png", "id": "1268267374559900", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39035341_1268267377893233_48067521865112634_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLbTXxtl0v8Q7kNvwHwGtkz&_nc_oc=Adp3hYS0KMPgAxvPn48iHQNK7Nv0_gFOmhuscdM1VGluxzNEQYTi4u10S-xChxh8-KE&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcosT4MGB-DUi7aORzPJ4kJ1fiAXezmx7IZX40wSQkzQ&oe=6AAE8D3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Meta Store Trailer.mp4_000107.596.png", "id": "1637484883685084", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974628_1637484887018417_7252704979020135469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3lRFLm8logUQ7kNvwHtlQLI&_nc_oc=AdqhH_EPdZTGiQRjWyZhTDSn-1R_s7keORbhSGCqFwowsDiq6E4uQ88f6zA_zrpy7Y0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPs5LJqKcJtDBu3StQY_nFTOswJ-M5AiC9-k9EmqWfVg&oe=6AAE9A7B"}, "display_name": "Color Factory", "keywords": [], "long_description": "Welcome to COLOR FACTORY, an immersive mixed-reality idle game where your hands hold the power to create and control. Using intuitive hand gestures, build and optimize your very own factory right in your living space. Manage resources, construct new buildings, and experiment with unique color combinations\u2014all with simple movements of your hands. As an idle game, COLOR FACTORY continues to produce and grow even when you're not actively playing, ensuring that your factory is always expanding. Engage in a hands-on experience that combines creativity with strategy. Immerse yourself in the vibrant world of COLOR FACTORY and become the ultimate factory tycoon!", "short_description": "Color Factory is a mixed-reality idle game where you build and expand your factory using your hands.\nCreate a miniature factory right in your bedroom, which will keep running even when you're away!"}]}, "developer_name": "SpeedofShadow", "developer_privacy_policy_url": "https://gold-noemi-88.tiiny.site/", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "https://github.com/SpeedofShadow", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25269964615982261"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "446791487833349"}]}, "baseline_offer": {"id": "446791487833349"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1714422600, "status": "PUBLISHED", "id": "446791487833349"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25270063942638995", "version": "0.1.0"}, "id": "299011599909013", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25269964595982263", "is_concept": false, "l
KPdvs2yQyHQqLS_oGIDRM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIktepDfdRqi2k9bevm_zIpCpLw1oW_0qXRsdXtUrctDw&oe=6AA15847"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YA1RW3xyTwQ7kNvwE_O2Md&_nc_oc=AdoZyzIMPiM_5ptedO61JMo1yzzr_28200IiXj14Yj1Pe_DuUh2aTzMlNYsZ-s_QrZs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEmGZ8AgpXYAE_tCNgDKk-2j6yjS1dn8_e8OClR9SgsQ&oe=6AA17799"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2pDztbqhuIAQ7kNvwFxYo70&_nc_oc=AdoNyzLZu2RgMQ3wYUiwy4PD1mW32N15ax3RxNMjRgwdqzU9wv9ViuV2o8hyzXb9jAw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGT4FdmLgMeyOvjNGMiXytvJNHHHpuwccBV_vbWO-obg&oe=6AA17D0B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xIVewsbqoQAQ7kNvwHVBFBC&_nc_oc=Adq1VjcaMXPv5j_1J8Ww3DIh3-drF80ySjFNGfxyNh4UC9iZIdqwDbXYlxAQtTQOyrc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwu-x7VDL9CCnTTvZPupTv31dx5d_eACu6l500NhMAjg&oe=6AA14ADE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9RR_a9xDZ10Q7kNvwHl87PS&_nc_oc=AdrunXBdGBjrSJhN77zZK2u4Wc68m6hQwMLmH5QcIeuhQv0EPNz2dc7Ie7QhkL5H95A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI5QImRYLGeLBPSQAYB7PidCpKmRXH6yG9QXpB3qa21Tw&oe=6AA15AA5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
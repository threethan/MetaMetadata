b34-Doy7O1FO3ViQAXSFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAl1WnFylhKImjdD1x7mS86lTwu9cvqN7ptYJZh1iYWog&oe=6A675647"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lSYo2sKDzMQ7kNvwHgovD1&_nc_oc=AdqCwvGMWbMct0RjSUKl0_wcA5VwkwJ2BBQkvmH84mbVJB5HKtKNyt7MNhtJDHWmdrc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3GhEv-J0_y0nTSfo3SchhDlKYRhpTn2y5xfCAja6C3A&oe=6A677599"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8t90kH32qckQ7kNvwFiCktX&_nc_oc=AdoTtx3M84HLbZ0Yra4R3hDlKNKuKsMRFqBU71heWDvEliXf5Uz2Djy1OxAHs64kCFQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACOI3t9fgwOpRy2QvVGvVrnNnYTxM3pew5L6pV-dojkw&oe=6A6742CB"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HgfTFi1NzYQ7kNvwEil_OH&_nc_oc=Adoz5ORZmXgaNephCxdeehLcSojqV2MiY14ZivkmAY7GpRS92w7ruP8UE2cnMmBH80E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuOpyXz8F2CAAiwO0DuQPwhLA74bNR9kIS-OM7JIfJug&oe=6A6748DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xIQNStjwqcQ7kNvwFhi3KO&_nc_oc=AdqiMAu2h6pXr9lDyel2hrOSDfuYch54Xl4gW85MuCQ2zrwO-JpvU5cCs9Bs7um-kxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChIMVCYf7VwAB2H29SOndu9pBR0LXWMkoe31rOpIkknQ&oe=6A6758A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
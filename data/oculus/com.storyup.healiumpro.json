Nl0QepQ1ioXbA49OCV7MI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuf__c7PUN2hjDIROhty2mgKEqrNBEwKgaGkUbeKiMiQ&oe=6ACA6F07"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0BXGh5RjLH4Q7kNvwHPuz9N&_nc_oc=AdpB3uWPGHPkNFr8CH8fSpbGYYC6mH_XKD2j1Fwgiu6kmV5hrA-1yYLxZtt_sUGeYcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMeclmO4yP35fyG8GBnw0nrmj1p47ZeR6srv3x24IwzQ&oe=6ACA5619"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEz2G2PyyaIQ7kNvwHF0dX3&_nc_oc=AdoKCp1ku3bl-Gdd3yvsFRXiK9Qz-Xrnip7rotk4v0-nbr7Ccwpst8cSp5GxhrF_JOw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-Jjj0W4oV4nD-cDsYrbsdNBggkGHXObN1ZNRAdFfEaw&oe=6ACA5B8B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZuNW35wsc8Q7kNvwGq8xds&_nc_oc=Adr9Iut0h5E26YrK5zzP0u0eqjL4IUstUECBQ4i6dhYmGGt5RinWHb4c_SUMr37OEdg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCLU4fbt58CevobLZuLM56VBo9agkNkXNh-Yv9N5bUng&oe=6ACA619E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JRGpq2UybhwQ7kNvwFdnFAb&_nc_oc=Adq975xmEtv_8tigU9Eem7RKDwVARgsbk_PBgb9e8Aiyx0u7vOwM2PDdaVGyDVonioQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDRjsLwOAuMT-F4442gNz0XaFV4BkePPRlpat8RqtCcw&oe=6ACA7165"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
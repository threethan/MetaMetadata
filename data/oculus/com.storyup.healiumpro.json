1TL5LEix5tSORMMucwteZIyQvw&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJjDCosIKfPFDEY6Mic2uAX3jRekptVAl3D6HPuKNEvA&oe=6AAE8747"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kcjck_o29wQQ7kNvwG5CDtb&_nc_oc=AdobRRZZWkI9DeMiIw1S3oBS_yN8NEphCD6mWOH0P6GejpN5JbIhpfUznN9_6ohsF5s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIee_GmndRe_d9tBUcawMgCFW8UoDois_dov3Kdbr3Omw&oe=6AAEA699"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLu2Njydm8MQ7kNvwFLLe83&_nc_oc=AdrBOOR3nPdPSRGq6gkGZagqd2CggvL2AAbiK6PzSr6kLEd3FgvzGsnD5TPsWjNFr7w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIcfT0fQ9GMWSKAx5pBF06d7NyFAzb-8UwjE4Hbf3Z9ww&oe=6AAEAC0B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjxeOQ1Ti-UQ7kNvwFaNsZt&_nc_oc=AdrEgi3Q0nv3fXstcQZ5VQcKpjATI8lp-ir5DWvrY8BQmo7KtVkwciuoS61bIkfqW2g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKw1Rn-aLD7ZqwnZDzEK-WsZK6a6qZLsh_JjvRlGg5fDw&oe=6AAEB21E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fO1_1sZZG5AQ7kNvwFZ0uTT&_nc_oc=AdoxYrPCzs1Z79CYM3jke5GRzDG78HvU75kD8153XiHLfxGVj-hOy4K-HkkogekhOng&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkN6MJD-Me3BY0U2HY2ElWa0jRUX29J7kmMQrsl7ZVJA&oe=6AAE89A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category":
4HG4fdY0qTFcBqOjDsLpo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCNCXG8MTklfSytkASga8BbMIWCo04eMSzjr6FXRHrWA&oe=6ACE6387"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uTmDWbO9OzEQ7kNvwGWKMqu&_nc_oc=AdriJU_bVp-wOm8eF1NCEn0cYQfQFVit6zSug6CJtFfr8J1zBhuqvdr5FR6oJj5qTW8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiwPpuvmR7Pr6tuATMS3QibKLA--SdFpLCLSebzOhy3A&oe=6ACE4A99"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBOoA9Mp0nsQ7kNvwGMwGzP&_nc_oc=AdrL_sO6qMMUulZ99kKBhK7CHq6YwJXXhszWBX15lPvRHNE0HKC4TaYdABzfIb5uzr0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3rJ6cDYKcDTYAYQo0sreCgwT-ZQpLpOC4IzFMN-bypA&oe=6ACE500B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19yJDlxmJ_gQ7kNvwH-tuYL&_nc_oc=AdrwWzTkKhiT8_yucJivnf_6gLqpjJIdCNgyoiixyR3WPbpC4zUKQ72cXv26V4wbj3k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMot__5nI-67SuOiAkSepe5nutTYzSRn3mkAENy51mfUw&oe=6ACE561E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43TB3-aAmagQ7kNvwEH7jK7&_nc_oc=AdqgYWP0nr70zIooYQn6ABzw5qn1kFn-t_GJ09MtlcARwtfhnc716tOaFf7YBxzUU1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmNvYJ1sifoit_nIL_OT1JX-t0_L6E1R-UkET9o9wSMw&oe=6ACE65E5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
H6ue803y9uY4z2aDnrusA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0tC_3r83J-MW4xQhMZzq-UsGZFCW5ELT6oS_mYnafUw&oe=6AECB607"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHVrGIH-RdAQ7kNvwF98Xir&_nc_oc=Adp-QlAq6VfGpOIlp1Oqkf8Bc0XT8mrKQxGMRmu_2WXrzajMKVJS62084a7nIJwE1b4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCTBcnKBqT-ItDyYE-rR64MEYa0hdqVD9XxhiFFg25Mw&oe=6AEC9D19"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFPOUaimT1QQ7kNvwE2rN9A&_nc_oc=Adpyz3m_9k7ySHqS5O6U22er8EeosZPDuwW8LMJXqv1Mia3yuc2csgyAZqGP4QiS8o8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3Q9KWoZpTd7AQaEwIRUmQoFfla4FBNQKp4FGVewmJbA&oe=6AECA28B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kG1mIKhPQekQ7kNvwG7jclA&_nc_oc=AdrGnoR6T5iO-jhCTZGxX-53uPgYMJL0hA1NmKbfH-p2_RNvZcVwYP2hsoUbntHPTGY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSENF6Y6yNaae36HXgGqenCULckBApcgeMYSm-aSxjdBA&oe=6AECA89E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss9XYQbRBp8Q7kNvwHH9hm7&_nc_oc=AdrF8J94jnNWxNY8h0O1xqeW7lee9ohNUTg7wsMLpY9sSSlL9YXnHzJjnAWiKNMpG6c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKEJhvMknpXshiF9xnhxahMxlfFhfAyr-65XI41tlfxg&oe=6AECB865"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
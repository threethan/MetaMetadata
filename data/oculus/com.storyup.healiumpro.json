1Y-tFeXPnpQdsYCnUzrWuoM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvjOH2amgSQf7Ocgua_0dbTlh3Vo1a4ocJhp7L2FFKjg&oe=6AC52907"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WIDZ5AVJGQQ7kNvwEJtU7C&_nc_oc=Adr1w6F671CZmk4MfNyZlp5rfiMhHTbV7sbw4WqMy9iGKMALz8D5rZ6w4Mbew4V1COM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPb1F0i8iB19hIncfe01TAQkMiaPgtQu163S7KgDTV94Q&oe=6AC51019"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I9VIE-FHLskQ7kNvwFKjlFV&_nc_oc=AdqWB-aEJuMjoP_cIlIwpbdUy14waYDtvJRtAJiKF9rX0eHdER8S-n1vG32oLHcBwdc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYWBmVtUdT5d48mBDWRqbbsHbAmdGjoljJY3C0UaKWDQ&oe=6AC5158B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9zcGlekrgBcQ7kNvwFCwzNV&_nc_oc=AdoSYAB5qFnhWN-I7DdsYRxhrB0KqKxzMkTJm9ustG_74teDnq1cLXiXwH9Y_pzZSDs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPP2K08PTNPojulcBLWA8GgUrv3gpaDXyDgTv5oAjB6dQ&oe=6AC51B9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZWcVQ4oE1oQ7kNvwGRcNpx&_nc_oc=AdqoPfvCmTNDhA_oo1EFrfgOOwzw6njrpMB-z7dwyBKmR7Ev_5r2nd3YoDJxI0uSiXU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFOd_pSqmITS9SxvOdflvLAlPe7E0cChfPnmNrTYwIUQ&oe=6AC4F325"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
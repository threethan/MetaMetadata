jKz0uIymTXCtYHhODkCM8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6P_1DMKgYPuwZ9ESCLv6h0qBq8zrAhjbBwZPu5Owynw&oe=6AA54CC7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cWsPOEJt6S8Q7kNvwFrZTbM&_nc_oc=AdrCjb02fgqsywb5vg7phHlX_17dHDZ0TjV0vF6fG2XG78TaEGGL7n7svijwYy4GLNs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7HL5NAs0vLKB4e8axzxjAepEXIO4CGqbT3dA2fJBFvw&oe=6AA56C19"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=giRyzmi5HvwQ7kNvwFLEbww&_nc_oc=AdqB2LFA_iSWTb5ch0tb172eXpqy6qax6V45zCc85ikcPRs3UbklQbG9bZTnxIua2Ew&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz5NupXe5Sz-IJ0J7g7uil2N1ALERsIWsDxrAY09fatg&oe=6AA5718B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Idw9TNfnwycQ7kNvwFlsYMw&_nc_oc=Adra6_QGzXvBy1WWks6ZSSfDgpmgVd5-HTC5841iN7HWOuuxQUaqq_If1PbBF0Gqu8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlPjGUXI42AGWZF7NltW3rGQYkyPYPZSytMjgTpqeWTg&oe=6AA5779E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHKxfbRceqIQ7kNvwHflkOT&_nc_oc=AdpHx4KplMQ-iAMhCP49agkSFghRAvc0khTnMO3y5WsOXZ5d6YJdOFeEE8_FmYu3Q2E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTJHr6dPfLPRrCl-dU2drstD_WmpoO-tjmeHJ-zZE3AA&oe=6AA54F25"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
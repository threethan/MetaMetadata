3DXoyzrB3CHwel4TOyGl4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5S7KpHrqjJOV3lY1iAbB-p6y1rybDYxU6A4KtECa0Hw&oe=6AEF5907"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oHVrGIH-RdAQ7kNvwF7GAUO&_nc_oc=AdrBVrQjRJ6wTP_lDL4vYYdlusvUQ1XhLY8s2aVS8qbai63s2zKim7Lp3UGpgwFiQVI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9Vg5wMSpN2_y48IVl81fhqbA0cAOrpDWA8B8xS8kiKQ&oe=6AEF4019"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM7URQXFkrAQ7kNvwGk1WTq&_nc_oc=AdrS15MmZcg2Uj2rPXyhlC7XlSvtogrH8lxTWz21vCOe4XtTxT7sQn8ZyOIERWRyTYc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQx54JlyWcaxXZm7Qld9JPSqNhg2--CAB4dgfVdjD5gTA&oe=6AEF458B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiolugNwqqUQ7kNvwFMcesf&_nc_oc=AdpWtrqaiJbd-xnXpZCHzIeRVQGQFiZk-2hUtrCCWb-yCXPmPr0mThhDXnlFVbqPrlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4MLCzac0rVYrVydcqxOPWrbe-8ZNdLv60-5VPEGBYUg&oe=6AEF4B9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ss9XYQbRBp8Q7kNvwHHopBq&_nc_oc=AdpMVLaZL0SsDNmPAXuTYogEaGGGsYDqcArP4yIpR5hdK-DJV-9qbHH9xAaipoogZQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQToli9lLOW2Hd6tiOPrNexQSCvxE5IjA5Kgrm2M3dC_Rw&oe=6AEF5B65"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
oJjmcclSng_67MRqCneQLWQ_Oal5aura-euqiDU8yr6pUt6TIkm2_p1P14e8CA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvQUqVVnNWq1RDXcR_ZcwqlQylf-ZfikS-qRv6HkXj8A&oe=6AB29B19"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkuNdDS5K8sQ7kNvwEpkUSr&_nc_oc=AdpBffpOTjU7iZSNrqSKYc5QbXxc7WYerJVABgNPBdD6paMt_y7qFb8XlpNA08063Fg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBiRo9SRwbdLD33gp0Gt-MZ9c2MAWR7MVLXzWrtVjd3g&oe=6AB2A08B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hlGMaKQr7QQ7kNvwEEkm47&_nc_oc=AdqsmfUh5Eyv6fzR_uWVkX40dibrog2ByyDbZiMgHJFaQ8wnORxoDZtY8B7B8VjciIA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn256w1KXLZuL_UBHAixZ2mQy1XoudfX3Lxsbw56f5sw&oe=6AB2A69E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DyNE1Bor78Q7kNvwFu9703&_nc_oc=AdpfuznQR86ZtOLs0DGmPRKRARM41A_LWsV8G5Z1Crp5rZZ0-Nz0HeP_Yb-soMKpx8E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXVe88u9DpYNc21biEG9NgIWlDOIuCv_4V7jH0Fjepkw&oe=6AB27E25"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["RELAXATION_MEDITATION", "TRAVEL", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
KsfgfCgnhgNrum9Bo0B2A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtOd_Y-13FvjEQ93OZbmYCB8TndwnXSxnBmTdQJB82Zw&oe=6A50ECC7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLDY8jHQYFEQ7kNvwHlzMk3&_nc_oc=AdpnojY4j2ptNSRw_xzvcyGkQEnTjvpmhxdtMf3gLmZy-b8a3TzIZVDQWgJOq_-_HA8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD67O6WJAlVGc_FuwcX-0rcyojTjWXLBm5xfzamaYKy4A&oe=6A510C19"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTN1JloKzWYQ7kNvwGpXB13&_nc_oc=AdrKZxuVS-aqgNtv3vzs_jIw89XW1m-CnwI06MVKs-f_KehNPQl-CPL7XIi8Dvrnezk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpjaIy_e_AXQeEn8OOArxwfy9McDJqBoG_kbUg4nYlyw&oe=6A51118B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj4XGYArhm0Q7kNvwHlYMrA&_nc_oc=AdqglILbFtDXAgwiUsRxUhfTh9XgAxZhMpaNDsnsBlB22gyiDHBsYa_6xCCegXUZmxg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL3h3do-xOdwXw2xY_Rn0V3U2UbT-hPtVslrfshtkMRA&oe=6A51179E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z-oqXfefungQ7kNvwFF3sb_&_nc_oc=AdqJdXd0WKNi-HFHyLFEGLCnbP8HPMonCHfzLbyfIpBIFud01cI7FH-viCj5tP-FbrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBs322eOpTEyWuRssTBY7qR3deWZxnoiTDzfZFJ8hsUzQ&oe=6A50EF25"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
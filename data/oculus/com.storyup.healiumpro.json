EAU_dvwRYn0ITHl57BR5M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgb_fJGmedNnQLuNDH3tNUlX_H4fSk0MuU1J--ijHkFg&oe=6AABE447"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6eDCa-nYVoQ7kNvwHU1bJA&_nc_oc=Adr7plh1QVVuvUU8pY9lD90gAI_PgpXrVHCAuxloV_dIZgACh66uOL9m2UaoeCzE4qk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIM6RECdPfCiH_-eUKcSgL-EPFQe7MRqW3mw_LPlxbA_g&oe=6AAC0399"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLu2Njydm8MQ7kNvwGqzAYC&_nc_oc=AdpsGw8TC_d-wBtXgwrLhpeQk9NXPqVb1LQj-Hn2URlWJQ-YDF29_xgTDOsSBCH_slQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRlgXoocuQVet56IRis95ObIePf6TbuVYro5OW-WbNTA&oe=6AAC090B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x2Ev-W3SAMQ7kNvwH0tQBr&_nc_oc=AdoAgFarfUXEHPoANgJLmIzKEHgaqbMcOOjZcU6kMFyyfu72CTs0NbGShUeQ_F_R3Dw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLegtiU4N5rrGBTuoi0jUtsvpW34sgxaMUxYC8CcCNLRw&oe=6AAC0F1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Rvw6H19_MwQ7kNvwEO4KB_&_nc_oc=Adqr_52lLgvAuX_d6HdZmJ2XHKfK1pv8VAfr-2VmliDlOKGUHKm_p1gYvCeiXjBrJOc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm5j0hirlkYZpidDXmbAJLOTxkvUV4UcfeIMnsUWINPQ&oe=6AABE6A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
tPZXlqWVxT_QmY71l89h0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJihtuGb0LN2-PxNDjsi6tKqC6CqGW8J39k9FHnZihQuA&oe=6AAA92C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l6eDCa-nYVoQ7kNvwG5IhjC&_nc_oc=AdoSZ81Z0tDUG6GjwJSKYkjr6lzC3EcYtCWSDGqff6EcknCqCk47pVrJgknL3dUoMEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy72pBGKApyeDbEz4raTHxPWSeewqgvc5SKHQaUd85Vg&oe=6AAAB219"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7c2ITK8FuFwQ7kNvwGdjKBi&_nc_oc=AdoZ1dwL5VaQF2AkwbNhkZdTUfs2jg30ivz_VQXYTF1UomJ99jobQm7_2CwFB3fYZ-k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqksN4RjqT8Z6QqPSyKbpUCqLRCSyViBrQTxtuy8RzNA&oe=6AAAB78B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x2Ev-W3SAMQ7kNvwGObyZJ&_nc_oc=AdqJeTH2jSJVjyzwbx7YToM903_06GxgDCuuRI9mNauE5xW4eBrBuRfimxjpcJNgm0g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuZjBHA7eMReP7kQAsbSMQlQtAYIAWlw19f0IC5xmGtw&oe=6AAABD9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Rvw6H19_MwQ7kNvwEKJpPo&_nc_oc=AdqO-nLs15IbfUg0DCZyWKnQIEe7WuyZ_ZE5vj0rDxB2GBGsNI-2Xz_G94gwjlFJz-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKsDwjE2dU7AW6Y5KDwfx7XYbZYZh22LqbGjmINZwnUTg&oe=6AAA9525"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
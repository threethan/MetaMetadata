lK1W3OIubydlw6yulw4MU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnIgR9tgRy4KOlcWyctaTvYglJdmzjbte9a5Q9dyqigw&oe=6AAD35C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kcjck_o29wQQ7kNvwEkVBb1&_nc_oc=Adp91jpX5V0-UbhZ6xgFaGfpx0uVUCmQxad70SLYmNBlB7nu6Xw3I5HvZolO9pXNK08&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSMG_VtZtF630O3q7tpYWTB6xROMUi_LL_Nhlxx88twA&oe=6AAD5519"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pLu2Njydm8MQ7kNvwGIjrqT&_nc_oc=AdqlEb5Ov7A1WVqeGYyW2RiQb2-jGIsBdS0_mWPIv6dra6GdiI8fovixoVAUU1mv6mE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKudB9ALsR4EyTxS3otmU5R9PkN04xPp-yL3E5jHkJFMg&oe=6AAD5A8B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3x2Ev-W3SAMQ7kNvwE0fnzI&_nc_oc=AdpVOsnCC6StmEzHCGyme081VNL9iO69fxy5uNnExH934-nHYQz-zmL0XPqluIhhojo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKV_2PNfh1UtaV_VU1OKRqc4KqBbGrdk6-1iCqEUYUepA&oe=6AAD609E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fO1_1sZZG5AQ7kNvwG4QjNU&_nc_oc=AdriEjEk-Lx2Ot_jN_Tw-eqndV33d54mK8uRD7FmpUnS5EMLJnZqz1deMAKf1ePSnX4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbBXXypkWkmM-JR-J29Rg1lsJU0cszGMkFUc9Ixdkqaw&oe=6AAD3825"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
eX5LWMF-quL43uiswWcCs-Zs6k&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gEEMTfq_LldTVpzqdLQ78yDTcdd18XDPlUKBcoU8l7A&oe=6A4660C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCReGvSUvcgQ7kNvwGsp-W7&_nc_oc=Ado-vlLiP0826uL2uzb_QU6v0GLqEIIWt4wnCQtIVBiICOHvmn7aXjtemBHDPhiX81c&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mx58PHpMflpK1ecLVC-sV-xbBNhNSob22oY3c1HXs_g&oe=6A468019"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUbirkTGXYUQ7kNvwEjeQe_&_nc_oc=AdrXA9e9NCHhCJ4VZ0o_qkX6KHCBRgUzdGL5Sc046nz_b129lSsQn6nfUmUPyEzb95A&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KFgRNUHWKCzCTXtmZD_udcsiul0hXjZKFibk3AmRTfQ&oe=6A46858B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J7OnJGOYE0Q7kNvwGtUfS0&_nc_oc=AdrTLgQOrd5QTI66bCxUpeGnxuMS3vAlDyUx09KFcz59y2Fn9g0Yq8fzufBPuW9-Tr8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8_ON1mQ6arYk1WDwE_ouEbLcGLzsEGa9xf0W8JJUewOA&oe=6A468B9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWFtk4XQV3cQ7kNvwH7z6Ln&_nc_oc=Adq7uFOZY1-JAYx-J5GmJYLXnv4R7IJ1ToERmC_nkEPoJ0Ix8CUFJf9yflLhKe11z6U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Xcl3Mm3fOQDaF9RhJX7NVUz8qviu3-J5UPsEUibOWqw&oe=6A466325"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category":
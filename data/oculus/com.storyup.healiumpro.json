rMGryVUM1jujMggAVQjP1zXcRbaIssE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExJelvixq9VwRL3AzsKCMBb42KWwTaMSxtWbWXP2WbYg&oe=6A8D91C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqMQ6RwUFMsQ7kNvwEw6B7k&_nc_oc=AdpcfmMNevjVwhUI8CRtiIpVR8ILtSvr7JOaKAy1X6zfQ-zAbgRwkCXrWBBy6gehZck&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQX2sXSdfJpvMDd4_0ZTRnkL4s3XW1hto-Tf5vs5QvYA&oe=6A8D78D9"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWhyvXpmPpEQ7kNvwFxLE4t&_nc_oc=AdrxOoiGfL6yQiPf2ieOFf1TTs0fxbnTHoBavC86B8Vybo_h5S__-pEqfZg7u2ds8IE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8f7b6UOFteX2aDVGzDffT9aM-IznQfemkqRvemiWVkA&oe=6A8D7E4B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yo0J2OszStEQ7kNvwGf0o6C&_nc_oc=AdqQ9BfWRxQHjeTTfT5zD-iTiqLNCAk2xVBJ2gmYQ6eJXGyydFSn48GczSN63AYSwS8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-b-rWEjf2lU9pKgaRR4hrjQrxx5IGdiROpRuPEOhfWQ&oe=6A8D845E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1eC0QadzakQ7kNvwEybxx-&_nc_oc=AdpRNmkQanFBIGDQ2d2NM0sdjNTMbp4XNiuhHw0LQE4qlIG8j-wupG85eAPVvu7PVOs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHx80kDbrLUaTPdPGs6r1Ev_wedD1ltUKJYQ1VR61K6Eg&oe=6A8D9425"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_
2zsYDZY3OU_Jen-WOQAX8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpia12mgi-Gs2eUz7qR504gFJZZe-JY9k9ULM31UJQoQ&oe=6A81B447"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5pS3JnPcgMQ7kNvwE9K1YL&_nc_oc=Adr4O6BawFxRqFTVKLf3Ht97VQNaVuphe-OXkt7xzpj3JgjevFrJvsX7qtyEtNvzpGI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEavNz7ypAa_roRFrFj1W8AvMvmw-Kr3z0SeDkop26c6A&oe=6A819B59"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6fI2g-IhrMQ7kNvwFdyUgt&_nc_oc=AdouwlYr2-Jzk6dfFlcQXxcs4HP8AUBTWbXGmtTDJx2gv_CpyzkO2KwQ4uTO_5sYGd8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZ5aNKPKTB90YfjKfgx6-KaYX6k_v_RgARePDGqvYt6g&oe=6A81A0CB"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SThr85HTzwoQ7kNvwErfuB6&_nc_oc=Adp5xZUE27URJSayNRkIV0U9GCm3b7WDGkQj923RWNoIFRWMHsBYlggSmMJhStnPMSE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHn41iBdDY6u2NS1Fn8EE-k_VQkXGtfB67sjx_PsEEZhw&oe=6A81A6DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zzSs3LG5bwQ7kNvwFVxof4&_nc_oc=AdqAJeKRL2xxuwEedrMWIvvYUuCYMBmNMBM8Tr2GwN1pR8cZkYOEVM1yoxi_qRcP7IY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbwV20T1soidkp0ms1IId9xcKpOO4ixd2TvsPH_QKG1w&oe=6A81B6A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
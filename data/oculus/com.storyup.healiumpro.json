Z_imxaD7pjms6oqjEndRg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGs85KMGa287xqZXFZUlfhwsFSidJHBx0UifN3z3fVUYQ&oe=6A918647"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=65gv_adBEUUQ7kNvwHI1SIU&_nc_oc=Adph1aWtK-Ru95ZakJJLvBQkgQxibDUY4iNqSczx7rBfvrlM0oTfGghCsr2m6RC-2YU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEswN7LxD1hPm03O_N-dSu3EdISh7vZ8y7HHykTO3q3JA&oe=6A916D59"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxJgaCLCJdkQ7kNvwHNN3cj&_nc_oc=AdrKr5iA0d08tWPNhzDIBcmV3N7GMzZcS8iW3a6o_-Ci6bCY8pYEDHodRGCajEHHeG0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnPwnP2SkSW3odH7TLegAl-WcV5NTB_eLklwAuGlOAPw&oe=6A9172CB"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odSM4bBfI7YQ7kNvwHvyFvA&_nc_oc=AdoqZ6jbAZhLvYO9z6KHSxrysxnIMIQKeHjhKd0LU3IS6VHLXuCLmsNaApPf1_NOVP0&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhFiRGFKOzA94h94-n8TmJ4ZnXsE-C1NHh80gmL_XDxw&oe=6A9178DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2xnCZ3LLH6gQ7kNvwEHp-1p&_nc_oc=AdryRWVKgQnvuBIFNcWowOeGTJX3cbcWVDrP0tnePImAB7zuCG8ygP4-mZBPdk0JRqM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES4cu0gC4miDzfGYMRkmBoVu-uHdjWmk3qtOxWtDIDlw&oe=6A9188A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
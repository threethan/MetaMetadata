zCnSMLDL4-9hU5X0x6DVk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDXHxKCfWthH1oopk6OPcfs15FyF4pf0cRoXbZg0DAOBA&oe=6A523E47"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFVlibKuLPIQ7kNvwFmxlwc&_nc_oc=AdrIg2lu3aU_nhPkokPtbuqe-hCnV0ntCNsoEv1aBdqZxeeNzp-I43yt3owoDehfbK4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC58IaA4qtkth3SwYEXmtIs06YDvUEEWZXgPQYv01X4YQ&oe=6A525D99"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTN1JloKzWYQ7kNvwHAEQF_&_nc_oc=AdobjcqpJxvWxoObWiO-FSuN46ESfeBGDOUdl6LCseZTXWLGOn7SRWbD1fLYCtkj2r8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv_nWvb5YUXgNBorVyw0vhwyk3jVMG7q45Vt1QUbaF1g&oe=6A52630B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj4XGYArhm0Q7kNvwG2NFvI&_nc_oc=AdosrlC2LXQU2rFr3HUMnPRAA7vJeDmf9QeACeZ26o70_yTPuq0eLOSHsdYVo4ofv2c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtgUgWZD-OIiBXBe86hgBRCP-0bYKbQb1NoBEZNUuz5g&oe=6A5230DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_Jc4RtRemgQ7kNvwHewKyq&_nc_oc=AdoJPgBayZclW7XrXdts3onkoTPJASp6XQp3tRGf57ut6BmREUcH5TnPTpOfku65zW0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcWkkn3llSZsctdfpIBqqs07itcLRa4r_vsoW7ZFwJAA&oe=6A5240A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
SyZwBoa22JVmgq7JNKIZ_nx4J-FmPWk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0vIB8oGisPDAZv2B3uF8OZBiThzmSQ8UzwkDhdLeixw&oe=6A85A8C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiKgMIOGr9YQ7kNvwFhrYYV&_nc_oc=AdqNNK--hZkJV57fS9aexctPAVFNIKFqDQTlVnDR94L37GYkKsKhCoXvj_O4FrlkqxE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBZOgpxPP1lW8hRpxe06WIdD2MW-blNJv4cU2rUSb1qg&oe=6A858FD9"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Btx97BU9N5wQ7kNvwHFg1aU&_nc_oc=AdpfhEy_jnhE7_eTLrowvLaUJIwjTbcwjJ3vcbZFYVsTNTqrxxOdt8bvZUobWSra7ZU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEF09m6gxcdX0Zpi7ZHGmk4_axFou8ytxP5rTMfZmBhHQ&oe=6A85954B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6k57RoBUtcQ7kNvwHSUaDp&_nc_oc=AdqngzgAPA1742BFawr1I-FgIeqtpUpoGdA408DSZKX4L1eO6Xn1_crk4BPuZzd319o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlsSkBpC_ARQZV5KvLOImtoOAcYb5kes_Oix5njOgIyw&oe=6A859B5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ee27dSu4j0oQ7kNvwGvqsTD&_nc_oc=AdrYaRHWpOZofpk211PFDSm9jIs1kSdOb09CCzcA4tP__c551EpLYns1WFP68K_wv-Q&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4XTQk7beyWeCU9B9cU87aGgxhq_zQluYJTXFiEkHobg&oe=6A85AB25"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_
gRmv3lh6GWj_M0qNzxOrA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJh9l7ReplD55n6nasRqzpjY_ouJtyWJtRkyKCrXcfEdw&oe=6A9C1247"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a7WE0C_sg-sQ7kNvwHH7qlF&_nc_oc=AdoGff74AMiycscQVQ6YfxWbwFXd-grtrojrZDUGhdj_gYaFKL3NFo8N3bdkGPq8Ct4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGniLSWsKOePMbvlMV9wsNiqrgQQWxudDpxENp-6oh_A&oe=6A9C3199"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3nIb6EfpKhQQ7kNvwGvxq6l&_nc_oc=Adp8W1vBCn8mY0Arq-6PpqL3tDKtmVuGnBj0x4VYBrgpxl3hY82txOe660Xn_b7U0es&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-eDHX57L0vbBwmOAJSHfjjrYVB3TVhf3w5uRMI08ZXQ&oe=6A9C370B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vk3PKbWOpFwQ7kNvwFtxg2a&_nc_oc=Adr7sUo2Cf2zr5kf5hRukZyfIZT3YCB40ekpcXF8X1cbMBJ3PFVaFBYJJnuKRDxO4DI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKppBfDKH_8OI_60mjZrgG0FZDOodBAoCdS28EgNUNZuw&oe=6A9C3D1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQiRKoGgBe4Q7kNvwEy3-hw&_nc_oc=AdoesLs8A3S0KaeUYj7kgFtIXMn0qJCfZA7mw6JC7kUxB7HGJ42PX6ebBtPc-EsK2So&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpG5vno4nheUwG2nYjUZ6_71RxHUgj8hLx2BKRdowBIg&oe=6A9C14A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
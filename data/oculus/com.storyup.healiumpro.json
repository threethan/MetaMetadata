1bZ7FQ29CBpHEBS-sgzdg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYYXwHXCrAUzDA4irptE9nLEEWHrr7kNZoDSe-LnHCwQ&oe=6A973CC7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJzdTjQ6oI4Q7kNvwFneZNE&_nc_oc=AdqUpUCHL1g0ScpNHi_w6z3Y64WOgKfZIVpzCDqT78zUp7KXfcUM8bkHw6brgDsA4uI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdw1Nh7N-lQxOMxA22mR_ZvNOu94wL7E6XmKADx2_ZGA&oe=6A9723D9"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6LPaEh58CMQ7kNvwH8tAW1&_nc_oc=Adp2WHv8bVaxxnaFUW-az6bg8KpBdAZ84YjmP1kUYVZ1DzOrl9dF-J2vMGlj-nD3XI8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWH5nkqzzQxPG5IVzUQmF4QE6yn0lrt4SRicTtu3Xxxw&oe=6A97294B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaAq4uNynIYQ7kNvwGIToTj&_nc_oc=AdpKULN2MN3IO-T2sRo98HV_XioGynu_OMiB4SYIyRGL5v5NIsqbtOVYR530sAEUzT0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHe4LKzEugcPTXibbFVdJzEYYaetAoMPlIRsh_l1FbuQ&oe=6A972F5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C94ks6U6avYQ7kNvwHs8cME&_nc_oc=Ado_OcKduGY0IG5BcVAAZkz36kDvcWX29PHBTmJPZe2-glfT5WK0GBLSVNFoUC-Mi9s&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEosKoCcv5mxHPnDhsQKQmVYPHuHIQbQzMDpvy78PVjIA&oe=6A973F25"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
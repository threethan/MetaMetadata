iwWXQ38hTnnCfJrVsVSmk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVAJq6G7110WGn5HCxoG6IFI2H0qggLc1pm993QnPwVQ&oe=6AF34D87"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlsmmLJdxLkQ7kNvwEnl2fc&_nc_oc=AdpHCHw7ccGZD4Jh2876xVbGDPzdwQWo4m01G6gZ32OXFgvGcOhz6mGpY0I1xHH7kfY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHPQBfxS78buds2mVuHkp7ybI6JMJYECDEW3BtaGgumA&oe=6AF33499"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNWhr_zBlwkQ7kNvwF3H1pm&_nc_oc=AdqpClL93-cOY91g-UcWThKJpM6ceDybQf79pJAQLFqyOetH3_8DL6lUXffLBuEJP20&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTihD6p9afQcnMmu8BpKKZNJT4i2sPW21vvthVs6jGbEw&oe=6AF33A0B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Jp1_R_OVpQQ7kNvwGmU6-0&_nc_oc=Adr6NrHnUpjuZzh-5CN3yYTdoGlnIrbmLmFCcrIB8PlTKWZ6EqVOaqJxwuJ1Rm2Lr6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRac3Vu-HNqN5hzh9VV8B9iWUMuaiCOUlR7QVdCB54nYQ&oe=6AF3401E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRtXql-3NTYQ7kNvwHkiofO&_nc_oc=Adr0d1p6jEcIZMpirQhArcMDuc2GbtJos61XhRhWq7wicl_Cgt2pWaqzYc23ReQ39vg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTfyMf847-6OcjzJqfRqzcT6gUYMYkohF9uoGUe41KTw&oe=6AF34FE5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
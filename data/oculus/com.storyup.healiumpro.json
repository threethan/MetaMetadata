u-_gBHJ0EUDr9WfLl10Y0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1TGczJdCBi9A01vavIU0w-IngFUNaXVrOsqWEZS2p8g&oe=6A450F47"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Bg4z4zXzN8Q7kNvwGlpBa1&_nc_oc=Adq_a3V3qCQ3R0YNbo2lbCVUUWsIJP2dhP6iK5JyiH1uEAPgPrHM2fZeNMc-aY9ShoY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Dzxv66MmXYMzdo4YfsUpNk_RutPRzdaP0w1RHt3fA6A&oe=6A452E99"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KUbirkTGXYUQ7kNvwHigjdM&_nc_oc=AdrvFgZex0Ln-oh7hJJEBysh1a3Y2vOqWjKMQedzcQC9nk1QlGOdTNC0KELuYpXdL4w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2xl_LbbvD6bFoHlk2rHoowoXIuXy8VeSqhN1727zFSw&oe=6A45340B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3J7OnJGOYE0Q7kNvwF2rtpx&_nc_oc=AdqamLxyioygyoXQmG1LGjg9eI2yM3OIJ5IAY6PW0hroQrTiSmzGPOuoR_SoL_UIrWU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9LZCLEgmbdUPLn1GpNROPRqkgVzeRjBdv-FrHdDzD1gw&oe=6A4501DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TlNuIH7hWoUQ7kNvwGbK_U2&_nc_oc=Adpp5l3m9jejhc5iCVKX5_FT9rP45kXXSl_9zsx6W0QIeB_oVdYLm60cf-ESNXIob_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af809IzCF5peUJFz8X1GjCxz020_UsNVoY5JUOpEL_Lehg&oe=6A4511A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
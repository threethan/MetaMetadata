phnm33nKqboV5JH5da_84&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoRHx_K7GTywKVw-0e8PGKn6j-R9zDBRL0tus0KVEi0w&oe=6AD10687"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq-_11347vkQ7kNvwHA1Ce8&_nc_oc=Adp-2byQZqmynYMfrxwI0_MyAHyJM1O0FTupuOB7XVe3s2IqmFbtm_xAb8WVdvqsrf8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0r_stw9cqCHHpzmn_Cf85dYJYJg3FLSPf3H6w8N1uXQ&oe=6AD0ED99"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DBOoA9Mp0nsQ7kNvwF_RIEY&_nc_oc=Adp2nqx03UJnNc_Bi4ZoBHZKp2mMD2mGMibTp0RylooRvh_75gLNDU5Fnhmiff1BY70&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6D5Ksi_V4wVWXeu7scp2I38Q4p5tM6qubMNo2PNZ19g&oe=6AD0F30B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19yJDlxmJ_gQ7kNvwEXQBnS&_nc_oc=AdpD7y9Df474HJxLARSo-_eFiArwe24Wj2bTpMkskFPo8OdtCFtFQRi3uXf9xl0TIlw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEP49BZuK5JFlqzVvd7rMkLOwykp6V86nUz8XjnqhJ4g&oe=6AD0F91E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30Tv2QGYs2MQ7kNvwH9Vrp9&_nc_oc=AdpAmIqyi4cfR4bXp2trm2GTr94xIJjK2IQ_5VsZKIHXXJZvpI5UiBOt3gihEnXscfI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmtd96ILtHx1stkZT5PvUX2mEgl2J5ttHxNT60zWRROA&oe=6AD0D0A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
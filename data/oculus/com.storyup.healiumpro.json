sd0_wqzWcyTYjNAQUZFdI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9f1qZ3jq801bP8XiCe1NTOkPS-jPqt3YUfzLblkXcPQ&oe=6A95B307"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJzdTjQ6oI4Q7kNvwH0Kqoq&_nc_oc=AdqmhrgI8Ikqk1A7kNq2ZNF5xz0VmktjrCtYrjFwJVV_-6FiwJvJW6WnreHphgqwZ7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkIjl25V2A3XoLwMkTNpwum4Ccv-wAV-derGdRXBrZ3g&oe=6A95D259"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTguTm-Gjb4Q7kNvwH97GyZ&_nc_oc=AdqDWhC_OpE4HdcBkd2id5Nd39dc0t5K5URN4X8p9ilY72q9q-RQ0PCIkxKqwRhA28Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHenLhDv_ZERnLmVF6R8i3bHwBus6hajbhCtzy3oB13Nw&oe=6A95D7CB"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLVdx8ZY7bYQ7kNvwHHHOx-&_nc_oc=AdoZPo5B73FU1h_7dSCZQKSfd29F1DaOQSc9vGg1neqSmdJidgLVQVjIfowBSG7ZjNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGEtyLtC-UYBYSiT-INnJXVtrAHolduCUvoVZLQA7Gt5Q&oe=6A95DDDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C94ks6U6avYQ7kNvwHzLL67&_nc_oc=Adovtq3y1ZKRxJ4ZkdkYcSyhdqGhLqBWIDVhkEoLStWAhK6a5GAGPtaO9_hQmSV3oWE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCW1JErV7Y_fZmLCNkY0R_ccYVmKCyaNuWE6taYOPZEg&oe=6A95B565"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
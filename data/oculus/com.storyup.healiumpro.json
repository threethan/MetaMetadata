Dq-nGEo4VWUk-aFbScw08&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEcMp1YX4hVUiXRTK0d8fm-NeV__7I0fZVkKNxIrqtgEA&oe=6A71E247"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ML-sW3XeV6cQ7kNvwF_-b0M&_nc_oc=Adqx9o_84XnDiBpQsGltbw3BvgUHwyMdavsAQJ1d1NR6heTRDgxc1p5pAVmT-dHyb7Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJSFgJvlB-8uRS1BQOFXZdpaNhRxKwuFOHE5IKgx2m5Q&oe=6A720199"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFPLvSv4YOUQ7kNvwFQtDIc&_nc_oc=AdpvCRC2V7Cz8lMYz61-7RFTUJl0jzaKXVXEm5NaP8_x4ebSfYK4P3SOF7o3bzO_CLA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX0UsGrRGj4RqtsCfnqd-6N_5OZBQbNbhZBTyg_r619A&oe=6A71CECB"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fet4M_10d-4Q7kNvwGWlrOL&_nc_oc=AdrPPNU4gLz1Pps2Q69i3LPj233nczNHNMC3SoMDP5lSUimlgjbD_TmRXwIckjdGnSY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFdJveAyyeAroyxQVSD__LIUgAzf_j1d3f6-cKVABjnwA&oe=6A71D4DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T24pwXjtgl4Q7kNvwHNl7fZ&_nc_oc=AdqLUVQ1H8I1wqXGvWR5oiucMqcrVCwBjarhYFdcjDbbeHQlWizTlmSvT-M6B18kw9w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEU9tZa_wyiTSS-tHzdAepRpSwMvznSWdk3TR_QFyU1dQ&oe=6A71E4A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
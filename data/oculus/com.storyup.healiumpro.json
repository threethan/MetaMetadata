NuX79gM66azfateG5SZns&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8cRi6PJG4Y1vMZ7M_2c-zGAZjLmaXlwp4vv07eu7MNg&oe=6A5E1BC7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmc9-LVZnWsQ7kNvwGk6x2A&_nc_oc=AdpJxhwk4fvB-NjhOU0laZvNlPLmIgP9NibmJP9PwQhfbxm0jJCUxkA5pKXtYUkchAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTl_HKdWo3oDkXKlacgfG3ghBaGujvL-yDZAlJYXjfww&oe=6A5E3B19"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAXYfof_bqYQ7kNvwHWebRy&_nc_oc=AdoUwh3eZ80d6jmpnHKFFEfq8SJ36DceJS4hVRe7GMNRpx9BwUiQJQgyHU6SW-XyO9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHgvSWum7b5dqelpx7I4kleE0EnnBGasDEsnJ1hDchTA&oe=6A5E084B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8t3fC55g0cQ7kNvwGGbnT_&_nc_oc=AdrLiSyW_8MyG7S8cImF9Sg2z_z8NCJfQ_d6LmwdaBdf3IVLowrEKnWpn3tXXk43qNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKoX6PGPUcJ5scRNIwj9ubFiAfpXRuIBjkHelQJU6jog&oe=6A5E0E5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb3bMpznEWoQ7kNvwEyRA3m&_nc_oc=AdrRWbvNMwUeQe94BOVNY5ctHcBNPQAqS_fkhQ2GTy7uMi4NgsQyf1z6n38z31RH2VM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3qOPtDwo02qfunSLswqhvBJzhBR7q0-sbjb7Xio9WvA&oe=6A5E1E25"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
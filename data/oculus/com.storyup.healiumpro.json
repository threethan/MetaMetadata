588dR21TiY1vk-b7EG26M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG04sEHpFGY3zuYfYJzBio48oZtajDorIE3Y_ifr--vbw&oe=6A8305C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5pS3JnPcgMQ7kNvwE-5qIX&_nc_oc=AdpBTe0N0fexnGhu500nVENeLm5Lb-dIgOc-wT6oZX-oJAre7Lcr0pC79sEVm5AkDCI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEKRSkJGu-E7H26XIIlgPe7Muw1kIjayB8tz2BR6zaOA&oe=6A82ECD9"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6fI2g-IhrMQ7kNvwHCvyzP&_nc_oc=AdpWhpxBHw12Se9zrAIESvbGckWIjXWwUc4sl7lxuXxG0-SoU511ySIup74KPJtA9RA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-wB1Oz-t9y8sXvkEMXCwalVmYz5KD_lovRa3oG9er3g&oe=6A82F24B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6k57RoBUtcQ7kNvwFp-HZ3&_nc_oc=AdoOberwfA-Xys5fvDANq7GWpoG-FmldrCa8E7t6VK8M-oxcbH94sJUeoVUQU32_4ew&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzWJgCNzw8y8QQ-me-8Z5LfGRddC2RnF98JlalKLC49g&oe=6A82F85E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5zzSs3LG5bwQ7kNvwHdsYNh&_nc_oc=Adqh6fx_B53cXTzMPeygKnfXQ9sXPn86zXfux6GMiUrz-xnQs0ezaZ6eYQXJDF_a0Uc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElKEVNIrJf94Ev43f1tTnFpb_EuPoHvDdKd10eoQJFiA&oe=6A830825"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
uczenFeKRg2m1RPHZGmv4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvy0sZyYS1Te5q-9929_9xYzFuve_6IgX3f8XNQSrYRw&oe=6A5CCA47"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFMIX6LDBzsQ7kNvwE3n80j&_nc_oc=AdpzUoCospGyGVegVk2jTtGudaZHqtpAaBmh6NsmNRWxSs7RQxtNPo-5RZQIjd5f2E8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB9vzE40v48FwRTgwx-IQ2y7awC0uWcj3urj76vpSaAGA&oe=6A5CB159"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAXYfof_bqYQ7kNvwHum-i-&_nc_oc=AdqO9vudtXHf7-SdvSCu6R94dMRxmlJCpLBzxtlymYX--D3Q8rXOVYM1Lz9XU2hzFSE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeZvLBlgIoUUFewcbLkqfigrrR-NSkW6AACHQIzWm0kA&oe=6A5CB6CB"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C8t3fC55g0cQ7kNvwH-gvKo&_nc_oc=Adok0gCFIh8ppZtOa7n7GqmXQH1Myai1Mg2mElg2cSZWW_GL8sp5GhTUX3nrqDLJWCY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwQwXo2KsuZ6cevnlDFlyJcOxAAnyn3Rx_O-0f-lSOAg&oe=6A5CBCDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7sQtckvHZUQ7kNvwEuUEQE&_nc_oc=AdoAvfOj6rvyFRKSM1JmyrOT6CQc8yANN_v1BJ_iGncp4SfbLO3bo95kXDN_NPmQgR4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwhKelKa1lZ6QMQ9eY-4AeiIyuOqJU2EJbPVn1Hpu8WA&oe=6A5CCCA5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
6pn73CFEQFc_fvzjnfPXk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lySQWRzXIlKLo76xCTOGTMzAR4BSz0LWCleQIxO1Tzw&oe=6A3D2647"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWvRqdpViwMQ7kNvwGI1i67&_nc_oc=AdpipeyyV3FI2UMyZh77A9WtXxiZV-fwPae8EYJZcZT3MEdt3lMzQs9xpm5YnP2TWZ8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-n7EFWI9iAaOv91UfhqtSaADgdwS1OsFxbMbqWnwGolw&oe=6A3D4599"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Doebcp9PeFsQ7kNvwGMjdo6&_nc_oc=AdrYsT53L6wK6yCHrPmHoyfW0bmGTRBoFBfiCzqW-3cZLW86aGMhiEYOUxWuEi_hG38&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Aiv4B3Hz0_ZK-0BwTrWcBTxHMmKhM4FSMfl0caqn6sQ&oe=6A3D4B0B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfgIR3I2Bh4Q7kNvwFJrh4f&_nc_oc=AdprMc27S9UTrUO5PMa-j-Wj4dtT7Ha4kltxJGQ_yxJ0fo2_FavBrU3z5if4CunXYt0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gcg6sVUA6tlOU-oH3ETF_XwKDbr1HDJ0eCknDZAlaYQ&oe=6A3D511E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CL7VAJK9JgoQ7kNvwHBZsso&_nc_oc=AdroTwJ6gygmaufEQNH6STziZep-ZhRIHJ7vE6BlTp9d5-HdxUPcsKsvwpQoF3iFAn0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Q5V43j9tYAB8E1WYfvGHQ14VoXDKfpHmQP-9ZxsFigg&oe=6A3D28A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
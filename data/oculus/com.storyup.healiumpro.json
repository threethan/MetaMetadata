bPOc1nLoVGhY2vzXJinpE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDepBSnpG_TpsSNjkMCbAZ-ytvwZWjBOLSUOQH74zE0ng&oe=6A5A2747"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFMIX6LDBzsQ7kNvwEyNH-Z&_nc_oc=AdoMFpS1TEqHDrT-_WQxYshw2TdRAM0JQuqiP5hZz_4ce9PTC4VHV3WnMXfQPL91nIs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9qxqEcm41GOk7TaNw9mxF1DTjpajKDFc5v0FDhO6tJw&oe=6A5A4699"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBBxg-iHHJEQ7kNvwFXOkhS&_nc_oc=AdqH0v5UI-kmgH3EWxv1s2-8P5SX9qPsxhcmL7l2uJgaS-fSfdr3VDpsyWhTkGbqCak&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHaDnmKm211xxze96uReWG9x2mzHbfcr33h-5QlgznxA&oe=6A5A13CB"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dATlLSv71A0Q7kNvwGF9CXs&_nc_oc=Adoud6MmP2W4vT1JVYox-YHq8wf941IHa-KCJ5zqkga0RLLmKkkTWzJzsVmLbW5RGmE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBujhcQLYhgw4a7dDl56jrduplJfFpeiSlI_A4VIcXx1g&oe=6A5A19DE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c7sQtckvHZUQ7kNvwFb9HSl&_nc_oc=Adom3rd9u8aC_Akeq3MES7XbU1xG8mlJipjKgIeSlBs1fP0g7vOh8FH-60CtNbeuaDE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPbVQ8X_4WcF0M6IWfx6k4_1zIV0UZX0ykU6kTrTVUtA&oe=6A5A29A5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
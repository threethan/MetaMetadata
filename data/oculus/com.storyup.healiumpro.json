_tlS-AUNrHfljur9V25kM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLIuJO7DWhBjLd-nDaO3Ip4a0Ox-tLbcTdssBK0yFNxA&oe=6A899D47"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AfqT8XNgZWAQ7kNvwGDc4gq&_nc_oc=Adpe8ns7r3evEZ7RbxJJLP6BDfIv8dxXfPzaX1iOHql0P1dniztUUq1APkWZtiOVios&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmIt6fF-GH_1MehxTyU0P6YqsvDPFet2wSndk0pVLMOQ&oe=6A898459"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIwNmw0mSkQQ7kNvwHQhDN_&_nc_oc=AdpsLjAXIEN478U8Oyaa9V76tcQ-0Guga8Xwr9uksupidab3gTBfPOJXqC60ORUHQ24&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuaNisOOykeI9em0LikWuBgg-K4zLhXJKeC4NZ_-7L2Q&oe=6A8989CB"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkHGdW88jJYQ7kNvwFsoHRJ&_nc_oc=AdpRF40E1esiiGKPJuHX9LRN8xxHdJt4aMXNSurND-pmUkJeiDBVZZEui1Ulzpip5IM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfnC2z1F2HTxd3KLn9spTIsUkt598s26k0OBEgh-ma_w&oe=6A898FDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DfebJnPsnrsQ7kNvwGpLlOR&_nc_oc=AdoT85GbAkcQ3ak3JpeXeVDhxyCNrhwEXNCLStw1e9cMqi14XgtgbihOzbdwpxtwGUU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb5IoyWMj-Xz_OH14ey2rFj8G2UWTjACqAnWOU3AGJ2w&oe=6A899FA5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
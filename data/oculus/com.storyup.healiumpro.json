aUIly6xsGLvEK4TR7tuUU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAriLAWMjpnhbsQEnPsksvEEinnYN_2ZNpZsOaw-AehBw&oe=6A6361C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W4m5DrxFIdYQ7kNvwGbCgHe&_nc_oc=Ado7xdOygfCyUrFCdpIvztSZa8Ydn8gj7-PB4wK5_xvjnBc5kXEUtmhaSjSlgM9yy_A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe00YEjC11SRbk1w-7YgpwXvTsW56t_kvCRSz3vZ5rlQ&oe=6A638119"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEHnap_xBjsQ7kNvwE9fq-5&_nc_oc=AdqvUCTk9UO2XaJ-R3GNhHD6E_5UTUwxnWrrXQiAv-RBZdRu9jLiJX2pW8YcCHkonOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuq9XpDp2i8FGs9xWXr9S-H6EiN-ZRpJ0OiP5qmoukeA&oe=6A634E4B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uLyKI9Hk4lAQ7kNvwGa9tqn&_nc_oc=AdpveMelMELzbvVRhZRwcO-3yx5qOxnwGbd6bl0M81j1cWLcnNVouMyHmnyr7Tz3FPo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEm12cjT1xE0g_CPvsgpUU-SOI3SMM94fRXFZ8xYmwAQ&oe=6A63545E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NL1_E76bdEsQ7kNvwEfxuiY&_nc_oc=Adp2DLN3qivXDM1rgsdkoOehP8QCcwP2NgiVe_ARtZWKFqjI93apz1Q200AXHQHlcIw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnzJZHWt6d6zs_UbgnnkmApw3URwVEK6m-G0oP7UFKHQ&oe=6A636425"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
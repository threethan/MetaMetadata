InhOeyTOD0l-2RYgKySVs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdQXR0ZBFh3lD1gyxzscj5jjS5FjI331WUc-2SZf7D5w&oe=6A9034C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqMQ6RwUFMsQ7kNvwGW7fab&_nc_oc=AdrxBWXntX7b_Igb4RrcZFoCMVnMDD0FIFUHDGB91bXdNy84u73PfuAec-qp_WKI388&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFW9eGk6dov7l-PTjID8bJ2L1AWzPN5Cxz9ARa095rUwg&oe=6A901BD9"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WxJgaCLCJdkQ7kNvwEo2eUI&_nc_oc=AdpFkRlHx7TI4Y7cAHVnNe_2Vu4rndbQJ3DZpU0KBfecnVEPsVWFNO9HajoG6ae6EPU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF11JgZWmb961bITo4VX0SPJXVLpyEj6eb-AcPETds7aA&oe=6A90214B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=odSM4bBfI7YQ7kNvwHI7X5G&_nc_oc=AdpUReusNyeAbgMM3aCeqaq51mrGo3cFjhW9RF2J1qHgsB_YIDAFUpr-kayiX1ErRkw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWlGwBFHyAfsjIDYyA5P6z6cPNHsxHwEz9jaJTfGk4Lw&oe=6A90275E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1eC0QadzakQ7kNvwGNMTEs&_nc_oc=Adopcgdp3bticMMGVtVVg4dWZoYOTKF3tz3xBAWIrQJE1CbaUXdzElLZdaDlYmx-Tbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwYVvtr2tS4t99RO37ioKThquXAqTtGPFP6gSGIjEQ-g&oe=6A903725"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
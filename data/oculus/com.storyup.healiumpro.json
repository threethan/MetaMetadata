Y0w7zGqv7Q8vwz0ddFi2Y&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMdFrzk-fBtIRfyYDb7fRCjlcqZcw7uoTgt5VGK356XsQ&oe=6AD3A987"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aq-_11347vkQ7kNvwEKO7rf&_nc_oc=AdqFCkXAz0_w1J5I5r_vPG9a_K1ilu_6RkTd_vrGDDONU3fwd41vhoSMG7frQujO4o8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcQIDu4y7zfTY7JN0XOSjjp2C_X6jxNTXB1DPUzIg7SQ&oe=6AD39099"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6fgIljEKqwQ7kNvwHvrd5A&_nc_oc=AdqH6j5TNmje2krS3_RSbS3dkO3ny26F1jCXl2EoyKjZlu8TVafLna-_-osnbdYcuLc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHxqqi-SRSyvj4GbfXeNFCLCNAD448iblm3HqLySRTvQ&oe=6AD3960B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U0rzbInWWbcQ7kNvwHEjZuh&_nc_oc=Adr9SiXqHqaKddwIBYbDd0joo2eS5uDx-Q2YJgFDvzTg-plSymJEe9vh5OQTP-ex8X0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQx7Uo5uOQXaNxI7VE8Tzeo4j4blwEcPbzZxUa9PVZFA&oe=6AD39C1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=30Tv2QGYs2MQ7kNvwFneOV4&_nc_oc=AdpzW6AvbOfsJzCS8S3WKM_LQToZ2JZlKwT2UlNAGA6naAcb6zj8Ik7x5zH42xsxIG8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGmNtrSbzaZkL720YStALQbw-BeFe9sQMf_bxaPMR2Mw&oe=6AD3ABE5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
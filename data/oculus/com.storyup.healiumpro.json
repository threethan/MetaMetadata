AMGMRWTimJYRaP26wrNjk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXnnofl6bWKu7UySnH-dtEb0ak822DbVrRzGzza67L-Q&oe=6A985607"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJzdTjQ6oI4Q7kNvwH1GpYG&_nc_oc=AdrAErHnEPxU_2XOXfRkRugfQDhT6huI7Lr0HJKDDNqMh_GP1yooUf16PC7OAHQc7ZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoJVfrI6qgvPSekAbVEq1U3xPpX4tdsbEb5GrUm_9YSA&oe=6A983D19"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6LPaEh58CMQ7kNvwFBnW-4&_nc_oc=AdpQ6XIiTsslv-O7bMhnnbeGIeOTyD9ahaJoLXlHhfU9mjukeOH_D1UfI1yZVd2rkww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFSJh92pxNvATJFCJWLWFzaMniY7qoP6SyvXGSUAaBCQ&oe=6A98428B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaAq4uNynIYQ7kNvwHCnwGf&_nc_oc=Adog99OTd5ZH4Lw_fuX5puggyAu67SuvbCsl9_GmREMYd6jKHOpavg9iPulvdzz0wVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbsMgmSZL9A6GzpG4FoJ8PPKQ9IFY5uTJBZSTiXZ4EPg&oe=6A98489E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C94ks6U6avYQ7kNvwFMrOfK&_nc_oc=AdrObTcQR0wbdGpZD8daUv_Ucng_edoO-onOpKwYGMo9ER2Y362W7nb1gRGXpTgUn0g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKJScwKjPlHGyVMA8iTrV-fACZjuZSu93ag2O8ePP0c5g&oe=6A985865"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
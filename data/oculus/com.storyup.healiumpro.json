EHbojtIzMa2iaVPRAYdcU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNS1kh8RT6fyeIcL7liuD8YENQhntSawxetus-vRuTRTA&oe=6ADDFD47"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-WMYPCueNQQ7kNvwGXqIEO&_nc_oc=Adqg2AFbWr2ExkqHpUlErdOFKkcEWJdcchJJDxrfvMwCNj4oQ_k76AkeDMZOEgpfK3s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8z-I8ePoFwStJADY9Ku025FCIqRgupQtYG51qR2UHzw&oe=6ADE1C99"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gO-bMjO00SsQ7kNvwFCGd3m&_nc_oc=AdpxcQ8p97at5OD9FLE_f-bkuL_LBoyS8zv4bBVrKUX-Bubds3OS8YOYnHAsguxI6LE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1fPUz8R728q4tGsfGzUZp31JWbmbG-vw8G-D1oF1Q8Q&oe=6ADE220B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJzp0O7Xss8Q7kNvwEqQjJk&_nc_oc=AdpTLRmV6nDzCxW9h5sbqTvCjqX4XsAckJb7OYQh_7TvGw_v89cJPtcTJsVSdGcp2-4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5niFkrLbOsXS_8rhgtV-gvNpKipfBNi_fBe8UMGFFrw&oe=6ADE281E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtjS-7N5JscQ7kNvwFCl6rw&_nc_oc=Ado0G6punvyUWgEleF540Fx-hwAMnr9lKFnhq8GmM1LTIveslfAyQFVnfYE67zr3vWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLjzTeBcpgNpWHM3WmyPfKRDtye_lgGvQXvFMemD1GsA&oe=6ADDFFA5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
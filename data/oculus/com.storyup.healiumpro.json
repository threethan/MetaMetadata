gu-4318iyp9Cr0rHn7qo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6xHWECMhKu_7-5p8vmpI5HXSaw8pZbgLkOFK_aTb2MQ&oe=6A60BEC7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmc9-LVZnWsQ7kNvwHVUdSP&_nc_oc=AdqGxBraF2T5P7F6akJEQ0OXhmHQghTfzLRgon2AVvHf2pcx1jebUDF_uiGyVdV6vfE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrLjmxJ_gTbUB_CZYveqj4SNnza88ToScjoGb5LWz6RA&oe=6A60A5D9"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEHnap_xBjsQ7kNvwGqkAun&_nc_oc=AdpSRbEv0WyEaeolZpkFmVeFr9s_j_2IU0ToQkq_kM44uG9VaBAGavmL2olwZJjRDfI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGBU-DFzHP9dnixKyZSWxtm54w2JPu6jP92QiGG2RX8A&oe=6A60AB4B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M94zdorHtzMQ7kNvwE6SQ1A&_nc_oc=Adrnoq26hwQ31_5cbPSf70mbd2XYzxBjC8xT4zqyNeUTXwFssa2fs-WtnQ9m114MIpU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsQ-NoVktAIx7rn_y-1CUgJTkoYS_S5yeRkIdlDtaL3A&oe=6A60B15E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb3bMpznEWoQ7kNvwEyV-w9&_nc_oc=Adr9jDOepjF7uYPeQXCApidhzYIsa9aGWQ6bKLNiyhB6670j7x_40usz3O9YKxUret0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAn1jtBDm5AxNKeY8etafJvqogWdX1seRzBhtShmfxe0g&oe=6A60C125"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
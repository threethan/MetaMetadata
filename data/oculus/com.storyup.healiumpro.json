4K-u95ZjIGdXWc8a4-c5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAui2mAgWhoS-MbOGytODncwbtoMxtcQah4TN8RKGzZQ&oe=6A7333C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ML-sW3XeV6cQ7kNvwHAfp06&_nc_oc=AdrKsD2jjIEKP3goyfZ54RYUQ_DlneJJ33jxx60I5J88Fn1oGz7HmQ0junFMaFq0lF8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9DSaK2Ph-ZE4qUCvtfZCv5voWk3wW_gSspwL2RVhOeQ&oe=6A735319"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aFPLvSv4YOUQ7kNvwFvY7XI&_nc_oc=AdpvnDQPocYEbw_83anfdog99BJdbjHtvsx0O2AP71xhij3W_sdIFhqouj-wZo90HMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGiNwZBMXRoUBRJb6_YhWiC_98B5HSDh9SB6lbBlYfQ_Q&oe=6A73204B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXOa-brlJ4IQ7kNvwFarvUf&_nc_oc=AdoQ_3VYYMEuY8Kw6Q5HMdAMxIg2EWddtEVvvpX_e2Zku_8nlVNpyGKn_KmAKUBfqhQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYCPZP6o82P7dW9sdbICSpY5aT67kvtdkh9QAlc5IeSA&oe=6A73265E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T24pwXjtgl4Q7kNvwEWwILw&_nc_oc=AdpUt-TwUPM0yEmmYe81jNfUf85EfEMSXaOcqo8Kf-fACJaleCtM7pHfxubD8_eYQvU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGW1BKjaX3wrNHCzleQFcT_jlFpEPQYr8DVX_HVSc-JA&oe=6A733625"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
3kux_nfGLD1G0PbUGCizI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7-mJWBN2HKzwG_NuSqJjox8KhoShF58wW5mz8ArHSBw&oe=6A58D5C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=da8cyQCWibEQ7kNvwHCzqZP&_nc_oc=AdoUMktRTMzIA8LtHqfUAc_C1Dap2QAgJX6XGZMf6AKU70JE5D06pnT1hb4Zn-sV7R0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYJWvjbK66Fer_MQUnl2VcKK4agJkvP3F9LtBVOcFXmQ&oe=6A58F519"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBBxg-iHHJEQ7kNvwH6O8Wg&_nc_oc=AdoxH8Bk1WmX3UwsOsQHayYyG68Zh8gyaj5jntG2GwL9dpk1QRVYlWZ4p-LzOlcEZgM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuPV_vYwwFv1gmBQApKtfdQZ8ZFo78x0QkaId1kRbwmA&oe=6A58C24B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dATlLSv71A0Q7kNvwGxTKVa&_nc_oc=Adq22evwf_dLaORkMIdVlhr6PzAQcocWkWcYvMnY8hEaD3mia8extofq6YAmss_u8L8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-Vz8wJ1P_VoeWbfWFK5KB88Czyrr2wRaAc6Jc-XWz0g&oe=6A58C85E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmrEdcImqaIQ7kNvwERlIW9&_nc_oc=AdqsqQkD_rk6oXCTt0xQ_50Q052suNEwenRc7O3YKv7Kek-b1t9gzqOsGlC7T0LR9gw&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbyIW_9U5G3NRiop5jfn0yNsbuLLtBCLPDmiZOpGYDfw&oe=6A58D825"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
PV2bsd6TP1DseV9aXuxe4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GZYcGK-uVRs-eNrYkSKIIq2EtMWOnPHORay-Hox2N3A&oe=6A3EB007"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fsf5VURiytEQ7kNvwHkWTZG&_nc_oc=Adpk1FG4elXGW_2jAj_1PwC8SEFFBXFZe4WL_z1hN1atLHQgKA8Z07LNS-HSd-0_XAo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83iOEVv78TYaPgRNroKyF8gRyk0m7v84Iq0xbpx5tIOg&oe=6A3E9719"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Doebcp9PeFsQ7kNvwHzsBX6&_nc_oc=AdpfOqQgYK5Dw1mKxvabLLK1aqW1PtuBgqphUhUWBAI3Ll-dQKesCW4KeUM7EixBwAs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V8PoQCQiJ8rYlVOj4qT72NV25-eSE9dyfusKmsNUvQA&oe=6A3E9C8B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfgIR3I2Bh4Q7kNvwE2HpnR&_nc_oc=AdrUsQT61_UT1Jxefasf0bicZmvm5j6Mg5GiHWEaSsn5n09lVJ7deQlkKWt0KrqpZL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6KoYOR7l1aMjR2-mWFyvzXLKIVAqXfMxt9U9Op57nYg&oe=6A3EA29E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHbCZtq0tGUQ7kNvwGeTlm0&_nc_oc=AdrnpZx2i4lkjGZzHq9qWipSwy1g2QegShlocYo6YjEw8JPZ0sbIMawc4Lgy5Eg8WwY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DpFQzQ3sD6ngz9ZkTN-gAzzyDDHBJDskKFSxeXbYlKA&oe=6A3E7A25"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
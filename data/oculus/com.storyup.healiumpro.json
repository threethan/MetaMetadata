9Jt0RlsEmfXKJlcQzLwvQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMefwg9xe-8ixuslEwi3p_kfdUEB1ytL0VusYFI1wsOiQ&oe=6AC7CC07"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6WIDZ5AVJGQQ7kNvwGLXI2a&_nc_oc=AdoLRwVNZM6zB075o4yggKezHSxuqNx0aOAGPIpb1iagWfp2BHxjjV8Jx9eRK5Cu9iA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCTx2jSSklHmXH9NxLx1DSc30xkiBzN5uqCNqOKh0oAA&oe=6AC7B319"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTWyNcVxOvoQ7kNvwH4oJNW&_nc_oc=AdoZUk8kF0J8f3-u-j9Z6n25Kijs5-7F3UByyDzA_I4CxAoJfdTBFnVu_h4-6a8qHj8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOM-g3owtgF7t4DpldRJecGj3GqfUjjdXaOhxi6XLQp5A&oe=6AC7B88B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SOlyCXzTk8gQ7kNvwGMR_iP&_nc_oc=AdqSYUkvbQxVJMcEbidrXAfE1b5fy-YPmFb8gf8nHyNk1sRidVBUHCZzzB0e8i__F6k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlExaGncUULKQD-pCgMd8nqQQbtxcCyvqI8GIqafy39g&oe=6AC7BE9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jZWcVQ4oE1oQ7kNvwHZajjU&_nc_oc=Adry4dWdCWGw5T-gNC0xmJJlgi2ThwzgJC5Ha8zvnI8nuM2MEX714J7FzTjwjfOlt7s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSDUzi_idjDhepTAbwdJvGnCmjV6ctrjPFZiDgx0th9Q&oe=6AC79625"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
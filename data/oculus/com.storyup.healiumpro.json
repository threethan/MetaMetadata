Zl5GjUWOU5hMlKOB40H2o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2a8MZW5XVOt8c1c66-ALs8ffpa1p1aYtHqGUwHeBVgw&oe=6AF5F087"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=obaBZ-bzJs0Q7kNvwFUYWnu&_nc_oc=Adr-ngy5pDCAshtje0yYWZXOcwziO868ZBt5NPLcJ8XSkbxQmkfIKwlE8gzPQOHIzXg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRFAwWqMRjAkHoP-7mfMybcC_PKLOqys3grEY5q6GW-pw&oe=6AF5D799"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2i9SOrFa5EsQ7kNvwHSKGHT&_nc_oc=AdpM-hqnfyYMZIGDdo3JRi-hj12X75aiL54BH4JLOl9N-xIU51U0G-o_IPWThfDCXHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK12nM7jfTMyR_Bnx8secOx1mxI3dBT4yxc2E9tP7Utw&oe=6AF5DD0B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dj-fgkqWp2IQ7kNvwGuvsJp&_nc_oc=AdppHfjUToy5Dy2ASqN_dfzo4mz7keqIG5opwKkRAAIdfOKYYGZpkyF5N5dREQ9TsL8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQutwCns9BTQKx0xBz29cB5eIzKZMCk5vgt0CsXkgT_jA&oe=6AF5E31E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E1o8HY85eBgQ7kNvwFWhk_m&_nc_oc=AdrUt_1f1_u7A3tUKgQy1EZrzRtOJ1TANxePXfys5yn4k6_bg2N63bZAyMk72UW0iuU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM424UIixJmDEUgoakP3uyF8k0815z5n8Dy1QGqxgIjQ&oe=6AF5F2E5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
v6TirAeMcSEkQYLt6Gi9s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLdNfYpGvE13EdsSAHsHfn80rXrYckoVfYXvPgnQhf4A&oe=6A884BC7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiKgMIOGr9YQ7kNvwE7d_0x&_nc_oc=AdpXnbYbQyG0PqcqCvhxoU3ZVkz-ETR_9BgAc11KZKdkPbIhASQH_TCrxYoGre9g1Ps&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGH2d1sWmGtLdDyGctZtTWVoSBcL0-L_i154p3VbpdJXQ&oe=6A8832D9"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cIwNmw0mSkQQ7kNvwGXdqyf&_nc_oc=AdobC0vaoAbpGNVrOjiATLXFS2QkdEOs5nwGFa4XCbwdlem6M9HInL2b1C0VWWSd-0c&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpdofURiu-qhLgMAduB517vrzD4f1aV47g_hPv39ICvQ&oe=6A88384B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkHGdW88jJYQ7kNvwFuV7pE&_nc_oc=Adrt23K_qoxblpdy79eFhdtwSEbetHffpOrSpsQwTA22g2IqiHXHzPgQkNzBvJxvtms&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHooXdGjnKUMRWF9O7q6GJvO-tZ36Cq0zWN6fesx4SPDQ&oe=6A883E5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ee27dSu4j0oQ7kNvwFdN261&_nc_oc=AdopEEFIynHPrjnYTSdyDS4BUM30BiBdmthJ89MaM0HyyE1u-ydYavPKn1pN5i9Hqik&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEHxaC_x5zZrt5xELOvjoBk8jacBR4Zr7js00AjOFad8w&oe=6A884E25"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
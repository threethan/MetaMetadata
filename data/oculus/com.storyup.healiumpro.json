N_XxxaH3qXLChUwfIcL3E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOd-SI0Q8F73dItCEcTmpTkXsTKH0jx6pYBgTprHPgxdg&oe=6AE1F1C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9TZTV75rJ0Q7kNvwFnFCsy&_nc_oc=AdprYsWMgmT0uGjtSpKnp5QUzLZUDiD5ndNFvaSKXJMOTYlRHDxIPj_eB7Ltaz2fUK8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHg8jJ5q_p494ujmLe1dz1dhC3yc_GHwpEyz3qGffZNw&oe=6AE21119"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGmdVmMxhmQQ7kNvwHcy1S6&_nc_oc=AdrJxUwo9B80yqUeuCxgNcf8QiTokLi-1hWCOMQDuYk2Knkdg4qF9pX7_S-v0wQoi-s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNOzFjXK_sqIPzf8gK-pY9gyUNpPSpkEvBgfHXZtkjW_A&oe=6AE2168B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ffaoEoTLot4Q7kNvwELx0iI&_nc_oc=Adofj8l-fMgLH3YmKWHhVIkgt9Nc6X_69wAq3K5nxxqM6nGDgqExSnUpH4JS-D49O7g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXW0goM-fix0x0-tuwCf6A7hl0ZMM6AeH04W4BFCJ7_A&oe=6AE21C9E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SyZOT03iS74Q7kNvwFKrrqO&_nc_oc=AdrSXOscaDTnS1Y0hQKuBoFQ6pKFGIKiUVzOSznkRHMgL033xMVXANGlAls2mClJG1U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtpGd_Nj_grrsCpHGXQal-iPByzoCid0bbBNch4jruUg&oe=6AE1F425"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
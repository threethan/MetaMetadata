z4CYKXe35iS8aH-vKd5VQZWDGW58sVHPTv0OcypBgnQa1758Y1T7iLA3oXE3OM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe8VHAYd17R0uJHGPfELITCrc94g5un0WLQXZ7KAjQ8Q&oe=6AB3EC99"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JMlmfVgrLH4Q7kNvwE_J0so&_nc_oc=AdpQqodTBqEZ6WilUEZbscZqelASfMZuQZzgSvBq_d4DXWAjbnsYl84kGFJo1NP7rYU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFD1_g5JoWJsaBMlpY6Ntg_7hZlQ2j4xzVbGvYmQm_Xw&oe=6AB3F20B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hlGMaKQr7QQ7kNvwHyNwvt&_nc_oc=Ado48mQ_He2TWoafw9UXHmdDCeig1fIx7bPOTDdxxURSuoR8s2uvHR4N5g0r8404eys&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzqhhOMOoAKHqm8mlj_4BUEXYQXmfZ6LEqcA_-eLe1cw&oe=6AB3BFDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5DyNE1Bor78Q7kNvwFsMyEQ&_nc_oc=Ado1ofroD7sk2_cj0DpBHQCRfWwvnWmXjjUd1VN_24IdanhgjrsGYZfJuNVLq7jVHtY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzJLqeQCOVXHPkm-7hc_xiXbh0EJFUlif3t61knsnnYQ&oe=6AB3CFA5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["RELAXATION_MEDITATION", "TRAVEL", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supporte
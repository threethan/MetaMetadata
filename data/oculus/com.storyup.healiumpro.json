BS8koWQEOpdP_ATVEYxxM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM7bRl7xboOqTP8sOYj2G3hZ0qD-fP2YCTd18SWIHL5Q&oe=6A86FA47"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KiKgMIOGr9YQ7kNvwHWTh3J&_nc_oc=AdqywwbbhiOjRKBAJb2QhIX6SnRRFHfk_Le-94l2pDNOtEreQSwMYYXsZA6HNjRMAH4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHm5OrpaBMMrhyTgqBc835BFfmW7dH1N-8OXaL51ONTfw&oe=6A86E159"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Btx97BU9N5wQ7kNvwE-sX78&_nc_oc=AdrkbaZOvKz0Ro0TL3pYzYV1FxgiGN3wFiUCRfKzkFcRSGdkFN_tJjqhKXYzIIucF90&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErJi3d46W4nxVHIKCBkFVqsKB0a7u4X76NOfNGFrlPiw&oe=6A86E6CB"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QkHGdW88jJYQ7kNvwHQfvXU&_nc_oc=AdoNiU7_d47PLH3gG19HE_R2smuCTQgeIQCIO3lcacAkWetHA2E1ETzyDHfYFF9nldo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFqpXZohaLQFlPzp3V71HaY8x4miEM4o33wF8Md8yotRw&oe=6A86ECDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ee27dSu4j0oQ7kNvwE6Cp4p&_nc_oc=AdrSpnaRenYy4KtNQ3wv7XVy9RcHg9CWU13gAhv-pWAY9J7k2sc4msMV39Y75KVl6ng&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF-0ZgZOw4oo1zTzcDRkfG6C_xjdd8s4cpmENPxQJX7Q&oe=6A86FCA5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
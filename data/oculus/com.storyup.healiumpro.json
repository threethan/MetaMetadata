5pA58vIUppX0y-bv8NtP3DJCco&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFuwTWQ89K00-s6a7LHJt2hphpa_R7w9eCKINl8F3p3zw&oe=6A7DBFC7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5m4keyuaZ0Q7kNvwFWMmnw&_nc_oc=AdrD20f1LtvzS9Cg7M3S0zCOtk7v_UjeDTbnn_hzwWMZUoRb8zadmTSjDIVafkxP4zo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEptpIlIeUpRhrm9FB2CdzsADukdsygTzEJYBgQ9R1S-w&oe=6A7DA6D9"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xeE85tCLCc4Q7kNvwE8DNcT&_nc_oc=Adp1buyXtbjtm49m02LlEFYzwDbuq18CrwTgQsfADP74JIoGji1gJhFE7KnIIzHHgEE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJXCwR8z1xfzqdLz3y_2kDaBjz4yAJHCxJIhd-8behvQ&oe=6A7DAC4B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ru96SjcpHYQ7kNvwFUlIBS&_nc_oc=AdrGdEkOmCShc4bOOeHOjw8TUzn-FfsXJE_i7Vb81vG5OQ-Rndmrq-ycxI7Ur5oYrOk&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHiFoYvUjZYl-JCUQD23PH4PzBVhJsYAeicrxYXrd6V5A&oe=6A7DB25E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_oVP4i3zaMQ7kNvwE6C4Rn&_nc_oc=AdqUH3UQwUohrWkTgdHcZ-A5g7o5NHTJLTrR7KhdFC0LLCf-7Jp9_X4rfrlowO5z5TQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIPD0NTgArIlMlxSIU8quFWGT2QFFq7ox-_28Upkezgg&oe=6A7DC225"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category":
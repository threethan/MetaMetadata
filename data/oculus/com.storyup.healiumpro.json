s2nhZOWfSxFeOAN1c1tHU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVzBr3h4TW-QGe30HuZ2zImJEj4dPUD1JyrzWHe1lBZg&oe=6AF0AA87"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UlsmmLJdxLkQ7kNvwHimf5r&_nc_oc=Adqt4f39HLqHr6lqjV9_Q-uzrgJcslS5Gj-jD-Pqkfbd8rU7pQBtFd8OgrepAaryJyk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD6GdfJ4yJQ__briiS46x76EAH3SbhxcCjANbwbvrJuw&oe=6AF09199"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PM7URQXFkrAQ7kNvwHNecfc&_nc_oc=Adpl4-ogwKTzrsKdOqu0BxUy46cm0bmOXhiuRq4CqX-jhSn_IGJHF5HUwUuSEWF18e0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_tMrPC5W7UOvYKpJ0SXhQMhc_bUBLmfxwvzZaPaj9JQ&oe=6AF0970B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IiolugNwqqUQ7kNvwEtjt0G&_nc_oc=AdofL585K34R4O0w_yUzwSzwlvcy13eYHBlWUrUEjqSwAHEnCaMF0QkZOxYfGk3gd5g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAQHagxq7KE4uLKFuCyp98BJ0yH4vku_p_RqEQQB526Q&oe=6AF09D1E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRtXql-3NTYQ7kNvwG4M77H&_nc_oc=AdqOJlyH4cJM0Kdl_Evbq-xG3iuJXa_Q-ypzwR5EJyq6vuKyuXGGMbTF59a4b7weEGE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4ri3XIApdLN_oCLtq1dTyTKPyz67dCh8lQrMa1TvM4w&oe=6AF0ACE5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
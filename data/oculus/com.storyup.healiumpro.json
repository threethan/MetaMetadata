dJdEQf6eyr8YYxOVaKezo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJKXJIuxllNskoi5sA2Cqf7vjv5_WL3YECYQrAf3ilMg&oe=6A68A7C7"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lSYo2sKDzMQ7kNvwEV-CoJ&_nc_oc=AdrCBkscvj8Q8oixqbAi-6M7TP7tGo5Tj4V2Zh-vQ7Rn1T34Np55kHquYJ-3kMWPUP0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9dHfuDkZxiuj6dWqDnxLK_JbIFpeQxpUefsp2-aBhvQ&oe=6A688ED9"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gcLbLl4YAIQ7kNvwFkes2M&_nc_oc=AdodYc2GB8QZHA5xPTfHg8ofAu8HyXmTS2ZX4Y7wvJFyMxnyoLfVqWQTTZGJiUmMiw8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4Op5Dz30qRsoNhflNWgzpaSngmxCaXb72yru0LM6ISw&oe=6A68944B"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HgfTFi1NzYQ7kNvwElt9b3&_nc_oc=AdpCogUz3Qq5YKN1hEsD3BT-ooz0mKTbxyqkJLUUSbybq7GSJ5t0Whk-xkoP0IbKLl8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFKTVNxmyX_BlJ4vA2YFFP-ShUuUae54vR7KpZ44nIbQ&oe=6A689A5E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xIQNStjwqcQ7kNvwGMgoNm&_nc_oc=Adq13y-PLdMtdRNauf89GHy_62IYh6BqZj0ZmTx9akwSDknOUaVtvusBYmPEhTOSU9w&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdw6c4hJnI5l8cyFeVyeIlVWDQuVf5ZvbfAQD9kRp38w&oe=6A68AA25"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
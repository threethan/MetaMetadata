8B9cXfEtobN7cfE-OSPcU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFNYES4MpaaXsdH_iWQSzLkG_2mHHdEQwcRc6wEhUEew&oe=6A5F6D47"}, {"file_name": "delete me 1 .png", "id": "172355680988904", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974479_172355684322237_4105130526410975147_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmc9-LVZnWsQ7kNvwGLni-u&_nc_oc=Ado63GTbCgnEzhdwVPWkPlyJtWsdP7asbF40Ko9oyJw5EV46K_Bcm3RxB6AcOMOIMEk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBiaGkFCsRV7xD4-yu07-t2a4dZ_7rBENmaFtdyeMYhow&oe=6A5F5459"}, {"file_name": "delete me 4.png", "id": "158877452514842", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75422392_158877455848175_4048704126648886678_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAXYfof_bqYQ7kNvwGyuFz1&_nc_oc=Adp7PqoW-Z_Fh-BJwRjBaoMAkxwupFjOBiRpyi5iDMdykV-L39A1hR3LHUh8pI-8Dwc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWU_Xc9Gu42w_8uZpkSLbUS1162lOqA4aPCETihQoQGA&oe=6A5F59CB"}, {"file_name": "delete me.png", "id": "138116401478547", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462963_138116404811880_7726014392190288933_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M94zdorHtzMQ7kNvwEy8Y19&_nc_oc=AdrhtM2C9bHHp2XYZgtstbgHxBpDuj5AEtXCoNe-6yiAOztlzFP8KUd_VPAGrFpLB4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAiIhhQYOBWQTSikziWdKVc9m4JaQx8PODGPGrFaGrSBQ&oe=6A5F5FDE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "delette me 6.png", "id": "462900904730118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57570311_462900908063451_1017078218521890310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb3bMpznEWoQ7kNvwGfU1AI&_nc_oc=AdrB1a7ecu7X9z_8QNcsOfBccoz-u6xgX5zEkq-v6DZDnjACq7TW7dHx4Pf7w8fhssw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAICihQnecbTe4GMofKim7m3hKb-xSOERXul9TtQyklwQ&oe=6A5F6FA5"}, "display_name": "Healium", "keywords": [], "long_description": "Beautiful, nature-based escapes powered by your imagination. Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Use your feelings of focused calm to make the flurries fly inside a magic snow globe. Sit quietly inside a zen garden. Grow leaves on a 150-year-old Burr Oak tree with your memories of being still. Healium is a walk in the park for those times when you can't physically take a walk in the park. In four peer-reviewed journals, Healium has been shown to improve mood in as little as four minutes. Connect an optional EEG meditation headband to make a firefly rise and fall with your feelings. Healium is a reminder that our thoughts have power to control things not only in the virtual world but the real world as well.", "short_description": "Beautiful, nature-based escapes powered by your imagination.  Float through a crystal forest, feel a healing rain wash over you, or sit quietly in a field of sunflowers. Virtually travel to Mauii, listen to the rustle of a bamboo forest and the ocean waves lapping at your feet. Experience different colors of healing, trace a mandalynth, or glide through a breath-taking fractal. Healium is a walk in the park for those times when you can't physically take a walk in the park. "}]}, "developer_name": "Healium", "developer_privacy_policy_url": "https://www.tryhealium.com/privacy-policy/", "developer_terms_of_service_url": "https://www.tryhealium.com/terms-and-conditions/", "publisher_name": "Healium", "support_website_url": "https://www.tryhealium.com/faq/", "website_url": "https://www.tryhealium.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS
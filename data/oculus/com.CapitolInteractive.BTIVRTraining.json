": "ss-5.png", "id": "2234956736877025", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031421_2234956743543691_7041318165616746897_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRoP9br-_KUQ7kNvwF85men&_nc_oc=Adl1mLvoTqzsm2Jly0OmegVV_WfEVVSKs5FXyGj6cMgxw42O6Ib7viT1qhosaMlfyAw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afuio3Pvkw2NxRbys07DFTYYQysewGFPwqB5DT5bHx9igQ&oe=69A446D1"}, {"file_name": "ss-4.png", "id": "1102742384541135", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223470_1102742387874468_5690116116704421764_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85Z8cgjMDYAQ7kNvwElamR7&_nc_oc=Adl1akQPukjTXoRJcVOtL7l3OcbSCWgXrZJsHkciFM8UFNigItLvbKYCLTlZkBE81SA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvLKcPmFifcjB5X6MI-gq-x792vGuP3HPFpS9woaAesKA&oe=69A42E25"}, {"file_name": "ss-3.png", "id": "432950273136799", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/57566688_432950276470132_6296901410558271266_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RhLWbG9YL90Q7kNvwH4p5Mg&_nc_oc=Adm6JwSgVgnlMg-HILP1S_f3v8NfnlAzuU8MYZANOXSKq5JxG1hM7zw1UFlcSYZgQoc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvGueETfBjrnlFtGh0PrDOKWs09L1_cFGSz_8oL1IL0lA&oe=69A42235"}, {"file_name": "ss-1.png", "id": "990870309506933", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974746_990870312840266_8219670313969916413_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKZVOLuw97oQ7kNvwFZqA_S&_nc_oc=AdkiWzIupsWJd0Lf0ULUsqQD6nvFBeDCNIMN_J2UsAdMKWriFByMtY12e4W7mdtYuMc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aftge0t1QYCSCzR38iMqA8kwJkaF1i0EbAlAD3kwJ9VmXg&oe=69A444E6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-thumb.png", "id": "896068849090374", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984476_896068852423707_6468028910789789512_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WvUOVolKqjMQ7kNvwEF4gPg&_nc_oc=Adk9DvucFRnzDkXvA1JvLBZeHfJXjJPhT8TD_pMfwFLO0AtCcPuCcYEF6A43L7226Nk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftegN4ZIFtGfCm65cI2QUhcad41pMUknChrA5CcUK-ufw&oe=69A42054"}, "display_name": "BTI: VR Training", "keywords": [], "long_description": "Key Features:\n\nHands-On Learning: Enhance your hands-on experience with a realistic virtual lab setting, ideal for BTI\u2019s BioSTART and Laboratory Associates Program.\n\nSelf-Paced Learning: Progress through learning modules at your own pace with built-in evaluations, ensuring you develop competencies before advancing.\n\nHaptic Feedback: Feel like you're performing real tasks with tactile feedback from the controllers.\n\nInstructor Monitoring: Instructors can track your progress and practice frequency, ensuring a smooth transition from virtual to real-world competency.\n\nAccessibility: Break down traditional barriers to training, providing more opportunities for underrepresented demographics.\n\nAdult Learning Principles: The program aligns with the principles of adult learning for effective skill development.", "short_description": "BTI VR Training is a cutting-edge training tool for the biotechnical sector, ideal for those entering the biotech industry. It combines practical lab simulations with interactive theoretical lessons, providing a comprehensive learning experience. This application is a key resource for acquiring essential lab skills, serving as a bridge to the dynamic biotech world."}]}, "developer_name": "Capitol Interactive LLC", "developer_privacy_policy_url": "https://www.virtualapprentice.net/privacy-policy/new-portfolio-item-jjw66", "developer_terms_of_service_url": null, "publisher_name": "Virtual Apprentice LLC", "support_website_url": null, "website_url": "http://btiworks.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_
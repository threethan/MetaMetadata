7kNvwGZ1m8G&_nc_oc=AdoCd7_UiZHqu-M2wRVWU4B3_UL35impLJLtFsSzOZdkU5daCgIjy-X1zbIPXGd76Z4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1fjeQ6ANPT5pJL9ASn2qTqRFy1B_jOwq7jVJyhYUr8w&oe=6B0DA565"}, {"file_name": "b081f760c3ed46fd9bfb3a6362e72152.png", "id": "1994891477862073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1994891481195406_2516230768412551774_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lwvOWukOrqcQ7kNvwEbGIVJ&_nc_oc=AdqGpbafVR5JFpdZHh1bFP-XH3n_pOf5k5XAlz4E1BHyxQ2UbeiCKFWFs8M_dVZnogA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTbtI859GWDyrAKbEgf_PeyiC9naXffkzhzT7vG02LQMw&oe=6B0DB244"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Impossible", "keywords": [], "long_description": "Dare to take the journey.\n\nImpossible is a minimalist VR challenge built around timing, precision and the irresistible urge to try just one more time.\n\nHigh above the world, a seemingly simple path stands between you and the finish. Watch carefully, learn the rhythm and choose your next move. The further you progress, the greater the pressure becomes and a single mistake can bring your run to an abrupt end.\n\nThere are no complicated rules to learn. The challenge is simple: keep moving forward.\n\nDesigned around a clean, striking visual style and an easy-to-understand gameplay loop, Impossible is about mastering each attempt, learning from every failure and pushing further than you did before.\n\nCan you stay calm, trust your timing and reach the end?\n\nFeatures:\n\u2022 Precision-based VR gameplay\n\u2022 Simple mechanics with a demanding challenge\n\u2022 Rhythm and timing-driven obstacles\n\u2022 Fast retries that encourage one more attempt\n\u2022 Minimalist environments with a distinctive visual style\n\u2022 A challenge designed to be learned, mastered and conquered\n\nThe path is waiting.\n\nDare to take the journey.", "short_description": "A minimalist VR precision challenge where every step matters. Read the rhythm, trust your timing and make your way across a surreal path suspended high above the world. One mistake can send you all the way back. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.titlesunknownstudios.com/privacy-policy/impossible", "developer_terms_of_service_url": null, "publisher_name": "Title Unknown Studios", "support_website_url": null, "website_url": "https://www.titlesunknownstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1532649921963725"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2836227830110736"}]}, "baseline_offer": {"id": "2836227830110736"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790164680, "status": "PUBLISHED", "id": "2836227830110736"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1538985271330190", "version": "1.0.0"}, "id": "2310125809775984", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "15326499186303
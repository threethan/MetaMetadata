, "id": "1717700179343798", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1717700182677131_5905738693805893014_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psFFtgU9lj4Q7kNvwGBfOFx&_nc_oc=AdqqD7_MwGteQRViMd4111zkhhnPhC5izGlv2IK-spvobunDRJ2VtPwaFddFI8RHpBk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ7B0UcsKxNPJOIiy-Er2woCXiGbaIZOYuhAgcOZF1Ng&oe=6AF88D65"}, {"file_name": "b081f760c3ed46fd9bfb3a6362e72152.png", "id": "1994891477862073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1994891481195406_2516230768412551774_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iFZGDUtxmOMQ7kNvwH0pT3A&_nc_oc=Adrkn_xliZexRSYRZFdB6rw3b1kzYyppUpDlSbvxBa6utCfcAUMjgyqgGdRuqqu_62k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPZKbXupR3enZM5PrAsmCwdnQ82nKOqBF7eIzfrvCZ4Q&oe=6AF89A44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "impossible-trailer-cover-2560x1440.png", "id": "2576410352786867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_2576410356120200_6205217491943012556_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF2gQFfQggYQ7kNvwFvLy22&_nc_oc=Adq2jUhUqlpiLySI6qE-zy5vAuEHMWnUghfOAEb-NFhW1Www4M4_W1heCvO5nRg0Je8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT02Wk1yVFOMcUgt9m3SY-9uni_LsFBDMRJMLQuLFB8gQ&oe=6AF8A933"}, "display_name": "Impossible", "keywords": [], "long_description": "Dare to take the journey.\n\nImpossible is a minimalist VR challenge built around timing, precision and the irresistible urge to try just one more time.\n\nHigh above the world, a seemingly simple path stands between you and the finish. Watch carefully, learn the rhythm and choose your next move. The further you progress, the greater the pressure becomes and a single mistake can bring your run to an abrupt end.\n\nThere are no complicated rules to learn. The challenge is simple: keep moving forward.\n\nDesigned around a clean, striking visual style and an easy-to-understand gameplay loop, Impossible is about mastering each attempt, learning from every failure and pushing further than you did before.\n\nCan you stay calm, trust your timing and reach the end?\n\nFeatures:\n\u2022 Precision-based VR gameplay\n\u2022 Simple mechanics with a demanding challenge\n\u2022 Rhythm and timing-driven obstacles\n\u2022 Fast retries that encourage one more attempt\n\u2022 Minimalist environments with a distinctive visual style\n\u2022 A challenge designed to be learned, mastered and conquered\n\nThe path is waiting.\n\nDare to take the journey.", "short_description": "A minimalist VR precision challenge where every step matters. Read the rhythm, trust your timing and make your way across a surreal path suspended high above the world. One mistake can send you all the way back. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.titlesunknownstudios.com/privacy-policy/impossible", "developer_terms_of_service_url": null, "publisher_name": "Title Unknown Studios", "support_website_url": null, "website_url": "https://www.titlesunknownstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1550494586845925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
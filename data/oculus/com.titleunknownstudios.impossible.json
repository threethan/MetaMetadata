, "id": "1717700179343798", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604370996_1717700182677131_5905738693805893014_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G2iUt0wdUUoQ7kNvwFgzFzi&_nc_oc=Adq-i4nDFASN30zO1gRt4cxw_3AkE72qNw1DShLsqT6fk7Pc2-WGnvXVFy7ypE-Jfcw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0ymsottEM-sJ2MO31Hgp7CPXGZeUuiiK0OA-ZK-S4GQ&oe=6AF498E5"}, {"file_name": "b081f760c3ed46fd9bfb3a6362e72152.png", "id": "1994891477862073", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831279_1994891481195406_2516230768412551774_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-0n4vSqfzUQ7kNvwHD6LRu&_nc_oc=AdqVuSTmiQZb8bzkdG-dQ5SgNLA6frpHklHM7jGV6FEe2_7DqY7-Wp1wU8ZEHqDnpC0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS5VyPgb5Fkl48IYjItFJY_bNJkm4IgtdZduQvzpN_Dig&oe=6AF46D84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "impossible-trailer-cover-2560x1440.png", "id": "2576410352786867", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830576_2576410356120200_6205217491943012556_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9C8BDQ9QKMQ7kNvwECn0B1&_nc_oc=AdomQhL6imXavRwcsRvSyxeVUntqRJ6u2tatl_qAjz3jHcIiv7Oq2qRmwbWCOhU1HIw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAY0IMzd89AnUcr-eNtaNMbdt6ak0IzS8NiASveCLSsA&oe=6AF47C73"}, "display_name": "Impossible", "keywords": [], "long_description": "Dare to take the journey.\n\nImpossible is a minimalist VR challenge built around timing, precision and the irresistible urge to try just one more time.\n\nHigh above the world, a seemingly simple path stands between you and the finish. Watch carefully, learn the rhythm and choose your next move. The further you progress, the greater the pressure becomes and a single mistake can bring your run to an abrupt end.\n\nThere are no complicated rules to learn. The challenge is simple: keep moving forward.\n\nDesigned around a clean, striking visual style and an easy-to-understand gameplay loop, Impossible is about mastering each attempt, learning from every failure and pushing further than you did before.\n\nCan you stay calm, trust your timing and reach the end?\n\nFeatures:\n\u2022 Precision-based VR gameplay\n\u2022 Simple mechanics with a demanding challenge\n\u2022 Rhythm and timing-driven obstacles\n\u2022 Fast retries that encourage one more attempt\n\u2022 Minimalist environments with a distinctive visual style\n\u2022 A challenge designed to be learned, mastered and conquered\n\nThe path is waiting.\n\nDare to take the journey.", "short_description": "A minimalist VR precision challenge where every step matters. Read the rhythm, trust your timing and make your way across a surreal path suspended high above the world. One mistake can send you all the way back. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.titlesunknownstudios.com/privacy-policy/impossible", "developer_terms_of_service_url": null, "publisher_name": "Title Unknown Studios", "support_website_url": null, "website_url": "https://www.titlesunknownstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1550494586845925"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
qQhwpoa39peUARJVI9LAfFM1Klso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAErXwgvDT08gMyxjPmX4rvxCGc_AvVEPtvqkJM3HOSw&oe=6B01C27F"}, {"file_name": "0eb16917c76343cb83d18a69f220d06f.png", "id": "1717700179343798", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604370996_1717700182677131_5905738693805893014_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qkleIaF6RgEQ7kNvwFbjtwJ&_nc_oc=AdqDZxq3f0PA70DMxzJJPhzoa3gm8vlo6hm-Ihgi4OL_auenUfzoQALwyV2uuySc9DQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUAMskb_UvYQ8U9aDbqq9Q9-F1hi-0iM3ABMfDnvubgg&oe=6B01C7E5"}, {"file_name": "b081f760c3ed46fd9bfb3a6362e72152.png", "id": "1994891477862073", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831279_1994891481195406_2516230768412551774_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--jY0zOiO08Q7kNvwGsUnz-&_nc_oc=Adp68w8jS8Au3L17-eFZIvv3-ifS4i3Z9hxzkAWrrNqoM2k8J7wlQ5DhHVyISHQSNnU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6HaaszPVM-ti4RCBGXedH-8rMaLraJCxYLfTD5qObCw&oe=6B01D4C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "impossible-trailer-cover-2560x1440.png", "id": "2576410352786867", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830576_2576410356120200_6205217491943012556_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6mI062SivAQ7kNvwH508Mh&_nc_oc=AdqAG6MbWez7aVOaJx1WghHnqIrAewy4OqqRFnxEcqothbD-kfEYvz-3mxecBMDbVF0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ30Zjj-yes4QRNLHe1MJwmRLfptqZDv4kIBetInwOQXA&oe=6B01E3B3"}, "display_name": "Impossible", "keywords": [], "long_description": "Dare to take the journey.\n\nImpossible is a minimalist VR challenge built around timing, precision and the irresistible urge to try just one more time.\n\nHigh above the world, a seemingly simple path stands between you and the finish. Watch carefully, learn the rhythm and choose your next move. The further you progress, the greater the pressure becomes and a single mistake can bring your run to an abrupt end.\n\nThere are no complicated rules to learn. The challenge is simple: keep moving forward.\n\nDesigned around a clean, striking visual style and an easy-to-understand gameplay loop, Impossible is about mastering each attempt, learning from every failure and pushing further than you did before.\n\nCan you stay calm, trust your timing and reach the end?\n\nFeatures:\n\u2022 Precision-based VR gameplay\n\u2022 Simple mechanics with a demanding challenge\n\u2022 Rhythm and timing-driven obstacles\n\u2022 Fast retries that encourage one more attempt\n\u2022 Minimalist environments with a distinctive visual style\n\u2022 A challenge designed to be learned, mastered and conquered\n\nThe path is waiting.\n\nDare to take the journey.", "short_description": "A minimalist VR precision challenge where every step matters. Read the rhythm, trust your timing and make your way across a surreal path suspended high above the world. One mistake can send you all the way back. How far can you go?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.titlesunknownstudios.com/privacy-policy/impossible", "developer_terms_of_service_url": null, "publisher_name": "Title Unknown Studios", "support_website_url": null, "website_url": "https://www.titlesunknownstudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en
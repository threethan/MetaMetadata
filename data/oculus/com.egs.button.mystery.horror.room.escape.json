622916752988775778_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sXgpuNpIkYQ7kNvwHe82XZ&_nc_oc=AdqPWANvCzEyysHwfoELEId0THL1smp0Bxz30Zp1Ktb_zpY4rkQXoUhbn4XEgirD3Xo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQurgjmMl623b5_3rKvP9nPBDUXw-FyJRqKYcgl3GWnJw&oe=6AEF3653"}, {"file_name": "5th.png", "id": "1802641994443066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314660_1802641997776399_1123199971452262715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ow2eqEyOvssQ7kNvwHJJ7Xm&_nc_oc=AdpiSPslzLUlgkxOVgwD2lqyNiA8Kj_0msSpY1NSUP1jlArf9OnKO7g48mA8kRyltDs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTAstw8t_Z_ltlcQ6DnH8oVAS67Fo5xFimosKt7ubUxKA&oe=6AEF424C"}, {"file_name": "2.png", "id": "1572876507585680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507829686_1572876510919013_5786311199577440665_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kit8mRHClRUQ7kNvwHnnmWo&_nc_oc=AdqBcpzNBkkKoKuIoq2-HMTNhr6yqXvvQpHpKLNv9YRL1j2-ALKp26C4AtpGVsY6drQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrhATSx1Mc96ahU_v5jB2ps6GTd8j0Z2g24onrJsGEvQ&oe=6AEF39C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Button Mystery: Escape Room", "keywords": ["horror", "puzzle", "escape", "mystery", "scary"], "long_description": "The room is covered in mysterious buttons. Some reveal the objects you need. Others transform the trial in dangerous and unexpected ways.\n\n**Button Mystery: Escape Room** is a VR memory-and-consequence puzzle where observation matters and every choice carries risk.\n\nStudy the objective, investigate the button walls, and discover which presses produce the required items. Remember the useful locations, collect every object, and place them inside the glowing portal to complete the trial. A wrong button can summon a strange creature, reveal an unsettling apparition, change the room, or trigger a destructive event. Stay calm and use what you learn before your mistakes end the run.\n\n# FEATURES\n\n- Memory-based button puzzles\n\n- Objective-driven item collection\n\n- Different consequences hidden behind the buttons\n\n- Suspenseful creatures, apparitions, and environmental events\n\n- First-person VR interaction\n\n- Attempts that reward observation and recall\n\nThis is not about pressing randomly. Success comes from learning cause and effect, remembering useful choices, and acting carefully under pressure.\n\n# EARLY ACCESS\n\nThe core puzzle is playable now. We are continuing to improve interaction, visual presentation, balancing, performance, and overall polish, while expanding puzzle content and consequences using player feedback.\n\n**Enter the room. Remember what each press reveals. Then escape.**", "short_description": "Test your memory in a room covered with mysterious buttons. Discover which presses reveal the required objects, remember their locations, place the items in the portal, and escape, but every wrong choice can unleash an unexpected consequence."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "i
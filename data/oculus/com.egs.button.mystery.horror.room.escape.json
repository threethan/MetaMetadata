0919013_5786311199577440665_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RDLEI5AfdUQ7kNvwFv7HZk&_nc_oc=Adrj7ysSTzmKugerEpYapMP-aWMzST8wyPA1il5Zigqd09FQse5LoHVNI7-uflSgDT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsfddlkhI7YZ-KN9rAYhVtnrxk9KXpLucS6OC4dxcL8A&oe=6A998847"}, {"file_name": "5th.png", "id": "1802641994443066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314660_1802641997776399_1123199971452262715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erw1D3TrGfQQ7kNvwEqu7vK&_nc_oc=AdrUnVl1ik9l3qBqcwOClw2o5og2r5DYRMPzmV_8Aa3vWOyEnZVeKTvr-k4R4MBdz4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISnYgf8xgHKtZ0b3p6jAefG4sLf723rY5-APuvBK2S4A&oe=6A9990CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Button Mystery: Horror Room Escape", "keywords": ["horror", "puzzle", "escape", "mystery", "scary"], "long_description": "Button Mystery VR:  Horror Room Escape is a memory puzzle and escape room adventure with horror elements, hidden objects, and unpredictable events.\n\nYou awaken inside a mysterious room filled with colorful buttons, strange objects, and a locked portal. There are no instructions and no easy escape.\n\nEvery button can trigger something different.\n\nSome buttons reveal useful items. Others activate traps, strange events, jumpscares, or dangerous effects that can cause memory loss and increase your failure count.\n\nYour mission is to explore the room, remember button outcomes, collect required objects, and place them into the portal before making too many mistakes.\n\nBut the room keeps changing.\n\nUnexpected events, creepy encounters, and mysterious effects create tension as you progress through increasingly difficult puzzle challenges.\n\nButton Mystery combines VR interaction, memory-based gameplay, puzzle solving, and horror-inspired suspense into a unique escape room experience.\n\nFEATURES\n\n\ud83d\udd18 Unique Button Puzzle Gameplay\nEvery button can help you\u2026 or punish you.\n\n\ud83e\udde0 Memory-Based Challenges\nRemember patterns, outcomes, and important interactions.\n\n\ud83e\udde9 Escape Room Adventure\nSearch for hidden objects and unlock the mysterious portal.\n\n\ud83d\ude28 Horror Elements & Jumpscares\nUnexpected scares and strange events keep you alert.\n\n\ud83c\udfae Designed for VR\nImmersive first-person interaction built for virtual reality.\n\n\ud83d\udd01 Replayable Gameplay\nDifferent runs can lead to different discoveries and outcomes.", "short_description": "Solve button puzzles, find hidden items, and survive scary surprises in this VR escape room adventure."}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27001469212881292"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1537470407954465"}]}, "baseline_offer": {"id": "1537470407954465"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781118000, "status": "PUBLISHED", "id": "1537470407954465"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__type
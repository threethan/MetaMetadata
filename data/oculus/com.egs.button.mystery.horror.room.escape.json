&_nc_oc=AdpC7hRTluH1rdEGYAQfCWqESrX-_5ZsqpPB0he4gTmUjV2tYacQaVt_wxscUYwFCM8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFT09zjhw4aLe9p-TuHZMCCtg91Ggr5axZQo1XE0C6zA&oe=6A99852F"}, {"file_name": "6.png", "id": "947981981541059", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311585_947981984874392_8622916752988775778_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Vric7LmyCMQ7kNvwFSmRf2&_nc_oc=Ado3KcwJSawKmrP_eZ6_APD1czB1ou35na9Pvopf3bELYG9gpfnkP_oXRabwzy2jg-8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0cV6fA6Xq82d-epnpxoGXSRYFIVp-OkRFPl-PuB3KVA&oe=6A9984D3"}, {"file_name": "2.png", "id": "1572876507585680", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507829686_1572876510919013_5786311199577440665_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1RDLEI5AfdUQ7kNvwFv7HZk&_nc_oc=Adrj7ysSTzmKugerEpYapMP-aWMzST8wyPA1il5Zigqd09FQse5LoHVNI7-uflSgDT0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsfddlkhI7YZ-KN9rAYhVtnrxk9KXpLucS6OC4dxcL8A&oe=6A998847"}, {"file_name": "5th.png", "id": "1802641994443066", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499314660_1802641997776399_1123199971452262715_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erw1D3TrGfQQ7kNvwEqu7vK&_nc_oc=AdrUnVl1ik9l3qBqcwOClw2o5og2r5DYRMPzmV_8Aa3vWOyEnZVeKTvr-k4R4MBdz4I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISnYgf8xgHKtZ0b3p6jAefG4sLf723rY5-APuvBK2S4A&oe=6A9990CC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Button Mystery: Horror Room Escape", "keywords": ["horror", "puzzle", "escape", "mystery", "scary"], "long_description": "You wake up in a strange room with no idea how you got there.\n\nMannequins stand silently in the corners. Furniture is scattered around you. Endless buttons cover the walls.\n\nNo instructions. No clues. No obvious escape.\n\nJust buttons.\n\nButton Mystery: Horror Room Escape is a VR puzzle, adventure, and psychological horror experience where memory and observation matter.\n\nWhat starts simple quickly becomes scary and thrilling. Solve puzzles, remember button locations, and uncover secrets hidden throughout the room. But things begin to change.\n\nStrange random events appear. The atmosphere becomes more dark, chilling, and unsettling. Silent mannequins and unexpected moments create growing fear and dreadful suspense.\n\nAs you continue your adventure, you'll face mysterious events and wonder if something evil is hiding in the shadows.\n\nFeatures\n\n\ud83e\udde0 Remember & Survive \u2013 Track patterns, locations, and choices.\n\n\ud83d\udd18 Unique Button Gameplay \u2013 A different kind of escape room puzzle challenge.\n\n\ud83d\udc41\ufe0f Uncover Secrets \u2013 Discover hidden clues and mysterious events.\n\n\ud83d\ude28 Psychological Horror \u2013 Scary moments, suspense, and growing fear.\n\n\ud83c\udf11 Dark Atmosphere \u2013 Chilling surroundings with strange random events.\n\n\ud83d\udd01 Replayable Experience \u2013 Different discoveries can change each run.\n\nCan you escape, or will curiosity become your biggest mistake?\n", "short_description": "Wake up trapped in a mysterious room filled with mannequins and endless buttons. Trust your memory and press carefully\u2026 something terrible is waiting"}]}, "developer_name": null, "developer_privacy_policy_url": "https://engaginggamesstudio.com/privacy.htm", "developer_terms_of_service_url": null, "publisher_name": "Engaging Games Studios", "support_website_url": null, "website_url": "https://engaginggamesstudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
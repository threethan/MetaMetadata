creenshot_02.png", "id": "1641437774355534", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_1641437777688867_3675366394183738081_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LYkvN-g3_toQ7kNvwHxJ6ur&_nc_oc=AdoguCbAqwCVnA4xkB1oFz4p2Qnh2WGmPgNQ2mibSPg0GgwXUG_hCZI-fzqRuAI30fA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN5Le5Ba7zVpKlxNmUHV7hLEe4wGlqBKtj4Bc0h8PfAA&oe=6AF35763"}, {"file_name": "screenshot_04.png", "id": "4781881288751117", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823905_4781881292084450_3792462627185795168_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VKedYNrXLukQ7kNvwHAOZqc&_nc_oc=Adpjii5ifZ3GeffknpcrsAr2Q9gAHWtkrQ8PHawKXEOPuxu5tKLu_Sru-aG90sbVkEY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZ4eEH2h27gl9KSNuB1UAkDhRCW7ocsEACoPfTHaZQvQ&oe=6AF3238B"}, {"file_name": "screenshot_03.png", "id": "1658023369034418", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824665_1658023372367751_430845932710528057_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2EvjoUF4alAQ7kNvwGQ-CTQ&_nc_oc=Adrjx43POepZ85kqUIByvadk3JkMMDoOpkKi1Vl0vT6PodOW40S-kMff31bWjl1xvE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiigcsTPILUJZgMMUrySNTcenDFAEhNXzuSWleLZg8Yg&oe=6AF355C6"}, {"file_name": "screenshot_05.png", "id": "2332768447478669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_2332768450812002_8195798954632667365_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vRJ_BfsudkMQ7kNvwHG6MxA&_nc_oc=AdqbRR68mN3bWMo4EHdllxA4fLc4yLNG1oZmn0fNTy8GI0lIJiHETZTkpP4oakJoAu8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd2lX95O3GRT8YXnsqTqUywoGyrgP_iw48NDUSizXcrw&oe=6AF32CDD"}, {"file_name": "screenshot_01.png", "id": "1485741946804477", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823837_1485741953471143_1425626395264868067_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guK68fE1xvoQ7kNvwHUxcrR&_nc_oc=AdpwNm8cs26u8VtBGVyx1D_pft1HybZlrNApphllXJX6zhcbGQt3hZB2h14pSrA8iGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJyTtHZ9-V9UdNQRvP-0Ii6xcZdd4WXWR496CdkwGBEQ&oe=6AF33557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "29245353865081279", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_29245353885081277_4703890347092395099_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kHF6B06vNxwQ7kNvwHoc6-S&_nc_oc=AdoQhfTRfa_EmowR1vGOmaldEjF9tTTbbsa2Ku4KL7B5TpLFeLJG8fOED2HhY8N3mYg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTD8wGeQWtiV0-FFMyVUTuqaWPvXJ6QIEDVrlQUqwtjww&oe=6AF34C74"}, "display_name": "Fractarium", "keywords": ["Fractals", "Mathematics", "Science", "Geometry", "Art"], "long_description": "Fractarium turns the room around you into a gallery of objects that cannot exist.\n\nSeventy-seven exhibits in eleven collections: escape-time fractals, recursive solids, Mandelbox realms, organic hybrids, kaleidoscopic landscapes, bulb-box universes, minimal surfaces, algebraic surfaces, knots and one-sided surfaces, strange attractors, and higher dimensions.\n\nA Mandelbulb hangs at arm's length. A Menger sponge has zero volume and infinite surface area. A Klein bottle passes through itself. A 120-cell turns through a fourth dimension you can watch but not point at.\n\nGrip with one hand to turn an object, with two to resize it. Then change the mathematics: raise a power, fold a box inside out, drag Lorenz's constants until the butterfly comes apart. Over a hundred parameters are live.\n\nNothing is pre-baked. Forty-five exhibits are ray-marched every frame, twelve are traced as point clouds, twenty are generated as geometry when the gallery loads. Sixteen palettes recolour the room, with relief shading that reads the surface. A spatial synthesiser locks a harmonic drone to each object.\n\nStep into the void for the mathematics alone, or leave it standing in your own light. Hands or controllers, seated or standing. No account, no network, nothing collected.", "short_description": "Seventy-seven mathematical objects, standing in your room through passthrough. Mandelbulbs, Menger sponges, Klein bottles, strange attractors and 4D polytopes, all computed live. Grip with one hand to turn an object, with two to resize it. Then change the mathematics itself: raise a power, fold a Mandelbox inside out, drag Lorenz's constants until the butterfly comes apart. Sixteen palettes, spatial audio, hands or controllers. No account, no network."}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/fractarium/privacy", "developer_terms_of_service_url": "https://nebulytic.com/apps/fractarium/terms", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/fractarium/support", "website_url": "https://nebulytic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1398090333386986"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827973_2574274606422580_3537175469008985106_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RvwRHbmxh2wQ7kNvwGDpVZf&_nc_oc=AdqI-uIqvz-WS-dkpZh39s4nqaf1Xa2hSmPwTFs3CYvQxw44ZpGJ5IDEznfsDvPwips&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_s
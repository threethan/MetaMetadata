play_name": "Samsung PhoneCast VR Beta", "keywords": ["Labs", "cast", "video", "samsung", "phonecast"], "long_description": "* What's new: Multi-screen and Theater mode.\n\nEnjoy viewing your favorite mobile video application in your private theater at scenic lakeside campground. Sit back, relax, and enjoy.\n \n'Go to Labs', when you feel like doing more than viewing. We brought (most of) your mobile applications, installed on your Samsung device, into your private garden so you can check emails, ping your friends, or do anything else you enjoy doing on your mobile phone while you are present in VR world. \n\n* Lots more exciting news is available on our new Facebook page: https://www.facebook.com/phonecastvr.samsung.5\n\n* Please check out our FAQ: \nhttp://www.samsung.com/us/support/answer/ANS00063079/\n\n* Note: Supported Android apps on PhoneCast VR (on home) varies per country. Please refer to our FAQ for more information.", "short_description": "Enjoy viewing your favorite mobile video application in your private theater at a scenic lakeside campground. Sit back, relax, and enjoy.\n\n'Go to Labs', whenever you feel like doing more than viewing. We bring (most of) your mobile applications into your private garden so you can check your email, message your friend, play game or do anything else you were doing on your phone."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.samsung.com/", "developer_terms_of_service_url": "http://www.samsung.com/", "publisher_name": "Samsung Electronics Co., Ltd", "support_website_url": null, "website_url": "https://www.facebook.com/phonecastvr.samsung.5", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["MOVIE", "UTILITY", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "
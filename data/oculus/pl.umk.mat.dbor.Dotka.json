265344_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLwr-5hiwNIQ7kNvwEWmU9-&_nc_oc=Adqfcejzu-NDuMKOU52trRnSoGpDW2S-b3jO-uspA4p_y4ONpEQjEN6bgs5E3Pbrc38&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMH_aJGBZiG0PQojcwnQDyj_Ha6N6dwUruvu0XqwlnWA&oe=6A859FFF"}, {"file_name": "migrated_image.png", "id": "525688161705157", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39001681_510309092881288_2367234691922132992_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7G0SD_fP4IgQ7kNvwFbMJYA&_nc_oc=AdpNeIndFYBCBGaVdeI7RF63tZlu6ujiPPLpLQ21onHej1aTgYlqEsZFcQXd4nXRtfI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFyk2gabSCuVSU3kZZ1zYPntqhxfjiQewnsKvDLLPEbfw&oe=6A8589F0"}, {"file_name": "migrated_image.png", "id": "2329081290734141", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982473_2426231394318613_901009741277298688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6iiuD0-CpNkQ7kNvwHTen1x&_nc_oc=AdoyzCKTECeIPGa8qEHjkm7c2ZRLB_RCIysA2ZdMh0xetg3oTu9vCBAFnA-yc7vH4d0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe57mzz1FQWcHar_QBX9JTurBX4otIVqA0ZkzXnTfLHQ&oe=6A8585F4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dotka", "keywords": ["Game", "Shooter", "Action", "Dotka", "Asteroid"], "long_description": "The game is a shooter. The goal of the game is to shoot down as many asteroids as possible. The number of correct shots is displayed on the screen after every good shot. You have only two lives. Avoid collisions with asteroids!  After the first collision You will burn. You can repair yourself by flying into the green ball. Navigation is very simple and uses only one button (Trigger): press and hold - move forward, double fast click - shoot.\n\nBibliography:\nA. Cookson, R. DowlingSoka, C. Crumpler, Unreal Engine 4 Game Development in 24 Hours, Pearson Education, Inc. 2016.", "short_description": "The goal of the game is to shoot down as many asteroids as p
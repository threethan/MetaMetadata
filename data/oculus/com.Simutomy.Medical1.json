.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ADa3ECkRF4Q7kNvwHhiocb&_nc_oc=Adp-L9p0mSj-Mam8LKD9_XMdPOFolh8pAI02AI0IGk7Qj8JgAz83utbpuF4JvoRMZjE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwvES_Ra-mqOjIw_So-EBG4-uCiI4VMmzjxoNHq-ZTmw&oe=6AB3F593"}, {"file_name": "Screenshot 4.png", "id": "4547711152141200", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823949_4547711155474533_8047107360825871700_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DK5kS446GTEQ7kNvwEQfEZD&_nc_oc=Adr7eFX-pLCFwLu1XwrQQknLZbZUEmJ6yZChBrOkxhZ3gR7Lzgl4-e4UluH1QLGmUVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeVS52tqlt5bTf-kgOdoLZP0Hu5RTqLoedeLSAaTaGtg&oe=6AB3CACD"}, {"file_name": "Screenshot 1.png", "id": "1475341704356657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824307_1475341711023323_7443015728043492681_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yX6mQhF5qAMQ7kNvwHr-C8_&_nc_oc=Adr9hX4pBbYbytGGuT8d0AdnDEVXQ9u6GVTtM4RfKgbg_TrdjMSdlTUVl9keCTr3lok&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRRH1GSLoPh-FMl4_KfDx1YJTMDoX-Dwpk8IApsjTpPA&oe=6AB3E0C1"}, {"file_name": "Screenshot 7.png", "id": "3062762144084909", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_3062762147418242_3902861305978465404_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R0_rhyWglOIQ7kNvwF0DnJe&_nc_oc=AdrY3Ao_YYjikDSITsTjWvCx-M7P0Z5tRdZXMOLfOqCOT0NVYAKe_TWR_i8Iw4MOOtc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJCVC6t_lvCcmwFvlDytEll6ybBk1C7IlyQjerK9UGygQ&oe=6AB3E2A5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer thumbnail.png", "id": "1580775120252350", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823783_1580775123585683_5306906078297447488_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjOQVDhItbUQ7kNvwHSMmtz&_nc_oc=AdrkvBcjdR4pMu0Z-fn8dpNoh6vCiNWpSa6yZi6QSD-N9mRks12xfGiU694FYJm-bmY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKE8A7Th4ColrBLMg52D_p4yq2WjIZ4OcQLw8w1U-JuNg&oe=6AB3EC10"}, "display_name": "Viscer Medical I", "keywords": ["Medical", "Simulation", "Training", "Education", "Nursing"], "long_description": "VisceR Medical I is an immersive VR clinical training experience designed for medical students, residents, and healthcare professionals. It provides a safe, repeatable environment to learn and practice essential diagnostic and procedural skills without risk to patients.\n\nThe pack includes procedures across general medicine, critical care, and obstetrics & gynaecology:\n\nGENERAL MEDICINE & PROCEDURAL SKILLS\n\u2022 Arterial Blood Gas\n\u2022 Intravenous Cannula\n\u2022 Chest Tube Seldinger Technique\n\u2022 Thoracocentesis\n\u2022 Arterial Line\n\u2022 Lumbar Puncture\n\u2022 Pericardiocentesis\n\nOBSTETRICS & GYNAECOLOGY\n\u2022 Pap Smear\n\u2022 Colposcopy\n\u2022 Cervical Biopsy\n\u2022 Endometrial Biopsy\n\u2022 Dilation and Curettage\n\nThrough interactive VR simulations, learners can understand procedural steps, practice clinical techniques, identify errors, and build confidence through repeated practice. VisceR complements classroom teaching, clinical demonstrations, skills-lab training, and supervised clinical education.\n\nVisceR Medical I is part of the wider VisceR healthcare education ecosystem. Additional VisceR packs cover other medical specialties, nursing departments, clinical skills, surgical procedures, anatomy, diagnostics, and other areas of healthcare education.\n\nLearn by doing, practice repeatedly, and build clinical confidence with VisceR.", "short_description": "VisceR Medical I is an immersive VR clinical training experience for medical students, residents, and healthcare professionals. Practice essential procedures across General Medicine, Critical Care, and Obstetrics & Gynaecology, including arterial blood gas, IV cannulation, thoracocentesis, lumbar puncture, pericardiocentesis, Pap smear, colposcopy, biopsies, and dilation & curettage."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.viscer.co/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Simutomy Medtech Pvt Ltd", "support_website_url": "https://www.viscer.co/contact", "website_url": "https://www.viscer.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "982291428167406"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1601595731363873"}]}, "baseline_offer": {"id": "1601595731363873"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787941800, "status": "PUBLISHED", "id": "1601595731363873"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "982297198166829", "version": "0.1"}, "id": "929932896815730", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "982291424834073", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "982297198166829"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "929932896815730"}]}, "change_log": null, "created_date": 1787291
AQItK0xrbD9x3hAgp_aD5Goeyf8HcbEshadT2fMiDkV9zA&oe=6AA158B0"}, {"file_name": "screenshot_28_20251202-131107.png", "id": "832476453089655", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820855_832476456422988_8383551753011786379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3KWybEAUEQQ7kNvwGuzcck&_nc_oc=AdohPAPlzzr-yr6K8yBmmDt5qPY3zAIWIVc1WKryFlCS78P_M7fSQiwdLNiRNancERQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX8qs0DQR82PODR_kHCTmpXzCS04IRddn7xhzbSDvXvQ&oe=6AA1556B"}, {"file_name": "3.png", "id": "1869324943773589", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824665_1869324947106922_1341569722763222754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4fAL3_K6-gQ7kNvwGUTxET&_nc_oc=Adp7y6W_aO_wpWOvvbq94VogWKPa8A-I7LGcL9E7EbE24y9vDvn5I_HYYK-a4E4ufjk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWGxi1wsDQGfbX4fk1s91kGrfxN6OdgcBu2YfCwyF1Jw&oe=6AA17C63"}, {"file_name": "4.png", "id": "966536092992263", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823270_966536099658929_7065836735143718708_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku3yjNZ2BPwQ7kNvwGwClqL&_nc_oc=Adr41eZ-tdJluHi6Cwmj7WQ2oEj2fTpCSmQjFJthTVRZkzdMHnhWteQ_qcvPn7fN7nc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDY8ajd-zjkT1qeEkl8bvEkAmdQT3r7MQBl69vwgQvzw&oe=6AA16C8B"}, {"file_name": "screenshot_44_20251202-131523.png", "id": "853472417082939", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822550_853472423749605_6621515077070126422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFrfE7PAm-wQ7kNvwG1kpXM&_nc_oc=AdoELBewE6PBbxPp0QlFbiOon6qVgikgOeb750Y7LxukKgzqwkCUb9z6srnIXIJZWbA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKfxcTBJKSabDaftx9fFYWnK5c05wy7xucymsqTzuJl7A&oe=6AA16FD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Design sans titre.png", "id": "1052003840544082", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491827973_1052003843877415_6326377583628192334_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_0cU2wf8hIQ7kNvwEp8_5O&_nc_oc=AdoqRwpekIBm1tlmPlzi2b3CyCB_vLoZxNWKbFs5ElBbxaLFWtGTxA5jZrAE5YN_fZk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsnECD13ZLLfwfW6mQnE2TaJfpxUVnn4pt92zRWIcc4Q&oe=6AA1663A"}, "display_name": "Dig To Escape", "keywords": ["Prison", "Escape", "Dig", "Hole", "simulator"], "long_description": "#                                                                                                                                                                                                       \n\n# Dig to Escape\n\n**Grab your shovel and get digging!**  \n\nDig to Escape is a stylized VR prison-break game where you dig, survive, and outsmart the mole to escape.\n\n{2046789639497740}\n**Dig for upgrades**\n\nMine valuable minerals and sell them to upgrade your tools. Better gear means faster digging, deeper tunnels, and more escape options.\n\n\n{1547839482800416}\n**Watch out for the mole**\n\nA sneaky thief is after your loot. Catch him before he makes off with your hard-earned minerals!\n\n\n\n{1551401099280034}\n**Be the inmate boss**\n\nBrawl, intimidate, or outsmart other inmates. Take on optional quests that can help your escape\u2014or make things much more dangerous.\n", "short_description": "Grab your shovel and dig your way to freedom!\nOutsmart guards, brawl with inmates, and tackle wacky quests as you tunnel through a chaotic VR prison break adventure."}, {"images": {"nodes": []}, "id": "1770942310598396", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["\u76d1\u72f1", "\u9003\u8131", "\u6316", "\u6d1e", "\u6a21\u62df\u5668"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# \u6316\u51fa\u9003\u751f\u8def\n\n**\u62ff\u8d77\u4f60\u7684\u94f2\u5b50\uff0c\u5f00\u59cb\u6316\u6398\u5427\uff01**  \n\n\u6316\u51fa\u9003\u751f\u8def\u662f\u4e00\u6b3e\u98ce\u683c\u5316\u7684VR\u8d8a\u72f1\u6e38\u620f\uff0c\u5728\u8fd9\u91cc\u4f60\u9700\u8981\u6316\u6398\u3001\u751f\u5b58\uff0c\u5e76\u667a\u80dc\u201c\u9f39\u9f20\u201d\u4ee5\u9003\u8131\u3002\n\n{1228813532185699}\n**\u6316\u6398\u4ee5\u5347\u7ea7**\n\n\u5f00\u91c7\u73cd\u8d35\u77ff\u7269\u5e76\u51fa\u552e\uff0c\u7528\u4e8e\u5347\u7ea7\u4f60\u7684\u5de5\u5177\u3002\u66f4\u597d\u7684\u88c5\u5907\u610f\u5473\u7740\u66f4\u5feb\u7684\u6316\u6398\u3001\u66f4\u6df1\u7684\u96a7\u9053\uff0c\u4ee5\u53ca\u66f4\u591a\u7684\u9003\u8131\u9009\u9879\u3002\n\n\n{961778742955503}\n**\u5c0f\u5fc3\u201c\u9f39\u9f20\u201d**\n\n\u72e1\u733e\u7684\u5c0f\u5077\u76ef\u4e0a\u4e86\u4f60\u7684\u6218\u5229\u54c1\u3002\u5728\u4ed6\u5077\u8d70\u4f60\u8f9b\u82e6\u83b7\u5f97\u7684\u77ff\u7269\u4e4b\u524d\u6293\u4f4f\u4ed6\uff01\n\n\n{2085378488911800}\n**\u6210\u4e3a\u56da\u72af\u8001\u5927**\n\n\u4e0e\u5176\u4ed6\u56da\u72af\u6253\u6597\u3001\u5a01\u80c1\u6216\u667a\u80dc\u4ed6\u4eec\u3002\u63a5\u53d7\u53ef\u9009\u4efb\u52a1\uff0c\u8fd9\u4e9b\u4efb\u52a1\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9003\u8131\u2014\u2014\u4e5f\u53ef\u80fd\u8ba9\u4e8b\u60c5\u53d8\u5f97\u66f4\u52a0\u5371\u9669\u3002\n\n\n", "short_description": "\u62ff\u8d77\u4f60\u7684\u94f2\u5b50\uff0c\u6316\u51fa\u901a\u5f80\u81ea\u7531\u7684\u9053\u8def\uff01\u667a\u80dc\u8b66\u536b\uff0c\u4e0e\u56da\u72af\u6df7\u6218\uff0c\u5e76\u5728\u6df7\u4e71\u7684VR\u8d8a\u72f1\u5192\u9669\u4e2d\u5b8c\u6210\u5404\u79cd\u75af\u72c2\u4efb\u52a1\u3002"}, {"images": {"nodes": []}, "id": "1616593846700608", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["Gef\u00e4ngnis", "Ausbruch", "graben", "Loch", "Simulator"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# Dig to Escape\n\n**Schnapp dir deine Schaufel und fang an zu graben!**  \n\nDig to Escape ist ein stilisiertes VR-Gef\u00e4ngnisausbruchsspiel, in dem du gr\u00e4bst, \u00fcberlebst und den Maulwurf \u00fcberlistest, um zu entkommen.\n\n{1237325348507167}\n**Grabe nach Upgrades**\n\nBaue wertvolle Mineralien ab und verkaufe sie, um deine Werkzeuge zu verbessern. Bessere Ausr\u00fcstung bedeutet schnelleres Graben, tiefere Tunnel und mehr Fluchtm\u00f6glichkeiten.\n\n\n{25994835953478522}\n**Pass auf den Maulwurf auf**\n\nEin hinterlistiger Dieb hat es auf deine Beute abgesehen. Schnapp ihn, bevor er mit deinen hart erarbeiteten Mineralien entkommt!\n\n\n\n{912532344844187}\n**Werde der Boss unter den Insassen**\n\nK\u00e4mpfe, sch\u00fcchtere ein oder \u00fcberliste andere Insassen. \u00dcbernimm optionale Quests, die deine Flucht unterst\u00fctzen \u2014 oder alles deutlich gef\u00e4hrlicher machen.\n\n\n\n\n\n", "short_description": "Schnapp dir deine Schaufel und grabe dich in die Freiheit!\n\u00dcberliste die W\u00e4chter, pr\u00fcgle dich mit Mitgefangenen und meistere verr\u00fcckte Quests, w\u00e4hrend du dich durch ein chaotisches VR-Gef\u00e4ngnisausbruch-Abenteuer gr\u00e4bst."}, {"images": {"nodes": []}, "id": "1589248499493008", "locale": "ru_RU", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["\u0442\u044e\u0440\u044c\u043c\u0430", "\u043f\u043e\u0431\u0435\u0433", "\u043a\u043e\u043f\u0430\u0442\u044c", "\u044f\u043c\u0430", "\u0441\u0438\u043c\u0443\u043b\u044f\u0442\u043e\u0440"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# \u041a\u043e\u043f\u0430\u0439, \u0447\u0442\u043e\u0431\u044b \u0441\u0431\u0435\u0436\u0430\u0442\u044c\n\n**\u0412\u043e\u0437\u044c\u043c\u0438\u0442\u0435 \u043b\u043e\u043f\u0430\u0442\u0443 \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u0439\u0442\u0435 \u043a\u043e\u043f\u0430\u0442\u044c!**  \n\n\u041a\u043e\u043f\u0430\u0439, \u0447\u0442\u043e\u0431\u044b \u0441\u0431\u0435\u0436\u0430\u0442\u044c \u2014 \u044d\u0442\u043e \u0441\u0442\u0438\u043b\u0438\u0437\u043e\u0432\u0430\u043d\u043d\u0430\u044f VR-\u0438\u0433\u0440\u0430 \u043f\u0440\u043e \u043f\u043e\u0431\u0435\u0433 \u0438\u0437 \u0442\u044e\u0440\u044c\u043c\u044b, \u0433\u0434\u0435 \u0432\u044b \u043a\u043e\u043f\u0430\u0435\u0442\u0435, \u0432\u044b\u0436\u0438\u0432\u0430\u0435\u0442\u0435 \u0438 \u043f\u0435\u0440\u0435\u0445\u0438\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0435 \u043a\u0440\u043e\u0442\u0430, \u0447\u0442\u043e\u0431\u044b \u0441\u0431\u0435\u0436\u0430\u0442\u044c.\n\n{2842689259414941}\n**\u041a\u043e\u043f\u0430\u0439\u0442\u0435 \u0434\u043b\u044f \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u0439**\n\n\u0414\u043e\u0431\u044b\u0432\u0430\u0439\u0442\u0435 \u0446\u0435\u043d\u043d\u044b\u0435 \u043c\u0438\u043d\u0435\u0440\u0430\u043b\u044b \u0438 \u043f\u0440\u043e\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0438\u0445, \u0447\u0442\u043e\u0431\u044b \u0443\u043b\u0443\u0447\u0448\u0438\u0442\u044c \u0441\u0432\u043e\u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b. \u041b\u0443\u0447\u0448\u0435\u0435 \u0441\u043d\u0430\u0440\u044f\u0436\u0435\u043d\u0438\u0435 \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u0431\u043e\u043b\u0435\u0435 \u0431\u044b\u0441\u0442\u0440\u043e\u0435 \u043a\u043e\u043f\u0430\u043d\u0438\u0435, \u0431\u043e\u043b\u0435\u0435 \u0433\u043b\u0443\u0431\u043e\u043a\u0438\u0435 \u0442\u0443\u043d\u043d\u0435\u043b\u0438 \u0438 \u0431\u043e\u043b\u044c\u0448\u0435 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 \u0434\u043b\u044f \u043f\u043e\u0431\u0435\u0433\u0430.\n\n\n{798885056564342}\n**\u041e\u0441\u0442\u0435\u0440\u0435\u0433\u0430\u0439\u0442\u0435\u0441\u044c \u043a\u0440\u043e\u0442\u0430**\n\n\u0425\u0438\u0442\u0440\u044b\u0439 \u0432\u043e\u0440 \u043f\u043e\u0441\u043b\u0435 \u0432\u0430\u0448\u0435\u0439 \u0434\u043e\u0431\u044b\u0447\u0438. \u041f\u043e\u0439\u043c\u0430\u0439\u0442\u0435 \u0435\u0433\u043e, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043e\u043d \u0443\u0442\u0430\u0449\u0438\u0442 \u0432\u0430\u0448\u0438 \u0442\u044f\u0436\u0435\u043b\u043e \u0437\u0430\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0435 \u043c\u0438\u043d\u0435\u0440\u0430\u043b\u044b!\n\n\n{2334285103750404}\n**\u0421\u0442\u0430\u043d\u044c\u0442\u0435 \u0433\u043b\u0430\u0432\u043d\u044b\u043c \u0437\u0430\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u044b\u043c**\n\n\u0414\u0440\u0430\u043a\u0438, \u0437\u0430\u043f\u0443\u0433\u0438\u0432\u0430\u043d\u0438\u0435 \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0445\u0438\u0442\u0440\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u0438\u0445 \u0437\u0430\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u044b\u0445. \u0412\u044b\u043f\u043e\u043b\u043d\u044f\u0439\u0442\u0435 \u043d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0433\u0443\u0442 \u043f\u043e\u043c\u043e\u0447\u044c \u0432\u0430\u043c \u0441\u0431\u0435\u0436\u0430\u0442\u044c \u2014 \u0438\u043b\u0438 \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0432\u0441\u0451 \u0433\u043e\u0440\u0430\u0437\u0434\u043e \u043e\u043f\u0430\u0441\u043d\u0435\u0435.\n\n\n", "short_description": "\u0412\u043e\u0437\u044c\u043c\u0438\u0442\u0435 \u043b\u043e\u043f\u0430\u0442\u0443 \u0438 \u043f\u0440\u043e\u043b\u043e\u0436\u0438\u0442\u0435 \u043f\u0443\u0442\u044c \u043a \u0441\u0432\u043e\u0431\u043e\u0434\u0435! \u041f\u0435\u0440\u0435\u0445\u0438\u0442\u0440\u0438\u0442\u0435 \u043e\u0445\u0440\u0430\u043d\u0443, \u0434\u0430\u0439\u0442\u0435 \u043e\u0442\u043f\u043e\u0440 \u0437\u0430\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u044b\u043c \u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0439\u0442\u0435 \u0441\u0443\u043c\u0430\u0441\u0448\u0435\u0434\u0448\u0438\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u044f, \u043f\u0440\u043e\u043a\u043b\u0430\u0434\u044b\u0432\u0430\u044f \u0442\u0443\u043d\u043d\u0435\u043b\u044c \u0447\u0435\u0440\u0435\u0437 \u0445\u0430\u043e\u0442\u0438\u0447\u043d\u043e\u0435 VR-\u043f\u043e\u0431\u0435\u0433 \u0438\u0437 \u0442\u044e\u0440\u044c\u043c\u044b."}, {"images": {"nodes": []}, "id": "1515198509759641", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["\uac10\uc625", "\ud0c8\ucd9c", "\ud30c\ub2e4", "\uad6c\uba4d", "\uc2dc\ubbac\ub808\uc774\ud130"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# \ud0c8\ucd9c\uc744 \ud5a5\ud574 \ud30c\ub77c\n\n**\uc0bd\uc744 \ub4e4\uace0 \ub545\uc744 \ud30c\uae30 \uc2dc\uc791\ud558\ub77c!**  \n\n\ud0c8\ucd9c\uc744 \ud5a5\ud574 \ud30c\ub77c\ub294 \uc2a4\ud0c0\uc77c\ub9ac\uc2dc\ud55c VR \ud0c8\uc625 \uac8c\uc784\uc73c\ub85c, \ub545\uc744 \ud30c\uace0, \uc0dd\uc874\ud558\uba70, \ub450\ub354\uc9c0\ub97c \uc18d\uc5ec \ud0c8\ucd9c\ud558\ub294 \uac8c\uc784\uc785\ub2c8\ub2e4.\n\n{2252759775132353}\n**\uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc704\ud574 \ud30c\ub77c**\n\n\uadc0\uc911\ud55c \uad11\ubb3c\uc744 \ucc44\uad74\ud558\uace0 \ud310\ub9e4\ud558\uc5ec \ub3c4\uad6c\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \ub354 \uc88b\uc740 \uc7a5\ube44\ub294 \ub354 \ube60\ub978 \uad74\ucc29, \ub354 \uae4a\uc740 \ud130\ub110, \uadf8\ub9ac\uace0 \ub354 \ub9ce\uc740 \ud0c8\ucd9c \uc635\uc158\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n\n{1280652240597785}\n**\ub450\ub354\uc9c0\ub97c \uc870\uc2ec\ud558\ub77c**\n\n\uad50\ud65c\ud55c \ub3c4\ub451\uc774 \ub2f9\uc2e0\uc758 \uc804\ub9ac\ud488\uc744 \ub178\ub9bd\ub2c8\ub2e4. \uc5f4\uc2ec\ud788 \ubaa8\uc740 \uad11\ubb3c\uc744 \ud6d4\uce58\uae30 \uc804\uc5d0 \uc7a1\uc73c\uc138\uc694!\n\n\n{1451714646670473}\n**\uc8c4\uc218 \ubcf4\uc2a4\uac00 \ub418\uc5b4\ub77c**\n\n\ub2e4\ub978 \uc8c4\uc218\ub4e4\uacfc \uc2f8\uc6b0\uace0, \uc704\ud611\ud558\uace0, \ub610\ub294 \uc18d\uc774\uc138\uc694. \uc120\ud0dd \ud018\uc2a4\ud2b8\ub97c \uc218\ud589\ud558\uc5ec \ud0c8\ucd9c\uc744 \ub3d5\uac70\ub098, \uc0c1\ud669\uc744 \ud6e8\uc52c \ub354 \uc704\ud5d8\ud558\uac8c \ub9cc\ub4e4 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4.\n\n\n", "short_description": "\uc0bd\uc744 \ub4e4\uace0 \uc790\uc720\ub97c \ud5a5\ud574 \ub545\uc744 \ud30c\ub77c! \uacbd\ube44\ubcd1\uc744 \uc18d\uc774\uace0, \uc8c4\uc218\ub4e4\uacfc \uc2f8\uc6b0\uba70, \uc5c9\ub6b1\ud55c \ud018\uc2a4\ud2b8\ub97c \uc218\ud589\ud558\uba70 \ud63c\ub3c8\uc758 VR \ud0c8\uc625 \ubaa8\ud5d8\uc744 \ub6ab\uace0 \ub098\uac00\ub77c."}, {"images": {"nodes": []}, "id": "1008709522160210", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["prisi\u00f3n", "escape", "cavar", "agujero", "simulador"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# Cava para escapar\n\n**\u00a1Toma tu pala y empieza a cavar!**  \n\nCava para escapar es un juego estilizado de fuga de prisi\u00f3n en VR donde cavas, sobrevives y enga\u00f1as al topo para escapar.\n\n{910750908253377}\n**Cava para mejorar**\n\nExtrae minerales valiosos y v\u00e9ndelos para mejorar tus herramientas. Mejor equipo significa cavar m\u00e1s r\u00e1pido, t\u00faneles m\u00e1s profundos y m\u00e1s opciones de escape.\n\n\n{1470513174687425}\n**Cuidado con el topo**\n\nUn ladr\u00f3n astuto va tras tu bot\u00edn. \u00a1Atr\u00e1palo antes de que se lleve tus minerales duramente ganados!\n\n\n{1920504108556875}\n**Convi\u00e9rtete en el jefe de los presos**\n\nPelea, intimida o enga\u00f1a a otros presos. Realiza misiones opcionales que pueden ayudarte a escapar \u2014 o hacer las cosas mucho m\u00e1s peligrosas.\n\n\n", "short_description": "\u00a1Toma tu pala y cava tu camino hacia la libertad! Enga\u00f1a a los guardias, pelea con los reclusos y enfr\u00e9ntate a misiones disparatadas mientras excavas t\u00faneles en esta ca\u00f3tica aventura de fuga de prisi\u00f3n en VR."}]}, "developer_name": "K&K Studio", "developer_privacy_policy_url": "https://knk-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "K&K Studio", "support_website_url": null, "website_url": "https://knk-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ru", "ja", "zh_CN", "ko", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27843424815347404"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823905_1363141435961314_8447327157172335402_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rd1BX7d3m6YQ7kNvwGN5PK5&_nc_oc=AdqpypOgqhI0zY1xswi9Z5vLEJ-mpsUPhiJIjomwvM1Jh0D0FqKqrync_6ZKy974-pc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvFScCSqUWKwWPgjz-8FUlNSF235umSR10P1Zsus2SaQ&oe=6AA15FB9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dig To Escape", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1766826000, "lastRevision": {"nodes": [{"id": "24491705887185997", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24491705840519335", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2874604362736422"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "portrait.png", "id": "4445341382412177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819356_4445341385745510_4536041713598403427_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KlVRCLlGBYcQ7kNvwGKq-zD&_nc_oc=AdrPp80T95ElL8KTHsuhh-TLusxB0Hdqh5u6n8XoGXSxq3HuZg8gq1W3-7n94rA9qu4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5mW_ZMcXOG6vMrK4Td1gzP47QrGsfs4D3-O3mb2kuMA&oe=6AA15A4C"}, {"file_name": "logo.png", "id"
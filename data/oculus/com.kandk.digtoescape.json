.5771-25/491824665_1869324947106922_1341569722763222754_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXWu_ax6OzgQ7kNvwGRBMPe&_nc_oc=Adoq__jjg-9ZR7nzJY0LfBb6eoqTs-5HRz4PrsW8OFzZWSgHzxy7te4h3w1N6oYvEXY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLulfTAknq8z7PC98RiwvMZ_F9vCT4zfZPPBFGWXW2DVw&oe=6AAAB6E3"}, {"file_name": "4.png", "id": "966536092992263", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823270_966536099658929_7065836735143718708_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KKLBkRQzRiIQ7kNvwHU0AiX&_nc_oc=AdoUynmkKKqUrx1KvoV4xMVA_W_4wcJjR0V-LkVmIlIxemmhofn9AEKlmc37JR_OrE4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLR0j8aaHCOR-sRYIpkv_V_xx0-Z1YJzpaBPe8v5Pdiow&oe=6AAAA70B"}, {"file_name": "screenshot_44_20251202-131523.png", "id": "853472417082939", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_853472423749605_6621515077070126422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBMe-YpjXh0Q7kNvwGKzo--&_nc_oc=Adqlp32KaBpzHiZ1t9sCYEVfKOr8SXJ-lMo0nG5y_rvfPfeYGU--eStK0NbF8chLcs8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZJKPtD2GzI9prDJ8vHHxBLe2fIVZBzK1sZGX0iLboPA&oe=6AAAAA52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "28748537168117541", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312338_28748537178117540_48666039729433215_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jePdbnhQ9QIQ7kNvwHhfd2L&_nc_oc=AdpRWxzrSUdoPWzycW1isOfVpqw5DtXDA9wNKXiwERcn77LFWO4OXkHx0a38BFkOxlA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaK-6zmHZCIbd-BcXR-MBtkldw9VT9g0GEp2DuSjbI1g&oe=6AAA9D41"}, "display_name": "Dig To Escape", "keywords": ["Prison", "Escape", "Dig", "Hole", "simulator"], "long_description": "#                                                                                                                                                                                                       \n\n# Dig to Escape\n\n**Grab your shovel and get digging!**  \n\nDig to Escape is a stylized VR prison-break game where you dig, survive, and outsmart the mole to escape.\n\n{2046789639497740}\n**Dig for upgrades**\n\nMine valuable minerals and sell them to upgrade your tools. Better gear means faster digging, deeper tunnels, and more escape options.\n\n\n{1547839482800416}\n**Watch out for the mole**\n\nA sneaky thief is after your loot. Catch him before he makes off with your hard-earned minerals!\n\n\n\n{1551401099280034}\n**Be the inmate boss**\n\nBrawl, intimidate, or outsmart other inmates. Take on optional quests that can help your escape\u2014or make things much more dangerous.\n", "short_description": "Grab your shovel and dig your way to freedom!\nOutsmart guards, brawl with inmates, and tackle wacky quests as you tunnel through a chaotic VR prison break adventure."}, {"images": {"nodes": []}, "id": "1564811224567215", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["\uac10\uc625", "\ud0c8\ucd9c", "\ud30c\ub2e4", "\uad6c\uba4d", "\uc2dc\ubbac\ub808\uc774\ud130"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# \ud0c8\ucd9c\uc744 \ud5a5\ud574 \ud30c\ub77c\n\n**\uc0bd\uc744 \ub4e4\uace0 \ub545\uc744 \ud30c\uae30 \uc2dc\uc791\ud558\ub77c!**  \n\n\ud0c8\ucd9c\uc744 \ud5a5\ud574 \ud30c\ub77c\ub294 \uc2a4\ud0c0\uc77c\ub9ac\uc2dc\ud55c VR \ud0c8\uc625 \uac8c\uc784\uc73c\ub85c, \ub545\uc744 \ud30c\uace0, \uc0dd\uc874\ud558\uba70, \ub450\ub354\uc9c0\ub97c \uc18d\uc5ec \ud0c8\ucd9c\ud558\ub294 \uac8c\uc784\uc785\ub2c8\ub2e4.\n\n{2252759775132353}\n**\uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc704\ud574 \ud30c\ub77c**\n\n\uadc0\uc911\ud55c \uad11\ubb3c\uc744 \ucc44\uad74\ud558\uace0 \ud310\ub9e4\ud558\uc5ec \ub3c4\uad6c\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \ub354 \uc88b\uc740 \uc7a5\ube44\ub294 \ub354 \ube60\ub978 \uad74\ucc29, \ub354 \uae4a\uc740 \ud130\ub110, \uadf8\ub9ac\uace0 \ub354 \ub9ce\uc740 \ud0c8\ucd9c \uc635\uc158\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n\n{1280652240597785}\n**\ub450\ub354\uc9c0\ub97c \uc870\uc2ec\ud558\ub77c**\n\n\uad50\ud65c\ud55c \ub3c4\ub451\uc774 \ub2f9\uc2e0\uc758 \uc804\ub9ac\ud488\uc744 \ub178\ub9bd\ub2c8\ub2e4. \uc5f4\uc2ec\ud788 \ubaa8\uc740 \uad11\ubb3c\uc744 \ud6d4\uce58\uae30 \uc804\uc5d0 \uc7a1\uc73c\uc138\uc694!\n\n\n{1451714646670473}\n**\uc8c4\uc218 \ubcf4\uc2a4\uac00 \ub418\uc5b4\ub77c**\n\n\ub2e4\ub978 \uc8c4\uc218\ub4e4\uacfc \uc2f8\uc6b0\uace0, \uc704\ud611\ud558\uace0, \ub610\ub294 \uc18d\uc774\uc138\uc694. \uc120\ud0dd \ud018\uc2a4\ud2b8\ub97c \uc218\ud589\ud558\uc5ec \ud0c8\ucd9c\uc744 \ub3d5\uac70\ub098, \uc0c1\ud669\uc744 \ud6e8\uc52c \ub354 \uc704\ud5d8\ud558\uac8c \ub9cc\ub4e4 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4.\n\n\n", "short_description": "\uc0bd\uc744 \ub4e4\uace0 \uc790\uc720\ub97c \ud5a5\ud574 \ub545\uc744 \ud30c\ub77c! \uacbd\ube44\ubcd1\uc744 \uc18d\uc774\uace0, \uc8c4\uc218\ub4e4\uacfc \uc2f8\uc6b0\uba70, \uc5c9\ub6b1\ud55c \ud018\uc2a4\ud2b8\ub97c \uc218\ud589\ud558\uba70 \ud63c\ub3c8\uc758 VR \ud0c8\uc625 \ubaa8\ud5d8\uc744 \ub6ab\uace0 \ub098\uac00\ub77c."}, {"images": {"nodes": []}, "id": "1154841377111723", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["Gef\u00e4ngnis", "Ausbruch", "graben", "Loch", "Simulator"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# Dig to Escape\n\n**Schnapp dir deine Schaufel und fang an zu graben!**  \n\nDig to Escape ist ein stilisiertes VR-Gef\u00e4ngnisausbruchsspiel, in dem du gr\u00e4bst, \u00fcberlebst und den Maulwurf \u00fcberlistest, um zu entkommen.\n\n{1237325348507167}\n**Grabe nach Upgrades**\n\nBaue wertvolle Mineralien ab und verkaufe sie, um deine Werkzeuge zu verbessern. Bessere Ausr\u00fcstung bedeutet schnelleres Graben, tiefere Tunnel und mehr Fluchtm\u00f6glichkeiten.\n\n\n{25994835953478522}\n**Pass auf den Maulwurf auf**\n\nEin hinterlistiger Dieb hat es auf deine Beute abgesehen. Schnapp ihn, bevor er mit deinen hart erarbeiteten Mineralien entkommt!\n\n\n\n{912532344844187}\n**Werde der Boss unter den Insassen**\n\nK\u00e4mpfe, sch\u00fcchtere ein oder \u00fcberliste andere Insassen. \u00dcbernimm optionale Quests, die deine Flucht unterst\u00fctzen \u2014 oder alles deutlich gef\u00e4hrlicher machen.\n\n\n\n\n\n", "short_description": "Schnapp dir deine Schaufel und grabe dich in die Freiheit!\n\u00dcberliste die W\u00e4chter, pr\u00fcgle dich mit Mitgefangenen und meistere verr\u00fcckte Quests, w\u00e4hrend du dich durch ein chaotisches VR-Gef\u00e4ngnisausbruch-Abenteuer gr\u00e4bst."}, {"images": {"nodes": []}, "id": "1068212665938014", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["\u76d1\u72f1", "\u9003\u8131", "\u6316", "\u6d1e", "\u6a21\u62df\u5668"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# \u6316\u51fa\u9003\u751f\u8def\n\n**\u62ff\u8d77\u4f60\u7684\u94f2\u5b50\uff0c\u5f00\u59cb\u6316\u6398\u5427\uff01**  \n\n\u6316\u51fa\u9003\u751f\u8def\u662f\u4e00\u6b3e\u98ce\u683c\u5316\u7684VR\u8d8a\u72f1\u6e38\u620f\uff0c\u5728\u8fd9\u91cc\u4f60\u9700\u8981\u6316\u6398\u3001\u751f\u5b58\uff0c\u5e76\u667a\u80dc\u201c\u9f39\u9f20\u201d\u4ee5\u9003\u8131\u3002\n\n{1228813532185699}\n**\u6316\u6398\u4ee5\u5347\u7ea7**\n\n\u5f00\u91c7\u73cd\u8d35\u77ff\u7269\u5e76\u51fa\u552e\uff0c\u7528\u4e8e\u5347\u7ea7\u4f60\u7684\u5de5\u5177\u3002\u66f4\u597d\u7684\u88c5\u5907\u610f\u5473\u7740\u66f4\u5feb\u7684\u6316\u6398\u3001\u66f4\u6df1\u7684\u96a7\u9053\uff0c\u4ee5\u53ca\u66f4\u591a\u7684\u9003\u8131\u9009\u9879\u3002\n\n\n{961778742955503}\n**\u5c0f\u5fc3\u201c\u9f39\u9f20\u201d**\n\n\u72e1\u733e\u7684\u5c0f\u5077\u76ef\u4e0a\u4e86\u4f60\u7684\u6218\u5229\u54c1\u3002\u5728\u4ed6\u5077\u8d70\u4f60\u8f9b\u82e6\u83b7\u5f97\u7684\u77ff\u7269\u4e4b\u524d\u6293\u4f4f\u4ed6\uff01\n\n\n{2085378488911800}\n**\u6210\u4e3a\u56da\u72af\u8001\u5927**\n\n\u4e0e\u5176\u4ed6\u56da\u72af\u6253\u6597\u3001\u5a01\u80c1\u6216\u667a\u80dc\u4ed6\u4eec\u3002\u63a5\u53d7\u53ef\u9009\u4efb\u52a1\uff0c\u8fd9\u4e9b\u4efb\u52a1\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9003\u8131\u2014\u2014\u4e5f\u53ef\u80fd\u8ba9\u4e8b\u60c5\u53d8\u5f97\u66f4\u52a0\u5371\u9669\u3002\n\n\n", "short_description": "\u62ff\u8d77\u4f60\u7684\u94f2\u5b50\uff0c\u6316\u51fa\u901a\u5f80\u81ea\u7531\u7684\u9053\u8def\uff01\u667a\u80dc\u8b66\u536b\uff0c\u4e0e\u56da\u72af\u6df7\u6218\uff0c\u5e76\u5728\u6df7\u4e71\u7684VR\u8d8a\u72f1\u5192\u9669\u4e2d\u5b8c\u6210\u5404\u79cd\u75af\u72c2\u4efb\u52a1\u3002"}, {"images": {"nodes": []}, "id": "1052173547418038", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["prisi\u00f3n", "escape", "cavar", "agujero", "simulador"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# Cava para escapar\n\n**\u00a1Toma tu pala y empieza a cavar!**  \n\nCava para escapar es un juego estilizado de fuga de prisi\u00f3n en VR donde cavas, sobrevives y enga\u00f1as al topo para escapar.\n\n{910750908253377}\n**Cava para mejorar**\n\nExtrae minerales valiosos y v\u00e9ndelos para mejorar tus herramientas. Mejor equipo significa cavar m\u00e1s r\u00e1pido, t\u00faneles m\u00e1s profundos y m\u00e1s opciones de escape.\n\n\n{1470513174687425}\n**Cuidado con el topo**\n\nUn ladr\u00f3n astuto va tras tu bot\u00edn. \u00a1Atr\u00e1palo antes de que se lleve tus minerales duramente ganados!\n\n\n{1920504108556875}\n**Convi\u00e9rtete en el jefe de los presos**\n\nPelea, intimida o enga\u00f1a a otros presos. Realiza misiones opcionales que pueden ayudarte a escapar \u2014 o hacer las cosas mucho m\u00e1s peligrosas.\n\n\n", "short_description": "\u00a1Toma tu pala y cava tu camino hacia la libertad! Enga\u00f1a a los guardias, pelea con los reclusos y enfr\u00e9ntate a misiones disparatadas mientras excavas t\u00faneles en esta ca\u00f3tica aventura de fuga de prisi\u00f3n en VR."}]}, "developer_name": "K&K Studio", "developer_privacy_policy_url": "https://knk-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "K&K Studio", "support_website_url": null, "website_url": "https://knk-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "es", "ru", "ja", "zh_CN", "ko", "de"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28431742633182283"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312263_1694903449307446_1605783394746169597_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKJQzuHON7oQ7kNvwHm5n_0&_nc_oc=Ado8ZA-jR30wuQqFdRDZqI5K4i9sPmWCSL8oCCfRR_X2mP92-wgNYf-D_ZDphu16U7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaUpFexeLYQQ4T0SipT6aVH1UsMcqk3CgU2wNHPQHuPQ&oe=6AAAA491"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dig To Escape", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1766826000, "lastRevision": {"nodes": [{"id": "24491705887185997", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24491705840519335", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2874604362736422"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": [{"file_name": "portrait.png", "id": "4445341382412177", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819356_4445341385745510_4536041713598403427_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xkvXYQJu2PUQ7kNvwGekUYg&_nc_oc=AdoVztylvPOUffkLZhQuh82qmdaMBOugyCxQrt-Mpq16lUM3nhSFv-Yxt-mJ7vAahZM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrtWTm2ydCuTpfu2CtkLRkSpphBpuzTtPG4ODhGfZ4nQ&oe=6AAA94CC"}, {"file_name": "logo.png", "id": "1961118957799513", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827626_1961118971132845_8512616718470224276_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2buKud3CP8gQ7kNvwEikMXR&_nc_oc=Adq8O_yHud4-gTHB_s93uqdcva386jkEG5s-LfaW-reD-tZkYsom_IHK-kC1pOogTkk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIodriWmx5RX9xXyyFcpIwZqaL6ulT_j4p0_gKHfzkpKw&oe=6AAA97C5"}, {"file_name": "square.png", "id": "1376654530787945", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1376654534121278_3237220077780505607_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0t-d79mM9rAQ7kNvwG0UNsJ&_nc_oc=Adr5fs87r7eHlfpvFjEKFislnIhvCU0zfQ0I2VDMw3e5qRO2rX2_mhCF9K4hP8dr5Yc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiyYsnZq3F5R_DJgyB1DSPuCSxiGUmhwNYyS_DxeD9ug&oe=6AAAB422"}, {"file_name": "landscape.png", "id": "1364306398678718", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1364306405345384_3839751309183669377_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gFAkc49PkgQ7kNvwFbIAZ8&_nc_oc=AdrkvqvGOdpYrgjDC_gGGR4xsDE5LyDVgJyPNLIHxsZdMTbpgrbLJFbpwYW-4ApLmJo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfSygbISmfREi5mjqkwObQWY9J_l9t6iEDKUb2pzd6gA&oe=6AAA8805"}, {"file_name": "icon.png", "id": "852648874014539", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819281_852648877347872_8146081087447431756_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKgFZAcZNAEQ7kNvwGGaqz7&_nc_oc=AdpBsqycEPu2H0IGgTYZpGKGeU3gI7RW4F7-D6P3SXpPy8m3ZbK0tEELorkYIEqqrvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2TpHoB1o4KyUVWfvDoZuXzSY4FJtYexPDRB_IH_MkoA&oe=6AAA8573"}, {"file_name": "hero cover.png", "id": "842004081768883", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/4918233
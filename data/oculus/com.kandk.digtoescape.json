3-1.oculuscdn.com/v/t64.5771-25/491822550_853472423749605_6621515077070126422_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxprN0Gx6P4Q7kNvwHpIULO&_nc_oc=Adr8AU2ZQAwZ1HuNzFl_e8lDjekDLHvAd6rXe-J_uMUDJ845wGKVJJk58slBpcwb-5s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTYwdEvi5UJMbvyR-1WBc-E_UEj1pltsF3bOwqfPwL4Q&oe=6B06F352"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1361199002222552", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821782_1361199005555885_917954452052319403_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H2Y55UCCcbkQ7kNvwG3r1qi&_nc_oc=AdrCHRaXmo8Djl1z57RN0Ux5_zVXPr4dghRb51QTLwZuV2b3aVhTJtFBjF7FNeclYSo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvOn3LOe4ZXfX1CMQW5yiPNst4QnvHXcvKUv_fFAXpqQ&oe=6B071C90"}, "display_name": "Dig To Escape", "keywords": ["Prison", "Escape", "Dig", "Jail", "Fun"], "long_description": "# Dig to Escape\n\n**Grab your shovel and get digging!**  \n\nOutsmart sneaky moles, brawl with inmates, and take on wacky quests as you tunnel your way to freedom in the wildest prison break ever!\n\n**Dig for upgrades**\n\nCollect minerals and sell them to upgrade your tools. Better gear means bigger digs and more ways to escape.\n\n{2046789639497740}\n\n**Watch out for the mole**\n\nA sneaky thief is after your loot. Catch him before he makes off with your hard-earned minerals!\n\n{1547839482800416}\n\n**Be the inmate boss**\n\nBully, outsmart, or intimidate other inmates\n\n\n\n\n{1551401099280034}", "short_description": "Grab your shovel and get digging! Outsmart sneaky moles, brawl with Inmates, and take on wacky quests as you tunnel your way to freedom in the wildest prison break ever!"}]}, "developer_name": "K&K Studio", "developer_privacy_policy_url": "https://smallpdf.com/file#s=5c5ab8e5-9c2e-4705-ad6f-3598c05f6127", "developer_terms_of_service_url": null, "publisher_name
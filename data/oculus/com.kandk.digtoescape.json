5/491823351_842004085102216_4708951305732051776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_xwpCHPrNH4Q7kNvwE1audd&_nc_oc=AdpWlWFyC6cxIz4pbkdZzKvCosbyGjp_yRDsNRA5JcbREJ7qwCqfnMtG1taZO9ULEf4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DRynh_F8PpIed3Weu8kbofIIyzPHvg_4_xqkq6ErJ_g&oe=6A395A30"}]}, "id": "886357107396844", "locale": "en_US", "screenshots": [{"file_name": "screenshot_48_20251202-131740.png", "id": "1366203291866472", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491819854_1366203298533138_764670648854347107_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH5WgpxXVq0Q7kNvwHu4TRi&_nc_oc=AdqS53BOzRL__0wKIn0RLM_aFH2xeFMXTzvO_U-pDSSyceDAk4j6Qdc1GDJQjI83CrA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8muB1KcsimCJhUFZMwpel-PJnfw5xgwh7JUOVUbqFENg&oe=6A393292"}, {"file_name": "screenshot_28_20251202-131107.png", "id": "832476453089655", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820855_832476456422988_8383551753011786379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XU3TgVcc1EQ7kNvwEmHWQp&_nc_oc=Adq7kxjf_WQnIos0IMQ7fWEQAxCtU2Tjx75X72RNe6wf8L187brsG3wbHgI6jf9ZntY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DYhzPQOXG9WgqZnAM_z2zxAapWEBhoM0xTfAHROaNLg&oe=6A392EEB"}, {"file_name": "Mole Screenshot.png", "id": "858932226686551", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491823802_858932230019884_3218205658265757273_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEXP8tTf-PoQ7kNvwGSAGhb&_nc_oc=Adq7ArsYu4Nio54M9nGgCts2qRjuy0bOu9Xv3hES9ilRq9rzb5kfkDnc2ySfPueHvxw&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YAF8D9jj2xQ0adZBpyflyK-fLLDcgUSTvXZZ40XqNHg&oe=6A395237"}, {"file_name": "screenshot_71_20251202-132218.png", "id": "4191951167799953", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491819239_4191951171133286_6008220942567939390_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SIzocaxDv9AQ7kNvwFRdfRX&_nc_oc=Adqy_QvFJRgVuhtTJd0Luw5iuKCDALc94phlLCOY7kr0Pa64sQeK5EAtQtitxlOIRng&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kvFT7cIizfOefWvm2wCwKGYp3x8ojApzbQ1BRsyCyyQ&oe=6A3931F6"}, {"file_name": "screenshot_44_20251202-131523.png", "id": "853472417082939", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822550_853472423749605_6621515077070126422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX64pc00CkkQ7kNvwHIB2Xc&_nc_oc=Adodjolgu-1VXvDnr30AvrLWLR9CFS7UBfPdlRGeYRTrysJ4mvH2KOgCbSCxJk_yiMc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TIhV49qDQwmbaBCDlIgF806scm8QjCQw-WhvS_qjLvQ&oe=6A394952"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1361199002222552", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821782_1361199005555885_917954452052319403_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lFAeiC4naPcQ7kNvwGYZOCB&_nc_oc=Adq3lImkH7KIPlDIeobiAh8qiFMAfdByhXhHbHpy7jqQL8-IhlJdBcPrdqE0g4nTiZs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AsnLf4XSicnNboa7vXYJW26FCs5eXevYwIBOfKJ5uAQ&oe=6A393A50"}, "display_name": "Dig To Escape", "keywords": ["Prison", "Escape", "Dig", "Jail", "Fun"], "long_description": "# Dig to Escape\n\n**Grab your shovel and get digging!**  \n\nOutsmart sneaky moles, brawl with inmates, and take on wacky quests as you tunnel your way to freedom in the wildest prison break ever!\n\n**Dig for upgrades**\n\nCollect minerals and sell them to upgrade your tools. Better gear means bigger digs and more ways to escape.\n\n{2046789639497740}\n\n**Watch out for the mole**\n\nA sneaky thief is after your loot. Catch him before he makes off with your hard-earned minerals!\n\n{1547839482800416}\n\n**Be the inmate boss**\n\nBully, outsmart, or intimidate other inmates\n\n\n\n\n{1551401099280034}", "short_description": "Grab your shovel and get digging! Outsmart sneaky moles, brawl with Inmates, and take on wacky quests as you tunnel your way to freedom in the wildest prison break ever!"}]}, "developer_name": "K&K Studio", "developer_privacy_policy_url": "https://smallpdf.com/file#s=5c5ab8e5-9c2e-4705-ad6f-3598c05f6127", "developer_terms_of_service_url": null, "publisher_name": "K&K Studio", "support_website_url": null, "website_url": "https://knk-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25311792385177339"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "889716413493912"}, {"status": "PUBLISHED", "id": "840047175686266"}, {"status": "PUBLISHED", "id": "3998606983603559"}, {"status": "PUBLISHED", "id": "829483523552321"}, {"status": "CANCELLED", "id": "3142049329315494"}, {"status": "CANCELLED", "id": "1473605497878109"}, {"status": "PUBLISHED", "id": "1550477966056240"}, {"status": "PUBLISHED", "id": "2125365964960870"}, {"status": "CANCELLED", "id": "1242027804444181"}, {"status": "PUBLISHED", "id": "2128099918018300"}, {"status": "PUBLISHED", "id": "25612307108395221"}]}, "baseline_offer": {"id": "25612307108395221"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784566800, "status": "PUBLISHED", "id": "3998606983603559"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26536333242723241
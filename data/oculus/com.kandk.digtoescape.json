1_842004085102216_4708951305732051776_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CYW2NeJMm8YQ7kNvwHUgkMf&_nc_oc=AdocL0v0aj-vylX7udWNsl53Fto8Ym_PNb_JD2HhdIbUX_41MShhv06OgAgAegLHS4E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81jS7FXYeqSLQGX9g9Y3ubmqUQdBHJ9i_j8G5qF1FZnQ&oe=6A2593B0"}]}, "id": "886357107396844", "locale": "en_US", "screenshots": [{"file_name": "screenshot_48_20251202-131740.png", "id": "1366203291866472", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819854_1366203298533138_764670648854347107_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CPOAzolr-8EQ7kNvwFsPRa3&_nc_oc=AdqPUE8j4Egddjl5zGtVKgdpStw7uQmVH7UiVrD6qmJBwmPFTqsHOzJcUI28sntOG2Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Cf74V7vHP001lLva_HJ_-UxF2KTahmtrW6KmbxkNDDg&oe=6A256C12"}, {"file_name": "screenshot_28_20251202-131107.png", "id": "832476453089655", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820855_832476456422988_8383551753011786379_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciSMm9Uaq4YQ7kNvwGNnQgx&_nc_oc=AdqqW0sAYForvbL8T00W737IzzEpFtx2fsK846RDiS8_kNriDyef1GokhPpfbOBuwtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9htJ7I-toS6Rm2WRd_iHNL4AbuprD2plNeBaec5Rs9Vw&oe=6A25A0AB"}, {"file_name": "Mole Screenshot.png", "id": "858932226686551", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_858932230019884_3218205658265757273_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmwnnxzadacQ7kNvwHM6bKX&_nc_oc=Adp4lezADcyr-G6t5b6JE6BwYAsFQLJPdrlpXJ7F_29P4JvzDk9b6Rd5lQ0xe-dnQfs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8W2OjB1uu8oWfvrB8kVJRMK8SuIG5Xo_OLKv37FjtFdg&oe=6A258BB7"}, {"file_name": "screenshot_71_20251202-132218.png", "id": "4191951167799953", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819239_4191951171133286_6008220942567939390_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0GvBArsUwwQ7kNvwEh-HNA&_nc_oc=Adpl3W_IBfYqm9v4wI1604lQ3HLOf8Vx_OCxTRSQ-GwCk2Fty0Z03Ja3c5qXdBRakgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Gr8h8p5YyP9xP7ft-NeeZQS-eMxhJ5UF4T1jlZ_m8mA&oe=6A25A3B6"}, {"file_name": "screenshot_44_20251202-131523.png", "id": "853472417082939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_853472423749605_6621515077070126422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2oHthh0iWzUQ7kNvwFcudEI&_nc_oc=Adrh1-hACbv_piJdg_P1id6NoC2as4wL3UwPPuaWQQDqFcQYe_G-36Pn3ibB0QgwAp4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vFxmbWDDugF4P3_-_vOMM3wzMK7Yv1XtLmIMfAOtgfA&oe=6A2582D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1361199002222552", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821782_1361199005555885_917954452052319403_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLzLCf1FeJkQ7kNvwG3prG1&_nc_oc=AdomWyl98VY0SuRjyJcGIzk9eIvKbfrMek3k6NQmFrBJbNhp-ge52AfJSmq4BY-2wdA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_admiwaEwZnpBeY-zfBHapRsaV3C4vi9XPMzVBwiDYDg&oe=6A2573D0"}, "display_name": "Dig To Escape", "keywords": ["Prison", "Escape", "Dig", "Jail", "Fun"], "long_description": "# Dig to Escape\n\n**Grab your shovel and get digging!**  \n\nOutsmart sneaky moles, brawl with inmates, and take on wacky quests as you tunnel your way to freedom in the wildest prison break ever!\n\n**Dig for upgrades**\n\nCollect minerals and sell them to upgrade your tools. Better gear means bigger digs and more ways to escape.\n\n{2046789639497740}\n\n**Watch out for the mole**\n\nA sneaky thief is after your loot. Catch him before he makes off with your hard-earned minerals!\n\n{1547839482800416}\n\n**Be the inmate boss**\n\nBully, outsmart, or intimidate other inmates\n\n\n\n\n{1551401099280034}", "short_description": "Grab your shovel and get digging! Outsmart sneaky moles, brawl with Inmates, and take on wacky quests as you tunnel yo
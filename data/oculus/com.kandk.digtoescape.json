kg1-1.oculuscdn.com/v/t64.5771-25/491821782_1361199005555885_917954452052319403_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9UWoBwVCaQMQ7kNvwHpKiLY&_nc_oc=AdnGuZx5ZJ9BFSoFV2uVSYEDtEOtlE7UHt79VF2n4WrigCxoFksSvCKg3AXBq9mJf94&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afvb0Uqt3ez_S3wwW3Snw-ApuBh5NeilE-NOlsu1sC7oKw&oe=69A19DD0"}, "display_name": "Dig To Escape", "keywords": ["Prison", "Escape", "Dig", "Jail", "Fun"], "long_description": "# Dig to Escape\n\n**Grab your shovel and get digging!**  \n\nOutsmart sneaky moles, brawl with inmates, and take on wacky quests as you tunnel your way to freedom in the wildest prison break ever!\n\n**Dig for upgrades**\n\nCollect minerals and sell them to upgrade your tools. Better gear means bigger digs and more ways to escape.\n\n{2046789639497740}\n\n**Watch out for the mole**\n\nA sneaky thief is after your loot. Catch him before he makes off with your hard-earned minerals!\n\n{1547839482800416}\n\n**Be the inmate boss**\n\nBully, outsmart, or intimidate other inmates\n\n\n\n\n{1551401099280034}", "short_description": "Grab your shovel and get digging! Outsmart sneaky moles, brawl with Inmates, and take on wacky quests as you tunnel your way to freedom in the wildest prison break ever!"}]}, "developer_name": "K&K Studio", "developer_privacy_policy_url": "https://smallpdf.com/file#s=5c5ab8e5-9c2e-4705-ad6f-3598c05f6127", "developer_terms_of_service_url": null, "publisher_name": "K&K Studio", "support_website_url": null, "website_url": "https://knk-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_process
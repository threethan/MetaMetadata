, "id": "4191951167799953", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491819239_4191951171133286_6008220942567939390_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R2sOoZ44VUQ7kNvwGzeBdI&_nc_oc=AdlLtcRaYiwuHjjIJ0IZZP9f9wZdMTQim8de7PewfgxB55iSVVaf7CM7QAwvO0iSmMU&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftVKtUrdodvQWiMHV84a7cilpwX2uK7EjM343Z_CF48sw&oe=69A19576"}, {"file_name": "screenshot_44_20251202-131523.png", "id": "853472417082939", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491822550_853472423749605_6621515077070126422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CuOpu3r2_wEQ7kNvwE0xNs4&_nc_oc=AdnnjMIkDHxrmwMBkwvXLcq_YsB9ZUf7f5L7o2_vbhzUfSDYtIy7fm_M_lMAFopd-e0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftiTNvJUaUFAYlq0MzWe2zWL-C6Fx-o_hq4e31mX_SMlQ&oe=69A1ACD2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "824307180611907", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821725_824307187278573_1515421764207143540_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKAO67egRCcQ7kNvwGvG3bX&_nc_oc=AdlTqEXzHmNWgVs9l1F7quVHgEke-qEMmJP62n3F3y35xKX0zhSuDRIkrZKu3WL5t3k&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsRgRTsLmDpf2ZMg5nuKmSeIHTWi0jJNvpNRi5HBGSzJg&oe=69A17B39"}, "display_name": "Dig To Escape", "keywords": ["Prison", "Escape", "Dig", "Hole", "simulator"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# Dig to Escape\n\n**Grab your shovel and get digging!**  \n\nDig to Escape is a stylized VR prison-break game where you dig, survive, and outsmart the mole to escape.\n\n{2046789639497740}\n**Dig for upgrades**\n\nMine valuable minerals and sell them to upgrade your tools. Better gear means faster digging, deeper tunnels, and more escape options.\n\n\n{1547839482800416}\n**Watch out for the mole**\n\nA sneaky thief is after your loot. Catch him before he makes off with your hard-earned minerals!\n\n\n\n{1551401099280034}\n**Be the inmate boss**\n\nBrawl, intimidate, or outsmart other inmates. Take on optional quests that can help your escape\u2014or make things much more dangerous.\n", "short_description": "Grab your shovel and dig your way to freedom!\nOutsmart guards, brawl with inmates, and tackle wacky quests as you tunnel through a chaotic VR prison break adventure."}]}, "developer_name": "K&K Studio", "developer_privacy_policy_url": "https://knk-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "K&K Studio", "support_website_url": null, "website_url": "https://knk-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25729399156749991"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491825050_1573921147292844_5059665208820809675_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Omotcyn3tL4Q7kNvwGH6bZX&_nc_oc=AdnLJ9g6QZxe6RYUHdB06A9JSIbcOyDzH5V2R0RLrZ5BTZzuYvZBqJywoHmImGgCwWQ&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuvHXlgYU_DLEwxQVQzgE_HG-QRL
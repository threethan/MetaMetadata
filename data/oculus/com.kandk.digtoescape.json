oe-xwBwkhrRJFP8utSqajP-DFiDJCNNWlP6afCipXYsl7fFJivv-Od4a8KKxgHir8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9xc2BJclmVQPDunlcVDvI9LYguudHQ739JGwONONNkQ&oe=6AAA92F6"}, {"file_name": "screenshot_44_20251202-131523.png", "id": "853472417082939", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822550_853472423749605_6621515077070126422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBMe-YpjXh0Q7kNvwGKzo--&_nc_oc=Adqlp32KaBpzHiZ1t9sCYEVfKOr8SXJ-lMo0nG5y_rvfPfeYGU--eStK0NbF8chLcs8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZJKPtD2GzI9prDJ8vHHxBLe2fIVZBzK1sZGX0iLboPA&oe=6AAAAA52"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1361199002222552", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821782_1361199005555885_917954452052319403_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p8ni2QoImmMQ7kNvwEtaoC-&_nc_oc=AdpaX_cVP_DEUeMkWx8hz6IQoYY6aSpZ86prb0HPUPtevFDvyLOpoViU_Wc3oaLrEbc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKiiJCgF2nWoZE4nema02GxdSgditzSL_ZG7rvyDjejQg&oe=6AAA9B50"}, "display_name": "Dig To Escape", "keywords": ["Prison", "Escape", "Dig", "Jail", "Fun"], "long_description": "# Dig to Escape\n\n**Grab your shovel and get digging!**  \n\nOutsmart sneaky moles, brawl with inmates, and take on wacky quests as you tunnel your way to freedom in the wildest prison break ever!\n\n**Dig for upgrades**\n\nCollect minerals and sell them to upgrade your tools. Better gear means bigger digs and more ways to escape.\n\n{2046789639497740}\n\n**Watch out for the mole**\n\nA sneaky thief is after your loot. Catch him before he makes off with your hard-earned minerals!\n\n{1547839482800416}\n\n**Be the inmate boss**\n\nBully, outsmart, or intimidate other inmates\n\n\n\n\n{1551401099280034}", "short_description": "Grab your shovel and get digging! Outsmart sneaky moles, brawl with Inmates, and take on wacky quests as you tunnel y
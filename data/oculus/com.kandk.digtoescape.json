{"data": {"node": {"__typename": "Application", "id": "24491705840519335", "organization": {"id": "2009069909547287", "viewer_permissions": [], "application_groupings": {"nodes": [{"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "7891807644259156"}]}, "id": "1260980321504546"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "25642737555351555"}]}, "id": "790680660686165"}, {"viewer_has_update_access": false, "full_applications": {"nodes": [{"id": "24491705840519335"}]}, "id": "1105814481180458"}]}}, "firstRevision": {"nodes": [{"application": {"id": "24491705840519335", "release_date": 1766826000, "is_concept": false, "platform": "ANDROID_6DOF", "scheduled_offers": {"count": 7}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26077077381982165"}, "id": "771088165785055"}]}}, "binary": {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24491705840519335", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26077077381982165"}, "release_status": "RELEASED"}, "id": "26077077381982165", "version": "1.02", "version_code": 16, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1772139339, "id": "26074263812263522", "is_initial_release": false, "name_with_fallback": "v9", "pdp_metadata_with_fallback": {"version": 5, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "26074657642224139"}, "release_status": "RELEASED", "id": "24491705840519335"}, "id": "26074657642224139", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24491705840519335", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "2874604362736422"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "26303368432591489", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["\uac10\uc625", "\ud0c8\ucd9c", "\ud30c\ub2e4", "\uad6c\uba4d", "\uc2dc\ubbac\ub808\uc774\ud130"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# \ud0c8\ucd9c\uc744 \ud5a5\ud574 \ud30c\ub77c\n\n**\uc0bd\uc744 \ub4e4\uace0 \ub545\uc744 \ud30c\uae30 \uc2dc\uc791\ud558\ub77c!**  \n\n\ud0c8\ucd9c\uc744 \ud5a5\ud574 \ud30c\ub77c\ub294 \uc2a4\ud0c0\uc77c\ub9ac\uc2dc\ud55c VR \ud0c8\uc625 \uac8c\uc784\uc73c\ub85c, \ub545\uc744 \ud30c\uace0, \uc0dd\uc874\ud558\uba70, \ub450\ub354\uc9c0\ub97c \uc18d\uc5ec \ud0c8\ucd9c\ud558\ub294 \uac8c\uc784\uc785\ub2c8\ub2e4.\n\n{2252759775132353}\n**\uc5c5\uadf8\ub808\uc774\ub4dc\ub97c \uc704\ud574 \ud30c\ub77c**\n\n\uadc0\uc911\ud55c \uad11\ubb3c\uc744 \ucc44\uad74\ud558\uace0 \ud310\ub9e4\ud558\uc5ec \ub3c4\uad6c\ub97c \uc5c5\uadf8\ub808\uc774\ub4dc\ud558\uc138\uc694. \ub354 \uc88b\uc740 \uc7a5\ube44\ub294 \ub354 \ube60\ub978 \uad74\ucc29, \ub354 \uae4a\uc740 \ud130\ub110, \uadf8\ub9ac\uace0 \ub354 \ub9ce\uc740 \ud0c8\ucd9c \uc635\uc158\uc744 \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n\n{1280652240597785}\n**\ub450\ub354\uc9c0\ub97c \uc870\uc2ec\ud558\ub77c**\n\n\uad50\ud65c\ud55c \ub3c4\ub451\uc774 \ub2f9\uc2e0\uc758 \uc804\ub9ac\ud488\uc744 \ub178\ub9bd\ub2c8\ub2e4. \uc5f4\uc2ec\ud788 \ubaa8\uc740 \uad11\ubb3c\uc744 \ud6d4\uce58\uae30 \uc804\uc5d0 \uc7a1\uc73c\uc138\uc694!\n\n\n{1451714646670473}\n**\uc8c4\uc218 \ubcf4\uc2a4\uac00 \ub418\uc5b4\ub77c**\n\n\ub2e4\ub978 \uc8c4\uc218\ub4e4\uacfc \uc2f8\uc6b0\uace0, \uc704\ud611\ud558\uace0, \ub610\ub294 \uc18d\uc774\uc138\uc694. \uc120\ud0dd \ud018\uc2a4\ud2b8\ub97c \uc218\ud589\ud558\uc5ec \ud0c8\ucd9c\uc744 \ub3d5\uac70\ub098, \uc0c1\ud669\uc744 \ud6e8\uc52c \ub354 \uc704\ud5d8\ud558\uac8c \ub9cc\ub4e4 \uc218\ub3c4 \uc788\uc2b5\ub2c8\ub2e4.\n\n\n", "short_description": "\uc0bd\uc744 \ub4e4\uace0 \uc790\uc720\ub97c \ud5a5\ud574 \ub545\uc744 \ud30c\ub77c! \uacbd\ube44\ubcd1\uc744 \uc18d\uc774\uace0, \uc8c4\uc218\ub4e4\uacfc \uc2f8\uc6b0\uba70, \uc5c9\ub6b1\ud55c \ud018\uc2a4\ud2b8\ub97c \uc218\ud589\ud558\uba70 \ud63c\ub3c8\uc758 VR \ud0c8\uc625 \ubaa8\ud5d8\uc744 \ub6ab\uace0 \ub098\uac00\ub77c."}, {"images": {"nodes": []}, "id": "3281617682018063", "locale": "zh_CN", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["\u76d1\u72f1", "\u9003\u8131", "\u6316", "\u6d1e", "\u6a21\u62df\u5668"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# \u6316\u51fa\u9003\u751f\u8def\n\n**\u62ff\u8d77\u4f60\u7684\u94f2\u5b50\uff0c\u5f00\u59cb\u6316\u6398\u5427\uff01**  \n\n\u6316\u51fa\u9003\u751f\u8def\u662f\u4e00\u6b3e\u98ce\u683c\u5316\u7684VR\u8d8a\u72f1\u6e38\u620f\uff0c\u5728\u8fd9\u91cc\u4f60\u9700\u8981\u6316\u6398\u3001\u751f\u5b58\uff0c\u5e76\u667a\u80dc\u201c\u9f39\u9f20\u201d\u4ee5\u9003\u8131\u3002\n\n{1228813532185699}\n**\u6316\u6398\u4ee5\u5347\u7ea7**\n\n\u5f00\u91c7\u73cd\u8d35\u77ff\u7269\u5e76\u51fa\u552e\uff0c\u7528\u4e8e\u5347\u7ea7\u4f60\u7684\u5de5\u5177\u3002\u66f4\u597d\u7684\u88c5\u5907\u610f\u5473\u7740\u66f4\u5feb\u7684\u6316\u6398\u3001\u66f4\u6df1\u7684\u96a7\u9053\uff0c\u4ee5\u53ca\u66f4\u591a\u7684\u9003\u8131\u9009\u9879\u3002\n\n\n{961778742955503}\n**\u5c0f\u5fc3\u201c\u9f39\u9f20\u201d**\n\n\u72e1\u733e\u7684\u5c0f\u5077\u76ef\u4e0a\u4e86\u4f60\u7684\u6218\u5229\u54c1\u3002\u5728\u4ed6\u5077\u8d70\u4f60\u8f9b\u82e6\u83b7\u5f97\u7684\u77ff\u7269\u4e4b\u524d\u6293\u4f4f\u4ed6\uff01\n\n\n{2085378488911800}\n**\u6210\u4e3a\u56da\u72af\u8001\u5927**\n\n\u4e0e\u5176\u4ed6\u56da\u72af\u6253\u6597\u3001\u5a01\u80c1\u6216\u667a\u80dc\u4ed6\u4eec\u3002\u63a5\u53d7\u53ef\u9009\u4efb\u52a1\uff0c\u8fd9\u4e9b\u4efb\u52a1\u53ef\u4ee5\u5e2e\u52a9\u4f60\u9003\u8131\u2014\u2014\u4e5f\u53ef\u80fd\u8ba9\u4e8b\u60c5\u53d8\u5f97\u66f4\u52a0\u5371\u9669\u3002\n\n\n", "short_description": "\u62ff\u8d77\u4f60\u7684\u94f2\u5b50\uff0c\u6316\u51fa\u901a\u5f80\u81ea\u7531\u7684\u9053\u8def\uff01\u667a\u80dc\u8b66\u536b\uff0c\u4e0e\u56da\u72af\u6df7\u6218\uff0c\u5e76\u5728\u6df7\u4e71\u7684VR\u8d8a\u72f1\u5192\u9669\u4e2d\u5b8c\u6210\u5404\u79cd\u75af\u72c2\u4efb\u52a1\u3002"}, {"images": {"nodes": []}, "id": "1638604150608379", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["prisi\u00f3n", "escape", "cavar", "agujero", "simulador"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# Cava para escapar\n\n**\u00a1Toma tu pala y empieza a cavar!**  \n\nCava para escapar es un juego estilizado de fuga de prisi\u00f3n en VR donde cavas, sobrevives y enga\u00f1as al topo para escapar.\n\n{910750908253377}\n**Cava para mejorar**\n\nExtrae minerales valiosos y v\u00e9ndelos para mejorar tus herramientas. Mejor equipo significa cavar m\u00e1s r\u00e1pido, t\u00faneles m\u00e1s profundos y m\u00e1s opciones de escape.\n\n\n{1470513174687425}\n**Cuidado con el topo**\n\nUn ladr\u00f3n astuto va tras tu bot\u00edn. \u00a1Atr\u00e1palo antes de que se lleve tus minerales duramente ganados!\n\n\n{1920504108556875}\n**Convi\u00e9rtete en el jefe de los presos**\n\nPelea, intimida o enga\u00f1a a otros presos. Realiza misiones opcionales que pueden ayudarte a escapar \u2014 o hacer las cosas mucho m\u00e1s peligrosas.\n\n\n", "short_description": "\u00a1Toma tu pala y cava tu camino hacia la libertad! Enga\u00f1a a los guardias, pelea con los reclusos y enfr\u00e9ntate a misiones disparatadas mientras excavas t\u00faneles en esta ca\u00f3tica aventura de fuga de prisi\u00f3n en VR."}, {"images": {"nodes": []}, "id": "1597961074821348", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dig To Escape", "keywords": ["\u5211\u52d9\u6240", "\u8131\u51fa", "\u6398\u308b", "\u7a74", "\u30b7\u30df\u30e5\u30ec\u30fc\u30bf\u30fc"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# Dig to Escape\n\n**\u30b7\u30e3\u30d9\u30eb\u3092\u624b\u306b\u53d6\u308a\u3001\u3055\u3042\u6398\u308a\u59cb\u3081\u3088\u3046\uff01**  \n\nDig to Escape \u306f\u3001\u6398\u308a\u9032\u307f\u3001\u751f\u304d\u5ef6\u3073\u3001\u30e2\u30b0\u30e9\u3092\u51fa\u3057\u629c\u3044\u3066\u8131\u51fa\u3092\u76ee\u6307\u3059\u30b9\u30bf\u30a4\u30e9\u30a4\u30ba\u3055\u308c\u305fVR\u8131\u7344\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\n{1633851911140370}\n**\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u306e\u305f\u3081\u306b\u6398\u308d\u3046**\n\n\u8cb4\u91cd\u306a\u9271\u7269\u3092\u63a1\u6398\u3057\u3066\u58f2\u5374\u3057\u3001\u30c4\u30fc\u30eb\u3092\u30a2\u30c3\u30d7\u30b0\u30ec\u30fc\u30c9\u3057\u307e\u3057\u3087\u3046\u3002\u3088\u308a\u826f\u3044\u88c5\u5099\u306f\u3001\u3088\u308a\u901f\u3044\u6398\u524a\u3001\u3088\u308a\u6df1\u3044\u30c8\u30f3\u30cd\u30eb\u3001\u305d\u3057\u3066\u591a\u304f\u306e\u8131\u51fa\u624b\u6bb5\u3092\u53ef\u80fd\u306b\u3057\u307e\u3059\u3002\n\n\n{1829605641033174}\n**\u30e2\u30b0\u30e9\u306b\u6ce8\u610f**\n\n\u305a\u308b\u8ce2\u3044\u76d7\u4eba\u304c\u3042\u306a\u305f\u306e\u6226\u5229\u54c1\u3092\u72d9\u3063\u3066\u3044\u307e\u3059\u3002\u82e6\u52b4\u3057\u3066\u96c6\u3081\u305f\u9271\u7269\u3092\u6301\u3061\u53bb\u3089\u308c\u308b\u524d\u306b\u6355\u307e\u3048\u307e\u3057\u3087\u3046\uff01\n\n\n\n{1630797854905970}\n**\u56da\u4eba\u305f\u3061\u306e\u30dc\u30b9\u306b\u306a\u308d\u3046**\n\n\u4e71\u95d8\u3057\u305f\u308a\u3001\u5a01\u5727\u3057\u305f\u308a\u3001\u307b\u304b\u306e\u56da\u4eba\u305f\u3061\u3092\u51fa\u3057\u629c\u304d\u307e\u3057\u3087\u3046\u3002\u8131\u51fa\u3092\u52a9\u3051\u308b\u3053\u3068\u3082\u3042\u308c\u3070\u3001\u72b6\u6cc1\u3092\u3055\u3089\u306b\u5371\u967a\u306b\u3059\u308b\u3053\u3068\u3082\u3042\u308b\u4efb\u610f\u30af\u30a8\u30b9\u30c8\u306b\u6311\u6226\u3057\u307e\u3057\u3087\u3046\u3002\n\n\n\n\n\n", "short_description": "\u30b7\u30e3\u30d9\u30eb\u3092\u624b\u306b\u53d6\u308a\u3001\u81ea\u7531\u3078\u5411\u304b\u3063\u3066\u6398\u308a\u9032\u3082\u3046\uff01\n\u770b\u5b88\u3092\u51fa\u3057\u629c\u304d\u3001\u56da\u4eba\u305f\u3061\u3068\u4e71\u95d8\u3057\u3001\u6df7\u4e71\u306b\u6e80\u3061\u305fVR\u8131\u7344\u30a2\u30c9\u30d9\u30f3\u30c1\u30e3\u30fc\u3067\u30c8\u30f3\u30cd\u30eb\u3092\u6398\u308a\u306a\u304c\u3089\u30e6\u30cb\u30fc\u30af\u306a\u30af\u30a8\u30b9\u30c8\u306b\u6311\u3082\u3046\u3002"}, {"images": {"nodes": [{"file_name": "icon.png", "id": "2511803675903164", "image_type": "APP_IMG_ICON", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820141_2511803679236497_5745489834461663248_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R_IfE1bUaFwQ7kNvwHcobCz&_nc_oc=Adnp-G
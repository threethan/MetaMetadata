, "id": "4191951167799953", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_4191951171133286_6008220942567939390_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DEgYYXIvcM4Q7kNvwHn7Mlq&_nc_oc=Adnm4_UMkwPPlVqPjXUQHrWer5smGak7zvUSimH7wbiNkkiqUz7pVm7S8ktXK7QsHzM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftLhYBX1HZGmq8xQqP3iDwrbjRDeDzm7iVHxm0qCWjHig&oe=699DA0F6"}, {"file_name": "screenshot_44_20251202-131523.png", "id": "853472417082939", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822550_853472423749605_6621515077070126422_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_gQkboNVD9IQ7kNvwFUjDQJ&_nc_oc=AdncJ24xCvBInKui4GKuvFYbknNgR0tKwvLshy-DaBp3Vv83NFSkDw5ivUFbSxLdwwk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvB7cbQpmo8GXMSzhJ4ftjBeTymBpG0iegd0y4Wmm_8GA&oe=699D8012"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "824307180611907", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821725_824307187278573_1515421764207143540_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYpgYTJKQ4IQ7kNvwEXTWrU&_nc_oc=AdmlmY2LgWoMn9w7ceitslDRw8PWp6RTGlnj1jg4IahHluf997s1XfDCdxpRPBUHrmc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftL6pV67fAS5IQQx23jgkyZHhcijqhc3ZPON-GoLWHX2Q&oe=699D86B9"}, "display_name": "Dig To Escape", "keywords": ["Prison", "Escape", "Dig", "Hole", "simulator"], "long_description": "#                                                                                                                                                                                                                                                                                                      \n# Dig to Escape\n\n**Grab your shovel and get digging!**  \n\nDig to Escape is a stylized VR prison-break game where you dig, survive, and outsmart the mole to escape.\n\n{2046789639497740}\n**Dig for upgrades**\n\nMine valuable minerals and sell them to upgrade your tools. Better gear means faster digging, deeper tunnels, and more escape options.\n\n\n{1547839482800416}\n**Watch out for the mole**\n\nA sneaky thief is after your loot. Catch him before he makes off with your hard-earned minerals!\n\n\n\n{1551401099280034}\n**Be the inmate boss**\n\nBrawl, intimidate, or outsmart other inmates. Take on optional quests that can help your escape\u2014or make things much more dangerous.\n", "short_description": "Grab your shovel and dig your way to freedom!\nOutsmart guards, brawl with inmates, and tackle wacky quests as you tunnel through a chaotic VR prison break adventure."}]}, "developer_name": "K&K Studio", "developer_privacy_policy_url": "https://knk-studio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "K&K Studio", "support_website_url": null, "website_url": "https://knk-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25729399156749991"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825050_1573921147292844_5059665208820809675_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmSOYwYkm74Q7kNvwFTfqug&_nc_oc=Adml1Ny5rvI2TanbKfl4qLz1A8N_68nfQhr4KfC5A2zg_Y2Mt94Olm8hLFQcyPmQr8g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvJu7anoIpO2h3fYA6u1SdLk-ppv
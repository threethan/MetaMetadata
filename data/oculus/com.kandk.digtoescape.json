89639497740}\n\n**Watch out for the mole**\n\nA sneaky thief is after your loot. Catch him before he makes off with your hard-earned minerals!\n\n{1547839482800416}\n\n**Be the inmate boss**\n\nBully, outsmart, or intimidate other inmates\n\n\n\n\n{1551401099280034}", "short_description": "Grab your shovel and get digging! Outsmart sneaky moles, brawl with Inmates, and take on wacky quests as you tunnel your way to freedom in the wildest prison break ever!"}]}, "developer_name": "K&K Studio", "developer_privacy_policy_url": "https://smallpdf.com/file#s=5c5ab8e5-9c2e-4705-ad6f-3598c05f6127", "developer_terms_of_service_url": null, "publisher_name": "K&K Studio", "support_website_url": null, "website_url": "https://knk-studio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25311792385177339"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "889716413493912"}, {"status": "PUBLISHED", "id": "840047175686266"}, {"status": "PUBLISHED", "id": "1550477966056240"}, {"status": "PUBLISHED", "id": "2125365964960870"}, {"status": "CANCELLED", "id": "1242027804444181"}, {"status": "PUBLISHED", "id": "2128099918018300"}, {"status": "PUBLISHED", "id": "25612307108395221"}]}, "baseline_offer": {"id": "25612307108395221"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776445200, "status":
=6e7a0a&_nc_ohc=5AukUmgjNeAQ7kNvwG2ZbLg&_nc_oc=Adp88-Rk9qwezlZQZYtpDJdUwxPomG3oOiN2SZLfpMSay4u47F52JG2nxVTYgwuFSoY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1EseznxBPOlh7yuc3rnhndpCkSj5yKR4ERohfi4AYIBg&oe=69F1F8E6"}, {"file_name": "4.png", "id": "1488377815132033", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39001670_1488377818465366_4369730771137685134_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufhZvhKp7McQ7kNvwFABQzl&_nc_oc=Adrd6_A8WR_nvHeajpRZXrvYX8x7DTar5Y4e_lVRwM7a7k5VOG74vb_oZh9H8266AH8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af3gkizYQlPfLlDhWecEXpUYEx0_IJyGKcMi7Gcpj8Xhcw&oe=69F1F544"}, {"file_name": "5.png", "id": "414882827722865", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982480_414882831056198_2207792374391745331_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S85SB-5jEVAQ7kNvwHtq83z&_nc_oc=AdoSyVMy-zX6guMMPRLYOF172ldjB5_mqHxwAlTrrbSnt0PnNkjJDSYuOmFYG9fjnD0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1zvLJ_V4qYxLVf5MX5uwlNi18FueAwuHoZK4zlLrSIyA&oe=69F1E87D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "16x9-2.png", "id": "811607170639171", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86609236_811607173972504_8101196321901847264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvuMYvuDmuMQ7kNvwFqJNk0&_nc_oc=AdoGZMh7GnTB6ChUXA44-BEgEfWIHRR6T7046NFm9JRk6k-YS1CxYSGyxx1k5eWCucQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZnZV74T3foiQAPWPYYQRizuPXD-2Irk2wPJEVwikvyw&oe=69F21581"}, "display_name": "Void Ninja Demo", "keywords": ["action", "platformer", "ninja", "void", "runner"], "long_description": "Void Ninja is an **action platformer** game that blends runner elements with a unique **\u201cJinba Ittai\u201d locomotion**.  \n\n\ud83d\udc49Gameplay: You're **always on the move and can't stop**. Use your hips and shoulders to steer on the path. Overcome obstacles and clear out enemies.   \n\n\ud83d\udc49**Just one button \u2014 let your body do the rest!*** \nYou don't need to remember million of combinations, or press something to move  - run with the flow.  \n\n\ud83e\udd77\ud83e\udd77\ud83e\udd77  \n\n# Key Features:\n\n- **Unique natural flow locomotion:**   \nInspired by the \"Jinba Ittai\" philosophy, this system ensures perfect unity between player and the game - you simply act as you would in real life  \n\u2796  \n- **Comfort / Motion sickness tested:**  \n 85% of players experienced no symptoms, 10% adapted after 30 minutes, and 5% did not adjust and we prefer not to talk about them  \n\u2796 \n- **Platformer / runner:**   \nFirst-person platforming adventure inspired by a certain blue hedgehog. Intense combats,  adrenaline-pumping jumps and jet-powered flights - this game will keep your heart racing   \n \u2796 \n- **Combat dance:**   \nAs you progress, you'll develop your own unique moves and combos crafted by your skill, not pre-made by the developers  \n \u2796\n- **Level reassembly:**   \nEach time you load a level, it\u2019s generated in a new and unique way   \n\n\n\n\ud83e\udea7**4 demo levels**   \n\u279517 extra levesl available in the paid supporter version\n\n\ud83e\udd77\ud83e\udd77\ud83e\udd77 \n\nThis is work in progress version.\n**Share your thoughts, ideas and feedback with us** - let's make the game together.\n\n*rarely its 2 buttons, but you won't confuse them. Only 1 sounds better, right?\n", "short_description": "Action platformer with gesture based controls and unique locomotion."}]}, "developer_name": "Roman Yakimenko", "developer_privacy_policy_url": "https://void-ninja.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Magic Web Solutions", "support_website_url": null, "website_url": "https://void-ninja.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "45978150496848
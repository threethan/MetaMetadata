nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=07jpWILHiR4Q7kNvwHmDD5-&_nc_oc=Adq6fmNhsvpTMbiAk20Fh2F1TSthd5RXzIdZF2iOhX3FU9rvJmtK5xOaiIPn_hn4ezs&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80rWGXu3Z3nauHCJ4rrBSnZDtOnmqjAUSE08uP4LyWJg&oe=6A468ED7"}, {"file_name": "Shot17.png", "id": "589330579540392", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974847_589330582873725_3039143483285821512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tv2QO4USCmsQ7kNvwFIicRk&_nc_oc=AdoyiTAIoY1ybDWUQUl78lAVczrOKUlcn3oNoeXFQcZfVplcLlH5cCabQEBH1KuekBE&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LCIaAqbpNY1rmB5RnimUNuVvnpQNZO4KIkYYWvMt5Iw&oe=6A468647"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_demo.png", "id": "422196240046732", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974850_422196243380065_3203480253240726917_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fUUw1hZMbsQ7kNvwHTQcQB&_nc_oc=AdpG4My7dvMk3L6iHcER20cmL3APOS87Ba7By7yvjk1lJfNIo4SWIuz4MavIzexkkXI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VxzfwCrOWH_Ivrmp1Hy0RBGvJSC-bOM1K5v75AFTEHg&oe=6A466B7F"}, "display_name": "Lucky Fish Bread Demo", "keywords": [], "long_description": "Full Version : https://www.oculus.com/experiences/quest/4204810336305193/\n\nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "FOOD", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "511175210827707"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "8216608008409340"}]}, "baseline_offer": {"id": "8216608008409340"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1667422560, "status": "PUBLISHED", "id": "8216608008409340"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5523432584437532", "version": "0.1.2"}, "id": "643219270755922", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fa
nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rkq4LZSWUZoQ7kNvwHPx1Xu&_nc_oc=Adpuot_tCAOO_rrDTMEGipKuHsagIBZv9guBDbaz6FgvoKjtGleD6gazn-qTim1-GkA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RDw2b_D2vFxrbXITT2XTpQFE01cocjVAsKCSeL-KL7Q&oe=6A36BCD7"}, {"file_name": "Shot17.png", "id": "589330579540392", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974847_589330582873725_3039143483285821512_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20T3BKELml0Q7kNvwFks6j5&_nc_oc=AdoCp6uGiCuM9Dn7KH6GrYQMXjZyHzPG7C5sMUHHe8vqCh0Q6BNIvBzRGhk62fRxUAo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dGMXKPk6b5Dx5ZtEhXAvo_j4uTubUvXK3ViOjtljrTg&oe=6A36B447"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_demo.png", "id": "422196240046732", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974850_422196243380065_3203480253240726917_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cmLI53bzSecQ7kNvwG25mLo&_nc_oc=Adr1q2Bp5UL8a29PjuMRbo3PokPIFCkrunEr4vpnBhCBbGb-5LHXG7NUunYe25I93WY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r_TQww4O9sT4a0WnhKmb-1ENew-LoxJtzHYHh0znS_g&oe=6A36997F"}, "display_name": "Lucky Fish Bread Demo", "keywords": [], "long_description": "Full Version : https://www.oculus.com/experiences/quest/4204810336305193/\n\nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "FOOD", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "511175210827707"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "8216608008409340"}]}, "baseline_offer": {"id": "8216608008409340"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1667422560, "status": "PUBLISHED", "id": "8216608008409340"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "5523432584437532", "version": "0.1.2"}, "id": "643219270755922", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": fa
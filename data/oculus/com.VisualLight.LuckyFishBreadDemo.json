ontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgY9swMLKv1-cyWUWUTbZAIi2mM-SrFKeCAbBCQi_UtA&oe=6AFDAEEF"}, {"file_name": "Shot53.png", "id": "622477239282836", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031491_622477242616169_3348529047411611146_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTgsk4FYLeAQ7kNvwHWb0n_&_nc_oc=Adqv1jvNgR2LDvNkXzT-tcuXXTrLPDqaYakGJUG_TGTzgSPunT2xL2PtbTHBt_ObaCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB5eD6U9mWQ6PrE-HZkAKGm7pPpo2qP45gBhnHJV2Y4A&oe=6AFDCF57"}, {"file_name": "Shot17.png", "id": "589330579540392", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974847_589330582873725_3039143483285821512_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1uVvEKg-8cQ7kNvwHU1I70&_nc_oc=Adrj9_rfqOVvUPZ5LlIsbI8Z5-8eNdkQylJs06E2J5LLzcgtruUphqNrMq1vdwQHZ3c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRo8YZKJrlIa-iax0PfyLxxEvP75AYCudZRCo8wz8Sk2A&oe=6AFDC6C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape_demo.png", "id": "422196240046732", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974850_422196243380065_3203480253240726917_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpQNBQPVRWEQ7kNvwECM7vQ&_nc_oc=AdpJRl3TaabHSBuyM-2mvmbgriTbsEHdpwG__mMlBTEBw9-gcJuoX3ZYHGTT3BZYRuI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmB4js4YFDNOPUKuJ-tjqwnRJ50X_n49mJYZpDBkfglQ&oe=6AFDABFF"}, "display_name": "Lucky Fish Bread Demo", "keywords": [], "long_description": "Full Version : https://www.oculus.com/experiences/quest/4204810336305193/\n\nIn this cooking simulation, you will be baking Fish Bread in a street food stall with the help of the Fish Bread Fairies.\nPrepare Fish Bread and drinks to order for your hungry customers.\nComplete the game's missions!\nUpgrade your stats and cooking equipment!\nBefriend other Fish Bread Fairies and learn their Fish Bread recipes!\n\n\n Features :\n \n*Pick up and interact with all kinds of objects around you. There is more to the game besides cooking Fish Bread!\n*Enjoy the unique, cartoony art style, and make colorful and animated Fish Bread snacks.\n*Interact with cute Fish Bread Fairies.\n*Complete the game missions and engage in funny cutscenes with the Fish Bread Fairies.\n*Sell Fish Bread and develop your business.\nMake your street stall the most popular stop in downtown!\n\n\nSatisfy your impatient customers. Keep troublemakers away from your business. Become a master Fish Bread Chef. Do you have what it takes?\n", "short_description": "Let the world know about fish bread!\nWake up the fish bread fairies to learn a variety of menus, satisfy the customers, and protect the store from the villains!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SIMULATION", "FOOD", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "511175210827707"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "8216608008409340"}]}, "baseline_offer": {"id": "8216608008409340"}, "is_approved": true, "firstOf
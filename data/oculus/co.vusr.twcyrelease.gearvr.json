/t64.5771-25/11162708_1990727377853632_877880771157688320_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0-5-JRaRFgQ7kNvwHkoWoT&_nc_oc=Adp_zovkraX4FxPWdLoNbtsq1IKArtOzy-6rqzd8EVT9J1EeS6CdAc0O3xKcY6FZOAA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbvKHxzxoYhHcYYbV4P5JyDP3teEM1Nnu2hQ8hZNRACw&oe=6AFF104B"}, {"file_name": "migrated_image.png", "id": "206626313943752", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/11162694_124314561588208_4742359797112766464_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tldriUYBbUkQ7kNvwHMdaud&_nc_oc=AdqwrHIzianMJwHd_qVJCg2upRV9fSgCzaXYHQQQliwYfiaMMr-hTbihG136SpKILUw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpqeI0M_Vvn67gvDAreXFRpeQoy6io5XhhRUGAJW_vJg&oe=6AFF14D6"}, {"file_name": "migrated_image.png", "id": "2475005612759736", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/11162741_528897064124363_8011350618318831616_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aLRX0zBoXEQ7kNvwGJp4I5&_nc_oc=Adoq1D6rMXvekDEWY_sONDu6IumnY1kbgvpW2NHOPQzhBnul2wle7baCVzwV2EKJMYk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLj60sILYKQvMdT4JQ7FgLxdxlkUtJDY5O3Y4DDhV9WA&oe=6AFF0596"}, {"file_name": "migrated_image.png", "id": "2334445713530195", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427674_163625267557860_4598453207008542720_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCnqJG09TZcQ7kNvwGrROxP&_nc_oc=Adpukiwt1ojGXaVBu1V_5hpBIR_iOtnVjfr_58qbzaRswX2K95CUqTPAEDaGwyXdobE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDuBCZHi3eXbU1vnO7tgWDBTjnI7Wzqu-ud97OWrCGPg&oe=6AFF3616"}, {"file_name": "migrated_image.png", "id": "211585230252468", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12386286_154147631856714_4811834947574693888_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X4Rtt5ps0aUQ7kNvwH6POp3&_nc_oc=AdoPJD_NxFEXAg_jHUbhzOshs8DCsS6oDVGGz5_zai28AVyk-5N1Rw1MdyF8efsmpgs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUaYcWNPRZDGg8g2oKffbl1qi2YMQfn3Dded2bsh3dUg&oe=6AFF23C0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Wild Canadian Year", "keywords": ["nature", "animals", "canada", "wildlife", "seasons"], "long_description": "The seasonality of the weather on our planet defines and drives the lives of every creature on earth. Humans, plants and wildlife must navigate the changing conditions they face as a result of our planet\u2019s annual trip around the sun. But in some places the effects of the seasons are especially pronounced - one of those places is Canada. Lightning storms and tornados whipping across the Canadian prairies, secret worlds buried beneath the snow, polar bears hunting in the open summer waters of Hudson Bay, a bizarre animal that lives underground and has 28 tentacles around its mouth instead of eyes, frogs that actually freeze solid in the winter - miraculously coming back to life year after year each spring, and lynx that walk on snow chasing their elusive quarry through the northern forests \u2013 THE WILD CANADIAN YEAR will showcase the most amazing and rare natural wonders of Canada.", "short_description": "From the creators of the acclaimed series WILD CANADA, comes a new  legacy series in VR, which will view Canada\u2019s extraordinary wildlife through the lens of its four distinct seasons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://www.cbc.ca/wildcanadianyear/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "ge
hc=L2xwrfAvzmgQ7kNvwFS5fFA&_nc_oc=AdrjFMHD-OwML_DX5RoYuSEqzmvXuNS-spMtwJqpPAlBUrh6oXDco-HxlW7ZeKWPHVg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTAML42zes1DLusWd12nvTiEjr7KplNbDff0gCjGGIBQ&oe=6B104740"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Wild Canadian Year", "keywords": ["nature", "animals", "canada", "wildlife", "seasons"], "long_description": "The seasonality of the weather on our planet defines and drives the lives of every creature on earth. Humans, plants and wildlife must navigate the changing conditions they face as a result of our planet\u2019s annual trip around the sun. But in some places the effects of the seasons are especially pronounced - one of those places is Canada. Lightning storms and tornados whipping across the Canadian prairies, secret worlds buried beneath the snow, polar bears hunting in the open summer waters of Hudson Bay, a bizarre animal that lives underground and has 28 tentacles around its mouth instead of eyes, frogs that actually freeze solid in the winter - miraculously coming back to life year after year each spring, and lynx that walk on snow chasing their elusive quarry through the northern forests \u2013 THE WILD CANADIAN YEAR will showcase the most amazing and rare natural wonders of Canada.", "short_description": "From the creators of the acclaimed series WILD CANADA, comes a new  legacy series in VR, which will view Canada\u2019s extraordinary wildlife through the lens of its four distinct seasons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://www.cbc.ca/wildcanadianyear/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "ge
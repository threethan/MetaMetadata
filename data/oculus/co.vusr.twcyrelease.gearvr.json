nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSCojcHI7NRd2EjgabILHNXNFpHzm-UgL8fi-4ulOGJQQ&oe=6AFDC356"}, {"file_name": "migrated_image.png", "id": "2475005612759736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162741_528897064124363_8011350618318831616_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67F0bjs5TdYQ7kNvwFncGyP&_nc_oc=Adoc1d2a5n7r-krhhE6uSnnHxtdWVZRPzbrrTecNB9ppHf6KEkkWx6wVzjn3P-7qgxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUF6r_ZfLNN7kYNuHX3SAcoXk9HGCZs3sxwT2EUYejWA&oe=6AFDB416"}, {"file_name": "migrated_image.png", "id": "2334445713530195", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427674_163625267557860_4598453207008542720_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OCnqJG09TZcQ7kNvwG8pkqh&_nc_oc=Ado9zHqcMUNy66e6IuKfkzwoNv5DClJcsrSeuAqJlsGA-Bf9KAFRIEa3FhMZmPgy3yY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQR3grgLRpZPWxrJ_ZYdrgkwh4RsyNzw48x0GGl2Ih1BQ&oe=6AFDAC56"}, {"file_name": "migrated_image.png", "id": "211585230252468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386286_154147631856714_4811834947574693888_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nmu4UOt__tEQ7kNvwFM6RR_&_nc_oc=AdomW7340BAOsAO9c0y1Q1LWCCi-Hd6B27UncIwd8D4R3f5i5c7z56aSWmDZvSmnN-M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnNVxyWq4_ZbUmcKHJTc6E8lPBa1Gib4OGWLAKqyNEhQ&oe=6AFDD240"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Wild Canadian Year", "keywords": ["nature", "animals", "canada", "wildlife", "seasons"], "long_description": "The seasonality of the weather on our planet defines and drives the lives of every creature on earth. Humans, plants and wildlife must navigate the changing conditions they face as a result of our planet\u2019s annual trip around the sun. But in some places the effects of the seasons are especially pronounced - one of those places is Canada. Lightning storms and tornados whipping across the Canadian prairies, secret worlds buried beneath the snow, polar bears hunting in the open summer waters of Hudson Bay, a bizarre animal that lives underground and has 28 tentacles around its mouth instead of eyes, frogs that actually freeze solid in the winter - miraculously coming back to life year after year each spring, and lynx that walk on snow chasing their elusive quarry through the northern forests \u2013 THE WILD CANADIAN YEAR will showcase the most amazing and rare natural wonders of Canada.", "short_description": "From the creators of the acclaimed series WILD CANADA, comes a new  legacy series in VR, which will view Canada\u2019s extraordinary wildlife through the lens of its four distinct seasons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://www.cbc.ca/wildcanadianyear/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1077845756092474"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1617451564956947"}]}, "baseline_offer": {"id": "1617451564956947"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1515564000, "status": "PUBLIS
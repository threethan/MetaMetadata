nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3qweMmo_wgQQsZjfqsgXHlma0hlSuyedVGiPFuAVZ0A&oe=6B06FDD6"}, {"file_name": "migrated_image.png", "id": "2475005612759736", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162741_528897064124363_8011350618318831616_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qeI8BoBl3hsQ7kNvwGjO545&_nc_oc=AdoegCjVUAesWh9-gsxpJF1PwxSbSFHQh_QBh-Z1DYybbyUmcww9ZB0SAtBbX2QqA7k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVWmW_i-clQGbUzVqSM_kAac_VCkA7HYM2uBGRuzbT8w&oe=6B0726D6"}, {"file_name": "migrated_image.png", "id": "2334445713530195", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427674_163625267557860_4598453207008542720_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4evR_3wSQPwQ7kNvwG4u4Ad&_nc_oc=AdrSTvBmGIw7HhzCpbzcko6bfQrieX01GI6Nfi58LVvGTZoXsNrn1YSurTwVp_tZxt4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpzNI4aRz2DLn_cfIGRr56KvSw01uufP6mW3pZLfOaGw&oe=6B071F16"}, {"file_name": "migrated_image.png", "id": "211585230252468", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12386286_154147631856714_4811834947574693888_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Epu_nqUrUa0Q7kNvwE64vQy&_nc_oc=Adr7bBI468y2BROoKjqnPehg5XFVCI3siKqRwIuAeNrt6k8NJs6ZZXmmolqwLg_Afe8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHfKxu5Z0SjkymGHnD6ogcI0FszaEZVCifLFEqYRlRig&oe=6B070CC0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Wild Canadian Year", "keywords": ["nature", "animals", "canada", "wildlife", "seasons"], "long_description": "The seasonality of the weather on our planet defines and drives the lives of every creature on earth. Humans, plants and wildlife must navigate the changing conditions they face as a result of our planet\u2019s annual trip around the sun. But in some places the effects of the seasons are especially pronounced - one of those places is Canada. Lightning storms and tornados whipping across the Canadian prairies, secret worlds buried beneath the snow, polar bears hunting in the open summer waters of Hudson Bay, a bizarre animal that lives underground and has 28 tentacles around its mouth instead of eyes, frogs that actually freeze solid in the winter - miraculously coming back to life year after year each spring, and lynx that walk on snow chasing their elusive quarry through the northern forests \u2013 THE WILD CANADIAN YEAR will showcase the most amazing and rare natural wonders of Canada.", "short_description": "From the creators of the acclaimed series WILD CANADA, comes a new  legacy series in VR, which will view Canada\u2019s extraordinary wildlife through the lens of its four distinct seasons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://www.cbc.ca/wildcanadianyear/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1077845756092474"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1617451564956947"}]}, "baseline_offer": {"id": "1617451564956947"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1515564000, "status": "PUBLIS
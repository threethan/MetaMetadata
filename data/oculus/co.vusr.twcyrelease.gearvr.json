nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRXas_69qSuv9f6oWv0iL5HYBtWON0ZhSxUV1wyyWt6yQ&oe=6B0DCD96"}, {"file_name": "migrated_image.png", "id": "2475005612759736", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162741_528897064124363_8011350618318831616_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gr7cWKXc7-8Q7kNvwGROV0A&_nc_oc=AdpVHN9lYTEsAkLMV0SMI678s6MAkOJgyPEHKFzS8y8jN7YVkscmONAFOHaz2uZqVMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhStL9RcmXfl3HIp99naIAg1hhkKxNPEWK6N_AOWkXRw&oe=6B0DBE56"}, {"file_name": "migrated_image.png", "id": "2334445713530195", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427674_163625267557860_4598453207008542720_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U73PVPlZsNsQ7kNvwFdAcjM&_nc_oc=AdruteIJrREP_EjKKrSa6hAdogT5VVLLIZH2ok2hK4pVixjnfLul8HlPvqA7WOME42M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRlOUt_nCfM6D_uc8-1PkcWvH0qDQPiwrFre2kafUfHiw&oe=6B0DB696"}, {"file_name": "migrated_image.png", "id": "211585230252468", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386286_154147631856714_4811834947574693888_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YL9g4PwsQ4IQ7kNvwHZQrXF&_nc_oc=AdpGWK-hccmtQWadNtW4hEuXerKGzDaKUdkaoaR46rIsMOmytrRPxjoKMx1Qr7bqqUM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpDuSpITtCj3fgerr1kfRMjttvYWKHwmHqmb2KnclgQA&oe=6B0DA440"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Wild Canadian Year", "keywords": ["nature", "animals", "canada", "wildlife", "seasons"], "long_description": "The seasonality of the weather on our planet defines and drives the lives of every creature on earth. Humans, plants and wildlife must navigate the changing conditions they face as a result of our planet\u2019s annual trip around the sun. But in some places the effects of the seasons are especially pronounced - one of those places is Canada. Lightning storms and tornados whipping across the Canadian prairies, secret worlds buried beneath the snow, polar bears hunting in the open summer waters of Hudson Bay, a bizarre animal that lives underground and has 28 tentacles around its mouth instead of eyes, frogs that actually freeze solid in the winter - miraculously coming back to life year after year each spring, and lynx that walk on snow chasing their elusive quarry through the northern forests \u2013 THE WILD CANADIAN YEAR will showcase the most amazing and rare natural wonders of Canada.", "short_description": "From the creators of the acclaimed series WILD CANADA, comes a new  legacy series in VR, which will view Canada\u2019s extraordinary wildlife through the lens of its four distinct seasons."}]}, "developer_name": null, "developer_privacy_policy_url": "http://cbc.ca/aboutcbc/discover/privacy.html", "developer_terms_of_service_url": "http://cbc.ca/aboutcbc/discover/termsofuse.html", "publisher_name": "CBC", "support_website_url": null, "website_url": "http://www.cbc.ca/wildcanadianyear/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["CASUAL", "EDUCATIONAL", "EXPLORATION", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1077845756092474"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1617451564956947"}]}, "baseline_offer": {"id": "1617451564956947"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1515564000, "status": "PUBLIS
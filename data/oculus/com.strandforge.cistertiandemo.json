h immersive dining and cooking."}]}, "developer_name": null, "developer_privacy_policy_url": "https://strandforge.com/documents/Privacy-Policy_Cistercian_VR.pdf", "developer_terms_of_service_url": null, "publisher_name": "Strand Forge s.r.o.", "support_website_url": null, "website_url": "https://strandforge.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de", "cs"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26525078570459155"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "966974742452995"}]}, "baseline_offer": {"id": "966974742452995"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776166200, "status": "PUBLISHED", "id": "966974742452995"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26481031064863906", "version": "1.0.0"}, "id": "2779824062375023", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "26393457256954621", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26481031064863906"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2779824062375023"}]}, "ch
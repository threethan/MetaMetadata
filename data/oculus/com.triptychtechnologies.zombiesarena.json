-dfw5-1.oculuscdn.com/v/t64.5771-25/499623512_1793469651787388_2721743605433659327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXHg5JRjPOYQ7kNvwHyoQSI&_nc_oc=AdoDyDyEQd7HFp63EfEoMNIydVHmVlunI-sL1zYRgcviRCz-Fzp6Xu31GPpMVhUe3lo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVIEzlemWVoSeNQxJHfmcOZwjJbE0LX6_d2X1xpJFYmg&oe=6B086B62"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8Ii0qZ6GfoQ7kNvwF5qC10&_nc_oc=AdoA5KoND2OtOoTqQmM1Fr6JqNGpoIhXzZlzP_9ZBTNnjWFn2SYD82QQjTS_7gjwcZk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSY1GEHuSBM6skvQcScd8K3U-bF34BqDY5MTm8N5mGQlw&oe=6B08418E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFL8d9MfuLgQ7kNvwH03_zj&_nc_oc=AdrnB8OUxLddUepIa3x7plEmLoBRFZ9COAsRZ44cU6m_0yrnHC_QnCP5Dm_pn0jytXw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSe1VKDiEn2ntZwgLDufQ4baNtTLtmTVuqbjnsGk-yERQ&oe=6B086C96"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_D5wPvADucQ7kNvwHEFTrr&_nc_oc=AdrPD4qQbaA0yfgek3fVujnun08h5oiZZqrn-niueOFYMSuAXzAt7yj91iNSOyqAlV4&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-lXJSSyVK5t5GtFXhmQXxsH2V4ghf31YpV9uPdN2sJA&oe=6B0863CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cQrfQwjwWAQ7kNvwGAFKzk&_nc_oc=AdqAvt7km1EKy-z44VqTZ05D9SMpv7DZjik494OEzSazxy6lKpgIDkDZtnx7K8hIH6s&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeev-x8TSsumztB0jhD2SXgZmaWVIKo7n-Ak4ZgpS18Q&oe=6B08545C"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_po
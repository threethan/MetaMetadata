-atl3-1.oculuscdn.com/v/t64.5771-25/499623512_1793469651787388_2721743605433659327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK2zrFJYWqgQ7kNvwERvMZ2&_nc_oc=AdoOiOM88AQWSYpNF4mU72HEcEax7ZEXcK9ATv1AbG50NEMsL6JmdMyI2bPeV5n0mdY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRpGJxZIoILOv-uIVPwuzmr4II6Rt0S7bGGV98SNhCLIg&oe=6B0B0E62"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8Ii0qZ6GfoQ7kNvwEWrBZZ&_nc_oc=AdqIin-FiHnWCLBBcJ7DrzgqVNgWpVVq62wWV0cgebkCbgnuov-EX1bNTUjbth8cB6o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRPOlT-nQbhWM2Ib8zsTgLL5INlGWikXZJjRLldYu62zQ&oe=6B0B1CCE"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPO8QV9oPxUQ7kNvwHLBkmc&_nc_oc=AdrKr9GkrZ-cZg5Y3YzspuoX2kkL_UuPjuxCEhyk8VuG7HzF4qZh9SJ1ci-nuYsXjSQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUQnlE1qk2pTqNLPsyhPzQEUrD8s4t7-YTXTtf_6UZzA&oe=6B0B0F96"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_D5wPvADucQ7kNvwEfJoKg&_nc_oc=AdqsleOLnMMX2AhlKkHnJxLtIucSp3NrkdVG5lntlVwH4DIi-Yj9hvwZOPAVvSuFfis&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSTBadzOfx5LjYGlU1XD-qpW5MIqbfM-dqEZN1lb5R4gg&oe=6B0B3F0B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZRumV1fL4UQ7kNvwFT5SlE&_nc_oc=AdoKHS_6oriYgTBfnn20e6jp2nQfYJfifMBFsy3C9sgljgdXnG36WK5b-fWao1DvlO0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsrHxrT4RzH9FFyFBdxL8BSMe87ZNCNNuReTgKU1UDrg&oe=6B0B2F9C"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_po
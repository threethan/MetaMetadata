-iad3-2.oculuscdn.com/v/t64.5771-25/499623512_1793469651787388_2721743605433659327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VtiMi92_A8Q7kNvwFrxBPK&_nc_oc=Adp_R4JSypgWPvRX3Zn1_5bQSZ0bz6MA8-JQqmIG-inf1gZJZ6fCOc0rlfDdDfnSjmI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhsGJz4W04Nice1I_Flqrwddc1ob8oniop22Wlc0vRFw&oe=6B01D3E2"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zJsOymiqFcQ7kNvwEvplTT&_nc_oc=AdqmbDj3b5cUptiQD-sypCX6ymYGIuM6CazG-MwTOiVfSkcuBSfoZXKjSmxTJr4CekE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqu08fAKog-kj12KJDcRI6FENtZ3STS0MMawcyGe6GvQ&oe=6B01E24E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42WJroljrjQQ7kNvwEn5Bbu&_nc_oc=Ado5vU5z_y_1csA0Sy8eefCuZaUkwt_1XDtGzz7BShzYXqz4l50iaIi9DcEyou-ZQ9c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcbwGSPM2EXxVCijeCmJv86iZ-86sWoOE_SiBI921_4g&oe=6B01D516"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZc0LUiGrZwQ7kNvwFHNyYr&_nc_oc=AdryBBrYAIethY73MKq1S_Rv3wCQgqS2N7oo0yixlVAfz4K2nMXqiVOzepKglOEjHIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREAiGIBA_Qqx0rrwGcwJiEpij1Acksz3j7_r9g3LVUjw&oe=6B01CC4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptlFe1kW9BwQ7kNvwH7aiEU&_nc_oc=AdrLRI7MhaKK8Jk5XmATFptYloOGGTc16x4h5wXazRUG6QpINqoYCjrATcS6ftBI2HY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwkkm42oxGXW3nIuXza1DQcMqWJMbM3_5hp9ydz_NziQ&oe=6B01BCDC"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_po
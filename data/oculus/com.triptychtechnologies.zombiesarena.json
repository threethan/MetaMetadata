-sjc3-1.oculuscdn.com/v/t64.5771-25/499623512_1793469651787388_2721743605433659327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RUyMBhoUgMoQ7kNvwFEsjg7&_nc_oc=Ado4FI32rruwc11n7d_vVtja5LEH0h2eiJ199YtU8v6lKR_i29mORAaQyg6qogUWhLs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSZELXm86IpJUry_ylqhmDsOesUA24UrDF9ycoPesiRrw&oe=6B032562"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zJsOymiqFcQ7kNvwFw7Uhv&_nc_oc=AdrEyPYrmEJkKM_wbiBhWaWW7zxi9DTInMHi9j0qA1jXaesep4yiRlR9zhYLT_FtrP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZnYx5vqqEpwK3Vp6GLJRE7moYyu-kCsU9VnNxZq9JLw&oe=6B0333CE"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42WJroljrjQQ7kNvwEkBsPI&_nc_oc=Adp2MPAHobhfNM0g44IdB2pWBHikkJS9gTfeg-n8l-5En3wpwglTU6Eejz661WBTa4Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLDs6o9p7CsQOdMLo5lEXxMWLzNLFhPOe4Z60kP7z8VA&oe=6B032696"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZc0LUiGrZwQ7kNvwGvMpD2&_nc_oc=AdoewEy2O0GirUdejzWe0BFL1hBtiz_ZklYtVEP_DsxBFh9Jb8e9XdQALcVr-IXNE-k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS2QxLMrv3ILkv-fjzaN9TWJqTINlyRBeKn3rkVPlMug&oe=6B031DCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1MF-KZn-XwQ7kNvwGSJ2Gb&_nc_oc=AdqrBut3W3jJj534zSeYq-8_0MmLGSeAXsR_Y1oAGZ9_WQkOy0Z_tG1ATeU5Zdq-c08&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSAEQTOztu0C7-ySsO24DHcPg7UGiGqoZsN9IzNMPl9eQ&oe=6B030E5C"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_po
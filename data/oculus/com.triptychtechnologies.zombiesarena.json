20f&oh=00_AQT2LSMhpY1uVzOkNH0eKyH1yqubLywvYEh1fj8ORi3MdQ&oe=6AF4A4E2"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sWeDbWlTGXgQ7kNvwEkzXkr&_nc_oc=Adp9lSYdyyq-_DNGTkVJZJhDmZt8mz8ZYDOu7zMEAdGolf00AlGJAG2yOwtXtb3m7fA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2K1bXlcL1kGwoE5IdeHsedH98nSKPQR48NXnjk1Xz5w&oe=6AF47B0E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6QWF8lZTNkQ7kNvwFXz_fu&_nc_oc=Adrw45xvUmIWqLmKgu2P0_6qpg2ggyP9x6hYHl0ydTG7XNcluOOGmIxws-VXPjTNxpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_n39wXVIYP0-yGiQSjNyG9CiMlPdoaNLx2DxcJSnZQQ&oe=6AF46DD6"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=orPEt4eu_1sQ7kNvwFS2B4o&_nc_oc=AdoS63C8UtdPRb4aHfiEsEXNT4YpZfWjfgo06avH99P3PdpBPBIrXadLdqbB-UswIHw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjpd5Uveu_xxZhQ2wqgBn0t3QwsRV-7mAbzu8IqlPZAQ&oe=6AF49D4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1XT418Uw_gQ7kNvwEzUb8y&_nc_oc=Adqo3hYoxBEP4V20sjwd8Elu-_kCDFw_o-Kwben9glcRxxbCcDEN6-sz06lsKdYAqWM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9GZIqneS52xQ6rSbl0Dv8JuAbm3NBOQ3ExGKASwBkzg&oe=6AF48DDC"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sl1nk.com/elk7h1g", "developer_terms_of_service_url": null, "publisher_name": "Triptych Technologies Pvt Ltd", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813
-ord5-1.oculuscdn.com/v/t64.5771-25/499623512_1793469651787388_2721743605433659327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQXB734hUtUQ7kNvwEzhH1_&_nc_oc=Adpp_IOxjLDT539EoneQLuxZLhxlzDJ5Iu7vb_cknaAXoCujZOiVLvCH-pAlNf1mY3U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6kiGKWV4wdrdxwgS40EnKwKteerYJwrXhQOjpVSAqtQ&oe=6AFDDF62"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdTktuzgtOUQ7kNvwGAH8mA&_nc_oc=AdrwJS52fz1aTV0QMD-CT4KljM53d1GrONEtspQDcjBW_3ew_it868E0rEFkgrX93mQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMz5MtXQn5Ff3ddu2yI1YE6SEWM9XRWBYXYGR9e1FsSA&oe=6AFDB58E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=979c2AptBVwQ7kNvwFQZbGK&_nc_oc=AdqQk3Z7HU8urfU8aLkvQf2yHfsp2kq9cZ00i4-cZx8wnTmge90apacyOEuY-DjpGsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOkc54Q4EtzZFqcfJCExaPKKLkf1m2wg477s24FMAouw&oe=6AFDE096"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmBKjLlE41cQ7kNvwFK8qXt&_nc_oc=AdrhXBroq1JttRQmm0l4aZPfxIKpFBwrKg85pFwbBngYGDOa7Vh9uxBbmHKsyajnz7E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTn7WrfTDaLF1EcrqLm6VfzFA8HMLroe-GUrSicWaBeA&oe=6AFDD7CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yl3JLUQaF7UQ7kNvwE3ShjN&_nc_oc=AdrEeMXMKCZp3v8YhmHDuDWl-jIfNmBTGZHuDuhCgvni42pqRi_bZe_DaDiiWZrfaPs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrgM-hGCV_H_HUgTulXgHAZiWVyFZEB4JOfxEes1OPdA&oe=6AFDC85C"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_po
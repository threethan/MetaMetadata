20f&oh=00_AQST4EbrGsppIrvpDrxWfThG1CP5DU127pMEN9u_zruptQ&oe=6AF0B062"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t4lvTLN4vUQ7kNvwHY-mSi&_nc_oc=Adr5IEGdPre6CwKF0ZJze9hgUIz3fifKm52ak6U1hTCDvei-Fm7dyMWxDOyQ_3ZNss0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmTes41ThzwuQcZhsDjtsgYiBCrhJMuc6e5S0HRZmYaA&oe=6AF0868E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oixQRJHdadMQ7kNvwEwX_hO&_nc_oc=AdpaCM0oSU5wAZ9S20GQYLaoW8SWMgSY08fsjjhe0O0TYVZRwHIKzH0duSMkCN_lbjk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzvuD2-wFUFn2PfoidZJwX1SHbjBhHOhOmPE9yxVcHew&oe=6AF0B196"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBYMd_QjguAQ7kNvwHoZiYZ&_nc_oc=AdqBzf_AcQFhSORpy50TX73jyYkxVnxNEL_F56WbyXOUhsSROvA6l0a1uT6miRv7Sjc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR32PxPtXAwW0vxDoxqPCwhYK3b3NQpIEfX5MBpA17ahw&oe=6AF0A8CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kal-Ocvfx4Q7kNvwG9Lmz2&_nc_oc=AdphwpxvW3SCeBb21INB1x27aGjw1189yvnmKtZ-Y7hJD3bG1vjiVHmX7k_jbEgXHjU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj3gdr4y10G6uSFZMHiIcQdk9sZjrLgbGkSVU0HbweAg&oe=6AF0995C"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sl1nk.com/elk7h1g", "developer_terms_of_service_url": null, "publisher_name": "Triptych Technologies Pvt Ltd", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813
-sea5-2.oculuscdn.com/v/t64.5771-25/499623512_1793469651787388_2721743605433659327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXHg5JRjPOYQ7kNvwEPkivM&_nc_oc=AdpRCFa1AVmUHQbmQXYR6vCI-41tzvsxDBkScD5sryjloQis7ehLWXbEh6659rzoZVU&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJqgmT_le3SLApfa3h5J2ysG01z16wYgUS4aBSwciPAA&oe=6B09BCE2"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8Ii0qZ6GfoQ7kNvwGt7elm&_nc_oc=Adqlhkj5g5vRxtGpzVwE01R3zzLiy8zgPPab9nGWNvD4i_I1xfNs_7lsCLpAgp4KPWc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkGGrC1EB7KviPRaPRfTAdhaBs1QR5Mx7QCHpJdoPkkw&oe=6B09CB4E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPO8QV9oPxUQ7kNvwFK2go9&_nc_oc=AdoqBg_18MA3_cDZHh3k-vVUar7KZ10FMp1zAMWPyEXeb0tGTYUu7jFWgJ8WIKjXTUA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0iF0zq0sdfcIzkUWWvsm-dOyyG0hNLdKEn_TdRejzHA&oe=6B09BE16"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_D5wPvADucQ7kNvwErtVTx&_nc_oc=AdpJvBdoJF0uQIjY6IEh1sgIcdsH74NZVl2OAUxSJambbhG7QN1ady8yAtOcNpwHYEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOu6u70cjQ_OyMeEFxoTHO8Kvft0w1w4nwgpyNXeSsSw&oe=6B09B54B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cQrfQwjwWAQ7kNvwGP5g9M&_nc_oc=AdpRqCCtaq18iCOC_ZSl-ob3i-RbGwd936SOhIptWi7SrzmcGxIgEd4Jv6x-EpuoN88&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbE9YcyhOg4lTS0aaRfSuoE8N6fNcNxbByd18Y0lYRAQ&oe=6B09A5DC"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_po
-sea5-2.oculuscdn.com/v/t64.5771-25/499623512_1793469651787388_2721743605433659327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VtiMi92_A8Q7kNvwGc90A9&_nc_oc=AdocvNZihOJH_2JHPklVZpSQF3-zjhfviMwMq1pWvo-iTv1-5ncy3tV4G5zCNzSOKvY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRatmJPmyG1DFPW9rRM5Xge1UKJPYdSTzN8sdtVVonQag&oe=6AFF30E2"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdTktuzgtOUQ7kNvwFid_9e&_nc_oc=AdpZxsrqKqytHQ7-is9NqmIj05AU8WzhkQ6dotIMrH__o_uW9jXe7b9dHi7lxdtvy4E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_lHp3XtaNWBTyQw0KyVNny1S_NyuybVpiGQ1s4ei2_A&oe=6AFF070E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=979c2AptBVwQ7kNvwE5BKW2&_nc_oc=AdretiCOROTzT-5OGAPJmTQe9HGo9NMRVERNeuW0rwFH8dz2msTVnkv36yeAIE52pOs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQG58DNPVcMKFjrGBUPjmLVupxOsRJLxMqCZmtnxcxU4Q&oe=6AFF3216"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmBKjLlE41cQ7kNvwH_F6GI&_nc_oc=Adr1rfuHADTSuz-JhSUq6QZP1QT_gJpgLKbLrGkVTWQmXtSYjO4J7Wxhk0FbWujiSgY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfR5U6yY1geJfY0zusgDQugDBH-knN_C8WFKm4A3CRWw&oe=6AFF294B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptlFe1kW9BwQ7kNvwEiStGO&_nc_oc=AdqKpa-u-YObOAY84TFd5fYPHwXi2hhscXLsK1EFLMdeGWIZJxTzyObsx5iQ59Oyo7A&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRfFveRHFolmdsm1AqtzKMAHkEpREX496jM6tRny9vNZQ&oe=6AFF19DC"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_po
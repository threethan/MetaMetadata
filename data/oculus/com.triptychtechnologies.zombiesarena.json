20f&oh=00_AQRrCEUs1rORMgiNBBaY0R-LXIoak3Y0qrbzn2UPu38n1g&oe=6AF9EAE2"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8Ip_AToRfkQ7kNvwE_o2PL&_nc_oc=AdrN39RunozdXjlTMAQzrjMbWE6ipIEEEa85KG_DMauVfxTLQb6VtIimCiqmPKE_u34&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXv08_vzujGEyazcPzV7xoRgDo1xsKsmyGRm6viiaFwA&oe=6AF9C10E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qh9KysQajtAQ7kNvwHdZkfk&_nc_oc=Adpy1n7LNIY5PkN5hsxlIg85EYxkfMLWDlLe6oFzmELCVSI9EsqIa_Da_wRMBwFaPB0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWxfBYgF2xigDMTtRWtsnghm30aoH_9kIM_DYX4IuOHA&oe=6AF9EC16"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8le7hWZD34Q7kNvwEWLIkI&_nc_oc=AdqvhMY_yHTBER8fHrcxlMa3oSSQsOgjpj63DdM6jgllBPxiQXCKu9jQBtLprwMEJiI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQResRe4kXoPnfe6XMWYQjuezj90kJL5foQBtqsnUD36Ww&oe=6AF9E34B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C1E6S7OdjaUQ7kNvwGO9aI_&_nc_oc=Adr_LiijfVSWk7bB7-fyxshtw3H4MwrFT8CQbrJif6Pik3AdCQKQkKROkgGpC_gcVzE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1mrlZu9_Pxw4lb23QxIZDUjtzpt6wiLdjwVasMdzg5w&oe=6AF9D3DC"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sl1nk.com/elk7h1g", "developer_terms_of_service_url": null, "publisher_name": "Triptych Technologies Pvt Ltd", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813
-lga3-3.oculuscdn.com/v/t64.5771-25/499623512_1793469651787388_2721743605433659327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQXB734hUtUQ7kNvwHyvCoW&_nc_oc=AdrZKrULqadyb_CYg84Pmqn3ET1s5ObT4ojH_1bLnhn0R_gya8CFKTvbqyapHTmsLic&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoiHY3CNZaIMJKEWz9TO0qaMer4YlBmycvl8fIZtHarA&oe=6AFB3C62"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J8Ip_AToRfkQ7kNvwHbRn6S&_nc_oc=Adr2ldcpX1ijk-wmf6Ot5RmGYHiNB2LR8lHzGty7hA1uQBVVdyfdKrDTMdgWnipGGcg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvHqYTr9vDy6IMMF6XyyvjoOjLp42WlOD5Q-lA0jGnPQ&oe=6AFB4ACE"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qh9KysQajtAQ7kNvwGaQFKm&_nc_oc=AdrUrhPhR5PIrKc3nDtemBGWTrIvBhkUKsI3VnjEE0lgh-WBWzXwmJPrCOUfuUmVEqA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ5GErsJo6aaT0-6gyJ_U9_EaPUO1AfQzsQMe9G4bHq2Q&oe=6AFB3D96"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8le7hWZD34Q7kNvwFBtfwW&_nc_oc=AdqiAr079mpTT2FYN_BZB2fYrwXxHrVMm49qTJRz8geYGnwc_X3vutf9DoZUSTTkoM4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAjbnpSk9189_HGkWWMq55VuGr6mo0XUbONSzeElDR4w&oe=6AFB34CB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yl3JLUQaF7UQ7kNvwFTAuK_&_nc_oc=AdqHvb7SZs90RopUhC_Fu_pDJmJV2d6W_vc0GTDljQl9fjq2Y0AjgwO1sLxzAqhCglc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzqJs7ztws7FDdAuZqD-qOn-YcTnIUi1j1n0k77S6-dg&oe=6AFB255C"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_po
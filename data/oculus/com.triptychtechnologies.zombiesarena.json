-iad3-2.oculuscdn.com/v/t64.5771-25/499623512_1793469651787388_2721743605433659327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK2zrFJYWqgQ7kNvwEPXGhP&_nc_oc=AdrjTPiRADNCAHBNUfOqOHpUMQZRDtc1Bc9kIuVFKiZBmjazlOY9HxHNQTagMJUbrYo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQHRdRsoGMplvW40t_hiY-t84guCGyp5FGKGmmwgjkGnw&oe=6B0C5FE2"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0x3tUCxtLYQ7kNvwE9XxUp&_nc_oc=AdoF-88yg0rt4oZoHDDHCWIXqkTHzAR_4UZ5atJKt4IapWRAUpEhEiYn592fU7duWk0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSV1o3h4eDWECp7u57mN4D_tiWeLTxJTaItqBtnKprrvA&oe=6B0C6E4E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPO8QV9oPxUQ7kNvwHmdF5c&_nc_oc=AdrfTwAm-p8rbXwnSk3o689HVyN2Gjx1Z07NaJwQOEX2ZmKFlkZNIn40RpgdaxaGB-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS62fCLZnWYXVgd5tmNUF73LqbqV4OAyBsq3w5S1du3UQ&oe=6B0C6116"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTx9G8YRbBcQ7kNvwEMPMcY&_nc_oc=AdqZQX9-m8uKrqhEq2s_0Xh0r6EidBRc950Hyb3hDqmdHm5lD30q4ZzoAy5MrIemPhA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQQPRXeKtj32yOVxjMs2xxqn18rjBv8XhXk49xBRIsyZg&oe=6B0C584B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NZRumV1fL4UQ7kNvwEnxU6N&_nc_oc=AdrHx74Pjv_F_q6S6UjKKQu8RVI9iSM9J_hFKHKR6FJoMoO-9ddGSAcDcZH0SMdZu5c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQKmCwSteZTRXRoEuQuAo3YzmppPOhZq_vL3I9zX0qknA&oe=6B0C811C"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_po
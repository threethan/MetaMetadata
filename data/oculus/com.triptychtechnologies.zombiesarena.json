20f&oh=00_AQTL5txKjkzazd0VKjJF3d162wCp2Mp_63rVmIVmaSvZsw&oe=6AF35362"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_t4lvTLN4vUQ7kNvwFC_itv&_nc_oc=AdrsbtTJ3bpxCG_52e9Q8vkRxnWmSqh1gGFxTgE-7ewUKl3lrzDdJMM2QxX8kxvR4iQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8IcObLFfB_2v_XzPHhbrD2xflJOpG7OqB9tWUYhNkVQ&oe=6AF3298E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z6QWF8lZTNkQ7kNvwGYbmFc&_nc_oc=AdpzXCTUM9OgAZzZ8uFX_sVH_vDQbF9vWjyiw2rYQMaCPJc3eTsZJpMpmj6KJ2KfgR0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWfejDixSyF-SIgD7VCwyH_YoyjxeaezxuGRPweE4i1g&oe=6AF35496"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QBYMd_QjguAQ7kNvwF0Ceho&_nc_oc=AdrJxvCBjSfJ7aB7K7V0sLbKMvSumdxlEBOOW_fzmSD_gee4svYsDUZPGOqe9SubuGg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTdU5dAQ7hUo7IqOPvRB3XbQ9T-lNLSlupb7H6bhZJJcg&oe=6AF34BCB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z1XT418Uw_gQ7kNvwFgMH8H&_nc_oc=AdrkxKWIM9sl0PnURyObF2uJyOdgF7R6ilS6_52duEWC-_UBTqHXBtSJenkJPZA11zw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKkDs4MGaPVFh2pk2ZuPm_xfMRRFvNQOkF52ft3xj_ww&oe=6AF33C5C"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sl1nk.com/elk7h1g", "developer_terms_of_service_url": null, "publisher_name": "Triptych Technologies Pvt Ltd", "support_website_url": null, "website_url": "https://www.triptych-technologies.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813
-iad3-2.oculuscdn.com/v/t64.5771-25/499623512_1793469651787388_2721743605433659327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RO5-SbymAw0Q7kNvwHRpvbT&_nc_oc=AdqjDCUArnNZhtEBa0A8wloGpA0WPXpTd4TpaJSzVlfGZxutYui9xM5AosYCVwm2q_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXW4LuzccTg_jvdBvbNZ3RpWRGvJiy6BnWriokl3iJt3g&oe=6B0F02E2"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0x3tUCxtLYQ7kNvwHecO77&_nc_oc=AdrQ_YhGM01m9fidnQfJVk8szdk0pz2cLA0akKxCgNi0Ws4NP3uVAQNhNnwX6Sml6kM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVYgxRUmSPT7mhaEkWbui2oxlsSm7cWG1XRjcM47EBw2w&oe=6B0F114E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JrjB81VB6cQ7kNvwHt5_iN&_nc_oc=AdqPHAaDgUddh1sJlAZhX-7bZ15wGxTa__FKHUwblhqzowbKmH6W6jRzWQ5jXgaqAbo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX8Hghab05pGJQejRbrZ803nlRG4_pjrc8giWetPe15zw&oe=6B0F0416"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bTx9G8YRbBcQ7kNvwFvMvAX&_nc_oc=AdpmAV7RZ97GNT_CmDTasp_ofXbGeB6QSHyr9cKkVOwgQwfQMyC0vPF6W0_zxQ-BpnA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX3UxY-R7dhIMc69DNxuBJLEWzxQNpd2feALM3WLCtxrQ&oe=6B0EFB4B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7KDHKfgaPaQQ7kNvwEpc2iI&_nc_oc=Adq2dEHZOSopU73ZEl_2apsl85Mj6dWE1T1PThpuFeQcyvstwyom6v9C0LBu2QO8bUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV0Mo4H-6hc-I8LjhNx1bDiNFHFhFw4PgvoRQqDpHvs-g&oe=6B0F241C"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_po
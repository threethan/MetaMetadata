-iad3-2.oculuscdn.com/v/t64.5771-25/499623512_1793469651787388_2721743605433659327_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0VtiMi92_A8Q7kNvwEaEkGE&_nc_oc=Adr0wAsTg0ZRuNrUDNI2cbDjIOfD68VM6l07c617wbKHkI1zfISfDjoQMhV79AnbXv8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRtvKjBs_Dt9YVwtWvr4Kf0gPJ24Zxm20ktOfs-t9j9FQ&oe=6B008262"}, {"file_name": "ZombieArena (3).png", "id": "1557727165557400", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619382_1557727168890733_5537396341465727627_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zJsOymiqFcQ7kNvwGQGJJg&_nc_oc=Adot3JQyspf8j9A4Nqokro1thSUHHCPN0qn50sGAnoiZ4aEtAnlF1DZ9FTZoSnKyTbI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE_IVOQvhY9xdp1se3YXxB_nUOiUehtiFLzbNxTttViw&oe=6B00588E"}, {"file_name": "ZombieArena (4).png", "id": "2295322097885935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622916_2295322107885934_3526111232110423805_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=979c2AptBVwQ7kNvwFaBrxx&_nc_oc=AdqawfjFvtYeO1W1gRPRvU-6bdKvb8YS7IhOIPLv7KDpP7qId8qxUhvOmZhXDsIltY0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTb8sQnjOtr11qieGHKy4bYcGCS18QZrkrHYj-dZexJrA&oe=6B008396"}, {"file_name": "ZombieArena (5).png", "id": "1973847879950044", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499623131_1973847883283377_6833158800952351249_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EZc0LUiGrZwQ7kNvwHBgw61&_nc_oc=AdpNqbsu-fyWFZEiTt2mL_kpk_Hiwkm76M48SJRqpKKhA5nD70OcqqEOtF8AF2MWUt4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPBQvDYAIwILDDGOcVmIbXqq1HFh0eJkPLIPve0W1e6g&oe=6B007ACB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Zombies (3).png", "id": "1759325818629723", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823802_1759325821963056_2990637514169877422_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptlFe1kW9BwQ7kNvwF7xRaT&_nc_oc=AdqseffjCpQkf6wd1JVLs7A4hlUC0ClhxIAncfsp-jEo3NKjvaQo5hHYi0b1U_0ehUw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQcCBwbiNBFEJRo1zT2dhNgDiTIfuQpolVSmVG1jxakw&oe=6B006B5C"}, "display_name": "Zombie Arena", "keywords": ["zombie", "zombies", "zombieshooter", "VRzombiegame", "VRshooter"], "long_description": "# Zombies Arena\n\nStep into **Zombies Arena**, an action-packed VR survival shooter where every round becomes more dangerous.\n\nFace relentless waves of zombies, adapt to increasingly powerful enemies, and fight for survival using a growing arsenal of weapons.\n\n## Features\n\n* **Wave-Based Survival** \u2013 Survive escalating rounds filled with increasingly dangerous zombies.\n* **Multiple Weapons** \u2013 Use pistols, SMGs, laser weapons, flamethrowers, rocket launchers, landmines, and more.\n* **Powerful Enemies** \u2013 Take on different zombie types and deadly high-level enemies.\n* **Kill Streaks** \u2013 Chain together kills and build impressive combat streaks.\n* **Weapon & Item Drops** \u2013 Earn new weapons, ammunition, health, and equipment as you survive.\n* **VR Combat** \u2013 Aim, shoot, reload, move, and fight directly inside the arena.\n* **Increasing Difficulty** \u2013 Every round pushes your reflexes, accuracy, and survival skills further.\n\nHow long can you survive when the arena is surrounded by the undead?\n\n**Grab your weapons. Enter the arena. Survive the horde.**\n\n## Zombies Arena\n\n**Survive the Horde. Master the Arsenal. Dominate the Arena.**\n", "short_description": "Survive relentless waves of zombies in an intense VR arena shooter. Fight with pistols, SMGs, lasers, flamethrowers, rockets, landmines, and more as each round grows deadlier. Build kill streaks, defeat powerful enemies, and prove how long you can survive in Zombies Arena.\n"}]}, "developer_name": null, "developer_privacy_po
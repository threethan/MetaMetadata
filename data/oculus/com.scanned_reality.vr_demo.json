metric videos. It contains a dancing demo clip and a fashion demo clip that play after each other. The app controls are as follows:\n\n- Move a controller while holding the grip button to drag the video.\n- Rotate a controller around itself while holding the grip button to rotate the video.\n- Click the trigger button to toggle the user interface and to click user interface elements when hovered.", "short_description": "This is a small tech demo for ScannedReality's volumetric videos. It contains a dancing demo clip and a fashion demo clip that play after each other. The app controls are as follows:\n\n- Move a controller while holding the grip button to drag the video.\n- Rotate a controller around itself while holding the grip button to rotate the video.\n- Click the trigger button to toggle the user interface and to click user interface elements when hovered."}]}, "developer_name": null, "developer_privacy_policy_url": "https://scanned-reality.com/privacy_tech_demo", "developer_terms_of_service_url": null, "publisher_name": "ScannedReality GmbH", "support_website_url": null, "website_url": "https://scanned-reality.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1280625946144720"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974466_605442518204097_5009893282237016690_n.png?stp=dst-png_s360x
.oculuscdn.com/v/t64.5771-25/38974537_773298867738627_5437829185415531227_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c9JZeXSjcPQQ7kNvwFaRdI-&_nc_oc=AdoXXWDFBEYFol5RyPPIiLjKF3FFJ5fegnse6paazikjy_2BnXKw8oZqIUmUuHc63AU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTT0vtYxeevAAShigK_QucSmi-cZA6v_3-S1YEjOnFgfw&oe=6B008203"}, "display_name": "ScannedReality Tech Demo", "keywords": [], "long_description": "This is a small tech demo for ScannedReality's volumetric videos. It contains a dancing demo clip and a fashion demo clip that play after each other. The app controls are as follows:\n\n- Move a controller while holding the grip button to drag the video.\n- Rotate a controller around itself while holding the grip button to rotate the video.\n- Click the trigger button to toggle the user interface and to click user interface elements when hovered.", "short_description": "This is a small tech demo for ScannedReality's volumetric videos. It contains a dancing demo clip and a fashion demo clip that play after each other. The app controls are as follows:\n\n- Move a controller while holding the grip button to drag the video.\n- Rotate a controller around itself while holding the grip button to rotate the video.\n- Click the trigger button to toggle the user interface and to click user interface elements when hovered."}]}, "developer_name": null, "developer_privacy_policy_url": "https://scanned-reality.com/privacy_tech_demo", "developer_terms_of_service_url": null, "publisher_name": "ScannedReality GmbH", "support_website_url": null, "website_url": "https://scanned-reality.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended
p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t69pzdfqt3cQ7kNvwEbiU2G&_nc_oc=AdpQDYdaiDXuyOMNdrgQCemAwiuPKiUoL-xmp-RUqf6Daksx15dWyqOwCj94UzSbZ_w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVTWJsOQnbRCfUEq-IONCqrlv-4wYAGHJfcr9mHI019zA&oe=6B1037B9"}, {"file_name": "2025_08_14T10_56_32_000Z.png", "id": "813457164412205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822897_813457167745538_8014275553377083693_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VPTFF079bFsQ7kNvwGIQZvF&_nc_oc=Ado2mX38tcOt_jCqTFr5QnvJJvZK4_uWe4qdOzkLfonGT8rjhLE9D8IsReYMDDBH-Uk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWi4y8VmgNR43y_cvHJxom2B11mkrFaMtgQvbjkw7YoIg&oe=6B105935"}, {"file_name": "2025_08_14T10_57_37_000Z.png", "id": "1488938728978297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_1488938732311630_1761406613498481697_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2C0yUPuN1ZQQ7kNvwEBHb7t&_nc_oc=AdrUaQp_fCk1fjKG3r4j_NM1Npu2NBgNqzTZuncXaUm_Cl72uMnVZIZJ9h43Z8ZANGA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWHSOcuU2pgFTaMFAEtKG04NO-9DjUfQ7zbOr3WUY7GAQ&oe=6B104BFE"}, {"file_name": "2025_08_14T11_00_35_000Z.png", "id": "617881834714241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822897_617881838047574_1344351920777635266_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NB-emHiQSEQQ7kNvwGgHisU&_nc_oc=Adq5-HDoyKDRUhO2l0cqDbdboCCMFh_Z7a18RUMN3K6I-w_irFh5U96fm_tkURlUVvQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUcPunEPwffKxdGS4R_Uw9nanqgIpIZVvxlAORZ3haPeA&oe=6B105EE9"}, {"file_name": "2025_08_14T11_14_49_000Z.png", "id": "1228567169021536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822034_1228567172354869_9107760783255308761_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-srXQtQxXoQ7kNvwFVNk8A&_nc_oc=Ado69aTXAOloagjUUlV8AN4i0ljE2xTEmP_7QT-ZzJxNwxQ2WtR-j2DXlZ6EMTJxjbY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU6ZaBUa8PQfk-BraseIPncZHxRiVuXkBJEu03ZqmWK2w&oe=6B10577A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mockup_store_capsule_main_nofont.png", "id": "2310533302678158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_2310533306011491_3620319197284353638_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0tQT98UXucQ7kNvwEQwyQb&_nc_oc=AdpLq5dRs3HgwwUyWTjbRueYvizGFqUIBFtk0X5FqFpAWukLIDARCDsRCDdcuW3btKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXhrpXnLXIDA33_369p40-OQiLKKj3BHL__a_WLR9-iCQ&oe=6B104397"}, "display_name": "Carbon Dreams Land", "keywords": [], "long_description": "Carbon Dream$ Land isn\u2019t your average VR game \u2013 it\u2019s a wild, satirical rollercoaster through the absurdities of the fossil-fuel era. Step into an over-the-top theme park where oil, coal, and gas are celebrated like it\u2019s 1950. But there\u2019s a catch: the show is run by Donnie Dino \u2013 a fire-breathing, gold-tie-wearing tyrannosaurus with an ego as big as his CO\u2082 footprint.\n\nTogether with up to three friends, you\u2019ll dive into short, punchy missions (10\u201315 minutes) that mix fast-paced action with sharp climate satire. Your mission: blow up oil rigs, dodge diesel-powered drones, expose fossil-fuel propaganda, and turn scrap into shiny wind turbines. Armed with futuristic tools, quick reflexes, and the guidance of a rebellious scientist, you\u2019ll fight through arenas packed with traps, explosions, and ridiculous characters.\n\nFeatures:\n- Cooperative VR action for 1\u20134 players on Meta Quest & Steam VR\n\n- Short, replayable missions \u2013 perfect for quick sessions\n\n- Unique gameplay mix of destruction and rebuilding\n\n- A spectacular boss fight against Donnie Dino, the fossil-fuel showman\n\n- A colorful, exaggerated world that\u2019s as funny as it is fiery\n\nThe world\u2019s on fire \u2013 so grab your friends, strap on your headset, and make fossil fuels NOT great again.", "short_description": "Welcome to Carbon Dream$ Land \u2013 the theme park where fossil fuels are made \u201cgreat again\u201d! Team up with up to 3 friends in this fast-paced, satirical VR action game. Blast oil towers, turn scrap into wind turbines, and dodge diesel drones in intense 10\u201315 minute missions. Face off against Donnie Dino \u2013 a gold-tied, fire-breathing tyrant with an ego the size of his CO\u2082 footprint. Save the planet, one explosive mission at a time!"}]}, "developer_name": "Pixelcloud GmbH & Co. KG", "developer_privacy_policy_url": "https://pixelcloud.de/data-protection-carbon-dreams-land.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelcloud GmbH & Co. KG", "support_website_url": "https://pixelcloud.de/", "website_url": "https://www.pixelcloud.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24428480926803067"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1834672997393782"}]}, "baseline_offer": {"id": "1834672997393782"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 
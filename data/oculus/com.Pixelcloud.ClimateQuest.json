p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y96-d9HOJDIQ7kNvwHcHfsj&_nc_oc=AdrQd1KHrvYzLH_gvN4pXKlClfoeVPKqdOa6wxrawRkLzqLTtIjOctGRnoMB-qQl7hc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQwbiIkPfxc8m2BPXssmQ4mzzXuKzooXSYnv36z54bZjQ&oe=6B01EF79"}, {"file_name": "2025_08_14T10_56_32_000Z.png", "id": "813457164412205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822897_813457167745538_8014275553377083693_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2xvZN2nq-QQ7kNvwGo-DiM&_nc_oc=AdolOa_LFGHaD_aqcp8J_RUvcVFrZAYvx-tAmRjGAeQ3ahdcXCafk0KTGBof7q1_wt4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqmIUP7RsVYSll5PWwIQPF9rZm2mTu_bJVRrYZdd7s0w&oe=6B01D8B5"}, {"file_name": "2025_08_14T10_57_37_000Z.png", "id": "1488938728978297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_1488938732311630_1761406613498481697_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44BvU_qHDUYQ7kNvwH16ME8&_nc_oc=Adp5Ms7qK8wqpR_R--MymJD0IL3WSBdFsMkHdvO_fmICJB0Cs6Qgm_tAHxI9R3gdAdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSFtl6vRqlxM9RWsFogmo5dYPpeRkfIB6fniC4wS55hVA&oe=6B01CB7E"}, {"file_name": "2025_08_14T11_00_35_000Z.png", "id": "617881834714241", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491822897_617881838047574_1344351920777635266_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KeELrwMDGRQQ7kNvwHlYcKs&_nc_oc=Ado_LYxsqjnQwmDwOqZNUMREgaZ2GTPVdEjwimhljIQAhfYEsHVBlHiE0kM-JetQu5Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDhuzz2BLuunuuMauhYF3BQqWOeH1s2eYMKrWRFaMtVA&oe=6B01DE69"}, {"file_name": "2025_08_14T11_14_49_000Z.png", "id": "1228567169021536", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822034_1228567172354869_9107760783255308761_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWAGJE8WeJ4Q7kNvwFkPccC&_nc_oc=AdqhsVbM1pwlRfUEdX1fuNZOQ_8YpJxna2vAZ_cJ9y2yMz9LGUDEzLXgNwuzgC7wkq8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPesxLnsx7SoBoxc_PxpCv-9RPjzxPGtksq_-ggLQATQ&oe=6B01D6FA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mockup_store_capsule_main_nofont.png", "id": "2310533302678158", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310731_2310533306011491_3620319197284353638_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvnNNWoxfcgQ7kNvwFdA1WI&_nc_oc=Adp1K4H-InbekHpyaPgsQ88osse-ZnLibyFBRzQp2buNazJqLaFpRSC4Z0-_oXYnGcE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJ0Ewfvj8F5VCg7OWhXy2JHbT1p_6BUE7VROugoZcOIg&oe=6B01C317"}, "display_name": "Carbon Dreams Land", "keywords": [], "long_description": "Carbon Dream$ Land isn\u2019t your average VR game \u2013 it\u2019s a wild, satirical rollercoaster through the absurdities of the fossil-fuel era. Step into an over-the-top theme park where oil, coal, and gas are celebrated like it\u2019s 1950. But there\u2019s a catch: the show is run by Donnie Dino \u2013 a fire-breathing, gold-tie-wearing tyrannosaurus with an ego as big as his CO\u2082 footprint.\n\nTogether with up to three friends, you\u2019ll dive into short, punchy missions (10\u201315 minutes) that mix fast-paced action with sharp climate satire. Your mission: blow up oil rigs, dodge diesel-powered drones, expose fossil-fuel propaganda, and turn scrap into shiny wind turbines. Armed with futuristic tools, quick reflexes, and the guidance of a rebellious scientist, you\u2019ll fight through arenas packed with traps, explosions, and ridiculous characters.\n\nFeatures:\n- Cooperative VR action for 1\u20134 players on Meta Quest & Steam VR\n\n- Short, replayable missions \u2013 perfect for quick sessions\n\n- Unique gameplay mix of destruction and rebuilding\n\n- A spectacular boss fight against Donnie Dino, the fossil-fuel showman\n\n- A colorful, exaggerated world that\u2019s as funny as it is fiery\n\nThe world\u2019s on fire \u2013 so grab your friends, strap on your headset, and make fossil fuels NOT great again.", "short_description": "Welcome to Carbon Dream$ Land \u2013 the theme park where fossil fuels are made \u201cgreat again\u201d! Team up with up to 3 friends in this fast-paced, satirical VR action game. Blast oil towers, turn scrap into wind turbines, and dodge diesel drones in intense 10\u201315 minute missions. Face off against Donnie Dino \u2013 a gold-tied, fire-breathing tyrant with an ego the size of his CO\u2082 footprint. Save the planet, one explosive mission at a time!"}]}, "developer_name": "Pixelcloud GmbH & Co. KG", "developer_privacy_policy_url": "https://pixelcloud.de/data-protection-carbon-dreams-land.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelcloud GmbH & Co. KG", "support_website_url": "https://pixelcloud.de/", "website_url": "https://www.pixelcloud.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24428480926803067"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1834672997393782"}]}, "baseline_offer": {"id": "1834672997393782"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 
=1-7&_nc_sid=6e7a0a&_nc_ohc=sQz3CfUilt8Q7kNvwHYZrYz&_nc_oc=Adq5fulUtnC4tUVbptJ7zEBJcPStLbnb7lm2gaaBZlm-K3549ZsFaIKRmjhGKykkQfU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8n5ETmZqjK75XxAKZI_BWMt4mCj9Ojqi04OhgZ8XqlZw&oe=6A465E3E"}, {"file_name": "2025_08_14T11_00_35_000Z.png", "id": "617881834714241", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491822897_617881838047574_1344351920777635266_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEF_hrfIUAoQ7kNvwEEHUUp&_nc_oc=AdqW2EfBVxEy3DPu76YCqiec2iR6pcVvMQbYiIeA7yl1lkNvXHN1YzI0LsUuN1_3-r8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_n7BtjIc335XN_ba4hcAIaFD2g3dWrCUP_5mloW2pmmg&oe=6A467129"}, {"file_name": "2025_08_14T11_14_49_000Z.png", "id": "1228567169021536", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/491822034_1228567172354869_9107760783255308761_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6uX7sM_yMEQ7kNvwEOum9p&_nc_oc=AdpEFEgnaj0QUwcrn67n-44jyqE9VUJhXbJ0Tg_abRTICGADGwvWZGaJx3izTkUapAc&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Nj5mbZ1B6bmk7Gl9k8h0s2OsPXrPYbJL3zAnlvfjhdA&oe=6A4669BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mockup_store_capsule_main_nofont.png", "id": "2310533302678158", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499310731_2310533306011491_3620319197284353638_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V-xQFV1mOEkQ7kNvwFkldjv&_nc_oc=Adpp-OAqKDS9Dy17jyfRWfuZ2Sf0FwVKCPJ5dfayUlB8kl7D3v3Ah8pd4EuGVjLJ5HQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Mnn5eljimRoTEN5-Q9CESpuhSUB1nAiDwHn-aGazB8A&oe=6A468E17"}, "display_name": "Carbon Dreams Land", "keywords": [], "long_description": "Carbon Dream$ Land isn\u2019t your average VR game \u2013 it\u2019s a wild, satirical rollercoaster through the absurdities of the fossil-fuel era. Step into an over-the-top theme park where oil, coal, and gas are celebrated like it\u2019s 1950. But there\u2019s a catch: the show is run by Donnie Dino \u2013 a fire-breathing, gold-tie-wearing tyrannosaurus with an ego as big as his CO\u2082 footprint.\n\nTogether with up to three friends, you\u2019ll dive into short, punchy missions (10\u201315 minutes) that mix fast-paced action with sharp climate satire. Your mission: blow up oil rigs, dodge diesel-powered drones, expose fossil-fuel propaganda, and turn scrap into shiny wind turbines. Armed with futuristic tools, quick reflexes, and the guidance of a rebellious scientist, you\u2019ll fight through arenas packed with traps, explosions, and ridiculous characters.\n\nFeatures:\n- Cooperative VR action for 1\u20134 players on Meta Quest & Steam VR\n\n- Short, replayable missions \u2013 perfect for quick sessions\n\n- Unique gameplay mix of destruction and rebuilding\n\n- A spectacular boss fight against Donnie Dino, the fossil-fuel showman\n\n- A colorful, exaggerated world that\u2019s as funny as it is fiery\n\nThe world\u2019s on fire \u2013 so grab your friends, strap on your headset, and make fossil fuels NOT great again.", "short_description": "Welcome to Carbon Dream$ Land \u2013 the theme park where fossil fuels are made \u201cgreat again\u201d! Team up with up to 3 friends in this fast-paced, satirical VR action game. Blast oil towers, turn scrap into wind turbines, and dodge diesel drones in intense 10\u201315 minute missions. Face off against Donnie Dino \u2013 a gold-tied, fire-breathing tyrant with an ego the size of his CO\u2082 footprint. Save the planet, one explosive mission at a time!"}]}, "developer_name": "Pixelcloud GmbH & Co. KG", "developer_privacy_policy_url": "https://pixelcloud.de/data-protection-carbon-dreams-land.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelcloud GmbH & Co. KG", "support_website_url": "https://pixelcloud.de/", "website_url": "https://www.pixelcloud.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_c
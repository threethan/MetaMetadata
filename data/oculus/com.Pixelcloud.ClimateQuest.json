&oh=00_AQQVZqWrI4UPITLuWotom7fffcIHfT8JQmXrMkFX2ijt9w&oe=6AE75939"}, {"file_name": "2025_08_14T10_56_32_000Z.png", "id": "813457164412205", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822897_813457167745538_8014275553377083693_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKJRscjdmCwQ7kNvwFy_7e8&_nc_oc=AdoXd2GB4G6nOdUItC1U30Jtya4KwciCb_HFTZDjFtOay5_244JbhiiQ1A0gstatIs0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbTtYA503MgRsWXRK4MqKMh8qLaKGO60gwZPHmh9weaQ&oe=6AE74275"}, {"file_name": "2025_08_14T10_57_37_000Z.png", "id": "1488938728978297", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822817_1488938732311630_1761406613498481697_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FAhF7VaiPHsQ7kNvwGDU_lg&_nc_oc=Adoslpfc6mQPuBRqmkP5iZcMrqGPKUmpCyzV_jBGzkRN2uCiKqksvMYAjwjMi_3_WV4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNh1zcXoIDkZHU2oKLLOJwW5JZDJ2zPcoxTGpEj8FnNQ&oe=6AE76D7E"}, {"file_name": "2025_08_14T11_00_35_000Z.png", "id": "617881834714241", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822897_617881838047574_1344351920777635266_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FTd-hwq1vQQ7kNvwEYvm16&_nc_oc=AdrHMMMzd5dK2ixfFFfwEpPDQU6G8c6JmQfERQ9nIlRjs3KRTINesLozUeFX8pSelwA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNMtutw0zMRu5fiaDFmuqNcuB7jWvDXrFqSsk8ys6dHw&oe=6AE74829"}, {"file_name": "2025_08_14T11_14_49_000Z.png", "id": "1228567169021536", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822034_1228567172354869_9107760783255308761_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZz8Uq8lUVUQ7kNvwGl8PRj&_nc_oc=Adrk4vcbsh7UBARUn8tfVm63cZL9WGa6d8m_g9A3NfPclH3W1htPOVRDQnj7bsXplOI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKF6fuapSAVJjV5I2UcVKrRw-X2Cv5R6APmwcpNs4FBw&oe=6AE740BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "mockup_store_capsule_main_nofont.png", "id": "2310533302678158", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310731_2310533306011491_3620319197284353638_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ms96GO_xj70Q7kNvwEgypM8&_nc_oc=AdpF6tLwLNMq_MueCP1eLfhftqIUNg7Xb_ZKD3gr-2zzN_cPyJ-W7qvKBw5WIYSmc2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6GSb2Y6lS0InXTdFXel29cZrEU2NTyeFgH6HVla4iIw&oe=6AE76517"}, "display_name": "Carbon Dreams Land", "keywords": [], "long_description": "Carbon Dream$ Land isn\u2019t your average VR game \u2013 it\u2019s a wild, satirical rollercoaster through the absurdities of the fossil-fuel era. Step into an over-the-top theme park where oil, coal, and gas are celebrated like it\u2019s 1950. But there\u2019s a catch: the show is run by Donnie Dino \u2013 a fire-breathing, gold-tie-wearing tyrannosaurus with an ego as big as his CO\u2082 footprint.\n\nTogether with up to three friends, you\u2019ll dive into short, punchy missions (10\u201315 minutes) that mix fast-paced action with sharp climate satire. Your mission: blow up oil rigs, dodge diesel-powered drones, expose fossil-fuel propaganda, and turn scrap into shiny wind turbines. Armed with futuristic tools, quick reflexes, and the guidance of a rebellious scientist, you\u2019ll fight through arenas packed with traps, explosions, and ridiculous characters.\n\nFeatures:\n- Cooperative VR action for 1\u20134 players on Meta Quest & Steam VR\n\n- Short, replayable missions \u2013 perfect for quick sessions\n\n- Unique gameplay mix of destruction and rebuilding\n\n- A spectacular boss fight against Donnie Dino, the fossil-fuel showman\n\n- A colorful, exaggerated world that\u2019s as funny as it is fiery\n\nThe world\u2019s on fire \u2013 so grab your friends, strap on your headset, and make fossil fuels NOT great again.", "short_description": "Welcome to Carbon Dream$ Land \u2013 the theme park where fossil fuels are made \u201cgreat again\u201d! Team up with up to 3 friends in this fast-paced, satirical VR action game. Blast oil towers, turn scrap into wind turbines, and dodge diesel drones in intense 10\u201315 minute missions. Face off against Donnie Dino \u2013 a gold-tied, fire-breathing tyrant with an ego the size of his CO\u2082 footprint. Save the planet, one explosive mission at a time!"}]}, "developer_name": "Pixelcloud GmbH & Co. KG", "developer_privacy_policy_url": "https://pixelcloud.de/data-protection-carbon-dreams-land.html", "developer_terms_of_service_url": null, "publisher_name": "Pixelcloud GmbH & Co. KG", "support_website_url": "https://pixelcloud.de/", "website_url": "https://www.pixelcloud.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "2691890164460465"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "24428480926803067"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1834672997393782"}]}, "baseline_offer": {"id": "1834672997393782"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1763469720, "status": "PUBLISHED", "id": "1834672997393782"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24593681623616329", "version": "0.1.622"}, "id": "1006393601193335", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_bina
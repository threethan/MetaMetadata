.\nThese installations can take the form of intricate patterns.", "short_description": "\"Cryptic Tag\" A New Interesting Gorilla Tag Fangame"}]}, "developer_name": "Spool", "developer_privacy_policy_url": "https://docs.google.com/document/d/1pe_sesAGt-MzXJjGgV6Bylux52u_lfwc3zHPzO-Y26E/", "developer_terms_of_service_url": null, "publisher_name": "Fays", "support_website_url": null, "website_url": "https://html.cafe/x084f8f28", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9307884472644470"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622551_585706431230492_2124458112115217085_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dxi20GCBdswQ7kNvwEKdyKb&_nc_oc=AdoWk2GuO2KvdP4BRXxExrqct6EeDcbkyTNKW5p7pmU5ETT1A_ngd_w703ZIauqfP4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQa3RYoPq33d-80UFOC4y0YHy7nnmTGkZgRdUZ88LC4Q&oe=6A5B7DA0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Cryptic Tag", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Hangout", "id": "1023770785722696"}], "release_d
GrBhJuBUG88Q7kNvwGUq_im&_nc_oc=Adp8VoKFc7GSCQzttqEj4tZgcniqVwFscXKc0to9FvtJ4mFKVzz9LNlXcA2jKHlRhFw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af83vzn_kem8RWX0D_0SsBpm_m3lJs5GlCzHG8YPFTdZjw&oe=6A259E6D"}, "display_name": "Dark Den", "keywords": [], "long_description": "Dark Den: is Single Player, ARPG (Action Role Play Game), full of adventure, only possible in VR\n\nWelcome to Dark Den: Mystery Awaits. The Den is full of tasks, wicked and powerful enemies, it will take courage, strength, and survival instincts to defeat them.\n\nDARK DEN: delivers an unparallel experience with its unique environment. Experience the THRILL - Fall, Climb, Run, Jump, Trek, Dodge the snakes, take the ladders, fight the enemy, and save some lives. Collect the MYSTERY BOXES on the Board. UNLEASH THE BEAST. Use the weapons to FIGHT and win levels. ", "short_description": "HUSTLE, COMBAT, RELEASE. Dark Den: is Single Player, ARPG (Action Role Play Game), full of adventure, only possible in VR.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.darkdengame.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies Private Limited", "support_website_url": null, "website_url": "https://www.darkdengame.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes":
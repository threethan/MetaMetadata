100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fcVWMU9qUxUQ7kNvwGCeoIC&_nc_oc=AdloDnEihsVcX6nkK7w8FXaqhElLutbgCCo7N-1sq3-pA9rBtBjwFYfXYoBceTPfWVU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw4kmkIarb1jDc-N8_0dC2XeRgr-twDNL21blOTvCrVQw&oe=69BA86C7"}, {"file_name": "Untitled design (3).png", "id": "1204896881465489", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825470_1204896888132155_2155245264290217_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cZlPPEeeS5wQ7kNvwE3kVSs&_nc_oc=Adn-gRIDm55lUgs8DGBLcQH6ptS2CgYlGh29K8s9jNSBA3JizL1E4vvxLzl9l0sN-k0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwCuf1ZsPgeNXgg8GQqsp4amKwbHLBgK4WEz1jZjVeZmA&oe=69BAA410"}]}, "id": "4194163997498723", "locale": "en_US", "screenshots": [{"file_name": "vlcsnap-2025-12-16-12h48m29s254.png", "id": "2149348089138120", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822307_2149348092471453_7384423706674857351_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LvPjgl0iwmwQ7kNvwFxTpgH&_nc_oc=AdmJ8pbsswa7F4WlOYf5Gc9IagpwJ-A4Q9CO_gvFHJmjYRakmkvjCDbQGv1YWDyZJXE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afw1LOpGRvcwsEJP66xr-TNLjZL7euGFqpkhesmryFiaZw&oe=69BA866A"}, {"file_name": "vlcsnap-2025-12-16-12h32m40s405.png", "id": "932381719958549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499618064_932381723291882_7349274555890011686_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymZbudXmRjcQ7kNvwE9hrAl&_nc_oc=AdnmgKh2C2wItqxHC92i2os41OxrVBIiiv93pQ5BmoGG7QUeSbnOG1GWe0KnyfM70dA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afy3J-qzd3uNixC7z2fK8kgj78_VEL1ga_S3WFX9cI6coA&oe=69BA92AE"}, {"file_name": "vlcsnap-2025-12-09-15h40m48s078.png", "id": "1990737235042519", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820496_1990737238375852_5821069915937329317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftJDmmnqEKIQ7kNvwF_Is_N&_nc_oc=AdlVxvlB9wEM-nYVyWhg9b3svtwFS80mtxKKkTb5PnRaQTYRv0vRKOKMsyON2RRpipM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxQFYX92JG92Txdv4lvRYyDiNUDmRKO8Y6MUy-WcPEXNA&oe=69BAA214"}, {"file_name": "10.png", "id": "2036704133569202", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491818849_2036704140235868_1647752663797633777_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oNULtME4egEQ7kNvwETplzq&_nc_oc=AdlaecCu63sZjmYHXMyNVwOtQN3OY8o3luthU8ebBGkIMF5owPagAOk5x_me2-l2Bb4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxCKkZWQd28N_1lzcOAbyChANGIS9U_15mW-YaoUxWpUA&oe=69BA91C4"}, {"file_name": "12.png", "id": "2295336937655597", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823910_2295336944322263_7717276936021807718_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldN6suN9DOkQ7kNvwHCU_Xy&_nc_oc=Adkx4n2-FvY7-7aKDa8Q0ZMwKY1wUR1NAZqmgEeaJwDO3Sj434qZC_up-c23pPcUnEQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXUMvPzKEI_5H75sAynR6RkL2zJmE7zPU34TTxkxZvGg&oe=69BA9703"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "250925 Fixer KA new 260205_META 4 B.png", "id": "1034324279753727", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823366_1034324283087060_676395118583240566_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0JJwxGD10XYQ7kNvwHDUphp&_nc_oc=AdkqJUY1LHX8RuCGC0sS-c_SzCav3X9YbYw-xceAsCU2sfs_VwkcMq7BWmXh6RtCL4o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyvSaJOhQJbujccrYEaorGIRN_BfM2qTjvCaHME_dIHZA&oe=69BA8E0C"}, "display_name": "Fixer Undercover", "keywords": ["Puzzle", "Adventure", "Espionage", "DUO", "EscapeRoom"], "long_description": "\nForget the suit; grab your toolbox. As Agent 404, infiltrate Redemption Prison not with lasers, but with wrenches, drills, and grit. Every broken pipe and faulty wire is your cover. Improvise, adapt, and dismantle the system from the inside. No gadgets, just tools and skill.\n\n{1412744550259526}\n\n\nFIXER UNDERCOVER turns the prison into your puzzle playground. Grip a power drill and bypass locks. Use an angle grinder to cut through \"faulty\" vents. With realistic tool physics and haptic feedback, you'll feel every screw turn, every wire snap, every mechanism click.\n{1858028224836004}\n\nYou're not alone. Winston is your drone partner\u2014your hacker, your scout, your intel source. Leverage his skills,= and when the pressure's on, he'll come through. Probably.\n{861830766774015}\n\n\nRedemption Prison is a lie. Warden Kozlov's celebrated \"Born Again\" program turns hardened criminals into model citizens\u2014or so the world believes. Behind the miracle is a conspiracy funded by millions in shadow money.\n{1846686503390347}\nThe prison is one massive environmental puzzle, and you are the only one with the skills to take it apart. Observe the flaws in their design, improvise with your workshop gear, and combine elements to break the system from the inside out.\n{2675564446144117}\n\nYou're The Fixer\u2014a ghost operative hiding in plain sight as a maintenance worker. Your toolbox is your arsenal. Your cover is perfect. Nobody notices the handyman with a wrench. \n{870020845768229}\n\nInfiltrate. Impovise. Expose.\n\n\n", "short_description": "Other agents have gadgets. You have a screwdriver and your creativity. Step into the boots of Agent 404 in this VR adventure inspired by real escape room design. Undercover as Fixer, you must infiltrate Redemption Prison to uncover the chilling secrets behind the Born Again program. Solve intricate puzzles, improvise with your tools, and plan your escape before you become part of the system. In this prison, creativity is your only way out."}, {"images": {"nodes": []}, "id": "2340700353107703", "locale": "fr_FR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fixer Undercover", "keywords": [], "long_description": "\ud83d\udd27 Oublie le costard, prends ta caisse \u00e0 outils.\nEn tant qu'Agent 404, tu infiltres la Redemption Prison avec des cl\u00e9s, des perceuses et du cran. Chaque tuyau p\u00e9t\u00e9 et fil d\u00e9nud\u00e9 est ta couverture. Improvise et d\u00e9mant\u00e8le le syst\u00e8me de l'int\u00e9rieur. Pas de gadgets \u2014 juste du matos et du talent.\n\n\n\ud83c\udfae FIXER UNDERCOVER fait de la prison ton terrain de jeu. Prends ta visseuse et force les serrures. D\u00e9coupe les a\u00e9rations \u00abd\u00e9fectueuses\u00bb \u00e0 la meuleuse. Gr\u00e2ce \u00e0 la physique r\u00e9aliste et au retour haptique, tu sentiras chaque vis tourner, chaque fil casser et chaque m\u00e9canisme s'enclencher.\n\n\n\ud83e\udd16 T'es pas seul. Winston est ton partenaire volant : hacker, \u00e9claireur, source d'infos. Quand \u00e7a chauffera, il assurera tes arri\u00e8res. Probablement.\n\n\n\ud83d\udd12 Le programme \u00abBorn Again\u00bb du directeur Kozlov transforme les criminels en citoyens mod\u00e8les \u2014 c'est ce qu'on croit. Derri\u00e8re ce miracle se cache une conspiration financ\u00e9e par de l'argent sale.\n\n\n\ud83e\udde9 Cette prison est un immense puzzle. Tu es le seul capable de le d\u00e9monter. Rep\u00e8re les d\u00e9fauts de conception, improvise avec ton matos et brise le syst\u00e8me de l'int\u00e9rieur.\n\n\n\ud83d\udc64 Tu es le Fixer : un agent fant\u00f4me planqu\u00e9 \u00e0 la vue de tous en tenue de maintenance. Ta caisse \u00e0 outils est ton arsenal. Ta couverture est parfaite. Personne ne remarque un Fixer avec une cl\u00e9 \u00e0 molette.\n\n\n\u26a1 Infiltre. Improvise. R\u00e9v\u00e8le.", "short_description": "Les autres agents ont des gadgets. Toi, tu as un tournevis et ta cr\u00e9ativit\u00e9. Enfile les bottes de l'Agent 404 dans cette aventure VR inspir\u00e9e des vrais escape games. Infiltr\u00e9 en tant que Fixer, tu dois p\u00e9n\u00e9trer dans Redemption Prison pour percer les sombres secrets du programme Born Again. R\u00e9sous des \u00e9nigmes complexes, improvise avec tes outils et planifie ton \u00e9vasion avant de devenir toi-m\u00eame partie du syst\u00e8me. Dans cette prison, la cr\u00e9ativit\u00e9 est ta seule issue."}, {"images": {"nodes": []}, "id": "2173882796781115", "locale": "pl_PL", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fixer Undercover", "keywords": [], "long_description": "\ud83d\udd27 Zapomnij o garniturze \u2014 bierz skrzynk\u0119 z narz\u0119dziami.Jako Agent 404 infiltrujesz Redemption Prison nie laserami, a kluczem, wkr\u0119tark\u0105 i sprytem. Ka\u017cda p\u0119kni\u0119ta rura i lu\u017any kabel to Twoja przykrywka. Improwizuj i rozmontuj system od \u015brodka. Zero gad\u017cet\u00f3w \u2014 tylko narz\u0119dzia i fach w r\u0119ku.\n\n\ud83c\udfae FIXER UNDERCOVER zmienia wi\u0119zienie w Tw\u00f3j warsztat-\u0142amig\u0142\u00f3wk\u0119. Chwy\u0107 wkr\u0119tark\u0119 i rozwier\u0107 zamki. Szlifierk\u0105 wytnij przej\u015bcie w \u201ewadliwej\" wentylacji. Realistyczna fizyka i haptyka sprawiaj\u0105, \u017ce poczujesz ka\u017cdy obr\u00f3t \u015bruby, p\u0119kni\u0119cie drutu i klikni\u0119cie mechanizmu.\n\n\ud83e\udd16 Nie jeste\u015b sam. Winston to Tw\u00f3j lataj\u0105cy wsp\u00f3lnik \u2014 haker, zwiadowca, \u017ar\u00f3d\u0142o informacji. Kiedy zrobi si\u0119 gor\u0105co, wyci\u0105gnie Ci\u0119 z opresji. Prawdopodobnie.\n\n\ud83d\udd12 Program \u201eBorn Again\" naczelnika Kozlova zmienia kryminalist\u00f3w we wzorowych obywateli \u2014 tak my\u015bli \u015bwiat. Za tym cudem kryje si\u0119 spisek op\u0142acony milionami z brudnych pieni\u0119dzy.\n\n\ud83e\udde9 Wi\u0119zienie to wielka \u0142amig\u0142\u00f3wka \u015brodowiskowa. Tylko Ty masz fach, by j\u0105 rozpracowa\u0107. Szukaj wad konstrukcji, improwizuj narz\u0119dziami i rozsad\u017a system od \u015brodka.\n\n\ud83d\udc64 Jeste\u015b Fixer \u2014 agent-widmo ukryty na widoku jako konserwator. Skrzynka z narz\u0119dziami to Tw\u00f3j arsena\u0142. Przykrywka idealna. Nikt nie zwraca uwagi na Fixera z kluczem.\n\n\u26a1 Infiltruj. Improwizuj. Ujawnij.", "short_description": "Inni agenci maj\u0105 gad\u017cety. Ty masz \u015brubokr\u0119t i w\u0142asn\u0105 pomys\u0142owo\u015b\u0107. Wskocz w buty Agenta 404 w tej przygodzie VR inspirowanej prawdziwymi escape roomami. Pod przykrywk\u0105 Fixera musisz zinfiltrowa\u0107 Redemption Prison i odkry\u0107 mroczne sekrety programu Born Again. Rozwi\u0105zuj skomplikowane \u0142amig\u0142\u00f3wki, improwizuj z narz\u0119dziami i zaplanuj ucieczk\u0119, zanim sam staniesz si\u0119 cz\u0119\u015bci\u0105 systemu. W tym wi\u0119zieniu pomys\u0142owo\u015b\u0107 to jedyna droga na wolno\u015b\u0107."}, {"images": {"nodes": []}, "id": "1426529522535892", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fixer Undercover", "keywords": [], "long_description": "\ud83d\udd27 \u30b9\u30fc\u30c4\u306f\u5fd8\u308c\u308d\u3002\u5de5\u5177\u7bb1\u3092\u6301\u3066\u3002\n\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8404\u3068\u3057\u3066\u3001\u30ec\u30fc\u30b6\u30fc\u9283\u3058\u3083\u306a\u304f\u30ec\u30f3\u30c1\u3068\u30c9\u30ea\u30eb\u3001\u5ea6\u80f8\u3067Redemption Prison\u306b\u6f5c\u5165\u3057\u308d\u3002\u58ca\u308c\u305f\u914d\u7ba1\u3082\u65ad\u7dda\u3082\u3001\u5168\u90e8\u304a\u524d\u306e\u96a0\u308c\u84d1\u3060\u3002\u5373\u8208\u3067\u5bfe\u5fdc\u3057\u3001\u5185\u5074\u304b\u3089\u30b7\u30b9\u30c6\u30e0\u3092\u89e3\u4f53\u3057\u308d\u3002\u30ac\u30b8\u30a7\u30c3\u30c8\u7121\u7528\u3002\u5fc5\u8981\u306a\u306e\u306f\u5de5\u5177\u3068\u8155\u3060\u3051\u3060\u3002\n\n\n\ud83c\udfae FIXER UNDERCOVER\u306f\u5211\u52d9\u6240\u3092\u5de8\u5927\u30d1\u30ba\u30eb\u306b\u5909\u3048\u308b\u3002\u96fb\u52d5\u30c9\u30ea\u30eb\u3092\u63e1\u3063\u3066\u30ed\u30c3\u30af\u3092\u7a81\u7834\u3002\u30a2\u30f3\u30b0\u30eb\u30b0\u30e9\u30a4\u30f3\u30c0\u30fc\u3067\u300c\u6545\u969c\u4e2d\u300d\u306e\u901a\u6c17\u53e3\u3092\u713c\u304d\u5207\u308c\u3002\u30ea\u30a2\u30eb\u306a\u7269\u7406\u6319\u52d5\u3068\u632f\u52d5\u3067\u3001\u30cd\u30b8\u304c\u56de\u308b\u611f\u89e6\u3001\u30ef\u30a4\u30e4\u30fc\u304c\u5207\u308c\u308b\u77ac\u9593\u3001\u30e1\u30ab\u304c\u565b\u307f\u5408\u3046\u624b\u5fdc\u3048\u3092\u5473\u308f\u3048\u3002\n\n\n\ud83e\udd16 \u4e00\u4eba\u3058\u3083\u306a\u3044\u3002 Winston\u304c\u76f8\u68d2\u3060\u3002\u30cf\u30c3\u30ab\u30fc\u3067\u5075\u5bdf\u5f79\u3067\u60c5\u5831\u6e90\u3002\u8ffd\u3044\u8a70\u3081\u3089\u308c\u305f\u3089\u3001\u304d\u3063\u3068\u52a9\u3051\u3066\u304f\u308c\u308b\u3002\u305f\u3076\u3093\u306a\u3002\n\n\n\ud83d\udd12 \u6240\u9577Kozlov\u306e\u300cBorn Again\u300d\u30d7\u30ed\u30b0\u30e9\u30e0\u306f\u51f6\u60aa\u72af\u3092\u6a21\u7bc4\u5e02\u6c11\u306b\u5909\u3048\u308b\u2015\u2015\u4e16\u9593\u306f\u305d\u3046\u4fe1\u3058\u3066\u3044\u308b\u3002\u3060\u304c\u305d\u306e\u5947\u8de1\u306e\u88cf\u306b\u306f\u3001\u95c7\u8cc7\u91d1\u306b\u3088\u308b\u9670\u8b00\u304c\u6e26\u5dfb\u3044\u3066\u3044\u308b\u3002\n\n\n\ud83e\udde9 \u3053\u306e\u5211\u52d9\u6240\u306f\u5de8\u5927\u306a\u74b0\u5883\u30d1\u30ba\u30eb\u3060\u3002 \u89e3\u4f53\u3067\u304d\u308b\u306e\u306f\u304a\u524d\u3060\u3051\u3002\u8a2d\u8a08\u306e\u6b20\u9665\u3092\u898b\u629c\u304d\u3001\u5de5\u5177\u3067\u5373\u8208\u3057\u3001\u5185\u90e8\u304b\u3089\u30b7\u30b9\u30c6\u30e0\u3092\u7834\u58ca\u3057\u308d\u3002\n\n\n\ud83d\udc64 \u304a\u524d\u306fFixer\u3002 \u4fdd\u5b88\u4f5c\u696d\u54e1\u306b\u626e\u3057\u305f\u30b4\u30fc\u30b9\u30c8\u30fb\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u3060\u3002\u5de5\u5177\u7bb1\u304c\u6b66\u5668\u5eab\u3002\u5909\u88c5\u306f\u5b8c\u74a7\u3002\u30ec\u30f3\u30c1\u3092\u6301\u3063\u305fFixer\u3092\u602a\u3057\u3080\u5974\u306a\u3093\u3066\u3044\u306a\u3044\u3002\n\n\n\u26a1 \u6f5c\u5165\u305b\u3088\u3002\u5373\u8208\u305b\u3088\u3002\u66b4\u3051\u3002", "short_description": "\u4ed6\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u306b\u306f\u30cf\u30a4\u30c6\u30af\u6a5f\u5668\u304c\u3042\u308b\u3002\u541b\u306b\u306f\u30c9\u30e9\u30a4\u30d0\u30fc1\u672c\u3068\u3001\u5df1\u306e\u5275\u610f\u5de5\u592b\u3060\u3051\u3002\u672c\u683c\u7684\u306a\u8131\u51fa\u30b2\u30fc\u30e0\u306b\u30a4\u30f3\u30b9\u30d1\u30a4\u30a2\u3055\u308c\u305f\u3053\u306eVR\u30a2\u30c9\u30d9\u30f3\u30c1\u30e3\u30fc\u3067\u3001\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8404\u306e\u9774\u3092\u5c65\u3051\u3002Fixer\u3068\u3057\u3066\u6f5c\u5165\u3057\u3001Redemption Prison\u306b\u4fb5\u5165\u305b\u3088\u3002Born Again\u30d7\u30ed\u30b0\u30e9\u30e0\u306b\u96a0\u3055\u308c\u305f\u6226\u6144\u306e\u771f\u5b9f\u3092\u66b4\u304d\u51fa\u3059\u306e\u3060\u3002\u8907\u96d1\u306a\u30d1\u30ba\u30eb\u3092\u89e3\u304d\u3001\u624b\u6301\u3061\u306e\u9053\u5177\u3067\u5373\u8208\u3057\u3001\u30b7\u30b9\u30c6\u30e0\u306e\u4e00\u90e8\u306b\u3055\u308c\u308b\u524d\u306b\u8131\u51fa\u3092\u8a08\u753b\u3057\u308d\u3002\u3053\u306e\u76e3\u7344\u3067\u306f\u3001\u5275\u610f\u5de5\u592b\u3060\u3051\u304c\u552f\u4e00\u306e\u8131\u51fa\u53e3\u3060\u3002"}, {"images": {"nodes": []}, "id": "950470697401134", "locale": "de_DE", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fixer Undercover", "keywords": [], "long_description": "\ud83d\udd27 Vergiss den Anzug, nimm den Werkzeugkasten.\nAls Agent 404 infiltrierst du das Redemption Prison mit Schraubenschl\u00fcsseln, Bohrern und Mumm. Jedes kaputte Rohr und lose Kabel ist deine Tarnung. Improvisiere und zerlege das System von innen. Keine Gadgets \u2014 nur Werkzeug und K\u00f6nnen.\n\n\n\ud83c\udfae FIXER UNDERCOVER macht das Gef\u00e4ngnis zu deinem Puzzle-Spielplatz. Greif zum Akkuschrauber und knack die Schl\u00f6sser. Schneid dich mit dem Winkelschleifer durch \u201edefekte\" L\u00fcftungen. Dank realistischer Physik und Haptik sp\u00fcrst du jede Schraubendrehung, jedes Kabelknipsen und jedes Klicken der Mechanik.\n\n\n\ud83e\udd16 Du bist nicht allein. Winston ist dein fliegender Partner \u2014 Hacker, Scout, Info-Quelle. Wenn's brenzlig wird, haut er dich raus. Wahrscheinlich.\n\n\n\ud83d\udd12 Das \u201eBorn Again\"-Programm von Direktor Kozlov verwandelt Kriminelle in Vorzeigeb\u00fcrger \u2014 glaubt die Welt. Hinter dem Wunder steckt eine Verschw\u00f6rung, finanziert mit Millionen an Schwarzgeld.\n\n\n\ud83e\udde9 Das Gef\u00e4ngnis ist ein riesiges Umgebungspuzzle. Nur du hast das Geschick, es zu zerlegen. Find die Konstruktionsfehler, improvisiere mit deiner Ausr\u00fcstung und knack das System von innen.\n\n\n\ud83d\udc64 Du bist der Fixer \u2014 ein Ghost-Agent, getarnt als Wartungsarbeiter. Dein Werkzeugkasten ist dein Arsenal. Deine Tarnung ist perfekt. Niemand beachtet einen Fixer mit Schraubenschl\u00fcssel.\n\n\u26a1 Infiltrieren. Improvisieren. Enth\u00fcllen.", "short_description": "Andere Agenten haben Gadgets. Du hast einen Schraubenzieher und deinen Einfallsreichtum. Schl\u00fcpf in die Stiefel von Agent 404 in diesem VR-Abenteuer. Undercover als Fixer infiltrierst du das Redemption Prison und deckst die Geheimnisse des Born Again-Programms auf. L\u00f6se R\u00e4tsel, improvisiere mit deinem Werkzeug und plane deine Flucht, bevor du selbst Teil des Systems wirst. Hier ist Kreativit\u00e4t dein einziger Ausweg."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fixerundercover.com/privacy-policy-en.html", "developer_terms_of_service_url": null, "publisher_name": "Creativity AR", "support_website_url": null, "website_url": "https://www.fixerundercover.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en",
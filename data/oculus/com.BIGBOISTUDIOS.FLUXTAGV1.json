-7&_nc_sid=6e7a0a&_nc_ohc=V212b5fUTAYQ7kNvwFv5FjZ&_nc_oc=AdodmHR8kDi1TIlU_iXNOBHlybO2Vr3Dp-PwXDPMxW5MCA5hdmC0RvBnLP_kvfjCfQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRsUYPzYw5VaYJ-rgb1w8SMNwcNt8enPQQ2GJ6DyihNA&oe=6B006CBC"}, {"file_name": "Screenshot_5.png", "id": "996008942726965", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831778_996008946060298_2576002652258432090_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmtb6bnFOXQQ7kNvwHJ9ROy&_nc_oc=Adp_5GEVU4ecuDRUyiKrECV2pSZeBowfMFqnkQ_z4_jNsWd__9PqENn4s-wxTIKADjA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4NP15S-fdehM28t93mlszxsybv8sz2WinrG5bSEjjtQ&oe=6B00834C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLUX TAG V1", "keywords": [], "long_description": "Flux Tag V1 is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other.\n\nWhether you're the hunter or the hunted, movement is everything. Master momentum, wall-run across futuristic platforms, leap across massive gaps, and make split-second decisions to outplay your opponents. With fast, fluid locomotion and parkour-inspired level design, every match feels fresh, challenging, and fun", "short_description": "Flux Tag V1 is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other."}]}, "developer_name": "BIGBOI STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/fluxtagv1/home", "develope
-7&_nc_sid=6e7a0a&_nc_ohc=lZBdW0X9CUwQ7kNvwHokwwL&_nc_oc=Adq_uCby5geswGi_J1UAQqxrhtZeRDXd3u3EAEQvI_5MZyLEY1ncp9YW_WFE3nvZ7lQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTZH090oQ2ZYAezkiiUnFTijdjAsEj3cTT9gFGE7BbUKw&oe=6AFDC9BC"}, {"file_name": "Screenshot_5.png", "id": "996008942726965", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831778_996008946060298_2576002652258432090_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mmtb6bnFOXQQ7kNvwGNOKDJ&_nc_oc=AdqdgkdWW62U9i0UgAiQRTL2aL0718RucIJT-8GfGh0fZ8M35bTcaA-Pmy53HL6O7xc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_VPZPY8nmqIOIdTNXF2ONJ4qlmO-n9PDkT1GkuKZdxA&oe=6AFDE04C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLUX TAG V1", "keywords": [], "long_description": "Flux Tag V1 is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other.\n\nWhether you're the hunter or the hunted, movement is everything. Master momentum, wall-run across futuristic platforms, leap across massive gaps, and make split-second decisions to outplay your opponents. With fast, fluid locomotion and parkour-inspired level design, every match feels fresh, challenging, and fun", "short_description": "Flux Tag V1 is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other."}]}, "developer_name": "BIGBOI STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/fluxtagv1/home", "develope
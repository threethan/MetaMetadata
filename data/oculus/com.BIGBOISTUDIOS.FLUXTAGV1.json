uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831778_996008946060298_2576002652258432090_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wgrolxihbegQ7kNvwGu1_OM&_nc_oc=Adr5qnR-p2ADz6fowkOou21U5ia5dJl6cdrq-_4Jgq-1BCsH0f7A-1hPEuD6emS0YoI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-azlP3qxRkOUpuMNezAGYqLPP5zSKo1p3eIfccr5KDg&oe=6A6DF48C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "FLUX TAG V1", "keywords": [], "long_description": "Flux Tag V1 is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other.\n\nWhether you're the hunter or the hunted, movement is everything. Master momentum, wall-run across futuristic platforms, leap across massive gaps, and make split-second decisions to outplay your opponents. With fast, fluid locomotion and parkour-inspired level design, every match feels fresh, challenging, and fun", "short_description": "Flux Tag V1 is an exhilarating VR multiplayer experience that takes the high-energy, physics-based locomotion of Gorilla Tag and turns it up a notch. Using only your hands and arms to move\u2014no buttons, no sticks\u2014you'll swing, vault, and launch yourself through immersive environments in a heart-pounding game of tag unlike any other."}]}, "developer_name": "BIGBOI STUDIOS", "developer_privacy_policy_url": "https://sites.google.com/view/fluxtagv1/home", "developer_terms_of_service_url": null, "publisher_name": "BIGBOITHEBIGGEST", "support_website_url": null, "website_url": "https://sites.google.com/view/fluxtagv1website/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topi
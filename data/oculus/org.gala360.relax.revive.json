3yTZ96bnTEpV2KkzjW0gQ1YKoPA9j8LVa5NX0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaYEsn4lJtSx2YIu0L9wMRHma43FtDVxvdd0iufddPHg&oe=6AFC7D95"}, {"file_name": "02-collection.png", "id": "3044853129192918", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827987_3044853132526251_8655757851665985810_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CsJCdO4Z1QsQ7kNvwFWX0Yj&_nc_oc=AdrWrrJxwSyzHnK8DI6-DSQNaJ0Woa5iVo40f-65bvteD0Ec07plKafd0OU2c8LlxBA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSN36HRW59BS7YYPXtmaxovO432UgcETxu_EvtUx4wMQ&oe=6AFC658E"}, {"file_name": "03-backdrop-california.png", "id": "4421875358113012", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823279_4421875361446345_1651232247588989221_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5F8YszBctFYQ7kNvwFMV60w&_nc_oc=AdqGYFbg_rpTuMMKtSwRkjIJNCkYbXDd17n4cD3T0UyaNLx7QdgulmXKWB49DMFGxJE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRadIbmXqOpAebCz9cDX2eyeoiSWX4N-ITOFm3fa8XdsA&oe=6AFC637C"}, {"file_name": "04-downloaded.png", "id": "2331423364275734", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823310_2331423367609067_7001289947047001937_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AP9u6WkGKKIQ7kNvwF7-njq&_nc_oc=AdqWCvJb-YJbEYlCLocA-b5qiFOEsIaqJ11To7yhh9576JyCfMJkLJc1EV1bcuBi7E0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRJ0AcNAUt33rgyePvj6JsQDMmpUROHq3BycjeyPCioZQ&oe=6AFC5EE3"}, {"file_name": "05-player-mauna.png", "id": "29232602573000083", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491828028_29232602599666747_7212272778230631290_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JtOOGhwnnJIQ7kNvwGBjh8u&_nc_oc=AdqFU-1h5zuQFQ87oB9iD4wKcVTs2LEY0hnuKs4BhmSoOKwnf_Od4PBgzq52cWN6I3s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5bGkH71htI167G6PbU05Tj9C2Bzt-c0-s8jix67u8XA&oe=6AFC7087"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gala Relax", "keywords": ["galarelax", "relax", "360", "nature", "ambient"], "long_description": "Your quiet place, one scene away.\n\nGala Relax, rebuilt for Meta Quest, puts you inside calming views: waves rolling onto a Hawaiian beach, waterfalls, city skylines at dusk, coral reefs, the coastline from the air. Each scene wraps all around you and loops without a seam, so you can stay as long as you need.\n\n- Seven collections, plus 3D scenes with real depth\n- Download your favorites and unwind offline\n- Seated or standing, no motion, nothing to learn\n- Touch controllers\n\nThe first scene in every collection is free. Go Premium to unlock them all, with a 7-day free trial. Cancel any time in your Meta account.\n\nPurchases from the earlier Gear VR / Go app do not carry over.", "short_description": "Step into the calm. Surf rolling onto a Hawaiian beach, reefs drifting past, the coast from above: 360-degree scenes that wrap all around you and loop for as long as you like. Start free, then unlock every scene with a 7-day free trial."}]}, "developer_name": null, "developer_privacy_policy_url": "https://gala360.aicam.fun/privacy", "developer_terms_of_service_url": null, "publisher_name": "STW Software Limited", "support_website_url": "https://gala360.aicam.fun/support", "website_url": "https://gala360.aicam.fun/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["
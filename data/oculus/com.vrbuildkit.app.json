kxGNvIpz_yD8cZZiqXOo6jbR_db0JmPCxxmR6E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQU-59mMu6F2YYPyCbd6AJeiRHFjK1XNS_NPSwYMk4-kA&oe=6B0B1FDB"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1659925028880271", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619382_1659925035546937_3870695689220037648_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf4TlK7ZDyQQ7kNvwHalXP5&_nc_oc=Adp8I_C3BiLA9-hahFz88PMNaHjW_EMnakp8-m4CIdIvDMwHW5OkqVBHkLdWwzkzjNE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRsaNt_Ci0Gd1ww8O89dkMtqbGFjCV-mrQ89VNXcSKNvA&oe=6B0B37BB"}, {"file_name": "screenshot_5_2560x1440.png", "id": "4177339905730498", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593749142_4177339909063831_3023418251747365142_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oiZxLesRlAQ7kNvwH2aEUi&_nc_oc=AdrsluErZvBF2OWn4pibiSocOMaD9MoLJz9GskE_25lHi1r36jc6vYhsLxyFD9iyBb8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTH6QavM-sDRknXBE6bYSRKyrmuK3ENf2usw86NIV9ZLA&oe=6B0B2EB5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_dino_2560x1440.png", "id": "1149629504281682", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499620666_1149629507615015_4502828290444551372_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6lZQIL9E9UQ7kNvwGc8ASM&_nc_oc=AdpO1qNSs-V4D2RRaM3JeSrBCRmS582LJArEwRdRI1fjn0K-OUpsiqXNOqTJXSnoEmA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQDxiOekewNKDqbZkOIt7ZTmymi7o01f04OtACFa8Dmhw&oe=6B0B2F79"}, "display_name": "VR Build Kit", "keywords": ["architecture", "design", "education", "modeling", "visualization"], "long_description": "VR Build Kit is a spatial design platform. Build or upload a project on vrbuildkit.com, then open it in your headset at real-world scale, placed in the room you are standing in.\n\nIn the headset you can:\n\u2022 Use your hands or Touch controllers: point and pinch to select, pinch with your left hand for the menu, and touch menu buttons with a fingertip\n\u2022 Walk around a full-size model with passthrough, so you see your real room at the same time\n\u2022 Select, move and copy pieces, and change sizes in feet, inches or meters\n\u2022 Measure, draw lines and add dimensions and comments\n\u2022 Try materials and lighting, including the sun's position for a real place and time\n\u2022 Switch between spaces and design variations\n\u2022 Browse a public 3-D model library and place models in your project\n\u2022 Use voice commands for common actions (Pro and Enterprise)\n\u2022 Take photos and record videos of what you see and save them to the project (Pro and Enterprise)\n\u2022 Present to other people in the same room: everyone sees the model in the same place, with pointers and live edits (Pro and Enterprise)\n\nGetting started: create a free account on vrbuildkit.com from a phone or computer (18+), open a project and choose Show headset QR code, then look at the code with your headset. Nothing is typed in the headset. It works without an internet connection and is better with one. Plans and accounts are managed on vrbuildkit.com.", "short_description": "See your designs at real scale in your own room. VR Build Kit opens projects from vrbuildkit.com in mixed reality on Meta Quest 3 and Meta Quest 3S: walk around them, measure, move pieces, try materials and lighting, and review them with people in the same room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrbuildkit.com/privacy", "developer_terms_of_service_url": "https://vrbuildkit.com/terms", "publisher_name": "VR Build Kit LLC", "support_website_url": "https://vrbuildkit.com/contact", "website_url": "https://vrbuildkit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
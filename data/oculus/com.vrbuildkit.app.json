_oc=AdrDY1y4uX_1p8tPNuokWc2hBkmlRVFj6XC_5Ax3AwNEx-ci-fcYS0-JRaJ8DklH2zw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ4Ud2bFaxX1i0fxohbv8lv8am5MF66VP2nQWEJ2CEQQw&oe=6B0DBC52"}, {"file_name": "screenshot_2_2560x1440.png", "id": "1162712369658994", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593858738_1162712372992327_7673817831346300978_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tYChf2woyCcQ7kNvwEqP_fs&_nc_oc=Adp_b7qfEema7LHQ8MNNZRi7tkYOx7ymmOnFrXELirKIexgonh5PHVZGTzxqvkLLl-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhCpGX2amAAIHUEg1Hnx6d6_BbvYyYLrDDN_3293Rzbw&oe=6B0DA8F2"}, {"file_name": "screenshot_3_2560x1440.png", "id": "2010667739631886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593714175_2010667746298552_5179324025004745408_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Al6AhU9wvr8Q7kNvwHq-PN2&_nc_oc=AdoIWM9QDA-M3fw4FuJCUdBjnPAw-ZS2wGkl98NPybnGmCbvvoWDxDjy59KypyNmsY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTkqzi9S9PyEXic22jhoa5KLP7GfU_MKuosY86q30jv-A&oe=6B0DC2DB"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1659925028880271", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619382_1659925035546937_3870695689220037648_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yb38f_i6KC4Q7kNvwGpE-Gd&_nc_oc=Adpw-XtIz2IV7Q136yoWvyXy2con1EL8QUBGx6SN5ZnuMZEvI-LDabts1Y_QLN1BYVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7VPCEl3W_jdXANTTOcktFBg1quhT48IBrtEHBX_Kiqw&oe=6B0DA27B"}, {"file_name": "screenshot_5_2560x1440.png", "id": "4177339905730498", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593749142_4177339909063831_3023418251747365142_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O-4F_cLhlJkQ7kNvwGVbBm4&_nc_oc=AdpQbT65JOQP_H1mT1YgUx_D9RN7037RZOc-MZlZJE5BXmtKZ1XRp5r11MpaR6WTLCg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ9kF3VImZtspDJw0v9FB3YN3E0kOpkzADFr4DE-dOmBg&oe=6B0D9975"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_dino_2560x1440.png", "id": "1149629504281682", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620666_1149629507615015_4502828290444551372_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ow_JB0nwaaYQ7kNvwGWyoVq&_nc_oc=AdodaJdjCII_zYQLNk2JcbNuYQObFgV8W_CtSYrzeqosl8FHLjJex270DJyXMYb6liY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRv_X8yH2QQdbXxKXlC9M_9d8YfgT55pRDFiJ_PQo4i4g&oe=6B0D9A39"}, "display_name": "VR Build Kit", "keywords": ["architecture", "design", "education", "modeling", "visualization"], "long_description": "VR Build Kit is a spatial design platform. Build or upload a project on vrbuildkit.com, then open it in your headset at real-world scale, placed in the room you are standing in.\n\nIn the headset you can:\n\u2022 Use your hands or Touch controllers: point and pinch to select, pinch with your left hand for the menu, and touch menu buttons with a fingertip\n\u2022 Walk around a full-size model with passthrough, so you see your real room at the same time\n\u2022 Select, move and copy pieces, and change sizes in feet, inches or meters\n\u2022 Measure, draw lines and add dimensions and comments\n\u2022 Try materials and lighting, including the sun's position for a real place and time\n\u2022 Switch between spaces and design variations\n\u2022 Browse a public 3-D model library and place models in your project\n\u2022 Use voice commands for common actions (Pro and Enterprise)\n\u2022 Take photos and record videos of what you see and save them to the project (Pro and Enterprise)\n\u2022 Present to other people in the same room: everyone sees the model in the same place, with pointers and live edits (Pro and Enterprise)\n\nGetting started: create a free account on vrbuildkit.com from a phone or computer (18+), open a project and choose Show headset QR code, then look at the code with your headset. Nothing is typed in the headset. It works without an internet connection and is better with one. Plans and accounts are managed on vrbuildkit.com.", "short_description": "See your designs at real scale in your own room. VR Build Kit opens projects from vrbuildkit.com in mixed reality on Meta Quest 3 and Meta Quest 3S: walk around them, measure, move pieces, try materials and lighting, and review them with people in the same room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrbuildkit.com/privacy", "developer_terms_of_service_url": "https://vrbuildkit.com/terms", "publisher_name": "VR Build Kit LLC", "support_website_url": "https://vrbuildkit.com/contact", "website_url": "https://vrbuildkit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "1380425778495629"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2947433482309178"}]}, "baseline_offer": {"id": "2947433482309178"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795125540, "status": "PUBLISHED", "id": "2947433482309178"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "14
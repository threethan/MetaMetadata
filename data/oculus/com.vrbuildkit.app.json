fP0HvmgUCvyJ00QvTm0mX7o3Pn-GReh68EqYKE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQT14pqW6IVuyko94Ozou0EFToeTlzPPLYT7Hrn28Qw-A&oe=6B08449B"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1659925028880271", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499619382_1659925035546937_3870695689220037648_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xf4TlK7ZDyQQ7kNvwGx6kWm&_nc_oc=AdrufzGPZ_cwa5SoJ4ElVk4UtRyu_WkyyCx3VVGZur_7PzD6izIXtsGsoxvAAT5VZGA&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRePvzVfNo4VA0MqiWOBJO5ysQ772_e-hhaSpjDQ1ZmFg&oe=6B085C7B"}, {"file_name": "screenshot_5_2560x1440.png", "id": "4177339905730498", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/593749142_4177339909063831_3023418251747365142_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6oiZxLesRlAQ7kNvwGk7xTe&_nc_oc=AdpN7MOfASyvrj14AtP133dWKHcEfyFcAaHr_uhRXHd2ourxnU7NAeM8f36sQADkNRo&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSm_3Z8_tJf1EmnBrWANNu4AH6RqSwssWSpKX11Lljn1g&oe=6B085375"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_dino_2560x1440.png", "id": "1149629504281682", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499620666_1149629507615015_4502828290444551372_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3zL9c5q3TkQ7kNvwFoaq8j&_nc_oc=Adqsi64f0mcxP0h-b8NjQxHCnO0WUQ_-gTwW1VXRlJeijTuQgFp97s-b5lZHtS77QUc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTtdZ8wFQEkwMvS-rUzOPo1BuTshANY9H1ASToQ_086w&oe=6B085439"}, "display_name": "VR Build Kit", "keywords": ["architecture", "design", "education", "modeling", "visualization"], "long_description": "VR Build Kit is a spatial design platform. Build or upload a project on vrbuildkit.com, then open it in your headset at real-world scale, placed in the room you are standing in.\n\nIn the headset you can:\n\u2022 Use your hands or Touch controllers: point and pinch to select, pinch with your left hand for the menu, and touch menu buttons with a fingertip\n\u2022 Walk around a full-size model with passthrough, so you see your real room at the same time\n\u2022 Select, move and copy pieces, and change sizes in feet, inches or meters\n\u2022 Measure, draw lines and add dimensions and comments\n\u2022 Try materials and lighting, including the sun's position for a real place and time\n\u2022 Switch between spaces and design variations\n\u2022 Browse a public 3-D model library and place models in your project\n\u2022 Use voice commands for common actions (Pro and Enterprise)\n\u2022 Take photos and record videos of what you see and save them to the project (Pro and Enterprise)\n\u2022 Present to other people in the same room: everyone sees the model in the same place, with pointers and live edits (Pro and Enterprise)\n\nGetting started: create a free account on vrbuildkit.com from a phone or computer (18+), open a project and choose Show headset QR code, then look at the code with your headset. Nothing is typed in the headset. It works without an internet connection and is better with one. Plans and accounts are managed on vrbuildkit.com.", "short_description": "See your designs at real scale in your own room. VR Build Kit opens projects from vrbuildkit.com in mixed reality on Meta Quest 3 and Meta Quest 3S: walk around them, measure, move pieces, try materials and lighting, and review them with people in the same room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrbuildkit.com/privacy", "developer_terms_of_service_url": "https://vrbuildkit.com/terms", "publisher_name": "VR Build Kit LLC", "support_website_url": "https://vrbuildkit.com/contact", "website_url": "https://vrbuildkit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_to
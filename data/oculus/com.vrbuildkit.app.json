scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUxc9NfymYVnlO08PLTUQhifJNVad-Eq2VNm48XVkzC5Q&oe=6B103C75"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover_dino_2560x1440.png", "id": "1149629504281682", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620666_1149629507615015_4502828290444551372_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ow_JB0nwaaYQ7kNvwGH7kzO&_nc_oc=AdoEUJ0UdSN8pca7em2gOjSfC6GM71ezSO2QGV3QmUPbwIQALFaNoNlm80dFIp6TRtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWBZB1JqXV5TNkEBU2iOs9QPBJbPq_9g3E32cVOBsK3bg&oe=6B103D39"}, "display_name": "VR Build Kit", "keywords": ["architecture", "design", "education", "modeling", "visualization"], "long_description": "VR Build Kit is a spatial design platform. Build or upload a project on vrbuildkit.com, then open it in your headset at real-world scale, placed in the room you are standing in.\n\nIn the headset you can:\n\u2022 Use your hands or Touch controllers: point and pinch to select, pinch with your left hand for the menu, and touch menu buttons with a fingertip\n\u2022 Walk around a full-size model with passthrough, so you see your real room at the same time\n\u2022 Select, move and copy pieces, and change sizes in feet, inches or meters\n\u2022 Measure, draw lines and add dimensions and comments\n\u2022 Try materials and lighting, including the sun's position for a real place and time\n\u2022 Switch between spaces and design variations\n\u2022 Browse a public 3-D model library and place models in your project\n\u2022 Use voice commands for common actions (Pro and Enterprise)\n\u2022 Take photos and record videos of what you see and save them to the project (Pro and Enterprise)\n\u2022 Present to other people in the same room: everyone sees the model in the same place, with pointers and live edits (Pro and Enterprise)\n\nGetting started: create a free account on vrbuildkit.com from a phone or computer (18+), open a project and choose Show headset QR code, then look at the code with your headset. Nothing is typed in the headset. It works without an internet connection and is better with one. Plans and accounts are managed on vrbuildkit.com.", "short_description": "See your designs at real scale in your own room. VR Build Kit opens projects from vrbuildkit.com in mixed reality on Meta Quest 3 and Meta Quest 3S: walk around them, measure, move pieces, try materials and lighting, and review them with people in the same room."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrbuildkit.com/privacy", "developer_terms_of_service_url": "https://vrbuildkit.com/terms", "publisher_name": "VR Build Kit LLC", "support_website_url": "https://vrbuildkit.com/contact", "website_url": "https://vrbuildkit.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP", "MULTI_USER"], "id": "1380425778495629"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2947433482309178"}]}, "baseline_offer": {"id": "2947433482309178"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795125540, "status": "PUBLISHED", "id": "2947433482309178"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "14
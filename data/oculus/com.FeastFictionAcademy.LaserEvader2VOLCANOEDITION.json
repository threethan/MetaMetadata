1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK8YAJO3te9h8zV7d6qf6pMeh-cmeZ9CZGVPilSpDRzw&oe=6A5CAEE0"}, {"file_name": "download-resizehood.com (16).png", "id": "24908516262071794", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622184_24908516265405127_7343681642642581228_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbYZTiFvg6cQ7kNvwGmkvfu&_nc_oc=AdqIpuTuBdRldBsltBeWWZ-QE9n9FiIYSYhCzFy3JidbVoypFe8eFpOj7cvHLsjZK6E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBjDSaDfl2U1bFYz6R7QBrw9NOT6W2UQ-FRY3hYg2y39Q&oe=6A5CC382"}, {"file_name": "download-resizehood.com (20).png", "id": "1387091865894705", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499304084_1387091869228038_6504957866180838453_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHdVw9-jI_0Q7kNvwFhdcM9&_nc_oc=Adq5y2mnOhrLYRue6ygv08d6mq1PlnHU60gcievcU2DW-Lx3WWUlCwAVNBY2a6q2dOA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaTAjlsje-6t1mlGBxD_6fyfO0DIVqy1RlMX_tTxkjCg&oe=6A5CE192"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Laser Evader Remake", "keywords": ["laser", "trap", "survive", "VR", "Evade"], "long_description": "Laser Evader Remake: Volcano Edition\n\nNavigate an active volcanic chamber in VR. Balance on narrow beams over glowing lava, dodge sweeping laser rays, and leap between drifting molten platforms. Every movement relies on timing and precision.\n\n\nOverview\n\nStep into a volcanic tunnel where lasers hovers in different motion and floating volcanic rocks. you must have fast reaction speed and precision.\n\n\nCore Gameplay\n\n1. Evade Laser Traps  \n- Vertical, horizontal, and circular beams sweep in patterns  \n- Observe motion, pauses and openings, then dash through at the right moment  \n\n2. Avoid the Lava  \n- Walk across narrow ledges and bending planks; one misstep restarts the level  \n- Steady yourself on hovering rocks to regain balance  \n\n3. Leap on Floating Rocks  \n- Jump between moving magma platforms of varying size  \n- Adjust your timing and trajectory to account for each rock\u2019s drift  \n\n\nVolcanic Environment\n\n- lava lakes glow beneath\n- Ember and fog effects swirl around the chamber  \n- Floating rock formations suspend above molten flows  \n\n\n\nVR Experience\n\n- Designed for intuitive motion on Meta Quest headset and for VR in general", "short_description": "Laser Evader Remake: Volcano Edition\n\nNavigate a volcanic tunnel and open areas in VR.\n\nCore Gameplay  \n1. Evade laser traps  \n   \u2022 React as lasers sweep and pause to predict patterns  \n2. Avoid lava  \n   \u2022 Balance on narrow ledges and hovering rocks; a slip restarts the level  \n3. Leap on floating rocks  \n   \u2022 Jump between moving lava platforms"}]}, "developer_name": null, "developer_privacy_policy_url": "https://aeon2418.github.io/", "developer_terms_of_service_url": null, "publisher_name": "Aeon Flux", "support_website_url": null, "website_url": "https://aeon2418.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24319293504368136"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618913_1253200876547053_6431659850949250276_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8C4gLpbQyDEQ7kNvwEB8MNz&_nc_oc=AdpnpDkXsFdwpv6VPzvfnMOMCso2_JtpMea8j
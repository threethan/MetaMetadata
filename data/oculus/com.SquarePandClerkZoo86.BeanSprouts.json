EFVBfkyspfuAIntLBAVMf2-vQkTLArNKgM4_cSvpXI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyeV3rYOIECgFfVfMyDjZn-FBw6e0RNClmd5z9xATXZAg&oe=69BFF52D"}, "display_name": "Bean Sprouts", "keywords": ["social", "funny", "climb", "beans", "bean"], "long_description": "(This game is still in development, so things will change)\n\nThis is a social game where you play as a bean and do whatever you want in a forest map with a big trampoline in the middle. and talk and play with other beans!\nIn future updates, there might be cosmetics, horror, and even farming.\n\nUp to 20 players can play at the same time.\n\n", "short_description": "Here you can chat with people, run around, chase eachother, do whatever you want to, as a bean!\nChill in the cabin, jump on the trampolines, escape the map.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bean-sprouts/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SquareP", "support_website_url": null, "website_url": "https://sites.google.com/view/bean-sprouts/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9904784272970332"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823893_8238539269603029_3634160438538645416_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K1q8pvvk43oQ7
olnTYAWLB0g&oe=6AFC8595"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Adobe Express - file (13).png", "id": "729667152907456", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499295308_729667162907455_280941374856631410_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QseZwt2aBXYQ7kNvwFQ9fd2&_nc_oc=AdpwydP4x9P7DFBiU9gbkq2tT9ROek_2WlGIu09nAqiaCPaJRw7e8jHogCIBlzW1pMg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ35jZFN8PeF99EZ2de-XYh0aAeoqgMiHdblsdhDqOXYg&oe=6AFC956D"}, "display_name": "Bean Sprouts", "keywords": ["social", "funny", "climb", "beans", "bean"], "long_description": "(This game is still in development, so things will change)\n\nThis is a social game where you play as a bean and do whatever you want in a forest map with a big trampoline in the middle. and talk and play with other beans!\nIn future updates, there might be cosmetics, horror, and even farming.\n\nUp to 20 players can play at the same time.\n\n", "short_description": "Here you can chat with people, run around, chase eachother, do whatever you want to, as a bean!\nChill in the cabin, jump on the trampolines, escape the map.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/bean-sprouts/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "SquareP", "support_website_url": null, "website_url": "https://sites.google.com/view/bean-sprouts/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS
s live matches, replays, highlights and more."}]}, "developer_name": "SportsAI", "developer_privacy_policy_url": "https://www.sportsai.au/privacy_policy", "developer_terms_of_service_url": null, "publisher_name": "SportsAI", "support_website_url": null, "website_url": "https://www.sportsai.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1062438406135832"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620860_1026190276719295_1043501715885961054_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sYJCJDjGNoQ7kNvwEIi1bQ&_nc_oc=Adql8PsDQqsibiB8vHo52FSqZ8CC8evPJ31RMNdmXHGWll6x68gfLwvInkJsMIKb-0Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQu0ZqabbJ8cM7p11Y-pOBruLXHnd4RYUKYq3OTRTkKQ&oe=6A732C35"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "London Broncos", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1785388740, "lastRevision": {"nodes": [{"id": "1062438409469165", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1062438389469167", "is_first_party": false, "enables_i
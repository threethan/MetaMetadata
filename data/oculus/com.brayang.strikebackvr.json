uscdn.com&_nc_ss=7f20f&oh=00_Af7O5ESmJpB-0Jj5--0E5P9MxPBtPrJNSvC8FYnV3aEZEg&oe=6A09DEF1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "595674189194703", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982698_595674192528036_8093659035493696978_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJ0HRqSFl8sQ7kNvwGoeW66&_nc_oc=AdpIHljqIe7DM4hIwNHH2M-fa4hMn1p1DIM7oqfy_Qbo7s-Z4UjUPTS0mKRRht59YXs&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SO2BcxzwPdcE15ekj9unJYEqUe5ted2rxvVErZ522sQ&oe=6A09D52A"}, "display_name": "Strike Back", "keywords": [], "long_description": "The world order has been turned upside down when the terrorist organizations gradually grew to be on par with the superpowers, as an elite special agent in the international anti-terrorist organization, you have the task of infiltrating and destroying the organization from the inside.\n\nThe game is designed extremely detailed and meticulous. Each mission is a new challenge with different context, different difficulty and different boss.\n\nWith extremely impressive graphics from the background to the characters, it is guaranteed to bring extremely vivid experiences to players.\n\nYour enemies have artificial intelligence and act like the real thing, they will give you really impressive challenges.\n\nWhat are you waiting for, let's start experiencing the game.", "short_description": "The world order has been turned upside down when the terrorist organizations gradually grew to be on par with the superpowers, as an elite special agent in the international anti-terrorist organization, you have the task of infiltrating and destroying the organization from the inside."}]}, "developer_name": null, "developer_privacy_policy_url": "https://strikeback-vr.web.app/", "developer_terms_of_service_url": null, "publisher_name": "Brayang Studio", "support_website_url": null, "website_url": "https://www.brayang.com/", "category": null, "comfort_ra
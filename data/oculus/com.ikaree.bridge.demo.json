3CtKEjWSmmVDppJOL4Tw2AjgutMrpQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUCqH4QmhXmjIfznU51Y32zyeMEutJ-W4vUbzhCHmpVXA&oe=6B106B83"}, {"file_name": "01_bridge_red_alert_2560x1440.png", "id": "1141677588226912", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824671_1141677591560245_1707958243909889026_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GhX7DVPd9MAQ7kNvwF52Q0u&_nc_oc=Adp7QHxg2f7AUuHfbf87L-GBxEWovMHYJwHvthfnaq_3PJFG_njKWxpZt1qWE2zcTZY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUTsJ3O7M9rfhkUXrO6B9XdO_9fIJCjy4BN8ThKqCiuLQ&oe=6B104DF4"}, {"file_name": "05_thessaly_wrecks_2560x1440.png", "id": "1656287229364804", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823802_1656287239364803_5374368453035831296_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=04qxB0N6HZ0Q7kNvwHrBNOH&_nc_oc=AdpHNeCCaEurFvJOfCwY6oaYBp4fHTexCOVRvfQ90XAq2faCq95a5LmeecAn26C-kug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXXvCNRv7WfDvBsB9QxIEA7EtWeeXtaNARh5OCCGWShgg&oe=6B1053B5"}, {"file_name": "04_engineering_core_2560x1440.png", "id": "1662060741939039", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824665_1662060748605705_8687203420279468709_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0MaJ8wCzzcQ7kNvwFYoPPt&_nc_oc=Adq1AZ2hmQLF661LyY2WCz0XnEj2Pic7UJIGzUmKbnr-CkvMiLcVGQgIpuhlbCFpnbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWtNqI3hlYkkYqWAun2DSzErNG4GjiUJZAcZMavHyNHvw&oe=6B105931"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "2230272577530845", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827987_2230272584197511_8171126056338237697_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4UvyRxH7Q8Q7kNvwG9EDq3&_nc_oc=Adp8dEtNpSuTO3rqN7wuHYoR2KA1Aq1OYIAdjHOOOs6DelRSK3EXDkI0480pLOjn4qw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWom25x7JP3QDdzmk5rfWJFUxOK3G95kNlEEGZr6Q9DPA&oe=6B105EF5"}, "display_name": "Starship IKAREE demo", "keywords": ["starship", "captain", "bridge", "voice", "scifi"], "long_description": "YOUR CREW THINKS. THE GALAXY IS ALIVE.\n\nFree demo of Starship IKAREE, a hard sci-fi game where you command an exploration starship from the captain's chair. You don't fly the ship. You command it, with your voice.\n\nA CREW DRIVEN BY AI\nYour officers run on AI. Speak naturally: ask for options, give orders, push back. Helm, tactical, science and engineering understand what you mean, answer in character, argue when they disagree and carry out your decision.\n\nTHE DEMO MISSION\nIKAREE is crippled among the wrecks above the gas giant Thessaly. An alien warship is closing in and the core is failing. Make the calls nobody else can and find out which ending your choices lead to. Playable: bridge, engineering, hangar, conference room and captain's quarters.\n\nOUR OWN GALAXY\nThe star map follows the real Milky Way, built from NASA data.\n\nLIVING UNIVERSE (FULL VERSION)\nThe species you meet are not all written by us. Players create their own on the web and they evolve hour by hour, rise, fall and remember when IKAREE came to visit.\n\nBRING YOUR OWN AI (FULL VERSION)\nConnect your own AI with an API key (Claude, OpenAI, Gemini and others) or run a local model on your PC.\n\nWHY THE DEMO IS LIMITED\nIn the demo the crew runs on the developer's own AI account, so the number of players is capped for now.\n\n- Microphone required (voice commands in English)\n- Internet connection required\n- English or Czech subtitles\n\nMade by one sci-fi fan in Brno, Czech Republic.", "short_description": "Free demo of Starship IKAREE, a hard sci-fi starship command game powered by AI. Your crew isn\u2019t scripted: speak your orders out loud and your officers answer, argue and act. Your ship is crippled above the gas giant Thessaly, an alien warship is closing in and the core is failing. In the full version you connect your own AI through an API key. Demo access is limited for now."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ikaree.space/privacy/", "developer_terms_of_service_url": null, "publisher_name": "ProBudin", "support_website_url": null, "website_url": "https://ikaree.space/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1453702824490378"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2634479513632940"}]}, "baseline_offer": {"id": "2634479513632940"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795106100, "status": "PUBLISHED", "id": "2634479513632940"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1468255103035150", "version": "0.21.2"}, "id": "1816855779555767", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1453702821157045", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1468255103035150"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1816855779555767"}]}, "change_log": "Starship IKAREE Demo 0.21.2\n\nWhat's new after the Comic Con beta test:\n- Easier consoles (default): each department console shows the officer, their last report and 2-3 big orders you can give right now. The order the mission is waiting for lights up first. Switch back to the full consoles in MENU > SETTINGS > CONSOLES.\n- Every order works the same by voice and by button, and the crew answers every order.\n- The pointer ray is always visible, with controller models in your hands; the nearest panel takes the press.\n- The mission goal is on the main screen, and the crew reminds you of the next step when it gets quiet.\n- GAME lets you start from any checkpoint you have reached.\n- Seated play: your eyes are now at the captain's height in the chair, so everything in Engineering is within reach.\n- Smoother frame rate and many fixes to what the crew says and does.\n- English is the default language for subtitles and speech; Czech can be chosen in MENU > SETTINGS.\n", "created_date": 1794860065, "id": "1468255103035150", "version": "0.21.2", "version_code": 28, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1453702821157045", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1468255103035150"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1794625418, "id": "1462717096922284", "version": "0.20.0", "version_code": 25, "release_status": "PENDING", "status": "DRAFT", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "Andr
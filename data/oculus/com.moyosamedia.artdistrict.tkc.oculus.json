-7&_nc_sid=6e7a0a&_nc_ohc=opnY_dI53r0Q7kNvwE1mtxO&_nc_oc=Adoh7qDADQIFQj9E5y-elh2ws8AZLre1PXPTnvpNI9uHtpfKKDPMfanrmAZwduCDmYw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1qc-P461-YKBwidudasvdbKpTMcDElDlmgh-xNil3EkQ&oe=69E22E66"}, {"file_name": "migrated_image.png", "id": "538687946649060", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12504745_200384717251851_8459326741062615040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vkcKuvP8VxgQ7kNvwEOT6KO&_nc_oc=AdpSkcVkUl7t0VWLf2PMFgVNTWO1Eg6TCQNulGwZp_jlPo_F_U7I6Ne50tRE_6M_jQo&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mV75kQdMOUbEN_jB5zCYAXP9g81r1Qkhdtnuy-6nsPA&oe=69E227CF"}, {"file_name": "migrated_image.png", "id": "486903698856969", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydRZohcCHs4Q7kNvwHILjMd&_nc_oc=AdqsKS9PlMA8hyTJND1ZsF043SArcQR8QgaaGVOWsOXbHmEB-nUHf_aw90KqNEHjCqw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3EHJkzYtb3DWAIw_NrhU6z-7sRHhwBHaXLhOt1M6zoJA&oe=69E22324"}, {"file_name": "migrated_image.png", "id": "236710350845886", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12410440_1822405177841081_113439822978220032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2FUzYZHX-QQ7kNvwG16QyY&_nc_oc=AdpKudoB6-M8jzy4Ta34yRPdkFXL21NTB7bGYQsT1aizpDXmqKi3STkDE70Mj_MTBr4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05of-hkcr95dJItJVLdLaDaZKcSxy18qCcs3VamvxeLg&oe=69E221CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465256708481712"}, "review_messages": []}]}, "cover_square_image": {"uri": "
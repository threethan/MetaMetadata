-7&_nc_sid=6e7a0a&_nc_ohc=mlGAyxXO7isQ7kNvwH6Jh1f&_nc_oc=AdqfGulm9jvwP0nEL-F-PQiX0d8ppObQigl8kYImJXNqz0JR5_e4YrEn2Kr-nyUqDpw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RwfFsZTJ1I-qD-upAQXDlm1rDPBPurQPhypyNEyDeWQ&oe=69F9E966"}, {"file_name": "migrated_image.png", "id": "538687946649060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504745_200384717251851_8459326741062615040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aVEcuD_NRtIQ7kNvwGpMjwr&_nc_oc=AdoIkAKNGJJADNYsn5G2g2cCAM0ZVgUhzfTOnJEpA6siS2IC0boqgL7wPA0qMZ_PMqQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7S9s0i-KpYBR4O1Wi3BCcXWWm04xUe42yuOMKMkarlTQ&oe=69F9E2CF"}, {"file_name": "migrated_image.png", "id": "486903698856969", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HBeSFWrIG9AQ7kNvwEWtfxH&_nc_oc=AdovfGo2ZnnxT5ImddwKZ82NRrmp8-vVsoOFFrSx-4dz1w2O1VYSnp34cnLN-CJNyeo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AMGGNoriZzg6P6t5p2qXOhMvJaLMD3Jy-sM1KTW2bBw&oe=69F9DE24"}, {"file_name": "migrated_image.png", "id": "236710350845886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410440_1822405177841081_113439822978220032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-riqhYLTwvYQ7kNvwEuOHN8&_nc_oc=AdofwcRy00tq73eO4NpjvnNpfNRCND_kkxFWvY2FivoS5ngRk6pQVxOpQudXMTAqObc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vuEBkxygmmK6-kIo80GtpAPj3ntEQMdbw8dhf1sC35w&oe=69F9DCCD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465256708481712"}, "review_messages": []}]}, "cover_square_image": {"uri": "
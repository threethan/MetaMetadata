&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuGAQks6E_5ttp6ugoTY3gJZJWe9wJu-4DR_IUv9l8ZSA&oe=69A9774F"}, {"file_name": "migrated_image.png", "id": "556646814986841", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_vaQv-6JsgQ7kNvwFA3eqg&_nc_oc=AdmHm7NZtvsOtPK8_GZ5kuuQNpTtue34HvOLEBfjAwHfm3fPdoMPXYt949iYfe2EM68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afs7caXVSQLkjqKhaBGU0iUjkcubN5GkggAxiNzlr9jIwQ&oe=69A972A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/kBGzp7", "id": "1698381450276199", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504684_1698381453609532_5626861655494230016_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8TsC2lnyakQ7kNvwEhvtWJ&_nc_oc=AdkpfzA2DXHJD94Vkt5PyB7F4AGn-XI-VzJurH7i0wJFY0yZ3EfVpePFw-8lskdm0mI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfuuREj9MTZtI87i3Fagzy8gmuEA0p37j3Ip4tVeMrEiJg&oe=69A966CC"}, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1130125167752215"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "456129498313477"}, {"status": "PUBLISHED", "id": "742822112759748"}, {"status": "PUBLISHED", "id": "185241422392272"}, {"status": "PUBLISHED", "id": "1120145351519732"}, {"status": "PUBLISHED", "id": "695383574537107"}, {"status": "PUBLISHED", "id": "434398623889729"}, {"status": "PUBLISHED", "id": "732656540502174"}, {"status": "PUBLISHED", "id": "796887054007157"}, {"status": "PUBLISHED", "id": "1281085415414548"}, {"status": "PUBLISHED", "id": "442432563248398"}, {"status": "PUBLISHED", "id": "497234757807614"}, {"status": "PUBLISHED", "id": "422095268616970"}, {"status": "PUBLISH
-1.oculuscdn.com/v/t64.5771-25/12331252_229728951166483_8561782460059222016_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ec5uTELrO2oQ7kNvwGQ0-f6&_nc_oc=AdrmuNVi5LhuUVIlJfdg-Qca8CDXzgXg9mTRJsKcvoFY3NIB54AIQE0KOyN0faNxUGI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWrwJFX3ORlW39w_HngJXSj1FlEipT9QjNiKstfoEqXA&oe=6B05C43D"}, {"file_name": "migrated_image.png", "id": "653215488825435", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12504745_200384717251851_8459326741062615040_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awXDqYlet0wQ7kNvwEQ0AUu&_nc_oc=Adp0BgSghswY3JQE0JJSEXfZAkV-TK9GTY-psQxKvXQfMuuwMH0iDzpeEGw6wJKOyz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIcGx2EH0DN_2WZppgBpl6UqXEIQBQKmkGEknA243MBQ&oe=6B05BB8F"}, {"file_name": "migrated_image.png", "id": "556646814986841", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hmjUcZq6PVIQ7kNvwHHQTxM&_nc_oc=AdrL8qz1K7fy6H-yiNUNJb5TiXxNtJCmybp8Uy0bK7oP8CWzmM33ad1xbDlWjs-guB4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQ1IGmbwZauhC2X7iXKKN7QSLqRXSL_VLoxqP8xh9QTg&oe=6B05B6E4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/kBGzp7", "id": "1698381450276199", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504684_1698381453609532_5626861655494230016_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTOtxOoJRfAQ7kNvwEFHAvj&_nc_oc=AdrPmA7EsI8q5yhaxGfczBWTCmBCnKPQ5FWrrsoh23pRMHYp_nEuGQRvGYbdaYifWQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWVpk7OZ36V0ARUPQ-OAAvy4mY7gWEaa4XeA8jXMw2ZQ&oe=6B05AB0C"}, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_mo
.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NRe1LCj6U40Q7kNvwElH4rs&_nc_oc=AdlCmG5ZEhQIi6wFb4j4cChQLczfaYKyi_AQH-DxoCp7M_jEcMecE8detUmnthRYhks&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Aft5ZOaMSzZoRdlF5ttiRe0gNgiCz_5ObjAla5dk6sFjzQ&oe=69A57E24"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/kBGzp7", "id": "1698381450276199", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12504684_1698381453609532_5626861655494230016_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5yGfuhxaR0Q7kNvwF2_3S5&_nc_oc=AdkgnXDW18uko5P_0P8woErcNjX2jeqj8dSHx5SsqnkAfkVmbGl7M1us_qoJkI4C5pI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AftTjT290IRYsdNJKXOa6VOvP9Kmq4hiCwgOXT_QBpOVsA&oe=69A5724C"}, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1130125167752215"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "456129498313477"}, {"status": "PUBLISHED", "id": "742822112759748"}, {"status": "PUBLISHED", "id": "185241422392272"}, {"status": "PUBLISHED", "id": "1120145351519732"}, {"status": "PUBLISHED", "id": "695383574537107"}, {"status": "PUBLISHED", "id": "434398623889729"}, {"status": "PUBLISHED", "id": "732656540502174"}, {"status": "PUBLISHED", "id": "796887054007157"}, {"status": "PUBLISHED", "id": "1281085415414548"}, {"status": "PUBLISHED", "id": "442432563248398"}, {"status": "PUBLISHED", "id": "497234757807614"}, {"status": "PUBLISHED", "id": "422095268616970"}, {"status": "PUBLISHED", "id": "655238618254298"}, {"status": "PUBLISHED", "id": "1915338515227213"}, {"status": "PUBLISHED", "id": "2383383808427507"}]}, "baseline_offer": {"id": "1915338515227213"}, "is_approved": true, "firstOffer": {"nodes": [{"start
c8w&oe=6B0C5BBD"}, {"file_name": "migrated_image.png", "id": "663102227814453", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410280_658272314515587_4633065124381327360_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3sShrf8qtoQ7kNvwECD3NC&_nc_oc=AdqzNL1BtftP5cr6PR-eU-415Wuo6Hc4aUzN__5FC__UhDfktT0Vk-yj9Q8LISpaudM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYmaKsV_jmbOnBjvOhNu4ZichKOJ6g_Otl2d3jxrFoQA&oe=6B0C59A6"}, {"file_name": "migrated_image.png", "id": "538687946649060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12504745_200384717251851_8459326741062615040_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gg37vPfl-UoQ7kNvwEHfrGa&_nc_oc=Ado_ILsgsIe6HE67SQJld2bpy9GOHiRvVTV4ujkjvL-sTqzLOrmu5NcK4-wtfj3dTbA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCEzOORHuHkaKkMu7CWuJoBOTAAac8c0ONdR6Sz81AZg&oe=6B0C530F"}, {"file_name": "migrated_image.png", "id": "486903698856969", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clKhpXD3s38Q7kNvwGg1dUb&_nc_oc=AdqhjBOO_dAIygDx46omgczc6xQgwmY5ECQSuMmayEXOnPmcZdvzBLZ7KU83V-XG0Tw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQlXN1Sk48wySbX5v9uLdtAgpvREZTcO161rE1is-JIxQ&oe=6B0C4E64"}, {"file_name": "migrated_image.png", "id": "236710350845886", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410440_1822405177841081_113439822978220032_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Nmrn4xVJ0QQ7kNvwFuBITQ&_nc_oc=AdpSORRELRT83t0b4UAfAgs6zbzZtqkv5rBvetUPw_KsrGVMgupZuB3HKZY5Lsg0CIw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRtI9hSGrKBKLQiYXbTclq9A1Zgtr4b_MxF0VrREt4VJg&oe=6B0C4D0D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": nu
Ct0mHZtojlSzGfhkpZkw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af0kSvKZrGBduFvK-T7qTsP0hsuJYHw57AxSxZTy5aJnVw&oe=69F0AEE6"}, {"file_name": "migrated_image.png", "id": "538687946649060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504745_200384717251851_8459326741062615040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=awD67wFvlJUQ7kNvwHZYCyW&_nc_oc=AdrcDTF6dC4DmBo8njBApWY3MXNn523unlU7xH9bbzWwk32TITW_nNJw8oTapHeU-6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1fkLiVWkQ6H1oQifXmL-ON4UXbnEx1UQy0Q3N-h4PPpA&oe=69F0A84F"}, {"file_name": "migrated_image.png", "id": "486903698856969", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XenJT6LqyGEQ7kNvwErYR3q&_nc_oc=Adook038wuHMkHZP_IkHgoHZEttEiw2arIP9VJo-A7N6X8LZPyfo1MUBB5jETOzVY6s&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af0Cx5rEicCsMEu_2V0qttIDME6HJk5c9AZ-6khK8K06_A&oe=69F0A3A4"}, {"file_name": "migrated_image.png", "id": "236710350845886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410440_1822405177841081_113439822978220032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7z07iFIuaMQ7kNvwH9bqwZ&_nc_oc=AdrpG-IDwEW9_1h2cBxZQVJO5y4XQJFyRRB-BPVoYhp3XeUE4YDbuzopQX_dN6Y5qsw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3PE18yD4u44om5EPulhCPmHYFrlX2v8DWJtAO-lkeUOw&oe=69F0A24D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465256708481712"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031382_2566874203540277_432423423394709504_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a
-7&_nc_sid=6e7a0a&_nc_ohc=qS9rMONqF9UQ7kNvwGLVu2m&_nc_oc=Ado6UnqmtYL8tNUltPwWj1S7U7ybM-pFvyUew7ck_0Nlng8wsyKzxBk5BmNWtIZHv-U&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7AXnpNJREy0wsW2Ww1PO9TtteuMHQOYhHYqnYceMpNLA&oe=6A05C6E6"}, {"file_name": "migrated_image.png", "id": "538687946649060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12504745_200384717251851_8459326741062615040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7Dqolyfx8IQ7kNvwFTePPv&_nc_oc=AdqD0y2hzfsPxqChmjWJB5wYW6BU6ET8un_GY8ySpbprowxdoWXHMCEot7SC5cJEc98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jcXGyp8_Cm2kQ8ICVJBzWYB6WWDnYSqi31-YzyThrCQ&oe=6A05C04F"}, {"file_name": "migrated_image.png", "id": "486903698856969", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fj2Yo1P37FgQ7kNvwGFpOzk&_nc_oc=AdraBjXHq229FYgONaCY5XH-IEz-XfVy8OS9YB3RbWgP_aNi68FA6aftifYBIR_e7Ow&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Z9yhJemCwCWVT9Pe2gdADWRBzV2Ub_DvS12RO2MFPYQ&oe=6A05BBA4"}, {"file_name": "migrated_image.png", "id": "236710350845886", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410440_1822405177841081_113439822978220032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fQ40W1SDJ7gQ7kNvwHRRr4v&_nc_oc=AdrT5daOjlRF9VneYDtNkgpYjbsMV91Ir-fngNlsV-UCb4hhPv23pSbgOUdY7qD7Swg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4CrrOq0JwUFJAaa706YO6aQ1r1RHSxrf_SOXuHCsSAwg&oe=6A05BA4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465256708481712"}, "review_messages": []}]}, "cover_square_image": {"uri": "
pTZbpHsJEVgIAnQ8_DHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvjFZedHQ668CJsi-x-IITALTIbDT4GRqhrEsLKYX9r7w&oe=69A2E666"}, {"file_name": "migrated_image.png", "id": "538687946649060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12504745_200384717251851_8459326741062615040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X404CEvGCzoQ7kNvwGxN5vD&_nc_oc=AdmHVlqpyl8WoaWw4IPQxGFvc23uxJRrKZp-jtYfUZQqn3d-46OpqZJILXhE6ogsRPw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudZ0xEhKd0FR0M1pLSPUWWQjtUawn4qe3jVuovy7AgHw&oe=69A2DFCF"}, {"file_name": "migrated_image.png", "id": "486903698856969", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TmxnvjoGC30Q7kNvwGPG0Qm&_nc_oc=AdlZOp-ra-xJY2LJnmroC3qCKpAArGLrP2NHccwzbzt3q1q7L8YYGNTX2zlCTOf1tNo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCtFf_C8YVyoqcuQ6yntaXfua2lGpcPJiYjCsB0D6q7w&oe=69A2DB24"}, {"file_name": "migrated_image.png", "id": "236710350845886", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410440_1822405177841081_113439822978220032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4eaNh3iGkHAQ7kNvwGVBy5J&_nc_oc=AdnBGFZ0ZoTt5sWyV8PjMhtTO3YB1rsDAzvTLFf1I1XTnVXNLoPEQGMAfyUJgCi3MlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuwtVXTcFYJLiYnXpQSwx_mbZICeTyYW1dRmESqy5S7Ng&oe=69A2D9CD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465256708481712"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031382_2566874203540277_432423423394709504_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a
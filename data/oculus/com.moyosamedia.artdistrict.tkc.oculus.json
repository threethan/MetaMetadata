-7&_nc_sid=6e7a0a&_nc_ohc=dsrzR9SDqgUQ7kNvwEEvq3t&_nc_oc=AdqCgJIuJXlYHnqS3FSQzKTHIMVT09l7tWfeJu5pnjG4K2vCZ6p8ubGg9oNhv6yF-jo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJboYaMVIQGLLjEzk-_xk7L_KpEVM1KXNre8246NByfg&oe=69C3DBE6"}, {"file_name": "migrated_image.png", "id": "538687946649060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12504745_200384717251851_8459326741062615040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8GvBb5pQFIQ7kNvwHQ4A4B&_nc_oc=Adq0y-hWM7r83PcZiIYM9h47CtJ064c-BHGAamNdE8JpQ695NVH6h31Y0TwoF7yuLLI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyo8v5yQ_LRnFnS2CAr1MQH-HVhoA_cJeI9eNAgFyimnA&oe=69C3D54F"}, {"file_name": "migrated_image.png", "id": "486903698856969", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5hsW7ZEjMv8Q7kNvwFJxn1R&_nc_oc=Adqq9udobPbHWKRRci4kvZmce4Uoqp0W0pwxDs_5y_KtynU5qDYJD7vs6Pp8Z256So8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9b-Wotn2ejLrZmu2NjJa_FNsTzvspQTEgAFZYQPWE1w&oe=69C3D0A4"}, {"file_name": "migrated_image.png", "id": "236710350845886", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410440_1822405177841081_113439822978220032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOgosvwo0JkQ7kNvwFtd6IE&_nc_oc=Adojv85SEU3G8YPa3F8fifRoXoVq0PB06F-0-Keov9w7bxnjCAq5D6SXBOgw50U8OOc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxq_5KsGGneat9ayZ4c_hDg28Qzds0wSfBRsEMgPUTR8w&oe=69C3CF4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465256708481712"}, "review_messages": []}]}, "cover_square_image": {"uri": "
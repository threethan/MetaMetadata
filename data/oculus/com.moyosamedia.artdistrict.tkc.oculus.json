-7&_nc_sid=6e7a0a&_nc_ohc=EoY-vk092gYQ7kNvwGzY-71&_nc_oc=AdpxmBB4TNEAacR_RtdESXR0RM816CM-DQRzQnfH6TlKHtwlGoE7SHMG2lanmvPve3w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JcsgS8imzMUfLtUEGVtbKxkfHnNz0qgvUtaiz-6IwBw&oe=69DE39E6"}, {"file_name": "migrated_image.png", "id": "538687946649060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12504745_200384717251851_8459326741062615040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NVcFrU-XxEcQ7kNvwHZvwkA&_nc_oc=AdqxfhUIUq4bn2NgrAbpxroeYtsaCu1Lvp2xyKR_E2_9vw1kDBsu92iT6CzsATV43kw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23T61l2jo_71HcGj5N7OD91G_7JjWZPltHmEwOrWGtSw&oe=69DE334F"}, {"file_name": "migrated_image.png", "id": "486903698856969", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lg6eW02yyygQ7kNvwERT2zh&_nc_oc=AdpmRWad5SvLHHSQyJWG2UDnPKjg0D6xFZSbH2PoQqEIc7_gjqqeHXVPVT69THsv1hQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3gXRuUer9ZC6SoSxHO5FdZ6Mi5ueAIRq6hYueYMMfO8g&oe=69DE2EA4"}, {"file_name": "migrated_image.png", "id": "236710350845886", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410440_1822405177841081_113439822978220032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x9GdJYq8qTIQ7kNvwEryq3p&_nc_oc=Adr684RLimcEde_u99aZqY6ApFFcjmM8PYByosvC7Bo5jyk5e16T1Y7d5ee3tUPo-Ck&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kDmS85p8Z9GeZckGp9F7fQ8_T6P-oUqUVPAXQga1sUw&oe=69DE2D4D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465256708481712"}, "review_messages": []}]}, "cover_square_image": {"uri": "
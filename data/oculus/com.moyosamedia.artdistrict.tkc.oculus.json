6e7a0a&_nc_ohc=iGfx0ugZAw4Q7kNvwHhNfnm&_nc_oc=AdqxIpLpXsVTBgjW8UkxfcvJrWcHPlAaKmB7OZnVvMElJ66vHFnPJDTBFVRlLt08NYk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsKU2UrMPN7O9FhxbwknwfMcmllqQ3uXxEEsUKiM2OxQ&oe=6A8EDC4F"}, {"file_name": "migrated_image.png", "id": "556646814986841", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxt6rFBffd4Q7kNvwGANmJc&_nc_oc=AdrCs7Rx1bxz3pMHMP2cN_QCt4fmQ4EqfW6e-UeZnFqKGDsU4xx2uH_kYXCmFx4XylY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH439SRWQaYW0W5J6rpypz7y8jnvQNECz10a9t5jnPuCQ&oe=6A8ED7A4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/kBGzp7", "id": "1698381450276199", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/12504684_1698381453609532_5626861655494230016_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=So1ZhiXBVawQ7kNvwGIaiQ7&_nc_oc=AdoWt8uyBagIBWCjm_CFZuKl4uXmzYHzDDzFVMgMElCvddwV9aA5Yns1xkCGdmlPbgM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG32bZHRkRrtvHbGwz-k-M1qgAs44fCoayi0s_ZidJS5A&oe=6A8ECBCC"}, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1130125167752215"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "456129498313477"}, {"status": "PUBLISHED", "id": "742822112759748"}, {"status": "PUBLISHED", "id": "185241422392272"}, {"status": "PUBLISHED", "id": "1120145351519732"}, {"status": "PUBLISHED", "id": "695383574537107"}, {"status": "PUBLISHED", "id": "434398623889729"}, {"status": "PUBLISHED", "id": "732656540502174"}, {"status": "PUBLISHED", "id": "796887054007157"}, {"status": "PUBLISHED", "id": "1281085415414548"}, {"status": "PUBLISHED", "id": "442432563248
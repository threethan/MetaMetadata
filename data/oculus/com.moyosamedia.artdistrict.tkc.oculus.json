8fHWYzgW26cMlfSMFGNg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvlVrRHi3AwSt32y6XGlPmPS7IvnswBCcL4Bnb9R871pA&oe=699C4EE6"}, {"file_name": "migrated_image.png", "id": "538687946649060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12504745_200384717251851_8459326741062615040_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGYkq5ZZo9oQ7kNvwFdxtGQ&_nc_oc=AdlNs_VzqpGC-KPYSb9pBjBHqA5RvZMGVK-8cCLc35x_hvni0N6hrA9Y-npzJj3X-lg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfscyKVmxZi3P6W34OkOOV1Q7ElgynajO1jTwFSNggy8hw&oe=699C484F"}, {"file_name": "migrated_image.png", "id": "486903698856969", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410355_148634189332687_3529253027456221184_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CoWcWtomK8QQ7kNvwG2cX3n&_nc_oc=AdkmYJzujYR0v3zQBJ6Chj9ASov2GtpKZTW3q3P1M2E8WmztTZuZdRJGfWLpOetsWZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuQldSBnv0ckKCg6X2d3erz06q-vBQsu7Z2CPpVLN9PUg&oe=699C43A4"}, {"file_name": "migrated_image.png", "id": "236710350845886", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12410440_1822405177841081_113439822978220032_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjJO_2b84GcQ7kNvwEse_S3&_nc_oc=Adm2EZm7rcuOcmOJCJWzYGi5JpHC2vkzdtH510o_6t1coPS_q35u_UX-T4QVlyxn27k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvTQmJd7O4hTs84r8TIKPDLlNuDL-5MC0FNTjlsRQ9qtw&oe=699C424D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The Kremer Collection VR Museum", "keywords": ["Art", "Kremer", "Rembrandt", "Museum", "Gallery"], "long_description": "Art like never before. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age.\n\nWalk around a fantastic new space, where the balance between traditional museums and VR is represented through a new sort of architecture. Be sure to check out Rembrandt\u2019s \u201cold man with a turban\u201d, walk through it, and see the original back of the panel, to explore the work\u2019s unique stamps of provenance.\n\nDesigned by architect Johan van Lierop, Founder of Architales and developed by MOYOSA MEDIA from the Netherlands, the museum features 74 Dutch and Flemish Old Master paintings from the Dutch Golden Age, and is  accessible exclusively through VR.", "short_description": "History and future of the power of art combined. The Kremer Museum is an innovative new museum concept that combines the newest VR technology with world-class Old Master paintings. The museum includes pieces by Rembrandt, Aelbert Cuyp, Frans Hals and many more Old Masters from the Dutch Golden Age."}]}, "developer_name": "Moyosa Media BV", "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/61928640", "developer_terms_of_service_url": "https://termsfeed.com/terms-conditions/051227a0ff69016187322614025d0229", "publisher_name": "Moyosa Media BV", "support_website_url": null, "website_url": "http://kremer.moyosamedia.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ART_CREATIVITY", "DOCUMENTARY_HISTORY", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "465256708481712"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031382_2566874203540277_432423423394709504_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a
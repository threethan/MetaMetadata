55_1119060598239632_3252491919086845952_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ycGG74yY1mQQ7kNvwGF7O7g&_nc_oc=AdkR9qPDJXwYaC1L0oHrWO-iaNuhrsT15h4XjdYyxewHHQAI_EF0vtL1TgLGuzy9VQ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzAAvu-zZ-MRKehM1Iihny6esYf8D_8LckqYD6170IIMQ&oe=69B806F6"}, {"file_name": "migrated_image.png", "id": "681387799336031", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162677_1383098208368439_7476204943142027264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYIdED_JQ_IQ7kNvwF1VGOR&_nc_oc=Adlb_6VWO04WXil1FvVoNVp1SAsfBReHoi9sIo-UiRGQhm7vgDOJzMjIh9zqB5k_1_Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz6IyWFJdhOSxN7baWP9YAUqyY7wXoDj163eV4-Zk2cAw&oe=69B7EA85"}, {"file_name": "migrated_image.png", "id": "668514197274023", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12522493_414039975653442_9084267301791858688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pvUTbE_2IOAQ7kNvwElM5p-&_nc_oc=AdmRlY2Xw90DdsIFHJ_PIGOH-5UZdSqos3DlK_gJ_N3GPzp2QfMLCzcheFCGikRvjLQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afwg26nUgK47k5OOnyN_5NYLgJrg5Br-w6bWcKHAgGXncQ&oe=69B7F012"}, {"file_name": "migrated_image.png", "id": "193699318595946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_117991095359073_7145262740729233408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7FYBTvZ-7sQ7kNvwF8zgi7&_nc_oc=Adk4PuNWikM8ZG67YsIrIuBlR9ZuWBE27QCg8gccm3nZ3v9O2WbQwbnDkebpq_v57K4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzOfzK31Rm0o5Wt1oaAgGox4AU1Cm8K5YfZRsqFUmUFdw&oe=69B7E702"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TacoFace", "keywords": ["taco", "tacos", "truck", "laser", "rain"], "long_description": "Updated to support Gear VR Controller!\n\nHave you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality.\n\nFEATURING TWO GAME MODES:\n  TIME ATTACK - Eat as many tacos as you can in 60 seconds; there are no bombs so no need to worry.\n  SURVIVAL - Eat as many tacos as you can while tacos and bombs rain down on you. Destroy the bombs using your laser blasters to survive.\n\nDo you have what it takes to become the taco-eating* champion of the universe?\n\n*Please observe proper taco-eating etiquette at all times.", "short_description": "Have you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://klnk.co/tacoface", "developer_terms_of_service_url": "http://klnk.co/tacoface", "publisher_name": "KLNK Inc.", "support_website_url": null, "website_url": "http://klnk.co/tacoface", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1098648827640386"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162677_367736773580304_3879388352088113152_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6hXENnOhvYQ7kNvwFdKaXR&_nc_oc=Adkm6A1Ee9M9nsOshOcnmZm-p_7Y3nIPHwt1igVIU5MEzkf5dhjGLm-kqR6kgYQnGs0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKlGUpLaQjs_J0f0uw0FdNWLbTLGq7U01OJBvhBqa26A&oe=69B7FB42"}, "is_concept": false, "is_test": false, "is_trial
55_1119060598239632_3252491919086845952_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsR-6j2QZF4Q7kNvwGaJ-dn&_nc_oc=AdnGk_13tcHh1ytRA4rfE0VnKRJSktVOhgV3W049rh08g60as92jZF9XA-ln8O3rODU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftpmpT_WnjLotUbaZnfZg2XERd1eQO_mYp7Xj8xwBR_Ww&oe=69A98676"}, {"file_name": "migrated_image.png", "id": "681387799336031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162677_1383098208368439_7476204943142027264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cTDH38HHwBoQ7kNvwGkFkK1&_nc_oc=AdmpSknOj__ctTywB72foH7F2zMGhScPKBEMjvgH00GUuVOij1sLjoW9IkEDqXaAX6w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvCeH0F_iXw2GiqLjUMoAlFhWFuEO-B2Jr4qxQQkMhudA&oe=69A96A05"}, {"file_name": "migrated_image.png", "id": "668514197274023", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522493_414039975653442_9084267301791858688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhK8hStDMBAQ7kNvwFXIF3j&_nc_oc=Adnk-VHElHh0R5N4qHvsemJRv94BcbeVxoYOiVOMDlal3nz0KE4W1j-04yZpP110B3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftQtgbnmk5cO7G5PBBjzKTJg_JuahSSlyTVzjeEynbI1A&oe=69A96F92"}, {"file_name": "migrated_image.png", "id": "193699318595946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386444_117991095359073_7145262740729233408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBkr5Vp4iuQQ7kNvwHXAFir&_nc_oc=AdkpDwVsGjIMzY5n8_WOUADR3nV4SuhXcpBuMlb1Nh1Kk0Zjn_CFJ4gfH_rl2v-AQeY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfubkOPSdre5U5A4ZDCnwXpSEd1BDuLhaQtM4SqBvzy1wA&oe=69A96682"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TacoFace", "keywords": ["taco", "tacos", "truck", "laser", "rain"], "long_description": "Updated to support Gear VR Controller!\n\nHave you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality.\n\nFEATURING TWO GAME MODES:\n  TIME ATTACK - Eat as many tacos as you can in 60 seconds; there are no bombs so no need to worry.\n  SURVIVAL - Eat as many tacos as you can while tacos and bombs rain down on you. Destroy the bombs using your laser blasters to survive.\n\nDo you have what it takes to become the taco-eating* champion of the universe?\n\n*Please observe proper taco-eating etiquette at all times.", "short_description": "Have you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://klnk.co/tacoface", "developer_terms_of_service_url": "http://klnk.co/tacoface", "publisher_name": "KLNK Inc.", "support_website_url": null, "website_url": "http://klnk.co/tacoface", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1098648827640386"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162677_367736773580304_3879388352088113152_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=meeIPv89AO0Q7kNvwGa9yhh&_nc_oc=AdncXfEsj5nPTbIZ1DTyO6Ef-_Vi1xgmdSHlVD_FImBPcW1dhZkcJ_P58qrJWGHI3pY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfsLQ-ciPRSn3neFqRTXGvl3xitHBJOauN9FGgBqDWXEpw&oe=69A97AC2"}, "is_concept": false, "is_test": false, "is_trial
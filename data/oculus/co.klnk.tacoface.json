55_1119060598239632_3252491919086845952_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B0IGjRD4x_8Q7kNvwFEXuVa&_nc_oc=AdnyFkkgrMFNkXZadbPYMZvfi0rT8CPvlb5tTShnOPnETMwmZVm5Qy1Bd7A7WvtLUaY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwM2V7kKOlCvEiRHAq0Ncx6K82J1CATouXeyQ74GwX3Lw&oe=69B2C0F6"}, {"file_name": "migrated_image.png", "id": "681387799336031", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162677_1383098208368439_7476204943142027264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6W9CmBth6sQ7kNvwEYL-qK&_nc_oc=AdnkRiGRQXrqkLNo51Wid4T0Jwm9NiFam9ZFZApdv_nAPBp_nPOIQPgeDL06Cc8CxWY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwiz4w2QoReUz0Zwr_502MiA0SNsvR3W5Lq05OBKkx4Jg&oe=69B2A485"}, {"file_name": "migrated_image.png", "id": "668514197274023", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12522493_414039975653442_9084267301791858688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xu_t4YajnPgQ7kNvwF-xOc2&_nc_oc=AdlFpxSytfaPkjwde4GeHAMTs770sA_FAcAGvKPvl9nVqN6ueSTlu4_bqlal9v8zwG0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxrYeex7aReuUL8mGkxe_ywJEZK4eG5muHCFS1LyPvlVw&oe=69B2AA12"}, {"file_name": "migrated_image.png", "id": "193699318595946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_117991095359073_7145262740729233408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_LninLiOZIQ7kNvwF9OE49&_nc_oc=Adn3Z95tXaSJ2vpQUkWjCinh0vpCrLqslLaXoh7MusC7i1bdRh3S8wA5WKbQ4xifRIs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afx6c2lS5j_rafo_GBjSNgpPRYKzwjRl9flMBuhw8WZfBg&oe=69B2A102"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TacoFace", "keywords": ["taco", "tacos", "truck", "laser", "rain"], "long_description": "Updated to support Gear VR Controller!\n\nHave you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality.\n\nFEATURING TWO GAME MODES:\n  TIME ATTACK - Eat as many tacos as you can in 60 seconds; there are no bombs so no need to worry.\n  SURVIVAL - Eat as many tacos as you can while tacos and bombs rain down on you. Destroy the bombs using your laser blasters to survive.\n\nDo you have what it takes to become the taco-eating* champion of the universe?\n\n*Please observe proper taco-eating etiquette at all times.", "short_description": "Have you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://klnk.co/tacoface", "developer_terms_of_service_url": "http://klnk.co/tacoface", "publisher_name": "KLNK Inc.", "support_website_url": null, "website_url": "http://klnk.co/tacoface", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1098648827640386"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162677_367736773580304_3879388352088113152_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qzQvx2IvcboQ7kNvwFX7IQj&_nc_oc=AdkvHilBKg5DCB4Zj44xxrpF-o2B3cOBRJnw6sscBYIGyfTog95qhDnjftWpZTEXtZ8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwJXrnBA5cPsC8-A4Do2fn0vhseOZ6vITcbVCNOoYYUKg&oe=69B2B542"}, "is_concept": false, "is_test": false, "is_trial
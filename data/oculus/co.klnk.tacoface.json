55_1119060598239632_3252491919086845952_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wt-xe8sih-gQ7kNvwFaJzel&_nc_oc=AdmNcCON4boP2sYQnmceLrXOsUkQZW5yTnNMq0opfAZqjzMGKz45cUpkNqNqTRiFsRY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwOZvEriIfaebjuMLQP1r99TeEnIsmkbBsKvPxTVF-CPA&oe=69B95876"}, {"file_name": "migrated_image.png", "id": "681387799336031", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162677_1383098208368439_7476204943142027264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IYIdED_JQ_IQ7kNvwFsJPpI&_nc_oc=AdmmiE4dSwvv6FGICPnwBjkcaT_XfESyW_yOmSdvRgrBphXc7zjAaOzZvsa85Bq10LU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwT9M52FwpnEfCs0AIEl9eBgW43r7LPZOOOLEhIpIRDnw&oe=69B93C05"}, {"file_name": "migrated_image.png", "id": "668514197274023", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12522493_414039975653442_9084267301791858688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CXGa0vJkDmQQ7kNvwGnNu-F&_nc_oc=AdmI45UJ_E0UhGIAG8zFW0eDRgZbA9paenxKWsxkwKlfg1rDx8JyGfieUsVnBXzczcA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxc4IMMao8MN4lGfW0Zrn_rnlPtRg7MGUdD6i_FUF7Dqg&oe=69B94192"}, {"file_name": "migrated_image.png", "id": "193699318595946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_117991095359073_7145262740729233408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e7FYBTvZ-7sQ7kNvwG_Lsaz&_nc_oc=AdkiQIS8w5mE204fp4U6T3eo0ZhKXtOtZEX_D6_aHM8ICkGOaqS0ibFtIWiafVCH2-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxRK1YC_SJgdqaVESPM1dpC5YGon5WaEXwgc-odmdx69Q&oe=69B93882"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TacoFace", "keywords": ["taco", "tacos", "truck", "laser", "rain"], "long_description": "Updated to support Gear VR Controller!\n\nHave you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality.\n\nFEATURING TWO GAME MODES:\n  TIME ATTACK - Eat as many tacos as you can in 60 seconds; there are no bombs so no need to worry.\n  SURVIVAL - Eat as many tacos as you can while tacos and bombs rain down on you. Destroy the bombs using your laser blasters to survive.\n\nDo you have what it takes to become the taco-eating* champion of the universe?\n\n*Please observe proper taco-eating etiquette at all times.", "short_description": "Have you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://klnk.co/tacoface", "developer_terms_of_service_url": "http://klnk.co/tacoface", "publisher_name": "KLNK Inc.", "support_website_url": null, "website_url": "http://klnk.co/tacoface", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1098648827640386"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162677_367736773580304_3879388352088113152_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6hXENnOhvYQ7kNvwG7res3&_nc_oc=AdnQ-0OlkZKio7szguhzkRlYRD1SKD8Z9qEpbVsGc-qDTP7jO5HOaEU26uWtDD3JEnU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfywmaEYfaS8TWGXNc_JoROSmmaQTD79yOlHhGM455yW_A&oe=69B94CC2"}, "is_concept": false, "is_test": false, "is_trial
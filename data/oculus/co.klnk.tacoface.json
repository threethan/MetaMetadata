55_1119060598239632_3252491919086845952_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdLntgtKUvAQ7kNvwGzfYXe&_nc_oc=Adlsk-xkQPTG_ZYVtb4oAS6PJOTTp-MYXa_tM0prT1nPczprQPGRKhPKI3Guz2LSyi0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwror4uy3F-32Zi0oXNAYSyrfPGSghkxE-yCsTpeoVCPw&oe=69BFEFF6"}, {"file_name": "migrated_image.png", "id": "681387799336031", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162677_1383098208368439_7476204943142027264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5gHJJMFnIcoQ7kNvwEITpOO&_nc_oc=AdmHWv0IDHlfkENviddYwtqJQi5y4eXa3pl00cKFS8hjzuWQuvtVzOnqIDSWlkDJ8GE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfybO0SGtXnlpBJi0lCM004Sd7ClZW14VzzN9MMiUheg-Q&oe=69BFD385"}, {"file_name": "migrated_image.png", "id": "668514197274023", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12522493_414039975653442_9084267301791858688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FxZNXyVvzucQ7kNvwH0l7iw&_nc_oc=AdnFO4zqohjAfeNPUsxuArIvdjFXhPRO-KAEkJKJ5OzBR0wNM8znLmDp4A1xNMGF0XU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeAPxyjkpSINwRjLIj2M2c3zh4Q6H7MxAq7-CKTTwq_g&oe=69BFD912"}, {"file_name": "migrated_image.png", "id": "193699318595946", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12386444_117991095359073_7145262740729233408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBqOiaKU1C0Q7kNvwEBLSI5&_nc_oc=AdltEMR-rd2pr50rJiCJGnJyV0_tgQhmiRMCWaHrQ03ptesfjn-zwkgJeT6qs2_Opgk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwWj7xLJOlQk8BYaXYnl68QyBYS1gBwD9HOiolj8YtDmw&oe=69BFD002"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TacoFace", "keywords": ["taco", "tacos", "truck", "laser", "rain"], "long_description": "Updated to support Gear VR Controller!\n\nHave you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality.\n\nFEATURING TWO GAME MODES:\n  TIME ATTACK - Eat as many tacos as you can in 60 seconds; there are no bombs so no need to worry.\n  SURVIVAL - Eat as many tacos as you can while tacos and bombs rain down on you. Destroy the bombs using your laser blasters to survive.\n\nDo you have what it takes to become the taco-eating* champion of the universe?\n\n*Please observe proper taco-eating etiquette at all times.", "short_description": "Have you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://klnk.co/tacoface", "developer_terms_of_service_url": "http://klnk.co/tacoface", "publisher_name": "KLNK Inc.", "support_website_url": null, "website_url": "http://klnk.co/tacoface", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1098648827640386"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162677_367736773580304_3879388352088113152_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1JBnpWXNVkQ7kNvwExhV32&_nc_oc=AdnS9leOsNmAzOBp0CtuTHKAPVq2dZXmWiAZtXTTG1mvDYLN4brDhBdohtUgBNmUV3o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyaUxXUM8_u90E0qXhKpNSmLCGLnQfoUhogn6dBRm8Nxg&oe=69BFE442"}, "is_concept": false, "is_test": false, "is_trial
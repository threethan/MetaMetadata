55_1119060598239632_3252491919086845952_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsR-6j2QZF4Q7kNvwHgtEwz&_nc_oc=AdkwWBFMjn1UABaCNG5yaNn_OvuU90HAcsTIUJqZXtX6m2goRcIl78un78IkINZ7EwM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afy5dbBe5S21AswenhmEdflt6abyeLlfYUEsuOIuW9aUkg&oe=69AC2976"}, {"file_name": "migrated_image.png", "id": "681387799336031", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162677_1383098208368439_7476204943142027264_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rGAbK-ZGYcsQ7kNvwE0I6wu&_nc_oc=AdluPhmy6Cpr60xWQeDTajAwbrJFylXLvcyJBxQMBEGYkXq8nqaZI_yX5S7YKWKil-E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx6GqzJrMK1acx6Vemfmp-CQFLqCju-VM4D3dXLeOatFQ&oe=69AC0D05"}, {"file_name": "migrated_image.png", "id": "668514197274023", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12522493_414039975653442_9084267301791858688_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhK8hStDMBAQ7kNvwF8dE5U&_nc_oc=AdnbAkLIOZYuItqRwYYqe5e1RhQ90wMXBUetebDEIsTjbqSwRRubcGyWb4_F_63acSc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwqg27DEYhBAUygZWj9vUX10qoypoeoDqr6U9PW5NvSnw&oe=69AC1292"}, {"file_name": "migrated_image.png", "id": "193699318595946", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386444_117991095359073_7145262740729233408_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBkr5Vp4iuQQ7kNvwENIYgm&_nc_oc=AdlrK2xvYiiA_Ucxvsbv-wftBg2iDoBVALu493MGi82QNVzQBpK97Xr2oqpBUSrzfwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwJiK5wBye__OR2-fjWzQtPP5CUoYIupIidF9YQeoFWXw&oe=69AC0982"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "TacoFace", "keywords": ["taco", "tacos", "truck", "laser", "rain"], "long_description": "Updated to support Gear VR Controller!\n\nHave you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality.\n\nFEATURING TWO GAME MODES:\n  TIME ATTACK - Eat as many tacos as you can in 60 seconds; there are no bombs so no need to worry.\n  SURVIVAL - Eat as many tacos as you can while tacos and bombs rain down on you. Destroy the bombs using your laser blasters to survive.\n\nDo you have what it takes to become the taco-eating* champion of the universe?\n\n*Please observe proper taco-eating etiquette at all times.", "short_description": "Have you ever dreamed of having rocket launchers for arms and laser blasters for eyes while delicious tacos rain down on you? Well, your dream is now a reality. Uh, virtual reality."}]}, "developer_name": null, "developer_privacy_policy_url": "http://klnk.co/tacoface", "developer_terms_of_service_url": "http://klnk.co/tacoface", "publisher_name": "KLNK Inc.", "support_website_url": null, "website_url": "http://klnk.co/tacoface", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "CASUAL", "SHOOTER", "SPORTS"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD", "GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1098648827640386"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162677_367736773580304_3879388352088113152_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TR0qXIEVW8wQ7kNvwGExJM3&_nc_oc=Adnqpo0gex_xUcHytYH2fI9CuRcCI6X3TRwkGq_G55ca1VLHxI0bCGNtIm4l6-K6NyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwgqGgt53gE-vvemiOevyqpen-tWwRUvHyK_3TlH9siSg&oe=69AC1DC2"}, "is_concept": false, "is_test": false, "is_trial
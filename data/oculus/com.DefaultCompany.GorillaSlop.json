71631", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499313063_1046308128104964_4523987230342106432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LBNbjACIZiQQ7kNvwEB_b2f&_nc_oc=AdoAAF1PwQHDtihFAt9A6HldWvYfGnwa2YIJjaC-HE3TebzFEaTY0krnXy770-zlTdw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0ZJ7L2bAw2fSnuHFkwTw0d245p07QCF65vIt7GXjwWg&oe=6ADF47E2"}, {"file_name": "SampleScene_2026-08-09_15-48-58.png", "id": "1579496973835522", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499312338_1579496977168855_7764047056128321855_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GxpMgwVBnoUQ7kNvwHw3p_U&_nc_oc=AdqkUDr_gTrX3A3FvwCgUx8xC9v7w1J2NRuzz8RIwY7HucAFSKeJi5UQHTc5XGovzHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrgwkCI1kJNC0F6W3nYUg0vKTj7mKdIkMZZRMbQwCfXA&oe=6ADF7B2B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkari", "keywords": [], "long_description": "Welcome to Monkari, a fast-paced multiplayer adventure where your hands are your greatest tool. Move through the world with intuitive hand-based locomotion, climb towering structures, leap across obstacles, and discover new places alongside other players.\n\nMeet new friends, explore unique environments, and express yourself with a variety of cosmetics. Whether you're racing through maps, practicing advanced movement techniques, or just hanging out, every session offers a new experience.\n\nNo complicated controls\u2014just your movement, your skill, and your creativity. Master the mechanics, challenge yourself, and become part of the growing Monkari community.", "short_description": "Welcome to Monkari, where every jump, climb, and dash is powered by you. Swing through exciting environments, meet other players, and show off your style with unique cosmetics. Learn new movement techniques, explore hidden areas, and push your skills to the limit. Whether you're here to compete, explore, or just have fun, there's always an adventure waiting in Monkari."}]}, "developer_name": "LowkSillyStu", "developer_privacy_policy_url": "https://sites.google.com/view/monkari/home", "developer_terms_of_service_url": null, "publisher_name": "Bones", "support_website_url": null, "website_url": "https://sites.google.com/view/monkari/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "4142489282709070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620965_990492667354975_2932538149917567945_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVGTEUkTXjEQ7kNvwEK4GXD&_nc_oc=AdpazDepQVjhoRnUt1sFuYA3-c0u1Qjs2FeYawWl77wSRyZla3aj-0lDuAadWzljoho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2v4ftwO0UKB4ObXSlcosZaVVr13VAGrPAQ3TiuLmhNA&oe=6ADF6FFD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkari", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1787355660, "lastRevision": {"nodes": [{"id": "4137635583194440", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_
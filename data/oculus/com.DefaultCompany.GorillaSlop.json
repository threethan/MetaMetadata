71631", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499313063_1046308128104964_4523987230342106432_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xx4PiYoSAt4Q7kNvwGUuDmD&_nc_oc=AdpH54IXvhhndekP1-b_ujua_OIN8lagJt2XFPSxnK2qvrTDVFMpUycW4UEnDf8zVR4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkqNeYYs5P_eHqFZNSOvnPu7sV8ZkadY8DBCH8Axvo3Q&oe=6AF1F522"}, {"file_name": "SampleScene_2026-08-09_15-48-58.png", "id": "1579496973835522", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312338_1579496977168855_7764047056128321855_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JFt7Bs_oIQgQ7kNvwFjUYlF&_nc_oc=AdpbnM0P0RksOgxswcuVDBB56R9Nv-0Ova5e_ycKr7zjCvY_UlR6hRVe2Tcm-V4dVPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRy8KZvJvUMzegbJ63E68PKKneC1wAuBcQLakQDiItJ6w&oe=6AF1F02B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkari", "keywords": [], "long_description": "Welcome to Monkari, a fast-paced multiplayer adventure where your hands are your greatest tool. Move through the world with intuitive hand-based locomotion, climb towering structures, leap across obstacles, and discover new places alongside other players.\n\nMeet new friends, explore unique environments, and express yourself with a variety of cosmetics. Whether you're racing through maps, practicing advanced movement techniques, or just hanging out, every session offers a new experience.\n\nNo complicated controls\u2014just your movement, your skill, and your creativity. Master the mechanics, challenge yourself, and become part of the growing Monkari community.", "short_description": "Welcome to Monkari, where every jump, climb, and dash is powered by you. Swing through exciting environments, meet other players, and show off your style with unique cosmetics. Learn new movement techniques, explore hidden areas, and push your skills to the limit. Whether you're here to compete, explore, or just have fun, there's always an adventure waiting in Monkari."}]}, "developer_name": "LowkSillyStu", "developer_privacy_policy_url": "https://sites.google.com/view/monkari/home", "developer_terms_of_service_url": null, "publisher_name": "Bones", "support_website_url": null, "website_url": "https://sites.google.com/view/monkari/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "4142489282709070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620965_990492667354975_2932538149917567945_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olUdfUyyD10Q7kNvwEU34hr&_nc_oc=Ado_FMXZgwHYFKYt9EIc9seek29S1QmKUsvbC6pmmblj4sCQQA7rNR3zmnW__oQcAKo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqBhDpgCISqEF2v0GaZGew6yOjF4lUzJKHDqoCiPuC-g&oe=6AF1E4FD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkari", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Platformer", "id": "528142316460358"}], "release_date": 1787355660, "lastRevision": {"nodes": [{"id": "4137635583194440", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_
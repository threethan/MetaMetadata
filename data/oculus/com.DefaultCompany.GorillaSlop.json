wing through exciting environments, meet other players, and show off your style with unique cosmetics. Learn new movement techniques, explore hidden areas, and push your skills to the limit. Whether you're here to compete, explore, or just have fun, there's always an adventure waiting in Monkari."}]}, "developer_name": "LowkSillyStu", "developer_privacy_policy_url": "https://sites.google.com/view/monkari/home", "developer_terms_of_service_url": null, "publisher_name": "Bones", "support_website_url": null, "website_url": "https://sites.google.com/view/monkari/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "4142489282709070"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620965_990492667354975_2932538149917567945_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ZGQeY0eYY0Q7kNvwH6xHkQ&_nc_oc=AdodIPGLaP-00HoCDXPowuML7UTOCeCAiMG3-3yMK4hzdM_85K_CGL-fPn_EvUZihA8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQT9cVfkU7BxCERZ40VgewJvr6hIr7Xeye0BX6OaMvF0w&oe=6B0C7B3D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monkari", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action",
r1LjVJne4JW1ACRx6PsEodLZ-RhKmy3lBLSM8v8bPRVf8b96Fi8oE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPlM3i0GU_rrWzh7-28v3Ky9mXW0NH0nJxaboaZ2z1rQ&oe=6AFDD741"}, {"file_name": "shotbase-3-touchup-quest.png", "id": "1813208503017667", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830904_1813208506351000_1726170686306118436_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfh8Whik26oQ7kNvwGdgZZx&_nc_oc=AdqnF833jEO2mwvMgcNi_UUSXR1RgDBotR6ROHOxrdQdM5ihWPG09PZ-J6sGJLNG0qg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoyfQGRYm4jrQTu27ElAs_rT7AHyxt0O2cHop2-NVKbQ&oe=6AFDB2CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ShutterBase Thumbnail 2560x1440.png", "id": "1809184860113130", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491830822_1809184863446463_2667756823744922501_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BXMH7fIUpsIQ7kNvwG5cI0B&_nc_oc=AdqKFpJgeuGjiNkQ6s0qh0wBX7DVmCKFctE0uLuIFj-FhI6VifnfqfUn27EJLAo0sc0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlJEmdTx6v3uXdgeghMMSzKMNj3MvEfTgq_G-9w_kuAg&oe=6AFDBFE2"}, "display_name": "ShutterBase", "keywords": ["camera", "image", "raw", "photography", "editing"], "long_description": "# Your darkroom, wherever you shoot\nTurn your Meta Quest into a portable photo studio. Import your shots, edit on a large, glare-free screen, and prepare client proofs before you pack up.\n\n# Bring your camera\nOpen RAW files from Canon, Nikon, Sony, Fujifilm and more, plus JPEG, HEIC, TIFF and PNG. Import from a camera or card reader over USB-C, open files on headset storage, or send photos from your phone or computer over Wi-Fi with Local Access.\n\n{4768836143387438}\n\n# Find your best frames\nRate, flag and color-label photos. Organize them into folders and collections, filter your library, and keep referenced files on their drives.\n\n# Shape every detail\nAdjust exposure, white balance, highlights, shadows and color. Refine your look with tone curves, a color mixer, color grading, sharpening, noise reduction, lens corrections and crop tools. Save presets and copy settings across a selection.\n\n# Make precise changes\nMask a subject, sky or background, select by color or brightness, or paint with a brush. Remove distractions with Heal and Clone. Focus view fades the panels back so you can judge the photo.\n\n{1342853887792897}\n\n# Deliver with your name on it\nExport JPEG, TIFF, or PNG. Choose size, quality and metadata, and add copyright labels or watermarks.\n\n# Keep your photos yours\nPhoto processing runs on your headset, with no cloud or AI service. Edits are saved separately, leaving originals untouched. Importing, editing and exporting work offline.\n\nOne purchase. Every tool included. No subscription.", "short_description": "Turn your Meta Quest into a portable photo studio. Import RAW files from your camera, a USB card reader, headset storage, or over Wi-Fi. Cull and organize your shots, adjust light and color, and make precise edits with masks, Heal, and Clone. Work on a large, glare-free screen, then export finished images with your watermark and copyright metadata. Your originals stay untouched and photo processing stays on your headset. From first selects to client proofs, take your darkroom wherever you shoot."}]}, "developer_name": null, "developer_privacy_policy_url": "https://spatialbase.co/shutterbase/privacy/", "developer_terms_of_service_url": null, "publisher_name": "SpatialBase", "support_website_url": null, "website_url": "https://spatialbase.co/shutterbase/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "inte
Z3k4Q7kNvwEss2je&_nc_oc=AdmXlSdViOCwyVvWV3Su_RCcFZU5G-FQvFEt_OY8JifDQiNTo_7Z-HimMEduK_DgdO0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwyJOaqOfTu9qf27-0H2uZjFo_7EivX793fTnDriQaZWg&oe=69B95124"}, {"file_name": "screenshoot_03.png", "id": "1352746406572386", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827567_1352746409905719_7557399453042494386_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-ioqH9KSlpgQ7kNvwHY75iY&_nc_oc=AdlI5Tw84ZmmYfe1T02h8iFSaztm31yI_2EPd40FSfSg6MIrqcdodoPBGG6Hp9yP-pY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzRbrB7Pp7upAFl19DLXNzTKo5gTqque-SDEAhuup9Glw&oe=69B93290"}, {"file_name": "screenshoot_04.png", "id": "973969308406204", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491822307_973969315072870_386045648968861927_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DlMc7Qo0KYQ7kNvwGMGj3O&_nc_oc=Adl7bLhD71ZcDzcf-mbShYLuZ3tAGPdAC1jYlebZI6Sa0SarcrMExXmfY5XVKR8UoEA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUTdUrfmY702ZLR3eNcTdnYoQxVgLRH3c5bs9N8XR65w&oe=69B93DFD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AG Albums 360", "keywords": ["virtual", "tour", "albums", "ag", "albums360"], "long_description": "AG Albums360 - Experience immersive 360\u00b0 panoramic tours directly on your Meta Quest headset. \n\nBrowse your device storage to find and select .vtour archive files. The app automatically extracts them and launches them in immersive VR mode within Oculus Browser.\n\nFeatures:\n\u2022 Visual file explorer with directory navigation\n\u2022 Support for .vtour panoramic tour archives\n\u2022 Multi-language interface (Catalan, Spanish, English)\n\u2022 Language preference persistence\n\u2022 Real-time extraction progress tracking\n\u2022 Optimized for Meta Quest 2 and Pro headsets\n\nPerfect for:\n- Travel enthusiasts exploring virtual locations\n- Architecture and real estate professionals\n- Museum and cultural institution experiences\n- Virtual tours and immersive storytelling\n\nDevice Storage: The app accesses files from your Quest's internal storage (typically /sdcard/Download) to find and play compatible tour files.\n\nPrivacy: No data collection, no advertising, local processing only.\n", "short_description": "Browse and play 360\u00b0 panoramic tours on Meta Quest"}, {"images": {"nodes": [{"file_name": "Miniatura_Horizonta_1.png", "id": "4465613507094746", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820387_4465613513761412_8017434051719727320_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnp0mLm7E64Q7kNvwH7rpiQ&_nc_oc=AdkK7mtzHzA6-mnbZzH6J7JrD-FPgLV9_6sO0Jq8p8nFWCyjl8R6sl0W2lw_l7kYURM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz-haiJXv2Au_9db3gLNevXSvGnAZQ-e8TYQGEpjLuiNA&oe=69B94D25"}, {"file_name": "Miniatura_Quadrado_1.png", "id": "1657996252037470", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818849_1657996255370803_4894886329234613232_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Pc58MtuG50Q7kNvwFae5MZ&_nc_oc=AdlvtrUNDvv8lmo2aHvZIkjteYXt3JIfUHRXCSQmy7iNMiN_ZtLDthNPnvL4KGWCWws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQNMH_-PIgBzF6L1_n-hC4S1zZcEhV_o1kxsONVWfF2w&oe=69B946DE"}, {"file_name": "Icono_512x512_1.png", "id": "1254482923336241", "image_type": "APP_IMG_ICON", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824307_1254482926669574_8850452282837976129_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFNwuYk3uvYQ7kNvwHPDZMY&_nc_oc=Adk2gZgeG9lAIt4kRqn-BjBR3PstnzmkD-ThXbFrWSz7E_n_X3ooeWFcbaL0_Kljghg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwJaEcqQmQ81t5xlf3MmLXaimHhR1__w7xC97xqpzDy9w&oe=69B94E6E"}, {"file_name": "Portada_principal_1.png", "id": "1227577015686443", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823837_1227577022353109_5060019138764007136_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8GFNsFz83QQ7kNvwFiiBRK&_nc_oc=AdnGBWRAg2t6uRzX10bZ3fgXOj6LKrL_ubJXG1tkaiApm_r-2ywN5GWrEmxWYBaP_9o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxYrIOP8PZ4Bmi0xLgRXqdLpjKExm74SwCK74BxVyeWZA&oe=69B96312"}, {"file_name": "Logotipo_1.png", "id": "862297363470665", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820428_862297370137331_5103042544862437736_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baUFAuafIZgQ7kNvwG0jIgf&_nc_oc=AdnHWFZX2a9kR8HUf2nzA7FFfIsG2EDy1h-eIZvbAI_tbkMkl3Dik6Wm3-QwxOXLcyk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwPD3ZLtipSGRTTZrur-MKCVvBlPGicZgyIx7aucTONZQ&oe=69B94183"}, {"file_name": "Miniatura_Vertical_1.png", "id": "813565841768858", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822327_813565845102191_7278965707887070921_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J96u45JQEqEQ7kNvwFgsIGI&_nc_oc=Adn_2n9a5OOZ7drhcW0_JnD0LyVjy-WcvnYJsZb6h7aIVItbDNUElkUv0lUx08qmLFA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxs8Ux5umt7TonO2heg5I40Wv10Y9FpZ8vsurCGGAvk3A&oe=69B95987"}]}, "id": "902187959365071", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "AG Albumes 360", "keywords": ["tours", "virtuales", "ag", "albumes", "albums360"], "long_description": "AG Albums360 - Experimenta recorridos panor\u00e1micos inmersivos en 360\u00b0 directamente en tu visor Meta Quest.\n\nExplora el almacenamiento de tu dispositivo para encontrar y seleccionar archivos .vtour. La aplicaci\u00f3n los extrae autom\u00e1ticamente y los inicia en modo VR inmersivo dentro de Oculus Browser.\n\nCaracter\u00edsticas:\n\u2022 Explorador visual de archivos con navegaci\u00f3n por carpetas\n\u2022 Compatible con archivos de recorridos panor\u00e1micos .vtour\n\u2022 Interfaz multidioma (catal\u00e1n, espa\u00f1ol, ingl\u00e9s)\n\u2022 Preferencia de idioma persistente\n\u2022 Seguimiento del progreso de extracci\u00f3n en tiempo real\n\u2022 Optimizado para visores Meta Quest 2 y Quest Pro\n\nPerfecto para:\n\nPersonas amantes de los viajes que desean explorar ubicaciones virtuales\n\nProfesionales de arquitectura e inmobiliaria\n\nExperiencias de museos e instituciones culturales\n\nTours virtuales y narrativa inmersiva\n\nAlmacenamiento del dispositivo:\nLa aplicaci\u00f3n accede a archivos del almacenamiento interno de tu Quest (normalmente /sdcard/Download) para encontrar y reproducir recorridos compatibles.\n\nPrivacidad:\nSin recopilaci\u00f3n de datos, sin publicidad y con procesamiento totalmente local.", "short_description": "AG Albums360 - Experimenta recorridos panor\u00e1micos inmersivos en 360\u00b0 directamente en tu visor Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://agalbums360.com/privacyappeng/", "developer_terms_of_service_url": null, "publisher_name": "AG Albums 360", "support_website_url": null, "website_url": "https://agalbums360.cat/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ca", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26039076042412632"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822327_797939133225021_7208154984777333657_n.png?stp=dst-png_s
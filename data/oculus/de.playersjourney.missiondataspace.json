548050852_n.png", "id": "2650973571968086", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818852_2650973575301419_6206023319237208257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcfsCg2i-5cQ7kNvwF934Ew&_nc_oc=Adps0pi87s8oy6XcQcmb4I4Fwd1UhtNZmea1T-ScIKTKVmaB5Wb_d6TNY-lZtyjKzXs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgD068ASNWZ3lxQYZyiRuJPaWy-GPzJyq119Kt6WknTg&oe=6A86FD38"}, {"file_name": "491823286_1530540294921651_8551984079506413285_n.png", "id": "1029861315975429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821725_1029861322642095_3558292827793715579_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3r4Vkjz-EoQ7kNvwHJn5HG&_nc_oc=AdokqQss3H3h4-USgOlUsPHzyJmz4kLq5FhqqxsrjdJlY--mW6wFU_QWZxZVTSk8RRU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjhbygPP5FyoZoMMF8ZH_w3_fSHSFtpyT51Ys6ZW95XQ&oe=6A86DD9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mission Dataspace", "keywords": [], "long_description": "The game uses a Virtual Board (mapped on a table) with real-time events to represent the own production site and the physical space around this area to visualize the Supply Chain Network. The FutureMobilityMover is representing the progress of the game and is visible in the center of the game. Each Component of the FutureMobilityMover can be selected individually and represents a quest for players to solve. A quest is completed once the component has been built.\nThe game's goal is to have a high utilization rate of the production facility and finally build the FutureMobilityMover together.\n", "short_description": "Players take on the role of a business manager producing components for a futuristic transport vehicle known as the Future Mobility Mover.\n\nThe game combines incremental basic management/automation mechanics with increasingly complex challenges like new Requirements for the Production, highlighting the importance of efficient data management. The game uses XR technology to project elements into a pass-through environment, allowing interaction with digital elements in a real-world setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playersjourney.de/datenschutz-mission-dataspace", "developer_terms_of_service_url": null, "publisher_name": "Playersjourney GmbH", "support_website_url": null, "website_url": "https://www.playersjourney.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25776305058673725"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820923_1449228306820981_9008102242452140101_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pzCUGNezWrwQ7kNvwEP9lVe&_nc_oc=AdrFbazeCh9rabU8e-ZwCCaufy9vrW_sS-O5fpb2lyNtqXRC6g2D7XjAdeGF62x_tUg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa5JDXWoW_LhH9D-Ws2L9T0Okh3ZlUkdn-z5aeOrucKA&oe=6A86FDB8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mission Dataspace", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1767776100, "lastRevision": {"nodes": [{"id": 
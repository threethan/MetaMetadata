020003868791961", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819982_2020003872125294_4858869764653648933_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdBCA8530OMQ7kNvwF0XUl1&_nc_oc=Adq84WjEnVYyOoWvggEvY3lYknZuT48HjVV6awEA-vtOLwCJ0lyakucKuRmGEWIdDUk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFucj-PRuvmOmhRJfkjWJvwPhZsoapqxhJVomXGNhGYaQ&oe=6A86D3EE"}, {"file_name": "491823940_32776367638676874_6041744969548050852_n.png", "id": "2650973571968086", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818852_2650973575301419_6206023319237208257_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcfsCg2i-5cQ7kNvwF934Ew&_nc_oc=Adps0pi87s8oy6XcQcmb4I4Fwd1UhtNZmea1T-ScIKTKVmaB5Wb_d6TNY-lZtyjKzXs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgD068ASNWZ3lxQYZyiRuJPaWy-GPzJyq119Kt6WknTg&oe=6A86FD38"}, {"file_name": "491823286_1530540294921651_8551984079506413285_n.png", "id": "1029861315975429", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821725_1029861322642095_3558292827793715579_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b3r4Vkjz-EoQ7kNvwHJn5HG&_nc_oc=AdokqQss3H3h4-USgOlUsPHzyJmz4kLq5FhqqxsrjdJlY--mW6wFU_QWZxZVTSk8RRU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjhbygPP5FyoZoMMF8ZH_w3_fSHSFtpyT51Ys6ZW95XQ&oe=6A86DD9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mission Dataspace", "keywords": [], "long_description": "The game uses a Virtual Board (mapped on a table) with real-time events to represent the own production site and the physical space around this area to visualize the Supply Chain Network. The FutureMobilityMover is representing the progress of the game and is visible in the center of the game. Each Component of the FutureMobilityMover can be selected individually and represents a quest for players to solve. A quest is completed once the component has been built.\nThe game's goal is to have a high utilization rate of the production facility and finally build the FutureMobilityMover together.\n", "short_description": "Players take on the role of a business manager producing components for a futuristic transport vehicle known as the Future Mobility Mover.\n\nThe game combines incremental basic management/automation mechanics with increasingly complex challenges like new Requirements for the Production, highlighting the importance of efficient data management. The game uses XR technology to project elements into a pass-through environment, allowing interaction with digital elements in a real-world setting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.playersjourney.de/datenschutz-mission-dataspace", "developer_terms_of_service_url": null, "publisher_name": "Playersjourney GmbH", "support_website_url": null, "website_url": "https://www.playersjourney.de/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1043107547362485"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "de"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25776305058673725"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "715043768342131"}]}, "baseline_offer": {"id": "715043768342131"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1767776100, "status": "PUBLISHED", "id": "715043768342131"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2561
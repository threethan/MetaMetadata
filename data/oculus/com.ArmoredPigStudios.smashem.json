t5kGtx-PKp9iu5TnvhWg5aMTpfV1zZog2blMiQ&oe=6AE5E3C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover.png", "id": "1374865631452368", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499310731_1374865634785701_7288660955128246003_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWqf_J-072QQ7kNvwHoDE0s&_nc_oc=Adro7yn14nBvCDj-pyo9knWHO6ZgQ5HeBYCxozfpw6eeKgT070e4kEd5iTEbOph2Afw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlSvHh9FL8S3PIM3BZF7OjymMKNniGOv-6YbaYb-3CYQ&oe=6AE5F350"}, "display_name": "Smash 'Em", "keywords": ["fighting", "retro", "gore", "fight", "combat"], "long_description": "You have one goal\u2026 \n\n**SMASH \u2018EM**\n\nFight through hordes of angry enemies in order to get revenge on them for taking over your world.  Use your fists, various weapons, and even powers in order to defeat the horde.\n\nAs you progress through the levels, receive various upgrades as the enemies get more difficult.\n\n**Intense Melee Combat!**\n\n{1773219323840210}\n\n**Cause Chaos!**\n\nCause extreme carnage and chaos through your violence!\n\n{978583751643286}\n\n**Use Powers!**\n\nLeverage the use of more than four different powers to defeat your foes!\n\n{2061456481460783}\n\n**More than 10 weapons!**\n\nTake advantage of more than 10 different unique weapons to cause the most creative violence.\n\n{1335396602024828}\n\n\n", "short_description": "Take revenge on the horde that conquered your world. Smash enemies with your fists, master devastating powers, and create absolute chaos with a huge arsenal of weapons."}]}, "developer_name": "AP Studio", "developer_privacy_policy_url": "https://sites.google.com/view/infernal-climb-vr/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/infernal-climb-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2
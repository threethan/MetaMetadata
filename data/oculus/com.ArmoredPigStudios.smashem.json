p=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0edZwK_RE0wQ7kNvwHuiIwK&_nc_oc=Adq9kZ8H_qRvliJB2qCpYhdNS6IC2R5jI-pcVrhkw-anM3U6GfnuFnsMRwYfL1gI1qw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnDsRHvYepZb6GFizOQZxIqeNUjOIZbR_Sk7r5vgDDJg&oe=6AFC81E8"}, "display_name": "SMASH THEM", "keywords": ["fighting", "retro", "gore", "fight", "combat"], "long_description": "You have one goal\u2026 \n\n**SMASH \u2018EM**\n\nFight through hordes of angry enemies in order to get revenge on them for taking over your world.  Use your fists, various weapons, and even powers in order to defeat the horde.\n\nAs you progress through the levels, receive various upgrades as the enemies get more difficult.\n\n**Intense Melee Combat!**\n\n{1773219323840210}\n\n**Cause Chaos!**\n\nCause extreme carnage and chaos through your violence!\n\n{978583751643286}\n\n**Use Powers!**\n\nLeverage the use of more than four different powers to defeat your foes!\n\n{2061456481460783}\n\n**More than 10 weapons!**\n\nTake advantage of more than 10 different unique weapons to cause the most creative violence.\n\n{1335396602024828}\n\n\n", "short_description": "Take revenge on the horde that conquered your world. Smash enemies with your fists, master devastating powers, and create absolute chaos with a huge arsenal of weapons."}]}, "developer_name": "AP Studio", "developer_privacy_policy_url": "https://sites.google.com/view/infernal-climb-vr/home", "developer_terms_of_service_url": null, "publisher_name": "AP Publishing", "support_website_url": null, "website_url": "https://sites.google.com/view/infernal-climb-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null,
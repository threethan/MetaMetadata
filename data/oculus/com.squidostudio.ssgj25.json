cb=1-7&_nc_sid=6e7a0a&_nc_ohc=fdmEPRp1g_MQ7kNvwF_2BSe&_nc_oc=AdoehXf1qK550Ro-eq8l9Ub7Ks3sRfi4OBjQ9VR7KJiBgAV0bWEYBl47U7PyrseAifo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OG7Sjgo-6bMU9sCVSULjdGyeGPtAeIDaxf-xbeqWUEQ&oe=6A0DCAEB"}]}, "id": "755316947090655", "locale": "en_US", "screenshots": [{"file_name": "2.png", "id": "2037663817062925", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830888_2037663823729591_5553066749525453659_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOFlw7ovcJkQ7kNvwHI1G31&_nc_oc=AdoCR4epNCVxjSfS_cxv7zl1tiEqwYxeVPP_i7oHSlYRdDhbC2RwrTIOPBbWj79jhNA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nzgeWbXAVeetUmOZkRP5h-lMlK2Po-ZC7Mz0KbOeLAw&oe=6A0DB58C"}, {"file_name": "3.png", "id": "733957056067439", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304938_733957059400772_920742563406696154_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AK_goyMBaFAQ7kNvwFYVpy6&_nc_oc=AdqX1TE4j5MNxu6vgA4lL6lCXtI8c3E5YG6uYBpjWaF1ey3LEn08NG1cQIHrbYcLbgc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65BKkDnXjluActHrdsxxvuFTUscSxzkiloqHveG31HKw&oe=6A0DB23C"}, {"file_name": "5.png", "id": "1280346576874720", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491830003_1280346580208053_7249782898254538243_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1D_kSWvLQmMQ7kNvwGqsdoD&_nc_oc=AdpR5rH2lQwYBlLvKQsa0X8iiU5kKbvVZUYfsekyWgmFj3QVCue8ZCWrJh9-NS-AanY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JGSxqzSE6FkCIOPAX1P7JLdCm9vth-VqqAJVr91VVbg&oe=6A0DA33B"}, {"file_name": "4.png", "id": "1058564566460641", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822581_1058564573127307_8888241539711216554_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gteWPNQMriMQ7kNvwEUf_x5&_nc_oc=Adoq8l8rHRvn-hUoQLaB-Mf-ROR-Nd-CRthduZCD4yadA59Fqv0D9jGI775gOYndkA4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-4MqVj_E-ZIUb8n5ke_vnvDjHGg2ZY0pH5_MQW5G6Eg&oe=6A0DA59F"}, {"file_name": "1.png", "id": "1292733639083143", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304131_1292733642416476_7098072006652819798_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7xVnnJtMDYQ7kNvwEku-Gr&_nc_oc=AdrbX1O5qI5A-0-MS60rE8F5lWIFdNC1_-HkWW8dWN86VsQe6rZoblyEgLYxlsKNxDc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eNsuIQEFmWRhE_HOTrFVPK8t6Z1L4h4KF0FgHDycziw&oe=6A0DB9AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mount & Mail", "keywords": ["climbing", "parkour", "multiplayer", "coop", "social"], "long_description": "# Welcome to the least efficient postal service in the world.\n\nPut on your headset, grab your hands, and get ready to become **Berald** \u2014 the world's most determined (and least coordinated) mountain-climbing mail carrier. In this chaotic, physics-based VR adventure, you'll scale massive peaks using only your strength, stamina, and stubbornness to deliver the mail where drones fear to fly. \n\nClimbing isn't just a way to move \u2014 it's the whole game. Push off with your hands, cling to rocky surfaces, and fling yourself ever upward as you fight gravity, exhaustion, and your own flailing limbs. It's part workout, part comedy show, all multiplayer madness.\n\nWhether you're climbing solo or in a lobby with up to **4 players**, you'll quickly learn that what starts as a heroic delivery mission often turns into a flailing, flopping, laugh-out-loud mess. \n\n- \ud83e\uddd7\u200d **Fully Physical VR Climbing** \u2013 Built for hand-based locomotion. Push off, pull up, and parkour your way to victory.\n- \ud83d\udce6 **Deliver That Mail** \u2013 Reach checkpoints and make your deliveries like a (somewhat) professional.\n- \ud83c\udfae **4-Player Online Multiplayer** \u2013 Join up with friends or strangers for cooperative chaos or casual competition.\n- \ud83d\udcaa **Stamina System** \u2013 Pace your climbs and rest when needed\u2026 or risk flinging yourself off the cliff in spectacular style.\n- \ud83c\udfa9 **Customize Your Berald** \u2013 Unlock hats, outfits, and more to make your delivery look **fashionable.**\n# Remember, mail waits for no one!", "short_description": "Put on the postal cap of a Berald, one of many bouncy postal workers on a mission to deliver mail up towering mountains. In this physics-based VR climbing game, you\u2019ll scale cliffs, carry precious cargo, and laugh your way through ridiculous multiplayer mayhem. Just don\u2019t drop the mail!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.squidostudio.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Squido Studio", "support_website_url": "https://discord.gg/Xr6jXex8ZP", "website_url": "https://www.squidostudio.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "528142316460358"}, {"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24249440544687173"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2142104706264050"}]}, "baseline_offer": {"id": "2142104706264050"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1754587620, "status": "PUBLISHED", "id": "2142104706264050"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24292229600408267", "version": "0.9.0.0"}, 
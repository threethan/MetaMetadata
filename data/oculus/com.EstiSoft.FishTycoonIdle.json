n.com&_nc_ss=7f20f&oh=00_AQKydzKfEvvMeeOgt5-LRM4Y2jdPpWBGvcjJ_zkn2tmtSg&oe=6AAD48AA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2024-12-27 004247.png", "id": "28582344424712591", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035448_28582344441379256_9200889030892259302_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Jxx6i4WaQsQ7kNvwEw6bT0&_nc_oc=AdpJc5NtLWhZ0g39T7g3s81KPSOB6AsT3pxkxR8BFwUOaq2BOgQ--v9lGZg8dIUEUIw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJy-V74vSsWJnW_dAbRr6f191wZ-HWSw0lu0AvwcrzpVQ&oe=6AAD48D4"}, "display_name": "Fish Tycoon", "keywords": ["Tycoon", "Idle", "Fun", "Elite", "Comfort"], "long_description": "Welcome to \"Fish Tycoon,\" an immersive idle game experience now available on Meta Quest. Step into the vibrant underwater world where you can hatch, raise, and manage an array of exotic fish species. Begin your journey with basic tanks, slowly expanding your empire by upgrading aquariums, unlocking advanced breeding techniques, and discovering rare and legendary fish.\n\nBalance your resources wisely to optimize growth, trade valuable species, and earn rewards to reinvest in your thriving aquatic haven. Each fish has unique traits and values, making every discovery an exciting step forward. With beautiful graphics, engaging progression mechanics, and a tranquil oceanic soundtrack, \"Fish Tycoon\" is perfect for casual gamers and strategy enthusiasts.\n\nWhether you're designing a visually stunning aquarium or chasing rare fish for profit, \"Fish Tycoon\" offers endless possibilities. Dive into the peaceful waters and create your ultimate underwater empire. The ocean is full of opportunities\u2014are you ready to seize them? Download now and start your tycoon adventure today!", "short_description": "Dive into the relaxing world of \"Fish Tycoon,\" an idle game designed for Meta Quest. Build your underwater empire by hatching, raising, and trading exotic fish. Manage resources, upgrade your aquarium, and unlock rare species as you progress. With stunning visuals and a calming oceanic soundtrack, \"Fish Tycoon\" offers a perfect escape for casual and strategy-loving players alike. Let your creativity flow as you craft the ultimate aquatic paradise. The ocean is waiting\u2014start your tycoon journey t"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/fish-tycoon", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "275629210202852"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27900868376224306"}}]}, "scheduled_offers": {"count": 9, "nodes": [{"status": "PUBLISHED", "id": "1413663500584842"}, {"status": "PUBLISHED", "id": "26406304289070542"}, {"status": "PUBLISHED", "id": "1254907290018727"}, {"status": "PUBLISHED", "id": "1649104389803449"}, {"status": "CANCELLED", "id": "1494356691974644"}, {"status": "PUBLISHED", "id": "3983796898561228"}, {"status": "PUBLISHED", "id": "9364085637020070"}, {"status": "PUBLISHED", "id": "980869383956501"}, {"status": "PUBLISHED", "id": "443424178842512"}]}, "baseline_offer": {"id": "9364085637020070"}, "is_approved": 
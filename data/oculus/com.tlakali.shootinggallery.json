wGBIKW_&_nc_oc=AdobsV9n-aYQv6y1gzjgGHMvzSHmqE3ffnX-tYdY2eLgR4-U_gFoM7hnwt3gXqhhYiI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-i7P-6at1fg50Vywb7TyrAIFgSUZTR_S1F1XL49RgV9w&oe=6A4662F1"}, {"file_name": "Screenshot_05-02.png", "id": "1418520699914024", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499308575_1418520703247357_1634850019470259041_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAMlpnm7FEIQ7kNvwFFiJtp&_nc_oc=AdryMGCxtn93ne8ZZJlcYPXQ1k8ozk68RYXFf2d46JLKSLu5Y6kKQz-L3kiCUFr1l6U&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_YOJQWs11hUbZ-cSPGtHbyyvNU3afnbJYx7ltO-86gmA&oe=6A468574"}, {"file_name": "Screenshot_06_1440p.png", "id": "4270613736583837", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/604275479_4270613739917170_1403522466175136918_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=knBXZbq_qjEQ7kNvwFYFSj6&_nc_oc=AdodXsT9lI4TBJ_fbmqhYWfcGAGktAxIV72SMAmrkRtIIdUnKxqBGFX8YP1XMO5a-DU&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gAcROxJoF5jIep5oGLJxnIJy6qxdZP8SOsGDC1CQi4A&oe=6A4670AC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaStore_Trailer-CoverImage_01_1440p.png", "id": "1232636845739532", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499620504_1232636849072865_4719327055640048275_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HhzV4gOiB4QQ7kNvwE9u46h&_nc_oc=AdoPzFdqWvapVU1SyAzTiWJJn72QWXBgDYH5zstROqpzXCSyvw3ijPKBZbNEvHYVcp4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P_piIsJuYb55m0s9Fu-hLBWbfi5ZVISp9zrCAVL1Clg&oe=6A46747F"}, "display_name": "BlastZone", "keywords": ["Shooter", "Gallery", "Arcade", "Shooting", "Aim"], "long_description": "BlastZone brings the classic charm of an old-school shooting gallery straight into VR\u2014bright lights, fast action, and that \u201cjust one more try\u201d feeling. Whether you're a seasoned sharpshooter or brand-new to VR, you\u2019ll jump in instantly and have a blast.\n\nChoose from different stylized guns, each with unique handling and abilities. Level them up as you play to boost your score. Then step into themed stages\u2014like a whimsical barn, or a retro carnival gallery\u2014each packed with moving targets, tricky setups, and fun surprises. Some targets are worth big points\u2026 others you really don\u2019t want to hit!\n\nBlastZone is built for quick, satisfying sessions: start a match, shoot, score, repeat. Climb the global leaderboard, challenge your friends, and push your accuracy skills to the limit. Whether you're chasing high scores or just looking for some light-hearted arcade fun, this is your personal shooting range\u2014anytime you want.\n\nReady? Grab your weapon, hit the play button, and let\u2019s rock!", "short_description": "Step into BlastZone \u2014 your personal arcade shooting gallery! Pick your favorite gun, level it up, and blast through fun themed stages filled with targets and surprises. Easy to jump in, exciting to master, and perfect for quick sessions. Climb the global leaderboard and come back for \u201cjust one more round!\u201d"}]}, "developer_name": null, "developer_privacy_policy_url": "https://tlakali.com/wp-content/uploads/2026/01/privacy_policy_BlastZone.html", "developer_terms_of_service_url": null, "publisher_name": "Tlakali Studios", "support_website_url": null, "website_url": "https://tlakali.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
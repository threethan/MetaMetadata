: [], "long_description": "FREE one level demo for the space flight game Space Salvage\n\n*** FULL GAME NOW AVAILABLE ***\n\nhttps://www.oculus.com/experiences/quest/5768528353244808/\n\nSkilfully manoeuver your space-pod through a beautifully rendered, dynamic, inter-planetary crash site.\n\nCan you find and collect all the lost cargo?\n\nNavigate the colorful wreckage and asteroids. Use your laser to destroy lurking mines and face-off against the furious space pirate - all the while following the advice of your enthusiastic but amoral ship computer.", "short_description": "FREE one level demo for the space flight game Space Salvage\n\n*** FULL GAME NOW AVAILABLE ***\n\nhttps://www.oculus.com/experiences/quest/5768528353244808/\n\nSkilfully manoeuver your space-pod through a beautifully rendered, dynamic, inter-planetary crash site.\n\nNavigate the colorful wreckage and asteroids. Use your laser to destroy lurking mines and face-off against the furious space pirate - all the while following the advice of your enthusiastic but amoral ship computer."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fruitysystems.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fruity Systems", "support_website_url": "https://fruitysystems.com/support/", "website_url": "https://fruitysystems.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SPACE_UNIVERSE", "FLYING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fr", "de", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "sup
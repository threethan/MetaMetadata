_AQQEPdTrlgADSQHH8uE9XxDzjbv389pZqjDGfgh-cRJHpg&oe=6AF73015"}, {"file_name": "shot2-cans-2560x1440.png", "id": "1390800696539874", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/596068480_1390800699873207_5860802589334501863_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmcUJAWmP_cQ7kNvwHIbkXw&_nc_oc=Adoy6gwKviMuQP2CyPR-ooYRYzwAmVkkrEGT19mfGHU-cjrXqeMemWaBNd_pX9jkNcg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrD0IBvPg5f3JNgz2t-dgxBBJckRCO_eVn99VW1h9P2w&oe=6AF723FB"}, {"file_name": "shot3-stencils-2560x1440.png", "id": "1090404906829373", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673716021_1090404913496039_267769626366068739_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P1w7PIdYzSMQ7kNvwEs0VRr&_nc_oc=Adp54d89hvsEiCFxXEsvwUGVoRYg_5AJvPwWpc609ZlYvkSQTHF4diCXoScJ668E6eU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf1RyCoEnZg4_fKU5ApBbITVOzJdqBiRDb8EgZMM_oXA&oe=6AF74B06"}, {"file_name": "shot4-street-2560x1440.png", "id": "1741520256969883", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673819499_1741520260303216_5979023615648515565_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQe7eI1bkZYQ7kNvwFoeQV-&_nc_oc=AdpKXiudpyCbWIhDuacnnz0X3EZlhw2jPC62ELYvneyLyztfCBxWUJKynXkXlivs7HQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRasVxJjlEUACtr0CB_Zr8uUT86mN3pvW7iM3WVNkohyg&oe=6AF7198E"}, {"file_name": "shot5-night-2560x1440.png", "id": "4884874685092431", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/604375581_4884874688425764_3429530806172955959_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKR5KB-KV0gQ7kNvwEgak5w&_nc_oc=AdqXgZ0M5UKxoPYvn4kZcBj0kBUBJmxXSeZBUsa-sKdvUIVQfjHAG5znQ9mhLpDqIGc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWRTP-zXBKdwHjsiVq0CxEFrZVVqVYLnZs2oYTWLqSkA&oe=6AF74888"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1016137674793628", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595119480_1016137681460294_131494977019649718_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gy4ghPxh-t4Q7kNvwHf4bIh&_nc_oc=AdosoYbY_i1za-ku5pQN5qBj_ZyTySACmPNM84Gd27tps0tl-ycJZ2rN2SnlhgFvvPw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrSbu-pwYYuOCt0fJ8Qbs4baOVJbYqGmKJ8KNHskJcIA&oe=6AF733D1"}, "display_name": "Graffiti", "keywords": ["graffiti", "spray", "painting", "art", "sandbox"], "long_description": "Graffiti puts a table of spray cans on a sunny Brooklyn sidewalk and gives you the whole block to paint.\n\nTHE WALLS\nAn old red-brick warehouse with four big blank bays, three shops with roll-down steel shutters, and a buff-brick garage. The paint sits in the brick, so every mortar line shows through your piece.\n\nTHE CANS\nGrab a can and pull the trigger to spray. Press X to open a wheel of 44 colours and load the can in your hand. Press A to swap caps: skinny for outlines, medium, and fat for fills. Hold the can still up close and the paint drips down the wall.\n\nSTENCILS\nTake a stencil off the rack (star, crown, lightning bolt, heart, arrow or NYC), press it flat on a wall and let go. It sticks. Spray over it, peel it off, and the shape is on the wall.\n\nPHOTOS\nPress Y facing a wall and a photo of your piece is saved to your headset's Pictures folder.\n\nDAY AND NIGHT\nSwitch to night and the street lamps, wall lights and shop signs come on over your work.\n\nFRESH COAT\nTap the red post to wipe every wall clean, or clear just the wall in front of you from the menu.\n\nFEATURES\n- A Brooklyn street with 9 paintable walls: brick and steel shutters\n- 8 spray cans, a 44-colour wheel and 3 cap sizes\n- Real drips, 6 stencils and a photo button\n- Day and night, with traffic driving past\n- Shake the can to hear it rattle\n- Background music with its own menu\n- Walk with the left stick, snap turn with the right", "short_description": "Grab a spray can and paint a real Brooklyn street. Tag an old brick warehouse, the steel shutters on the shops and a garage wall while traffic drives past. Pick any colour from the wheel, swap between skinny and fat caps, stick stencils on the bricks, let the paint drip, and take a photo of your piece when it is done."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-graffiti.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://citiview-graffiti.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1233059783233328"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2188439762093243"}, {"status": "PUBLISHED", "id": "1697823385015811"}, {"status": "PUBLISHED", "id": "1768409734397988"}]}, "baseline_offer": {"id": "1697823385015811"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793822400, "status": "PUBLISHED", "id": "2188439762093243"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1236797782859528", "version": "1.0.0"}, "id": "2307704586666549", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": 
", "screenshots": [{"file_name": "shot1-wall-2560x1440.png", "id": "1118540294171965", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673759338_1118540297505298_6651948906941090637_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4IXGOYoG2PUQ7kNvwF2RdVX&_nc_oc=Adr_lZ61jHvShcFe2YxeT2ooZMCGQQRTpd0ApKA32VmGCnGhU9p_DcAQ1U4pyvMbkeM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV5brZcdw-Wgm_BsOSdXkAyXwE3LQGSEx9glbl_R04mA&oe=6AFB2495"}, {"file_name": "shot2-cans-2560x1440.png", "id": "1390800696539874", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/596068480_1390800699873207_5860802589334501863_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ue9cBROPBo0Q7kNvwFlkFck&_nc_oc=AdofUQ0gVv2bf79KuPSclOy5uuNFsMwzLHNKDSNIHc1RIcypxQE0NiPQ6GnOJTkWVyI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk6hb2e2hVdgko9ZacYQj-hsh-XbJKR4Z_RkgUWD1nug&oe=6AFB187B"}, {"file_name": "shot3-stencils-2560x1440.png", "id": "1090404906829373", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/673716021_1090404913496039_267769626366068739_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8OBaVPl-yDAQ7kNvwHhoBve&_nc_oc=AdrXGat9ZKGxNk3b5gyTQyDRW9yDx_wuVk_7zdQW1HEVuEjwY_JFa0pFPiP38JQBybE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTFF0yDo48hGW1wA4EX4Gu-HPPyZB94F3g6FGUzgH6xZA&oe=6AFB3F86"}, {"file_name": "shot4-street-2560x1440.png", "id": "1741520256969883", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/673819499_1741520260303216_5979023615648515565_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FE8uT1871soQ7kNvwFvrdCF&_nc_oc=AdppmFNph3fpvFInDKFFlt2t_oB6qf3Yd6JVMZuHlqWf8fUhxZfNU6LxOA-PjYVXc5w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWSo9ahJ8axh4XvtBgmqO0J_DKasytA34uTPFJYaRyow&oe=6AFB464E"}, {"file_name": "shot5-night-2560x1440.png", "id": "4884874685092431", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/604375581_4884874688425764_3429530806172955959_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5OAZWJE-6HEQ7kNvwFwRhJT&_nc_oc=AdqrC2zwtkhtN1eydfAPiM1GRuzgt98pMuqvKliK1GElWNJ9yt7lPg-9b6l55DMezcw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROyMuCXLXb73qz-ZDi4RJsLSBy8EctO40bhDXeZXWLQw&oe=6AFB3D08"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1016137674793628", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/595119480_1016137681460294_131494977019649718_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T5CwwVeum2gQ7kNvwFlOdJG&_nc_oc=AdqC7qAtTm1OCtceNY0dQBOD3MubGCNXmqv2n8Z1wFSbbj8eWY9iwU4Fp7IMTGCVHZo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6m84oWA2pLZwDwnLSNiKUxTaXNhRdk_K3wpNngMZ8Tw&oe=6AFB2851"}, "display_name": "Graffiti", "keywords": ["graffiti", "spray", "painting", "art", "sandbox"], "long_description": "Graffiti puts a table of spray cans on a sunny Brooklyn sidewalk and gives you the whole block to paint.\n\nTHE WALLS\nAn old red-brick warehouse with four big blank bays, three shops with roll-down steel shutters, and a buff-brick garage. The paint sits in the brick, so every mortar line shows through your piece.\n\nTHE CANS\nGrab a can and pull the trigger to spray. Press X to open a wheel of 44 colours and load the can in your hand. Press A to swap caps: skinny for outlines, medium, and fat for fills. Hold the can still up close and the paint drips down the wall.\n\nSTENCILS\nTake a stencil off the rack (star, crown, lightning bolt, heart, arrow or NYC), press it flat on a wall and let go. It sticks. Spray over it, peel it off, and the shape is on the wall.\n\nPHOTOS\nPress Y facing a wall and a photo of your piece is saved to your headset's Pictures folder.\n\nDAY AND NIGHT\nSwitch to night and the street lamps, wall lights and shop signs come on over your work.\n\nFRESH COAT\nTap the red post to wipe every wall clean, or clear just the wall in front of you from the menu.\n\nFEATURES\n- A Brooklyn street with 9 paintable walls: brick and steel shutters\n- 8 spray cans, a 44-colour wheel and 3 cap sizes\n- Real drips, 6 stencils and a photo button\n- Day and night, with traffic driving past\n- Shake the can to hear it rattle\n- Background music with its own menu\n- Walk with the left stick, snap turn with the right", "short_description": "Grab a spray can and paint a real Brooklyn street. Tag an old brick warehouse, the steel shutters on the shops and a garage wall while traffic drives past. Pick any colour from the wheel, swap between skinny and fat caps, stick stencils on the bricks, let the paint drip, and take a photo of your piece when it is done."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-graffiti.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Group", "support_website_url": null, "website_url": "https://citiview-graffiti.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1233059783233328"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "2188439762093243"}, {"status": "PUBLISHED", "id": "1697823385015811"}, {"status": "PUBLISHED", "id": "17684097
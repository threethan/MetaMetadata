5/75297580_273094731688107_4722023891126031790_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8JRSN2igE4Q7kNvwEIrC7o&_nc_oc=Adnf_tWFd4SifDetaOvIihy3Xttz9QqmUW9R6_KVNAj9D6V4-JzuBrSu-7vPY2U4scE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwzJRh2Qvb4iBHbZ0yQbTPMJgivdj-20FtQ8oLgnzbGHQ&oe=69B7F8E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "766101374549787", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86655525_766101381216453_7286659792955350348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2Jk7APTbMgQ7kNvwHsYZGj&_nc_oc=Admk9Xv0iQm3hZWUni-HMymwSGSjB8JBKdzWBW1lRWYss21dmYS77lFcGWLDO-_ofGs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwqMXNEvEhzQB0u-Z1oTCpt7q6u5wAtV_NbJ75gDLuoXg&oe=69B7E4BA"}, "display_name": "Flipout", "keywords": [], "long_description": "Butterfly, backstroke, or freestyle! Swim around using your own two hands, no buttons or joysticks. Play on your own or join your fellow turtles in a public or private game. Enjoy anything from showing off your tricks on the diving board to exploring hidden treasures. When a safe-zone appears deep in the ocean, the race is on! The last turtle to the safe zone will be out of the race. But don't forget about these fallen players just yet! If they tag you, you will lose your speed. So swim fast!", "short_description": "Swim, race, and explore, with friends. Last one too the safe zone is out! And watch out for other turtles trying to slow you down!"}]}, "developer_name": "Sam Baker", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRZ6WRuSkydWmWjnSH_ttrPy8Pfc38pH3io71892Yx0OAxIVu_UUdDMmJY1SmgyiGxPbcyYZKiaWJJp/pub", "developer_terms_of_service_url": null, "publisher_name": "Sam Baker", "support_website_url": null, "website_url": "https://www.tiktok.com/@projectelectronics", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", 
=6A36ADA9"}, {"file_name": "img4.png", "id": "273094728354774", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75297580_273094731688107_4722023891126031790_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Y3Cf45yCEcQ7kNvwGLPlLh&_nc_oc=AdrP6jaP2485AMwpAwoyEo4s29F31UNLVr3tnwPeIT0mLdkekGBaLVRSQlYXuNln5Ao&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88ySbEc7vutAEC1DYAMY3c0WfHnzvHjJaAYW72biWsEQ&oe=6A36C123"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "766101374549787", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/86655525_766101381216453_7286659792955350348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SQDbQp9gW4Q7kNvwFmRxUF&_nc_oc=Adoj95T3-u9e46SKpSnRqJAKu-J2V4BTi8zKTLFPqFXiCDTbTKoKY2uFAm0DioztSpM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_TD57dzyY9mCsl4-pIwSnyntsvXMJkKSeRNeCK16z1aA&oe=6A36ACFA"}, "display_name": "Flipout", "keywords": [], "long_description": "Butterfly, backstroke, or freestyle! Swim around using your own two hands, no buttons or joysticks. Play on your own or join your fellow turtles in a public or private game. Enjoy anything from showing off your tricks on the diving board to exploring hidden treasures. When a safe-zone appears deep in the ocean, the race is on! The last turtle to the safe zone will be out of the race. But don't forget about these fallen players just yet! If they tag you, you will lose your speed. So swim fast!", "short_description": "Swim, race, and explore, with friends. Last one too the safe zone is out! And watch out for other turtles trying to slow you down!"}]}, "developer_name": "Sam Baker", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRZ6WRuSkydWmWjnSH_ttrPy8Pfc38pH3io71892Yx0OAxIVu_UUdDMmJY1SmgyiGxPbcyYZKiaWJJp/pub", "developer_terms_of_service_url": null, "publisher_name": "Sam Baker", "support_website_url": null, "website_url": "https://www.tiktok.com/@projecte
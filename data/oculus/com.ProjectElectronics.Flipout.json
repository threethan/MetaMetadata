9U-PLDUM45j3sdHKWJ2z9lpNr-jw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzstDZH16nXj0l6ud6Iy5Eov8_6hH0vK91Lot1VIwCumw&oe=69AECF93"}, {"file_name": "img1.png", "id": "437829765017369", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_437829768350702_7450192307433430568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=anoiRrL8PzsQ7kNvwEmgtlP&_nc_oc=AdmwHgc00DFHJrzEq3i9kXAouDsu3SyMeC70YtZpRGzyfsoANIdsXFDPLdClLriC_Oc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQjpklxvh2N_beSJlLoz8TouJLNWIOc7oJXFiM-W1S8g&oe=69AEAAE9"}, {"file_name": "img4.png", "id": "273094728354774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297580_273094731688107_4722023891126031790_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=leKU4vpy3iYQ7kNvwGHvldg&_nc_oc=AdkzpzUw3NfuXLgtNna-kFGcG40DsL9I33V6yTLq0QU6u0OdAS0IYKsERPtWjwvD_6U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzs4pbAcBV13WMJqeKGVSSDQEPUgKSYjMEfU9HuLFr40g&oe=69AEBE63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "766101374549787", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86655525_766101381216453_7286659792955350348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9EUKFWAQC0YQ7kNvwFBg11W&_nc_oc=Admecw68WP-DJXegji-6Wf5_LIUc2Oz5l6kdzQ5pQhLhX8MNqi1eTDLEhmMjifp4Fis&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzuu4KPETRCmdnLkmN5P2nPu5OW1f-E5AMJaxVEdoV08w&oe=69AEAA3A"}, "display_name": "Flipout", "keywords": [], "long_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Play on your own or join your fellow turtles in a public or private game. Enjoy anything from showing off your tricks on the diving board to exploring hidden treasures!\n\nThere are currently three unique game modes:\n\nTurtle Ball: An underwater game of two-team dodgeball. Hit turtles on the other team to switch them to your own team. Last team standing wins!\n\nZones: A game where turtles race to randomly safe zones that spawn randomly around the ocean. Anyone too slow will be frozen and can slow down unfrozen turtles.\n\nCasual: Hang out with other turtles with no rules!", "short_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Swim, race, and explore a variety of online game modes such as Turtle Ball and Zones!"}]}, "developer_name": "Sam Baker", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRZ6WRuSkydWmWjnSH_ttrPy8Pfc38pH3io71892Yx0OAxIVu_UUdDMmJY1SmgyiGxPbcyYZKiaWJJp/pub", "developer_terms_of_service_url": null, "publisher_name": "Sam Baker", "support_website_url": null, "website_url": "https://www.tiktok.com/@projectelectronics", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1127218841283151"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_3203519883308964_4405241252296094869_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joIc4NsuT70Q7kNvwGhKka1&_nc_oc=Admt837VYbi3b5gQpoWfnhYSeXwYIGdk2iSOCqYLK9j97oXL1Hs5bnf4DT-ElmJXDCY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyloFSve4kkceaP1L_6g_oBP5XqK8xtC9vyXwHFsmMS2g&oe
TjLuyRN_aO-GctYbj3sfd4ajZ6TA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzvXzc7wcI6fiSN23wJ6Wm7SGeG4Wrzr3CuYpEf8dawrg&oe=69B95B93"}, {"file_name": "img1.png", "id": "437829765017369", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982678_437829768350702_7450192307433430568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75yKCRXpz4EQ7kNvwEJEpqO&_nc_oc=AdmJXPMYlKeBIAgONqqihMpUz1D3b5lwDE_y-zwLA0q2JrENHNOMNclwmEytcL58_9g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzAVdVhUfx2_rTm9Hu4Mw0XqK6TsIyQX8G0QzCjV-QGSg&oe=69B936E9"}, {"file_name": "img4.png", "id": "273094728354774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75297580_273094731688107_4722023891126031790_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8JRSN2igE4Q7kNvwG0JGdE&_nc_oc=AdkzbyR5O2RYJUsqoqnvwq2s0IKo-M0a4eEVX4gIsW55mqttR7NvOu4bSV-pKVZPdsg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzxvM0sXL-ELrtor6rxrTkPqybvBEPCAZ98Ey8arkQx0w&oe=69B94A63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "766101374549787", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86655525_766101381216453_7286659792955350348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2Jk7APTbMgQ7kNvwH3CWOW&_nc_oc=Admc4PtDjc3iUkzBIl_sG_ClERnDUCJbI3BzftJPKEGWWYVulh8IP3s0Tk9BmsT8AOg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxlxR3Yrch0SXmUuLxfB7-9kFF7Sk6a7L7p7hmPgsmAPw&oe=69B9363A"}, "display_name": "Flipout", "keywords": [], "long_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Play on your own or join your fellow turtles in a public or private game. Enjoy anything from showing off your tricks on the diving board to exploring hidden treasures!\n\nThere are currently three unique game modes:\n\nTurtle Ball: An underwater game of two-team dodgeball. Hit turtles on the other team to switch them to your own team. Last team standing wins!\n\nZones: A game where turtles race to randomly safe zones that spawn randomly around the ocean. Anyone too slow will be frozen and can slow down unfrozen turtles.\n\nCasual: Hang out with other turtles with no rules!", "short_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Swim, race, and explore a variety of online game modes such as Turtle Ball and Zones!"}]}, "developer_name": "Sam Baker", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRZ6WRuSkydWmWjnSH_ttrPy8Pfc38pH3io71892Yx0OAxIVu_UUdDMmJY1SmgyiGxPbcyYZKiaWJJp/pub", "developer_terms_of_service_url": null, "publisher_name": "Sam Baker", "support_website_url": null, "website_url": "https://www.tiktok.com/@projectelectronics", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1127218841283151"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982512_3203519883308964_4405241252296094869_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miHPSyWr8NYQ7kNvwFHPpKO&_nc_oc=Adlwu8e4kZxhK0Zjz_gaJaL26pd6ww22oaR9KSjdeLLbuy90hNcX9rpVFLI3nsEKeGE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyzjAmTlD77TDwaZg9wyzkma2fBML-aVsqN6C-wLA3lxg&oe
ebNn3oKAUyJn3X2KUxcUS68Jnu5c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy-3PA-RJOafKMOUrYRDHeXFSHFfHIHZO9S9Ugfwybe6g&oe=69B6B893"}, {"file_name": "img1.png", "id": "437829765017369", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982678_437829768350702_7450192307433430568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HMNzjzKgx_QQ7kNvwFnCQoc&_nc_oc=AdnlmhC5de3nBqE3_fFXPcw1943rmkjBu1U07qIDPIsP8BQ9nQEBaVDVX9bf9yqrE18&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxbg95mqOWI-KINLH67GodomqtP47zcTlyCeavpdHprkw&oe=69B693E9"}, {"file_name": "img4.png", "id": "273094728354774", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75297580_273094731688107_4722023891126031790_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8JRSN2igE4Q7kNvwFnZwWP&_nc_oc=Adkp_J5ajFuxVU9pdP4UGGtYBGQzjJXoziCOnznA6Yx4PTQkf2qLft0OYqlRXzm1fq4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuAUDmKAACc6RkE6gb4AYU2B-fYfgwb9eF5ydeT9FJBA&oe=69B6A763"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "766101374549787", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86655525_766101381216453_7286659792955350348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2Jk7APTbMgQ7kNvwFXZac5&_nc_oc=AdnPw5dKNFeaxoWvemM6n_Spzk2jOMPw4nQms84aq5AtCsNDzBgz05GttZszCovjlAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwUEJ1StupkXrjZLhtRyK5VOi6uChVih_CsHC9O4PnsAQ&oe=69B6933A"}, "display_name": "Flipout", "keywords": [], "long_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Play on your own or join your fellow turtles in a public or private game. Enjoy anything from showing off your tricks on the diving board to exploring hidden treasures!\n\nThere are currently three unique game modes:\n\nTurtle Ball: An underwater game of two-team dodgeball. Hit turtles on the other team to switch them to your own team. Last team standing wins!\n\nZones: A game where turtles race to randomly safe zones that spawn randomly around the ocean. Anyone too slow will be frozen and can slow down unfrozen turtles.\n\nCasual: Hang out with other turtles with no rules!", "short_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Swim, race, and explore a variety of online game modes such as Turtle Ball and Zones!"}]}, "developer_name": "Sam Baker", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRZ6WRuSkydWmWjnSH_ttrPy8Pfc38pH3io71892Yx0OAxIVu_UUdDMmJY1SmgyiGxPbcyYZKiaWJJp/pub", "developer_terms_of_service_url": null, "publisher_name": "Sam Baker", "support_website_url": null, "website_url": "https://www.tiktok.com/@projectelectronics", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1127218841283151"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38982512_3203519883308964_4405241252296094869_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cVzyzH37gfIQ7kNvwEYH-zH&_nc_oc=AdnbPDUt1PikWOFOApndho4Mx8AmOXOrkfVto_Iun0YoARneYe02eQhpNWQkMKn_oaQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxJKO1znzYymi7k0oy6mvRKz1PQJuyRQjs5oX5b6uS2cA&oe
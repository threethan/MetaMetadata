KLIu0LMaAjEdZlkKHPf1-IGzpIyA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsWFMmS5Q58IflsBLFGNfXFStnuKJJVMCP1MXHcWtz-BA&oe=69A98993"}, {"file_name": "img1.png", "id": "437829765017369", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982678_437829768350702_7450192307433430568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSx4-gF4mWoQ7kNvwFvu4mh&_nc_oc=Adkr-pXH0ZbMqR9mVG-PakECgREblTberz6xUEMFcWxtn8vN_UYyrHGcM0f8dtHitfA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftoNsjlGG_NubwU4qc8fG8GFYJJ7JBQyoufzyb_FESoJA&oe=69A964E9"}, {"file_name": "img4.png", "id": "273094728354774", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75297580_273094731688107_4722023891126031790_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWJh9eDbFa4Q7kNvwHUg4bW&_nc_oc=Adn3ADP5EmeAjwPy9Xp88f_aJdKs8AAqpI7WUeHPU4Ix2bPIYk0qVvhskAbRVteYJCc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu7IjMM09ExlrCnmull9VwVD8EX_02VMMYVqVcpQhrCrg&oe=69A97863"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "766101374549787", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86655525_766101381216453_7286659792955350348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8okqlqwTqp0Q7kNvwF4tJFg&_nc_oc=AdlbA3pl0I564nXIZTn8Znh5EopYopj2bQsbAcKke7kR09rMDdS3zFL_QngKEaA8CQU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftrSsqArMaxAMBUf1TM4zfTHNk95l9xWU7StgIWbbLdTg&oe=69A9643A"}, "display_name": "Flipout", "keywords": [], "long_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Play on your own or join your fellow turtles in a public or private game. Enjoy anything from showing off your tricks on the diving board to exploring hidden treasures!\n\nThere are currently three unique game modes:\n\nTurtle Ball: An underwater game of two-team dodgeball. Hit turtles on the other team to switch them to your own team. Last team standing wins!\n\nZones: A game where turtles race to randomly safe zones that spawn randomly around the ocean. Anyone too slow will be frozen and can slow down unfrozen turtles.\n\nCasual: Hang out with other turtles with no rules!", "short_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Swim, race, and explore a variety of online game modes such as Turtle Ball and Zones!"}]}, "developer_name": "Sam Baker", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRZ6WRuSkydWmWjnSH_ttrPy8Pfc38pH3io71892Yx0OAxIVu_UUdDMmJY1SmgyiGxPbcyYZKiaWJJp/pub", "developer_terms_of_service_url": null, "publisher_name": "Sam Baker", "support_website_url": null, "website_url": "https://www.tiktok.com/@projectelectronics", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1127218841283151"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982512_3203519883308964_4405241252296094869_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LbTOQ3qEqkIQ7kNvwEdTKnH&_nc_oc=AdmZC9i41-rReiE0y2XKwMDcuwX0DCC-fSF0LUMrRmeP2TZzrLLoGqiqKOyNCl-_-ZQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfvYIKjZmzYsS9Wlq9OCmdQRzfVGSuLu8YRHaIpqOwjErg&oe
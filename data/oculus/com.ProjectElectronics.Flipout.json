uHaYRBvVlQqZdldSQPdLhB0e62Ec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfuBqye1gc0ZpMgXxAej0FxUu0d72x7fVCXpzhIdlq2n7g&oe=69A83813"}, {"file_name": "img1.png", "id": "437829765017369", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982678_437829768350702_7450192307433430568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-PzwolkyWgQ7kNvwHFScdT&_nc_oc=Adkzkqj53WdD8FHYyvpsIgwd-kVw4kVf7tvbYuNHjr5FyygflsWimkbHsICm8Wb7HGo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvTXlEUN7f1OttGZRNILuIoeZCg-y5OvDjglmjS28A2BA&oe=69A81369"}, {"file_name": "img4.png", "id": "273094728354774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75297580_273094731688107_4722023891126031790_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWJh9eDbFa4Q7kNvwGjm_rS&_nc_oc=Adl8AROH0fGW9xWBWeDkUt4iCP_8RpBJCVdZ9avEOVwzKjruWFJPWUq-95XWIsAt3D4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Aft-mCjZ0v29DiCjULbYiCmIbBHX8wFnUfvo--bGklfdeQ&oe=69A826E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "766101374549787", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86655525_766101381216453_7286659792955350348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8okqlqwTqp0Q7kNvwFJ1GSo&_nc_oc=AdlmAow4bj3TXbhXhIWav4zJ1XeFjIKaagAqnpBDDw3CAUb6ZqJVYRKIKLbOFTXtPrU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afs2s00lVpO83J6FaMPmCpLwHaJmqQrM-gRvuuXLyaC4Tg&oe=69A812BA"}, "display_name": "Flipout", "keywords": [], "long_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Play on your own or join your fellow turtles in a public or private game. Enjoy anything from showing off your tricks on the diving board to exploring hidden treasures!\n\nThere are currently three unique game modes:\n\nTurtle Ball: An underwater game of two-team dodgeball. Hit turtles on the other team to switch them to your own team. Last team standing wins!\n\nZones: A game where turtles race to randomly safe zones that spawn randomly around the ocean. Anyone too slow will be frozen and can slow down unfrozen turtles.\n\nCasual: Hang out with other turtles with no rules!", "short_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Swim, race, and explore a variety of online game modes such as Turtle Ball and Zones!"}]}, "developer_name": "Sam Baker", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRZ6WRuSkydWmWjnSH_ttrPy8Pfc38pH3io71892Yx0OAxIVu_UUdDMmJY1SmgyiGxPbcyYZKiaWJJp/pub", "developer_terms_of_service_url": null, "publisher_name": "Sam Baker", "support_website_url": null, "website_url": "https://www.tiktok.com/@projectelectronics", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1127218841283151"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982512_3203519883308964_4405241252296094869_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xwarxBZSS2YQ7kNvwF5ax4i&_nc_oc=Adlt4iQAAMvbLOQCs75OmpL_Ux51W7nY3468t0sE0Ui9F1yG-foGp_RTSTaF2aJz9uA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvXaRGc5xRlm6jRklD8i7He43dJZl7gwBtIBA2WIKwcCQ&oe
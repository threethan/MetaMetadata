-QJnvgWdQoFpXjLDrlQb_3iT3Rjc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afzq9R1cUiwXM4MRV3Ww4VB_Be-FhtkZkKXVubjlh_pqbw&oe=69C14493"}, {"file_name": "img1.png", "id": "437829765017369", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982678_437829768350702_7450192307433430568_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuTIZugk0aEQ7kNvwEYkl9y&_nc_oc=Adr1BbJO5dIcxDCen9Av0KqxmtKaYrunJBYzASPRqbCK2vFc3pUJh5M5dk8jzklsMzw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afzf3nI97mCsvhmiHJjFml_T148ydfr9XM3ZBbqU-VMaQA&oe=69C11FE9"}, {"file_name": "img4.png", "id": "273094728354774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75297580_273094731688107_4722023891126031790_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ivlMCaOZ8AQ7kNvwG3ft_Z&_nc_oc=Adr_8Ic3lSqpYdO4dhX5Lin-JbUs-pJGdBmElNlrVBfmT0tMsIA4xoIy4hdeZPRLxac&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzyFDx-nDmwzmgO-hFSOGaQb8erAP1ZZI3Ukx7u7ODScg&oe=69C13363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailerCover.png", "id": "766101374549787", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/86655525_766101381216453_7286659792955350348_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zu2G3p7l-A4Q7kNvwH2FF9r&_nc_oc=AdrGebH5odsNMILs57zSpNRS8-naljBPKyTsw1UaFwxQnkjv1fqDJLkzauf1_phlEeU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwXLNRyEC43RvyBJhqUv3ge6EKak5Y67bkNefGHz-_1Zw&oe=69C11F3A"}, "display_name": "Flipout", "keywords": [], "long_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Play on your own or join your fellow turtles in a public or private game. Enjoy anything from showing off your tricks on the diving board to exploring hidden treasures!\n\nThere are currently three unique game modes:\n\nTurtle Ball: An underwater game of two-team dodgeball. Hit turtles on the other team to switch them to your own team. Last team standing wins!\n\nZones: A game where turtles race to randomly safe zones that spawn randomly around the ocean. Anyone too slow will be frozen and can slow down unfrozen turtles.\n\nCasual: Hang out with other turtles with no rules!", "short_description": "Butterfly, backstroke, or freestyle! Swim around just like a real turtle, no buttons or joysticks required! Swim, race, and explore a variety of online game modes such as Turtle Ball and Zones!"}]}, "developer_name": "Sam Baker", "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRZ6WRuSkydWmWjnSH_ttrPy8Pfc38pH3io71892Yx0OAxIVu_UUdDMmJY1SmgyiGxPbcyYZKiaWJJp/pub", "developer_terms_of_service_url": null, "publisher_name": "Sam Baker", "support_website_url": null, "website_url": "https://www.tiktok.com/@projectelectronics", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "CASUAL", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1127218841283151"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982512_3203519883308964_4405241252296094869_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f8GtAHGHVDcQ7kNvwHMmnVM&_nc_oc=AdqZahSiyZ1kWhRv4kf7YkFIjxhYxmdKr6CfMh1lWOkGOhBEV5s1YAwWQ-WGPO9mC0c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwjQF7QnXuJF2XAGsh-npKSB7VRi1w2l7PpCTbN2N-6Bg&oe
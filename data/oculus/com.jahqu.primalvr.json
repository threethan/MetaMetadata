tps://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499628882_1439350028149441_1842511343747010890_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u53zyWVnueQQ7kNvwE1Roiz&_nc_oc=AdrhC-jYPmTbgBMrs3h5NpBA86_Xt401JyerBNuwhBRe8hLxy5gw5fcPV7pnFm08lik&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNorTQr19a08yNfajNvm8i28i7xOQgWXMIJSU-qIAZD2g&oe=6AC8ED3A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bazaart_E9F70533-479F-4D69-BAF9-02FA69560FF3.png", "id": "2690343168030392", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499297120_2690343171363725_3501761583217391444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBgn2xnP9e8Q7kNvwE7QA-p&_nc_oc=AdrFI_vclRkNMIWJBD5bpCzJpAtR52Wuf2hf921lPQvOfz6iMdwmB_y_2NmjOfrKVY4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiTE52t3vQDDH0FqLJ71ojPSWteF62r0tpACFHWM_-uA&oe=6AC8E758"}, "display_name": "PrimalVR", "keywords": ["primal", "vr", "stumble", "guys", "fall"], "long_description": "PrimalVR is a fast-paced multiplayer VR party game where up to 16 players compete through 3 chaotic rounds to see who comes out on top.\n\nRun, climb, dodge, survive, and outplay other players across a growing collection of unique maps and game modes. Every round brings new challenges, unexpected moments, and opportunities to knock out the competition.\n\nCustomize your character with a variety of skins and cosmetics, play with friends or meet new players, and keep coming back as new maps, modes, cosmetics, and features are added.\n\nFeatures include:\n\nUp to 16-player online lobbies\n3-round party matches\nMultiple maps and game modes\nUnlockable skins and cosmetics\nFast-paced VR movement and competition\nRegular new content and updates\n\nWhether you're playing to win or just causing chaos with friends, PrimalVR is built for unpredictable multiplayer fun.\n\nHALLOWEEN UPDATE\nThe Halloween update is finally here! \nEvery map has been revamped with TONS of decorations and themed activities! There is new Limited-Edition Skins, and some secrets for you to discover!\nSANDBOX MODE\nWith the Halloween update, I\u2019ve added a Sandbox mode available only in private queues. This allows you to control which maps you play, how long each round is, and whether eliminations count or not (essentially practice mode).\n\nThe Halloween stuff will be leaving on September 1st so be sure to enjoy the fun while it lasts!\n\n-Jahqu", "short_description": "Jump into chaotic 16-player VR party matches! Compete in intense rounds, survive unique maps, unlock skins, and fight to be the last player standing."}]}, "developer_name": "Jahqu", "developer_privacy_policy_url": "https://stickersvr.github.io/primalvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Jahqu", "support_website_url": null, "website_url": "https://stickersvr.github.io/primalvr-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1361963336997307"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300738_1405272458389414_2719646887823703224_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U5gypkAJ53wQ7kNvwGuyKWO&_nc_oc=AdroXQ6rwzjDeoZcz8QhHFYA38mrXafWnFJBUyRKl0tAe8lfXEx4LVl7ND2pvMlRV78&_nc_zt=3&_nc_ht=scontent-lga3-2.oculu
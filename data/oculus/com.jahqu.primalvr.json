azaart_1F21BE42-04A1-437D-9FE7-720492EB40EB.png", "id": "1048715254631693", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499307309_1048715257965026_7202625518583766700_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lAAMsDyHUicQ7kNvwGNQ2R6&_nc_oc=AdpDs8fcruZK9xwGWtUAu_hu3zUR-mVxZFEre2OTosBmGICD9q3sELnF_4PvQ65vWKY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOPtheij1dkmFk6LEPDNUSvT-9ss6OcNMA2btTrxLvBTA&oe=6AC51702"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Bazaart_E9F70533-479F-4D69-BAF9-02FA69560FF3.png", "id": "2690343168030392", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499297120_2690343171363725_3501761583217391444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDVjQK13tY8Q7kNvwGNJVay&_nc_oc=AdrLmvGKH6fPTJJvPWYkrCu-Nod8KDK2Pu9g76AsZsBIJVL07gaqJdWKl9ghYJ73VvQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL-ymSrROKEgmICM7bajknF53Lk8J7yc8nhuWIfUAIRA&oe=6AC52B18"}, "display_name": "PrimalVR", "keywords": ["primal", "vr", "stumble", "guys", "fall"], "long_description": "PrimalVR is a fast-paced multiplayer VR party game where up to 16 players compete through 3 chaotic rounds to see who comes out on top.\n\nRun, climb, dodge, survive, and outplay other players across a growing collection of unique maps and game modes. Every round brings new challenges, unexpected moments, and opportunities to knock out the competition.\n\nCustomize your character with a variety of skins and cosmetics, play with friends or meet new players, and keep coming back as new maps, modes, cosmetics, and features are added.\n\nFeatures include:\n\nUp to 16-player online lobbies\n3-round party matches\nMultiple maps and game modes\nUnlockable skins and cosmetics\nFast-paced VR movement and competition\nRegular new content and updates\n\nWhether you're playing to win or just causing chaos with friends, PrimalVR is built for unpredictable multiplayer fun.", "short_description": "Jump into chaotic 16-player VR party matches! Compete in intense rounds, survive unique maps, unlock skins, and fight to be the last player standing."}]}, "developer_name": "Jahqu", "developer_privacy_policy_url": "https://stickersvr.github.io/primalvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Jahqu", "support_website_url": null, "website_url": "https://stickersvr.github.io/primalvr-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "1331299153397059"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499300738_1405272458389414_2719646887823703224_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xzbJ5GSmTgoQ7kNvwFrWEoi&_nc_oc=AdqDVqsWdbhQMWJoOeSqc4Bua90IWhF2K5feU0ze5_1m1fO9fdknZqBIq6iN6H0ROnU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUaapB74FTvoRMS7Epzy1Ee5u5y7w3MJFjOJNjOSU7Ng&oe=6AC5054F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PrimalVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Party Game", "id": "1700921480735423"}, {"topic_name": "Platformer", "id": "528142316460358"}], "relea
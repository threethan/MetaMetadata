ttps://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499297120_2690343171363725_3501761583217391444_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vBgn2xnP9e8Q7kNvwE7QA-p&_nc_oc=AdrFI_vclRkNMIWJBD5bpCzJpAtR52Wuf2hf921lPQvOfz6iMdwmB_y_2NmjOfrKVY4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPiTE52t3vQDDH0FqLJ71ojPSWteF62r0tpACFHWM_-uA&oe=6AC8E758"}, "display_name": "PrimalVR", "keywords": ["primal", "vr", "stumble", "guys", "fall"], "long_description": "PrimalVR is a fast-paced multiplayer VR party game where up to 16 players compete through 3 chaotic rounds to see who comes out on top.\n\nRun, climb, dodge, survive, and outplay other players across a growing collection of unique maps and game modes. Every round brings new challenges, unexpected moments, and opportunities to knock out the competition.\n\nCustomize your character with a variety of skins and cosmetics, play with friends or meet new players, and keep coming back as new maps, modes, cosmetics, and features are added.\n\nFeatures include:\n\nUp to 16-player online lobbies\n3-round party matches\nMultiple maps and game modes\nUnlockable skins and cosmetics\nFast-paced VR movement and competition\nRegular new content and updates\n\nWhether you're playing to win or just causing chaos with friends, PrimalVR is built for unpredictable multiplayer fun.", "short_description": "Jump into chaotic 16-player VR party matches! Compete in intense rounds, survive unique maps, unlock skins, and fight to be the last player standing."}]}, "developer_name": null, "developer_privacy_policy_url": "https://stickersvr.github.io/primalvr-privacy/", "developer_terms_of_service_url": null, "publisher_name": "Jahqu", "support_website_url": null, "website_url": "https://stickersvr.github.io/primalvr-privacy/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, 
_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hY3drHJwY4Q7kNvwHovQQO&_nc_oc=AdrGVIs1w2K-MwI5mr8KYd-5jgvBDbhka0H8FacSd4400k8bQU10Pas-94n6_Pg9usQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCA6iFSi576t8YPdfvV29ejugO126DnmXa_Y221v6yP1Q&oe=6A4BA19C"}, {"file_name": "Image Sequence_014_0000.png", "id": "651035987939015", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311553_651035991272348_5373410231614210051_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eL0swrpfMMkQ7kNvwEDe-mo&_nc_oc=AdqbGfyCssjWhPQqlnBXyyL7zX2Qm9Zg20jEM090kz2tv40lvMsNpAniIfLdYKp0csU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7a-gjSOqK-KKFwI6SSKGNko5glaqzrCwewyCKOaGJoA&oe=6A4BC691"}, {"file_name": "Image Sequence_018_0000.png", "id": "3888313721408067", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499327047_3888313724741400_8433662412092859559_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1lCwTBVeu8Q7kNvwFStJ2A&_nc_oc=AdpCvusSZCybJpvo9b0HTeK8TI-RlcIfHngDzWyVYolQPEwov25s81hbhp8sOqii10o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC6uWlqe12j_o0VDfx6duEx3uuQUfHZLX7PqU4qD0QiQ&oe=6A4B9F46"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "SMSCP Skilldrive Training Sim", "keywords": ["engineering", "education", "mechatronics", "simulations", "training"], "long_description": "SMSCP Skilldrive is a VR-based educational training platform developed by the Virtual Mechatronics Lab to simulate key modules of the Siemens Mechatronic Systems Certification Program (SMSCP).\n\nThis experience introduces users to mechatronic systems through:\n\nSensors Scene: Learn about different types of sensors by virtually connecting and testing them in real-time.\n\nGears Scene: Explore various gear types, their operation, and real-world applications.\n\nEach module includes:\n\nEducational panels with step-by-step instructions\n\nSummarized theory content on the topic\n\nAn interactive quiz/test to assess learning outcomes\n\nDesigned to support skill development in TVET and engineering institutions, SMSCP Skilldrive enhances hands-on learning through immersive simulation aligned with global mechatronics training standards.", "short_description": "An immersive VR training platform that introduces users to Siemens SMSCP concepts through interactive sensor and gear simulations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vmlafrica.org/docs/censent%20vr.pdf", "developer_terms_of_service_url": null, "publisher_name": "Siemens Mechatronic Systems Certification Centre (DeKUT)", "support_website_url": null, "website_url": "https://vmlafrica.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26862810196670050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491830021_1912216062931212_1559283651498655245_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx1lbJYOhLIQ7kNvwFy-6pP&_nc_oc=AdprC3CzlC0jsvERymckwLoi9ASQD88zH0u67YbjVYMWHzqb6fUo-vprhuyYV1nRlNM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwFH7hyjxHpl1NBS5SD-kjak7PSZ06zwpGOL0b4ZcuCg&oe=6A4BB9A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "SMSCP Skilldrive Training Sim", "platform": "ANDROID_6DOF", "co
ience introduces users to mechatronic systems through:\n\nSensors Scene: Learn about different types of sensors by virtually connecting and testing them in real-time.\n\nGears Scene: Explore various gear types, their operation, and real-world applications.\n\nEach module includes:\n\nEducational panels with step-by-step instructions\n\nSummarized theory content on the topic\n\nAn interactive quiz/test to assess learning outcomes\n\nDesigned to support skill development in TVET and engineering institutions, SMSCP Skilldrive enhances hands-on learning through immersive simulation aligned with global mechatronics training standards.", "short_description": "An immersive VR training platform that introduces users to Siemens SMSCP concepts through interactive sensor and gear simulations."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vmlafrica.org/docs/censent%20vr.pdf", "developer_terms_of_service_url": null, "publisher_name": "Siemens Mechatronic Systems Certification Centre (DeKUT)", "support_website_url": null, "website_url": "https://vmlafrica.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26862810196670050"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491830021_1912216062931212_1559283651498655245_n.png?stp=dst-png_s360x360&_nc_cat
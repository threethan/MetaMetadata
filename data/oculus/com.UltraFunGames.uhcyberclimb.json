ile_name": "UH CYBER 0 5.png", "id": "2737016323326969", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821081_2737016333326968_7937372385497896912_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0R6FNZWwEbwQ7kNvwG6hyc0&_nc_oc=AdoC0YMh5h30Mh8C0hSOxt1LjjmBvWnoGRYmcf247qVUMP96fp9cXt_kPotikeQAhBA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2mo5yahP51l2b7QOtesDXPpgJ6va6a_D8ovLkr0Q0m5Q&oe=69F0B656"}, {"file_name": "UH CYBER 0.png", "id": "1605513623940854", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823901_1605513627274187_718883518830209100_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kWNT4L0qgfIQ7kNvwG0P-ym&_nc_oc=AdoPLJFprH3p0ncGH46ESRC9NcV_XZvrRPdN4AnVL2JwTId4dRl1mAFUkKbuzsU1vZY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1EEGhtL427-2acBpVxq_evfCxB9z745H-V6KWGcQEcfg&oe=69F0ADD5"}, {"file_name": "UH CYBER 0 4.png", "id": "1536521660995232", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823746_1536521664328565_7758339419171314542_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=opD4usozvsoQ7kNvwF0OBT7&_nc_oc=Adp7VQyV9ForWUustIQm4IVLBLiCEelGFS_1vLfeEBHDBj1mqCIta0CfKA4BJGZQT4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af32jF6wBepMXvJLDVU_lCdgJ4XwKe2oiHEPvZQfp0JmYg&oe=69F0CF76"}, {"file_name": "UH CYBER 0 3.png", "id": "25762304626770674", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824322_25762304653437338_1307376407140721144_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjyrUBx4rOEQ7kNvwHnG6pL&_nc_oc=AdrYIRNzRzEfYMOghKMzS-cKiVRJPF5Nxp65IdAleJW4tEdARikCb1Mwf24pfllSMI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af26qK-n_z_PFFw5myvdEM-znSgQ2Sn0oBe4KBeZa-9l4g&oe=69F0C603"}, {"file_name": "UH CYBER 0 2.png", "id": "3795323923931848", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820441_3795323927265181_930611488900163259_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btrdUUd5ljIQ7kNvwFpRRIL&_nc_oc=AdpPqLqgxswpFCYU9RGXqkd7UIuc0vWWJj4mmAjtlcsbtAiAQkwfaNjFDL0Id8v_HPc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2etl4iQbPP1KH367I1-v1yO_zOh-CLQGSSJb1NTgZUyw&oe=69F0A933"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultra Height: Cyber City Climbing", "keywords": ["climbing", "parkour", "parachute", "cyberpunk", "flying"], "long_description": "Ultra Height: Cyber City Climbing is a VR climbing and base-jumping game that pushes your fear of heights to the limit.\n\nAcross 20 progressively harder levels, you climb increasingly taller buildings in a futuristic cyber city. Each level introduces new challenges that test your balance, precision, and nerve.\n\n\ud83d\udd39 Core Gameplay\n\nClimb realistic skyscrapers using full VR hand interaction\n\nNavigate fire exit staircases, ledges, ladders, and complex building structures\n\nBalance and walk across narrow pipes at extreme altitude\n\nJump between platforms high above the city\n\nReach the top and base jump with a parachute to complete each level\n\n\ud83d\udd39 Progression & Challenge\n\nEvery level is higher, harder, and more intense than the last\n\nCarefully designed skyscrapers with varied layouts and obstacles\n\nRequires calm movement, spatial awareness, and steady hands\n\n\ud83d\udd39 VR Immersion\n\nDesigned specifically for VR comfort and immersion\n\nStrong sense of scale, height, and vertigo\n\nPerfect for players who enjoy climbing, parkour, and adrenaline experiences.\n\nIf you love extreme heights, precise movement, and the thrill of jumping off massive buildings, Ultra Height: Cyber City Climbing delivers a pure, intense VR experience!", "short_description": "Climb towering skyscrapers and leap into the void in this high-intensity VR climbing and base-jumping experience. Ascend dangerous buildings, overcome extreme height challenges, and finish each level by jumping and parachuting down from the top."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-oculus/", "developer_terms_of_service_url": null, "publisher_name": "ULTRA FUN GAMES", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25372337022456629"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1252140506948802"}, {"status": "PUBLISHED", "id": "1688203079289079"}, {"status": "PUBLISHED", "id": "25829649666641946"}]}, "baseline_offer": {"id": "1252140506948802"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775851620, "status": "PUBLISHED", "id": "1252140506948802"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25949285864761739", "version": "1.2.78"}, "id": "1485814905829582", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25372336959123302", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25949285864761739"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1485814905829582"}]}, "change_log": n
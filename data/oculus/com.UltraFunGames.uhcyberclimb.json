iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSitmuivIANuSu0chJtNiqzkKJKUSgLvLFmHa_yz_fnwA&oe=6B0C70C3"}, {"file_name": "UH CYBER 0 2.png", "id": "3795323923931848", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820441_3795323927265181_930611488900163259_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFBA_Nk2UJ4Q7kNvwGVJ1zc&_nc_oc=AdpBFT0jqaJAKTenucb8oI11jt8KmZ3kF-UBjJ-IUBQvkchyHUXrIPaAG0wBZDgbGTY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSxGLmboiyp3YDRSPHlZUrT7Kb0AhWjiX0lUVAgmC2OOA&oe=6B0C53F3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultra Height: Cyber City Climbing", "keywords": ["climbing", "parkour", "parachute", "cyberpunk", "flying"], "long_description": "Ultra Height: Cyber City Climbing is a VR climbing and base-jumping game that pushes your fear of heights to the limit.\n\nAcross 20 progressively harder levels, you climb increasingly taller buildings in a futuristic cyber city. Each level introduces new challenges that test your balance, precision, and nerve.\n\n\ud83d\udd39 Core Gameplay\n\nClimb realistic skyscrapers using full VR hand interaction\n\nNavigate fire exit staircases, ledges, ladders, and complex building structures\n\nBalance and walk across narrow pipes at extreme altitude\n\nJump between platforms high above the city\n\nReach the top and base jump with a parachute to complete each level\n\n\ud83d\udd39 Progression & Challenge\n\nEvery level is higher, harder, and more intense than the last\n\nCarefully designed skyscrapers with varied layouts and obstacles\n\nRequires calm movement, spatial awareness, and steady hands\n\n\ud83d\udd39 VR Immersion\n\nDesigned specifically for VR comfort and immersion\n\nStrong sense of scale, height, and vertigo\n\nPerfect for players who enjoy climbing, parkour, and adrenaline experiences.\n\nIf you love extreme heights, precise movement, and the thrill of jumping off massive buildings, Ultra Height: Cyber City Climbing delivers a pure, intense VR experience!", "short_description": "Climb towering skyscrapers and leap into the void in this high-intensity VR climbing and base-jumping experience. Ascend dangerous buildings, overcome extreme height challenges, and finish each level by jumping and parachuting down from the top."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-oculus/", "developer_terms_of_service_url": null, "publisher_name": "ULTRA FUN GAMES", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25372337022456629"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1252140506948802"}, {"status": "PUBLISHED", "id": "1688203079289079"}, {"status": "PUBLISHED", "id": "25829649666641946"}]}, "baseline_offer": {"id": "1252140506948802"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775851620, "status": "PUBLISHED", "id": "1252140506948802"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25949285864761739", "version": "1.2.78"}, "id": "1485814905829582", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only":
_0fwpTYnA30KU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY_fyfMnvUObt8Nrd2vQIxJaLlsNh_p3lY9WjoKQxsRg&oe=6AFC7EEC"}, {"file_name": "3.png", "id": "1069829365485125", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620817_1069829368818458_4736617141253640543_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEYJGDwKZu0Q7kNvwGKPJlK&_nc_oc=AdpZgKR59EN7FO3p5RqE9T_Ve1KQCXNnhulDaUGSuuq3BgDuZVVqskAleFCp49EKXuQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJAREW8Lvt6Ql9uvHrSxjlgOgmnjSFoZaWT8HD6Oc2Gg&oe=6AFC793E"}, {"file_name": "4.png", "id": "1053937693804112", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673638530_1053937700470778_6299887377405960249_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=li-kVqWqS8wQ7kNvwEscigK&_nc_oc=AdohX4frFjAx9IZdXXHOwB3iEp75SB5yRsVeBinNgKBJaXQHPyiXi-vymOYmDpCZxsQ&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK2gMYSctIhM6wKer-GyoyO3v6cmRl3YyjhFjzeajxvQ&oe=6AFC767E"}, {"file_name": "5.png", "id": "1752542886097145", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499619668_1752542889430478_1819614256692818125_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=06eGGycR5KAQ7kNvwGAQPKX&_nc_oc=Adr2eRzGc0RiuPRUBRCGvTJnyOmLZXdq19zqSa0pzDHpf_z4DjZc9_bc3cQfVYcEp0Y&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQuPRV5b-IHcOTv5BiAh2URM-b9jqGHnlI8CQF5Et6QZQ&oe=6AFC70FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (2).png", "id": "1734595944459719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622276_1734595947793052_2639806269991627472_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mejG33w2VwQ7kNvwEYxIDF&_nc_oc=AdppYjTjunSImLaMvuDwCkBe7o9lbGc37sMfgsWEgGzs6ZVAiEbfCSXuGTo1tdEQo_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSYnSuulkjH0fu23LwhMvgASCEsTi55lW69FeSja8zdnw&oe=6AFC87E3"}, "display_name": "Fit with Pets : Run, Workout & Relax", "keywords": ["Fitness", "Cardio", "Running", "Puppy", "Exercise"], "long_description": "# Turn Your Daily Run into a Joyful Dog Walk! \u26a1     \nReady for a cardio workout that doesn't feel like a chore? Fit with Pets transforms your fitness routine into a fun and rewarding run with an  energetic virtual pup. Swing your arms to jog, keep pace, and make sure your furry friend stays happy. It's the perfect blend of fitness, fun, and relaxation!    \n\n\ud83d\udd25**Key Features:**\n\ud83d\udc3e **Dynamic Leash Mechanics:** Swing your arms to move! If you slow down, the leash pulls taut and your pup gets grumpy. Swing faster to catch up and keep them smiling!   \n\ud83d\udcaf **Mood-Based Scoring (0-100%):** Your dog's happiness is your score! Keep the leash slack to boost their mood up to 100%. If they pull too hard, your score drops\u2014keep moving to win!    \n\ud83c\udfc3 **Cardio & Relax:** Get your heart rate up with active arm-swinging, and enjoy the rewarding feeling of relaxing with your cute companion after a hard workout.   \n\ud83d\udc36 **Your Pet is the Best Trainer:** Want to keep your dog happy? That\u2019s the ultimate motivation to push through an intense cardio session! Keep swinging your arms to the limit just to see that adorable smile.   \n\ud83c\udf33 **Immersive Environments:** Run through beautiful, relaxing scenery that makes every workout feel like a breath of fresh air. \nLace up your virtual sneakers, grab the leash, and make your pup happy today! \ud83c\udfc6     \n", "short_description": "Grab the leash and get moving! \ud83d\udc36 Fit with Pets is a fun VR fitness game where your arm-swinging speed controls your pace. Keep up with your eager dog, keep the leash slack, and keep their tail wagging for a 100% score. Run, work out, and relax with your virtual best friend! \ud83d\udc3e   "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29254229667502309"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620965_1965681490803923_2669043464544160297_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C9WzHMfnTaIQ7kNvwF7e9jd&_nc_oc=AdqANZjO2nCmA5TedNj83uzy7DoYuIAucLD-30xo7BJl369U5XJVQzcW0mGF_V_c5U4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfZdXMFF3Fi1qx6QkQufPcUfp0Dt41toiXFJMStqbPgQ&oe=6AFC7157"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fit with Pets : Run, Workout & Relax", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1785495480, "lastRevision": {"nodes": [{"id": "27928953003363322", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "27928952940029995", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "ia
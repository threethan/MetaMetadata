1-7&_nc_sid=6e7a0a&_nc_ohc=Cip0TguhOc8Q7kNvwEIFQCm&_nc_oc=AdoIgAQUQ9gHgr-em33iy2QpKeMmayxQbhx6RvygzOUiu2908XFEduvHocCFjHrRICM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv9Kj2D82GKhy_RGFDbQaoMmrIvpORYeU-HHyDGxAmVA&oe=6A9417BE"}, {"file_name": "5.png", "id": "1752542886097145", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619668_1752542889430478_1819614256692818125_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sb7jd2HTPrcQ7kNvwEDE5pd&_nc_oc=AdqkRHQgoP-uKfJ75HwqC3g-V9_JoR34T-d9h2T6hlkR3U-NnUBvbOd5oTQlDkZVjtQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8a7WYw8u-WT4wzft7M2dmZa89mpzcvVsePVgnu7H-Nw&oe=6A94123B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (2).png", "id": "1734595944459719", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499622276_1734595947793052_2639806269991627472_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTojr_5btZEQ7kNvwFC6IfC&_nc_oc=AdqevpuExick2KYxahZnoQhc5FKPAUYBwWiw2-u3QqPk0u5pczgX6An5svzRJhunzZM&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIcBJ1pjrMMRfdXuByguZrH8UPz_L41VerodYDmAxTWw&oe=6A942923"}, "display_name": "Fit with Pets : Run, Workout & Relax", "keywords": ["Fitness", "Cardio", "Running", "Puppy", "Exercise"], "long_description": "# Turn Your Daily Run into a Joyful Dog Walk! \u26a1     \nReady for a cardio workout that doesn't feel like a chore? Fit with Pets transforms your fitness routine into a fun and rewarding run with an energetic virtual pup. Swing your arms to jog, keep pace, and make sure your furry friend stays happy. It's the perfect blend of fitness, fun, and relaxation!    \n\n\ud83d\udd25**Key Features:**\n\ud83d\udc3e **Dynamic Leash Mechanics:** Swing your arms to move! If you slow down, the leash pulls taut and your pup gets grumpy. Swing faster to catch up and keep them smiling!   \n\ud83d\udcaf **Mood-Based Scoring (0-100%):** Your dog's happiness is your score! Keep the leash slack to boost their mood up to 100%. If they pull too hard, your score drops\u2014keep moving to win!    \n\ud83c\udfc3 **Cardio & Relax:** Get your heart rate up with active arm-swinging, and enjoy the rewarding feeling of relaxing with your cute companion after a hard workout.   \n\ud83d\udc36 **Your Pet is the Best Trainer:** Want to keep your dog happy? That\u2019s the ultimate motivation to push through an intense cardio session! Keep swinging your arms to the limit just to see that adorable smile.   \n\ud83c\udf33 **Immersive Environments:** Run through beautiful, relaxing scenery that makes every workout feel like a breath of fresh air. \nLace up your virtual sneakers, grab the leash, and make your pup happy today! \ud83c\udfc6     \n", "short_description": "Grab the leash and get moving! \ud83d\udc36 Fit with Pets is a fun VR fitness game where your arm-swinging speed controls your pace. Keep up with your eager dog, keep the leash slack, and keep their tail wagging for a 100% score. Run, work out, and relax with your virtual best friend! \ud83d\udc3e  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2792895297
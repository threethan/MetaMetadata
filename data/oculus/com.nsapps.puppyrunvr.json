a0a&_nc_ohc=96PyHgKHp94Q7kNvwFR_Zsq&_nc_oc=AdpSmEy4vr7JgD3VXmoFCQA8tawpVNd3LDtPtdYHhBAlVIC5fGIVMa17TuuHOJg0FLY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8UmI6mc5Kx-3kLQdG2jsv0AbKLOhdPnlNDkMHTrx4cA&oe=6A972DFE"}, {"file_name": "4.png", "id": "1053937693804112", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/673638530_1053937700470778_6299887377405960249_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TI25wbd809AQ7kNvwEcQysU&_nc_oc=AdqgHUHFEUbwckyFldjkrkOY97yQqj2TbAAYGWK4Sg1Fz2rbn2AFtJeYDxGYsw2neL8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLe1HDyPxsvAKmox6CfmBAMyglWVMKloLGNnD4gSVYeQ&oe=6A972B3E"}, {"file_name": "5.png", "id": "1752542886097145", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499619668_1752542889430478_1819614256692818125_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLpRu9ev1dQQ7kNvwEmXTOX&_nc_oc=Ado1HFscxRkY_LP3CXpIeCJdQ-UyAPHbrwZIL3M3eAWlXihGWklyLCrc9xHydDsxgLU&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFM3G_7sNma286T-zYhBrQtEgyhf-knvt780352X1agGQ&oe=6A9725BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (2).png", "id": "1734595944459719", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499622276_1734595947793052_2639806269991627472_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QgdSb8FT9A8Q7kNvwHkkAi6&_nc_oc=AdqQ6SDz_qmybrX08p0_b4O9qOCehB5OSsQ9W_aB_wz-mOVl0WqkCZpZxMmFtdUjzj8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHwY6ebAflgzxcwbAvL7Ae3H_paxrmg59XqHuRKaXU4bA&oe=6A973CA3"}, "display_name": "Fit with Pets : Run, Workout & Relax", "keywords": ["Fitness", "Cardio", "Running", "Puppy", "Exercise"], "long_description": "# Turn Your Daily Run into a Joyful Dog Walk! \u26a1     \nReady for a cardio workout that doesn't feel like a chore? Fit with Pets transforms your fitness routine into a fun and rewarding run with an  energetic virtual pup. Swing your arms to jog, keep pace, and make sure your furry friend stays happy. It's the perfect blend of fitness, fun, and relaxation!    \n\n\ud83d\udd25**Key Features:**\n\ud83d\udc3e **Dynamic Leash Mechanics:** Swing your arms to move! If you slow down, the leash pulls taut and your pup gets grumpy. Swing faster to catch up and keep them smiling!   \n\ud83d\udcaf **Mood-Based Scoring (0-100%):** Your dog's happiness is your score! Keep the leash slack to boost their mood up to 100%. If they pull too hard, your score drops\u2014keep moving to win!    \n\ud83c\udfc3 **Cardio & Relax:** Get your heart rate up with active arm-swinging, and enjoy the rewarding feeling of relaxing with your cute companion after a hard workout.   \n\ud83d\udc36 **Your Pet is the Best Trainer:** Want to keep your dog happy? That\u2019s the ultimate motivation to push through an intense cardio session! Keep swinging your arms to the limit just to see that adorable smile.   \n\ud83c\udf33 **Immersive Environments:** Run through beautiful, relaxing scenery that makes every workout feel like a breath of fresh air. \nLace up your virtual sneakers, grab the leash, and make your pup happy today! \ud83c\udfc6     \n", "short_description": "Grab the leash and get moving! \ud83d\udc36 Fit with Pets is a fun VR fitness game where your arm-swinging speed controls your pace. Keep up with your eager dog, keep the leash slack, and keep their tail wagging for a 100% score. Run, work out, and relax with your virtual best friend! \ud83d\udc3e  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genr
s=7f20f&oh=00_AQGwAEuFqP3v0KVuxgI9BQNRYHD8U2893aezMNSWXIus1A&oe=6A82FCAC"}, {"file_name": "3.png", "id": "1069829365485125", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1069829368818458_4736617141253640543_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9BJ6OYqFwcQ7kNvwE7GLJF&_nc_oc=AdpBzl06vjAlVyx0L5tp09EhTQNVj_lGuvjhOVFBlh4WhLEgd9PCr-ypLoOcsgIW1VY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvgeYlfqWy2_PjY76w0F_U8CT_7EnJcZXFG-MaOxhpNg&oe=6A82F6FE"}, {"file_name": "4.png", "id": "1053937693804112", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673638530_1053937700470778_6299887377405960249_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOeT5ANqG28Q7kNvwGeJEb2&_nc_oc=Adr-W5kacwn2YRo7rsn74bAkC60YE6IYpFUgm06imO8KwPxj_3qOART0G9jrI5M872s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQwaz13LIlBlLHOWWbsx8xyUIMdrHBiQyfGdgzSjOqwg&oe=6A82F43E"}, {"file_name": "5.png", "id": "1752542886097145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619668_1752542889430478_1819614256692818125_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_idB8-fyntMQ7kNvwEd9Btx&_nc_oc=AdpnIm5q7HOVICCmfo39C4z93Y3w5FhgqfoYuQMDwbJ5YR34_LxF16VrGjWOHdvjdMA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX3Zd3VRVp3mdEQWCmttofvm7_lCJFudtnZJEjvDzxyw&oe=6A82EEBB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (2).png", "id": "1734595944459719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622276_1734595947793052_2639806269991627472_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEtfbNPvw1YQ7kNvwHpQkt2&_nc_oc=Adr5KJMua4GV12nfdkvzVD8VT2zZ8iuuSC1kMQFsGgTiPDIkDybGcT1Fx2qx-czCCyI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHzfLjOmdo3d6-qUCZucuP6TWLh0jLeW9qCnBuP9TjjnQ&oe=6A8305A3"}, "display_name": "Fit with Pets : Run, Workout & Relax", "keywords": ["Fitness", "Cardio", "Running", "Puppy", "Exercise"], "long_description": "# Turn Your Daily Run into a Joyful Dog Walk! \u26a1     \nReady for a cardio workout that doesn't feel like a chore? Fit with Pets transforms your fitness routine into a fun and rewarding run with an energetic virtual pup. Swing your arms to jog, keep pace, and make sure your furry friend stays happy. It's the perfect blend of fitness, fun, and relaxation!    \n\n\ud83d\udd25**Key Features:**\n\ud83d\udc3e **Dynamic Leash Mechanics:** Swing your arms to move! If you slow down, the leash pulls taut and your pup gets grumpy. Swing faster to catch up and keep them smiling!   \n\ud83d\udcaf **Mood-Based Scoring (0-100%):** Your dog's happiness is your score! Keep the leash slack to boost their mood up to 100%. If they pull too hard, your score drops\u2014keep moving to win!    \n\ud83c\udfc3 **Cardio & Relax:** Get your heart rate up with active arm-swinging, and enjoy the rewarding feeling of relaxing with your cute companion after a hard workout.   \n\ud83d\udc36 **Your Pet is the Best Trainer:** Want to keep your dog happy? That\u2019s the ultimate motivation to push through an intense cardio session! Keep swinging your arms to the limit just to see that adorable smile.   \n\ud83c\udf33 **Immersive Environments:** Run through beautiful, relaxing scenery that makes every workout feel like a breath of fresh air. \nLace up your virtual sneakers, grab the leash, and make your pup happy today! \ud83c\udfc6     \n", "short_description": "Grab the leash and get moving! \ud83d\udc36 Fit with Pets is a fun VR fitness game where your arm-swinging speed controls your pace. Keep up with your eager dog, keep the leash slack, and keep their tail wagging for a 100% score. Run, work out, and relax with your virtual best friend! \ud83d\udc3e  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc
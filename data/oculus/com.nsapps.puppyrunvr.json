a0a&_nc_ohc=eLc7kw4d2coQ7kNvwGGdMBh&_nc_oc=AdomqemeGRVW9eVyIXyQNAF0Y79bU4BRSlsFaEux2YuX7e04dtosfsLbnUOEBOu5aGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfKo1GrTFJdrJhdak5k6XhApOofj1eZSPCcE302MLUHg&oe=6A92C8FE"}, {"file_name": "4.png", "id": "1053937693804112", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673638530_1053937700470778_6299887377405960249_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tf5qRV2AQkoQ7kNvwHUUpeg&_nc_oc=AdrTSBmPRe0k1mfWSWscQitUnzW48Tvh5EdVflF87nxlPhoe4-5zdvhLdSEi-VeBdkI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNM6xhdtM_3fZZy5kxU1nCpsLI-ql7dfO8WFajpWSkAQ&oe=6A92C63E"}, {"file_name": "5.png", "id": "1752542886097145", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619668_1752542889430478_1819614256692818125_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sb7jd2HTPrcQ7kNvwGhOYBo&_nc_oc=AdoURUr4GL_g6CTHBBcGfDbH3VbuPjpDdT5OfuSZtVHf2BsaHZhxzRH17wHrxxm0_f0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6D7kOu5GKZBj-9TpmueGrlR2t3TMAl0xUhUkwreOojA&oe=6A92C0BB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (2).png", "id": "1734595944459719", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622276_1734595947793052_2639806269991627472_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLak-1WETlIQ7kNvwEi4VNP&_nc_oc=AdppI0r-ES8v0dy4jSrQba3S6aBfL6MdcpAijN8m8UGlR3n1fV5xg6Af-8OsEEjGajs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFFFG767pDUNkbCLMqz9GgjXw0bAGJycklM4jhOlI87zw&oe=6A92D7A3"}, "display_name": "Fit with Pets : Run, Workout & Relax", "keywords": ["Fitness", "Cardio", "Running", "Puppy", "Exercise"], "long_description": "# Turn Your Daily Run into a Joyful Dog Walk! \u26a1     \nReady for a cardio workout that doesn't feel like a chore? Fit with Pets transforms your fitness routine into a fun and rewarding run with an  energetic virtual pup. Swing your arms to jog, keep pace, and make sure your furry friend stays happy. It's the perfect blend of fitness, fun, and relaxation!    \n\n\ud83d\udd25**Key Features:**\n\ud83d\udc3e **Dynamic Leash Mechanics:** Swing your arms to move! If you slow down, the leash pulls taut and your pup gets grumpy. Swing faster to catch up and keep them smiling!   \n\ud83d\udcaf **Mood-Based Scoring (0-100%):** Your dog's happiness is your score! Keep the leash slack to boost their mood up to 100%. If they pull too hard, your score drops\u2014keep moving to win!    \n\ud83c\udfc3 **Cardio & Relax:** Get your heart rate up with active arm-swinging, and enjoy the rewarding feeling of relaxing with your cute companion after a hard workout.   \n\ud83d\udc36 **Your Pet is the Best Trainer:** Want to keep your dog happy? That\u2019s the ultimate motivation to push through an intense cardio session! Keep swinging your arms to the limit just to see that adorable smile.   \n\ud83c\udf33 **Immersive Environments:** Run through beautiful, relaxing scenery that makes every workout feel like a breath of fresh air. \nLace up your virtual sneakers, grab the leash, and make your pup happy today! \ud83c\udfc6     \n", "short_description": "Grab the leash and get moving! \ud83d\udc36 Fit with Pets is a fun VR fitness game where your arm-swinging speed controls your pace. Keep up with your eager dog, keep the leash slack, and keep their tail wagging for a 100% score. Run, work out, and relax with your virtual best friend! \ud83d\udc3e  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/product/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genr
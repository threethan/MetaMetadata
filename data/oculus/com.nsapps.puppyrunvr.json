s=7f20f&oh=00_AQGuie-2oYvEO29N0waVyPFFxzAo4M3WIUk8rDT-qEGBEg&oe=6A844E2C"}, {"file_name": "3.png", "id": "1069829365485125", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620817_1069829368818458_4736617141253640543_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9BJ6OYqFwcQ7kNvwGkd48h&_nc_oc=AdoCQ_awPMhF1Gt2mWemPaSKTqUY9rsEpQV_b0GqgH_2f_FRBz-NaQ0Tv4m0OldN02s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFvgNLJhlunRZfMcoo0QF8o6O0JXzVYuEewHlX3qWvhVA&oe=6A84487E"}, {"file_name": "4.png", "id": "1053937693804112", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/673638530_1053937700470778_6299887377405960249_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vOeT5ANqG28Q7kNvwE9z-Oy&_nc_oc=AdoRIUOXxM_q_knvdBwh1LHpryvAcvqLURwwG79g1tDYXYql5-TEMJqLUnlyMVjZj-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGREOdsedjUT8WJjub8XNu47UAgPH1ZEx8P3AU2ij5zFg&oe=6A8445BE"}, {"file_name": "5.png", "id": "1752542886097145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619668_1752542889430478_1819614256692818125_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_idB8-fyntMQ7kNvwEx6aaa&_nc_oc=AdrgYKBjampK02bdr2DSwHTyPUb5orVhekb5rV8VSG1JBDZH5n9vQc-kmeJVPLjTIo0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkA4HNK0N7NKtCxjU1O0JCrerL_LYzemIwOu3iG4Op7w&oe=6A84403B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "1 (2).png", "id": "1734595944459719", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622276_1734595947793052_2639806269991627472_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iushiYxqnXoQ7kNvwHNIE9G&_nc_oc=AdoyvpYU7PSZNLi4CER4kpjN0-jkbrIVQSCdoeEt0WeWkQzmScOnDyZX6oZ8SSN7N58&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk8rax-Odai8_B4d9AQx04QM9Odbhh76zByfXyaWNDZQ&oe=6A845723"}, "display_name": "Fit with Pets : Run, Workout & Relax", "keywords": ["Fitness", "Cardio", "Running", "Puppy", "Exercise"], "long_description": "# Turn Your Daily Run into a Joyful Dog Walk! \u26a1     \nReady for a cardio workout that doesn't feel like a chore? Fit with Pets transforms your fitness routine into a fun and rewarding run with an energetic virtual pup. Swing your arms to jog, keep pace, and make sure your furry friend stays happy. It's the perfect blend of fitness, fun, and relaxation!    \n\n\ud83d\udd25**Key Features:**\n\ud83d\udc3e **Dynamic Leash Mechanics:** Swing your arms to move! If you slow down, the leash pulls taut and your pup gets grumpy. Swing faster to catch up and keep them smiling!   \n\ud83d\udcaf **Mood-Based Scoring (0-100%):** Your dog's happiness is your score! Keep the leash slack to boost their mood up to 100%. If they pull too hard, your score drops\u2014keep moving to win!    \n\ud83c\udfc3 **Cardio & Relax:** Get your heart rate up with active arm-swinging, and enjoy the rewarding feeling of relaxing with your cute companion after a hard workout.   \n\ud83d\udc36 **Your Pet is the Best Trainer:** Want to keep your dog happy? That\u2019s the ultimate motivation to push through an intense cardio session! Keep swinging your arms to the limit just to see that adorable smile.   \n\ud83c\udf33 **Immersive Environments:** Run through beautiful, relaxing scenery that makes every workout feel like a breath of fresh air. \nLace up your virtual sneakers, grab the leash, and make your pup happy today! \ud83c\udfc6     \n", "short_description": "Grab the leash and get moving! \ud83d\udc36 Fit with Pets is a fun VR fitness game where your arm-swinging speed controls your pace. Keep up with your eager dog, keep the leash slack, and keep their tail wagging for a 100% score. Run, work out, and relax with your virtual best friend! \ud83d\udc3e  "}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy/", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc
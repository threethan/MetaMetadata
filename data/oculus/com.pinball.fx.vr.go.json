7075_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSuR8bgn8R0Q7kNvwErGkcd&_nc_oc=AdqPJE1GvXYhlV-LzEO_TWY7x05Dcjj1Ygu7PEy6IeMJ-isZSNHZqxKeweJEh_gI-rs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQrrXYChT1581QVAT0g6jH3AllDvAGkqc6lvKZ1jwYfMQ&oe=6B0D9B44"}, {"file_name": "5.png", "id": "2563412724133281", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620599_2563412727466614_6619516482392736661_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnA1oHwygvEQ7kNvwFRGlu5&_nc_oc=AdrzWBD7sFoNUGBpBBO83ULh8WCVgzbbwRCvUvnsBbLETlgSBbeZQ9C0OeSKmqcHbYo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSCLWb9BnClXQHdHip7IP216J9gtf-YjRYx71Gf5hfA6Q&oe=6B0DB305"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "3D Pinball Go", "keywords": ["pinball", "arcade", "table", "party", "classic"], "long_description": "Step into the ultimate arcade experience with 3D Pinball Go! Designed from the ground up for virtual reality, this game brings the timeless thrill of classic pinball tables straight into your immersive 3D space.\n\nWhether you're a casual player looking for quick arcade fun or a competitive pinball wizard aiming for the top of the global leaderboards, 3D Pinball Go delivers fast-paced action, hyper-realistic physics, and stunning visual themes.\n\nKey Features:\n\nImmersive VR Gameplay: Interact directly with flippers, pull plungers, and control the table using realistic hand tracking or controllers.\n\nExciting Themes and Tables: Explore unique, detail-packed tables like the vibrant Day of Dead board, filled with custom ramps, targets, and bumpers.\n\nCompetitive Leaderboards: Compete against friends and players worldwide to prove your pinball mastery and claim the highest score.\n\nSmooth Performance: Optimized for fluid gameplay (72+ FPS) to ensure zero lag and a completely comfortable VR experience.\n\nArcade Nostalgia Meets Modern Tech: Enjoy classic arcade sounds, dynamic lighting, and responsive physics that make every bounce feel authentic.\n\nPull the plunger, keep the ball alive, and chain your combos to unlock massive high scores. Download 3D Pinball Go today and start flipping your way to the top!", "short_description": "Experience immersive VR pinball with realistic physics and thrilling boards!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Digital Aesthetics", "support_website_url": null, "website_url": "https://teamdigitalaesthet.wixsite.com/privacypolicy", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1397648730095836"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1108915978676529"}]}, "baseline_offer": {"id": "1108915978676529"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792951440, "status": "PUBLISHED", "id": "1108915978676529"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1393314863862556", "version": "0.1"}, "id": "1412137287214271", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "A
1330083549_n.00_05_03_21.\u9759\u6b62\u753b004.png", "id": "1836664650238569", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821210_1836664653571902_6406442745734947436_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZDIrpRo4gYQ7kNvwEGuxM9&_nc_oc=AdlDA07ubp68xZIuCNnuLdt0hXB-xsZSHC1zpECfwxwxf-0xuS-eR2q1LqwTcL20MYI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsP0Vu-BKvGnd0UbtY93E-febtSPaWlg0TWKAO_LiphEw&oe=69A03E0C"}, {"file_name": "57572928_478412695071001_5104229581330083549_n.00_07_48_27.\u9759\u6b62\u753b001.png", "id": "1408622026801161", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819377_1408622030134494_5212183964317653365_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IXGAf_NzlNcQ7kNvwGwShgt&_nc_oc=Adl6gpOsfn2-8j_IJWgBTtvU_Kv1oniUha5bOuhVFXqZeIIwmG8h5oqWbNMl8F9UCJc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afu8qhmXob-OVmrZunvduoF7eJa-ivqTr60AB3kNvZtBWw&oe=69A03A7C"}, {"file_name": "57572928_478412695071001_5104229581330083549.png", "id": "654486124410250", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473403821_654486127743583_4917977342083234454_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_lg1zTYn9AQ7kNvwFaNDbu&_nc_oc=AdkY6qFR2Y7wBCf-RrS-CnrveGC9on0c3gt0mtxq2h0CMj0OxHwfcAPl-puE8Oqlps8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu24nOCKLhe63rMd9BeLwuBMkvgtm7_Hu18frsEJMBYlw&oe=69A03FAB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "f2p-meta.png", "id": "3169578119839724", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974809_3169578123173057_2079444359238908647_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s42lnJ-YjyMQ7kNvwHhfSrS&_nc_oc=AdlAQh_KGP4hHUlh0rkrQR6URqg0VYOEYCPvLLB25dvGlA2Rw3cUmBs71VomWqWPKBw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuFNdJvxTAw3fv5wjF2xKSUNeWxAKFih8TPp3QAFtFgLA&oe=69A03EFA"}, "display_name": "Akpala", "keywords": ["PvP", "Free", "Magic", "Anime", "AI"], "long_description": "*Free to play for a limited time! (Ends: 31st December 2024) \n\n# VOICE MAGIC ACTIVATION\n\nCast spells by chanting, and striking heroic poses for enhanced magic effects. Learn and perform different spells according to the needs of the battle. Movement, strategic thinking and resource management are crucial in every duel! Be sure that you use every tool in your arsenal.\n\n{1176736497103531}\n\n\n# AI CHARACTER CONVERSATIONS\n\nEngage in voice-based communication with 3D AI characters! During the tutorial stages, you will not only be able to learn everything about the game but also 'chit-chat' with the character that is guiding you with AI-generated conversations. Be sure that you don't get captivated by Lukia and actually finish the tutorial!\n\n{912634733949310}\n\n# GAME HIGHLIGHTS\n\nSupports up to four players in multiplayer mode with 1v1 or 2v2 team battles and battle royales. Grab your partner or join solo with our matchmaking feature and get to play with other Wizards from all around the world.\n\n{1450985992470893}\n\nIn multiplayer, strategically create and place blocks on the stage to build advantageous positions or snipe from above. These blocks can make a huge difference in different scenarios. Need to go higher? Build a ladder! Plain battleground? Create some cover!\n\n{1484220565855393}\n\nTake advantage of different perks and jumping-pads to move through the battlefield. Collect black orbs that yield random outcomes and mana orbs to keep casting your spells.  Flex your wits, move your body, and chant magic loudly on the battlefield!\n\n{465384995949128}\n", "short_description": "Participate in VR Magic battles where you will need to chant to cast spells and strike poses to enhance your power!  Fight 1v1 or 2v2 in a variety of scenarios. Master different spells and defeat your opponents to become a master duelist in Akpala."}, {"images": {"nodes": []}, "id": "1741514766718913", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "AkpalaPV_1.png", "id": "7690176081065379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974456_7690176084398712_3727308418691568002_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77PcbyMJ6g4Q7kNvwGNJamj&_nc_oc=AdnFqHV2b9dYoLoqsZ8Layt2txkp8BUEA_0V6tVsh0OatXqxbg63SdptvLa8YOj26aE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCfy6Dv_jCMxHTRol7MxK3j2265Hg1QD5BFwxKA8fsQA&oe=69A05A67"}, "display_name": "Akpala", "keywords": [], "long_description": "\n# \u97f3\u58f0\u3092\u4f7f\u3063\u305f\u30ea\u30a2\u30eb\u306a\u9b54\u6cd5\u4f53\u9a13\n\u3053\u306e\u30b2\u30fc\u30e0\u3067\u306f\u3001\u5b9f\u969b\u306b\u58f0\u306b\u51fa\u3057\u3066\u546a\u6587\u3092\u5531\u3048\u3001\u6c7a\u3081\u30dd\u30fc\u30ba\u3092\u3068\u308b\u3053\u3068\u3067\u9b54\u6cd5\u306e\u52b9\u679c\u3092\u5f37\u5316\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\u72b6\u6cc1\u306b\u5fdc\u3058\u3066\u3001\u3055\u307e\u3056\u307e\u306a\u546a\u6587\u3092\u4f7f\u3063\u3066\u30d0\u30c8\u30eb\u306b\u52dd\u5229\u3057\u307e\u3057\u3087\u3046\u3002\n\n#  AI \u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u306e\u5bfe\u8a71\n3D AI\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3068\u306e\u97f3\u58f0\u306b\u3088\u308b\u4f1a\u8a71\u3092\u697d\u3057\u307f\u307e\u3057\u3087\u3046\uff01\n\u3053\u306e\u30b2\u30fc\u30e0\u306e\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3067\u306f\u3001\u30b2\u30fc\u30e0\u306b\u3064\u3044\u3066\u3092\u5b66\u3076\u3060\u3051\u3067\u306a\u304f\u3001Akpala\u306b\u3064\u3044\u3066\u30ac\u30a4\u30c9\u3057\u3066\u304f\u308c\u308b\u3001AI\u6280\u8853\u3092\u6d3b\u7528\u3057\u305f\u30ad\u30e3\u30e9\u30af\u30bf\u30fc\u3001\u30eb\u30ad\u30a2\u3068\u300c\u304a\u3057\u3083\u3079\u308a\u300d\u3059\u308b\u3053\u3068\u3082\u3067\u304d\u307e\u3059\u3002\u30eb\u30ad\u30a2\u306b\u9b45\u4e86\u3055\u308c\u3066\u3001\u30c1\u30e5\u30fc\u30c8\u30ea\u30a2\u30eb\u3092\u7d42\u3048\u308b\u3053\u3068\u3092\u5fd8\u308c\u306a\u3044\u3067\u304f\u3060\u3055\u3044\uff01\n\n# \u305d\u306e\u4ed6\u
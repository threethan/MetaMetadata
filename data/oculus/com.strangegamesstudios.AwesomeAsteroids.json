ids", "aweseome", "ship", "arcade", "space"], "long_description": "Awesome Asteroids blends the thrill of the classic arcade series with a fully 3D playing field. Blast through asteroid waves with lasers, rockets and your minigun while defending your bases and structures. Snag shield pickups to absorb impacts, then hunt down enemy ships before they tear your defenses apart\u2014all amid floating mines and orbital hazards.  Customize your ship in the ship builder!", "short_description": "Awesome Asteroids blends the thrill of the classic arcade series with a fully 3D playing field. Blast through asteroid waves with lasers, rockets and your minigun while defending your bases and structures. Snag shield pickups to absorb impacts, then hunt down enemy ships before they tear your defenses apart\u2014all amid floating mines and hazards."}]}, "developer_name": "Strange Games Studios", "developer_privacy_policy_url": "http://www.strangegamesstudios.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Strange Games Studios", "support_website_url": null, "website_url": "https://strangegamesstudios.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["SPACE_UNIVERSE", "FLYING", "ACTION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25770975415820143"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://sc
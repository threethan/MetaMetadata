content-sea5-1.oculuscdn.com/v/t64.5771-25/491830822_1819315892528754_3336685916703704037_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WkoZWp6ZhCUQ7kNvwF5UE_3&_nc_oc=AdqHszkg7FGvBzza30550q2oZgzbmnQVjduqVVUZBnUH_oGXFubCxZg497ifY2Yg6aQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTai-PdtcesdXwd3Z9BXjgfo0IaedsnZ-qI0ymV8HPaOQ&oe=6AFC7EB3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Music Player", "keywords": ["music"], "long_description": "Enjoy your music with My Music Player\u2014a simple, convenient player designed to accompany you while you use your favorite apps and content. Play your music via a clear, 2D-panel interface, with controls always within reach so you can stay focused on what you\u2019re listening to.\n\nImportant Note:  \n-You must create a folder named MyMusic (or mymusic) and place inside it the audio files you want the application to be able to play.\n\n-This app is in early access, and features will be added over the coming weeks and months.\n\nThe design adapts to various panel sizes, ensuring a comfortable experience whether you prefer a wide view or a more compact one. My Music Player puts your music front and center, offering a straightforward, accessible, and user-friendly experience.", "short_description": "A music player with a modern, substantial design for use in VR."}, {"images": {"nodes": []}, "id": "1386682583212737", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "My Music Player", "keywords": ["musica"], "long_description": "Disfruta de tu m\u00fasica My Music Player, un reproductor sencillo y c\u00f3modo pensado para acompa\u00f1arte mientras usas tus aplicaciones y contenidos favoritos. Reproduce tu m\u00fasica desde una interfaz clara en forma de panel 2D, con los controles al alcance para que puedas concentrarte en lo que est\u00e1s escuchando.\n\nNota Importante:  \n- Debes crear una carpeta llamada MyMusic (puede ser tambi\u00e9n mymusic) y colocar all\u00ed los archivos de audio que quieras que la aplicaci\u00f3n pueda reproducir.\n\n- Esta app esta en acceso anticipado y hay  funciones que se iran agregado las proximas semanas y meses.\n\nSu dise\u00f1o se adapta a distintos tama\u00f1os de panel para que la experiencia siga siendo c\u00f3moda tanto si prefieres una vista amplia como una m\u00e1s compacta. My Music Player pone tu m\u00fasica en primer plano con una experiencia directa, accesible y f\u00e1cil de usar.", "short_description": "Reproductor de musica con un dise\u00f1o moderno y pesado para uso en VR"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/179DA-AZ2_wqHwlT0LeWJFsqhWpgqhlDygrQpn7oDrec/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/my-music-player-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1474120852439779"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "924895523818211"}]}, "baseline_offer": {"id": "924895523818211"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792594320, "status": "PUBLISHED", "id": "924895523818211"}]}, "liveChannel": {"nodes": [{"latest_su
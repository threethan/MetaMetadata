7K0C87XOw&oe=6A16FB36"}, {"file_name": "\u622a\u56fe5.png", "id": "1108811133252997", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982439_1108811136586330_644352280341395127_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XmPS2X1g4a8Q7kNvwGpqYS7&_nc_oc=AdrJ03w0nJZu14XNT-x7cHQkEwfCrGMeKPmrdJ-yOwKWi3IZnQogF0z1iaVuUlQi1No&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yfmsLx9P-KJ09a2BXuEN16tQb3DcKXY6zddpJm8pT-w&oe=6A16F2BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u9884\u544a\u7247\u5c01\u9762\u56fe\u7247.png", "id": "1378159819287337", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035322_1378159822620670_4442149295807103551_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqaJE_OMz7oQ7kNvwFz69J1&_nc_oc=AdpiWLiQ2WePYzJBkcksjjZlxM-xbabTVFyDXd_x3HaGFlrMFvnqShkukjlUed1SzHU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6E9Uibq8ODSRT1ZDcRO7Y5184cw9yFPuUQbYOMP8bvDw&oe=6A16FA36"}, "display_name": "Party Crashers: Balloons", "keywords": [], "long_description": "If you are a social expert, you can interact with other users in real-time voice chat, send emoji bubbles, and make unexpected actions in the game lobby. But if you are a social novice, there is no need to worry at all, there are many unique ice-breaking mini-games in the game lobby. You can also experience different modes of the game with other players in the game room. It's a stress-free world where you can have fun with your friends!\n\nGame Mode:\n-Scruffle Mode: Pick up any item on the ground at will, smash mercilessly at your opponent, and win!\n-Handball Mode: Team up with your teammates to pass, shoot, and score! Smash your opponents and hinder their attacks!\n-Graffiti Mode: Use props with different functions, let your imagination run wild, and turn the surrounding walls into works of art that only belong to you!\n\n", "short_description": "Party Crashers: Balloons is a casual, party-type VR game. Become \"Balloons\" in a world full of fantasy, and enjoy the joy of socializing with players from all over the world. "}]}, "developer_name": "HXDF", "developer_privacy_policy_url": "http://vrpro.sitaitongxue.com/web2/outsource/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "HXDF", "support_website_url": null, "website_url": "https://discord.gg/U27U59QNxZ", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ACTION", "SOCIAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "5144463448949289"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PENDING", "id": "2404261699875326"}, {"status": "PUBLISHED", "id": "496445349158531"}, {"status": "PENDING", "id": "1651785838550098"}, {"status": "PENDING", "id": "789545458913955"}, {"status": "PUBLISHED", "id": "406395798129521"}, {"status": "PUBLISHED", "id": "411325417094831"}]}, "baseline_offer": {"id": "496445349158531"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1662656400, "status": "PENDING", "id": "2404261699875326"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "6168790806470895", "version": "2.0"}, "id": "241636984818519", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicati
6moHG3P5g&oe=69D26D36"}, {"file_name": "\u622a\u56fe5.png", "id": "1108811133252997", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982439_1108811136586330_644352280341395127_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8vpKzoxS4wYQ7kNvwGPdqgO&_nc_oc=AdrW4g9mHWpKAcMRRJRj4LjYviWARy-0sW5W48HBto2AoHLFcVzrjo2dAqitn6Z2EdQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ewy01cx4omFoPDn2U0Jw_igrIM3oEU10EnepetYGnzg&oe=69D264BA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u9884\u544a\u7247\u5c01\u9762\u56fe\u7247.png", "id": "1378159819287337", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035322_1378159822620670_4442149295807103551_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSJZw1dB9S0Q7kNvwGETptJ&_nc_oc=AdpkgFPhfcxJyVsoMC_np3M8wvHbkiIvdrJlhs1W7jloYW8vQxFAFtZEyIGcvVCZRaI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af09bwTccojoy_DiSteJKJudckyazFnWlJAdYFu7Mh0jXg&oe=69D26C36"}, "display_name": "Party Crashers: Balloons", "keywords": [], "long_description": "If you are a social expert, you can interact with other users in real-time voice chat, send emoji bubbles, and make unexpected actions in the game lobby. But if you are a social novice, there is no need to worry at all, there are many unique ice-breaking mini-games in the game lobby. You can also experience different modes of the game with other players in the game room. It's a stress-free world where you can have fun with your friends!\n\nGame Mode:\n-Scruffle Mode: Pick up any item on the ground at will, smash mercilessly at your opponent, and win!\n-Handball Mode: Team up with your teammates to pass, shoot, and score! Smash your opponents and hinder their attacks!\n-Graffiti Mode: Use props with different functions, let your imagination run wild, and turn the surrounding walls into works of art that only belong to you!\n\n", "short_description": "Party Crashers: Balloons is a casual, party-type VR game. Become \"Ba
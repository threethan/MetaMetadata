IQNGmGhEblZgXwONg&oe=6A7079D6"}, {"file_name": "sc3.png", "id": "2333161043843782", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499294603_2333161047177115_8393077959596311913_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=39MpmbYysLMQ7kNvwF8Ts6Y&_nc_oc=AdqCNzOp9PlbZGKN2oHN6a5ddUFaK5dkIbKoB5Lc1CNtaC_HY3yVUWh66d91Fx4Rn7o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFK17QlJbys6KwnMAvuZMKZkECAYzPba2thCc5UXtZZKQ&oe=6A70A4CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DioramaKeepr2560x1440rc.png", "id": "1667487227619365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298248_1667487230952698_2747131339385572270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sIovy7CghFwQ7kNvwG3ACWE&_nc_oc=Ado_D2o5uvuUjqEIUOjvz-evAalflfOEb9fD77Xo-mdAEOeuJqXKBzyYW0q5UW07HmQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9f6awFtPMMnSEOJaBUWLil9k2bd8xqZcoftVc9wnNfQ&oe=6A7084E0"}, "display_name": "Diorama keeper", "keywords": ["miniature", "diorama", "adventure", "shooting", "action"], "long_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature.\nAn Evil Magician has broken free from his own diorama, seeking to spread his corruption and conquer every other miniature world under your watch. As the Keeper, you are the only one able to stop him.\nWhether you're solving environmental puzzles or leading a charge against a siege, your presence is the spark of resistance.", "short_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature. When a corrupting force of dark begins to invade these delicate realms, you must intervene from above. Use your ability to possess the small heroes to defend their homes and preserve the beauty under your watch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zoAUzdjLXGv0CDaxAgMcFPVLC9Ac7loCEJiNGBta6Zw/edit?usp=sharing", "developer_terms_of_s
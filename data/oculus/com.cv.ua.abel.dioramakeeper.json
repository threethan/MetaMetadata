y4zBF5VqADaK7BY3Q&oe=6A6890D6"}, {"file_name": "sc3.png", "id": "2333161043843782", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499294603_2333161047177115_8393077959596311913_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHmD_OTpjiIQ7kNvwEPfAby&_nc_oc=AdpXu0Qn9n66URMBUCvMllZvh9SVkKf41RTjQBTTHFcxA7Ezf9QtKia03W7snclwoxA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9ZY_Awf1Y6Ipc-dRgdeCwzSrxuO5DxHqHX09NR0S2Ww&oe=6A68BBCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DioramaKeepr2560x1440rc.png", "id": "1667487227619365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298248_1667487230952698_2747131339385572270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmOS9YBDWEEQ7kNvwEgUIAK&_nc_oc=Adr061s5BxsQJolVn-37ogS_VS_3tNRkpWivi-Ckzhz7aJKmkah-q6ZalVBfSG3UVrY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdzk2pJiYjqeo_XhngQEyyJicHhfv1OU95kk1PiwoqXw&oe=6A689BE0"}, "display_name": "Diorama keeper", "keywords": ["miniature", "diorama", "adventure", "shooting", "action"], "long_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature.\nAn Evil Magician has broken free from his own diorama, seeking to spread his corruption and conquer every other miniature world under your watch. As the Keeper, you are the only one able to stop him.\nWhether you're solving environmental puzzles or leading a charge against a siege, your presence is the spark of resistance.", "short_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature. When a corrupting force of dark begins to invade these delicate realms, you must intervene from above. Use your ability to possess the small heroes to defend their homes and preserve the beauty under your watch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zoAUzdjLXGv0CDaxAgMcFPVLC9Ac7loCEJiNGBta6Zw/edit?usp=sharing", "developer_terms_of_s
oLxvCGlrQSDm9lkfw&oe=6A453096"}, {"file_name": "sc3.png", "id": "2333161043843782", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499294603_2333161047177115_8393077959596311913_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rrRw_SSbNc4Q7kNvwGlKK_-&_nc_oc=AdqMowStfobKakCuYWeFZrxmow8O9tlLknAkvetmsP5w0yW3_0S7H9GFJEyO_Mvrc0k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9X5UNEwcZM8LJY52XrJlZgKECeh4Z2Rz_24c2X2arKCg&oe=6A45234F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DioramaKeepr2560x1440rc.png", "id": "1667487227619365", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298248_1667487230952698_2747131339385572270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PduuKvAox9cQ7kNvwGu2UOY&_nc_oc=AdpXqimnXmH0Y9aBuXOgX_55LZqMPu3iv_xrQnG8b4kiRuOAlmKs7gIHpUkQcDpFreE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U_kXtD_3q8IWipQ2wZWDkfpau99CI9_upvl7SKD9RcA&oe=6A450360"}, "display_name": "Diorama keeper", "keywords": ["miniature", "diorama", "adventure", "shooting", "action"], "long_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature.\nAn Evil Magician has broken free from his own diorama, seeking to spread his corruption and conquer every other miniature world under your watch. As the Keeper, you are the only one able to stop him.\nWhether you're solving environmental puzzles or leading a charge against a siege, your presence is the spark of resistance.", "short_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature. When a corrupting force of dark begins to invade these delicate realms, you must intervene from above. Use your ability to possess the small heroes to defend their homes and preserve the beauty under your watch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zoAUzdjLXGv0CDaxAgMcFPVLC9Ac7loCEJiNGBta6Zw/edit?usp=sharing", "developer_terms_of_s
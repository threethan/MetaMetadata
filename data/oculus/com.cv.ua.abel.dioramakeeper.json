20f&oh=00_AQIrT3oVdCXbCzGYG8NJQaN1rzN_sKvnNrNx0nsJ86ymYA&oe=6AA2BDCF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DioramaKeepr2560x1440rc.png", "id": "1667487227619365", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499298248_1667487230952698_2747131339385572270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VXpexGoJREEQ7kNvwGi_CYc&_nc_oc=AdpaaqZn3sI4lxXFi2M8wXAHZypUIzH8w9kp6ed2bwMfIT_PfInLUKLsYWU1_qdf-4o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6-8hgqTS1TEEkRKXsc_ELWtzpw6hJDxzfZHr8wo_nBw&oe=6AA29DE0"}, "display_name": "Diorama keeper", "keywords": ["miniature", "diorama", "adventure", "shooting", "action"], "long_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature.\nAn Evil Magician has broken free from his own diorama, seeking to spread his corruption and conquer every other miniature world under your watch. As the Keeper, you are the only one able to stop him.\nWhether you're solving environmental puzzles or leading a charge against a siege, your presence is the spark of resistance.", "short_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature. When a corrupting force of dark begins to invade these delicate realms, you must intervene from above. Use your ability to possess the small heroes to defend their homes and preserve the beauty under your watch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zoAUzdjLXGv0CDaxAgMcFPVLC9Ac7loCEJiNGBta6Zw/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "FOP Oleksii Belaventsev", "support_website_url": null, "website_url": "https://www.facebook.com/DioramaKeeperVR", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "269
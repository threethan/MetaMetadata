Z4U2wC2HdTOMQj30A&oe=6A510E16"}, {"file_name": "sc3.png", "id": "2333161043843782", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499294603_2333161047177115_8393077959596311913_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCDUb1gq28YQ7kNvwHbzsV5&_nc_oc=AdpSz-q3ESQheN1ku7jfJ7WbPkq2f3hxVtLXFuya6IeRzdLoemUnC3m3RwABUePiKMw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAashUNW7T-joOx-8HIhFRNQ4tTx6XYMKpnEzWVuNprFQ&oe=6A5100CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DioramaKeepr2560x1440rc.png", "id": "1667487227619365", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499298248_1667487230952698_2747131339385572270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKorZDIKpjgQ7kNvwFUkon-&_nc_oc=AdoOQrAU-Qq8A8dwYlMd4x9sp_UohNOc_IfFKy18_kK961DfQ72TCC21YTfUe_RWQ9I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCldZMcNLmC-A0cWQ2bdt1jO65oY4kUCrottboWfqs-9g&oe=6A511920"}, "display_name": "Diorama keeper", "keywords": ["miniature", "diorama", "adventure", "shooting", "action"], "long_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature.\nAn Evil Magician has broken free from his own diorama, seeking to spread his corruption and conquer every other miniature world under your watch. As the Keeper, you are the only one able to stop him.\nWhether you're solving environmental puzzles or leading a charge against a siege, your presence is the spark of resistance.", "short_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature. When a corrupting force of dark begins to invade these delicate realms, you must intervene from above. Use your ability to possess the small heroes to defend their homes and preserve the beauty under your watch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zoAUzdjLXGv0CDaxAgMcFPVLC9Ac7loCEJiNGBta6Zw/edit?usp=sharing", "developer_terms_of_s
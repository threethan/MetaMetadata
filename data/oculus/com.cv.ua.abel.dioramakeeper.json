ulCy1eZWtuftjIDwg&oe=6A58F716"}, {"file_name": "sc3.png", "id": "2333161043843782", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499294603_2333161047177115_8393077959596311913_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UYp3cf_a1LMQ7kNvwHDOEcy&_nc_oc=AdpR2QVMplFIWx_MMIZMiLQEFv8csoMCck5yc1GOUfvP10REfAFx5OoYLtp06NaIKSs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5le05ln7_v8uGFQCuGRVYArMA6OlPIXDwhxrmxnA-DA&oe=6A58E9CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DioramaKeepr2560x1440rc.png", "id": "1667487227619365", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/499298248_1667487230952698_2747131339385572270_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rmewi6LDUeYQ7kNvwF4mhgk&_nc_oc=Ado74NjmZP0XhHRFT2_Qe-QtBqWTX4Cst9Uw2JYTSpgj6pNLrmYzimv1OY7yudeMiJY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAERGD6j7vLoHXxZIRuWQqeDVM4G5BjDIabFa2R1HkFvA&oe=6A58C9E0"}, "display_name": "Diorama keeper", "keywords": ["miniature", "diorama", "adventure", "shooting", "action"], "long_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature.\nAn Evil Magician has broken free from his own diorama, seeking to spread his corruption and conquer every other miniature world under your watch. As the Keeper, you are the only one able to stop him.\nWhether you're solving environmental puzzles or leading a charge against a siege, your presence is the spark of resistance.", "short_description": "Step into the role of the Diorama Keeper, the guardian of worlds-in-miniature. When a corrupting force of dark begins to invade these delicate realms, you must intervene from above. Use your ability to possess the small heroes to defend their homes and preserve the beauty under your watch."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1zoAUzdjLXGv0CDaxAgMcFPVLC9Ac7loCEJiNGBta6Zw/edit?usp=sharing", "developer_terms_of_s
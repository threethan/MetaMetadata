0_Af0PGhzA7vcax6v-dmKcsk_wmr78Gl91ZQDlBbDVB0i-EA&oe=69EF51CF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Ekran g\u00f6r\u00fcnt\u00fcs\u00fc 2025-01-06 004040.png", "id": "1302188447489062", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974439_1302188450822395_4241106787978786533_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3Cvj7lwjt8Q7kNvwGbv-KK&_nc_oc=AdpezIU6fDUcZFjtJZntw-IQKjsj1g9Y-D6O2_EgXDDqA0lg-EgyyNdzc-A3Ibgnd2Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2irzEH8CIuIkw1EHTRFXLCIQ4fUuFn1CnmKqeLMLvwiw&oe=69EF6428"}, "display_name": "Super Bounce", "keywords": ["Comfort", "Casual", "Elite", "Ball", "Satisfy"], "long_description": "Embark on an electrifying VR journey with Super Bounce, the ultimate action-puzzle experience crafted for Meta Quest. Set against a backdrop of vivid cosmic landscapes, this game combines fast-paced reflex challenges with strategic gameplay. Navigate through a series of dynamic levels, each filled with unique obstacles, glowing trails, and gravity-defying mechanics.\n\nSuper Bounce takes full advantage of VR capabilities, delivering stunning visuals, responsive physics, and an immersive soundscape. Players must harness their agility and problem-solving skills to outmaneuver challenges, unlock secrets, and achieve the highest scores. The polished design and smooth gameplay mechanics create a seamless and engaging adventure for players of all skill levels.\n\nWhether you're chasing record-breaking scores or exploring the intricacies of each level, Super Bounce guarantees hours of heart-pounding excitement. Perfect for VR enthusiasts and newcomers alike, this game is your next favorite Meta Quest experience. Test your skills, embrace the challenge, and bounce into the action!", "short_description": "Dive into the dynamic world of Super Bounce, an adrenaline-filled VR adventure designed for Meta Quest. Experience the thrill of navigating through vibrant cosmic environments, bouncing your way through intricate challenges. Utilize fast reflexes, creative strategies, and precise movements to master each level. With stunning visuals, realistic physics, and immersive gameplay, Super Bounce delivers endless excitement. Challenge your skills, achieve high scores, and become the ultimate bouncing ch"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1nRyME7ipZKdK4JPdh6Aza7RPKWnEWmNI/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.bilgiplatformu.net/post/super-bounce", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1023770785722696"}, {"id": "3744040075834813"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9168494889884860"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PUBLISHED", "id": "2059642104814377"}, {"status": "PUBLISHED", "id": "820587024060671"}, {"status": "PUBLISHED", "id": "736476698827434"}, {"status": "PUBLISHED", "id": "630492386476971"}, {"status": "PUBLISHED", "id": "1605574470131784"}, {"status": "PUBLISHED", "id": "635419685652503"}, {"status": "PUBLISHED", "id": "1610448787019583"}]}, "baseline_offer": {"id": "1605574470131784"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1771358400, "status": "PUBLISHED", "id": "2059642104814377"}]}, "liveChannel": {"nodes": [{
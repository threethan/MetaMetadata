D53"}, "display_name": "Robbot Taggers", "keywords": ["Tag", "Gorilla", "RobbotTaggers", "fangame", "Fun"], "long_description": "Robbot Taggers is a brand new hand locomotion game! A robbot is a legendary type of monkey! This game has a place to practice skills and talk with friends, two working computers that allow you to change your name and join codes, and also a unfinished only up! The game currently has a few maps, including forest, only up, and zero grav. The game also has a nicely made player model and color code system.This game is finished! This game is going to be updated a lot! Expect a lot of new maps, gameplay, and more! Hope you enjoy Robbot Taggers!", "short_description": "Robbot Taggers is a fun game to play with friends and other people!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/robbottaggersvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "OfficialAmericanDude", "support_website_url": null, "website_url": "https://sites.google.com/view/robbottaggersvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1627895905502033"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1006804872442218"}]}, "baseline_offer": {"id": "1006804872442218"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791674280, "sta
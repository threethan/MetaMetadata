Kkp_PAXDRM7fZs5g_hrB_hA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLx0RvrnOtXsn2bLrbt3Wgi0LvFwRCrhg7WZBsubL_vLQ&oe=6AB5218C"}, {"file_name": "migrated_image.png", "id": "204847957499066", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/11162699_1937600323136154_2625204291874324480_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E53o7kU9T0QQ7kNvwGsicGK&_nc_oc=Adqqe5WhQcDvQ-VAdREVI9oCW5y9Ci3X-Lwkx-v2cbjl7DvgWTC8SI54rW3_4r6aEec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ118wRxGWkMv8DVQMkCwV_dSOerVo5QXInLhPdUY0hBQ&oe=6AB54938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RushGo_trailer_thumbnail.png", "id": "2072563853016576", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12448961_2072563856349909_5507482725969297408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqtMJ4j2r-4Q7kNvwHo-D5e&_nc_oc=Ado02uso5j4qXbXoNKiDGCV6pyx77p9gpeLx-Lv4tJMWXRFMz6H7t6QE60RSn3qNz5Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWhyaZmkCYFcNejBKfB_2hDUMgFHxv5nhiUkaWYsyeLg&oe=6AB53B17"}, "display_name": "RUSH", "keywords": ["skydiving", "wingsuit", "race", "thrill", "multiplayer"], "long_description": "Take a dive into the adrenaline-pumping world of wingsuit flying with RUSH. Soar down mountainsides at breakneck speeds. Weave through canyons, dodge outcrops, and plummet down sheer drops as you race towards the finish line.\n\nDo you have what it takes to walk a tightrope at near terminal velocity?\n\nFEATURES\n- Stunning environments: Soar down four breathtaking mountainsides\n- Challenging races: 80 unique mountain paths to master, from basic downhill trails to expert-level suicide runs through the narrowest of spaces.\n- Multiple game modes: Race to the finish, Time Attack, and Score Challenge, each requiring a different set of skills and strategies to succeed.\n- Epic multiplayer jumps: Challenge up to 3 of your friends online via Oculus home parties, or quick race against random jumpers.\n\nStrap on your headset and hold on tight; you're in for a RUSH!", "short_description": "Are you ready for the ultimate thrill ride?\n\nTake a dive into the adrenaline-pumping world of wingsuit flying with RUSH! Soar down mountainsides at breakneck speeds. Weave through canyons, dodge outcrops, and plummet down sheer drops as you race towards the finish line.\n\nDo you have what it takes to walk a tightrope at near terminal velocity?\n\nStrap on your headset and hold on tight; you're in for a RUSH!"}]}, "developer_name": "The Binary Mill", "developer_privacy_policy_url": "http://www.thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://www.thebinarymill.com/terms.php", "publisher_name": "The Binary Mill", "support_website_url": null, "website_url": "http://www.thebinarymill.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EXPLORATION", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "508586240693256"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410200_1897789310254530_6549303833334382592_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WtNKBbkaXHIQ7kNvwFcahfc&_nc_oc=Ado7_MQArNk5CwVmSYGpEq7HbIy-S7KiPSA8vsukQgaoab2UjYoYOg6gmzfQJ6MlqQQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI29_jRwJoBGFiEN-l_rhIrXWj8suF6LGlJ05tE8VJ_fQ&oe=6AB53B04"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false
F50C"}, {"file_name": "migrated_image.png", "id": "204847957499066", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162699_1937600323136154_2625204291874324480_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-N9ndo7zpcQ7kNvwFjFcvQ&_nc_oc=Admx88NGYB3VUwCF9XYq_rkDkKhF-DRqWHY3oml--a9yt-dEBAsQaEaaOF-VkFuc878&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsiaJ5UwDkec8atWXi1GBazbbpo5_mY8IREentPiWPPag&oe=699EE478"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "RushGo_trailer_thumbnail.png", "id": "2072563853016576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12448961_2072563856349909_5507482725969297408_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lvSe8O4HGckQ7kNvwE0IPrX&_nc_oc=AdnjVKwBddMngXqLP56ZIXIXszKMkQcofm1TXyy3A3ywcpTxMbXNhwf6GosAMG7M_h4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfswkRlCVq9nKMkY_Mft6xtROskMGa5132WjPMKmk5BGxw&oe=699ED657"}, "display_name": "RUSH", "keywords": ["skydiving", "wingsuit", "race", "thrill", "multiplayer"], "long_description": "Take a dive into the adrenaline-pumping world of wingsuit flying with RUSH. Soar down mountainsides at breakneck speeds. Weave through canyons, dodge outcrops, and plummet down sheer drops as you race towards the finish line.\n\nDo you have what it takes to walk a tightrope at near terminal velocity?\n\nFEATURES\n- Stunning environments: Soar down four breathtaking mountainsides\n- Challenging races: 80 unique mountain paths to master, from basic downhill trails to expert-level suicide runs through the narrowest of spaces.\n- Multiple game modes: Race to the finish, Time Attack, and Score Challenge, each requiring a different set of skills and strategies to succeed.\n- Epic multiplayer jumps: Challenge up to 3 of your friends online via Oculus home parties, or quick race against random jumpers.\n\nStrap on your headset and hold on tight; you're in for a RUSH!", "short_description": "Are you ready for the ultimate thrill ride?\n\nTake a dive into the adrenaline-pumping world of wingsuit flying with RUSH! Soar down mountainsides at breakneck speeds. Weave through canyons, dodge outcrops, and plummet down sheer drops as you race towards the finish line.\n\nDo you have what it takes to walk a tightrope at near terminal velocity?\n\nStrap on your headset and hold on tight; you're in for a RUSH!"}]}, "developer_name": "The Binary Mill", "developer_privacy_policy_url": "http://www.thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://www.thebinarymill.com/terms.php", "publisher_name": "The Binary Mill", "support_website_url": null, "website_url": "http://www.thebinarymill.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EXPLORATION", "RACING", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "CO_OP"], "id": "508586240693256"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410200_1897789310254530_6549303833334382592_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SuRZQqghx-8Q7kNvwFOxMn9&_nc_oc=AdnktrQT7gNTVqe1RKGCGcSCDT695-K6Bfa2CMVWlSqf20wIuI_4GtQd0zpJukkQz68&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuLE9IAvfj4aPWMGri4m_6bxu7hYr50vx27R3FU-lJZ7Q&oe=699ED644"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "RUSH", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1495668048, "lastRevision": {"nodes": [{"id": "1320538841335516", "re
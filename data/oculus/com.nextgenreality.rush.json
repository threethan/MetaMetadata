kNvwEs-xld&_nc_oc=AdoJrf_Ye4mkiBVegqTKtd_rbgGKoy6G08cSn9dw4b_yodYfxZQxkQBx3P5HUkGCzus&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFxRNuFghTqP-l_G2sAuF27p6Zm-Q7HTPPUMZeicSj6Ew&oe=6A85AB8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rush_Screenshot_03.png", "id": "801754446646302", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/11162707_801754449979635_5812943926797008896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9vviOSBlUTsQ7kNvwHQeztN&_nc_oc=AdofhSlClzLYcFW4Y0XhGg2L9ySFDzi6Hah_Bgq-_Wv3YzCA80EAdsYwSYuWYOn2Xek&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfNlLr4osQ8mIALnrtFQhkOu5oLt322nc2wKm6yrTC6A&oe=6A859AF4"}, "display_name": "RUSH", "keywords": ["skydiving", "wingsuit", "race", "thrill", "multiplayer"], "long_description": "Take a dive into the adrenaline-pumping world of wingsuit flying with Rush. The intense VR action will have you on the edge of your seat as you soar down mountainsides at breakneck speeds. Weave through canyons, dodge outcrops, and plummeting down sheer drops as you race towards the finish line.\n\nDo you have what it takes to walk a tightrope at near terminal velocity?\nStrap on your gearVR and hold on tight; you're in for a Rush\n\nFEATURES\nStunning environments: Soar down three beautifully rendered VR mountains\nChallenging races: Over 60 unique mountain paths to master, from basic downhill trails to expert-level suicide runs through the narrowest of spaces.\nMultiple game modes: Race to the finish, Time Attack, and Score Challenge, each requiring a different set of skills and strategies to succeed.\nMultiplayer modes: challenge up to 3 of your friends to online vis Oculus home parties, or quick race against random jumpers.", "short_description": "Are you ready for the ultimate thrill ride?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://www.thebinarym
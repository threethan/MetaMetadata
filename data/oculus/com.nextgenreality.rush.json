tPYBzt_B0IBn57fLcMqD35jBBK5IFjdWTEhqbQMIrt0pRzMR_c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5GG9JgenF4K5i0cBTbcg9ojvzyVQz2wJPbfYwjmNvXQ&oe=6A89A00C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rush_Screenshot_03.png", "id": "801754446646302", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162707_801754449979635_5812943926797008896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMfiV97Ylg0Q7kNvwGdpPBw&_nc_oc=AdqMd8HVEk6xAPHAALngkB3BKwfpsFB9bfY0FdUPqcK-SpDcGAS-Elkvpx3_kO6lTfw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlP9d1Ab7mDNC2MTkga5kH_k9uzBJck6ASoiKrgJOw-w&oe=6A898F74"}, "display_name": "RUSH", "keywords": ["skydiving", "wingsuit", "race", "thrill", "multiplayer"], "long_description": "Take a dive into the adrenaline-pumping world of wingsuit flying with Rush. The intense VR action will have you on the edge of your seat as you soar down mountainsides at breakneck speeds. Weave through canyons, dodge outcrops, and plummeting down sheer drops as you race towards the finish line.\n\nDo you have what it takes to walk a tightrope at near terminal velocity?\nStrap on your gearVR and hold on tight; you're in for a Rush\n\nFEATURES\nStunning environments: Soar down three beautifully rendered VR mountains\nChallenging races: Over 60 unique mountain paths to master, from basic downhill trails to expert-level suicide runs through the narrowest of spaces.\nMultiple game modes: Race to the finish, Time Attack, and Score Challenge, each requiring a different set of skills and strategies to succeed.\nMultiplayer modes: challenge up to 3 of your friends to online vis Oculus home parties, or quick race against random jumpers.", "short_description": "Are you ready for the ultimate thrill ride?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://www.thebinarymill.com/terms.php", "publisher_name"
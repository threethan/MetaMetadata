wZnphbLDtHNvhFY0iteRrZyejI_s9XoTRzE5C4UDVyk5pLp-QY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r61yj3SZnTnkt0AOPU4B3oSGraI1vSFP-ItAKPsKZBQ&oe=69D25F8C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rush_Screenshot_03.png", "id": "801754446646302", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/11162707_801754449979635_5812943926797008896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naGrqIgTPs0Q7kNvwG5bUFu&_nc_oc=AdqcvimnSpcJNQ47ajnHHyK1kPgnOuzC56ZbTkzHwM0NvKoGrOB0SkjxZkHwOiekDKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1aDT0H8qdVvMsBV35E92yivCWTbvMzGhPlbIuUsLqb-w&oe=69D24EF4"}, "display_name": "RUSH", "keywords": ["skydiving", "wingsuit", "race", "thrill", "multiplayer"], "long_description": "Take a dive into the adrenaline-pumping world of wingsuit flying with Rush. The intense VR action will have you on the edge of your seat as you soar down mountainsides at breakneck speeds. Weave through canyons, dodge outcrops, and plummeting down sheer drops as you race towards the finish line.\n\nDo you have what it takes to walk a tightrope at near terminal velocity?\nStrap on your gearVR and hold on tight; you're in for a Rush\n\nFEATURES\nStunning environments: Soar down three beautifully rendered VR mountains\nChallenging races: Over 60 unique mountain paths to master, from basic downhill trails to expert-level suicide runs through the narrowest of spaces.\nMultiple game modes: Race to the finish, Time Attack, and Score Challenge, each requiring a different set of skills and strategies to succeed.\nMultiplayer modes: challenge up to 3 of your friends to online vis Oculus home parties, or quick race against random jumpers.", "short_description": "Are you ready for the ultimate thrill ride?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://www.thebinarymill.com/terms.php", "publisher_name"
tDr7EZx5sCat1vNzl81mYKVKdVraN4cazK5s_uJsSNSmgFSBOI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42CewcJ0ozI4dF_wrg4fTh7g6ubr5dFunwEX8uyYn-XQ&oe=6A12F90C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Rush_Screenshot_03.png", "id": "801754446646302", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/11162707_801754449979635_5812943926797008896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3CxruwbdaAQ7kNvwGEumEp&_nc_oc=AdpZaUvg8W2TK0bpPtgr7VMD9ZvUslgKU-x-wVadA2yY6QjV1_kjf9RQ6XSYpNIlL3k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pdI-vK78GfQOsxlqnnM128ETnNvMDsou4-7HXpaVg0A&oe=6A1320B4"}, "display_name": "RUSH", "keywords": ["skydiving", "wingsuit", "race", "thrill", "multiplayer"], "long_description": "Take a dive into the adrenaline-pumping world of wingsuit flying with Rush. The intense VR action will have you on the edge of your seat as you soar down mountainsides at breakneck speeds. Weave through canyons, dodge outcrops, and plummeting down sheer drops as you race towards the finish line.\n\nDo you have what it takes to walk a tightrope at near terminal velocity?\nStrap on your gearVR and hold on tight; you're in for a Rush\n\nFEATURES\nStunning environments: Soar down three beautifully rendered VR mountains\nChallenging races: Over 60 unique mountain paths to master, from basic downhill trails to expert-level suicide runs through the narrowest of spaces.\nMultiple game modes: Race to the finish, Time Attack, and Score Challenge, each requiring a different set of skills and strategies to succeed.\nMultiplayer modes: challenge up to 3 of your friends to online vis Oculus home parties, or quick race against random jumpers.", "short_description": "Are you ready for the ultimate thrill ride?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://www.thebinarymill.com/terms.php", "publisher_name"
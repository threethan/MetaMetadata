m/v/t64.5771-25/11162707_801754449979635_5812943926797008896_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xTIPvQv_3aQQ7kNvwF1jgPx&_nc_oc=AdnV9-XQVcJ94FsPwjOUFYMIEloqY6TRkXoGIqEvdAttNZq_i0vojihOIp8-DAS50A0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvkrdxrLPCRARPOly_9gzkK708yvpmac3KtG9NtlAkS_Q&oe=699EE474"}, "display_name": "RUSH", "keywords": ["skydiving", "wingsuit", "race", "thrill", "multiplayer"], "long_description": "Take a dive into the adrenaline-pumping world of wingsuit flying with Rush. The intense VR action will have you on the edge of your seat as you soar down mountainsides at breakneck speeds. Weave through canyons, dodge outcrops, and plummeting down sheer drops as you race towards the finish line.\n\nDo you have what it takes to walk a tightrope at near terminal velocity?\nStrap on your gearVR and hold on tight; you're in for a Rush\n\nFEATURES\nStunning environments: Soar down three beautifully rendered VR mountains\nChallenging races: Over 60 unique mountain paths to master, from basic downhill trails to expert-level suicide runs through the narrowest of spaces.\nMultiple game modes: Race to the finish, Time Attack, and Score Challenge, each requiring a different set of skills and strategies to succeed.\nMultiplayer modes: challenge up to 3 of your friends to online vis Oculus home parties, or quick race against random jumpers.", "short_description": "Are you ready for the ultimate thrill ride?\n"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.thebinarymill.com/privacy.php", "developer_terms_of_service_url": "http://www.thebinarymill.com/terms.php", "publisher_name": "The Binary Mill", "support_website_url": null, "website_url": "http://www.thebinarymill.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ADVENTURE", "EXPLORATION", "RACING", "SIMULATION"], "has_in_app_
-1.oculuscdn.com&_nc_ss=8&oh=00_AfwXYoIW_dKVOfrdaU7OObu_Wfwv6YwLKO-xFTFKiq98Zw&oe=69AAC641"}, {"file_name": "ss.png", "id": "667751416014662", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491818938_667751419347995_7097180411950527092_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-h1ZkOr4tUQ7kNvwGb2hqc&_nc_oc=AdkVD68tuT0FqM15mvg2O1muKhQPFS9_cCoOtRKGOFyr_u-_ktH122z5jis-eGVtHqs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw6deMZ2GQfGKqIgsjRhFxqOj1nzmjk97uICs7HrbGOYw&oe=69AAD1D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treehouse Jumpers", "keywords": ["Treehouse", "Jumpers", "Walk", "Hands"], "long_description": "Treehouse Jumpers is a wild, whimsical game where you don't walk\u2014you handstand. In this topsy-turvy world, the ground is just a suggestion and your palms are your feet. Players navigate a surreal treetop village by walking on their hands, leaping between swaying platforms, balancing across ropes, and vaulting from branch to branch in gravity-defying acrobatics. Every treehouse is a checkpoint, every gap a daring stunt, and every fall a hilarious, floppy descent to the leafy floor below. Movement is entirely physics-based, turning each gesture into a challenge of coordination, strength, and chaotic fun. Whether you\u2019re racing friends, exploring secret paths, or just flinging yourself from a high branch for the thrill of it, Treehouse Jumpers is all about mastering the art of upside-down parkour.\n\n", "short_description": "Hello. treehouse jumpers is a game. and im a sandwich... wait, what? sorry. um, Treehouse Jumpers is a wild, whimsical game where you don't walk\u2014you handstand. In this topsy-turvy world, the ground is just a suggestion and your palms are your feet. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/treehousejumpers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DJCullpanda", "support_webs
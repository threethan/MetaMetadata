s.png", "id": "2543150646025079", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820382_2543150649358412_7402341987435837451_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mi81_-o87QAQ7kNvwG4hbuJ&_nc_oc=Adqb649OQcs8cHNIDoaZMFDSdq5hU4g-jzjZRpro2tzzjIp5Mn3OwmRaSADmEqgDtpM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2fA80MuJv3__d2dRQSWxSFixCLpEmyhSTqN87YNR6Gg&oe=6B070A81"}, {"file_name": "ss.png", "id": "667751416014662", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491818938_667751419347995_7097180411950527092_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zXd8243uliIQ7kNvwF8Pln8&_nc_oc=AdoJ3b5jgbq0q3067bJnmzjM5u9X5aeliQa41982aRlYXlK-62xUWxpxQCgiDGzEqn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6aCDSPVZSGF19n7Fl8N-daZUqOs2wg6lOKNnM2EHsVA&oe=6B071615"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treehouse Jumpers", "keywords": ["Treehouse", "Jumpers", "Walk", "Hands"], "long_description": "Treehouse Jumpers is a wild, whimsical game where you don't walk\u2014you handstand. In this topsy-turvy world, the ground is just a suggestion and your palms are your feet. Players navigate a surreal treetop village by walking on their hands, leaping between swaying platforms, balancing across ropes, and vaulting from branch to branch in gravity-defying acrobatics. Every treehouse is a checkpoint, every gap a daring stunt, and every fall a hilarious, floppy descent to the leafy floor below. Movement is entirely physics-based, turning each gesture into a challenge of coordination, strength, and chaotic fun. Whether you\u2019re racing friends, exploring secret paths, or just flinging yourself from a high branch for the thrill of it, Treehouse Jumpers is all about mastering the art of upside-down parkour.\n\n", "short_description": "Hello. treehouse jumpers is a game. and im a sandwich... wait, what? sorry. um, Treehouse Jumpers is a wild, whimsical game where you don't walk\u2014you handstand. In this topsy-turvy world, the ground is just a suggestion and your palms are your feet. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/treehousejumpers/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "DJCullpanda", "support_website_url": null, "website_url": "https://sites.google.com/view/treehousejumpers/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9733159053440715"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "732107175810914"}]}, "baseline_offer": {"id": "732107175810914"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1746558000, "status": "PUBLISHED", "id": "732107175810914"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10094847837271833", "version": "THJNewGenyay"}, "id": "1373978007134470", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9703799649709989", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "10094847837271833"}, "release_status": "RELEASED"}, "binary_r
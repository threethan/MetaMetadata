xo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0A3SryNzDiooRp4pAsjwZsuXmAqxeUfUtQ-6m7O-yGA&oe=6AA14EC1"}, {"file_name": "ss.png", "id": "667751416014662", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491818938_667751419347995_7097180411950527092_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5FJpaBYhxp8Q7kNvwHX2Wbz&_nc_oc=AdpIEpQB9fatRsViz3IPOw9TWkLOTeDVQyAAzNzCH8LY2QdoXgKPbFrfTu58lGGoYy8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9hP0VYDlsXtws3dAP7hHV1tcLXqmt5eBleIDiIiX9vw&oe=6AA15A55"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Treehouse Jumpers", "keywords": ["Treehouse", "Jumpers", "Walk", "Hands"], "long_description": "Treehouse Jumpers is a wild, whimsical game where you don't walk\u2014you handstand. In this topsy-turvy world, the ground is just a suggestion and your palms are your feet. Players navigate a surreal treetop village by walking on their hands, leaping between swaying platforms, balancing across ropes, and vaulting from branch to branch in gravity-defying acrobatics. Every treehouse is a checkpoint, every gap a daring stunt, and every fall a hilarious, floppy descent to the leafy floor below. Movement is entirely physics-based, turning each gesture into a challenge of coordination, strength, and chaotic fun. Whether you\u2019re racing friends, exploring secret paths, or just flinging yourself from a high branch for the thrill of it, Treehouse Jumpers is all about mastering the art of upside-down parkour.\n\n", "short_description": "Hello. treehouse jumpers is a game. and im a sandwich... wait, what? sorry. um, Treehouse Jumpers is a wild, whimsical game where you don't walk\u2014you handstand. In this topsy-turvy world, the ground is just a suggestion and your palms are your feet. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/treehousejumpers/privacy-policy", "developer_terms_of_service_url": null, "publi
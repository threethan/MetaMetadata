MvIYLsWX3mqOg-Mgs49LGc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxhLDVwD-1LW1KvqXUYlWsiZQZ0-0zyJ_v8lGbirZKgyQ&oe=69BFF0FB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/bhFV0w", "id": "2094325244198480", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39001676_2094325247531813_2271249431351263232_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-rp44DcCYIQ7kNvwFSah6z&_nc_oc=AdnHtdYEkavlmCRKwf18lR8GE_dWKhAW1jPXcDC6l_u89_7LqQufy-r10YMrZ67SISk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzgJXgH2ggpuZaXiCU8WQ5mAmqWNl5l3uPkpYlDjcHnCA&oe=69BFF88D"}, "display_name": "Void Racer", "keywords": ["race", "racing", "speed", "bikes", "motorbikes"], "long_description": "The thrill of racing at its most intense! Not for the faint-hearted!\n\nRev up your hover bike and fight AI opponents for the sharpest lines and the quickest times.\n\nTest your racing skills to the limit; this exhilarating gaming experience delivers pure unadulterated speed.\n\nFeatures:\n- 8 tracks to master, from the smooth and fast to the twisted and devious\n- 3 bikes with unique handling characteristics\n- 8 bonus items to wield\n- 3 game modes to beat\n- 4 weapons to punish your opponents\n- Learn and unlock new stages in career mode\n- Compete against your friends on the leaderboards to get the fastest lap times\n- Prove yourself in the weekly leaderboard challenge\n\nFollow @CoplanarGames to get news about new tracks and features coming soon!", "short_description": "The thrill of racing at its most intense! Not for the faint-hearted!\n\nTest your racing skills to the limit; this exhilarating gaming experience delivers pure unadulterated speed.\n\n8 tracks, from the smooth and fast to the twisted and devious\n3 bikes to master\n8 bonus items to wield\n3 game modes to beat\n4 weapons to punish with\nUnlock new stages in career mode\nBeat friends on the leaderboards to get the fastest laps\nProve yourself in the weekly leaderboard challenge"}]}, "developer_name": "Coplanar Games", "developer_privacy_policy_url": "http://coplanargames.com/voidracer/privacypolicy.html", "developer_terms_of_service_url": "http://coplanargames.com/voidracer/tos.html", "publisher_name": "Coplanar Games", "support_website_url": null, "website_url": "http://coplanargames.com/voidracer.html", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["RACING"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1106334610204940"}}]}, "scheduled_offers": {"count": 15, "nodes": [{"status": "PUBLISHED", "id": "1199197947121299"}, {"status": "PUBLISHED", "id": "603949656682365"}, {"status": "PUBLISHED", "id": "371591806761147"}, {"status": "PUBLISHED", "id": "257439478491147"}, {"status": "PUBLISHED", "id": "1833470206756488"}, {"status": "PUBLISHED", "id": "282963989083633"}, {"status": "PUBLISHED", "id": "385747975414812"}, {"status": "PUBLISHED", "id": "649228439141334"}, {"status": "PUBLISHED", "id": "2637192599885148"}, {"status": "PUBLISHED", "id": "2081204908568862"}, {"status": "PUBLISHED", "id": "557978171279011"}, {"status": "PUBLISHED", "id": "444847162878589"}, {"status": "PUBLISHED", "id": "193604902044753"}, {"status": "PUBLISHED", "id": "734569287380481"}, {"status": "PUBLISHED", "id": "528402397855642"}]}, "baseline_offer": {"id": "282963989083633"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1597078800, "status": "PUBLISHED", "id": "1199197947121299"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBin
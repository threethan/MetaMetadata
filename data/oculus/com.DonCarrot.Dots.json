&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Nu5TJr4UG2-sQ0jNcm8cjMO-GjN-Lrk1OOj4YFyCCOQ&oe=6A19B4C8"}, {"file_name": "Screenshot 2056.png", "id": "1870758416916189", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823270_1870758420249522_8819076078923022250_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v5MSo0-eVuEQ7kNvwG36vgz&_nc_oc=AdpFAazguzCDU7pN9E9rayoeuS7g-L8n2_OagZg-qC69xbBjhnJezPebjTVF1bGiLWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af685zbnOuVf79bu3hqCMaT17vdYnFcENzDX8lGxQXs6jw&oe=6A19AFE5"}, {"file_name": "Screenshot 2059.png", "id": "1553658752408265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_1553658755741598_7888159509988888044_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQ0k5sZKCRkQ7kNvwF8T6Lh&_nc_oc=Adqs2cB5lhchPiljaGmEANUkYwSgKq-ekfE4VTeLhBEktIhDWcBcZLYZ6OxL6pZyW70&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fLgJAarOwgZ4Rn5T6M_zQaqCSL0x4d_MXkKILTO2C_g&oe=6A19950E"}, {"file_name": "Screenshot 2055.png", "id": "1615099709616422", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823901_1615099712949755_391587709563556574_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlMJxTd1Ts0Q7kNvwHaAIAh&_nc_oc=AdqxBMonzq4i2bDu-LB7G3ChFDYJi69b35v8wuG85yJjvj_e4UAqRoLRGxLkHYfdKcY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xkYxUFRqZmhSHNrTXMX_c5iFITI19_XRsnJzafjPoGg&oe=6A19AEF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Demo_Cover Landscape.png", "id": "1498807665068531", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619588_1498807668401864_214871716270309590_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YvmAzW7qdRUQ7kNvwFz163P&_nc_oc=AdqUnPJYOTcVB0x9AtazUoO0KS7utXuUArzYl1Yz8-JulLMzhkdpbRPDf-Sqb47ALP4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DahjIH93u24kbHTe-XtPyA6wTpMaRHEmtMVflFr8LhA&oe=6A19ACCE"}, "display_name": "Dots Demo", "keywords": ["puzzle", "dots", "relaxing", "hands", "metaball"], "long_description": "Connect. Flow. Master the Grid.\n\nConnect every matching dot in 3D using the fewest grabs possible.\n\nDots is a relaxing, skill-based spatial puzzle for Mixed Reality and immersive VR. Your goal is simple: connect matching colors until every dot is linked to at least one dot of the same color.\n\nGrab a dot and move through neighboring dots of the same color to build a chain. The longer you continue without releasing, the better your run. Fewer grabs. Longer chains. Smarter routes.\n\n---\n\nHow You Play\n\n* Connect neighboring dots of the same color\n* Build smooth chains in a single grab\n* Every dot must connect to at least one matching dot\n* Fewer grabs = better performance\n* Replay levels to improve your routing and earn stronger results\n\n---\n\nHandcrafted levels introduce new layouts, shapes, and routing puzzles as you progress. Difficulty increases through smarter spatial design \u2014 not complicated rules.\n\nPlay fully immersed in VR or blend the puzzle into your real-world space with Mixed Reality support.\n\nEarly Demo \u2013 Your Feedback Matters\n\nDots is currently an early demo, and your feedback will help shape what comes next.\n\nIf you have ideas, feature requests, or anything that feels unclear or off, I\u2019d love to hear from you.\n\nWhat was your experience like?\n\n* Did the dot size feel comfortable?\n* Were the levels too large or too compact?\n* Did the interaction feel natural?\n* Was the difficulty curve clear and fair?\n\nYour input directly influences future updates.\n", "short_description": "Connect. Flow. Master the Grid.\n\nConnect every matching dot in 3D using the fewest grabs possible.\n\nDots is a relaxing, skill-based spatial puzzle for Mixed Reality and immersive VR. Your goal is simple: connect matching colors until every dot is linked to at least one dot of the same color.\n\n\nDotS is currently an early demo, and your feedback will help shape what comes next.\n\nIf you have ideas, feature requests, or anything that feels unclear or off, I\u2019d love to hear from you."}]}, "developer_name": null, "developer_privacy_policy_url": "https://doncarrot.com/legal/dots-demo/", "developer_terms_of_service_url": null, "publisher_name": "Don Carrot", "support_website_url": null, "website_url": "https://doncarrot.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25660499480293777"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820887_2226377298176574_5069995972879338681_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ijC6tOD9VQQ7kNvwFixMKk&_nc_oc=Adr1ZQ4NsPVByVKhf6AVi26DOGNkcootr-W8NvBKVxkw3C3zVcd-r93i7J6bCDk_3Ns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GLTULjZ2ZkiJ4ZkSh0lMrc-ZUKHBGAvZq4LkNWyQUAQ&oe=6A199865"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dots Demo", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Tabletop", "id": "1676485315806614"}, {"topic_name": "Puzzle", "id": "377978390272490"}], "release_date": 1771605180, "lastRevision": {"nodes": [{"id": "24998161896527542", "release_type": 
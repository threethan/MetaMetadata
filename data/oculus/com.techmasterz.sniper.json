Xf9f994leJKHeMkSs4fu8yERMvszlQaNQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS32SxUqGTnu1reTSqLny5bTforN-9Qm6x2GrhUg3uI6A&oe=6AFB2503"}, {"file_name": "5.png", "id": "1434630914940303", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499312332_1434630921606969_4527092208030006395_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_508G5D05sQ7kNvwG4sz3t&_nc_oc=AdpotxQ_EilNlCMCWPMKFc9p7McwZ14FWDZuSSjOS2I1nlyJUpfnnpULtKHLxh82RmE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTs4km64mqwHt4DFkAIHm-uMgMVs4BDDD7OLINi5VebPw&oe=6AFB2FE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sniper", "keywords": ["sniper", "shooter", "rifle", "snipervr"], "long_description": "Best professional sniper game for VR headsets.\n\nStep into the sights and prove your skill in this precision fast-paced VR sniper experience.\n\nTravel to multiple unique locations where every mission challenges your speed, accuracy, and focus. Whether you're shooting static targets or taking out enemies, every second matters. The faster you complete each level, the higher your score \u2014 and the better your chance to dominate the leaderboard.\n\nDesigned for immersive virtual reality, this game puts you directly behind the scope with realistic aiming mechanics, responsive controls, and thrilling gameplay that rewards precision. Each level offers new environments, new challenges, and increasing intensity.\n\nCompete against players worldwide, improve your reaction time, and master every stage to become the ultimate sniper.\n\n\ud83d\udd25 Features:\n - High quality realistic rifle\n - Control with one or two hands\n - Multiple detailed locations and levels\n - Enemy and target-based missions\n - Time-based scoring system\n - Global leaderboard competition\n - Fully immersive VR sniper experience\n\n\nLock in. Take aim. Earn your spot on top.", "short_description": "A real-life sniper simulation. Take the rifle, zoom in, take a deep breath and shoot. \nHit every target, defeat enemies, and climb the global leaderboard in immersive locations around the world, including the desert world, beaches, war zone, ... ."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tech-masterz.github.io/privacy-sniper.html", "developer_terms_of_service_url": null, "publisher_name": "Tech Masterz", "support_website_url": null, "website_url": "https://tech-masterz.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29075443462082428"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823802_1101187059518835_731814638757737843_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZYVQaLk_2EEQ7kNvwHvoA30&_nc_oc=AdpGwkQqwlhbOah-UaqIJ-Fb9fNkb3OwFjas2e-YdkFlKqHdgf1rRPohi_oHkxYKC9Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQua9-IDs9keaAPglHjnt_CN3fhqXftoyu0GLkEZUVkMg&oe=6AFB21D1"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Sniper", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": 
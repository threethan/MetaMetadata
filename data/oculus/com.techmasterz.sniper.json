{"file_name": "3.png", "id": "2562716837544415", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620655_2562716840877748_5627236337874388342_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7TBSehqu2AQ7kNvwE9GyOW&_nc_oc=AdozpgDxKuvkJTBHKUBlYD5eObWu0xKBjlc7XcFl32y96ihTSZBUTwSmLxXDSRUMFIM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzGIotAZUkoMavGLVEp9BRLL7nobOJmCoBcP1ALPqx3g&oe=6AF9DDC6"}, {"file_name": "4.png", "id": "1632193535017765", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623512_1632193538351098_6169588497117530841_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YR43sg2X9KwQ7kNvwFAwk_j&_nc_oc=Adr48ihqhF_2BIaPPhXXl_8D39I61vp6PoM4Qj4SJ5xzHJ_8lGNlKc5uLh2D7hOwCYs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_hX8AaQWc4yqsJxNC69a2BHN0rtyEWMSmXcBlH0OA3A&oe=6AF9DD74"}, {"file_name": "5.png", "id": "866835499786517", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499623512_866835503119850_7973011695971641613_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_B-TFHDFs84Q7kNvwFTHLn3&_nc_oc=Ado5tlSnvlX4HJkQbAp2YEM5OPqKd0REwCnMJX21YGDo57ICzsSMHdE5MZRFa4dRklM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUOW0sL4yHb8A0G_h-thjaIicEknBj0mutymsvmjHAjg&oe=6AF9C1E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Sniper", "keywords": ["sniper", "shooter", "rifle", "snipervr"], "long_description": "Best professional sniper game for VR headsets.\n\nStep into the sights and prove your skill in this precision fast-paced VR sniper experience.\n\nTravel to multiple unique locations where every mission challenges your speed, accuracy, and focus. Whether you're shooting static targets or taking out enemies, every second matters. The faster you complete each level, the higher your score \u2014 and the better your chance to dominate the leaderboard.\n\nDesigned for immersive virtual reality, this game puts you directly behind the scope with realistic aiming mechanics, responsive controls, and thrilling gameplay that rewards precision. Each level offers new environments, new challenges, and increasing intensity.\n\nCompete against players worldwide, improve your reaction time, and master every stage to become the ultimate sniper.\n\n\ud83d\udd25 Features:\n - High quality realistic rifle\n - Control with one or two hands\n - Multiple detailed locations and levels\n - Enemy and target-based missions\n - Time-based scoring system\n - Global leaderboard competition\n - Fully immersive VR sniper experience\n\n\nLock in. Take aim. Earn your spot on top.", "short_description": "A real-life sniper simulation. Take the rifle, zoom in, take a deep breath and shoot. \nHit every target, defeat enemies, and climb the global leaderboard in immersive locations around the world, including the desert world, beaches, war zone, ... ."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tech-masterz.github.io/privacy-sniper.html", "developer_terms_of_service_url": null, "publisher_name": "Tech Masterz", "support_website_url": null, "website_url": "https://tech-masterz.github.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28831002643193179"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "111877315418372
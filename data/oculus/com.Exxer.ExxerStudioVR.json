/scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311597_1551695349704525_8289856793207429660_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SFEtHlab50Q7kNvwG7iJQq&_nc_oc=AdoZ-9JI-n1CMkFdImT2fd_DYwwZAeIyo6WP6rNgYrcWo2MmQ0WM_4-SNpNxwOUpji0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDACwd8fET1kR7tKbts5bdaFWppIIr8TF50JOrjgPnhQ&oe=6A79C32E"}]}, "id": "4366858290254759", "locale": "en_US", "screenshots": [{"file_name": "Login.png", "id": "1019949420977503", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507849536_1019949424310836_2430825481953201194_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL9JlVyJkUEQ7kNvwG80-rW&_nc_oc=AdpYC3alNdPDwTiGW3-wMfzQHWrb7tJjLoH3Qq59Hnr7pp-RxKQx3H6zN4pseLijH-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsazo7h6XDvAF294JyOzFG5nv5qmWtpT5g1tq-r-wnMQ&oe=6A79B7DF"}, {"file_name": "Configura\u00e7\u00f5es.png", "id": "2483170328862858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308050_2483170332196191_3153438380775261383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2EwBtLLcEwQ7kNvwGpFlWg&_nc_oc=Adp6Zwa8hnExw3Qshz6ZkMsbGQWx4PAfEuuhDOS4Baxdas6rOgc08p5TAJDdsQNiq50&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEj3SLEyroje6RVGY2vBGi04_Br4OxvTYZBItZIX_uxMw&oe=6A79D36D"}, {"file_name": "Idioma.png", "id": "1357593703139209", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499307470_1357593706472542_2577503620853900239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVQRXBNJnZQQ7kNvwGk46wo&_nc_oc=AdqyUixW04nYmFV0nB_gJONPKhcjJiTp3mEuoUPsj7xIftDK_UAMD2wL3glT2ISmNqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGadPUoLL04JZBJsa8buHurm3AIa1Sh3p55dMOyasxMKg&oe=6A79C025"}, {"file_name": "PDF.png", "id": "991476380303430", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298427_991476383636763_6170206601108302214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h7o1_eq8XLAQ7kNvwG3W0FD&_nc_oc=AdojBjIfvb675lVih4G5EO4C_OcnC4R3rE0ZgthyKG5UuqsPQEHqMUlWrtz0R15pwoc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtnZ3AQRgnYzrB2tnn5L3CxWs1RLx-aCun8bcC--KYKA&oe=6A79E01A"}, {"file_name": "Intera\u00e7\u00e3o com a mao.png", "id": "1327514535562794", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499311585_1327514538896127_9054442454944556640_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMm08vboqZIQ7kNvwFGVDUi&_nc_oc=AdrsWSuHXOa8IVPxF2gfEtYDWj9Vj6mx9UIer9OEPQGisHrCvJMW-saq-dz1huv4lyg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVC9vJtxloJ7xkRr8beZfngiyC0vK15f9fFqLetUbc0g&oe=6A79D6EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exxer Studio", "keywords": [], "long_description": "ExxerStudioVR transforma a intera\u00e7\u00e3o com sistemas industriais atrav\u00e9s da realidade virtual e realidade mista. A aplica\u00e7\u00e3o permite conectar-se a servidores Node-RED e visualizar interfaces homem-m\u00e1quina (IHMs) totalmente personaliz\u00e1veis, configuradas por meio de layouts JSON.\n\nMonitore vari\u00e1veis, visualize indicadores em tempo real e interaja com bot\u00f5es, campos de entrada e controles que enviam comandos diretamente para equipamentos e sistemas conectados. Com suporte a passthrough e leitura de QR Codes, o aplicativo possibilita associar informa\u00e7\u00f5es e a\u00e7\u00f5es ao ambiente f\u00edsico, criando experi\u00eancias contextualizadas para opera\u00e7\u00e3o, treinamento e supervis\u00e3o industrial.\n\nProjetado para dispositivos Meta Quest, o ExxerStudioVR oferece uma forma intuitiva e imersiva de acessar dados operacionais, integrar processos e aumentar a efici\u00eancia em ambientes industriais e educacionais.", "short_description": "ExxerStudioVR \u00e9 uma plataforma de realidade virtual para monitoramento e controle de equipamentos industriais. Conecte-se a servidores Node-RED, visualize IHMs personalizadas, interaja com dispositivos em tempo real e utilize QR Codes em realidade mista para contextualizar informa\u00e7\u00f5es e automatizar processos."}, {"images": {"nodes": []}, "id": "1320352003603365", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exxer Studio VR", "keywords": [], "long_description": "Aplica\u00e7\u00e3o educacional voltada ao ensino de tecnologias de automa\u00e7\u00e3o industrial, Internet das Coisas (IoT) e Interfaces Homem-M\u00e1quina (IHM), com suporte a realidade mista.\n\nA plataforma permite a cria\u00e7\u00e3o e personaliza\u00e7\u00e3o de IHMs integradas ao Node-RED, possibilitando o monitoramento de equipamentos industriais que enviam dados em tempo real. Atrav\u00e9s do Node-RED, o usu\u00e1rio pode construir interfaces din\u00e2micas utilizando estruturas baseadas em JSON, definindo telas, componentes e fluxos de intera\u00e7\u00e3o de forma flex\u00edvel e visual.\n\n\u00c9 poss\u00edvel configurar elementos como bot\u00f5es, campos de entrada e eventos personalizados, determinando a\u00e7\u00f5es espec\u00edficas ao interagir com a interface, como enviar comandos, atualizar dados ou alterar estados do sistema.\n\nA aplica\u00e7\u00e3o tamb\u00e9m inclui suporte a leitura de QR Codes, permitindo identificar equipamentos ou pontos espec\u00edficos do ambiente. Ao escanear um QR Code, a interface pode ser automaticamente adaptada para exibir informa\u00e7\u00f5es adicionais, como dados de sensores, explica\u00e7\u00f5es t\u00e9cnicas ou pain\u00e9is contextuais sobre o equipamento identificado.\n\nEssa abordagem permite a sobreposi\u00e7\u00e3o de informa\u00e7\u00f5es em realidade mista, enriquecendo a visualiza\u00e7\u00e3o de dados industriais diretamente no ambiente f\u00edsico. Todo o comportamento da interface \u00e9 definido pelo usu\u00e1rio via Node-RED, garantindo alto n\u00edvel de personaliza\u00e7\u00e3o e flexibilidade.\n", "short_description": "Aplica\u00e7\u00e3o educacional de IHM para automa\u00e7\u00e3o industrial e IoT. Integra Node-RED para cria\u00e7\u00e3o de interfaces din\u00e2micas via JSON, permitindo monitoramento de equipamentos e intera\u00e7\u00e3o com sensores em tempo real. Suporta leitura de QR Codes para exibi\u00e7\u00e3o de informa\u00e7\u00f5es contextuais em realidade mista, permitindo sobreposi\u00e7\u00e3o de dados e interfaces personalizadas configur\u00e1veis pelo usu\u00e1rio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.exsto.com.br/APP_DEV/exxer_studio/privacy/exxerstudiovr.html", "developer_terms_of_service_url": null, "publisher_name": "Exxer", "support_website_url": null, "website_url": "https://exxer.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1204790286048903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307451_3571751516306500_1489927943857804540_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gnbpOlGALMwQ7kNvwH1_33_&_nc_oc=AdrTeYaZoQNTX4WVLanV_BJZNdVA4mvLfPW9414rQiSrTWuMqnVjC077pwIOfC_tEUA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIYmm2Q66VcCKrhgxCNOHjk0IU6D8EJLYy5E6kkYRhWQ&oe=6A79D64F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
/scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499311597_1551695349704525_8289856793207429660_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kcEUVQBdHB4Q7kNvwHMR1ai&_nc_oc=Adoi-C5mShEY-TJ0mgg18wP8FA_sdzkTggM3GO4AdUuAexl8rvqjsZCN0wPtO_ne4EA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9icOwHVYW5YnfNOheaRlVjkeygGu5U4at1Uotfwqq2w&oe=6A8843AE"}]}, "id": "4366858290254759", "locale": "en_US", "screenshots": [{"file_name": "Login.png", "id": "1019949420977503", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/507849536_1019949424310836_2430825481953201194_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0lVwQACI3kQ7kNvwGmCukV&_nc_oc=AdpZa7Czvd6TwSFNOOvo9YqUMZQIIibMigxFp5J-ie3h_MoqEDyw_R8NjX9YZee34dU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHF2EAC7NG21agMepKPZ4eTGnDALuvq7vs-UJvnZFAQgQ&oe=6A88385F"}, {"file_name": "Configura\u00e7\u00f5es.png", "id": "2483170328862858", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499308050_2483170332196191_3153438380775261383_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJEx3qAiIDoQ7kNvwECPs-t&_nc_oc=AdrObwK2WUwzkPuNx4_2GG_zNReb1eBFs6vxiXwCe7ERMMxd_NUy4NRDJ9tm8m9Rv6E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_Lu9B_8-daheLDsGLrLklwbcwT0c-YovoDufgxEyciA&oe=6A881BAD"}, {"file_name": "Idioma.png", "id": "1357593703139209", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307470_1357593706472542_2577503620853900239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Il7aZXdxmfYQ7kNvwEYoBse&_nc_oc=AdoUc9GAPwFDVXQeIlWaB_h9IfyjP7cte0WvpgaVyERcRTOUqDc1gx_M4TAdAzhfqSc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUc5eR6TWIQG_PeG84GLAgFAfDhbgebHiysbyd6iMtWA&oe=6A8840A5"}, {"file_name": "PDF.png", "id": "991476380303430", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499298427_991476383636763_6170206601108302214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWKhxYpUa7gQ7kNvwHewFnn&_nc_oc=AdoO8PtbJdP7b6bSTGeCyHKA_4k7sSfsZ_qZseChFOho5S2E-LQRrFtCmRJy5jW6LbM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF94L0E9Umzc2NzJjDkJWUwKGn15iw4_qrm0Jat7EaCKQ&oe=6A88285A"}, {"file_name": "Intera\u00e7\u00e3o com a mao.png", "id": "1327514535562794", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/499311585_1327514538896127_9054442454944556640_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTzRqQFR6L0Q7kNvwEDleR2&_nc_oc=Adpa9tkq-Xex5tFgba4QJGpb7Jms0aOAP7gYj5g08BS_SAemtKMM6Vz3WyJ1u1aa7mw&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8CRyaX9DbE-_gsF_Au4m5oby43TkV442eZqmJJlIQ8Q&oe=6A881F2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exxer Studio", "keywords": [], "long_description": "ExxerStudioVR transforma a intera\u00e7\u00e3o com sistemas industriais atrav\u00e9s da realidade virtual e realidade mista. A aplica\u00e7\u00e3o permite conectar-se a servidores Node-RED e visualizar interfaces homem-m\u00e1quina (IHMs) totalmente personaliz\u00e1veis, configuradas por meio de layouts JSON.\n\nMonitore vari\u00e1veis, visualize indicadores em tempo real e interaja com bot\u00f5es, campos de entrada e controles que enviam comandos diretamente para equipamentos e sistemas conectados. Com suporte a passthrough e leitura de QR Codes, o aplicativo possibilita associar informa\u00e7\u00f5es e a\u00e7\u00f5es ao ambiente f\u00edsico, criando experi\u00eancias contextualizadas para opera\u00e7\u00e3o, treinamento e supervis\u00e3o industrial.\n\nProjetado para dispositivos Meta Quest, o ExxerStudioVR oferece uma forma intuitiva e imersiva de acessar dados operacionais, integrar processos e aumentar a efici\u00eancia em ambientes industriais e educacionais.", "short_description": "ExxerStudioVR \u00e9 uma plataforma de realidade virtual para monitoramento e controle de equipamentos industriais. Conecte-se a servidores Node-RED, visualize IHMs personalizadas, interaja com dispositivos em tempo real e utilize QR Codes em realidade mista para contextualizar informa\u00e7\u00f5es e automatizar processos."}, {"images": {"nodes": []}, "id": "1320352003603365", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exxer Studio VR", "keywords": [], "long_description": "Aplica\u00e7\u00e3o educacional voltada ao ensino de tecnologias de automa\u00e7\u00e3o industrial, Internet das Coisas (IoT) e Interfaces Homem-M\u00e1quina (IHM), com suporte a realidade mista.\n\nA plataforma permite a cria\u00e7\u00e3o e personaliza\u00e7\u00e3o de IHMs integradas ao Node-RED, possibilitando o monitoramento de equipamentos industriais que enviam dados em tempo real. Atrav\u00e9s do Node-RED, o usu\u00e1rio pode construir interfaces din\u00e2micas utilizando estruturas baseadas em JSON, definindo telas, componentes e fluxos de intera\u00e7\u00e3o de forma flex\u00edvel e visual.\n\n\u00c9 poss\u00edvel configurar elementos como bot\u00f5es, campos de entrada e eventos personalizados, determinando a\u00e7\u00f5es espec\u00edficas ao interagir com a interface, como enviar comandos, atualizar dados ou alterar estados do sistema.\n\nA aplica\u00e7\u00e3o tamb\u00e9m inclui suporte a leitura de QR Codes, permitindo identificar equipamentos ou pontos espec\u00edficos do ambiente. Ao escanear um QR Code, a interface pode ser automaticamente adaptada para exibir informa\u00e7\u00f5es adicionais, como dados de sensores, explica\u00e7\u00f5es t\u00e9cnicas ou pain\u00e9is contextuais sobre o equipamento identificado.\n\nEssa abordagem permite a sobreposi\u00e7\u00e3o de informa\u00e7\u00f5es em realidade mista, enriquecendo a visualiza\u00e7\u00e3o de dados industriais diretamente no ambiente f\u00edsico. Todo o comportamento da interface \u00e9 definido pelo usu\u00e1rio via Node-RED, garantindo alto n\u00edvel de personaliza\u00e7\u00e3o e flexibilidade.\n", "short_description": "Aplica\u00e7\u00e3o educacional de IHM para automa\u00e7\u00e3o industrial e IoT. Integra Node-RED para cria\u00e7\u00e3o de interfaces din\u00e2micas via JSON, permitindo monitoramento de equipamentos e intera\u00e7\u00e3o com sensores em tempo real. Suporta leitura de QR Codes para exibi\u00e7\u00e3o de informa\u00e7\u00f5es contextuais em realidade mista, permitindo sobreposi\u00e7\u00e3o de dados e interfaces personalizadas configur\u00e1veis pelo usu\u00e1rio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.exsto.com.br/APP_DEV/exxer_studio/privacy/exxerstudiovr.html", "developer_terms_of_service_url": null, "publisher_name": "Exxer", "support_website_url": null, "website_url": "https://exxer.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_AR", "es_CL", "es_CO", "es_MX", "es_PE", "es_PR", "es", "es_VE"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1204790286048903"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307451_3571751516306500_1489927943857804540_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjInNMqJTNcQ7kNvwEz-lLd&_nc_oc=Ado7mOWTR1Xt7bEv6U4DZH9Mx5t-8fSUueT-Z-ia3OUSW37MYGI9jIXWqvWljQ3I1WY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFBqQokGSfnA5wFjCHnzXUlyhANsgaofIaY3AGrCS8GQ&oe=6A881E8F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "dis
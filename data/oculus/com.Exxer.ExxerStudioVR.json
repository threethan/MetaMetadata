ontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO9s9xh2_spCQsykLtCGGdsSlDU50-pqSkBaSBsoeGYg&oe=6A87026D"}, {"file_name": "Idioma.png", "id": "1357593703139209", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307470_1357593706472542_2577503620853900239_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Il7aZXdxmfYQ7kNvwFCcSDJ&_nc_oc=AdonyceIZLibQAZSfee4VWeDkN-cIFejsUMYD8EEO91ia8UTz1uXiDjOlyBsGhq6d3g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrO3PkTPhz5mklP8oRb8hdg8scgfP6EbAI8SSPdptp8w&oe=6A86EF25"}, {"file_name": "PDF.png", "id": "991476380303430", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499298427_991476383636763_6170206601108302214_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NWKhxYpUa7gQ7kNvwGhOoBe&_nc_oc=AdqsMRm9k5SWVua5wwzhanmnI7Zifwmnwe3C-gzLF3TDzR0VQ0KEWi2fazhFE7lG7iQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0C446Vv5mMLvDRuknbawjgiop4coaxLpGgpYzTLn3NQ&oe=6A86D6DA"}, {"file_name": "Intera\u00e7\u00e3o com a mao.png", "id": "1327514535562794", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499311585_1327514538896127_9054442454944556640_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTzRqQFR6L0Q7kNvwHmWrzd&_nc_oc=AdqTligQU2NNACJZIDDOTJ8_-jL0k5QYnXu-i0lu06ExMKKKhl1xl7BgXlIta7MxSIg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUGIX8w20swlqVoQYxfATHcHUPIUdnP-CvO3WX6iFmtw&oe=6A86CDAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exxer Studio", "keywords": [], "long_description": "ExxerStudioVR transforma a intera\u00e7\u00e3o com sistemas industriais atrav\u00e9s da realidade virtual e realidade mista. A aplica\u00e7\u00e3o permite conectar-se a servidores Node-RED e visualizar interfaces homem-m\u00e1quina (IHMs) totalmente personaliz\u00e1veis, configuradas por meio de layouts JSON.\n\nMonitore vari\u00e1veis, visualize indicadores em tempo real e interaja com bot\u00f5es, campos de entrada e controles que enviam comandos diretamente para equipamentos e sistemas conectados. Com suporte a passthrough e leitura de QR Codes, o aplicativo possibilita associar informa\u00e7\u00f5es e a\u00e7\u00f5es ao ambiente f\u00edsico, criando experi\u00eancias contextualizadas para opera\u00e7\u00e3o, treinamento e supervis\u00e3o industrial.\n\nProjetado para dispositivos Meta Quest, o ExxerStudioVR oferece uma forma intuitiva e imersiva de acessar dados operacionais, integrar processos e aumentar a efici\u00eancia em ambientes industriais e educacionais.", "short_description": "ExxerStudioVR \u00e9 uma plataforma de realidade virtual para monitoramento e controle de equipamentos industriais. Conecte-se a servidores Node-RED, visualize IHMs personalizadas, interaja com dispositivos em tempo real e utilize QR Codes em realidade mista para contextualizar informa\u00e7\u00f5es e automatizar processos."}, {"images": {"nodes": []}, "id": "1320352003603365", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exxer Studio VR", "keywords": [], "long_description": "Aplica\u00e7\u00e3o educacional voltada ao ensino de tecnologias de automa\u00e7\u00e3o industrial, Internet das Coisas (IoT) e Interfaces Homem-M\u00e1quina (IHM), com suporte a realidade mista.\n\nA plataforma permite a cria\u00e7\u00e3o e personaliza\u00e7\u00e3o de IHMs integradas ao Node-RED, possibilitando o monitoramento de equipamentos industriais que enviam dados em tempo real. Atrav\u00e9s do Node-RED, o usu\u00e1rio pode construir interfaces din\u00e2micas utilizando estruturas baseadas em JSON, definindo telas, componentes e fluxos de intera\u00e7\u00e3o de forma flex\u00edvel e visual.\n\n\u00c9 poss\u00edvel configurar elementos como bot\u00f5es, campos de entrada e eventos personalizados, determinando a\u00e7\u00f5es espec\u00edficas ao interagir com a interface, como enviar comandos, atualizar dados ou alterar estados do sistema.\n\nA aplica\u00e7\u00e3o tamb\u00e9m inclui suporte a leitura de QR Codes, permitindo identificar equipamentos ou pontos espec\u00edficos do ambiente. Ao escanear um QR Code, a interface pode ser automaticamente adaptada para exibir informa\u00e7\u00f5es adicionais, como dados de sensores, explica\u00e7\u00f5es t\u00e9cnicas ou pain\u00e9is contextuais sobre o equipamento identificado.\n\nEssa abordagem permite a sobreposi\u00e7\u00e3o de informa\u00e7\u00f5es em realidade mista, enriquecendo a visualiza\u00e7\u00e3o de dados industriais diretamente no ambiente f\u00edsico. Todo o comportamento da interface \u00e9 definido pelo usu\u00e1rio via Node-RED, garantindo alto n\u00edvel de personaliza\u00e7\u00e3o e flexibilidade.\n", "short_description": "Aplica\u00e7\u00e3o educacional de IHM para automa\u00e7\u00e3o industrial e IoT. Integra Node-RED para cria\u00e7\u00e3o de interfaces din\u00e2micas via JSON, permitindo monitoramento de equipamentos e intera\u00e7\u00e3o com sensores em tempo real. Suporta leitura de QR Codes para exibi\u00e7\u00e3o de informa\u00e7\u00f5es contextuais em realidade mista, permitindo sobreposi\u00e7\u00e3o de dados e interfaces personalizadas configur\u00e1veis pelo usu\u00e1rio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.exsto.com.br/APP_DEV/exxer_studio/privacy/exxerstudiovr.html", "developer_terms_of_service_url": null, "publisher_name": "Exxer", "support_website_url": null, "website_url": "https://exxer.com/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR", "es_AR", "e
-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdXKM3uuAkqbt1JA4olaRQ9Tcf8F7L6opkSnSt9KoPfw&oe=6AFDC61F"}, {"file_name": "Configura\u00e7\u00f5es.png", "id": "2483170328862858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_2483170332196191_3153438380775261383_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZpTziEyw9oQ7kNvwErksQP&_nc_oc=AdpIvmlUxUNLhPkHAk4BBrat_Rd-HMWJ1Yn1yZXgW--J-RT53_zb_ZzcjWQ4o3llwkw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUlHsEfuBHqYmOg-_rbR676Z8BmJiSeRdAaUtumxmVkQ&oe=6AFDE1AD"}, {"file_name": "Idioma.png", "id": "1357593703139209", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307470_1357593706472542_2577503620853900239_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jP6t1B6Ll_AQ7kNvwGMB5NC&_nc_oc=Adr2pxOWvYYtLXXn3ShrYKQU0rtskDu16sC-t4R1bgJhqg80hZf5c7yxxXokUMekAvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSskTLU52KgDJ6brOWbDN5iNy645l8VnMx7EW_JG0rSSA&oe=6AFDCE65"}, {"file_name": "PDF.png", "id": "991476380303430", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298427_991476383636763_6170206601108302214_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_I8p4EqmfoQ7kNvwG4328J&_nc_oc=Adof73QIZSlKhmRImczIjDqkkkvej0kagznHsn8KFiRaeZ-wTfSubKXV1G05MjGuTKc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPk8lssDFgpb9s7ThoHl9uEyr465mw4L9SdpDGIkfH7g&oe=6AFDB61A"}, {"file_name": "Intera\u00e7\u00e3o com a mao.png", "id": "1327514535562794", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499311585_1327514538896127_9054442454944556640_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh9hZ9VzrDQQ7kNvwEwkxfd&_nc_oc=Ado9-IpTQ6PQQ7abwT7-hnmCokyE2is3xP6yGSXSqy5ZuxxjijjU5P5MAEgI8wJyakA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS-n3NZEycNXJV__xq6mxAqDFdy4HWc349-zkgBTpC7UA&oe=6AFDACEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exxer Studio", "keywords": [], "long_description": "ExxerStudioVR transforma a intera\u00e7\u00e3o com sistemas industriais atrav\u00e9s da realidade virtual e realidade mista. A aplica\u00e7\u00e3o permite conectar-se a servidores Node-RED e visualizar interfaces homem-m\u00e1quina (IHMs) totalmente personaliz\u00e1veis, configuradas por meio de layouts JSON.\n\nMonitore vari\u00e1veis, visualize indicadores em tempo real e interaja com bot\u00f5es, campos de entrada e controles que enviam comandos diretamente para equipamentos e sistemas conectados. Com suporte a passthrough e leitura de QR Codes, o aplicativo possibilita associar informa\u00e7\u00f5es e a\u00e7\u00f5es ao ambiente f\u00edsico, criando experi\u00eancias contextualizadas para opera\u00e7\u00e3o, treinamento e supervis\u00e3o industrial.\n\nProjetado para dispositivos Meta Quest, o ExxerStudioVR oferece uma forma intuitiva e imersiva de acessar dados operacionais, integrar processos e aumentar a efici\u00eancia em ambientes industriais e educacionais.", "short_description": "ExxerStudioVR \u00e9 uma plataforma de realidade virtual para monitoramento e controle de equipamentos industriais. Conecte-se a servidores Node-RED, visualize IHMs personalizadas, interaja com dispositivos em tempo real e utilize QR Codes em realidade mista para contextualizar informa\u00e7\u00f5es e automatizar processos."}, {"images": {"nodes": []}, "id": "1320352003603365", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Exxer Studio VR", "keywords": [], "long_description": "Aplica\u00e7\u00e3o educacional voltada ao ensino de tecnologias de automa\u00e7\u00e3o industrial, Internet das Coisas (IoT) e Interfaces Homem-M\u00e1quina (IHM), com suporte a realidade mista.\n\nA plataforma permite a cria\u00e7\u00e3o e personaliza\u00e7\u00e3o de IHMs integradas ao Node-RED, possibilitando o monitoramento de equipamentos industriais que enviam dados em tempo real. Atrav\u00e9s do Node-RED, o usu\u00e1rio pode construir interfaces din\u00e2micas utilizando estruturas baseadas em JSON, definindo telas, componentes e fluxos de intera\u00e7\u00e3o de forma flex\u00edvel e visual.\n\n\u00c9 poss\u00edvel configurar elementos como bot\u00f5es, campos de entrada e eventos personalizados, determinando a\u00e7\u00f5es espec\u00edficas ao interagir com a interface, como enviar comandos, atualizar dados ou alterar estados do sistema.\n\nA aplica\u00e7\u00e3o tamb\u00e9m inclui suporte a leitura de QR Codes, permitindo identificar equipamentos ou pontos espec\u00edficos do ambiente. Ao escanear um QR Code, a interface pode ser automaticamente adaptada para exibir informa\u00e7\u00f5es adicionais, como dados de sensores, explica\u00e7\u00f5es t\u00e9cnicas ou pain\u00e9is contextuais sobre o equipamento identificado.\n\nEssa abordagem permite a sobreposi\u00e7\u00e3o de informa\u00e7\u00f5es em realidade mista, enriquecendo a visualiza\u00e7\u00e3o de dados industriais diretamente no ambiente f\u00edsico. Todo o comportamento da interface \u00e9 definido pelo usu\u00e1rio via Node-RED, garantindo alto n\u00edvel de personaliza\u00e7\u00e3o e flexibilidade.\n", "short_description": "Aplica\u00e7\u00e3o educacional de IHM para automa\u00e7\u00e3o industrial e IoT. Integra Node-RED para cria\u00e7\u00e3o de interfaces din\u00e2micas via JSON, permitindo monitoramento de equipamentos e intera\u00e7\u00e3o com sensores em tempo real. Suporta leitura de QR Codes para exibi\u00e7\u00e3o de informa\u00e7\u00f5es contextuais em realidade mista, permitindo sobreposi\u00e7\u00e3o de dados e interfaces personalizadas configur\u00e1veis pelo usu\u00e1rio."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.exsto.com.br/APP_DEV/exxer_studio/privacy/exxerstudiovr.html", "developer_terms_of_service_url": null, "publisher_name": "Exxer", "support_website_url": null, "website_url": "ht
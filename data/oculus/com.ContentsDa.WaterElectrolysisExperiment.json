c=AdmOImeHr713BC0TNuRxDSTWnDebjseBXO_m_z7n7nICvcBSl0fGvx_FXMnLHu8oWKw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwzYjnoiY2H9wVbtRtRSQcXTLig51pOnO3EHNSvlDEXKw&oe=69BA8192"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Water Electrolysis_Landscape.png", "id": "1071910887477670", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/57575348_1071910890811003_4489277300741599218_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZlWNVz35qTcQ7kNvwHXMoXf&_nc_oc=AdmyES_QUW38QMRjRolqjxGzPFhkQeBPs6kJHxeUHSMVUJB35jvoeFJNu-TzNl_UKZ8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOlkWJBKbyrux5KL0H8c2MThtV_RqioTdNgoZWOPEzlw&oe=69BA974C"}, "display_name": "Water Electrolysis Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "electrolyte", "science", "contentsda"], "long_description": "1. prepare the materials and place them on the table (beaker with water, bottle of sodium hydroxide, spoons, glass rod, gasator, electrolyzer)\n2. scoop a small amount (tablespoon) of sodium hydroxide (electrolyte) into 500 ml of distilled water\n3. stir with a glass rod to dissolve the sodium hydroxide.\n4. pour the water with sodium hydroxide and tritium into the water electrolysis apparatus\n5. close the two valves on both sides of the device\n6. press the power button to activate the water electrolyzer\n7. observe the water electrolyzing, noting the degree to which the + and - are empty of air.\n8. open the valve on the - side and light the gas igniter and observe the behavior of the flame.\n9. Open the valve on the + side, light the gas igniter and observe the behavior of the flame.\n<Result \nA model of a molecule that undergoes electrolysis of water to produce hydrogen (H2) at the (-) pole and oxygen (O) at the (+) pole\n\nTranslated with DeepL.com (free version)", "short_description": "Witness the power of electricity as it splits water into hydrogen and oxygen gases in the water electrolysis experiment. This experiment beautifully demonstrates the concepts of electrochemistry and renewable energy sources, showing the potential of water as a fuel source."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8617662951654103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982712_1409752362965047_1173833049439999754_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=me7NndwhTTQQ7kNvwG37Fr3&_nc_oc=Adm6hSPC8qhmRLr5OpyetGckddZBqF0mymTTN69g2otIkPXjLtMMYTcI8llQxn21PMY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afx2B2Qy4Ao0hzEuz8I4OCPAR_Cx6yZluOYEuNWpKmHxjg&oe=69BAA382"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Water Electrolysis Experiment - ContentsDa Science Experiment", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "i
tps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035468_397750759323802_6570687362828127363_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CLcQC8HE0OUQ7kNvwEkDBSO&_nc_oc=AdkekWrHC0zE5OLVZTnF3j3g476IJh8CuWdV7XYF2UuRITE-qpQ2FTUqvpCrFFNz5GU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsAazXJTf6izoJOxa9qwMZITiw28M4b-dgKs7aY7TuyOQ&oe=699D9B42"}, {"file_name": "Water Electrolysis Experiment_Screenshot05.png", "id": "1234909971245869", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974714_1234909974579202_8337848044828905951_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AxjgljPGHoQ7kNvwFrzYbc&_nc_oc=AdlKJhDPA7_EWPOcLYTRtdVwP0PCTOLsRUDEXnCh0QFmVfPPnrF4yZo-6Md1jxLif0w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsxoRMq0oL4eOMf_-49_i4waXCpE_JffScNsjouxO5OCA&oe=699D8092"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Water Electrolysis_Landscape.png", "id": "1071910887477670", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/57575348_1071910890811003_4489277300741599218_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoZjThfEGMEQ7kNvwFjn0ck&_nc_oc=Adk_TrueKbaaPjg0390Jt2VYCQTnZ5wgaCAHMnCWxqM9E455c1ZBBJewmSTrnGZwTLs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvmtCIfy65ipVhiaz5WTi7kg1ssTqfDk1nRUsrA6OjUyQ&oe=699D964C"}, "display_name": "Water Electrolysis Experiment - ContentsDa Science Experiment", "keywords": ["experiment", "chemistry", "electrolyte", "science", "contentsda"], "long_description": "1. prepare the materials and place them on the table (beaker with water, bottle of sodium hydroxide, spoons, glass rod, gasator, electrolyzer)\n2. scoop a small amount (tablespoon) of sodium hydroxide (electrolyte) into 500 ml of distilled water\n3. stir with a glass rod to dissolve the sodium hydroxide.\n4. pour the water with sodium hydroxide and tritium into the water electrolysis apparatus\n5. close the two valves on both sides of the device\n6. press the power button to activate the water electrolyzer\n7. observe the water electrolyzing, noting the degree to which the + and - are empty of air.\n8. open the valve on the - side and light the gas igniter and observe the behavior of the flame.\n9. Open the valve on the + side, light the gas igniter and observe the behavior of the flame.\n<Result \nA model of a molecule that undergoes electrolysis of water to produce hydrogen (H2) at the (-) pole and oxygen (O) at the (+) pole\n\nTranslated with DeepL.com (free version)", "short_description": "Witness the power of electricity as it splits water into hydrogen and oxygen gases in the water electrolysis experiment. This experiment beautifully demonstrates the concepts of electrochemistry and renewable energy sources, showing the potential of water as a fuel source."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "ko"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8617662951654103"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982712_1409752362965047_1173833049439999754_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=
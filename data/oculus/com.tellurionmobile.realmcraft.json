uluscdn.com&_nc_ss=7a30f&oh=00_Af1E0kzBzth-dttce7XTQiRtH9nNh21pxMK6iOPOb3i-sw&oe=69DE2C3A"}, {"file_name": "migrated_image.png", "id": "543801156266595", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410271_1816492958588938_6237811970142109696_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-8_mUM1x5QQ7kNvwHHDisx&_nc_oc=AdroNpuxdRZrr0uKONKhkHSL4AExX-K8-dWilrU0YFlspbP4libtu8UxI41CZjJUtL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af07YMs5E2Ihe_golWrX3w83Rgtvz6OFXTC8skEE3M88mg&oe=69DE2AAD"}, {"file_name": "migrated_image.png", "id": "607230599865958", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138845_1897605223792843_4617680328188755968_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_0UVTlOEZ0Q7kNvwHOh4zn&_nc_oc=AdrFKFja99qfPkU3_-akDyCGzoxUbe5KHZjZBuiJmBeQ7DWL4P8YS00BeXxPTdEkNqk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af377brBIJ5UcFvCLKIbQ3f6cODO4s4ddAVPbr0DQmOvZA&oe=69DE379E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1697611387217819", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12138844_1697611390551152_3067927308837847040_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XqGEu_n66bcQ7kNvwG7j1Jx&_nc_oc=Ado0WsyAPt1Ig9JwwWzNHVdsEiY_9lTfFAUY_9OMGEzTKVkHIjA4Zwc3QW7CGRVwIh8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BdnbwkR-AjGynzMCfi9dPQjLdC-AuqE3ZtpfwbivIaA&oe=69DE2A64"}, "display_name": "RealmCraft Survive & Craft Pro", "keywords": ["craft", "sandbox", "build", "worldcraft", "explore"], "long_description": "RealmCraft is a sandbox construction game with 3D procedurally generated world. Create and break apart various kinds of blocks, explore the environment, gather resources, craft weapons, build shelter and take part in combat with dangerous opponents.\nThe game offers two modes \u2013 Survival and Creative. In Survival players have to collect resources, construct buildings, fight against enemies, manage hunger and explore the word to survive and prosper. In Creative mode you focus on breaking new grounds of creation by building the most elaborate structures you can dream of.\nRealmcraft is a game for adults and kids, it will entertain you for a long time and earn an unforgettable experience.\n\u2022\t3D Sandbox construction game;\n\u2022\tHuge world to explore;\n\u2022\tCraft and destroy everything;\n\u2022\tBuild your own shelter;\n\u2022\tGo deep into the mines;\n\u2022\tGather resources to survive;\n\u2022\tFight your enemies;\n\u2022\tCreative mode to set your imagination free.", "short_description": "Sandbox block craft survival game. Build and explore!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.tellurionmobile.com/privacy-policy", "developer_terms_of_service_url": "http://www.tellurionmobile.com/privacy-policy", "publisher_name": "Tellurion mobile", "support_website_url": null, "website_url": "http://www.tellurionmobile.com/games/realmcraft", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "916370152578241"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1890223727901041"}]}, "baseline_offer": {"id": "1890223727901041"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1490202000, "status": "PUBLISHED", "id": "1890223727901041"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "14735
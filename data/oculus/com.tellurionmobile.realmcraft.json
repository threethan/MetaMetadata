oculuscdn.com&_nc_ss=7f20f&oh=00_Af6HLappFwA1WY9RG4eTJ20WECnVxAv0l9J3IBPXcX9dSg&oe=6A11CEFA"}, {"file_name": "migrated_image.png", "id": "543801156266595", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12410271_1816492958588938_6237811970142109696_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xuuj5SDwydAQ7kNvwGANMit&_nc_oc=AdrAQ0auCMg4NchiROFaScNapxbkm5R2MOJQQOg3CfDVrKmsIkS3VaoPf3L0f7Qx-uI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41gr6OqmiDZU60pfROUQv-0TCyHhXS96ft0EC7fbcOWw&oe=6A11CD6D"}, {"file_name": "migrated_image.png", "id": "607230599865958", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/12138845_1897605223792843_4617680328188755968_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lGktRkwZg4sQ7kNvwG0rX5y&_nc_oc=AdpUu-QaYwd_ywfIHyBxm2YuY6w5B-vcMHI1NB3VSTKLGFTyrVmCP6KohEl8JeU-Xp8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6r0-auHrFN_ZEH-dek6vmhNPV2bx5hJZWijFHNdV1EEA&oe=6A11A21E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1697611387217819", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/12138844_1697611390551152_3067927308837847040_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iuYqU8ElqSIQ7kNvwE5AvQK&_nc_oc=AdqTbCFpujgcq5YXNdWq9HIyL7BpBSU7wgYhhg1URhXiPQkOPHf0e7iybWyHc4Jie_g&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dsLYclp1oyPKcU51AfxB1Gz6S4PomDz0BFOEVyvac-Q&oe=6A11CD24"}, "display_name": "RealmCraft Survive & Craft Pro", "keywords": ["craft", "sandbox", "build", "worldcraft", "explore"], "long_description": "RealmCraft is a sandbox construction game with 3D procedurally generated world. Create and break apart various kinds of blocks, explore the environment, gather resources, craft weapons, build shelter and take part in combat with dangerous opponents.\nThe game offers two modes \u2013 Survival and Creative. In Survival players have to collect resources, construct buildings, fight against enemies, manage hunger and explore the word to survive and prosper. In Creative mode you focus on breaking new grounds of creation by building the most elaborate structures you can dream of.\nRealmcraft is a game for adults and kids, it will entertain you for a long time and earn an unforgettable experience.\n\u2022\t3D Sandbox construction game;\n\u2022\tHuge world to explore;\n\u2022\tCraft and destroy everything;\n\u2022\tBuild your own shelter;\n\u2022\tGo deep into the mines;\n\u2022\tGather resources to survive;\n\u2022\tFight your enemies;\n\u2022\tCreative mode to set your imagination free.", "short_description": "Sandbox block craft survival game. Build and explore!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.tellurionmobile.com/privacy-policy", "developer_terms_of_service_url": "http://www.tellurionmobile.com/privacy-policy", "publisher_name": "Tellurion mobile", "support_website_url": null, "website_url": "http://www.tellurionmobile.com/games/realmcraft", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ADVENTURE", "EXPLORATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "916370152578241"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1890223727901041"}]}, "baseline_offer": {"id": "1890223727901041"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1490202000, "status": "PUBLISHED", "id": "1890223727901041"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1
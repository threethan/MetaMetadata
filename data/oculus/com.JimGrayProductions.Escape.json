5559702_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xf5E9xIIUZIQ7kNvwFPJ2fi&_nc_oc=AdqkrQ6g94ngYDy27H8-4S8iycVOgr9BpsKKcgBRbMKxPMQf3eDzQY_Jn0sus9I8pjw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhQPJzcdoW5Ws7ZQnYPSrZmuDnIdigNQZfwEWntR-tow&oe=6A6DFC67"}, {"file_name": "screenshot-3.png", "id": "1056521275377047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75603733_1056521278710380_5045420068564353207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24pTfO1_yLoQ7kNvwG0c2Sc&_nc_oc=AdoynuQ6MOaufuNcdFuWSRuG31Mabum3IgAwqDqkmjz3Ku7KImNJNZj41QhzNgYN7Cc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdlU8WlybBo4deSjVrcL4yOklTySP7uEUQosz7bd-18Q&oe=6A6DE8F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "705343571987645", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831968_705343575320978_6364866043747351745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4aGCFk_6wkcQ7kNvwHa1grA&_nc_oc=AdqQ5hxrnkh32ZmjMATwTsJYvKD5Oa_BFrr3bAT0iZch6ikmF_hMALkv2Y7A-KrNbUU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAglbm3DG4zc9JZCP614i4mDhIdfkZmE_FPjGWJJ1BXjA&oe=6A6E000D"}, "display_name": "Escape from Hadrian's Wall", "keywords": ["escape", "puzzle", "fantasy", "cards", "adventure"], "long_description": "Escape the Dungeons of Hadrian's Wall. Your liberation awaits!\n\nEscape from Hadrian's Wall is the debut game from fledgling studio Jim Gray Productions.\n\nIt is 402 AD in the Roman Province of Britannia. War has come to Hadrian's Wall. As a prisoner within the wall's dungeons, your journey of discovery begins with an unexpected alliance with a stranger, who provides you with magic tools to navigate the puzzles and obstacles throughout the fortress. Your task is to find the mage within the Wall, who has mysterious connections to the war, to the wall, and to dark and ancient magic. \n\nElemental Golem Card Puzzles\n\nElemental Golems guard the passageways of Hadrian's Wall. These Golems must be defeated by summoning your own Golems. Using a set of magical Golem cards you solve puzzles to clear your path. Your objective is to dispel the enemy Golems by bringing each Golem's strength to 0 while preserving your own. Clever use of your Spell Cards and positioning will help you overcome your opponent in these battles of wit.\n\nAn Immersive and Magical Dungeon\n\nHadrian's Wall is host to many puzzles to test your puzzle-solving skills. A game built exclusively for VR, there are many unique gameplay moments that combine the opportunities of virtual reality with historical fiction and medieval fantasy. Play a magic instrument, mix potions, and blast spells from a mage's wand. Master your skills and conquer the secrets of Hadrian's Wall!", "short_description": "A VR Escape Room. The year is 402 AD. You are a hero of circumstance - a prisoner caught in an epic battle between good and evil. Exercise your intellect to solve magical puzzles and battle Elemental Golems. Decode, decipher, and delve into the bowels of a massive fort within Hadrian's Wall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jimgrayproductions.com/privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "Jim Gray Productions Inc", "support_website_url": null, "website_url": "https://jimgrayproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mod
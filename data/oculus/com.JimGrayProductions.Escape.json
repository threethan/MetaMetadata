wvM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSjiXiFMgdkz6n_umgiGVkKfwWrLupDzNRPiv_nZgCAyA&oe=6B0C83FE"}, {"file_name": "screenshot-2.png", "id": "527298313190518", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39003230_527298316523851_723403163565559702_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q7mAjcuk3wcQ7kNvwGh6pd6&_nc_oc=Adr1_BeK4xUSMu7TrjsyiqAA2qCnBG9fMUYkS3WK-AWo41rfXQXHrkjwuYiLpd4gT_o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQuwkeMsNuSsfHQ7c9WhXTeCAr7OS_QweJBswbFKV8s6w&oe=6B0C68A7"}, {"file_name": "screenshot-3.png", "id": "1056521275377047", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75603733_1056521278710380_5045420068564353207_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p-XpVTd3BkQ7kNvwESKMUE&_nc_oc=AdoI8bCRBsdMrPN1o_4h9hEWtABrLgEUQeTr5ciQMERp9DKvgZXv-eXvS2axyHyLxLc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRO3L_HQibYBpfd7VLD4-eeWcGID1yOTC9keNLUCppT5g&oe=6B0C5537"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "705343571987645", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831968_705343575320978_6364866043747351745_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjnOpSN5zgMQ7kNvwEukG7E&_nc_oc=AdpcsYMIOfy5aJ5y2NtDON9n7GdKOmejDxbNPTNCnkFn7TA27hsEOlvJVrlr8SERrzs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCRJ8oh0lcCCSAfi-1KCQDSsd8lOlqbuo5GgB0mwqiaw&oe=6B0C6C4D"}, "display_name": "Escape from Hadrian's Wall", "keywords": ["escape", "puzzle", "fantasy", "cards", "adventure"], "long_description": "Escape the Dungeons of Hadrian's Wall. Your liberation awaits!\n\nEscape from Hadrian's Wall is the debut game from fledgling studio Jim Gray Productions.\n\nIt is 402 AD in the Roman Province of Britannia. War has come to Hadrian's Wall. As a prisoner within the wall's dungeons, your journey of discovery begins with an unexpected alliance with a stranger, who provides you with magic tools to navigate the puzzles and obstacles throughout the fortress. Your task is to find the mage within the Wall, who has mysterious connections to the war, to the wall, and to dark and ancient magic. \n\nElemental Golem Card Puzzles\n\nElemental Golems guard the passageways of Hadrian's Wall. These Golems must be defeated by summoning your own Golems. Using a set of magical Golem cards you solve puzzles to clear your path. Your objective is to dispel the enemy Golems by bringing each Golem's strength to 0 while preserving your own. Clever use of your Spell Cards and positioning will help you overcome your opponent in these battles of wit.\n\nAn Immersive and Magical Dungeon\n\nHadrian's Wall is host to many puzzles to test your puzzle-solving skills. A game built exclusively for VR, there are many unique gameplay moments that combine the opportunities of virtual reality with historical fiction and medieval fantasy. Play a magic instrument, mix potions, and blast spells from a mage's wand. Master your skills and conquer the secrets of Hadrian's Wall!", "short_description": "A VR Escape Room. The year is 402 AD. You are a hero of circumstance - a prisoner caught in an epic battle between good and evil. Exercise your intellect to solve magical puzzles and battle Elemental Golems. Decode, decipher, and delve into the bowels of a massive fort within Hadrian's Wall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jimgrayproductions.com/privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "Jim Gray Productions Inc", "support_website_url": null, "website_url": "https://jimgrayproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "
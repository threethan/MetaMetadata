ePortrait.png", "id": "478985681626700", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974834_478985684960033_581840819204097328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HX7wSKUqx1EQ7kNvwEykora&_nc_oc=AdpRaEbNkY-HHH6cr8cTjQf7QClIxDAvRhYCe28rX7eKzaPVAKUrgHvZdGCkrZzoZFg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cxAdrarCI2sZRBoHCLKB5YhvdnsQNq8pigjDb_f5O0Q&oe=6A451205"}]}, "id": "671993942397023", "locale": "en_US", "screenshots": [{"file_name": "screenshot-4.png", "id": "495748173309750", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75395604_495748176643083_4039137674618411903_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrfuGMbygmkQ7kNvwFIHrnj&_nc_oc=AdrU2Awrhng_LwymOxgiZQkycIPfF4g1rUUqokB5zRQMWa_N0pO57Oiv8WA8FXvNEBc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_mos390TKL6ZV-QSaaJRxll6aI-wsE1kQRRb6frhNBTQ&oe=6A451E33"}, {"file_name": "screenshot-5.png", "id": "1648277869076964", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75556795_1648277872410297_3678664582315111403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zwee6I6zra0Q7kNvwEm8ev3&_nc_oc=AdoWucjAi9zjlvJw_agriUfweL6f6F1fzjYaBkEjMkXXn-L6LCze1M1JOBAHc5sHPIo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZRu1FqN4Su-n83AMXay7HxZKgwjjTbuEBjjy2DmQeiw&oe=6A452058"}, {"file_name": "svcreenshot-1.png", "id": "1421653888532081", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031544_1421653891865414_2226925184782531414_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qRSb79JYh40Q7kNvwHASde8&_nc_oc=Adr07REo_MSDxzri4NIQNrl7GI_fbVho_C63Z6_M3V8W9Pagz0taiwMWgMQzRWYIAQs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FawS8RWGzF3Bcu_f5g8i-JuvvvSd4VNPzfcn8Zpos3Q&oe=6A45393E"}, {"file_name": "screenshot-2.png", "id": "527298313190518", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39003230_527298316523851_723403163565559702_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qqld1eXlFIUQ7kNvwFIspbp&_nc_oc=AdpCvNkxGPERHcKJx2EmZIwQH9BjjyakLiCpE732zixwXC8Qj1OvYf3HFrreS2CeUUU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81fDdEVU1GBTMiG7NOxXPbzONQaz8o5VRnzUH-kw9BVQ&oe=6A451DE7"}, {"file_name": "screenshot-3.png", "id": "1056521275377047", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75603733_1056521278710380_5045420068564353207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bzLiaOjB7qIQ7kNvwFlkPFY&_nc_oc=AdrwULb3DDq-EuxL5Z_Vgl2FTST36VhNbm__9Ow1fO7UANDhAH-27ieZ1X4Hmmy413U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Sv0kQPAhcJ8CxTpJnsQDFHlhqGG6mShLd5lD1MXsE2Q&oe=6A450A77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "705343571987645", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831968_705343575320978_6364866043747351745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gldl8lpW2WMQ7kNvwH_m6q0&_nc_oc=AdqtckXa8HeSBypLvS725sQeDRamLn4TIMvT2GtUPUdmtmVGsb4E9RbsMkD5N-Yr99I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9w_lSiC7PW06JDgdDr3qNOT3DiIjbNslcG0-td-mYGuQ&oe=6A45218D"}, "display_name": "Escape from Hadrian's Wall", "keywords": ["escape", "puzzle", "fantasy", "cards", "adventure"], "long_description": "Escape the Dungeons of Hadrian's Wall. Your liberation awaits!\n\nEscape from Hadrian's Wall is the debut game from fledgling studio Jim Gray Productions.\n\nIt is 402 AD in the Roman Province of Britannia. War has come to Hadrian's Wall. As a prisoner within the wall's dungeons, your journey of discovery begins with an unexpected alliance with a stranger, who provides you with magic tools to navigate the puzzles and obstacles throughout the fortress. Your task is to find the mage within the Wall, who has mysterious connections to the war, to the wall, and to dark and ancient magic. \n\nElemental Golem Card Puzzles\n\nElemental Golems guard the passageways of Hadrian's Wall. These Golems must be defeated by summoning your own Golems. Using a set of magical Golem cards you solve puzzles to clear your path. Your objective is to dispel the enemy Golems by bringing each Golem's strength to 0 while preserving your own. Clever use of your Spell Cards and positioning will help you overcome your opponent in these battles of wit.\n\nAn Immersive and Magical Dungeon\n\nHadrian's Wall is host to many puzzles to test your puzzle-solving skills. A game built exclusively for VR, there are many unique gameplay moments that combine the opportunities of virtual reality with historical fiction and medieval fantasy. Play a magic instrument, mix potions, and blast spells from a mage's wand. Master your skills and conquer the secrets of Hadrian's Wall!", "short_description": "A VR Escape Room. The year is 402 AD. You are a hero of circumstance - a prisoner caught in an epic battle between good and evil. Exercise your intellect to solve magical puzzles and battle Elemental Golems. Decode, decipher, and delve into the bowels of a massive fort within Hadrian's Wall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jimgrayproductions.com/privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "Jim Gray Productions Inc", "support_website_url": null, "website_url": "https://jimgrayproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mode
ePortrait.png", "id": "478985681626700", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974834_478985684960033_581840819204097328_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hUaCn-HSZUQ7kNvwEopFly&_nc_oc=Adr02-PPeLbfBSzY6UuqvgKaUx1DXbFumystNEKLs0HZpgf9zxcUmfi4ii5-zKMlvxI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O8CQYQ0Aqarb50DnkWx6LPygbnaZle9q-_08LTyWO2A&oe=6A1AE205"}]}, "id": "671993942397023", "locale": "en_US", "screenshots": [{"file_name": "screenshot-4.png", "id": "495748173309750", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75395604_495748176643083_4039137674618411903_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EGKt5uROEIQ7kNvwFXhCwq&_nc_oc=Adqa126HS4pf-1gSVMkhwPp7h4x0FtnakKK7UPhpEENyHaAOPXIaQYRbC9KbzweAhmQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KJo0jBvz4QFRUaMzvUqeoFnhDWJXsBjO2OGBG_mSJtg&oe=6A1AEE33"}, {"file_name": "screenshot-5.png", "id": "1648277869076964", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75556795_1648277872410297_3678664582315111403_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ld8aXzqD55sQ7kNvwHhU-hQ&_nc_oc=AdqOKt8CJGkLXjIzERU8m6kNRI-04k9CCuqWcyldb8vfR9mukygvxe5usrXyCDhV8GE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5JUYMT6mcq6CXc1lrdSdGm_gspAXEbpndRsON_ANOsFQ&oe=6A1AF058"}, {"file_name": "svcreenshot-1.png", "id": "1421653888532081", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031544_1421653891865414_2226925184782531414_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KS_9b6SYbrYQ7kNvwFsJ8re&_nc_oc=Adqkpx3RjBgNGK20Arz3-A7kfDoWJD7yGiG7FnFsBwWkFECWJd85yCUIikhn5dfNHyA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FGRGF5hDskEkbpTMJ5RCMwniZaLorLr1dpqgiG_8msw&oe=6A1B093E"}, {"file_name": "screenshot-2.png", "id": "527298313190518", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39003230_527298316523851_723403163565559702_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAI5bVklcpQQ7kNvwFBO3pw&_nc_oc=AdpxpEIoP6jRuvd5lnuv432-OVChCuamLQa7hCidnIxlXtHnG7Ruf-rnQR92xaOmdqo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ALsXLh6Vet0myvEXvW_UHusErblenVbPa-yBSkzb39w&oe=6A1AEDE7"}, {"file_name": "screenshot-3.png", "id": "1056521275377047", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/75603733_1056521278710380_5045420068564353207_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mjv_NBB-_kQ7kNvwEpiQkL&_nc_oc=AdqyxuZ_SwhLQqd4hJS3BhJGusEsxyHzeNCvSLgRECV0iv3wVUP0F6dzcfWTofDK8r0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RYgyd01Qdq59ZpfCNGngxDBiFAbf61nLZ3b5vUE36HQ&oe=6A1ADA77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape2.png", "id": "705343571987645", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491831968_705343575320978_6364866043747351745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gritkz_teG0Q7kNvwEpQf-U&_nc_oc=AdouURuJxFdysiXiIoimx3U5O9BEchsCKqL48h5eMNDqC-K0yjKcwIuOfZ-JYJLYvYo&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4b7mkl3kfn1iXF52NN1Lau0md09VDwhrR4INlBvC7WfQ&oe=6A1AF18D"}, "display_name": "Escape from Hadrian's Wall", "keywords": ["escape", "puzzle", "fantasy", "cards", "adventure"], "long_description": "Escape the Dungeons of Hadrian's Wall. Your liberation awaits!\n\nEscape from Hadrian's Wall is the debut game from fledgling studio Jim Gray Productions.\n\nIt is 402 AD in the Roman Province of Britannia. War has come to Hadrian's Wall. As a prisoner within the wall's dungeons, your journey of discovery begins with an unexpected alliance with a stranger, who provides you with magic tools to navigate the puzzles and obstacles throughout the fortress. Your task is to find the mage within the Wall, who has mysterious connections to the war, to the wall, and to dark and ancient magic. \n\nElemental Golem Card Puzzles\n\nElemental Golems guard the passageways of Hadrian's Wall. These Golems must be defeated by summoning your own Golems. Using a set of magical Golem cards you solve puzzles to clear your path. Your objective is to dispel the enemy Golems by bringing each Golem's strength to 0 while preserving your own. Clever use of your Spell Cards and positioning will help you overcome your opponent in these battles of wit.\n\nAn Immersive and Magical Dungeon\n\nHadrian's Wall is host to many puzzles to test your puzzle-solving skills. A game built exclusively for VR, there are many unique gameplay moments that combine the opportunities of virtual reality with historical fiction and medieval fantasy. Play a magic instrument, mix potions, and blast spells from a mage's wand. Master your skills and conquer the secrets of Hadrian's Wall!", "short_description": "A VR Escape Room. The year is 402 AD. You are a hero of circumstance - a prisoner caught in an epic battle between good and evil. Exercise your intellect to solve magical puzzles and battle Elemental Golems. Decode, decipher, and delve into the bowels of a massive fort within Hadrian's Wall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://jimgrayproductions.com/privacypolicy.php", "developer_terms_of_service_url": null, "publisher_name": "Jim Gray Productions Inc", "support_website_url": null, "website_url": "https://jimgrayproductions.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_mode
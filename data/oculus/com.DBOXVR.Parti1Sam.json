 Emmy Award-winning Visual Communications agency that has been representing architecture and envisioning futures for over twenty years.\n\nParti 1: Features Brillhart Architecture. An AIA award winning, research and execution driven practice based in Miami Florida, lead by Jacob and Melissa Brillhart. Their architectural work and furniture design has been published and exhibited internationally.\n\nALSO AVAILABLE FOR DAYDREAM AND CARDBOARD ON THE PLAY STORE.", "short_description": "Parti is a series of Virtual Reality podcasts exploring architecture."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.dboxvr.com/", "developer_terms_of_service_url": "http://www.dboxvr.com/legal", "publisher_name": "DBOXVR", "support_website_url": null, "website_url": "http://www.dboxvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "261819502621166"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1363989733693781"}]}, "baseline_offer": {"id": "1363989733693781"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1493226000, "status": "PUBLISHED", "id": "1363989733693781"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1528826497150423", "version": "1.0"}, "id": "173774239805862", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "bin
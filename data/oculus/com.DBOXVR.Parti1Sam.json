atures Brillhart Architecture. An AIA award winning, research and execution driven practice based in Miami Florida, lead by Jacob and Melissa Brillhart. Their architectural work and furniture design has been published and exhibited internationally.", "short_description": "Parti is a series of Virtual Reality podcasts exploring architecture."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.dboxvr.com/", "developer_terms_of_service_url": "http://www.dboxvr.com/legal", "publisher_name": "DBOXVR", "support_website_url": null, "website_url": "http://www.dboxvr.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "339872587963812"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12602290_1679939765635560_5031548612396449792_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wKaLpSxwM0EQ7kNvwH52f70&_nc_oc=AdrU1AG2g6y_eVQ5yBELKHPb-sq53kKz85A88JRE2o3IecxdN1PBV7ye3IYqZz-pi4Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWdpf241YCw79BNcsXOS8zMLkjMmDFLDQol4yXP0QohQ&oe=6A79D378"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Parti 1: The Brillhart House", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1493171753, "lastRevision": {"nodes": [{"id": "1426454087417997", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "
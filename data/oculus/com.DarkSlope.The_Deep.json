1.oculuscdn.com&oh=00_Af2HlDTG_PJZkqAQMj_-P0rwkkRzi6L5Ast2Yxnv6faqoQ&oe=69F0C5E1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_image.png", "id": "1338840764259905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619071_1338840770926571_6269814051083876380_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0vpZtAIiddcQ7kNvwEQc3tu&_nc_oc=AdqjH016T7Y_nVYP_u0TxAl8BLouDjL4_fgoEHOQpONk_UPeryP-7Pj6JK8OXUygh_w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3NZn1cCUMKYVkc5k14hXQh6lIr716SE5_iq65WtnyUZw&oe=69F0C0A2"}, "display_name": "The Deep: Beyond the Reef", "keywords": ["underwater", "exploration", "adventure"], "long_description": "**Dive into The Deep**, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, youngest member of the Nekton family of explorers. \n\n- Strap into the Vulcan Knight, a prototype aquatic mech \n{1242079381297479}\n- Explore ancient civilizations \n{1981481742613961}\n- Avoid lethal threats \n{681988514933906}\n- Collect artifacts\n{1532313101129389}\n- And stop a lethal contamination that threatens to spread across the entire ocean.\n{1087659246525233}\n{2745496312319488}", "short_description": "Dive into The Deep, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, youngest member of the Nekton family of explorers. Strap into the Vulcan Knight, a prototype aquatic mech, to explore ancient civilizations, avoid lethal threats, collect artifacts, and stop a lethal contamination that threatens to spread across the entire ocean."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.darkslope.com/legal/ms3000", "developer_terms_of_service_url": null, "publisher_name": "Dark Slope Studios Inc.", "support_website_url": null, "webs
n.com/v/t64.5771-25/491827130_1340797647579947_3807241488811760853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uq6mUv6dizMQ7kNvwEGUQWW&_nc_oc=AdpvbwnAIFUK9PnLD9XQOJXjJN9vmE70Xo2oVady8m6nnL5k5tbJbl2JvHvoaSt90Eo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-CtnC-ovUxaDL2aBnZ1jNiSWUpOGmXkYHT3zywzJ92xg&oe=6A297661"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_image.png", "id": "1338840764259905", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619071_1338840770926571_6269814051083876380_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tTstplbc8FQQ7kNvwEJdvmU&_nc_oc=AdquC0twACzH8Ez6CYzoeisXpZUZyKKY0vNVKFbisigOCEibAglqri_NkNxvINQY81M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lnShYniRBlUsBusuHfRsDnIgSLV0eNBl65XruuLs1Zw&oe=6A297122"}, "display_name": "The Deep: Beyond the Reef", "keywords": ["underwater", "exploration", "adventure"], "long_description": "**Dive into The Deep**, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, youngest member of the Nekton family of explorers. \n\n- Strap into the Vulcan Knight, a prototype aquatic mech \n{1242079381297479}\n- Explore ancient civilizations \n{1981481742613961}\n- Avoid lethal threats \n{681988514933906}\n- Collect artifacts\n{1532313101129389}\n- And stop a lethal contamination that threatens to spread across the entire ocean.\n{1087659246525233}\n{2745496312319488}", "short_description": "Dive into The Deep, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, youngest member of the Nekton family of explorers. Strap into the Vulcan Knight, a prototype aquatic mech, to explore ancient civilizations, avoid lethal threats, collect artifacts, and stop a lethal contamination t
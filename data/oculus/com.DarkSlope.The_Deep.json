dn.com&_nc_ss=7f20f&oh=00_Af9xC-_o87EdEh-R0RQ84TcozsH4hZ2HeKm8Xk7DKsBWxw&oe=6A219B0E"}, {"file_name": "com.oculus.vrshell-20251008-084104.png", "id": "1340797644246614", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827130_1340797647579947_3807241488811760853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XtQzkRTwWAQ7kNvwG24U6s&_nc_oc=Adosu6FwkB6Cjs3YE1uJfq97eldEtoPB2XRhGTM_dLjcN3TGgJaJfO3w3KtLQif1Dcw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v3Al2eS_HIrmnGL8ZKJwttFmB83btlT-B7oE-o_Ywqg&oe=6A218D61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_image.png", "id": "1338840764259905", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619071_1338840770926571_6269814051083876380_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dF9NoDzQnQEQ7kNvwH4dxRo&_nc_oc=AdqZstYOY8p7thrVw4LdLIwUQdROUTBMOrLvjc97g-0M3_bmYIrDVwcK4XCJLTPb9_c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hw_FnxR7j8sYs4bLEKu9oOtR58JDt-S5YlJOhgI7Tdw&oe=6A218822"}, "display_name": "The Deep: Beyond the Reef", "keywords": ["underwater", "exploration", "adventure"], "long_description": "**Dive into The Deep**, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, youngest member of the Nekton family of explorers. \n\n- Strap into the Vulcan Knight, a prototype aquatic mech \n{1242079381297479}\n- Explore ancient civilizations \n{1981481742613961}\n- Avoid lethal threats \n{681988514933906}\n- Collect artifacts\n{1532313101129389}\n- And stop a lethal contamination that threatens to spread across the entire ocean.\n{1087659246525233}\n{2745496312319488}", "short_description": "Dive into The Deep, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, young
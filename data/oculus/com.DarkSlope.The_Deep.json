dn.com&_nc_ss=7f20f&oh=00_Af3Ih0jSC1_7q1nlpYcbuqLYoNufVoL2p2PG5tUocg7u1Q&oe=69F76B0E"}, {"file_name": "com.oculus.vrshell-20251008-084104.png", "id": "1340797644246614", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827130_1340797647579947_3807241488811760853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwdSaoDFLckQ7kNvwGQn24K&_nc_oc=Adq_FDhYGz4-ogusRZGChfa8C4ito2E0X32_gtJ10ZlvG0twrPY5X_RrBA9CYAptzts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qrUHrC4Ik1mHtMB4GWLiRiIhytID8H4WBxJPhTRqGVg&oe=69F75D61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_image.png", "id": "1338840764259905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619071_1338840770926571_6269814051083876380_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ebCFQq_VQSgQ7kNvwHymP_U&_nc_oc=Adq69WmLx7anbX7mh88_0W12Rmn_bt4L1fPi1Cq88_L96gsg8A5KnzfFSYpEzutnxi0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JGiuzKnYQx4tx95lZZFHTuOjdqSTNxEW_W79kGvBshg&oe=69F75822"}, "display_name": "The Deep: Beyond the Reef", "keywords": ["underwater", "exploration", "adventure"], "long_description": "**Dive into The Deep**, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, youngest member of the Nekton family of explorers. \n\n- Strap into the Vulcan Knight, a prototype aquatic mech \n{1242079381297479}\n- Explore ancient civilizations \n{1981481742613961}\n- Avoid lethal threats \n{681988514933906}\n- Collect artifacts\n{1532313101129389}\n- And stop a lethal contamination that threatens to spread across the entire ocean.\n{1087659246525233}\n{2745496312319488}", "short_description": "Dive into The Deep, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, young
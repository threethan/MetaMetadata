dn.com&_nc_ss=7f20f&oh=00_Af5VgpqnIKB9Dm1H2eM8-RXqo9apuEJd0k6coA0H3xZSzw&oe=6A01F70E"}, {"file_name": "com.oculus.vrshell-20251008-084104.png", "id": "1340797644246614", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827130_1340797647579947_3807241488811760853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19l0zpvEwN0Q7kNvwG56ilG&_nc_oc=Ado-gBh5tIQR7kKTaKHp1Tc_bVDwUEzQSMdatj4Qr59445OsmU4Sf2KI031DnEHQ_hs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kdyKzLJq7ZT94-_toxndcMkTH-EZncCNrCA6UXa3OiQ&oe=6A01E961"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_image.png", "id": "1338840764259905", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619071_1338840770926571_6269814051083876380_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XeGlIr0G8wQ7kNvwFA5w39&_nc_oc=AdrKBTiKCQflaZCcWxVGFdlKhSfAI4zf5mLOjRJmkhCDt_d5tJEBrk2EwMwkC5NLMfE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48baf3NdMEKN5Le_QdP9-q64TvjvKgUrMx3hMD2hzaig&oe=6A01E422"}, "display_name": "The Deep: Beyond the Reef", "keywords": ["underwater", "exploration", "adventure"], "long_description": "**Dive into The Deep**, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, youngest member of the Nekton family of explorers. \n\n- Strap into the Vulcan Knight, a prototype aquatic mech \n{1242079381297479}\n- Explore ancient civilizations \n{1981481742613961}\n- Avoid lethal threats \n{681988514933906}\n- Collect artifacts\n{1532313101129389}\n- And stop a lethal contamination that threatens to spread across the entire ocean.\n{1087659246525233}\n{2745496312319488}", "short_description": "Dive into The Deep, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, young
dn.com&_nc_ss=7f20f&oh=00_Af5FUO6rhI1R2QYL0y855hLNMT0yjRrPVA3ZMBxVhrusdQ&oe=6A049A0E"}, {"file_name": "com.oculus.vrshell-20251008-084104.png", "id": "1340797644246614", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827130_1340797647579947_3807241488811760853_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19l0zpvEwN0Q7kNvwHEmEfI&_nc_oc=AdrBamgZQtbKKiVYgOuItkMGduAbe1okJlBbLQnm-xcg6JI0GksKermAPNvmfYygkeA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6xj5h02L1bVpcIBYbTy7w4x3azW-GJ-DAmKHwwcjxlEQ&oe=6A048C61"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_image.png", "id": "1338840764259905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619071_1338840770926571_6269814051083876380_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7XeGlIr0G8wQ7kNvwH6J0f7&_nc_oc=AdqQBFssSjPmVqPUCocHk-Nhh1bC7iGEgeEeDw2uoRT8vrB7GV6YiEr08bmuJYL_bpg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6OHQQapl_bz9GvmGCq8BqS7L5RbK9Oaw6d6sAk06Nqaw&oe=6A048722"}, "display_name": "The Deep: Beyond the Reef", "keywords": ["underwater", "exploration", "adventure"], "long_description": "**Dive into The Deep**, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, youngest member of the Nekton family of explorers. \n\n- Strap into the Vulcan Knight, a prototype aquatic mech \n{1242079381297479}\n- Explore ancient civilizations \n{1981481742613961}\n- Avoid lethal threats \n{681988514933906}\n- Collect artifacts\n{1532313101129389}\n- And stop a lethal contamination that threatens to spread across the entire ocean.\n{1087659246525233}\n{2745496312319488}", "short_description": "Dive into The Deep, an underwater adventure game based on the acclaimed graphic novel series and award-winning Netflix show. Featuring the original voice cast in an all-new adventure, you play as Ant, youngest member of the Nekton family of explorers. Strap into the Vulcan Knight, a prototype aquatic mech, to explore ancient civilizations, avoid lethal threats, collect artifacts, and stop a lethal contamination that threatens to spread across the entire ocean."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.darkslope.com/legal/ms3000", "developer_terms_of_service_url": null, "publisher_name": "Dark Slope Studios Inc.", "support_website_url": null, "website_url": "https://darkslope.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572822366109046"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3305445499618464"}]}, "baseline_offer": {"id": "3305445499618464"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760598000, "status": "PUBLISHED", "id": "3305445499618464"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24847479274883430", "version": "0.0.2"}, "id": "1504648790414662", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8572822342775715", "is_concept": false, "latest_released_binary": {"__typename": "Andro
enture, you play as Ant, youngest member of the Nekton family of explorers. Strap into the Vulcan Knight, a prototype aquatic mech, to explore ancient civilizations, avoid lethal threats, collect artifacts, and stop a lethal contamination that threatens to spread across the entire ocean."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.darkslope.com/legal/ms3000", "developer_terms_of_service_url": null, "publisher_name": "Dark Slope Studios Inc.", "support_website_url": null, "website_url": "https://darkslope.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "8572822366109046"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "3305445499618464"}]}, "baseline_offer": {"id": "3305445499618464"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1760598000, "status": "PUBLISHED", "id": "3305445499618464"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24847479274883430", "version": "0.0.2"}, "id": "1504648790414662", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "8572822342775715", "is_concept": false, "latest_released_
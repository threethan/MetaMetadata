2725225}\n\nA third type of puzzle is on the way and will be ready very soon.", "short_description": "Escape Rooms and Physics Puzzles with mixed-reality elements and lots of balls."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/lawstprivacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "Ryan up in here", "support_website_url": null, "website_url": "https://sites.google.com/view/lawstprivacypolicy/home", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["PUZZLE"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24427658443591459"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619608_1363628398272622_1023489302553981525_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PjeeF33edLYQ7kNvwF4pXpF&_nc_oc=Adlr52d2pPFXcm6uVIzxm3azwcdQY9_BwwaoWq5mbhIFqpse5K3DWElQ4C_JNwVgbf4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftg8_Jtwzeoos944B9W5zv0U87i1J9k6HkdUlAm1Lsejw&oe=699B012D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "A Persistent Illusion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Puzzle", "id": "377978390272490"}, {"topic_name": "Sandbox", "id": "1990104051447093"}], "release_date": 174775
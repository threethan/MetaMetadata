=00_Af6v2vkhq0iFofSzvCZ7eyKGBsL_2DmcXDHsU-KzeBsI5g&oe=6A05E821"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FQAfW2C2DwQ7kNvwEKIRpD&_nc_oc=AdpTS8uMBr0OZIR73RpX9FSesDsA-yKBOR_eKKeb9Khf33aXAG5mMrmoP-fsRV4-CY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c-dQquk3-dxT0AwuStOhpOsZvPwrItV0NW9pwUAx0LA&oe=6A05D396"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oWdOdxohOkQ7kNvwHFXQMN&_nc_oc=AdpEL9nQs7VazhVJrHDEU1e0X4DM9ZRiG6Yv5r5ftfclLAaMLTGpt0hCBaRZ4w52LZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dJTjfj1zz45jVTAVI8OV3Ad9m8MBpSzCVACoJSSv59A&oe=6A05E384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw92um3PXg4Q7kNvwHTPzBi&_nc_oc=Adpfd2HeGgt6omOtN1Wnmqjvemoy8cOT6QQMrxVU_0ye8ybWVjtSu3Tredy7phsug5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69KP5B3wwz1XPUvc_6zSW3T1FY_AdEOb0RRqnVrzVYOA&oe=6A05C0B6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
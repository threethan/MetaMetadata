=00_AQH6SMgofsrYGhShfUAHuRSI67l7-W4SJ8cGCIwC-2FO2w&oe=6A92C061"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvggBypZCdsQ7kNvwEYqBXN&_nc_oc=AdqjxQ-k4m50fEihFLk4Phc6baql5yMkl5E5hdcy961BiQMxoWPSRjBYtu31pABiz3c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGddb0L-oIlvbn4PQYiJPQAyHOAw-Vd_DFdWDQJdeeoqw&oe=6A92E416"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vh3SIxysCcAQ7kNvwEi9hzw&_nc_oc=AdokcFi8Mp9r4qWB0foi532ltqgSKINHsCCHk1aNVIHmxKKC0ItsNo09MpAX84FwS1o&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0Cif3iazytqfFn9FFQ85ab2l2tobFiSLyC0suGCJ36A&oe=6A92BBC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18Qag5XzouAQ7kNvwGvwbcZ&_nc_oc=Adpk7qyk5_XM-edE5LHia8eoJTYTMxQUcDYv0UEQuOCF2DVvp8457ibEXjk790EdUno&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnuYVwkBN6HGnKiD3Ali2XxQXd8Dnwsaze8AD4wpeaAQ&oe=6A92D136"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
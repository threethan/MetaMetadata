9434_6520162654547229233_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4UZjDQ4zvsQ7kNvwE56aPD&_nc_oc=AdrmQU0NBJEj_F69hP_ewSrKZBPJMhxZswGMze09dcDinLYdt0tTiVv1nj-wPtvmgNE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLMQ0GQ036zMgPQqFnzXVd8Tahdwdq6_3U6sRPIxmHDQ&oe=6AFC70A1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L6o11AjzCtQQ7kNvwEBi1o4&_nc_oc=AdoLmbyfpxYMVr4xZUqrmtaFEaS1GSX3PmEZdB-DtHzUDB_LikCAm-9qXx5H_4Fw2sk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfSZR7uM2DrvjHtNlJqvIBYC341ysvieFIlhLudOcTKA&oe=6AFC9456"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbDjGO90qg0Q7kNvwHFNSw1&_nc_oc=Adqp2U95i0JHfuE5hhDrcRtmaZmUuZZEdAgghqfKuZ2fAWsaCL9gtcZVCEhV7esO1nY&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2j46DkqWIc_qy4toUaqTb37dOOY2-1xsGS2Cw9AOXWg&oe=6AFC6C04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F4Er-ULSlmwQ7kNvwFtcaey&_nc_oc=AdqwqHJJVH9o2y6naE55eozaoT1MWCk3bWdAWgrlw5jeRNyXIQA9mNyw5uQvvl8Y8_M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTfJPH56Zpt-bcA5KN5K4pCY1AQxa0wWmZbW2dwnlvsyg&oe=6AFC8176"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4suWzI7JloQ7kNvwF0FJsb&_nc_oc=AdqMzGuJrgBZXca-aoWo18UAA5T5rBJKR3WqtFzxBNxOn-lY3
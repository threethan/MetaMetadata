20f&oh=00_Af9IkfJt4P0F8PWzmmBN_mNmfF-P9a4UxSi5fkZHK9_jiQ&oe=6A4681A1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=347p3RDSDpQQ7kNvwELS0Gr&_nc_oc=AdolYwoELRD6XBKNemPK5sRoqxrRAzy--lsz4s3pGPorP7sSs-EiL0W6O1wH9fgcERg&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1Ekpuor5wgYPR74y_5ZuiCgDDNnjdGawgkjaH8gr_Cw&oe=6A466D16"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8XZU_DZXlkQ7kNvwFXNKJB&_nc_oc=AdpYnlIKrJ8iQ8DfFEotC9xD5aU3njBELuu5DK-QqgAYvi7rdhR9wJ02ygHoWsggKHM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2Rwq2OIelxCyIGx07R6KSB6Rnsr9jd6g1tEIBVIAqaw&oe=6A467D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PYs_d9YpixAQ7kNvwEuouQ9&_nc_oc=AdoqHJo3kaeA025PWDuNyUCdpM3tAJLJaE41QTI1rqoGxPOpcwFpm7GFFt3pcqIjmM4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s7qrrH1mUnKDLqfdeW5oTRNdhcTGhldKBgNURlZ5Pew&oe=6A465A36"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EUTDRfrNb0Q7kNvwGi5OGh&_nc_oc=AdpMf4NMLuuWz2r3NaGYtjPNjD-Lvym7xs6VefHm41uz5fy8pKRAb1O2BIG5vhn66Qw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ywAVeWBEq-6mSQZVZwsuQcebIL9-gb_ULsAR-vZ1hAg&oe=6A466C6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625
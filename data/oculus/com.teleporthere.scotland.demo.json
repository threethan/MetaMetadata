=00_AfxflatPu-K8rmfRXJPw09-ZFQBbIg1b2TFTB8dIjFHvdA&oe=69C7B961"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yoc83WivvCkQ7kNvwE8iNp0&_nc_oc=Ado8B71sAjYSFTrh3NoPWYlxVbpThtS_vDw5A6n3htIUw1HJ4K2o7kQMeKjTlB28srQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfztKWJF-FfKEQDN0K7zVE4vP57Uu0bn1rUaOlyO6yh6qw&oe=69C7DD16"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOeU42vuW9oQ7kNvwGUD8UY&_nc_oc=AdoeTcTaMvKljxyPsQfSI6hLJZIjU9wXAgp6r8ujEF2vBlN9pFHmhRW7wu9Jpgzb0rg&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLhx03AR_JJXZbMlxh3fXsQ4m6KfP-ODK8oXs8tQgC5g&oe=69C7B4C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0brfM-XhUxgQ7kNvwHqa17-&_nc_oc=Adokbnzv01c1veAQKayFklavusEU9RhTckM78K7eJScdXj_SEyhTr_6iOprGltJyiVE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGwwe65jHaYnSg1km7QkeI2I8izw5iowah8auYvHBaFw&oe=69C7CA36"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohXZOthYRDsQ7kNvwGJsxNJ&_nc_oc=Ado7_MJp5sL0TBICcqpXoAmQMZmXiXCTFu4c1TKSA2zsn7AoyBdr5sqETc5extDyIXo&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHybRSpcJsyPa9FLOo7HOGmPj_OW-s-sxUzhs0bCCV9A&oe=69C7DC6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
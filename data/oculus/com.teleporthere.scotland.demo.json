=00_AfzbJdwCmr1lUaUjfjaQ2KNJY6yTwhP9KCV3kzxcGSFWSQ&oe=69CCFF61"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d20SJ5IKJJgQ7kNvwHRxhxn&_nc_oc=Adq79ndsrXN_UOeE8YeIuZtAc61u2vuXx66g0cWU76WuHzUi29VDrChcNijBkb44u_M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxVQCnT49Ruq9WNzbe7PFF-Cta3MApkLXKrZRWD-b94QA&oe=69CD2316"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=788I8XQEHwIQ7kNvwH9Beri&_nc_oc=Adq61ThSWwBwpS0HhVUn5iSMRHDZLeCMUxRiX1VTl51yUeKMBTHNpNM0YYVCUGLF-68&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwf_8YnjuWedVFOUuXtUkvvtNM3CCBu44nJgmRxE9Bppw&oe=69CCFAC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p4UyeD0jmnIQ7kNvwFMetfg&_nc_oc=AdpWj-KWgtoIJtSI2JfEHNlhnsvKnJFBOG9KZnMBnFCFfl263kgO-Vw1sKJl2M6Sfhk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ0ahVw2P1uQoNLx7-Shuw5EzJ1pE0ZCYjQgz4-GzqwA&oe=69CD1036"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
=00_AQJKWPLS7_EFXuEGORsjvinsxDF-b2zNJMIPi_Rjfi_QpQ&oe=6ABA85A1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMBcZR2SurwQ7kNvwH3rE0P&_nc_oc=Adqa-QwT1aYdTxzBTYhajIhWiZlGw6SB5qq3yYPKfCzVDhgBT-9XN5N_dOqJDxOUOHs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMqhKUctfFYeHjRY9RbTrDdb8gx5Hyr7dh34nPSNZbUg&oe=6ABA7116"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QHd5uMLBxXEQ7kNvwGnRJea&_nc_oc=AdqE3EV79WuxeqLcbudumbws5Y5Lokl9e5wKxmTujK7Wdl19DCwbWEiuQ91slapTjp8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdgYidzurwgQds1obmTgKNGL_1350J32xkqvncuit7yQ&oe=6ABA8104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzqyXTCRP40Q7kNvwGM8ydf&_nc_oc=AdpMlmSQ_4q_m6AKR8YKCcyb7m165Ee0R_Z6y8oif0bnDdmD0Dchg53fHTYxv8gs3Gk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa6Yz3oCeK7RhZ2szYW-_LSDoT-AwmbKBJ2NR9PP3xNw&oe=6ABA5E36"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dC_TpaLPV0Q7kNvwHHSUmV&_nc_oc=Adrsfc9d4DnfqcgmX4z6ZHFgTDN6iw5lzDKStqd7AreIG95hRCmBERe3GkiA22UyGls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqRaJvtXr6P6kTWhHDLgUfWSzZbggJYGF_q9JP3FV9SQ&oe=6ABA706D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
20f&oh=00_Af_RXTmNeWCFXOGzNIVR7-76fECKXZ_KKopLQpWz0Xeajw&oe=6A22E921"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdqEL6I0WXYQ7kNvwGRcxyN&_nc_oc=AdqMtSRBvpos2bVjyV5o3sH0r40aFuQl06rIynA8ieqcDAuGoLujk2PG9NXW9OBmqgc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AXHJHl5xe7OtdI80w863dLmGf6zrTd2IDIQ9yY4bPAA&oe=6A22D496"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I1vdtzaCfvsQ7kNvwHV_bhj&_nc_oc=Adry1wQem2qRS0JgmpPjmi1ae0xKWIge2qinVhb5Nh3PoH2LNPBqH61R6fPGiiYf21E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9r77GbqM0YPMCLlnLanL9M_-COPBr_qrarfujhBfIDWg&oe=6A22E484"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UtIQxMyXSeMQ7kNvwHNHwI5&_nc_oc=AdrJdyHSicegmBlC-Q2NO8Bz8KcFNYYkd-PPKTkDRoMK4k7NSnhixYS0m4AD3jtl0pc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CaV1xd4vqNgfQjCr5Vx9598-rgzE-IoCKSDUecVOmhw&oe=6A22F9F6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oCQFOJbaGq4Q7kNvwEWAeha&_nc_oc=AdpzVSvR-1xJG_xjZZqfg1nJRfoBF2IL3frz7VESU0cfe09o9-IyQob6hU9KJy0rDlE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WbpMqqoPeQ6oDjrW5HEjZxE93RUTh0JAEtvLFLTq8QA&oe=6A22D3ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625
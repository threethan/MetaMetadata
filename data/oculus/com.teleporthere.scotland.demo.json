=00_AQLv2G3JY4xaBUd2UjvD2WBGotthNHURuF8YvuGI9FdT0g&oe=6AAAB3A1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGqfalaasFYQ7kNvwEcIuIL&_nc_oc=AdokChnaKrTFBjPgMv1pAeFwyb9wySR1ZiEslSZKu8sApOiZwfixjUEofYcvDqoVh58&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLum4Gdu6UuQWg3S3NIwZKa4Y6DFjX2H0RyD-fHUb748g&oe=6AAA9F16"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-xnpEMehu1AQ7kNvwGHCK2S&_nc_oc=AdpDM7zTkUM5CrjdsYPNJEj4hVY9IYlxXuAoNEISvyMVPFNYeXqs9wP0cH8O1nMgATU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFwQpaZYMtk3hSfDIuzjrBsVd15JvTfblvMSyuAx4hWQ&oe=6AAAAF04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWuG6kBN6iAQ7kNvwH6Pd2X&_nc_oc=AdpaQQgBWfZ3mt8AaXoU0ECaNnpRWyltzzwV2EqxzwOYvTZZzt8_7fV9380lVKSW30o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR-cj8QkSZ5hCrNpTpKiNygGSxP-LvLCUH3uGqQ2Rujw&oe=6AAA8C36"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ug20m_2Iv74Q7kNvwHYE4fr&_nc_oc=Ado--mrxVIVf7QnLwBZzwXS2PlKT7rPd4OS6RXopi-bC79E8X7BC5eRiscGXDgQZZVU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOQ2oTBB3RmdiQuusucnGh752jYrptQjuvuA1xRl4Gpw&oe=6AAA9E6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
=00_Af915a2_RxWw_Zhk299Djz5MeI_lbnCn0mNvNs3y576YVw&oe=6A3FEA21"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2h5oFHZOcsQ7kNvwHKaoqM&_nc_oc=AdqePwrPyEwbUXeeiZ_4GfT7DdSFVtbXVPKwmHL0xCzxj7qwAh2SKv7xalNt460vGFA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_715AtvqHU_yhdIJ086ZPorRFzbqz7yb0xNnQ1pzsgtA&oe=6A3FD596"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fwNXVA3g7JgQ7kNvwFl83uH&_nc_oc=Adqu-d4r1K93GdWIX0kFS3fRom35r16o1clH0y3-c0v4iFwIL-cU518xKjh5G6oBpNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PZVmsNo54K6clF0xvu6AV-MCD99RpfzNJUw9BnPx25w&oe=6A3FE584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OLaFtQ9v1bEQ7kNvwEMZv6b&_nc_oc=AdqMbbfDhe5ONQmvue_HmksSiX8FsHSnYT_e6FQrIepLmboSYHKk85wCXXxx5VCFDNA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_x1ozPW7G9Am5DsiU2tG09Y103Q6Qu9EzFZaYIqNIp-w&oe=6A3FC2B6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
=00_Af7wn-tGfVqXclEjtc9JfjgM7OToeLPTVmx_covPpjZDgA&oe=6A0496A1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FQAfW2C2DwQ7kNvwF2FqFd&_nc_oc=AdpyPtQZdK1gaHWmgXB6F4U8L9cXhJTZST7PRv2t7m4c4p_F1lBcoK1iviMmiEmWfLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gNERoVIgZa4TIHGo9nm_FIBErzYYHAC2JF58VNSjKQA&oe=6A048216"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9oWdOdxohOkQ7kNvwE66QHy&_nc_oc=AdqRKa5VcrpRui9P5Jt6yGda_wU9iG6cAU2MVaNuNDe2jlMQSRNArrIxyqOLg7JERH4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DbocG1XRXzHESiW7KuLVNGz0tIeo-tf9AP7eIHov0Jg&oe=6A049204"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw92um3PXg4Q7kNvwE2BoCx&_nc_oc=AdqCwOpkmr82sF0_JdOAaTMrsVpEHpdkMzcJbbObBr1hFnAnoHA81RgQdxnozP53LE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6oypyoiIB-XoEhq1i6b5acWJNEofQ6DJzEVmcMzHeLEQ&oe=6A046F36"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
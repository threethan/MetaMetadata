=00_AQHq0Tp9DG9xYPrDUxEu9QMgxED21GAg5xw7IF2x47QxLg&oe=6A804B61"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_-LzRlBpNcQ7kNvwG7N-PO&_nc_oc=AdrK2SBL-E7F3M1IJkbV8ohoy7NX3xPECzIPy9TLk5AljIVl2A0-IRagOw_MU3RlpLg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlt0P9dM4ArDxkK8bmzq0Uiaiz_e68SJ_4_kzvaWL2TA&oe=6A806F16"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6n7wAKrWUQQ7kNvwE55epj&_nc_oc=AdoKq8cCJ4HJetyUkwBbN1oziAFS0ILzd_AgQl6GIGnukXRNMw9zz9r27J-WZ9kAFNs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGf-kssY-iu9mnxm4_VQOnGfY6m0IOdO3mYXVzvfCF2Iw&oe=6A8046C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpWjzYgdWxEQ7kNvwGNYYX3&_nc_oc=Adq7_BmevwiQ8Y0WWNhKDEgD43entyWKsvsVoBm3aNule0f7dlUEzg_OC-45lFQKCzU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEaoIGZONWLsuAVjq7LyCNIbjDa8ynbLHH9szupUGYpnQ&oe=6A805C36"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1MCPt9y0Q94Q7kNvwGBuM1M&_nc_oc=Adoqe9k3jpLW-PIugjft_nQiV2a7ne_OQXqSR65Wl423AiqG3C6wZcFvtOJWXeWQZpg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqSVZftqpFYefxu7qqKP_AJ7d1mtTSb7QRfK5Cf_yveQ&oe=6A806E6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
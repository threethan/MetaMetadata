=00_AQB2mQ8tCoos6m2YxlbwyFfYDIh645DAg0UDRBaewZk1sQ&oe=6A69E1E1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QiwvYJd8ER4Q7kNvwESh9QN&_nc_oc=AdoRSlUlr35bxJ7SENh4YXAdmS2Spp0HURkoVxgVydIaHNTaJS1eHviOwdbL3U740iA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw_lM7lCa-Ec62SmI4IVeyuzEiEvWDI4c7peV6i6PatQ&oe=6A6A0596"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lDdNbw2yx2EQ7kNvwEGsD5J&_nc_oc=AdonDNHLC-lNUHJ7alM18w2jeBcU7LUxrRg0ASFE0iJysM3zkhtNv2ie-BmPi0WO1ks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPJtQIfNUWFWQzYcl4nMIxtsOF3xFaqS2YoCwQ0FyXOg&oe=6A6A1584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvToavcYkMwQ7kNvwE6wxXL&_nc_oc=Adp9UINjJmXXyHnnuJSuxDybjqNWzM8rt4n7rrI0mCl6-eFv3OnpevNjugaHWYPmE38&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB2K1GTl4w6YOkqqj_OCtNUNGL1XNBpbUTCflidglvVIg&oe=6A69F2B6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEiqhUddlyEQ7kNvwFtwnwa&_nc_oc=AdpCWrlTT4fvnibVfBLf6w_mTdyeeJDVsg2Isjn3QC8IzJJ7WU9yWQz_67aI3cLd_gc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDFIARAFY8iVsfeC7d8ipRW_5ynG2Z-4jtKj4n69yhg8w&oe=6A6A04ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
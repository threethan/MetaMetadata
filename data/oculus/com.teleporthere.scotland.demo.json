=00_AfwDRTdYwfL3bWaTs0xrH2WicM_eEdGn70tSXglE7ZPkPg&oe=69C51661"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O11P9Nm-mKoQ7kNvwEeCD4e&_nc_oc=AdqgBxnrufzNtfEigO1LTLJYbeJHVq0_QOFzSk9x4yqwB5fie_7ghvo9Wq21i5IxUVU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVAcOHdO8vzyQQGzOLBVhwO2i_U_IrnqgUTEjsxVFCSA&oe=69C53A16"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YOeU42vuW9oQ7kNvwH95iNi&_nc_oc=AdpzNomhBWtcSpaXG9ghwKz1dKIU8LJUQZdYCougtguGXXps_u4NVBDyrlm-R7326LA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCeXTmQnx7ebpima11EltysTXQ1JJXdIrMekiSRFyu-A&oe=69C511C4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0brfM-XhUxgQ7kNvwG1-lI-&_nc_oc=AdpopN_xXhOcPq1aSqagDpnYIVJPME-87t64mZZ49l05KTzo7xlOGM1HhQYska_0jww&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx71gqcmukSLXe2NFIZ_ierhvol8KuqZtZ9qWnsqmqCoA&oe=69C52736"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohXZOthYRDsQ7kNvwGYmuSE&_nc_oc=AdqbTrivHYzg-6JemVm8xqJ_9ElhG4S7fYqQmusc8tLuoVX20SwhMSHjhFlF8mUUyRQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzOOrRg_ToU1_qSWUG7-n8POMKQ4zCd015AHldKAuos8Q&oe=69C5396D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
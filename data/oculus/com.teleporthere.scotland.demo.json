=00_Af9ZipFVgea0SQ1WZsbbUokJ-dQ4emO3w-I1kuXQrxopOA&oe=6A340CA1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EW78W4tiZl0Q7kNvwEcMgM7&_nc_oc=AdpteEauckQ0it_6Ms2JYQ1lZAoi4X1n4pmLDqeq8o3d65-NS8mN_jj6YMWczadfcf0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yLkjFMzEqAGZrW_abmo7QyGoMz7yD4rj2JhqAKwM0yA&oe=6A33F816"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GA56lcDx6H4Q7kNvwEYfyJo&_nc_oc=AdoxB8OJY7oSVhz6UcMtAMzZUtAfmZVQ16aqVWflBzGKVLs8BrtMSjA1iaKarhAKiC8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HyR8pHQZmjQ6qxRy1EWJsrdunfMbGTp1fNOEzKvnmlw&oe=6A340804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5L0xGPJJZ4Q7kNvwHhGbSn&_nc_oc=AdqxuoAjy3PtuCK6tZjz72dPHAS_xf-O7os3pLm74Y2J9-GVgWIgWumM876mXEkOVe8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_IdLf7uiynPcoaadfLHogPUGv-G--xW2pvxqyOE6Og2g&oe=6A341D76"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
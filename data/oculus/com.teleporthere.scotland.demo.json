=00_AQHi9Ewrh-RDuXpFLeN4xh2fFAbhpvtaNhVcdTlfl8kHFQ&oe=6A9411E1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvggBypZCdsQ7kNvwH9iyuE&_nc_oc=Adrzv7EG6m6XhGvqtGQ09h10p9VB2Ln0PY-LNoybtF-dJpBkVWitaQNT1BZAP03cpAc&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIJh5Pr1JsLbMTjP5UJnRaePr2y5fp01DXFE9NCFzxIQ&oe=6A93FD56"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vh3SIxysCcAQ7kNvwHc0ZwQ&_nc_oc=AdpKoz4RxRgA9ZWk6_v7SgbWlZY70AkNM90V_o5Tg3a_Wx25Lbi8srV-HzRGLUFuU-c&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvW0gHy7qG0bir3--j2PC1Owh3Y3pvAf7YTJ3K0HCk0w&oe=6A940D44"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18Qag5XzouAQ7kNvwFc4YDU&_nc_oc=Adq1zLIUO-jj9viK9Zirma1Yna-4h-SLlHlUMQHJC8jKzvcm_slY6ETmSfdTpFx7Cwg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFmziR-BirAH0t5j1oXpa8Dv8d42u4L8ou5hScmawtrQA&oe=6A9422B6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GG5kK75dUwQQ7kNvwE-D_f9&_nc_oc=AdqxM5BOM_FSDyd6p5uQrz8CbqDUrRB4vj12S6E3XZBVsjLxFP_0JWQozz8M77y-nQQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE-pAtgcMbEObN-YcD2UCXhj1jrhWbtMPyXEeMRBQowzA&oe=6A93FCAD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
=00_Af0jM3Vi6c3o7AfVyDgeojWs7hgWu4UzhEt0beMv81I1JQ&oe=69DE22E1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uN-kgGd1jfIQ7kNvwHmIQh4&_nc_oc=AdofZTy93NfTryQbnvzCuEad3jIq5ZL9Fax2YOf_q1Jrv-f5Ui3rQ3mF8OeEzn3Nue8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wIKjvCydEz8U92WCZ5p2imgki7TG-PE6nQlYxBJSbSQ&oe=69DE4696"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=83pnPQNEikgQ7kNvwELSLRD&_nc_oc=AdpmJTaGyzN34uGf5skX76hnMUsu9KLiBmYJ64oiVNc3pFYkXDJNDdZA3jbkhJue1rI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HU63nn4OwAirQM8IQIciOqKQ0pq2vYpTQKy9WEZgo2g&oe=69DE5684"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkeQI48zvVIQ7kNvwGw2Ryo&_nc_oc=AdrF9BPqc2KgkBEWJyHpYo8HUXLr-qVTqPS_M3WKJ16QHqYZokGOw-SUT0gLC6FksfI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-uhlzTN5vAxnY9kta1UP1jilU8zZFf2g-w5nVCquNDA&oe=69DE33B6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dcbl4ThSqqYQ7kNvwFBlJvw&_nc_oc=AdqN6WVC1XYN7LikbaYEtcVpjF5cfYZJjSvTOo8as4mWDvxbTwVt8F6iXuySSvG11xE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Pf7BKaBqhOxmFFZ1FchPOT68LOUU6wlt3eHoX6JK8DQ&oe=69DE45ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
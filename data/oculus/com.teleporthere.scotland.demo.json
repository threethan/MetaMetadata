=00_AQEtD742D9qtBxY5-frueMP_bK2iicH9wt65pJ6MHCXpRg&oe=6A720321"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bQZOYtaNQ5MQ7kNvwFNqHrZ&_nc_oc=AdqlmJvG9miZCIXKN2d376va0IQHwQHdcwv2yiByrQlQHqp2rtoE2cNeQNyNsJU4N50&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsCX8-nfAPrWAOtKtOtAx9DFS5kZ1bnDUFthzXfr0UxA&oe=6A71EE96"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-zjjexUizEsQ7kNvwETHX3-&_nc_oc=Adq0ClpEw0BSlhDmtrMcfKHwLZ4iTBHBBxfRPlb5b78gkhL5JPnGSHmxdyH6fTZexRI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFE7Ey82KeDP3QLri9d2jAf4JKBRvS8kwafy9RvnFiXBQ&oe=6A71FE84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONgazPFcl4gQ7kNvwHq40Pa&_nc_oc=AdpNX8tat9kx05mG0-Pp_SW-DlEwxPQTm6qaE4KBsfePBdn7Xjd423Fftg2dMG34rLo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEA9pbq8VMPSx0T1a-nLH5WI5pi-kYetof2pc9hD_Ik1Q&oe=6A71DBB6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fPrFb7JLp50Q7kNvwFnAWHb&_nc_oc=AdpwaqWAp_TS04WpYps-t_5rjN7e8xQDdQHIZA66a04BTO7JdCzWGE6KeEny8SCDXzg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmoYjzhKvZxrwEKxV0thMIg_Vg0E3v3VdojdNn9NcjMg&oe=6A71EDED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
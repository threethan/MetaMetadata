=00_AQAV1yY7e0xct1Nxm2HdrLgIsW-y_uGzfbIntqL5zGChzg&oe=6A4A7621"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iC3J5oFikXMQ7kNvwHQMwZy&_nc_oc=AdrijmKSsBbnkVZ2k09MsPasNLGkH_wLVeETmJ8UbutcKQjUOHvr8YsO8jQyikRUggA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFptWKVX8mCjuMsihzunazeMMEpsV_soYYZVlJeFJ_hA&oe=6A4A6196"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llWI0GPEascQ7kNvwFrBdN2&_nc_oc=AdovLSg5CSw_6UXLadeW6ysIGlHTOD5QF3lHU_jTlTF4wV5IDfL22kGXOCilhYu_qw0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDEcg-jLThiHb-_SnT92yyuGGWM8ktICGBEefOfFiOqQ&oe=6A4A7184"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhXmymeHOSIQ7kNvwEDb8Zn&_nc_oc=Adp_izKs2UzyT6C7TYTtODFFBXll-WRWohqskN5j--t5PXCMQSm9fxloAlcvNnGQSNI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArjPs_YXlo9_mv_wGXBp2Q_JB4kOFYwIzQDVEwam6zvA&oe=6A4A4EB6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
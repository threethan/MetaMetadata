=00_AQQfgmLxCiE50Q6BUeRw1QbBMhwIAz1MPWzK-BoDQKqQzw&oe=6AEF41A1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9n7vgB11L1QQ7kNvwEqnzub&_nc_oc=Adora0RLmWsINg4EFERqpGBzDAZRWDoFwA-YfV3WvEeKCCCVpWfBXeclC2WQVl6816Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbaMRJGdQtctbWj3uhjkD-v3CeSYZ9Ug4uzL3t0e-8-g&oe=6AEF6556"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f7152B4937YQ7kNvwGI4_n_&_nc_oc=Adr1-aRAj4qdLwZ-ud9GDQuamiSx8idqDXbafJMXkPS8iw3E-Mrg1yqWK5_8cRQPMPA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR4wyT2MHDvYZMaxUw6uRCpHatq3Q9bBD-3jPHaZj29yQ&oe=6AEF3D04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pC8fp0vfz7AQ7kNvwFpw5xD&_nc_oc=AdrjWwC7VJF64pnRTJkuTi_uVjlcipEzWUEw8JekMNYIitcrDGccgJvQtA1y6xo0Hj8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxaOC1j_0f32ETIFLgaRHQlAoRmywi_iTNBePtLr2-fg&oe=6AEF5276"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZUlSGC5WWoQ7kNvwEO5KX5&_nc_oc=AdpFLhHHrfE1M6pCAPP8nPB6FRCLtkOjWN098pAWwMmrhjUFBQipuZ4XS2mWW0zpc1I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdmNE5FRkdHbRPTyETOTPGTUmfGmCpvdIJLO0KeSlqVQ&oe=6AEF64AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
=00_Af5QBM1tj3EaIYfB6CyAH_TDlANoVWG1EgP1XcUmAbRCkg&oe=6A09DCA1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lF3U_DfNnEQ7kNvwFuyQVQ&_nc_oc=AdoBuZ8_PrbnV58br_HgdqoHkZ6rlfi6eTFzKzgBjDhmdnHkQhViVIIdqHz4EpDBW2s&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5sW1bMP4xPtDZwvBywvTtbQVyvrOMuryLDB9-V3gz0KQ&oe=6A09C816"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYhg6h0bxwUQ7kNvwHKE1-M&_nc_oc=AdrouNppK7bkEZsT5wNUkeTAaftpdspRq1QRtWSqF4yZdLgIjhNAX5JjfceeOGjPvAA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7IpIai-EVKsc17GKN8s_HGn2LKfz5zN_NjmJUtI5MaMw&oe=6A09D804"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TqsN1FCtgJUQ7kNvwGvA-Jz&_nc_oc=AdoLEbR6f9O2jF2HRwUHtD2P6A3l8tWZF1e3xttt5tyhUR1yD2RUlHzlypX-mUUvytg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vbYxsJ7mgwqrIbVyxEVbz7DgghwDe259p1kfq8QvEtQ&oe=6A09B536"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k_alw4cFDa4Q7kNvwFMNBUD&_nc_oc=AdoW56DxP8YMm-7lIoAsqFSA3zluA3jvwbKK5L1yr0m0h9ipeqaF12deiwOD_XpYhbw&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bcmbCTmU9OWo99dNh8Tg1LzC4F1Tunts6QPPVF7hVtQ&oe=6A09C76D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
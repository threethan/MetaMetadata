=00_Af382IwgF9piSAwPINGMe0GtEHdQmRQ2BEh1Xt0cWNW8og&oe=69F37321"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT9XE52bnHoQ7kNvwFsf4Ka&_nc_oc=AdrGWhMmSDhyDUMCYmf1qK0iOAMOWpSV6iL6kAB1i_zHGVPdSqnC9W5aXtK0clVGHI4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3PjBKVj58d6-nWC3d5AkGgTjtYOwcr0BOz9VeypgdHJg&oe=69F35E96"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPGoZKSuQewQ7kNvwE4C6r6&_nc_oc=AdrQJudgLsVZE4eZ5bVHvOptJOCEdzoVbo4DSBEYebkP3OC108zF7HJP9WMjbtqILTI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0FlgYUuKt85DZ4dreq-sUly7Kl_Yyk2bqumv09lVzCsA&oe=69F36E84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9K-8sRu_kYMQ7kNvwHiy4Rt&_nc_oc=AdotyFfrnSn8hJw9FBgGsA537cqqdSl-bkIpqnm5MSquSLCX5burbrber1boirtQ7iQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3ruijftoPgrpM97qv5SDurwb_-o1W7rr75b51FZhQXfw&oe=69F34BB6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kDxBFxCTmcIQ7kNvwEz_sVb&_nc_oc=AdoT4Kdh5zMVXYqiQguw1y4WYIuyf36h2pbeKD-r9rKqrdunpnCgINqp_uT4L_LSNsg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3-XLxj8WhbMRmhvJVGV8oXvUIFnuSe4ZCgkbNiPhpbNA&oe=69F35DED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
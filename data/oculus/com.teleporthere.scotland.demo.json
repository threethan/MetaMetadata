=00_AQPX7-_Kvo6p-VvWyjgPZ9jiMVDg5rlSRToNfaWsVAc0PQ&oe=6ACCFAA1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLjH859PsYAQ7kNvwG9NLvo&_nc_oc=Adp22GS-IK3oelFRipBIOqBCT-HwNYLXmdHHxVwEcpEJvMu6c-UFSvkA3Cv9QkaVneo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN02yEGRVtp1vU3fvTI5DeCTC5oMI0lLZId4nGmUkFKwQ&oe=6ACCE616"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9TdBEbgzimwQ7kNvwEl3o3x&_nc_oc=AdpX5Kt95tqdXqJetXNRLGXeNfqugfMGapZFXPOIyY0T62VD8MPJoUnWTnWuJg8Mrxw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORAqKC6Tjvwus7baxt-K8yCIw5qz-iCcT1sUqJyNEnig&oe=6ACCF604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_2OlxKkuzsQ7kNvwHOPTdD&_nc_oc=Adpw2TQ2XiAsG-68rf-Yp_YdZWbTpq7hsqG86Xant3ZQGIioCGu7TItO05mncR5uAPc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMJjC1jfLY3QcFo5Ob6rYSrUpJdqedqsP8uWQKwksuBUA&oe=6ACD0B76"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
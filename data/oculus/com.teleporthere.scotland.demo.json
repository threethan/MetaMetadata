=00_Af-Y0X9KmV34vKeFVnYdD47gFAAnVxdc1Hx4FHVMgNyD9Q&oe=6A243AA1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdqEL6I0WXYQ7kNvwEJl6tH&_nc_oc=AdpII6dhJNTA--blAV8p8dhVUP7rvYeChG58AYvDgAlHeQAGeHB3dGtqKqi9G7vPj8I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0Tpkf4q0G2xkhlozzN8WCtSNOUOXst0huefHnzQtZeQ&oe=6A242616"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FcxoXG17g-YQ7kNvwEoDjk-&_nc_oc=Adqw8h8xOcrsy6tlBb2R-JdKuMqFX2D9Br2v3NvznZ1-fXcQFFE7a2Y9XqsTC0KNPOc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84DFacCWSsxG_mCsVeaU0dAM--qL-ZVDKSE93z-tFDfQ&oe=6A243604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_miiSA1tMwkQ7kNvwFSLBQJ&_nc_oc=AdoackPPDbr_hiqNWuQPocn5507aIewGW68oTUef-S5qdOP61OIh34pso2fZRLIGkc0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HBv5KEQu5agGBD9Uexf227ZzY3Pp8z0zbRLn0B3pVPg&oe=6A241336"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYrWA77wFdUQ7kNvwHyb42d&_nc_oc=AdqC8Na3ailSLzGnSPEn2dj4SFyxeCoHYsv-uZXO4EYOkZjN7ZBRIYECUZMBEQJfxCY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-v5YpBC1Bn28_WFloAGdoUBbGIRBNW2ntID6Q_nCkrWQ&oe=6A24256D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
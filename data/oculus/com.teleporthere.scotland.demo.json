=00_Af75T1tTq2M9O9QIc2FHsluDTAGAI2TjEpmPolJ0cxNZkg&oe=69FB5C21"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFTn3WCWFL4Q7kNvwGVjIwy&_nc_oc=AdqmmZAxa_bf1KeKx47afgRLLmq62KURfJbghHkKO09PnLeFB-OATg5Of0LjNF4t-gQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DuV0EZmeKamoe0habfeWp_lnlQ01GIoLiqK4niaPkhQ&oe=69FB4796"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDxfmUvEHqcQ7kNvwGYKP-N&_nc_oc=AdomEMAA_j50U1e_AJuAkuhjsM4mAb8Y8E_ltC5V60CU3aWV6yvDDWFKZBghh1EuClI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WMBV4KBdbB_XKbCqaofZWo_N4s0vLqOdthpyaX0gRjA&oe=69FB5784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrKJXrylLKUQ7kNvwFoVuYb&_nc_oc=AdqMT_lM4zDd8yAorX_i9CVtdOXjmDiVeLqJThyShwyDLyZtvyhhvBP3G0zOvHq2J5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6F-dr1aKfBZS4K5T_teoNG-Jf9DfFZZO6zQuyymVqDqg&oe=69FB34B6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9nctaFycwQQ7kNvwG85VL-&_nc_oc=Adrk0LwEDX04BVZpNbbEq6rCgYaEd0QsJP5leKwMHp5Kxwjo_nfztMRVD1YbPHYuXvA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VvJuZih_AVqu1KtgJ9AbZRUtvOtJw8Z588yiDSbEhYg&oe=69FB46ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
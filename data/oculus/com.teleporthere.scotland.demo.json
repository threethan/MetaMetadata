_ss=7f20f&oh=00_AQERbs_mrf7VvMcA5H9Zf7y8sFQgxjucIMVti3ZLZBqA5Q&oe=6A8ECBE1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqUxa0XGPAEQ7kNvwEexVRH&_nc_oc=AdrA85tKfZTWZESIOR2xisw4aZ81Djdkqub0d2VYsDtzZlVZbGmVc7z8oYrojFpGZmQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGMu4Gpr3A1ZL_KA_nDVrEqTC-eZTcuCAaIa7x3f98Z0g&oe=6A8EEF96"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhmYNcK4J18Q7kNvwHS4cdm&_nc_oc=AdolxMRfJTWR34riOwHAvFS44wT69WlJksKdiLmir_cXPAOPJWY2X9yjmSlWEOIbjRc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHX4gQhthuUB5aFFAWaYH4KLyEAso3IPfKzO5CfDn61vg&oe=6A8EC744"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFATXyVB4x8Q7kNvwFHKpMf&_nc_oc=AdrTjtbgQv1foYhwgNgxbeFtM2bH0OWh8go_XzSMehZbxs9j0yL6BnNiczdoequ2UZc&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF60weclZp7GFNIRnAIAxRdtSpL3mODmsylTSxjsS1QrA&oe=6A8EDCB6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1z4KE6tXxsQ7kNvwFDH2e8&_nc_oc=AdoCoNWN5hbk2aormQMYmo6elYArhf7vqzLWKd-zfmbSGB-jYjGIuNEd-kDZTbgYWV8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAgsxWEB027lAuPEKenY9EG8A42es3G7sweEgtg4Ncyg&oe=6A8EEEED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_d
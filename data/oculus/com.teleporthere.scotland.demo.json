=00_AQG6gxoe5T57wzRVcmA0JZ33BOYzePRo-NofcnOYcoWpsA&oe=6A75F7A1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6-rDnyJu5qAQ7kNvwFOloBQ&_nc_oc=Adp9uVTQ_D4xKmEqp8KRq1Hk52fgeqb75a-ZEAKcd9vDRrxzX4KFESTP13mXzZUbS3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn2lg-h46xtB3DX8Wdzf9aqdeU3LJ55T1zgmTDy0rMcw&oe=6A75E316"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S0W7su4wFYQ7kNvwFisRDe&_nc_oc=AdrOqt7LIy5ZbS5f2QOoPAv9KyPGBRyM-IRmMrVTB_ALvz3GIeU4LrXd8YGIFOKYq0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDpxUO_ltS28sekLV8NiPpKRDm9WFlzRPY51GUZSPxsQ&oe=6A75F304"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nfFerd4Z8SsQ7kNvwHbDJbU&_nc_oc=Ado9fwO_PwFvWdYuIy3byKwn_HkDu8U38iSG8bcLxwCRCQNxRUKK8o8B8fW4BVX6NMc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF98Oh6wEwnCQ8nB51wDkLbrXdMGsH-N4wpnFKj5m7WJA&oe=6A75D036"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mMqF691nFaYQ7kNvwGUac3v&_nc_oc=AdrhTxzJJMcNk76UErSfu3us6buug5pzCcYbUQOJUAM0m7T4Vv3QKGAtEwWzEXC2QPw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF32Q_ecE15BqkkQyObS0qo__e7eyU_qPIvrO9wq85n0w&oe=6A75E26D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
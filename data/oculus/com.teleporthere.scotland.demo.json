=00_AQPmqdvaopxDDpnrqebIawx60zT0fmVgnHAdi8d_IgB6Zg&oe=6AC7B4A1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNOsjctJ8hkQ7kNvwFVdthC&_nc_oc=Ado91zXjSoMK1W08sAqZBQ8O6kBFPp0fQ5WUbdJufHhkxeqgjM6Suznthb8X4qIIcb0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2pdidL-8ZfwWcT1QIymuLwBUzSbVJ93OrNZCvhnxAMQ&oe=6AC7A016"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9fbkYZFPC9gQ7kNvwEirC-G&_nc_oc=AdoNUA9bsAIff93zwnrem-jEvTVuqiSmAiTTACN_Gp6eMDviyuLYqCkzOAU0jVhwHEo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSUfCakABYNztkq6-XwMd64hlSTubCDNzEIDcHmfKNWg&oe=6AC7B004"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84lsROKgHEEQ7kNvwGZRJNn&_nc_oc=AdpeiBLeZ_9txpUvi30WBldN48aHBKgl-S1wv16IoD4Gtxd7v-a5A1Rdi0CvrnKCD6w&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMBrJybS304m9LA17bSRiSZSeVtcVasO4kwbiZzlllxVw&oe=6AC7C576"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
=00_AQDaHIMiGpkQ575j3KPnINY1Xm5Zf_bj8_m1GJ9XOf_gQg&oe=6A6DD661"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2nWeHkMlriwQ7kNvwGvyvX2&_nc_oc=AdqFHvQlGx8W0v5r09LyNKBIWyh58aS9juWKaqmqVdW6jZiiX41r7z23rloUeLTvYAI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0AVqAmuVPvZItArRgtuKsPxdj75fNxNPzaNgh7AB7RA&oe=6A6DFA16"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NrA-giA9VmQQ7kNvwFCfPhs&_nc_oc=AdqV_GylK6s6Rzyo8GzIeNhZw_z8OXFY-INPg8JfHqsACIXVOF5RP5Y9Jy8ZqUbEr7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBMzTe_w1cRqSOW2dZPM3p4KMt78wGY6ohsJx9ejxY5Pw&oe=6A6E0A04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-pbV9ic7BTIQ7kNvwHIiLxX&_nc_oc=AdrX6xILaDM3KZC5hgW4cIocazoA16mAps1hjYsv2ryYXCHuxnO0m25mwmiX-37dTOk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9O0doPmNEfe6p4VT88u6eSpWvA3HG2bQfyyfeIkJrzQ&oe=6A6DE736"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fST8vdqo910Q7kNvwEyygHo&_nc_oc=AdpQSVxVBIqUHu4gZy_B4Etr62hD08KwHI_8_8aQg86A_U37n8T3N4W6eoV6Xli78j8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCQGSiBmwy5VDHc3YwHzkZfzN1yVC_l3lVdWNGHFkVocQ&oe=6A6DF96D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
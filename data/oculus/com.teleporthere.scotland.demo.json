=00_Af9I-UsY5iuM__C-TuCqaGqZTxVh6_C9TuGgdLQrCqmikA&oe=6A47D321"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=347p3RDSDpQQ7kNvwHVOKXS&_nc_oc=AdrrzF_WeksaAbnOpu7PZoc5PmRIlJT3jXAAk8a4IQPDINBkrDhHUtKXWOBumqa0nt8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kgicHjGTlKPmAcksqZni3vD80JBrtT8rdNVLIOCxtPg&oe=6A47BE96"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=llWI0GPEascQ7kNvwHLQYES&_nc_oc=AdqniS9EK9QmsUU7Z3CUcvgQ-ny0iXYtPEgKAnYAG0-pKvEjy2-mvOWxWQeNu3_ohJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-sbSwPhO5NKrvKI6HOBRUIbyQL8DRXOIw_nmIwl5sGPg&oe=6A47CE84"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LhXmymeHOSIQ7kNvwHOJ8rW&_nc_oc=Adrz53v-ldqXkrVhIdHPXe1h4y--_cP-C9ZIC7ZqObOUWYAOci4gltxRyfrSOxMwiQc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Q3SSy2BlFOk5LadrcKDKEi9VkSUBK8ofw-1igyIyqdA&oe=6A47ABB6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
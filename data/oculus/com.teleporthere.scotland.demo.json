20f&oh=00_Af8psw31pqplz2ut-WeoUAVZudDqk3zJHDsBKsMCKGldvQ&oe=6A36AFA1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1nEo-b3vzkQ7kNvwF7KoHW&_nc_oc=Ado_dvEyJxlZsC6vSd_aBPF-HFg2e-CC0fkDdoZom0wzNLJaNHGYUMJAwtyruWraHI4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RxMYlIrJH5zZa2FSYXsbpbCT9gkEp31Bgi6-f1Grq9A&oe=6A369B16"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GA56lcDx6H4Q7kNvwHPFw52&_nc_oc=Adqy209HvIF85KkVkiPBmk5TJGQHTVaiOslhMiR_e1vw58o7khcRfHCh2IP6P-uWBGI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_RXSAw04nrcKQ3UASBFZyXpTBi9sCHvxB4cvSPxvoGMA&oe=6A36AB04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c5L0xGPJJZ4Q7kNvwGu5fKt&_nc_oc=AdpnMiZG5wIIn6NjRy3ZBud9JAdRDj9F4siD22U9hKj7STbDhdZifr9ectdeCcU1InY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zLeDBgyeiJVGm49kZKKeLA7lVlE7WiwWKx8NLJduJkg&oe=6A36C076"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNviJUvTaIgQ7kNvwF3Hv7E&_nc_oc=Ado9mELMZhNdFDp_1sjA5-P8rPwTCchHThs9vaPidM0nziTYoDuQ93DhoL5qwffeeE8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9L3QA-KmrkO-MpkYYMRyQKYdji1nILdfnrr0JrqUE3A&oe=6A369A6D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625
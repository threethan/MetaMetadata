_ss=7f20f&oh=00_AQGecXCQSp-bmNx4f7IqBgX7TdHKdv9mDklYTDAbn47Nlg&oe=6A859161"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6eVC1AFDMMQ7kNvwEVtF1y&_nc_oc=Adr_V_AEVCwckFAq4s0aYJ4KtEUji9jlthxv2A1d6RyTAkrLnILps5IQbQQS0AT25Yw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPFidO6e5VVOc0w7hCL61lXklX5Q2-E-oNE0XlNYGvLQ&oe=6A857CD6"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZHr3YPTmuzUQ7kNvwHnm-kZ&_nc_oc=Ado01RbyjsHXe1txlG2KE_OmmHjLP-Ea_Tzvnc-ZvrjJ6u5BY9CkshpmhjAzG_YXKe8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGmPBaCR4bNgGYPN_5_9iS4_deVS1E8d-x1iZmjB-D9w&oe=6A858CC4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_v6CoDwzecQ7kNvwGqcjl1&_nc_oc=AdqhZkyty04si54So3O_SRqND5BtRu_bWqg_fDLbBdzC-TZU5JHAvlL4jmn0Pg_nB6U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEu0Hpt4Mdfa-9D7vSNeWv39J0FXCzG05lAEVOt7ttvfw&oe=6A85A236"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tD7bvrvAjrAQ7kNvwHaBLwG&_nc_oc=AdrqMeNloYP6iDYfyeRd8NlU9s0gmGobsiprAJ8xRpr9Oe4Ky7Cz3uqxlVY78STT044&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUZKRZHahj5SNpOPgMFCCg1QgMDMWLIVXSIkPrmHF2Pg&oe=6A857C2D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_d
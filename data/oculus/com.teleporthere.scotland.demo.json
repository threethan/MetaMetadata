=00_AQJ8JL9q3GpgL8gDhTwqc7oADWaQmTo_yEpJYdve3qZ_qw&oe=6A983EA1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ig_9cjvhYdIQ7kNvwEysBMr&_nc_oc=Adrxqcf2SUaK5POAs50OK9XdvH2r0RlP0GkLVtViR2dKPQHzDV2QCM8jUFOXVpsXY0k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyQ4K7oARNssVjULYJljkvP1L3peP4-9hn7vZ3a1iu9g&oe=6A986256"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VwyxQpoGF1kQ7kNvwFGzK9j&_nc_oc=AdpFlQqAMC_oxl7ljZAwQRkfzRdr-YpQs-An7Qn9hsjWD2ylB5ZOwytmBuCxViQVLDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWLEhZ5eFLxtiwdWF5ri_dKdwHtUXyPN47QA27GQ8oow&oe=6A983A04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xjp2Q_yuGz0Q7kNvwGGxZ4p&_nc_oc=Adr37gB3naiecsBA5JngNn-AmWbvOl-JKH227RuXrDj-VBvlHvQMLc1LIqx605prIdE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLHqpnZ7vQ4jnYV91s7CI-SQkDphNZ7itGtJduUDVbKg&oe=6A984F76"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4NI-x69bN-QQ7kNvwEuaS01&_nc_oc=AdrrOzkaX7jYz2KfQjdlQ7LTQEjDmhYIcsfPC146eAcbIBKAP6y5MZN7Kkqu_oj9YP0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlIEabH9MVlXcwK2exCClU1HaTl3MzzC2w5PbPW0_xqw&oe=6A9861AD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
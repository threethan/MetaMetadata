=00_Af_rElBrtvjb2HapS_h2-kEhTmi6SuDgLEI7vf9jtM1NpA&oe=6A3BF5A1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oLLjddEzPrUQ7kNvwHC5oCo&_nc_oc=AdogngPX96yaGdvxOD0CGaxMQzXIBcmbL01YX7dhy6yFIxaZ9LiNuQTnVx5qiFfXWRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tfEYEHCaN5580zvolKfnKxrapDEGtpcpwDMIoH-fUng&oe=6A3BE116"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQeHJOf-yQ0Q7kNvwGbZMFS&_nc_oc=AdoDmMySoMrbCyyaCvhJ4V1BZ8w3Xc-_j-2fprFv-2k4w03pbEECZRkiVnPWNgyXEQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WjCJEGkUPe6rEnpIA5zWAM1CvIyED4pCO_LJpMq8grw&oe=6A3BF104"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1OV5RYJ4O2QQ7kNvwGhRDO_&_nc_oc=Adpm42E_Mwzmykte5zQLa6AmI9VLWLZ68QBKG3wPj4QQ3WrWeEewI9o2NjAWXXSEbfQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-azOo5aH-BW1y8EYSNSAbFtVOYflstfBuyPl8Eij6bhw&oe=6A3BCE36"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=alFBUDIsg80Q7kNvwGLmUiA&_nc_oc=AdpQHRF6VQS0gwgsKT91xmqtChr9hpqH6SXq5CweTWir5_sofZga6Gpx7V4NIV-MmbI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sOrYsR4zJR8Ny8l8AcW_sOgmaeodRb3f8DK7zFbM5pw&oe=6A3BE06D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625253478, "l
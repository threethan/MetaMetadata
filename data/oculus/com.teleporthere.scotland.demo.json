=00_Af5v1PEmPgwUDsmVpx0vGXOjjqn_h6EBEz1Caaljlcmtnw&oe=6A15BA21"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7PslNGaHB0Q7kNvwGvHHxd&_nc_oc=AdpLmhxaVwZ8FCzxf4U4NUwd2SfL0YAH6w_lAHCKq1J8wT_fk2zUbtTlia_zfGebeE0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-QHMDwr2-AkiD40kOo_1LSKjHg3hJIyQeh4fvL0XW7w&oe=6A15A596"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MP_gPsRnui0Q7kNvwHWZmHm&_nc_oc=Ado6q9aV0sW4FK_i866xYQj8KtCpYat0ebWiz1pK1QunqTTGMK4yY-6-_ps_x798lJQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AielFZWbH1qhs1u9JXtDk-eByps2gYnRgJeg91DwJ6Q&oe=6A15B584"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ykcpix4E6lQQ7kNvwFw8pmp&_nc_oc=AdrX9OypSTIUjiKIv1foyX8AR-i_uFXv16OWvtr5c1xdhszOLD4WDwjqo3SsAQy08fk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Ibx054wQhTTpjT3IuNPU6z1dLiJ-f9MmX7OpiF044CQ&oe=6A1592B6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
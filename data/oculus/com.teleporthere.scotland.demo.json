=00_AQL_OMrQiHLD4NdceO3GDj1ql1URULUjts2nSEH7xPYpLQ&oe=6AB53FA1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFPw8FR56oUQ7kNvwEmfCj1&_nc_oc=AdpaxpR2yQSMt23RmSGwQLzG_RLfuvfTkqIybNu5bN6T82yF50bDOSFGesLPiJu1b18&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3DxtUVbbCwoaz_bco4Mt2Ju3BmHCn-5dHsz0GA40RAA&oe=6AB52B16"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KcARo13okSsQ7kNvwEMRivg&_nc_oc=AdqsdnrcBIFcaPTvDAizImbFR3FN8a6Wj55KvlIurBFmhSoIzYsOBBFdtlmCroqsLic&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIr-zdSpJY31zrTxXWmj5M55qe7YJIqDviY7pFuaiGMgw&oe=6AB53B04"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NETsL3SHxlYQ7kNvwHa_FUV&_nc_oc=AdqO_M7PQJRdhVLq-GCyju7U14iKTI49TcO5qJf76ZibqkLTvMdQaZhq4la4HwbXgGU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKflAaAPnVftHvp9oh6octFEjZZhhvWGtvnrtPlocEu_Q&oe=6AB51836"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
20f&oh=00_AQJ9KQgVDAvpk8wFNlCwwtJunFGjjaQ3KYg2B7rzyc1sCA&oe=6AAEA821"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChTld2pbgXsQ7kNvwGuphgS&_nc_oc=AdptJMBpKDanfpzPXd30qVevNoZRdsknJC06FLi5mL1-oy3HPFX5-RI3FL0HCbuma9Q&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1cDN-u2NWeWbkDtw3K2B-IYT2vaneUpXs_bqiW3-LQQ&oe=6AAE9396"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1rGSROxbgcQ7kNvwEn1Iec&_nc_oc=AdoD_qAbKKWiUW2y4cutE8C98Cl3gt8jMVMaMb43oFb6xtPgr-e2p397JAw7Ro41rHY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKImECM9U0lx91pYr7yU2dLi1G5dstsKUf32j2ptEkEeQ&oe=6AAEA384"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucBAvY6WnOcQ7kNvwGLRAOB&_nc_oc=Adrd00Z4zkH36N9xk--5z71szdH64nM22iAl3vfrA0Qp21lKTAdYKFf4x3QPhsnEpws&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ72OKDpGAalYj5Jy4EWWBem22gTg-a4WaEXP6flbiTXg&oe=6AAE80B6"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See Hogwarts Express chugging along the Glenfinnan Viaduct and take in the breathtaking views from the Scottish Highlands. Immerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location. \n\nThis demo contains 5 selected locations. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://teleporthere.com/app-privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Departura Ltd.", "support_website_url": null, "website_url": "https://teleporthere.com/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["TRAVEL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1134388193983646"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982479_1081821342564717_7140769447498022582_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xkm6AaKGbPYQ7kNvwHQi4Wr&_nc_oc=AdoF-2LR1HQyVI85OmNbrJzy-2WQKquC2n2Hn1423Y2cWhfE-EG_MKFpFGL0ZwxWKEk&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLobyCL_3_xEYo-Ics8YfKwDeEAAtMEDWAg6V_0cM6wbQ&oe=6AAE92ED"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Teleport Scotland Demo", "platform": "ANDROID_6DOF", "context_category": null, "context_topics": [], "release_date": 1625
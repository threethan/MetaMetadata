=00_Af7qzjKb_n5TE2MFURwVwOLNrcXz48azWHUlTUUr4VBdTQ&oe=69FA0AA1"}, {"file_name": "screenshot_4.png", "id": "224457852374247", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982553_224457855707580_8771126862454033654_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iGDTnfVAjecQ7kNvwGajuAG&_nc_oc=AdrHhsbF3c0Imc7aPmqXnl-EJI7BHQtmfK7-c888k8YdY7BSxzTfQHiiMOAlAuJfMsE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ceHy2XFipeMBwpZtC0Ii9Fn8Uta6GW0bG_WK8Evuprw&oe=69F9F616"}, {"file_name": "screenshot_5.png", "id": "4120107308047028", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974901_4120107328047026_1000761019227985402_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDxfmUvEHqcQ7kNvwHV8qsV&_nc_oc=Adp18PiUFxaY6WPJPKqCLC1BK_bGbG-ytmIz9NxZRuGfFYnMWCqQ__rqe0JxuT3h8Qw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FTOAID0csakd4xkGZmvYz043pybijnOjANjXFv8py-A&oe=69FA0604"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2_coverimage.png", "id": "966235423943471", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982460_966235427276804_1604046224860046214_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrKJXrylLKUQ7kNvwH2DnOZ&_nc_oc=AdrhMkkCmNhFiFzPVtgLL5XfCwRSgkhcBcmPJ1zZ5A6S2zu1jyHkd3LIB1TNfjX46QM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5iey2dr6TM3nqN_GOlnKFmSJdYEHX50g0nyiHsSsDKVQ&oe=69F9E336"}, "display_name": "Teleport Scotland Demo", "keywords": [], "long_description": "Ever wanted to travel a whole country in a day? Explore vast locations across Scotland, from castle ruins to the beautiful beaches lining the north coast. See the famous Hogwarts Express chugging along the Glenfinnan Viaduct, escape to mysterious lochs, historical landmarks, and bustling cities. \n\nImmerse yourself in stereoscopic 360\u00b0 videos and spatial audio. Take your own time as you jump from location to location.\n\nThis demo contains 5 selected locations. \n", "short_d
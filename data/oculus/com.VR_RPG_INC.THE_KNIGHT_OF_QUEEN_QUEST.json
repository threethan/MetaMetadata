GHVGIp&_nc_oc=AdqCEwHAkeokyAIc6BRZFA3bHEU-U-YGzqV7n2nbVEI0sTB4iWI-B9WQAMnHox3_gD8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQzR3LHtQU5-NQStKpqq1tDbEveFheGQZAKICJyCmpt7g&oe=6AE89611"}, {"file_name": "SS1_EN.png", "id": "446937713154240", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974524_446937716487573_4416804926913257435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nh6XaH61HucQ7kNvwErNsPp&_nc_oc=Adpn3PN6szVM6t_QoI7tMhk8DW85vdddcarG7vOgq1wXH37OvhcG9ZdrGwdFgQRQhac&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQZ7Om1Rd9do6eEeqSg6-u1SW86KjkciVLGMQWgUpMYVQ&oe=6AE89B9B"}, {"file_name": "SS4_EN.png", "id": "182975900248557", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031622_182975903581890_2732049728403921425_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pn8LdjJjp1YQ7kNvwFkyS4s&_nc_oc=Adr_c5TJVq1t_gb3_o7SK3T3_hUwETN_xeTmehicbBF28uLTLrbp1hT1wAzk1eqOwGs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStSUEATRNT9wYtkuN8guj8rKJzZW-D9714YlxljYWc-A&oe=6AE8B3EC"}, {"file_name": "SS3_EN.png", "id": "179038630318961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035320_179038633652294_3822399642803749135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6teBe5yBuA0Q7kNvwEEWr_R&_nc_oc=AdpESZlNPgllztj3JZI5cbzvnQxWsIJlg7lwsSN3XG3P-6iQ4eFn2Tnim0xHbDjmDEY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYIDo_xsdejfYAmRdYK417XsWkg69oCh-yCvl8LPmUPA&oe=6AE8B066"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THE KNIGHT OF QUEEN", "keywords": [], "long_description": "Once sealed in time by the legendary Hero, the Devil King broke free, and the world is on the brink of the chaos once again. \nAs the knight of the queen, you will depart on a mission to fight the Devil King and restore peace.\nCan you defeat the Devil King and save the world?\n\nThe battle system uses a one-to-one turn-based command input.\nWith a familiar old-school system, you can start playing right away, without any learning. Relive your imagination in your youth, 'Diving into the imaginary world' with VR!\n\nYou can walk through fields and dungeons with a 360-degree view. The game gives you a more realistic feeling compared to the 2D experience on a TV or smartphone.", "short_description": "\u3010Turn-Based VR RPG\u3011\nDive into the world of an old-school RPG in VR !! \n\nBecome the Hero of his majesty the Queen, by explore the world to defeat the vicious Devil King, and bring peace for the people !!"}, {"images": {"nodes": [{"file_name": "KQ_1080*360.png", "id": "786064732293541", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974469_786064738960207_4749689403788812198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUZlRxrxINYQ7kNvwHXC5Hk&_nc_oc=AdpmrbD6InDhHUfIRe9WzrJK7K1GlVu9BaL7E99uhp0j1InOc9gR8R8kKB08DQ1-7o8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEEp5HxkdUzG_gZaQStBGgty1BDoZFdmdEmcwLF9uiqA&oe=6AE89494"}, {"file_name": "KQ_1440*1440.png", "id": "438350890698514", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75221331_438350894031847_8924041884466895870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7TEkCnQ3F8Q7kNvwEjHRbX&_nc_oc=Adq1h_Fr3ly8gWLZuEPM_BURqTkBuKqos86NTaa6j8jioI1yGVBMIXyFJOqAf9RPEHc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnpTkyujyExWJuJ0-SdL_X5-I3gbvwyajU4uIGPAb17Q&oe=6AE895B3"}, {"file_name": "KQ_1008*1440.png", "id": "266229888189672", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982670_266229901523004_8014371044846660317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6q-CMY3e-4UQ7kNvwGMNIxa&_nc_oc=AdrIej3-AgqYxbsKUO7k6q4wj9egajKwX6Z94GiALSwzULX35xBPb4NKvY1aM0IYeo8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKMoRqLIAIg66KmX7kyYp26SMX6LrK5v3u2Jw
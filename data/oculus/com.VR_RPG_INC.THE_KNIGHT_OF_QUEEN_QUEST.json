YSkBDsGKcpqE55OYFfiahfP1_ECwurXsLpz9-VZVCPv3owy7k&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYc8k1N7CWQEOPaslpXgjyLiHsGo8AETIYWDYyNuR-OA&oe=69B56891"}, {"file_name": "SS1_EN.png", "id": "446937713154240", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974524_446937716487573_4416804926913257435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czMH2q0EE1cQ7kNvwE7n_D1&_nc_oc=Adn7bo9Is74KVM498DX3woGeFZEhEGS6MEVIYE_1u8ya7yUJa8IhxK086Egc-UCaYPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afwj_I_ZrIxKmzPhy7D3Jfk9GbNXqxTfUQtX-YxN_D17pg&oe=69B56E1B"}, {"file_name": "SS4_EN.png", "id": "182975900248557", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031622_182975903581890_2732049728403921425_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LM0FgHVJN2AQ7kNvwH0Pk5s&_nc_oc=AdlKX5FS8s_SSZesnRh2ESq0TcCDZ69Nh6KatgZfZieEb1LNbXIMcvfSXM9l9PqmsF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzEVpGcN6pBFUQpfZTZPvoYnhMAx8f1LWJ8I3-luL4inQ&oe=69B54E2C"}, {"file_name": "SS3_EN.png", "id": "179038630318961", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_179038633652294_3822399642803749135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jM4NEvYvc9kQ7kNvwGWeHLE&_nc_oc=AdlMrQjFHFj6uZ6O4C7K7hp7bKXxGXCbEGCBKCFuepWhf0QtdLc0p_RV-u7kOZC4mBo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxSdi1ubig-AoWX2AlcT69HROOsA1GHESbb18YrkZ3Gyw&oe=69B54AA6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "KQ_main.png", "id": "1580567332330969", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39003273_1580567335664302_3537293144248747467_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rgfilvt-PvMQ7kNvwFAs8iZ&_nc_oc=Adk2UI_BgOVelp27CqaLyrPxiRxq78OHNjETlTcvnWlXVfmnvxPPNM9R8gdSXGPi7UU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxE1uoQ4SO-NYiHvPQAxMVflcdy4tz7-V1gvXOkEih8vQ&oe=69B5582D"}, "display_name": "THE KNIGHT OF QUEEN", "keywords": [], "long_description": "Once sealed in time by the legendary Hero, the Devil King broke free, and the world is on the brink of the chaos once again. \nAs the knight of the queen, you will depart on a mission to fight the Devil King and restore peace.\nCan you defeat the Devil King and save the world?\n\nThe battle system uses a one-to-one turn-based command input.\nWith a familiar old-school system, you can start playing right away, without any learning. Relive your imagination in your youth, 'Diving into the imaginary world' with VR!\n\nYou can walk through fields and dungeons with a 360-degree view. The game gives you a more realistic feeling compared to the 2D experience on a TV or smartphone.", "short_description": "\u3010Turn-Based VR RPG\u3011\nDive into the world of an old-school RPG in VR !! \n\nBecome the Hero of his majesty the Queen, by explore the world to defeat the vicious Devil King, and bring peace for the people !!"}, {"images": {"nodes": [{"file_name": "KQ_1080*360.png", "id": "786064732293541", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974469_786064738960207_4749689403788812198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQFpCcZ7OhcQ7kNvwFGL7nX&_nc_oc=Adlf103ak0p9LuPEZ4-EYtlmKDuCmjJN5kYDLNT3hDYeszBdxVK2M5t1TJ-fLoUw8Vc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwYJD3r7fAGsTtHmIBSWYMtVJcA9xdtKTqbDimK3SOCRg&oe=69B56714"}, {"file_name": "KQ_1440*1440.png", "id": "438350890698514", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75221331_438350894031847_8924041884466895870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rl1ukbGv_uEQ7kNvwHDkrcm&_nc_oc=AdmXT0H2af4VtWAE0QO7oh92ohht-Ks4wZ_utFSMf82kRY3twyZetPXmBSgmuBlKmq4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwEgr7mypADgzsOUzTyRHdtMmm0_ltkhA4xHayqfm6NSQ&oe=69B56833"}, {"file_name": "KQ_1008*1440.png", "id": "266229888189672", "image_type": "APP_IMG_COVE
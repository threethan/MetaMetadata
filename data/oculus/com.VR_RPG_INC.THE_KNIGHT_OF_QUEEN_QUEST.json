EZ1zh8&_nc_oc=AdpqFi2t78F_isOkuoYuJyFTe_MqudQXWRWc8zIb36TbymvOZ0_pr02km4OiK9O0Ma4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjTBgk6cNBS0acLCcW2U_ilJqmknJoAa3AklfFgGUSQw&oe=6ACB9511"}, {"file_name": "SS1_EN.png", "id": "446937713154240", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974524_446937716487573_4416804926913257435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mDVEKD0O1m8Q7kNvwECJCeM&_nc_oc=AdouXRVilKpfO8eTzT6CaIPdhzua2VnhK8fO4fBM5YjTC7INrUn4SSrbz0wRTO3yiyI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOboTwpSfDffG2l_DPb2rXN1TATU8LEjqP1MXYIwibs-w&oe=6ACB9A9B"}, {"file_name": "SS4_EN.png", "id": "182975900248557", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031622_182975903581890_2732049728403921425_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZ9NjLex8_oQ7kNvwERkip6&_nc_oc=Adoh-E2LPldkW3o--7-VJ4TvbqZbkXKLpYvDyuTQWRyDZLSFhdPlZRn4lXyEanZ_ozg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_gEyMwwmmnkQpssjQu3xGGWu_qJmQ-OX3Q6mwDsSMnQ&oe=6ACBB2EC"}, {"file_name": "SS3_EN.png", "id": "179038630318961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_179038633652294_3822399642803749135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9mM6FfliZMQ7kNvwEql8vW&_nc_oc=AdqwPx3C2NeY-q3WwE0ByP0CO2RlOqVHrPVwL0yJxtBIV6TcFgRYYHKnV3Y7krkIHBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMgz9v_egNdGpS5rbr3nrkS-c3tcrKq-JMS1tV0H1B_w&oe=6ACBAF66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THE KNIGHT OF QUEEN", "keywords": [], "long_description": "Once sealed in time by the legendary Hero, the Devil King broke free, and the world is on the brink of the chaos once again. \nAs the knight of the queen, you will depart on a mission to fight the Devil King and restore peace.\nCan you defeat the Devil King and save the world?\n\nThe battle system uses a one-to-one turn-based command input.\nWith a familiar old-school system, you can start playing right away, without any learning. Relive your imagination in your youth, 'Diving into the imaginary world' with VR!\n\nYou can walk through fields and dungeons with a 360-degree view. The game gives you a more realistic feeling compared to the 2D experience on a TV or smartphone.", "short_description": "\u3010Turn-Based VR RPG\u3011\nDive into the world of an old-school RPG in VR !! \n\nBecome the Hero of his majesty the Queen, by explore the world to defeat the vicious Devil King, and bring peace for the people !!"}, {"images": {"nodes": [{"file_name": "KQ_1080*360.png", "id": "786064732293541", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974469_786064738960207_4749689403788812198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w6TD6CDfrq8Q7kNvwE5IKc4&_nc_oc=Adp387flFy7Qk9Ln2RRdlOy0jZlreIMbmHMcu0hmUFvWR5O8n--sRfelC_3igV_omFk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM67VTlm1SP2dlCXcwijf0VaYCWa2NZi5f8XOFT4suFaA&oe=6ACB9394"}, {"file_name": "KQ_1440*1440.png", "id": "438350890698514", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221331_438350894031847_8924041884466895870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ckI3lRtL2FUQ7kNvwHGa-97&_nc_oc=AdqtdY-sGtghmxCRN5Z3lC8YTitdtroimO2EEjQGxCO_NDHZIqhMlbG1JVKv3oo5vB4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRq4HdMbtjxmjvDokuWIrB4bhwBVftY6odKfwKcVYyvg&oe=6ACB94B3"}, {"file_name": "KQ_1008*1440.png", "id": "266229888189672", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982670_266229901523004_8014371044846660317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6BAd3ftV8E8Q7kNvwE4SEr-&_nc_oc=Adow3GRGoAFiRN0s7IJK8O5ZaIvVero6Rj9PHO1_HB-yfUeAx8lvve7fa_O_9-pQGAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVf_6DF7dy7H_7sB3VOaPucTNXxkS_4oJOtw_
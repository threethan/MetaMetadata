Ee60jk&_nc_oc=AdqCnGDZwyR9pBgN08CsCDaNcHzhKzVGg-06CbF5-zOZt9DUkf-iLBuM7FL_3cqNfIY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOksnUpwlqWzNPaAOnuBxveWNu4VMiJPNt6VSH5v4hzQQ&oe=6AE35011"}, {"file_name": "SS1_EN.png", "id": "446937713154240", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974524_446937716487573_4416804926913257435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9SgUIjlIeKoQ7kNvwGs1urw&_nc_oc=Adq2rJHDVsz3AcEsInQBH16R-qP65Pqkb6dKDvzalxZxxrlzUphfBVUpSMN_fIEO_98&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_5Zaan-6BjnZXQ7WDZRZffPpm7qMIW6Lg9JnKUKR4Gw&oe=6AE3559B"}, {"file_name": "SS4_EN.png", "id": "182975900248557", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031622_182975903581890_2732049728403921425_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSuQw_6qes8Q7kNvwGAtezZ&_nc_oc=AdqplmnZiL-SB6nbEjV5JDeXwWWeLKhEt4_OLDzyWSAYCiAZc9X3Jq34CNTEqh6PugE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm3mZw9NA0ho3tjenueB2pIJQ6QoZmbYxL6CfQ-64tmg&oe=6AE36DEC"}, {"file_name": "SS3_EN.png", "id": "179038630318961", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035320_179038633652294_3822399642803749135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TW_yb51B3JsQ7kNvwG0qgJA&_nc_oc=Ado90dLsH7Eq1VH3zM8Ec-OjthL305W2MCX8o-QHirOobjlf34gFUugDC2i4U6ZcBWo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMG3pUH8r9LLBEgoe7FNyMK9txWTdbkUrKUPw8oH-0I9Q&oe=6AE36A66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THE KNIGHT OF QUEEN", "keywords": [], "long_description": "Once sealed in time by the legendary Hero, the Devil King broke free, and the world is on the brink of the chaos once again. \nAs the knight of the queen, you will depart on a mission to fight the Devil King and restore peace.\nCan you defeat the Devil King and save the world?\n\nThe battle system uses a one-to-one turn-based command input.\nWith a familiar old-school system, you can start playing right away, without any learning. Relive your imagination in your youth, 'Diving into the imaginary world' with VR!\n\nYou can walk through fields and dungeons with a 360-degree view. The game gives you a more realistic feeling compared to the 2D experience on a TV or smartphone.", "short_description": "\u3010Turn-Based VR RPG\u3011\nDive into the world of an old-school RPG in VR !! \n\nBecome the Hero of his majesty the Queen, by explore the world to defeat the vicious Devil King, and bring peace for the people !!"}, {"images": {"nodes": [{"file_name": "KQ_1080*360.png", "id": "786064732293541", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974469_786064738960207_4749689403788812198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gNK7ISeLc30Q7kNvwFU7gMI&_nc_oc=AdpIL1-CPCfeLtFpvVaqEWkwAma18f3nHDiybTV6DZJc2wIucjY63PCLwaiH9gpw88o&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3vI0EYP0G6LiFpB2HgtZ1Z6AW_pG0Vqvy7wx5S9di6A&oe=6AE34E94"}, {"file_name": "KQ_1440*1440.png", "id": "438350890698514", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75221331_438350894031847_8924041884466895870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV5zZ1opM1oQ7kNvwETBmuF&_nc_oc=Adoed-pkJ3A1WzbAXLDUeotRnYNuOFVmmWgJxRkMx3Q-7v_g3y3DwydqwXDtlDk8-oM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMA1fTiZSD8A71_E1yOY6pHpJ5F-KX-2YP3ll-vBlcaQ&oe=6AE34FB3"}, {"file_name": "KQ_1008*1440.png", "id": "266229888189672", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982670_266229901523004_8014371044846660317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XLc88Ifv6tAQ7kNvwEvWtgm&_nc_oc=AdqA63nEM_as_HbDo_J7jXh4uozOtQQwavelL9DeulhisrYOi4dliGGsbZlRgCk49F8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1FsZSFG5cN8ro6p5dBlTlKzmLWCqpdSTHQpU
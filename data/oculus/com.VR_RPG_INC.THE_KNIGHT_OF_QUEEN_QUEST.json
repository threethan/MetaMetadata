H9kEvB&_nc_oc=Ado9lndwXA6awrwu-5u9-hn_TIz3fisGXjHGugs9I5CwyuQ2y-ftdnaXVP7Iu6DDVVo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFY6016NIWylPgh-0v4Minfe9wfAzSJ03RQyXCksyt4g&oe=6AEF65D1"}, {"file_name": "SS1_EN.png", "id": "446937713154240", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974524_446937716487573_4416804926913257435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdftaQzyo3MQ7kNvwFtctHJ&_nc_oc=AdryHUA7wYCOhuUtnAUHzaxEbp1O4o5qNXonqgee2Ncv37UemdWtC1dMMCfAaEr2xV8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8ngvktErPOphCUZ_EqAH1UsFtwCHMla7a4PH2zfMfJw&oe=6AEF331B"}, {"file_name": "SS4_EN.png", "id": "182975900248557", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031622_182975903581890_2732049728403921425_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8_bP2yyXwIQ7kNvwGNFLxV&_nc_oc=AdqPNOWDKcLLsk87C8lc6-GCQ4uuYW8jG-lnmguA0AZNN2Lrvcu5g6lMHzD43aHclsg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQma0OwhdKc-6ygBtOiXwwlFy4dppucfW7THwYf-LbzgQ&oe=6AEF4B6C"}, {"file_name": "SS3_EN.png", "id": "179038630318961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_179038633652294_3822399642803749135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLfu5TBu5HkQ7kNvwE8eDmO&_nc_oc=Adrpz2ROiRTi6COgTRlrSQ2-0FogpGOG69P6txWUvfzoVPuY7yYMhcig8AulFX9lgAk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxqd8LxEDOl76zor3O3vvzr6cvzAxYOrEvv0CM_1KG4A&oe=6AEF47E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THE KNIGHT OF QUEEN", "keywords": [], "long_description": "Once sealed in time by the legendary Hero, the Devil King broke free, and the world is on the brink of the chaos once again. \nAs the knight of the queen, you will depart on a mission to fight the Devil King and restore peace.\nCan you defeat the Devil King and save the world?\n\nThe battle system uses a one-to-one turn-based command input.\nWith a familiar old-school system, you can start playing right away, without any learning. Relive your imagination in your youth, 'Diving into the imaginary world' with VR!\n\nYou can walk through fields and dungeons with a 360-degree view. The game gives you a more realistic feeling compared to the 2D experience on a TV or smartphone.", "short_description": "\u3010Turn-Based VR RPG\u3011\nDive into the world of an old-school RPG in VR !! \n\nBecome the Hero of his majesty the Queen, by explore the world to defeat the vicious Devil King, and bring peace for the people !!"}, {"images": {"nodes": [{"file_name": "KQ_1080*360.png", "id": "786064732293541", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974469_786064738960207_4749689403788812198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-qvbF2QeNYQ7kNvwGmW-d2&_nc_oc=AdqrTWkxNq5PId12fZc32mOpVbm2PzU_dHDrtCn4sVglLROypxjItiq4DWYhT6maMi8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6RGnlV7dn0ichNeyUb5TtlUzt9f9tWJk5aHx_wigJeg&oe=6AEF6454"}, {"file_name": "KQ_1440*1440.png", "id": "438350890698514", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221331_438350894031847_8924041884466895870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=psc59YxGiTMQ7kNvwFxr5JS&_nc_oc=AdpV3MnGSu2hEQjiuo1DwRac-U9ciAZgzZUTQ9pK6vt92braycG6qvWJcQ-vbMn19aM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2MQXl6buoPiUF_5hHiXaC16zDa4qE1vg5Xjtxnb0scg&oe=6AEF6573"}, {"file_name": "KQ_1008*1440.png", "id": "266229888189672", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982670_266229901523004_8014371044846660317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ku67suv1Ii0Q7kNvwEDexFz&_nc_oc=Adp4Ple4Rc7QJ126Ec9p9tlLySQE8VLkxqTbeRqlwTFteg8ajRN1jaHgq7r48yTpP7Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTj0WrYUkVlfptu0XRCSKSXv3-w0STvsTKOvP9
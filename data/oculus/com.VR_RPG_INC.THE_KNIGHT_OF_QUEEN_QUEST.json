EZ7Mqs&_nc_oc=AdqhBZdiai7kQTGRug_rmKhDuYTfBJh5oJHUgSk7r_9v1MFwyN2QoJKr_-erhiff4yk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLm_5Iwrbycco9OAEzk7f3qijBAqKL9EF79pnChKbmixw&oe=6ABBC311"}, {"file_name": "SS1_EN.png", "id": "446937713154240", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974524_446937716487573_4416804926913257435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtC2KroEAjUQ7kNvwFt1xAd&_nc_oc=AdrpZh_Eb334odp8CcZnh1eSBK7m0xLPCpi-v89mtvp2t6HwcWWW87hQqsiv-WEpHSk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoEvjDtQaNauIFtbWT2hCzL5yhkMtYOmwk9Mtg5n64aw&oe=6ABBC89B"}, {"file_name": "SS4_EN.png", "id": "182975900248557", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031622_182975903581890_2732049728403921425_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3zI6_EX4asQ7kNvwG3hjKD&_nc_oc=AdrofEr2Ni3IGAM_p2G3rxtalqy4X7Ab-XzZSgw-MfNaRpJH46k6cSVnMxHz2THSAOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6-lZvcUyB9s6vSfDY2C0Fqyy66Iwn_OP_FnAL9rbjOg&oe=6ABBE0EC"}, {"file_name": "SS3_EN.png", "id": "179038630318961", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_179038633652294_3822399642803749135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esHMq7NmhLQQ7kNvwGSujmr&_nc_oc=AdqUiGsbtDNKX_ca2Pyipvk0PiPU2vge6TUqYNODG5OKz_PGlG7A_pdUnhMn5GjPUkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtiIlW2H2howXKNHXJRI0I3Jd_LOOn_3wBGlVVtSD7gw&oe=6ABBDD66"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THE KNIGHT OF QUEEN", "keywords": [], "long_description": "Once sealed in time by the legendary Hero, the Devil King broke free, and the world is on the brink of the chaos once again. \nAs the knight of the queen, you will depart on a mission to fight the Devil King and restore peace.\nCan you defeat the Devil King and save the world?\n\nThe battle system uses a one-to-one turn-based command input.\nWith a familiar old-school system, you can start playing right away, without any learning. Relive your imagination in your youth, 'Diving into the imaginary world' with VR!\n\nYou can walk through fields and dungeons with a 360-degree view. The game gives you a more realistic feeling compared to the 2D experience on a TV or smartphone.", "short_description": "\u3010Turn-Based VR RPG\u3011\nDive into the world of an old-school RPG in VR !! \n\nBecome the Hero of his majesty the Queen, by explore the world to defeat the vicious Devil King, and bring peace for the people !!"}, {"images": {"nodes": [{"file_name": "KQ_1080*360.png", "id": "786064732293541", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974469_786064738960207_4749689403788812198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cRs0hbMuaMQ7kNvwEv5Jkn&_nc_oc=AdqKlLYJesGIJdPChf9QTaSijH9LFXTKg-JfknR8pwgAR5tjWS2XI7u2nqWu-XucKdE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOjv4Hel1MInznrdSf-761YRaq_0SaL_PMcJ9rlepCGw&oe=6ABBC194"}, {"file_name": "KQ_1440*1440.png", "id": "438350890698514", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75221331_438350894031847_8924041884466895870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDuBBaGPmX4Q7kNvwEnwQrQ&_nc_oc=AdqU9PAL3JFQK_ij2ngiKaT1Qrf1Inh7M6BwD8MAG1xFftR_Rnu1fjLhENUq_3XYFVQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuJy-LygZHdSHAW5aLdiXWSfqc2wEruf6xSdClTiWarQ&oe=6ABBC2B3"}, {"file_name": "KQ_1008*1440.png", "id": "266229888189672", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982670_266229901523004_8014371044846660317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVth6O2HtIAQ7kNvwFQ50Xm&_nc_oc=AdoxxUeziJn6WB4db5Mfvp_2A_T_3Yb5T4yybACgJuXaJw9X7WVnywyZFuOcw-I-7vA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjpD9uoRDVF6cOofuksbDPPhnrzOh4mNRquJT
GHSIOg&_nc_oc=AdpuKuwYXkRbTy6BX29jQEI84deHjd9H_oQFLOLut-A4u0naCVWuEFlpaZTH9DVUVv0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJlYrQ6h3XGFZk8vh0ytSccvxyfb6IbMzqnsj7Hh8chA&oe=6AF9B991"}, {"file_name": "SS1_EN.png", "id": "446937713154240", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974524_446937716487573_4416804926913257435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3HwmbO4yk98Q7kNvwF79N-Y&_nc_oc=Adp2bMRZlRo6ErAxLftIrh3StAYewwsENedP2daQg1Jet8JVZb5Wvcpha36LPl-Ud04&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY-YTkr1MS0ELWt-U18L18Fab9fSCxR1j8frpWivRUqg&oe=6AF9BF1B"}, {"file_name": "SS4_EN.png", "id": "182975900248557", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031622_182975903581890_2732049728403921425_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xvDhhJsttqIQ7kNvwFNsXgP&_nc_oc=Adocz_aYAz5B-_v72VJG46QH0wcEPYzPyFRc8k_BjgaLU92FC8u3tJM3PZnUyHkPn_0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbDimN08SjdBmTskMYk_80OoMYj6WEwxFctnvMabcoxg&oe=6AF9D76C"}, {"file_name": "SS3_EN.png", "id": "179038630318961", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035320_179038633652294_3822399642803749135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uP3y8Ghh-5sQ7kNvwHEXKjO&_nc_oc=Adp2CaggcPrGgA9QsPCuMHD3wUt5TbOJU6gOFHeMToTcHhkQFMh9Wvn1lCbPqTJdTHQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNWA-9vhI5tzBMOe18vkl_3V_BPeoNusAHu1WQOibYOQ&oe=6AF9D3E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THE KNIGHT OF QUEEN", "keywords": [], "long_description": "Once sealed in time by the legendary Hero, the Devil King broke free, and the world is on the brink of the chaos once again. \nAs the knight of the queen, you will depart on a mission to fight the Devil King and restore peace.\nCan you defeat the Devil King and save the world?\n\nThe battle system uses a one-to-one turn-based command input.\nWith a familiar old-school system, you can start playing right away, without any learning. Relive your imagination in your youth, 'Diving into the imaginary world' with VR!\n\nYou can walk through fields and dungeons with a 360-degree view. The game gives you a more realistic feeling compared to the 2D experience on a TV or smartphone.", "short_description": "\u3010Turn-Based VR RPG\u3011\nDive into the world of an old-school RPG in VR !! \n\nBecome the Hero of his majesty the Queen, by explore the world to defeat the vicious Devil King, and bring peace for the people !!"}, {"images": {"nodes": [{"file_name": "KQ_1080*360.png", "id": "786064732293541", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974469_786064738960207_4749689403788812198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6KPKV2pwAMQ7kNvwFq-M28&_nc_oc=AdoRa56c9dPA9nO9tHwBdc4lLSZopFamHDdVnG3IwkyiSFxqUpoZx02gk9rmyFg4OS0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQcuLmNgyHYPqH7Sj-ljtkC7z4eYeoJtk_7dkhWZhWTTg&oe=6AF9B814"}, {"file_name": "KQ_1440*1440.png", "id": "438350890698514", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75221331_438350894031847_8924041884466895870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AsyrG7FEYMQ7kNvwE2L-M9&_nc_oc=Adqxe5iUNYT8dV32CGD7t413vXataTHTmX6TLxHar7cD51WqfkNQktNcUdUV9Ha4rb4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8ls58FBYhPk4kX7Gnykx2t0gVIBxV6Kcw3F0FMVM57Q&oe=6AF9B933"}, {"file_name": "KQ_1008*1440.png", "id": "266229888189672", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982670_266229901523004_8014371044846660317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CgtD8E6fRQ8Q7kNvwFJBy8-&_nc_oc=AdooThMQZ5dkFiTjqnUoT1DNzHtHPvCsCcz8N_kxp4ea46Iw_5q2AS8en88JiYKrsgg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1CPAQyV66G03aMe9E10fuqoMOb9zG0Y2tFkZ
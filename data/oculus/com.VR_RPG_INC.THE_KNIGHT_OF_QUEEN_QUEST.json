GTYV7E&_nc_oc=AdpEC2_7S4HFS-0WmQrozknRhasrsLHedphosy6UbMRFMOgHHsm_LRcZtDhIbaaIYGw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_xU6eIPh4TZIlybtY6GnxJR4D1-cZdEF1S24xRGwUkg&oe=6ABE6611"}, {"file_name": "SS1_EN.png", "id": "446937713154240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974524_446937716487573_4416804926913257435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pfvln3JAsfAQ7kNvwGh7LuI&_nc_oc=AdqQ_B3F4_SST9GuZJAURImDnMuUT-VKIivin55mgNu1Yoq9aZsZEYpzG5aKIZxvRjs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLYRHNjzGcYyBfz06hIJepad0GGiRxhNKKNh-ZasWTlSw&oe=6ABE6B9B"}, {"file_name": "SS4_EN.png", "id": "182975900248557", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031622_182975903581890_2732049728403921425_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L3zI6_EX4asQ7kNvwFXgrp6&_nc_oc=Adrn0Z4v-KR1LMYw79KqsxYGB_sjIyNVQJ5lY0pK_-uYOq6gbFc2yrSY6bUA2Gg6tYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkOHBIKflqbkKO0Our0rG_3pXM_-wVife4EbRMGapmsw&oe=6ABE83EC"}, {"file_name": "SS3_EN.png", "id": "179038630318961", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_179038633652294_3822399642803749135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEUFrSGr8zQQ7kNvwE10Al9&_nc_oc=Adq4tRUzLWzB9WwIhV4zkCtxO6W1OIQlN9fTSpCimx6eeNe33YV1brotx8jta9Nk4BM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW5mx-cqXryo9R7Gz18D7Yob-dghfYwxOVPl0VtKRs2w&oe=6ABE8066"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THE KNIGHT OF QUEEN", "keywords": [], "long_description": "Once sealed in time by the legendary Hero, the Devil King broke free, and the world is on the brink of the chaos once again. \nAs the knight of the queen, you will depart on a mission to fight the Devil King and restore peace.\nCan you defeat the Devil King and save the world?\n\nThe battle system uses a one-to-one turn-based command input.\nWith a familiar old-school system, you can start playing right away, without any learning. Relive your imagination in your youth, 'Diving into the imaginary world' with VR!\n\nYou can walk through fields and dungeons with a 360-degree view. The game gives you a more realistic feeling compared to the 2D experience on a TV or smartphone.", "short_description": "\u3010Turn-Based VR RPG\u3011\nDive into the world of an old-school RPG in VR !! \n\nBecome the Hero of his majesty the Queen, by explore the world to defeat the vicious Devil King, and bring peace for the people !!"}, {"images": {"nodes": [{"file_name": "KQ_1080*360.png", "id": "786064732293541", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974469_786064738960207_4749689403788812198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uPb4kfS48BUQ7kNvwFq2t_P&_nc_oc=Adp2wFQlqvk6oy9szsULtjnrSODffZYd4uEH-5IkPJstA7GUSPj2rg6m7zKP2J0qwC4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpmrslGwccX_LVvKJvFLg9WDsWnX8MH7SH9-qTvTtn7Q&oe=6ABE6494"}, {"file_name": "KQ_1440*1440.png", "id": "438350890698514", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221331_438350894031847_8924041884466895870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jdQ4IyvlzNgQ7kNvwFB63gy&_nc_oc=AdpCbkOXgwdi1ImXZxqB9XeUyIxvMoY-EOoz5yKQAMTOo3GgZEDze9m9CHUugN4N0_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0mF_z4LAI_hwgnU8Umj5szkpqDx_-xa8HoECOBExP9w&oe=6ABE65B3"}, {"file_name": "KQ_1008*1440.png", "id": "266229888189672", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982670_266229901523004_8014371044846660317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilJC75MY4hgQ7kNvwH25-IO&_nc_oc=AdqRwVL8MUjWzuMjLb6ss0gbrJ0O7P4M3iBcvdp2HIxqWdden5nTrIrIx_POTExc1AU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy3NvVt-fumYlwYNMf14d2CnflW9ApxZCy7NF
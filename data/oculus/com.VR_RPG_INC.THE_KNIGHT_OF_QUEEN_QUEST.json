F331ym&_nc_oc=AdplCAKglzzHRpHbEBQfCTJhGG_sRfDPSD4a46l9AjzJemYhED7nYxEp71HzS-xGDA0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMk7jpPix7RJawCCihO7Ml3igU-S8cd3PpTlkuC3quQA&oe=6AC4FD91"}, {"file_name": "SS1_EN.png", "id": "446937713154240", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974524_446937716487573_4416804926913257435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eOjXhnalb3AQ7kNvwHg2pli&_nc_oc=AdoZUF7O-cziFlPGcPMAYFI2kfDfJ7OSR-BYvG9lroCBSy2LT7zbsvxoDjAwzg00DJs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhRQq-uMpsAy0sNMTK4UNtKsGWF41ZAc-1BppnpbOKZw&oe=6AC5031B"}, {"file_name": "SS4_EN.png", "id": "182975900248557", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39031622_182975903581890_2732049728403921425_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68qcoNva-CcQ7kNvwEHTSwy&_nc_oc=AdpV4f8NqCgQoHoNfOxWIiYXI5i00fd7K98Z38SRaMbWHfmT1aWW0Gd78hrBmgTDGtk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMB5HNSXqKJs5DS9ekdayiOsSXIKujDZfdI_xeOEUXEA&oe=6AC51B6C"}, {"file_name": "SS3_EN.png", "id": "179038630318961", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/39035320_179038633652294_3822399642803749135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9qFW1QRnr8Q7kNvwHL_Qfc&_nc_oc=AdoIwBrlQ__qv1_dOlDjo-gkY_4XfJC2hHZ6Anlx8kw3Q5fB-1vFRauGOXgIbh-KEYg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwK1Cbfo0UTDdm50foR6Hy74eBmpL2pnoUsBzw_IP6Lg&oe=6AC517E6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THE KNIGHT OF QUEEN", "keywords": [], "long_description": "Once sealed in time by the legendary Hero, the Devil King broke free, and the world is on the brink of the chaos once again. \nAs the knight of the queen, you will depart on a mission to fight the Devil King and restore peace.\nCan you defeat the Devil King and save the world?\n\nThe battle system uses a one-to-one turn-based command input.\nWith a familiar old-school system, you can start playing right away, without any learning. Relive your imagination in your youth, 'Diving into the imaginary world' with VR!\n\nYou can walk through fields and dungeons with a 360-degree view. The game gives you a more realistic feeling compared to the 2D experience on a TV or smartphone.", "short_description": "\u3010Turn-Based VR RPG\u3011\nDive into the world of an old-school RPG in VR !! \n\nBecome the Hero of his majesty the Queen, by explore the world to defeat the vicious Devil King, and bring peace for the people !!"}, {"images": {"nodes": [{"file_name": "KQ_1080*360.png", "id": "786064732293541", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974469_786064738960207_4749689403788812198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EBOIB2d9tBQQ7kNvwG5FB63&_nc_oc=AdpZL4VUAnLnLuMoCE5r8W6Ssy2QGfQlmYpSx_Rm-Y_owrLLoJyvVrOfZ-_upEb3qcg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQODQTy_1cCFaDgK7dFO99l-UxSfvZjeE7bBDQZWTKWWCA&oe=6AC4FC14"}, {"file_name": "KQ_1440*1440.png", "id": "438350890698514", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75221331_438350894031847_8924041884466895870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UmCkf3zxuRMQ7kNvwGzJHfi&_nc_oc=AdqGNk8eyoFvhFAhuFAHdlI_YpU85kJaXPDiV84P4yr1dSp3XED3yAurTybJ4d-T47Y&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8n-hefuNrhZyYL6U0YeRxalU0odaxAeT3wAYCpi5B2A&oe=6AC4FD33"}, {"file_name": "KQ_1008*1440.png", "id": "266229888189672", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982670_266229901523004_8014371044846660317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hU2YfdZqzGwQ7kNvwH3VzM0&_nc_oc=AdqAsaaF5-Y85C6GerKWQIs4ekx4ZaEoOb6IA0NdrFzAMvbOjEnB_Esf47shaIHBBZ0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNxxotXXZPi2Uqsooq2tMecfauE8M6pvjlm1t
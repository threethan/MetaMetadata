GHTqRw&_nc_oc=Adpg8Zk3roKvR2-2K-wzDOXlq7NFIw6-xqhIcVeBA1Xj7WzDf9lC3LTxPVBYXz2vtRo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP9oLdjC-OJ1gHUq0dwckxCPgc6LyJJI5DPc-lB-evuDA&oe=6ADE0A11"}, {"file_name": "SS1_EN.png", "id": "446937713154240", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974524_446937716487573_4416804926913257435_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5uB17QGB20Q7kNvwH0LOS5&_nc_oc=Adr5mo1_ZU_v1FW34I7dES2JpyblecOhcRg2whpk80jJ1RsIWwjcbP7lDr2PlGeBQgg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUAyQE6iar5P3PP0K1UpMzuX2YRUjScieGomqZh8Rfsw&oe=6ADE0F9B"}, {"file_name": "SS4_EN.png", "id": "182975900248557", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031622_182975903581890_2732049728403921425_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FLB8cudHeaQQ7kNvwGhTleX&_nc_oc=AdoP-KRBguBjCiFUR-XmdPRbm7hxWz-dU7F2hhM9jfZ_SVCKm2MbNKizGfMkU_YQgOA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP-Bb8rJrTPvC7cb69BlnXP3Om3Z57rExsoVpJi0ByogA&oe=6ADE27EC"}, {"file_name": "SS3_EN.png", "id": "179038630318961", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_179038633652294_3822399642803749135_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jd-3eSm3YcQ7kNvwHrbPKE&_nc_oc=Ado0dEQbVfe32iz96KVe3WG9gdq0LsJWgGBIcHyEjuRd6luej10523WJWSOZCBagrME&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN78TOj6HR9_PvbPo7FcuZ7MNTnQwpIt8xq5yjiiBQJdA&oe=6ADE2466"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "THE KNIGHT OF QUEEN", "keywords": [], "long_description": "Once sealed in time by the legendary Hero, the Devil King broke free, and the world is on the brink of the chaos once again. \nAs the knight of the queen, you will depart on a mission to fight the Devil King and restore peace.\nCan you defeat the Devil King and save the world?\n\nThe battle system uses a one-to-one turn-based command input.\nWith a familiar old-school system, you can start playing right away, without any learning. Relive your imagination in your youth, 'Diving into the imaginary world' with VR!\n\nYou can walk through fields and dungeons with a 360-degree view. The game gives you a more realistic feeling compared to the 2D experience on a TV or smartphone.", "short_description": "\u3010Turn-Based VR RPG\u3011\nDive into the world of an old-school RPG in VR !! \n\nBecome the Hero of his majesty the Queen, by explore the world to defeat the vicious Devil King, and bring peace for the people !!"}, {"images": {"nodes": [{"file_name": "KQ_1080*360.png", "id": "786064732293541", "image_type": "APP_IMG_SMALL_LANDSCAPE", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974469_786064738960207_4749689403788812198_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7uaoh2P5JgQ7kNvwEWsoos&_nc_oc=AdrFDU-HgT1iw9SNDmu1lImwavB0Ajdn9UBycBkf1E_ZsIWNbCLkQHKkuKAjNeSs9ZQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlvSdxXbQXBuyARa0IF8od3gJN7qymquV-8opH30VUZA&oe=6ADE0894"}, {"file_name": "KQ_1440*1440.png", "id": "438350890698514", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75221331_438350894031847_8924041884466895870_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WW-rPWw6GCUQ7kNvwFdeMrF&_nc_oc=AdoPNzUOwpp2pP9Zk7Gj99blwhMEe6Jx-Dc1nmm1ywmeLCttipGzRFBLMiHCqVym_8Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRi1twC_x0UGtdk5k-kqywZsIez3BUDwWo70CH5PkxKQ&oe=6ADE09B3"}, {"file_name": "KQ_1008*1440.png", "id": "266229888189672", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982670_266229901523004_8014371044846660317_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MMFamkSs7koQ7kNvwEM5fKc&_nc_oc=AdoUjbNaZgQZ24iM38DXswLvO3PW3NvByrDoL0Pm30SvoC52g0HC-up0AOE8WB_58RY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6wyAp5H1pt76u7UYzRBMYV4QZAoo7ux13xAL
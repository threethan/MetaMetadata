02758785", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39001725_517059806092118_7462762512495582454_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DzrK87q-Vd8Q7kNvwFxsktX&_nc_oc=Adn7Nyxu_O2wrnOst2Xi_8wQ27L9k93MrZSM-m-QIWAX2F7H824jfRFIHpInvB6XdpM&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=8&oh=00_Afx0bAFLlKkcen1ejATxekeLuW3O0Jb_IvEBEODtHxW8oQ&oe=69AAC58E"}, {"file_name": "Screenshot03.png", "id": "852143972042044", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982449_852143975375377_3521140181557750365_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtUtddp4bFQQ7kNvwFgJGHb&_nc_oc=AdmSqSNE2P4tcPchA7QaVBOemjkO_IbNbnTjN2Y9u0trFbYmPpBDXMKh3ZNrgL57MQ4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afxcd_3vQVUqYwzgCDtvaNcYmQhXaetjkFW0CYZ5vCTG0g&oe=69AAD5C8"}, {"file_name": "Screenshot05.png", "id": "847266136137706", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38982535_847266139471039_6897886014697723757_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-YlgxUPPmVcQ7kNvwFOi3Zp&_nc_oc=AdmTfPoPJEcUGXFypiCKM28O3usaaJaRxekP5FE_QA6QlZbVIL-1ab4QY00GNK7gkC8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_Afz58oozEvkxXdCNzNHYoBOKKl-tLMTLbP_cMp-Jw9xBpg&oe=69AAB7EB"}, {"file_name": "Screenshot02.png", "id": "389297869066772", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982487_389297872400105_9219008850474244600_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8p15sKOUEPkQ7kNvwEYsK0T&_nc_oc=Adk0XKkNVoCo5cV5KrPsdkOx2sk6AarJwUbYMs2B4X6gVC3uZfLSxevAhVemJdbojL0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxxTEK5GhIEcBhSllAMBftVrCsP8dsg3FlN5Po9MAaAVQ&oe=69AAD30A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1353584178367717", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38984461_1353584181701050_8295691459651567578_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yM3bJ5ALgz4Q7kNvwFMSeLS&_nc_oc=AdlZ7tYaQkDSngcxtp30psmAzZQ7TzvIiSzIQ3qq_UoKN0AZLcuTYrm6wFk-iolbq40&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfwGGv9o2QWE8bbjoWuOxwwRw67P1Gyjw7WLeIYc_f9U6w&oe=69AAB299"}, "display_name": "Sep's Diner", "keywords": [], "long_description": "Welcome to Sep's Diner, the new burger restaurant of which YOU are the Chef! Will it really become the best burger in town? It's up to you now!\nLevel after level, your experience will increase as well as the number of your gourmet customers. They are in a hurry, so make it quick to satisfy them before they leave!\nHungry and impatient, they won't let you make a mistake... Be attentive and precise, to make the best possible profit!\n\nIncluding a brand new UI and weekly challenge!\n\nGame Features :\n\u00b7 3 restaurants\n\u00b7 4 game modes included : Timed, Relaxed, Infinite, Multiplayer\n\u00b7 27 levels included per restaurant (12 for timed/relaxed, 3 for Multiplayer)\n\u00b7 Co-op multiplayer up to 4 players\n\u00b7 Intense and thrilling levels!\n\u00b7 Immersive audio ambiance\n\u00b7 Impatient customers with fun voices\n\u00b7 Beautiful scenery and colored lights\n\u00b7 Increasing difficulty level after level\n\u00b7 More than 30 different combinations for burgers recipes!\n\u00b7 Burgers, Kebabs, Pancakes, donuts, waffles, ice creams and more!", "short_description": "Welcome to Sep\u2019s Diner, the new burger restaurant of which YOU are the Chef! Will it really become the best burger in town? It\u2019s up to you now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://voxel.scale1portal.com/privacy-policy", "developer_terms_of_service_url": "https://voxel.scale1portal.com/terms-and-conditions", "publisher_name": "SCALE-1 PORTAL", "support_website_url": "https://voxel.scale1portal.com/sepsdiner/#contact", "website_url": "https://voxel.scale1portal.com/sepsdiner", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "conte
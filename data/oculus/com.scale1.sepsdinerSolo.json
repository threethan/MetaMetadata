8-wQdF8Rkl09azUlk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTNWme0XZoZXxMq1bibMVCOXVZTdWoLO-as0zJ02YJNCw&oe=6B0DB72F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape.png", "id": "1353584178367717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984461_1353584181701050_8295691459651567578_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHfn9_g0KtAQ7kNvwG5WLPr&_nc_oc=AdqD9N1ao--QSzdIXc5FWWxx147iHxWVWOnv-6BKKolfWdVS8amxqLOFTEhboVi1uH8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSDcRT3oRlovd0Xi0YAT37lT_4QeEGdxoXctGdQ_2NDZA&oe=6B0DC699"}, "display_name": "Sep's Diner", "keywords": [], "long_description": "Welcome to Sep\u2019s Diner, the new burger restaurant of which YOU are the Chef! Will it really become the best burger in town? It\u2019s up to you now!\nLevel after level, your experience will increase as well as the number of your gourmet customers. They are in a hurry, so make it quick to satisfy them before they leave!\nHungry and impatient, they won't let you make a mistake, even though burger orders will become more and more complicated... Be attentive and precise, to make the best possible profit!\n\nGame Features :\n\u00b7 12 levels included\n\u00b7 Challenging but not impossible!\n\u00b7 Intense and thrilling levels!\n\u00b7 Immersive audio ambiance\n\u00b7 Impatient customers with fun voices\n\u00b7 Beautiful scenery and colored lights\n\u00b7 Increasing difficulty level after level\n\u00b7 More than 30 different combinations for burgers recipes!", "short_description": "Welcome to Sep\u2019s Diner, the new burger restaurant of which YOU are the Chef! Will it really become the best burger in town? It\u2019s up to you now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://voxel.scale1portal.com/privacy-policy", "developer_terms_of_service_url": "https://voxel.scale1portal.com/terms-and-conditions", "publisher_name": "SCALE-1 PORTAL", "support_website_url": "https://voxel.scale1portal.com/sepsdiner/#contact", "website_url": "https://voxel.scale1portal.com/sepsdiner", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "FOOD", "SIMULATION"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1659769311039374"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1108131478895262"}, {"status": "PUBLISHED", "id": "537850839227219"}, {"status": "PUBLISHED", "id": "517597885942604"}, {"status": "PUBLISHED", "id": "195798579377005"}, {"status": "PUBLISHED", "id": "437964681072417"}, {"status": "PUBLISHED", "id": "536351697981689"}, {"status": "PUBLISHED", "id": "847926789123330"}, {"status": "PUBLISHED", "id": "859795971355068"}, {"status": "PUBLISHED", "id": "717731236265884"}, {"status": "PUBLISHED", "id": "249783497257073"}]}, "baseline_offer": {"id": "437964681072417"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797883200, "status": "PUBLISHED", "id": "1108131478895262"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29134517139492376", "version": "22727"}, "id": "712748529612023", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "3590
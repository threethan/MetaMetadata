ohc=PF_uFJUFDvwQ7kNvwF5SceG&_nc_oc=Adrbym-XQJ_uMmWWFtK7sPcidCIUUs9PhRDFVZTU7Mbk778-42ertZaLG6tzF0H9oSA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8FNtILjGT8KEj4qOiY1wxgPadiM5K6ENxFy_KQQe8RVA&oe=6A467BD9"}, "display_name": "Sep's Diner", "keywords": [], "long_description": "Welcome to Sep's Diner, the new burger restaurant of which YOU are the Chef! Will it really become the best burger in town? It's up to you now!\nLevel after level, your experience will increase as well as the number of your gourmet customers. They are in a hurry, so make it quick to satisfy them before they leave!\nHungry and impatient, they won't let you make a mistake... Be attentive and precise, to make the best possible profit!\n\nIncluding a brand new UI and weekly challenge!\n\nGame Features :\n\u00b7 3 restaurants\n\u00b7 4 game modes included : Timed, Relaxed, Infinite, Multiplayer\n\u00b7 27 levels included per restaurant (12 for timed/relaxed, 3 for Multiplayer)\n\u00b7 Co-op multiplayer up to 4 players\n\u00b7 Intense and thrilling levels!\n\u00b7 Immersive audio ambiance\n\u00b7 Impatient customers with fun voices\n\u00b7 Beautiful scenery and colored lights\n\u00b7 Increasing difficulty level after level\n\u00b7 More than 30 different combinations for burgers recipes!\n\u00b7 Burgers, Kebabs, Pancakes, donuts, waffles, ice creams and more!", "short_description": "Welcome to Sep\u2019s Diner, the new burger restaurant of which YOU are the Chef! Will it really become the best burger in town? It\u2019s up to you now!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://voxel.scale1portal.com/privacy-policy", "developer_terms_of_service_url": "https://voxel.scale1portal.com/terms-and-conditions", "publisher_name": "SCALE-1 PORTAL", "support_website_url": "https://voxel.scale1portal.com/sepsdiner/#contact", "website_url": "https://voxel.scale1portal.com/sepsdiner", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "
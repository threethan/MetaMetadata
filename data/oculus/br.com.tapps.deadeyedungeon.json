_nc_sid=6e7a0a&_nc_ohc=ZBtxBscExXMQ7kNvwHLpu8T&_nc_oc=AdpfpIG4Jpr5wVzTGRYw2R-V_Auo2iSFQjjKktCyPVwT0_Jo7SNqulrbQtq5KROHuzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3M4_6L7kkANNZnSA8TMpNBMMikj4rx9puFA5Gu3FLnmg&oe=69E36AAB"}, {"file_name": "migrated_image.png", "id": "236060684100118", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/11162686_734824180011996_6155298050588803072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d2MKi2KQ6YQ7kNvwEmqWy3&_nc_oc=AdqiC2Y9e5PpTnIOnA5HqRDHgPpYh1F5FdBUXVe0B5k9bJX1lpYExYKaU5tkXMh3gZ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O8aJu-xs12jiVa1K-1mUK8v1zlcoqsTgVuZO0WHiNjw&oe=69E36F50"}, {"file_name": "migrated_image.png", "id": "211503126603151", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/11162686_1302141543214404_5643938475527897088_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EzHJ-zJd8JcQ7kNvwHCqtrY&_nc_oc=AdqjLZUTQ8uB_iZZIvFW5XxnXrvSwZ6YnaX6I57zc5jwLdhuat337ZlXW22HabmAgz0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ww4eSQCwtdgAF2hGvZWhavmidlWyT2Ip5wrltKbF2oQ&oe=69E3832D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadeye Dungeon", "keywords": ["RPG", "Gun", "Exploration", "Shooter", "Fantasy"], "long_description": "Delve into an unknown dungeon deep within the ominous Deadeye Mountain and face the nightmarish creatures that guard its darkest secrets. Load up your powerful Arcane Gun and shoot your way through the treacherous depths in a scary new VR experience!\n\nREACH THE DEPTHS\nVenture deep underground as you traverse the shadowy floors of a forgotten dungeon using a comfortable teleportation system.\n\nSHOOT THEM ALL\nCome face-to-face with terrifying monsters, from creepy crawlers slithering at your feet to huge boss beasts that can crush you in a second.\n\nDISCOVER SECRETS\nExplore every corner of an ancient dungeon to find hidden treasures and powerful loot, including new and improved Arcane Guns.\n\nSTAY ON YOUR TOES\nHandle the tense atmosphere of a dangerous dark fantasy world where every corner you turn may be your last!\n\nGet ready to be immersed into this unforgettable dungeon crawling adventure!", "short_description": "Shoot monsters and discover dark secrets in a relentless new VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "EXPLORATION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2757591844544633"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "252723111973042"}, {"status": "PUBLISHED", "id": "301393336979179"}, {"status": "PUBLISHED", "id": "1893100317385425"}]}, "baseline_offer": {"id": "301393336979179"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1528995600, "status": "PUBLISHED", "id": "252723111973042"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2143467915712795", "version": "2.1"}, "id": "1075414339257956", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applica
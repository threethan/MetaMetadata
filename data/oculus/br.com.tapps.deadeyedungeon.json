Wb3ZyCM0Fgy6-Kb2nNVhm6kRVi6T0xUes&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxi7ynGkxlLu8eHotD7Bum6l9WXcijbtxxA3jQTsTBJAg&oe=69B151AB"}, {"file_name": "migrated_image.png", "id": "236060684100118", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162686_734824180011996_6155298050588803072_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w3IELDs5peIQ7kNvwHLsAd0&_nc_oc=AdlY8ZW2nV68WZhFJRN3wtsDHfES1NN2L0UwLzz2qXNnTE7t8dCYV8y07Z6T-ydxw7s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwQulGnG199WCXyr4GdA-oC9cXmqHamy-rvskuYr96N5g&oe=69B15650"}, {"file_name": "migrated_image.png", "id": "211503126603151", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/11162686_1302141543214404_5643938475527897088_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rtlX4jlo-8Q7kNvwEHBRE0&_nc_oc=AdkDzJevgs_f5RYyZXIPb2r4QhS5C3ZDFAvf0R-7fiTNTD3fkka3oW8hUR3cc_2j-Rg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzKsbYqNuhqE90OEshrtvmBOtWsdk3aE8AcpaECpyFvAQ&oe=69B16A2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Deadeye Dungeon", "keywords": ["RPG", "Gun", "Exploration", "Shooter", "Fantasy"], "long_description": "Delve into an unknown dungeon deep within the ominous Deadeye Mountain and face the nightmarish creatures that guard its darkest secrets. Load up your powerful Arcane Gun and shoot your way through the treacherous depths in a scary new VR experience!\n\nREACH THE DEPTHS\nVenture deep underground as you traverse the shadowy floors of a forgotten dungeon using a comfortable teleportation system.\n\nSHOOT THEM ALL\nCome face-to-face with terrifying monsters, from creepy crawlers slithering at your feet to huge boss beasts that can crush you in a second.\n\nDISCOVER SECRETS\nExplore every corner of an ancient dungeon to find hidden treasures and powerful loot, including new and improved Arcane Guns.\n\nSTAY ON YOUR TOES\nHandle the tense atmosphere of a dangerous dark fantasy world where every corner you turn may be your last!\n\nGet ready to be immersed into this unforgettable dungeon crawling adventure!", "short_description": "Shoot monsters and discover dark secrets in a relentless new VR experience."}]}, "developer_name": null, "developer_privacy_policy_url": "http://pp.tappsgames.com.s3.amazonaws.com/GeneralPP.htm", "developer_terms_of_service_url": "http://tos.tappsgames.com.s3.amazonaws.com/GeneralTOS.htm", "publisher_name": "Tapps Games", "support_website_url": null, "website_url": "http://www.tappsgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["ACTION", "ARCADE", "EXPLORATION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2757591844544633"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "252723111973042"}, {"status": "PUBLISHED", "id": "301393336979179"}, {"status": "PUBLISHED", "id": "1893100317385425"}]}, "baseline_offer": {"id": "301393336979179"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1528995600, "status": "PUBLISHED", "id": "252723111973042"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2143467915712795", "version": "2.1"}, "id": "1075414339257956", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1395533030506291", "is_concept": false, "latest_released
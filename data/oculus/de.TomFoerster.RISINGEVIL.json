.\nBut be warned, something is watching you..."}]}, "developer_name": "Tom F\u00f6rster", "developer_privacy_policy_url": "http://www.forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom F\u00f6rster", "support_website_url": null, "website_url": "http://www.forstech.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "HORROR", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "890477914919513"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "2211747082455153"}]}, "baseline_offer": {"id": "2211747082455153"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1578592826, "status": "PUBLISHED", "id": "2211747082455153"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2326469430797912", "version": "3.0.1"}, "id": "2441331176183035", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "2307438349367687", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "2326469430797912"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2441331176183035"}]}, "change_log": null, "created_date": 1575408694, "id": "2326469430797912", "version": "3.0.1", "version_code": 36, "release_status":
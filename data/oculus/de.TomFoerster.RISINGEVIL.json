-P5OZeV5tY0zlHqtf_duWlLEXrxk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLa5laNqdXyDWor-Ue-lMc9Gv7huxIvCs88pHmXzFFGfg&oe=6AB7D705"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rising Evil Free", "keywords": ["rising", "evil", "horror", "game", "escape"], "long_description": "ATTENTION: If you have any heart or epilepsy problems do not play this evil game! Be warned.\n\nYou woke up in a room, alone, beat your nightmares and try to find a way out.\nBut be warned, something is watching you...\n\nIt features amazing 3D high end graphics and a stunning haunted horror atmosphere.\nRealistic 3D spatial sound will provide the ultimate thrilling experience.\n\nNew Features coming soon! (Tell us what you would like to play, we love feedback!)\n\nPlease vote for our app so that we will be adding more VR apps soon!\nIf you are experiencing any bugs feel free to contact us, we're still learning.", "short_description": "You woke up in a room, alone, beat your nightmares and try to find a way out.\nBut be warned, something is watching you..."}]}, "developer_name": "Tom F\u00f6rster", "developer_privacy_policy_url": "http://www.forstech.de/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Tom F\u00f6rster", "support_website_url": null, "website_url": "http://www.forstech.de/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "HORROR"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "445426100612083"}, "review_messages": []}]},
_oc=AdqgtyDS44Mb2wQagZ8reA2P6LB2cyEKiCTucx8wFHY_dyl50sofKvg70JIU6biWai4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQV31zTUGY76iQTNgBFiHzn7TzyBOVpeGzBFAq_4O-aFHA&oe=6B105FF7"}, {"file_name": "03_Soldier_View_Drone_Combat_2560x1440.png", "id": "1626612492284079", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622192_1626612495617412_4751083577159378757_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W1zsQoXetBAQ7kNvwGsJLZD&_nc_oc=AdoGVEM8_AdnyYTvGT8zsoC01Jy94OUK96C67VMFa7GmHQFbcDulxiZwTdTY0o7LdUM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWptNkZR0VVd0Fij3TF7s_DfwAV17VrJfZXicA3ZGIT1w&oe=6B10556A"}, {"file_name": "02_Hand_Tracked_Command_2560x1440.png", "id": "1105109165684749", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499628893_1105109169018082_8566808198940504477_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jKsBr_381sQ7kNvwFHEs0d&_nc_oc=AdqnLmuEozhPVK9EAOS22BBfuEdsD0Lh2GdE9WBpD0gH04vWggHmjabAR119Zp6CYZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUcBZWNMLpO6zpl1IdK85dlESNl-C98F80fpR5o9xZLdQ&oe=6B1047D0"}, {"file_name": "01_Pyramid_Giant_Enemy_1920x1080.png", "id": "1052353347812719", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623131_1052353351146052_4841820390706064228_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LFIyoPKo6O0Q7kNvwHTORfR&_nc_oc=AdpG5TIvHBRF5KgXAuIl34mYYnJhAUhcZ24gykBIjbpAr160NB2jGTBQwO2Jj1AbalM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWTXBFHpoQl48NGaFgv6K8p64HBJcE6VWDc7x8jfYNB2g&oe=6B106063"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ActionSquad_Loading_Splash.png", "id": "2348750672528048", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499628454_2348750675861381_5242942822357209303_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLBLFBJ4pr0Q7kNvwH6Ane4&_nc_oc=Adr2jgP3WAQApdqaUse_rj-HbSAh2uiDN5dZkiLLRHxLVZ6g0AlYSPv7E8N6f75vJgQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0hJQk1FSt7tVF6md4qBe3Q3ZoK4HXnuHQEyq99lrnfw&oe=6B1051B3"}, "display_name": "Fortress Line: Tactical Command", "keywords": [], "long_description": "Fortress Line: Tactical Command is a single-player VR/MR strategy game that combines overhead battlefield command with direct soldier combat.\nFrom above, use hand tracking to select units, deploy soldiers, and issue movement orders as enemy waves approach. To join the fight, select a soldier and take control from their perspective. Fight on the ground, move through the battlefield, and defend the line firsthand.\nSwitch between strategic command and direct combat as the situation changes.\nBegin with the Tutorial, then advance through three battlefields:\nGreat Wall \u2014 Levels 1\u201310\nNormandy \u2014 Levels 11\u201335\nPyramid \u2014 Levels 36\u201350\nEach battlefield introduces new routes, stronger enemies, and tougher defensive decisions. Learn the terrain, protect your positions, command your squad, and join the fight when the battle demands it.\nPlay in VR or switch to optional Mixed Reality, where the miniature battlefield appears in your real surroundings. Your surroundings affect how the battlefield is presented, not its rules or collision behavior.\nFortress Line: Tactical Command is a self-contained offline experience. No account or internet connection is needed.", "short_description": "Command a miniature battlefield from above: deploy and reposition soldiers with hand tracking, then take control from a soldier\u2019s perspective and fight on the front line. Switch between strategic command and direct combat as the battle unfolds, defending the Great Wall, Normandy, and Pyramid across 50 increasingly challenging levels in VR or MR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zp1412042552-hue.github.io/Fortress-Line-Website/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "ZP Games", "support_website_url": "https://discord.gg/sjkvgWZuA", "website_url": "https://zp1412042552-hue.github.io/Fortress-Line-Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1618873366215662"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620384_1095301759747143_2241165587675963429_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IfZsPSpbIl4Q7kNvwGlWp0o&_nc_oc=AdomzANxdia0DrZcsU2nKReGP2WrB8OCKGGTTlV3oRH202LyIOQV0cYq_oQstqLsvXA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUGFpCTcJdUEu5lQPafqTWq6osDaalAK0SXuy_U1Yo0vQ&oe=6B105FEE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fortress Line: Tactical Command", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Strategy", "id": "275629210202852"}], "release_date": 1792548000, "lastRevision": {"nodes": [{"id": "1568862984550034", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applic
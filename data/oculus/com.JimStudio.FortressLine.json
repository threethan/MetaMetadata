226007658", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499624606_1752861229340991_4844608104350839014_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G1HZDi90s9EQ7kNvwEpoArc&_nc_oc=Adpe1uXWyA0PmnjbuUTu7lJDeH6xtmZP7VZAZ9SJ4Db8qEaPQqRTFevG1jY5cHHpbTM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWOCXvFEfhtwuOzeKIfkeMe6BFOKFjjlBxMa6EVW47vgg&oe=6B1053C5"}, {"file_name": "9\u670828\u65e5 (1)(1).png", "id": "3732064540268232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622192_3732064550268231_8296866426004529664_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNRDjqss27gQ7kNvwGlthqg&_nc_oc=AdqHqfH-xWvnlPTVe1CtIMdh6aBpalmW3OyDvbI-eW0AbAT_mMJIr-q1SDI1hEkLy3k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWuH-vb1XVO9O9hCn4zlrZUS_tQ2pi2OyIhmXSpif3nJw&oe=6B10444D"}, {"file_name": "ok.png", "id": "1558502496317676", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620655_1558502499651009_6341195402648439470_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qu8zi7rj_n8Q7kNvwHCx-Gs&_nc_oc=Adrip0AaoLm7jT8OLlO4PvxJ8gVKxxyiw3JyyGz0zf-C1CN22ysFiV7L5EKoxJeSiuI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVJBR0utYwzeQjsyG2dnG25Kht_E9GzAS2L1syR6b0oTw&oe=6B10443A"}, {"file_name": "9\u670828\u65e5(2).png", "id": "1081186691327838", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499626808_1081186694661171_4502768004113480174_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_axLJbTQpLUQ7kNvwGRz7zS&_nc_oc=AdpYr8EmSrt0VKdhkyYBs49ZuL284dEM0xhMhSOzM8giVNAGzH3r-yOGof7KQ1QBS3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVOg7PaVd5uvwygJWtQYDVVOzTxXyej9wTyfW9-R-xKUw&oe=6B105F89"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fortress Line: Tactical Command", "keywords": [], "long_description": "Fortress Line: Tactical Command is a single-player VR/MR strategy game that combines overhead battlefield command with direct soldier combat.\nFrom above, use hand tracking to select units, deploy soldiers, and issue movement orders as enemy waves approach. To join the fight, select a soldier and take control from their perspective. Fight on the ground, move through the battlefield, and defend the line firsthand.\nSwitch between strategic command and direct combat as the situation changes.\nBegin with the Tutorial, then advance through three battlefields:\nGreat Wall \u2014 Levels 1\u201310\nNormandy \u2014 Levels 11\u201335\nPyramid \u2014 Levels 36\u201350\nEach battlefield introduces new routes, stronger enemies, and tougher defensive decisions. Learn the terrain, protect your positions, command your squad, and join the fight when the battle demands it.\nPlay in VR or switch to optional Mixed Reality, where the miniature battlefield appears in your real surroundings. Your surroundings affect how the battlefield is presented, not its rules or collision behavior.\nFortress Line: Tactical Command is a self-contained offline experience. No account or internet connection is needed.", "short_description": "Command a miniature battlefield from above: deploy and reposition soldiers with hand tracking, then take control from a soldier\u2019s perspective and fight on the front line. Switch between strategic command and direct combat as the battle unfolds, defending the Great Wall, Normandy, and Pyramid across 50 increasingly challenging levels in VR or MR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://zp1412042552-hue.github.io/Fortress-Line-Website/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "ZP Games", "support_website_url": null, "website_url": "https://zp1412042552-hue.github.io/Fortress-Line-Website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "contex
etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0KYcTLhgBwQ7kNvwGn5N3S&_nc_oc=AdrteeJe6A5PbJD2X1RynqgclLSDQZJeBJgM6diK2tqpZw4uBM8LDAG6BtgEIC_oMKM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1OtCvJfE-U4Jy9zZyuA1qsJHbMYxHWPfHsjKmKWbx7g&oe=6AFEFF1E"}, {"file_name": "Exoshock_F3797.png", "id": "2880702635634034", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_2880702638967367_7281622528886127213_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1BFEuOIVxjMQ7kNvwH-po7R&_nc_oc=Adpb4IyiygtPwbMdm4JD69RcL2FrVU_j69bSvsdnG6lPMLSDdveYrYAZXIrIgpagmhA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpHJg5yrvFmNUznBt3VwkAaB92yf36DQR_lm633V2pVA&oe=6AFF187E"}, {"file_name": "Exoshock_F4908.png", "id": "1424375282534771", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831299_1424375289201437_1716906967201781931_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y3kUHdlvJE0Q7kNvwHX52D7&_nc_oc=AdohPGzvgxTkBorBO_PplMyptJG5iuctSnShuwCsKp02t2G9WYhsE-RBKiZ2YgIaFXM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRlTqvRQVws3zlI312BEANx8uxCIAgZvJBW3PMIC3h2w&oe=6AFEFEBF"}, {"file_name": "Exoshock_F17812.png", "id": "2108211300582003", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/818442663_2108211303915336_7717153806940331504_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D1L-LTNkCEQ7kNvwHF8IUG&_nc_oc=Adpk9NeoktpQnfsma_HxeUPkxL5CmchUqeV5lCWGqisSoztaYsIYlj2NWkLF1o6AnCw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTk_ku1b24hkmulZJuxQi26i64clF3tOrnUAyIOPzqsPw&oe=6AFF0F17"}, {"file_name": "Exoshock_F19489.png", "id": "2189190295328964", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/585720338_2189190298662297_5928342381138957938_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSwQTicDFIAQ7kNvwFaVHMq&_nc_oc=Adpj0DqwZPaETSyfusTLpjUF707W-vqpRsqemMtZX9hoVIHY-zAi4coXfloePIhprjo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgo8MLuoUo0IhyS1D2RzO09cZDZa8Os2ynxsODvY3WaQ&oe=6AFF2197"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.PNG", "id": "1129939239490025", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/654904853_1129939242823358_7171986077159820390_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jLDquC6Y4-4Q7kNvwETqN8j&_nc_oc=AdpRYn21hvioKOnfcblHXNqCTklF72aflQ4DF17lINHBpe2MQc_BnvtUfQyAGwNZpRY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQisTg45nfkSsHsTKOi6ltTAUETBNgAEto5mJOHB7dBQQ&oe=6AFF1028"}, "display_name": "Exoshock", "keywords": ["fps", "coop", "shooter", "scifi", "pve"], "long_description": "**EXOSHOCK  - The Firefight Redefined.** \n\nStep into a **1\u20134 player co-op sci-fi PvE shooter** driven by one vision: to deliver **the most visceral combat**.\n\nA hybrid co-op FPS **built for VR**, where **flat-screen players fight in your squad**. Full cross-play.\n{995872566894994}\n**COMMAND THE CHAOS** - You are a Division 9 operative, owned by the Basilisk Group. Board starships in transit, sabotage systems, steal data, and eliminate targets. Gear up, complete your Contract, get out, and return for another.\n{1781064126480031}\n**REDEFINE THE FIREFIGHT** - Enemies flank, suppress, and push your squad. Reload under fire, strike with melee, and cover your teammates. Find an opening and turn a desperate fight around.\n{1157746316934332}\n**ADAPT TO EVERY RUN** - Fight across three starships of varying sizes, including some of the largest maps ever built for VR. Semi-procedural objectives, six Resistance levels, and Contract Complications mean no two runs are the same. Face melee droid hordes, automated defenses, or hostile forces fighting each other.\n{1874930530624243}\n**BUILD YOUR ARSENAL** - Complete Contracts to earn currency and increase your Arsenal Level, unlocking primary weapons, secondary weapons, and items. Customize your armor, colors, patterns, and patches.\n{1900553691102407}\n**VR & PC. SAME SQUAD.** - Play solo or team up with friends in 4-player co-op. AI teammates fill the remaining squad slots. Solo play is also available completely offline.\n\n**JUST THE BEGINNING** - Early Access is our foundation. Expect some bugs and rough edges as we expand, refine, and improve EXOSHOCK with the community.", "short_description": "EXOSHOCK is a 1\u20134 player co-op sci-fi PvE shooter driven by one vision: to deliver the most visceral combat. A hybrid co-op FPS built for VR, where flat-screen players fight in your squad. Full cross-play. Play solo with AI teammates, even completely offline, or team up with friends in 4-player co-op."}]}, "developer_name": "PolarityOne", "developer_privacy_policy_url": "https://exoshockgame.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://exoshockgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "29641612585431494"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/604298355_2077917902847986_4181662070278234482_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6
_ss=7f20f&oh=00_AQSklBg6EGoLQyroi7MuQw8CfpLKyJRLaIZCvREIo1vgnA&oe=6AFDB4DE"}, {"file_name": "EXS_Screeshot_05.png", "id": "1404167554351988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473393984_1404167557685321_8029243256161281274_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3IKeXQF2sl8Q7kNvwFW7CCh&_nc_oc=AdoBQcJXzKjk5iEBPV1T-46LK7MGaSizLA_y02OuVIlejRirHmnY_Uv1RdSqhgKQLJk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkyE8qjrrUscoQ9sQ8Nz17TC_C30dOFhjOMztAA72gUA&oe=6AFDC4E6"}, {"file_name": "EXS_Screeshot_04.png", "id": "1454416058870319", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391934_1454416062203652_7747540442805885498_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lt6lqEIejHAQ7kNvwF54tTh&_nc_oc=AdrailMVtbXRZUIqJBrDKsaK1NTOJMxENz8P6sFoJXlHxANkxlN01gvojGVaDnlCZ3U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGlppv4_JufQJ3b-_M_c3ZHaxV75rqQc0cvipAF7HGZQ&oe=6AFDB925"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "EXOSHOCK", "keywords": ["fps", "coop", "shooter", "scifi", "tactical"], "long_description": "Exoshock is a cooperative sci-fi PvE shooter that redefines VR combat with intense firefights, squad tactics, and dynamic battlefields.\n\n# INTO THE FIRE\nThe dropship doors slam open. Gunfire erupts as your squad breaches the hostile warzone. Tactical coordination and split-second decisions mean survival or annihilation.\n\n# ADAPT YOUR PLAYSTYLE\nCustomize your loadout, refine your tactics, and coordinate with teammates. Whether leading assaults, supporting allies, or adapting on the fly, Exoshock lets you shape your combat experience.\n\n# EVER-CHANGING WARZONES\nInvestigate a derelict warship overrun with Ravagers or pivot when defenders disable life support mid-mission. With adaptive AI and evolving gameplay, no two missions play the same.\n\n# IMMERSIVE, CINEMATIC WARFARE\nGunfire illuminates the darkness, sparks spray from ricochets, and klaxons blare. Powered by Unreal Engine 5, Exoshock delivers next-level combat intensity.\n\n# FEATURES BUILT FOR REPLAYABILITY\n- Face adaptive AI that counters your tactics.\n- Engage in intense 1-4 player co-op firefights.\n- Customize loadouts to suit your style.\n- Battle through unpredictable environments.\n- Adjust strategies between aggression and precision.\n- Evolve with player-driven updates.\n\nYour mission is set. Your squad is waiting. Will you step into the fire\u2014or be lost to the void?", "short_description": "Gear up, soldier! Exoshock thrusts you into a relentless sci-fi PvE shooter in VR.\n\nInspired by Halo, Warhammer 40k, and Helldivers 2, this tactical VR experience delivers dynamic battlefields, visceral combat, and squad-based chaos. \n\nEngage in intense firefights, outmaneuver adaptive AI, and conquer with 1-4 player co-op. With satisfying weapons, fluid movement, and endless replayability, this is VR warfare evolved. Team up or go solo; can you command the chaos?"}]}, "developer_name": "PolarityOne", "developer_privacy_policy_url": "https://exoshockgame.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://exoshockgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "us
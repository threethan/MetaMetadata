u_FntgTHywcHBb-MgQegALKbQTXYxXqad4YKznBA&oe=6AF4731E"}, {"file_name": "Exoshock_F3797.png", "id": "2880702635634034", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831299_2880702638967367_7281622528886127213_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1R6lmTd8DAQ7kNvwH9OPVZ&_nc_oc=AdrrouXRmHy-RqoyPhLGoSOiSHaKvWw82dJUL31oADXEDUolCQVljg_rX4Zptm-fAT8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQSjk_Kb64M4I5LQJt27Kbf3Tv0NFR8YyDg-vLkI4v_A&oe=6AF48C7E"}, {"file_name": "Exoshock_F4908.png", "id": "1424375282534771", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831299_1424375289201437_1716906967201781931_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv7m2zOdyrcQ7kNvwEx_v97&_nc_oc=AdoPdy5Y_acj_OTzgr39Z7h9AwG9l5EfsfQhM9KmWdgwXVXuUYJH2NwqYVS3XZoJkIU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEswuwXNauSr8uOUsVVo0dRhq7vOx-_E7hNeOv9WSlWQ&oe=6AF472BF"}, {"file_name": "Exoshock_F17812.png", "id": "2108211300582003", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/818442663_2108211303915336_7717153806940331504_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TnUEm5T-mkEQ7kNvwEVb256&_nc_oc=AdoPReej9_X1uWTGFvK83hLqXocSMVKgdjd9dHVUZ58VZQ6c5o25WijEBpv_8pnbaOc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReJSc5lInHK72venKeYUuZqke6rzvvv3lA4lR01fS85w&oe=6AF48317"}, {"file_name": "Exoshock_F19489.png", "id": "2189190295328964", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/585720338_2189190298662297_5928342381138957938_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nbk4T0YYc6EQ7kNvwGBVtZH&_nc_oc=AdqFLIWrvDEv-KPuLWMx0m27vk21qyIKReTB81Ce2NUu2cElCOhgi358DF7hkitwSNc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTskOIBNZmkwh2kn6Ng6MQo8P7vt6IbzUp6PiU24xk2fQ&oe=6AF49597"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer_thumb.PNG", "id": "1129939239490025", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/654904853_1129939242823358_7171986077159820390_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AAsVW6M1T4Q7kNvwFVqfjK&_nc_oc=Adpcimpk1rLRQVKRXXEH9QL9MUN6qOp1QD2DzRkNGDJd6HLFFR3SV2put6gZ6X4neWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuDJTDnPLb75RSsiWF_rs-ymWvVu6CLaBZR8-1cLc7Xg&oe=6AF48428"}, "display_name": "Exoshock", "keywords": ["fps", "coop", "shooter", "scifi", "pve"], "long_description": "**EXOSHOCK  - The Firefight Redefined.** \n\nStep into a **1\u20134 player co-op sci-fi PvE shooter** driven by one vision: to deliver **the most visceral combat**.\n\nA hybrid co-op FPS **built for VR**, where **flat-screen players fight in your squad**. Full cross-play.\n{995872566894994}\n**COMMAND THE CHAOS** - You are a Division 9 operative, owned by the Basilisk Group. Board starships in transit, sabotage systems, steal data, and eliminate targets. Gear up, complete your Contract, get out, and return for another.\n{1781064126480031}\n**REDEFINE THE FIREFIGHT** - Enemies flank, suppress, and push your squad. Reload under fire, strike with melee, and cover your teammates. Find an opening and turn a desperate fight around.\n{1157746316934332}\n**ADAPT TO EVERY RUN** - Fight across three starships of varying sizes, including some of the largest maps ever built for VR. Semi-procedural objectives, six Resistance levels, and Contract Complications mean no two runs are the same. Face melee droid hordes, automated defenses, or hostile forces fighting each other.\n{1874930530624243}\n**BUILD YOUR ARSENAL** - Complete Contracts to earn currency and increase your Arsenal Level, unlocking primary weapons, secondary weapons, and items. Customize your armor, colors, patterns, and patches.\n{1900553691102407}\n**VR & PC. SAME SQUAD.** - Play solo or team up with friends in 4-player co-op. AI teammates fill the remaining squad slots. Solo play is also available completely offline.\n\n**JUST THE BEGINNING** - Early Access is our foundation. Expect some bugs and rough edges as we expand, refine, and improve EXOSHOCK with the community.", "short_description": "EXOSHOCK is a 1\u20134 player co-op sci-fi PvE shooter driven by one vision: to deliver the most visceral combat. A hybrid co-op FPS built for VR, where flat-screen players fight in your squad. Full cross-play. Play solo with AI teammates, even completely offline, or team up with friends in 4-player co-op."}]}, "developer_name": "PolarityOne", "developer_privacy_policy_url": "https://exoshockgame.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "VRAL Games", "support_website_url": null, "website_url": "https://exoshockgame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER", "CO_OP"], "id": "29641612585431494"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604298355_2077917902847986_4181662070278234482_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5wryEo3IicQ7kNvwHVERrM&_nc_oc=AdpQHFmP2WjkmwMxZ5UWbSLUpwcXeAFhPJywjUHbeQu9LXk9BZHCDVeVF5t54zelG1U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXR2kTenMOFC7OheOa9wK6VeKtiAG6iM319g3GpteUpA&oe=6AF482C0"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Exoshock", "platform": "ANDROID_6DOF"
=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rag8ExpbnTUQ7kNvwGrkrH6&_nc_oc=AdpZUJWVXg7wtQhDIg8Hsl3hHMMzdpbWVZdFk2yCvdlCi0avrndHCCPOUMzqxCBiCpw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRUrBP7-i97t4p_9VAz1GiLfh4v5i_Rw_Xvk9hKbz8a2w&oe=6B0C5FF8"}, {"file_name": "Screenshot 2026-10-19 221416.png", "id": "1048270501611004", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499303707_1048270504944337_3785130098301509880_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1St3D6w1RkQ7kNvwFKC3iD&_nc_oc=Ado5bPzoKTDRBI8Q7H9hi3Cy4y-kDyaNoHLgfpu1TlbXe0eiPDR4GRu4qPBKA--JXtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTham1kULXZ_Z5wW7oyPj3zHZpzl8HdhphZqQKsYlIDtQ&oe=6B0C7BF8"}, {"file_name": "Screenshot 2026-10-19 220044.png", "id": "1674647251112636", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310596_1674647254445969_8074082870655189606_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRbLPD7nGywQ7kNvwF36bVo&_nc_oc=AdoXYdk4v9dAOa9HNNWLmtnr_K8FvkfOasSgi38h0lK6U3VDEP7G1Gw2D9XI_5Hv7QI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQO26vdUaicK1qiMpy2NVvuYkCVOdN-zVQL27Eb7IZ2A&oe=6B0C8084"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "a_fishing_tale_trailer_cover_2560x1440.png", "id": "1890437188548316", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499303976_1890437191881649_2229680087481474242_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x0rWqdrQRJsQ7kNvwGepIGU&_nc_oc=AdpAQ5X0fRX71Nk_bpkiIyXBE5JiOZWPlxEDu85hEJWR04ACBvLagoGBDJS0hLUs8Gk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaAVj9koOgGDhgmfGHLYpyFCjshPRJZVZ3dlWnjjLLBw&oe=6B0C4F2E"}, "display_name": "A Fishing Tale VR (DEMO)", "keywords": ["Fishing", "Relaxing", "Cozy", "Casual", "Demo"], "long_description": "Slow down. Cast a line. See what\u2019s biting.\n\nA Fishing Tale is a cozy VR fishing game about the simple pleasure of a quiet afternoon by the water. This free demo is your first look: one peaceful spot, a rod in your hands, and fish waiting to be caught.\n\nFishing you can feel\nEvery part of the catch happens in your hands. Cast out, watch your float, and wait for the bite. When a fish takes the line, you\u2019ll feel it through your controllers. Set the hook, keep an eye on the tension, and reel it in before the line snaps. Some fish come easy. Others will put up a fight.\n\nMade for unwinding\nThere\u2019s no clock running and no score to chase. Stay for ten minutes or a whole afternoon.\n\nMore on the way\nThis demo is just the beginning. The full game will bring more fish, more gear, and new places to explore. Your feedback helps shape what comes next.", "short_description": "Grab your rod and head down to the water, a quiet corner of the world made for slowing down. This free demo of A Fishing Tale lets you try the heart of the game: hands-on VR fishing where every cast, hook set, and reel is done with your own hands. Feel the bite through your controllers and play the line as the fish fights back. No timers, no pressure. Just you, the water, and whatever\u2019s waiting below the surface."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fyrebitestudios.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "FyreBite Games", "support_website_url": null, "website_url": "https://fyrebitestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_dev
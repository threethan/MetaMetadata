=7f20f&oh=00_AQJgx-JLkWrNjM0X_OBMSSnYBSynooxGc_axV07l3gTmZQ&oe=6AAAAEFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPhsVdAuLfAQ7kNvwGATJEA&_nc_oc=AdpN-uiFUO6eh7CzD0Gp9h6czO8V7ImgUorAgIpAHQw_4zxniKQzXVb-lUXcBSYMYMA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNeLpOzxi0nBrSJWnbIGlPZ4zYmqk5dwWAYuOfYsC-WA&oe=6AAA97C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9jaB6zRW58Q7kNvwFdKonx&_nc_oc=AdrDThsHIzEIo2ZgbUzuowBhFgmpfl1jScMvIuxrzGArL7oWylFqapZvq7vLMgNU774&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxEwpVI0uQcJaXDRu1j4GzaSzx_xSa9ju_wlXzNlOYag&oe=6AAA8A37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3YUCdkaU6AQ7kNvwGx19hB&_nc_oc=AdqRksdeGRdfN4gQ6Ds3444f0-P5Jdmm2mhh75tcpQRL0YyEFkqoeKa5NRDUcpSUJeI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ_0CH2-mnb1HYDuSYrAOYOaKrehZGfBRCaUO0IPIc28Q&oe=6AAAAE68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1NwUQlG5aoQ7kNvwEek-W7&_nc_oc=Adpfewp6hGrgZCw4z3fSLCmNwD7UVfk7slWB4Xz659uOtKIPle8i1DgMxGC-3C_bZRM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-ZLr612BMW6H-bPU5grlTLs145klg5ownVhMwX7aaVg&oe=6AAAA417"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrAJ6enLWCoQ7kNvwFu7j8_&_nc_oc=AdpvDyiwP9d-D41rfuT6FR0AQq9_QEUVwKVTDQiz8sqgZlvsz250S2nHdyKvA6JzUrs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLP6qLp5E2EqgcECXrMpkxqU4jD2x2VokfD5DoYY2RHXg&oe=6AAA9338"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHUjVEzCDhsQ7kNvwE4iRkt&_nc_oc=AdqvGLbU-ZdhbGtHZKg9K83taxP2Fmh4X6h052DoRYji78xNH7CJ-ZggP0Liv9MAKTY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJsMm2vj
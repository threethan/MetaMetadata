=7f20f&oh=00_AQCSynQyAgsLPZfiPUPcxClkatHTKQy_dhD3JLUjHibhRA&oe=6A6E09FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJXlEIIBtl8Q7kNvwE8LICL&_nc_oc=AdpezICjsodXeFBy5HcntP_hIymMvg3AFKq4BpxM7S2RNHhclt3YDvyRF87-tvmMmLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsrQqlqfYxXyD_rZS7fzy8Cw2hb0RGwTyUJ_l0R9nqYQ&oe=6A6DF2C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNec6WMphSAQ7kNvwGONfn1&_nc_oc=AdoXiYnNyrRjUyL8fNhzbyI-BmzPAy62N-8SGds-wui-pSrYlPafBioH4AdASBQIZ8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDI2sj5wtoIe6_2EnXO6cgQMhbGFqD8SWW15kATLKXBmA&oe=6A6DE537"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6wawPF1tdgQ7kNvwGDVqPH&_nc_oc=AdpyP70USsj7H6mvW5kLKhPYJCpijvRFnyEbOT3NYawU2F_psiEFxNY6CYicBEJLcCs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_nDgbGAaNOgmXeK5RiEvAfWpXjLzHucIrkUMDeqWUVA&oe=6A6E0968"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Vop4bS4pIQ7kNvwGC9qot&_nc_oc=AdprwnqPZt5JkgWzP9R-XX_qK20llRwoVcexDhpngEGJ4w6CtcxE1CIvUq-dg8wqZCI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD3qPEdu4kobam7hhuq7RtG3a3i-YZTHzisISV5mEzQrA&oe=6A6DFF17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-aFXqN05CEQ7kNvwGHdNBA&_nc_oc=Adqzw5gHNqrHxYMzKmjP4yUipHPBy5UyjSflXDTQgvjE0j8d-8XiJzzzPYBlFXzRPDE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdG7oV_rVNEcgjr2Kn0uh1Ux2r_RcUs2dzRQxYpdJjlA&oe=6A6DEE38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuxTPYjr4TAQ7kNvwGV2bmH&_nc_oc=AdrNGUs6TiYEAE4JFED-dTiMiMf8aqbD-0y-mkQ1__Zz1m12e8EHaQJ5728EnftaWX8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFFFWaQ
=7f20f&oh=00_AQOqTH1nlGZi17zTyS8C-ybe1gCrCPnPpC7gRPajDWOslQ&oe=6AC65E7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsydbr0XzuUQ7kNvwEZ2tly&_nc_oc=AdpsBPpDCxh_I9qsDA9AfpgSV_V5NScxxbBH9Had7-IEFgC6cbtjKxbpbIOekpRYRoY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMVamxaVYBAtbdbswYUOTdo5hEG21jns-_XdHkAFvZ58Q&oe=6AC64743"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLmc-LaDw_EQ7kNvwH6y34C&_nc_oc=Adom-QlnHG2xYC_48juqpe_IzChbkFxXf7Rtkx_kaqUL_SVyY5RaZtKg-RVzfCCKJe0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPt25NLcN0SL1ULW49mMX6foEBYwPMl6Hbsa7bOY-68ig&oe=6AC671F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJXDsWaICfQQ7kNvwExfo4v&_nc_oc=AdouKTsyscWig8w5oKy6MK9iQ3DnBkeWat3ZPI1l4c56oIOc29iDiwU5jAFMI5tifdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5Bc-aWkZyMCqAqjG4Ea8cJSqQc6Jru6ypGdVfwFgrlQ&oe=6AC65DE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyqWkEs5mJEQ7kNvwHIYVSG&_nc_oc=AdoDEcRfyhpv3wOJaHB4FiuINXkRxzmB68gz5mxvSoKC85wF8SzV2zVBhH6-GRFzsQY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMmHX5wHPqRzggeE-vdbZdupaqLEy0wKBr_WMMBFrm3dQ&oe=6AC65397"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afafLPNAPHIQ7kNvwHUkfaN&_nc_oc=Adoc8L4XTPOiEvZrCrZIu1OMSf61MIz_62001s6PERhPU5Vq3FIHRLCnXl45p7y0cL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGSq9KmdwsVBH_gsItONB4fDB34Aiia7pdrb8p1vz_DQ&oe=6AC642B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--NYNe_wI4wQ7kNvwGqagnD&_nc_oc=AdrLhX8G-wdQhGM3ipGdt4j402vhGHm_-rztlSVuluklRxjrpGPD7RKQZVEpkGLwwWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLaTkyE
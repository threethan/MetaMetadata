SiW-s9BDVBnM70p2as4GtWrPB-g&oe=69B6913B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpI_DGEoowwQ7kNvwHVr95W&_nc_oc=AdmsF6FnEXc4BWcYwgKKbcGRPMlWDFI4ldcn7Vsx0y-2DOYjArVGuj1rFVTiiEFTCLs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyG-naB8OddMMd32C_WvVmhxCpWxIv4MMrtiPpeI84JIQ&oe=69B6B243"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCJaxu4a8TkQ7kNvwEUwH6Z&_nc_oc=Adnn8DZofq2ivJqO9wmzwHOtS-gqJCvHskXWaSIUebDlGG2NNfGvAIZqSNO_L6adaQw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyS83w34_60w43qbj0gHYHUlzcQtWKYwdZU_Z3now597w&oe=69B6A4B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QANjaNLtAUQQ7kNvwEHVPPk&_nc_oc=AdkpMQS-AntTZKI3SoZQDWcFqt1dXdvSml3hAmsdou635PaL3ssT5CkS1pmrQxB03m0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWirO2EjqWAJ53Xc-2JsGzPGHwrWD_vKm1Pzf9CfCN_Q&oe=69B690A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_TTNgtbwZXwQ7kNvwHYDHeL&_nc_oc=AdnftMGJ5lV-HsyzyndexWh5OTrV3DhVskXIm_QNId7-PurWFnXIRab8HnyZDQ7r6BY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwVDhyRsV2aGnxoyF1VPe39AEubSP4NABQ64hQwTQRD7Q&oe=69B6BE97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWfDxZtrDOYQ7kNvwEJMfKO&_nc_oc=Adn5W7YiP5NlSVHnkmwdqEmXPHr1Vw3SyxyVw5O4dUfGy1wUZvZY64RQ3AoNJaAuJ-M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxPg4FabOLgzwHyWIzLIdmHgyd54z42T1AE-gu3e5NosQ&oe=69B6ADB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_33V6iV154Q7kNvwFSVvHW&_nc_oc=AdniMI5rpO44WGZnJMnmpHEr_VOHGGRp4BC1VYI8PZMEh5KV28MpwtjLlPmj8DRCLww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afy7jDh7Ocw7R5OoevJEA4KqNSHqBiPCFzKqcCn0WtEScA&oe=69B6BF86"}, {"f
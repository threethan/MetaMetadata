=7f20f&oh=00_AQPalPGXZ_jpXyA29LIkutxTfbv3uGVE495iDvwk2ZIPnQ&oe=6AD38D7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1KK7PpWVdoQ7kNvwEyvX42&_nc_oc=AdrrLhxL1X73nYFlvQwdtYQ7zPv40PpaA8yKN-6Pgo0meHQpSlb75PVJBoImj3CsPoM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCWGreS87lsB_WwgxubboThdYQ3pYCk8Wh2Iz4wk2iaA&oe=6AD3AE83"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG90dGP69D4Q7kNvwFgcZ2l&_nc_oc=AdqCK3UhxxkM56b4k1lHl_jYqip_Bc0rB_oQUhCW8Anhl-4yF8_sp2ytWkBQo0uWnOY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUrJZUoVfzq9f8P6ruktYgBMDTLMEftAoIXTO0jSoavw&oe=6AD3A0F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpe96lmVfdkQ7kNvwHt0d11&_nc_oc=AdpsNlVDnf4P4hfzt-HPFq3RS2sFvqE_Eyj8X9ORuP6RasZ_nMGTrxPHl0A3_sQOW-U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3LunOCgW_6tMM2ijOib0rdV-PxK1HBvyy61dTYy-T-g&oe=6AD38CE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqF2Azqd6mAQ7kNvwHW4Ymt&_nc_oc=AdqoDGRxhff3_asP-_QNr8FLTlu4T-AAznuXFed6YPe9tmGXM6OOY9bujmmdHAwulYs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp9k6iWVfQ9MPHAu4ZQTOwAyx_38Z1l-Z1Ibi-Y0F4Bw&oe=6AD3BAD7"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wB6YDjSVtoQ7kNvwFmdQlO&_nc_oc=AdrXyaxvH5M7yoFw64d4oMva98ZAe3I2_k4odgh4Lcjs_tabTP-ItTTL_2s54muPYn0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTUfPT6BkQg5V9g0z3B2N_2O7O7Ho9wrSbAR5cjAAZAw&oe=6AD3A9F8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ox1a8j1LB2EQ7kNvwF2jp_L&_nc_oc=AdpJxkmqUzF-ClP2vxRA-zojfQ95YzRHRAlgwasIOR7sWwEYnVWufkHVito_gAD9vD8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP449zaF
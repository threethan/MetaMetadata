=7a30f&oh=00_Af2rWmkeAUQ7htyjNk7QD-86yjWVdxvjtyS4InfewJC44g&oe=69DE567B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN42H80YpK0Q7kNvwE0WE2F&_nc_oc=AdoilXQXjYTLvb9iczX_AVGlvbPMUrVoldxNi5xIeAKQWXEB07dYoym7lYJ12XqY3nA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bh2osVyWZUCnG_OKfDh6HIvXk9Xx2qCmF1sgrbPaPXA&oe=69DE3F43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIF9ukk0QVgQ7kNvwG3lB0m&_nc_oc=Adrc7vNO3OMH6qaLSls_jP2wKCQG_HjOlihCRn3LSaVTPP8TFpqzffse5inYplYYJH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3aOsDEqe2AQVrI3-cIzHtuZTmkBmCQcQe1-vWOdf3SMQ&oe=69DE31B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfrpZA5tS98Q7kNvwG1XYp-&_nc_oc=AdrNViwbT7EDCbZZJI6oCKEDFSWIsscLtHa_ZqamOetdfXeacA15tpcAZfJWk_5FOWc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10lEahNKS2TMgL26_wKcuEHQ66SF2CL3hV14GodJyFFw&oe=69DE55E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RSd09lBVG0Q7kNvwEcTfsu&_nc_oc=AdqZ_q7AZKhNK59QVBdPwFsMuoNy9pCnSFWnrZ7Y7ehvEVDxEfaDTPY1uI-0KU01a-4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0wttzEvQAPC0jHOrfw4Wu8x8WHn_pU9xbzzRNTwIvKsQ&oe=69DE4B97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpqtCSRQisgQ7kNvwEi9FEO&_nc_oc=Adr9B9eQh6xFYPQ62eUaU6_Lm24pCZZaehEKbINqQXc4WeYyp5XvEdQLsiITEZKLCC4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0yATDtLHxeMnT2GcGNvefWDB88bCuLisZB5IVO-J0-YQ&oe=69DE3AB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jurdqtXSCDkQ7kNvwHZCcjm&_nc_oc=Adr09c5vIcpGQJMI0ox_GR58U_49yK3SZ6fFaKrd7YTO_IxIZqCHO0n7KmPubzx9JDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cqfpDo
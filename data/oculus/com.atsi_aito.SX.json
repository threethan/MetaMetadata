=7f20f&oh=00_AQGeBHDf_OIpPqHWFXA8JEW1RltIkJLZKNck6WmrNaPA0A&oe=6A7C523B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxJlT6KFHwoQ7kNvwFRANgG&_nc_oc=AdoSBhK0k1trflllaThfkf0ReI3xSniTLGEnAKvAuIEmyFGV_yl_VTxAqRRresIbgOY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPsUedugumcASM9v-Wx7mfrgxgHtzuD08ylIu2LCuF1Q&oe=6A7C7343"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80eGG96sUzMQ7kNvwH_rj28&_nc_oc=Ado2anzusMbs2v7QaVk-8CP3sGzp38yVCiLDKZy7b9qbi7p9IHgXoKgRn9uCp64_QlQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRTopGQr1Di4JzB5_zEAjTEHZO_V_MM3M5_lwA16cTDQ&oe=6A7C65B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3tZ9PkQ8RkQ7kNvwFGIEFP&_nc_oc=AdoGG1jrfIWURcmlKguJPi8XPEJQl58BDEoAZoOpQd4fd2GJaJTXf-s3WjnqaZwBqq4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIcG-4YRFJE7JcKNyGePqPNlXB0mJpmo0vQOp7EcDcYg&oe=6A7C51A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxE_T9PJkcoQ7kNvwGCkcnC&_nc_oc=AdptA0smLS5pkibTN_QOApVG4esCGSLHJNCR6KMQQakIiXC3fzFyS_CGosTJq-5JifY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHQ_5uZ-5NHvLi30yh2A4jCASBZAyoji1A6lG0aliBexw&oe=6A7C4757"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pLbY5g0BWEQ7kNvwHze-xA&_nc_oc=AdpUNaRJcHEDeXwm6G0abvysFG5dcbLb3AezBV7uaUTo54G2L1toD4wIEFPBMWInfU4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDoCZGeBMDNVMqA8WWRaTESY6LQkkrrw-Bz1a9xSHi0w&oe=6A7C6EB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6LLiXbwJ5sQ7kNvwEHC36X&_nc_oc=Adpq-9gUY76t3XO01wjliRBt3uu1wZYoCuPFIJ68OLojOjfZSBz3gLOxw0GnNfCfCTo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG2w53g
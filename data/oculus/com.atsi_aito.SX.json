=7a30f&oh=00_AfwmQzxfirYAz38A5Wrh--0Vamgs251ZkuAbAkiGSb-Glw&oe=69CA57BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eT2tMXT1lgYQ7kNvwEF-bb8&_nc_oc=Adr8fgArYf29vE-Ex-sQ1BF89Iugx-D52lTVHUgFOG7wKyo6fmBfngUP3v2vxjLj5uw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy3km908hCbAt7Rz4B4YQt4DrzlLdV_qvzbls8m3LZRsA&oe=69CA78C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3ty0M-bC1UQ7kNvwG-jOIB&_nc_oc=AdqA6DSkRmT5NcEkPcSxn8KVAoNoEHxu7F8eARuUQxNiP73Z4ZE2ZQ-2UgRPuJPiSEg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxO8krsLSzT_-pzs2O3ySYTafcOGDC1HnlBF4Fh9B2NJQ&oe=69CA6B37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zycj4O44q8Q7kNvwGt_VIt&_nc_oc=AdobZ3Rb7o60SN2qOSBipqo-6Y9S3YRReGXk71Rs1DoMx6EDuGek7Xnx5CBHXaKzHek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxJMbmpyC737hjJq0WL9xJafZoyZ8T3xgt9gdGugR85vg&oe=69CA5728"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii7pSU99HEUQ7kNvwEenNE7&_nc_oc=AdovCTmnotgUmyQyEoLmk8AibJakn5rVH4nQjJRz9EQytjbLNYO6jcGXq6wCuHqCm0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyxmhD934uHYlsJPgYYDTaPAI_odAyAOX_ndO_3wHhBdw&oe=69CA8517"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2tVTm_QinQQ7kNvwFehhFe&_nc_oc=Adoa8YrdveXokjPkpZLVU2QGNNCA6852NhzYx137Lr_DJ4n4XVp4OH3FSUDEhoVxRrE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwPMYWxO58FrxLfBCk7sE4glequRy1U0_wqQES1djMwsg&oe=69CA7438"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7iIKu6AlRoQ7kNvwFEhJoS&_nc_oc=Adr9_u9huJNtI6E8Qsj6zhvpadRfe2cu4ulnrRJWMntrUf9-ccYH5LybGMasX07NUic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy85BZcd
=7f20f&oh=00_AQK1Z8JA7W0f0-ukGoE-u93unoKXgitdBMSjsPX-QfAmFg&oe=6AA6BA7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oapx88V3eWgQ7kNvwEqe-lw&_nc_oc=AdpYdanT5aB3HULIYsqJrgdztAfNJCJMmWB_dtXXZHupNzTxNyM3utUv5FltA6lNl7E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7EpbS3ByIeVoG5a3QqUSGp-ur5QGVR_1VusQLqgPXJA&oe=6AA6A343"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km8HYopDKiUQ7kNvwGKHqTi&_nc_oc=AdqbmGJefwYeUUMxD88hkvPFsXI0Hpt8OwBI9QZdiCKpNli9MTUGv_bTuJaGXJk3k9I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoOU4rOHh6uuoijJYiN2jnOH6Kav8N2zX15wPB8T7svw&oe=6AA695B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Hcoj6s4QiUQ7kNvwHdN0Yc&_nc_oc=AdrmqOrqeMWXgnX8LTN3JjTu0IPZKJ6KV47-TY3-EuaNaMQinQ2Hy71dqvwy3p3JYCQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLocH20AvzTCuzkKYZDS7rihyC5FJykVbGAXm-UihmXCA&oe=6AA6B9E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unKU2lymqvYQ7kNvwFkq3u6&_nc_oc=AdpWepm5pc-NIeSJZ-KUvI9t-KcHeFrC8_7XhYZqSmRxXSMdYiZj7dtUh0apxBwDvgY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLUDDvHO4kkuM5WH-34s6IiroT3eUZTL_Ic6WqH0LDEuQ&oe=6AA6AF97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-WXrwyD3XkQ7kNvwF3w3s2&_nc_oc=Adplk7xlD-kXpOFNMsPXuh2NtEDk-v5ILxNshkXw6r6C4n9LfSZYV6T4ph_LDyPqPio&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJgdTf2REoSfOLuzXbY8O5VVQ4WLK5wXVAxHBBJVavp6A&oe=6AA69EB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGeHkGo6RQwQ7kNvwGrtiYc&_nc_oc=AdoKGUXdd6HKML8XpXmsDxc_IR6b2MgvXcd4EuVYHKQA4Di4ulK7__xC8QBQEzyZgS0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGxVQL-
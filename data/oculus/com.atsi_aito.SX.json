=7f20f&oh=00_Af5UcbQobNe1_pHrBh82ATFmwYsSEiRs2dLq8IXdV7czMw&oe=6A0734FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6QfYm633nsQ7kNvwFqxAHG&_nc_oc=Adr3hmy96doDraQxowdm3pSk3ydxUdfJF0kIQD5QZGv2ikoC1ynVcMBLKh51OCeh8oY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KgMzfj3u780wXopDrU-qplwNx1QIBlamoCexOzeoB7A&oe=6A071DC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YxDks03GcMQ7kNvwEJ3wXT&_nc_oc=AdrcOjKEJPgQbfHBvYYrjpXqC0eBjDpfw7W-2o0M2EdDSRK5CHRYnEP6npJeIk-eQ2o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TNBHApi8qODEVoL0V2kBbLLZSsr8lS2lEce9BbB5UXg&oe=6A071037"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0pDLCm_Z0sQ7kNvwEZYhj1&_nc_oc=AdoqOwvNTLgoOS1wZ9y0y2i5YdAmeZ6rOx8hG7duTCcU0t4mGQgzOjG5BvNYOh6EPIk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5FBl9kdSZT7CHddr-hVX40bvsf0i1EIKqpcymYPsxeGw&oe=6A073468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAVaSG_z66IQ7kNvwGFcXDb&_nc_oc=AdpD1MlmnUMXy3Cn87Dqg2Pp8AF0chBExOyo4rgrEKYYr7giw8gz1ryREPMen0b6aao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WnLn8nh3x_CGKmYf7bH8PcnoiFKVLgd8criahXVTk9w&oe=6A072A17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN7ARcHOn_cQ7kNvwEGKSHN&_nc_oc=Adon-FA8hX32IieJBV5bHYhA7WEaKCRwOKA4NqqaXz_TQ5NH9S9hiPVkCUFcUDDdW-o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49IePVDYWFCr_tMj0gYG8JBAZNe3b-yyEXBtJueMX2Zw&oe=6A071938"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPM5o6NmKvkQ7kNvwGpmFfN&_nc_oc=AdolXgiPxof99SDnNJQUCtVZTuNwO6Ypvi6IqjqNfhBt3O6wh80ewNRL3pZPHulwlc0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69YGMpW
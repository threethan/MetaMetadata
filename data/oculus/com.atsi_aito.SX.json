=7f20f&oh=00_Af7eXV1bXSKFNsjsoZ5vkYMFuP9lIcZlOBTX_2QjXc6fnw&oe=69FDFA7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m4J2QsP9sgQ7kNvwEzZNeG&_nc_oc=AdocybTGsvpLTwBBTNS--IkYmdIKd00VRw9TLrqiTS8n6ZAO76ThOpDFuN1JD_uZ9Ic&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4R_xR5mEXUJ6_wvf6iLY1VH9YtOfit1AB9hVA9rYOesw&oe=69FDE343"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWNrf_-yYWUQ7kNvwFVg9cp&_nc_oc=AdoKv71WtDYdv-92sRhGIRcbF1fLEyXhA9sbYXfjWhyspNt8XTIZdDLorcg14L-usFA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5SmQXY0kr0ArWnty8pj_iGc5oqtwR1lAWn91oL1lDTZQ&oe=69FDD5B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxDE8SAitCoQ7kNvwEqhQdS&_nc_oc=AdoKjURtD6j10ukbUE3YV4Mxzd-81gULLPHnx-YBRw0boX3jQfRmpe-GkDOWTEutFWI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69IhwKEQYU3fpreK-NsyORUWxDxCVFEFdGxmDPynR3Zw&oe=69FDF9E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gg3w8ww2qQQ7kNvwFyMPPv&_nc_oc=AdqEMpfT-Y7pvXeR1bCyj--L9A8zYLyPazbsL_OT_clz6l0ZMxSUKsR0EEkiQbSxYxk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jQ9gVuiGKEXIzmjMOWcHzTuWrlaa-8RsnetVX7VEAuA&oe=69FDEF97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7totPR4w5AQ7kNvwFv27Wn&_nc_oc=AdrmyRheJAr7XM0Um0KD8X50ti8qWbcCKsYH6WeOluam3AtcC5Fp9p-yRioTD8eBr_8&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BgF279ezme3s4wriQC4vAd659Fn6o-lu7ENq0DdY4bg&oe=69FDDEB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8nFA02mCzMQ7kNvwEbrCeB&_nc_oc=AdpJg7jHyi-AMuxuR2UF6ktugSeNi4BtYd28YkOSkGDAvNEgwqLPZNk_OX8sV4Kl9Zc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af695Tk8s
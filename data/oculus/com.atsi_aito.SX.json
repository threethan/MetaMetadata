=7f20f&oh=00_AQOuvRwmXQVRWL6g2SXXyjlDFGePT77NjDi1vdlvwZUqpQ&oe=6AE6027B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIRxVV_LqkgQ7kNvwHJbYt4&_nc_oc=AdpkSpbJleOUeEmsotCm6raJqKsPvwGCdNr0y5gDRCMHBGJDHzFqQlUmXoz9NUTLdbs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUyf8Pbv3BhB74X0WnqHJvnro1JqBlMTvOCVCngiYhMg&oe=6AE5EB43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Dgu3T_3ePIQ7kNvwGlEmUO&_nc_oc=AdrzScEjJnmB0mEr8tygsps1UAbGNxjc1N0xV-DO5U7bnkld7YGiG5GV67C06Q3ZRM8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrXuygTGuV5IwavCanxZuG8n-6aFzgzZx5esrslL0T_A&oe=6AE615F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kH-u0bp6kDQQ7kNvwG2OgYa&_nc_oc=AdoaR39hLDYaEv8zNVPaEHsd1bSmFDfZNyc-1Fgq8_5YAi1b3_R3pOKqgaDJDKqJkYE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhOyEG5msqTsbPyNccWNy3nStyA7ZBfx0sBgkJY2Dq2g&oe=6AE601E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bbx_07xcrWEQ7kNvwGZ9JNv&_nc_oc=AdqKR_FbuZOpNlPGER7_JxgwrNnr0t_Awt4EdgbRIsGbOec6AfIPP-EMvJJBhO4uZXQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN176-WcStFEGhX2D_eS57RZM4vPd2w5fhW0y5dbEpyFQ&oe=6AE5F797"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZW_L26pd0UQ7kNvwHtXCpN&_nc_oc=Adr8UigL-P6vEfTdU4iwuPoTvxO0Wc7IVzVolobfpTp387IP29zjD6r3ZmpEPa59oow&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPueIbwSQ0EdgWscykQgDY-tzXE-v1IWQffSWlwSDisgQ&oe=6AE5E6B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3kIE-UxHRBcQ7kNvwHu8ECY&_nc_oc=Adqfp7qY2yWgJYvrA0cR3UdnbtqlVJNksIsqc58MfkDbS6dTjp2Qf3yi6TMopfUKvVo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbQiznB
=7f20f&oh=00_Af7R4Um_Yw-eG-iE-7_IGIGRT3LtPyu2CWyUm27YK4KtRQ&oe=6A1463FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kzv9-J42gXMQ7kNvwGhGoHl&_nc_oc=Adq8p5A9VNGyqloYsx6bpvPFBIqSgJ5NsX5JMWm0IAMqUQklAn_vo5fjU6-hO36TWx4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eOt5M1wQOymYBNRX5uwGNHFFamfdqgo-onvOWxvBKjw&oe=6A144CC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utsb8ty-BjwQ7kNvwHwnyag&_nc_oc=AdqlX4u5eNa_fu88cNUdyy6_eNYkZCaOQQGinlsdf0okQWQv4uenodUoTWwEyXgux_I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mXOdRGJy1tHiwKAmjZ5OD7dik9GczkhP09n4kVMZX6g&oe=6A143F37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gNpWdDo5SMQ7kNvwGVe-Wf&_nc_oc=Adpl758rh2fJM_Avvm-GzHjRvhJEUAcPSGhW3he5uu14zMp7KkogsJ13s38jLThRTng&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Hnv3zhfvLNN_B77m-NGm-c2bXB4PxJ0wBO8dDb7RCFQ&oe=6A146368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToH6qRdyhAUQ7kNvwGZoIrP&_nc_oc=Ado7T0UHVoR2hxKAPzvvCEQ3EONo3qV27jfqD_V0KPT_MVcLTsprW8KQRliEAVKV_08&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K9xQwyKtnLMsJRA79gJgO3W6YdvEn22Ut__XbcZNDYA&oe=6A145917"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aHrjAm2q8YQ7kNvwHxv2gf&_nc_oc=Adri3jKBryUygw86iGNkeZgjS_5Em6OJm1NUOGUTsfm1LhzF-HhXPOWdxIPuT-mQAKU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qQXyNctI47dPhz6aJZ5aJ2Wc9F9mEA31p4okVLyUqPw&oe=6A144838"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJRE6hnagp4Q7kNvwEuluMg&_nc_oc=Adps2eR06u7X7dp-L1-eXTotZD8MVRG42aY9r4UE-y5gCrdSPODbjxbiMymO4-eoD_k&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41sXm5U
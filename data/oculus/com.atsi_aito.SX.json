=7f20f&oh=00_Af7N7tV7lJK55LNKf5ksm1XuzauzCuzMycSuG4IVl4SxXg&oe=6A05E37B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6QfYm633nsQ7kNvwGSAsBM&_nc_oc=AdqVr6EAILL94SB3Bcp0csqvrTcjvXreXT7DqPPWCR7l95hr3dpsEFW4WF6Al_fjdwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XG3kuLe92tQiLFIVO2b2DHF3h6V7PaObFAJtC5VdbnA&oe=6A05CC43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YxDks03GcMQ7kNvwGUH8Zi&_nc_oc=Adq1oAQ0ZzTwEofKJnmKIDCLQYwfOhU_2e_xNmTfOO8vvCOJTLcUWPj_2l42_lz844Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7z0ph4ZWYHVszoMjvXFmfGQv7Pspu1RrT-bIppJ8yZLw&oe=6A05BEB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IwLOvGSi3AQ7kNvwENbK4R&_nc_oc=AdrcP4BpgHvV69myHPpY_sv0T7y6Fif4kluJDNdmNMk75lZY0VvhKq8pqrEq57MweE4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TVBgnx4tZrYMwakDMmWW7K0BbNyp_TsaNoASjFgvC_A&oe=6A05E2E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6shUD45s04Q7kNvwE9373w&_nc_oc=AdrUvWFJuPKEIqn3Cqd69hjWvPWOClbqbAyxcIYGqvCYnPPkmIB2WaLflqrADRpMpHQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44itLLtJnGgy6B1QoyX54vspqUmaW_kvQ5ypGh6uKqwg&oe=6A05D897"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN7ARcHOn_cQ7kNvwHkkzQc&_nc_oc=AdrfWAn-L5yNl7W5e_2sle-z37vJuR-q6nH5x00vbvQy5nsxc0Z8bFP1iJSzsQlIMU0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VsuaRpKC5d1z1ZuVGnMWfuEna9yVFwwPS1W1E5ZuE0Q&oe=6A05C7B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPM5o6NmKvkQ7kNvwGBHSU3&_nc_oc=AdoVEFjZaCf-Fvk1F1W-mGDaW8GRNJrEFkP5rgnFFEADhbam8xvw2PS_If-6SzUzf5g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Bchmml
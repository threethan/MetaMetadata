=7f20f&oh=00_AQAYbaNUEZ-viL4RGNOf3AQ37K1ausuBzgvF9kyTZXS52w&oe=6A57A07B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZQBj3lrjnAQ7kNvwEY26mm&_nc_oc=Ado54UQGairSKIbzWpepoGBXicmM_VxBqf818hYlxTPM3YHDmYO_tIUJX1UhCy3X8WY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCNYgqnuS5bu9rDvbZJ6oIV2EjZIc8IsjEueieBYuEggw&oe=6A578943"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iokEYEe3fhgQ7kNvwHn9UvA&_nc_oc=AdroEZQwojrskGFpV1CWC4X_6PM4ezkaD_r7zG5LBBWWXFp8zSHLXhR1Il8AVK0dwsI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC397kqpaA7zcGU0FKyf5v3ig16bUwcbw313yCxTA58UQ&oe=6A577BB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfA0zT4ghjcQ7kNvwFxCkS9&_nc_oc=Adqsmckt7dClgqpBh8P85QBacxlFPUvYEJ00gtPDmA22V5EH9bfi1OLvcjveghZ-ZJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEMBkqHoMZhyE1Za167R4WqsJl-l9kkQ7DBJsSVV9gQQ&oe=6A579FE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rulreWy1t5gQ7kNvwEhAc2y&_nc_oc=AdotcUzFq4rUwdkDgMuiCGbKABnRLTFouTzl_rbHOsKCZOCTomDTiovdFcayRsmC3WI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5LHAjXZnqPEIT7Zd6HvnqBzuxwMP-Hyo0eLay7ONIHg&oe=6A579597"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=43HSSKGoF1AQ7kNvwE0JPnp&_nc_oc=Ado8dRAImvGLCenaYG_oSWcR0kkMBHoywHoxnrja1YgGbsWsSCgrKWFKqsW9aYAhxE0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCVFaavUF8Ve-dmE3rUO6S7weGuzqp7taFDm8OoeLfzQ&oe=6A5784B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Lj1mD8hhvIQ7kNvwHS3nUH&_nc_oc=AdoeuCrKjcfgqhQqtqVOXNWrWONx39EzEKq_rqF4rGE2x2MTIDVStENuPjoLCrahNXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhVxQAI
=7f20f&oh=00_Af0nxYtRJBYoeKISH1dLahgliDiwnxsmUc6aA8wYJ2-fng&oe=69F6117B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTtDVK3lc3MQ7kNvwEyl1OP&_nc_oc=AdrWpmzFAmQXwB5afMyi-6rkLXji4Avi4BwSbe6kUFEaOngYkKb1qvDU-kUz3waGY8s&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gEIGwXe57jAJKi1nKb9UI_nxwWKxIy4wNKGD7ZY5bVg&oe=69F5FA43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwfhGzbOGmMQ7kNvwFWQiuE&_nc_oc=Adq58VtNyxbcXtDM2kgndERSxq2NIi4AL7sTXavHI6BV8x7hZxQvnpwjFKRK7pV5tcI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2DEnpgVDLvZoUYG4250AOzp3z69kLqcFksy72Z4kre6w&oe=69F5ECB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oehlE_w5NewQ7kNvwEVdoMT&_nc_oc=Adrq6q7T1yFUmdKOfdjK9r2hsD6Vmp9anxPx3dCenpBfL9rhJAWmAL_IZx9vM3_Jyhc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af23To4jXKo0KWN_huEzjDsTGMxo2PfrD6bKQfrs-e7Txg&oe=69F610E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3y1f1fGX-0Q7kNvwHrcnDj&_nc_oc=Adou2EJ2fHvBx_R_Z0e_RAPKpr2e0qGLZcRmfrCYwLl0BCWYYtKAQ6tdeXdHSQmWn5M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2-E4PGzFx4W7L_9GSL9upCJF0xQ3dWrzgk4rO4Qn052Q&oe=69F60697"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRABVLKkxvcQ7kNvwFAjz8z&_nc_oc=AdqG-94S5O4uiXJg3H6KA6V_69xPDNMrEfo_asKfR1tV7Wyq5C6xQi7VLDtEtrC3i9c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af37n4bXUgmY9WaEKoW3JhOTdjEAB4VSSDRt3rHRV4HJZg&oe=69F5F5B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg7rB-y57S4Q7kNvwFxcdds&_nc_oc=Adri4Mgje2FkJe6Uc7-nGRoBAzzyRhLmfD6-aGuoBjdwDNYaAVsPCaKSVTyoecw3nFg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1x_Lm7m
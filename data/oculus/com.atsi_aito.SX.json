=7f20f&oh=00_Af6WBokyOxx1BzhQrO__JLQfZEHZTr5BmTfEl6p_ZV-qrg&oe=6A01EEFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D40qOqkn6OQQ7kNvwH7R2_3&_nc_oc=Adr44tze12W10KEKBwNst_1-Zo5vzwL1FII5puvDBQz_HxFnCmSLxUhkDeOVJ6tHJ_U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a2IaX9rOoiVSV6KxTTOJ4wsfZrO-k2_sbdXmKd3NGNw&oe=6A01D7C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vSS4jTP8b8Q7kNvwG2koS4&_nc_oc=AdrX7q5CcDu1ixSVMvaxEX7OQaKQcirwGNOrJsMF4Qp263_mTPggi3LixH_HqrcT7Uk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZphrDu8rnsl4bWiF3oyKkzmwd3m9az8nLWFOkftbRsw&oe=6A01CA37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO0CkmxqNcsQ7kNvwHAHVY3&_nc_oc=Ado1gMUBHhokMvAFieX0H7y1FLy_CMdgBkNJh6CGUpNJ_jMEa0OPoCWVEer2FqkE-eU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uspC4TE8axyxwyvO9zItryLWOuGgA6xhV9LIG7rzntQ&oe=6A01EE68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWQjsq6LWDsQ7kNvwHI5_pD&_nc_oc=Ado__gm-g_5WT0CjzxHDkCk6Xh-ljNkrf75N4bVVZ0SxO9VM_baoUTmqpRMgTd1sQNg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5i_lis6nEL8MHI6_rvpcBBzauT4TiXIvMnrNU6cNtgsQ&oe=6A01E417"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLqL32NrdUoQ7kNvwEOqFzD&_nc_oc=AdqkgYj2kiZF45MhjLc169G5tfbu2ePdNpx7Il-kzvHhCJmPoSTNzGP5t-ovDS3-MJM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Vs4rV_YNpcnf8ftTovUmIswl-UCG5cg2Vg6pZ742FEw&oe=6A01D338"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFEVfl_QuRQQ7kNvwEL7HJf&_nc_oc=Adpaq9oK5SRPUiBS6krORoWNY5n74q522YzIuW33S6Aq7aIu-hch3HEJW02RnAHuqq4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tzec5O
=7f20f&oh=00_AQRQaHRYq4_T8yMjikq52EhC21isvfgZMsrcCQAYst5DjQ&oe=6AF725FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tfPRScGLhrwQ7kNvwGSY8R2&_nc_oc=AdpAIC6XrNBELvlox26BWVShbaaE_Fng9_kPwYGruGwAPDI9GIThaUzHYFDd0RaOvA0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSj7eQ7SQduqH_XAHMv1otZjiDwJrVju-0dOx0WkZ8xkg&oe=6AF74703"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLFMjCa4MlAQ7kNvwF6X78d&_nc_oc=AdqAWjITzTtv5jy5qwa7YhNIxJCQp73R0sDBfuveqB-xRmUrAXPIa7iTXHkirK6w0vM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvmxn9Z3gMwgncJQUfcnhk4fJymPJa4weUPv2VBEnn7g&oe=6AF73977"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pdy4wG-LV0Q7kNvwG0dyCM&_nc_oc=Adp5esPYcEzRkfmBaCTQWRwUDvhNHqYUhEJ8dxdZ8BGACdaEAvyfw_qN5EI8xqhQg_0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR_VtMs6VJc1VPsQJ4H-I5AahK0f0H0neLoY31P_OSwvA&oe=6AF72568"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqI4zvFkpA0Q7kNvwGAR11O&_nc_oc=AdqhkM9j0c1f9la2KUZluTRtPBKIS9V-Li1OB_4lgl5l5yaxAgockUEqS4LCuM-Vm9w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwk53x1rc7PYxhCvh4-WACQEAj-rDfB0NQXI12zJNqSw&oe=6AF71B17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DokzZcpIAfMQ7kNvwGX6ZD2&_nc_oc=AdoL5uaXTu0WSC1Krs0UcbVopuUaEECjAfEtgFRGo-tNhvL5Xl8Xzybb4JwuvP0emwQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTf2cyFujHL-I4cJT1I0a9CWqVVNG6IlLaoFyFO7AZibw&oe=6AF74278"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Q-MayP48Z8Q7kNvwHpIvl6&_nc_oc=AdpGW2X0T6bQErNdJYTNo4JAX0C_ffaZo2ik9_R6-8yetcaEJck0C7fbrGTQWqT-zyY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQusQ5-
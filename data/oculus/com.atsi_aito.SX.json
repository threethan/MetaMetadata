=7f20f&oh=00_AQQH8Av-f2xdkHw54Js_JVld2Nw88k_PPUgQOA7j8K2ylA&oe=6AF482FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pJ8j2k1LACoQ7kNvwGr4dKB&_nc_oc=Ado5f4MLqwXQuhgg0IQ-b3mwpDMmFGNMfXQ3BtRNQZ69EIE-E_I4TLvwLKRaAJQsxrk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3nKyPIGW_fTpmuNIuGQOnlrccTcGf89THFgrs7a_Pjg&oe=6AF4A403"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXDkc2I0wTwQ7kNvwEc-8jh&_nc_oc=Adp0VJeyUcuKa8UoF_7FQupToNozojOBdr5n86ZoaL6wyccAe8E1Q_-odHHYV4luYMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuGZmYnYX4-tUfDGK6GDlBHg-l4uYEZAVphlvXqmbW1w&oe=6AF49677"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pdy4wG-LV0Q7kNvwHHIb0o&_nc_oc=AdoMOmmnRlDYz-dTaa14FxKGluycemUQzpuTLq1PhpjUXc0E7nva6PgcxFv8BuqhBxA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBoAMChXfsrVqXqnGytlCy_9oLsG7P3LN99IhqJn9L1Q&oe=6AF48268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqI4zvFkpA0Q7kNvwE_Wbol&_nc_oc=AdojXAvQVqY20BjyX7khqskrXVxm1ag4dBXyuLzD5ZA4V3PWd3Nb0OGuz47728VZ5A8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmwlt64L6NX_5geoA7aCwjt-hIm2YiD9ZThQjsDUpdUA&oe=6AF47817"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMxa8SViqbIQ7kNvwF3-kA0&_nc_oc=Adq2S5VjaEcS_TUjOGNUChGoAPleYy7nkS3N2HVPN7wUsc939fTOKALbb-oJY5P4vhY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSebYswNjuhXrSOIaxn3gVKqJkI4DdoaWnmXYy3ISQa6Q&oe=6AF49F78"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VhbvZVfrxbYQ7kNvwH48zav&_nc_oc=Adrujrbcwi1FqUXWAZMZokkQl3eabvmwMUBtV3ohF7ibTpQi7lmu1V-Q9KC6k0eDKQ0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7QWz-U
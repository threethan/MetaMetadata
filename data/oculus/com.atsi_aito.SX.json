=7f20f&oh=00_AQNwok_UrVdGMDaHxIIgaaypH7Y4hv8Brx0ZefowGjGvhA&oe=6ACF98FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2czB2TXiLYQ7kNvwHwyYoc&_nc_oc=AdqwN8wdvHwa5Y_2VKp0u6ZJ2aVXFT04PlBd3gw1o7hQP6KaYvjwCH7dSoEtIcO4BcU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNasOPpMY4uCgidQGdYKdL3pKg5Z6yKOcgij2Mccb-dyQ&oe=6ACFBA03"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5cMM2j1p94Q7kNvwEZVQu8&_nc_oc=AdpeFdxwQewuVcLB6Xc4qZnrnJ2YF9l-XA1dPyugBjYZ7j1WWO0UAgeK98pYqcIgdI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGd5h_GUKl8VYsaucy9Rpf72g-VCKVVlHZ68-Zztr29A&oe=6ACFAC77"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGibiAdFK8EQ7kNvwElqPwL&_nc_oc=Ado2flDp4FxJbwn94yG4UNyO4kY4ADeo9lZlKZ9Dq-BFu82pBeNeMgojWPdu2k5NlXM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOZps_NO2cd_S5IO4wRYl3p2LoLC3C5yCaetWGUrgamTQ&oe=6ACF9868"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg1zLqdnuvEQ7kNvwHe1g3r&_nc_oc=AdqGQKcve3LV4E_PNi8DR0scZRvFawxWOSNoBxtDptUnf2wyKfXbPwimyFuO1DZ6_hk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfj851rszZSYPYnQDnbnJbpOsQrUQ-C69j3LrVhrpvQg&oe=6ACF8E17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ctrl6dO4Q1kQ7kNvwHe9ctp&_nc_oc=Adp3g8e_T4LyyBB-Lf50WmQ6N3QwxLlNHnYlNlX7j3gFa4FNXdeHwG8iR5dEIHVBTPU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTxIIYH9yBeY95FDW49Z6B3RpqCk2HeLcwGlRuRgY23Q&oe=6ACFB578"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmcg32mKGHYQ7kNvwERA4Ne&_nc_oc=Adp749JPGjHOss6GRm6DLgfITI57u1tAXX4q7aQ42QvU-uSvxVdyxFO-U_iL52ysKoQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNFcX3PF
=7f20f&oh=00_AQIfg04dRg4PoUDEJgQ8a-dGN4Rg-R71RXcWTukjZ0rKqg&oe=6AAFF4FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiDflnVuxn4Q7kNvwFfUQph&_nc_oc=Adp9exgPzWKMICDoN84BS_z2eVCaEqFbOBlGYdtdhbuUew0_Lvc81kBq8gBRnIb9nco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuc8iFDGBr-wwY8w_SQV5j58j-_GP7oMuvo-UE2KO2gA&oe=6AAFDDC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI_1XZHOIqsQ7kNvwFRwLTK&_nc_oc=AdoUypZszatL2MkTqFnILW0MMex7aOHDtbCFxQYhzFWE3ZbEiHWuQRGGxoEU3BMOGHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrXoFrZPELmVPa1JPdge19pjRm7UNSL6fQqqNiEkjPQA&oe=6AAFD037"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEV8TucplQwQ7kNvwFzrvFY&_nc_oc=Adq7npOZ7B4LYqhS0DShhoaDRfsUuaHB6o7cc-lZPs1rNzZ1x3tjspaGqt_clE55g9M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITp35ZcaYRTBMxeSXEY7i5bJKOhAeyWFt-Y54N2Ni_zA&oe=6AAFF468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDK7oAuwqG4Q7kNvwFlWrLW&_nc_oc=AdpgArFoD3kMB1OZaB4HbDIiHn4pI_L-5AteVCytBIp5IIJAehaYyaEn_2KYeD2Corg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIujyQpj0KGD4k_PWMGobjJiv2EoTFxm8wp5_4c2yf5SA&oe=6AAFEA17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kg_4qHBpaGEQ7kNvwHRlrnn&_nc_oc=Adpy5hz7Xvfxk-kD06kxszAV6-16Fo0rfgNQ6XtYYbvvo1qL8LlEY2uKxq63WVFdP3M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6t-NkW9cXkez7BqnKBGVW9mpgflHy5z0rABc0oyFogA&oe=6AAFD938"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emWur3C3zT8Q7kNvwFcqRG8&_nc_oc=AdpFxIGQUq4MkRI-3iF1mo9fowC7w6izvRCQEHp2fsl9PAJOaMDCLlFh0NNbr8iu5lM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdx_gAw
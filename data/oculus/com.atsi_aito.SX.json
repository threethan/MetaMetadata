=7f20f&oh=00_AQP25YvnIiIQrg4R5IO4Dda0erf65rlB3tzlX40lFDNcSA&oe=6ADCC7FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6kj-Ps4N9DIQ7kNvwFGSPlh&_nc_oc=AdpfcppfRJEojSXRTaAG9cx0j5qEZogVO5OPkRniaW-BNShQ-ACCrV6dIR9JMyWW_5g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN_Hwuz3ND89KhU6ordUCFZ_FUOVrDIWADxyQkk7OwIEQ&oe=6ADCB0C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtQs-LnL-yoQ7kNvwFLZr9T&_nc_oc=AdplpcDgy1yWqh_6-HNQ_BSxNfZzimAS17GGGewOJsGDK12mjt4Uzo-BbidRwR9dslQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYOoGPGeuUyMnD0C6TJYX1xYMOWaFwZhrC2TMnYmb5jg&oe=6ADCDB77"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6cM0QpIm_wQ7kNvwH5e4QT&_nc_oc=AdoYVuYW2rXU0Z1y0vnIe8WFzEI7bcOEKTkrOqlSx8gHa--6K0KnG3ZLZJxaO60jDoY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMN6jOzmGeZyHg_oi-1xbMuHgpUBusXyNxRFPIOY0h2PQ&oe=6ADCC768"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGUmhzf-RFEQ7kNvwHMQYeW&_nc_oc=AdqJK5LG2WJ9WGUvl7jxRt44nZTe3CHAJNlrZFbpA0-eP8FBFua35ba61eOm5QS9t7o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3E3oHluG1M7prssAEmHN_ubsh_SemmYVkDDFk33_N5w&oe=6ADCBD17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ef5H9P2a6HYQ7kNvwFPt28M&_nc_oc=AdoxGs8ou_aSdTHN4T4HIjUNyogi9QT-0lGvPnpLMyQchfCNFvu_or8Js7AcedVRtaQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_kaw_rkCVxlkBpw3TzpvlKdMyZiKBiLP_HmuA4kg4zQ&oe=6ADCAC38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AocQ9Y0S870Q7kNvwGWXFXb&_nc_oc=Adq83QlYfGT_gnSHcKY1vsn0vo7xPaBs2NYy0nUHkLZrXFt7jjjo3_8RSiMHBTkMQEI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNzI0EI0
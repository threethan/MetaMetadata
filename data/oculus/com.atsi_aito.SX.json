=7f20f&oh=00_AQCrOqHf1sGUOJ6eVQnfr0lNTyJqBZX1pasNCHnpKujzNA&oe=6A64CF7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMD0H6EaQWgQ7kNvwFMCjdq&_nc_oc=Adp-U2_EdjHhg6OM91iDiCLXJpQML8r2VS9vPRBaugBkVBn0R9j0HNBNhHRe9O9A_cE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQANHW06dHLmIAELvbN182Eww7zBWn2U5p1ZnxYZWlxK2w&oe=6A64B843"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAtKMvCF49wQ7kNvwFKIa9V&_nc_oc=AdrffU3ZHZ_pY4WAce96ZzsddECMrgFqOJeOgMqKaOq3zazzHFb6nvqtlaUZ1Hkqq5Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQJ0tlLpJ6U_FlrVz6kWFo7J-q0-hzEMscLbzOJWkHOg&oe=6A64AAB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgMDQL-ypAsQ7kNvwE9ea1s&_nc_oc=Adp-F35FWgP_3tqeM93PL_7F4pmC5Wf42wla_m6s37DLpRMdlDyy-vNZrQx_YFtRYHI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuPRp1cKpZPwA6f4EN_pLv8XeJm3ceWcWR7-0lzFk0TA&oe=6A64CEE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRGX5Sbo43QQ7kNvwEQVSxP&_nc_oc=Adquu3vZ_M0yEDKfKEVceqqN2SQS0EIdXfZ1GJoeHU972NH515wxA-Lyhl3IfDsX5oM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_kacg9T1y7AlJKuX9DA6xMhsgfSZd0YK-bGlrCfqiIQ&oe=6A64C497"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPAT-mwGaWEQ7kNvwGC5Cjm&_nc_oc=Adr-PoNcZ5At0kfhMjU35K-nbSL-Xk-CWyUyoWZsIw1GxEJXvLPKerHZXR8WsoEyyEU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbe8fzWUrmP__5yhb9MGmuQzADsamkc4k_ddguzgtBRA&oe=6A64B3B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYWGAX9_sbEQ7kNvwFcGT3B&_nc_oc=AdqJj4--CGR9Iru08EsABSYIYW_iXSLQAKRrRb7-k5468MBm931nKXG1Xb4GH_814tA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIVVgeq
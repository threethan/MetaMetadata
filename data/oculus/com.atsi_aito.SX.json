=7f20f&oh=00_Af5hVjKDYkVW4EWWq-vARB3cXVFpK7kaeQ0IT9murqi-3Q&oe=69FB577B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAzM_Qp7z5oQ7kNvwFMOpzU&_nc_oc=Adoj3RTX_84L6qSNl7-8X4C6Sz9wlkTMKCMhOApr77CMP55OMHtPIJRyCa2aYmXaK60&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BFEt8RthSppB4ybOt2XXsirO6kynmgpcjT0GYlqh06A&oe=69FB4043"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8-5jORE3-YoQ7kNvwFWB1K1&_nc_oc=AdrPPK2C9QUi67jIDGegWjhEs63AO4TItEggJDRiflhT68ssnJgU1nBNWlMJmRLNYlY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lO7LFQVhPeL6bMy2rE86BiAgzCq-BUIFESSLcyKLohQ&oe=69FB32B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UxDE8SAitCoQ7kNvwEFgV4Z&_nc_oc=AdpV8Oi-HVdv7Qie60zKGm_rGNUiCnROqU9qRWkFMuquwB3xZFFuGH5VJRquVY-YUuw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FQZPrYPRt2q_dYoScc5oQ-pCYq2FfMd10eSbbPn538w&oe=69FB56E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gg3w8ww2qQQ7kNvwFITwZS&_nc_oc=AdojGw2QmCUs6y5xHJIU4W9Wl7l9eO2u56reuJ7Bsl3jYS_Jkp91QBodjpt77Ym6F0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZGLJ2Y-ZvOQ1xPZA71v1v2fAgjn-xWppZrPK-ybmpDQ&oe=69FB4C97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVKbGRWwmMkQ7kNvwH1uA_K&_nc_oc=AdpaL53wK-a1wX2cRs-n3WEnqyFZBhukUQ7oLlyh-0L5XD9Y9JAx95Ign2ql0MW_1XE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L8LADMafEHHMDeejE7dmHDRYrJUWuCXSWB9CE8d1MqA&oe=69FB3BB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-VR5G9NbyNgQ7kNvwFYesQB&_nc_oc=AdorAoUl6fenLKwT-FYhulRUkzN9H5QzKQGHF7qOBbbxadz8fmfgMhZ5JmfFFZmhNz8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kiCVsn
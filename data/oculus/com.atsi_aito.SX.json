=7f20f&oh=00_AQPNPrZbNfOU6bQjCy_mXS1IxvAGBs_cAbUC-W1KURTQeA&oe=6AE0BC7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_4NxGqoVY8Q7kNvwEVY2Wa&_nc_oc=Adpx78hL5nXzcdIrTXBioZd5-sPa9SzqPJoIut0YMCxJqZDVG90nhUfnAoGsKb85pwM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPvpjySFYGJjwtjXRagGBoHJk41V8H17mjSPVMJ-X0ZMQ&oe=6AE0A543"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K15PESOXqgYQ7kNvwHHktkZ&_nc_oc=AdoSs6WJm-zYwPd8kkF6-yKZk9DrDobkMKXXtdbBDIQ95B15FQUo3_qjZAEMuGOh1KU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsOCgkfwiseyO2liZqE31RChRI_bYjzvKhtOZCByNSpQ&oe=6AE097B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NUGrHr2lamAQ7kNvwENlKwY&_nc_oc=Adr0I3tzpdwm5PpegJ3PYNf__vCNxvWfUI45ojt358JSsC38wL16HKnQd-kV9ImSS6U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMina5Cwz-9Fl_IYGv2Yymddbzd-I5itTNXZMpOIjIP9w&oe=6AE0BBE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ViguIvBCicQ7kNvwEGUP74&_nc_oc=AdphnG1dXATU-P3Gxz2-4UGsTbwOboj2jUBCA5VO9TI90KBDdSgaC5XsSGYk-qrI_bQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7M77pArmd6j5vLl3zFb_SHc-8guLKWiwFV0lUyLnfdQ&oe=6AE0B197"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sASx4bETDSsQ7kNvwFEbblx&_nc_oc=AdrVzwuWfS1T5pVfgRsXqlUsbXTc-eiYhQb8KH8nso-uBIoPgybd-chdXMrqMsIxHB0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcGbd2P3ENPOMJ-njGvCMUpSHRd80iEYn5f84v9fE7aQ&oe=6AE0A0B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuGrdfKdmDEQ7kNvwEa0H6V&_nc_oc=AdpN13v_UBN5zWkcDc3Z7_AH2Em5ckr5k0hxIHByM9gOqLWq-XXF5HSZmGXY-1fDeiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObizN3x
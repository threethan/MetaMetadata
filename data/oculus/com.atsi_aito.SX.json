=7f20f&oh=00_Af6I70PTh9x4z987mV1agEiEhvFWyg1N2fuzeEmepLs4iw&oe=6A08867B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CqX8emVWlEQ7kNvwGpUF0C&_nc_oc=AdoKYuIIP9Z6afS0O7xYKimiJgFJIgtay1x3RS7rK9H6xq-ATZYkNWH23EM7tnPuIQg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eaPL-fe-1PXhQYmBvqCjJbYs61qX3KRz2DnKu4njaSg&oe=6A086F43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDAPqhydCbwQ7kNvwHckGTb&_nc_oc=AdoaQ3XEPKMnq_mJB8NbblR06iM0muOduY-vnReb89AhmLEUUckAtbplCbb9Vamj-X8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-4o3Q6nLLlnxJ3TLHT2vWOpQSNlT7ApAY9iRn9V531Q&oe=6A0861B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n0pDLCm_Z0sQ7kNvwF4xunf&_nc_oc=AdrXIVHJpHtd1dRqryC2loJKnMofYrSDwwPj40_qQ61zk5cj8l7n9kobdCzi8CK8Fx0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f1so6TkHJ8kLB7ejX35Lf7KxdjuetHmCy9NRa2G66Sw&oe=6A0885E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DAVaSG_z66IQ7kNvwEGq22J&_nc_oc=Adp0IKFRZZZoeYA-t6QQ56AsbbN8GvqGMtZn-fw_s5UjR-xE4GUQugtGG6loS0LU5Rs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5y-spAHLv5NGY84TTuX761ti6tN4bkVDlNUCGq9fBfOA&oe=6A087B97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tID9dUbfiP0Q7kNvwFamdcI&_nc_oc=AdpojedqPpyscjAvfyvsgqBBRC9AyhKCWG9a5ERcAEOPeKCMpHMPbJWlX_VAwOexTIc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6FJvOZMkAmHnpFCjBVQzVRQFmcjRHVWuzW7ey2tlsYJQ&oe=6A086AB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPM5o6NmKvkQ7kNvwEvYhMs&_nc_oc=Adpu8yY-I_HCfrNrAOOH3JUyf49mrTv083jAzjABAjNAhcQpjEXYD53ojkmhV1WPJiU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DLB85M
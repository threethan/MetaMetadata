=7f20f&oh=00_AQBN4op_geRzsIGqysD2zrfcQOJr5jleJcO10JqNiJZdNg&oe=6A491FFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UuS40y_CfMQ7kNvwHO94kF&_nc_oc=Adoj6T6qaTzvkLHERYJT6tZXRS5Jsq5i21G06LpFnA6YIPjG4fDFmMhiRoneYLKfXDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB0Wl6L9gWQ-GKESCryArlylCoBoXlkExJ2HKml3CC39A&oe=6A4908C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhoKuxo_wyAQ7kNvwEhg8tb&_nc_oc=Adpigy2FSKdsCZuzeTgkfhJLmqJeaElaDTOyhF-kfwGJVctRMf7k3lsh2fGOv4uzKUg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLR0mD00Xf2PCCUszu0ZB5-wp0J90LDCbi5DQ7J67Amw&oe=6A48FB37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcA9QmC3tZ8Q7kNvwFsRIz1&_nc_oc=AdoE_7Sq_i7L8mnD_KGJXB4_HPENF1FPtqbR786bMAIOEK813tus0m26uP2h2oWA0V8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2lekb3qtAtMKUeaVffixPWRDeu8SkvXkCvpM2ekFlxQ&oe=6A491F68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xw6r9vqfjtkQ7kNvwEjsxUU&_nc_oc=Adr2CB6GPxol5nVP-exMsI3v6w1g4WuhOVdqA65yFCKBEjnLj44rwmIFczj7o8y9mpo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMnbAUa-2EnPBpsIniJ6jKsriPCo74z6qdB4-1_62M2Q&oe=6A491517"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjj80X2n7fsQ7kNvwHKINJd&_nc_oc=AdoE7djxJfVqanHVGQBumPc_D8pIENRHJVDTAQZ8GlH0P31He9NFXnsu8MbjRdnA_8Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAQOzyeCt_fJ8Vjg_k7V4YvJhvc7Vv0K4V3pF9XdT6sg&oe=6A490438"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VChZAeKyIDUQ7kNvwGweKlc&_nc_oc=Adpq_9oDR5ZNVnV5Y3rN7XmOHat7tC-DZcJdxTPDN4YF8qjxxBxgFwJOTbv7OaQRSxg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDkyvEMA
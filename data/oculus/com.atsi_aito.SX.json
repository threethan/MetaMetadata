=7f20f&oh=00_AQFaHcFvdzwYwsyL26EbnCjPhB-NrigTDsh3__RnS5_qJg&oe=6A8C243B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOhNNstYq8cQ7kNvwEjelEl&_nc_oc=AdqLDAxEosTaFGoVjfBA-hS3qqL6kI_yjpkDg-agB-a3-CYv34C8Tdcg6hXpcD2rS9k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGNdJDvDQnX3oiBB0-fQ1RamDErCile45Jz4IDSYXz17Q&oe=6A8C4543"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmJrpEa1etoQ7kNvwFItdC-&_nc_oc=Adr8RPmHoPUwoCAUZX4PaJbup50qucMIPQgBdZWtNS36ZDeeIyaibr4K5AT479vigio&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYXk2KkSb4T_c9D1uzf2jL75jBLWa_uJhNBmV_cTWh4Q&oe=6A8C37B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZLM4PA6yQYQ7kNvwF6HRjx&_nc_oc=Adr-9m2IenoOTyyADjtC5DSfFJUJJN4iArawKrC-TfcYokJndu2_2tyJQfJ7JuqFqUM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJNi0AjWPcce1kTCm7PR5aPdUMflBhjvIGbJ7xNcp0Kg&oe=6A8C23A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaMYTyg9L5oQ7kNvwEe_t4M&_nc_oc=AdqjqgAuoBBso1hzg2IT2Lv8kj9F8maoF5KXax7Sl-3cSsHsaqHSjIMydo_YJbVUWtU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEx4M8dlzgLHvvUsvco4ejLutOBmLczMjlhxv5owKPmCw&oe=6A8C1957"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JhNG705zXz4Q7kNvwHUu7Rd&_nc_oc=Adp6DSmY2AHWXQivmovkgZsxT4FZeHbvFtnQj_4KQiMusXJ4kd5nAw_BJaGgV1Ywq80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCCLwvR-C3lBip3N8BaV-R9nCz5PR1wYyIXeKL2zZ0Ag&oe=6A8C40B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZzamBvn3rEQ7kNvwGjOgj-&_nc_oc=AdrNQLL_m3OVTbx-00soksvgFd2nksFlKhvDf27jHG6ZRFM0YZMT5V-4rHc2zJ8acFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhEr6ZA
=7f20f&oh=00_Af7gKbwXA6Ww_gXYcQfAk16mfFqOarp-SrIydcxZVNDaaw&oe=6A20417B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JEjf4qjdfa8Q7kNvwHk4ptd&_nc_oc=AdqvhHusLZI_Sw2HUUAOHVnozDX3DZ1U2tI1uuUHZNyT7Sevnitf6xsm-5CEHGoix8s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af783NOpWR0gn9uHqVuSU-g5Bc8Zf9-I5g4UeNr4uBSunQ&oe=6A202A43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBbnC7x949UQ7kNvwHuZyFm&_nc_oc=AdphfujKlRIpXXw54b9NHy9TIsA39QyFw5-qlYywewiRBfW26UEsmMdLP_MTL8Cq1gk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_EOMaU0jsY3Tv5-44bQy1V0siBu-Q22D451lW6fdzaA&oe=6A201CB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDNMq2V3H2QQ7kNvwEuqxAu&_nc_oc=AdpgCIh-YZFaNaUpNSldRDhiqyrGCKecnHI1KuajagqOhikMb_mwwBtL_aVpGtCBcBY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PeGZfV0qen8v-FWMWF6BLdfjhJ4-upDlT72qZYDKxdg&oe=6A2040E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_P7ohWctaEQ7kNvwHGkBZJ&_nc_oc=AdpagjhIr-pYyrJG2q0Za40Y36zpTY3V_YS-i6hNBrncVS6l24qcj0e_tq-mD62QZkU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77UiXixGfiFBlK_d-uPvc77K11zSs2b8Jgv1tUYArp1A&oe=6A203697"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMjHycXS2bEQ7kNvwHgivfK&_nc_oc=Adqahz-RtXLGYWJhJK0fDZ9FVngUPbbwMSKJiD14PtBNvfgFLmUQcCxzfx8oGTM1Zuw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wG5KorGXJWxIha-3im_brewzypCU1i9zw0n4tr64sBw&oe=6A2025B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGUXQ5YcJj4Q7kNvwHpk1BJ&_nc_oc=AdqRQkS6tzk9u8OfF8iHgko8mxWtnTbSewPubrTzOpTJNR9pPeKIhUzkSksUPAJ20AQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6P3LOvk
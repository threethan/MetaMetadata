jKgHQWlOWpJiYBP9SetpaCwE-0Q&oe=69BC0F7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgECf2nw0KsQ7kNvwEO-Gem&_nc_oc=Adll9JwrosSJ3jBckRYgchZwHSIHTbsA4w3qgOwT2gKq6qJ2vpi0KFnSdcixGXbMBTA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwinWmWJDGoXfIt6NVotcj4kkFNYOyGob08Jj92_7X9Ng&oe=69BBF843"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQSzwENrLHMQ7kNvwF8xeoQ&_nc_oc=AdkxjrDOMJANnKOuEcLwh9h75hmlPqNbTO2gfbIBjw-2flTZ4OuccqO23lgZBDp3xJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx1POdmn6jUeLHeQ1EhFL_WrQxMnqpRLnIzcyj43kbaDg&oe=69BBEAB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_YQmwXQPfsQ7kNvwFojEjh&_nc_oc=AdntR4dixuuwr7ULwgtYGmivcZskWoSjsSu0p94sht-NDu6kJQwj3E5qE4shEwEMmcM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxr3hJkDXpXFxrUzpFlQobdkX05U-BReF2FBe3kGCpUpg&oe=69BC0EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPbuDa5N8E0Q7kNvwGcFnZt&_nc_oc=AdkckUBfEVpE0Wh15dhB9IU2lzyktdFrjjE9XCVg0RCvTEDivVw_JOOLnTn0JR8p_wA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afyoz-HER5ZiR85QnS_mTOZdD-I31WbQrXO6ou7bCYwZPw&oe=69BC0497"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=twiKdr7X-DwQ7kNvwHYYqIy&_nc_oc=Adm-n3pWC9JTfYWqamWYdh_p9JeF3zjv8fDx7Otv_w0Igpz5naLKO0VGwfONT6hf08Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz88RgjbcfQy6fjTNBvllFTN58Xc984t7UdD89lV9YMqg&oe=69BBF3B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntHFX9jCtwwQ7kNvwHyKs3t&_nc_oc=AdncMrSCi94qMSz7jEQGz2daHgju-sPpUNkuxhsmmIydeW9dXftsEgarSdgQgUImzEs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afz2xRtQ9yfd2aTgPuSZujVqnskSQF-sX-L0jMqeRChDoA&oe=69BC0586"}, {"f
=7f20f&oh=00_Af7QRtyNEpDxT8hfwQhZRN8npUpzm2E6-Lt2oeNaCcAbMQ&oe=6A03407B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D40qOqkn6OQQ7kNvwHOmGki&_nc_oc=AdqX9zjbDodYJSfTDc_oeZ7UE1PzNv6pgCwNwnbq7OejUwiDggH0Qg-vAfrnEGxY_w0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DCwHSKTslu6WqYa2OzMo6FSPBDuDhOmCySvLUP9uqlQ&oe=6A032943"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vSS4jTP8b8Q7kNvwFOacQw&_nc_oc=Ado9k0fjI4XEzBCAZKkBNf4lJol1frrYCX_N6Gd6KOHhrY0lb0jE7j9cILCbypzuQdU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72z5zPT9_ntGiu2d8QQ50tycSCrNh1V9-A1wDO_XoB-Q&oe=6A031BB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IwLOvGSi3AQ7kNvwE0aru7&_nc_oc=AdqNNclyxuhRx8eScDy9gNfFScinKLBCnWDrh_gYtXQQdU9i9gNeLGi1JIycpEtfCbc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TYFVl7WzfxN25UjsF7CWLd5gsRttbgUczF_0MDUTOBA&oe=6A033FE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6shUD45s04Q7kNvwFTXoqE&_nc_oc=AdoXTyvski3OwUjR8Jvi00Ey96xeOYFSDTkKYU4pfsc7KVwC0t1suNqfo-uLaYuVxes&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4IXAdnsl3Gt9ZOx7jRSyTy4_m65LaeuP31ywoyZSOvKg&oe=6A033597"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLqL32NrdUoQ7kNvwE3qNvm&_nc_oc=AdodbajAJq8iL-7qdI3TEvOhEjV0wTmJMF6ZY9dj02YefVz9h_OpE11khK0l53jUhJQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6lRyzMWTNS9ts4vewpzMFpJpAME22ezR7SFAyw49mKcQ&oe=6A0324B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFEVfl_QuRQQ7kNvwEa6oR-&_nc_oc=AdpI9VjFmmPJ8bVfoggcMOiYdBlnBD69HUprzu9nu3gc6N3MjvxvT9Wrqbb4wnMKkHU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HvK4Ad
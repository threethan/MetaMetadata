=7f20f&oh=00_Af_1C9Da-ki8JOYjnPu1XAqgLyCnVD_iB2JjMBuR9aOUhg&oe=6A4136FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIMhVJcsCisQ7kNvwF_QKbo&_nc_oc=AdrwCoVdsJRWWnvxG6xfVFfjzHs8FRi65ET_1gcB7cQRjzaPh3OQWxSLGsCjBkXb0bU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PyTlCZys5F7pUWj52DcKRkih3cGEQ5bXBU3n6LZ_28A&oe=6A411FC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihwr4gEgJfYQ7kNvwGtrkzK&_nc_oc=Adrk_aECFGxkwAPCzTjVi-BKbh5rmslbqePu1eXsTK3xfy_J1eHO6xMujBwrk8Ml2gU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90-UcOnNWduGcWf7Tf8RDgMoHUu75JAtZ_ZYlxhqMZwQ&oe=6A411237"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urIoVe3PqjQQ7kNvwGEcg93&_nc_oc=AdqdmrcswkZlr2Xuba28gStnSaOA_FXzOwsBvR5zT1iWHY_tbTVEzaz4DSZWQZayKis&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_izmKeImMiphKEgDVIkLHVxAxmGa9wXlMBDFqB2FOTCQ&oe=6A413668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtwJa61rwLYQ7kNvwFPSZeb&_nc_oc=Adpmf0KZjPadYRFR2s126eFrA_C7AMOpJCFv0-XHLEP_f2a0ToQ9GIuRYaG-GpIUQeE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b9q-s0mnBKsrP_dZBO9TrxQ-TKoioDwdfkxLtWiMY5Q&oe=6A412C17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YGkPOxAF-MQ7kNvwF7G3cq&_nc_oc=Adrz9YaPmxjsZRFGA_dQg9Wz1yb_eFEGy7_f2t667TUtW5zqVjelKk4TKOrFjhV0OCs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VVTRGVlXSM9cINMg50Yj7f7GvTmgf0g50BA0UBLBEiw&oe=6A411B38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmWMTIvjXnQQ7kNvwHgBcsI&_nc_oc=AdpRlq0JL1d1MKzKLn6RO9MHm1Jv5g5qsmnrh2Dlz79z02OyL7vbUuHzXGJ2LwnyW58&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-d8x9up
=7f20f&oh=00_Af-2N9qHoN0iOx241GSy1ZeKC6wF9EaDuKT1w24Ox6YV1w&oe=6A26D8FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fyahp5T3-8IQ7kNvwE8bzlB&_nc_oc=AdrvcXisT8PMVk_Ls22nhJcn0so_qsyy52k5C4sG1dv3ROARRrLvOws8X_mirYSkPF8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_D3T2YpNrmYRIqLk9hfKvTXf4KFaXDOwLHvFGh13qtpQ&oe=6A26C1C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb-IIEY1joIQ7kNvwGlH-jr&_nc_oc=Adqa_DDffCVgnvatY7TdQuH65B3hERiLfrIYFD95-1-Rgo0hYbL_WSNGqFTfesLvKyU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nJmfh2kiNH0bmeKHPfLdczdUPk85qrEyLBgw0qpHvQQ&oe=6A26EC77"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VN8vEfQz2yMQ7kNvwEqDn9Y&_nc_oc=AdoMuKJXIh-b0t9xGnKnT8P7NNag9znwLA05Z90WJsirEUH0fPkGtBZqYeYjEZea3FQ&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_XSWQqtLea5Z8-AqusZUZXt1ULj8lVOqDcsHXkdkQbFA&oe=6A26D868"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOLnVlfqwyQQ7kNvwHsUaMc&_nc_oc=AdpAKzyyji22t0SZGeWV7AdUN7NBsiTIKzdMxkPTCixQLDrHciDNz7Nd8Pyf7Q3LdtA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UrD_Y41g5mhk6cm70cTS-OL7LoCigaGX7bWryCgF2Pw&oe=6A26CE17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUx-2zYm2YIQ7kNvwGr0O1J&_nc_oc=Adpu_l8nPdOi6d5DmZUs1FkZbaNFi3sAQWaWzd_-dDtNou46ZABmpQ76B10OGK7QrLA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_JhIs6wgdQi0czSvZZ9OvBZ27ExJmabomQC3Wkps7Ew&oe=6A26BD38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULjFe0BVqUkQ7kNvwEa9wel&_nc_oc=Adpi7dUA3GrAqeuo2gP8gXlfj-RAYVB77NbbIuFr2QTv_UDYOjCQrM-RdtEc4oSaWpw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_Y-14t
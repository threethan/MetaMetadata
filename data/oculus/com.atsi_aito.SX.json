=7a30f&oh=00_Af07VYDrU8GoeTftRRn89sM2IBh5nVWJzAQsI0h5D8VFQQ&oe=69EB857B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFverxyrsA8Q7kNvwGKpY7n&_nc_oc=AdqzIYqo1O4Ws0H7brdmSNxPf8EQATHAkpu5cHLvI20DdaugbpcHPMGPjiIpApST0GE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1rKjWlO73M3ASjB9c2rOaTQb-SakiKNVqFB6JidhWsxA&oe=69EB6E43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZqwP_0DSKMQ7kNvwGiazoU&_nc_oc=AdplrjRXRGW-qTrqzlzDbcMrpYm3sS-jK4-JOXU3otOeFQcK_tV7UoL2WOCfAjfR1yY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0sb9A22qZBKrj4IlXuqJQCYpz2d0QWIzPGINZXwv5jZw&oe=69EB60B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AmP3qVPiLkQ7kNvwEQmGz-&_nc_oc=AdqTClVvsyOakWDVjkIPAHH_4LzLJ74QK68nwUIDAl5ukGQMl_fOLsq4dhr_xsvQ6Js&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0jd8XS2vhLFu2QCgqpfsw1PBYr_-C4gsp6HnvRTwj9hg&oe=69EB84E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zJWxEClA9gQ7kNvwHJmMS0&_nc_oc=AdoRlRh-UQKlDh44cean17rKfNRegQXMNAqJ_RMZDt9bfkPp4cPA061MreVr20yuiIk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0QLkiAHIUxdciMu_lJqIVnD0vCrwEw9WMcz35lqtRavw&oe=69EB7A97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru3lWZC5uUoQ7kNvwH-zEb-&_nc_oc=Adpog9xeaNb8Yj-MGb6zlKk_ayK6ibwBALM7qjyJwMdlPdIpE-z3gk5R5Mr86KOEZnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nVCAdLi_jBMtfPhV7uT-XiWU8UuEWgZn86BT1s2KDQA&oe=69EB69B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlWNwwY1JK4Q7kNvwEVeBCf&_nc_oc=AdokszIySzIDGEiUP8i_vrqtKQsaGOAE6NqcQF_E7uZtUoKDzWojdA68bz4UTWETscs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tyjhpP
=7f20f&oh=00_AQN0Gn-xu6kJedUDica8wOFhYpZOzsw7bALVoBPglxAWKA&oe=6ADF6AFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_4NxGqoVY8Q7kNvwH7vfsi&_nc_oc=AdoA799MUoQRuwmvQ5iTm1RuCkmoGyB72kmHrnyI1SN92ElphoP-56QwFsaSo33SFuE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvCt_HiZ11lZbgdoQyHc4qP2BbeQauL2Th1gEMUaBOEg&oe=6ADF53C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K15PESOXqgYQ7kNvwHb-Mm1&_nc_oc=AdrIg34ksEKQhyID_RZQGK8_W6oHa3fiGJLYareQrYhhapkRnShaOJt_DwtyHauD4rs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUgezqrSJURLeRQyFg3zpOJ4TKwG-WKNlvvOL9X-lPlA&oe=6ADF4637"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6cM0QpIm_wQ7kNvwGfWBUo&_nc_oc=AdpYiGfbxFhBpuVS5w1dmQYWrJ-wAGg6ed-N8F1UUwpEfXS_S8toShbzWT6LVl13bB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO90h9Lx_8h1JiU44dkA_OvvHeLOkeJOa6MJX-K06WtDA&oe=6ADF6A68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGUmhzf-RFEQ7kNvwFuabvS&_nc_oc=AdrC-CUl6uNGL2eCg2fmcdr3WvxspoG7J28QsAxT1RARqNidXLzreUOI4xdz5UCq0KU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPs9x2Iy2Cx85tv19deEVFvW_Dy9Wb5s9XpNfcOf-yrnQ&oe=6ADF6017"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sASx4bETDSsQ7kNvwGYf9Y_&_nc_oc=AdofleCMwsO2m-T-xtOGuRRkcv4GvTCaKqLi00xbkWrd538CfpoTTaUKl7RxIAHgDSw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSKEpJbzZmXdqra3O_WghIm2ODOIZz70Zeo4jwQoBykQ&oe=6ADF4F38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UuGrdfKdmDEQ7kNvwGD_V8Q&_nc_oc=Adrg621VhlyAcg-LhkuOxVnl5T-JVrppotrtIOu-tFhepppFcGmNvduHDTUxY2uwwX0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNgFXOIu
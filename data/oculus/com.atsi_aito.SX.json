=7a30f&oh=00_Af1aJO2YiprkbSE4C81Jm6inMOS4q6DNqJlynf7y0_8DiA&oe=69E63F7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HYstoPyvYYQ7kNvwHDceGq&_nc_oc=AdqTIFl0XuKJx8PwPP3KJxkoGras9I5syuXv4Tyknh1e19k0rHeHFhzwap194GUpzw4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3_3zJpoEjA6CiRb6mljHNBLioxhbERCeF0dsV8jS8DTQ&oe=69E62843"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXTOmzh24QMQ7kNvwEJt7yZ&_nc_oc=AdpACUe5c3VpifOYx9onoWzwEgzHn56wwTmD4tYhHZvmMYQp3bX9qH2dx61D7ZSH5xA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lURtiLphajeAuKmPdBRF9MM_1YoUcEBQNiV9Wimhmqg&oe=69E61AB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Eoa7ddHzhcQ7kNvwHQRQFQ&_nc_oc=AdpfdHkZ-JlNWhiIzn546rVUvgyHgeMRFaG9Dh6gVdUoa5Ixzx-0BTxtH6UyVpdUqSg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TcALNfy57MXPGEvivTHY6FgcZu0PKsw93X6PdLtGzhQ&oe=69E63EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BErTYP1j5B4Q7kNvwEWx7_J&_nc_oc=AdrfbQufh3D5nxXQYjfil041N7MI-UJxRTVaubu2u7F6JUVx_OGRwjPJKZcxHr1ABYE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O911qksIdUWAIXeBlRCAmc_RCyzWBMu5WKhuWjgrnFA&oe=69E63497"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aM_hAegtvUQ7kNvwFgAU5n&_nc_oc=AdpXzXznOhewmleLep7fqxd2LAKMyYvcOlCvVTGxCG8uSCmb9LwRXzhCuMZV1ler_gk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2puqdhhRqm5DptAwfDv-m4ZFQokxiGd0m2gbK0XsK0BQ&oe=69E623B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk8t2-kmBkYQ7kNvwEgUgPK&_nc_oc=Adp5tq5ls2ikpi9W_QwSuspNLIH2jaMuvf4ve4bBDlOWw_ohJGd_r4GEU8ML85OKpl4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZjQFRO
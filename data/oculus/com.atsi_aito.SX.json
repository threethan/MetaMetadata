=7f20f&oh=00_Af9YDLaLggG26rucy3_xjdCfUPCa7RzHp-CyugJs1IpycQ&oe=6A42887B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TIMhVJcsCisQ7kNvwH0c8zk&_nc_oc=Ados68r0quFYEFVgrJmG4WIbxy_W5G0riSn-x8mRwicXJ49SycOTRaVWCrYXZvhRHEg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8qsAcQBqqWRS52E5hI2jtyWZGY0TQZVaESZB52vDIYfw&oe=6A427143"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ihwr4gEgJfYQ7kNvwF_l9uA&_nc_oc=AdrY_Zzu-3tJ7kkMZ8zWvp0yT0iW6fAJH2EGRlGvcAuSxl-D4FZGV2WTc-OQ19hj2T0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9efC2o2vDGN25MRU6Tn1muyoVSg5DQMkSJwyqeYiJiyg&oe=6A4263B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcG3LbtisoMQ7kNvwHe5P6Q&_nc_oc=AdoK85UoiKWWj_wYm5cGxRaJ2r6oTB9j6_-RAG2ya_vZE7ViuSvCaE9E8ANPLJ3qeUw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VV4svCew8bKca-bVzzFl49ZwJFC7RAuipIUhTqDOuwA&oe=6A4287E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDvaXmJDg2AQ7kNvwGoEUfq&_nc_oc=Adqw-PGDsNfIB4JzaV-Mhj5jPB5iEpZCxPI13V5tfOJqzpcq9k8zr-FwYczq1GrafS8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af--5Xv2ruFAf_5sNhTTxaxdf-ccuBpR01NKpvHiIdyW4Q&oe=6A427D97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4YGkPOxAF-MQ7kNvwF82sFD&_nc_oc=AdpwVjru4yxVT_GgVCz2QYMmJUw0YFxsq7dew3ayMDp6MAfz-w-pDyrDYhZg2ILE5hI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8aQAHsB331Mg7Kcjr_rweLbocT7XNhZItz3lbCr3QmtA&oe=6A426CB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmWMTIvjXnQQ7kNvwEjpS6g&_nc_oc=AdroBdADTDyoj6fw6UG-mJYuElYEYvH6K2-Yph1Fs9PPKdLc3EmNorAvxmQLFbpHxlc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ChEn8I
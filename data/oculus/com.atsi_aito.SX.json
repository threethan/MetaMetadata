=7f20f&oh=00_Af4rxUOw_ZqbRn-Pg8zPXb6wkptKdOQjmbGQln7nyClR4A&oe=69FF4BFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9m4J2QsP9sgQ7kNvwEftGxg&_nc_oc=AdpxlkoKMN-fXXlT0_ekP7W4_q7gKbn2tlp47xkAZzGExzTY1eQici9Wfp8jk20xyVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4hHsEYENQ-NWnxtaXLIp07FCU7DNHWnOxqA8hQRxK5UQ&oe=69FF34C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWNrf_-yYWUQ7kNvwH4ysbQ&_nc_oc=Adojwx7xQ2-jvwb9t8iN6PobqwsfCzVBO0Tmw1LRu2a1NosH9kML5Q4yZgc7coR7GCA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wNig8lMWT4RMqaqvJLjTi3BkTQqvyC4fc3NBWkk58Hg&oe=69FF2737"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO0CkmxqNcsQ7kNvwFHXzw8&_nc_oc=AdoNC8Lni9RjyFZoLPFkpz-tIJyx5hnnTgz0QejrrPi50mBsHnNNBQRxoAGhyMwV3j0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i_GEbsRIBNJ4dPGGsGk5H4T6BzAc9PlzozwdwtgpaIA&oe=69FF4B68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWQjsq6LWDsQ7kNvwG8n16o&_nc_oc=AdqNouH0r1f-PHowKTNi237fv68rYiy8jNJX_TBprkoaSr9vQvc5EsJT2jNvIAtGq-E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4B3_ELcTxnCYB_paJAy8kGg6XOYhMkiBe6R-NL9G6tyA&oe=69FF4117"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x7totPR4w5AQ7kNvwFpmyoi&_nc_oc=AdoiODetm3yWw3SEWO19F-niWxRobmDvUTV1eLhJcM2LlrDPFpo2vqrf143mKNj-hSM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vujSzeVCTIhy6v_PLy8Mw1UHua7KFlh_PRaS3JI6jtg&oe=69FF3038"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8nFA02mCzMQ7kNvwGGy9-5&_nc_oc=AdpBK5zz6ohWpS8ZcTj0dOd50YkWfzBRx7l3CIieaGy__gmMfOrffl93lGoujAqgyyc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5WcVfXi
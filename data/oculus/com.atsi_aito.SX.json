=7a30f&oh=00_AfxK0dhM2G2rnLc50gAJMp2aqhVz1v1cZ8j3ttS7nJp8zw&oe=69CE4C3B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8e7N38Odf8Q7kNvwEgJ8e5&_nc_oc=AdpI-I8SUAFqNFl7HqS5yP9i6owBCoJJ1EVSHYjChpyen13a8pXfNyrBlfUH2pbnshs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyMJ2tx829zpbyek0WJs2-Dx8xwmF4XUMINYERmFfP4Mw&oe=69CE6D43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fv03oRiDSaYQ7kNvwF207no&_nc_oc=AdrvrX1CyCUTthyZbh7zp_5YBtR-hWChU3vOlAdAeEUV2-U4Dw_v3anLr91ME61RCcg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDeBT2e8H1RkcaFz1Y0kQ5RTAHAw9EE-2M9xMEH50aZA&oe=69CE5FB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMuhpZp8xooQ7kNvwE3v-h8&_nc_oc=AdpQFzJyFM0FrWnzVvXcWL-_pU5LR0ko32rkgfwwpc1nP2gXOOUqAEYa2Ebu8szvMQI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMkVcg6ErECzLyQr7DJYPwDwRlbb7FHbJL3GdTq0kEYA&oe=69CE4BA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvluIM1oJ1QQ7kNvwEFK3ZN&_nc_oc=AdpF6B0AeB89hhxUz6K2g0Qp31hzuR_a8hw7zmWHI4fqaOK_yYbrzHXBmH_VIuECCeg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy86gR1FzMjRzq-yN5Idix5l_ooZ9d9Q_ohAaMYPlGODA&oe=69CE7997"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72JKaBtHxfgQ7kNvwEhAxAy&_nc_oc=AdpDe40OlA4yRD2Ny3pWcBc9vf7jyRpaNMv9UmFl9Pc472D_pOlU9QP4nQJ9Z57StWk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_5SfqTB1ys8wQM9VuyGBE3fmPPtcvQN4xqJe2PjNrlw&oe=69CE68B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjAfy3OT5LMQ7kNvwFJ3TvY&_nc_oc=Adp7EfSsU5NX5Xdt-cyJ-_VCEo0CUwZnOKkyGKVU8SkNKPOcqaDn2ywvVf3BPPrNYKU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwO-D_1B
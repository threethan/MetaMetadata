=7f20f&oh=00_AQMmZ0e1bcPz2fLOxpnFW6CzKlYsreIyEDZ1FJolLxuQzA&oe=6AC3BB7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad0U9JGlv8oQ7kNvwHtwmEf&_nc_oc=AdpGGDqmI8FwZQjRCGdF8dmplVnK2KOIHZM-CkXefiqAmJQJSliBkXexPLOePKH5-00&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPX8oDkW9CJQPjU2ynQ3RH3DWanLkdyYZYtJ1i90fBvpw&oe=6AC3A443"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaA8V0Z4Gv4Q7kNvwFOe7Qs&_nc_oc=AdqSWVuRfCcLf7j0nfN9Are1b5T2kycIVR_8y6qPu2BmufyG9sHAjBKtHRpba5wm0Ek&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZpiYqc46K4TaJFmJsuYHtPOZM4EAwikPEcE91UmMh7w&oe=6AC3CEF7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Api2p4EU4ssQ7kNvwE333Tf&_nc_oc=AdoFXFYisTBNMYX0lB4rmbCPtAraWBoZ_q4MeBTAV2xWbmwb9bk91bKMenG0-O11ndQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc7fw7EmxaKfYBLnCR90XHg1R0Z0rnMY7j5WT5GKG2SA&oe=6AC3BAE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgoNffQg46QQ7kNvwEDryom&_nc_oc=AdrGZ8CiCuG76NKHBN0rStnmdiJU5TzlpXWQ3gKkE0FC28NDXTqRZmoHXw7JmSsZN1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJQkKyOBtrE6Al01d5uvAn3A2i_r6Ua-6EYdYsgfIrlg&oe=6AC3B097"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsTHC6VCyTMQ7kNvwG4QJ6x&_nc_oc=Adp3t2PQ4iI9-vWLT0KitmULQxkVzkpy5g6JrCQF6vGusRE10BgblUfRCGtidNTGRbA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMToTJjoBSfNCrHIpgmPM_J80dtUzZS8ZiPRiW2CTyCNQ&oe=6AC3D7F8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--NYNe_wI4wQ7kNvwFUKbte&_nc_oc=AdowlleTkaDOVGgrKILk0zkncdh6w-3Gifmg5198YF5fOyb2ryK8OLdHJdZExCdH7X0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7XeSLZ
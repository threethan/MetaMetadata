=7f20f&oh=00_AQMQ9WffqJ3uiUOqM4KKY8ZJR3M2TBdLu6nMls9zS5RQHw&oe=6AD23BFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1KK7PpWVdoQ7kNvwF-dUBz&_nc_oc=AdrbyL5taNrtLN0FL5G3SuuXpmposI9ghG2hDNbuvR5WH15fSEhDyQPewlMXHfiXnJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrndWl0eYceZb3GfLGJvHA295EIXaGmShMH6TWPoHsFA&oe=6AD224C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG90dGP69D4Q7kNvwE7VoG5&_nc_oc=Adp3wN6qjcgU0VBsK0A7ZK9L6cV_wyldwDD83W8c_ROBDpNvo0M_WCkhfQ2g70mmcvU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJrGFoJdkdCKgPlKUCW7Pbmb2a10c0B543ScZ942rBjA&oe=6AD24F77"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpe96lmVfdkQ7kNvwFDfL6b&_nc_oc=AdrmxjP5O6-pAwWtGv59G3xysxjDSQNm-cfM0es1Iiq3f0N-BwKpu6kvamaHenWXAus&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD5P5b0BXrjs6LCPP8ViNaxRBoQPUKctLJvl7C5VV5Fw&oe=6AD23B68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqF2Azqd6mAQ7kNvwHld_u9&_nc_oc=AdryrLliz2d0aEdRJZFOpiJH6Mqguu3pkiI0A3o57CCklM8uV8biHVNRRLx02Gm2RFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHo9N_Yih2iVcurrqArjTMbkqD0taUs4zYIr05-VASBQ&oe=6AD23117"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2wB6YDjSVtoQ7kNvwFgT7d-&_nc_oc=Adrq1_PtizT2IcXANIyLnuCc8_hSDJNMNyhHInkV7fXWP4H-y16vts_fsB4tD_gBWq0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7eJqrNBWWK7468k3YMOLqRFZfGYYEeX9qseyJHEXgEg&oe=6AD25878"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmcg32mKGHYQ7kNvwH8wW7c&_nc_oc=AdrPPiqSKq7ecHW1j0sSAu9js9jFd0mwSURy2akQnWNfnIcZbQRnzbfmJTho4lRcWWY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoXPouR
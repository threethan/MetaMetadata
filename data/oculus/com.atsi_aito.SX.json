=7f20f&oh=00_AQC0az3tii9_3lz4gjaARPR9cikHsn6VPlDu1OZiB-Od-w&oe=6A5E37FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kj6Gg0Y0aTUQ7kNvwGNgZnN&_nc_oc=AdrGbiEVo1FmPZqduC0aiugl6LkQ0xKYVheWwTEHAUzjoh7JzHDkLzIEc3GsY8V5CE0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFz0alRcDxMg_xffMXBlUQ9LwudKDxYx3c4DifNn5mXg&oe=6A5E20C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wClodz4r71IQ7kNvwE3un4k&_nc_oc=AdoM3cs9LWS87cObLo_lA0eA0dTU5exVVnwIMLugHWmPUXTEVO6Z6RVc2w7B3cZWPeo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAsDBvY55zjDWwBVobe3_0qkyS9B5fdUJQL2PNeIU7kAQ&oe=6A5E1337"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUNvA3BPNrsQ7kNvwEvoA-Y&_nc_oc=AdoOzJJ4vye89y-llpBUP90eyMio0-25nbPmdsCAi1xhWxD6_2aEoOKZFBjxyll1NFE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAtWboy_znCcfc5mzDdUhx1ufBUpiC9iojW3XoR3-hMkw&oe=6A5E3768"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTmaiCEuxMQQ7kNvwE9Nh7E&_nc_oc=AdrU4GuQUym4yLO077DsMMHnW9G28aPOKB43T3yw_vF42A1oTQC_dHRxxOb57fzdASQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5m6e9vbUZ0jnHoLemY5tuxXibZd3rcVY0LoUBpeesLg&oe=6A5E2D17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtqSjzNz8_4Q7kNvwFM9vRK&_nc_oc=AdouZKyv8MPvKK09UoVbkzVOiFYMYE8ejRJXZxtOgU5Ul2quE0xa8PDaGkHRxRXUVKA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEw3FbtmWBSjW9BwWVpyQ8yEOruNnocXYXe3_G52Kr3Q&oe=6A5E1C38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWz7RTbZopwQ7kNvwFqbXAM&_nc_oc=AdokrgAlz2BwMg62XYFmceHg05NtP4I6c4l6wbSYW87lKJb_ufeXF6rcd9EfNKFIAqk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtvCOKx
=7f20f&oh=00_AQH7HKOltFTf0WSpzSI2hHlErCQoHgZ0wDiVo9KnpW9Qrg&oe=6A7B00BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve9DJ7bgGK8Q7kNvwFZ2jco&_nc_oc=AdpIvyOC2qnXwOdZOKRfUK_B6pFdTAmto_aCphkc0q-f7QP-X-QIVXUeKYgtcw7SM1s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHg4ziEH2s4VvFFrlcMfSqHu7HEgFh1sl_2E_-XbRFew&oe=6A7B21C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlqh9kA-PowQ7kNvwEGWfDF&_nc_oc=AdoiGkn5JudqKghmbma3JobJDp_z3e0Rl2V2-KGSDebKvDCo9BjKgiBOWu9Ep103kqQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX0Hf4bM3WKe-MNp1TghnP0JUACd0OfSrnZ-cwGcj-Og&oe=6A7B1437"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3tZ9PkQ8RkQ7kNvwH-QmAt&_nc_oc=AdpXeGQ8WyZogvn94yHVHcTufu-FNZZvoFuK20zlbh0CstL-VQlD8OoReAraxWK-3lU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsb0zRdnR1vw8cS-oMREsY2_yhC5GkuVm5b-qie_dniA&oe=6A7B3868"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxE_T9PJkcoQ7kNvwGFUYyD&_nc_oc=AdpM4nbpbvBYzDlwG9hJ4em6dIisFbsOvJmjPtUH6luK659X_BgmRaF-S__ULR2NfQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGJiZ4qnXiTTx0GW9n42U5tn5KKGUo7wetIVpxhS_A4MQ&oe=6A7B2E17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pLbY5g0BWEQ7kNvwGNtumy&_nc_oc=AdoP4n2Gxn3fsWKENCsndD27gDZZ1aPSYKYKrbPicHUxajWBCmovCQtjJdCzGCEF1gY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpF9SujTxsjY8G66XYfjU0GvNvF_aKP_vXdJgFzkvbVQ&oe=6A7B1D38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wIWuD4esAUQ7kNvwHfdExm&_nc_oc=AdpLGZdg7F7gSvfIkhGOlBEA67TFk8zUsgP1rDPd8aa4ZwuGxKPf05YsQPuD9V-cOxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFr0HHny
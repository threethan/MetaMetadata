=7f20f&oh=00_AQTtdQBTCiQpoqe0wwDDc7eT33Hi4O8P7sOkDc5ix0emRw&oe=6AF9C8FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z78Z2EY_TWMQ7kNvwG9_dFe&_nc_oc=AdowTjpSZ8qMT6HL2aZNOhTgw4rPgHMxlqEsJNQ-ROOLaECJIi6ALG-Nd26zpWbuVIA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4KHMHUDhNDh3ket0CRKjTgZv8c-cQhvqDtN6aUHpapQ&oe=6AF9EA03"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mJuCXeynJM4Q7kNvwH5sFth&_nc_oc=AdrOgac-xF3Wwm3nUDw31zXcvrzE687xW9j9UM2kHv6EGFfRbCDB7t6DrnjazOUX1Hs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRe9U389TGZ5nlUN5G1HlIZiWgJlH-ZXAmrzntoT2qFaw&oe=6AF9DC77"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmHBZC7XxacQ7kNvwFs56xP&_nc_oc=Adphl5wMQwQ-BsD6uyhz6N5Lrf0dyyICyXWifMI31FKpv7zIosbURcd10Ol3DaM8-DI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnSydeg7VVxH3l-erW9RaelZ3dS6cjRtJvKgXU1T8AAQ&oe=6AF9C868"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAQ3c_N1JNkQ7kNvwEH-4LJ&_nc_oc=AdqUlaZszuqkMx-KeN7iJm26zuSc8ce-Egj7NrUk9W6nuOiJSd8oBUWIuHaXjBZzvtg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRbEr1MDxBIoJuZAbdJmVdA2P_8p8BCaEiIt7BMxy1ZMw&oe=6AF9BE17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q1YCx7q2-MkQ7kNvwEh9-gS&_nc_oc=AdoGBh5j6p-dxr_5vqJBhQKKd-7Q-9euPF7D3gASsL2Bz7p0TMHSwop7dkIrTHGfFBE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeS9rJP1QfkpE8HPk3DqVjeOwBYrLJSHUps_YMuW4Nnw&oe=6AF9E578"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Q-MayP48Z8Q7kNvwGF8eGS&_nc_oc=AdqZaMm7TaI07HDEVW2tPXbA45aTm-3Tl7P46mhdOOrWimT1eZR9J8kPnC1WBLpH5fY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjYA9A0
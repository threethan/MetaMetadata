=7f20f&oh=00_AQT6tMYeOq1Rs1Cj7ha8lntzMCe4UEmHekpq4ryzINNIUA&oe=6AE8A57B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIRxVV_LqkgQ7kNvwFPxyLY&_nc_oc=AdrZCLwzqGOOwFcdSyhPpyPSc4UEU2ywj2l8modfk0Ulh4cpx8SFFB4NElJHHITPk0Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUer8l9NedebsblzIOEV6D_PHl8G_Gnk6xil-bhWjA3Q&oe=6AE88E43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Dgu3T_3ePIQ7kNvwHrxjIw&_nc_oc=AdqXcDZH3U5WoRETVDopi29TsryJK8fgLYKuHdbV0TLej3jLhPGQNYLl5jeVnJ7Dhc0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQk5I3dPkTGd2DAB2agekAK8yt3vZvYyx85qtck7U8DDQ&oe=6AE8B8F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osVnFp07ztsQ7kNvwGE1dDN&_nc_oc=AdocAGscFsulm-X6J9guhpoVjKIGC6_faRvWYUL2c9_oNE9HDSjLlGWgRh5Ols5-jUo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP-8HucuWNG5cvxEvn4hnEqQaRFxBXJm5slVBRyvezKQ&oe=6AE8A4E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlCC9GdWbmcQ7kNvwF6wtHs&_nc_oc=AdqRZSZeILJga8X0oEzpH_L3kZ5mayZr-pF4K67RxuGjRhkiUQjDPgtZlDuX82fGoPQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQbz6L_OHBqFdsTSEsmWM1-mTpmDej6cvmilhXIytDYqw&oe=6AE89A97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZW_L26pd0UQ7kNvwHJQ9R8&_nc_oc=AdoKh6u6DwywHByPB7bIAagKCrgQQmm4F1OHYNfZVzn5N1e3sUKEoTW6CI7obfS74e8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRgZbuf2laKvvpI6xjXSe0mfxbSIhNEbz-yxOceEGel6A&oe=6AE8C1F8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmC9mqHe684Q7kNvwHWLdVk&_nc_oc=AdqXtqAjIRjuSCNEJiRutYGoHOjM5Qa7u9baBStT93HfasHVQznltbBnQV0KWZ0nhK0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRw-ZpL8
=7f20f&oh=00_AQLus0Xb-tR2ykn4u4wUMqdVGNac0PJQl12VQdWRujj0lQ&oe=6A998B7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY8WpWmg7BwQ7kNvwEseGWZ&_nc_oc=AdobRn0JFHy8aX1t24xkaOV7dkwjN0QCGqLBLviwD_iCf0h-J0CIeM-4YrTyPwvr34s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJX4CBX0gI_RwLfiSlYK_Ji1pEPTYiPZSFDd_ebS9_CQg&oe=6A997443"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDBpr7-pFxQQ7kNvwFwrb8C&_nc_oc=AdofpncDnHGyhW_PbFZ0Qv852c97QsPgNal_kDuOK7Ml8IhRYC6OFnvgSVrKr-KHlZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMdteMVtKKc3fo6Hc8y5fXKfeXUMqZpvJ41Go0YiGaow&oe=6A999EF7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYdfj2A5OxUQ7kNvwElfBz6&_nc_oc=AdpkVygCn3m-1007if_Ki6Gjex_KUrbrxUmf3pBvrYOT11btoWPvy_OusIOVVUucW0s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAjGBCZKgZyZeg7sM_ccun2JZFOCcH9FsX8PlWxfj7dw&oe=6A998AE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ0fRPXlrJwQ7kNvwHI0VAF&_nc_oc=Adoaoc2EebMYI4FS87DhZsjeAk5Pw4MASSz400aZfbbvKZdHeAtqHpJJ21gHGTKcwho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgLZXCacvft_YANYiP2-aruLKMb49gwis87Tx7AiUsHQ&oe=6A998097"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09gQK4RJNT0Q7kNvwFmfBJB&_nc_oc=AdqcKzv2fEWfi665uMUJ0Pyrrpw5gmJlVCrmYHxmxsNhFsr68fYUUnhe0QS7uhYo-UM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDrFt89--URzabVkYqusG4-5QNLlXNJSz86dZlRRGK5Q&oe=6A996FB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1YCvlkNmWQQ7kNvwHkOURV&_nc_oc=Adr7S85AHxbU4hmQfZDybhYoRU3bO3XP4A1iuw-L-NDg_YEeTUmy0FLAa37QkxjjmCE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL3oMYGM
=7f20f&oh=00_AQItbf9zDC-0GVZlPz7YJXKspO-Z3v1dUZ8Ij-Xd-ZoewA&oe=6AA80BFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oapx88V3eWgQ7kNvwFuU3V-&_nc_oc=Adr3sgkEHn8NseovXOmtmQuRZ1JTzddAmXpNdeHagRZHvdAqHsrQST6bOcTfHcmTUz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy8EjVRCMCbCM8SuOHDdv4pZ3xLOyF3wnVswbJ1Ybqkw&oe=6AA7F4C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9jaB6zRW58Q7kNvwEpg-Ka&_nc_oc=AdpY-i1_yao6jDTc5zHF8LzjYxUclgWDaqEtW-wcGJvXjhGIlxoMF1U_IcmsRQS6LrU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNRpc7JjDnSQDE_nIWrq42dAVJcePEq5lZZSJPQxJZaA&oe=6AA7E737"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Hcoj6s4QiUQ7kNvwGMq3Gg&_nc_oc=AdqJMvwf76xUP4-PD2oWNiN9efASwY6O_OgkR-xokki8UOIazHNK9d_qMolHKjF53Aw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZ0cZKabVimhJB6KqJbOLiwQMczPu4pIpOx7jq4kjgHA&oe=6AA80B68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unKU2lymqvYQ7kNvwH7wzJq&_nc_oc=AdpwOiA6DmmAnvTfjwQSA76JFO7z7nX7K02wU1NUbRMFZUq2RNis-D9NIqACOPaj6HM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-_tu3xYbTKvr6i9g8i-M1QAESv026jvKwJjiPt-iLsA&oe=6AA80117"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-WXrwyD3XkQ7kNvwEVi4-7&_nc_oc=Adra8tV2TKcY_fHrSExXqZodYoPDqH7hDWybHBZqFGCJTrqIK8ctlqEOugU6oSX5goQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWlf5d7SU19ujbcT_Ht0OKHHcSSdyZMud39D3oZG-kIw&oe=6AA7F038"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHUjVEzCDhsQ7kNvwFZXbov&_nc_oc=AdqOCMVMGvxSx369V45oazLBuYn_dbFkgIrVxNnJg087My3MG08FRvAkG5ruxbIVSvs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZEBh-0
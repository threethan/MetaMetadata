=7a30f&oh=00_Af1nk5RDSlZoKYgrQABxOxyQk24INKT2xNU7xW72ENyZbQ&oe=69ECD6FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFverxyrsA8Q7kNvwGX3kg1&_nc_oc=Adp7bl4vmXipK9sLujQcssfkOdW_f-picqprd_71aXMTVCSANd0mo5_qZEW0UWbtb1E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1IbG5p5FBnue6XVpi69aUz-tTb88790Ya6pEGTw8LU1w&oe=69ECBFC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZqwP_0DSKMQ7kNvwGUc_A2&_nc_oc=AdodklxXEmRcuC0IT6JzVmJsnpwe-Y9SzB4lOD6llVI3bX2T71z3KxOyZtJ1MQ3CWKs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Vypw0WxGKYMi8wFxsiIM0jlw_-CpnwJAyHd2YK9NlOQ&oe=69ECB237"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2AmP3qVPiLkQ7kNvwFkIPCI&_nc_oc=Adp6y6-4PRXW5nZYOuPy4eDDy7D_5QuHiTRsEnbsZlwHuQj24BiZFrQmvW6epCbrjqU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PwOLho4uWKhB7WpG2ihoZcTD70h1ijBPbJr1ubJP_yw&oe=69ECD668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zJWxEClA9gQ7kNvwGqhZxt&_nc_oc=Ado6h4l8kfxwgoLoNrT15JPXbeMr3lvfXJBsvKxVRjc7e6inuPTsEYVSQrKXvtkcRLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0TyHHCB3Ic7tbmT1lUXoWAiG7QXMjC2LKhrBrGOEI3pA&oe=69ECCC17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFBUZvYe-TIQ7kNvwGNCb-u&_nc_oc=Adr4mM1rXkHmMExhcQqeOss2GnkHMZY5S-qog0arhtT1gJ2BhBle5N52nSC6IL5ZEJI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1diyWBrYXMmCRdBqUCtSz-Ew9T47tbr9soCPqn-yrsUw&oe=69ECBB38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlWNwwY1JK4Q7kNvwH5sZ22&_nc_oc=Ado4GmC3_0jMmKrvTUB-R2V7z1cJOguTJFlGKzTeFbzxB6gvqnTdNTK_cSntM8COGRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Req1WD
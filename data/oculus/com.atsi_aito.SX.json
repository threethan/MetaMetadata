=7f20f&oh=00_AQDHotp5ZdL76iOdKWv4yLDHyCWe74bmNx7mnj-9R15Eqg&oe=6A53ABFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVp9Sr5MUT4Q7kNvwHfQWdq&_nc_oc=AdqnhM3c6wlyk4MAJlZk36vYOI9X3VdiEho4MfkKX6ztG-nR87CjXyyW6vBBGA_UsBg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4tE1Af8RPc0YmAdxa9llkJJDOgnMN1b6T4SCEyM9COw&oe=6A5394C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nw5W6wXmOA4Q7kNvwHgIkkS&_nc_oc=AdoMcjsVwJoMPgqVbT77HaQHznR6zG4UYiKssGH8_tFe8QEkHIXhN8WulXX5S7BiZPQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCLtkI-OPDQ79C_Bvy5V_-p5urEtEbD03kFIMm9SqnvOg&oe=6A538737"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcHHKJrWQ3EQ7kNvwF5_y5E&_nc_oc=AdoIYNvTL8AtG3Xjj0ImZbJLRYJf1QWOH8LQPF4NC4UEUZ8q4OIt138HAWXUxstaN_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAD3Wen6yW9LYsvjgI-tjS1FQGBWJadwxZxJWldcK83ZQ&oe=6A53AB68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OshZNvforHoQ7kNvwGjIOCZ&_nc_oc=AdogibVWUHkuDC2pCaqOEqyiRcZSnJgDKp0rf7jEzXlPk_SUGqhH5st4_4Tq29jesmo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAz3FDDftGkqo7OcB6sbV8vJytBhY59-mpH1Ug8xj9vLQ&oe=6A53A117"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48De5STwZHUQ7kNvwGgLvO8&_nc_oc=Adp74sfbGt06peU996zWemEfoFYcXU2TCiHr4hXl0lL_KEOAdoIRhh3Pi21TtBIfANw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2tMchAEqdG_-VtHJ7gXSu-7b32IcuYp1G3Ry7VYXw4g&oe=6A539038"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQwvLDWEHpMQ7kNvwFqM0Ej&_nc_oc=AdrMq0FGbiJ4DQng5szISwZDm8RS1onYZ4y8xjJOl0Q44I5xrG88R71VleZ5ua9xUUc&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiNUUK1
=7f20f&oh=00_AQCUgTfs0o3KtWU_z2vCbzMnHr3_VgW9_M99GhB2pX_iEg&oe=6A5108FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVp9Sr5MUT4Q7kNvwHlsTUZ&_nc_oc=AdoJJNBm7FUlHQad3VF-umGFHYnL8eTJvj-hxX_-dmHD3mUdoILyaTQix6SuzuyiQgQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEG_yFDrKs2jSchi1ohkp7Mi7wSF4iVYtg3aVVxRg1Fg&oe=6A50F1C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nw5W6wXmOA4Q7kNvwHba5Fp&_nc_oc=AdrHo5xS5MxJwaqt4yxQS7ZsQeE1x2S-VNkOYHXiXFuwocI9n2TbUoc6XPMvhKr6rRU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjOzVJC_EV1rFiLNKClRzSmwvKYe2gItmP1XSWEAN_rw&oe=6A50E437"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RTfvG7IZTAQ7kNvwEiyq2e&_nc_oc=AdpPZf7y0SJ0eNbbq2lHUYss4maD6Q3DNXSl0cPsrdiue_avjMy5Wf0rwS4IecvZx1M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZXbom0W-Y7a8SCTO1mG7HRkT0Ci-1i_UIS83onKiCuA&oe=6A510868"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHblhAgZP08Q7kNvwHBGWuz&_nc_oc=AdoRMpjqNMDGFls4heqExewKj6bEv_wMLNLx9N1-QrGpLCWSMKmojDwplxOo-bOOiSo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwwG3ESNU1nWt0U6-gX8hdqBAcrRXnPEjqKTt_y-twJA&oe=6A50FE17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJ9Wz1DHMrMQ7kNvwEMH6HD&_nc_oc=Adp2JXCAgkLlwaG3XIbhxTOIYIkfMa4zRCXXKNR7YANK9Sfk_wOrlbxVnOtOD4nC78Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALcSMd4LXxJD1uHaIdNji42VLjyfE-YTjao28pQfdgaA&oe=6A50ED38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQwvLDWEHpMQ7kNvwElHmol&_nc_oc=Adqevvk2tvGrENJzyfaSneyur8qhefXeo4k9T0w0tZFBjx7uZjCv-s-SJ8r3EseUO0M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdTIK9p
=7f20f&oh=00_Af7n1VPLd2WQYjwsuEpF17w3T8sRpienYKMb02y3o0UGLw&oe=6A0DCC7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_90oTNzrhwQ7kNvwF954xT&_nc_oc=AdqCvhCR5RbdwKDJUcFRBn258DhhfxkM0r-Dgu-O7_ae806lfS0ZimQNibF6-BaJkLs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xpf-zcsndNhtxczG7TurrN8EpHycmtXzxLKC4sU__eg&oe=6A0DB543"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJUJvbhCxFAQ7kNvwGMh9uA&_nc_oc=AdputLWQcETWBUrVGW33GRmEBr9-6POcRSPVB_RU7kWWjxqExJyGMEDFbW5wYbg5nNU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75_FHToHPn0eiTkCyQ29IWwsFeRHYoje18RF5diGvhMQ&oe=6A0DA7B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyPurZghYbkQ7kNvwGMNC5x&_nc_oc=AdpSnHDfz8IcPBtNpYoqgDBFalML5TAAwr8wISETKNtGAz9FetS9OvVJC_CAFcsiC4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BaYOatmi3Teyhq0IAZOZFeDfXQLmf4QCAAyeBmUkO7Q&oe=6A0DCBE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYvQ8D0dYJEQ7kNvwH3Lych&_nc_oc=AdoMmfdf14wv4m2th9U9dDXQPXxJ3zyA6x6vBgnsGYoPs4joNnDFstFyGzABNoa7Y8Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DbPAV7Heq2Py25RgGHj6yscrI5C71M_8Vv1S7lBR9uw&oe=6A0DC197"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sV2qPs3uqnQQ7kNvwGpfbqe&_nc_oc=AdpwfQjs0-jAU0M7oi2rABj6eOYKZ9Pf9c85Z_D3EQbpbRkZDn0zzMUjBB8Ixbdi-z0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Uthh_WAkMf3fwtIFR4IrqZyvFmYJ8UK16GxhYQWwjXg&oe=6A0DB0B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sMm7oM5CZoUQ7kNvwHslQfP&_nc_oc=AdpXhG8_F5HG0UHNSg9wp4Bg4O55hpjxBnNKOtuX3MKzwRJD_Rfo9UsnlINdL1gpFWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af785SXEf
=7f20f&oh=00_Af6-EIa8v9x005lJJ0hJ0Ol7M-vWpE9fYGnH7cGhiRs-qw&oe=6A1D9E7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rd5S1j-ZqDkQ7kNvwHXSafE&_nc_oc=AdrygbLXg-WGJArUbOyAluaP62XknU77Ytmk8YuzxcZH8pUWDuQBldMKotxmLE-1fVI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7hnyAZPp7VFG9_7q-pNOhWtnGSx6-nvUcXHmg0Dse-ag&oe=6A1D8743"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBbnC7x949UQ7kNvwGaiYkT&_nc_oc=AdoOUdbVDwIxOiKRnQH2DNwirc9bBfyvcx2LXnqUhhqb_UpZTZBil_mY-UkV-hpoAAU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af77vAP__68Ij-BnG_fy5XOw54zC7YBV2RX1c1Li4XmPaQ&oe=6A1D79B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaKIVdXroaUQ7kNvwGNAZXR&_nc_oc=AdrvbhDkEbYl37fmC5Y5UOS-emiiYFsu3j6_rTPWmSYjYvnCi3SaWGLDjnI0QsnyLHc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Ag_8HFzoI1dF1wl7WyG1tTSRegV1TDv5e5EkzQDWZMA&oe=6A1D9DE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lveqVS6wNXEQ7kNvwHl3T28&_nc_oc=Adqg2BFOrTDTBh2YkV_D8drWWeqjSJ24eLXeIyxBlZmvvWNSOncjWj3DBp6Jy77A_TM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PDUDcNY0k3bi00E7SaPBgm0kRtRanfziq7y70JThNmg&oe=6A1D9397"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yH9o-P8Sb_YQ7kNvwFvsJRt&_nc_oc=Adpbpz8IhUbtx3mbwuwrDYVKnKicBJqA-EELb8KiK6bn-YZRpTiFG6-8FOgq-AuxGe4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6h4u_bgWKB9QDOuTt4lc6vu6d7AtMpQa25Q9IiLWpJ_A&oe=6A1D82B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGUXQ5YcJj4Q7kNvwHAFzzf&_nc_oc=AdpGFAzgjNchCggo6vQ6O1ZAffXZP9U67Ix_HYPf5kiqXy0nBtxY2-EK2pd_MdeH2I8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6K7HX2M
=7f20f&oh=00_AQKQTw3-swaszsiDW1UftUKpuyn6ZTq3idDB_W8apHqpGg&oe=6ABE757B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lH313L6tVeoQ7kNvwEj_zy9&_nc_oc=AdphAfGojAD3QosOosXLTSYaVL2bfHbVHJifX_BXFBMgSnN7GXs2B-WUVo7EglYiLto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnOMbQ1nQdmSy412kZUJvLArvKJE3T1XvdmXBeSFf5Lw&oe=6ABE5E43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UwhWiXbU48Q7kNvwHkF450&_nc_oc=Adrc365pr2nBY8i_y6A1AuYS8-AyA-p_dsrGGVKO4AI_EN9wHafgEON0GVuT-dgOUts&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI12jBgpTHHZvtHUBovZL9jYVDg3Xpr3O3v0LwJQRUlwA&oe=6ABE88F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYMvpm7Dt6gQ7kNvwEFyg6U&_nc_oc=Adr8aAQIufZdlB0a1Cwv5buf302rUF5_zCKKKr4juWMvGwDZhwyp6K2hBqSLYhUpUck&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuTfEITedU8wngiLT_Fh3DMfD8K6FRWnDwzy1sfV_qCA&oe=6ABE74E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18x9s-Coe9MQ7kNvwGft_OQ&_nc_oc=AdrZDXQ71ghGz2QX_wW7Ha5sUnTDyukl65zKgcu06bS9eC2ofDDD6l4RAseQvRBkdM8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLEVJGa2ZDXxQtTG8BEpZO4FLuGaZHTevTxggajokpyrQ&oe=6ABE6A97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DlRzjAx0oYQ7kNvwFtW9Wq&_nc_oc=AdpkvFwh4pWgFMDINx9U38QTiaDAErWmbBcnOo82bPHgaZlkA5yOEmUtASLQJnABO5o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY6eCj5lZUT8oGK20K93VxDVGXbEyedJQkU6JNBoLqew&oe=6ABE59B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaHXJpzvOFwQ7kNvwEKraNR&_nc_oc=AdqDQAord9Cqqc6fPo8JOUKNMOfELO1g7M83PIg4PrnKqiIDW_DY2UT6BhDuLF9PDnk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLB48ZVL
=7a30f&oh=00_Af1V_XHRYRoB3IsCnSmaCdIWcS3RNtVU82G8VLjAsNrzHw&oe=69D4E3BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atwCpXKWfigQ7kNvwGInXP7&_nc_oc=AdqghIHbjeZIxh_kSCwDF79iZfRQ3LunAZEP4_cWrpNakMrpKGbECIMLYka_CylgBtY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23TW6-OzgAg2MelFE5a-kMiraSddQVoqbKj6_zUkcvrw&oe=69D504C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuyHNiGGkRQQ7kNvwFdGGHE&_nc_oc=Adr07OPKj62_It87ZT9AgqP3-m8wVqf7cKWHS25kbzFwLTGfpuiNU9PhGQVZ-DVAM_Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IitJehI9NacnuM2RwiJaaYbzXpsWsyNeM3g0p0v5jBg&oe=69D4F737"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzMZAArYi-4Q7kNvwGkoJ3A&_nc_oc=Adpq-nYHwZn-FtIjtXXl7KxK0te4yMmv-RsnV0m-ef7cuP5_6Z92YTjslG-Mpdk7wyU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MechXMMSOb8MkRGYUyN-mD0U5TswoFxKNcCYsqMZWPg&oe=69D4E328"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ztrqWubqhQQ7kNvwH3yNpH&_nc_oc=Adq7CnqxcygviOesoiwYhymlMIw3zTIvnVpi-FabvGFEXq_9vrlOTob8cO1sxWSRPeA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2u-MNGNAC4QHDVqXul7qlvTkzsYqrJb7O5nW0axmHAbA&oe=69D51117"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhx9eNp1GOYQ7kNvwEq4YSc&_nc_oc=AdoR6fKxuH3ImhY6IxC53gmMl6hexrw3fjZgb7zwlTNyGJXiidebihdXKlwjl9KcD5U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1deV5eDZkfXg2cwXHfde_0jTt9JjffD5glppOeHswyYw&oe=69D50038"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCEVoYKtnZMQ7kNvwGUoWYL&_nc_oc=Adq9W8hNgT6FpIk2YxXTvtt5qSdmkqYdOaUGCgj8jDI2age4Zzztj_X64MBlt6kCCFg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3X8g0aG
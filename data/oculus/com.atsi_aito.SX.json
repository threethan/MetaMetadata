=7a30f&oh=00_Af2AwK93wHGN20qL8JFJQ_53kWGXAhopIx8MjPSvEHoiaA&oe=69D3923B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atwCpXKWfigQ7kNvwFF3wpF&_nc_oc=Adpfdx2s6de2iF7iWWNg49en8v4ZSYqJ07DMCaKyDlnyOu2XPAnXf0CPJEZPi5UNgYY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3LcwDPX-CT9217suRzIrzRXXYxpXvIrLmEI20CCiHgng&oe=69D3B343"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuyHNiGGkRQQ7kNvwHaoWZE&_nc_oc=AdqP2eX-cGZ_v49O6FbBkX-n0iH3LB0zqtB9KqrUB46bFcHKNxvCPsxokWoJRueSfbU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FUkVla6Y8LLSz8BBZCk-_f0llOdAzstenxDPNawuJLw&oe=69D3A5B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzMZAArYi-4Q7kNvwFOe2g3&_nc_oc=Adrd089poOf4KSACv3Vdp0d4f1mpvIgpd5sPStndP19wezq9PZwPt0Jb_38gf0nmHGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2z0hnL_n5XYGCGhFC8kUzjQqToTf55ZrxgcETDI4Gizg&oe=69D391A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ztrqWubqhQQ7kNvwHsFA1E&_nc_oc=AdqPQ805A2A70TB-WxMVf_OSxHjLsep9JWPEmqxIofYIIhnLr_EDDjo72BDRDT4PnRs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3E8wDSuXWYagBKNOurle2RchKybmVzTWMCyBBljDDnQA&oe=69D3BF97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IisVchkNgt8Q7kNvwF1dQY-&_nc_oc=Adqy9j5VfjUExiz0M7PMN-p6J90GU9FFIh6pPaMQ_f2ts7ntYR3A1RG8onzjvJkYb8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-ObpGqDOO64RUiGVkzFZXSR2ZhyvRYqpJpIAeYcLOeQ&oe=69D3AEB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCEVoYKtnZMQ7kNvwHU5qy4&_nc_oc=AdoPSIV1oucfmO1S9G2HKCHncVCu5869-crf78zC0ymDPx3LLPc9H1pFUNTKS0F9Kfc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24IXSOZ
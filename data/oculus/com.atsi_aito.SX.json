=7a30f&oh=00_Af3nkVXkJwPxahud1chUEaZj04hwjYiqVr_GBiCb6QtwHw&oe=69D7BEFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBPXEbeaWdkQ7kNvwFxwgvu&_nc_oc=AdodpUB5GmQcRhdnPoywt1EvF4MwJhrnrQs-99T61VW9x8rwXP_CkxqvSxz5UxfZG2g&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2epNv9yrI86IvWeULRMCikfEMmdMaPhat8XCj15gVUww&oe=69D7A7C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3RfHdZbZh4Q7kNvwFn3_Rp&_nc_oc=AdoSxYb0-WkvoaasvImygFdYfGKeUN2dBBvtYo3_urJ2YtGSumEhalt6H96VmK9cJ9E&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rvHs6S3aoSPNHI4zylhuf61Z9S1cYpzVlcPMbwVvrEQ&oe=69D79A37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRP5-bfGOckQ7kNvwFPIa0k&_nc_oc=AdoYB2pTwBUpNsMhpub_mkvQ-fn6K84aohhRdPqMWP5Q_8TzU5JHmRFMtzgaAtLuE_k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0odKrYvUMfOu4yyPYgK8Lxp3izWqFB_jSvBT5lb6p1hg&oe=69D7BE68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnHyl80fa4oQ7kNvwG46DIT&_nc_oc=Adrmj1snDfYhaOc0mpQdvFQZ-ARDsFaq0TmnTVvNkKI4XJdzkCGcch98H_GT57UZ0YY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NS5RnyK0rlfUZ65voW-niTjNvlCXflSWAPbf396V4vg&oe=69D7B417"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhx9eNp1GOYQ7kNvwHZP0bW&_nc_oc=AdpOlpLkT8TpOdxXFUZ8uJ9L6Wwlya2c3Q-MGSYDBQpvligdaEF39fZdoxyucsfdyPk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KndCHM3BMH5enS6IzMFJCNSWnDL95vm3F1nGVuITI9g&oe=69D7A338"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiN2EQ-umVwQ7kNvwEUjZwJ&_nc_oc=AdpN_B72TvVt0K25Aw7P4pCWVzW4iyeU0kzC8wmzPKB2bQLb7lLR_p95tl0FWXthzcM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W1XU6A
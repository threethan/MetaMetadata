=7f20f&oh=00_AQNiHWWbNwTxBBHBNcmeTttWaBwaAOhQnIrt3gz71y5qvA&oe=6ADE197B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_4NxGqoVY8Q7kNvwFCIGKZ&_nc_oc=AdqoVI4THIVofFAezFJiwfbOkpnSGQBrSVs8JkrzlW6F6ZXWQ3zWUJXq6ON6crEw5SA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPK1Pf9VEW9jiukk-68iirNlliGcyuGJ0lgVLwIv1lIVQ&oe=6ADE0243"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K15PESOXqgYQ7kNvwGRs7Bs&_nc_oc=AdqBkjE_zTWUNPU84W9NER2q-W_1AaOdcnvIFu8v0e9arUzNB5zxYHLx9qEDeiSxntE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2OZRXVXOH5WeZb0MpQwDzZLcqmndzvOAwZ-ow7oUFNQ&oe=6ADDF4B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6cM0QpIm_wQ7kNvwFIIyan&_nc_oc=Adrn7fYdvXr4vgFLWQtfCSbrqMFIalUP8d8KLZKh1QFmImwcZZYaKY4zSwyWsY6pg40&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNGhgjiszze2crQ_D5EnDVLwIzOy6365PZFEFLYtKf6A&oe=6ADE18E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QGUmhzf-RFEQ7kNvwHAg8tt&_nc_oc=Adoa6yDG40pEuDlY3Y_BNaliDRcoh_4sFfVMbM7_oGE9BME3y1XiK97blwM3sGPh738&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM4HQ3m0nML5eoquqzHgYx0Cme7PLVXYJ8TVoo8HfbjzA&oe=6ADE0E97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sASx4bETDSsQ7kNvwHAb37I&_nc_oc=AdpcNiFxlDxUC4DOYmV3FPj0gwScglz_Dcy0eliEv7XlRHBefq5U8IUjm-mHu-xsvhI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOaRkyIxQrkX8_UzjUIbsRHjewwD-8AA-gw4mV6_V3qtg&oe=6ADDFDB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AocQ9Y0S870Q7kNvwE3v40p&_nc_oc=Adovu4A1Ao-dmbWFVYojfvIufQBDv4BmYgY21dfO4wV4T2TUgAX8StCC5X0ceGSapgo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONBajRB
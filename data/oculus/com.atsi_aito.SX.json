=7f20f&oh=00_Af4eQEboTiguBOU1i7624RUmuJrU-L9SFoE1MxRhSJQaGQ&oe=6A0C7AFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F_90oTNzrhwQ7kNvwHbd1F0&_nc_oc=Adr2GCBMetjcVHS7FwkAycwCpbTBbS0fUJJe3gu0BEydEAaqbUX9raGN9562HWwJhF4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yOOSQn_DALeW7UMiLAqW7XGu-96hAOlaYwHjw1thRkg&oe=6A0C63C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yJUJvbhCxFAQ7kNvwEvXLIK&_nc_oc=AdqWPFVRG6bTsDd6iUThwdVjP-A39ilJ9dTTDp2IdvOVTD_eFAS9GtOR_ZeXQogssbc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gvaR82tzLNwaHuPSPa_siKaAxFK7O-ODSKWgV4jonqw&oe=6A0C5637"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyPurZghYbkQ7kNvwF13Ln3&_nc_oc=Adp_CCi11pS4Cf1xiY-85mXnP4ul32otNciYBJUxFKNTNKm9DJSuNXPZiwWTGXcO7Os&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7_dFyCOgu9tXuZeNsS7eXwg3oxtK3ufCk-Xe2OM1YbvA&oe=6A0C7A68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYvQ8D0dYJEQ7kNvwGLGFsL&_nc_oc=AdqBiW2tO74AVukayMFRhn8kSqaJP31QHEOk5-HqB0MaNBYcHaTebF3jnwQjP-nvfbk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uWX9Bv6EqUB5Lyw97ghybivOwJjf2wAjfU3frT4VAWw&oe=6A0C7017"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sV2qPs3uqnQQ7kNvwG5LCxS&_nc_oc=AdrUMkknBxSRSfPVUet5bjO2IaS04eluBiyuUSGuF_rUpL0l5eFsOzcKsFVjvjygEVE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cfpRspS5m6cGlpavsH1x4SofP6StVuOspuNBt6Xg9bA&oe=6A0C5F38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=um1ad1wWOloQ7kNvwGsuv9g&_nc_oc=AdoZkJ6FX_XGAd9HKH0HDLjBoHipSMSsQNwI1zRobOf7pthmW-ypY7Fb6-YI2-2FkUA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68Rzroh
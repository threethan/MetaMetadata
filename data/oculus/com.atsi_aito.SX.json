=7f20f&oh=00_AQLRVdIIk4qI-qaz4JtXZ1eiXCAzMoaJIuMF9x2g9luuVw&oe=6ABBD27B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufc-suC_ZCoQ7kNvwEN0DJI&_nc_oc=Adr6sFzMMligZuVqF8TK2IzRfYmvB5IG0ZQath2xOcVlcmLbOGjK49wQjuSm8S9srHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuBdd_FFbpMyaLvcY-gdBnoaoEkEjJtu0qA2pW-d6vkw&oe=6ABBBB43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t20qTUhdm2wQ7kNvwFQxQH1&_nc_oc=Ado5EOja0ALciLfRKdxK4gRt1iQ1wncsVFsB7sttFfQ6c1u7gk_jv8aoyKc2fPT2fco&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKChKjFAkadslmW2f1jMmuKdYHA_P9_p9dNdHjmtLcBag&oe=6ABBE5F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9Qu1iw83BQQ7kNvwGNMmU3&_nc_oc=AdoEA0QWYOEBqS7L4GjG4KEsGTJS1O3VisYAPo7XZY6i8Vnu_UxuNmwFChcNy6rNkls&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKl7xl99Sf865rNK3mco4mWEiY8TcYaaHeevkg6VCkJKw&oe=6ABBD1E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GI_pu1THqMQ7kNvwGidEVy&_nc_oc=Ado5KW8-97e5V3tkHPo4djyNv9TlNYceDS63V0Eqd2TD2JM5NcW04JsTHM8LHPkeVbA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI48ScE1x-7NJg_ffkMyTdkrXNyHT0JwTiJybaFRZ9qFA&oe=6ABBC797"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZ5UfqQcEj4Q7kNvwELJEz9&_nc_oc=AdpfQl80rswYZFvyp_MK7kIxtTk7-2JHYToArtwP0OiDb-swb5AGgUMqo8wzJodfIbw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJf7kB1-ryHN33YfabUGq7w1x-yBGXzWqL-7cj20hcnZQ&oe=6ABBB6B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KaHXJpzvOFwQ7kNvwFNZGi7&_nc_oc=AdoR3VJxSy0dr1uGDwJvGIBDEd6lnTppp96HQgINKAdT_ZykWO3wPMAmHrn5u2q_vwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwrWgnv
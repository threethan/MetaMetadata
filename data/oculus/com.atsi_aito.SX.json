=7f20f&oh=00_Af_weu9BD4XLe0c4AyXD9d9Nx3nHsV_S7wMhdsYiwdzsZQ&oe=6A2C1EFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSFLlTB76kUQ7kNvwEIpNyN&_nc_oc=Adpon_vOYVUN4_l7gqZnHsQdFLYtdxxwR1BUeCYWmGC66og6aIzy82PrbCa7D_CePDc&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_1nO4v47iPUC3eldYx5CQuZ45DvOyiicHmy9RMYWj_Ug&oe=6A2C07C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v0hlrozd4UcQ7kNvwEonZQG&_nc_oc=AdoKgsjL8zfB6lq7Z08eDlsWGbZkW_mFZePJaNvss8qXdsgoKfHWlgxplvODIrgBA54&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ndWIYlMCTV8wcZX0AhOZHhhQ4NV9T0Bo9nAkJ6C-CZw&oe=6A2C3277"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbVk3bikojgQ7kNvwGti2gY&_nc_oc=Ado75n3yq5FeiZ6iE2Zk7WJ-aSqa6SlENTAMZMHSvbmwNXm7Ohpj3VScivAe0uyOQys&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xYtBwzH29PmbzYchEzaNWFXzwuNkhuCE_QwxcfJRbPg&oe=6A2C1E68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3D6HvJIxBPoQ7kNvwHYzNWD&_nc_oc=Adr0-s3sEm2enpHKYGawnD2d0TeUk-WdPTgVEkRcvLtHEZh_NyDMiKLi9MzBAEg4BO4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80XoWl-Bn9-Z4Av2aVaxKF-2ghONBCcbFTowPAMEr8Jg&oe=6A2C1417"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iDQYhXDCaQUQ7kNvwHVYOP1&_nc_oc=AdrAKFDCkhnER0zEUTG4EqZ_EGf_AC6hbNKrDThQ_sNN414gNmaz3iDQmWWcLXuAyEg&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UbzEoWHxUmwbQCQ8wWkYECo8ccRwve3Kx-T4YFrc35w&oe=6A2C0338"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zq1MCNlJYoQ7kNvwFIdDlr&_nc_oc=AdrHgnylbgvlsda8TfoX4U4_8OHPTMaH7z1liW5iUoEpw8AqmA7-irCpWux3z5NXYIU&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9zsHvRa
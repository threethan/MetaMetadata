=7f20f&oh=00_AQTHyPiQtA4iq1Xa4QIQpHoPfRhTTDmPaWRX1t9IIxdUog&oe=6AEF3CFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xU0mB5LVg8Q7kNvwH5-S6x&_nc_oc=AdpRfBvjL0EmA-rdvzfgOq2ZfUsFAe1E_1f3QZswJWH42tcMnIJ3bLnBQXXyhW9eTSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTH61eOzLVZbbabZIs6QPYYHIv2ss2pYfUKqvjdzuP65Q&oe=6AEF5E03"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbvSAy8p-1wQ7kNvwGxurt_&_nc_oc=Adr7sVr6WUjgrwXn9vZ58eHzI3s-1mWk6GmGNP8RSZ5B-LSV8XfO97vqg7AjUO5HxSQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY2gB9_cWcYdkhSMpB2hue78mW2v54nyNKEUYYFGZr4A&oe=6AEF5077"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tkm4_3JcpcQ7kNvwFFfSm6&_nc_oc=Adqo5QrQp5ip417j8ejY2AHOSRMXCHOMqJGMccj6qhExHoTlkVvdcGSdqzYvsry8VeQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQBEhsCckrryPiD53oDm04L_6N17ThQ3IQKhcZrij30LA&oe=6AEF3C68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFF46Y8pcQgQ7kNvwGpKZ5W&_nc_oc=AdqCGDUmFprCzpfE66hth_JBcW67hQSMQEC_lBG62zswEVFGcRfnT7QJblptFHdHYu8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjJvJSEHsz_22kSxIdIo8aqh9qb53GUior5SHUIspJWA&oe=6AEF3217"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cc1ESsAsJx8Q7kNvwFN-IZi&_nc_oc=Adri_I5mpVTF9IKKegLY4KJhhUqRUzaxlycHHHsvE2N47cj-8VQKuMHHrz4JWC-Vxeo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8d7Asr4NDDDGwNpmvMHP3cpT7v6sNIjERAQHwtOnKuQ&oe=6AEF5978"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o41OYiWxW3gQ7kNvwGmpudN&_nc_oc=AdpSHHYH5Ne8PPe9O4t4t4HgCeanjvEKwnKxw2sCa9oFv8Spt5m1WdMMW7QvZcTI2gI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTK2Sgjc
=7f20f&oh=00_Af4sLjfC43-nQXrQxBPyiXbROeVmu_SktuVEgHSeyx09Pw&oe=6A13127B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g72AfwMCcdEQ7kNvwGpqO5A&_nc_oc=Adp1G17oEiaF3glxfS7Zdu1ji3qsT3c8ytm6l-oGeJ_Fjc4wBc1h68MrTSy8IaofW6k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rDnn9V5lJAZr7TBYxtGFsjoSqwCFEDODWW56-wvD61g&oe=6A12FB43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKce9WPc8OAQ7kNvwEOA7MH&_nc_oc=Adr8Sepu3aoNVKWiYichz2f5nP40g6wUik3glXHR_vNKuTSJ7zX0zWIjWaK4c96CwJw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l8fHmdnibs_Oobitdc9vXIx8ORn-R_vMzwA322qZOKA&oe=6A12EDB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gNpWdDo5SMQ7kNvwHxZWUQ&_nc_oc=AdouQrYbW3ERPisxMk3bDnE6dQaBmj8VeNCZrVNQn_sQYdxafR4N5FnFhA6VomKMzvI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ubUbyWKJ7eotIZVFDDJnYr80pHrEREKuvHEpwUivMLQ&oe=6A1311E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ToH6qRdyhAUQ7kNvwGjsusN&_nc_oc=AdpCIkF0PpZblt6JSPxBB-dMLlsXQwBosymM6631fH665G2EXaviOyo0FB72IbnDGlg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af49GRfk5zebcPglO7DpEmhssQgiLFMh1WRoq2tbxsNt4A&oe=6A130797"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8wpTIcmkvkQ7kNvwE5C3DG&_nc_oc=AdrVgO4EPcxHoBMBohlbLcZHIyETePVwaqDQ3PKG5gEobI4WQpYsVAgk-wzEbno6EkA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XXol7K2mlrTwsuvcEGg-97zHy_qt4LPVUpcMMU81UZA&oe=6A12F6B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJRE6hnagp4Q7kNvwE7nd5K&_nc_oc=AdqUzo9D1M58tLAtSf2tAcl1t1tTSOuhQkIu7slysIyQoqGHK7TEouoyoIAW0mdIu_Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RpIMed
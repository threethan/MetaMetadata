=7a30f&oh=00_AfyWxmOY3EFAWzfO9Xp_S7BjgdU86yKCQWM96rnWvzlxUQ&oe=69C7B4BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh_1YBy6FsUQ7kNvwGWs1if&_nc_oc=Adrtf1z2ieFBRquLEoVzaE0tzWsj9z1OlMjcfYU2AnHemLkwf_opBvDuZL1rWasrsds&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyn84Ce0r1s-1YMw88-j30Egmyk-YNV93CCAvl7HPROlA&oe=69C7D5C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dSzDtAADxIQ7kNvwH-zm45&_nc_oc=Adosrhl4XuAy5sbWd8OM3Nih6cu4zfIT1-sTIjJwSJzp-VFFH27LXQKgQqLCGW4AQOc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCKLpJgtz5IofkpPSxcVI1IUhEqy80BLIfGPGJ-IBgaQ&oe=69C7C837"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zycj4O44q8Q7kNvwF-Z4LB&_nc_oc=Adp3cZuuZXK61-sUFERPRMOJ2FuKDWNZa3Nw2hdK4ddcya1iemCDw1AvmqF37E10ZwA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxyTrEnagNxNK7YZ1uaSSMQgXjLQIxazYs7dtP7e7Mv1A&oe=69C7B428"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ii7pSU99HEUQ7kNvwFl9Okx&_nc_oc=AdomrBA96r-ldw-aNxIjpl1shwWliyEjff1ZTH27zXdYkiSZMvkglkgRK-BzVg8nsvc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy10x0-1AOY4RmRTypq7QUPjv2I-tVi6s6Av66FR_IC7w&oe=69C7E217"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXn56CAFJyIQ7kNvwHQaB5_&_nc_oc=AdpUinmiqKv6Ts-LNjsVkLRp_m0pZ2dp6V8d1kUAH_1UnIgR2wUDYfTVwhJpqqbS748&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyaCbOvbkLVGkzRInkyfGqEwj5_N1FTKyGE-Oe4g-JLWQ&oe=69C7D138"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALusMMnwEcAQ7kNvwGGVoTW&_nc_oc=AdoXkSuIIGz018aCPrN09VFS79EOMJ01PEQrbp5FP4UK7wLTq2BIg5PAMl2aywLbsko&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_U8x7K
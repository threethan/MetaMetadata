m&_nc_ss=7f20f&oh=00_AQIgrhf1hiDPkEwnCfyDalAW-v4GjshYwrfYP6Px0K80VA&oe=6AA95D7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oapx88V3eWgQ7kNvwHIBCZf&_nc_oc=Adpw8CI7t26YBfD1wK0xO9V_CCXhr4qP2tx6EAPNbE6mIV6hlcop0mVueXS-0BSAmW8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIH8c7wrt2bhHiI90-KNIpEBFugQM1TVB69_71orT-82w&oe=6AA94643"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k9jaB6zRW58Q7kNvwGJ92pq&_nc_oc=AdqTAU9_F-aRa5pHf5tMW1uNZnm0sn3mHZdpyDvlT6FJKmIiSFWUWBCAi0lQiJ8Dd0Q&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrSlKPa-_TRzNNhLSVk6yaGkjRmTTl_euOPgIS5Km7Hg&oe=6AA938B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3YUCdkaU6AQ7kNvwE1ywBK&_nc_oc=Adqc6ANN8MGskIkGZ3IEgLTcol_wR95h0fQXy_Ef6C2kxrR8WYmUUBd6nR3hsHRhz4Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV7gtABmiXNvDlpzWsgEMvvfD6qzix9pjY_c8StOyLUA&oe=6AA95CE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1NwUQlG5aoQ7kNvwFGeOn4&_nc_oc=AdruqH3M8u-SSxrigbIFA2i-i2UUR8fTPHpgGUuy8Z3SYgA2_WWdz5K8VqeGmb6IMdI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpveZ6kk_0EAd_zHBXgLpMdofy-nSZ-iD6WDpZQ-1cmw&oe=6AA95297"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-WXrwyD3XkQ7kNvwFMbutn&_nc_oc=Adq6FdjWvZwkA0IeU_5vH_2g79K0d9lZ65zfI9P9RDuxf8FwV59Sh4G8J4Fu3sXbP8w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKa8f1hLt5Jxg2mXo5mqoprudn9mxNRDzbBNNbmGBWUg&oe=6AA941B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHUjVEzCDhsQ7kNvwGAP8oS&_nc_oc=Adrf9bRCEn7loJKm8oYCs5jOM9k6-IyXA2mwm4BWChADEdCF3tKoLSAfinld90U6R9M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=
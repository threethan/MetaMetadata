=7f20f&oh=00_AQOu5-AnUW9wwPKApH2t63FSR4rjmfymFpb0OkrdmH1ZrA&oe=6AC9017B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsydbr0XzuUQ7kNvwHkT6yS&_nc_oc=AdobS3nqHYycT1FJU4q1ClY513TXLUkDra0zpkpU2e24tmE49eYa2DjxGVav14bmaf8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3fMR6MBIRudD6DGTC9NXC4PkxS6GvcUiQWTrd8ux4tA&oe=6AC8EA43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLmc-LaDw_EQ7kNvwEKK281&_nc_oc=AdrdGqc6cUwKP6pMgzkHxV278Qt4b5v-QyicoENbUralFsP2IM6R5d8c61lvMwe8OWs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOHV4X3wjw2QCBMhbEwgNDok3UK2L6YGFgE4BluRoFbQA&oe=6AC914F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rfYkPR1UhAQ7kNvwH0BWm7&_nc_oc=AdoeIoLzffah3JO3qtQ3efXL0JQMxcocAzbT256ks79dFdldaTRrn2y-RjLolGmc1M4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLGlXxJ7jVsUgx-WoW99wT1gnzhOdIeMrCnL6NxXUDXQ&oe=6AC900E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLI8kzZ9Gi0Q7kNvwGeq7Nt&_nc_oc=AdoGQEAZDXn44d6Xyg09IfcKqIA3E3iXjU_TiQTdOoGbaIGNQhLzcBvJMk1IJ_naymA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCPqYYuVbIuWH92P74gVIV2AZThoTPJ8I3nNulezMxlA&oe=6AC8F697"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afafLPNAPHIQ7kNvwGjRifc&_nc_oc=AdqUKbqGwOVe0D-h8YJmhdAk0q2cdHvNwQXQz2pwxCgjUC8aOWives6FL5qcCkguFyg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlklbn57eGLGbZRrg_47cJOu9AovKVsA8PDugEbCjS6Q&oe=6AC91DF8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKQUnahoZIoQ7kNvwEQEfzn&_nc_oc=AdrJAZREpy5K6dwNndR43S1DicnV5EqsVehdrbCkYxzcGCoXD1oD4rCpTE5qNsDRNnA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_Mdhgh
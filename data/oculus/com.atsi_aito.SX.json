=7f20f&oh=00_AQAzHOQu8KQT-a8g_S97YgkRO9AAXDXKKaH5B4sHHEMyCg&oe=6A622C7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnT3nmrPdPYQ7kNvwEebO4T&_nc_oc=AdpZXFHFqYl-d0Z5ITNQJczIWA6dFeYfdyRctSaG9wKCwzGGmmHjenmfceBQdxUZPAo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0CQ7GTgH3L1NIeeeg286dp1X_BlWJABM0GcV_uvRhCQ&oe=6A621543"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xohyCI1QP6EQ7kNvwEPp4JE&_nc_oc=AdrlVHbHrp2H-vvRcof4HZwaHpqrNwk7RdbO7ZDcB1qwlm4rd-VwvsQUwqXLFOh6e5s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2qHZt3U1NPtg3Dy1_cWp39HLE0sY-mP6wXxzzKtnelw&oe=6A6207B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgMDQL-ypAsQ7kNvwF2VEx8&_nc_oc=Adr8qQV6GoOQM381pccmPeNdr0sYgCmLlYWRG-4ozilzhTgGTt6K9zyWW64YKZTCCe8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0DCAkao5yqDwa9TArgaFsY5Ip-Hob1MO35XAgcJHEzg&oe=6A622BE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRGX5Sbo43QQ7kNvwF7HDxU&_nc_oc=Ado2zx-V1YbMNb4Ytb0nOV9AcJ6XFLxspRN73E9Y_zaudplaiHRDKXFWdZ-iYfBcE1g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBP9XsN0nQ6Tr7eoUGFgeI642zx5kIN3hnOlufL14qaaw&oe=6A622197"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8b228A1SnkQ7kNvwFz5WKv&_nc_oc=AdoPSUqlPSuSituIJapqjpAg7qGNTuVGKMzJ06jHCTbFXCYeTWbzKaWisDT9TFczxGI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAs-02TUvDm1lpvEj9C3ivEdP9nyhgo5FgAvx1WCvJ0Hw&oe=6A6210B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlnDh9CzamEQ7kNvwHYJc0L&_nc_oc=Ado7XIUcbq_s1kNtewhiMK_Q_CzM9U23O_C62s9EGsbl7jXCW_oXmbPMY6shg2ZPfy4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdouPG5
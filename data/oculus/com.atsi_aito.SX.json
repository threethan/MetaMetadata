=7a30f&oh=00_AfzmNXNepMucTq9erM3oabpQPYzz9-md_0B4il6PkXmUgg&oe=69C26EBB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DV_LGuJL6dIQ7kNvwGTzO0A&_nc_oc=AdrC7o4kVCjNmhX5C60ETmEULmCkRPV5z0PHgRkCLGsxTEGhFgqiGhyYCYn0BY5pqxs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3iK03QuhxkoFPpLdznkUkhT406URjsAAlI04mYJybXg&oe=69C28FC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YnYQrra1G7kQ7kNvwFqK2Lr&_nc_oc=AdqDn16qWafhy_bO9fpjfKeIYicMIokjuP9Vr5Ist1TB7X1f97JebmoEbHnZM_uCKgU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwHfv-FzBBA3mHYhSb5xLb6I-aGsMv5uPd2ag0xusfC-g&oe=69C28237"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9j47FLth4EQ7kNvwEuKVL5&_nc_oc=Adr3VYBjtt9J1clWcJDHrhD8GY-siMOtaImMM71slyGhKX3j8Or8iLV0UN7FPIkOl-o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw6eONAiynqlsSaIS8ZeyqoCG50hCtAiySRM1Po8jfdZw&oe=69C26E28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yqsWpfetvi0Q7kNvwFD4RJy&_nc_oc=AdqVdM9FIlwtTFaXwK4lYGi8TNDUw3hwK6m7qAPloB87Bw1G1s_L6DT5_1hZX0Hw_0g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPf0izhle8fo9PO2vORkRkdh-0jLz6keUW6olgovBP-g&oe=69C29C17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F9pxiu739NcQ7kNvwG5voU8&_nc_oc=AdpccVRoGD4AXdVdnXql4W_qe4MF9hdAStQul1575AgTzmtBQ8Sa3uTDHJDWdM_7-ys&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2bFrrq52LwCxeVHcbpJZ24wfNbaqgUlLMuhStFeh7XA&oe=69C28B38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDqDkhZG9JUQ7kNvwH9hSER&_nc_oc=AdqvFkX4BwNj4-w7tLNdsHN_hHkZnyOk3qKZt11F_ADvm71Nd6pC1zXSPNbouHD0BLw&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEM91Ks
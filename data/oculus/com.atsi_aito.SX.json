=7a30f&oh=00_AfxwViqf1XX82NEGLlioaPa_FaPQ-DeVvSFnwiADKcm_Vw&oe=69CBA93B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eT2tMXT1lgYQ7kNvwH3gjnP&_nc_oc=AdrsqnBHrkZ4kjQQri_erV1Za1RULL7HRKHYpfrbUcu_mtqbnCKIDMXLu9gLGnouufw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxh-aN4QGPILms6cyHSn9v5PbHSnkLS-x97XEKRKb7_7Q&oe=69CBCA43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3ty0M-bC1UQ7kNvwH9Za48&_nc_oc=Adqdk6F4fkE3bsPPJavi7jGZq68XMy61s78KxUhS3nO4mk038aJOH9rIJtQamQDzNB8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZM-kQMtf8haCXMlFZb55nZP0yI3ydkPd-bOlcnQI5YA&oe=69CBBCB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMuhpZp8xooQ7kNvwHXVdfK&_nc_oc=AdrQsIgprofeK8lrvuN0g-szloaLPJ9tA1fxVkwztJOsYBNdXv60mF3bNsF2WTAj4IQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwifhEHmqg0Ehj554BlMX5Mxx0UJwqrTTzYS5TGP8S0CQ&oe=69CBA8A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvluIM1oJ1QQ7kNvwEoNchm&_nc_oc=AdoK85m1DCjojBdFIh5WMy4vRdT5cceEuVV2XijxDIng2Xo7t-bVpXcvVs1TQIhI-9g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwdeQ_P6kpsXZat309DBvIclctcE-U9lCuqOrMMw7EUKA&oe=69CBD697"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E2tVTm_QinQQ7kNvwH8xBvF&_nc_oc=AdrA05eo93ScA9VjH-3OiDAQcOjPajBFOEkuHgKYRwBo0GPBVrbdlGGlN6QC-cWYEfs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxrc2VHMUs9gEA9BnIiHeApi-xkH_F2r3gIjLNB1o6NDg&oe=69CBC5B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7iIKu6AlRoQ7kNvwGUY0kK&_nc_oc=AdpMegG0PYloOZMQkhDKovc2M8wDq5RMXEDmNj87N-SBPY4XR-7tSayeZECqzeQ51Bg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjCebGx
=7a30f&oh=00_Af1Tipg6oEJpcRDC5Iw2eHFdhjgjLlNaxYvg0xWPpjn0RQ&oe=69DB7B3B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maepw6uxia8Q7kNvwEqlo20&_nc_oc=AdpM8_4bvi488jog5wcn2ggaEsWVnAoCmgfp0zKPCseXn5IwFOVf_1TQIAPNW4HiJNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02t9KtmJdhM_zat4lOV5Xw95I1s1kBgFohZY-pMvtkZA&oe=69DB9C43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cx06x35C2qIQ7kNvwEeADOD&_nc_oc=AdrcT8TFvd8X45tvY7dLbfih42O1OsG_611aEyA9WQHWcLONe9UPzFex_g5j3Tz17Qg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23V01ZSZkEssd1WOAXo4WAH9RxkiZjWB5kRagD7K9OGg&oe=69DB8EB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WfrpZA5tS98Q7kNvwFH_YqP&_nc_oc=Adps1h9Ks7cPySCBamFdinGvove3bcQIb2-vopBx_ouNnWRs08omGqpV2Y18ftK2xpw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R77VKYjQhMMImDaRDPxLlRE2kC7kzJLQCXvfeGoBg6g&oe=69DB7AA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7RSd09lBVG0Q7kNvwGupPB9&_nc_oc=AdpOKTig4_AXaW5t-B2iEhJTVfPnHsWhqHbYFcdv5dQp5MtJSbBmhqj9ZYAx-uy2anE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mog2L5SamzCmBkNC6S0tlNz-bzis3BJDygU-7nzxdyg&oe=69DBA897"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRz4im9SAAoQ7kNvwF5j5qC&_nc_oc=Adqqt5LthtABcAvfDbGlYwY1UW_KEaSDIEmkicOEwRO2tBi_Q3CRK-hsmq-JXlyzawg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dIOnfvA6H_uBSHU7gU8dpvXohtZ4RD0iq5qr1MpcghA&oe=69DB97B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ohTvcGOpf0Q7kNvwGqer4V&_nc_oc=AdqM17qGtvi9sRkebmBMToTe9nfCnRyPeN49wLBJf25LwybuOpjPPIZRja2QYLJmrg0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_1FbST
m&_nc_ss=7f20f&oh=00_Af9iZVvnP1pSm5ISVUjiI1QNIKTSTgo0Fo_zxWie0B_7uQ&oe=6A36AAFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrv8_AH0hd8Q7kNvwGDgiOv&_nc_oc=Adpt6WMWSVpIOXEA_hGEmpHalZPOmZXU3T61iMxBNkIYTp54m414od9IdkuQ3aWgqGQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PoI4UzH9V4NINwsNSJkKoFvVfhKWT_CZKAobrWsyzOQ&oe=6A3693C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQFc8xSctkMQ7kNvwEc3_oS&_nc_oc=AdpuY73PVY3gGWK0I0Cof6ucpROkNZBsgWYrF-0zBDWcmyCbLydhXmhESHe51Fue3eg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8q0dRzlGOwhSz0Rw6Z5Pj4SZHWJ3Uuxpw6pBaSud7kvA&oe=6A36BE77"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNayoN6MzncQ7kNvwEObzPa&_nc_oc=Adq8IMis3w4Khtjusil-M1ulP71R7_woQV2mgJwSVvaKtRC78Vb7ZcDhLPAXBGAqYyM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_A6zC1rsxMIW0jQIuro7yKlKcVtKOHhNLq6XQv6hy6KA&oe=6A36AA68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sfb8n8Hm7IsQ7kNvwEJdV0s&_nc_oc=AdrH4_jSz2zH3uWyPef3yCqSkTlfif14OF35gs9dQxlLlJ27njwshT66Mf281_bKt1I&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I0z6Bkbfbfv3vDq_emSWc1gQyjy1mIU8gbSBwy3_Obg&oe=6A36A017"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhdSA0Kbe-cQ7kNvwFPAEbG&_nc_oc=AdofDyAxjAfzOLyr-IlZOrbBSi3Lv82WpkLZAaOGpOrpjNRBsqIGIhZQAh0xCUQfab8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ygnIBFGrsQGPzmDqtKgCJECRUrkNyrSWS7FNNZ2Q8qw&oe=6A368F38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIKqmjmSvB4Q7kNvwHAUUa8&_nc_oc=AdrjAdE9AtTlsxX69a4tk7nPccoKASIFep74_RAc3Vl1scbiKnlhA0OqALn72wwhzCo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=
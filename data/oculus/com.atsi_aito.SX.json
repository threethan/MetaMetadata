m&_nc_ss=7f20f&oh=00_AQI7YCPy0UCLpH45lAw-whanIFlxTM0oqOEKEqEcCNmnhw&oe=6AAEA37B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiDflnVuxn4Q7kNvwHli3uS&_nc_oc=Adq3ghp7Jvvuu08eCS1WvIISR7Wjbf_R4SoO5XTHv2z-fBrFnO2uh0uqeLGQbvbR-NA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAhbT7pJ5zRwx7X8XT5r1UinXsPWYhztZko8TeRm3vCQ&oe=6AAE8C43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hI_1XZHOIqsQ7kNvwGI5kpH&_nc_oc=AdqxH8JJ8JncePJ2CjJJTcSAMaqEl3P_4OolFmLiJAvmiiCGANRaSoytaLv2ZjTDZEU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7phAFmtw5iPEtxUlkWuCRo2soyOYfhRA0CCWvMtrK9g&oe=6AAE7EB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEV8TucplQwQ7kNvwGX2OuN&_nc_oc=AdrxIRFpWIWTM8J1s6xc6RpLsTpr57eNsHmqTnW8iSave_CFn9KzhaTGneHgw6QL8O8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5pkjDkOxLc1CPg1QJ8FlUaKf08JjkUJQhGR3HzOFYFw&oe=6AAEA2E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDK7oAuwqG4Q7kNvwFLrOkT&_nc_oc=Ado0wDSoEX-WJmlnxzhGzlcm-2OUU8811h4j59ZhkgJFntS3V6Vu2BxrDu7JTGhMT3k&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUDRUURybEYiWb9B0EaY2ihi0KloUhhQSww_fTuf2pDw&oe=6AAE9897"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kg_4qHBpaGEQ7kNvwF_Qiga&_nc_oc=Adopd1beXBsiFlln-ATkXm6xdaT6uPpmWUPtJsfvFC56B4VXrICJESTP3bs89H_LzCQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL1dOp49yTsbmE-SqxBov0d4C63SGJT1MgCnaM433OY9g&oe=6AAE87B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_lCn-y2rvwQ7kNvwGrntqF&_nc_oc=Ado7-ndMrEBD_t60eTz7OxdQT67WiQz6KE-O0PfzbqGhcd2MkkZeaTdlZmR1WjKYhzU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=
=7f20f&oh=00_AQAxptPV9GkYUD15CUDqxu4MaJZflPY8AjdIMDUkz55O6Q&oe=6A4A717B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UuS40y_CfMQ7kNvwFTEYei&_nc_oc=Adri6YsmwHvulk3uv3zkqkCMQJM8zOSgoO47iz9yngx8LXBsb_aDmwy3rhZ-9sGnZLA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKcr9HzKeVIcReCRI8MOaN6Ycfi4u0dWZSGblImGoUQg&oe=6A4A5A43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhoKuxo_wyAQ7kNvwHyUyA8&_nc_oc=AdrgyCT5Yqdr3xDh-nA8EBCYJ4q28n8Gge3-uX0k4qxK-cJsY_LpMjP61h5SwmzfzVs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJPxCNC6GJlvRruXOPa8kcfmBCEbX5zE0zQJCX9X07YA&oe=6A4A84F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEh5x27BoXoQ7kNvwGI4q2C&_nc_oc=Adrso3tLX_E_rw-mZ--Rnu7QXRroUzDq2tqTPMVmsHyeUgMG8w_KJNPUgLD6C6AgTzE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFUtoidptQZEgQfiO4JxCpmdm2--oIeclVa4_dFl1vuQ&oe=6A4A70E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcfqBceTFX8Q7kNvwEZ3pEI&_nc_oc=AdrH1tkSv1CWUCnVxZ7PDlE18I0CKIAQvE3oIyPTqWhmTnxQEy4n-Ei3-z4aQ0jwL1g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBxvIy1f0hA8k3M7YHmsHTWfp77OK0yno424R-gPP3W1Q&oe=6A4A6697"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjj80X2n7fsQ7kNvwHB1pKx&_nc_oc=AdrGfAr54FbpGLP3JfPkk0pQaePPcm7XT9ZMe5xQYVScQHvoe2GIx1S3JPOmM5RAhfU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_dAcVTsBNS-jk7LL0mQNGbs8BvSkAF15CkQKeX1My4A&oe=6A4A55B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VChZAeKyIDUQ7kNvwEuMhET&_nc_oc=AdpOwNCW9lkTZKNbDp34BhtstiwW7NYawARVZ8YFu5R-9EPWtzXcZKBXlm-Gf-D1QcE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDehkAmB
=7f20f&oh=00_AQHSjoolA1OhcJLyxdZ2LTOJ6poHG5WnQeb9Ot3B8w96qw&oe=6A89813B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3-oailRK98Q7kNvwGx91OE&_nc_oc=AdoxSUF9xo8hFF5q1nOEbdt8v_e66jVtzAsfB1ZwLhNG_MeZlBnyGzGCj01yLJVa4ro&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFNOkJdSMgb8YKg3kdr0YsLjY8vL1nP-hJfZZzITJiF3w&oe=6A89A243"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UoCPXwr5wJwQ7kNvwFHPzzt&_nc_oc=Adqpu3ZPeFPhNJ3IgPB4lUu_-l8znheOHKLdub3BotMWeODZWnULustb5KhOct550_Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuVNvVJBtXSX6q4Q3xJu_Z6Ikmj7JD16guHy-FWvjSfg&oe=6A8994B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2ZLM4PA6yQYQ7kNvwHSEeXY&_nc_oc=AdoB0j6cwL77DYApRpxPuXn5Tj1XpS0lJmIElqJ-FhOHTmI7rPetWcbl8ogR6gq47pA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIqYY9W3wW5oP0N8_IS_QzwwwLp_zc2FZSD2oeOabr-Q&oe=6A8980A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaMYTyg9L5oQ7kNvwEzkzi_&_nc_oc=AdqnUDSv_opzVT6Jnd3UaAohGcGCoch23iWfi7y4AIUgyz8rU4ckcxSTu2fJMc-xwxU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj57pOv39gqjG0Pi3PmtD-PPDyuBVrTpDritSnxgpfxw&oe=6A897657"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GrsflvBoAHQQ7kNvwGTDlPe&_nc_oc=AdpfgEJvTOR_jDEVwkGZdT5Um2vUkjB1HH-W5rcJ3tEfwco6Jg7iEQidVN9giJvtWdk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHFg0KVOSsLV4sI1K5eje1uj986qZMSeVHtf1Wg0ptD8A&oe=6A899DB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U6NYa2KE_SMQ7kNvwGiAtMS&_nc_oc=AdqJcWO82d1z1bmLVikJicofHwRLfxOdN2-grgYkYSm1Go7sNZ8iRN1tFvmYp1C9JKI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQH6FZn
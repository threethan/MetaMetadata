=7f20f&oh=00_Af9i0e4qrxlTVBt8RyNADR_Hl13LkJCAeg-71ljZFVjR2Q&oe=6A452B7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc3i3HSe_ugQ7kNvwFmBkxt&_nc_oc=AdoWR0Kw4H_i4xKBnXxqZQUDVKFpkmywL6ekdZ9l3oQr27iRU6Lf2bHF3--hodFc58E&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EiR5ZWkcyrL6SUrsTIxnL674GqJLUkL04lsn2MIV6Qg&oe=6A451443"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqzv3j4GhPIQ7kNvwG9I8Kc&_nc_oc=AdrZZ0lDgI_1t7osu7d8634t7XkOyZwqtVL1aEZvurG0Ym2eJvsCuR7Uc96DRvvHmc8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_b4gIGMSxK4J2xStpAY_Y6DDJ0_yRxZISfrkqJL7xTFQ&oe=6A4506B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcG3LbtisoMQ7kNvwFAkhAv&_nc_oc=AdqRdHYMTrf7Nw065tmg8yhA6VRqf48wFCgDZIzvIFebDdVFYhQfy_J04KEJ9SJ4i4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_96ZTXbVuYcw7ESIBkmTvBIoonoWaFyVsWofsEYbpX_A&oe=6A452AE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDvaXmJDg2AQ7kNvwHpaAl2&_nc_oc=AdpUUT6OGvMD3bzaOkDZB8IwJ-zD_NLUETH3g-w8fjj96NyuTbdDU6UrdJifKnM5do4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U7SVUB-RHxVJSU-UjzMTCe1TV9OzkiQ7kOyXyginMHQ&oe=6A452097"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bSOwWhyA9wQ7kNvwEigTh3&_nc_oc=AdopBAOEkhDkNFY-gT7a1MmQI3WFvpKWZ42AHxrZlPRID4G_hfgv8tXNVUGMuyxE_hU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-40-84TLieJ0DbYWiZ9hjO5sSx5KK-M6KOjH5ambKG9Q&oe=6A450FB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiyDFtxflDQQ7kNvwFk6E3q&_nc_oc=AdpfgZGy1e6wd553gKBHN6vT259XThS_WeijlhxD7_G9XwtHR4jP7XVfr8WiOAR_smE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-_F6l-v
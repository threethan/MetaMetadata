=7f20f&oh=00_AQJoXmmfJjEbSBrMPO8z73NI5AMcnasjnwovNmxXHBHTPA&oe=6AB53AFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6t-jLLssMEEQ7kNvwE1C9Hx&_nc_oc=Adq-ab4AvsgoZLsEztiehCyiByxxnGoxIHR6NgkOKvjGaHAYnTTDAlyYqm-qwSLepcg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxFKWRkleuC33_gjTWd8V2r2s3VzwL-RhiSDXdrj_JCg&oe=6AB523C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uNoBVUgy7hMQ7kNvwGbezGC&_nc_oc=AdpcwCuZAtjMxh0tRCaJxgjihjy3rdXF9nvCCWadUymGbe_BvZvv1VHI48ULCJ_0bGo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIdNDciuJlCjHuAOOVoyhkLHLkwSfFG_Es_hfeAQhYGQQ&oe=6AB51637"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qB9ivf7HQUgQ7kNvwHZc-fn&_nc_oc=AdrxVnZjj6v5Putgwtam2_Jq1lqwTz0U2GI987kKOg4NQyRIJtO7AEB3BQHwRxCWdy8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy7UoyA0sSc63alEehYso9R7aNrF2GehszABZ8ANELWw&oe=6AB53A68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPjmSBBPUlcQ7kNvwEVUF_L&_nc_oc=Adps4DwVNd7XQ2b6ez_k2osJ0szdPq0HX1f9sGstuCRKQP2qYYYJGxiCdW1ALLtc9cE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLvEKLnus-ivrc25LtS7VcdbfyLh2bLMuiTytuqxLIyVA&oe=6AB53017"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5J6Yi7VdkGMQ7kNvwHiRhiF&_nc_oc=AdrDILDMVoWu-9_wTlx9T7q_FZZSj3ToshyUlGZPXbMqflQ3-AEeWDumCQl72Bhst0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLFvfv9XWMv_21VvC_bSIIJz9S5mq_gV7GWuY3D78bCxQ&oe=6AB51F38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_L_GlWkomAQ7kNvwHqFilH&_nc_oc=AdpB060FVxIs0ut0nWtl5ApkDEfc9Lp9DFX1T-yawEYHt325if7VsYT820BWS5iCEuo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXchYHX
=7f20f&oh=00_AQPWZLImmNlWwFNKHjKo_IXiCmLCTtklHidsN-bXH2DSug&oe=6AC50CFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad0U9JGlv8oQ7kNvwH2e0uJ&_nc_oc=AdontrGuKVZ213N2ltYxO3L-kaxXt-v2vVIuLpe2yKf-zmcM3Ygq1C4Rhhw4XITwDd8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2y-wCtYbgyfcEAktEVpR-lgOQeTzf-ZDQUKnD8nvWiA&oe=6AC4F5C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaA8V0Z4Gv4Q7kNvwFrtqwt&_nc_oc=AdoS6S7n6W0EDO5epxT5B0zWP5lGkdKcT0ZLl0uDctIWxzDpSVcNZ5yDpzUGM6M7zCg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgLpexDSIEqMDER1CWuLp_dSbk8Qu-Y9dh4K2POCPYBw&oe=6AC52077"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJXDsWaICfQQ7kNvwGrLUc0&_nc_oc=AdrsQqyHEUOVENKv2WbuDtm094WHpr_G0wsXjx6blOXMkB9ASKBfv2YTdSNWdvg0E3U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtU4BW9GEL1IU4OA3FchPaLqcZq2gYHy2Bb3XJL4Dy3w&oe=6AC50C68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyqWkEs5mJEQ7kNvwH4ENR6&_nc_oc=AdpFLjV_rHHrFNMs7BHwxhnaAIb9-xJM4w6UAMKPTwYZd3sUodNr649uF0E5WGxAGyQ&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5ZYNR0ttZF175z7qryoj_HlArbMf6PnTgH5fpHinaYw&oe=6AC50217"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsTHC6VCyTMQ7kNvwFuX3lZ&_nc_oc=Ado5ZvijSnYLG260YJ4lMCe_7iEPGg59uExhVGnXCklJ9i7Mjb6vX5Nu6AWc7n89Ogs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtDk-BpFm1WVE-IskpWE_eCXgujtFoSVWiowlNiKSCCw&oe=6AC4F138"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--NYNe_wI4wQ7kNvwGaUIoY&_nc_oc=AdofS4mLh9XS1FS3D8G2_XNXFRuPrHHFPirSu_MX4seGnFIXG6comuZtS-r2cInP-XM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNvroufT
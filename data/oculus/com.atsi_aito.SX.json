=7f20f&oh=00_AQSmDT94o7PL4B6Yk4tACjUfRxXzrM_gAEpseEzNWnJneQ&oe=6AF08E7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xU0mB5LVg8Q7kNvwFU2NIM&_nc_oc=AdrpCh3WSDS3hSi4pkX6uPyVx5UnJZ_NftuNDC0lR4VndsdtBKqBREBkflm4DkCsadA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7v2hS2dNnezkpW6Vu5gdVYVbFTJ3GtSK-QpO2HMpveg&oe=6AF0AF83"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbvSAy8p-1wQ7kNvwFc6cvC&_nc_oc=AdqWx_xvrRjeOXTvDCPpw-fG9vh2INm8xtA9FaLlUCqqIu8LKXHNOTVqSyBDrq4A4AM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStBepJbprbx_LgQWqXdQIk8P6Yfm2PGHrwxBaTXaqFmA&oe=6AF0A1F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0M71HioBsAsQ7kNvwEh6q2Z&_nc_oc=AdqHiPeWDbhf-Vt6Qlf38Pnpxx67ls5vcG7HkzkIRDQfTAPJEy7-Cq_piBocjezW8Tg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQF2kdU6mTDZNd3v1i08PJVmuex--uW3OPlcX81UUXdzQ&oe=6AF08DE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=10UTSXjrXu8Q7kNvwG-t6VA&_nc_oc=AdpIXYh2mms1ck-EHX6Ihn6BHBaITyP2stDMt9P4Hva_KfdN9uIHT4liZI1eibggXKI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpLiIWqQ38VycmLpbBw5EsjyNxuah_SwSZeT219ixYYA&oe=6AF08397"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cc1ESsAsJx8Q7kNvwGISZ9I&_nc_oc=AdpTHfpkad6s3ZdFaKiGHf9ZUW9DZu0k8VlgrcpO9gjG58eQzpwQKF4D_7PaDgmo0Lc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNFRXgyewkQLagtxm1DfPiaZnQDe9sPgitGR_4XP_k9w&oe=6AF0AAF8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o41OYiWxW3gQ7kNvwGCx7_d&_nc_oc=AdpUnunmVbfH9zimn-fkvTsnw_f2M-ea5C0iAhvycYhi0-93emWoRNMR_T_j2Pplo_M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvyl9l0
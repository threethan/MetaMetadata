=7f20f&oh=00_Af-jzICYHYi84ZX3FYH3CVS_jCDOevzsWuY4y7dpKDS3og&oe=6A47CE7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0UuS40y_CfMQ7kNvwHd-xLj&_nc_oc=Ado1LCGXASG43cywMtqxIOEI1eVi3_RgdRl17GRNFrtJEN6E0b2mnCQGKyOUcTDah-I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9O5tbfv4GL1SIrTtWvFrW8DZMlufKm7po5wtiRB9oLrQ&oe=6A47B743"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhoKuxo_wyAQ7kNvwEWyqXn&_nc_oc=AdpEn_CRGPb06IB6DnvqwQPrJ69UzXxpV5sWC1Qo1o6JFHdpG7go50sFa6drS7uuL9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3llOwB0tQ0Lf6XaH-HBw8jja3DE4TUNfuBC9ql3npPg&oe=6A47E1F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pcA9QmC3tZ8Q7kNvwGErN_y&_nc_oc=AdrSt2YqiPbTl0n20yboCh2Nug3uHqVdnER8c2ZZI3z3OcbhE5SRo6oyOc0LvvBT0wU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-9WjYZ0nwwn62vN6RErd5rs0nJXhSDlXnktZvpsKvonQ&oe=6A47CDE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xw6r9vqfjtkQ7kNvwG8AtOz&_nc_oc=AdoQSHpJmXTkU-yLcgehH2rCX42JtwMXuDaSXtxaSXaRoiDzVCrGw1r5_8cT6U__Zjw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0jumS_4tQnWTshd0SXpf00imqNnOyfRvn_qSbuhVO1g&oe=6A47C397"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vjj80X2n7fsQ7kNvwG_qIxR&_nc_oc=AdprLiGY3MoJDLOeM6boyVXSIc74huIN2Qnpd85f0sFJuIA7ide7vLh7SD1k-KukuTc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ir1jaUH7lW6YlDJID9mV-VX-eVeEJRHng3f_Rvu-VDA&oe=6A47B2B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiyDFtxflDQQ7kNvwEAW3PW&_nc_oc=AdomAWkt70PpNwUv15hrPKUdz3KyEH9-uZpqLiDPmEXs-NxMBo9FrHniIJHwLKYmqEc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FZPoBP
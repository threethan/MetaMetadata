=7f20f&oh=00_AQMzNRyvk-QCKs3LUdmtJteeVYipL6IIjzGkVmVvZaUo9g&oe=6ACE477B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2czB2TXiLYQ7kNvwHVIFxl&_nc_oc=Adq5hhxCULrgmv3sVLQ0rQIH_l5JgRqlTbUa2JTTxKQXZgs4O8Q8NSjtfr-Wya1vLB8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVNd60rVf8JobAwcdRF0M9MOO4TvqxxfFML8Vf8DHvWw&oe=6ACE6883"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5cMM2j1p94Q7kNvwF17l-6&_nc_oc=AdoDVWAqjNgdb5MDeCzXXc-2u61rXyW7kfauVQxaqz3s20HgscTLcudZbHfF7xhLsM8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2PfLa4enGd0_8KhNCf80oUS-SNhPSzeiw5aaMG_R9mw&oe=6ACE5AF7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGibiAdFK8EQ7kNvwH-1y_r&_nc_oc=AdpLBFet6_OmjsXzTmZpLNnsA9rspHPtGN-IpwNzqXJqCY6L3XYeBykamHvg8aowDXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMB51Mf7_WrR0resfCY7eusDGWRiNYCrUHHZGVYm7FwBg&oe=6ACE46E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg1zLqdnuvEQ7kNvwEeQh2D&_nc_oc=AdpXYp4Hvl7eysyOHZXrqia7ljOjGBFF-YxA7NRlCWXaDHNxGYQrcvQnh77dGfMmJKI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3YmpSXB4Y4PIO5Y0DP8OcavCqc-g9U1yPKbFEjngg5Q&oe=6ACE3C97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ctrl6dO4Q1kQ7kNvwE8gN16&_nc_oc=AdoeyJnPvl38JBgCPd8dtaUtVGMckv3iZT6Eln15enjAp8LBTXvikvzyvbUnOOnJOa4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxSLGQuF-hQnMXB9PPREOhxWm1xL_5EQbgae5RwuMjzQ&oe=6ACE63F8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEvaVT9ZfmgQ7kNvwExoQJ4&_nc_oc=AdobxzwyYDZBsFBgs_MWeTPBD_6Pw9kOjyrYbnT9JKye1vHX5vSVih7BYa8ov9Y7Nro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrsdd27
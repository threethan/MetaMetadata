=7a30f&oh=00_Af0Oc12pDlAUOUcsrbXf8j6cZkvd1SlK55SyvIfiF0UOZw&oe=69D278FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atwCpXKWfigQ7kNvwF16WfG&_nc_oc=Adq2QHi4p5_LBtby8PBXeOzIvlLV_jmsZ7WB60nfnhgcbKtuaf-C-RrKR4oLfce6Jkw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1x9LF2wvmOVRdYpLH2a6ITwtVhT13jr2MF8bQGqmVBUA&oe=69D261C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tuyHNiGGkRQQ7kNvwGDQ2bs&_nc_oc=AdpX04LKI1OIR35gWNG0RxcYL6G3tPvAlCR52Ap-Z75HojFjSIwUhDVzAW305Yex6E4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dqEJqBYNyREqLBcJwTQQ_ukteakmKERxsS69PpfA5mQ&oe=69D25437"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7QWnc7LKpD4Q7kNvwH8rgY0&_nc_oc=AdpaQJOFcd28SZ9KaFyKgW5muZzdu6dvUkx3sXiP9YaEBZZQJ2_rk3v0rvFlAFu5qFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BiNVR0Jq1jwE73hAmuYU8zDgcScf7A2ZjTr8Oyy7amQ&oe=69D27868"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSRc0ihumN4Q7kNvwGpkkOr&_nc_oc=AdraIlueo4JUi7tvi-vUENVjlPgUUSgVpqYqmz9RgcrtXTRTr_0espshlK2K4oPQXhc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2fLnzCz2EPL_Oq6GGSvLBK1TpDkPYRsU45iuDGQJKkvw&oe=69D26E17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IisVchkNgt8Q7kNvwHbjquk&_nc_oc=Adp0mpnETeSfo4q_0IWINwa4gAPBS9WCYSh9Ky6EJkQgRufy15aNpkiQPuE-RxhpKn4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sSQq3gLyAj2IxJ-W99Ul0AtNLe86woG3OUNDKgT522g&oe=69D25D38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCEVoYKtnZMQ7kNvwH9hnk3&_nc_oc=Adp2-RaXXRB6XBcUsEjHYK-moa_dDeMX2kN0qRdNi9ITy1sB7VOEavYQLLzkYMlGgZE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pexgQ-
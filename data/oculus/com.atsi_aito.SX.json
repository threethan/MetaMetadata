=7f20f&oh=00_AQABXIwhJRG_yLfrS2T_d2M72QRC8sDhw197seoVukvpzw&oe=6A6CB87B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eJXlEIIBtl8Q7kNvwFmUUyG&_nc_oc=Adpnj0976wuVtxjBZJmRkDSMHaVaV4pWzS67fivtpxLp2vePl1hx4hH63MfmVOxv4LE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCuf6EevI93uWd-aPK0aL1BdeA1yS_B4xxDOb4G2lPnlg&oe=6A6CA143"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNec6WMphSAQ7kNvwF_siBZ&_nc_oc=AdrUdcgzYVFO1CsA6gcpETOs6jzlXO-F4ytF3o9QMxdFZXmHzBY4vpKznxoLj0DHc8M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCb5bqhHXBe1LlaZbcrM9d8oypE3__hpzd-YA33argkjQ&oe=6A6C93B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bTgvf2O3-sQ7kNvwFymL1G&_nc_oc=AdoaQzZHC0Tm7Nu_ZdDAvvabt_-fk7O2CwmKS7mKjUJp8OhH1dbfPFXEGi5uGmL7urw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAGsyu7DPAGvcIZJ4L7PB9-umj1b_C0rdHGSn15dgGL0A&oe=6A6CB7E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zzZ2GrwdKjcQ7kNvwFEkn8M&_nc_oc=AdqM07r8i2M0RS7R4yL1fbSkDJMtXHHtoSUMr0GFF7Y7-UgBWQwVnOd1UiR2QqPnkgg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv1CgMrMOPmqQV5EzxwUPR_3xsxW2uZMbb5PIdIa1RKA&oe=6A6CAD97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e-aFXqN05CEQ7kNvwEeO3PG&_nc_oc=Adre6v4z49NZ8ScdHYD96oF8YCm8Uly93noL_ZgwhziA7IG4F2NDYMfXNMRwirvCank&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmPM5wfPS0r8tz_dLiKIJZGm8nlcJmTP3BXemfMj6-nw&oe=6A6C9CB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WuxTPYjr4TAQ7kNvwEBjhWz&_nc_oc=AdozU-1Ub3FjE5pUszkQzKuvPwYG0P-BFhgk1Ev1axm8jG3PNaMPXEIfzhJVu0Vf53Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsZjqvz
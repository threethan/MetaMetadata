=7f20f&oh=00_AQTxidszt_MNAle8PP7TczS6YObKslRjklxvzEWDI9RPGw&oe=6AE9F6FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l4QOC7LAEYQ7kNvwE8wuLA&_nc_oc=AdoT6iyTnjFOjPT3W_adfea_0b-ArzuE3182CEfBeVoZuvPmjxx2mEJvzd9Iy2KfwDc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP0VpRE2IINHutDSjjA05PrMlI18aX3rLyTXDnW4V0pw&oe=6AE9DFC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdsA88Ow6WcQ7kNvwGcKQej&_nc_oc=AdoKmVC0G8oxprXzyZg8POjaytWHOJzxhDpvLyDK3RFn9DfzJC-1i5zQGMfz7fTlIas&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCvdvQteqThTQ093ffJ10CFm4VXZP0Z-2K1pVSdQ0FeQ&oe=6AEA0A77"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osVnFp07ztsQ7kNvwG4RTxs&_nc_oc=AdpSTtVbhfojfMmzKVJG3x0_Zz8pn8KMFpkW86AmiipFnRek-1zP1QpJr2uTsc6ZRLg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQD2DNVP-2bxekwgVpsxwhRrMs8ou5fNAAJsCmgbt6hsA&oe=6AE9F668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlCC9GdWbmcQ7kNvwE06haL&_nc_oc=AdojrlXaxBTDJj2Vigr8A5cRIk9hnD1GtU8qe4aNpTNj_SHuamTIHPFWovxWshIE3CY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSh3Je6Mc3GFZkLkAdqhEeLkXZ7ARNvDAX8zOpmaXwK3w&oe=6AE9EC17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De4JPEEqmqIQ7kNvwHa9JZm&_nc_oc=Adrg9SD3LEjYQ3DgndqElTz7YhF3PLb5WomFBjKYmDIOG_sNpk7TVkYOToyhJOp3mU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeiJ89bYHoh1mMRIDMnheAALYOEE8TfFIkHn_A2pHOtQ&oe=6AEA1378"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmC9mqHe684Q7kNvwHqbPAd&_nc_oc=AdqH1_kQZ6J6-5pMEfMoZX6_3fnKdZZ1L1_eLaJFnz8_XnSaHNT9d5EzOj8poQcnmbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzeuyem
=7f20f&oh=00_AQFtZrLnFmKMQzMF8Bs0TYQY8_54sZ2Fm-5k9ZNdKdUaZQ&oe=6A75F2FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5anR9A5YqmUQ7kNvwGGHMw7&_nc_oc=AdqGQjwXTmaNr6ZEifPuj0_RigRXtqsrGY3n85u09v6Ayj71vD_zSyaRHWY3TRwa0SY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8tR3VbaJcFDa8Uafnxyfb_GaxBiNxIx-Ct_jeZOiPmg&oe=6A75DBC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJkP8RDqdM8Q7kNvwEnXfoe&_nc_oc=AdpBHMYe2wm9ZW1NsaHd7pPL40-UUQm8u_cOkp5bOYG1SWIZrUdECO_cWKVRBDWbGIo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfiL0IDWoKxedN4M9sN0yABj6I4lzzUtCeIg8iVAkLfQ&oe=6A75CE37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mg1SksLuGPIQ7kNvwG1oSdO&_nc_oc=Ado4Lr8-OBB6K7svjcncXKtVF7Lc1eyRXuxdTuyQGgM5YsDc3O--yk1GSNzkrUC0EwI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFg1BN5tiYXKuuofM0zQ5MlMco1zI6FYdBcxFzz182IaQ&oe=6A75F268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4F-feMQEaoQ7kNvwG48ZnG&_nc_oc=Adr4lqum2u7pvgwpyvCX2BXzYh0cbIl4LqDgrrava7oHDVIPlUtROgCXmkBYLNjfRwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoktR7eFAa8S0AdQ6UfETg3b_1IswvWjBYHNin7-8uYQ&oe=6A75E817"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01BY6kBOl7wQ7kNvwFA-Tyq&_nc_oc=AdopsjglM0tWJhPAC2vb_EUxd1dvMZ4_ygDlZZY0P-zTG3WQidcLcZNTE5_eol1qTqU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2ssW2_kaqSywbFF8DZCISLTXOI35PF9kQTGBrYDYDeg&oe=6A75D738"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRoz4pGBx2wQ7kNvwE7sFjO&_nc_oc=AdqtxHEUeIxvMPxVEwOnDyuLqi4JIuQYGVkF8U3hFXDg1LQdCelwgGKoRdsvhU2q5vU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZjFbnu
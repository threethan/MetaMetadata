=7f20f&oh=00_AQAzCNR4bc7ewHHdlRmfL_i-GksJpL8PPpmIs1e6PPUktA&oe=6A4D147B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3yiF6Cz-VAQ7kNvwFgrdh1&_nc_oc=Adpm6WCqYlYuQR8qBiLKL5BrVarOv-KLbHmfkFhC2KFENabhdhKovExIDpdfgVy5qt8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA1XH8eZ9rfvf0Zo9h8splh-D6nHaw2PWV5P92mzqsnPA&oe=6A4CFD43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ITBZpY72v0Q7kNvwFB6xux&_nc_oc=AdoZDYAmCmvYi99U2whLolWDdIGQqXbBhmLT-st3qbchFpmC4cTDK6AlPmsQ5U-XmNg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSJGhepPbghcEcp2K0YPyCHVOWiDO4xWtTpp2EqzPqRg&oe=6A4CEFB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEh5x27BoXoQ7kNvwHWDVCv&_nc_oc=Adp_zPBlPxY0BcbRgOz60mEeP1oaHZkFPCQewjREMmByNdEjnxmvLKKEjFFJpbKR-vY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcXGC6cOSYX-XQSXf5RvndkuQS1wM7Xb40Q2IkxVLvhg&oe=6A4D13E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcfqBceTFX8Q7kNvwFPSviv&_nc_oc=Ado7dTCmq-Ign4v3Ry2yHlGK9NPcM5iB_w4flB_lIt5Iii5Ep-Pw9lXhYJrNsBOR_3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4IxtZPCpKCT_M5v4dMGfYO0WR4hlclD0YRQpV0UyXcg&oe=6A4D0997"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE6PtoEwSFsQ7kNvwEa18Yd&_nc_oc=AdriDHxJknycCE1cWqJMHiPNyjEuo5wFQJVHr5b3XQVgj8JB147ipefHVSYZV7aBHTc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChISHmE1YtnVJSzvF1Ybapx1OHXFvZrm8rbTNjR0UB4A&oe=6A4CF8B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDdVaLT8v_0Q7kNvwFw-7dv&_nc_oc=AdrzuV54gFJ5cxW7u3iAbjcELk6PR78WpmaIiDeEUf9YCqMx6K5dJ_Jd7oGXQKga_6g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpfrra0
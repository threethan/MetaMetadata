=7f20f&oh=00_AQRo7Uh31rcuMtNzEIluhEPQr34Dda2x3JzKgti0P9fHzQ&oe=6AE753FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RIRxVV_LqkgQ7kNvwGAB321&_nc_oc=AdolmqC3FNu-gA2QWqS9GT2v_YTy1aWjBB2t6vZiJKUMIAvmaWvNpyyixbTktART9m0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT0lJThM8SVqAO2og_mV-os9YlCbsaaSh10u3DB5bVwEA&oe=6AE73CC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Dgu3T_3ePIQ7kNvwGxbRuc&_nc_oc=AdoPIaGOp-vt9dASsNhJ-ALPYFV7Y-yyPcy-u3yx3gjlQ_HiFgDWMQBxKy5miJlRF-s&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlrky_w48NmWvLx8EeF9vopvlgfMWel05kpik3tQH1LA&oe=6AE76777"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kH-u0bp6kDQQ7kNvwFCAVT5&_nc_oc=AdoVbhWcp4XH-S_oTq7LzyqivSrhbj9l_8ZzyuALJzt18T9M_6fGuLenQe3hvWerF_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7K18HvgbICdsevPf_MhEwxXD4aiyHKySE8ZrCiBZqug&oe=6AE75368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bbx_07xcrWEQ7kNvwEVlOI4&_nc_oc=Adq7O-UnD2o9BhW9EczGEqLBDay8jZfs9yRv3RXdSMpoDFQVdMan53-UcViFY4J-Q9o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTosG3TEloK5WH2KY2zuNEkGHKLDLjWHSnVobn_tbe5NA&oe=6AE74917"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UZW_L26pd0UQ7kNvwHt3o0p&_nc_oc=AdqXpgVK8wx0t2V9OZUJ_GuoYD6nhpcErUIqiKUelBsDWBwUbdYiWiEn07ElWWLMLcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBUiE8kuyvV4DfTF4UPxPkxq7x8ifNXgtDte8GiN1BfA&oe=6AE77078"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RmC9mqHe684Q7kNvwGVqzE5&_nc_oc=AdrBHqZT28Amg9NZYXax7TZbuaa0h5SVYF4EQUde8M0iY74GDnz-kgD8EwvmVewPNec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKB0q8G
=7f20f&oh=00_Af4cDM9rbuFRNxbE4mZoIKRm4hHCK4xLHrfW9h6AwZCRtQ&oe=6A0491FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6QfYm633nsQ7kNvwG-sZdc&_nc_oc=AdqZilXcZi_BgLeoQqXjkUtPGzQ7rbzHX5P__BU6O910W21jABFQOfQWfqV5IptdeZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4sMbjwK6mpUPVwp2gQqN6_NxfawSbkJCKsYfXfHSDzWQ&oe=6A047AC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6vSS4jTP8b8Q7kNvwG8wc9O&_nc_oc=AdpZmOR7y15FLWbLONxuRGiQKmTJeQROe2qF1f8HaMeQWWmWYuYV835lDYVXN59Ho2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6bluS0HLNg_X0tJw5TtFNGynAJVAVQbIaOZImB8Lr-fA&oe=6A046D37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2IwLOvGSi3AQ7kNvwFWauwb&_nc_oc=AdruGxIS21NjnXCz9M6AF1fSgUFUIwEakm6-OX3-gozHlY5S1fdkOlfSJrWNcFfHo7A&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_V9HnckwiborCVN02FWnFNfXm_oURswkuqV9rhn1dDQ&oe=6A049168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6shUD45s04Q7kNvwFZKh6e&_nc_oc=AdriaaY_CndjAks6EMHmr-n0PTdlavcgZF8JY-VF9LgG-7MZDVkK0--j5yEtA-XRgrI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af679Y5DoW-eEKyr2u0nYrCE4ykzd6TWwgpC4CWKdqOkqA&oe=6A048717"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gN7ARcHOn_cQ7kNvwGXWMXe&_nc_oc=Adp01Q4etZftIXgIY9dvWqUWjZdy7hkkSfwlVZS8YmQNOJRcRw6bIj4V_Nrusjp6w5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5b6eaw4yUDqv0jb-2u_JkXYNg_lOUq0uTnmiXSmMc2ZQ&oe=6A047638"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rFEVfl_QuRQQ7kNvwFDgHhj&_nc_oc=AdpHyeC1usQMDGCcChW1Z0XMRZVVBDY32gLYgSwAjtk-TYbiskgFTVMlTw9ni2SQBqc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Djj7Tq
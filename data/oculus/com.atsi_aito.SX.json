=7f20f&oh=00_Af8nI6AflErvbs1Y2gHoQu7MBqcqK73YsH20O9MPFipJuQ&oe=6A35597B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrv8_AH0hd8Q7kNvwGZGq_p&_nc_oc=AdoOEuoiayXpqWgTkYkXzbj7VpTnEsSdpHFQl7PYUEj3EQNTwb22tL6wg7nwNBxLmyM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_pbMX9Mzv8n9mViTE6kQx2RtNVMD9ngOddMxZ6SnB30g&oe=6A354243"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQFc8xSctkMQ7kNvwFo-t9u&_nc_oc=Adq6Xdp4-KLB0eQah2Ii7kGxEzcV28upnIqPx1kJDUrtcxVlVL-6kHjtg9va-52V1eY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lqCdBUnGR1mEGS46b1LlFhLq9jBy3RVHvlpAE4SNbeQ&oe=6A356CF7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt8yduRM4e0Q7kNvwF2xvot&_nc_oc=AdrzrZvThAicltgmXr5BVHvHW4MwCFRN0VDzH-WP5f52-OD4LEEnwB0umjoxrZOJNzM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AfQkrYpDA6tV_DV7GMyHW_X59TvIdR08D7OqWSVuLCg&oe=6A3558E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYXMzn-QFIcQ7kNvwEXBgXM&_nc_oc=Adrijj5k8qiNqh4Vyt0jRzeSLjGyvnGQulDmWboLW25-sNAdrb7KqfIWB-Er6gS0m7c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cAIzacETfHlOAGIRMvgCSV059rASEHycLzOjgptFW_A&oe=6A354E97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhdSA0Kbe-cQ7kNvwGgb6xi&_nc_oc=Adp8NNojHDf-qq4P4ReA9Ae6dhn4jsGsRm5hw9jAUIcrF-naqzpEjRNpejZmSh8jOqE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8inldfYSAjJfWGM4XkZcwXbkwf2DCoiO_f-eMxOoOXOQ&oe=6A353DB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIKqmjmSvB4Q7kNvwHefodH&_nc_oc=Adq2yySJbFoDxccUy2WO0-LczlcYCVfQhXwyVqLHb0YLbGBIxrPeEyTSE_4Ag4teUOg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ysTUV9
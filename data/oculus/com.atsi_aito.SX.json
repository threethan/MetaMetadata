=7f20f&oh=00_Af_L7F_PX7NsKrtIinrWcZT2rxq2KU5iVSDryxqMDgVE7Q&oe=6A43D9FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc3i3HSe_ugQ7kNvwHptSnH&_nc_oc=Adplk44XLntRY4qGrezIV2mbH-xhmDzaYJcLmJsUntt-bbFjEbVIS33CtpvCo-WNNC8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xEWisS8r2ZbRzMifJK4CB1_OO8B4SsOKSVOCRx_Eikw&oe=6A43C2C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qqzv3j4GhPIQ7kNvwFdIfT5&_nc_oc=AdpC1XuhSsxkahNhA-tT1mEMScpM4-mR9zO3LB-cYOZSpwyCaS2dZhZrFFnd8LWM5NM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af86lxndZJof5rGkhSV5yqulkICLPsjbwtsHcg_7tIHbEw&oe=6A43B537"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LcG3LbtisoMQ7kNvwEOAP2B&_nc_oc=AdrwMK4vKA1dO9iEcmRD7HvngIW-e8qV9C8gBCQTObVzavnxn42B3Wn6sheUAfdXcnM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zu7_9tfXWnU_rRKltFgy_3mkYsDug5j_WiTXcmQ6DiQ&oe=6A43D968"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qDvaXmJDg2AQ7kNvwGCNboh&_nc_oc=AdpqrcINT-fwPikPeStfVyP7M6ZycJZiErbJ18LN1JdCPs5qLBXjLBvQCPEYwLcmEP8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oCnjNrmmDFT9x8iEZ5yfuCMIHCpWMxapi81sadpUowg&oe=6A43CF17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bSOwWhyA9wQ7kNvwFqDVeG&_nc_oc=Adpg-ZWC6vj4likZnHKPUYDvxPC4pirOKgZ-lNEnC3xmz-rIciaLGXTZocwBJDpZ6Cg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z_L4kda4MvXyiSXGpTitwTa_1y7B6A6v0erkpOi_jEg&oe=6A43BE38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PmWMTIvjXnQQ7kNvwFBqKwK&_nc_oc=Adq6mEKlK1W_e3AMWetuEBiUsByD7ZiRpE5rMVU6ttMVNSSuuz3CyjNbhn8mnze7PZ0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92Eu0x5
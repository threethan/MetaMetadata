m&_nc_ss=7f20f&oh=00_AQGJ9z7JRCGfmP9FhbMGuBZCLR97GWMHiSzDsX9AAZ4-og&oe=6A8EC73B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QOhNNstYq8cQ7kNvwF364fw&_nc_oc=AdoFZ7IUJClEXy-ndRrLMQKHl466B40PLr2tL27fD9tmnu4IkqISAw8jTz2Fi2Ly8bk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGh5OGTpSPzjccpbKYXofJ5nWiW3YCOoG80g09J9H0IkQ&oe=6A8EE843"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmJrpEa1etoQ7kNvwHMlk7c&_nc_oc=Ado9LwnF9Dm_D0iLjYUtk-MPclE_LG-rpGOl9grCmzc7btamoDprdRtTWcx0YA89glk&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGviF7G2cWTscdzrMXmynkWHm8YJedjWp4BhOsMPxGVmw&oe=6A8EDAB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zOakYMDpnTUQ7kNvwEYQ8yO&_nc_oc=AdoI6LNzqQE98Ga5cV3ANf8cQoHQEY03ajmDmILZD5-CaYtz8AU7bS8Da6S6KM3MdCw&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcI-UO7ZW8pB6NGdvIlRxQZ5i3vkbmkeWYKROCfopbAw&oe=6A8EC6A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slPEGOjZFEoQ7kNvwFfnjF1&_nc_oc=AdpXx--xq5Dl_EyP2txyYml14HuT-CdzI59pb41L5GwBHdfnATEIe1yNXcJ9c5u3iKY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMJcfeJwMCkMCokMQRlPksL-0dp7W_w2gThNG3wlUkDA&oe=6A8EF497"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JT2jZNv7In0Q7kNvwG8XhTA&_nc_oc=Adrwdn0LeST7jeSl2905lV9l_FMU-hh9yw_0vpGr1wE_HcyOkuNcy4dGf_MyFy4dyWo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFoaf1lUcevhAM1B2l3tUf6FA-ZriH7y3wcMbNtbiSj4A&oe=6A8EE3B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZzamBvn3rEQ7kNvwHurypz&_nc_oc=AdoRES_oMB25bVpKRn58lH5Eai7mDeXu1zDOApznZ1-RIReammQxuqZw2HuHfiMF9Ec&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f2
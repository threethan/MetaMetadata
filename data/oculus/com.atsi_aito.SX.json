=7f20f&oh=00_AQDHvolus9mF8pZcwrWt5RzA5Ugay-ObtAdb6E7rfOC2oQ&oe=6A6620FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMD0H6EaQWgQ7kNvwFhwWnM&_nc_oc=AdqKqpHobSZF_bvNczbiK48_qJfNseE2G_JKfwBOf4dhxr5_xs5KZGdJlF7Ywn6PAD8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8h6hv4GS93Tj-iOWK3Vf4BmntSEXmVETO50aIpFtBtQ&oe=6A6609C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EAtKMvCF49wQ7kNvwGj4giK&_nc_oc=AdpKAZd5RzxYOgHLzHvav-UeA84Hg4cp9TsN1ivZy0t24hNQG4rZk1k-lz9JSWdKbHc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAY9GYgqD3vXMLb4RZ1FFpAfZESU9zjwH8ymVlccdliIA&oe=6A65FC37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HY-xAmUENgQ7kNvwEd69FQ&_nc_oc=AdpFkZgvaswhbcAqiqKCMXL4qLsd2ZxKFilANUwsA4obUHs1_RvYfQfOdKbOLSOCJtE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7LNcZrPhkO7R4yx5tiIywDcKNYyiKOOjLfynzIMLKqQ&oe=6A662068"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLz0GF8Lk6AQ7kNvwH_haOw&_nc_oc=AdqZrTcY4uaPoyWfRpjQ-4aZcfZnuWF-qsb5DB_6S5-gjhne3PRBiJnCxf5Y7FFhrRM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9z_MhScN211YBwmZNFpc5ggA7AS393Y3du74dvOGelw&oe=6A661617"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPAT-mwGaWEQ7kNvwHKTH8E&_nc_oc=AdonHpvJNHtC99DG6QTUms__8wadgCmYQYZ06BQv-nYMvZgHvevU7GDE_hj_OYEnel4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABsMNF-xBMPEbq2eWc0Dx4hYBYzvRnNwRKAtjVUF886w&oe=6A660538"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYWGAX9_sbEQ7kNvwHGWM55&_nc_oc=AdoXAaJvj97rAip8W0fAKEYXAjQ6ud9DKbxBpBicyShw3ckjh0Lp5M2BwpbWlLnuIDk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw0v1sV
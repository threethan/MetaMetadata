=7a30f&oh=00_Af2YH4aHc5F3je0_ysPMkT9n0-d0W_m0lys1rJlR4clvyA&oe=69E4B5BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiDpE16sED4Q7kNvwH96U2r&_nc_oc=Ado3QDSC6XI9J2Psk7gXXsrOvzcCQ3sXXPAzjdQLzniEnsQu5mZJqfEkdWJbUUI5QZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27lwXyixHkiMfbvhDu01CBxW1MLy1gqVrgnJYYzXSB3w&oe=69E4D6C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HF8iHXvu5lsQ7kNvwH8rInJ&_nc_oc=Adq3-iRtCTRqhiXGe6k-MqaFKmiG24QhrgUPRTbNQNeIBXGFACN2asX4rJ8dM9wdGEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1u8n06s-Ljdv-u1p3yjg67RitswYuB8e55MLNIT10hqg&oe=69E4C937"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Eoa7ddHzhcQ7kNvwEEGuE8&_nc_oc=Adpk5zcOF4DelzWS-fpbjdOuvQO7blEmJKAIkahlAmifi61QwI8Ya2nKRVeV_1bkTOQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3a8C1dnMWvIlaRCRmvl7f2sShC7ddw2w1Cm61T-ri9HQ&oe=69E4B528"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BErTYP1j5B4Q7kNvwFL5ZB-&_nc_oc=AdoUnGuMLH-RX657t4URLMbXKnUQPiDNraXb05kFoM1IbqYFt1byBkcLKzrlm_Cx2oE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1S5_8uYI167GDnDSth2Fv6I6oFbtMfhpkxJChQoFU7lA&oe=69E4E317"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aM_hAegtvUQ7kNvwF1UZpi&_nc_oc=AdpBv2e629ejt55lwIzreHpeDSO2yYhcg8jTyyiBvhrY42MJljhgPsDxEEZ6FWe_iso&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GLeGn8xhAAsp6DvxupD8CvVB1lRB7eMWOCrJNgWyELQ&oe=69E4D238"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkyrbF5m3ngQ7kNvwFPlZQN&_nc_oc=AdrDqsGpGOySQum9Exivlm2Kq_OFN159Kn1oI8t7QC9a2dHLJIsCmSIYSEukF4M81k0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3UO6t97
=7f20f&oh=00_AQOl5UqPhwdpMcjH7XEx12acy727Jl0skMvwYdh8ZBeFYg&oe=6AD0EA7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2czB2TXiLYQ7kNvwH_OBUG&_nc_oc=AdpmBAtTqbMLEoPAvznYOc9__-ur5PsBqQNYqDmir1l3QfmlJEcaVJPm04nNSxjp5Sc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdEmYmTc4BFzfaIxj2Whjn-znFy7dtz9elLMFaeFiEew&oe=6AD0D343"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x5cMM2j1p94Q7kNvwFBsiG1&_nc_oc=Adr494kWUEzxgDOgsGuQ-mKKrPje0Y-g9wOg3T8gACePzIl_tuAJAAV9uZxQYgolK5I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhR3nwZ0oy2xXZkBJXpdoPLbn9QbHemHmGO2r5Enzp3w&oe=6AD0FDF7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cpe96lmVfdkQ7kNvwEVdTfE&_nc_oc=AdoDBZDnJqrmzLI7AzNh4rrFkTEMx9TA5M1hm2Y7yHu6jTneFpxEppeJeHZpKOk85l8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrm5taAgOaixwpHtwd-rIzXXQsitYnnrIMSh1vJ2LINQ&oe=6AD0E9E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqF2Azqd6mAQ7kNvwHQZLvt&_nc_oc=Adoa8vOeQ33eXi_mtSCNIo3nBX5QXhNVodPGzS79n1_V6Mbpz9ai3WN1yD35YfHTcfM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPdUYOiyuE7lsL-oGI2VnFlsqo94vuXDY9x4VlcW4WEw&oe=6AD0DF97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ctrl6dO4Q1kQ7kNvwFODAip&_nc_oc=AdppXoyJw0FPjlJ8w8FnouPEhtpjtoEooZjnYj_EtWLm5WhYBX-p_eGwPWYgOxYOixY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCkcBXo42HVIQTQjg3-pMmer3G7QELvmkjuRr-3spogQ&oe=6AD106F8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zmcg32mKGHYQ7kNvwEle7yy&_nc_oc=AdrtLVh1LEC9aa4hXAu9iXLD-ZZJGIWEWF3mWcB0sM0WE0Jk78UZE2O1px5hRMybc7k&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMOusnCd
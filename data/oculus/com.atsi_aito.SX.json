=7f20f&oh=00_AQJOTcTtaf1s5wop9UradpIW1LlE5PS8JxJuHLPIcVc0Sw&oe=6A9C2E7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfyg1KH-ANoQ7kNvwHXYUz2&_nc_oc=AdpEGhRMF54vrPMSDDi_0H1VwDDgEs5mEz7RE_v-Y6j40p_yw3OFGR3tm_px3HMHylI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINpT_TsKGZBiTwgJg2o9HirGHjg2Es9DdyGyJC89j_lg&oe=6A9C1743"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1uyI4LJjSoQ7kNvwELdQpQ&_nc_oc=Adq82uicwbU-6opzv1_5EUzoEWWmDrfmAjeTK_5FxvvqgFZgOPrZH_KSkEJWuvQ0JZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0c8GN04E5TYw0Cgocha6f0eXFYw1WFU4quvZ9EBrwgA&oe=6A9C41F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYdfj2A5OxUQ7kNvwGLBVRL&_nc_oc=AdreDcFLv44njRRiTuQqSTR7nHBFE3GF9Xh_MRx-1biwCI_uGdgBm-v3bZ4qM9YIVM8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnWaZM9zTdXJCvdMMDVopkJpK-W-5SIqYjUW22XPtmUQ&oe=6A9C2DE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ0fRPXlrJwQ7kNvwFMWs1b&_nc_oc=AdqOM_3ZP9kIiXP41sCE-FpWqAD-RBAkjGh-Meb5e5Qg5fUQNHTFY8t5iX3ZAQ3Ojkw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWXRkRjvEtp9uOppL1wu7lQI622-lU3YaJS8T31xwY_Q&oe=6A9C2397"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NI7CNskzF3MQ7kNvwES77hP&_nc_oc=AdrDyedYajBp4GkyAlfi5dKOtdaXoKWMTOy6V53U3KmX7VJxVRJVGbK2wW17To7iAcQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeXBTPxxAySTDgJ3dJUX-0adXNkqrK6HW7WK8NOAnUQg&oe=6A9C12B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHbRvRn02PwQ7kNvwHF7SVX&_nc_oc=AdrVlvOYDYNfiKb2s33CTeo3BOxzqyTAag4uSMwP294lchMrNalb5CNAiv45FVv9ZmA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGoqFSu
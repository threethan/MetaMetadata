=7f20f&oh=00_AQPoRVQf_RnyeN2VyEUhDGZ4MC68JlK3UCJdOSHUoS9KRw&oe=6AC7AFFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gsydbr0XzuUQ7kNvwHUvWoq&_nc_oc=AdrBeuLH_DJ0CLXjzI7L6I6j_kxZ6MIaDtm4PiLTihpu_eqdmanDp-DKXPCJDFp683o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBnUfhnkSS6hKzY4LJOfqcW6MSMZBPuV-wJBtEUnXxIA&oe=6AC798C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dLmc-LaDw_EQ7kNvwEiEWY-&_nc_oc=Adq0vJ5LBOcdtG_RjZ4WL30AFuFGBRtiQjdB3na_3Kmpgu10SAQUyt-C9136A3ppTds&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHLeLMD2-edvA7kpxXJm5TBinFKrXmfRrc_ppm2ALgPQ&oe=6AC7C377"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJXDsWaICfQQ7kNvwGorln6&_nc_oc=AdpD_kSGpycb47dwQolgF8WE4-3M8mlLQV1DPH_paKfotpijIUCcbFVV4QOecrvxHik&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5XRVpXmaB7_HQK73Q6XZXEa6DYDggxU9kDmrXgdm1uw&oe=6AC7AF68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gyqWkEs5mJEQ7kNvwEZmRF_&_nc_oc=AdonHnL2Kq6RzRJegEzlDGNsRrprplKHd2AUcSph589K7RmUQ-ZSGQ0THDiswEFjljI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcOfFbyEhGCIIjb8wGUuxVep8HAOLjeu-20b7vai_KYg&oe=6AC7A517"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=afafLPNAPHIQ7kNvwE2DrOi&_nc_oc=AdqGy2lO6Mxg9pK4yHHBJk5yM1j38HdMVCCg-jhjVnfqW62EhRqiIhK0ZVR8e0RDXT4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGM7isLieIyFbvownuLxGgxwLVrxAcbvPh5SBeiFkdmQ&oe=6AC7CC78"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKQUnahoZIoQ7kNvwGQSliP&_nc_oc=Ado4KWrYr_qdIdoOtRfoTpsT-eKdKm8oaDnUJQG_IARnHcnxqVf8tl8OXmMKGHFj5HU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqL9a0y
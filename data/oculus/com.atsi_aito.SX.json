=7f20f&oh=00_Af7N23Qo7EO0fem_V8FPsivWyFufvFAu_1E0LBoQY2vTMg&oe=6A1AFB7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpzuppaUwg0Q7kNvwEwZ9hZ&_nc_oc=AdrET1gUJxL__Qic9-IGC1YuPj6GojXeO7P4oi6ImNzTL-7-9ZipkCE0LqEGdQf7EeE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5fJVNP0sRHPHeyEtfOhjCKSCnZy0l4Vm2pgV3aC87zGg&oe=6A1AE443"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY8Sukp2stMQ7kNvwHQsjM9&_nc_oc=Adqb2RjvPFnaULwkml5fBa3Qx9fhW33CQF0nHLqRBc35Fe_OxvHCm01KKD7lQVllTXg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Or46aMBwBZz-rlKMGUC_w1jhZDD-nbPOUiDEiRYGiRw&oe=6A1AD6B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QaKIVdXroaUQ7kNvwGNFvBg&_nc_oc=Ado3OkJrX1-W9t3O7yegEXtIGyklWCUhvxHKiOMixlo42qCazrBXvClMjGkyCMO3f7k&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4TQDpJwut-w6D0IAkBXDLqeXcgGWymv1VYpcKfoLhmYg&oe=6A1AFAE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lveqVS6wNXEQ7kNvwE8JgHN&_nc_oc=AdpAS5BnWr_6Pmk4iPx72W0Jn6F1k97finJ1yIs67u_KX_2Wq7t4Rij1dJDdc9lv1DE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af419HSjX6usHMZ0rvsd7cwVxBjxo46W7wNLPBizSNtP6g&oe=6A1AF097"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAP3OZfzeisQ7kNvwHFaxuV&_nc_oc=Adoip-JTBjd7JXzbGXRiILQ5JIz3D4MYXM_wX1HIBwyo5DB_xH-PpHY33lztKSjeq-U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4y1uCy44fWgi_aC3jnjYOCRc_NBBgBLLMULXBaKaC-ag&oe=6A1ADFB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpgGt5bc_MIQ7kNvwENoMbH&_nc_oc=Adp2579lMhEezhQzWC0vgCDjtApwsrCqAbS5S-zZwrbj2UeDsJrdgm7JjiRtRhlEym4&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LY8Sd-
=7f20f&oh=00_AQHPKlzs2aLkjDhk9s58xoN74eIpZiOVuC2n0rDTjx6MHQ&oe=6A82E9BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpqWtkyFOT8Q7kNvwExyX6l&_nc_oc=AdpyLWpD2yWbSUwgKYuWkhUXtdzEIXQeblQSA8pjjTOxKxE5nAIffbx1vKePptZB0qk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-OYUJ6G5olI0OcJy1ooD5zXIyhoBQXx9n843ZawpuBA&oe=6A830AC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUQucrU08HUQ7kNvwE1LKTk&_nc_oc=Adpj0HJIHxCV_F_WL36h6lhmomi3JrRQkW1LeEm4PdXP_0Eh73AD5f1mBldFsQjun2A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHK3cfvfOpKI3fjlpNJt0nCPwoYWCgNcUT1-0oDmzagUw&oe=6A82FD37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNuMQw9FiD4Q7kNvwGmEnHX&_nc_oc=AdpFkOGHlNhNk_71_8UIsZibKiK-9ewsDQJaLACOZ6HbJxRgmsrcUDIQWElLbdRthUo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFPPPeqa1Fo3xyFqNzhCp5zCFo1m7o0SHUkJV6winuqcg&oe=6A82E928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKK9jhDhX_QQ7kNvwHalNUf&_nc_oc=AdpaAf1tMpWfb9wrhxKqhlMbLWM0QgkYER-Jb13YUF7iVEmZWoJKTu7mKKDHyYS9q-g&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH9BaeJGN_kyd-s36qoNvtspeWNvUYhBlJ6QH1NFtRLew&oe=6A831717"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qrVEmcc7iGcQ7kNvwG4ylOX&_nc_oc=AdoCrkgPZ1Nm8k_6TrFcUA9fnzaKyqgs87t18WHQrmU68Doiyxa08phK0f45du_943A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO7d0f0yzWDy3SB616We3KT0S6s5QGEZXcgDSPWkNi3A&oe=6A830638"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPTRoB4-RG8Q7kNvwGDjOnw&_nc_oc=AdrzfUTOsNbv5x9ObjPvGMOyZa1k_buTyIrGZpwSfJ9rej5o6WaMibhiswjFvsf9N5s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlWRy41
=7f20f&oh=00_AQHks_m2XLYvBRCRSeDuxM3qoVe_cVnpW9-MPOTHijrEug&oe=6A7EF53B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mxJlT6KFHwoQ7kNvwEMjrdw&_nc_oc=Adpyp0-O8QXpNFzT6QnPQTeypdjGANDKQjWD-ewY-PpZgs6lzwXLEhre8PxlA90snfM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqBi7lbvViSKuMeHl3PTArSr41smO-Vg_J-NG-E4G_hg&oe=6A7F1643"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=80eGG96sUzMQ7kNvwFfbzeI&_nc_oc=AdoSIL-P7bQBKwgE38g6QDTKrr2JQUge9-AuT3sxDDJND2acpbaMnJrQ-Dm3BShkwjo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEh7rs_PsuLVuyNZB1pxVOwvAOcTqXK7hBJ3y7XaDzuRg&oe=6A7F08B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IkgyotI1CsQ7kNvwGlUpxu&_nc_oc=AdpK9mTzoRBl71gL2ahkaw1Tw44WyHmPYAgy0nKINA3NNyCOlRUdr9ijtKG6LxWvEu4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF1gz0MhhHaIJHh4hH-GZnrwOEOG3rPbc5Bpvuj2-7ZQQ&oe=6A7EF4A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0A0Q_0kwIAQ7kNvwEy3Kpu&_nc_oc=AdpDz4Iz_0I8dKP3B2Y_ys1ThilB3rAbINbBgTbqOzmI8yNR0Znu_XJ3_0NcYsDKcuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVDkAZKM_qCqdl1d6oJfULIdZZWCrsolPAr-DC2wqADg&oe=6A7F2297"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAfESxtLougQ7kNvwHXBpAQ&_nc_oc=AdpWJVgzUzJEGgWRdW8lUbBMp2d4SxPWFDhucl5jX0IFibZWCW2pfhcNaBRk_IrGyZ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgNTwkzseeNXvrH1jbnlzxoRCAVYIBXUvcnt-foTz4vg&oe=6A7F11B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6LLiXbwJ5sQ7kNvwECByfK&_nc_oc=AdrssStruCEQMVgL1-fkeq4nmatb7kdHXOTJsj57XcTIoOO-r3UReqTq6G_UG2-j4u8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcz91nQ
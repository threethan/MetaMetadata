=7f20f&oh=00_AQAZ95pHZ-71JJI2Fu3W_pECjbuQEIG0cAtCJoa3MILbPQ&oe=6A4E65FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3yiF6Cz-VAQ7kNvwHIjgEU&_nc_oc=AdqFnCZDeu5zJ310GFCWVI52uTbKIMSoKChFgDMfnYiCs2zxIGiOvzwR3MhpUCCk8Pk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD8hE9824sezG_eOCTrDiSeSXRzHviO6jgq4BghmORT0g&oe=6A4E4EC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ITBZpY72v0Q7kNvwHa843k&_nc_oc=AdqsZUihTMD2at4wN8EErgcmgYMm9Q8X6c3769x2inXi2kEoivkHabgnd-_W11BAuvU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAv96sDgyp3a8433Nuy7BJwKqSI7nhW6CLh8H9-n1aYcg&oe=6A4E4137"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RTfvG7IZTAQ7kNvwENnkBI&_nc_oc=Ado9It_yaX_tnJqr5Z3eRtwlh3Bhz9l-Z8YgZJ7xxjWH8-JszeCloaQKvBdM81dStgo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxAL7rdN9UTfdn6tR9TI-BSogFHLad5IKuQ0608JWTMQ&oe=6A4E6568"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHblhAgZP08Q7kNvwEVrW53&_nc_oc=AdpX_PUHoUOUDHjU-13WpQsuygfP_d114lU-D6f4DbYf7HZIBHKSVNHQUKIr2dSXAoE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZb0dasE7dgVGtP77MYaVrXvMyeeVKgj8Z-rEAsk8KiQ&oe=6A4E5B17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE6PtoEwSFsQ7kNvwFR99lz&_nc_oc=Adoi9UVVG7yZzalK1sDi4vWE0fUF8bd0lo7JF5lFRzrv-N5LF6A0R7tGFYCdsvYrvxA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBl1x2RdXo6ke34SgT_PJ6PKjMR7q370KQXV5Fxq_Da-w&oe=6A4E4A38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDdVaLT8v_0Q7kNvwGtsxFO&_nc_oc=AdpaPZhFCzPOU6wR_hmwqLJbovHatgE6eLYvBTZMDRHz6HTL7tLFBGI7Hl6rAGddGRs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDoo_jap
=7f20f&oh=00_AQEDNmFdx1uXDEOKTUgmyndtS0L16F6HZudD1G3kd-3mPg&oe=6A7074BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDhn3IdmFF4Q7kNvwE_iUCD&_nc_oc=AdqH1VfVAxrbZpV3_P5ATU9g7wFomsAryg_pA4deAeHOWzdiHxQCVWek7uulVMTtTr8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJIgi-eNIgvtXsMVHTxdOvXGG8QwZ4QNYLQYPs1nF8Cg&oe=6A7095C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E5lPDjflybsQ7kNvwEkNi3C&_nc_oc=Adq3QP_BVewIBMHEla3Helbs8nTSAYEnoQMnm7QqkNK8_r31YaWIlw_xx_VyvSPoeRs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOwIoDfvHNLP7OcNQ7Y-CNOlLUWeXLQFLG1L-T1cr6FA&oe=6A708837"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B6wawPF1tdgQ7kNvwGxGZKP&_nc_oc=Adr0n3nB2spoGuOf_LqC9w4GrQSPfOR-yxdTH4tplZbSetVTZGKYqU0x7b64QhV8yCg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK164M7AXDbxNbIxyCpAV3jlZAbJDY8uO53zsBxsLGgg&oe=6A707428"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q0Vop4bS4pIQ7kNvwGYt8Ob&_nc_oc=Ado30i1TUCVlHltiXrcoFoGMweIhrTg-oEWZD2OZDtkUQQi9c2FQPT93VA_v3eg2phw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG1O493SNnSFaiEsSGhSLICIY0fyTRNyLd_UQRJU881Vg&oe=6A70A217"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrOYSIv6tucQ7kNvwEalRIG&_nc_oc=AdrMbO9aSUi0abz_wr_1xMX5TnqNLVGVMkDCg5C-c319NJvHTXsvLpNZfBwm0YJVm3w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGhXioRRSR_OT-2Im_CWpMuImT8Q9K4B6w8oOlyrA_Bdw&oe=6A709138"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QUHsVKchOV4Q7kNvwHFySMr&_nc_oc=Adoa5zt3rxowtNJOSkMSU--7vL9XrsduINzzSyn6wtDudI4JyGd4C7WFy7VsBaj_XrY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmFuv8V
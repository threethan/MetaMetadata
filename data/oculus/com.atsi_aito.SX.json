=7f20f&oh=00_AQI_PDMDt7bNUDEHYDrZ14VTyTPBwomAze6PmP2pfsYthg&oe=6A9ED17B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53SHVeja-GMQ7kNvwHnInWp&_nc_oc=Adpo8wKnZHtg3drevGPuujRNd3prM1ifohxsMCQ8241z-ra-cw3jA8Tv_CDNHaTVQFg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0o3oUwsf4m1YLKkz99PkXfNQ1v-zPLihcA66nXSPaPQ&oe=6A9EBA43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6H8GCT-F-QQ7kNvwG79W0j&_nc_oc=Adr-gEWdTDQ5Uod0qTXrpqE76ODRfeeeUKCB6mH6uU5m4NkmHRyQr51logJ5to6956k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCQN3j-gdi8VWYffIjxIQklsT-wQ_p3j72VSZoB43s3g&oe=6A9EE4F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8poNGJtrZUQ7kNvwGFc3Dd&_nc_oc=AdoT6lMvKDhZLHOGg49Ti7IDp3Llt1SJbmZdanBm4hMaFrMoVKu0kPiC1W5dkdAhRpk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINTkau0vVYF0_J-WIWMoDl4uVTyIgc0u1bVu5XZvpn9Q&oe=6A9ED0E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K4svexgAXg4Q7kNvwHD2h0v&_nc_oc=Adp65ZnX7H7DyCw16aVdVvC_HI-QAhIpohx7QO0iJbuDyOafJtmW52pjwPSeuLlbskg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3nXRECBN0kLZQrIggV_hxGqn8e_BnZBDykQIzyOneeQ&oe=6A9EC697"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2tJq8p0QJsQ7kNvwEsCwjj&_nc_oc=AdpOTDDyQorQl7HqAon7S7fEIDeFBhzsTtkvtiGzOWLTiPVMcHttHnGp5-X-h2jbAB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvG9IRdY13es9wXPgZsI-60I0larC1zRxcQ6OS9YG6tw&oe=6A9EB5B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHbRvRn02PwQ7kNvwEBOvWG&_nc_oc=AdrRDs0W0dUBFFTkFCXoMtO3Q_6mwfj27zvsy780THisx6YMVG9Y81FTGXgKGoBr1dw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4HMY1f
=7f20f&oh=00_AQErn1qSt9UgtDvMGTZDa2GvB_dGOwabGQh6YokX4M02jQ&oe=6A9720BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vY8WpWmg7BwQ7kNvwECGrg-&_nc_oc=AdrN1BHavvyDmP-W6ERyV_xT5HJ-y4tqfo5TPZvL6TtjUlEgJhuHba6ay9Iwz0_XijY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3mT1E2C6nyJ68xV8NJIk-IKk1xI_glAy8Gfoejr9rBA&oe=6A9741C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDBpr7-pFxQQ7kNvwE5r8mb&_nc_oc=AdpCKnc8_iqfmDPR0FFwX9kXgOIlGDihdBp3PwYEPTTPhBw78krDPkfH-M3otB1qr4k&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2U5ftIMftZ_DGeEWniHBxfpz924VWKI1DG9Fewo3QGw&oe=6A973437"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=94NhAUON62YQ7kNvwEA19Zv&_nc_oc=Adr8r2urkwca8ce8nRA3uZHXPQGKu8ofVk43aMUqSeunpFML8OD3o5_ca4FA6oZ9two&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwFs3Ik_HSUZSdZ2RPilQpQYuNA0fcKDmCND8z0ISzdA&oe=6A972028"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1g5acVWwhqMQ7kNvwFmZ-Wr&_nc_oc=AdopNTyHx9p2KPlCTTGXydLBpYBhn4oz5S5QyVlFztMt7Z9wBxY9kzpbO_Sdbr1TLTg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_FxvxJNfoZ8Y3U7wkouxLqbssewYsVM_Lg6d8zL811g&oe=6A974E17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=09gQK4RJNT0Q7kNvwFQ62uD&_nc_oc=AdqAezo8LrmvGoMhaGsVBG25HK4F3I1ylfCVHybkXStCLwG3Zc8FDNiv7qFnhg_39KM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGBaYxXTHC2jiVKFPrQLs5z2DCII_iY9YqSunH5I9ERWA&oe=6A973D38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1cIk64MOqoQ7kNvwEzji8C&_nc_oc=Adpfw_rnSYbLq6dYKl9oEaE9EtyPc142aLCxaNcm2yf47SN6PQ4zW27zgBgraTiZZbI&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv5voZA
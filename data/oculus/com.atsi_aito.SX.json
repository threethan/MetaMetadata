6WcPc-51mPi70mYD6jmzijDKWyQ&oe=69B29CBB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5U2aP9kMdAgQ7kNvwF_ljzm&_nc_oc=Adm16i_P1hzCrJcJoZ3LKEeTTxiIeY0b74kuJ9wMi3l_Fx-_jrg08bM0rufQrLdf4NA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzs2diHn7HaDR6miTYy3BGqALdCBn0WiftOK5Qt_X9Ceg&oe=69B2BDC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qzf-4AcfdSEQ7kNvwE20VGh&_nc_oc=Adn4h-tLl23cDnwkkL92YE2DovnoOBOH4dBAm1uX7pDcwd-ywOGmZeK3COTid1SgwlM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7W_6UNqxAJKb7fMR4WCVuc8nMTkN4vQQIV3OLN0Z5sg&oe=69B2B037"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4elZC5oOnTYQ7kNvwE7izpZ&_nc_oc=AdmJYXjmzZJbOVo66XKNsydNJD4Oy3PH4Uha_goCxRhUjSXGKYhaX5KNWTXbq5JrMp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwoZp9KiA7CHD7wTr7BnCWg0hsE4oVLgAuNoQ5awhMOow&oe=69B29C28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LBAbWjxu34Q7kNvwHdCDg8&_nc_oc=AdnPMw8JdUuxnpffbik90KgK5JDtaMMEk8D9xpKqiVIe3-fgFx0HBFqSrTTOVLzW_DA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwVCAiXDdW0nm_irCMd29CYkOOpFTmAiumGzblHPivIUQ&oe=69B2CA17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M3TiSghLD6wQ7kNvwHR6g2L&_nc_oc=AdmgOLOeuSqSb98njNNi8rhrP3etnSXknlgdmPNkBJutJklxrdkJ9Xi2_wl975h9Ln8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afzxb4BzS8RCkh-Fu5QB6vRKXZJ65snr8kB-WD5TyP03QQ&oe=69B2B938"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_1c6ovlg1gQ7kNvwFqjKEy&_nc_oc=AdkM7yFqQAn8cxcxk3BFk6hehUhmUtnisPpgR5ZPPvqad8PmdvBaIQzObnJCuL492tI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwT4TUeiVThCunDxRm90p3ILAHHo-pyS0mFMMgqZXkz5A&oe=69B2CB06"}, {"f
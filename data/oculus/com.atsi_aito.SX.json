=7f20f&oh=00_AQD3P37yNAWIgW7Su2-m7JGuSKIJ6CjENXiauZkfYOvmKw&oe=6A5CAE3B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kj6Gg0Y0aTUQ7kNvwFAxO1m&_nc_oc=AdpsVgCEmYHsMHbNyUTGKeJzHeLEI7_svbBzTanV7FxFsOVWh7gjpCXXKHxoumAonjE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy-VrktnAlfuanHo5QViEX9ci_z9hPdbcVvIXY8ipoIA&oe=6A5CCF43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wClodz4r71IQ7kNvwHHbYsn&_nc_oc=Adp2n5Nw4X07a3X7WZDJ0RAZuMqoqxD-B54ovls1uQogXpQzDXeVu-14asiNqAT4Bdw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArS8NkJdnTs7lVLd2N78sjX-AYsVTl7-OTbUpUAOQAxw&oe=6A5CC1B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kOF7Gk6L8qcQ7kNvwGb-iq-&_nc_oc=AdroQsRwhkYan0vIUGPeZhSVi0dbxLVVuEt_F9gyvnNArJuMklFo2p_WBuxY01ehOGY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCm95XyRHfyDxbPqgUttK_8yRhF9tVs3KPAOtmBtxlNA&oe=6A5CE5E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QT5YOIhofwQ7kNvwEsz5VU&_nc_oc=AdqZItdWniU_B45Ou09rNAuayngnWIRsRlAXDix1NrV3pKxAmry9F1UgOpyu3xr0g6w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYNh50wMFJZB61sKB6CNYaMGQSE7uiQ8_IceI293VZVA&oe=6A5CDB97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtqSjzNz8_4Q7kNvwGTXJeT&_nc_oc=Adrs0TMewyZGESOUGbryBUb4s1nxPTNPGcZ4zIYpd3SitBNYqFVcTEaUxLjqjM7JbEw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAykUza4UwkD8jPE8MCAmOLMPYz7t-w63shkZ4ZANsuAw&oe=6A5CCAB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WWz7RTbZopwQ7kNvwFB8goy&_nc_oc=AdoNgmkrc1CC1yBFhcszpqZ2TXfknHqPMeMxsc05-rDfCgBuey27zElm50jOq8QXKRs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHI9bET
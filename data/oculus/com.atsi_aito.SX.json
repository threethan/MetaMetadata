=7f20f&oh=00_AQNwQJYhKkkVdtDtZ5h4FBNK3Qsz5-JWF2jE3BaMisWFPA&oe=6AC1187B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lH313L6tVeoQ7kNvwGiG4QX&_nc_oc=AdoPupwCno1crbKdTscBBh6j4I7jAaLnzc3znrHpcgT1_DzfQ0Sb1P9qo1LNkXULh4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMvc057DtTrcas7ULPdRsQhhDKF2ing9A_6zBwkrJ4wg&oe=6AC10143"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UwhWiXbU48Q7kNvwEmLcfF&_nc_oc=AdqBO4TVaa1EdGokuN_OEY0Rvq319tTARQHYVCnfp5Xr_K97wM43OETH3jljlinMD1M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNo-OX5jYEsaWhDt68qtreeREGVTVNFRvZSv56nj7cLJw&oe=6AC12BF7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Api2p4EU4ssQ7kNvwFbDg2e&_nc_oc=AdpUSHu504DFoqt7DJc_bCwcEox-iyMqoOj2UlAzmGxytaTUXBnjlYMtiRdnDwfbyuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeoTyYM8EK-YOYIg2QHJyKjBqBgpVhliyg4IcgNt_5vQ&oe=6AC117E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgoNffQg46QQ7kNvwGDJT2_&_nc_oc=Adr2HRYKAB1d8wK2KOO4eF2S9kebRfxx6RubQ2xD4SyM-HDkMTCcEZB0jHIS10KUX84&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPF4_9qSYv81wnnT3fahhOZ1AZZIYk2roC2lNZJMkiaMQ&oe=6AC10D97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3DlRzjAx0oYQ7kNvwGoI2NI&_nc_oc=AdrbtS5DDwlYaQHPsTazVHXnhMEEo1MlD6cnLu1f62ioT6pO1XqvcPdQClwuHX5FH1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqiLTrtGyWtNaHE4EpngogqKP34DKZhANHmCVyqq7brg&oe=6AC134F8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_VJKV_XvHAQ7kNvwFajzWW&_nc_oc=AdradXkfL4jvWqocJJ2Ooxx2r0nlbnxek9VuwJb9brB7ejNpLps0D2jnRmRfbyJB94g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQObhKekU
=7f20f&oh=00_AQJVQle8EXjTNRWWD4lPR4M80YWeV1rH-qph20DTMZEFOQ&oe=6AAD51FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPhsVdAuLfAQ7kNvwER0vXf&_nc_oc=Adp2pBfo7acDQ9097DVb1zJw4NkaKRSELthhyP4GztzIDluNQAAls3i8IQ3vwVxYWkY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8xbau5K0lvgzB2YU71GrwkIvJm1PQawR9tFXianSiAQ&oe=6AAD3AC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PngWxCL53fEQ7kNvwF_JjVq&_nc_oc=Adr_TrsZ7Rq7mHGqg5W2jNdaP198ZoV7ijSc6WS9Yfdj9ZkSN00nKQeR7jmPnCDG_Q8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyIZwJgUdKzEIgbb_yYfFjJG43j8hFROKQZ7eq1gxjYw&oe=6AAD2D37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uEV8TucplQwQ7kNvwEGg75p&_nc_oc=AdoWWqNqHp-r7ilKeVWDdnL34GOSNVV62Fa5Dmrlf7wcPbf03oTAxp9D-09XsxA-3K4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyRA6n_aYHBgqKOrQPpovLVyKKE0RubmZCkE4sZI0idw&oe=6AAD5168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDK7oAuwqG4Q7kNvwGVJhxt&_nc_oc=AdoRZI_V0_SIXYHAOw-B2xXbf7KPHcGz5nMtJRh04ixzdn2sYz_c9hjQDNyelSVWnyg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFJ_LOaW1BVTt4TjkefeAUpPHHhWrRq2seoiuYwVH5bw&oe=6AAD4717"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrAJ6enLWCoQ7kNvwHDS6Uz&_nc_oc=AdpUddHFrxSAqeyxFZVcEjY8Zeo7MUP3SGa8k5qlkSQtOZ3R9a_XJn-y9VS1MZ9ZUP0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJoa11bhxTCx2SVlR4XbzGSH6i6etzDfGIQx1pCi7q4cw&oe=6AAD3638"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_lCn-y2rvwQ7kNvwEEDzWO&_nc_oc=AdrKu39-ZIOMaa3ejYf1x2WGk2Kd4mjLsB0o5GcHDDR2ngC-RX_cLI3Dir4SAw5dOSU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLim9Tyn
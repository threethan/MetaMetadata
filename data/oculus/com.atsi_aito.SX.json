=7f20f&oh=00_AQDauApqirE3mJ130hgVIsMISZqXAl95hakte33w_ybi-g&oe=6A637DFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMD0H6EaQWgQ7kNvwHNdI1j&_nc_oc=AdpDw88HkSfNW93PvHK5EPS1vFBdW-gbQjjSIvZAaPen_lZ5hmUmBzNqW3BiPxlSDXE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBH9DFlCoJC-vDPfIyalZ5iGpkjxMhv4pVIALkR9rflMw&oe=6A6366C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xohyCI1QP6EQ7kNvwFWgnqY&_nc_oc=AdoWabKSMo5e6uOp9qrgylrrIdHU8z8hBWAQTHiJlqQxfYLUppnvEQZxXyuwzHiQIvc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBOak29q2DNog5cxB0o1IVaRw_ZxOi-27WQE5g32tgHLw&oe=6A635937"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qgMDQL-ypAsQ7kNvwH5T8al&_nc_oc=Adqiyg8fMui-3T4_XkzW3mcSCF-FwVh2_sdPYP7H4XDNjgYTYfNAxjJSyPwP0E--Hvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDCR8C7WFBYX74_2DGIRuXERo0DzAAoBAD8SpK-wIGcAA&oe=6A637D68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VRGX5Sbo43QQ7kNvwEaTElR&_nc_oc=AdrA769eum7orxv1374gYnE4dYrHec7zBk2VMoAOr1DO0dUdOuqUmXNCRH4U9bGNZhY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsU3UDd5lEVxqwlkPSAnH-qUlr_m_B87HEmFopJhhIcQ&oe=6A637317"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hPAT-mwGaWEQ7kNvwHulLEA&_nc_oc=AdrDgnrCGriNidhp8IAFJBFB_jIMbX0i1qPNh8dt7ADq95DsYzdvSHlxFEviKCIcyuM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8FhkTauMO4NRPPPejskaOVvrfWQUbV5cCJlSlDzvpbA&oe=6A636238"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlnDh9CzamEQ7kNvwE2KZhD&_nc_oc=AdoNxBtnfkMfzXwtLI_Zx0Apvr889JOJfUQpVmyqdXS5Kb_pwJ_JHKvPTDgYVVyUaQQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOxxeUB
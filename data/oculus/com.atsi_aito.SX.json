=7f20f&oh=00_AQArNxcpKZxUMBKdrXnIP3Iug5R03wMNZ7QEHBqOs1JnuA&oe=6A60DAFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QnT3nmrPdPYQ7kNvwFBbGWd&_nc_oc=AdoUrow5TPLJn_kwIQVP1dh2v_5WG-YojYNqQjKVR3CTVlFgHp8ZJz1A8NLfIVVRqeU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrVuVYYs7ThxrXUtLl6ZsXjOI9rjDY39rUhmPqsa9v0A&oe=6A60C3C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xohyCI1QP6EQ7kNvwH4xBwh&_nc_oc=AdoDjlz6D3Qn9csqAc9g0er4NwvKcl_ie-yoGQSJiu0uYbYRfwrb0xCS_RXdXrsEFts&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhNExxK_RjjU3O-plrzO6t9FxQxF0v9ct-OGMtC5ODiA&oe=6A60B637"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUNvA3BPNrsQ7kNvwGB1kQ_&_nc_oc=AdoE7Hu1yV0ms7Lf05UHpiKB3e6TIngHCsfhyeuVGWnv_3XWl_mnlCNPgt67mf9ntNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHdJ4oi1hQYs4WKgcFb1eTEnK38ZvYUWEH9fYer5qlYQ&oe=6A60DA68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HTmaiCEuxMQQ7kNvwGWmGUS&_nc_oc=AdqnaHTpiXm5uC0kNGIcq2Nc8PThgC59Czl3pquiyQstOE814x4ZdAgglZbrGIBGV_o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcNdOg3zErMwOYxWN7mCH-wkprbPrZCUdeb8xb-IybOQ&oe=6A60D017"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a8b228A1SnkQ7kNvwE42Gex&_nc_oc=Adp4lX-Ea6uKGy2K_eCgrdPFSRYqa95gK6ZLAFosVNXtpOkh1AXdPlODeG79dIgCnCw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAPV3GnsKpN3uH8jUXe7qoyoWSc5BCzoaJxDk-8OjMb5w&oe=6A60BF38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlnDh9CzamEQ7kNvwER0JsU&_nc_oc=AdrZnYzE8yDLU33zQkmufK2fncdAzrGRnTofeNaJrlepSFuTrQ7CdI7CBAfQK84VEZc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi6mIqy
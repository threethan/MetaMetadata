=7f20f&oh=00_AQDDAZX-6Y9fpgFtLzeE_jIb2uIXHc5cQefs2x-oF7tYug&oe=6A68C3FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ff30VcWZuVQQ7kNvwGG2hQu&_nc_oc=AdoPgO_CVUsyRa-5-lK47B3rp3Y51fU-B04mR7C2WGlKt0CIUbuu1FL39ufKGkD-XpA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIbNHd_gb37fQbWga8myY-Cp__ucZomuuz33mhXanp_g&oe=6A68ACC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IL3Sy17z_NoQ7kNvwFjgPUv&_nc_oc=Adr9i3uKM3DLajtHWIbUM2nR9FGWv6qgTsaYXjsGMY3qHAJxq6Z-z4rXCPMJcNqv2xU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfDknRALEiFLQGotKc7j7zWl601guAJQgKu4OM8NQmmQ&oe=6A689F37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HY-xAmUENgQ7kNvwEy01TW&_nc_oc=AdovnC41-I8sB6YqN3ZZkEtLw_b-b_6sfei-MVTP4PmKTOZjKRziKDNIBvyPXSiE94o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2dOJjbe_DZrGZ0z6cIZ4BG0RLQQIiKbEWDZ4OdVy7Uw&oe=6A68C368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cLz0GF8Lk6AQ7kNvwGeV6EM&_nc_oc=Ado_9-lZnikpFKi_Q466Y27-8ntxnmWJLC06WbfFQVyYV2j8T0tnM8SEU8n-y4AS2fs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBwI_1H_y-llc4EwZC74N32QqijqlD-yUGG4yieTRkgmQ&oe=6A68B917"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkU62jap-n0Q7kNvwHVo-br&_nc_oc=AdrQt6rTHLMRdNOhUNaPQKn47mmj5GO0fbD2-BXPJ_KWI9k1rzyi7sB2hPZ2T96uIQY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBWi2hsKk9AoN7tLNOVEVy5jEB0DGj9Hdnfyy3JCNSjHw&oe=6A68A838"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_T9JeyvdZewQ7kNvwE2cYK1&_nc_oc=AdqUD0swUY1CX2Z93_rXyONnCPYPJJVuFopQNhLdBDDqpxnD7jO3nbd-vANVsN6Rnqg&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb-WncF
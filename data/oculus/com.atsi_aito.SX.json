=7a30f&oh=00_Af063LavsXkkUprJIkqHoYWUOgeR2tPURluArU05nkk_zw&oe=69EA33FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wFverxyrsA8Q7kNvwHp4kg5&_nc_oc=Ado1so7fPsB9DLlhTDYfjzMpXi4_fQxKk35z1DD_ICOczRYj7v201MjxFsIAKgACmCA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2l1M5k8J3xZJmyZP2Jbo3MSGR3c4oBb1g75GlrEg-kFQ&oe=69EA1CC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qZqwP_0DSKMQ7kNvwGtltU4&_nc_oc=AdpW3GcevU5ejhcf648sgDEY-M8qw4AZg9NoVPgzQ4Q_ETKl2tBpjFhYxT7EcQElCkg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30IB3-qbvyQDi4UuhNOjNaPL6JrCaM8ZP2c2bfLN1N-w&oe=69EA0F37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miAKoY8KX44Q7kNvwFpyoYq&_nc_oc=AdoRF3KOdrF7lt3WrNuF4uGGLavYa-1LaYmEXaW0WvKVwyAlxhEHE4QNYUmc8oIbZ90&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18mbr4dt8_0xjEVl_2o9MDr0EDAXrfo3vCdVFF-PCb-A&oe=69EA3368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDhX867Fh0cQ7kNvwHdH4vz&_nc_oc=Adp3Ehs_N6ZbV2cKrbB2xCSMrvWyR-YNu6G_SrM09Sz-3EjF0Yp1_buK6OQTI8dTidA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2IxXXX4xuyhK9hGiqXbUq8QFVRrOb416q3k2qpMLTNvA&oe=69EA2917"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru3lWZC5uUoQ7kNvwHoNzUi&_nc_oc=Adq8vN4tp0qGVl1wT2ka7KUjFllyoT4knfA8Igsvq21ctvQdK1L79Q7J2J9DrXb5V5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TsFthJ9ihX7g_fN38Gp05Tt-nFAf2gK4ltptrWICFfQ&oe=69EA1838"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlWNwwY1JK4Q7kNvwG2kTrx&_nc_oc=AdqltBksteNPLDPBfGgy6LBLFx6RslrcWYPUllgVv3UqTs8Uap55JjUzfOnOStHy7aw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iFadFj
=7f20f&oh=00_Af_9Tpy6BaXh6w0kMQE4DC3a3S7sMJcdio1NhaAyiF1EnA&oe=6A3164FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OSYt40PdjwQ7kNvwEbMbdy&_nc_oc=Adqa1AYvs62Eive-ErekO_NfM8tBZG0fJNobSksKbtcogvfVLirODo8B55sf5s1lRP8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oO36Qm2FUdb2ew_wxA6D0HbiMKT8FlXC_ayxc7hgrmA&oe=6A314DC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G7xxe8iVYKQQ7kNvwF1nlzt&_nc_oc=Adom5V4Eq4RYkURNN3UWo0_J6pKnHyrsYIlRG_Xwp_kB22DXWrQn4cLIs_JeaUPT5ss&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Hs6DBO8KdvD9oBoza92-t0Y8ikN79s8cxowcCrustig&oe=6A317877"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LE0L4nKtFRUQ7kNvwEz0-kf&_nc_oc=AdrsGsVGQdSzfv_JaXcLGLR7s1lGMNePLjsMXlbGFd2H-wHyoxO7E0nFTpJLA4pfJ-E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RpH_2LKfUXCd4MFfpNBBvwkIWVr_LXEvr6ZWI2tcWoA&oe=6A316468"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uudCN92pEM4Q7kNvwFXnItA&_nc_oc=Adp9IxSOj-C0UzHCSzsQBGD-DNJkjx5sjm__VEIRynpsCx0s1RGinbVnYrXtdy_kJYo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O9-FJ7npoPxL_Aq7jSfPk3Ah5pnFHmFhRXHQLDqoydw&oe=6A315A17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkybaVy9AZ8Q7kNvwE3F4tS&_nc_oc=Adq_wEG-Mapnq-XzaroWHaLJh90NKkeSjycc6hs__c3heZRdLYihLejQidUeba0VDS0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-79vJDNu9ozrSPz0zcGUTj6xu5r-Tcfljn-i6y_vsCbg&oe=6A314938"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arzipeWqYtUQ7kNvwHZTvJT&_nc_oc=AdpZdiQhR0hlHU1x8Tya0RmsIQM5TQybZ-3G_lI_77P6HeSAVZGDM6qC1ZNo1y2Elko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CzthAP
=7f20f&oh=00_Af9Zu8s1OGl9gtqmV7MwV6z7aUw6QEbDK7bd1Ze3DaO23Q&oe=6A3A9F7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es75YtmO8YgQ7kNvwF0brpe&_nc_oc=Adqwasxbc_cpBGXv8dwIWnMLfDaASHqrcQZ_UVvYPbtQnbnP1NkNRhUIdyTzbChGRAg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xRStCHo79VD_QpuuYTIDpsKzoeHOs-YmCezBIbeP9zQ&oe=6A3A8843"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5SmS53fiu4Q7kNvwEo9L--&_nc_oc=AdrNsUArHuYsZDRKSqIgSTgq5QcAGAk3kmpssAoHkAtfz3bPA5uwclzSPpbF5NpHesM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T4nxMpI-u8_-nFlKQocztnP6zJr94uBdFxlJVgi_NvA&oe=6A3AB2F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYhkUNPqbXsQ7kNvwGTELHL&_nc_oc=AdqZltrH2ETC4CKXXir9AKQNp5zWKJl3JDpKrq4yQnretNe04VKxLsApLgW1FprpnpA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9YYHTpeSNcTPltLihNNHPg1dKk0bk1tgYJ2UKq68_SoA&oe=6A3A9EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hesfm_35FQQ7kNvwGA6C19&_nc_oc=AdqzfsZItQur8NgxRbQI4z9bi1nCp-ohuKG4HD_V52X6_PckXB36VusU9mDA9YnlFzQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pDZLi_n_JYxf6SCi8bBerah3uA6k9ob3ATVkPV67Sug&oe=6A3A9497"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=144jTZXkT8QQ7kNvwFXryrS&_nc_oc=Adq_6VCuBvs_bxgUr1-Qx_5AIRslmDRa2MgDHTfVWM1qnBzjNFpMqRuStwAg5_q4pkc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MB8tJsj68tXZ2J9HhOgXZ3utDPwbb8_wl35mj_QQ7hQ&oe=6A3A83B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeQlFKmbn30Q7kNvwEjwe8S&_nc_oc=Adrd37_8qdNUSkazQQEFt-0knYtr6KGr47iTlKo1QrYGleFr4WGLQxSb-G-7NiHmFa4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af879vJSE
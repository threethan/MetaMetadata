=7a30f&oh=00_Af2J7VGiDIq1mkYZYMZX7cERv0oi_EHJ6GKg5usoev7EYw&oe=69E39C7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiDpE16sED4Q7kNvwFoPGoG&_nc_oc=Adrsr_fVJPUpN-eJ3VeaZwvAqI2dB8eL4LXvq8DbDDxApmW2U0lAdtGzRidzCxtrqdE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1wVdTCN7PPrimMZqwc5ihzURE3XEucFnENdnSJdAovMQ&oe=69E38543"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HF8iHXvu5lsQ7kNvwEeDj-z&_nc_oc=AdqzJ3P-jIKLJRhcUYmYNeIgYS6LiPtQTYvdGVbBQnbtIDi3Z5iyUdaR6VN2kVFKSoc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K3onuFPGRseC37Os_HjSEz4gJ1RZ2T-T7xr3AP3apcg&oe=69E377B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Eoa7ddHzhcQ7kNvwHjP9Ne&_nc_oc=Ado5u0W1Lw5ICSZ6hJ83V_XirSdOoZyQ1-3_sD2OgX8GH_3Nzvcd5zwysHu1sfHH1dc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sfZiu60P9MBT9cJZxmUSg0JE4lMr6QcXP_ij_oCs21Q&oe=69E39BE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BErTYP1j5B4Q7kNvwGxpjFf&_nc_oc=AdplgG0xBC9dRShP7fx11WEHKefINu1UlPtBjjk2W6rZl8UD1D3iz0X6SQSZlsWbVR0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1OEqfaRyRnTr5RO5vpGbr6bjXBqaxvA1DFhikK99YaCQ&oe=69E39197"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwlQPs6oZvQQ7kNvwEWnOhX&_nc_oc=AdoyLiGb0wPjoZPcn4C4aB4CrS2k67oQZqZZhGBTAZKivSsSeMdh6_KLcIN8vE03oTs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27Jdneoz6pNICrwAIVDYrz2zjK7OCfRfwbBoAfsugMsg&oe=69E380B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkyrbF5m3ngQ7kNvwF6BTUb&_nc_oc=AdphijU2vOLWgjyXBT4NteXyC6hZkvWISA4tjmbqUW73ncOETTh_srsepYZbBQVuefU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3F_EHoP
=7f20f&oh=00_AQFZ88stUVashIyS4HkxSmBWMEfVDnKVNRPIBgDV05jcdA&oe=6A785DBB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve9DJ7bgGK8Q7kNvwGno_7L&_nc_oc=Ado3eruzP_EtpBadiSPFBahxh_ZLqat1Q8KP43etNs4NE_VtGT9TR9wCW7RH4Ahzkpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3bruCFvAGxD1ZccHwcNFM8QZNfH4aTO0YWKXGGdt2UA&oe=6A787EC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlqh9kA-PowQ7kNvwETwBh4&_nc_oc=AdpYcvStVAhKCH8JDS6bfnBBZJubDdh7Tm8CAbRgt5Z8WMVZEfyvVfFoTJITvDeIK1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIVH9xsWHkiksbmzOM5R1cf-UyeuDPs4_fNrVdxXwt8w&oe=6A787137"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mg1SksLuGPIQ7kNvwGXF_y1&_nc_oc=AdqG62ahYwKMwhuwyk2DInR_3ns5mLZfx74Oe5MCR5Gwe6dVJfFrFviAmuPmpOvv-YI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH-p7qQwLxAos30GYa98QwoQ1vkYW0okUUaUsL4vrf2Fw&oe=6A785D28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4F-feMQEaoQ7kNvwGfqLOA&_nc_oc=Adrae1p6lq7aH_BftNT_BbOdJzAZQma6Z6uJB3oQXytvneB8DmtquR8nfEYjEEwbanI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKRbGGXihHs4xaaw7hABZvOskOZ8p1E4kkXi7mfY74jA&oe=6A788B17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsLjhJl22kIQ7kNvwGm6h-j&_nc_oc=AdoUie4b2KXCW2Ugszn6t2vD8XXfV7dE45xzb5glS_uygLspmrxGRio7oMC-4McwN0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnRdWI66nyNiDSCG3fCcCToPQ688oISM_8BbNQutybuQ&oe=6A787A38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wIWuD4esAUQ7kNvwHSpbVF&_nc_oc=Adruy21UfqHc6uDkv8SjCDujH4o_coYRupSGgUs1Awj59Xq0q22c5jnOBi3aforTfXU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3zMs73
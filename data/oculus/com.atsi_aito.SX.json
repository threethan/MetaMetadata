=7a30f&oh=00_AfyBcA5cDq95KxITp-QenJ0qBH68F5PoUFygGDNBnzFswA&oe=69C6633B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lh_1YBy6FsUQ7kNvwEh4gXl&_nc_oc=AdqML1M0yuHdKz5-JCU-0LmaxIXVWzaJN9WtwysYpFZKBL4XX1nXVpkd95vCFwEjj7g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQOk-N8hU-zTjuc3gUllC-dfjBAU5w2ndS7KwFGh4vvA&oe=69C68443"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dSzDtAADxIQ7kNvwFQdhEn&_nc_oc=AdqXMeObVEFZ7MURNL_ZFdbP15fb7L843FFrQCMqrg_2ePkGOyF3V2O4r6LR7C4IpQ0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz5t-MJTG2MljDWetial7wd4i9-OhIvGs20xTYFTlraUg&oe=69C676B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urxh-wXdzjoQ7kNvwF4JmE5&_nc_oc=AdpqFsbu33Zs22c5FPorQ1-CNEqOAbEIRA-gmi3_7mYjXBjQlWlgYXxstbl6ttXGTTA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUXXy4Ef3PVj40JnMnwBtp2oZMzgyx2qfEaJDqSiRAGA&oe=69C662A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMX93K7IWDgQ7kNvwHc3jWB&_nc_oc=Adpc4u02EZAwb_AU0aHjBdInLIlq4qEMvb3igiuu5S0hGZtCZHarlG2qZl4KwrKkD4M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIUzTB2G_9ESOBEC80sOWNGMuDbGKDHvro8hOSDW0Egw&oe=69C69097"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OXn56CAFJyIQ7kNvwEhoMwW&_nc_oc=Adr8rKxojeY-jCHd1ttztsVaqyowkeRU9TSA3IX2NLRYRwtk27fES1WH6M7ealKAW38&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9Ii2dmUGwzhS_wE4JmNxiVxggj2cFi2DemtlcmqkpwA&oe=69C67FB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALusMMnwEcAQ7kNvwEa4P3v&_nc_oc=AdrxUOBCZkEYebIURBteHOcgmn5O7xj2H2CFyyUryiyYuCAyrXsPNhZEBZlype1Xzo0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwbImhpv
=7a30f&oh=00_Af1MfplBQSZEG432s5ocicL1D2soLSy5k2aRQwKyvH-eGA&oe=69DA61FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=maepw6uxia8Q7kNvwFFA9Xa&_nc_oc=Adpo7i_vg2FQg_2CpRexzOAiag86d0wqTYJT3dl9qBQsyPZdiEu4NDnQ0razroXE5Ag&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HImMKWTlDaDFvWvmHJfXZpFlzYXEYLIt3piK3nFT97w&oe=69DA4AC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cx06x35C2qIQ7kNvwF1dbnn&_nc_oc=AdrXefFHeH2cFoLTC68hGO8G_pFwtucU2Y4zR6A6P9vpW1-ZdaxcaqcxjshE-rNslp0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05amitczE31juSKWU-4ssLlpXw0-dVg3p8XXxQJSyJOg&oe=69DA3D37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRP5-bfGOckQ7kNvwH-hDNo&_nc_oc=AdoAAnDApvbU2Y4WNp5f7fu6HK3v66HrSXYcQ-ljILUpn9kLWCguligmHe45pW3fZec&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HVJMtWyAMAn5Aq1bGQWNevA9rOfl_a53AOMe1Iwgieg&oe=69DA6168"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnHyl80fa4oQ7kNvwF2prks&_nc_oc=Adq6-9xib5BmHrZ0xOGrEL4xJm7TDmRJtAbNPq-_jzjBFWSvVMXQZevIFRPF2M1cPeg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21_zqo9WuCUD1sq3FnJ7PNvf-iqJMGltv3VEjVguje-g&oe=69DA5717"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRz4im9SAAoQ7kNvwGZPR8F&_nc_oc=AdqfKquJs1L7lW18wC-fn3D2moNQu6NQLVWwhLQPGRid4JFfSn4F5tRQCFfFm465ERI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UdOAgpis7yF0DbZhU4uqhybD9skybZIPkgnLVdNz8Rg&oe=69DA4638"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ohTvcGOpf0Q7kNvwGkr33n&_nc_oc=AdojHfiMfdt65ymFUAciUdmr9R1z2eZK5FepA5TjD_FRMAE81fFRMXr7ta5SSDXcWDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_D2KPh
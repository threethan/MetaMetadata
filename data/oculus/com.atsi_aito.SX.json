=7f20f&oh=00_AQAI5ezf4q9_dv6G3W9z6bZ_cKnm4ZSmjkBcG75eK6CfzQ&oe=6A525A7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVp9Sr5MUT4Q7kNvwG9pGGc&_nc_oc=AdpD2C6H6oHhff-TE3BfePz7-W5xT1ZsemqWjIgyrVoXDZGJBvcQSSkb5nSHwtfj_hc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlG3sd22-7WE89-iLl0CwC_RoHwMN68lWTGFk6eQ7VpQ&oe=6A524343"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nw5W6wXmOA4Q7kNvwGDUqsw&_nc_oc=Adoqvf3IKXcRK5uaKVQGfWI15uxRYNdVwP_E2Tpdvjx7VHOM5fe0F_xLZ2WMY3tDsW4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjyANLsmQFAvBxvc7XXSBf7SX87CixB4zgnJkhmsHg4g&oe=6A5235B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcHHKJrWQ3EQ7kNvwFLU_F9&_nc_oc=AdrxYRBmgwxM81qxFhCyMZo6xz93khkDMmKAketDqRK2ZwPY56EAxJ2tU6XNHtv11bI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKpa93IhaXcYEYX7oDaFDji0ur_cxf_TnzBDulS6BJbw&oe=6A5259E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OshZNvforHoQ7kNvwEPKWBw&_nc_oc=AdrK0XEJ04yJ6LjwQwY0BoIBDAM6WnelypER0Al4RWCEbPUfsBBG4ebjsMZsIUwC9GI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBT6ASFCo6xkfJ4U5MkX9kg5TJzFc-UgptQLqKFFO7PmQ&oe=6A524F97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJ9Wz1DHMrMQ7kNvwH5MYcR&_nc_oc=AdqRmXMJJlTAWiYXBZV99RnKtc1eBNXQLyzUY6L5PlO4T0M_giNo9E_VX-VLBdzccPY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQq-CFJcfI90pA1k6d1GjWKxJdi3WghSZxjntKCOnKuA&oe=6A523EB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nQwvLDWEHpMQ7kNvwG-loWZ&_nc_oc=AdqwRQnKKeQCNBVYZBg_QBg0lAYlFk6GAbqA1XWY5IxsMcBzKUaV1bavU8rSAHRTKHc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAWinjLr
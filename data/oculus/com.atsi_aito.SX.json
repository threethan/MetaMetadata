YSzFn0pHUaoSoE2ML8LBLnbBTzA&oe=69AFF9BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY_Y-su1GkoQ7kNvwFsdhOh&_nc_oc=AdkeUFFsbEbQmuFIGRpRARQqlNAsQi5zRGD-zSFvb6oMiVXLRbFtmUa687zL2jpho9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfySPtrXaCLkCwesEg8YSStMeW0gbv4I2kpm0Q3xXRsdrA&oe=69B01AC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCFzrhelT3IQ7kNvwHLbGOZ&_nc_oc=AdmydO6hkwdwF-WyTr5MrQdPZLiq_7_3FRMa_9SJ5b_RiCFcO4vPjZON2X2Xl7POXOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzunYgiRoqebW4fBHqw9npnkCv8lzlP6GS_Sol011Sgpg&oe=69B00D37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4elZC5oOnTYQ7kNvwHyup8M&_nc_oc=Adn9smnPoeMvQ6UrVo0bAQL_A4n6YHb0VLB4F1JWKbltqRyjg5kBrvOHNFqNK-ZP4C4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxC22P0C9hz_upyBDpc3sCSsSeveKj6fGzfGbDFnO4RyQ&oe=69AFF928"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LBAbWjxu34Q7kNvwFs2nLJ&_nc_oc=AdnQkci05bvXLRmwH1mO1iyf_culSdtGDC6ga-x2De3OIT_3Ev-ilvsjn7nzRzHILyo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyutMHAhdgsmAveHUb6uFdqpATeFkDn68Vm4pkzWWzdUg&oe=69B02717"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngZT0jheaqoQ7kNvwFhoVUp&_nc_oc=AdkL3LPkuSjjvITlvizW3eiqEq4hzR-_XrCFwGOhTl9buR3uZbzsacaymHljnwDxxow&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyxETjO3CG3G9BrT9dNmqBg40ba3IAYGS7s68LuvhIi2Q&oe=69B01638"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4fprZRmJg4Q7kNvwEiDbWm&_nc_oc=Adkm1OvSxr0o-3CXB9IeGyeFqmxfL8UwqcyR01plsfw5yBjRHSA5Yh4DvttHjYQXLyI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzMiJmUttlV29KVORAxLDxfVj8jGjxF6BXV_54VHqJfUg&oe=69B02806"}, {"f
=7f20f&oh=00_Af4pBU9sd0JS-3MmGuIPCSmc3QVEFNQih54aKlpuv-ONxA&oe=6A19A9FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpzuppaUwg0Q7kNvwFl7dt3&_nc_oc=AdoB_3oFUxkZs8bfgl482-xG1xKq9djdYbdQ154-O0vfuuGuWWLwHc1033H2Pw70VE0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jvA7JJNfLOfKFQXms-jKWSnTsPN5n1hbA6z3lob2UuQ&oe=6A1992C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY8Sukp2stMQ7kNvwGbRMvh&_nc_oc=Adpt5Rrc3CnztQvHvmrA0n1dSOghiyiXbyIAEXAUBtZG40kyZpiM1PdPZJrepWfEwTY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KIWyu4JpKvEw_wWZ20YAt2fx-suuYBaQPHNL9URbnYw&oe=6A19BD77"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_hsjyVhrdMQ7kNvwGn6gSu&_nc_oc=AdqRVu3w0A30zIA-PIFz58YwcSroCvGn9HLqhSlWokl9N0ATyMBQ1xbdin4jyTnn3pI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6UyUr5lbe_UQiVef37uM9zSDLsfaTTEisxM91i57UcIg&oe=6A19A968"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfpNydjRIpsQ7kNvwELAGvH&_nc_oc=AdpAmhcRoGtI8ULG3tMzwz5Tu01bR4sags3R9aGgmuUi4ZRfAFMBE5tC_bMIcGyqADY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5T2SUYmNEkTKue_ENltusVuM_-zxHcQ0dNlrQXR1Jawg&oe=6A199F17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAP3OZfzeisQ7kNvwGj9W86&_nc_oc=AdollJaMYTtM-NwG6LNngyZ4AHfmVHZIJMDlv02O0OxFtMePkepSZzpH7SARcIdcF18&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4dAAB65C210waAIsR_4zPstwgzgGHNtMAGYAkgWR47uQ&oe=6A198E38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dpgGt5bc_MIQ7kNvwEAVy4-&_nc_oc=AdrKEHe3y9UL9_ZVqfRCMoKxYeGr9Sx8bn3EgdmyvJwh2eV1mvtuYkUpElT63A3GRDo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5QYTyRs
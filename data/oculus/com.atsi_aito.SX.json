=7a30f&oh=00_AfxtjsYOf3dL2K14pw2f1Hy8UJE-myZH6IcXtPXjrXMzRw&oe=69CCFABB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eT2tMXT1lgYQ7kNvwGknRDA&_nc_oc=AdpQAKTJT2VYD_dyN7dgJwM7onDIMMsjHKWrVDKhgy5ey9K-ICxASLN8dGWoUJ-0StQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxn_e8a9_45BoiLZuA2jJwP_2i6mKE56kaHZc7AiJ0EeQ&oe=69CD1BC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c3ty0M-bC1UQ7kNvwEwnlwl&_nc_oc=AdrI2fy8UccDBijK3LNah9_IUL5Ou1sDU_tS1QWyRxx6JeTUJkL4wr7pkTZwV09NdS0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwj4e1PO1dGjbyjPyuCYt-HqZixsTtCQ_1wNBRiHqhTxg&oe=69CD0E37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zMuhpZp8xooQ7kNvwEM7LTH&_nc_oc=AdrGmiXEff9cEEYv7FNtXzcJZENYvPbVQSjZlJ56MDTZozerqB3mcEVlPGYgIkNrpLQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw-yFk7lY3EuquQh6CGXRNCljB6wxEZoeWVwG2D_4d5-Q&oe=69CCFA28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MvluIM1oJ1QQ7kNvwEvSvsh&_nc_oc=AdrGnW10ynBBqBb_0JlLNd_SSZNSAJ4QMG5LAxxlSLk3RZOvP3Fuso8l1eCGISsFwSM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxV1-GPglmjjhQJPPH_2ur_dQsPnGCjottUipJ161GWoQ&oe=69CD2817"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72JKaBtHxfgQ7kNvwHIQIPV&_nc_oc=AdqGcXeJ2eHDsemXLmaV1TNkjTPGITeoN480R-ZM2qW79H6VYHC1SUqbG5irUWXftkI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwK0Nb1QviCnhlgazj1VOMWB68wiZ1ou5AyOHw01f4aew&oe=69CD1738"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7iIKu6AlRoQ7kNvwFngO2G&_nc_oc=Adrt_fQRnGdH4_tE4yLZuwu1KlZIVmo36Ehh4zjETJVXqDy1ODIG4y5b3t9qhMMD7lQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzFvqZLB
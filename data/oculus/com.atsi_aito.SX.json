=7f20f&oh=00_AQJ1xkE440sRNEO9nJCYc5ByvtAhoexBIpBopBHUxlclIQ&oe=6AB92F7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rohsgVI5WgQ7kNvwEC1cid&_nc_oc=AdpY42neZ702gH-mn0v587bLcIY06FXBtkv7Z3o6UVX2lYLAbm-az4FYuR5Oiop49TY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnjWPrpjlbATv5vnUunh-X1zhy1kIwth8N72UmMQIA5Q&oe=6AB91843"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jhc5PC0tWscQ7kNvwGvUK8J&_nc_oc=AdoO0KxTwjl5v-JHkA3PCf0AzWOET8Yb93cuAlM6TS-Ni2tqKzx_R1UzachU4My1g90&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLevYu1Tw7agoUWUTZUC2rSL8rswGinJdNyVw4YgiH3Ag&oe=6AB90AB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K9Qu1iw83BQQ7kNvwH5JPgG&_nc_oc=AdrZSJYf8o97FZ5kPxHWOiLOVCZNFhYLEH5it3IYoJkUWGJKPO4igBWhFbV1nbLZhCE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAT3faexKsxDY0HLrfuqYs7edbYdsNBDQbW0saeefBjw&oe=6AB92EE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_GI_pu1THqMQ7kNvwF95OqR&_nc_oc=AdrEwGet2aWd8xJ2dMLVLpVH7GndjYL-aHHCrSzp4Nqv0MZ0usjHinN9COosx50IKyg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0pFsAvHa56W4Gj_0_F7RMiVCkt8Icl8KMT2TAjllTyA&oe=6AB92497"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=27swzcqpJNgQ7kNvwG2V1Vj&_nc_oc=AdrMT-ZPKrlViMrvrKGQRanSUFjGCc8HqPawsMm8SZWRRme_qLvT9ddzLKN7DRB9-Lk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAThZN3IvG89G_8_7Btmrs4wb6PYhQach0fn_krUHIuw&oe=6AB913B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuCcpnVMzPkQ7kNvwH5g5u4&_nc_oc=Adr0ycBg97E0P6kKX5jnG5WAtCwo3u0RB1d4eFDJG8Njbptpqhm2qIkz6YavwK7yjEk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_ai5dF
=7f20f&oh=00_AQNpyg0fu22yu5qd0QgAUnJbgTePno2MnNOkFYcM4s5c5Q&oe=6ACBA47B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5NIDfIB5awQ7kNvwFLc9-L&_nc_oc=Adpx1p3CdcRQZVzmm26ATAPNl3JCxvQEjtj3VJc9vBxxYVqo4d95OmRACmGdNsWz-0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1t5GeWgwATsGlb3-dVVwpISY_fPe-BB8Y8V83sVwwEg&oe=6ACB8D43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQyBV0bdRM4Q7kNvwH1vZo4&_nc_oc=AdqkieE50UMakaZftbIESqlFKyObnwTtsFxKzJ45FfgVh_EI433JDh8j0YoGDjYxgoo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfEZSSpBxjG45WeHzzJWhyBKJKstKsWWjCqBO8Ddn2CA&oe=6ACBB7F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rfYkPR1UhAQ7kNvwEHPaqh&_nc_oc=AdpGi7w8P_RIG46geJuxvW6x9luJx0e9EDQfTkLfPyW4y2tA-617ZzCOSpdb1fjilbY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMFZmS_VemLGNPIcFRphxUkTCOVI_1pGD2mxM2yrvXamQ&oe=6ACBA3E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLI8kzZ9Gi0Q7kNvwEl9SRC&_nc_oc=Adox3lZdOW3Heg8aoFYP-R8qdtzXVbO4kH3XW7Hzf0s838NGTiDRoUvnGNmqbbPEdgo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEoax6yGMdbm__uCS97DmC1AfnvFOsRrsf7sGZiSiyJw&oe=6ACB9997"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDPZSWEBawoQ7kNvwHqzp0K&_nc_oc=AdrNqZu-PoRVJ4B9usDm8FSXjyB0Wt9vL1gojbnerOc0hL-vArqWCMvHpgrOSehnr9o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXBrPLWG9HrQHpDeByFTL3OMLoSmiv7cRrqhmIE__Ujg&oe=6ACBC0F8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEvaVT9ZfmgQ7kNvwFvJcya&_nc_oc=AdrplkTP3haAezWsXoOB_mMQ4DTILJt14Fj6Ll275ZT_yysyVW08UPck8VkhmqDRGbs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2BQJMy
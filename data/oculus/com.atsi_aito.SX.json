=7f20f&oh=00_Af8ArYnUP6lUMD7PxowPY8DYcWlaFx5RotGsnmnVh5VS3Q&oe=6A3E93FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG6T4LL-k2wQ7kNvwG45Ct-&_nc_oc=Ado5_6u8AcRY0QQ4JMnTOtUeoiZ4KILKVW_8jwTLUrXprfrcm7XDt86uNiRiqLveH3E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nPayeu6_cROFiC4Hu7tfCPR1u6uSTk-UyAaB_sP23PQ&oe=6A3E7CC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTc7mYgoyawQ7kNvwGg9NdQ&_nc_oc=Adq7bQ9MlMeP2fbvYlNWNAMRCWjWWwpMyBEJbpExRBUQhB4Sd03ZOH4KAVFSBvA52Fw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5N-_5O8NMvdtsal90C-Mnssf4py9X3JYDJEeniu9uSQ&oe=6A3EA777"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urIoVe3PqjQQ7kNvwHdoCtb&_nc_oc=Adrm3QTMKC0N4rZy6LwmzK26cVW2OohoKifISppftcU-PbEovEAKUwTziGsBXoP12sg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_55m92PQm4JmhHf4y3dAllYIdgqj9mTDLDdh1N9UPxDg&oe=6A3E9368"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtwJa61rwLYQ7kNvwG1s0ft&_nc_oc=Adq131JPSQ8wHskHGlcy5Xb0MBzqISU8VpRdIi6Cx4Xs_ub8-FdGc46pbbj3m4J7qKE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RAfbyFU5lLegXqceVfULJhDQyFPMvdw7JlHMp_ULDKA&oe=6A3E8917"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CexfLw7vC_QQ7kNvwGyI7-E&_nc_oc=Adq4VN4mJwyvImet7H9sylohHvTzwiqLmS_E9PibGEJ0_ak-9Es0DfPNKWYdYhbsY38&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LjPx6f4P3sN6IxRfptAW9kf_AqAB6HNwDmGqA4wjIDw&oe=6A3E7838"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bYvEIlhBRYQ7kNvwFYcoaY&_nc_oc=Adq5ujp-cNkp2Y1ktj-gkAPmPyL_KMBZouywUfgUz6YUdyM_XdF8sNOcFv3xoVRMXhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9kAlOES
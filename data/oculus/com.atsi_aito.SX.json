wCR9p8NWoPBAihMHuVFD9ChfXxA&oe=69AD56BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m62fmNelc6YQ7kNvwGyoG09&_nc_oc=AdmikTDKr1MIiv0kFRhQlMonfbDyk0FXXdYiWWZzZxtHliVVYZc3q2PFPmeob7lBoo4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyFohasCLpeMjE5JPzkBIM6lW96SaSXsSEGwEe7T-RigA&oe=69AD77C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcL1ZTsydjYQ7kNvwFj2Kly&_nc_oc=Adk_A_3rXk5fBAAPofiWMENFOf-aMEX0TH9ED9SzO0nWRKjR5obkbuK2WRqAOQc6AmA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxp6OXoYHXQH_-IpneydgQEpHV2yGisn3J3J16q9IxhfQ&oe=69AD6A37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NyNW7HlCWYQ7kNvwEp_bX9&_nc_oc=AdlpdnEAaeQG0hjVOAb1e_mQuMOs3eSIQJlvbtYAvW7ZpvlmI7HK5hyBU7MXuUjM8i4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDPXPu5M1Me6ZF4UReQnGWg1P4uVBkpJazXtVAHzJikw&oe=69AD5628"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EqW0-rUxiMQ7kNvwFunxBf&_nc_oc=Adnc1z89SLsfXCCJEoza0wsiqRJU01pgras81HPRaOPCzkm3rGnsau0O0YthdrIhwUM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwi7B9_9ihTxy4YSOBnJlYFZ9LpKWHtqRjmKq74PgR83A&oe=69AD8417"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngZT0jheaqoQ7kNvwGybrYM&_nc_oc=AdmqE-Ld2B2j-bez6Kz0sJYWijZRXLqIZIEwqXRj-ffyZBBLBmIMXLKpU6tVkK9KrPk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9x6k6K3h2N-7pOEwZKAMfrjzVB6yvC0m7XzmNmx1nbA&oe=69AD7338"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9C0E4vOlvqYQ7kNvwGCY9L6&_nc_oc=AdmkACYd6D5gvW2SciL2XYrplrhl1X0tp88W348StHbHsyLo8lsxo4DNQRviLx2xM5M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy9ziLWzckgibEYZUhFb6RBtQrXvcfKGIS8B8P7wrovjQ&oe=69AD8506"}, {"f
=7f20f&oh=00_Af739CbX6b52A-J-dSjoBD4MJazOiaiKoFRAs0qD-Lfccg&oe=6A009D7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D40qOqkn6OQQ7kNvwGlZO92&_nc_oc=Adpu4Se35DLhC3rAfzApprPLAZmhLJd8ULfSiclDDRq3aQKxPoteotoXc2fT_Z8kjwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6cSY2rCex7zAVt1EwWEl2aivsuKh_7hlX1ajd03kFo9g&oe=6A008643"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FWNrf_-yYWUQ7kNvwGBJd-A&_nc_oc=AdpJGg_1wtDTGW2i-nO3sItly9gLLBHt-wceh2PvlLDy9Rg6BMgFUpfBo5SbKYYBKME&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7N7YY8xk5zkDdp1vBpBasLJ3HLgKwlFoGXNs-jsext7Q&oe=6A0078B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JO0CkmxqNcsQ7kNvwH6smS8&_nc_oc=AdpefCNETVJJ7_uiPV2el9UwJIGFCRtuMeqHF02fafgcXUYB1K_ClsWnMgPA_TdIMFA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40i8oQHq7QMVEEJt-tD0p2ujV_FHgLiF-zZaJTPhhCjw&oe=6A009CE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWQjsq6LWDsQ7kNvwHe1Poj&_nc_oc=AdqRlZvnIAXTEN0fEBBuBhiQ-5-meWW3hk_BRE2KoZv13Yih01Pdi0mDroJHHr07gt0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5-cI4am2wCyi57vD9Ni6Oha8_yj1F0qICkffokn9Sreg&oe=6A009297"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLqL32NrdUoQ7kNvwF20G7G&_nc_oc=AdoNxSKDYkXoH-HOc7DwRPrzr_pY4t1Hkr1j0UYn8WLA53whduF31j_J6YwfVxj__yI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6T0tZRg5Ra-hGn2fu6yhixXnDaHyqNXNKcs1CKd6pFlw&oe=6A0081B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H8nFA02mCzMQ7kNvwE6vH7I&_nc_oc=AdpjOPGsug7-lRm8wi9k3RwQXGfs8vtWhgJBsQTBQzKm4ijpOSils3vDVKWUmZcpZnk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kMLu58
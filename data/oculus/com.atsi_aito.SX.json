=7f20f&oh=00_AQJzee7Tb1u5b8UbzMjzXp36qW2ZTpXxhpqcq3jhUIed4A&oe=6AAC007B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xPhsVdAuLfAQ7kNvwGoZw9y&_nc_oc=Ado6Lj-p8BUY_K5AKSkabPAf44Ha6bN4qtWXEQ3oXKpby2IsqP5z786-dLm6e4sjpB0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKWnJpYJDSVc0mVfyu9UhdsRHFP0zaiJRdbT8NW9OSwQQ&oe=6AABE943"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PngWxCL53fEQ7kNvwGBC298&_nc_oc=Adq3vK_6kkAzMNEy2tpK9Z2WIpx0ofWCfgyauEqJRkc18rb-a4J8S3oWwEEdDnhCjrw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIS9e0Qr3yLUKNPYg1T80G5ILVd9stn7bXrYxuphI0N8A&oe=6AABDBB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3YUCdkaU6AQ7kNvwHVOp_6&_nc_oc=AdoDWBhQLb1175drjRmj8laB7azSKdht2A2yiucftJ30DWivsHtHvU79WbeV9KE3KMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi3JTRvDA3d9cMpaB9ZlDt_IcqELHvIlSpBC4drDJF8Q&oe=6AABFFE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O1NwUQlG5aoQ7kNvwEcP4uE&_nc_oc=AdoK1-Hb5eF1j80thEb4rBElrmEN7B_qG9KjurnIPsAJCFrfSkTczUUca0YRXazUEN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHJ1eiCbzZpSvA12VabeC9gXZ9hOeF8tnjbf_ACcNxsA&oe=6AABF597"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IrAJ6enLWCoQ7kNvwG2HNyJ&_nc_oc=Adq-0kvflGRF8WxOvNbXTrbI1dojv_FsBpLwNcu8734jYR5HAF6Ym7trVSyaio6XR-A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjAJNWlappsP8kI-qjlKFgy75BEvia_fEvtqdy8KUc0w&oe=6AABE4B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L_lCn-y2rvwQ7kNvwFhu3po&_nc_oc=AdrHLppzvptzPHoCW0xTrcx0vdBcSXwL8Lx8fSuU7aD66YOm0mVsj4BmhdBtBYRmyW8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkCfqHK
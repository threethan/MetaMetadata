Ok-7QO2Of1tlrlgFRsEPW46sY_Q&oe=69AC053B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m62fmNelc6YQ7kNvwEGyNlQ&_nc_oc=AdlOzm451sfjNCtDzaUG5a9n7BnIDseTWCD756A1HyCuXu5xn_uRQXIiDwFZkYA49E0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxuxNMZj9vWEqezd4mE6e5XH3J1qRZGKmqFvZKP9e7M4A&oe=69AC2643"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YcL1ZTsydjYQ7kNvwFFtnKs&_nc_oc=AdnkyBCUfl98IJFczTMmXZXbuUmVyuXGm5KBxy9W_PXEJurv8NkAQ9kl0Bc3TbRKiEk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afz14o54L_7OX5FVRPi3mWZCgfemt9uaQyGm1buVd8EvBw&oe=69AC18B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NyNW7HlCWYQ7kNvwFw_xhJ&_nc_oc=Adm_EdbHlOr_cloF0qnVLVXELayHXr3K5RYrzb46jzfXY2L4EinCiG6lNkC7jPdtBtQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzRbWISgaj-Hf4j_vt3MC666IR9EVdHpiKLlmFxPsVFLg&oe=69AC04A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EqW0-rUxiMQ7kNvwEDoBD4&_nc_oc=Adm1dmCEaNDZOqY-nJhPPiIvVZMSh4RNWIpgyCdoxyKOyXjRvRGOMCzRMrmHQZ3FYRU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzfgDOmGZAnzqjge6Pckum6X3gepp08A3fKA61-Jr8VWQ&oe=69AC3297"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pcekpyrTIEQ7kNvwGEHWdG&_nc_oc=AdnnFHif3ZEjMyOAIJ79xQZXf-6-gQufrHp0__TfVpIspBiHQDkyHVkYrclz_1pY5-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfygZYNLGRVCEFRgfihaJoi7W56x0ojFU5c5ZAQ0EYUUXw&oe=69AC21B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9C0E4vOlvqYQ7kNvwHo8_ql&_nc_oc=Adm9b4eh_SbPGnOYlYiugyqetxI5sRmb4rk0ckDelF__lJmASTaJZ62nLj0caQZaTME&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoH82ntviNK8lk4uFZlhhfqW5JIiLH3spIiEMP-eV9bA&oe=69AC3386"}, {"f
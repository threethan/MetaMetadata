=7a30f&oh=00_Af0zeDW1wxFvwwr8Qr0p42FWSUjgEI0_prZn5AAkxPEfgg&oe=69E24AFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FiDpE16sED4Q7kNvwEbFiga&_nc_oc=AdoG0b7ZoRs_WyyVtSgyAkg1IlXr9eCWdPloElr6Id9pebNK2d_YYFlZ900yM1m2rNE&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3v8xveRTrl9kAuUL_sh8kWa98EM6-Byq6xc2_96CasSw&oe=69E233C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HF8iHXvu5lsQ7kNvwHWQFk7&_nc_oc=Adovpt9SZiYqfdIdMXH2sKsZyw8vsIF4tz1cifMLFa7QTVjaVzjuftWAQkkl9ExuJDs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13BLJ9gdQwkjdr3zVGdVfOKr9HQxz0NqUNKliNWX2yqw&oe=69E22637"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUDbmYbO22AQ7kNvwEILlfp&_nc_oc=Adrru1Tab5yFhYkMhUkkTZdXoDvkomOSPgMmb-4wnVaL90_fKc2v9v07ToH3cqx8H8g&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0WT2ZnUGN06YjSbWr85grA787ODXRXDc3LgtCMcyLTWw&oe=69E24A68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0O-1MxzWaXcQ7kNvwEBdxXC&_nc_oc=Ado9uR-8lLd6uU2_zUJc9jphZq5Vq-yRbPNJ5wG6W5E0Pw1w3zdqM3iX7kqSk-k7jgs&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aMKgXkl-ihUHqotM22nLFEzERkJ3VSuOcn1_-LM4K9Q&oe=69E24017"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwlQPs6oZvQQ7kNvwHI8Ddq&_nc_oc=AdrBdu_rzxr3Da524nWUtblhM_UBmhmqEsI7bChcJ5MyxuQy_3R-TQUH5AKq7DE5ndo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0i7WMDCsnN-nmUq8Ueuwj__kub7liNnsH7lOlf0GuYsg&oe=69E22F38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkyrbF5m3ngQ7kNvwGkx1-T&_nc_oc=Adpv_35nGpCy5XxJlwVsRFM737Pl0xmHOTKx5POpYhwsEELlup9MG9FZ7GS1yJNpigs&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wGNGLk
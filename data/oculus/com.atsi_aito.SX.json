=7f20f&oh=00_Af6SNtv8OZ71wyHQoJrZb623JtlgtgpJdjTJ4tb-u1-Wlw&oe=6A1EEFFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rd5S1j-ZqDkQ7kNvwFqEQVG&_nc_oc=AdpZbRLd-ZnrG7j99rK9UjgJorPqscyLOezdN6VhaPDcEQixcoDS1oVs1iij5nR_gVU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KJOVQRKyKHeo4dRTMax2PVOMlr5M89T2ZNYQ2dGMzWg&oe=6A1ED8C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GBbnC7x949UQ7kNvwFX6HMq&_nc_oc=Adra8RbsptFbiXpuWcjxvmSQIPsAlG5AqRn9b_R8OVluNatDNRiGKbBiG4RIe10HFfE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G8_cbDf9wc1Bq4km6tkByUFaEQ6AgDow43F7ihGlSDg&oe=6A1ECB37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDNMq2V3H2QQ7kNvwEw9i_A&_nc_oc=AdqyvvrgzExG5Bm7qlyh9D_f0WNvSD8aMorRCheESdBglFzzbWl50u7zOFV1PCLCNN4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lfMo1YE6IoxVjnGiWlikJzprFu_fw5FaDMHF4A_UkzA&oe=6A1EEF68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6_P7ohWctaEQ7kNvwFLbc4p&_nc_oc=AdprmTYFhOElrZha3ehtDNSVCgX5y_Bbw9UNf4hLYBy4EpyvDefl-HRSPgiwDZhSDvU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62Nmc9gB26JcIzpqi4XoNJMYOpJT-C6IyO02aeEyImkQ&oe=6A1EE517"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yH9o-P8Sb_YQ7kNvwG-Lds5&_nc_oc=AdobaJTwPUdhnO7uw1rffpkYh8tW0k4zepgHqPM4T1fT_TK8Upcpy0vHes0YvaTevy4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56aeuVppqaI0CGNQcZRMUkabmPV4COhpaKIfy6gR32iA&oe=6A1ED438"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RGUXQ5YcJj4Q7kNvwGogpfW&_nc_oc=AdqEsIokIjXI1ll9iqDYc68SSZ0YKviXZPcGGAsSR9v3PvOuAH8BzchkXJx0DJ4W7hM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nioKwL
=7f20f&oh=00_Af771hMqExZXophE0Q2zv1sW5_3oiVQwHIesy_WySLkDCA&oe=6A1706FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kzv9-J42gXMQ7kNvwFLomfV&_nc_oc=AdrhLPpIaqL4OVjanHPM3l-Xhv16La2udg3kFD35WIDD_3BfeiaiGw7FZZYzrz1zqf4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63z99-FuflsHLEr5H_51XDQqJvINKcKxH8s0rw9jjbBQ&oe=6A16EFC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=utsb8ty-BjwQ7kNvwGMjNWy&_nc_oc=AdoO8ROtMn4BtVvKsmYSj7KNQ8JnCrGkqB4tBjjXMGeA8dhlrQUJsgXoInJtTWge-VM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-NhNz7qhxfYM9SkSYvn1fVLShV43oTDtBQOll7tGVAw&oe=6A16E237"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_hsjyVhrdMQ7kNvwGhUNKk&_nc_oc=AdqU38R_bW8XdUi8JHWhazpDcWk8rX2I9KoaUtyi_Cg_5u7OkdhAVe-MTPVaLiV09yo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7O5YGAMZ7qJKsgtF5BLgNfqXMued8HnONgCKPp89fDsg&oe=6A170668"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfpNydjRIpsQ7kNvwFQ1Rnu&_nc_oc=Adq27jxV0NlvQOSBsRIIfFpFkYD2N7baqBEEmvdKLEHUm7mSlhyM3MWIEvBf6BV6vb0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-1LZnN80dOszTP3CXOYqb7x2ptOzYwdGOh0HTgIb95Q&oe=6A16FC17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3aHrjAm2q8YQ7kNvwFBvv9x&_nc_oc=AdrT2XZciwdMRfbBQCQt4g4-ZQSRvR7TzmTefbYmPYZsGo74lQBwQAzzQBBc2s6nJc0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73dWMfPJHcRcIGBhJOP39W2oiDBohA5GV_1fsle8SEiQ&oe=6A16EB38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ccSIDVQxXkQ7kNvwH_-gnk&_nc_oc=Adot1tgCJusKZZUcBcUFWNQrujQOT9h2XqK9Bk0aSy48MbfmwNDrueum84TIdSEfTaY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5r7f88o
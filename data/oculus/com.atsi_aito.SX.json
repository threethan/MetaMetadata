=7f20f&oh=00_Af_sBUZurFsa8pI_sxqSLvND4iNb3p9w4eMS0WJhbyxeeQ&oe=6A25877B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fyahp5T3-8IQ7kNvwGu_uEQ&_nc_oc=AdqeNIuhyd7cKQ8aOPe-I95uYdDdb15qrbq0rBvyftKAc-qGoRigWll_iY-EJoO7ZqE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-46lra6jmPJWOztEqU5Kc32Rh9LEWufzLjnjhbMfcsnA&oe=6A257043"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sb-IIEY1joIQ7kNvwE4NcQD&_nc_oc=Adp_f3UzLNAa5rd7_kPq4n6Hsft_FNLuEBS1rGxxlsVXF8OUaSSr2aS4XVASr-YAiWo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-yKCJddOMWsXcvuc-YGPx2iZa58h8Ckj1l8-aVR4YMzg&oe=6A259AF7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M67pVFkS1hoQ7kNvwEbvQm2&_nc_oc=AdoJtCyuWWYc7RSOz0bJoZM0_sDqV3YANH4LUV2C4vZpSN4Iy0sKGx-wN4NlPb06NiI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-f5nG6pFN9IdQhgS2hgXBKSjQDANpbD9Ke3P0b0So0Aw&oe=6A2586E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4OX3odbW80Q7kNvwGsHXD5&_nc_oc=AdovEwPDJbiFUwWsyq1PWHaYUAim2v1OXed8hqaSkANhWquzjDnooIXAs4cI_68_RbU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85ofaitfmdi8zOEJ-SOOqP3njWix1HbCb6y8C2yEE-Dw&oe=6A257C97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WUx-2zYm2YIQ7kNvwFpzzT3&_nc_oc=Adq4_HCyMV_LA2a70Q0a4liGq9UEYoFWxi7T59gjL4K1bJ7m289jJ40eiGZtlidFMjA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LvU_z8vhxpv7VHDDIfFDpC3cgjgzgBNiGOVYv54DeEg&oe=6A256BB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ULjFe0BVqUkQ7kNvwEQdV8K&_nc_oc=AdrA64ZYUntmlOLD_Aw-EFmxsuzKmKg8VIQF1zEWTTHgCuilQlHOi--SecYq3RqAK3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VIYf0w
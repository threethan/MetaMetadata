=7f20f&oh=00_AQFUWSoZt4-07TCwTq3ZHVtkkkP5Zdk9Yan9-RN5smdHfQ&oe=6A92BBBB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iRsK3yd4WCEQ7kNvwFmUzvx&_nc_oc=AdpEdU3VGIUIA151svf5DWEzZC9lNk3FsrQtF4e_Mh7GBNaxlbdv_t-lAACZROdEidY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa8_izBY6PERGqm1LqDrrOIHTMwLLIN4iYkQDPp4h4PQ&oe=6A92DCC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyPE2lC9ofoQ7kNvwECVsK9&_nc_oc=Adpmi502u3ZefHU-JzooZsF81bs17igvHdxRu-sEdZAi_Jyap9n7eK2DAdFHs6UOg2s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZBLP2HD98R4j3if-YXuMFcxh-O4m0Mf8Vkhfy7SHOYg&oe=6A92CF37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kfBvccGR79oQ7kNvwE7Lc0X&_nc_oc=AdpDMs4jVmT2VonGDJ-URaxCHbEkbeu-tUfBhvtfgSTLUcjrDsJ-OSPPD60bYi-rD7s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFEXJz2N_D8IamHThnk_tY_8tICNY2oLv5nVrbrYZrVHg&oe=6A92BB28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsDLbuBQQ5oQ7kNvwGI-kmg&_nc_oc=AdpqO5F6OGBY2YoFXUqjfO4PWJTOxrfsgsaBpokauQVhyjbGcsgM5W5j_sr5FUMj_IE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0oXH2ZBBXtjiPlQLkGrX01CiC89xKcQ6njfZmXGeDqg&oe=6A92B0D7"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zifUVtG8xNoQ7kNvwF9iEnA&_nc_oc=AdqdSJFEWb4GfL9S3c1qo1iEKEYR15bB-VZQ1S8OTswI_RlNG3r5J24TqkjVrOWnia0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGnlJJvbhPNWs9BvCCY-vJPFPwT6jQf8QEIiGtKRpHxyg&oe=6A92D838"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6jjILRAwxF8Q7kNvwEGXSNR&_nc_oc=Ado0RiQecHcQyrKctIgQ1ikSDcn60D_E72JYAHKRLJh8MYZWMH2Qto1TqxeNRi6cunQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgGwK1u
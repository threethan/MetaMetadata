=7a30f&oh=00_Af3HJ__97wdHmhH6xLW6NraqsHYyX-9LVFGx12bhptl7GQ&oe=69D6353B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBPXEbeaWdkQ7kNvwEwENXn&_nc_oc=AdpnmxdWbfrnFXvR35gT8hLsU8YA2k9q4WYZkb1lxwjw-WHRPaQPeyDkAIgCJT7Jb3M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af147ICcCawwkuJYT706GBjOnSpCrQEurBam7TasjDldOw&oe=69D65643"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3RfHdZbZh4Q7kNvwFp3Bhd&_nc_oc=Adp8u8_8I5SXkVcajd9EPVWKBub5eFkfNNcRLnILaGGhcKShQEU9WB4OouyAqhAklfc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Kam9f4eNP_ynqrhTpC4-IaMxr65x1CIhv_kv3Qb3sWg&oe=69D648B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzMZAArYi-4Q7kNvwGEgAjm&_nc_oc=AdpR_PbVec2nlmVN8jvzvdoglxIeZYzieCq6OPGC1u8pUam85cN8v1kEXWPHb1YSlQ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iAO3oVe5TAktHIKYZ3awUbo3JMmDA7HHiUhmfguNW1Q&oe=69D634A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ztrqWubqhQQ7kNvwHPWiwP&_nc_oc=AdpYwU1rRcjRvtYHeyptV2f43OiQGSSqG5LTiXrBFRhryQ3AoBslx8RG03tfnWEZwLc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QT62GDBdGOn5harkKDgDZwJNfuA5fD92zLDTQ8r_lsg&oe=69D66297"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bhx9eNp1GOYQ7kNvwEOwhOh&_nc_oc=Adp0_WkfB5CviNt9e8NJjbo2QiNR2ZXPm-k_6a_gqD-NeahXtN98Zy0TvcyIsmSZTlE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24k7BZH8p1NXumscShj3GayVmcukYovbqzDWWjgsnqbg&oe=69D651B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiN2EQ-umVwQ7kNvwHMalXa&_nc_oc=AdrIbTJkXH4F7OySmXQVwUDSAElqcqleASQlmnbtXkJH8Um0RDHKZ0h7MMP1d-Wq074&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2YibJAk
=7a30f&oh=00_Af0ZR81tlJxuFlrJDLBOMbUFgVgKv1WBf_xjN8N-7AdmaA&oe=69DF6FBB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BN42H80YpK0Q7kNvwE9OKUR&_nc_oc=AdoBbeRcY0twLhhLiVeyWjIOW9Enk2DN8wrfRlfZBqSlM8jaKxblXUsDbvZbhAjigpw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jp6mulWkaO4vnw-nZuNrS3B3u51bTtH0I1NCjsWp94A&oe=69DF90C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIF9ukk0QVgQ7kNvwFatrom&_nc_oc=AdornhIs83HgCRIRiyG-M8cdeYNr45LHMwMUsYsFSBYGvlIkqVFOff2cUWeZn1hcwQA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af08SfnGQ-jA52fVhd7pgM4MEc-61iGxZOBIZsJi9O6i9Q&oe=69DF8337"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LUDbmYbO22AQ7kNvwHRClk5&_nc_oc=AdqTAiXSOasUbhUgcOqm0OisYrsv1L3fisa_rIplhjJyVqKEy8Aegsqb-DYv7g4-SgE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hap75NT3wDHN9mIwIO7MA1U0lOjSaK6rTiilYGbJIYQ&oe=69DF6F28"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0O-1MxzWaXcQ7kNvwHqbhm5&_nc_oc=Adq6k3374hkHwgLoylrM_qJ2XjhA5AITj_Z37UgpzFDZQG3iY_lGb6AM1e00d0MsnQo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2kc0qap5WOXCyA_QVbqTrHZWheL0R1wurtYjtcaIA4zA&oe=69DF9D17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpqtCSRQisgQ7kNvwG02b9R&_nc_oc=AdqwbSraD_fVKt0DmSlNzgWAh67fgktCfb2V7Y6PDlsSBpuxn6vJcyoV9yar0NsPE3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sHJ2cc_rARNl5pxODrqYv-_oErCZCqbUztaAHNru4xg&oe=69DF8C38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jurdqtXSCDkQ7kNvwG-Ehhc&_nc_oc=AdqzmHLpAzwmmuifHd_H2PKif9dQzlggJ25JmnWADRtAtkDi4AWRbAvsgxrRvPuOdyo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ZoRXay
poMKIWpgVKrPWyUoayvOH-FSqfw&oe=69AEA83B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MY_Y-su1GkoQ7kNvwHRAcl-&_nc_oc=AdlgqB2Wn9lqvPRPchFpGoStLwNqi_Dnx1OGzL8b22uLANyCqjFaV8Y_pAWrwN95CmU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxiBMxxGPgOEtnC4vOkEFYQ15Zg6BfnA57Mi0UOr-VWjw&oe=69AEC943"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uCFzrhelT3IQ7kNvwGcmhA8&_nc_oc=AdmZmtQEYcA7yfDbOzaCOy78EJ-uRT1xtELX4dGd5-XCeLxJzAK6O2GoGEXjlAbsJeo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxnOUQfogMF7lLLtBtg4qI574bysswixV-DXGrWChesgA&oe=69AEBBB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5NyNW7HlCWYQ7kNvwFmdDag&_nc_oc=Adn1YPsEWx4EqwSGttli-as5t9F7sW12aDP7w0pQZ03Oy1eIfTCeWMNH6C0BwxOyxbE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw1nzbsJq61qc7DS5RMwbFju6iHwmzFsVRlGHsgvlfPXw&oe=69AEA7A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1EqW0-rUxiMQ7kNvwG52rtD&_nc_oc=Adle4NYpdMHPEGxJC6opOERh6XAY9ZRpigZYZjZi5kFagF2HjizG3JMJJt69Ve23_UI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyI0iO9Txa-yMbxdRThTufr-EWA9tvptMnkBq8OSVOxIQ&oe=69AED597"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ngZT0jheaqoQ7kNvwGI9nsZ&_nc_oc=AdlVeIwao0cZt5esnfIMexUFLpnHbsilkCnn-CmwQP2x8EytxZ6TpcAJuK87RJ32yGk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwHFPJ5Phg7NJbfEV9ZcKKNC733PmulwjUz6lTD_ERRvw&oe=69AEC4B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4fprZRmJg4Q7kNvwFQ9uof&_nc_oc=Adn3ey51QwkJ-Tl_9CvU2kvVMnL9gTmHzxRTEPq8YRS9lH409K7MkAGcqMrF3LeCnVc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afxrl8DQuAxjee3hiMucO9DLwstT4c0MdyLDL8DcrlyjcQ&oe=69AED686"}, {"f
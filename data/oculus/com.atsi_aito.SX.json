=7f20f&oh=00_Af0uY_QnmoxDvMVKtgIQpzBQFfjQ2PEBUdZ86M0QGdsHeQ&oe=69F762FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTtDVK3lc3MQ7kNvwFp7u6N&_nc_oc=AdrAoOgvM463wr5OKkISkbIHg9yJxBEv72H3kwWRNV8EZ87DPek4AB3gNJAkry3VJYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Bcnz9eJunpPPmClKrS74bkPtL_hEHsitpw7h0PCK0dQ&oe=69F74BC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwfhGzbOGmMQ7kNvwFyHEM0&_nc_oc=Adpqqpp__MbzHpch8ognCwLYybOCWBmhorIf3oC_UtEmfRmMqxFn4hLmzyNvFhi0sHs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ev60EfK2Wj0uAf1bpwa5UskSQuGLixaB48ID4Y6Vupg&oe=69F73E37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRYCfmt8MrYQ7kNvwGMHZ9x&_nc_oc=AdqBbQlhyJJdfFFcs79jUscNBZHqiRsdQsZgi2bBO4RLrSRQ9LuWXVWtyc6BUh0Iu84&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1nBkxHREAgoZ5XIZ3NVwMKcL8GziOJFpBdWpbrI__flA&oe=69F76268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsW0pADnlRMQ7kNvwEhBk2C&_nc_oc=AdrLPFk8d4PC6XfmxvS_XQnRpSgxLfI2nin0pJrGm0vo3v92yxsnLn4IJH5xSOY_5l0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ccJorbeGKug---FmdUl9Qw5zAt4RlMcm7nZS7Pf2sSQ&oe=69F75817"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lRABVLKkxvcQ7kNvwFxUFor&_nc_oc=AdosW7Dkl5kR9KfCX07aNzgQ5SPyJ-FXHOEkOUNjaTj99If-z-eP9TPG_6bkLoU_tJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3CETpTqLUsUDge4WX8PKo2Xsi2BtFK25tLo4jQ50fDUg&oe=69F74738"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rg7rB-y57S4Q7kNvwHhgiZh&_nc_oc=AdrXTXzM2r2ATO13OyXYe3hez45HvFHoI6Nq7UpQ7OdMBaskZSt_5QifIiCnI2tD8Fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3G53NOK
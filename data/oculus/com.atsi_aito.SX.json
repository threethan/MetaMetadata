=7f20f&oh=00_Af3vkgTUc0rWU7qzuSlFAxmUxKqAthNREEbIY5YOL0BvvQ&oe=69F36E7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kjMK0CWIfEUQ7kNvwEyhDd4&_nc_oc=Adoy0kkP1Xqzqr73pkYnR_iA2dGVjs3aTv4U-O7RDw55RBf-hNTZVYdIxrnSP1292UA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0oN4AGF8crfOeeIXCjtTiEK01SO64ZqIo8eGPXo6k2eg&oe=69F35743"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qbr3UNgqhoUQ7kNvwHKDUrU&_nc_oc=AdpcpKhPJvvwNGoYKc_rXXAFncOYjNI-nUyHp_jTEa7Un5r34G2spt92rpn-0V87pA8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3l61vZA64eUjkWNTuUuK743zn8qZIbvuvACitxF7b9OA&oe=69F349B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oehlE_w5NewQ7kNvwEQDGra&_nc_oc=AdqOc-AtwZENagaQqf_QSlZqbT5Sml_BLeTJHFFA0u-bqGuTpKqA_nwCqaAMHx5Do68&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1H99mkwToPRUnj599AL62x1evTl8bbI767JMum6-h61g&oe=69F36DE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m3y1f1fGX-0Q7kNvwGWi9N3&_nc_oc=Ado_fSQ-09_4uZIRYU0iGC_5GQEC2eq6TRP3wS2HhbHOLIiKzsMm0W2zeDPCNeE7hrs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3KpmwyMpn9uZp0y7UejZjtM4EgwYhwqYR8_-awJoieGQ&oe=69F36397"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GeA-_tpHLxMQ7kNvwF8KXcw&_nc_oc=Adpt0lCCNw08BLs_AYrhvV6dGK6D8Egpk-VBPpTz_mTvfMpB0Seq5dlI5gy0DvXKOg0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1JG2k-p_mQ-RQ5C97-jc7uz3OG6l62W8-P3n-oPwaqsA&oe=69F352B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDWPkSp7DfUQ7kNvwH7RnTG&_nc_oc=Adp0Z0Tjum3bMdmhzz1YVvUtsM8vHTyOpoouOT1zy630lNE15W0579FE05LBbH0PxNs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Ti4LYx
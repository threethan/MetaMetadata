=7f20f&oh=00_AQOAnpptjmKj1MCMRtE_k9B276Ddy-tQoY0Zz5D7hqezgg&oe=6ACCF5FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5NIDfIB5awQ7kNvwFKxlW2&_nc_oc=Adob4vNYNjCiODD__dhPaor2cvJp_MMxHFEpOLgLIyx8tXpu7r-QfyyMe34H0HI1HcM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz0P_x7lhxJtG2Ky_Ocxm2Z7vcLSTniPTk87Z8aG2Fwg&oe=6ACD1703"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQyBV0bdRM4Q7kNvwFt8d7-&_nc_oc=Adr8pCwRQpVlCeTXRFD9mlxJrdqz99s7qybAAOQ4qRkDLmqA4R20n4EEgsDI_s36SGQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOzayQdhJgjt4T7pyY4TGoK1YAlrFAacYfH90o1Z_2VQA&oe=6ACD0977"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TGibiAdFK8EQ7kNvwE4wAef&_nc_oc=Adqwr3N7XwUcgicjVr3Uz-ziislIsIyCW2UJvo0vxQ_KQdNimQbWKxfhLK-BCjDE81U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLjDRe3Ugfa3ANbB_xPWe31V2GeNB0WnRBRZbVqNJAbg&oe=6ACCF568"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qg1zLqdnuvEQ7kNvwHRd8fV&_nc_oc=AdpZmyi_-p52-JHNxrkuKyuPNu8tN8WIvbRzAnaGHXQIFNbx5YFsobheum3UJvOnvm0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMKc5xPvUYwf_zBKeQ9_x62h1THJEq9qZdFhSCjY1HCIg&oe=6ACCEB17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDPZSWEBawoQ7kNvwHMFxcK&_nc_oc=AdrU6eCIDpDOV5NigHn9xIJsdrpFAf9Vgv3xIzFqVqeehuuzJdLCN6v0W_4CjOd2cwo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqH6A7sDG1XJZI53xNV7EU4gWBzeHzxBc__M_rdM7MqA&oe=6ACD1278"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zEvaVT9ZfmgQ7kNvwHzbjij&_nc_oc=AdrqE6V-WtN8oex8kvM7zprfMVsHqLx-0mGEJMhEEgAlHesyzXQ14vzgZBc51mJi-80&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlFTGbj
=7f20f&oh=00_AQAdLHF9dEHQLwU_3xc5rRjsoQieX191gCMqltNmv_YTAA&oe=6A4BC2FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3yiF6Cz-VAQ7kNvwF1ivUY&_nc_oc=Adqs5ifrRB0bmuFZVI3dzzBe408W0GCS9FdHPeQSxMJuLs4DQOSXIAu_Yznao0aFX7M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcfnPb0z0k3M6tp6rbwMj56k_QF4JwNu3xT1KcdhVHkA&oe=6A4BABC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FhoKuxo_wyAQ7kNvwEMptMu&_nc_oc=AdovSpRjzZgBEmkFy-mdzpx-OgM15AWR5OJpxUN3vt1o79plg8jSEpZnpj7mMb4nWOo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEoyKlSP4rFroPjHUXWZZVNsqCgWHqCxM7MuH4GmE83w&oe=6A4B9E37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mEh5x27BoXoQ7kNvwEOsMn0&_nc_oc=AdoTRTOyEpAtxaLXjbaB2aBoDLsI6MlCFzyX6i0QGuYymjvwgH8F0Lv49xtkQ8FsgWQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRrcw4x2LY_yzBK7jMPM_dQc2srr7C40jhh-4N4RC6zw&oe=6A4BC268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QcfqBceTFX8Q7kNvwFQih-O&_nc_oc=AdpsRIvLceocNMPZEs-icI9ZAnvQJPFxS1JigagiE6njBVNkOtzDszQRIxVEY0ScFDI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBqQ8lDYzpLOt8cRvXNmN-Vx-pAbm04gO-hh9nCF8Sqrw&oe=6A4BB817"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eE6PtoEwSFsQ7kNvwFSV07q&_nc_oc=AdrmKM_XCDXcoTTYY8AxIw7hM5Le1ARHsE5lZcH_-wXA1p4xfdaxaEb7-ZiEo3KXo1A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAR4-9VH4AANuvqxiOOpDOFzYnUp0ErR9B7XaP0EYB_9A&oe=6A4BA738"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VChZAeKyIDUQ7kNvwGbrX95&_nc_oc=AdrNuNZuAiip50QTISonejG1n1N6CPBA6TYpoKa3ZfWvoje9sKpGSEfmTc2ofy79lBM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY0yBrc
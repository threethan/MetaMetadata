=7f20f&oh=00_Af9pCTyHJI6-DHwUq0QtI_LVoOrcV8ggf3szW3hCDSkrMg&oe=6A3407FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrv8_AH0hd8Q7kNvwH2_s2Z&_nc_oc=Adpzfnl-cTFRXY4kT_Zo_ErAyOK-SUmznDx6_XDz9u5y_B52XpsTUD8Tbwgfvtl-V_c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88_P6RCSoeWBdPOaA4O3nf45Oj8Ssu2lGlHqnBdwitMQ&oe=6A33F0C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yQFc8xSctkMQ7kNvwFsQFrx&_nc_oc=Adr9VAdarTF758jcjmhrz5dREF9tJW1GC_3V1PkVpPoj4wvAguHOHrL-jWEo3k54Hlo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9gk33wFku0w_Rbapki0llavixslno4z0MT-O8SGfm9tQ&oe=6A341B77"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jt8yduRM4e0Q7kNvwGTyHMY&_nc_oc=AdoVHhMmq6nrmF15n0OWR0kBjMquW0xg5_X3BXthoGYrbcUZZjXkWsIpZleCahzJv5c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bIeHfnYP6X6vVTyYCafEa5R9ulkVK9BXxJZexxPNi9Q&oe=6A340768"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xYXMzn-QFIcQ7kNvwEPm9uZ&_nc_oc=AdpgUU3ZukVNdHNSMHArmmia7BdOTUwkwc2QaNU8J_hYTSqKXFHSbBTtNu6rCVEUnI0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_7bUKCVIHH8vq7eYEAOStzULa86D0EEEms_40wLhvug&oe=6A33FD17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BhdSA0Kbe-cQ7kNvwHLFnTB&_nc_oc=AdrQ7YOoxG-Ic1kTiabPr7LMvYLcOLxpb0zbZ16nQjZI__SU-OsAbgb0hQc_gmEuFpo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af94sOyHdqXp46pXIL_RgP8j0zX2I9Z0GF30J_wawRuIXw&oe=6A33EC38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arzipeWqYtUQ7kNvwGjHnjG&_nc_oc=AdpR4Vuq95bfdyFZPdwf_-0GEBGLil4FjUOXhKkRvK1R-1xNQZgNcX1L1SEZ_nv7t_c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ELVodq
=7f20f&oh=00_AQLAhyN8cc6--yHkFxFOpCYkVc-F-bcag_0zFT6Gk7GVrw&oe=6AA2C5FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72PkhgrcNAAQ7kNvwEMsUKC&_nc_oc=AdqxuQHgbbGnpsOcSF3yV-y7ae7IYcy5HJnLV6s2WCduYJ3RnVjVUcVZ0TRhc4TbFeg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKU1gEer10fh2zxxmuccJXEWOvwBiVVt8uBSuRRufeP_A&oe=6AA2AEC3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6H8GCT-F-QQ7kNvwFvd15k&_nc_oc=Adp36pxfPyf372hZTY6lZ2_wVcz6KEJQKTtUpjFb1Re2v3skB7dIsRIWNmV5QsrfDv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcL6w8qdjw3sinq_O4UmRy9Lr0XlWy58QCoTOxrKgU-g&oe=6AA2A137"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I46zoPoyZZQQ7kNvwGRv7hD&_nc_oc=AdqzOM4cB3EhyxYjncOXBS57SrodNqm6DljjH48XFIJe07H56n5Ufoae96dtQ2IKPqI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXyFqO7yi4Ml-8WVq1o_X920cy87wkie0rNuf5iNSD4A&oe=6AA2C568"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icYSXSW9UJkQ7kNvwFZef0g&_nc_oc=AdrsPhF_mbcoFRqXuu8t2U3eEuTdGqnJgRF-1orbqpuLj0YW-5vDMtHTy5FBL6q9Ov8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_Xd0O7uSrAo5-O4n066JfuEGw8M9lft0aZG4hEahQKw&oe=6AA2BB17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmmNh2aTLqcQ7kNvwGT_BSW&_nc_oc=AdqHvpNnI0Yks8tOwDmnc_FlLQNzIV30wHtA9GGZjwh-SkU9O_TUf8FzMXCPIbJbLFE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbfSA7OGVdpqxbLxoN5mR0JlVjSl-BM_Fj1tgC3SP7Lg&oe=6AA2AA38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6PFJMW6PNYQ7kNvwGwZXKF&_nc_oc=Adrldkb4XdUmhGK1KkFt1y6Z0zx-9fNtTIHN8CUup_BVvHHQurglv6oUYkiU2GfE5YQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5Y3xyB
=7f20f&oh=00_AQFwYqqC2vMdGyp48rmb5X5ya8ohWBY7249diOR-Qp9GPQ&oe=6A8046BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpqWtkyFOT8Q7kNvwF3mzIf&_nc_oc=AdoApOCkTlVCJusBICmQr8PMgWNAyZwtg48mmVEEQR2SZXWmj6YceE_c_b8029MtYGs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5Yhkx-4dxJcP9mKspgqlVLi0nj3Skq5i3PnDvPNVpNw&oe=6A8067C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUQucrU08HUQ7kNvwF4FmQ6&_nc_oc=AdqXyD9iljvSuD9Zrywos1Bk9bCl9L88gb_7O35okL224cORbUfGd12rfy7L-AlLY08&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsm2r3t6QsK5YiN3fJGapwZnPoGDUmBS35mpze45DnvQ&oe=6A805A37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7IkgyotI1CsQ7kNvwG_wDgC&_nc_oc=AdoqZ4Gz9XRtyO0GNnNkYvQfoukzEGfAZ5SbJit2LNx9QGxLentzduwBqb88XgW6Xvo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGb-9uMrDIEOHuzKKeFU7E0vU817yRd3sb_p08Vo7B0NQ&oe=6A804628"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V0A0Q_0kwIAQ7kNvwGjkmNc&_nc_oc=AdpQggNfXJL0EX66sIiciSB0TPG0KbK7EbxB5HdUIko-3Jpfo52AItlo6qFFd7T1d2I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDUWe-oFGpFQ8CZfQFRQe7Q7tqIgAW2KUskDF7K53dwg&oe=6A803BD7"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAfESxtLougQ7kNvwHbdXup&_nc_oc=AdqDH_FK19L7xxwUjTEXkSjDZLsFfQ1WNzje7bQjLGc9J3bd6Ng9mXP2tIKeppyQYuk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqbdfqTZr3Tj6GojwVIH2q4ijMpLqZt14ASx0FB-RhAw&oe=6A806338"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPTRoB4-RG8Q7kNvwEVlyR9&_nc_oc=AdoDLKf0dozvSaUajRcix4-n1EZYKDRaTGjGEgEEyZfnxGEbq7d6Ddny7a9vQF07OuE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE61QvGd
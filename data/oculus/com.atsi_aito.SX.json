=7f20f&oh=00_AQLHsF5YEsLHD-1z3lwtI7kYo2v-TV8SxOKgyZEUR_JJWg&oe=6AA568FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72PkhgrcNAAQ7kNvwG61rkb&_nc_oc=Adoq2xHRkjMxslkihHO8Pzn5UO_bwOb6Tas-LCqSczz3va8rpapafBnDTIvQD5C2dyw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIDtX5AxZM5JlQCkBULn9Fc-VQSuEsCYG_dCSXxaCiZVA&oe=6AA551C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Km8HYopDKiUQ7kNvwE4j2AU&_nc_oc=AdokapDdsvEYVHD7p_zNn-i9biI0sj5S30LM2UHxXtKLXe0zzzVm9CAKXSUoh6u6GyY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLsN8jbIMo5BCRr5F2I9jgIKcK_rNVx8bQInUFwvK5SLQ&oe=6AA54437"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Hcoj6s4QiUQ7kNvwGcrgf3&_nc_oc=AdoYP9HRZZpILld3L5bzUf_YBBoi7uFLcBhFVMlybVADLycpXbJMPaBIBtEHPudXSuI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfSl5WJ3CXuiUgCzJ4GsG9_Hu7YKL7qiqhI-UHh5gALw&oe=6AA56868"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=unKU2lymqvYQ7kNvwHSA5SF&_nc_oc=Adrw6aLxndonxwEdwXaFCiDKRvfshQ5sPW1okGMJh9nHMTq6H0SOuJtYR8qi7262Dyc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK6InD8HlR1ikYr_N3ipwS7oAa1-brqOHvIL2n79BkiKg&oe=6AA55E17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmmNh2aTLqcQ7kNvwEWGcaj&_nc_oc=Adr-xJ2ETb8FdIY5Xi4a8hIGts-jYyT93lLZl9eVLZubMqmjBkSPuVb8tYnOb05VS5Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4tFnXDFwXgPomYwGf7GYpGIpFVkAh2u7HnBeCmg_QSg&oe=6AA54D38"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGeHkGo6RQwQ7kNvwG7F9xK&_nc_oc=AdrkVhgCMThccehz41ame3dehGjwnutn9WbyqPmH4r-sHWjzofI1jUV_186ZmVFolss&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpxrLnu
=7a30f&oh=00_Af0pBHQhcJ0XfedIz0nFNfa3RZW4zNcZKuURv41UBrFo5g&oe=69E790FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HYstoPyvYYQ7kNvwFQAL4d&_nc_oc=AdrNWwoAUGESygknzpq-hOXZWFXENCWXdu8ZKBV1NyZp3jTXyy_-dr1JwITS_4uvfmg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yb10nRORYV9m52nIbQopYUwuG_xOd4LQTN8COULhK7Q&oe=69E779C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXTOmzh24QMQ7kNvwF4xmBY&_nc_oc=AdrJCNyk3AkkIaLjQqAn64TWPPQi5cZdOAg6Onu3mQGD1Rxqg29J_SVKcCif9knJfm0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32YsNA6G_BQKTtTVG0vWw1RTqOrzD3igyQtKs2rTB7Qg&oe=69E76C37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miAKoY8KX44Q7kNvwEyVFym&_nc_oc=AdrXCJltmnIJ-qe4gLNRxlW2kXyWrt1JdzUd4w8eoEniiQMwCUKDPR54MbWdQCXbv-M&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PVn0Pd8HdySgSFmksclzb4IcR9LUALEWxUKwwzs7ALQ&oe=69E79068"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDhX867Fh0cQ7kNvwEfiDR5&_nc_oc=AdqYOlnhQkohM_l_myLRwQdCYo6jbhVtnYV0ytWKTirsVgR_EoUxqRlBdJEDr9vJtYw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YHYwoV6wwZ7RV96srMXDYcyaVK0rgDdrkmFw7uoMtkQ&oe=69E78617"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8aM_hAegtvUQ7kNvwHuCACu&_nc_oc=Adr-Itexo_Vb6Th4hajI7cTMYGdC2hbpboI7dO1J_8MHXVP8ZlUq73weGwjgoPlBP1s&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IBLFqSNoQzkdlzyphQ_3cEQwF-XHlLCHk7GDx8cRR1A&oe=69E77538"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk8t2-kmBkYQ7kNvwF-Wy0l&_nc_oc=AdpQmP0yPpwG4ivObimTKlSWIYFlHQ-IeK8DVu2WUHHqL6VN2MNAeq3AksSOYke-fXs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2vNgPcN
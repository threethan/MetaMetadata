=7f20f&oh=00_Af8exeiwRVPPyPP92XGGy-blulhwlpRXcQEHani9vTpHPg&oe=6A3D427B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pG6T4LL-k2wQ7kNvwFewZk0&_nc_oc=Adr-TXJ4bvN3L-CYwPSoEZ-4QXshrAAL9_EXtkIy-BCWQzSewEPnCeyokKNxqf8266A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Grt1BSpq6n8n7_NMP3RqF3CbtgloceNu0Be5lYEh8PQ&oe=6A3D2B43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTc7mYgoyawQ7kNvwE1CSRI&_nc_oc=AdpMH8Y2RnwXSSaX6C9GnBdbU67M1eH2SQx28ELsHqXYsRLSQRco1pDFwd5argkMAyg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tZ9gzoIeG6TBH3Ni83v1dsqwA-HY2RoQhOEkWz7yjUQ&oe=6A3D55F7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYhkUNPqbXsQ7kNvwH60fc6&_nc_oc=AdoKuHg7TrINYiaitNTZdDIPPqr7oiCp657mB4SZh-aP5hrD-YuOSYl9uTuykxVjV8M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8cgx4uxTZSEdFX8rJlKThgDurv1fvPPP54mtR--26UWg&oe=6A3D41E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0hesfm_35FQQ7kNvwHXvpNQ&_nc_oc=AdoATou7qzdzmdWjdexzj3-8DHjtYOlTdyeXaCBAuaR39sIE_rmg4yag1lCGksS1Lp0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9us0dstnAErENLc4Sl8yFTSSDYjIiRLtPm2biKuyT6fA&oe=6A3D3797"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CexfLw7vC_QQ7kNvwGlJPc8&_nc_oc=AdrVvs0sxka4r2D4WO9QDT0WiH5DkZQNVibOt9wkvoKtPSS3bAGE1rbvjRJqzbTB2f8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bVFh-FrTwT6k8IOmFcJPdKl8D-VR1rg0_1PaBjTeJig&oe=6A3D26B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bYvEIlhBRYQ7kNvwE-0Jee&_nc_oc=AdrAW8O7-HmDRgkQ6rtE-VG18wnSIGMgOzLhXmox4HSfA7Cu3cqv8Q9eHfUYesRez2k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ydO2os
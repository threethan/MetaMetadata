=7f20f&oh=00_AQLI1FK6JwVTDcJ5I-4oYQ4p3pisM3OlnGcETretfS1OBg&oe=6A9ADCFB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mfyg1KH-ANoQ7kNvwHjdpOd&_nc_oc=AdpxtFdABdCeXvw4ZQRYCoFW480yBRZ-bbw7af4xlf2NDF-UP42atvXnAYsxsBSGQk0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRx9W6aZdPVbAGU0orFGwbqQIh2KqMAJ7Qa2tuyqnxMA&oe=6A9AC5C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1uyI4LJjSoQ7kNvwF9DAkc&_nc_oc=AdoLk5bmFw8WmH_TmLO4RMwPuNtgwBgj7sT7MZ9lSeIUTW4E9mDssUcQ5TZ1YUUOFSQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRGLwbEMc5gK3a74Udo0jAwbDkhLr77WcNvgamf_dLNg&oe=6A9AF077"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OYdfj2A5OxUQ7kNvwFgmjmi&_nc_oc=Adq8ZJ-GJi6b5lBVu0YWHjfHOehY93IyHUSvTdzUoQ5xy0GctgA-xDZ7KLYTi386QWA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJvTvIQvpUpgQ9qOt1F-GDovUKL8pF5JgyeN8cvKh22Mg&oe=6A9ADC68"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJ0fRPXlrJwQ7kNvwHNjfy2&_nc_oc=AdoGLkbihMRSJKRVA4jk-KCrrBpSsNww4KbrfRzlVrSxWV555kisB1MQo8L88e2GCW8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKzwpwfdxvNBW64EvhDWBCllN3r9IzAEYHKAMIOzI7EA&oe=6A9AD217"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NI7CNskzF3MQ7kNvwH1ZjJx&_nc_oc=AdriDzGd72DpaoINY-3VY4QKUvOHk6eLuGmZr7B3nQenVyoMp_cb-gTrmtRzz0gXqRw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGKTsGP06p_Xh5QjUIHu3TYMeQl2gAEKW4rgoUsdNCUQ&oe=6A9AC138"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1YCvlkNmWQQ7kNvwFAI8z-&_nc_oc=AdogAYygDZ9cWCL-itgOY_OF2yxzHg18EkD8Ec6oVOk2o5rZWOMH6E56aiKHZSbnM2w&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrb71Zo
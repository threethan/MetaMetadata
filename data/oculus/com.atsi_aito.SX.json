=7f20f&oh=00_AQTRui4cC0dbd4LqkxPejyjef0CvfqSsFwd4XMM6EJe5aQ&oe=6AEDEB7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xU0mB5LVg8Q7kNvwHzmuNA&_nc_oc=AdpZ_VlxhaQ27KDd77pRCLVtd3pXfVtMbdXvDakeH_PVPoGW0P852ZhV9QcATr83lDE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw8JdeAKSSZCX2UOHIBV-GC9Ld8D_l5WyuurEge_cDQw&oe=6AEE0C83"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gbvSAy8p-1wQ7kNvwGcJwzC&_nc_oc=AdrpZ3kU6Q0g3SR_xV31SbHn0Xc6Vow19_V3Rw0_FRwUkrXjpdOvGKJFDVAP25VrAIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqwsMT0hJFK_r_aneno1lTqQPqCHDRpfkK28vQdTePMg&oe=6AEDFEF7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tkm4_3JcpcQ7kNvwHFJumM&_nc_oc=AdphFc_nDuEGdwSWEamqeUr2WM5DrVInE1o_GOQxiTVylh9JRMxcUKBcbodvUDu-DLk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT45oYymCRx1_NzrOYzWBElcpWyo-gNMZ8yBtmU5wHzAQ&oe=6AEDEAE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFF46Y8pcQgQ7kNvwGYXzM0&_nc_oc=AdpftzQWCHaGPxLsjucIBvGUsci5iTD8T44DEjRoxokszAwPISZWY2p83EPI8hNH4aU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuZ1FNuxEfdrkEi8WbuO0kytTYgYS9KsXfWI1QwDuwbw&oe=6AEDE097"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cc1ESsAsJx8Q7kNvwECCJtg&_nc_oc=Adp5tGVhx6-STyvCgwJMjRngbdBieZ8ayCv5O3FprpVIMv7X6qMi8DWFgAJ6sqGUHZo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSGcYnfOncEfM4uRMZJgyQy_6Ft3J-xKSEXWOviX_i5w&oe=6AEE07F8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omza58Fy3eEQ7kNvwEVIPaJ&_nc_oc=Adqr2ocEp4u3BfVZAk5WdrckTZ0UzrafIkl3HPja272zJoN7tqjV4rMO9WZxFx90rhg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTXavI6e
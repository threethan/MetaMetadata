=7a30f&oh=00_Af3bSYFC5b6DbsmDzpVvMo-tQHAu-4Hs-AVCEud5VgIamw&oe=69E8AA3B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_HYstoPyvYYQ7kNvwEqX48R&_nc_oc=Adqke9DIG99dxdv1E_b0Qx9U1B9yNxUIvjhDjZr2LLZSybDL1gwHxuWoLqghe4CBtQs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oJCRTFQGXTrVMe9z957t9sejnatFX8UB0KW-MjoQ49Q&oe=69E8CB43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bXTOmzh24QMQ7kNvwFMmFMu&_nc_oc=AdoJ8056piqmWVC8aO1upIIdNbMP_G_U8rTLP7xzqb5OoB1e_bw8Alo5jq-HngCi82s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hlrqE5t0wgSMUUhd_ZCxoj6NSrPf6est1lxF18Ee0hQ&oe=69E8BDB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miAKoY8KX44Q7kNvwGoWwYn&_nc_oc=Adq-Jmz3ZN_CXPUxHvtrBvFJvvwRT1_Np3sfo8AefFLTyzuWbr8s70lfNIBLe-76DS8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pb4RVkRqFqoutN4O4TF9-K6TVXpauMcBtXaiDP2isGw&oe=69E8A9A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDhX867Fh0cQ7kNvwGnAaTG&_nc_oc=AdpI90UWK0enfAWxWk08HorFOU_Pm-jftwuw_8sjYCtWsorvUG-OmUYqxrEpyVtjl4M&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y6NfBZMAcUXDKUoU0jDe_Qvo-60X0Bh5wek8L-VHjjg&oe=69E8D797"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ru3lWZC5uUoQ7kNvwHURBwV&_nc_oc=Adr-3G6Q8EIuHxDERsx6S2ZEZCq0RG335H0K2p3t_pQjix9uUUfIcL5tPTiPMTZqwro&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hQoNvGVdd5qrUAPp3ONq1ivSu51QZx4magG7dUa3z8A&oe=69E8C6B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jk8t2-kmBkYQ7kNvwFKiJPd&_nc_oc=AdraVali7RlilkZ_jPovEPeQ14lzvunJLB-JnjCN_lDR_KPHyb4gbNq2g6jIuMfOSN0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3RCVeTZ
=7f20f&oh=00_AQFDKReliO8u552mEoSsBZz0b_YKNNR0oRMb0C4ze4Buwg&oe=6A79AF3B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve9DJ7bgGK8Q7kNvwH1ONVv&_nc_oc=AdpsvSSXjNs6fQqiREsQokBbzUGoQbPhG573CWoppocJgJi87WD-5eS29ldMS7sbB3g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF0vBRuzKRmTT4cS9kn_rFPhdY6roC4DNGtd046UJhuaQ&oe=6A79D043"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tlqh9kA-PowQ7kNvwEau4TF&_nc_oc=Adr2B2QmKb3RnNv0-nNZ8SujXrzYtXboiTGzsCaGxBV2QCS7innzHJgs0KKaX8SRi8o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdURW2Rwpdp3s0SzMghRdTkxOvlMYdgaQax58L2cCqUw&oe=6A79C2B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3tZ9PkQ8RkQ7kNvwFPIbU5&_nc_oc=AdprXR1tpxK51MlNOlShQe9rhy__wdpJtVb-JluVKjxgybCiFkboN0D1QgP8QQn2k68&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEi3pWBP4pPjvidNsy1wYwtAHBvzZhCpu1hj_M8aML_Kg&oe=6A79AEA8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxE_T9PJkcoQ7kNvwH1W2tn&_nc_oc=Adoorlmd3z0VS3Kzk3cH1RaO54v82zUOLi3Iffk7T7OP8LvpMRm0ryuxbTaxu3hbGw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFWrJJON7pxpnbMXDZeudq4BGW30UiLazTz-f5abhd4AA&oe=6A79DC97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsLjhJl22kIQ7kNvwGItXA_&_nc_oc=AdqPyLgus_EdWhg2GZQ1HNohg-jLBJ7GWwZAQiik-i4BU3BCiG77rrP6HSK3DlWPUgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKNBnMp7oZJ6j7SvK_PrNXqI5V680Tsx9pxFSwMacZCw&oe=6A79CBB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wIWuD4esAUQ7kNvwE11aDo&_nc_oc=AdrbJ2ujhYJ_Dfq2fYdGHi4wFms0z4PcHJbkbVvF-TI4oD_38lBkqSC-xnZ4nWRLUdM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7vA-iL
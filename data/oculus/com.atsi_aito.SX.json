=7f20f&oh=00_AQGg2RDD2qNEzr5WzWDY3NRWAmiPz5zIIzL1ykR7ANBNzQ&oe=6A81983B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpqWtkyFOT8Q7kNvwFLbsla&_nc_oc=AdqaX013n9Q1G6vrdEvft0U6kTidjKgIpqBgroYo2sWApHy9gOsJhhaNopMEk-_Z2J8&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENmBwCE5bEX3qBB91I7AYdu2rPmZqZaNedQfImejVcig&oe=6A81B943"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UUQucrU08HUQ7kNvwEBVAgB&_nc_oc=AdpWYHxEWmBbXNiqnAQQnXX2W3suw6ImGb6FqMwzKdC1WRH4kB6pcSu_2PdLmFvoUh0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGpx9VoOv394P4I4bXFoXdgDiseGYStb8PRamLdtwxwg&oe=6A81ABB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNuMQw9FiD4Q7kNvwGXOBYJ&_nc_oc=AdqfnPc4pfAhvjVo89518FggQExYgqtWDzOtt4f6oUERHw0jfHCOQsJ4MtDArhd5Gow&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-W9BuSgsx1uOhawa21zOX6_4WWtXhhxHqkZ4aWlankQ&oe=6A8197A8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DKK9jhDhX_QQ7kNvwEhCKRr&_nc_oc=AdqZERUz7bCp87peXX4gnUiCSrcTP1VWN6KN7qAiqDINiCzgY5H_1_tWZ3zGxpbp0xk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGEBkGcFpPLHRfj_u3rTNq-GoG3VFb2r1sfciqHEw4Wg&oe=6A81C597"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bAfESxtLougQ7kNvwFmrD93&_nc_oc=AdrtDpHnFNkhxw4gY1JsoAcxzvV0g4TYZIY4OhCRZYs49pyb1lU2Me2_8HeprDxAKtQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2P7L8i22coWdqHisGHLoOVa3vQ9TC3XmHMyRpSA31CQ&oe=6A81B4B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPTRoB4-RG8Q7kNvwHzuRKP&_nc_oc=AdrGH-uy8lq8LKZ2_RFH8LfCcN3Vg7az9OsHR3u-ye8ly0lIbrloIletLiqGjnI163Y&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH8iisS2
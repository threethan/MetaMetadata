=7f20f&oh=00_AQS3h76-Fr7qbafOUKp0jUiwkjwT0ychVzXI30wfdJJZHA&oe=6AEB487B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l4QOC7LAEYQ7kNvwFMCfZy&_nc_oc=Adpt_TNWO_mcHYg3t1k_oGxuRVKHc25lK65sZkSJQhsQ1fG2ICgu_OI6V5gVXv_R48w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIOPK_KOmPkl7bDAHNlFWHIm-E6ydLcjK_ClXAycY7iA&oe=6AEB3143"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TdsA88Ow6WcQ7kNvwGBRx9i&_nc_oc=AdoU22jMsFCFTedmYNoIHhlDJjUlkKJztTwCycGrijaC2zwLRDEFgv5GPwLekwCDlEY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_WsxCii2B81usTZj0ktJXwfLzJAmanwy7JDuKUwg-Yg&oe=6AEB5BF7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=osVnFp07ztsQ7kNvwGkOvE7&_nc_oc=Adq89ZZ8-fQiA9PXsuachm2vRlJZNAQpKKh6MKTbxZVdGL1vqit417BZX3G9y8APyuM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxvq7MQXqG6W9iHFRffRC3Too-9x1R9Vw7tUJ6VQPfGQ&oe=6AEB47E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SlCC9GdWbmcQ7kNvwEYHTyC&_nc_oc=AdrH7LaNLtbQG1ixRoYD4SUpvGKIuFNDx6gHwGuwRgDu9d9sA8eTP6UIcdMMKv1rf6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHgViX_9Cyz7NG7KFarj3LkroqexHm04A-J9nWAz1iOA&oe=6AEB3D97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=De4JPEEqmqIQ7kNvwF046ae&_nc_oc=AdpYcVOjTO46-cpfxdgj1F_foz12cWIAtVjOvT8QmQLakSOjRfdg6qsSJyG3UnNQqy8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYiwfs65KCxVhM8gkqRTENlPwuKi9ZpXP1Paq_WYOXAg&oe=6AEB2CB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=omza58Fy3eEQ7kNvwEkQjTv&_nc_oc=AdpITdjvzecIK8ztx5UHE5N52pS__eXXhAo6ITcM71Z0BojK0g6DUC-U5uPoHQowNqA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcCo11i
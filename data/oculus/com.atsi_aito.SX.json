=7f20f&oh=00_AQKGQYYy56R6Krhx2CBXWBjWpkZZdRag6FEFTbmarsz9VQ&oe=6AA1747B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=53SHVeja-GMQ7kNvwFiEwaA&_nc_oc=AdrLh3_qJNM5eQJDcHZf6vmWeocOzfiin3iLRHzpJmQu4LsBu7G9t_9TRwkuhehzLms&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXqSEXDY67v9nzhAez8YnVsCr_88t-Dk63v0LRTCDcqA&oe=6AA15D43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6H8GCT-F-QQ7kNvwE3rYPd&_nc_oc=AdoSCodkB-fMJ3tTQ9FUOnA3DYM4wacWjN0FhXyE3zf12OkOwPJpoGr1B9b7dEH0leM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlbneKOyhRBZkT7MnCSQRLOwE8jkPNTLxuq-CaTFfnrQ&oe=6AA14FB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I46zoPoyZZQQ7kNvwETzboG&_nc_oc=Adr_rX_OxoX6SejNIIbzT4o-fbxvM-SEugBoLxTHitWjlgiPTHg4HRRbML8MYpFuF1Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKAf1j9LxTX5yIlW8vqlKi95Y3557dru7omjXUK8bhtmw&oe=6AA173E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=icYSXSW9UJkQ7kNvwGPxg_S&_nc_oc=AdpVh_GJDDgTV58d_KFHt7_0PDFF7irW_EPv7QG8vLMmQEwAwFGO3lpXokbybp7IUq4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKebsDTJWBHJomggwGd4Z8nj33amY9oTTJ76VTaAJiGGg&oe=6AA16997"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2tJq8p0QJsQ7kNvwF9zNPJ&_nc_oc=AdrFevVMDl7zFSB0f6ct44hDtBM2FT6GI2jnuCh0JvVzqo8pxrcgP3xNS6Dd2ap4uYY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq4SKYRYWxWIzVIU_WYAg2XDmF9xqOmlKDoNOp2mVJtQ&oe=6AA158B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6PFJMW6PNYQ7kNvwEK9dxM&_nc_oc=AdrSA1N3WFT7-7iphNpYUBxIoTq5QWLHMczpavpnxP3_zGSshZKm9--KDvLPxF9L2Fw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItt6ubq
=7a30f&oh=00_Af2VKs3bK2R3qXzxjG9vgrVrPPFKem80mZWdWThNFQvHGQ&oe=69D8D83B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nBPXEbeaWdkQ7kNvwEC2LpY&_nc_oc=AdomU_y0DljXlD3JfEQIzcaeae1WeZ_TEXNsAzoNwB0my0vu7_Yr3wfYIRoefmfcS10&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2qEoM1pkz08jNQEAUo7GKtN2tBLazmojlMG3dXrBoa3g&oe=69D8F943"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g3RfHdZbZh4Q7kNvwEcfg6F&_nc_oc=AdpsWdw_i8jpy6PF3c38ikzgnmjy1l4pUUNLfgd5Bzi5Gmix01yi-YfIoZr_shMwCb4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0KTp4CwrP53XGEn7bkewoiLs6Wbxt5cY1-i0hUld1LTw&oe=69D8EBB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HRP5-bfGOckQ7kNvwF2NGAl&_nc_oc=Adqj9-zI00EKx21O9D78lf0nmbdXzqnpakLXw0UC5Y9qGDdG7_0vEtkk9LLTinLdyh4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2sdCLMpCuDYm3OeFzWSDw5Uo-QO_viHKHajSPhMoUs9A&oe=69D90FE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DnHyl80fa4oQ7kNvwGewE1L&_nc_oc=AdrXZBTU9ZPtrzc0Ot2jH5BdSimL_FA9iZpNdhjbcYQw-lagRVZP19IB9U--TNkg-5Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aDgF1UkHNrX8vg1seaDvUNHhI4LsTJyadXyvTWmX8NA&oe=69D90597"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bRz4im9SAAoQ7kNvwGZqDKN&_nc_oc=Adrff2NYcXXwyargoQ_wd1U3h86lfLvs6eTWl_vxKp0wOPXfl62L1HAEnOyBVlGoNXs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1TmeCvo6q-OwQC_WOvxEv5EeHDXDPzLT07QVc1bAOLLQ&oe=69D8F4B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiN2EQ-umVwQ7kNvwFawQjf&_nc_oc=Adp3xXGPe6j_2G4VsQxuP8xvYWF0zwEVushB_c5IzA8h_9ye5nxkaR3lOK1FJemd35M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26vZgjJ
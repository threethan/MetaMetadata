=7f20f&oh=00_Af-_sSVDNXbT9idITrC7IYKCue502BQzq6CeCIQEUHXkLQ&oe=6A37FC7B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=es75YtmO8YgQ7kNvwF8tG6z&_nc_oc=Adr0fZ5L3fpuAot0nU1EAq2SlcFtGRMlhXfKXJ9WKZG-LDyTkHpMwM1131MHCye7tMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jkYYgr5W2UHLLReuzzxy_bDLKlVAkjp5l8M7741XIVw&oe=6A37E543"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5SmS53fiu4Q7kNvwEiYJx5&_nc_oc=AdrjS0MubGqFiWEMavFXYZCKWmQnMuCqdPNYiL1la5SF19ppZ_dD3lsghDK9iFpkDtg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HQ-8181shBb05h2J-INKC-96cU3JdD4m57PtKaPYz_A&oe=6A380FF7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNayoN6MzncQ7kNvwE9ZEdB&_nc_oc=AdooKR6lIwV322fyhBiTRvO5NGr2-2UIv6WxTugKba6haqmdYhEgIa5Es-sBnr8Sgzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9VnYm5rlieA1ovQbszACJry7rEFhuqGwwJrc0d0R65EA&oe=6A37FBE8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sfb8n8Hm7IsQ7kNvwF17ZDN&_nc_oc=Ado5TDxpuo4VcDj3GGn2ZL88iwPuOoylA0PIlnaKG7JD5mS36CejxXQ00pO7dTQa0UU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MyzDGs26gC9WS9Js6LvR8cyycpLd0iZft0uZc64YJIw&oe=6A37F197"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=144jTZXkT8QQ7kNvwEeyXAq&_nc_oc=Adr_hVSEIGH3-9PJ5EsRuR_WsjSy0TqLQHB_DmqYuxToEkKQwYi7nJ6F2yy1SO_o9Q4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ZK1toFICp3y6ceHpCRAiQoq9JGmH_mFuxYA1OYoQApw&oe=6A37E0B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIKqmjmSvB4Q7kNvwEcv9xh&_nc_oc=AdoXOjEZ1sYoGCgauXiKozMjedTxVUaIpc2j2APhZolNWfPnHvrpBuLQm-afIqXk64s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hR0t3f
=7f20f&oh=00_AQG8wLojLHMTf8o5ZrKSREBSAvnwD8OuIU3stQEPoob1kA&oe=6A77447B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5anR9A5YqmUQ7kNvwEv_Oee&_nc_oc=Ado6R4G6p-zyIez33QdG5i4wRlKgHvYFb152iZ_2OKcQwsNjO36sEVPzQ2_anCP256w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHsZIAPjP5TKmBDi3D0C0J303SmvBHlKeNk1TMC7F9VlA&oe=6A772D43"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OJkP8RDqdM8Q7kNvwGDd-R_&_nc_oc=AdrJb8fuLd_JiH1whGjJNkP1AC_NtjW_B7NSIGfELyEcS0ljFSZ2tq7rW9HuPt4DnkA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpJkN9Juak4QsQf-UMYSL5wMzmbbt0o9OhRqMQQDTy5A&oe=6A771FB7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mg1SksLuGPIQ7kNvwFu9bLM&_nc_oc=Adp4GqugbVaDwo5dS7RipQK3jabOJ3MUsJ8IBvOqWU1-Vbm7yMd7XvW2YSFUNXb1GHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8S32EaDQuEgmnOJGHTrPlAuOwUUHhZej7HI_oWNkPOg&oe=6A7743E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4F-feMQEaoQ7kNvwHqAN5Y&_nc_oc=AdqYmIVJovi9w7x8t5SH-9XZvfwAVpxvZ9r1rh0mlzaIrfrdyXiwZwzSZMnJijH3jOk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHHdat2yV3qeXLallzH7ZiLDr-XIKdMdB7PsyRPFq-9g&oe=6A773997"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZsLjhJl22kIQ7kNvwH22Q9p&_nc_oc=AdooHK2Hh_4fe7dKAzFlzWexTZVWww9JFno-IkrOw07lqnO7WLlBJOEiXronyWB6YX0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDrOhYGUNtKyKSUlzbNHceyKJTpiv4h2bW8OE5mrb2Lg&oe=6A7728B8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRoz4pGBx2wQ7kNvwEDuQhd&_nc_oc=AdoUcaYdPSF_Ih0M1f_bZ645L1QE65Q6WdtcjmF8f-ev6rOUMVjkx2ed_nY07T9Ha4k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHG8_-L3
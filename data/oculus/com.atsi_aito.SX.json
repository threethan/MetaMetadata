=7f20f&oh=00_AQN9vzETEnkgR3PVH8JaheRuNU8ywjjLJilgTVbxB4bv-A&oe=6AC269FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad0U9JGlv8oQ7kNvwGklRXr&_nc_oc=Adr4cERy9QCRtzsNaLCwIFkSISIevqF4jSWQqyGPoDubAuNzr3NUil3mcYkcD1dPFOw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMubsDghG8kXMiLWpy9ZuxF_7l8vusmUNtp7gf2ST2LFQ&oe=6AC252C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaA8V0Z4Gv4Q7kNvwGIhzT6&_nc_oc=AdrcImtPz8QAcxaoggAGd7P8FHrbHYB5cHlTBIICvYumr5MkaGyuW_ISWGmJlTG2yCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMw_wgXBsbUQq0DcdJmmenw_-mQ_vMcFTYI0-eTK86abQ&oe=6AC27D77"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Api2p4EU4ssQ7kNvwErK4Bw&_nc_oc=Adowpr6V5zR00Q4oeAN9YIosRnioEdZ5EjPFI3xzuSk1Y7KKcvv6qN3RD_mMGfrmocY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsaYpq1Md44C_MrAJx6AX6RaNhmiORYF5-IoGncWp72Q&oe=6AC26968"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tgoNffQg46QQ7kNvwH-DuX-&_nc_oc=AdpSzCyCmDv0x6Bm821Wb87zOXB8nMiWJQWO3tp5yGMMf76iQXWpFlYKnc04fN3DTo4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOqMC-KyG23LykrLim5p-VCfYvxv9xxRZeR2LWmpatsdg&oe=6AC25F17"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HsTHC6VCyTMQ7kNvwEmoE1O&_nc_oc=Adohijxu3jGb4_Oh-2VOCTJxF92bb9wTjD_Wy4H0C49A1V6pbuhYum_qSsNm3QkqkbM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOG67W-Ei84X1fW80YroB3uyQFhtcf-9Jj4VFl91nBubg&oe=6AC28678"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_VJKV_XvHAQ7kNvwEbx9dX&_nc_oc=AdpG2d9pH0F2p-sjAkP50NT_IeA4ZONKqwHVltfzQsG8tWWsK37CbR_JJBpBSKy5rJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMkU2XQJ
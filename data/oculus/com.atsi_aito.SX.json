=7f20f&oh=00_Af4QRrEa4Rvt1Y4NEDMI4CjMzR2FuKvf2sswVKMvdUFrSQ&oe=6A0B297B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CqX8emVWlEQ7kNvwEM6aAW&_nc_oc=AdoqhiMYE-Vqjf3M_KvVQChLkl3Y_7rPq6msJbiPWUtMQp7nw_Mt31G7bu9l73uO07U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jCIxZBJP4MMqGzzYMXPSuMzvzX62LiKuZ2siw-acVOg&oe=6A0B1243"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eDAPqhydCbwQ7kNvwGe3W4p&_nc_oc=AdqzQ5Dv70X5SyX35VjvYkUkZyS7RB--4klyzUXI0Qa_J1Jm6_g-suykgPCnq7BCOAg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jqm_V9qHyzynvYx6FJdgu434eEjG9SNo3QdaLszAHSQ&oe=6A0B04B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyPurZghYbkQ7kNvwHYwcyd&_nc_oc=Adqlh1AzqEOSCrvK7SgurVkwbXrSFsR7qU2WkIMonRTzQCEl3IwTsCzLp_ptFx595j4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y2eCg4Zbz_DCCgDodiNa1g-WG6LQWaZErlmo9PJOlKQ&oe=6A0B28E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fYvQ8D0dYJEQ7kNvwGokr0W&_nc_oc=AdoTouy2vSmaW_v-jqkvNlugWGe3WMFrvU5pxAl2GQs7-58bRmlpso9GsCgnoGJYYVo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N6hH5iiV9qoi3Cyv3VQlNUwDUx8S8mVKIuivPNGs3mA&oe=6A0B1E97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tID9dUbfiP0Q7kNvwEUieCo&_nc_oc=AdpcwfYX8wEIsy-M6hh7ZFZn1ZUoZ-vB4DvtROjgVsBatT9dM87cw7eri_lRwf6k_LY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DU640sj3lF6sVh0lFnuFb1yL9tFUe-pOnyVOMjjjOMQ&oe=6A0B0DB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=um1ad1wWOloQ7kNvwE0i_Ey&_nc_oc=AdpHYjnX1baQJa6EquM4zLtPXqCRamNDRzFDsDXzjsTBIpXzqmuoUeQKEaOpeyRgZno&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5uzx3DH
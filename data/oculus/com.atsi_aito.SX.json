=7f20f&oh=00_AQBraCOLSCIp2pkkqYrLE_HnHrlE-vqwughxEGJK_LHhdw&oe=6A4FB77B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kVp9Sr5MUT4Q7kNvwFIKWB8&_nc_oc=Adp0JwNbcY-vtw0dbge9pBPVCSxiVlDUttdSudrtH8FTzV8i6KcJ1Q_J34tGd_MT3Mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCgekRYZF_yjHKgLPCnBIE5T8EDw0JSmE87-684jhqUrg&oe=6A4FA043"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ITBZpY72v0Q7kNvwFZiepy&_nc_oc=Adobp2WnV1N2b82mKu9O08iDUVwcb6IVmYHNsoVcfB9yLlLgSC3mPS1koxdgth_OnoQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCwcZNAYkyUYpOF1Dvl_LQlPuTvftDIu0ojP6Kexhuyvg&oe=6A4F92B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RTfvG7IZTAQ7kNvwHqBlC6&_nc_oc=AdoR5ChhU55jqUd3HQNAud_Lq9EVCMRD1UN7c13EZ6Sc58CIqh6pfnhC0koJT592ilg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAYhyybHEHCenZZvt-o9jilXMuNlfOq81vQ46TuOmREGw&oe=6A4FB6E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHblhAgZP08Q7kNvwFoZHpt&_nc_oc=Adqu1mNgJ8EuW06V_q5vlq2WagM9yL9E89HvF25n_NY23SL0P_Yj3Xd0CfIAfEbexFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPQN_f_Wnlq19cpKSo5TLSeOJu9eZmJ7NZ_dauzlS72A&oe=6A4FAC97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJ9Wz1DHMrMQ7kNvwGVtiNL&_nc_oc=AdqiMFLhwT4Sj3iKeq_IUOrwoA8UTvd8hZyBgcdBDfxAI-_smhltUGRR-yEMqbX1tWw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6aLNnNSdOEZMYpUyfBJVD_amheH6iYX8D7U7NvnI6Yw&oe=6A4F9BB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDdVaLT8v_0Q7kNvwGt9XHX&_nc_oc=AdrU-6vdDPGwN4pM43HvDJy7Uk0brCekl6tnagS6sycZJcG_rt5oUB5VBdGlCSFJgzc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRwzqll
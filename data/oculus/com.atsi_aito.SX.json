=7f20f&oh=00_Af4IjCvqx9Nel-w52SLnIpDYwmlG4lotDFWm_XRFGU9b9g&oe=6A18587B"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jpzuppaUwg0Q7kNvwF8kYPU&_nc_oc=AdrlMlCG9G0H_QplqpGzhUUwTFwVx9TMM9YK5ezhlCvmz3-hwiLngkJYHWtaEoTxfYY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yyNEnYRZAxtO72dYw01HS7Oov8WU8mxyK9FO31efCJg&oe=6A184143"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZY8Sukp2stMQ7kNvwGxpaZY&_nc_oc=Adqjxd-zZRXubFCzZndiOw01B1VcFm8h6KFbILNFAX5qrEVHEEpGRenDfYEXEa6kd6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RXyNDlU1Q46W0jRlmUBfRHBBU9O9W4OkH_hC25qqe0Q&oe=6A1833B7"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D_hsjyVhrdMQ7kNvwG0wAYo&_nc_oc=Adqq4FOHUows-is5WkNfqK5B1RCtYgjXAtrBOmxPxxLMilWuxM4X2z9QfKjX3psc2aE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UDwo2UzH7_E9eEooCMSoGDwDufDmsLPJibhbP3eVHQA&oe=6A1857E8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hfpNydjRIpsQ7kNvwFIFupZ&_nc_oc=AdpxUdKvehz8wCuszlFkCSH-DN2jUGqY6_QZzoPFyvFazzZBW_H8ijSmuOAuvo8WyhA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af63hH1w8HvkzJ_h0UhHGd88i4msnCXg7esnE6p6n149mQ&oe=6A184D97"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TAP3OZfzeisQ7kNvwHt-8OB&_nc_oc=Adp3XsXmOODs1LQyj8jC3UIfde2dL5EpgHc-rpB0IGOXFI7L20EAcaYlL0f9KaaG5PY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56v2-Xch5Eprin79O_uZ2XPqGWdPcqAxF-RKskqA-3FQ&oe=6A183CB8"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ccSIDVQxXkQ7kNvwE1jvGO&_nc_oc=AdodwyVWkZGcUBP3S6Lyas1F0eX_2A7luSBBVQR9XqEBfGlCQytGCKs_lQADD9-hJj4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4opTflT
UahKJYO9MBkAZaYdezXYW-aQhtw&oe=69BD28BB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TgECf2nw0KsQ7kNvwEAmDgh&_nc_oc=Adlmkb0Ftus0kyAQqfnU-KwSgmHH5jq-jXz0_DNMJpIiGmgidK1_ZhKQ-7nnpxEYH3Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzYweQI_KqhtFoCcsuua9II6gG3CRO_Xso3Rsg8VLaJJg&oe=69BD49C3"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQSzwENrLHMQ7kNvwH0slga&_nc_oc=AdlqKSn-ISSp_W4SHEegnrbJuLiUS94YocXSimZFSIaW9EsXNY6NzxRyYVVXjqAzH7c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afx7QhnpfySvYrR4XKEL8PPPtctibg3ivMoBWH_5aclDmA&oe=69BD3C37"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_YQmwXQPfsQ7kNvwGFp5h1&_nc_oc=AdmjlYeAyQQDXsID05leQvbV5FRiy1UUAAmbQQ61OxsmIn1PAljYVeeAOMZqMz2PXdY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfztuL5hhPeJJMdqc6FtNiMgX62AdjdBDInLlBQyF1yPTQ&oe=69BD2828"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPbuDa5N8E0Q7kNvwHhUjgC&_nc_oc=AdlGQskO7d9I7ZBKXUrebhDGhl3zjMADr2zEJ9zDsX-0wSZFcaPn3jebAhFwmfHH_ws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzFWgrUOFUf-auPyuFYydAJuYJRgPqqFHQue_hXvJjs8Q&oe=69BD5617"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CzKgXHPO9uMQ7kNvwHI169g&_nc_oc=AdnGrOsw5ZdhQFX7LSXFhH5nP2JBQp0Fj0JrDaD-IZ9KR9_Wl69vMZeltRQ5Yn76ewo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxRaCCOFpBkEIm0lIrfD9cxCHiHY_CMATPdZnzutyO4WA&oe=69BD4538"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ntHFX9jCtwwQ7kNvwGCpWeN&_nc_oc=AdkqHN9mEHDwu_7a9G0DAJG33FRGBlmG9ar3QaBtZ8vufqVt4997XWGQwGYFvch7ivY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxwxGoYkcTtFZ16H5kiRRO-DDFLHQfmGUsjV0Qt6qp86w&oe=69BD5706"}, {"f
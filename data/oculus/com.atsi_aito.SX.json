=7f20f&oh=00_AQOgczwXteLhpXJk2sMcWvTSiPziuRPUn4y4toY0rzjadw&oe=6ACA52FB"}, {"file_name": "SS3.png", "id": "723134115394774", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031454_723134118728107_4043384121724302618_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B5NIDfIB5awQ7kNvwFpBCZC&_nc_oc=AdqPxQwaq-LGKJRbUB4IomO-3XO9mCSjhLd8r4cZ-0I8J1lKvV-yZ2v8hype-sKkgu4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw8_SrDwDoOlaH2gj6JNeVQVtDNiTXOR4amFW5w8VIGQ&oe=6ACA7403"}, {"file_name": "SS4.png", "id": "754772309021381", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974748_754772312354714_7880261410314101793_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQyBV0bdRM4Q7kNvwGbv9vk&_nc_oc=AdoyvsL9Lnb3a4PlgXd5CqrUTWHmGHH7Y679pD0lcRdxQJUvHk4fMBhmpq2JiXPOqD8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2jEklyGPcjrCZZvHpE4M4yzjDjKRffFBtpdShTf1YvA&oe=6ACA6677"}, {"file_name": "SS5.png", "id": "390055603063549", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035320_390055606396882_5049138452910400198_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rfYkPR1UhAQ7kNvwGPr2kL&_nc_oc=AdryQGR52lfmi1_UKReknXwsP_xnZNbPOY_ayzfDTcYCWFjXTYDYBrfojawAkk4Qa2s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfkZkaP4QUCD4EoqvRINPitP9HluNNZETmY3w4VePzsA&oe=6ACA5268"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CA_Y.png", "id": "676592056732564", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75462961_676592060065897_4767015868477364991_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hLI8kzZ9Gi0Q7kNvwFaD_wZ&_nc_oc=Adpm2M0ju0eKyp73sOl9UUxSEp4H5i_Irque72rOhDexX5feRoLIjQ1h_6euEfuQ-yE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO1mUNiW2LqbpngOPCFpJyH4gWV66c3GoPkRhKYjrs_hA&oe=6ACA4817"}, "display_name": "Simulation X", "keywords": [], "long_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR.\n\n\u2022 Method of operation\nFor hand tracking only.\nThere is no move operation.\nBasically, the scenario progresses by touching objects.\nOnce the battle simulation starts, it will be a gesture operation.\n1.Attack - Either hand is a Paper\nFrom the palm of your hand, the spell of Shikigami comes out.\nPlease hit enemies and items.\n2.Defense - Either hand is a Rock\nA shield will appear to prevent enemy attacks.\nIf an enemy attack approaches, use a shield to prevent it.\n\nAs the scenario progresses, you can use a Bomb Attack.\n\n(Please refer to the website for a description of the items in the game.)\n\n\u2022 How to proceed with the game\n1.Start\nOnce booted, system navigation will begin.\nTouch the Start-device to start.\n2.GamePlay\nIf you select Shikigami, the battle simulation will start after a while.\n3.GameOver\nThe game is over when you receive a lot of damage and the \"sustainability\" reaches \"0\".", "short_description": "Pass-through MR shooting game.\nWelcome to Simulation X.\nPlease experience the power of Shikigami with MR."}, {"images": {"nodes": [{"file_name": "SX_HA2.png", "id": "3000425346762311", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974640_3000425350095644_345006402581541278_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDPZSWEBawoQ7kNvwFcOmav&_nc_oc=AdoUzQyS6_rxMS8cNbeAhlLpDOSBLCsCKJmUKCnfKVMXvXcJFrqP4XQ3J0ArgEHYids&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOcqAHtD4bt7niE1zKQctnt6x38Ts5zu7rOnHYs46oHzQ&oe=6ACA6F78"}, {"file_name": "SX_CA_T.png", "id": "2224180891334863", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974746_2224180894668196_895140125717342456_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKQUnahoZIoQ7kNvwGPmSA_&_nc_oc=AdqOG7hCYEwvSXHnWzsrV_3I3u3nR1fmlPmjH3xBfWIRD093KKvjizW0JPCh_ml5n4U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNJCG9t8
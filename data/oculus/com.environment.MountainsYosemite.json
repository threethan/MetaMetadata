-ams2-1.oculuscdn.com&oh=00_AfvtprxkvMteh6gCOCOaYw2nb_FDsQu-WLPfccZR2AdKAw&oe=699EE1D2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "9014616641962581", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974638_9014616645295914_4453090153486170430_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=voqYavxE3ckQ7kNvwFnWDPw&_nc_oc=Admot8XsaPWb1H5th8trXcMwzeOXrMiEd5wFMVtK90lPEsjzrP6K2qakFjizJe1vKHM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs6C8K_IvI9PK2ij73PPxDVtZWqIkvtJpBu2Grr8WZaKA&oe=699EDB99"}, "display_name": "Snowy Winter Mountains - VR Backgrounds", "keywords": ["Mountains", "Relaxation", "Travel", "Yosemite", "Backgrounds"], "long_description": "Escape. Relax. Immerse.\n\nExperience the tranquility of a snow-covered Yosemite Mountain and the calm of a distant waterfall. Whether you're working, meditating, or unwinding, this background offers the perfect escape. Enjoy a movie, surf the web, or simply unwind. Transport yourself to a place of relaxation\u2014even if you can't be there in person.\n\nSpecifications:\n4k Video Quality\nSeamless loop Video\n\nGoals for next update:\nIncrease Video Quality (5.6k)\n\nEmail suggestions: VRBackgroundsemail@gmail.com", "short_description": "Escape. Relax. Immerse.\n\nExperience the tranquility of a snowy Yosemite Mountain and the calm of a distant waterfall. Whether you're working, meditating, or unwinding, this background offers the perfect escape. Enjoy a movie, surf the web, or simply unwind. Transport yourself to a place of relaxation\u2014even if you can't be there in person.\n\nSpecifications:\n4k Video Quality\nSeamless loop Video\n\nGoals for next update:\nIncrease Video Quality (5.6k)\n\nEmail suggestions: VRBackgroundsemail@gmail.com"}]}, "developer_name": null, "developer_privacy_policy_url": "http://vr.gixcore.com/SnowyMountain-Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Robert A Bishop", "support_website_url
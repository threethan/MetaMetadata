-iad3-1.oculuscdn.com&oh=00_AfuR6DiRDwpcWZ5dMX5Gwy3gYhV2GUO_0QVp08wEF0Df0g&oe=699D9052"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Image.png", "id": "9014616641962581", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974638_9014616645295914_4453090153486170430_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0SFVaS_hkXIQ7kNvwEQe4Qa&_nc_oc=AdnW0sMoqwWrmM0mlA6DVKNl_vFnag_CFwOFttrTlBmAoFOnVJ26UiAVfm0N76E-mAA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvRowQWWDiwyyEkl-6c83zG-QD_d6Wqzn-wOekyc89KUw&oe=699D8A19"}, "display_name": "Snowy Winter Mountains - VR Backgrounds", "keywords": ["Mountains", "Relaxation", "Travel", "Yosemite", "Backgrounds"], "long_description": "Escape. Relax. Immerse.\n\nExperience the tranquility of a snow-covered Yosemite Mountain and the calm of a distant waterfall. Whether you're working, meditating, or unwinding, this background offers the perfect escape. Enjoy a movie, surf the web, or simply unwind. Transport yourself to a place of relaxation\u2014even if you can't be there in person.\n\nSpecifications:\n4k Video Quality\nSeamless loop Video\n\nGoals for next update:\nIncrease Video Quality (5.6k)\n\nEmail suggestions: VRBackgroundsemail@gmail.com", "short_description": "Escape. Relax. Immerse.\n\nExperience the tranquility of a snowy Yosemite Mountain and the calm of a distant waterfall. Whether you're working, meditating, or unwinding, this background offers the perfect escape. Enjoy a movie, surf the web, or simply unwind. Transport yourself to a place of relaxation\u2014even if you can't be there in person.\n\nSpecifications:\n4k Video Quality\nSeamless loop Video\n\nGoals for next update:\nIncrease Video Quality (5.6k)\n\nEmail suggestions: VRBackgroundsemail@gmail.com"}]}, "developer_name": null, "developer_privacy_policy_url": "http://vr.gixcore.com/SnowyMountain-Privacy-Policy.html", "developer_terms_of_service_url": null, "publisher_name": "Robert A Bishop", "support_website_url
reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2oLx6HvqfUQ7kNvwFJ0-zR&_nc_oc=AdpzDHm6QLDqcr9WNJYB4EkeLQC7TVWrRotLE7v8JWua4YTv_nuSsn8cc5qrlaQkjss&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GcoLHK2Kf1DWvdFMvZfwqSGR7rn7cgLMbTkcPdT-67g&oe=6A3161AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HacB-3nTDJIQ7kNvwHe4VML&_nc_oc=Adqr6Jo4av-5ko-UxgfKsXyH6lBFOUsVQghxDIjQA4hSP_6oKzJjwWw4Kqnlbb7gLg8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4mpDnSuCgiHwa9YWQEvTCRQIfpxTn90Pm258o5JPJIQ&oe=6A317501"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x58aQHHsakQQ7kNvwFmr4r1&_nc_oc=Adosht0BDX6ZUQwmHjhb1RfkwdR_uTaUXr2nIxkL6GZnXY2_2DFThbkHIQU3c0zt5qA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-fpkjtp8mAHY_gfRNcEZouKyzRFeZAuvw55MrOMqyEhw&oe=6A31690D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKnRYdTCsq8Q7kNvwHpmzvL&_nc_oc=AdonTUtn1t-6D31ljBbK9DI8F0309V2fPzTwgFIJ6RCOreylK-KGNQzU8jc_N7Ow9C4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8s4Mcxtzn2M02NxqcitUtOF4fThS6NMQJ6423FKgUODA&oe=6A31758F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gTXrfH84VJUQ7kNvwHXwyM7&_nc_oc=AdrldzXMQ4H5NXkTJTsgzZncxaFfOnpzNmeVGrcb8d1tmpu7XkEaKW5gjQ1A8c5DDjc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-gm_Ckd1sda4Fg4jy3oY5MVqdt5Nj9lZ1JqCoPPsXZtw&oe=6A316D77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEF0yLVFHOEQ7kNvwFlj91r&_nc_oc=AdoyZc5OZhUo40G48CQmvvRcsmsFx7HNSHxMGzVKosFJiNNV4BPHYsGLGxNwvfSLAI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WYw4J3jax7qRGdpvMhJmbJe1gOMP1AAOzq7AXE9C1nA&oe=6A314C18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5AQ740LepsQ7kNvwGToVv8&_nc_oc=AdqQogiYuJ-uasPJsHbElAUzY8eq1X0sSS4QyzKe-iVdW_rhAkL3Q3gy5zW_hAJ2NrI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WxzUJNWSXQFVLozO6rrwakEKcddgh-Y-5TitEtuhUSA&oe=6A3156A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
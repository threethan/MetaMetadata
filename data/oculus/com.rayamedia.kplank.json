=7f20f&oh=00_AQGfIoI0D6ImcWCgLPAyGwOKXfGhcvrdx1wmOIPbQnkOMg&oe=6A732C2C"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IsIZt7stzXIQ7kNvwEpMffo&_nc_oc=AdofAFSixcn3qmr5yfuQtwS_kEeZX2LA5UiH2cuQGd0TrDp5Etfd4x8Cedpa4KbN9uw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGmavn1dZdEwvoo6Qq_qy9crajPhtrjlMnv_PpLJAEdHA&oe=6A734CAB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0h8SUGID3wQ7kNvwHxAjY5&_nc_oc=AdpSseOUKjQulb8oqtmGXU9lVxqDrTG0TExiLk9eBSAve0YkTUVXO6UVIOMA-ds7O-o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_DMe5MnJD0TSg2H8sblSMPC1vqF9qad74bfDCRGOkXA&oe=6A7327C1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ItKtrhcUphEQ7kNvwEBUEXV&_nc_oc=AdpEDva61EuK7oF8U87itIub1Xdp_Z9Mehx152UckeHPUmX63rjoulyYpWI2_BuM53E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJNTvDd7YS7TtwjDu-oohpszOxS7lN1LsRDGLziPD9sg&oe=6A73540D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_yvpe7Jwa8Q7kNvwFN1Dpb&_nc_oc=AdoXW1WcnHjgTY7AsuYKVGjMYQf_dt8T5EZYG3iEtPcFq2GsZ2oLmVgFG-B7YUEhBZs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhPKx1_3K7gAWLp7ny_QaYgivk0QT9OQ93nPLG_8ZbMQ&oe=6A73284F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYoQGuHiXV8Q7kNvwHMhWAH&_nc_oc=Adrx2gi5FmGsYEOZPIREsO-5E2MuXt6dbLsU7vpHzzodUpPlxTyL7ViAZUYUTUqghBo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFchLztzvlFXZDVq4PrIXG_BRM2h4ZOoDeUt0P2yl7mUQ&oe=6A732037"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPSCPp0BSPQQ7kNvwFDiItU&_nc_oc=AdoivcQh2LOs0ok5ubmGCIz3YlKb0HI0e0lCvBPCdQi2Qhm--5FJpfyun7FYXcPyqYg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfy9Zj9ot5NwFxHeabeA7_7UB-aycvFCYnk5aMHoMSig&oe=6A733718"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNN6BDCbqY4Q7kNvwEbFLaH&_nc_oc=AdqEgAcuiDUNeb1vYWBpQf15vmwmTpFQv7rs5bFXBDIrrAZGXl9R2qGqDFZFQCXDuzQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEivpyk2OECOMHk06gs17qHwcv4482wxqPkO4Fo4AyZ-Q&oe=6A7341A8"}, "is_concept": false, "is_test"
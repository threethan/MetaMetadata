.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5EOyDiJ7rIQ7kNvwEZEFi5&_nc_oc=Adongk6QV8h4lJ09d2dY1r0GCaFx6PATj12uylgBxynBpGZAjFCOY3jKsJ9q7EpMUU4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBmkilcZHnfG0MdeSihm1w--3URuTRskRgzuQ99jYf-Tw&oe=6A58C237"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWSun1X5DN0Q7kNvwH0Iczz&_nc_oc=Adq0ffYKoGENiyTxNzPcxTWgWn46jesFZlz8ZETUT3-ZrXY2cjIadgrpgMuqr2UDBqs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0DcOPecV7y0pbXT9ih5nmBueunm5jtA4-zdFO0KKk8A&oe=6A58D918"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fRv_oKSTR9EQ7kNvwGWdAuS&_nc_oc=Adqcm6m8vdSL5i7KnNn_fPTyYNVwai8r55v2kVqpCYhMpfaPV0ZEzvzS6bVpz8uWeds&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLghsUqxJiJ1Y7PuTn86QWA2Z0qIBKQ_yNDTxOJJzv3Q&oe=6A58E3A8"}, "is_concept": false, "is_test"
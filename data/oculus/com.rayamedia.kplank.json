reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ed57aVl734UQ7kNvwGjGwD6&_nc_oc=AdqOM5npuUpA4fk6G4vfRry4ptNkWlGRKDpgP6eNARbIVhYLI7fzf7eT9wFNytTdN1M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VqzWX1aARMdY2WGqB2yZ3pjm8hThwO0k-0H_uZOTjaQ&oe=69DE532B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riKGwpgpuBQQ7kNvwHndqrn&_nc_oc=AdroHbHEr27m-ZgXL0BEWOZVFlbfat8RrbeHUwgH1ToM8bmyoxwk0PyuhCWVtiCimzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3pRWba6_Cpr10TL4bCV3PkG4B0YHC4ZmlI7L-LE77KMg&oe=69DE2E41"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNqIveb2TM8Q7kNvwGbxLKO&_nc_oc=Adoxx-HNbGFV1iduGIk032nXbTSiCaQ-_yBk-jo1s8njBIR3anUSNDgBvVDoj1jnWhA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3DQGpzHniAr0EGrfcKSxhXP71-MCYK6sobYVgnN65X9Q&oe=69DE224D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KYeQZFvOfUQ7kNvwEmCzek&_nc_oc=AdrWKTeEE1I9NDHcsyxcZvjrNu_J66Y-PROQNOFsWa_f7qX0R2KPgR1FHbsEghrZ5NM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2phb8E1000GojFx9V6mZVO6uvTjv8kRX6Pw2J7cZTMBw&oe=69DE2ECF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mi_s3U5wHAQ7kNvwFUEVxB&_nc_oc=AdoN6d7qCZ2l1gxJ3jlKG_WCwR1CklhDQ_fxuqR_8WG9Kv2YJ28Co4DSI_oYb-XCSSk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af025cDFrMcc8pNagvv3gfKjXLUKUn-_VyZieWOZX5-OWA&oe=69DE26B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hSdELRN1GgQ7kNvwEIYRaQ&_nc_oc=AdpYU1wo0t3F-VapY9tix2pwar2zoZJTVPT-tP5MKxKHzEXkWhPgmhyYLC0xHY8ZVeQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aSAMGtKjJ3TuTADWE8ypD3wffy3SsL2xsOZXSE6ajEg&oe=69DE3D98"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN0RPxIFdjwQ7kNvwHoWMvZ&_nc_oc=AdrT8gVf-ZclbsEoROtNoq-8Dy3NSDT-vCl9AGFKtbIF68t-tmXMap_4Gh0we0pHLbw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dQxCwif9UHUMRtrURts1WtaLdGOq95_V7YU177sik7A&oe=69DE4828"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
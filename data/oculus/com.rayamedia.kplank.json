reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UZfXCE96WMQ7kNvwGdWt3N&_nc_oc=Ado5JpTyaXJRoNF84r0evAP00ZyZ5JMACtX23PkWbLwoVMtIBIAZbT9e-nvgGv61_rU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Ib_NKo1-fWtwaFuShrgsZoEsjRSZa2qDwJFN36wKaWg&oe=69F60E2B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I4mU3ShEgh8Q7kNvwESlglE&_nc_oc=AdrF11Sk4oGcSrrdlV38eHuqEEp2341vhgTs-SqJWV5Zkn7gmIGsFxeQY5EHkGj1QJ4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QCoKr0XPPe4UB6rBRkyiO7cDXsfJ7qVx4_QT9pvcL5w&oe=69F5E941"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoAH57U61gYQ7kNvwE_ZpJz&_nc_oc=AdpYN6GSvTpVIQRfYt0mFsnGu2wih5D_w9Jvfk6Hp6Emf0btP2ipuhdXlt7mKy_RD9Y&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1_Qmvki97sZKINGg4nslAkYSgY_Cg9q0CQ6mbIUsisZA&oe=69F6158D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NseU_yV7ZKAQ7kNvwHVcFh_&_nc_oc=AdonaM3pGe0lG8Q553_VrS2_6NO07LzCh0iO0SZk8I8bIrTuZWOr7b7Tr0vuFUCTA2Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af089xltOTJ-10a2TFPu2wGxjKjkdlW-7LoPY4Yeml8A2Q&oe=69F5E9CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-4h-OC21sMQ7kNvwFKUDCi&_nc_oc=AdqvJN5hGUT8F9hjbNrZp6r4sBcqQLAyGAqjwfKgea7sL14vVLWGOBj5jMBgnnVHuz0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3bMWF-ekv1uHWbHX5atRWMSe2WDFrCwdo7f5xmRWXukg&oe=69F619F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHj9ccvjUE0Q7kNvwESFzh5&_nc_oc=Adoq7jWwKaxBYpPI59UTQo_ZgKGwB6yV2keq-XkbL5Jkb_ji_V2ZmfLrtGEgT9znW0U&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IoSxwwTZ_mNle5T-BcM-lbmy61QpUa7RNTHDARMRDbw&oe=69F5F898"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eg8X3wlDCU4Q7kNvwGAY-Wr&_nc_oc=AdoX_SQVInTYOr4jS0Dpswyd_NgJqoirGywWeA24n_wIfHwiNjrJw84bQ1s9qbWfz3I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MKdwkiYhX8fZUOexap1I_sGaTIWEvmmw24eUsGaugjQ&oe=69F60328"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
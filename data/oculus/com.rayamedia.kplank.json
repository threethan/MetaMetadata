=7f20f&oh=00_AQCb44bEHIA4DnCEvnPSMhojEa1i4Lou4dBFukVU5fmDqA&oe=6A5236AC"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjhp94XSFU4Q7kNvwEPuHqT&_nc_oc=AdqBHgjt9qajLZvn4QuZ9FlJGYNVNfe8Uu1NWwWUsYCJm5phYVzEc7d9VHRvobJctmc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCI7Je-NXBReUdt8fOahOXNay7XOFTxIAAR9lOcqJbi0A&oe=6A52572B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mf6ajVevw0Q7kNvwGYb50S&_nc_oc=AdrGG0B3dLeyy5ClLt7LlteX5HIjjonfYOrp7rQHoLrtL163fZ4JC2BOXWs_u2V7dnY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG8lqJBVNF_yME9KzFs3ma6CtOxlioVlwyyOsbhz6o5A&oe=6A523241"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrT6rPl92x4Q7kNvwEOA6UD&_nc_oc=Adpd5YXV02n9D1AOpFQk5xgQwIUPY44HL5Qbx7knr256XObhhJpbSW71_EZKcbJgc6U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCyOHo7NQXzKFOlqHJdw4r1BS0GipDJnyLKxL5wzxmlrQ&oe=6A525E8D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SfWnBTsxGQQ7kNvwESAA05&_nc_oc=Adrk4EFL4xCaTmupktVKP4a0fIkeszuKcniIWTDk5T49dhc6Pgv0JyTaeRlrGTguDHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCGMY5aMrYO3uhZDEgqaR3yj_D1lhbkEegO5g68Xs7-A&oe=6A5232CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Gx8-3uPP44Q7kNvwEXzJ5g&_nc_oc=AdrKfa4XjYdE9yWq7hWfWEYk-3qd9pQXQMPU51Ay0z1LJBkTzEQaOYGkeqY_GUumEcc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZrKbCe6tgatZwjZYbkC8NLMRS7SArO-_w1TXKTFouPQ&oe=6A5262F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDu8CxdszfgQ7kNvwHI0LVI&_nc_oc=Ado6kTr2yTvX_ovTyYZNSlou7C3QpyHltigBq-N3rmeTUvHPShI8iVpnowLACvy3BUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBgkXDeaKkMOyUS0e1l-9a8nZjmNbkfGzF_O8pSLJfClQ&oe=6A524198"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CPFQJLEKhQQ7kNvwF28Eok&_nc_oc=AdoqHP3wxxRkWOGKh-T0ynunW_sEA8V5wsgts08v2ZTCH4J5k3G4CRIaWjlwC_AVVKA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpSkfRK3Mv4ha_kI8fJETeB5VK7q8RXCwfR7F0ghir0Q&oe=6A524C28"}, "is_concept": false, "is_test"
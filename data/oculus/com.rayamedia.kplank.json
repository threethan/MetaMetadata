=7f20f&oh=00_AQFvl2QOF0OuFaXLiF4IoKJa-yfRtVAWsm8Ibe7Ir7rjUQ&oe=6A71DAAC"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lSsor5in844Q7kNvwEhxhtd&_nc_oc=Adp40UpZMDyZICEOi2swheH2FuDRUFKAhIM_iSaISJLiKvOp2D1J2F3MHN0MmubgEng&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYkb5eipm32JPEss9tdGePXg-tdRo-zIlBjHii7MCxIQ&oe=6A71FB2B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_0h8SUGID3wQ7kNvwHrEYak&_nc_oc=AdrF4fkQLPDtmqaswixTBM9ovaOYiYOpYxvgbfKODrkohvUeJ1ZY0RF-mkhwDvpVl_Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYZob57--rTDcgKmh1ec2fu0riCR4btMH_Wm76apiDrw&oe=6A71D641"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1REggJx56EQ7kNvwFjTjmC&_nc_oc=AdqPXmgRYjek5Trt39KpC3fnCMXnaiku2o-1bws18DgBxrmAklOnTTUuXSZvxD7YGA0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVXSacdrLPKDWDmu_kEk96dCVIHI8dZqBWT-gvmNOcxA&oe=6A72028D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OAHGrS4_XeIQ7kNvwHxfil0&_nc_oc=AdqPQtfZCiqyQvntehiOpby2UdKEqgQT0qV8MK3_zxE68zGcQj0BRF07TW3MdnuWygw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzr9BRRJj1CNrP9tY0BnmIgFEaUS1Xvfnzqqm492uFdA&oe=6A71D6CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sYoQGuHiXV8Q7kNvwEFdeWD&_nc_oc=Adrnae0IVwf5meL4IYmUDn8tJ6Rx8jcyuwsukg_O-5MFnjz13UcIOVCgtJtRfYFZzss&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbZ02-kf-wueNojlHAaBGOL1PdIkhbdwhApDFZjYs4JQ&oe=6A7206F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WelwjFO09ucQ7kNvwHN019E&_nc_oc=AdpUspZAX31DSHXUuKFyYlUbBpV8Qcpjo_gWihV02fujnTzt-vVnjX9GJArWo1w51so&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFP2AJKx2YEAtb1-yFJOhsmO8N6PXTUiOmnNDlcm8dBNw&oe=6A71E598"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tTX2MiYQSQQ7kNvwFz6AtR&_nc_oc=Adrxobse3ZhGSdf9oC9Nja-l8pzpUXHet9VAzqftfdKEgT4EpYgq-ljUW4fHVnn1SEQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCPz6-I5sV08ceBZahrdHn499xZjSP1S-IT9jV_7OHRw&oe=6A71F028"}, "is_concept": false, "is_test"
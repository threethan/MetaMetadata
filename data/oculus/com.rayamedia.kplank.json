reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jTsuzh4WrFgQ7kNvwFYGjlI&_nc_oc=AdoztaaT0zZENRsDudGk_QX9wEI2lnwmptUZU1ctnmUTVGgPxJQzI8xnGheN-rT88JQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80hZkMW0gQBFteU_heykM46405G1dvkWQbqWcaP0Plng&oe=6A3E90AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLf6Hi8XHowQ7kNvwFu0iwd&_nc_oc=AdrPyR-YHA-JLttEOEQgHOqtThgjlu26I1Bj58zeH8_iVTmQydmVXFcowPSFtSB4Auc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KMEwmcxLBOYkrin-wuBLUKtkJF9rWK6gmd9XSrtJkyQ&oe=6A3EA401"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3AEzoC3EB0Q7kNvwHCBSqE&_nc_oc=AdqsJwk8fbs0xoI8yVS7PNXqBjvBK1XlxZEcHT-THXwnOyNc8LVXekyLFCjhjoVgNBU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AFO54JX4b70s6dLLtBEHyDiYAQ2Jtd7pdN7Gg3mxbOw&oe=6A3E980D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzkE4Otcw3IQ7kNvwE6j7OU&_nc_oc=AdpJEwfsXxlHFdJ-VR1PzVz4QhwtFg4Okg9tIsqzwwceg1T-3302sxU_b5p16BHVzCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91MkpTQH61cTCrqHoMt9YBaiMMjJHsIxFIMMggEEFXsw&oe=6A3EA48F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBEGz40HBEsQ7kNvwFbtEwK&_nc_oc=AdoCuddOqEf5vGwQ6TPXq1bupez-heuqxAINz-k-_RT2ZD4c50VU7vt_yKlRcDZXBIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99iTJEIkC-HdAvEiZAtkSnmWHrICq1YsBiREgU_GZZdQ&oe=6A3E9C77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBWqp9ofAYkQ7kNvwHyeWEr&_nc_oc=AdpUagO7QxIb-Ayu6ZWS4rR5QWgxTxP5enoxphbi7kBls4Sf990LpF2DtGKOrLusr-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_BM3Zz_wdpsJJFwumchAflkPMAnoPdofgykVZixJxJlg&oe=6A3E7B18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gE90IWbsDUoQ7kNvwHBMm5a&_nc_oc=AdrVnSTpzKJZ6G7J756YQCs_isfIRQoAVu1_MM2eq5_Rs3Z472NTlhw1Ls4OVzeKPK4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7QKywo2ctN1lbZWJ6oGY5R1dvx9tx5AFwmqZa5Y2SiA&oe=6A3E85A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
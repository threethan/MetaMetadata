reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivlT9Yu7KvAQ7kNvwGpb-Yx&_nc_oc=AdrLiw1yBlaCcwLSj9p8JQeNcdU-JFkVcsEi2Tg9Y59OeWqAlOxDPWOFOHNFpoAPGc8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pN3B5VqWpliMsZ-wVBTkPciM3A1eIdPOfXQ4WFX8M9Q&oe=6A09D4AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sO23-30gGBYQ7kNvwGmCq-l&_nc_oc=AdoMVr1lxIO3huEdSMlWL9SLiX2lRU3jHBrXYrxljI8NMRqpOoOekbgCgPU1B15iJNI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4QMkbJ4aNhmwT7i2YkNqbRad5k2Xs3uLW0z3tU4jG8Rg&oe=6A09AFC1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj439nJhwXkQ7kNvwGRZr2G&_nc_oc=Adp9_lsGJp2kKMYK2FlCSJEgQiNnFPA_RFMm6hLY37FIjZ5AQfTCrbxUO_FYx6MrofU&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af52KeWVoG-yjWbqUvy6rfLi5fTnWlXZ8z0LB5djSSPD9w&oe=6A09DC0D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X7ZiJKvEcmsQ7kNvwEE8W3r&_nc_oc=AdprnGAZNB7zxlvpb9a1rpGVTknZ7teNI8Wiw3VuseoXbtMCW88-tH2pG1o0Toh9Ve8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4AlIdmmPmSXRTrB25gb-NxH3niGphV4tDTJ302lUsuUQ&oe=6A09B04F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MBya2qisacQ7kNvwHrw2KQ&_nc_oc=Adq9Xyws_lxzue26RgOpbK0gKrSQm-vblqDB8psLK6wgFBw1pfPdSRCc1JdGqAt_6js&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6eefrBDwkZa9Xyn_yZ0WVtDjm0FxLnjuli67qv94etDQ&oe=6A09E077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJRIG5dpiY8Q7kNvwElDIIo&_nc_oc=AdrGAV2gqrk-nTVLxAo3ztQ59Xn0PP3EyCx-cPr7sd8m9zMtrqNmtZ_Hhj6JP2pdpIw&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lpiHdnif2XxYpvQzPmFz0LOzFCwTiJYMdtKcEmFMi0w&oe=6A09BF18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJbrh3tdjgIQ7kNvwG7eudS&_nc_oc=Adoukk0VfOtYPbkrLFO3dys5YOcQj8YsMakfIXFskGzKjs4qVUBg0z7Q9uuu5YFVlX8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5h4gxC_wTPYxUs9cXSyHuvHOcu40jNCpiixDvmNxEmxw&oe=6A09C9A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
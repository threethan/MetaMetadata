jcr6Y0nD3Lcy_T8LrBHKjJVzc0WabGo2uvdA&oe=6A5F60B4"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HrNii95HhCgQ7kNvwFGj-HX&_nc_oc=AdryLF7CpXflzMhig-uR39lamlMiG-VKyPwHs5sygOpYicCIfqXWz85BOPmCauYG04c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDKQy_QUOQbEG6DRsjq-BcT59COL_NQ7xFTMepwrn4nA&oe=6A5F554D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eviyyQ6S390Q7kNvwHeXytK&_nc_oc=Adqkcw0SQqme00BiINr7-ASuyo49Yhg3YHfdj2c09xYIvXKPFehd0dLGOeD8zNrLTp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoAoYnRlCiYiUZYGOj3oXpJjuLdGPWvKqjEAPsTLl4RQ&oe=6A5F61CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydmDGDLblBwQ7kNvwFqA3Nd&_nc_oc=Adr3cDO18qnXqIxawC1LfstkxTM7GRZAgCxP-pCb3XJrQ9v0MBVCRRntCTFmWaVenXQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRfD3_UB5wFyySsscHbbQagpgNBfsVl0_DzSLMyYF0_Q&oe=6A5F59B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J-pOGlQ2LoMQ7kNvwGe2PHT&_nc_oc=AdqJmIfePHaP08CKSC0ppWPMADwhKUFbZmhB0j0oR96Rxkl7_gEZwU8Vof1GOf_u-Cg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAC0H5ZAvHjA1GhvAeyT4hif9YpmIYuVZPRl4lJN9ObWw&oe=6A5F7098"}, "display_name": "Plank n' Kitty", "keywords": [], "long_description": "## Plank n' Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank \u2019n Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743
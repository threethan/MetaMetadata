reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YWb5IYiZjsQ7kNvwHAgKnQ&_nc_oc=AdqUKaoeWlwhAnrIXIaZFmF0v2_x9439Rr30KzuZzfSRz-MZwcEwgeyZ1eolV_BhxB4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fF9Vdc_24bYEchUeaWX68YkwD13smDa_ZIKgIOyfyQQ&oe=6A1AF82B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ftbytXBtLp8Q7kNvwELk4aZ&_nc_oc=Adrx31rEMiT5Lba1BqO5kftvUrSuUcx8CN-kE3JHTszw6TiVzOBwJeZbFVQGazlf4h8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7wOgjvIPEw7O9YfYf9FK-YiY693OuWiX3eTdkZC5mCIg&oe=6A1B0B81"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vCB_EMmUxJIQ7kNvwEogsbm&_nc_oc=AdrJ_z6tIE6FtdIZ5N-_XabZAkRqycQ-DPdo-Iprwrb2A-IGgpXenGANjDRaRfXPYdc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73Qr-QWbf64uugGJG4gmqXfRKlmQDtPFq7G4mQbPJqig&oe=6A1AFF8D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRCxXN8VHNwQ7kNvwGqI8Pm&_nc_oc=Ado88dTjVHBOnsPQd--L78j5YXK30f-g9wHWFPBWlOtp1Sg-3XeundG-gBBM7uDy1no&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78voCS5dfocfOlC3XXsCroiLUNENDNaSeS8zKoMhpBcw&oe=6A1B0C0F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lxKDXN7ZIfQQ7kNvwF5iS9m&_nc_oc=AdpZo3TKg44YGg6YynJXQ4PCAK3DIxIkThO00iUV8ptUyjchzmaQ1lJEXm8_NaLug7M&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71XRwry8FOuOi0-3BDo4oBlEjURi1ZqscLDhkwyvsBqA&oe=6A1B03F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f401VWyMudgQ7kNvwEdO7q5&_nc_oc=AdoP1zQJNAUERp8MgI58t4Pw9z0z1VN3nqQCRIwYTCJghxXZtEgbMusmbMnAoWLz8U4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6SMi3bwmY47kxH35axQ96ZsqXsQ4J9OIdo0NkXjnP59g&oe=6A1AE298"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umLSYH0KA8QQ7kNvwHyVoLs&_nc_oc=AdqgOnPD9dg9U0yb1kDORNniX8Vf8-D-HUQ182G9LWv5RbQl7Oo2sLSx8cNs8dw8KX8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VxBsJ0RYWB0krR3md1EzgjgU1yqQiJZ4Ej59_rJIo4g&oe=6A1AED28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
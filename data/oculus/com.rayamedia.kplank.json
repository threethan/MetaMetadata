reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in0jDoAXJZMQ7kNvwGy3OsC&_nc_oc=AdoUPgKXUliqpcEij_sE1m1wfMZ16B3PXQDvKQVfHFORMCGIqnwvGGT5xO_-bumt3Vw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyiB64xAK8PKq_RlhlSEiKQN0wftxEAPOd-oY16Aed69g&oe=69C26B6B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvPDoT3p0kIQ7kNvwFCrx_B&_nc_oc=AdpwwhPLl1OsByRaP1GqogItRygxkn96VC07dkzhDX98MQ0hcoEr7Iix8JZ4Koa9bSk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwzTQmqb2uoxpbUpV-FJoSSPi9fQoRrWXFFSyYMRgKGXQ&oe=69C27EC1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU9WOuWkI74Q7kNvwGYWDrd&_nc_oc=AdoZhyi0EXiXFmhZhFx484yPAqYWe1CizcUb-BiwSnmxc_EJKDOsDrAS6wyP-8RALF0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxINGhUloX7fFOjNKkLsX5pceOcpfgiNG5hfNhzdsoIzg&oe=69C272CD"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovrvB6SxoaYQ7kNvwGlbgAe&_nc_oc=AdoN0bU4X3V3Y3_0h1ZGKCwipJL7V4Qm1jNC_GkM3wf0tlNYVEJtj-Whc5ELQneU7_k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyOREpjZNJRu1jJTzSAEnNcETp82VaXisRIM1J2zZCPDw&oe=69C27F4F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b62ZX08Bh3kQ7kNvwG3LAYE&_nc_oc=Ado02UolCEc7_6QWOV319EPV8aoRBtZRLkG907-nJB_Z1iqqMMOjp-ZlvGwglLocsiM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwQxiQxdqaodn7wh6M97H53W6YO_N9XmUCVJW3UseYqpQ&oe=69C27737"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc8gfyZmjn8Q7kNvwGb8oCY&_nc_oc=AdoHWBQShpf9re61cq8KLr68DkLz5WjgbPdCg_r61E9775WEpRUE9iPC0ortsnnwgmU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_fHwoNgvcer3lF8PjCA5UlJtuxXpXM7LFb87TAeVxeg&oe=69C28E18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9NFiX7mL7cQ7kNvwEyDvYV&_nc_oc=AdoX6PeBODlvL3muJgGCqHT-GeUvMzJE9zholnrRfTiTakGGtDwiAe8_B84Xe0FJkT8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxxckXZ4yKpl4jrWBXYORi8X7QRH9G3Y_jvLvkujh8UQA&oe=69C298A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
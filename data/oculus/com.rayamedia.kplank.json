reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9Mi6LpUT_UQ7kNvwG7Ro5D&_nc_oc=AdrA_SF1ZQLkNCWMxNnTBKWf_WTc-cX8jLySWKZhCoRz8fm3E-pnj6bNl29uOLkk21w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ZeYDP4LS_kQWWEkJTmAef23Zou8UQu_vU0dTpe-5UHw&oe=6A3404AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HacB-3nTDJIQ7kNvwFswPq2&_nc_oc=AdooZJkZLBIYXWtTkkrsC8TWb_hP9aHs-QK3iB17ZG7zT7PRx12NOo5xVFTvrZCuXds&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8a-556ONCRrP4frxcibT0zQWwjZL6Fk01aj9Tt3ULfQQ&oe=6A341801"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBbTn6D4h6QQ7kNvwFfw50J&_nc_oc=Ado98KySvwagSTUMgqZOcAeGH3uU3fzFu5v1GOfVmeUTdka4H-ry4-UD4CO_cL7wy58&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__nApMPFhACJC_HUY-3F_cmpB6Diw-haJX8zV6Z44tmg&oe=6A340C0D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4zSTPigBL8Q7kNvwFF1iT7&_nc_oc=AdpKRA54JriTEXNp2Q6bDqZwT19PnxFLc5XjmqJiTgLnZVe1cF-fXbnkMRVfuUqPN6E&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8CVk8Ny6j2N8YnBqTOL4ZhDOQA8y485Ts8NOjtengGUA&oe=6A34188F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-Ru8l7OFkAQ7kNvwHRFpA9&_nc_oc=AdpLV-gJFKaW5gC8P4ylAKNz4DoF2iWDoEVS99i93y3InEdl2riVfW8RkjS5oZl8puA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SyndymlnpisiS6IAEuWap0NxGevcYV0EvG25-mcikvg&oe=6A341077"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRWxuZgI8f8Q7kNvwFNyGeL&_nc_oc=Adr-y-v2lDWtnOAiP6ksp8p-HIEuM0pS2-nGOT3xGCVoXnh1gUrRkANaw5czctnm3Lw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Kv-1rAG8C-PLjbrAUe_niGbjvSwdUEX-a1IXuJpVD0w&oe=6A33EF18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93bWWsRq30MQ7kNvwHaNruI&_nc_oc=AdpsWZar42fyCL5yg6b6UQO89V2orY31mxXphcawX8E8F_dgn0e7Gv4QecexQsOfxec&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zSu9n2Cnq22z1BIMSSsKUbEJPN8aaBjnG17thj--UGQ&oe=6A33F9A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
=7f20f&oh=00_AQCyePvLE3tz8uP94qMZe8-ICOyso-RvLbCvUwnz7bNL4A&oe=6A50E52C"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bjhp94XSFU4Q7kNvwHseZDM&_nc_oc=Ado0UfzBlfX_OE255_9b-oAOLeE4jvzO63y6bHB6Yn9WtzVEAm11pF0l7dKus0SRgDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDgDAvgepr5wlaxAvo38-l46nJ4hd9nG4ZA_ibUrBuW_g&oe=6A5105AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mf6ajVevw0Q7kNvwHktBwG&_nc_oc=AdrgL6iSg7kOyVArIahucL59MhCkT-tTkVFGWentYu5vUT4TmrN3GYLMXBNM3TMKato&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAZH4im06BW519n8g0vrKf6TItlBeKdJi0YyqBFRNnBw&oe=6A511901"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=af6_n7nTIz4Q7kNvwE-aMEl&_nc_oc=AdpJGA_zYSoeJt0NcF7xNsvhY4tvPfXSszZ5eRcOWsA2BW5oXhuRyGVHtCmbuhiYN-A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZ9l9jMnF_25ksshodYDIyTbmRr73ni9Mf5i14fWU1yA&oe=6A510D0D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SfWnBTsxGQQ7kNvwFNGMQp&_nc_oc=Adp0NpzGLuEL6-_ICrnDabmmI5A7myk9K9IGkbBwXi5HB0fA6gux2BSDfQirVFKepvI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAteSA6Yb4zDVT5WXhwzZN_Ai_itYsGkIq9NUBdp5KGog&oe=6A51198F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JKGhV_S7pNYQ7kNvwG9f1b6&_nc_oc=Ado9n84NmAbSHZoS_-Rs9nBAybLGi8biKjFaRtY_g8X6SB6sqVdKFvl6jSB8mBSzSwo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACU-MziNAC17PjUFYueNjz33cCAbY2sCZ_RDtnslHFxA&oe=6A511177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDu8CxdszfgQ7kNvwF-jjrw&_nc_oc=Adq11cR2vZ9BY8PcLyvNXbrabjohQbvhRX2yLG8lE-96hhmHgyhR46FUvAn0xo3yRQo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1femEDCNqviEtm-O1oRP2TZjRMN9dQQeSVBOUmcwzTg&oe=6A50F018"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3CPFQJLEKhQQ7kNvwFapTlM&_nc_oc=AdosJ5ueQ23yzKojHtn-tshx0g5OJvR3HaZ7zqpeQIzjEVL7dSer5iSgb-_LB65XCEs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAj-CZnmo5eZKJfWg0TCeJttCVQwlGorlHdsbfCC-vykQ&oe=6A50FAA8"}, "is_concept": false, "is_test"
reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdADL8ywQr8Q7kNvwFTrz37&_nc_oc=AdqU9Za347PRnW00hhpBZpEwfHs28fF8Wqfa4OfQ1F3Cc_CRUtNQQJqF0EuBKDVaXLI&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hGiXL0i7hQnJad2V_E8iM5scze8Nrkv7qQPk9Nvg9xA&oe=69E247AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uqQu0cUkmBwQ7kNvwEeNapS&_nc_oc=AdpC4ubK5VMpRdVRUy7E6QEICGlzhsAdEMN_nu6E7nmkklwajMYNiCp8PbLQo_NYp4o&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21kgfOcesMI5gnrPMNMwdyU9jz7H3EE9SCmZgDN70wEw&oe=69E222C1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hObycFAEBFsQ7kNvwHOQESU&_nc_oc=AdpY-zz7IvkQa-a4H_SdFajM2RQWj8rixgkhxsrAAuQwNQYUyBCNh1Q535Pv52oWYQY&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CH-hf5sme5kpod3JeXKvp-6mO6JicnTQj-khT0IY-vw&oe=69E24F0D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u2KbtdaCbO8Q7kNvwHlokcT&_nc_oc=AdprQOASFIpTSmcgIgcneAPQdf45VnLAkiIYgpZZwpWChmggaHTSNRWb90p0WoD_nbc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2uOTPAeO-Mug8i5OjN0X8-TnLn-pB7S4Grdr1h13P8uQ&oe=69E2234F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhQ7gocN1cAQ7kNvwG7KeAk&_nc_oc=AdoLNYCKILTxuJl6Ao2sC7OP96gbvLTKjpK6UnGfuCN3XMnHiM9VCy9ry5DS1BGXgSc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3El8sGOI_BRxpHQU5ahdkrJulEoo5sI7tM4lc0oe4Itg&oe=69E21B37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wpOnyFpUqNoQ7kNvwFL4c_9&_nc_oc=Adp1V_npgtBUBkTdwp4mzlUuLlIT5P0AJNAtxL5PYm9XHVzfDAxDgcfFxlHIcmialGc&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w_plQOEr9C8vsWCIz9nQFmgDhe3KkU_hY-liXpwl_QA&oe=69E23218"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bKwYo2z16MMQ7kNvwEYK8Ob&_nc_oc=AdodSgjxrqsewJZSesnpZIxDDkqk9pFv7FZKi_o1shutxA45gK9ByuDUkVMKMBenuD8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Tg19iAUoehJ4IaAHPongQLJB_oU0ESHPEo3BzVmCxhQ&oe=69E23CA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
=7f20f&oh=00_AQDsHFHjQulroMYhH-lgbzCzU7THlb_qK8BPuRs0N8hyVw&oe=6A53882C"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luFQr4yNvU0Q7kNvwG2vclk&_nc_oc=AdqbdzTxiDBzDusHyezC3FJte5Ckg_oX3OSxngX0T00Cjse8VKV-cdKMT1edbeBAhlE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_us8P6nMokiP97v7KqGT7OaBm9Whexr0L3SkWS4hdyg&oe=6A53A8AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mf6ajVevw0Q7kNvwFNPqFU&_nc_oc=AdomESc8Qdk_2lanw1ixXQtJiGE-nz3Myz6vF46dtWrG7PBnyAA-keFbaUQZtoqNap4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBug144QumQeAuAn_I84ckTaCwpi_q2yH0dlzImx346A&oe=6A5383C1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrT6rPl92x4Q7kNvwFG9O-R&_nc_oc=AdqND6tSN6UhJoFnnOfcF49XF1YWeLrxksKH6-Q48jrF68d3r9n40CO6Sal9TLFqbLk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcs2eO04lRLw_5iSILibDBmR0XTRa-qW_SlqPbHyORWA&oe=6A53B00D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N9upOxnJGpAQ7kNvwH41dN5&_nc_oc=AdpUUucVUGy_LgGdnrjt3uUDXDwoWTjSoPqpky4CzrH6vGNQmzDEE5Qadz4SRRPMxJg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCDSua9RiXhdJSKCyLdEiQZKc9S1H8RFjPq2dobzgIV_A&oe=6A53844F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9Gx8-3uPP44Q7kNvwFjM1rE&_nc_oc=AdpbY3Z0gElz4fvtGHv2cDp7RR199YmGO29GlafBHT0pM0lI0OlbyPGkalIKPhIhOsM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBhJ4Lo9belbjHDgTvrVk4IpxCYzuV300ATGVj2R2Udgw&oe=6A537C37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjW6sYcsEfwQ7kNvwFOl1uc&_nc_oc=AdoLFlEnG8UgUVBFn-JxeG0WPZtBwS0O1yBfCNiCifGc41PNQj7HVradfVhjNEqeQHk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBDjIIfAVSVFZd09DCMuPzJ3wCX4gedYwDnIHuPhniGg&oe=6A539318"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5H7_aGgm1kQ7kNvwF_JWhD&_nc_oc=AdpxRGXL70YQ8BQizcotImOhQVm3sgpDKdfE9p9tXN6cezZ-C2-hPSBPcpEF6_642Tw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBY3kVgp4TUE7KUqGA5lYNn8WkKyrTmogSwwz8QUkI8fQ&oe=6A539DA8"}, "is_concept": false, "is_test"
reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIuTzOcVLW8Q7kNvwHxPMdm&_nc_oc=AdppL9END8lDPpsomXxj8UQxSCtfB2oNJXVLp2el1ivCavqUN1Jon7pvtp-21DiZXso&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQ4LuWVJI8L2FR9GDML45lL5mCyk_uwVHgohzQrWh2sA&oe=69D1242B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lYH_jJ_tNeYQ7kNvwG32Zq0&_nc_oc=AdpkCWNWJXZmqmomz6HTSmZ_lR9jbGt9cM0Q3EU30oz6KmT_HF8De8Ir4hpSmqloqLc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxj-6nA3GtPZxSoZUrp60zEA_i2JWls_s9S4SUVPSAWjg&oe=69D0FF41"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBdDT33ZjGcQ7kNvwEwZ_Kf&_nc_oc=AdoRi6umi23n2OYjQCUmApVFJpdaDA--DbdBvrhnMLLTaFEErY-c0GBDUL4WBi8H2MI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyJGlJ1dSt6E4OvmF7WVenuPt7P0mCIx3JRIUt4DeUpAA&oe=69D0F34D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVkbP5QZSpYQ7kNvwErzMxs&_nc_oc=AdrL-hjeaip0GA__4NZUWgFvlzcQaSdPNNen7uzB9C5FF4rqWyk_2DQrrq0fGaP3p9g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeFj6lKwKkg_c1xT2zhj-G4U6tJqsIBlR_K3-dZUGg8A&oe=69D0FFCF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zR4GyNAFReEQ7kNvwFddShv&_nc_oc=AdqNQYmB0pqevaFKwYNhQlqidK3G6F4DeTaS6Xe5NSTjrEPw6ZThdAmRgjFKv8ABzCA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzDQiqqSFU4seTWRC_wjo7f7ss2B6WVCYZBuf3x4Vea9g&oe=69D0F7B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfRGs_2ZFKIQ7kNvwEEQcly&_nc_oc=Adp-_otjIxJwrTD-Q1RKS_JFJhLEjxtx6KyHOUSkDJaSpcz6nkWjo1yUvCitKA7zG5I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycE5-JV-Pu_HeQXZrInjdktfMS8G30XADl5JAWRB_o7g&oe=69D10E98"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAwWF_yemWUQ7kNvwFcp6b8&_nc_oc=AdoulhhAm_fG_096W2Wyb0I5XnWXWcuc2e4zzofs1WGtFGMMk312SMqp9ClpmrkaudE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwxNGFohVDL5kUpsV7mpe-_fzAOfH7183K8LW7gUgpgwA&oe=69D11928"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
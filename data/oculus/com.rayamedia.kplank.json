=7f20f&oh=00_AQAmSS3NLgEEAe2rdwI5d14P3oWJc_IAzZdp_pn4hhqygQ&oe=6A64ABAC"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l0uNRmp_DhAQ7kNvwFFnv3Y&_nc_oc=AdpKVMHLJoZFQFWxzYKgQiapsw5dA0M_h1mR9yrt2XZ8jXJuSqeDlHH0GhsyXRTLsoY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD51xxdMRZO-RXhYekhvRbGZ7Qe3IDkU900bLEFJP19JQ&oe=6A64CC2B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFxNrzkNWToQ7kNvwFJYl5X&_nc_oc=AdpTK1LTE95qDYuIbNPFHPkGwcuVxhoC-CVVCdsP__hBiFVIRD5ydnwJEcBgUX-jra4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQzVtw-Oh4Gb3SvtFZ0aBwAfvcNHjpLxjLdo3ExpC-6g&oe=6A64A741"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-hRQq9aKPoQ7kNvwHpKZzQ&_nc_oc=AdrW9oCU_h046uBkryBYKz1-KdtcLAb3o42Ju9AbhKrbREgnc_QgCc_icnOPKBrA1cI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1tlxNzfj6WNsxKOB0YWVnkcQl43xZMlveyIeHCktelw&oe=6A64D38D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHjdQaZC9PMQ7kNvwHosnnw&_nc_oc=AdqfqhPpDehMtMLAgrN5vVfnoNEVjVjiLQLxw6iTQsDpLFL7K57kD1JRRKzMDKP9wSw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXNxON9D3IB5nKpzHbTDRHm3A3w_IASDynM7KjY4_77g&oe=6A64A7CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIO3rinX5yQQ7kNvwHwMOFc&_nc_oc=AdrothowVzCcsZCiwrgdzUh07JHLTxdEnEt204BwMFSZb03At0GZ57allgB9eDOJ5js&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzw2uA6Elup5lbvIP7UH9xpy_kqpJ9HTC9BpzJS9qkwA&oe=6A649FB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SP0nRcH2Iu0Q7kNvwGJbFtP&_nc_oc=Adroj5xo_zRQwqoSifn9iTeg_ciS2dPz2C2MngdFKSoXW9a3D8jkKevWXcAoyz69SHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFEhKJjOyciRZ98FiXwATfadNFBbKUv1vncTiZ2Gk58Q&oe=6A64B698"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7frGGbK3SzoQ7kNvwF73hVM&_nc_oc=AdpNmbQy-vqW_8airSqJHXSaC_dxI8UbsI9QybiUO11gRU6e0ZAsDiAR4qm98zV-2ec&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCUecsC2McneTd7gSwJ3kzXZg5TehECcRPz59z2MC4mKw&oe=6A64C128"}, "is_concept": false, "is_test"
reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uIuTzOcVLW8Q7kNvwEtK70H&_nc_oc=AdopnJeqr-mCa46MMN0clq9aa5PFv1yAhLP574RxyxNpHNeCgtNMENp_Ag_kve9F6FQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0y4axeCzR2v0BffoVUCcrdYscN-0y64hCoYgF2elOfhQ&oe=69D3C72B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XtEKRyx7lwUQ7kNvwFqPFwy&_nc_oc=Ado3N4QaD2RnAOwB1Hf8SbeRuUy9F_9cXS9liB8uw3geVlpyO5i3ESWP1ijs1_QznHo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1PXZOkmTw2kKw5E_gUzwGncxWao2VARpCO8IvHozC5UQ&oe=69D3A241"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBdDT33ZjGcQ7kNvwG457Pg&_nc_oc=AdrSOqjTAsaM0RMvnpP-zNOkDFemzVDTGEsRBny0hMb1EMkRX2E3g1ETkYI-n_Tc2iU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NPolkN6GAaD6ehRzK80VLlRaaY_5wud6r-h1DkLwgKg&oe=69D3964D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GVkbP5QZSpYQ7kNvwGi-uEj&_nc_oc=AdrSkReTUCCNCrnehxyzjHG5fLsYbZ_fYSB8KhekbRcpt4xY6au0JwfBupnyg4hq3hA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CxPdu43IJbRiP_f0DRIy4TwOoeqTqRKfd8MQ7iavKqQ&oe=69D3A2CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjmJRDG2a7gQ7kNvwGmCRG7&_nc_oc=Adpvz-Y8eKuh6jljI3xJUZf6AIvSy3VlyYZNcXm4hgedRFpdm-ax99kl1OrMbRlbtTc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TMaK4horNyOkAJtsD5UxS6Tt_8hy7-I121Ik-7dYRfg&oe=69D39AB7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TfRGs_2ZFKIQ7kNvwEXrSqw&_nc_oc=Adoo67i87h_Mk33txBHtnjPbgi3svvIQL7KfxHoTuna2-ErT159SONrxHrf4qeQk-L8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1P3pgb3uZ-UUiE8kPdJV7yDto8YmQBhYPqDR2yMeJqug&oe=69D3B198"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hAwWF_yemWUQ7kNvwEzCzZS&_nc_oc=Adq0BEC_F8OW95x3nhGaJ5T79CCq-uNYn-bq6eQlhNaX264_S_ot2pWRTrnd6nQPzUg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3I3mWb1W7gyFzdhCJq1B7pwHMEVyZ6438dt0jTM7levw&oe=69D3BC28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IkoAG56Q51sQ7kNvwEE5Bmy&_nc_oc=Adr7cUWEbJeieJXKRnvywmZpqTg14nprUuwVv7i0WvohCs7dfYmdcS9rs7iDfFuRww8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89Hn2XINmm4W59MVPyAIWxElR9-P5qmfGSKCoNH6dvew&oe=6A45282B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7bDvwIRj2mQQ7kNvwHK2tdl&_nc_oc=AdoymuvqyW7j4V9hSvjSkTyygqFhjiV41qpdyFcw16SII1zazzQLzIBL8kmGglz2SFo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-pIL9c6jeSa7hY1WZ7235KcwFfHTGYI9q8lrYGiJ-Wxg&oe=6A450341"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdkzgwR_Vi4Q7kNvwE5YdU6&_nc_oc=AdqSO8v9fH8LMNjmCBaVsQvllMQC2Rqbpu30Poo5DpxPoAkpmpTOpkNC2BU9mQuV2TY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yTMr0AFLErUfCXvAp6q5alYGXtRTSZKhNpWz-RV2PaQ&oe=6A452F8D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hN9yz-iwBQIQ7kNvwGETNiA&_nc_oc=Ado6LdR6NagDwk95YMfyT5cRimPyjSmrNWTP7qo-GxhySISQg1F5PdRysU0_oCdOYPI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Pp3tjBaq8iszreHDZusRvFMYWhu1AXcREl5H8p2p9yw&oe=6A4503CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBWOm2ReWhIQ7kNvwEtHR7W&_nc_oc=AdofeWvPO3TTU-8bKHKzjq3fv4rd3Ku7Q9fhOsh2RA-NUUqeakRmqHx4-AFk4e7GK1o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_958DKVaaffgkL04h4eQ6EWQnKyBhBCREs1QRzjZybHA&oe=6A4533F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIRhiiAIqpkQ7kNvwH76lPt&_nc_oc=AdrMMcybYN37bLutr-qzP-W1lrFAAkDsnP4saDBV6cJGNcKknGystjFPbn27rqLegaY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yOPIg06KD-lpVUuQlTJkyn5aY32Q8w1d6tScxbEEIQw&oe=6A451298"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEz5iuYdQ6AQ7kNvwE_G8I-&_nc_oc=AdoFdNu6S8SciSrzOk7YgB4h_0sAqz_LG-2zyJeC7Q7H1lg6MZc4U6ysMnlNnJbF6Zg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bMeS-fyZZ_l4e2eAUYcwihYeiCzc-EYSgW26bR5Z3uQ&oe=6A451D28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
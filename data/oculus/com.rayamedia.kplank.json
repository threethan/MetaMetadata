=7f20f&oh=00_AQLUBZTc0xs6DVaDFo-z1ZqnhdGw6EPH1AoAzxAif4KzCA&oe=6A9FFF2C"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJRq7Ap1_6IQ7kNvwH1crQ9&_nc_oc=AdpmGmsciiG5AkNEq2iQYw-QpQ5in-TR8Qmt4t-foEqb_7-mL_3_Z9B7GdGZ3T66gY0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZtZQjkVEnmehIVHP0__dh1aCl_jeGBmFHfjyU68l-jg&oe=6AA01FAB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad0mphfYzJgQ7kNvwGP1x6-&_nc_oc=AdreC--emuNAaHMfBqGiNzI0g0HUY4suJITqzU24EjbvaFQNeMdVutfnRYFmnC4jCs8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ85cbCSdvFPLm8Rn-Xda2covcqtgtHDnapWV07jGBmyg&oe=6A9FFAC1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY-JIlxEs4AQ7kNvwE7nze0&_nc_oc=AdpbIBm1nV6YJtbUwFUmZqAa7O8nupZdSjIotx3pT6oP4u4UzmEse-rut899EnmMGQk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI14VgkzbAhZX2sjWnAyCxWT0RxlNnHM8H-_XFqXrQcnA&oe=6AA0270D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJ7Y6VXS1P0Q7kNvwH5yb6N&_nc_oc=AdroeruAl_qbcKGPkG0i_8Jus5X-vQSQTH85UcY6SdMPYEzEmqn0sXMiMpPrkuifOww&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX_LImGA-EpyBKXGAoLs77bpIBBp3fNT9gw8q3PDeqZw&oe=6A9FFB4F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YjOaGLWUHU0Q7kNvwHYFT_z&_nc_oc=AdpmHbOszl4eSWkbynar5R3KsSuHDdTycD3A089QEVAMOlJqbUNwQGEvfoZ4mImK15g&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq9AtKSBdwMUQnpSm7xiH5YHYRV8vjRa6QV2Y5rXT8Fw&oe=6AA02B77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDVaYnr7pjIQ7kNvwHkLtHY&_nc_oc=Adpc_Q_481LoG_LiPlxn3SQL6ZhxMjYl2A5eEYIZ8steBKZLVIA3bAsRgNoV0kKx2zA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlb_llW1e3kVfwNRdI83_HeAgWpHXgQ9RSXB89C88m1w&oe=6AA00A18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xG2cnjd84b4Q7kNvwFiadFI&_nc_oc=AdpdKvdnjb8Wzrhv2FaoOb_vKbFstj5gPumOcsyepx6YutWnwgNxsnsJRq0Hd7ws3_E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrqTsugyGuAuw-wi0CeAdKL2-bSV0szmMiDa01eZWEiA&oe=6AA014A8"}, "is_concept": false, "is_test"
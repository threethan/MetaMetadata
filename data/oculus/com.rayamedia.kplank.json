reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOceZhbr6ZIQ7kNvwEvtmRM&_nc_oc=AdpGhanijGgkXBOgKk00Q9I7SexC1gglv8yPhHHoykxdCjZzmIB8ZlEHVHPTYvlK6EM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9_UtzWQpfZF182p8wbJ--r3W4tVdUGs9Rhq_tSM9BSJA&oe=6A4133AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1w-bSk44aMQ7kNvwE1yXUH&_nc_oc=AdpYfUh9ulzC2ACSESGvwzznZsvjsOYSBKba_wotBpFNdwe_KI5Cmjwfb6vfUGIt7ls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SlT5J3Exd42aGmz1SZaKw3qjU37L2eBHGQOlCPzH8qA&oe=6A410EC1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3AEzoC3EB0Q7kNvwGdHnJb&_nc_oc=AdobeZWcBVyM5URjUpmGk9ELGBGl_38edjjITcMXNviQTg25awGOyJOI0_Yltpf3r8M&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PHHnp2EAI6nJn5WAlCG4tS0JeTv0ZfjlF7db2g-pQAw&oe=6A413B0D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yzkE4Otcw3IQ7kNvwEz6ki4&_nc_oc=AdqoBxZt1XUWwymZVfO7zYgsX4Q60-oa6zGGCUVdf1wqGoq0bFrZtbB9AHjmOvJXjg4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DErmRAgUyVbVoyweVOjsuIzA5tgcJtKyEC3NM-3LCew&oe=6A410F4F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pBEGz40HBEsQ7kNvwGtN6TO&_nc_oc=AdqWg9HAv7--7vYBZqItS-qgYVZ6MRCE6Nb3OILsX7xDGpInwBmX7MDV7zJbHfns8UY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xs4dR-16od2jKTpym7prQ_3L39PB8iyoH_MSMyE7DOw&oe=6A413F77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lhlcEN_yBtQQ7kNvwFUAHLg&_nc_oc=AdrUlUPB40GL9Vo5GAlG7fvakIfTVpqMhEtLqD4jlHIbDQ6J4j3w4YWHGy3I9y1qpdQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2Y6gO-sSHnn_MQI1MfOLvnhspkySWrWyd8hOmNE07mw&oe=6A411E18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivg6El0P2ZUQ7kNvwEOQ6KN&_nc_oc=AdqQYjJE7jumS-I7nzX4TdQX-X9NzxekYxD1hJ5M3123xhwU0gA6QRA1g79o-cB6JpQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p8B0kR1UbkGH9y1dMIe46rN9npLBSyml0nVaDH1SftA&oe=6A4128A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
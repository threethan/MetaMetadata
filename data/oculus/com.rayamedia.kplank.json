reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNtp_6OnGOcQ7kNvwG43BwV&_nc_oc=AdqJxo2cXhZQ4z4TYFh0lST5jVvKC8b_hTS6_kits7MZ7bdZBZS22l95w1QP96vr730&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAL6UZR8ro329ZSoNPwyzDYfWf0GvFFW5wMRCR-Z0uPXw&oe=6A491CAB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I63LDQ6cClwQ7kNvwHIVD3G&_nc_oc=AdrsnLNOZxUT8Bd19ENuSYraZbuvksHAYCHAn1GZW6BUdCVFGxhZeHXyC9f13q0Gw2A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwcLWB2z6dIdRLY-aDmgGYfAd9Yu8kNfd43ilkqMKvrA&oe=6A48F7C1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=clsSFvdQCYsQ7kNvwGM4_RP&_nc_oc=AdqhsSZXvBsE3sP0vP_eUc4N09sFcUv2faIDiH-VP8BMwIcaIZGJkKXZaAF0r1w2HSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVLiRa3IVOKwQS2CrKgElKUbYPc9w0I4_Vh2VDUYBgVg&oe=6A49240D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kzPbWJvHkL4Q7kNvwG_iLEe&_nc_oc=Adrz2cEG189AmyU5Alhi4-f3HoW3zO-_OKjWMyYHDNdDQEuf2TKClH2ZTG-tXpSZzGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8HWKc0gYnYRW7bNrPcELE3RHdb29njUaMUnh8mB7htQ&oe=6A48F84F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3KwYcoC2-ZAQ7kNvwHbvBX0&_nc_oc=AdqJsVf9PfApVVtcvOl7pJFqFlUjtEEqHZWqPe2lOfewcdSqXI9bPmw08gKdCj1E270&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC737NSUdQT189t8cwGH3P5LGYqxhumYsU1ESNk1xrX7A&oe=6A492877"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gVrHEeNmTI8Q7kNvwFyb4C7&_nc_oc=Adqxp0l_a68atd5TuhFvQRf77pS87cwybyEX7ML3mDAJ7gLbIXi7fKVq8ytIA6cgbII&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsrP0QElO5jlmQGik0td9bb8tqu-Lvt3yZVmxtFzMZCA&oe=6A490718"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ySxgBfBHG-IQ7kNvwGC_W4u&_nc_oc=AdpDvJz3uQzy0xLB6IFSkKKh1J0hOi_HBZKrdTPm13yDCOfKWI6ikMw_n1WezxbuwLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXyS2L9qk9YiKt9fOtwjOHVwYFOwox0nNIJRQKokMHTQ&oe=6A4911A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
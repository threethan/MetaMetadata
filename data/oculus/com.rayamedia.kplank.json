reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otp8i6IMztEQ7kNvwGDAuXJ&_nc_oc=AdpEy02YxZn54MxjLD6GO4VeRA9FcciwFJepNNMu3iLRKNuieTCrVAJDljozZKuKRro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6km5-rI66hN4ynE-5px9-8PCRtr5xTLf5wYfpgo6mafA&oe=6A1EECAB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gda0_-mlNukQ7kNvwH9z8cY&_nc_oc=AdoqY1UQZ2CCqmcaFt4xLULf90oduGnlpZxjspu1s2qUQAJk3JQAvPTnNrSUE_4MT-M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5G_1Prf9dEsuJ8Cw2KQlTV8fGf5BDpWKPCtK7Zl6Y_hQ&oe=6A1EC7C1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hiMb3XxUslkQ7kNvwGIzXSv&_nc_oc=AdqIafegO9QKe9VZHWvX4HqIjTMIxh_cNh1gECgyXm_qpBo_wxa60cv4-MaeanAGm3U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eosj5Mzv24HW6i5QFShnXsZaXi46FS4TkM8jkWlIfLg&oe=6A1EF40D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cRCxXN8VHNwQ7kNvwGLct7S&_nc_oc=AdpIXlYHgj-L2LO6sxXtgLoZ74dDVNpm-xFEycv-uMQ64gxvstwcVcIdz9Z5aWWzL2g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af423NZKNFWymqgPbHZMFx3pstdHQPlSAgZD-QfM8Kq-hA&oe=6A1EC84F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mAlTbK3lJ6QQ7kNvwEAB_jf&_nc_oc=Adr2nmLM_TnbhX1iUBnH0ud0HUffqVmTBzNVD4yZ0QY5ucDHzU6tI33mXuMPJi9vGAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6N_v5mzwe1shm0pJTzghAYNxdz010wKzq6T-rrxj8ifA&oe=6A1EF877"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vAgQ_UVZxEwQ7kNvwHkIK84&_nc_oc=AdpH89FQZpqKgLX2ADuYgjsB-nfTJS6K-dqa86uXoCQHdEwKX6FPrT5W4_gkKluNBcY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WZdhvspmk6NZUmVtZgcsN2CjNs1HLF061TshFwLbbNA&oe=6A1ED718"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HfsPAUKvuMYQ7kNvwH08UOi&_nc_oc=Adryo_Xio7bBuKpnXUPp9JsGfcMTMxrHOKNtpjQVA7EpMfqae08JzknwA4N_NBI-auw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iOHM1uC3KKTlb4ev_SHC3m3CzLSCfXBehTzTmxg9aEQ&oe=6A1EE1A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
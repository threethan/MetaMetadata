6", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLNK_H628bAQ7kNvwFZ76yy&_nc_oc=Adlo72kGfcVft1Yio6RGYwvIBCH3TkLs2XdvJSGiJfrus_dBMl6ZC7vkmC1i4m5AVck&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftCAyf6ChKeO3TEbS8xVTeKOSGwh1uwDDE61DrwQCB6bg&oe=69A2C76B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMizpiQTbFcQ7kNvwH-dzNk&_nc_oc=Adl6eVLiNB04Au7npw8pRpe_EvPfGK222uK4lFH8Hivpcef376AL8_Dgc7sUujAvxP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuHswqjtCX5TVm5RH-EaoStPwWSC3lOA68bfSvc-JigEA&oe=69A2DAC1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGLJU6RqMGwQ7kNvwG3P3zH&_nc_oc=AdlQ6whGzHJbiLVMKSsN_Em7yx-iiejhNouSXZkxjnh6aiOen4G82NAUbs8f__O2bZw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuJ3SuA6dUF9HLzE9ltfB4YHETtxgc0aVdmHA9KN71U0A&oe=69A2CECD"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxZaa32wIUYQ7kNvwEZTyK9&_nc_oc=Adl3glUcuodb8FVJJDznjT9TVaf-lmsf-BBRxvIHre2bKPfbI1i25bdu-xnP8VPEhhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu5EagsTGg0ZUvoUvuX3bi630N11DoV8VStktBXg6hmUg&oe=69A2DB4F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGhCCyNScNMQ7kNvwEq3gun&_nc_oc=AdlHZPr1o2cFNX6nDhd8NEkdL66tI2InmtXZ_FKbo7C62-K2lUA0d0xj53cBWYTUzBI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvidj9gWtyJNFu6luDYeIc0IPe1LH5h4osMk2wVXreTBg&oe=69A2D337"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ7ghvTmYEgQ7kNvwF6ffC6&_nc_oc=AdnqUcGU3Q7MAiApWosOEpr24eX46mKjAEoi0-kWrGvBcoVC7RUG0X4tKFyEld5RgJg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvD87NynQO6aanqWJ-8CFnNWoA4f1hYJV2L6qEFhwZfMQ&oe=69A2EA18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxckDPlnbP0Q7kNvwGZrtnp&_nc_oc=Adn7OEHrXBa0waCnOztyb48gnU2GBn24_wbABhYrwFofk6muHFFzb4Dm4FoQ0mt815o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfufPofhHNJzU-APt9AOIfJt52xO6Ph65DEUEdu717Ih7A&oe=69A2F4A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 176601240
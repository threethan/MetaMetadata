6", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBMPuyBsvOMQ7kNvwGo47Ft&_nc_oc=Admem6c_UjWw9R3qGCouhYSdjpOtk3voB1Dm_x-pHahM0ACTysjvAn3ZoGVaVN90vF4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftGG97Bhs8SXLJpLFAA81qKtymbazUuaMHBj9bcSodyng&oe=69A56A6B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NMizpiQTbFcQ7kNvwF1YH_D&_nc_oc=AdmjwUGxgIPc4B5DnaP876l_Qf1Y0vpS_KKm9ETC98A_dbf73DuYouiW8v-De0TlJyQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfspR4hncmlj-QIPv6iASxO6HvGc1j-HnEuugmsg96Mo6A&oe=69A57DC1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBDXr0Da244Q7kNvwGj28L-&_nc_oc=AdkFX7GaJowBOs7LsMbvk_rnpcDuC-SMgVDCrnMcV8aBkGXPUJtHc7dqL8I4FK0zV9E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfsbhmIwSfzqatnrhrUxZI3Xi7rftZtmnBynN9MM6GYHeQ&oe=69A571CD"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXmDqpT9mgAQ7kNvwFeI-94&_nc_oc=AdldR8xiI7rcJQ4cUMI_PCLtmXI6-mUj5Do99_FCSlo9s8m0gLWhzvWjkr_23790Gco&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfsByUhoaf1LLJxflySfHldpXRB97P_Mv_dst75ca8p8zQ&oe=69A57E4F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ybid0Vp9Q9QQ7kNvwF3HNuy&_nc_oc=Adkt-7fRQ1ipR78-btrEzMvlK-S78UlUEiatLkdUQIzEs_e8mMsGhR2VmDnYkp3qrZQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afugkn4u3rMyCB0wVCLnnZM7wT2gSxP6-ZHAM1E5gukO-w&oe=69A57637"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5XWuMc-vMIQ7kNvwECSTxA&_nc_oc=Adkj1DDIh978w1JX9Vpzq91ZrBkSub93pEsHYVvNvneK_3UrVmsU3X-nKNNQB1OhLDE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AftiY66pzQh-la-Pm738nXdChmSAcPe9saOuWnrlKR58UA&oe=69A58D18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUb_UBmOQWMQ7kNvwFteh_e&_nc_oc=Adlfd2a6HGy2rXbjUNS00cSWA-0aShTGEUa2Ns_IfqNmIIEI0-GFLIhdFoi5FymZEpc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuVukoWIbESLK00HNP3npHp9VyFnGmStSB-1p5LHkMoEA&oe=69A597A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 176601240
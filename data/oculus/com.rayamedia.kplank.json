reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALNMd_rV6bgQ7kNvwEbFgBL&_nc_oc=AdpW3Ti3Ofun5qHZGwbaYAp4vWd1Jj1tnGFtL4KVVo2qiy5_UAxLhw9_y-WFZpJ_QuM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hu71nOjq-n5AYmKSInaOy8ZMa_DpzX6_Cv6m0x7sSIg&oe=6A3A9C2B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PXAuH0PkxUgQ7kNvwHg2aeW&_nc_oc=AdoiscC8zCHf6F-PkAP2-JPymJ2iWl42D9_iA3kdCgPXb1ZVmon5vHCF2d4PnpcI1Wo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-TrAPs5NIpVz1__qjfyHE9klrW5Oy2pXEdHd3N6tlZTw&oe=6A3AAF81"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbCQcTzJSdQQ7kNvwGrMwUk&_nc_oc=Adr2xxzbCxCFJgBZUR5hfZPGIuiRQQhytsVmd9NTQpVdXcKF1PrG3WCXLDmGsry-uJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kFTq0ndvYjZ06sq8johehnbBIsQGbH-M-Agc5vu9I4g&oe=6A3AA38D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTNd1o3tk7kQ7kNvwGyHvNW&_nc_oc=AdrRQ65GfbRt7knCHVtWRC1OPOgPrrFgYxynV2p485VcjRz7l89RiG_I3uoEl9RCLFg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vsRoSrLjvFnysFyTo-KR3EzYE-2p0YTOJ1WAsC6Frew&oe=6A3AB00F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1b2H9orpTIQ7kNvwF_2s4M&_nc_oc=Adrzo0CKsEV6e-pgRekQIj6MIVavS5rTcLDdOv4QkHPLbz0btYcOCl0yH2WhXgN3Epo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vsknwMhja4_MPXxeC_axuCR2P3x--vN4-vVfqgxqckA&oe=6A3AA7F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kbzg601oq4YQ7kNvwFYkrzY&_nc_oc=Adp8yMkdNMKCLva20ERw59rePUpDt9Z8vL8jbYxotQj5L-dUfrWOsXXpprv-sgM9LlU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-UaqGXHn_r4hOmhYyPcYjcb3JTi5XBU-h1XSg9Xu8aRQ&oe=6A3A8698"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esk8JCpqFEgQ7kNvwHz57vL&_nc_oc=Ado2xvlS_tdVzgnGCB8O-M2D6LBDtDSLctQmSjGZxTYxff9mmrTJStt_I9XBAyBkDgc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_oLaoD47HO0pDDtdpDx8pU6LI5n8Y8Ecwz7VeXEIm2gA&oe=6A3A9128"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
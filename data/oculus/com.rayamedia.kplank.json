scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbCQcTzJSdQQ7kNvwGb5U17&_nc_oc=AdomqVcTK1OfnWnMXufiML4IpwJ4M6neR9LCGRGiwkwQw4Iq83GzIIvJJtDLA7zXU00&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ggplFaTLizXMLSayNFLPEwtczEyJbqWQeMaIcqplxaQ&oe=6A3BF50D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JTNd1o3tk7kQ7kNvwEbDp-n&_nc_oc=AdqDANGASGM8rULRGcBFN8DG5S5MEK3Ycq-UgWHz_JwEmnvUTkqjKY01gWIONq4Nc5w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Mn6dcBerB-c2ESi_oOg7VZQZ8blflmfPMrDihWEONxw&oe=6A3C018F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1b2H9orpTIQ7kNvwHJ23vc&_nc_oc=Adq9FNL9DIdySf9JYFKs5E8MUkDuYmKetjsg9iOTOA-hi1BwZR3wTLIWec0r1xe_JTk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DxAeyIkwWHoc4aKBNDUbRKQvr7gIKCJfUTdFbhu85VA&oe=6A3BF977"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBWqp9ofAYkQ7kNvwHr9_xb&_nc_oc=AdrF65jJtOdRw01677Enu9xgTQS-S8glzKgh6krUKTde5peb1K8NCAVAi3SRczb7aEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6-r1dOt4tNwmsuAeppWd9sogK1B__vrDuSynBESJj_Q&oe=6A3BD818"}, "display_name": "Plank n' Kitty", "keywords": [], "long_description": "## Plank n' Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank \u2019n Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "N
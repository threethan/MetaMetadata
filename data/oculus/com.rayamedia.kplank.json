reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9FglrLnttCoQ7kNvwE9_hp-&_nc_oc=Adr62RZanVsnmJnq34SLunQLD-AIejB7LTkLow_FU8RBEIWe2hm3sFI_MGfkLihzFeQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4VZpqLnyUy9SGY8aPlx-281K_Tim9Cm1GTegaRKqadLQ&oe=6A0731AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aLG3Ng7dthcQ7kNvwFijYXT&_nc_oc=AdrGjoWgCjdG4xmmErZ9l8R1wCqvUpX2pyHcb13E4tyIJ0RcuLk8QGeTB2xpoCCr6dY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7U5pJYnhLtuJ-n2noL4dA1BS2ki82tbQFMy32RGvi3Ww&oe=6A070CC1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zj439nJhwXkQ7kNvwF8oGE3&_nc_oc=Adr0NglX_s5ZwUSfih3jUvSEwAQQk33SqdeUat209nrjyOKoYXBn11Pyv6jT6Z5EXcU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af72mra_9tDiOhc5ZgXrvd884yROpm66icyrroK46GLARQ&oe=6A07390D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o5Vl9ItRe5sQ7kNvwGvLMWs&_nc_oc=Adq-pspnULomKiXiFtJyoBc27CKWpVoVAWkIKGoypVHce0N7uZEZhnxsHyFaiV_MFIg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6yqmgLCOUwOb9uKU2ex6rDKoIDINtdvWS7eUzfuFLhBg&oe=6A070D4F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9MBya2qisacQ7kNvwF4ohRe&_nc_oc=AdqQ7IZ8MahgUw-QAGsetbmNYo_PJzCUkAYaLYTNqr5h9pTU_efFcPzgtsaQEKANHJE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af551rz2CsC0PTKdwH9gRCx9CylCsBCM2n_DWJkanvdgkw&oe=6A073D77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxKIcUaK9W0Q7kNvwFxGjgp&_nc_oc=Adr1YCS_rjrrThFHKnQaJscXeWMbTeJpX1QbOmNq_sN6816N317V4FpyzjQ9KGyuazM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4mqwjVJgxJhVaPQ5rN9RJlSmGIRgql1Af05sZ5btWi4g&oe=6A071C18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PJqPy3fV0MQ7kNvwE6UKWj&_nc_oc=AdohuZMCAvUanNcGA5DS-kYOS1jX0WnHTfuXJwUPiQCVkpRCxqi1jBqLw9QbdRMrM-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af78fa8Wv38DrYP9b4d0kV9KPl-RWNT1-RGG2gJkXrMNKQ&oe=6A0726A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
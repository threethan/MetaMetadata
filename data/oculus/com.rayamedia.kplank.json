reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUjw2tA9JD0Q7kNvwGsamyt&_nc_oc=Adr7CPCJgLmOD-wP70aKR4btj2FKGh1x2D07k2C-r2ApWM0UYhtWb_7PMUyJZDvVrec&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A8jOb1M9ch0vgUgsccJhzaqnzQVa913oteza_RqVJOA&oe=6A130F2B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pucEf7yPxpQQ7kNvwGKo0cC&_nc_oc=Adr4-cihi1dVWSPV-58zsVz6p3wESnjLIqygJMhFo6fsJmTbPOuHDsi7CKxiBegsS9k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-VE5YmV-hiyaDHk6VnOBtvi4VzdRyHfJF2m912o3-Jw&oe=6A132281"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bct-6iyRFaoQ7kNvwGeJtt1&_nc_oc=AdptCbavXgsRp5NnCXrpTc-zd2HhGARWpI034zF9BpxqoSfu-YQt_-rOMSFfhHA3OrE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YxONt951ev5zmnE252YnQCx4Gm2zBseGKo6W4Zn9S3w&oe=6A13168D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pB4kiHFC3V4Q7kNvwGbk3Rg&_nc_oc=Adr4JxLfYhtSJlR48kNFQVeD7gZUHiEpiL8mvacwkudLXFZ1kmZ9rP0mccGrEAXQw8o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41qLcug_NWCNvgLidomrNe24fENOVTRH4_KPkw51mzNQ&oe=6A13230F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3RtYPey0nicQ7kNvwFdvfG4&_nc_oc=AdpFTzEkKUgCXhYXilKRzKrrUqO3cIm1VyjbXSZhQdBINr8oTL1_eboZhemMyOjvhV4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af45SWn3qvcX8hYOZ42s9TqSg7FDoJPBRsDN3KB9Xp18wQ&oe=6A131AF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JayyoBK02j8Q7kNvwFJpJHo&_nc_oc=AdqhEAqbQ59UA-yM7vxPvCQAXFUTbqVBKNjFnfTKC6cG7de_r2Q4-E2KYOxznVmBvwk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RxN0naRL-bVOBq0pIRfuqR4HDX4ycFDhuig0fASZ-ag&oe=6A12F998"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7msa8KyaqWQQ7kNvwHHxh0D&_nc_oc=AdqMTSMXD2ePtgvEZK1MBrR4-Qd14yqW64KC0uHgMvsprMLaSXUxFeAQ_U1OLbm252k&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7F7wEFGw08fZchXJlD4nYlCsy1i0w6zOsAmijfi-ravw&oe=6A130428"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
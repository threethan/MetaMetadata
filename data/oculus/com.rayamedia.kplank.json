reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UZfXCE96WMQ7kNvwFby7TO&_nc_oc=AdrPBjJRnE-OdBM_kAbf0562tTdjivf22CEcRJCKpSymlUpKRZp66GHIWJJmUvdd3TE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Ws75Qu-EBnBaMyZiDQS-xVIpDPwScGNPji8bxAex96g&oe=69F4BCAB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5CDTsdeEltIQ7kNvwGF92wd&_nc_oc=AdpJ8nOvsh6dp6rKzTsYFIfvdinUJj1ODQbemzier5voFO_APJr7silDmOCm9m_z3g4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af36geBDdGK2hqislPssyCCOWcInn569NOHMVnjCAJOEfw&oe=69F497C1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IoAH57U61gYQ7kNvwGeGfjK&_nc_oc=AdrcMFk5GnMH_rI6fcQ7OEh7o2csawfEhZ594GBSgSeSjnvJebZ6Mmg8XwgAsQjE_tI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af22Mj0mvmjjLPufLG7I4_UsHblQY9e8nQugBjUyfzirhw&oe=69F4C40D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NseU_yV7ZKAQ7kNvwG4lm3G&_nc_oc=AdpAYBkC9jfZF3hp0ackHwlOjJt-CXn3qBZmHtSr2PjS-ZFNJVVWkTAP6afjY2tQkik&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0NAc3Agr0ToBC353JVPTqLmnyGuPxauVu_PRCASk27hQ&oe=69F4984F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-4h-OC21sMQ7kNvwHycrOE&_nc_oc=AdopDOQhxFaZhHrJfswQZGl8DM-C6OLt48HDd2DXHlvMnE2JKkh5CSCqBGfoJYfbRyw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af15MN6hJSyMZzTIky104wSfXAuLXT8Kbih3n5M5ZegvAA&oe=69F4C877"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHj9ccvjUE0Q7kNvwHASjEd&_nc_oc=AdpChU55jIotIbj2884vnqwV1bxbcaViInqXFqxXt3uStaYJ1XAPRm6usnjtKMUZK4Y&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MrRBqfy7IwwCc8gODJyajNqJ3ST6BOXw5p8hcZ1z4mQ&oe=69F4A718"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eg8X3wlDCU4Q7kNvwFU1GQ-&_nc_oc=Adrbnf1sxKP4a6i5vWtfoveR2Y97CqZmTEzhoV_pM0ESpUUu39dti8imz_WZN7OIMiw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0c_1OvBb4iV4lyah2zeMK8lebG644UaVmqtRzucHwS4Q&oe=69F4B1A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
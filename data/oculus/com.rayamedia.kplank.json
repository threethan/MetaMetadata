=7f20f&oh=00_AQD18qglwXEVtU3CCFvHQxiw9eer-lM-neH-lLO8qWcCSQ&oe=6A674EAC"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a25DIyYu1DQQ7kNvwFSY-bo&_nc_oc=AdqoJPQdpeeIvRvoyazw6QaB3m13Dj4odqAjGR4pmwmHYv_75PyvCyHWq6Gvlh5nKu4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATujRqWwOc1jhMGfPFYgSjJ-7GvlrZ83XU5nof6NdIwQ&oe=6A676F2B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EFxNrzkNWToQ7kNvwGDlfr5&_nc_oc=Adrnl2_kp-zMhOOL7E-faIG84ukhx68-rwGaez-Xd5vj8Vv2sSO-XX82FQZNQ8TEuP8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA0RAzorGe5FAKl1WgV3yoieQ1KTdYb43f8c6OH-peYlQ&oe=6A674A41"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B7MPiNOJOQkQ7kNvwFC3x1T&_nc_oc=Adr6dCeCUxmDij_llLqvzE7cy5OAzFeDOE5kxgkk105RTvpohCK24ZZcvV1GF3GnnOw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMj0K2kxY0rRBuQv_IcglFcX3Y8XqECF9-54yfU11Mrg&oe=6A67768D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jwim5wfgbBwQ7kNvwFtmSBY&_nc_oc=AdpHSTN8Sjwe62CMi6WX58_dYi3Z7wreIlZLTWTXL8W7DvzK425hYiHTm30jFJwr-Fc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAE6XurhLYnprAzClVnVJD-9ZzQCUxQtV__Ag5xCp-WwQ&oe=6A674ACF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=svY9FBHtjYUQ7kNvwGHNbPo&_nc_oc=Adqdw5IHA3m6iuerCr3-6EklEIrEDoKx8jyxAXKR9UwtEx5QOqDbjkQu7YCCFdkDcwk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABFR0zeoYENR-nUTvzJe413h7S7Bd3i41NLhAxmksIRw&oe=6A677AF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R3stF6_bcOMQ7kNvwH8m6m0&_nc_oc=AdqomtabcPLSLkwqLwEve65AlkQdCLAYuUjHiDikhWnAQqryilhd8_BPMHx3SroPL_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBuawG8DIock6tvoPb708GNgvxXRtMfNQi7RVCBbHUpnQ&oe=6A675998"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lj-x5KZhlsoQ7kNvwGlUiSe&_nc_oc=AdrJYeFbAkZ8_7PKQOTbtuAMRx4ptYAqmYipTpkfh2t5EcieStDfvZuu2ULFB6LXPac&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnFTf1K4LBJa9uh_RkshRMp6jPkoGbVC-i8hCJblcVoQ&oe=6A676428"}, "is_concept": false, "is_test"
=7f20f&oh=00_AQJ31tgX71t6Hm1vGkawp3CdpvqC58iwwTl5EsckJkYTUA&oe=6AB3C5AC"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8XjDCrDxQVsQ7kNvwHjXGGG&_nc_oc=Adq77fVG8JnpMBxDng5LOdt2WXtlkeBEkFMNjF8UigYYWbBSR-g0ed_-mUH2h5jlRb4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmBzGBJugzy7h07h3IhRrTu_k7kun7nzU9rPvsHQFCCA&oe=6AB3E62B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=13OoXfBs62QQ7kNvwHfnoHl&_nc_oc=Ado6ZK_hXa3AwCpJybwSBJ_5XpjgRuiyP2PTHk9-63NrgvPquuxp15oisfVzD_E1obU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpRTLGFRcX5ElE4b6o70TlbnuvKV9v_K1bElco_lPn9Q&oe=6AB3C141"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNHXebPRomAQ7kNvwEdFsV5&_nc_oc=AdolbUk0N3RgHHwbAgOsII7xtUlEEv2bKC-t9QxZVu5Ou1SdrDSrx-ndjMdH4yyHWbM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ31Av-JGW1UH4NT-svQmAbping8cbW_1CbTd5ZfDpZhQ&oe=6AB3ED8D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OQ9UKKwTxdAQ7kNvwG8ndW4&_nc_oc=AdoIC1KyPRVRDoLQZcAS6n8-fgXbjHiIZ7TOiYB-oeqQXYw67mhmLmbo6b8RAGZO4Vc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj6nNwUZmfr5kQvHhHW2W1QTZRsShlc_i8RxU4x1JPVw&oe=6AB3C1CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=whAFkl9R0b8Q7kNvwFn83ht&_nc_oc=AdpvEfgkeGTmdCLVJkToW6shVfkqzuhSCsXB69GwiLq6wGSx1AcVxm2fuoAhgucyHlc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0jjiFMIRrbcepG8Gkl3kVMBKuI-d_sKvWHjfyt1p8hQ&oe=6AB3F1F7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vf4zYsjD84cQ7kNvwF5ATGj&_nc_oc=AdoyvBF2f_pkW3Bf3VWZCirxNtgz806_ygWwQfVP9L-UAR53twVUWXL-n9ajckSBtZc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIWkGTx-iijiJxpYkALo9anA4E1JrlaptwjHWnkNHMBaA&oe=6AB3D098"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LRIS3q3d7yAQ7kNvwH6SU0o&_nc_oc=AdoZppi7p3-l21uBzn1xEBui0GWSu-_lj2otI6PRIoaENRL6HW08u_85Jc3jBVjpXgE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhJhHwkHax9b_DzT5kaGAK8gnTd2gStilfDSO1ei6j0g&oe=6AB3DB28"}, "is_concept": false, "is_test"
reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Amkuer-UJDEQ7kNvwFw7V7S&_nc_oc=AdoYdndLGnQu1w1Fl2dazw6SrtoGz4Z4TccPz3L05ZCuSvAzy4MW5yuexvBq4IsLGcw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx1kduIFt86vBfMhdw23z1TdGOrOPMU_ny_weR-0ncqew&oe=69CBDE2B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6BZQxeWbgsQ7kNvwGgnvea&_nc_oc=Ado83XRxL8aliLOC_zVaNeSB8-bJ8FLqRPiX6TICnuzRjeSiZkV0NnXWdRS2e8s5F_8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz014gtkmr7gyoO-Ie2N9ihjikbbLqzr5LCOSa9d32yAw&oe=69CBB941"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnK8Snl6qDwQ7kNvwFZirKK&_nc_oc=AdqendmCWShN754tfBlqOxfuCPxIEKOKjWZj3qyWnk-gxTb6eOhDuljU732O5EMfLDc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzVdj_mIbfuOuVH3ClE_seoMmyCFkomOW1gA9OvmvBG2g&oe=69CBAD4D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a4-bH0ykPbQQ7kNvwHfKB_N&_nc_oc=AdpRSHztFrXMUFIie_s6iIpC_62votijEIiz1xo2kbK1Te82IjnKLodC8YG68uUoaUQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwGOvFuUf4lTETfUsjei7fMHy6UqYh4Fl_Rtl2lkJLr-g&oe=69CBB9CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYyHIymNik0Q7kNvwE5ryqN&_nc_oc=AdozIcA4xiyPEP1i8jxNsgH4eZ6CpTGgcbZQLPanGoKkwBW19_AyqKcsU1cf_3_jRp8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0hMsEcgI1KhN3Fxm6cxtd0LE_A8_fPKKgRg85pcZ6CA&oe=69CBB1B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFVHhx7hGHQQ7kNvwG0ATtD&_nc_oc=AdraytPiVmyzSQUVxyi7nzbMRKlGorWt5mrPNiuhBhLzKiUS_99h1DVHkbuddMH8HPg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIeMem5ns1q0ZeLMQsZFadygQ8wqYujJjBetXc5GmM1A&oe=69CBC898"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9a0l6XNO03wQ7kNvwHFFJUb&_nc_oc=Adqp8dbCxb_zTiBgRxPyQdzCYLClpvCEkNc7y6dfVBzS01SzJdQ44BsKtKgZ9GujExA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySVGsOEersBmdQRH8c9havGd-lpetLkSmsJu_-hER-Og&oe=69CBD328"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
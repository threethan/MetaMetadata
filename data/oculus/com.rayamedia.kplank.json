6", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PLNK_H628bAQ7kNvwFrz-Tk&_nc_oc=AdlHt2gE80_Tm4cbZmY0FHDZT3H5OLp3IdnlgStjaqYyTU57IfQZMiIOvla3J7aUXOM&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuHXTsjd8PrdKQ9KdxahnmVGWu5l4Oq_ahuuoUNzGDonQ&oe=69A175EB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SXzZ77e5u_EQ7kNvwF0kH_7&_nc_oc=AdlkOquapytdqkPHXOoxCdfTXA_Sjl7aYMya2JpG7e8d9BeX0E2JChoeYDBVynjRcgM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvFkopc-kTrii4Lann2gpfR6ZyVIsO1ClLDZYac_yeQiA&oe=69A18941"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VGLJU6RqMGwQ7kNvwH-5AfE&_nc_oc=AdnGN0NpE6yu_m7vbqUzvtmy0-GhgsQYwg_kCHZQlfqz8SGV-a5Y5JXZBUhF5ZGyYg8&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_Afvyh5RQWOfqvLyPj4aoayIqSHRXXsIt2uYAiBXmRB1g9g&oe=69A17D4D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NxZaa32wIUYQ7kNvwHKlWRH&_nc_oc=Adlw1uh7Rx8g_YGcHqBTu4V_jQRBpFwec6cRyPGBYGQH0Sx4ozeSk_q1RyHpyh7wAh0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvMN1O-i0UHVbDNdEr0Anm0ZVFObKeFv-Bsxrkb_n_GNg&oe=69A189CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGhCCyNScNMQ7kNvwGouX7t&_nc_oc=Adn8CMKvFTn8vwiMNHqXy2kpokwGeBC2HIAFHlWSoEevf_w3-OK7RTrVeEMBAxYAdns&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfuN3tGrvD3DyVN-jKPKxy9bz2164c4Gv14VH0ZapVUxng&oe=69A181B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJ7ghvTmYEgQ7kNvwE-jbIm&_nc_oc=AdkgYPRxvlhzwrz6f2HJWHmONORwEHdes4s4uYlAB1OTWTOc_b6NKSEy4woO4JfDjMQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfvJnh2jCodUn4-DmhJSlo6ChE4ZKaDVsLksXh7EhP_lyQ&oe=69A19898"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LxckDPlnbP0Q7kNvwEx8KWz&_nc_oc=AdnzG9IibuvHG93SEADslWKPWxarGpQ6qw_stamWHs0RNwva574fDCddrN5cxMPsiik&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfsmeKPMV9xxHiCWAwXRgGZBTo-xBK-q3ZFItTU4rI9jgA&oe=69A1A328"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 176601240
", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u9Mi6LpUT_UQ7kNvwFF7puM&_nc_oc=AdpNR209ZCiwjB6hzXxTz7MkJZrfp8J0g_QUOL73_1iKfiePd_1Fur9DUmZQsbGvHjg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aMHwe4ebEu-DJ8vFqLHaQxVDdkzbnB2gd4lFtNlHcSw&oe=6A36A7AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uo8Em0nSTP0Q7kNvwHw5c07&_nc_oc=AdpPsOYHLpEL947nia_pCx6oHqNR1ywY60fhb9Nm8S998g9rYEJy3bdjY3-nakhVEoY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-51BNJ0uu0qSo4Bp_gmixytA9TkoDz8WJnpIlHe_LDtA&oe=6A36BB01"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1YEIplbL4jAQ7kNvwGJX_LQ&_nc_oc=Adolx-vdRzUGkS5x4qd-2OKaeaJqup8vd_zZpCM24FeBTyE9ew9OZRiWRR0kfZshM60&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-FYccd6Q_BKOn2dS1cQVXnbO1H-joH9c8DavRVRN0xjA&oe=6A36AF0D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LLUEGmWsARkQ7kNvwEQUTBK&_nc_oc=AdqH_7uvVpCVUdYphcgpeX-Jev7x0bSrYgy6HB92Exs8mjvZBp06zevaf-MO4GnDlEc&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BfB1GGBKUG3XNLBKeYm-RVX6Wo90RU5sPD-9Bz5afjw&oe=6A36BB8F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQSSouqPL2sQ7kNvwHhjfMZ&_nc_oc=AdrULa7mnqTc0pomd_Oz6KimK2_2VID3RPAp-jKk-sfO4nnemDH9yOyiBGP9y-Z_m0c&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BTEH2I6gzB7dOSgyEnNNYxsTpEZ3pWohmw9yyUZ253Q&oe=6A36B377"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xRWxuZgI8f8Q7kNvwGpOh91&_nc_oc=AdrbGmIfbJjL53lHIzHBVdjLXx-Oi9CLHs9Ayzv06DkW3FK8JsoxNYFMxasisrIXfVo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Zm5_NRUyyXiP5vQRdrKUIlHwj7gpee7nadkFVTHQ78w&oe=6A369218"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93bWWsRq30MQ7kNvwELTigj&_nc_oc=AdqQ9yGUsyBMrEdw3yE5zEOZH1lRFKtn_cRdnSSQX7YtYN5aQrXfDrw-QbhwP7jJvrE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Bfy-gWE88RodHpTT41SBV5qI2Sr0x1pdfaltDmLER_w&oe=6A369CA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_cat
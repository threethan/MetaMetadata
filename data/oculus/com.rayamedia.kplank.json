6", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TBMPuyBsvOMQ7kNvwE20ABQ&_nc_oc=AdnmWqyINIv1vcOHj2z_wg6t2lh5X_SOMqJR3bqTU4FHDSHHWI7lz-B0G0-lW9U-6KE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfszaLi3MVUMw-Jbeeipo-N9wzU-gbECqI2uxgtiwyx5rQ&oe=69A6BBEB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vg3r2QKkRGAQ7kNvwEQovVE&_nc_oc=AdkRjIWpeGvS_52cGrvkBLgsAEc_rmveGkVWXcHDi3nsUdfeYSFjuEl3BcJTRKr_Hms&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsOibEzfkqanxAonflS50LmIDbp1IlR3MZDqu7fmi1qTA&oe=69A6CF41"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IBDXr0Da244Q7kNvwEDmaHe&_nc_oc=Adki09HK3yGEJIHMFbhen1s7Ih8-OjyvTta7-6k3NrZCxVilQb957E0DwTK4NY9uMzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsBATudwrsjSPL36spHZEyoFMToqT9RrClqVODftZ1J8Q&oe=69A6C34D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vXmDqpT9mgAQ7kNvwFcDUIz&_nc_oc=Adn3UUhd7YHH5uQ_FmkNn9TjeAleJe_82ZFex4rttZ3_RFTnDkkjbzoGex1WYTRFkwY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuN0-yC0IhNFbMBEp7cisL2jT_aFunHbpxk3KU79okDeA&oe=69A6CFCF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ybid0Vp9Q9QQ7kNvwF5Sn8b&_nc_oc=AdmrIFD4M7aa-JKE-YY_Gww8LmqAtR2v3V7cPaXnTpqppSMZBDGl_kUDjknzzPaqs4w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvYaGEBkwP8NHR-p70VUUOBMCAqNRBOUbTlp0a0gRHwdA&oe=69A6C7B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A5XWuMc-vMIQ7kNvwEg6uV0&_nc_oc=AdmvyoY0_8sJ2UIDcKuGEswEc0ezhdPivxLHCHCjn0TVm1gJiU81bm3tuaSUvxxNnaE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuW4c6XHB6eH01Zx8EIxheYgI2XQ9qbSWtp6lqGQoewng&oe=69A6DE98"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eUb_UBmOQWMQ7kNvwH0rThv&_nc_oc=Adk4UGWCYEupd0q7r9BMOwlSPwY2mf6NvzHFyzmh8fyPCbR7YT6Zg5ZURElUVkk4z1g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afsxy8puMteM2fCznhwt8z5wLW2lwp_d-074q24SwAr2Aw&oe=69A6E928"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 176601240
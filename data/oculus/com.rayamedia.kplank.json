reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=in0jDoAXJZMQ7kNvwGYdG9N&_nc_oc=AdoMTPo4F1LWRMDeUDLEBRzqoaeEJU4qrR83WFHSrL9RngCkRDzRiopibT4Ad3UVeCc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwz3LuJ_h8T99aG0h7BQxfISWVCuj8-8kqZRzfVkkdEIQ&oe=69C3BCEB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CvPDoT3p0kIQ7kNvwER5rfV&_nc_oc=Adpcw4-tBfWMJ0EAkvjs_mEgmLX0_gupQ0xJzeTbiX98FSbqv6YV5G5THfuRoBRHtrk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZdd32aBYlK1bH2QXYMctp_ddPx0fiaC6AsDtcsg7IRQ&oe=69C3D041"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU9WOuWkI74Q7kNvwGKufj_&_nc_oc=AdryyaDQNk9wnhOQ7iTmYGCfciydwYJY7gWF-qw0Z1i9dYoPbxEMh1xcHmYc3Qs7W9E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHbAnJn5cUDEv_IjslpwGARQt1lZBNWN6hs1nEqx6U-w&oe=69C3C44D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovrvB6SxoaYQ7kNvwFOsTZ0&_nc_oc=AdqtwAZ5Q7JBSB7LR1L1O-aJeoYqHYGB-X_oTqklEpr9PEu9TVg6g_VYAm8d-ikdQzQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz6Ce7JBHiu7j8FcoQwTI_zNWuDBn667Tr5XRQmUZHHtA&oe=69C3D0CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eFTYPe0OPpIQ7kNvwHTncXK&_nc_oc=AdpZWz-agPzhI9iMrEXydwqEUNaE5TGoT60R-r36vPBIsenXzCuZXRuV0kRmpuc0pVg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzeNAP8S_Ma44jNSZnmsSjbhfm23N6DZ8ZIuQzXtstmAw&oe=69C3C8B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc8gfyZmjn8Q7kNvwFAenQa&_nc_oc=AdqgU9edCD5hZPbnQQtXO4qfwhmllsqwYpLrBuqYlLCaZ05py9NeMTTLZ1OM0t3Yqqk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGBAmQSxL5hvuF-KvR-kALgHdOXbyuv0I08L4DH1lgjw&oe=69C3DF98"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9NFiX7mL7cQ7kNvwF9p79j&_nc_oc=Adrfpw3W8Z865etlXiiRujArQ4n4DpigriIAQgD7wzpvqudy6YLOwxUKHw48i2Dz1n8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxPEbe1aLZ5yrmidHbaJIKHGutswXavxxY-svPmOK4cqg&oe=69C3EA28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ed57aVl734UQ7kNvwE0ILE1&_nc_oc=AdpAYEIokz9amqnzv9A3bnzIBP0YJ2X1ulJeTa2Kegi49Uy_k3rpSe5l6g8EX7alymI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pGqbKPElsmV7Ljh7ZvRfUVtcuWOxMyoBiASY5JdkHBw&oe=69DF6C6B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=riKGwpgpuBQQ7kNvwH-IGi5&_nc_oc=Adrr9ecNr9F00siczY41XgZxwMuOxMJBPAR6z-3GdwIBDyUnSbcM1AyVsbwhcyurX54&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13F98yicN8MCBEQZXDqc-t2SvyXSQt6xMry8MpzZVyPQ&oe=69DF7FC1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tNqIveb2TM8Q7kNvwF05-GR&_nc_oc=AdpPnwrzRqEvMTG9TkeOowq9sGzNzg4c646doOba_fy54szbNVgtFuF7WMk5M2pI-qI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2bxULTwCzZlRoAJaKoaOIfI8oBOuBHbBEnVfnWz-9drA&oe=69DF73CD"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KYeQZFvOfUQ7kNvwHw6q5u&_nc_oc=Adrx80fWTUAHmYiDU2kadamVnBc7b61pmNO_US2_V07ID23l9adqXiZANm-ufca5oWM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wOpAh6C-aCxfJ7uWAQWXsHwXpE7wriQLmkHAcDoAKLg&oe=69DF804F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hhQ7gocN1cAQ7kNvwHYkOdK&_nc_oc=AdroFxWZvaGrCvpirtoV0aGeQ9RVx8oS0l-JDuJBn3x9ojbtTxQYIgPpd6fIRzN00Dg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CJ2RMC9Qm80dXv5jxgiWgk-FJzHpEjAKezrNwBtWt4w&oe=69DF7837"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hSdELRN1GgQ7kNvwGyvuMY&_nc_oc=AdrX_9QwzFTTYLqriStbTAoML9I_JbAmDCQBZXzIXohK1kHL6ex7JV_kVbJu89y-f3k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af01s3b_CjQkmJmkBIbmkSra4bUIZVMSE15XpnfQuUDwjw&oe=69DF8F18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RN0RPxIFdjwQ7kNvwFacr6u&_nc_oc=AdpL7w4tcjm9k5aZPQPKJo4C9dSTWy1edsLpCycu4_iTWZeHP6uRvKIXazpEygT_g3w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0CfJ7DW05qywp0VnGgA7h314bJ1ab5LioSXKFZvcAcEQ&oe=69DF99A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
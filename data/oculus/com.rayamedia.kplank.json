=7f20f&oh=00_AQL1PWTUMvNfRbdTZOU7ttBVlGse8rxzPdChgsG4b6KNgQ&oe=6AA5452C"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CIu3FR1uKoQ7kNvwHN7EGh&_nc_oc=Adq423uzPh-XR_32BjrXIGj6nJ6AszsP3iDmOOACn1so0GxDj5I-Q70gK6MNW6bofck&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUoywYj4xUIY2P6dMbD8UT1qN2n8Ceswa5ES0hpl7eEg&oe=6AA565AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jjSrKKP9rjcQ7kNvwEfXluG&_nc_oc=AdqMRAcLO_GIeybav6JOdaCf-K1yrwEYUuwaFXFb4nMUZb0dMlOISeNVz1qskka_kXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKI1Z1BO89r_nwk7-n7WiT-0QGN7BGndy4JgZA1DkRWUg&oe=6AA540C1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJrgn1jgQ4UQ7kNvwESCZSR&_nc_oc=Adr6YofujrJ_TF9XI44rAiDeXzmON-uDjEZCUCthmMLnGetl6PK4Pnm1jnnfsW_Tfm4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8fk8nQbpEJbtbbmwkOQIV8FUlT19YckDPSeOjHouHjw&oe=6AA56D0D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0cmt62Cf2EoQ7kNvwFuVFBb&_nc_oc=AdpcahmY3o9iBOqxWrVmY2skXR0HxUPxrY7vqB7bP8hHDSIFFoUASrKrIpVvJ9AnKKI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbHip_4iopJ6gFe_Gvih-My3N7ZgBBrGgPU3lKmAMgaQ&oe=6AA5414F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRC0VIHLr_IQ7kNvwEDO6iM&_nc_oc=AdpVOx8gyFNlKH-grF41hTNJsduSV8naw9f_dDYyvubXoMym_2sTTAmnFFrlFfQEQ-A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_flA7g1hPFJ2SaQ6kWXcSxlAJEJKZInRyE-g1nij02A&oe=6AA57177"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmIPNTUH2nUQ7kNvwE077Og&_nc_oc=AdpbmfH3dHWj59RKMqsj4_mi226LaJjAAye8dr92otQd5qbKwjI5nP9GHqUZExN4OWQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6oYGQWfhkCgRJbdzJOT6kEIBqg3YZ3fbGwAlUKwB1mw&oe=6AA55018"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJsb7EJGNxYQ7kNvwFhyocV&_nc_oc=AdoANM5wJPCPTI1M8zcQFQ9Jbd8UCFlMyA3gFOPAqtwmhkYhrgX02ptF0CR3PO_bV1E&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdPHvVUTo5Po7BRsJCD4xCU9BvCi1CpJQX68Ijg-ES8w&oe=6AA55AA8"}, "is_concept": false, "is_test"
=7f20f&oh=00_AQGCwJLy8FpvfnbfzgJ4tJuzt7TcRGQQNpzDk9CyKM65og&oe=6A7720AC"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=taOJxd2l_fsQ7kNvwGU4ubH&_nc_oc=AdoHyCQ3UOLTnrB9Rkq9CLsV0IePYklbhDSuKLlgJ6fSgbxpJUZVoIwK3Y3XupW7N6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeJyx27VGM6sxBzRnJ-pz1oRo4JehNGSkNPtVG5x0Ksg&oe=6A77412B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsyS5_AaBLMQ7kNvwEDM6pL&_nc_oc=AdqbkC6to6WtJhRV3dCSAHpfMbwtFxDaQMbstvmGC-D3wYZVMbtQNgdIzYtmQ6dUcYc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuyfiai59aUhSBQG7AULx7RRARGziOOa3TAKnBamKyJg&oe=6A771C41"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C524QbgM7-QQ7kNvwExIuSr&_nc_oc=AdoHRj96yom78YBXofETUcBYoHm9R6FDH33NyVhfD0erUzw-1r_9eqlJg88MR5U6-yc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXxBvxJrpPqKp1Hem5uWzKMtLbLTpcO44XK_EqkTZC6A&oe=6A77104D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MCPxmNY3RtwQ7kNvwFDXzbw&_nc_oc=Adr7Fga-2UxY3z6_IO70Zpa0RQ3aMZQ5R-YqRYuYhsrrnEozXeGddy6MTIWZvEc-ap0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEyxpMye-fOvl7i1JEnwz4gduXwB6ifEqRKZc0zAhLHA&oe=6A771CCF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xLN6m-FfQNkQ7kNvwEz7doU&_nc_oc=AdpRo_eS2RDJgdcamtVtu63SoSftBH5Nt-J9G3mcXYZDT__IrmuREBz_h_tXYfzAM8k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH52HGo2aR7NC2m0cfhC6lgDlz4Bqc0gWSYmYG2swiyAg&oe=6A7714B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x4v7CmYZ4QMQ7kNvwHvL84_&_nc_oc=Adr17lQQBv9kAM_R-88Dn1N4RQmjil7TiN0y8MmPyaDms5eh2koAeK3EFb1ZzWX8M4w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqExc18wEidAjBC8tW9ADeHSpv15Bcx_mgdFUFKaryuw&oe=6A772B98"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f3YReIitCAQQ7kNvwENnI-y&_nc_oc=Adq9e4B3ApQ4j_aM1rcrLqr3oalBpLQOBNXmcro2c6wUDd0nWGUFwbxePgmWtTVUpFg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHspQJK0M6vDgt2f-2aCeGJCBbZZWr_IouC67FpAFs3Dw&oe=6A773628"}, "is_concept": false, "is_test"
reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hQ9fj2qIEKQQ7kNvwEocQoz&_nc_oc=Ado204386qGgmYVr7b58ecjES_mgPk81Nq62RVEvvv5pgzJ4u_9Ip9KkolLStNpbjVw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cZ9AB4ArHkcjaDisOvARwtygdMYsxVeO0tMvT8rPe-Q&oe=69E8DF2B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JeHNdm53RicQ7kNvwHOohuC&_nc_oc=Adrm0m9bnBfa_sf7b7gjLrBKPbaimkLRiqSDTnQSOvzDRdmfRi8LippQp5f2V6jl_6c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2WGetYc3bAJ3LsbTXINvFI3ZjIktMl0ZCwDKe8BoOZZA&oe=69E8BA41"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIOqQ7McBnEQ7kNvwHaw5wp&_nc_oc=AdrBBcp17ZR48fbZapLhIzACszD8_rJWS_HZ4tsI4McF6SymljBtOQuSJXaOkIAy77k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0E_4NhPThgwyqkCB6w2SKS_rupSE68ygvYMhzSx_2ntw&oe=69E8AE4D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0PQcGq4UgoQ7kNvwG3x6px&_nc_oc=AdqwkH0AU8cvJuath7OVN6UeQNkOxj_Tl9m_j_TxmRCNgwzcxVs0YtScmmROrYM_XD8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1O98H9Sb6Jdr9mQhblk0hrV9UAMnhoVrJpRWgePc1jIg&oe=69E8BACF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TDOZKXtj1zkQ7kNvwHkkvZx&_nc_oc=AdoKA2QYbkRBFmKyc_f7ZpbP4mQgutl7IK6T4OvqjHc7ROMZxxOM47YYuYhano0J8ls&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10_1BW5nN-QGjARU2cm6a_KL0-gNHOZzkz6PBAC3JFWQ&oe=69E8B2B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oiZOtbO7CZsQ7kNvwFQcj7X&_nc_oc=AdrEsLmBMlKiJyKC6DYpYT_aQD9L72oRwdHNncjNdkJp-F-FN8JRzYb_MT6-fDUPiHo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sAFVk2UoVXYvHXZQOFAcxUGryBBR5r_RPkQfXYVxRnA&oe=69E8C998"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZkgQZMpeO-kQ7kNvwFwLZUk&_nc_oc=AdooTBNRxHiTayWWruMokfa1tjwcdGL1gr88KxCAc2J_dgT4Zxr4lpPzFl3wKUjvbh8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1-Nk3Vc7f83q7nmU8IhdyrdbgO0ndcrYeBfv_8xKyqQQ&oe=69E8D428"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
6", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciyi1iVZBXYQ7kNvwFDvSDX&_nc_oc=AdkSBiryWIO3-HLZKCD5x_Sxw3EZeuVERXv546EHS-jGhuCij0tvgFMaQngZEJZwaMU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftSKmqECmgAhZpGfCWF-Eh9P7ku3lGLen_ZEhGmMSMRMg&oe=699ADE6B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bmSpC5ZXzeIQ7kNvwFlFjgB&_nc_oc=AdlJNsHlolwqOxE1FBs-ev4mq53zBK9NjaefFM5d7lV9ST1Yt-cyH3A-bID_6A9APW0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuUrujYaEzfCF9sj2hhxPTlCAFzAIa_w-_vG-_ETDAItQ&oe=699AF1C1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJQYttgSB9oQ7kNvwFgNWDJ&_nc_oc=Adn1qg4M9lyPMtH6LiikfpUydYx1vmVAJZ-4xk4L41Eoiuk9vBwOfQuA5rtO3bue-VY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfulBiGv7orz45PZ7nMzydkzpsv_XCzLQFlTMKyykHDPDg&oe=699AE5CD"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5kICloIgWIQ7kNvwGkJS7H&_nc_oc=AdlSisg0boqY2nHBTFTMslKsanFnm8JpJuMa5guoV49TU540AhDHMFfIZoqjxCEb0XI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afvtbk3o6K0AQ-P26fenL2xyCdZZdF1QQyFj_DcudZmgxw&oe=699AF24F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUYxkfB5q6MQ7kNvwGf6A08&_nc_oc=AdlFK1GpZLlAfTPtO-5ssTqursBxi28iOXag98bCYbpexOl__Ik3xLZO4NJrc2aOPmQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftlgSAvFkMxK9BtYmF2d83JlXZNrHm1UdyFffAXZsL1fg&oe=699AEA37"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GL_vmCXrbT0Q7kNvwG359vd&_nc_oc=AdkNi-LE8YjpEUTerA5NetgkiKnsH0k2Zr5Ylw-rztHrXVQomfsf1osLoN7W2kwKU5M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvVs-9zfN1BjfB_XkpD_SC4cBvP4h_06eFueTOICEx43Q&oe=699B0118"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2o1r3ylY2bIQ7kNvwHraqYa&_nc_oc=AdkNVs31akbKYgAWJx9Gq65NPbjX4P0SVk403wJeH-zGKUihJ_L2Qw9dd0BpTzOsCF0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsSgmboaEaqmjou_5tAVJdzccr6hpaa8RcIQQ_ayMfdPQ&oe=699B0BA8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 176601240
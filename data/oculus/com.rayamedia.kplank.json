reenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j2oLx6HvqfUQ7kNvwEvd6fX&_nc_oc=Adq1CL6nb4-RI3X5uvFzM1gms_67B5Trzf7srfu54fGj1XB511TbKbPmiV8dZXloQWI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_suBrCFvhzECovqzNSDimpfYgEaQxIQIpjsizr0gdCVg&oe=6A32B32B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HacB-3nTDJIQ7kNvwHLJTxN&_nc_oc=AdqNqeU7D2uokh5Yklr1Bmkql9pChVo1QSL6-ng6ZnUGgrTpcooamLNZkwXZCEQA2UE&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mnrd_d4uysC6h00mBiZADOE7J8dasrVfN2ki05exSxA&oe=6A32C681"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBbTn6D4h6QQ7kNvwHBvC-Z&_nc_oc=AdrTEaICrkmJI8E5gibuZp_qWyn3bM7O-U9JxcjvOdtj3Kx6MHH0SiGrWKLuf2mdnsU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9sajA8TpViR3RmCa-V7EjT3-adXA65F4sLdJ3ODL3-bg&oe=6A32BA8D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4zSTPigBL8Q7kNvwF5v0pt&_nc_oc=AdrBdRSJVGwxva0JnG1ZJbELVAhMGDVNQWuuUjLtKeroCwlN5hxwAcvmI8n3T_b_ULA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WCIbxiymEJa9icw3cr1HfSfFPXaXL4yAAkdXYnw-KyA&oe=6A32C70F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L-Ru8l7OFkAQ7kNvwEG5oIG&_nc_oc=AdrmJthTvP36pYxBcjtU2prbG6HfwT6xPf3F8RfjAFvgYewe8V2v6RTEPtYEMkR0vNA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fRQ9_HzBY01-ka_PL3oVQCOsucxeGIZIKPFWhN7OvMg&oe=6A32BEF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEF0yLVFHOEQ7kNvwH84YQz&_nc_oc=Adrx3bjX3wIpyOv6iVVkFikyG28rd484Eef8U3FXKdeQASuU2Ugp2p3jfDN_HN5PjUs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9eFXBS5lh2HGdVcXMQZ6Li-KnTSJR-0YILeh99lQsPcg&oe=6A329D98"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5AQ740LepsQ7kNvwEXXPvs&_nc_oc=Adr16QPdjAmt8hlQOsZ85KxWMV9aLcXzfYz1Nglw7AN4ywb1aG6bqdY6A9d-2yLWqRQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af92nk-BTy267SSwHITde1uT4izlsQm0hoYEturYDJiNrw&oe=6A32A828"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"
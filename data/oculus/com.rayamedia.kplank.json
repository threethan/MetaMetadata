zhwsG2pXCKO-FoB4oEMmayUg_i1332pp5m4e4yfw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwrBcS_jZGmnZTe-r-MtPRjG1LyleFI-ifU3tZekNYnRA&oe=69BD3137"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=as-ZA0gDuUcQ7kNvwHNW29b&_nc_oc=Adnen_QxGJaaCbBH5RvKB27htaZNyxe-xCBspVNa7FkM6CrEIJwyO-yi4I-_coGRN5A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSX9lcLOW6UKuWhs2uHF2mxYMO3KqqLWOz1aU4DqvKXQ&oe=69BD4818"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mS6ZSZ04wBoQ7kNvwFqpLXz&_nc_oc=AdnjcUu1wR_KP1qLisjO5YssuMze7CWXefBxqrEbnH_XiRAHY6Hu1n_WifcqPHYCNQg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzYSM__wsbISDTGSjb3WRyi7m_Jy1tORntbQHiyV_VKZg&oe=69BD52A8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925
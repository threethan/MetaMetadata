6", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ciyi1iVZBXYQ7kNvwF18vdV&_nc_oc=AdlyBQt9j_2MwPegZnNOILcQ77_RSliikVs59hCTZU35PzgUS7khwzBdtdJriilolIw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsC8TrmoHBJS-MP-Liw-7pXBQrJ4guTwu6opdbcoK6k9Q&oe=69998CEB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81W9Uk9R-HMQ7kNvwHzweH3&_nc_oc=Adn2gE1wGGNd6h3rsDoLzmllhnFx1DtjqayA-QIxGHX4R9WRiPWbdEL5IVS2655CCNY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuDGSJL8ngPvJW2P8vifiVP-TH4T4LLDrZwUOIzCDFblA&oe=6999A041"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJQYttgSB9oQ7kNvwHVLkdi&_nc_oc=Adn6svoHhO3zBXq9DwEPYcj1wQt9Yghpw-dCJNudsbeU-oDSXhxuO_uBpvMBcfuMnSQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvR6_5qMW3uJJBf7v7X33k6AQmeQcUd1KBP99F-bqRyBw&oe=6999944D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5kICloIgWIQ7kNvwHZh0wZ&_nc_oc=Adl_pzk1r8mnRPaQDCx_DW6VIqxeGhmSxS5wYHG6w5A8pHezNU9wIP1b-0eGxOnlhCE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftrirB5VFS-I_pXjIL-9IMaBmTXWOFh5554ZUndrsGwOg&oe=6999A0CF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vUYxkfB5q6MQ7kNvwGC8diM&_nc_oc=AdlUAv4Osfga-eQwqcUB67pY9_2DkcFguZPP7_j8u6gLsIWr7T1jAhsv7GuFT8weiro&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftjzGuIP8cGIwmH4Ff-pSpriX3xNFpXBQOmVmd-XAT4EQ&oe=699998B7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GL_vmCXrbT0Q7kNvwEfxRc2&_nc_oc=AdmgQvxDEQj8VRh62h95n5P9E71YWpkeQYSVfnCwziBc0TB0zjoA-q_Yy8WDrog6jVk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftJSbE2OEm9_DlXn7Xz4U96GB2N2VPFuxbZgEvRM7wSeA&oe=6999AF98"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2o1r3ylY2bIQ7kNvwHBMqtI&_nc_oc=Adkt6mnLz61GX_DEGKffvS3H3KygS5ZpbskIfAKqj_kysvK2WCOWqz3PfCVP8oo-UP0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsqUuAWKb1MKckIfkGQ5tb_XN1eLr4rztn93EmaV1Afyg&oe=6999BA28"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Plank and Kitty", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Party Game", "id": "1700921480735423"}], "release_date": 176601240
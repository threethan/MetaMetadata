=7f20f&oh=00_AQHmRK6H25ytZMwMjrSmIdLRQblcGbAXCy5EbaEcBlR6IA&oe=6A7B152C"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0QnFTHItLkEQ7kNvwFfT30F&_nc_oc=AdqD1kJQuYvmc1fdcmwC11nVJ0SaeXIG5_civNEdRYSOBizzW2OTASkUXFAUGpREebE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGKYpVWdgrWUFLz2slgDcPfKhik-eKHXh-bvyVShIMOfA&oe=6A7B35AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84YSC64FpHcQ7kNvwH7GN9l&_nc_oc=Adr9jJkbHPpN6-iWwS4NhkztanyhG0rho7b8iqF8lPlohUeiagfcb8XyYyZkoIMpPi0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrgxc4AhSd33pJFi-Z9UCjrUCjpUwnTB5cg8rfS3I0rw&oe=6A7B10C1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HAcjE3gNbf8Q7kNvwG47FQM&_nc_oc=Adpg1N-mQ1Ct2gjquOnxFikRo0UwrlQkKxj14zlMiKjgCVW3tBjDHB9EIDWXJ_tsSvE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHrUBFmJdHX08UUk0Itnuar5t0ZfMRO0xn3z3j_T1XmGg&oe=6A7B3D0D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d-YMmRU33F0Q7kNvwG6CR4W&_nc_oc=AdqWF7kLYmTTVbE6xCtfFUqGigIOzcHgqtMeP2mrjDv0dXa_AyG1MGwhamRVAPqnq78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjKNl9qhtK0bfAu3HU6obrC9rRunvcEet6YSr6Iyd5NA&oe=6A7B114F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7HLBMdxJ8rUQ7kNvwEJpT59&_nc_oc=Adq-WgTtj9wnlQgkDGP6TwaN2nQnXNg3UNXnq72Lz2cgRx8cgyAXs1vHIYeramSHZWs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpBwXyl2qRxegCNEDU5WFG9qAvtkLJ46bw3-Td54yf6A&oe=6A7B0937"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xz30rjR0OUYQ7kNvwG240gf&_nc_oc=AdpF1UtSCfGDQZAoOfZt81oaj3BbZSwyOaS4xjHgfZagTTcckYXciBi-TFxcrH1ikM4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENTNmSKU1mYsA-jYMV_0CJp3F0GUeR33n52sYbs7UQew&oe=6A7B2018"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2I3Lh4RohiUQ7kNvwFlx33I&_nc_oc=AdoUXyuoThL5W89-HtL6Z_cVEjMXrolqjwlygEjRJ4IrDW7eh6eGmLkEevqo6JvQX3M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUmjtfZP7IUtKkKUxeeSEZOSX0o4H1bsLyRNhBYDv_dQ&oe=6A7B2AA8"}, "is_concept": false, "is_test"
=7f20f&oh=00_AQA-qrUnFigtcfCIFYOPynlsoXQSpJrdHwA5BrJrYRVFpA&oe=6A5B712C"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6HGcx6BiFAQ7kNvwH14fWi&_nc_oc=AdooMBVBCUJad25VEpzLWySgGP4FWR7vNWoZ19vuZi5HNFZmmbVby4WkhuLgxfRlUek&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAXqzPggqImn62AYWw9LCrp1HwPGRNa7AsBdKk4C3UpmQ&oe=6A5B91AB"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8tZOm7tpTPEQ7kNvwFLfqi7&_nc_oc=AdqImftd3wBnW4qamYdjJWUVRyXskCHv-VrLbkvPxWcaszXdKzzImNLXOutOpoIrCLc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCPHqP8t0wTycBgfQzRAKgvVSfsJwOnunDeXf6wtkHcfg&oe=6A5B6CC1"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RjBPCEAmOdAQ7kNvwE-qh3z&_nc_oc=AdqEjxpc4f53h4I6tGCsuFH1V3NOoIj64iIzwYuQvK9hw958tPvpXeTtsCZTIUHpw0w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9n-u3yJEm6_hQBi4F5IUKMRUYdg0DrQ26nGLDjsVDgw&oe=6A5B60CD"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JzKNVkk2uOUQ7kNvwFpEWTE&_nc_oc=AdrSSz6IQ3G96JQz3pfDb4vFDoKUEOZk4J8w09E1xXhl-vH29yrXBY8bAO39Ellj-SI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBzFa3awEokcKlu0bTlnPA83VwgIQdOZ88fe0GS_g2unw&oe=6A5B6D4F"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0JgYgWjEjUQ7kNvwEqQ0k6&_nc_oc=AdoeCYfMdVTeTi3FKrDUUlcs73x2T7D-MglKS-TKYFVSHsM2JFDejg03BA2haj0pQl4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCbT0u2owentvuety0SJmSWvOcC3OelmLf4vTsSavvuw&oe=6A5B6537"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lsLRZ_wiy08Q7kNvwGWGBlH&_nc_oc=AdruyBnro423I1cpPuZ2zAefCxT4Wka0691vktXKOxplhtG2bJ6SwVE-DiDrAb69wmU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBc0YnCk5mZA55u3GjpG_dZut7ti3adKMqdp14vvtaHuw&oe=6A5B7C18"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k1lJVGaX7wAQ7kNvwGRxY_T&_nc_oc=AdrP5FxDCKMsHvn1yJ7v3cfoLdTD517nALaLnjzwQIPzBfK8xUR_6Z4R5fU3RIyERHw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUV8o_QDTYPRbImbHeB9h4vQ4pBgvoohUVfDdYkNrViQ&oe=6A5B86A8"}, "is_concept": false, "is_test"
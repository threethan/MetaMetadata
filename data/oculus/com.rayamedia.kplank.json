=7f20f&oh=00_AQIEzFZkaiifnw1iv-nOazGTot0mdRLFvsWpnxeuP9oZLA&oe=6AA150AC"}]}, "id": "1532201041192677", "locale": "en_US", "screenshots": [{"file_name": "Trailer 3.png", "id": "753360197073326", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821115_753360200406659_8203486998587215122_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJRq7Ap1_6IQ7kNvwHRpQqC&_nc_oc=AdpnWA2D7s81nj5zxS6WbOOs20PObTUbOwrw3QUrekf0Pi4AV88ZHOH5K3yIty5EDps&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6IHMWBhOKTB2v-2MbMe-CKTKwlikI8truaErDvCgNag&oe=6AA1712B"}, {"file_name": "Trailer 1.png", "id": "887917486907456", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823930_887917490240789_7259065823174688925_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ad0mphfYzJgQ7kNvwEnuZXC&_nc_oc=AdosiP48-RkB6SFpTlsE23mI7Q5kcm9knLGIXCOVWxlMwdQxKEmBj5WFKUYB5J0Wyv4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-_7HK6-7ydhfKOqDKpjuP_BDIvS_9oDth55ga9b0PNA&oe=6AA14C41"}, {"file_name": "Trailer 2.png", "id": "1339585267486548", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821099_1339585270819881_5752003200383625231_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY-JIlxEs4AQ7kNvwFaZV10&_nc_oc=Adq0JSDEYpuU00b2js8cmwCrPNkqHN64ssAh62WZwVVMPcEnYKGEcwjKx9v-vHQr3YY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaErrEd4MlFvWYPwlAN6ipp9cfiH6kWIJ2yCoojZOoyA&oe=6AA1788D"}, {"file_name": "Trailer 4.png", "id": "25299459349722807", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491822307_25299459369722805_1875565800982623569_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJ7Y6VXS1P0Q7kNvwHjsDkS&_nc_oc=Adp-yeX4n5fWyctV55ttQevMPqN78YJzD4hP8_K5pRx0NFhetlRAPq94qCSi8ku9XPA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJbKxno1Eo17O3Vh5HW2bNwAgLObIS9Foxf_mpmQ6SnWw&oe=6AA14CCF"}, {"file_name": "Trailer 5.png", "id": "2038404890292862", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819859_2038404893626195_50283950361106217_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ICs_YX0k5PQQ7kNvwGOtvzO&_nc_oc=AdqGShyGNlJ3Irwpg67fNhW6D4oeWp1bqsY_JT4nx7tQadHL2-FY3Kp9ptb_3BNy2ho&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzQjrtHFs3NGIquazv-5HN-xpw7Don-gqc7nCwGdUNJQ&oe=6AA17CF7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer poster.png", "id": "1340193764070608", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819239_1340193767403941_2787865297931591383_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDVaYnr7pjIQ7kNvwGy8gR3&_nc_oc=Adr-s9A5n5iuMjg56te_g__PvLXZ3sO7mNxTBBspCmzqlD7Xp4NrjJyI1afl3awTWMY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLKCuEyqzUp-mKij5nj72yeHbWiL7UfSsKQHn97wetNjQ&oe=6AA15B98"}, "display_name": "Plank and Kitty", "keywords": [], "long_description": "## Plank and Kitty\n\nGran\u2019s cat has wandered off and ended up at the end of a plank high above the city!\n\nStep through the doorway into a virtual cartoon world, walk the plank, rescue the kitty, and bring it safely back to gran.\n\n**Plank and Kitty is a mixed-reality experience, not a game.**  \nIt\u2019s designed to be fun, approachable, and best enjoyed with friends or family taking turns.  \nEveryone can join in by watching the action on TV or mobile.\n\n---\n\n## What makes it different\n\n- **Two-way mixed-reality portal**  \n  A door in your room opens into a virtual world \u2014 and from the plank, the door becomes a portal back into your real room.\n\n- **Exciting but not extreme**  \n  High enough to feel thrilling, without pushing into fear-only territory. Accessible fun for everybody.\n\n- **Configurable play space**  \n  Preview and adjust the size and position to fit your room before you start.\n\n- **Perfect for group play**  \n  Take turns, watch reactions, and enjoy it together.\n\n- **TV casting support**  \n  Cast to a TV so everyone can see what the player sees.\n\n---\n\n## Device Support\nSupports mixed reality on Quest 2, Quest 3, and Quest Pro.  \nPassthrough quality varies by device.\n\n---\n\n## Comfort Note\nThis experience involves real-world movement.  \nThis is a **room-scale mixed reality experience** and adapts to your available space.  \nMake sure your area is clear before playing.", "short_description": "Gran\u2019s cat has gone missing. Step through the portal, walk the plank high above the city, and bring the kitty home. A fun, approachable mixed-reality experience made for friends, families, and party play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.rayamedia.com/home/plank-n-kitty-privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Rayamedia", "support_website_url": null, "website_url": "https://rayamedia.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25849444964659091"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825415_1750418838960693_443738152598553634_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xG2cnjd84b4Q7kNvwFdsQzB&_nc_oc=Adrim1lVfLIJ7dtFHCuJWlRtm4tE8Kj7C0805IUDtIp9DR8mb2UwsGl2VHBhnUiUJZU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaqmGUplEUeKgpw_tvv_PNHNW3S73NBlNc-HaXhGchuQ&oe=6AA16628"}, "is_concept": false, "is_test"
lfrIQ7kNvwFIw-KC&_nc_oc=AdrzTqVkxyNb17Eipdn03rvR874893bJW-01BiZQapu6t07u-8wYxlpQ390P3PlvZ6c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQRfWot4Cc3ARYH47J6elPl0s_yuXcggvxnH1zVWCYXdg&oe=6B0DAC72"}, {"file_name": "05-karting.png", "id": "1706844837735149", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312068_1706844844401815_1695825184806117837_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-__11Eo8wdAQ7kNvwHWOAbB&_nc_oc=Adp4-xS_kOMuvjHrDSTyHqhDzbbsIXkeJSSL8a-tv75pDK-KKuGaxQgLvxEirrcGK9E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQOwte_Q7Zb8G2520C9ryvhxRl8ZQ0CH8Yqwqs_zEdalA&oe=6B0DC01C"}, {"file_name": "03-golf.png", "id": "1526916449327800", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/806363909_1526916452661133_711772672150954810_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4dSkSlxujRcQ7kNvwG0KZe8&_nc_oc=AdrMO6LVG84GHAuP90cKzANbmOdnu1zMbht4yKzJwrpKDzhhBaVVy2dNodjrrKdtG-A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRQUdMfMuGE3PwrL379nvqnvl3GTmH9eNCtRxahsCEURQ&oe=6B0DC4B5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Sports Center", "keywords": ["pingpong", "golf", "tennis", "volleyball", "karting"], "long_description": "EARLY ACCESS\nVR Sports Center is a playable sports collection in active development. Controls, animation, visuals and balance may change as the experience is refined. A full-release date has not been announced.\n\nSIX WAYS TO PLAY\nMeet your sport hosts in a seaside clubhouse, then try shooting, table tennis, golf, tennis, adapted beach volleyball and kart racing.\n\nShooting includes target practice and two-player LAN duels on the same reachable local network. There are no public lobbies, Internet matchmaking or online multiplayer for the other sports.\n\nTable tennis and tennis offer local AI play. Golf focuses on local short-course play. Beach volleyball uses adapted single-player rules. Karting includes local AI races, drifting and optional one-hand steering.\n\nMOVEMENT AND COMFORT\nChoose your main hand and follow the in-game introductions. Swinging sports need clear real-world space. Kart racing supports seated play and continuous vehicle movement. Keep the platform safety boundary enabled.\n\nWHAT WE ARE IMPROVING\nFurther work focuses on controller feel, character motion, sports balance, UI readability and Quest performance. Features and tuning may change during Early Access. Online matchmaking is planned for a future update and is not available in this build. Release timing will be announced later.\n\nIn-app text is English. No in-app account is required.", "short_description": "Six VR sports in a seaside club: local AI play, kart racing and two-player LAN shooting."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.xmaillc.com/vr-sports-center-privacy.html", "developer_terms_of_service_url": null, "publisher_name": "XM LLC", "support_website_url": "https://www.xmaillc.com/#contact", "website_url": "https://www.xmaillc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "1423946237464386"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673573223_1398150885807438_5499098185034835255_n.
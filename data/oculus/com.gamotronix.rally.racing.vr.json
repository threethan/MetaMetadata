i_w6Q&oe=699855CA"}, {"file_name": "RR_v2_SS4.png", "id": "1170881771700118", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620444_1170881775033451_2871286342883947345_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qXDY6bETbowQ7kNvwGk4M52&_nc_oc=Adl3AGVdx-0oV1BGtMwu90h934aCtc7ymVoPunkb0NBbvY0mdCbD5cnS-BvBmpinuTQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv70-qt6TZ-PyLq8m7sZ7uR-jdnCAgI84mQtch2xU5Hrg&oe=69985922"}, {"file_name": "RR_v2_SS5.png", "id": "1376246060403517", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618103_1376246067070183_6834252983592982495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oepUr-Z9RIQ7kNvwEmdHlL&_nc_oc=Adkjw4MYsMaxvF2NSnr__yuABBxJGFUI64F6c9Y1yYjPNRKU_wMRVF0PMr1QYQDpxzk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afv11io9Q4YIR6bOIQuLwZbepNJuMl3guL1zJYXRrhR0tQ&oe=6998702F"}, {"file_name": "RR_v2_SS1.png", "id": "25606214392353775", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618252_25606214399020441_5587921185795553233_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iBj2hT0OMZoQ7kNvwFbT2Oe&_nc_oc=AdmWe1x9nzg4rpzYdtxZsvFXDTRcN_5TCfCxOJuW_MuSYyIqd3Eyad2K3sx5VqMBLIM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_Afu_XcrUdWsbmV8o4NcmbmYh5GxPmsmMzn_7glTfsQcH_w&oe=69986A80"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rally Racing VR: Xtreme Speed Challenge", "keywords": ["Racing", "Speed", "Rally", "Offroad", "Dirt"], "long_description": "Rally Racing VR: Xtreme Speed Challenge delivers an intense rally racing experience built for VR. The game\u2019s standout feature is its intuitive VR car controller, allowing natural steering & smooth handling that responds instantly to your movements. This realistic control system gives you strong sense of speed & true rally immersion\n\nRealistic Car Physics & Interior\n\nAuthentic rally physics bring believable vehicle reactions on dirt, gravel, & rugged terrain. The detailed interior, stylish steering wheel, & digital speedometer enhance the feeling of acceleration and control.\n\nBeautiful & Dynamic Environments\n\nRace through long, visually rich environments including forests, offroad, & mountains. Each track supports day & night driving & multiple weather conditions, offering variety, atmosphere, & a deeper sense of adventure. Cheering crowds react as you race, adding energy to every stage\n\nExotic & Customizable Cars\n\nChoose from multiple exotic cars, each with unique performance & visuals. Customize your vehicles with textures, & skins to create your own racing style. Every car feels distinct in both handling & appearance\n\nRally Challenges & High-Speed Action\n\nCompete through checkpoints, technical rally routes, and rugged offroad paths. When you need a burst of speed, activate Nitro Boost to power through straightaways & gain an edge in intense moments\n\nStart the engine, feel the control in your hands, & experience rally racing the way it\u2019s meant to be fast, immersive, & real.\n", "short_description": "Rally Racing VR: Xtreme Speed Challenge delivers immersive speed with a highly responsive VR car controller that makes every turn feel natural & precise. Race through long, detailed environments across forests, mountains, & canyon routes, each enhanced with day night lighting & dynamic weather. Experience realistic interiors, a digital speedometer, & smooth car handling that reacts authentically to terrain. Choose from customizable cars & enjoy fast offroad racing built for true VR immersion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category"
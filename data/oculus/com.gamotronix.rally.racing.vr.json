dn.com/v/t64.5771-25/499623295_1409034497374614_3901619388927675846_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOF2eIXJEwEQ7kNvwFBof6Y&_nc_oc=AdrX2DviSKUYF_gt5pqlAynO3fbCiHnwn8YCDr-QjWxNHV7S9cTJJCEPyLs0px7MAS0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2dBd58llRYv90V1h_w1TdhHq-NJAOFsQiFba47Mntusg&oe=69F20396"}, {"file_name": "RR_SS1.png", "id": "2117703635303917", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619680_2117703638637250_3557021797978100968_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxvKQ45_5eIQ7kNvwGC57UJ&_nc_oc=AdpgmpzxndcuNv_zYLhhaz66cpB-Aj5ZdWbDw348AxkUi4mh_O7Ukqp9gX1b3ijte9I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1jmq3ikrhaj1a65MdHzf1BV0SgOwY1ugMr9TfP0wgs6w&oe=69F1F3E4"}, {"file_name": "RR_SS3.png", "id": "701828006138072", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619098_701828009471405_3983015494867276998_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fv5_uwcXnW0Q7kNvwH-9uJN&_nc_oc=Ado5mJqQ7NnSpLZ2Kyx0eFc92vZ1ikAZ0jvTfaklb9-Jf_Ld54yJ4CJBY6xu6BKLAzk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2gW1WN2qgpHGK257L0fz9J_kbOZJjA-SqIQ15WDWB29w&oe=69F1E816"}, {"file_name": "RR_SS5.png", "id": "1403227184847958", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/595112037_1403227188181291_7607558910343929469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kswZshQd04gQ7kNvwFAwVxQ&_nc_oc=Adoz8JaBRr3-Zlzjsmt_HyclgWa1FSA0ruWaXpLRAf22qMksPs-Xli3Px7oVHl6y_HY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1_uNEs3Qn_8mxRzLusZhG6lX1tEkMUivEAtvRv9EeWZg&oe=69F1F570"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rally Racing VR: Xtreme Speed Challenge", "keywords": ["Racing", "Speed", "Rally", "Offroad", "Dirt"], "long_description": "Rally Racing VR: Xtreme Speed Challenge delivers an intense rally racing experience built for VR. The game\u2019s standout feature is its intuitive VR car controller, allowing natural steering & smooth handling that responds instantly to your movements. This realistic control system gives you strong sense of speed & true rally immersion\n\nRealistic Car Physics & Interior\n\nAuthentic rally physics bring believable vehicle reactions on dirt, gravel, & rugged terrain. The detailed interior, stylish steering wheel, & digital speedometer enhance the feeling of acceleration and control.\n\nBeautiful & Dynamic Environments\n\nRace through long, visually rich environments including forests, offroad, & mountains. Each track supports day & night driving & multiple weather conditions, offering variety, atmosphere, & a deeper sense of adventure. Cheering crowds react as you race, adding energy to every stage\n\nExotic & Customizable Cars\n\nChoose from multiple exotic cars, each with unique performance & visuals. Customize your vehicles with textures, & skins to create your own racing style. Every car feels distinct in both handling & appearance\n\nRally Challenges & High-Speed Action\n\nCompete through checkpoints, technical rally routes, and rugged offroad paths. When you need a burst of speed, activate Nitro Boost to power through straightaways & gain an edge in intense moments\n\nStart the engine, feel the control in your hands, & experience rally racing the way it\u2019s meant to be fast, immersive, & real.\n", "short_description": "Rally Racing VR: Xtreme Speed Challenge delivers immersive speed with a highly responsive VR car controller that makes every turn feel natural & precise. Race through long, detailed environments across forests, mountains, & canyon routes, each enhanced with day night lighting & dynamic weather. Experience realistic interiors, a digital speedometer, & smooth car handling that reacts authentically to terrain. Choose from customizable cars & enjoy fast offroad racing built for true VR immersion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_ser
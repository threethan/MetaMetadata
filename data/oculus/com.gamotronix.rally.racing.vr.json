oc=AdkRecT9MAPWl0Sehosau0NwssJLtq9r0lghYp8_UIzDHmwpD0_IWY5MR898KGtV54Y&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwxCZHb7T9kFfNUcb7VMXePHT_oTiGQP3RnUlQMRtShXQ&oe=69B2ABE4"}, {"file_name": "RR_SS3.png", "id": "701828006138072", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619098_701828009471405_3983015494867276998_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7Pi9uK9ymQQ7kNvwH1tYYJ&_nc_oc=Adkg_z0jyotYLpXrNpywbOb8OhXuaClmK2M2ARjIuJkKVpEqKx_knykfFYhsJu-WOXc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzukvGkC-k4wF1lnmEm6SrNdSeB8H0ivEUuVpjHOAN04Q&oe=69B2A016"}, {"file_name": "RR_SS5.png", "id": "1403227184847958", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/595112037_1403227188181291_7607558910343929469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOzOkfhjbCYQ7kNvwFHj7BP&_nc_oc=Adl9EWEJfRTFF_6rh438uEjbYH56AtQ8Q_o8446OR5EMpVhgE6V-uii9CB5DbbyEkpc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyPFEiEXEB73joZLfPBpsxaTQMWpwJU0qJ_QI7RecUo0Q&oe=69B2AD70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rally Racing VR: Xtreme Speed Challenge", "keywords": ["Racing", "Speed", "Rally", "Offroad", "Dirt"], "long_description": "Rally Racing VR: Xtreme Speed Challenge delivers an intense rally racing experience built for VR. The game\u2019s standout feature is its intuitive VR car controller, allowing natural steering & smooth handling that responds instantly to your movements. This realistic control system gives you strong sense of speed & true rally immersion\n\nRealistic Car Physics & Interior\n\nAuthentic rally physics bring believable vehicle reactions on dirt, gravel, & rugged terrain. The detailed interior, stylish steering wheel, & digital speedometer enhance the feeling of acceleration and control.\n\nBeautiful & Dynamic Environments\n\nRace through long, visually rich environments including forests, offroad, & mountains. Each track supports day & night driving & multiple weather conditions, offering variety, atmosphere, & a deeper sense of adventure. Cheering crowds react as you race, adding energy to every stage\n\nExotic & Customizable Cars\n\nChoose from multiple exotic cars, each with unique performance & visuals. Customize your vehicles with textures, & skins to create your own racing style. Every car feels distinct in both handling & appearance\n\nRally Challenges & High-Speed Action\n\nCompete through checkpoints, technical rally routes, and rugged offroad paths. When you need a burst of speed, activate Nitro Boost to power through straightaways & gain an edge in intense moments\n\nStart the engine, feel the control in your hands, & experience rally racing the way it\u2019s meant to be fast, immersive, & real.\n", "short_description": "Rally Racing VR: Xtreme Speed Challenge delivers immersive speed with a highly responsive VR car controller that makes every turn feel natural & precise. Race through long, detailed environments across forests, mountains, & canyon routes, each enhanced with day night lighting & dynamic weather. Experience realistic interiors, a digital speedometer, & smooth car handling that reacts authentically to terrain. Choose from customizable cars & enjoy fast offroad racing built for true VR immersion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_ar
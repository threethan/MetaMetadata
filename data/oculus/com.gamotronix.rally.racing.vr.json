3.oculuscdn.com&_nc_ss=8&oh=00_Afwg6qRdPQLdZtzhZJw4zTcvqNqZtt8jgiIP1uSSDrftyg&oe=69BBEE4A"}, {"file_name": "RR_v2_SS4.png", "id": "1170881771700118", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499620444_1170881775033451_2871286342883947345_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h3IXSxi0OvkQ7kNvwGXoWb9&_nc_oc=AdlzebU6vci-N-fvni7q0gZf0Pf73b5SDdL4krL-vvpjKFEv4T0PuN8kDfE5Ns1Oz1M&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyWeo6szbkcd9RLCPGKIM0aCJQwFOUJKjxfEnHhWpkPUg&oe=69BBF1A2"}, {"file_name": "RR_v2_SS5.png", "id": "1376246060403517", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618103_1376246067070183_6834252983592982495_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5xC7_D2tNzYQ7kNvwHVOrJl&_nc_oc=AdkXYXttMq5XUqgmFeEw314hcLLN1R7BCScAHm4POH5CKZT8spzuPGZ1py1amLYa-80&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afxt4MKE0kXDXJWKAuUN9bR1eMAmnxuCbnsByxKCGpAZWQ&oe=69BC08AF"}, {"file_name": "RR_v2_SS1.png", "id": "25606214392353775", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618252_25606214399020441_5587921185795553233_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eBCeqmUfTYQ7kNvwECZPkM&_nc_oc=AdltnQPwSSnzuxEr19HRRx72t4TcnA88jCKudphaqBxXVSHoBJebTt6MWEu6gMXVy3Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzpYW6EWAKnwOQsXTt1mEcWrMRlJea6-1GyyYuF7-oTEA&oe=69BC0300"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rally Racing VR: Xtreme Speed Challenge", "keywords": ["Racing", "Speed", "Rally", "Offroad", "Dirt"], "long_description": "Rally Racing VR: Xtreme Speed Challenge delivers an intense rally racing experience built for VR. The game\u2019s standout feature is its intuitive VR car controller, allowing natural steering & smooth handling that responds instantly to your movements. This realistic control system gives you strong sense of speed & true rally immersion\n\nRealistic Car Physics & Interior\n\nAuthentic rally physics bring believable vehicle reactions on dirt, gravel, & rugged terrain. The detailed interior, stylish steering wheel, & digital speedometer enhance the feeling of acceleration and control.\n\nBeautiful & Dynamic Environments\n\nRace through long, visually rich environments including forests, offroad, & mountains. Each track supports day & night driving & multiple weather conditions, offering variety, atmosphere, & a deeper sense of adventure. Cheering crowds react as you race, adding energy to every stage\n\nExotic & Customizable Cars\n\nChoose from multiple exotic cars, each with unique performance & visuals. Customize your vehicles with textures, & skins to create your own racing style. Every car feels distinct in both handling & appearance\n\nRally Challenges & High-Speed Action\n\nCompete through checkpoints, technical rally routes, and rugged offroad paths. When you need a burst of speed, activate Nitro Boost to power through straightaways & gain an edge in intense moments\n\nStart the engine, feel the control in your hands, & experience rally racing the way it\u2019s meant to be fast, immersive, & real.\n", "short_description": "Rally Racing VR: Xtreme Speed Challenge delivers immersive speed with a highly responsive VR car controller that makes every turn feel natural & precise. Race through long, detailed environments across forests, mountains, & canyon routes, each enhanced with day night lighting & dynamic weather. Experience realistic interiors, a digital speedometer, & smooth car handling that reacts authentically to terrain. Choose from customizable cars & enjoy fast offroad racing built for true VR immersion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTAB
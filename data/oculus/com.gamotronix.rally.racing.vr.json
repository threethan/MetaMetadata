4"}, {"file_name": "RR_SS3.png", "id": "701828006138072", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619098_701828009471405_3983015494867276998_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O4Em653oV0wQ7kNvwHmB-ei&_nc_oc=AdnP6p7zFlyN4EJwgycVKPcr2XdTIO5E5u320Y0czRLMltcJ121-j2m-Q_8q8eakHNw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuV1t48p6hNDHtRSgwAfEFCPOo0vWCkEa_tdWZ056lwjQ&oe=69A2CE16"}, {"file_name": "RR_SS5.png", "id": "1403227184847958", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595112037_1403227188181291_7607558910343929469_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyB1qF58hwUQ7kNvwGXwbFJ&_nc_oc=AdljL_RpdcBbFql1dO6fj2yZd3fjgHwAg_OHMZ1urlSDGrxa0e0CxXIcDC3qeRJL_MY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afte7R3AU4H8LmjJnE3RTTD6XxP0OhSpinxIh5MoeGH-bg&oe=69A2DB70"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Rally Racing VR: Xtreme Speed Challenge", "keywords": ["Racing", "Speed", "Rally", "Offroad", "Dirt"], "long_description": "Rally Racing VR: Xtreme Speed Challenge delivers an intense rally racing experience built for VR. The game\u2019s standout feature is its intuitive VR car controller, allowing natural steering & smooth handling that responds instantly to your movements. This realistic control system gives you strong sense of speed & true rally immersion\n\nRealistic Car Physics & Interior\n\nAuthentic rally physics bring believable vehicle reactions on dirt, gravel, & rugged terrain. The detailed interior, stylish steering wheel, & digital speedometer enhance the feeling of acceleration and control.\n\nBeautiful & Dynamic Environments\n\nRace through long, visually rich environments including forests, offroad, & mountains. Each track supports day & night driving & multiple weather conditions, offering variety, atmosphere, & a deeper sense of adventure. Cheering crowds react as you race, adding energy to every stage\n\nExotic & Customizable Cars\n\nChoose from multiple exotic cars, each with unique performance & visuals. Customize your vehicles with textures, & skins to create your own racing style. Every car feels distinct in both handling & appearance\n\nRally Challenges & High-Speed Action\n\nCompete through checkpoints, technical rally routes, and rugged offroad paths. When you need a burst of speed, activate Nitro Boost to power through straightaways & gain an edge in intense moments\n\nStart the engine, feel the control in your hands, & experience rally racing the way it\u2019s meant to be fast, immersive, & real.\n", "short_description": "Rally Racing VR: Xtreme Speed Challenge delivers immersive speed with a highly responsive VR car controller that makes every turn feel natural & precise. Race through long, detailed environments across forests, mountains, & canyon routes, each enhanced with day night lighting & dynamic weather. Experience realistic interiors, a digital speedometer, & smooth car handling that reacts authentically to terrain. Choose from customizable cars & enjoy fast offroad racing built for true VR immersion."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamotronixstudio/privacypolicy-meta", "developer_terms_of_service_url": null, "publisher_name": "Gamotronix Studio", "support_website_url": null, "website_url": "https://sites.google.com/view/gamotronixstudio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_p
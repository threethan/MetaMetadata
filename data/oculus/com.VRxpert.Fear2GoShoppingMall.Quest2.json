9fb7733fb7a0443c1a5.png", "id": "946349897684758", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391998_946349901018091_7204130139656221000_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UvJSLbPp0CgQ7kNvwGLFUqC&_nc_oc=Adoq3-cnLfzffyq-sIX4Tq1vv29INEvZVLGvSgtLvMGAZQPCWcjB0h1BNXGbwxk8ox8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Nd2FssiP611uG91dGC5BBQ31o4Il7NfJm4sn_Czxs-g&oe=6A2AD2EF"}, {"file_name": "18a1d8f71aa72e8956708960e6795ab5.png", "id": "941803778109005", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473391959_941803784775671_7030730485700273547_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Js7AmO0Z0T8Q7kNvwEsR1Je&_nc_oc=AdpkoTJGcJvKQLntS19tB3Qyha131znKZuyBCtAtAK1VzF1gZwIc34fqTfq2Q76XpH4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-MTEAzwUK62ZC1VksOQxSAvtEMVr4ZGWMF0OBDHEzJDw&oe=6A2AAF9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRferapy Home - Fear2GoShoppingMall", "keywords": [], "long_description": "This is not a game! Fear2GoShoppingMall (F2GSM) helps people with Agoraphobia and improve their mental health issues related to fear of people in shopping mall. F2GSM includes different standing location in the mall, number of people around, close to user and eye contacts.\nFree download users can try for 14 days but are limited to 12 preset training combinations of fear factors (standing location, number of people, close to user and eye contact). If you successfully register on the VRferapyHome portal website, you can go to [Renew License Page] to gain full-featured trial access for 7 days.\nRegistered and subscribed users can answer a few scare factor questions to create customize training routes with different scare factor combinations and review their own training records.\nThe training records allows subscribers to upload their records from app and use the referral expert code to share records with recommended experts for research and advice. Subscription registration is available via in-app purchase.", "short_description": "This is not a game! Fear2GoShoppingMall (F2GSM) helps people with Agoraphobia and improve their mental health issues related to fear of people in shopping mall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrferapy-home.vrxpert.com.hk/vrfh_vr_app_privacy", "developer_terms_of_service_url": "https://vrferapy-home.vrxpert.com.hk/serviceterms", "publisher_name": "VRxpert Limited", "support_website_url": null, "website_url": "https://vrxpert.com.hk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9420480794665414"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9730846886962135", "version": "1.1.1"}, "id": "1313969086165583", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "6382553251791532", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "9730846886962135"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"cha
ibed users can answer a few scare factor questions to create customize training routes with different scare factor combinations and review their own training records.\nThe training records allows subscribers to upload their records from app and use the referral expert code to share records with recommended experts for research and advice. Subscription registration is available via in-app purchase.", "short_description": "This is not a game! Fear2GoShoppingMall (F2GSM) helps people with Agoraphobia and improve their mental health issues related to fear of people in shopping mall."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrferapy-home.vrxpert.com.hk/vrfh_vr_app_privacy", "developer_terms_of_service_url": "https://vrferapy-home.vrxpert.com.hk/serviceterms", "publisher_name": "VRxpert Limited", "support_website_url": null, "website_url": "https://vrxpert.com.hk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_HK"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9420480794665414"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1107671604491906"}]}, "baseline_offer": {"id": "1107671604491906"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741053960, "status": "PUBLISHED", "id": "1107671604491906"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id":
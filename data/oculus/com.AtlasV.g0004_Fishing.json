-Mtfhd6A&oe=6AF5E16D"}, {"file_name": "Still 5.png", "id": "1794099367951036", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823746_1794099371284369_1080468047041667314_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-dHVhOTk9VoQ7kNvwHqQWYo&_nc_oc=Ado4Rc7Wl3vz9OcjuUeUWG_sI_Adake3uGJoDjsn1v5Te12fBfaRmqcEAXUI6cvENk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3CTVjt30b3pxa3Z3Me4Wg5zqSriunbiRfeAgs5EH_rA&oe=6AF5C221"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bear on Boat", "keywords": ["bear", "fishing", "cosy", "fun"], "long_description": "# Bear on Boat is exactly what it sounds like.\n\nYou are a **bear**.\nYou are on a **boat**.\nYou are **fishing**.\n\nFlee your responsibilities and cast your line, catch fish (and some other weird things), and look upon the fact that you are, undeniably, a **bear on a boat**.\n \n# GOTTA CATCH 'EM ALL\n\nUnlock new photos on your fishbook by catching all 32 fishes (well, it's actually not the fishes)!", "short_description": "YOU ARE  A BEAR\nFISHING\nON A BOAT\n\nFish, collect money, fish again, fill your fishbook!\n\nAnd also, you are a bear. On a boat. Fishing.\n\nAs a bear.\n\nOn a boat. "}]}, "developer_name": "AtLab 5", "developer_privacy_policy_url": "https://docs.google.com/document/d/1Fytl0swxy6da5xpKcanWhUPEVXLOTOGbOkr8VqZ2iqI/edit?tab=t.0#heading=h.pnoxman458tt", "developer_terms_of_service_url": null, "publisher_name": "AtLab 5", "support_website_url": null, "website_url": "https://www.arianestudios.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "rec
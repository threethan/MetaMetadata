_name": "migrated_image.png", "id": "2366227953667457", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12448837_803822429776617_6076750254160478208_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uk1uK0ia5uQQ7kNvwHdE8yH&_nc_oc=AdknTHN5v9Bt-hGTEJCv3567AiP3nLEm2SnEoKhMNFBjdBEhapw9twrdZFYy4hVolf8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxM-Gc_PYtNa6bKtxOE3PSSxcT3tSCCXgwcQ3vdDxRyBA&oe=69B16D6A"}, {"file_name": "migrated_image.png", "id": "511196109790770", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12727760_195834887580725_2697176407473127424_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUkmnDajua0Q7kNvwGWPqNn&_nc_oc=AdkoCMNzZrQtTQEiZ_atbW7tq3dDc8sYZwwmwSeR2GISE2y2Thc3ieOvAnY0cuilTW4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw5chtVD35jzXHDvDa8mU1rc3Z-jlz-5a38pM60X0Th8w&oe=69B16293"}, {"file_name": "migrated_image.png", "id": "254517672225138", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12448979_659707690887880_286033856862093312_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyUdSSsmKFcQ7kNvwGUGZRQ&_nc_oc=Adn3NfdGaZ2q0O_kIqck6KIq9ZPrdovkrndD-QKtpFnOjaAPvRowRX8sa7UouVg99Vk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afxq0LaxSlyujS3x-umfGla2tub34b3POHFFYtv1uimx_Q&oe=69B15BAC"}, {"file_name": "migrated_image.png", "id": "200859647811354", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12727894_1348940635141145_8612709072698867712_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrAHwwK8NSAQ7kNvwGgUBVf&_nc_oc=AdmeWxeyGLOCRCWlp7p44Z_2LSW1Jpyc57wMWzekzlLKaugzoYe4iNVfgUKGXtGCHmo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6K6lAjo08lyMC1sFea7KI-18_n5TU0wnxKwEO6jlsVQ&oe=69B17587"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\ud1a0\ud06c\ub9ac\uc2dc \uccb4\ud5d8\ud310", "keywords": ["Talklish", "TalklishVR", "talklishvr", "talklishVR", "\ud1a0\ud06c\ub9ac\uc2dc"], "long_description": "\u25b6 \ub274\uc695\uc5d0\uc11c 1\ub144 \uc0b4\uae30 \ud504\ub85c\uc81d\ud2b8\n\u25b6 \uac8c\uc784\uc73c\ub85c \uc7ac\ubbf8\uc788\uac8c \uc775\ud788\ub294 \uc0b4\uc544\uc788\ub294 \uc601\uc5b4\ud68c\ud654\n\u25b6 \uc138\uacc4\ucd5c\uace0\uc758 \uc74c\uc131\uc778\uc2dd \uae30\uc220\ub85c \uc601\uc5b4\ubc1c\uc74c\uc744 \uccb4\ud06c\ud569\ub2c8\ub2e4\n\u25b6 \uacbd\uc774\ub85c\uc6b4 \uc644\ub3c5\ub960 40% \ub2ec\uc131!! \u2013 \ud1a0\ud06c\ub9ac\uc2dc\ub97c \uacbd\ud5d8\ud558\uc2e0 5\uba85 \uc911 2\uba85\uc740 \ub05d\uae4c\uc9c0 \uc644\ub8cc!\n\u25b6 \uad50\uc721\uc758 \uba54\uce74! EBS \uc601\uc5b4\uc644\uc804\uc815\ubcf5 \uacf5\uc2dd \ud559\uc2b5 \ud504\ub85c\uadf8\ub7a8\n\u25b6 \uc0bc\uc131 \uba40\ud2f0\ucea0\ud37c\uc2a4\uac00 \uacf5\uc778\ud55c OPIc \uacf5\uc2dd \ud559\uc2b5 \ud504\ub85c\uadf8\ub7a8 \n\n\n\ud1a0\ud06c\ub9ac\uc2dc \ub274\uc695\uc2a4\ud1a0\ub9ac\ub294 \ubbf8\uad6d \uc720\ud559 \uc911 \ubc1c\uc0dd\ud560 \uc218 \uc788\ub294 \ud544\uc218 \uc0c1\ud669 240\uac1c\uc640 \uc774\ub54c \uc0ac\uc6a9\ud560 \uc218 \uc788\ub294 \ud544\uc218\ud45c\ud604 4,000\uac1c\ub97c \uc7ac\ubbf8\uc788\ub294 \uc2a4\ud1a0\ub9ac\uc5d0 \ub2f4\uc558\uc73c\uba70, \ud575\uc2ec\ud328\ud134\uacfc \ubb38\uc7a5\uc744 \uc74c\uc131\uc778\uc2dd\uc744 \ud1b5\ud574 \uc624\ub85c\uc9c0 \uc601\uc5b4 \ub9d0\ud558\uae30\ub85c \ud559\uc2b5\ud558\uace0 \uccb4\ud5d8\ud558\ub294 \uac8c\uc784\ud615 \ud559\uc2b5 \uc11c\ube44\uc2a4\uc785\ub2c8\ub2e4.\n\n\uc601\uc5b4 \ubc1c\uc74c\uc744 \uc815\ud655\ud788 \uccb4\ud06c\ud574\uc904 \uc138\uacc4 \ucd5c\uace0\uc758 \uc74c\uc131\uc778\uc2dd \uae30\uc220\uacfc 32\uba85\uc758 \uc0dd\uc0dd\ud55c \uc6d0\uc5b4\ubbfc \ub0b4\ub808\uc774\uc158\uc758 \uacb0\ud569\uc73c\ub85c \uc2e4\uc81c \uc678\uad6d\uc778\uacfc \uc774\uc57c\uae30\ub97c \ub098\ub204\ub4ef \uae34\uc7a5\uac10 \ub118\uce58\ub294 \ub300\ud654\ub97c \uacbd\ud5d8\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ud68c\ud654\uc2e4\ub825\uc744 \ud5a5\uc0c1\uc2dc\ud0a4\ub824\uba74 \ub9e4\uc77c\ub9e4\uc77c \uafb8\uc900\ud788 \ud558\ub294 \uac83\uc774 \uc911\uc694\ud569\ub2c8\ub2e4!\n\ud1a0\ud06c\ub9ac\uc2dc\ub294 \uac8c\uc784 \uc694\uc18c\uac00 \uac00\ubbf8\ub418\uc5b4 \ud559\uc2b5\uc790\uac00 \uafb8\uc900\ud788 \uc601\uc5b4\ud68c\ud654\ub97c \ud559\uc2b5\ud560 \uc218 \uc788\ub294 \ucda9\ubd84\ud55c \ud658\uacbd\uc744 \uc81c\uacf5\ud558\uba70, \uacbd\ud5d8\ud558\uc2e0 5\uba85 \uc911 2\uba85\uc740 \ub05d\uae4c\uc9c0 \uc644\ub8cc\ud558\uace0 \uc788\uc2b5\ub2c8\ub2e4.\n\n\n\u25c6\t\uc8fc\uc694 \ud2b9\uc9d5\n\n1. \uc74c\uc131\uc778\uc2dd\n\ube60\ub974\uace0 \uc815\ud655\ud55c \uc778\uc2dd\uc740 \ubb3c\ub860 \uc0ac\uc6a9\uc790\uc758 \ubc1c\uc74c\uc744 \uc815\ud655\ud788 \ubd84\uc11d\ud574 \uc778\uc2dd\ud558\uae30 \ub54c\ubb38\uc5d0 \ubc1c\uc74c \uac1c\uc120 \ud6a8\uacfc\ub3c4 \uae30\ub300\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n2. Challenge System\n\ub2e8\uc5b4\uc640 \ubb38\uc7a5\uc744 \uc554\uae30\ud558\uae30 \uc704\ud574 \uc9c0\ub8e8\ud55c \ubc18\ubcf5\uc744 \ud558\uace0 \uacc4\uc2ed\ub2c8\uae4c? Challenge System\uc740 \ud034\uc988\ub97c \ud480 \ub4ef \ub2e8\uacc4\ubcc4 \ud78c\ud2b8\ub85c \uc815\ub2f5\uc744 \uc720\ucd94\ud574 \uc9c1\uc811 \ubc1c\uc74c\ud558\ub3c4\ub85d \ud569\ub2c8\ub2e4. \uc774\ub7ec\ud55c \ud559\uc2b5 \ubc29\uc2dd\uc740 \uc7ac\ubbf8\uc788\uac8c \uc554\uae30\ud560 \uc218 \uc788\uc744 \ubfd0 \uc544\ub2c8\ub77c \ud655\uc2e4\ud558\uac8c \uc554\uae30\ud560 \uc218 \uc788\ub3c4\ub85d \ud569\ub2c8\ub2e4.\n\n\ud1a0\ud06c\ub9ac\uc2dc\ub97c \ud1b5\ud574 \uc2e4\uc81c \ub274\uc695\uc5d0\uc11c 1\ub144\uac04 \uc0dd\ud65c\ud558\uba70 \ub2e4\uc591\ud55c \ub274\uc695 \uce5c\uad6c\ub4e4\uc744 \ub9cc\ub098\ubcf4\uc138\uc694.\n\uc124\ub818 \uac00\ub4dd\ud55c \uccb4\ud5d8\uc744 \ud1b5\ud574 \uc601\uc5b4\ud68c\ud654 \ud559\uc2b5\uc774 \ub354\uc6b1 \uc990\uac70\uc6cc\uc9d1\ub2c8\ub2e4.\n\n", "short_description": "\ud1a0\ud06c\ub9ac\uc2dc \uccb4\ud5d8\ud310"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.talklish.com/", "developer_terms_of_service_url": "https://www.talklish.com/",
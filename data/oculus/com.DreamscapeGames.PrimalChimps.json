dn.com&_nc_ss=8&oh=00_Afw8KopUp24_kttG2Bz8DGHnaA98Uqaw0hntXNY--nSf8g&oe=69BEABF0"}, {"file_name": "Coco Taggers - 2025-06-23T220444.595.png", "id": "1250385746717441", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820561_1250385750050774_4939484651823554338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Phj9VSFy5l4Q7kNvwEph4QK&_nc_oc=AdktEMGHiMDdwFXnKXMO4xp-rEZUA6r4h7bLZVyU2z8fjFMhN0jJTrn2RtuXezItqK0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyY-3WnbNQj7Dv4PxeGqAWivgf3iVJ7NyLU8Hd3EeCitQ&oe=69BEA2BF"}, {"file_name": "Coco Taggers - 2025-06-23T220620.160.png", "id": "2248438025573944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819473_2248438028907277_1813521934436243583_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WaoN7gEJh28Q7kNvwEHv5pE&_nc_oc=Adninz3dz85uZhFCa1aU_GYqsaVYLlAEAAxy9WyvhUhE4HBNWWb4E_j6muRDW3krUwk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYQBl1nFEylyaqu2B2XiviuSnex0-ArbdA4DV2dZQt_Q&oe=69BE7E6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Chimps", "keywords": ["Spooky", "Scary", "Chimps", "Ape", "Baboon"], "long_description": "Spooky Chimps is a chaotic and terrifying VR multiplayer horror game where players take on the roles of genetically enhanced chimps trapped in a haunted research facility deep in the jungle. As the lights flicker and strange noises echo through the abandoned corridors, players must work together\u2014or betray each other\u2014to survive the nightmarish experiments lurking in the dark. With motion-tracked climbing, screech-based communication, and unpredictable ghost events, *Spooky Chimps* delivers a frantic blend of comedy and terror. Every round offers a new layout, randomized scares, and the constant tension of never knowing whether the next sound is friend, foe\u2026 or something much worse.", "short_description": "A gorilla tag-based horror game to play with your friends and have fun!"}]}, "developer_name
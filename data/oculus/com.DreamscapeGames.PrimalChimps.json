dghcnS8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGeg5wpYstceP6uDLYyFOb04swdQlkZFRgTuzsEjEaPw&oe=6A8EC0B0"}, {"file_name": "Coco Taggers - 2025-06-23T220444.595.png", "id": "1250385746717441", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820561_1250385750050774_4939484651823554338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vliCFCqYomMQ7kNvwGSGoNz&_nc_oc=AdprocuHYrxwt1V8r38hn-s1KglkNGbrmuZJQSvf1ZQKginhOb9CEXXh3zLWEH9aI_A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXqcNCVQYPpTOxiHDQIpZIUENpmpvGuHctfuEQWHuSTA&oe=6A8EEFBF"}, {"file_name": "Coco Taggers - 2025-06-23T220620.160.png", "id": "2248438025573944", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819473_2248438028907277_1813521934436243583_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJSROGVDDigQ7kNvwFeVMC-&_nc_oc=AdpaRXTFURPHeqaihG8OY9L3EaPO620Uu5n-nfio9ucN5jqAB58a7dsqrdqI7WGJI3c&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnH3VVCMghFS_v_J7VQIGFr79n2C3BakPeXV4kvYtOmw&oe=6A8ECB6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Chimps", "keywords": ["Spooky", "Scary", "Chimps", "Ape", "Baboon"], "long_description": "Spooky Chimps is a chaotic and terrifying VR multiplayer horror game where players take on the roles of genetically enhanced chimps trapped in a haunted research facility deep in the jungle. As the lights flicker and strange noises echo through the abandoned corridors, players must work together\u2014or betray each other\u2014to survive the nightmarish experiments lurking in the dark. With motion-tracked climbing, screech-based communication, and unpredictable ghost events, *Spooky Chimps* delivers a frantic blend of comedy and terror. Every round offers a new layout, randomized scares, and the constant tension of never knowing whether the next sound is friend, foe\u2026 or something much worse.", "short_description": "A gorilla tag-based horror gam
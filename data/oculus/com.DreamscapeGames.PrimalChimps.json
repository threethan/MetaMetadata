dn.com&_nc_ss=8&oh=00_Afzdpr3ATmqD-VbgBbzpWbOJ2RpipofWQXD-pOFeeHTx0Q&oe=69B965F0"}, {"file_name": "Coco Taggers - 2025-06-23T220444.595.png", "id": "1250385746717441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820561_1250385750050774_4939484651823554338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wO04_P01rrwQ7kNvwFl_KG4&_nc_oc=Adk8Jqs787q63rPQ_DHLU-rvB2vJcf0TvMOoQ1THXpPS0rWx27OR3i5yxa9717cvbEo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxN_yVjkcIwVPT44xTh85d-xaGVgDN8JXKhJl5tnngraw&oe=69B95CBF"}, {"file_name": "Coco Taggers - 2025-06-23T220620.160.png", "id": "2248438025573944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819473_2248438028907277_1813521934436243583_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UEBeVbOeAwQ7kNvwFHKzwT&_nc_oc=AdnqsdsHIxFXaOjiPdx_ynvMzTf2xOduhentiW7eoNYuzT6ZFYwRMs4myWNBUxOIO8I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwW1RMRya7uaLfbGlGBLLb-K9DOTBmg6LIbDS1gqCJMgQ&oe=69B9386D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Chimps", "keywords": ["Spooky", "Scary", "Chimps", "Ape", "Baboon"], "long_description": "Spooky Chimps is a chaotic and terrifying VR multiplayer horror game where players take on the roles of genetically enhanced chimps trapped in a haunted research facility deep in the jungle. As the lights flicker and strange noises echo through the abandoned corridors, players must work together\u2014or betray each other\u2014to survive the nightmarish experiments lurking in the dark. With motion-tracked climbing, screech-based communication, and unpredictable ghost events, *Spooky Chimps* delivers a frantic blend of comedy and terror. Every round offers a new layout, randomized scares, and the constant tension of never knowing whether the next sound is friend, foe\u2026 or something much worse.", "short_description": "A gorilla tag-based horror game to play with your friends and have fun!"}]}, "developer_name
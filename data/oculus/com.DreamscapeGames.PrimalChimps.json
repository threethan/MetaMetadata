dn.com&_nc_ss=8&oh=00_Afwgy0zTvIBUHvYjfXFtg6bDntQg0-P7bLGqNmmYjew-AQ&oe=69AED9F0"}, {"file_name": "Coco Taggers - 2025-06-23T220444.595.png", "id": "1250385746717441", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820561_1250385750050774_4939484651823554338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qTgfocq8HVsQ7kNvwHbPaa1&_nc_oc=AdnVaTC8rH64MdLFmKJ16pru_uQZIDygo6JVYRiKPbnKzOUnts2JlIbN_hxglvpdWKc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwtmIcVL4Tx_eE-TwL50LTWy2C6qi_BwufLkCO8w-LVtg&oe=69AED0BF"}, {"file_name": "Coco Taggers - 2025-06-23T220620.160.png", "id": "2248438025573944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819473_2248438028907277_1813521934436243583_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OF9VBhOuBMsQ7kNvwHwJoBG&_nc_oc=Adl0Ux6bg6O3pqXCSY5BAw7pfjI89k40rw_SjuGSEGXwRcrpUpeG7FSR-bdJl_N3a4Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afy6qizTEUeb18umCSW_tCsTGisYPVVl9LnG2RschDgcfg&oe=69AEAC6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Chimps", "keywords": ["Spooky", "Scary", "Chimps", "Ape", "Baboon"], "long_description": "Spooky Chimps is a chaotic and terrifying VR multiplayer horror game where players take on the roles of genetically enhanced chimps trapped in a haunted research facility deep in the jungle. As the lights flicker and strange noises echo through the abandoned corridors, players must work together\u2014or betray each other\u2014to survive the nightmarish experiments lurking in the dark. With motion-tracked climbing, screech-based communication, and unpredictable ghost events, *Spooky Chimps* delivers a frantic blend of comedy and terror. Every round offers a new layout, randomized scares, and the constant tension of never knowing whether the next sound is friend, foe\u2026 or something much worse.", "short_description": "A gorilla tag-based horror game to play with your friends and have fun!"}]}, "developer_name
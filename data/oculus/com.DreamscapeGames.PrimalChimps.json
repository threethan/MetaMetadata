-lga3-1.oculuscdn.com/v/t64.5771-25/499314646_1481494660682443_8578156372716553299_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-wthf8t8JzgQ7kNvwEausWi&_nc_oc=AdqJqu12X0Ww54PByaaNfmaIxCkINxxM6gK71Esvd4cPHCT1jhu_-DZxufy7aYvgzZY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTvyxfwPE-aFjGCgzbpkAU-pKJ4dhFV82MxM6D-Ct9NJw&oe=6AFB4C30"}, {"file_name": "Coco Taggers - 2025-06-23T220444.595.png", "id": "1250385746717441", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820561_1250385750050774_4939484651823554338_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aRCMgSKAThMQ7kNvwHC-ZTC&_nc_oc=AdpDSWtB3VUUikEMKfK_K4kInRMhUF-rK0jzIyezZFykZ6pV5LhWP3v7ymFcBOdOWxs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5J9LmvTR-dQAaVpuYHLXPCsuImKCvJNs3_kwpxVSAkg&oe=6AFB42FF"}, {"file_name": "Coco Taggers - 2025-06-23T220620.160.png", "id": "2248438025573944", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819473_2248438028907277_1813521934436243583_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fiLFyvpJzzQQ7kNvwFgQxbx&_nc_oc=Adqx-DCwNOT2uX-jdJQ0gPZuYGaSsEAgiWNfxgNVtznlyLcbFLShAzEKQ0irBpgDbYw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTenshsJofKbGMgGdzms6dN2dBh_emQ0eEuTihtFCHYw&oe=6AFB1EAD"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Chimps", "keywords": ["Spooky", "Scary", "Chimps", "Ape", "Baboon"], "long_description": "Spooky Chimps is a chaotic and terrifying VR multiplayer horror game where players take on the roles of genetically enhanced chimps trapped in a haunted research facility deep in the jungle. As the lights flicker and strange noises echo through the abandoned corridors, players must work together\u2014or betray each other\u2014to survive the nightmarish experiments lurking in the dark. With motion-tracked climbing, screech-based communication, and unpredictable ghost events, *Spooky Chimps* delivers a frantic blend of comedy and terror. Every round offers a new layout, randomized scares, and the constant tension of never knowing whether the next sound is friend, foe\u2026 or something much worse.", "short_description": "A gorilla tag-based horror game to play with your friends and have fun!"}]}, "developer_name": "Coco", "developer_privacy_policy_url": "https://sites.google.com/view/project-xmas22/home", "developer_terms_of_service_url": null, "publisher_name": "Coco", "support_website_url": null, "website_url": "https://sites.google.com/view/projectchristmasv1/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24300030769603998"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1452300259110279"}]}, "baseline_offer": {"id": "1452300259110279"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750780620, "status": "PUBLISHED", "id": "1452300259110279"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24346158028324605", "version": "2.0"}, "id": "4034636583419189", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Applicat
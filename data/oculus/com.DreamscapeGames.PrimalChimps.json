dn.com&_nc_ss=8&oh=00_AfxBCDzcMRlKgKQPrwt_vz3Sw5c3z3cq5W9i7-hnzAhqOw&oe=69C14EF0"}, {"file_name": "Coco Taggers - 2025-06-23T220444.595.png", "id": "1250385746717441", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491820561_1250385750050774_4939484651823554338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Phj9VSFy5l4Q7kNvwF0w8JD&_nc_oc=AdpT8wA2MDkiekI9cakVhRUNnAXCCA4MPmHRSvUgMWVOUbYmiNxwwQu4w1dz19qCoqc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afy_9STf7Lhpm6p_obmFZ6oB4dCL9idbf7HPS0T7r0UWKQ&oe=69C145BF"}, {"file_name": "Coco Taggers - 2025-06-23T220620.160.png", "id": "2248438025573944", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491819473_2248438028907277_1813521934436243583_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQmNhUIdCq8Q7kNvwGTb43K&_nc_oc=AdqwOGysL-v_ymi_nkwgm24pdZ6NA6sc9H7qEphm6wshaWzzgVha-gjUS61V1BvP1Qc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfymwRV4fmIsS6DEtVRI2C_4pAax1LP4OEIsfoufwSMRNw&oe=69C1216D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Chimps", "keywords": ["Spooky", "Scary", "Chimps", "Ape", "Baboon"], "long_description": "Spooky Chimps is a chaotic and terrifying VR multiplayer horror game where players take on the roles of genetically enhanced chimps trapped in a haunted research facility deep in the jungle. As the lights flicker and strange noises echo through the abandoned corridors, players must work together\u2014or betray each other\u2014to survive the nightmarish experiments lurking in the dark. With motion-tracked climbing, screech-based communication, and unpredictable ghost events, *Spooky Chimps* delivers a frantic blend of comedy and terror. Every round offers a new layout, randomized scares, and the constant tension of never knowing whether the next sound is friend, foe\u2026 or something much worse.", "short_description": "A gorilla tag-based horror game to play with your friends and have fun!"}]}, "developer_name
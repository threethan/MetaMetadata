dn.com&_nc_ss=8&oh=00_AfyeYbO8hxzDBsd6necFXyu7Ns2DBZucLZE-o_9ohBVGVQ&oe=69BC08F0"}, {"file_name": "Coco Taggers - 2025-06-23T220444.595.png", "id": "1250385746717441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820561_1250385750050774_4939484651823554338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hVkX6OAIU-8Q7kNvwFH54en&_nc_oc=AdmSdE_iU6Nt6Z49z7N52Qw1jsImn95-91_PWbpyQFpmzUhLTOYY1NPSVDKvPModV74&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfydBU2ERgiAfDbrccdY0yDWxI3lIDj_6GwblmkUSRN3wA&oe=69BBFFBF"}, {"file_name": "Coco Taggers - 2025-06-23T220620.160.png", "id": "2248438025573944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819473_2248438028907277_1813521934436243583_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UEBeVbOeAwQ7kNvwGdA-Se&_nc_oc=AdnGeccel5SoblxVlda52AZW8hyBZA0gL8XcNc6azsqxyAlD1eIKcXLjsL-hnkT2Fns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxY8Jg6w0lPWv5JkDq2ukLAqFHv-VFKl1c7f0tYexXqCg&oe=69BBDB6D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Chimps", "keywords": ["Spooky", "Scary", "Chimps", "Ape", "Baboon"], "long_description": "Spooky Chimps is a chaotic and terrifying VR multiplayer horror game where players take on the roles of genetically enhanced chimps trapped in a haunted research facility deep in the jungle. As the lights flicker and strange noises echo through the abandoned corridors, players must work together\u2014or betray each other\u2014to survive the nightmarish experiments lurking in the dark. With motion-tracked climbing, screech-based communication, and unpredictable ghost events, *Spooky Chimps* delivers a frantic blend of comedy and terror. Every round offers a new layout, randomized scares, and the constant tension of never knowing whether the next sound is friend, foe\u2026 or something much worse.", "short_description": "A gorilla tag-based horror game to play with your friends and have fun!"}]}, "developer_name
bGISo5I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5JzL3rygOB0L-k4e4IT3THLnbu2CZw4qC9GlIbsw5Rw&oe=6A858630"}, {"file_name": "Coco Taggers - 2025-06-23T220444.595.png", "id": "1250385746717441", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491820561_1250385750050774_4939484651823554338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oDVGSB2xFwsQ7kNvwHBKH0S&_nc_oc=AdpYrPcFljWCut6m94OuvYB4nndXNK3WyNUAKFgHI7sejzI46TN933zBWKWrkZr5KDw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVrV8cxjH6EthNBZjcXRqlMzDx9QNa7BjTnpIBt1qSAQ&oe=6A857CFF"}, {"file_name": "Coco Taggers - 2025-06-23T220620.160.png", "id": "2248438025573944", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491819473_2248438028907277_1813521934436243583_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WXf6UnUKLNQQ7kNvwHcabjv&_nc_oc=AdqHnPBA8hiKRg3VYRyfkAzyd8cvir4M8e80jSciW16mZVKY2aazbA10sTPk8B_qC14&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJcwm4HfQ0dmbUuIYEDWi3dI7rDlQvMqlDP7A1IJtCuA&oe=6A8590ED"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Chimps", "keywords": ["Spooky", "Scary", "Chimps", "Ape", "Baboon"], "long_description": "Spooky Chimps is a chaotic and terrifying VR multiplayer horror game where players take on the roles of genetically enhanced chimps trapped in a haunted research facility deep in the jungle. As the lights flicker and strange noises echo through the abandoned corridors, players must work together\u2014or betray each other\u2014to survive the nightmarish experiments lurking in the dark. With motion-tracked climbing, screech-based communication, and unpredictable ghost events, *Spooky Chimps* delivers a frantic blend of comedy and terror. Every round offers a new layout, randomized scares, and the constant tension of never knowing whether the next sound is friend, foe\u2026 or something much worse.", "short_description": "A gorilla tag-based horror gam
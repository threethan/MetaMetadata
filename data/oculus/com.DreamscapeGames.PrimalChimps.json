_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlfVEEV2kT6Gf3x9TRO2BOqTkfNz_NqKT07tAadr7suw&oe=6ADCC170"}, {"file_name": "Coco Taggers - 2025-06-23T220444.595.png", "id": "1250385746717441", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820561_1250385750050774_4939484651823554338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=62e1ooXbBjcQ7kNvwHd29-8&_nc_oc=Adr43j6B39_6ABnj-UnKAU7Yd4NZcyzywBzrAISHFNb68Vo7L409NRQNkLpAppzr77Q&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP68KexORgZQQz-P6fec-OYaw1S5g4yEdMOc3gMLpF9Ag&oe=6ADCB83F"}, {"file_name": "Coco Taggers - 2025-06-23T220620.160.png", "id": "2248438025573944", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491819473_2248438028907277_1813521934436243583_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J5bVqMnnxEoQ7kNvwEBYSgd&_nc_oc=AdqLFbV1ybM5N1O0KeDi3dXCSf8Uouki6IWfDOZ8W8syuHra9fXaKs_t23fbvc9i75U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBL_11RbhNy40rQDl6VFC18DtFRXAn8tHLFq5hHJ9Mqg&oe=6ADCCC2D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Chimps", "keywords": ["Spooky", "Scary", "Chimps", "Ape", "Baboon"], "long_description": "Spooky Chimps is a chaotic and terrifying VR multiplayer horror game where players take on the roles of genetically enhanced chimps trapped in a haunted research facility deep in the jungle. As the lights flicker and strange noises echo through the abandoned corridors, players must work together\u2014or betray each other\u2014to survive the nightmarish experiments lurking in the dark. With motion-tracked climbing, screech-based communication, and unpredictable ghost events, *Spooky Chimps* delivers a frantic blend of comedy and terror. Every round offers a new layout, randomized scares, and the constant tension of never knowing whether the next sound is friend, foe\u2026 or something much worse.", "short_description": "A gorilla tag-based horror game to play with your friends and have fun!"}]}, "developer_name": "Coco", "developer_privacy_policy_url": "https://sites.google.com/view/project-xmas22/home", "developer_terms_of_service_url": null, "publisher_name": "Coco", "support_website_url": null, "website_url": "https://sites.google.com/view/projectchristmasv1/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24300030769603998"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1452300259110279"}]}, "baseline_offer": {"id": "1452300259110279"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1750780620, "status": "PUBLISHED", "id": "1452300259110279"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24346158028324605", "version": "2.0"}, "id": "4034636583419189", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24300030752937333", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24346158028324605"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "4034636583419189"}]}, "change_log": null, "created_date": 1750887890, "
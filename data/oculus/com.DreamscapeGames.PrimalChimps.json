dn.com&_nc_ss=8&oh=00_AfyHL1D-xL0spxajSW0xUIO3Pd9N0IBnUwqWSGTkytnrAA&oe=69AC36F0"}, {"file_name": "Coco Taggers - 2025-06-23T220444.595.png", "id": "1250385746717441", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820561_1250385750050774_4939484651823554338_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYUFuhlHleIQ7kNvwF3fzAA&_nc_oc=AdnXd_k9H1ZQXCTkIf9hDsE8TjtMIskIM1X1gWeRAYTqZsh8ATWbXtJ4sM5R29h1H5I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTH9-wKKCdRGBiGGIU81h5Rboyoin2yIoTA18mgSRW4g&oe=69AC2DBF"}, {"file_name": "Coco Taggers - 2025-06-23T220620.160.png", "id": "2248438025573944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819473_2248438028907277_1813521934436243583_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYnQada8cuUQ7kNvwETP7xA&_nc_oc=Admmr3DEpXzb8pk2PhiboVXGww5NW8CIuqwPdO4QZDzar_O_MFbUYZQd8LPm3_laQeQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwGT9top_3E0stZ-ENUkBQ0-lrRPm5vdmNCdt2QYRgv2Q&oe=69AC096D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Spooky Chimps", "keywords": ["Spooky", "Scary", "Chimps", "Ape", "Baboon"], "long_description": "Spooky Chimps is a chaotic and terrifying VR multiplayer horror game where players take on the roles of genetically enhanced chimps trapped in a haunted research facility deep in the jungle. As the lights flicker and strange noises echo through the abandoned corridors, players must work together\u2014or betray each other\u2014to survive the nightmarish experiments lurking in the dark. With motion-tracked climbing, screech-based communication, and unpredictable ghost events, *Spooky Chimps* delivers a frantic blend of comedy and terror. Every round offers a new layout, randomized scares, and the constant tension of never knowing whether the next sound is friend, foe\u2026 or something much worse.", "short_description": "A gorilla tag-based horror game to play with your friends and have fun!"}]}, "developer_name
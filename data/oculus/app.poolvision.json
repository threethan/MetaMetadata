4.5771-25/908842208_1153410037388789_4960706895561761877_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kv04xVrp0OgQ7kNvwEUew6R&_nc_oc=Adq3n9j1aRzXA5tzf5RvfhvGtvWPQYELRAnaMnn9Zi4qI46EwolKvicD20z6d4BDo6A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTA-tKn2rGj4ecn302VZ-rgefmHQqkBugLZxyAb1i9b0w&oe=6B0DC799"}, {"file_name": "02-aim-cut-shot.png", "id": "2078528329533808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/908850595_2078528332867141_2666983903802708005_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aeTY4qyH3SEQ7kNvwG4uPzk&_nc_oc=Adqu2r8bQO6z5ttexVWkCra4d3SOvRzodRIyeS9lUGSJF8o0RSv6ZgSYNkufEVQO2vE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRedyLq7L2Ve2yVUqJg2ck7vpOehBVT0AheoJ349IhYcQ&oe=6B0DBAA9"}, {"file_name": "03-call-your-pocket.png", "id": "1619452526648577", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842257_1619452529981910_3356321750086210008_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woKVIt3NspQQ7kNvwHQZwKF&_nc_oc=AdrImF6w1sV9aqY34KyQxTGKa2fla16Y1OM6WXeEWyCQ5AjbDAlahpWLylyt-mU_LvI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQerSfqCi_AQe1aTVfsijAFaQUb32uC9F_Ht0dJx46Z-Q&oe=6B0DC3AE"}, {"file_name": "04-you-win.png", "id": "1407348367863541", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842236_1407348371196874_3490929776149846435_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AuuVN32ppDgQ7kNvwHtlUjK&_nc_oc=AdpI4MarY5tAMUoVQyzSSKAi8f25CQG99Byu5bA2JdZPnQmgpx4uMA666kq0c0ZpyXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ-aW_6lZRip1PWaFO6g1xgn7wzR6q52A7cAfce58CoZA&oe=6B0DADAA"}, {"file_name": "05-cue-shop.png", "id": "2130449311011850", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/908842261_2130449314345183_5522482394381323331_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8OUGiQs_1YQ7kNvwHxvFtg&_nc_oc=Adp65TGcK8Qc1hZM2cL6kgk6qXxz-W0ol2E4xIPPVEhqwnGyz98uFzcuAwiUa-32KKM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTZFfvkQSUTPeDuMSO64Fqm9xhacmyjy-WC0fdy1hov8A&oe=6B0D994A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoolVision", "keywords": ["pool", "billiards", "snooker", "cue", "sports"], "long_description": "Some pool games animate a shot. PoolVision simulates one.\n\nEvery break, cut and cushion rebound resolves through a purpose-built physics engine. Set follow, draw and side spin on the cue ball, and it draws, follows and caroms the way a real one would. Line a shot up and it goes where you aimed it: no invisible assists, no scripted outcomes.\n\n\u2022 Physics you can feel: ball-to-ball collisions, cushion angles, rolling friction and spin are simulated, not approximated. Aim lines show your line before you commit.\n\u2022 An opponent worth beating: four computer difficulties, from a forgiving Easy to a Very Hard opponent that punishes every opening. It plans real shots, weighing angles before it strikes.\n\u2022 Ten tables to conquer: climb from the 50-coin table to the 15,000,000-coin Champion's Table. Each table sharpens the opponent and tightens the rules: call your pocket on the 8, then on every shot, then play the top tables with the aim lines off. Every table shows its fee and its prize first.\n\u2022 Twenty cues to collect, each with its own power, aim and time bonuses.\n\u2022 Practice mode to play both sides, and a shot clock that keeps every turn moving.\n\u2022 1,000 coins to start and free coins every day. Coin packs are available as in-app purchases.\n\u2022 Plays offline (purchases need a connection). No account, no ads, no tracking.\n\nPoint and drag with your controllers or your hands: aim on the felt, pull the cue back or drag the power gauge, and press a pocket to call it.", "short_description": "Some pool games animate a shot. PoolVision simulates one. Every break, cut and cushion rebound runs through a purpose-built physics engine, with spin you set on the cue ball. Play the computer from Easy to Very Hard, then climb ten tables from 50 to 15,000,000 coins, with tighter rules at every step. Free to play, offline."}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Meshy-SC/PoolVision/blob/main/PRIVACY_POLICY_MH.md", "developer_terms_of_service_url": null, "publisher_name": "Meshy", "support_website_url": "https://github.com/Meshy-SC/PoolVision/blob/main/SUPPORT_MH.md", "website_url": "https://github.com/Meshy-SC/PoolVision", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2063175454394356"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824671_2162143701075528_8618326800116395034_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkyD9RrROHgQ7kNvwFvL_mJ&_nc_oc=AdreJQ4BbLD-WcDtw4mCzaILINDmFKFdqhjVEhjPYGPhcjjO-FdR3JWtD0zyy5Xvy2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRt4VqZukkqHXLbwGQs988hIQbG3diKfL6827N5GmLB7A&oe=6B0DA639"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PoolVision", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAM
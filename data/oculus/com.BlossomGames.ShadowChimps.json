ttps://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822897_1778283049783809_6903370103653707552_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZM8TsgxWJIkQ7kNvwFGOuLC&_nc_oc=AdoPkNk_5NKy8RbOXkx44nPmImRyxML34kweuDKh2bwyrVq-dMiyesMsfnLE5ObHtOo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Y_OyRQfnYjS_t9zvkCmC7KpVyQMFoiMoIE3XdrH4TBA&oe=69F4A1EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Shadow Chimps", "keywords": [], "long_description": "Shadow Chimps is an exciting and terrifying horror game that combines gorilla-style movement with creepy environments and endless fun with friends. In this game, you\u2019ll step into the fur of a chimp trying to survive the darkness that lurks in the abandoned forests, haunted caves, and eerie jungles that make up the game\u2019s unique maps.\n\nRun, climb, swing, and parkour your way through shadowy levels where you never know what might be watching you from the trees. Use your agility to escape terrifying creatures \u2014 or become the monster yourself and hunt down other players in thrilling game modes.\n\nShadow Chimps isn\u2019t just about being scared \u2014 it\u2019s also a place to hang out and mess around with your friends. Join a lobby, chat by the campfire, plan your next escape route, or just climb and explore every hidden corner of the maps. Discover secret areas, unlock new levels, and challenge your friends to see who can survive the longest in the darkness.\n\nWith regular updates, new maps, creepy creatures, and lots of surprises, Shadow Chimps brings fresh scares and laughs every time you play. Whether you\u2019re looking for intense hide-and-seek horror or just a chill place to monkey around with your friends, Shadow Chimps is the perfect mix of spooky, fun, and chaos. Will you survive the shadows, or will you become one with them", "short_description": "Shadow Chimps is a very fun gorilla style movement horror game, where you can play levels, hangout and chat with friends, and explore fun maps!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://monkeharvest.weebly.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "BlossomVR", "support_website_url": null, "website_url": "https://monkeharvest.weebly.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24057143387273292"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1801339904152858"}]}, "baseline_offer": {"id": "1801339904152858"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1751485920, "status": "PUBLISHED", "id": "1801339904152858"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24071337525853878", "version": "0.9.0"}, "id": "1245373997251429", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24051716044482693", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "24071337525853878"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1245373997251429"}]}, "change_log": null, "created_date": 1751630976, "id": "240713375
94", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827096_1767321920569527_6328194603177242100_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1QYa2xeL7HYQ7kNvwEhiPV-&_nc_oc=AdqESFzfKG9qCudYCNFjGiJJD9vBPQL7BF7NyR5NfO_u24s6fnJVKpDFLJOhUwTcOwM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXUk6IB8AX1HUCAxU4Qn1zS0EDU227fSumqvYHq2IeCg&oe=6A8D95D5"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tropical Taggers", "keywords": [], "long_description": "Step into Tropical Taggers, a vibrant VR experience set in a lush, colorful island paradise where fast-paced fun meets playful competition. Dive into dynamic, tag-based gameplay where agility, strategy, and quick reflexes are your keys to victory. Explore beautifully crafted environments teeming with life, from dense jungle canopies to sandy beaches, all designed to keep you on your toes as you chase or evade other players in thrilling matches. Whether you\u2019re tagging friends or strangers, every game brings fresh excitement and surprises.", "short_description": "An awesome game where u can make loads of friends and meet loads of YouTubers like (2Q_VR, GOOFYMONKEY, and many others!)"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/c5be26fc-774c-45fa-a3d4-35081f87927d", "developer_terms_of_service_url": null, "publisher_name": "GoofyMonkeYT", "support_website_url": null, "website_url": "https://gvr1.carrd.co/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommen
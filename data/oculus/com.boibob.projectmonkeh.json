f-A6_XmlCTGpa2XRXJYnl6Ae_XuroZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXl6hQdwrJ_HM7HQ3h_poy7I4v-b-JAzf9BCwTSQZodA&oe=6AF07C6E"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SoQi0RFgLFUQ7kNvwEy6LYq&_nc_oc=AdoI96P02vl6i-w_w5o1ZbLGUkjPbK4tDXeGr4hfEw9jdJgs3IB5-JUjpo4leAMJVGk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-PfnqgG0EBdxoIqAcc2dY1iYLPzN69WZZRKao3Scxzw&oe=6AF08A4F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0xiFagPoKl8Q7kNvwHvimkh&_nc_oc=AdrpevKCEox22_RuT1TgAnN7A7-FuIRqZs_SplN7BcmxjbsHXm3-28zQTSA4lpfV2Cg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcOch3MRJ5Mspmh6_EsvqCi-qta38UZDND96COeralSw&oe=6AF08414"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_JZyrGAd_gQ7kNvwHskIcF&_nc_oc=AdoR7T1wgljACmkfIwpTZ9xF90Al7Z2S2mHMZqRhR5qtms1te_g0patnTGM-ReEtUp4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQDD2Y40QUsHcTBAvTh1Ph2VrdHhVSJL17jotKaefFMew&oe=6AF09E7A"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vx94_USkwj8Q7kNvwF4Ed09&_nc_oc=AdrjANoGdPVBqIfJkvLMNlmz7CYIPvnC0OweuwXXEHUvwneTR0dos6jzjNAxRwhp1ls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYrO4bd1PP8wBgLns1-9SQBsBgId88pbsKA8rf8if9WQ&oe=6AF08A18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
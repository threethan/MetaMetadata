66TK6_fFhlKm_vhCeTujlUcISJ8Dh2M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLRR4miOYi8KOvlSfvV47K_GoFenn6vLC6pc6zSomgPeA&oe=6A9ACAEE"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38KhGa7HG5oQ7kNvwGOAvP-&_nc_oc=Adosk3YpniwXgINvL7c-PYWL1arlmkGEKUJt-u74StjzwJNyFLnrcu_ROhyHB4Yc8CI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLmfu-KoNf4JIuT_Bnrt7n_CjU4X-MvUPuwSeu1IqH8Q&oe=6A9AD8CF"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-slauUeN1QQ7kNvwGBudC9&_nc_oc=AdqIY6NAOXyxhSbuG1j9pFiwa_RixNdawD2_P1i2wY_yXBnXxLLrDvobvuxU06CW6sc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7VSm03aYhbgGUKObsslsINl3Pt7L7PgsXHpKVHgd1Kw&oe=6A9AD294"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pIGHLG3IyNYQ7kNvwEY4YBV&_nc_oc=Ado76KUxeSYI8N14ImVXhNInZe_x1D9AFjaXOM58SHvB8FbbXfr34BGxe8yWxsUFT18&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHgXvCoh3urt2z48RZvRfX1GDEwh21Vw4w0V9Yd_zUdw&oe=6A9AECFA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8evZReKMJNcQ7kNvwEuUuHP&_nc_oc=AdrHHT3H-rec0u2MjHEDEAWrO6BSKtjMq5dZP7fQolf_hmMbsGj95CljXe2WRCOweX8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyOfhkg_q8sZT8oUktD2v_g4h_0xWIbmloYI7VCobTSw&oe=6A9AD898"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
tps://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDHmUYqbnlcQ7kNvwHHFsNM&_nc_oc=Adnwv4IM1YqafRCEk9PTu-bHoEQ0w5Razyxcz5vyjemHB-iIIpd9Gok6T9z5-ptSEtE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuhThdPQZbz-C49M9DVl4caeyN_BE3yAu_vRfmHd8-UrA&oe=69A05BCF"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=andCPFKMVX0Q7kNvwH028sB&_nc_oc=AdnFKzGdfct4o_vy608Ho5WMWv4Q_sYhFr54lhFvZpUsMyvZnUFXwn8nV_ngt_TeyJ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuDpeNTIiasGl2lOpjyTlcJ5DNGU38AMUIfU-t9E0NQdQ&oe=69A05594"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9gso06p3ZaIQ7kNvwFFCPIw&_nc_oc=AdkbvNGsC7rS_xbVTwVTxtotjMA4uMCZHtrjmQJo_kHk4qYJc36pMxHbOYHo5XlL5hg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsQc8jP0Qaml15RlzlemNDo6Yz6bz35LW2N1lvzZhsKbg&oe=69A037BA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pn5SGfinZu0Q7kNvwER5v9s&_nc_oc=Adlr4AxpUmsi8NZkmsNjyHlotuahpBj9rXlkX5k71WJ06aRAwdPwow8DjpE1gORazqY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afv3h_zbGLEYLlj5YPrJAK1_N-okk9Pq5P2tU3wnvI2DVw&oe=69A05B98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "30270949939187520"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-
nz4ZxwWpeN_ZWwXz7Mw_VNLbWXdY0X4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBM9QrjUrOGizdYLaLhXVbzc18pQsjBoVG0017mtJcvw&oe=6AA6A86E"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw5kliM0vUMQ7kNvwH9XBXi&_nc_oc=AdofBLfM12H5_3DamI1PuDGgvk_5yDsMlCQj4fXDatm0-J7MhXpEIHIYUWfl6C9SC8Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXLX2esCJsi71eESNlF62O9cVyBsoTqYE6dvzXxwwegw&oe=6AA6B64F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH_580CaONcQ7kNvwGYUL7U&_nc_oc=AdperwdxXb8SBaiiCCwnie9lJr6UKKt94jCpJM4O7mrf1iKEjBthnMkOzVd17Bfsq1I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3pqU4X7pow7BfzaHJdND5QCBYYgRoPshbiB0fu2Q2XQ&oe=6AA6B014"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTO_SsRS8K4Q7kNvwGsAHPL&_nc_oc=Adp-8N5mjWUgWql621VfhVfHq4F7R4mL3D_MzbPN10UqVYxp7pBA7lxkR5RbVfSKXEE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIR6t0P7O_alwCkHCLTroes0ln8U8UlKGITX-PR64eiqA&oe=6AA6923A"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18Fq-4Pi390Q7kNvwFFsqJa&_nc_oc=AdoCPPgBT6kYiYsK2P2RgjzgSFZJ9RZgNbYobs5y7vGWZyjnf79oB2Pvt5-BX8o1J7U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaoYTr1gGPaspuhBcMUhV91XUql-HedvqcGwzLlCc8FA&oe=6AA6B618"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
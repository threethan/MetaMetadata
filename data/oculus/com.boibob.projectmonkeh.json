UERc4pDxLj3p2q444lmyMTiLCE4fiD0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDu6Q3X0domc8rH4M2ELkuzoKIYmjaEQeZElF1nawXvA&oe=6A881DAE"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8FEJhSYaYUQ7kNvwH8XKf4&_nc_oc=AdoXwHeSr3-lx55ttWKLRUSwy4luTZMlUKcGDKAy65O0S9VlQQXRQSBqnt5kooHJNxw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEymdEf4s9C2yRF16pVNo0WjSz_YYaLq2Pzh09vJMptfQ&oe=6A882B8F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAyw8x51Q9oQ7kNvwGP68D-&_nc_oc=AdpmI2MI7zJg8f5B40AQVLZ8vbdTE0ohP-7z16UNV9ilc_NY_cT9EUgMfYoMNlCEVOI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcYQteMEMdCuXrRhAXvAWEh0hkRpEMVZqaGzXDnRrUHw&oe=6A882554"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X177lu_-skQQ7kNvwEYxEK3&_nc_oc=AdrVGMDiXlOBuiiOs97u8IJ3myJ9vFWVjLvWZSovEAzow-JWhH-COzKrnO0kOcn47X4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuNqoAlAM4wbWJm5ltZjPsjXSZY5r5oQFNuW9-C1NQIg&oe=6A883FBA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eAcxc1eSuUEQ7kNvwG5rwR2&_nc_oc=Adp5e8P5Nj_hElRVGG8gK5rM8UMbZfQJdICyfY93p3QfmmjT761NAtyljJy9JYVaB-Q&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyXi0RYF9Qnn-iOgaPrujNPGWrYk9N1iksvOGYes8p0g&oe=6A882B58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
yeY_u1GD3vAZH0fGjQ&oe=6A35476E"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Zg76GY_Bd8Q7kNvwE2aXzN&_nc_oc=AdpruB1ta1vHWfBkAyKkCl3FXNI2i6FsDqsRgj8O6bL4aFoJh4YH8grWDg7y9UgwImg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-VPTTrgiCeG4-JQpOy8HKGWtbhe_7_8fqKvOPVupa2jA&oe=6A35554F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ybiQLkRudsAQ7kNvwG5gdNw&_nc_oc=AdoUFkx2T1d9p0tKBPTnvqPNvA6-vti71DXnBtEukPjBBr_ioIsePYnWEODtMeBJ2Ug&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OMbKXqxJPnhHITYRFNiPMv6XQHEUeUS2RCOV5O7BGAw&oe=6A354F14"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EgodedSg7igQ7kNvwHkw1SX&_nc_oc=AdrZCWfb9nmZnzVSb0rOJtllkYO7pptfObSoMImwrCm60vqz6XFHjqZc8QfSdkH0tk8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-GfT5GNh0S_Jgl-5H4nPfUcrvWScevoHgvhOV6F9SJsw&oe=6A35697A"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWlUgbJX-1YQ7kNvwGqtcdT&_nc_oc=AdpjSpQkPhek-wQm219r5MgFZ9gcFo90FebyKzPdqSvX_fZ8o95qB9aM7wUE__fx4R4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LorqZmUEoj7C6Z9AIThALW6goiSiGC6isAFoVgUxwTg&oe=6A355518"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes
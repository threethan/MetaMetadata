W1ADeDHBL5hOk74zgyW452PfhJSRPpY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQItObe-_lkdJ4tyuaML1yXb1ULt-blydxNqj8vrLVl9Ow&oe=6AB285EE"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KRUZiUD0Gk0Q7kNvwGx2DqD&_nc_oc=AdpoVYHt9dmDfN3AiFZT4Q26VIVYrVmRQt4wc79cpzzd_aT_yfvWD6fRu308F6ZYqqI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoORLJiqiioKO-tIG2_hVGs8vovMnK5f-hJ2Fy9n1Ucw&oe=6AB293CF"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M2bqszNW6uoQ7kNvwH4-3Z7&_nc_oc=AdrJN38ItE9bxRik1rnyCnDhrHL8EznhRWs1d0SSDnWr585eF16aRy3VMucLbLGktws&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6TqZVtlDoPHNJxPNmYhMfv5V1POB0dE8q6t0GK89rkA&oe=6AB28D94"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFIM45YOZr8Q7kNvwGL24Ab&_nc_oc=Adqbme5bMt8h9G2r26EMzvwrsQD2NhVaS9DrdxqerdHJIwT5zguq4icyq853_RBjj3U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJEK_RSpDKRDYwwC3S1YjwdWfe18o69ahbqZT2-sjdk-w&oe=6AB2A7FA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3B7SLhcC3EQ7kNvwFtIOkE&_nc_oc=AdpsDkKkFrGCKheyVEUQPOPKi7DJVayyhawOVDid0OfM1foqevTHSQR5IhszKHLNizE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJYjwtmWbKKmpdWOz0h2HcrN3twUqWE8Vl5K_e2eaCcpg&oe=6AB29398"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
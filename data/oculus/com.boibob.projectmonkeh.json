u4LyiUyQYRayTNP1eEmNaaM2de9nBtU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWc92ArQNXKz1l4atNxXLas2SN8lyuk_q1v2LO-52L9w&oe=6ABE636E"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=58aZA2Po3eoQ7kNvwHzsCUZ&_nc_oc=AdqYYaxxSPEjuGxoH8uGo4_DBkHhGmvN3pscZHp2dhfnLcKpxndeV00GZ26ZF-LqQAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOMbfWcTH6zmmSQx-9Hpif-vgVmx2ijxV4l7bHLGupNQ&oe=6ABE714F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pdrT_Mo-sJcQ7kNvwGQ1MRU&_nc_oc=Adp3tHbIg7UGkN6E4P0Ievu-ozV4WtAIy5YJqRkNjyekdPmDn9Ddixolu5qGScZYkrw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjYaWUGdVbDaKj5EuOQsY-mY4IePqIPXTCLEGzqqcxVQ&oe=6ABE6B14"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ZKrNa9utsMQ7kNvwEirJq3&_nc_oc=Adr4Y9Kyl5iGuatsGwLXn5Y8H5kYaUH2V1Il_TCjmwieL6SX1ulf4vLXuGP4z6WmxaI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZCzWA-ZKi7B2677M75go_M2_EI8LSF--cPtos34IkCw&oe=6ABE857A"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDHFTEhy5gEQ7kNvwEPDRNB&_nc_oc=AdqzBIKagbChxWvGBTjNT3Z7hvoXiT2wIazHPB2yhth4fFUfm4ZqKa2cHJdGKHfAbgI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMro4PNd6oGtIf4aJYo3afKZfTdAfvCtkFQx2wd0tYFA&oe=6ABE7118"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
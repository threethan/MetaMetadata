EE"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hg3v5MSEXc4Q7kNvwEYyV0D&_nc_oc=AdmKyIDfE0dcf1yHUyr40GubmYJAm9YT553E20HKPXu-Jv8w66Hx1B7FPahZcyqbjGk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzhF6Xwqbx72T0_isG_R0mNLR9eMkTvzGfVsvNdJa_YtQ&oe=69AAE7CF"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lNYharRl-bwQ7kNvwEnOWLk&_nc_oc=AdkOs60_UBB95PUDGFHoGUmHFrxmbqHfwDdtv5Z323H5joBIeVHOcZtRLUyda93PXwY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfytuUwOGVb0CGx_Aexk4xN9ynW7okmb5D3Br-HcMn4Z_g&oe=69AAE194"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvcZLfWaTZYQ7kNvwHwbG1H&_nc_oc=Adkx9dpN1pmcV-YXWwd9pMYznsFQA20cUG5ZdrswQKadYuZVO_eMG8F4Cx1RJOi4G0I&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afwxvdk0HM-IKRygXSvSSCrxkOLastWItxbli4BE-Cstng&oe=69AAC3BA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfHtCGf5x8UQ7kNvwF35Ghb&_nc_oc=AdkPlbMs5jCSQbI2X-JaYldSFRS3GqN7Efxjlw_qsb4viA6Qa6wQhvHm4pkikv0bgSA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfyOGWSmhzxVu7dzBTnahTOxM-jKK8zSeFYZXbWttmnlww&oe=69AAE798"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_U
_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ62c6oQBHAjCTZAOVAOekl-Y88xt1x3POne-AtHhFyFw&oe=6AF8A554"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbgzLg4xOD0Q7kNvwFlJCk5&_nc_oc=AdrbbqUD8bKJrh2dvtNPb0mPvoJ9lTlzIZg38u19OwGM3-2zJMaahPre4LDxH-jJsIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTuw1tQ21FcUGqsxYT1JUA2xb9no6gqCNF7DWiNB9MZ7g&oe=6AF8877A"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqOP2cBJM5YQ7kNvwGxLkCP&_nc_oc=AdqukOPxFFIJoUs1JChyePK07nOnV-j_eFIZ2xss6o_YvgkABaTn5Z6hos_PkEGTDJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPEXmDmDyrN0Thpy5arEqgKuJcF4C016TVJ-eBP-W2vg&oe=6AF8AB58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "30270949939187520"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "30352605371021976", "version": "0.4.0"}, "id": "1027308882879605", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "30257809467168234", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "30352605371021976"}, "release_status": "RELEASED"}, "binary_release_channels":
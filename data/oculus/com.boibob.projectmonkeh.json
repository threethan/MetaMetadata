DbNNF85bSiKhykFpE_FUrVqMmYz-O54&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWS-_Bo35zNMu4bBNLtlOelwmeFor7ORaLKJgwZhLMWw&oe=6A9746EE"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7YHFtc-8C6sQ7kNvwEY4NSA&_nc_oc=Adojd97j3j3V1ilfgc1fWDebYftSwxaJJpH4MelPVX0i1H43oFcgwT-23qcNT-qW44k&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqoOEQJ3f9J4W-C7HMjBiWLcXEaFs_Z8DccEpMUuhAIg&oe=6A971C8F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8joQyx1iyZIQ7kNvwH3mDPL&_nc_oc=Adpy-3t5_uM9c7tfoFqcwxDi6AEiVtCXX_Rt6j7_rAg0p-4h9jCbosddSLFJ8JNR8p0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6higG6QybL9deozNlPZw_F9mpU9MBlGPdVMwiL8KuIA&oe=6A974E94"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xJ4N-CmAIcUQ7kNvwHnOjNu&_nc_oc=AdqCP4gWv6YhO-4QA6TSrkyF9tlelB8rnNLZUWZKLD2ToTFCIMeUClprULvelcFXUJQ&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZHUYw5MyapAYzmM8kzLctTrfLCD9oz092PGqPUZ_kfg&oe=6A9730BA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=47iXZYRMYeUQ7kNvwHRB39J&_nc_oc=AdoONFIjONtg84N4KKLYYM4du1fLTlSOcblJc9eQE_0CPMhDQVZrBKcLp0iEzSfNbjg&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbTsMsSNREpuAg32PwJwHw3d9KnS0mKab7XdzLDAbx7Q&oe=6A971C58"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
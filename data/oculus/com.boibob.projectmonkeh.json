EFiN2DB8ohorQA3DSIAFDq-huH4a-lA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMqKEPwhu2uJ3ORQ8p2e-Ghx-e95VrRTBrvZ_cEGcm_Q&oe=6AA010EE"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UavW22oPFnQQ7kNvwGK3lfs&_nc_oc=AdrHLizhQmEq3zQdJrLiDtJUnCyuV0pxbNEoagpkR3oV5qNHYMMtaRCZQK0Gdh5-lIo&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpCEqQfz3h7hynOuy94OIkHILBqFEGGXuZo4aosF3Gdg&oe=6AA01ECF"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=drkz6gx3RkoQ7kNvwFeMEPg&_nc_oc=AdqkW_UgTHrWHWy5l6_L7VRblrezm9HFysDHKibBDsOEuXvJIdZvx5NgUUOOymMevy0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4O8Y5OisH-KWlLLlEYVXbs20UWq2xtJsy-4eUECfObw&oe=6AA01894"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_9LGBIb8u2YQ7kNvwGVciY8&_nc_oc=AdrBYrmSzZPqdMTejOt3L7YA6xtlr-3puZ-dDD1xnDA61DxTjjNU3oWSBBSiyXb-1ZA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqCEkZRJLExLlhdI47uqk6CgQe8BOajkUrzvYqQjc6YA&oe=6A9FFABA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zctBtokbdRMQ7kNvwFvVIjm&_nc_oc=Adp5GXVOTJ6t-j_OQpCKj5jI5FP9FHUlnLjzZFQSWWe2GXuSBgoJqhc372xDOLHq4kc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH8jerHUiQihuPLa1lp4qcRbto9BqjtWBY9Xl_-Rcq5g&oe=6AA01E98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
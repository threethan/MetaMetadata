Zcc0OuXOPcJux4sENQ&oe=6A4124EE"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AvK6wh17O58Q7kNvwF9ZPkk&_nc_oc=AdqOL6SbTnPIKOzhSI5trO3ko8U-37w1nqJSq5orzHfqX-OTu-toBUATmBaK41-cVjY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yMAf4boSazre1Wd22IZKIHE5rnvF8Y1mV712T2R7ZXg&oe=6A4132CF"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PonUUfEZy-IQ7kNvwEKFlG9&_nc_oc=Adq2DUMBsLPnB8IgBfuh1y5zbJOjc8bBierN-rg4TWTIaJnji1Xi8F_TFAZq1EAGRvc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8lmjC2rjbe5VSbPKAGX8feDWMl0fTZwhiJa9QPbcNmuQ&oe=6A412C94"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc19d2CxIAIQ7kNvwETn7eB&_nc_oc=Adp27FsAv8sd2jfcTWYfDxO6Fot9DIHSLvNoloZ9hUQzSsp_QeSmKaXjWDkFXrih3SU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_lGX7Lr2ELB6rNn2cHGPeyga9cRqiwKdWT7cekAIXG9Q&oe=6A4146FA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pz0IlF8FyfYQ7kNvwHW23A2&_nc_oc=Adpi_lhSe07g6rtpkU4BJOr27RevHfehOaSFzy3t0ZtrHxlcEubl93XHfN8DMnCCc6s&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VCuC-1x8GUGX2KBinl4khYQIpDTYH7xIqEYKZDttlTw&oe=6A413298"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes
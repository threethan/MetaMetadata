axeGv2EcohMe4O8NkzNJAcW-U4ey69Vb6DUQuLeE&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIqFVR1FScBqt_Z-4y2mJL-yevALG-PUEnGWGHTGRNzQ&oe=6A8D9BEE"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ub6XJAJi50wQ7kNvwGWWD_T&_nc_oc=AdpV3do3Exfge3fFqYvH-ONsMAO3YK4dPHRp-HxrJY8-PXagQHz83aaR2unABnTRIPs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfFH9zLPpSy6aI4CrMrt7ESvbq9ua1_XNUZ-G7DvoOGQ&oe=6A8D718F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=czHcLxw-SawQ7kNvwHsL8kM&_nc_oc=AdqiBr270CnWvXRHrHKFpnzqvLJ6_7kZnHS80k1wHfzBZCUwBUySJE52H3OZYzd8cDQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpQM8dryzVpZ2X41wkXAhBEIM62nRjP2VZpsZj1x_6Hw&oe=6A8D6B54"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRj0gVM_vToQ7kNvwGMY_KV&_nc_oc=AdrxY7hSVnBXxnqytuXDB1CsUfQ-sp56tLW1v4K6y0C9qRlKWpPQfo1T0pn2HSTPclQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOOH6RcCSXZ2RG40eDrTqHUs_fU6A0vkYQEZ6mCf0kWw&oe=6A8D85BA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k2G0NupNlwMQ7kNvwFEW48O&_nc_oc=Adoos6Tik045ZYgzhvRYTo9CXc0pELYirR_S0YFKuHEQLyU_HXytCqFsA_Oo4X1fgWk&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4M3PAJQh7pxnJK1jRJZ0rjqedwu8pRNJvw4E3P1rBbg&oe=6A8D7158"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langu
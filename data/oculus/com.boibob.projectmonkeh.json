YF8-jIu10wth4SU5bQ&oe=6A3A8D6E"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X9SpPGFTVkMQ7kNvwFJMSUv&_nc_oc=AdqQA9ovtslmCz6D99yMnSc6gOds8ZlIxvTsKRqj-DE_4k5tDUKsUkTBMNVCmdfYamY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-WfToSfO2MpEg7TlvsnCOGrmS3O2cm1QiA8NeryPYayA&oe=6A3A9B4F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RX11q-Iy5EgQ7kNvwHyAHf5&_nc_oc=AdoLO-odv515IPLRAOzRdLSsx5H3hpW1-OkBTHPH10oQF7sdjtFINevo4C-Rblu584Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UOMxryldI0r74Ulj9uGC1KTsd1_wJA55sQmYMdx8-vQ&oe=6A3A9514"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJL6dd80fl0Q7kNvwGOmgQs&_nc_oc=Adqq1gmqPed3yHP8v49ko3l2dqQ77eA_qzdMnysPjX8CRxg7thT9LGfJgTVt4OSTejE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8O2YMk4Mdu8lBI202D9T3NSzWn8xMD0KrTRF2WGnbzbg&oe=6A3AAF7A"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VmhGEmVPFdwQ7kNvwFVgYgu&_nc_oc=AdoRxvcBcLicJd5Wre8dCImy1e_eCr02-Op-jf0Xz8cDSf5nG2plkzKTV5Mnp0LBjIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-m1YrfYhswYax8a5RV_od67mEFV1pfWttbr0iZe1lhlA&oe=6A3A9B18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes
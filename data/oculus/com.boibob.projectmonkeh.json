YunucIj9aj7JPwAPOg&oe=6A563CEE"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-CJhSuu_xoQ7kNvwHT4iYZ&_nc_oc=AdpLBSbPcX9f5xaK11gboCNgOdvmeBGnThSVKes2reyPLeHjxajIPHNUamHD2FKCySY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCfjHF4zDPSM7XFj7od2FgbgbcV-hGZTT5mRUoyElzCg&oe=6A564ACF"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dqQ3rT36Sz4Q7kNvwFK_8on&_nc_oc=AdqJ0anP6gvmByYTJAa25dAAA3uVzK4aAbrAyJy07I6s3n952p4YV8ccamUsV4GrSow&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2C6dVS5KqupfNG5YnaNvR2-f7ZJyRIc0gfFq2XRrRkw&oe=6A564494"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dViWh88LHK4Q7kNvwETsSK2&_nc_oc=Adpsq6FkG9S7Ia3M62KASkCR7C-EhW2bZVnmTrr63Uunv2cAfJ7D3dAkndVCYQUCqGY&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC7M8PU0JQpf7ADqcCvk_GViBrXIxL2DOAasEcNFJ1syQ&oe=6A5626BA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08kTCPCuAj8Q7kNvwFf91PD&_nc_oc=Ado7xfblSdNM0EKmBkVmyFmPpNWuYsAAhDbcXZQZjntI0vlIFH-Qdc0p668ZM3SMQO4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDksLB8fLZQ7dy7IuL_AGZUB8FoRGuolz5e39H5u3KjeQ&oe=6A564A98"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes
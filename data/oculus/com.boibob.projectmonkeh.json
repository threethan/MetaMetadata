my5p0pk-nRt-Nu3heQ&oe=6A52486E"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9e5x9ttxvEQ7kNvwGezic3&_nc_oc=Adogq0yAUTOKAg9IKKqv7VB_lj1nlzLbmxPW3P_0Oa7C9vmmMbp-ptd0tBnSsyuKEmM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAyX-fnPjWpV8o6hYsYNtVx2Nt35QHRkU3atl_Tn3v4g&oe=6A52564F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH9wOpxJSgYQ7kNvwFzUSyi&_nc_oc=Adr5vnOkHVxXmLY7J9a1SAMTYZ-UgGl1C1rYMAqe9LanxsFnrh1CeevklS96iKEwLbE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBd3IhGpVzkRFbHGDriiab7_uvZdA5AZJBWGkWO1yY-6A&oe=6A525014"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSG-RsNSROwQ7kNvwEkeIiZ&_nc_oc=Adp0A-xgGRAL06wU_miFvEf1i5nxAUh2Po7D9OKKmQ9Wmtq_c8WhW93wCZ-aQgu8AC0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-IoBAsyTOS1YxCob57gzLK5jDp4-_mXKeQeDhefqqhw&oe=6A52323A"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=12J3dxRDxu4Q7kNvwH7eV3g&_nc_oc=Adp8DK8DUyBb-1M-5eQGoiUJ4nhNASVpgF-sVaCk-EXgi91DHVrgptKM9nSVTbF4gng&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDjaXwW7B4gOYXHC3_1ghTC5bn0J-NNCWCE4JZOvuG5pQ&oe=6A525618"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes
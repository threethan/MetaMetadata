cYxNhYUeJJOJjeZjbvDkDw&oe=6A466AEE"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GWmSq8L7-CkQ7kNvwGCE0og&_nc_oc=AdqvNrTd31j-Kmr7-77EYw2qV1l1uO-He3FrQdKkNt4BCywq037UeCxoitD1uxNH59I&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8TgGBb-x6CYDuw_VnHPnSOnQsyphdU5IuriNiIm9tyYw&oe=6A4678CF"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LA-RnH_xxRMQ7kNvwEnv4A5&_nc_oc=Adr9TWGbMzXKX45aD_uL1gGt3IDFLmwXUbl427wr3YG7HcN2LBiEtYFoRxf7hPkJgvA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-J1eJ_NENvQvprj2C12vJpOJSDweOCcCzq5FDazDCB6w&oe=6A467294"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6hbDOncooEQ7kNvwEKzrt-&_nc_oc=AdrrQca3YymxUYI29m_9G3xEjLSdJOn7JRBMYGH-T_oJ8-Wr9jihDX1k0SWSVAEaoE8&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vsg0pBn9vAZiwFAb1x7_lgkwcgeY4YgxUJMcKNBvu9g&oe=6A468CFA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PiWz1-Kox6oQ7kNvwHQ25a4&_nc_oc=AdqTAMSZNDisyjAUq8u3nxO-qfK8pN-OtLxoPnHPfEGl-JowX3BqrBtXtiqJqpXcxu4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_HgBFdBq9t5mjp72NcjNJn8BcM3i9T6pEQRr-WbrpqAw&oe=6A467898"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking
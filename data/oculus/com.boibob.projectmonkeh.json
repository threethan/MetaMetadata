-gxJDc9IJxL1ZDxF0wDrfsa6HLyL2FI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUlI7z7VkC_grUNyrdSKjCZId_FHGH79JGIyJug1KdSw&oe=6AABEE6E"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xqaz0zw94PMQ7kNvwEjCUHW&_nc_oc=AdpVzDVMM2PD4SIjTHlnxBg8tE-2hjv_Zc-tktLbBgfe4MOmjPh9miQ6-8ix3rTgbSU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpXPjwezpLGJ2eiPiaO-F4_gaN1NSJOh3NPAuIepHlFg&oe=6AABFC4F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIOXBUazxo4Q7kNvwEAp9t4&_nc_oc=AdqbSa837o8iU_FO8i2HG9KrTBP4tmqClQzgRMQHBiJrR0OoFFVClaL003iZ8Cgse6k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnVQi1QwwflDcY3rHLFqDM3U61WenG_pJakFEE91olqA&oe=6AABF614"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WKZNnr63gCIQ7kNvwEZMmgB&_nc_oc=AdoBQAZtvTSBybm_F1ZUP95-ZQDd99_1OYSXrBbQHkfKU2YfgClmo071JOUyehHTvNY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzdBS9RADH3JpVvqkwo4gySqAXaEQQt7TvLpjdUdQSkQ&oe=6AAC107A"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dzwc8Z_3SbYQ7kNvwFnz6q9&_nc_oc=AdrYuJh4n9YCJ9ZamGynzKPEJA1yq6Jb1_wm52QPy-pOGAjQyiqUHupusxule_zr3q4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFfQhMHZnBfnPhRGzUs8DGuMZIqlAVRC7drrHq5A0KRQ&oe=6AABFC18"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
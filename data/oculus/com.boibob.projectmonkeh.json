.com/v/t64.5771-25/491827725_1220977922446596_3723773128899054793_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6_C4A3-DTEQ7kNvwH3Tc-t&_nc_oc=AdrHvDDFe65ZqH7ZDpHGM2hX0Rpm7o_LhjGqJur-OyCCbNsaRBIgZKukuL4pZjyBMWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQST9wsQGwvJarvqy0t_U93QvyRuRu-4LvMReqobpqV74g&oe=6B0C642E"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL6fjFzNjQ0Q7kNvwHtZLkk&_nc_oc=AdpAIqoJkjJtzFlVh1qojrFx-NyCIhXXBUEPWKfX5-buDhlrBX9qEI8gzVlu3zn2jzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRbMzVyZJ5_Uu-WVROcUlxxAqPX9gDPIWUa80HATX_ARA&oe=6B0C720F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=McngOpxifEsQ7kNvwHTu8pS&_nc_oc=AdrtswJ_C2pW1z5h7uHj4x3pzSkvVlA6NA8lbn8f6W2pNF1CUIQnKZaySGlsIDlIC6U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ_k2otMC8ZRqGwv0E9qMjfN0IdxLeMpnZOyJzLg-L-hQ&oe=6B0C6BD4"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RLjsoWPVUMQ7kNvwGd4QZU&_nc_oc=AdpvOL7fFcIlnuWM7dvFX4P9DgAJGsfwFHrsiXnGKSUWUD-r0SZ2nW-elop7340cung&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBILgtOKWHxxanBFXpWJHzUsAO4XKut7u-5VdW7N-gfg&oe=6B0C4DFA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxCqKi6nYzIQ7kNvwFwyNDP&_nc_oc=AdpS-l4KSG6fHaCkG78IbM1ed7UoLhHA8Xbaj1cglGV9bJ-2hfiCE8miPYE_iCmEwNs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSneD4LaLp6CGQC79-lCoJXoljM7h6O2C5BnJx-ESlCHg&oe=6B0C71D8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_to
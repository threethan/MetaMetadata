o96kLEG9uXXadqZ-Xw&oe=69EF67EE"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eTSFVb7GUU0Q7kNvwFSvhSw&_nc_oc=Adrh7IlW0nqICsVsvGkEV_dgBO0BLoyWUSRAcF3pgh19AvLXOQ_LIH27hBJkc-4O6_c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2eCHOxXjgaLVT_ukOgBgMO_zFFUO41sGmZfCS2d15lcg&oe=69EF75CF"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uM7YZ83CItgQ7kNvwFpmUJL&_nc_oc=AdqWJlFUzWwzHDM1TPJk47afELcVLkjl6yiWg8iqzhxwHqubp4L2BB2JVCb9eH0g0BM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1wL6pDWEpR4bU09VbGnrW0JM_GJUshs7nu6gqqQZGInA&oe=69EF6F94"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldduH3T7i70Q7kNvwE-fvnP&_nc_oc=AdotQg-g0UfA37VRi0tbkNszonrZJPKYCLcnwfiIWDGoKQcoSxaMrt5tkj2Xy5TWWO0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0wpAX5fXdl_QJKUue0fL8O4JtAH_k29CumICQ3muFUUg&oe=69EF51BA"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ksg-l7Qnb5IQ7kNvwHMhPoU&_nc_oc=AdpwklNPxjetvh1zuH4RNyDEnYdXuALh7wiAyAvT8FSX9L1Ya_j_sD3UQ18N9ANCsqw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2--yJaW3mHw0vOiw1PO3tHOLospoaONXgIOok-w4uxvg&oe=69EF7598"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes
GU2Xqle0n9_oRWz8Lk6KOV8NsT4_Zro&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlm4g-0Z8XdCuaRbnauKz0y5fAOGiXuQMgRDZQKu_XkA&oe=6AE8936E"}, {"file_name": "Screenshot 2.png", "id": "1806756293604145", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/507840144_1806756296937478_170569489731509790_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wkQ-tFcB618Q7kNvwE_FWsw&_nc_oc=AdpteNhVlu1ounRPh_H63mQKjNPp6CNXCd2bAzfi4Bs7bBvc06ieP-COmn46AEG7-A4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRN4rmB4erOyRFdh6vMCzj_38iwl9k-M3a5CJetXV27ww&oe=6AE8A14F"}, {"file_name": "Screenshot 3.png", "id": "548023738246664", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827725_548023741579997_2367572761922622653_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xVeTYJoa1nwQ7kNvwEGK-xx&_nc_oc=AdrTlwVRDGUCKW-WGoPnawxz1bjXx67QiNworoXnIbScerkiCeQyJe-S87tOJXPZRYQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSP4vRZ-xJjT6pYoSNIuW2Lxb-ijDSQd12Q9FYabteu3g&oe=6AE89B14"}, {"file_name": "Screenshot 4.png", "id": "1043465811223282", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827725_1043465814556615_4450334846848160969_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kMaSmTxX9aMQ7kNvwH-waPQ&_nc_oc=AdoRqINNuVxtpo3sKWLYZvgpMxO2JNj0tUcdbbJ5PWy0DS6d2QunU3TBcU56y80KuRc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzWWb-0IVM3HNod9z6i2X2HTianOnIajUSGfw3HpedGg&oe=6AE8B57A"}, {"file_name": "Screenshot 5.png", "id": "1041159164863692", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831276_1041159171530358_652833371072058434_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48RpRlEiPcYQ7kNvwEEGw_h&_nc_oc=AdqLRqYubMl8gE6XRjPr40gXFzAjGlvXx5MSuLjLFo5D0CaXCBuvEEw-bggxyZlL1Yg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHP-FQi0stJSWEx2RlJCNJvLUTAHuFEgnYN8n6zk7E4A&oe=6AE8A118"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project Monkeh", "keywords": ["monkeh", "monker", "project"], "long_description": "Welcome to a jungle different from all others, where evolution took a surprising turn and the monkeys have no legs\u2014but that\u2019s never stopped them before. In Legless Monkeys, you\u2019ll be leading a band of wily, wheel-bound primates as they sling, slide, and launch themselves through a world of banana-fueled madness. With precision timing, you\u2019ll make them swing; you\u2019ll cause them to master the use of momentum; and you\u2019ll have them defy gravity in stunts that would make a real-life primate envious. Dodging their deaths by jungle traps, rival animals, or the occasionally puzzled zookeeper, these brave behavior hackers will uncover the ancient secret of the Missing Limbs in multiplayer mayhem or solo story mode. Agile, unpredictable, and outrageously fun\u2014Legless Monkeys shows that you don\u2019t need legs to kick butt.", "short_description": "Project Monkeh is a wild ride through the jungle where monkeys have no legs, but a ton of attitude. They bounce, roll, and swing their way past danger, proving you don\u2019t need limbs to live life on the edge. Pure chaos. Surprisingly graceful. Totally bananas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/project-monkeh/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "cosmo inc.", "support_website_url": null, "website_url": "https://sites.google.com/view/project-monkeh/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"],
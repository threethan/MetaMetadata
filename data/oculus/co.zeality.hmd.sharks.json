c_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=efDEwl3N_EgQ7kNvwFKNsGB&_nc_oc=AdnsFBaNj7l8OJsDoZKSJTKwBnQ5P-BNtG8SEdlvYDUF_IcA8-R1kRu1u2LUoaOMjRY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftukOc0CiJxIHZlwIhuQBfvdAw_6-F_pDsgyvaPR2Ekuw&oe=69A41DBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "San Jose Sharks VR", "keywords": ["Sharks", "Hockey", "Sports", "NHL", "Ice"], "long_description": "The San Jose Sharks are the first and only NHL team to build their own Oculus VR application, delivering rare and exciting content in full VR/360\u00b0 to fans everywhere. Get up against the glass at the Shark Tank or go behind the scenes at the SAP Center for rare post game experiences in 360\u00b0 with one of the best teams in the NHL. \n\nBy partnering with Zeality Inc., the Sharks have created a new platform exclusively for Oculus VR to give fans an exciting way to watch and engage with their favorite NHL team. Zeality\u2019s unique patent-pending social features is revolutionizing how fans experience VR and 360\u00b0 content from anywhere in the world. Download the new San Jose Sharks Oculus VR App on your Samsung Gear VR today.", "short_description": "The San Jose Sharks are the first and only NHL team to build their own Oculus VR application, delivering rare and exciting content in full VR/360\u00b0 to fans everywhere. Get up against the glass at the Shark Tank or go behind the scenes at the SAP Center for rare post game experiences in 360\u00b0 with one of the best teams in the NHL."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zeality.co/privacy-policy/", "developer_terms_of_service_url": "http://www.zeality.co/terms-and-conditions/", "publisher_name": "Zeality Inc.", "support_website_url": null, "website_url": "http://www.zeality.co/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "g
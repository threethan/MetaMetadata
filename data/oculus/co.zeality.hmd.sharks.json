HInLY0HwI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzsRZ9sc06Gg7lmFgl5eP9H8etx_ereU_1cqjT1TtTGg&oe=6ACE39DB"}, {"file_name": "migrated_image.png", "id": "643080643136269", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_1854490231546123_4099980088613797888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqXPsNLcmpAQ7kNvwGAFJnm&_nc_oc=Ado2gjfhHq68FmNAddCMN18QoLnZecsdvNgpYJh7y6HQJmTutkYrJgcpGqyXlvnLqI4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNssZXNjs-g4L0yvel2XXrG_1klmkCHqlUK7elx-L19vQ&oe=6ACE48FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "San Jose Sharks VR", "keywords": ["Sharks", "Hockey", "Sports", "NHL", "Ice"], "long_description": "The San Jose Sharks are the first and only NHL team to build their own Oculus VR application, delivering rare and exciting content in full VR/360\u00b0 to fans everywhere. Get up against the glass at the Shark Tank or go behind the scenes at the SAP Center for rare post game experiences in 360\u00b0 with one of the best teams in the NHL. \n\nBy partnering with Zeality Inc., the Sharks have created a new platform exclusively for Oculus VR to give fans an exciting way to watch and engage with their favorite NHL team. Zeality\u2019s unique patent-pending social features is revolutionizing how fans experience VR and 360\u00b0 content from anywhere in the world. Download the new San Jose Sharks Oculus VR App on your Samsung Gear VR today.", "short_description": "The San Jose Sharks are the first and only NHL team to build their own Oculus VR application, delivering rare and exciting content in full VR/360\u00b0 to fans everywhere. Get up against the glass at the Shark Tank or go behind the scenes at the SAP Center for rare post game experiences in 360\u00b0 with one of the best teams in the NHL."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zeality.co/privacy-policy/", "developer_terms_of_service_url": "ht
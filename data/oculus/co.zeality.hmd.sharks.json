2LvQH9ZeE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlAVzMhULWuDByvKVVTpbA3gpJJsCzrnZqNEDCvcmruA&oe=6AB921DB"}, {"file_name": "migrated_image.png", "id": "643080643136269", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/11162687_1854490231546123_4099980088613797888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4AX3xvO6O00Q7kNvwH6TOiT&_nc_oc=AdomSKiNZHuo7stdMt3NCxk5oYjTrf1nNTj2dISzL1Y2sitCOzfvW3kmSEIzdGIoe_4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyXpRzdfx_qrrmaE0ygHsHT_kaBTpSn9hKn00nGenyag&oe=6AB930FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "San Jose Sharks VR", "keywords": ["Sharks", "Hockey", "Sports", "NHL", "Ice"], "long_description": "The San Jose Sharks are the first and only NHL team to build their own Oculus VR application, delivering rare and exciting content in full VR/360\u00b0 to fans everywhere. Get up against the glass at the Shark Tank or go behind the scenes at the SAP Center for rare post game experiences in 360\u00b0 with one of the best teams in the NHL. \n\nBy partnering with Zeality Inc., the Sharks have created a new platform exclusively for Oculus VR to give fans an exciting way to watch and engage with their favorite NHL team. Zeality\u2019s unique patent-pending social features is revolutionizing how fans experience VR and 360\u00b0 content from anywhere in the world. Download the new San Jose Sharks Oculus VR App on your Samsung Gear VR today.", "short_description": "The San Jose Sharks are the first and only NHL team to build their own Oculus VR application, delivering rare and exciting content in full VR/360\u00b0 to fans everywhere. Get up against the glass at the Shark Tank or go behind the scenes at the SAP Center for rare post game experiences in 360\u00b0 with one of the best teams in the NHL."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zeality.co/privacy-policy/", "developer_terms_of_service_url": "ht
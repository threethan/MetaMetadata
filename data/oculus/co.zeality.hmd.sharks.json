6439284039680_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8x7MFC_xT44Q7kNvwExRveF&_nc_oc=Adp4KYkiToOGwhABvmL6ExH-WhTNDrLazEG33NQTjj1FC_YTejWD6-wkGfGDMeSJ9es&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1ukQUPc6GS7a-ChFstAytFpjFnejd0DuTleUjgmT3DHg&oe=69F21041"}, {"file_name": "migrated_image.png", "id": "212392556673832", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162681_1479006138841745_1058122479643394048_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Yaypom0aiEQ7kNvwEwZdtG&_nc_oc=AdpnI6eO9PhCJbnUy7Puu-ShWMC45BnmC-N6M4FW_8n_tWCxkurASZd7UcDpvrPL4mw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af0q194r6M9WqEjHK6ZKuCikPr96jFkjyYbR7PvamgpH9w&oe=69F1E515"}, {"file_name": "migrated_image.png", "id": "2963322393734864", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162676_1306308732812695_4569914648270209024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gx5EhvKDImkQ7kNvwHNScp1&_nc_oc=Adq-iG3VAnKXuFCd2OiiEJ0sGu6PO9patN59f6RJJMR1jX9WmDT1TjXebuMKjWbs36o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2HgcmQd34o0C0pquw_jdgS2OigMHz2liWWeD_RRqz0hQ&oe=69F20F5B"}, {"file_name": "migrated_image.png", "id": "643080643136269", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/11162687_1854490231546123_4099980088613797888_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WnzTGk-IcQwQ7kNvwHXSBt_&_nc_oc=AdojfGFrDeRE3ZJV2kTL2xlh6lCxfuYtcxF77t9DSV40FL7RH47S7b3u9lDnfm0-h48&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3Bh8TL9ECdMCQVIP9A7_7WHNtlUR24r6lBtcmORZo8kQ&oe=69F1E63F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "San Jose Sharks VR", "keywords": ["Sharks", "Hockey", "Sports", "NHL", "Ice"], "long_description": "The San Jose Sharks are the first and only NHL team to build their own Oculus VR application, delivering rare and exciting content in full VR/360\u00b0 to fans everywhere. Get up against the glass at the Shark Tank or go behind the scenes at the SAP Center for rare post game experiences in 360\u00b0 with one of the best teams in the NHL. \n\nBy partnering with Zeality Inc., the Sharks have created a new platform exclusively for Oculus VR to give fans an exciting way to watch and engage with their favorite NHL team. Zeality\u2019s unique patent-pending social features is revolutionizing how fans experience VR and 360\u00b0 content from anywhere in the world. Download the new San Jose Sharks Oculus VR App on your Samsung Gear VR today.", "short_description": "The San Jose Sharks are the first and only NHL team to build their own Oculus VR application, delivering rare and exciting content in full VR/360\u00b0 to fans everywhere. Get up against the glass at the Shark Tank or go behind the scenes at the SAP Center for rare post game experiences in 360\u00b0 with one of the best teams in the NHL."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zeality.co/privacy-policy/", "developer_terms_of_service_url": "http://www.zeality.co/terms-and-conditions/", "publisher_name": "Zeality Inc.", "support_website_url": null, "website_url": "http://www.zeality.co/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["SPORTS", "SOCIAL", "MOVIE", "NARRATIVE"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7086789728028698"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/11162702_483101372063451_3671084151924064256_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2juBhTAtlMQ7kNvw
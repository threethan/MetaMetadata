.com&_nc_ss=7f20f&oh=00_AQQRZhGWeNTq8UyFzSxtTyt8vuGR957f-AXYZUFrxbG3BA&oe=6B00793F"}, {"file_name": "screen_2560x1440_2023-03-18_19-53-39.png", "id": "5856095431174224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371511_5856095441174223_980006476129001742_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMHUrgjm3rkQ7kNvwH-qPFu&_nc_oc=AdqabGpPdSaSPzLb0SYRdWBh9WkrfNBF29FVvr4i9Bl0DAuPfNJ4rh3uvXMqPr-yNTY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSuGIZopbbPzyKrEd5gh782V5ot7X9DQL1oJSlO-By6Q&oe=6B008382"}, {"file_name": "screen_2560x1440_2023-03-18_19-52-47.png", "id": "230252092836540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982523_230252096169873_7421664140117665238_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9XfaQ_FagEQ7kNvwGcONWn&_nc_oc=AdrORed5mPe_rwif0Cz9TyMbRwNWnABrtoeYWP5IispoKvaVIrocM4-66x1PbVr-e4s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPWHgEyALREBA37ebHkZDe2RoMIfgqguF42E6s-fhQrQ&oe=6B0060E7"}, {"file_name": "screen_2560x1440_2023-03-18_19-51-33.png", "id": "913956666476400", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_913956669809733_3423329136682682156_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbqbeHvlWxwQ7kNvwFp401e&_nc_oc=AdoQICih02fjiOMuR7nqKE5rgHa47BgD0Fj4fqKLW0p9-5L_wh8X0lc3d9SmzEdgVI8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS94OGy_1xZwOiSQ45BynrTUwlPEvdyWQOMKmjU6GMubA&oe=6B00531C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oyan XR - your mirracle morning", "keywords": [], "long_description": "People are always evolving and our goal is to help you find the best approach to this goal \u2014 be the person you are dreaming about to be. As you enter the virtual world, you'll be greeted with serene environments and calming soundscapes. You can choose to start your day with a cognitive training session, where you'll be guided through a series of methods that awaken your body and mind. Alternatively, you can opt for a breathing exercise that helps you center your focus and reduce stress. And if you're short on time, the app also features quick, five-minute routines that can be easily incorporated into your busy morning routine.", "short_description": "With Oyan XR, you can transform your morning routine into a powerful tool for personal growth and self-care. Start your day with intention, focus, and energy, and discover the positive impact that a fulfilling morning ritual can have on your life."}]}, "developer_name": "Khakim Yessenzhanov", "developer_privacy_policy_url": "https://hackstr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "black box studio, Inc", "support_website_url": null, "website_url": "https://hackstr.github.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "903567277528092"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974738_1414455065744163_2210164120303131027_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Tyz2RrgAY8Q7kNvwFu3Qct&_nc_oc=Adr_byf7Njs3Fr4mherngkF9PqxjPoeRlfxP93QgRNL-2JInTADPaXezlahh5e0gbcE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
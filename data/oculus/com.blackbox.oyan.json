1511_5856095441174223_980006476129001742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l_baAjcb14oQ7kNvwEiEN8E&_nc_oc=AdqXX2WVq00nnDAr0G6bBj5j49aCzE3U1y4tjkHYP7_dEaTxB4lDxpAo_aLRVWfLQ5U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz_FMIOheYSP1zu2fYKF5_KYptuvtVc4nbfZqkaGVaaHQ&oe=69CA7AC2"}, {"file_name": "screen_2560x1440_2023-03-18_19-52-47.png", "id": "230252092836540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982523_230252096169873_7421664140117665238_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_e94Ui8s6EMQ7kNvwHoeyDD&_nc_oc=AdoL-I3ZGSK9UK20fd7WVkUKknBuHreHpeTAuEE6L1rlCV2eFT1nUL9PoAdNdWst6KQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1K2XBhu6DLwgoy0pm9X12wDR0XHly22EUoPXTjAZ71Q&oe=69CA5827"}, {"file_name": "screen_2560x1440_2023-03-18_19-51-33.png", "id": "913956666476400", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974593_913956669809733_3423329136682682156_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUFsWsvMKXEQ7kNvwFFzZj0&_nc_oc=AdqRxoqef2dbpQNtIpWNCyT9hS4Tjcv_9L-AvlsF4-RUHZETqAne_sVzhPVCYczLdcM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyVe7bv6FI1oBZkFEm87LqQ1dYf5x8mocA5srNRrlN51A&oe=69CA829C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oyan XR - your mirracle morning", "keywords": [], "long_description": "People are always evolving and our goal is to help you find the best approach to this goal \u2014 be the person you are dreaming about to be. As you enter the virtual world, you'll be greeted with serene environments and calming soundscapes. You can choose to start your day with a cognitive training session, where you'll be guided through a series of methods that awaken your body and mind. Alternatively, you can opt for a breathing exercise that helps you center your focus and reduce stress. And if you're short on time, the app also features quick, five-minute routines that can be easily incorporated into your busy morning routine.", "short_description": "With Oyan XR, you can transform your morning routine into a powerful tool for personal growth and self-care. Start your day with intention, focus, and energy, and discover the positive impact that a fulfilling morning ritual can have on your life."}]}, "developer_name": "Khakim Yessenzhanov", "developer_privacy_policy_url": "https://hackstr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "black box studio, Inc", "support_website_url": null, "website_url": "https://hackstr.github.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "903567277528092"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974738_1414455065744163_2210164120303131027_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lxRhLK6fJYQ7kNvwEn8HsT&_nc_oc=AdrnPwkq0UHfYAzlivzONYMSKd1R3oZAxXYD08alsiKLVzITJHxinjJCDuii0aPiv1U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1-ydFYJJA3DiCLMSezX_M9lJCnbkyEPjj_GZOO-6YxA&oe=69CA705E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Oyan XR - your mirracle morning", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fi
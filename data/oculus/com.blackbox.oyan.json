1511_5856095441174223_980006476129001742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7N8fn_k-xQUQ7kNvwEV2Doa&_nc_oc=AdoMtJVV71tYrIUEBGg6NH43HcEaBhKP7J0G8CYIz0VxChC46ToeR0KZXHuuYfyiP6c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mZjrnw2PnzQoFEYAI7iE1UWR-GGtS6oofsWVQIes5lA&oe=69D506C2"}, {"file_name": "screen_2560x1440_2023-03-18_19-52-47.png", "id": "230252092836540", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982523_230252096169873_7421664140117665238_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPQRSuTB_sgQ7kNvwH5yg5E&_nc_oc=Adoxel3stS4tfbefcgmQxC5qI8vqy-dZ39UCwywKwilYtOfjmh0M7X2k5x83fZ922TQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MJ_xMziD3TrC9aOz5VcS9k9ediOeL1JPbnkv0qjhx9w&oe=69D4E427"}, {"file_name": "screen_2560x1440_2023-03-18_19-51-33.png", "id": "913956666476400", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974593_913956669809733_3423329136682682156_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tXcFu8WTmr4Q7kNvwEUCWnB&_nc_oc=Adr0SqxmKarnI9cNO79kujMEsUTXCPD8iWe6YygtC2_bpHx48Bz_AzmOKtxs59wEkRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MGpXq-ylSB7DnL6bw5aDvjRTJqDiI8ELI1kNuJQ_Z0A&oe=69D50E9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oyan XR - your mirracle morning", "keywords": [], "long_description": "People are always evolving and our goal is to help you find the best approach to this goal \u2014 be the person you are dreaming about to be. As you enter the virtual world, you'll be greeted with serene environments and calming soundscapes. You can choose to start your day with a cognitive training session, where you'll be guided through a series of methods that awaken your body and mind. Alternatively, you can opt for a breathing exercise that helps you center your focus and reduce stress. And if you're short on time, the app also features quick, five-minute routines that can be easily incorporated into your busy morning routine.", "short_description": "With Oyan XR, you can transform your morning routine into a powerful tool for personal growth and self-care. Start your day with intention, focus, and energy, and discover the positive impact that a fulfilling morning ritual can have on your life."}]}, "developer_name": "Khakim Yessenzhanov", "developer_privacy_policy_url": "https://hackstr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "black box studio, Inc", "support_website_url": null, "website_url": "https://hackstr.github.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "903567277528092"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974738_1414455065744163_2210164120303131027_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ns4NbRb5bnUQ7kNvwHVUSp8&_nc_oc=AdqxhXf7zDu7qKF5Mcc3wNHuqxcGjyj038x_9xja649jeq7SvE3IxLRHRpwi2TxZWug&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WuN5LoJtQyUjjTL1SiS6wyG7tz4ciXK7-WU9knJ_M_g&oe=69D4FC5E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Oyan XR - your mirracle morning", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fi
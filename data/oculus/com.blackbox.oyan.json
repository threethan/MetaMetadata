.com&_nc_ss=7f20f&oh=00_AQT15imTgH5Lwynf4T7gEx8shxOE0GSAn_44iFeJnIxLDw&oe=6AFC84BF"}, {"file_name": "screen_2560x1440_2023-03-18_19-53-39.png", "id": "5856095431174224", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/75371511_5856095441174223_980006476129001742_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZcOYVLcB2_oQ7kNvwGKMGRK&_nc_oc=AdrZZ0NWp9roJ5NnIBT6j44El4XmojRps35FN5mYX-i9l4AIHZ-YVx3pa-tehHRVhc4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx4RYj97fE2hJQX-OWjvv3m5x0vNf78aXDi3yoBJRbiw&oe=6AFC8F02"}, {"file_name": "screen_2560x1440_2023-03-18_19-52-47.png", "id": "230252092836540", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982523_230252096169873_7421664140117665238_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ub7THs7UTYQ7kNvwGSq3T5&_nc_oc=AdqDN40mr29gEU66r3D_pFhiXLupEa0mbNqKCuhDcw7nA8ckWF0H0Ka3xhshoqN6ARU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgbU5dr18agqgTT6yejSw2NNakP9Xu74bQ6sUqyOywLg&oe=6AFC6C67"}, {"file_name": "screen_2560x1440_2023-03-18_19-51-33.png", "id": "913956666476400", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974593_913956669809733_3423329136682682156_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RPYPpZBa5MQ7kNvwGvwwlk&_nc_oc=AdroWWrg69OR6fL-HyehsrceexCZ2A7rMPx4jRyqj8YGJxr3Z16_9yqYV9H4Ys9e12U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvTqBQkjL-z3Fq3q5jEBhhIOBn2uMiHLjCjWdiqFVw9w&oe=6AFC5E9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oyan XR - your mirracle morning", "keywords": [], "long_description": "People are always evolving and our goal is to help you find the best approach to this goal \u2014 be the person you are dreaming about to be. As you enter the virtual world, you'll be greeted with serene environments and calming soundscapes. You can choose to start your day with a cognitive training session, where you'll be guided through a series of methods that awaken your body and mind. Alternatively, you can opt for a breathing exercise that helps you center your focus and reduce stress. And if you're short on time, the app also features quick, five-minute routines that can be easily incorporated into your busy morning routine.", "short_description": "With Oyan XR, you can transform your morning routine into a powerful tool for personal growth and self-care. Start your day with intention, focus, and energy, and discover the positive impact that a fulfilling morning ritual can have on your life."}]}, "developer_name": "Khakim Yessenzhanov", "developer_privacy_policy_url": "https://hackstr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "black box studio, Inc", "support_website_url": null, "website_url": "https://hackstr.github.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "903567277528092"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974738_1414455065744163_2210164120303131027_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pXB1JSiTwqMQ7kNvwEEhens&_nc_oc=AdoDUJnPHETpwuCsbHGljEPmdCEfVtRUDFzRTAl0dwdOzvkPpfjylWViODrYKDNffGk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_
64.5771-25/75371511_5856095441174223_980006476129001742_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GucNr07hmFIQ7kNvwF6YvDe&_nc_oc=AdqvMLkQfE15_NNzXQkgrwpZ1RfSfWLfL5hgVf9OccND8tOgcwmqfN0VeED7oBPC02A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG0gS0n4iNTL2mUK06ePIdQrN-Hy8-RDJtpzszICDyhMA&oe=6A8D98C2"}, {"file_name": "screen_2560x1440_2023-03-18_19-52-47.png", "id": "230252092836540", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982523_230252096169873_7421664140117665238_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sN4AGw_7_GIQ7kNvwEVBieZ&_nc_oc=Adq0ziNby6EDOgzgL8IRyeIbWTW4COTt1uh8B_siVqbt8CxNKSrALXcRaqfEB7g9PmI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGbgCbv5sdEFWZRjAWm0bKQZPo9fIUkoaoTmO5u1cMsIw&oe=6A8D7627"}, {"file_name": "screen_2560x1440_2023-03-18_19-51-33.png", "id": "913956666476400", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38974593_913956669809733_3423329136682682156_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aw2sR8qleuEQ7kNvwHwBRZt&_nc_oc=AdqrWGx3raFwUEsqwcySbqArM2x5Z7jYhLirpM2jkUv68PimKlg0flA8peMtt-TCkX8&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHY06d12tUpbjIQelnXwTzHcfkWg4GfrQV7LiFNkYaWmQ&oe=6A8D685C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oyan XR - your mirracle morning", "keywords": [], "long_description": "People are always evolving and our goal is to help you find the best approach to this goal \u2014 be the person you are dreaming about to be. As you enter the virtual world, you'll be greeted with serene environments and calming soundscapes. You can choose to start your day with a cognitive training session, where you'll be guided through a series of methods that awaken your body and mind. Alternatively, you can opt for a breathing exercise that helps you center your focus and reduce stress. And if you're short on time, the app also features quick, five-minute routines that can be easily incorporated into your busy morning routine.", "short_description": "With Oyan XR, you can transform your morning routine into a powerful tool for personal growth and self-care. Start your day with intention, focus, and energy, and discover the positive impact that a fulfilling morning ritual can have on your life."}]}, "developer_name": "Khakim Yessenzhanov", "developer_privacy_policy_url": "https://hackstr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "black box studio, Inc", "support_website_url": null, "website_url": "https://hackstr.github.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "903567277528092"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974738_1414455065744163_2210164120303131027_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6a-hAWD2bI4Q7kNvwEpUcrU&_nc_oc=AdprXtZ1y2qGm17dXp1nCY5wDfCngAAH76wqu0w6QHWklHORrkcuYLMYyoAW0A0erE4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqhac5RuU6416oGSMoHQHpaBnQFqZz5j9fAHjJ0dce9Q&oe=6A8D8E5E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Oyan XR - your mirracle morning", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics":
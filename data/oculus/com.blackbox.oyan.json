.com&_nc_ss=7f20f&oh=00_AQTuVCtlYnO1OfpB_3p6nlyav2JFPX26lLoBiO9ahNTfsw&oe=6B01CABF"}, {"file_name": "screen_2560x1440_2023-03-18_19-53-39.png", "id": "5856095431174224", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75371511_5856095441174223_980006476129001742_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMHUrgjm3rkQ7kNvwGiF46w&_nc_oc=AdqwbV86Bs-9eV40_zctjX5Okb_-QT6kEX0bqvTI0esKc6U2n-1Qh54kaS78dLUXZz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgP5zE3vHAm11iO95n45xX66UFcAxySHJLf8DhyIDC6A&oe=6B01D502"}, {"file_name": "screen_2560x1440_2023-03-18_19-52-47.png", "id": "230252092836540", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982523_230252096169873_7421664140117665238_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t9XfaQ_FagEQ7kNvwHIJUzg&_nc_oc=AdrOFD0yIdMY3Y0WaLgGy56vw-b_OzpnIjocrUT-hVTtOuM73y5Bt1SmwTX_6PaWctk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVTN9RpZOIDrr8XWkjMNpaAh6dJ9Jkq_9zXmMwK9ODEw&oe=6B01EAA7"}, {"file_name": "screen_2560x1440_2023-03-18_19-51-33.png", "id": "913956666476400", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974593_913956669809733_3423329136682682156_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YbqbeHvlWxwQ7kNvwHcdwoD&_nc_oc=AdrQR3p2pyACRBmHusv7yODQ64uWSn8owSSkCn6QsnBEyjdK3gvQ5ThC3qzEU8QwwEE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSD-rTnk04iUIKAH5FVU5nr_dQz0dTrb8QfeT2nrUU97g&oe=6B01DCDC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oyan XR - your mirracle morning", "keywords": [], "long_description": "People are always evolving and our goal is to help you find the best approach to this goal \u2014 be the person you are dreaming about to be. As you enter the virtual world, you'll be greeted with serene environments and calming soundscapes. You can choose to start your day with a cognitive training session, where you'll be guided through a series of methods that awaken your body and mind. Alternatively, you can opt for a breathing exercise that helps you center your focus and reduce stress. And if you're short on time, the app also features quick, five-minute routines that can be easily incorporated into your busy morning routine.", "short_description": "With Oyan XR, you can transform your morning routine into a powerful tool for personal growth and self-care. Start your day with intention, focus, and energy, and discover the positive impact that a fulfilling morning ritual can have on your life."}]}, "developer_name": "Khakim Yessenzhanov", "developer_privacy_policy_url": "https://hackstr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "black box studio, Inc", "support_website_url": null, "website_url": "https://hackstr.github.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "903567277528092"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974738_1414455065744163_2210164120303131027_n.png?stp=dst-png_s360x360&_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EooMx2Juq5gQ7kNvwF5iFeB&_nc_oc=AdpcTQwPUoh1YrjzTcoV8fochJToXPR_gJZLGUjW0V9aM9sRv_qcV4hOybEEYWT9ncc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_
_oc=Admi5MbPutVjBk8LM49IiyzS3IQazYSD_5gBRlscrvonagSpauXA3eJ-Fa7b2ZRLtIM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvE4Jjreq_vjRRGnapIm20n__DsWQiW2i4jm2Hhru6New&oe=69A6E242"}, {"file_name": "screen_2560x1440_2023-03-18_19-52-47.png", "id": "230252092836540", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982523_230252096169873_7421664140117665238_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQoN8ics8msQ7kNvwHREUOu&_nc_oc=Adno7NWdqX6irbWl7FvQ8w0naMctahMpmmGh94Gw_dV2XpBkBaJCsxYvtL-401DHIis&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsclcIEG2T1N_1yiKb32fNkm5czaclRMQ1OwlzohCgwhw&oe=69A6BFA7"}, {"file_name": "screen_2560x1440_2023-03-18_19-51-33.png", "id": "913956666476400", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974593_913956669809733_3423329136682682156_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh0_UnFGSh4Q7kNvwFAjnJE&_nc_oc=AdmNFOKP9LZaxS3n5SAvpAEhjHEAFbu5vTPOveDFqNI-rPa06tYzgHuMoY3Bzb22lok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsJ1GVdR7EGSZx1Yax3s86diCv4kH1p_pSLTJgeBKW5rA&oe=69A6EA1C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oyan XR - your mirracle morning", "keywords": [], "long_description": "People are always evolving and our goal is to help you find the best approach to this goal \u2014 be the person you are dreaming about to be. As you enter the virtual world, you'll be greeted with serene environments and calming soundscapes. You can choose to start your day with a cognitive training session, where you'll be guided through a series of methods that awaken your body and mind. Alternatively, you can opt for a breathing exercise that helps you center your focus and reduce stress. And if you're short on time, the app also features quick, five-minute routines that can be easily incorporated into your busy morning routine.", "short_description": "With Oyan XR, you can transform your morning routine into a powerful tool for personal growth and self-care. Start your day with intention, focus, and energy, and discover the positive impact that a fulfilling morning ritual can have on your life."}]}, "developer_name": "Khakim Yessenzhanov", "developer_privacy_policy_url": "https://hackstr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "black box studio, Inc", "support_website_url": null, "website_url": "https://hackstr.github.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "903567277528092"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974738_1414455065744163_2210164120303131027_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VAG-f2FFH4Q7kNvwFiQDvX&_nc_oc=AdnI1BXxdxdnI6ALjrxBMkTO9lPTRi1Y0GhQaNkCGi7A-TtGkegjCpx_rqVRdDB7EuQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfudIJTRgCKqnKP1idY_QkhFnPPMu_cdYEqYReP5dE-bMg&oe=69A6D7DE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Oyan XR - your mirracle morning", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1659627211, "lastRevision": {"nodes": [{"id": "5174414006004443", "release_type": "SCHEDULED", "administrat
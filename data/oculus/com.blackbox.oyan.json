cdn.com/v/t64.5771-25/38974472_385754466811800_8513273206439066396_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8lg4PbwAgb8Q7kNvwGEMmrW&_nc_oc=AdrAW8hktUHsVKfEv9v5vi7DhNly6b_IZIyQT1HRDq34beYIai0PJHK5Z_05Q1Do_p0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS1MCC5LQZ2nJ1cNvhGjNeWPCoXdWsNPiLO38z2WuE0eg&oe=6B0319A0"}, {"file_name": "screen_2560x1440_2022-07-23_18-21-23.png", "id": "421466796605313", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031627_421466799938646_4903375708515772592_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E798M9oL668Q7kNvwEvTbHI&_nc_oc=Adrsj5mPPLXuXoSoyhadH47qTqfXFNfpFw6U8ewgEYeciZaV-P6cuv2V2dqHYSWt-tc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyqD1gwjKSRI4x4kySFSvLybu9q3uU5OUYK4EMpivc8A&oe=6B03288C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oyan", "keywords": [], "long_description": "People are always evolving and our goal is to help you find the best approach to this goal \u2014 be the person you are dreaming about to be. Activities that you are going to accomplish include meditations, hydration, exercises to train your brain and affirmations to keep you on track. Also we have developed additional features such as diary, where you can share everything that in your mind and the calendar where you will be able to track your progress in this journey. All the journeys start from the first step. You and your wellbeing is the most important thing in your life. Healthier and happier life is not a dream, it is a reality that can be achieved. Do not afraid or hesitate to try. You can and you will become the best person with this VR app. Let's do it!", "short_description": "Oyan \u2014 interactive VR experience that will help you to become the better version of yourself. Achieve your personal goals by completing tasks and activities."}]}, "developer_name": "Khakim Yessenzhanov", "developer_privacy_
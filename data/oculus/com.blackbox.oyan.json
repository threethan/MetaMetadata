_oc=Adk4Rb8BIIBK_aMz5ZxJS_6vA25EHXvRavbdTUOKpaITmkmDJNsDDtghfYt7zrThSiU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft2dItd5lWw2E-sMjnNDVd-K-mduunOm8RTr-FdSHKHVQ&oe=699EF942"}, {"file_name": "screen_2560x1440_2023-03-18_19-52-47.png", "id": "230252092836540", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982523_230252096169873_7421664140117665238_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d_IovFAVQH4Q7kNvwHka-CR&_nc_oc=AdmdIqeQ8XueHfbyr4GPZTyOwz6oUtb4pjX3W4IStaqzX1BIaYkx__AiRoCl3byqS-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aftv-ZmsTonIoLnpGkCr7ZVuWSdpiMPo0TrS4RcQrf8kHw&oe=699ED6A7"}, {"file_name": "screen_2560x1440_2023-03-18_19-51-33.png", "id": "913956666476400", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974593_913956669809733_3423329136682682156_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fq4CPsCTQKAQ7kNvwEjBcrL&_nc_oc=Adko-MPQAvezadjegy7VsEPPbGbcozWfWbFSOpxa2Tbhazz3rFJn8jbFYBfdjAF-9KY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuSsNLdxPcNy_Y4lp7LbDEsuh5CzZocwSI030kFDH53Xw&oe=699F011C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Oyan XR - your mirracle morning", "keywords": [], "long_description": "People are always evolving and our goal is to help you find the best approach to this goal \u2014 be the person you are dreaming about to be. As you enter the virtual world, you'll be greeted with serene environments and calming soundscapes. You can choose to start your day with a cognitive training session, where you'll be guided through a series of methods that awaken your body and mind. Alternatively, you can opt for a breathing exercise that helps you center your focus and reduce stress. And if you're short on time, the app also features quick, five-minute routines that can be easily incorporated into your busy morning routine.", "short_description": "With Oyan XR, you can transform your morning routine into a powerful tool for personal growth and self-care. Start your day with intention, focus, and energy, and discover the positive impact that a fulfilling morning ritual can have on your life."}]}, "developer_name": "Khakim Yessenzhanov", "developer_privacy_policy_url": "https://hackstr.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "black box studio, Inc", "support_website_url": null, "website_url": "https://hackstr.github.io/", "category": "APPS", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["RELAXATION_MEDITATION", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "903567277528092"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974738_1414455065744163_2210164120303131027_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jccG2CxXOpgQ7kNvwEBuaOx&_nc_oc=Adki4IdOEtG7HTwvRzG8XOvdtfsQSboQd3QoPPsJ2fl4QJnQkLYRSPWGKzscqPQlE0o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv03Y9C1pZn9koR50rEcQL4RgH1cxVvbhr5S1ZSex4xAw&oe=699EEEDE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Oyan XR - your mirracle morning", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Fitness & Wellness", "id": "810139357995560"}], "release_date": 1659627211, "lastRevision": {"nodes": [{"id": "5174414006004443", "release_type": "SCHEDULED", "administrat
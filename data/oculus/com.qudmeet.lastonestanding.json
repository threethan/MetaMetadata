-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRKnm72PNBnaM4APa9OM1fCQqpqFDdG8oqPUkqh9Str4g&oe=6AFC6CBC"}]}, "id": "1350453063656046", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_4_2560x1440.png", "id": "2143928529566272", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628893_2143928532899605_2143633242372480341_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3LU4kqmtqkQ7kNvwF7xf_R&_nc_oc=Adon3T7hX4G03uY2uXD17JfgUeV2zVLG-FdkND0xCzp0wgbrtcTQKQvvKW18e1A-jvk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2OBOpXznSZLcaesWutze2o9DDNgGx5ENkNanV2lO12A&oe=6AFC86DC"}, {"file_name": "Screenshot_5_2560x1440.png", "id": "1664960475047155", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619602_1664960478380488_7719471541650867324_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-9J9UA9t9fwQ7kNvwGTE9Lc&_nc_oc=AdpJAiu4AZN0D7yhLlSPYHi0v00IDDlV48f8cpjKQ7Iob5T4MLd6VnKySeNtz6kAnMc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2ZNZIH4p2pQqwe_0hNIFuHb_xAKRntG-zstwb95s0eg&oe=6AFC6456"}, {"file_name": "Screenshot_1_2560x1440.png", "id": "4493463590917782", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499624606_4493463594251115_331004430808757642_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lEFxXO5UsiYQ7kNvwGe8bMH&_nc_oc=Adok6yuPBQoj_c6hu0t-EKdIbsz11-eF1RFTtGgFrnDIX6jeGgt_tCf6SXICpWdGWos&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkmUbuyA0U-iOFCoeeykPEAFfmS0LiPqBsqwPOUSnJlw&oe=6AFC7A7E"}, {"file_name": "Screenshot_2_2560x1440.png", "id": "1659231652274461", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593815290_1659231655607794_965430491021688797_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AatAmLw1dGcQ7kNvwEGWMcj&_nc_oc=Adr2jVqcgPFSd_VzJAcbzIkMB_HxWzjBSXPKaPYHeXO101ZGka5oZ2Bf1CHspCqjyIk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0e38dTEBoYUhll6xKEKusyCupcyBAsFbnyzHCDVaEmg&oe=6AFC71E4"}, {"file_name": "Screenshot_3_2560x1440.png", "id": "1813381229676754", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593723055_1813381233010087_2702066089779372807_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=It8T7pZhlXwQ7kNvwEKGNgu&_nc_oc=AdqvKJnL9kivFVBvooZjZiaBpzn9iaNbS0tRffxvNe0bycJIIBkTM_KDS6ODzJnDTVM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2I-w4Y0z7okYeCiYIk0EaI_ZeSIDcRIW45MQe0kwGpw&oe=6AFC74C9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last One Standing VR", "keywords": [], "long_description": "Survive the hazards. Climb the stages. Beat the world.\n\nLast One Standing VR is a fast, colourful room-scale survival game. You stand on a floating arena high above the clouds. Rolling balls thunder across the floor, padded arms sweep the platform and floor sections drop away. Every hazard warns you first with lights, sounds and countdowns. Read the warning, step out of the way and stay on your feet for 60 seconds.\n\nSOLO CAMPAIGN: 30 STAGES. Each stage is a hand-tuned layout that gets harder as you climb: tighter gaps, faster hazards, bigger combos. Clear a stage to unlock the next. Your progress is saved, so you can always continue where you left off.\n\nEARN COINS, BUY SHIELDS. Clearing stages earns coins. Spend them on shields that absorb a hit when a stage gets tough, or unlock the Neon Night arena theme.\n\nDAILY CHALLENGE. One new challenge every day at 00:00 UTC. Everyone gets exactly the same hazards, so you can compare your score on the daily leaderboard.\n\nARCADE: WORLD BOARD. Endless fresh layouts. Chase near-miss bonuses and post your best score to the global all-time leaderboard.\n\nBUILT FOR COMFORT. No joystick movement, no camera tricks. You move with your body, and the arena fits your Guardian play area. The round pauses if you leave the play area or take off the headset.\n\nPICK UP AND PLAY. Rounds take a minute, so you can play one quick round or a long session. Point and pinch with your hands or use Touch controllers.\n\nPowered by Qudmeet. Created by Raheem Quddus.", "short_description": "Dodge rolling balls, sweeping arms and vanishing floors on a floating arena. Survive 60 seconds, climb 30 stages and beat the world."}]}, "developer_name": "Quddus Raheem", "developer_privacy_policy_url": "https://qudmeet.diaspafra.org/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Qudmeet", "support_website_url": null, "website_url": "https://qudmeet.diaspafra.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "1592192974313489"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1390612217469136"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499624395_2204422743829584_2206727521540957582_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_oNXoUhHzU4Q7kNvwHj2wj-&_nc_oc=AdpTs6cd2-1fjR5EvHsKxEjyHQME25u0iCpV8rDyCEYTkVqT4nTLwRoyVIg3uLQQmVI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRAOVeBmAV5B5ZzrYSj8HCFej6uPGwnfuzvV2OFQNL2EA&oe=6AFC7E36"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Last One Standing VR", "platform
6524993686", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491828816_911636531660352_4133833597096909533_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfLc_bOFeM8Q7kNvwH9CvWW&_nc_oc=AdrAf6b0g7PDQ1CjUeVS2baCOqdHtCl8hvtDr_W3cYlsTLDrU2C9uHIVemrSifbBHd8&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwDiqoVL28D-HN3ct4QoPLBQzLfnMhZ7HClq9QUChQLA&oe=6AA96222"}, {"file_name": "4.png", "id": "935098982594594", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823259_935098985927927_4392494475570445259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VP89NNZ0Rq8Q7kNvwH4Odoa&_nc_oc=Ado83wfsEJUZGOiFFWKCkSyseaVjvhKPVtgCT9QZPHDYIoE2T_SoAzPEEHU2A7aaMKc&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCFmzgVIYgvIBFz8ERI0qAh5gw5IHEcpEESTahhvxqHQ&oe=6AA94A6D"}, {"file_name": "5.png", "id": "916005871203921", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499307435_916005874537254_8123948083466530792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSbVna_e-jQQ7kNvwFLt2gH&_nc_oc=AdpYsR8dgOTO0EJ0YH3izVwbzelFyJGZw2lKy-tGUc1GaYulWcxR-SMpuf0JVvYy_d0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyHWvoGbTuvMlidEaNcZ9loib-D35Vczph_jXgS8D6CA&oe=6AA93C48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest.png", "id": "902684935912516", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491827973_902684939245849_9034814329616965532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H1ufPLAfOTkQ7kNvwERk2Zl&_nc_oc=AdrTP0G3XHmtKfUYZO_KBOUm9XySMT8PvpxDxUMZFisjgXo7u4VzeqqguSpMrrT1WS0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLGw8mzV1MIIizCBYHfgM1CZvSHLvyffDQkAD8cifNDw&oe=6AA948F4"}, "display_name": "Lagomya: Relax, Learn, Play, Connect", "keywords": ["Relaxation", "Wellbeing", "Mindfulness", "Community", "Productivity"], "long_description": "It is perfectly natural to need support during life's ups and downs. Lagomya goes beyond traditional apps, offering a science-based and gamified 3D world designed to support your mental health.\nCombining scientific foundations with immersive technology, Lagomya provides a digital experience where every detail is crafted for your mental wellbeing. Here, you are not just a user; you join this interactive world with your own avatar and transform your wellbeing journey into an enjoyable path of discovery.\n\nAlways With You, Anywhere!\n\nWhether you want to practice relaxation, learn something new, de-stress with games, connect with the community in live events, or have one-on-one sessions with experts\u2014Lagomya is here for you. We provide all the tools you need for mental wellbeing in a single world, allowing you to shape your journey as you wish.\n\nCreate your avatar and start your wellbeing journey in this specially designed immersive world today!\n", "short_description": "Relax, learn, play, connect, and get expert support. Anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lagomya.com/en/privacy/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metaverse Software", "support_website_url": null, "website_url": "https://www.lagomya.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26017568004582511"}}]}, "scheduled_off
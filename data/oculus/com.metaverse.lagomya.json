name": "4.png", "id": "935098982594594", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823259_935098985927927_4392494475570445259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JiHwLS_Mzg8Q7kNvwG50FFD&_nc_oc=AdrW0pRlHtlNskRpcY3zxgRT-4Y7i0E7o-EsmE0XHB99epll1cBfvyJus-Ddeu68a7Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1VE8hBXbZABA4j269m3UBrfMY6-y2NgFv-gLe3jE6ivA&oe=69F0B86D"}, {"file_name": "5.png", "id": "916005871203921", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307435_916005874537254_8123948083466530792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8mgqidPI0DkQ7kNvwFKOrYl&_nc_oc=Adqpl50ybtHcmQ-tkT7PPghq9k51phEoimsU6sQRMD6iriUEbOlFHgEw2hL1I1nkf04&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2xi1wsWFBxncN2uvPDjRXPtP8qHtZeeGvjuMXuNmQNPw&oe=69F0AA48"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest.png", "id": "902684935912516", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827973_902684939245849_9034814329616965532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TpL3CxZ_jP0Q7kNvwE5L5pG&_nc_oc=Adom70FxhwL4qMM-7MEMNvQW4Szbv2m4PqHSSBImgv0IoHz0zO4kI4LTmwa0RFuRW-I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2XYlcCGUFivCbuyA9DIuso90M6jF3G0MSNLfJnZ-UAaw&oe=69F0B6F4"}, "display_name": "Lagomya: Relax, Learn, Play, Connect", "keywords": ["Relaxation", "Wellbeing", "Mindfulness", "Community", "Productivity"], "long_description": "It is perfectly natural to need support during life's ups and downs. Lagomya goes beyond traditional apps, offering a science-based and gamified 3D world designed to support your mental health.\nCombining scientific foundations with immersive technology, Lagomya provides a digital experience where every detail is crafted for your mental wellbeing. Here, you are not just a user; you join this interactive world with your own avatar and transform your wellbeing journey into an enjoyable path of discovery.\n\nAlways With You, Anywhere!\n\nWhether you want to practice relaxation, learn something new, de-stress with games, connect with the community in live events, or have one-on-one sessions with experts\u2014Lagomya is here for you. We provide all the tools you need for mental wellbeing in a single world, allowing you to shape your journey as you wish.\n\nCreate your avatar and start your wellbeing journey in this specially designed immersive world today!\n", "short_description": "Relax, learn, play, connect, and get expert support. Anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lagomya.com/en/privacy/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metaverse Software", "support_website_url": null, "website_url": "https://www.lagomya.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26017568004582511"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1239296104586652"}]}, "baseline_offer": {"id": "1239296104586652"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1774880160, "status": "PUBLISHED", "id": "1239296104586652"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26155396360799674", "version": "1.0.1"}, "id": "135935538623
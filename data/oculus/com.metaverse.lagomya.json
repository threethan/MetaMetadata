KWOpAr4kQ7kNvwE0Bjy5&_nc_oc=AdoP8z5slWxNUQ_nek953yg3UCNAzLRBAtOq3G3WAiGDbKlBceLdm6odXfgh_-BlmBk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCveOqsDyOsEfyyYL7TK6grO5w8Rs-E-ayFRf_z9rG5ug&oe=6A5F766D"}, {"file_name": "5.png", "id": "916005871203921", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307435_916005874537254_8123948083466530792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pGQM8Ke8xjwQ7kNvwFeMCqk&_nc_oc=AdrT7ItKqT9yrAbc8HiVvj2QvClVId7QNCGRj75ifg64SZDp00j7LrKseQm9Iv86ytM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlGQoQW2VUZmgJl_N_gPnKi_1BK05ysQ47UhEOLK3zUg&oe=6A5F6848"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest.png", "id": "902684935912516", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491827973_902684939245849_9034814329616965532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DDwBdO_OHLUQ7kNvwGGMzLI&_nc_oc=Ado2Stl1su7SIU0LWOhjsXX8krVr8Z3s5re6rjK-DBoZ1WgznUF4aw0PRSjL_NW1LKs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZ5m9IPgl1p8IJReV2D9h3NfQRRAo6VjeC6nXrFoOscw&oe=6A5F74F4"}, "display_name": "Lagomya: Relax, Learn, Play, Connect", "keywords": ["Relaxation", "Wellbeing", "Mindfulness", "Community", "Productivity"], "long_description": "It is perfectly natural to need support during life's ups and downs. Lagomya goes beyond traditional apps, offering a science-based and gamified 3D world designed to support your mental health.\nCombining scientific foundations with immersive technology, Lagomya provides a digital experience where every detail is crafted for your mental wellbeing. Here, you are not just a user; you join this interactive world with your own avatar and transform your wellbeing journey into an enjoyable path of discovery.\n\nAlways With You, Anywhere!\n\nWhether you want to practice relaxation, learn something new, de-stress with games, connect with the community in live events, or have one-on-one sessions with experts\u2014Lagomya is here for you. We provide all the tools you need for mental wellbeing in a single world, allowing you to shape your journey as you wish.\n\nCreate your avatar and start your wellbeing journey in this specially designed immersive world today!\n", "short_description": "Relax, learn, play, connect, and get expert support. Anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lagomya.com/en/privacy/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metaverse Software", "support_website_url": null, "website_url": "https://www.lagomya.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26017568004582511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491818849_4377823515817184_6193910465655155680_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7heJoSTYZEAQ7kNvwGPKMLX&_nc_oc=AdqlJuTOFN-V6q-jgT9o5z8W_oRdDh2pXfdjuSfUNByAJw0__uv18B_mqm7Z2P3hCr8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAc8Gu9HHy5A5ak_AK1fp09yEles-hBoHk6Gt3DMstqpA&oe=6A5F5918"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lagomya: Relax, Learn, Play, Connect", "platform": "ANDROID_6DOF", "context_catego
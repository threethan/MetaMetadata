xzchFC2UQ7kNvwE5cszX&_nc_oc=AdrntigWpMIxQ0D2LVaEg7Mh8rqAN5bhMEEK6tIzmU9SBvWRTGVuDimmjwgV7QfZSvQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BJ5Pzyp-iD4kwi9xABYssYdLfagZwwqi-jJvEAIkZ6Q&oe=6A1C39ED"}, {"file_name": "5.png", "id": "916005871203921", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499307435_916005874537254_8123948083466530792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2QJCmXsSfS4Q7kNvwE32DeG&_nc_oc=AdrwqEMmZwXZvVIPil3-5p0Nv4QX6wgD3gWcOHeJnZ2t8CIpbfH2QEKipiO1KPaTEv4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LEYvurVomwMG28Crn4gMF4d2Jk8n8iCs5dLic6zVUrw&oe=6A1C2BC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest.png", "id": "902684935912516", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827973_902684939245849_9034814329616965532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o2NQjCl-3LwQ7kNvwEygGsJ&_nc_oc=Adqu5Z2k10IL_oeqZmcxFUMsMUgwTfTjKYmK7kTaLZVpvKgf8OZY5E6MSqyqGivLZx0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af660OOBz3vajj4uoVx8qvR8i5f5uuKQDYhSy37BgxCJkw&oe=6A1C3874"}, "display_name": "Lagomya: Relax, Learn, Play, Connect", "keywords": ["Relaxation", "Wellbeing", "Mindfulness", "Community", "Productivity"], "long_description": "It is perfectly natural to need support during life's ups and downs. Lagomya goes beyond traditional apps, offering a science-based and gamified 3D world designed to support your mental health.\nCombining scientific foundations with immersive technology, Lagomya provides a digital experience where every detail is crafted for your mental wellbeing. Here, you are not just a user; you join this interactive world with your own avatar and transform your wellbeing journey into an enjoyable path of discovery.\n\nAlways With You, Anywhere!\n\nWhether you want to practice relaxation, learn something new, de-stress with games, connect with the community in live events, or have one-on-one sessions with experts\u2014Lagomya is here for you. We provide all the tools you need for mental wellbeing in a single world, allowing you to shape your journey as you wish.\n\nCreate your avatar and start your wellbeing journey in this specially designed immersive world today!\n", "short_description": "Relax, learn, play, connect, and get expert support. Anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lagomya.com/en/privacy/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metaverse Software", "support_website_url": null, "website_url": "https://www.lagomya.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26017568004582511"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491818849_4377823515817184_6193910465655155680_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gF1ajJTQwksQ7kNvwHdc21e&_nc_oc=AdolM2TrGQnGxzQl7rbOdR96fR6Nr0GqRXv0ocp2BGHY7U0tZySdl_pHubRlw8GANCA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-hm6tq2twXwGbmMiVHcIgJ5FpZojWHAY41WmWA2YeVQ&oe=6A1C54D8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Lagomya: Relax, Learn, Play, Connect", "platform": "ANDROID_6DOF", "context_catego
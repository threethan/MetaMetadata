6524993686", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491828816_911636531660352_4133833597096909533_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CS-PN1A-HOMQ7kNvwHZOXG8&_nc_oc=AdpFmUlys_R9XzxJXO0jQY6h7lpWMki0MbExAInoSD8bvRH_9txgpUULbzolmWT68AA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF84ZzrU7wsIn0ysh4fcK-JNNLn2nCXho2ktQMp4ZuA1g&oe=6A7DA862"}, {"file_name": "4.png", "id": "935098982594594", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823259_935098985927927_4392494475570445259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFdCybjav3sQ7kNvwHbsSgQ&_nc_oc=Adr-Ob8HqhGjq0-MORTsgNeINmsXISL7vgu8n78Buy74juj70JxhTqE2uAEDeslYMIM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFKcNgpZg61z7PnduHBzUsVnnUxjuljt5krEKsd8kMOTQ&oe=6A7DC8ED"}, {"file_name": "5.png", "id": "916005871203921", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499307435_916005874537254_8123948083466530792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eXrsD7lL3CQQ7kNvwHZfe6t&_nc_oc=AdqNv158iPB5hvDHLy99DY9KJ68D4Of4jqsBcdgDe8tmv-8X3D7MSlc3nyH06c89gEw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFulRTqhyvSvm9GA-3RwHE995Sc48CITjqQH6kegdU3Zw&oe=6A7DBAC8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest.png", "id": "902684935912516", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491827973_902684939245849_9034814329616965532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xsLLLeA9ujMQ7kNvwF2kO0Q&_nc_oc=AdoR2lgjmQ3egz1ICKlya9NmbPVMLphhxdq05y9s1N323jyRYCGrbzxWFDB44UPnYys&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEZvly9TmUi3dftT_Ac9RT2U4a1dfTksqoy7tHHaPN4Fw&oe=6A7DC774"}, "display_name": "Lagomya: Relax, Learn, Play, Connect", "keywords": ["Relaxation", "Wellbeing", "Mindfulness", "Community", "Productivity"], "long_description": "It is perfectly natural to need support during life's ups and downs. Lagomya goes beyond traditional apps, offering a science-based and gamified 3D world designed to support your mental health.\nCombining scientific foundations with immersive technology, Lagomya provides a digital experience where every detail is crafted for your mental wellbeing. Here, you are not just a user; you join this interactive world with your own avatar and transform your wellbeing journey into an enjoyable path of discovery.\n\nAlways With You, Anywhere!\n\nWhether you want to practice relaxation, learn something new, de-stress with games, connect with the community in live events, or have one-on-one sessions with experts\u2014Lagomya is here for you. We provide all the tools you need for mental wellbeing in a single world, allowing you to shape your journey as you wish.\n\nCreate your avatar and start your wellbeing journey in this specially designed immersive world today!\n", "short_description": "Relax, learn, play, connect, and get expert support. Anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lagomya.com/en/privacy/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metaverse Software", "support_website_url": null, "website_url": "https://www.lagomya.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26017568004582511"}}]}, "scheduled_off
6524993686", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491828816_911636531660352_4133833597096909533_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGlGCCrk3IYQ7kNvwG_A2o7&_nc_oc=AdoQzCGWSUpPgW33lKpHhrMXW8hNXKZTZHVhR_Ke_eLQyvV_RMx0CKShGp4b7mLvlyQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ02klc_KBXQsdu5iuh2Dj9yrhitgdyrFdmfOhoLRqGAA&oe=6AA41C22"}, {"file_name": "4.png", "id": "935098982594594", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491823259_935098985927927_4392494475570445259_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VC_R_Aelj8Q7kNvwHHyRdU&_nc_oc=AdpColO_OPW_frh1P1ugujnEKVEjWyBaCRnQmt2QizjJv0i5Bo923mF6qTvr7b1xDUs&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9rShlRVbrky77_0K2d7jyhQQQpypHh9iEWTzXj9PLaQ&oe=6AA4046D"}, {"file_name": "5.png", "id": "916005871203921", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499307435_916005874537254_8123948083466530792_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sE6F3XlyzQQ7kNvwEJJPSz&_nc_oc=Adp-w0JeGc0NBHD14VqDAwWekcdMbgxSP8mhUh6ywMnkINX49h3ebjPvOL3HHbmdGxw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJw7Za2zcq4-PPaWYg7Az4EnSFP9EjoR9pG7Eslz0hY_A&oe=6AA3F648"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "quest.png", "id": "902684935912516", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491827973_902684939245849_9034814329616965532_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HqLaxJ_7vmsQ7kNvwG5OhK4&_nc_oc=AdoSvw0vCfmstbGuwjLuwTSy-S-Uip50IXhipJOXjbFR3VutoS_yLapKx6E-rjufmXQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO8vP1PK3gPkwK1JXe6LcX4A02lo3NTGtU1E3SFhudZg&oe=6AA402F4"}, "display_name": "Lagomya: Relax, Learn, Play, Connect", "keywords": ["Relaxation", "Wellbeing", "Mindfulness", "Community", "Productivity"], "long_description": "It is perfectly natural to need support during life's ups and downs. Lagomya goes beyond traditional apps, offering a science-based and gamified 3D world designed to support your mental health.\nCombining scientific foundations with immersive technology, Lagomya provides a digital experience where every detail is crafted for your mental wellbeing. Here, you are not just a user; you join this interactive world with your own avatar and transform your wellbeing journey into an enjoyable path of discovery.\n\nAlways With You, Anywhere!\n\nWhether you want to practice relaxation, learn something new, de-stress with games, connect with the community in live events, or have one-on-one sessions with experts\u2014Lagomya is here for you. We provide all the tools you need for mental wellbeing in a single world, allowing you to shape your journey as you wish.\n\nCreate your avatar and start your wellbeing journey in this specially designed immersive world today!\n", "short_description": "Relax, learn, play, connect, and get expert support. Anytime, anywhere."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lagomya.com/en/privacy/privacy_policy.html", "developer_terms_of_service_url": null, "publisher_name": "Metaverse Software", "support_website_url": null, "website_url": "https://www.lagomya.com/en", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "26017568004582511"}}]}, "scheduled_off
ames.UHAscent-20251218-170504_2560x1440.png", "id": "4207350882744222", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491819982_4207350886077555_5493617616106793819_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-0e01qcw5jgQ7kNvwFbNxKD&_nc_oc=Adp3ta1yAFn-8yV5d7MgpNTkVg2_zOlhBB8_5xRRoPAwPoGKwl6ct1D_Xe5ssNhhjN4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYxxy6o-g-To2oxGCpp9H1iC7Ac-gFujKflLEQzBbEIg&oe=6AD0E63E"}, {"file_name": "com.UltraFunGames.UHAscent-20251218-170728_2560x1440 (1).png", "id": "798520003219156", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820518_798520006552489_4266045885251254473_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8s0r3eUBGIQ7kNvwFQFObY&_nc_oc=AdpDgRNNFXUa2_iaLOaOm6W4Ev1OoTlNC_wtk6gxAq6lZ_ewUHiwpA_IKTbI842lbrk&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRyVg9XFILH3XCnE2VGfN1aLzhY13lLGTS_jJCGDwJEg&oe=6AD0FA01"}, {"file_name": "com.UltraFunGames.UHAscent-20251218-170803_2560x1440.png", "id": "25638221322468600", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820441_25638221325801933_6178327333226138476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4pPs9ik_bEkQ7kNvwEpZ3uL&_nc_oc=AdqPP3lCMByL-h4sAwIJ7Bz1fb3MxyOUzz8WiuwdUffqg3ZjOQFIFi-6HfT0c9LuNsw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaOk5TXOHyj5ndQDLFotbtOU1OYN7N1fBTo_jfsPgHEg&oe=6AD0ED02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "FREE CLIMBING BANNER2 (1).png", "id": "879497927785724", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819986_879497931119057_4455890512916913734_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yzq1jISuS74Q7kNvwEwOuuC&_nc_oc=AdqHYyC15tB4G-x05AEwIcGV7-qsaGRn5-Ys9e9q8oefUQNkvL-8C2spZYaqXbIIp-w&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmbfLqbLA2w3tpRugpshDxBqJyTmXnscz83SAnVg9sfQ&oe=6AD0EEA9"}, "display_name": "Ultra Height: Skyscraper Free Climbing", "keywords": ["climbing", "jumping", "flying", "climb", "city"], "long_description": "Ultra Height: Skyscraper Free Climbing is a high-intensity VR height experience designed to deliver a powerful sense of scale, vertigo and immersion.\n\nNominated for GAME OF THE YEAR 2026 at The Polys.\n\nTake on an enormous futuristic skyscraper built around one complete climbing challenge. Use full VR hand interaction to climb toward the summit while navigating dangerous structures suspended high above the city.\n\n\ud83d\udd39 What You\u2019ll Experience\n\n\u2022 Climb a massive futuristic skyscraper from the ground to the summit.\n\u2022 Cross narrow planks, pipes and exposed structures at extreme heights.\n\u2022 Navigate gondolas suspended above the city.\n\u2022 Experience huge vertical scale as the ground disappears beneath you.\n\u2022 Reach the rooftop and BASE jump from the skyscraper.\n\u2022 Deploy your parachute and glide back down toward the city.\n\u2022 Complete the full climb-to-jump challenge from start to finish.\n\nUltra Height focuses on fear of heights, precise climbing, exploration and the thrill of being hundreds of meters above the ground.\n\nNEW \u2013 Cyber City Unlockable Experience\n\nExpand the game with additional paid experiences including skyscraper climbing, plank walking, jet rocket flying, grapple swinging, gravity experiments, hang gliding, parachute jumps, flying platforms and ziplining!\n\nConquer the height! Reach the summit! Then jump down!", "short_description": "Experience extreme vertical height in VR by climbing a massive futuristic skyscraper using full VR hand interaction. Ascend towering buildings and skyscrapers, carefully walking on planks and pipes high above the city as you navigate gondolas and high-altitude obstacles. Reach the summit, leap into the void, deploy your parachute, and land safely in the city town square below in this free climbing and base-jumping experience!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-extra/", "developer_terms_of_service_url": null, "publisher_name": "ULTRA FUN GAMES", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29118022027810911"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824322_891197133448991_4022289136846949527_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2_9amu0eIsQ7kNvwG7KgRe&_nc_oc=Adq9hXHNFZDejkwtZ19Yl8gRMn0VpLZz_yFNmscAsZnH59Xg4r2v3-3kk02JxhHjt1A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMj-QaauAdfb36C92e00ywSxlxcKr2kxL1EaTV5a0dkGA&oe=6AD0DC48"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Ultra Height: Skyscraper Free Climbing", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Travel & Exploration", "id": "726368587961803"}, {"topic_name": "Sports", "id": "2776542286000603"}], "release_date": 1766411760, "lastRevision": {"nodes": [{"id": "25834392179507262", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "25834392112840602", "is_first_party": false
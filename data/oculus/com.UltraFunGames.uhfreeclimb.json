1-25/491820518_798520006552489_4266045885251254473_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WX0oKxiOEWoQ7kNvwECbJXC&_nc_oc=AdqUQ3UE5P6BYj-Xre5HC2gyQPCA7MrVo8omtBa0TF7f8kbuOirxwm-hSgAoIWrsfmg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMll_x4oupC_HbTM2H4VLBFSYWWmJ4I_JelhRuiiHgMoA&oe=6AC66E01"}, {"file_name": "com.UltraFunGames.UHAscent-20251218-170803_2560x1440.png", "id": "25638221322468600", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_25638221325801933_6178327333226138476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VlKW26LK3asQ7kNvwHCm1Qv&_nc_oc=AdpHnEqUkebU4hgE-LejmMMmjSanPG-Dolqu2BPAnuf_gSUOKRij255UhBwVL52Trt8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwX1TjV9z3cxLA_XlaDVoRSaa1JiekmrwE-YvKiM3KtA&oe=6AC66102"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultra Height: Skyscraper Free Climbing", "keywords": ["climbing", "jumping", "flying", "climb", "city"], "long_description": "Ultra Height: Skyscraper Free Climbing is a high-intensity VR height experience designed to deliver a powerful sense of scale, vertigo, and immersion.\n\nIn this free game, you take on one extremely tall skyscraper, carefully designed to showcase the core gameplay, climb, fall and parachute gliding mechanics of the full experience.\n\n\ud83d\udd39 What You\u2019ll Experience\n\nClimb a towering futuristic skyscraper using full VR hand interaction\n\nNavigate gondolas suspended high above the city\n\nFeel the true sense of height as the ground disappears far below\n\nReach the summit and base jump from the top, deploy your parachute, and descend toward the city\n\nLand in the town square, completing a full climb-to-jump vertical journey\n\n\ud83d\udd39 A True Height Experience\n\nThis free edition focuses on:\n\nExtreme vertical scale\n\nFear of heights and spatial awareness\n\nCalm, precise climbing at dangerous altitude\n\nDesigned as a standalone height challenge, this experience is perfect for players who want to test their nerves, enjoy climbing at massive scale, or experience the thrill of jumping from extreme heights in VR.", "short_description": "Experience extreme vertical height in VR by climbing a massive futuristic skyscraper in this free climbing and base-jumping experience. Ascend a single, extremely tall building, navigate gondolas and high-altitude obstacles, then jump from the top, deploy your parachute, and land safely in the city town square below."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-oculus/", "developer_terms_of_service_url": null, "publisher_name": "ULTRA FUN GAMES", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25834392152840598"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1382200853257612"}, {"status": "PUBLISHED", "id": "27461002530186549"}, {"status": "PUBLISHED", "id": "25522510007405114"}]}, "baseline_offer": {"id": "1382200853257612"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1787252640, "status": "PUBLISHED", "id": "1382200853257612"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "2
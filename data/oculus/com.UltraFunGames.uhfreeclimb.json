, "id": "25638221322468600", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820441_25638221325801933_6178327333226138476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4CTRlDmaUoQ7kNvwG6VYNq&_nc_oc=AdoHFl7zzdRfyNpEEuMj5jc7WZiPUpflgkwVsKe86l1oy1aLu2IlbKza-M-ooUjo_ug&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRkTTdIQlYrCdzn8-GE9VxBDEK6f_iVXpkSn1o1YF2Otw&oe=6AE8A802"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ultra Height: Skyscraper Free Climbing", "keywords": ["climbing", "jumping", "flying", "climb", "city"], "long_description": "Ultra Height: Skyscraper Free Climbing is a high-intensity VR height experience designed to deliver a powerful sense of scale, vertigo, and immersion.\n\nIn this free game, you take on one extremely tall skyscraper, carefully designed to showcase the core gameplay, climb, fall and parachute gliding mechanics of the full experience.\n\n\ud83d\udd39 What You\u2019ll Experience\n\nClimb a towering futuristic skyscraper using full VR hand interaction\n\nNavigate gondolas suspended high above the city\n\nFeel the true sense of height as the ground disappears far below\n\nReach the summit and base jump from the top, deploy your parachute, and descend toward the city\n\nLand in the town square, completing a full climb-to-jump vertical journey\n\n\ud83d\udd39 A True Height Experience\n\nThis free edition focuses on:\n\nExtreme vertical scale\n\nFear of heights and spatial awareness\n\nCalm, precise climbing at dangerous altitude\n\nDesigned as a standalone height challenge, this experience is perfect for players who want to test their nerves, enjoy climbing at massive scale, or experience the thrill of jumping from extreme heights in VR.", "short_description": "Experience extreme vertical height in VR by climbing a massive futuristic skyscraper in this free climbing and base-jumping experience. Ascend a single, extremely tall building, navigate gondolas and high-altitude obstacles, then jump from the top, deploy your parachute, and land safely in the city town square below."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ultrafungames.com/privacy-policy-oculus/", "developer_terms_of_service_url": null, "publisher_name": "ULTRA FUN GAMES", "support_website_url": null, "website_url": "https://www.ultrafungames.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "2776542286000603"}, {"id": "726368587961803"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25834392152840598"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "3688621221303456"}, {"status": "PUBLISHED", "id": "1668098528203806"}, {"status": "PUBLISHED", "id": "1116706341214340"}, {"status": "PUBLISHED", "id": "1136014496016647"}, {"status": "PUBLISHED", "id": "3984401305035966"}, {"status": "PUBLISHED", "id": "1382200853257612"}, {"status": "PUBLISHED", "id": "27461002530186549"}, {"status": "PUBLISHED", "id": "25522510007405114"}]}, "baseline_offer": {"id": "3688621221303456"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792943700, "status": "PUBLISHED", "id": "3688621221303456"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29144205438525903", "version": "1.2.91"}, "id": "878267308479476", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binarie
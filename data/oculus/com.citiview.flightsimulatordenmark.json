png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QbSjEUBSIEEQ7kNvwFROv30&_nc_oc=AdrrS4Kn_bKVF9En57CSFVQpLSJUaFnIllRLbtZ0liiIsXHQHgFAGYgjWapY_B5zkV4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBg9u2t2bOZygWnQ5G-QnUBM5Fyglcp5o-a3HEoeaehw&oe=6AF9E3F0"}, {"file_name": "screenshot_4.png", "id": "4564450747107654", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491831964_4564450750440987_4141762097347757673_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yoUA8ndmLsQ7kNvwFu07E_&_nc_oc=AdrB46mp0uRXv3NUdYsZNFcEu5sLweuBchRaIVeLn9VqblmLuWbBjOEXrRAwwh6QDDw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOiekfZfM8eEXfTlPjtrR_tBzpMmP_1A0O0bIv6pTmiw&oe=6AF9D915"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "2207371643155505", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/596168449_2207371653155504_2994205285109001307_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSEWr5Iee44Q7kNvwE4J5Lh&_nc_oc=AdoZZyxvv7RocYBwv7rr0SAZtQuDUSdtGuMvLJHhwUVIR6_vWi3AsSGxqN9rRD4Rkhg&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSbvp1z7Gg3WZJPRJZWPih2ziRATwWD_T4_Ay7z78br1g&oe=6AF9CE44"}, "display_name": "Flight Simulator Denmark", "keywords": ["flight", "simulator", "denmark", "copenhagen", "jet"], "long_description": "Flight Simulator Denmark puts you in the captain's seat over the real Copenhagen, the Oresund and Malmo.\n\nTHE REAL COPENHAGEN\nCity Hall's tower, Christiansborg Palace, the Round Tower, Rosenborg, the Black Diamond, Nyhavn, the Opera, Amalienborg, the Marble Church, the Little Mermaid, CopenHill and Tivoli.\n\nTHE ORESUND\nThe Oresund bridge to Sweden with trains on its lower deck and cars on top, Saltholm, the island of Ven, Malmo and the Turning Torso, Kronborg Castle at Helsingor.\n\nA LIVING CITY\nTrains on their real tracks, traffic on the real roads, yachts and ships on the Sound. At night the city and the bridge light up.\n\nAIR TRAFFIC CONTROL\nTaxi and takeoff clearances and your landing clearance.\n\nYOUR GLASS HANGAR\nEvery flight starts in your glass hangar, the city's spires through the doors. Repaint, wash, fly.\n\nFOUR AIRCRAFT\nTwo private jets with cabins, a midsize jet and a fighter.\n\nELEVEN MISSIONS\nKastrup approaches over the city and the Oresund, a sunset hop to Sweden, the Harbour Run, around the Turning Torso, Kronborg and the Sound, a Roskilde scramble, Copenhagen by night, a city tour.\n\nFLY TOGETHER ONLINE\nQuick Match or a private sky with a code. Voice chat stays off until you turn it on.\n\nEnglish and Danish menus.", "short_description": "Fly the real Copenhagen and the Oresund: City Hall, Christiansborg, Nyhavn, the Opera, the Little Mermaid, Tivoli and the Oresund bridge to Malmo and the Turning Torso. Start in your own glass hangar, run the harbour, circle the Turning Torso, talk to air traffic control and land at Kastrup. English and Danish menus."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/flightsimulatordenmark/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/flightsimulatordenmark/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "da"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1401264933070042"}
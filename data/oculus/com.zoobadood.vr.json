6HjpD_An0v1GKJaA&oe=6AFDDFD9"}, {"file_name": "screenshot_4_rethrow_2560x1440.png", "id": "1129765683064335", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499302348_1129765686397668_2216105592042932010_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RgXK3oH7wY8Q7kNvwG7fMGi&_nc_oc=AdqwbIJWj_LteetKHxj81_4B3w8-PPGHg5v-jog9lHB9bx1oLNN9Rdevj6b1mw1Ko6o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3P4g0zTwEA4mCfCw4z-X7ADdsVTuglrjoSqfpNpRvQA&oe=6AFDC2F3"}, {"file_name": "screenshot_5_missed_2560x1440.png", "id": "1425886739504946", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499299745_1425886746171612_4145448743073026546_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iB353R2TaEYQ7kNvwFXhTgf&_nc_oc=Adqd3DLGvki-CHSUkb70SckP52I6Ue_1MtjK5m1gRWAxsEcL2D0T2rjsCSvHz6d9RGY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRT_ah4l8ljDTypbviheD3cLgHtmclOTHtF00Xm337KAw&oe=6AFDCD44"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Zoobadood VR", "keywords": [], "long_description": "Zoobadood is a real game people play with a stick. You stand in a circle, throw it across, and whoever it comes to has to catch it by the right end. This is that game in VR, with a sword.\n\nGrab the yellow handle and you keep your hand. Grab the blade and you lose that arm. If a throw comes at you and you don't catch it, you lose an arm too. Lose both and you sit out the rest of the round while everyone else moves in closer.\n\nThrows have to be fair. If the sword goes too high, too far past the circle, or doesn't get near anyone, you throw again. So throw as hard as you want, but you have to throw it at someone.\n\nWhat's in it:\n- Online games for 2 to 10 players. Press Play to join a public one.\n- Private rooms. Make one and your friends join with the 6-character code on your screen.\n- A practice mode that keeps throwing the sword at you until catching it feels normal.\n- Throwing works the way you'd expect: swing your arm and let go. Harder swing, faster throw.\n- You don't move around. Play standing up, with enough room to swing an arm.\n\nLast one with an arm left wins the round, and the next one starts.\n\nAnd don't forget to join our discord server for updates, news and bugs: https://discord.gg/S4kv4kDS88\n\nHave fun!", "short_description": "Zoobadood is a real game people play with a stick, and this is the VR version. Everyone stands in a circle and throws a sword back and forth. Catch it by the yellow handle and you're fine. Grab the blade, or let a throw that comes at you get past, and you lose that arm. Lose both and you're out until the next round. Up to 10 players online, or make a private room and give your friends the code. There's a practice mode too."}]}, "developer_name": null, "developer_privacy_policy_url": "https://tree43.xyz/zoobadood/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Tree43 Interactive", "support_website_url": null, "website_url": "https://tree43.xyz/zoobadood", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1700921480735423"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "1343276298866973"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298329_28554060414257640_8451469330055955962_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_buck
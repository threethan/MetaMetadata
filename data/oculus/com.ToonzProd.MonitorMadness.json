ocomotion movment system from one of the most famouse virtual reality games. This game, though, takes a twist on it by adding differences that make it it's own uniqe game. In the game you play as an old CRT monitor playing and jumping around having fun. We hope to see you in our game :)", "short_description": "Monitor Madness is a 3 dev team game using locomotion movment."}]}, "developer_name": "ToonzProd", "developer_privacy_policy_url": "https://sites.google.com/view/monitormadness/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "ToonzProd", "support_website_url": null, "website_url": "https://sites.google.com/view/monitormadness/home", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7641871425930278"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974512_436323902099758_884416906611622449_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mtfpro5lAYMQ7kNvwFKrqmp&_nc_oc=AdpR4HOLYpC0nRLAbZnRu_p4aA4pBkiFlBFoz5X-TrSX2W1NruGZrriVPImXmisQIx0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1kLqPo_AfahuKKD62OFNVvFvcz0Mccr8QIEM1ebrSYQQ&oe=69F208C6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Monitor Madness", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name
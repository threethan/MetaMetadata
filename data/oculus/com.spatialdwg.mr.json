771-25/499620666_978839631937903_606700412522037128_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yLQ_kSayDGsQ7kNvwHQbZ5D&_nc_oc=Adryji2Fl-eyJ4nm-8HKPMYoy2QzRRr_4tAcwe-wdvH1l_Qrlz_PzVHWV9AJ6-1DGco&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8xcKc7C_18FwBIR1isM5Mrypq-zkCS97ee47W8au7CQ&oe=6AFDC95B"}, {"file_name": "01.png", "id": "1074467238751089", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499624395_1074467245417755_7532542351757719070_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuiUeSirbKIQ7kNvwGb4YqD&_nc_oc=AdrwaxjCJV6FIdE-xuUCOJtf6gmDDvc-85D-nNPfeqTXuuyVFs7wbYQDwbXJK17eNUg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXHnJuLgu62p7oBNWyoW5X-WNvZ120GUqq4imAxkXHMg&oe=6AFDDE23"}, {"file_name": "03.png", "id": "1895241198551976", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593839439_1895241201885309_7901063406119499021_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4PB10oJ40MQ7kNvwGOuVfg&_nc_oc=AdodjfXvR8gHn6VlAQFSGwGSI9k4sz3HNRsF3rjrHFs5siiI3V9iOVxoIqCJhi48Xmg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHeTEXqEyuklMCrZ5tka2-xVGcgcbVCMP2OU4_Yc3fBw&oe=6AFDDA73"}, {"file_name": "02.png", "id": "3671528306337697", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623185_3671528313004363_1871334045639488108_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNFhiWMOJFoQ7kNvwEysTz2&_nc_oc=Adq7HyUV9IKRrXE8iodLgyR-oa69_KktlG3ZafHoHO7hCiECnzszpDPCqpGmgTJrF48&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR1kWlzi5SZyNwR0J3L751Z62W7ppVsYFeepy-vFrAumg&oe=6AFDBEAA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "499619382_2305078980315379_2158509283906520088_n.png", "id": "1635822144656808", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593863731_1635822147990141_2531638659914051319_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vIiIbM-8M0cQ7kNvwHtgX9Y&_nc_oc=AdqawTpBzHP755TmJOBYZ5e6Z0gFnyvfwx843uG0T57xO_o1RItwRvTkT3vx7E1Tzd4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRXpvEGk9DoTMVNdJfohjefA-4LpjzeZXp_dZsydqwYpg&oe=6AFDC99E"}, "display_name": "PlanAnchor: DWG Plans in Mixed Reality", "keywords": ["dwg", "cad", "autocad"], "long_description": "PlanAnchor puts your CAD drawings (DWG / DXF) into your real room in mixed reality - at real size, anchored in place and as see-through as you like.\n\n- 2D plans and 3D drawings (incl. solids) at 1:1, any scale or as a tabletop model\n- Lay plans on the floor or stand elevations on a wall\n- Adjust opacity to see the drawing and the room together\n- Match one or two points to real corners; fine-tune by 1 mm and 0.1\u00b0\n- Turn and tilt on any axis around the drawing's center or its 0,0,0\n- Drawings stay in place, even after a restart\n- Move and rotate lines, faces and blocks, undo, and save as a new DWG (original kept)\n- Hands only or controllers (thumbsticks slide, raise and turn)\n- Web page on your Wi-Fi: upload, download, delete files and view the room live in 3D\n\nFiles stay on your headset and local network. Accuracy depends on headset tracking; verify critical dimensions. Some object types are shown but not saved.\n\nPlanAnchor is an independent app by an individual developer, not affiliated with, endorsed or sponsored by Autodesk, Inc. or any other CAD software maker. Autodesk, AutoCAD and DWG are trademarks of Autodesk, Inc., used only to describe compatible file formats.", "short_description": "Place DWG / DXF drawings in your room at real size. Anchor plans to real corners, see through them, move and rotate objects with your hands, and save as DWG. Not affiliated with Autodesk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blog.naver.com/uc7/223929197098", "developer_terms_of_service_url": null, "publisher_name": "woojoung", "suppor
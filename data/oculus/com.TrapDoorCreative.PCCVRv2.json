 beautiful mid-day canoe show Huki!, and our delightful Ali'i Luau Dinner Show in full 3D/360 VR.  \n\nThis experience will give you just a taste of what you will find when you visit the Polynesian Cultural Center on your next trip to the beautiful island of Oahu.", "short_description": "Experience the Polynesian Cultural Center in  3D 360VR!"}]}, "developer_name": "TrapDoor Creative, LLC.", "developer_privacy_policy_url": "https://www.polynesia.com/privacy-policy/", "developer_terms_of_service_url": "https://www.polynesia.com/terms-of-use/", "publisher_name": "The Polynesian Cultural Center", "support_website_url": null, "website_url": "http://www.polynesia.com/", "category": "ENTERTAINMENT", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "EXPERIENCE_360_NON_GAME", "TRAVEL"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "zh_CN", "zh_TW", "ja", "ko"], "supported_input_devices": ["TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "945041336380207"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974781_1378240208992067_4475925873182113792_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8APA-64kzogQ7kNvwGgWQ6b&_nc_oc=Adm23hkDE-fVc_0usmFg7oB5dSxcRGotNdm3FJrYaj1Mry9JuUbH7Vk4ZlsfgYRdB6I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afu9gF1PBBSA8MaMW_LDsCqzNJmGhR5jHvgQ4z4RQbVIng&oe=699C6100"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "The Polynesian Cultural Center VR Experience", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_da
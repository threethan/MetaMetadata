72qkDkUM-wykpklv8n_TYg&oe=6A7EF948"}, {"file_name": "Image Sequence_010_0000.png", "id": "611372940986633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982713_611372944319966_5908819421399743673_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VwCasas4YgQ7kNvwEdzt7i&_nc_oc=AdqBAULWT-GeaVKGEBItvEiGoyLHZ0A_l4VsWc2rYNtkm8XRkixY05kedjs5ROgskaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEex3SN8DERIVYRNTEIWUlA2lhpx8vHyD8GNH6yZ2FhXA&oe=6A7F1FAE"}, {"file_name": "Image Sequence_011_0000.png", "id": "254966370692550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_254966374025883_5842330178800131513_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TACac8C24rkQ7kNvwEH9-rp&_nc_oc=Ado2e_KWMPESesNKPHwv5hoipcmUyGvbJtYvHnhpvZUtzUxDYAfEcW77C8zqX1w4JaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgBErYeRGmC6PrTMJ_-IYIi5-GCjgNORT25f3uJsx_sA&oe=6A7F1619"}, {"file_name": "Image Sequence_004_0000.png", "id": "301846022417389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_301846025750722_4261715370222629531_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMAGhM2MWDwQ7kNvwGG0yeO&_nc_oc=AdoJJ2Av4mXcAjL5mDsgLvqYT38B_4XCtUel7rdlcGZmKaxW6BxCC1w_2N2QmFajbcc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTyPWLBwMZ6EhbBXXdEf4QcVFn5Q6jT9zsoPIewg8dsQ&oe=6A7F0FC2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer Cover Image.png", "id": "1424912221716434", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/43931339_1424912225049767_2133304150870274440_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfBVqq1nVzsQ7kNvwF333fU&_nc_oc=AdpFiTGwxk2a7NMi7Z3mA4-j6vMWvHTo12UYpxjem8XLYMx87HarVXWjAOXy_FLbx64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE_wUKULBJQb_4wz2VHGo5_QVFIAJqZ2ELT8JbriY3PXw&oe=6A7EFDFE"}, "display_name": "Speedpad", "keywords": [], "long_description": "Welcome to SpeedPad. The fun Mixed Reality game that exercises your mind and body.  \n\n\ud83d\udd79\ufe0f Based on scientific research from Psychology and Sports Science, SpeedPad aims to increase your reaction speed by improving your ability to orient attention and search for targets. \n\n\ud83c\udfaf Your mission? Hit each target that lights up as fast as you can.  But be aware.  Targets have a limited lifespan so every hit counts. Miss a target or hit the wrong pad, and your energy level drops.\n\n\ud83d\udcaa Explore different 4 gameplay modes. RampUp Mode with shrinking target lifespans, Time Mode with a countdown clock and Color Flip where its color based pads of your choosing. Try the Practice Mode for no-stress training.\n\n\ud83e\udd1dChallenge your buddies to friendly duels, compete for the highest scores and the longest sequences. It's exercise, bonding, and healthy competition rolled into one.\n\n\ud83c\udf1f Train your eye-hand coordination and mental agility in captivating virtual environments. Or use in passthrough mode for an exciting Mixed Reality experience. Each theme feels like an epic adventure.", "short_description": "Time to put your body and mind in overdrive. With Speedpad.\n\n\ud83d\udd79\ufe0f Hit targets as fast as you can to improve your mental agility\n\ud83c\udfc6 Train your attention, boost your reaction speed\n\ud83e\udd1d Have fun while elevating your athletic performance to top form\n\ud83c\udf1f Challenge your friends and compete for high scores\n\ud83d\udcaa Exercise mind and body today. With SpeedPad!"}]}, "developer_name": "MentisVR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FkviGFDJYL1P3IfxWgAINx0RBWalIQNh", "developer_terms_of_service_url": null, "publisher_name": "MentisVR", "support_website_url": null, "website_url": "https://mentis-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_su
klv8n_TYg&oe=6A7EF948"}, {"file_name": "Image Sequence_010_0000.png", "id": "611372940986633", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982713_611372944319966_5908819421399743673_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9VwCasas4YgQ7kNvwEdzt7i&_nc_oc=AdqBAULWT-GeaVKGEBItvEiGoyLHZ0A_l4VsWc2rYNtkm8XRkixY05kedjs5ROgskaM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEex3SN8DERIVYRNTEIWUlA2lhpx8vHyD8GNH6yZ2FhXA&oe=6A7F1FAE"}, {"file_name": "Image Sequence_011_0000.png", "id": "254966370692550", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982553_254966374025883_5842330178800131513_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TACac8C24rkQ7kNvwEH9-rp&_nc_oc=Ado2e_KWMPESesNKPHwv5hoipcmUyGvbJtYvHnhpvZUtzUxDYAfEcW77C8zqX1w4JaA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHgBErYeRGmC6PrTMJ_-IYIi5-GCjgNORT25f3uJsx_sA&oe=6A7F1619"}, {"file_name": "Image Sequence_004_0000.png", "id": "301846022417389", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982552_301846025750722_4261715370222629531_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMAGhM2MWDwQ7kNvwGG0yeO&_nc_oc=AdoJJ2Av4mXcAjL5mDsgLvqYT38B_4XCtUel7rdlcGZmKaxW6BxCC1w_2N2QmFajbcc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFTyPWLBwMZ6EhbBXXdEf4QcVFn5Q6jT9zsoPIewg8dsQ&oe=6A7F0FC2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Speedpad", "keywords": [], "long_description": "Welcome to a fitness revolution in the world of virtual reality. Speedpad transforms your workouts into thrilling adventures.\n\n\ud83d\udd79\ufe0fStep into a dynamic universe where precision is key. Your mission? Hit brilliantly pads to test your reflexes and coordination. The twist? These pads have a limited lifespan, so every hit counts. Miss or hit the wrong one, and your energy drops, adding an exciting challenge.\n\n\ud83d\udcaa Dive into diverse gameplay modes for all fitness levels. RampUp Mode features shrinking pad lifespans, intensifying the challenge. Time Mode introduces a countdown clock, pushing you to accumulate accurate hits before time's up.\n\n\ud83e\udd1dChallenge your buddies to friendly duels, striving for the highest scores, longest combos, and level mastery. It's exercise, bonding, and healthy competition rolled into one.\n\n\ud83c\udf1fSweat it out in captivating virtual environments. Slash through a variety of landscapes with our amazing themes \u2014each theme feels like an epic adventure.\n\n\ud83c\udfafPractice Mode also available. Test your limits in an endless - no reward - no loss mode.\n\n\nWe have more stuff cooking:\n\n- Upcoming co-operative modes will let you team up with friends globally. \n\n- Competitive modes are also in development, where you can test your skills against the world and rise on global leaderboards.", "short_description": "Transform your fitness routine with Speedpad\n\n\ud83d\udd79\ufe0f Hit pads, ignite your reflexes.\n\ud83c\udfc6 Compete for high scores and max combos.\n\ud83e\udd1d Challenge friends and push your limits.\n\ud83c\udf1f Join the fitness revolution.\n\ud83d\udcaa Get moving, play on Oculus Quest!"}]}, "developer_name": "MentisVR", "developer_privacy_policy_url": "https://docs.google.com/document/d/1FkviGFDJYL1P3IfxWgAINx0RBWalIQNh", "developer_terms_of_service_url": null, "publisher_name": "MentisVR", "support_website_url": null, "website_url": "https://mentis-vr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_
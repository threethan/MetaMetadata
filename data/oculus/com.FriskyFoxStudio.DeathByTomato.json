cdn.com&_nc_ss=7f20f&oh=00_Af7swQW9Z7Kc9Qfz06rD5cmBE8Pz0n-4619UYUqMC2k-qA&oe=6A05DA3F"}, "display_name": "Death By Tomato", "keywords": [], "long_description": "In this VR only game you try to avoid getting hit by Tomatoes and other food. Cats might also be thrown at you. You can slice food being thrown at you or you can catch it, but if you slice a cat you loose a lot of health points. If you catch a Cat you get all your health back. There are 5 difficulties with 5 unlockable weapons and 10 levels with music.", "short_description": "A VR only game were you slice food and avoid being hit."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.privacypolicies.com/live/737a9c99-e000-43dc-b8bb-4fbd0e9e25c5", "developer_terms_of_service_url": null, "publisher_name": "Benjamin J Wise", "support_website_url": null, "website_url": "https://www.privacypolicies.com/live/737a9c99-e000-43dc-b8bb-4fbd0e9e25c5", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "FOOD"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "316098370490487"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974573_475603647546369_7831117003157760617_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyE-QxWMaa0Q7kNvwFaE7w3&_nc_oc=AdqcZLQq9J7n5IDt_Smq3gDw-4Ir7yS5bZcR3bH0_wkXANbP8I3k8Zjah2MzwEocAQ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f
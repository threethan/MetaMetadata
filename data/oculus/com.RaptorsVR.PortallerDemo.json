&_nc_oc=Ador67vyl7_mATsxhFzghubWccejpp1EPgV8vHoG3L2A6XJAxMBgGwfD9h7QFc6MqEc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af76mDqHYts3v72KnZeFHwngHABrbF6FnR_CgRrQrTiIWg&oe=6A184DF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8XTwpYWOFwQ7kNvwEyUxG2&_nc_oc=Adq_P-8tzJHf94GzHUkIzksr5tVELgDF2ydIxvZxb_5A0HsE7oBIVBDKS6aR2cJ-pXY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RTkCgoopTraYXPL5ZEGNxilxNCP780wbS4tDsGmbNqg&oe=6A1847F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSTFxTsRiSUQ7kNvwHcrd4F&_nc_oc=AdruOVDfIFu0Tf_XaHmXOQUb-dh-CVpicRSbpfn6lLv9b1qlGQsbqMU1UNvw91yr2r8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lbbTxbcpevzAro6wg6_MuD--SzLbB25jrpXzuxtCtjw&oe=6A184E1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFKVRfKVo9UQ7kNvwG4K7kG&_nc_oc=AdpR143sG4qfR8iX9Lv-p41R3HyeGoeJlJP2c6mwnQXkGdadBtxbt1vznSc1n6qM4qM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6aJZ9nlrMq_ysXq0fP4OOdenNQ343rlv3TNAHkMu4Ggg&oe=6A186823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmcX2IO25d8Q7kNvwEDV-J-&_nc_oc=AdqRGwUfFEnc_CE4v7sMiYfhUm61q3_IjcaL2Mt1KgfJ1cc5KyLlO6PC_qh9ELZJ69s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6GOWEsRuEvvxexX5yHZdkzjAbFXyjeaSnTQY_68f8_YQ&oe=6A185934"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdrCIXaEQ-pMDX-_ftn42MxYM_ZoOgETHLADG9ZXrdWu9fPq85hvg1R9RGh2HXTIA94&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1J_hP9SxYUqGGBX8jkWEjCtq9KaVsVuxxxjXG4Rmkjw&oe=6A882534"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CjslkfXBvA0Q7kNvwFBItji&_nc_oc=Adrljq0_G45F-UKdQ3gZxzYQ-DYj5Tn5y4zoELlH6QG3TF3zmKWP5KmMEHqs6fCYSOk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFO9ZKfID9335VQvVFwr0q9JuVbVwru51CIePnnodD0dw&oe=6A881F31"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4c5rAedZu_UQ7kNvwG_ZIMq&_nc_oc=AdpJsNqE1zc146EDaTUGiKPAeeoT1H_eKkDcq2FAd2C_WFjTkPO8G81PZpJi4oXGMqM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGXLtNJcSsCdBZl2gAjUXaDkyfGSfpRp09iD_cfN3LMw&oe=6A88255A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dBnH8_Jr9LEQ7kNvwFd86VL&_nc_oc=Adr-zveYpoDePMyU1bYM3WcjQpr98-D8Q7R4xBy8OygKdefTJ91cc2rCVOQae5IjK50&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9ZfD_aRcji3UPQ4i7cuaJ5kXGZx7yuKBDtVaJ3f6P1A&oe=6A883F63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YsyBgBc6dgMQ7kNvwG7J7CS&_nc_oc=AdrLjh8NkWLZTEg4hX2RDcuCl9nhQumwPfsiKcYzBNsYliI3Ss2yOm3qdb4KpT-NMKA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFcfW79kZam6hOzZIS7I791t9DfMIUArf6EQyafpOxIEA&oe=6A883074"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
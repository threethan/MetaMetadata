&_nc_oc=AdqcRD0zeXIonc6ESt427HPacAu84TelalptJIBLkihtdlHOZs0m9SpdqZ245pZTys8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsXDLq95T9w5KUjdDdrURwX6bTWAqqOAFtBxrr9XPBSA&oe=69C690F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dQ2-d2Fng0YQ7kNvwEK4tkE&_nc_oc=AdpnBEb79tZJEa6xB4MhfhfN_fkBnz-JzI00W92rypdEzcYJT71g7oKk0Ti-aMiEnec&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyZ1_xMXFonTs1VCCfBaB0RxCZyPmxEfsVQ1TPmcnacRw&oe=69C68AF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubz-HKkHrvoQ7kNvwGvA0I3&_nc_oc=AdrTMOD2VhTYO6ay14ls4wcQyrzaX68A_tdW6uat0a1Q7Jw7mZcOh_4YeNofRwC58BA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzryOc9uga3vhHlyfyRiy3xr7Up5d_rCCAoZ8yaOwG4sA&oe=69C6911A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ttF5VlFLD8sQ7kNvwHy85vv&_nc_oc=AdorNbONDZz-4732gaaFBH94UnKRn-0-YQoWW-C22S_xj1NIGbbVmZbvz3OuvyRu-nM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEn4jISs2hFgfusUMsOWFMfJ68LXXzbu4kCudU_Bh4oA&oe=69C672E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ru7S2-iB2x0Q7kNvwG4kYMU&_nc_oc=AdpzqHnTnau25TZz1XBaL7oEn4wBve2HAEbUVCJYGfUsv7dijbcFEdpnm2E7jT3K-pM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxrOlIE7McgBUpHkn90bwdk3TOP-6dXVnUrfB7zZey3wQ&oe=69C663F4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
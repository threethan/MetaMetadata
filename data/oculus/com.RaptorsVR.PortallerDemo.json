&_nc_oc=AdoaqZpNcflgxdcdwrvAulR1ABeBP7Pp6I7x1lAkNW5oRBFVuxreIehgv5-WnU4hCuk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxz5dkh2EPGRHthcfTf8WfsT0vtPlwM8o4oiMZC72deA&oe=6AA6AFF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYmIFARiUTUQ7kNvwE6i7EQ&_nc_oc=Adr_exwt4JxVrlIIgaHmkgmQLl8BXi6U2PgFh9_klq5ru8VLR0Vf6HjtD_YpXyYsQqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJER5Bl6ez8gqJlR6eape_DShPCiLm26JLcOVfNEu_3Kg&oe=6AA6A9F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qta0Dx0_dlIQ7kNvwHkWcxq&_nc_oc=AdoC7LGqQxVjfcscIwmSzwrC33azMZXBv-piR_C1oZh1bflY8fbcuInbEQTxc3RKN6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJrFp7b9egjpy9PCmRdZd5BWQ_u2TDP9mI1EOLVVeEEg&oe=6AA6B01A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=seYFkyXIiQoQ7kNvwF26SgS&_nc_oc=AdouRKOyHU61iStGhlvva2qYDRYWT8v-s7cZjsv94I8PUsQmierrA-IUmBYnZfl67u8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0AdO-hwwiUPgdjMy3SUsLJr0NlI-HEZKUOm2iAwdZhA&oe=6AA691E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dUM6sYl0I9YQ7kNvwGpHL6w&_nc_oc=AdoB43raaYPMh3RKRA5JTdHU5TL77nfLCc_oKELuZagEF5sxRY71ADw530W5UOCyhHU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKrysS36Gt7-rmcbU7B7gqw5PG0vMTcvPEhII-1fwEHIQ&oe=6AA6BB34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
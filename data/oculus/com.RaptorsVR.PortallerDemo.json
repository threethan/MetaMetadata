&_nc_oc=AdrCzOJFNRzlryobYtznMxVQ_F4vqpPcMPj_AkvJcnFWhlqqFQt8QjLHTRd6NdS44lU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNMdfVklTuqoIPAGtN9a1X3avLr0-ps8FTRKbDyOtf7dg&oe=6AC50274"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWhvDOi-j5IQ7kNvwEWPTxw&_nc_oc=AdrHpuDZWalvI3CgHzAphyW1Nunm9NeKJk2IQSj7bo9PwdR_elMFZV2DNxFEItghdrc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsDqwSKTHQNB0-JNr1sDove7YC1GZSCvjPSi6HMJaEyQ&oe=6AC4FC71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S_ZsOvaOHpcQ7kNvwGp4vu0&_nc_oc=Adomh2_p4IuJeAfKZ-bVZV_ErkyLRE-brNu123WgZ_Bsp3oWPnkw1CShav-YVgXUIgo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOAzQxkN8lnWCv9niWctBf_68JLn5iTALpFoRRgZ4yiKA&oe=6AC5029A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbGWRqnbtkIQ7kNvwGkKpTA&_nc_oc=AdrGAigepKv1fBl0rH_u-ty62w48vnBOE3amp5YUpNjnWZKsfhuDSN1yUhA5VnEp7TM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPcQQ4Dze38GUCRgfIr25MY1vDm1puQvl2h-E_alKzr1w&oe=6AC51CA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDxZWHyizCcQ7kNvwFZLlEv&_nc_oc=Ado3ldErpUnvKAlnk1fb_zLgXBGMmwtFgs9TfiIWoe0sMFNXiWqqFEFvCUwyIbp22FQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMvPJN52TF5oC2gJdn_JbIXkbpF4GCozgxzfFh6SEbycg&oe=6AC50DB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
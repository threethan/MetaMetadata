&_nc_oc=AdpC3AlDQQ2ziZ2yIKZmfBkGoBCpMX5R9lTLEmg7yyxU1E-oKGC1lUczPbGx3iKX0Pc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Vp-V8kkDY0TCBImLdfq24Et9eVuYjyMzvjGy3AiExHw&oe=6A3E8974"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-vDG6evuFQQ7kNvwF62NMh&_nc_oc=AdqfYS9ht02uPzqHo5i2dXucdruskStgjb62UqEI3JnJeFzq7FjyOB9N6oz1wjNJrws&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8azoAG8-adA60Vr0pVEzlhHpDsuQPvPAZmWBqGHScpcQ&oe=6A3E8371"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfukHhpWn6sQ7kNvwHBH_Oi&_nc_oc=AdpueJ1FXbfAKtYDR4tu7oxS-IvQAFuXs81p9WXqQHPtzXMizjMuxtCxp-EqRZ7rzUY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MDAgUxIkfFvAJwU4DIHB8gQBE-lnqZEygWwc0cAGMGw&oe=6A3E899A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cR48D1Vw9hUQ7kNvwGccc8X&_nc_oc=AdoKGfrmct-WeYDdWyA0C5aJ7U51mk56rFlVj4IYPgP1BOGvq-N0WniA6HLMe8HPiTI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WXOwTG1kvZ8pKMR8BmPb1a6qNcEQuvKD1629sSufUdg&oe=6A3EA3A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AfVB7sgma0Q7kNvwFTaCfD&_nc_oc=AdrC6Hqv0Gn_l4q1OfxABAQd8ICL7nsvMrppzaIaIBPa2SMLJIcgfboxe99jEAFoZ34&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8w60I2JUrwZhv_cU9QktqOyLQCIIotxlxaBB1wRTcn1g&oe=6A3E94B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
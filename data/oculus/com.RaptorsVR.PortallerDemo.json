akMyOLie5dELOTov3aUBpdIw&oe=6AF735A3"}, {"file_name": "migrated_image.png", "id": "343236869967266", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAXWoqjEHH4Q7kNvwFTbtfd&_nc_oc=Adq-LJPVjaiNL5qpiZnyRR4CEYq8xs96irJdbq759oG4R8rCgOanduYNOFAbrhqRI-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8JpRFl5ZZ5u1fAJhqXRXOgIH5obdH2E9MXOWLpRnU7w&oe=6AF71B9A"}, {"file_name": "migrated_image.png", "id": "191623088951747", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12386220_447595682356269_3799769657104138240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2OYXfmELF8Q7kNvwH1fDen&_nc_oc=Adr_EjHF6ocSMcAl1k926N7uHWqh6ATtbtiYTujqWgaMM24M1Tw353HRgnTxXoBovPc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiuK2Jq3eK0V15preO70MuFzBRQ1InFIikgtfA0PtSxw&oe=6AF72FE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "304176820116737", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/10000000_304176830116736_5149671989836775424_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYGLJINbNl8Q7kNvwFLu9Sg&_nc_oc=AdqJd0y6JT3cBigSIXWcmwkPxCA7GoA5cvB7ICLxLDhxo1oUKBxMDY7fD-03cLbYWyc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvmjkieZtlN-MVFnDHMl6dddFMKSOaCRTolNdtB-j_6w&oe=6AF72BA5"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yuri Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2149768438507099"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "183635952323998"}]}, "baseline_offer": {"id": "183635952323998"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1528304400, "status": "PUBLISHED", "id": "183635952323998"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1895838293774083", "version": "1.0"}, "id": "818865614975482", "channel_name":
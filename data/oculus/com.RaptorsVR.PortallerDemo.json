&_nc_oc=AdppjppZw1Cfuih4xrSN1JArjQJX1FJ7tnZBcTLPluT6Nt98x6kxmZLWCSj4qiJ6sjE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBf1fYTbcqt7XuaSbBlgNjcvwLFuAnPq7ePIhNGKB3oyg&oe=6A54F2F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jbDIMmKX5PkQ7kNvwF_YDxH&_nc_oc=AdoPnvwYC7SbzEdan5CCRBUCppMspPDb0s13iphNtEe2lkYsXqEETypdigsTyYESLQs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDALUXqU3X8Lkx0-K4gw7o7iCLvbzX2M7KAenThCOudlg&oe=6A54ECF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gYjuvXHMwqMQ7kNvwGbk_tW&_nc_oc=Adq9L6vNLvDU_0OW9_YlweBv_tAApMQciSfIIPumKyNberjstXiG9ELhO9oA7-STl6s&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcdsVCBq8P5poDdO7XmA2zi0RDsQzIEzdW1EgB01OAyA&oe=6A54F31A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCgbNvwQc40Q7kNvwEOeNAT&_nc_oc=AdrFyGwZRaH52VD1M0Y1EPBr-DYJGS5orpMz8iSvGgr8hHyNgLIgQ8thb9TbFzhUJjQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5skFhYRUrQZ5Btxlts6cvOp7a--8JYTR1pPPEVYNZKw&oe=6A54D4E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0v2oGCMsKusQ7kNvwHqleUd&_nc_oc=AdqZmVrru97Q5qStPbKLgcwJ-ASWyFRCyzsBQ6GBaY0mi9GtxHh--dIC6KUsPAsS3UQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1Su3jaOLctmWfRHnSpp_ywOBNLQyx7oRPGUIv42n3UA&oe=6A54FE34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
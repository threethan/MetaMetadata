&_nc_oc=AdrAGl5dZnalnleL0GoPh6YCNHRi96DAhQeq3Pswn_c2vJXSqzHOQJHALKjHYrh4HaM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFiM4UwGkOh5FEzmTR8J16ves3Yw3Nme6T-fMPXulz8VQ&oe=6A9402B4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtQNH3UF530Q7kNvwEp-f8v&_nc_oc=AdoFUOQTd_endwuuvIDWO4oValpn9uzCBDF7WPxMwDPIMEUVSPtiCQQouDAMvY0M-bA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGII6dj884DYZLKMvTcMTHvNhjFVdmfxYih-bYxByEV6A&oe=6A93FCB1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9kt24PNagwQ7kNvwEL4tqA&_nc_oc=AdpNPZcea1VFdSEB16xbOtgT-glYFa1D_VjQuAoWqHzMOq_wUwsecDu2xWqQV-bN9-M&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGma58w5uDQbpNXbJUD9cUjQ2j8q9DdRKYi9REQGGrDpw&oe=6A9402DA"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0c8DR1egVPgQ7kNvwHS2MQg&_nc_oc=Adpn0vktlWpQCDg3Hi459HMSl0WT4AEwFa8xqaKid8wQp8tyHGd0DxlK8KYUt8V5xu4&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7hoCqguFH7C1vNbUa3GrzcCpegd04U4PSn3gdMw_dvg&oe=6A941CE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i5KKAue1ekIQ7kNvwGlhCZS&_nc_oc=Adpr_6BSOTR1jZyCAEkS8hfbyhnUlVP4prwwDS3jiS3CAWknyL4H0rDq5xePz-cQWoc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXvDWQPjmf_5F5m7LnAziyOLDUBdN3L8HVvciAOaNfTA&oe=6A940DF4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
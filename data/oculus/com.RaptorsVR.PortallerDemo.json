&_nc_oc=Adpg33kXtsOrozOHqDImZDOT3mFRup5pqgp3ZGTYfuA_tpEn57fSooweYYmUJOGTge8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tBLkalk7FGkq62K1WrNNzrFSV2bX8Gn3JwV8FgvAibQ&oe=6A145974"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IaDOhF2POxMQ7kNvwHpEB3d&_nc_oc=AdofJg5VUaIRN7YhXEcY4rcaroLZjuKXoGf0gLI1wqA25f2SZ1yvLSbP_98WLrVDcLE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a66R-cNRgJHZ3zAMiCjP3kCqNjfMo__ie_H1mn5p7Ig&oe=6A145371"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KCmcvljS7OcQ7kNvwF-R7dv&_nc_oc=AdoX_Jmr4HFOEv9LkZs11JwbSG4FWKwhSmF9F0qg9il5wYncelA6iSHPrwSmjBlfUvM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pWKJ6RH4cwb_c7n3InNn_BR8B0Z2XQj0XpkTr9cBOJQ&oe=6A14599A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QDNBDQEw1kgQ7kNvwG-sImQ&_nc_oc=AdrnEZ2tsWZdrlMkS52LKhcmviDAqIgCzFwhWW1TsDRT8uiq79YaLGy5HrrwL_bnOek&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4HJcxcgIgW9kQX0xPHYfHZ338rPhtHJ2E9c750zvckSA&oe=6A1473A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nsy6FyOTNzkQ7kNvwEfQ3wZ&_nc_oc=AdrFGVp9ju6LbXPkgysisqzfrxlIZTFXhMFWhCECgqFtjg-eoIGeUR_xj5KZ3D5q12Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bB9pc3u_bvDqhygJB60gWeelsH14vEw-2qPeAhEw4IA&oe=6A1464B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
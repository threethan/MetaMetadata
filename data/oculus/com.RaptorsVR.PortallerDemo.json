&_nc_oc=Adqi_5n6Ztmi5KTgtboxt70ZHgfNlYcUIQIAIAPe7lDC6fV3bp-4qTipZayFe4g6y2I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAhjKtpUrBwOZppwlXjlOCAwgGS9aeyz4nDzZwigfKtA&oe=6AA80174"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYmIFARiUTUQ7kNvwGWY7FW&_nc_oc=AdqCybIYrGFuUE2AZpV7n-Mzch75MLNzaX5Q3hsu5UXozYuhZl7j8ClmJPQSjD32i-c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv9JzFw5xQMVsXSKLYHr3iFJJXPyw5QJlzRWGoZzJ5CA&oe=6AA7FB71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qta0Dx0_dlIQ7kNvwGQuPyz&_nc_oc=AdqpFDS9NhvQXmUKsVbqCB4CT92xwBugL484ln2tqn1ZNpva6C4mqNzNGlmX3KYSw98&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZvk1E8FPwNjbxX87OZlGf8CEqnEnXFWlia8GbaDdR0w&oe=6AA8019A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQUiGJTu47QQ7kNvwEGmN4w&_nc_oc=AdrcSKQ63jC0cG1VMCB6s1CU0L_7rzxwXaH-NHlBG2PYrwz0EAOXZ9FU8WM3tjjgqA0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhCAV3j3rzTSzAqNs3gC4rzyDhuvdd0PGmXUPOu0dT1Q&oe=6AA7E363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-LPQCGyVTcQ7kNvwECvl3s&_nc_oc=AdppOJWVQmuk8iVjlAfEFVyWcyc_7Y11e2JvHl8lDpImD2iynEHf-KNo4jh-IRGnoCs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIknLj3wQYT7qorDky6LTuOKoA69MZ5aI6SjYzldbCZg&oe=6AA80CB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
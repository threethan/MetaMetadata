&_nc_oc=AdqMJmbQ3hDeyL2UcRVmMeCO7JuEOD2BkAKOJtAx8KaDYJ9v5lhnFyiVuGi4CyLbZGw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af14J1Nyo20FfMPJbWT1Dv7L98-VzELzH32obAJ8cFidNw&oe=69E634F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zc3xMYcgnMQ7kNvwFxohoC&_nc_oc=Adp8VUIewPCFl1UVpPD7BsI3y0gtMVbCCFV2W1mG7-FwMVX5UMwqYUMQ8TPyKWlisPI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rqA0KWqmeQoMuxaCLzvpdB6T0D2MrTyYRq9Caa-21iw&oe=69E62EF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-MuBUfyS0AQ7kNvwGPhx24&_nc_oc=Adp0vMqE_Ed5mY5-WPmho8Nj33SKhX4-U6vEUXmkqriNRkhgCdPvUQMVbQfZ5SAU0mU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11tRVrC0m0C0c3TQmt52pYkbTaC6pcAxgDi0dCeXah2g&oe=69E6351A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shboh1W2nKIQ7kNvwHdQ8Bh&_nc_oc=Ado5gD7uHBbk0C62cpu8DW38F8Da-6exw1BWLD5IAKkhequMSBdW-ktY8TVZADqYuik&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Bmw2jEM9PxSYKZ91nSc5afRhNzkf1jjfOsscUYSvnfg&oe=69E616E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPjV5o9DZWMQ7kNvwFfgXp5&_nc_oc=Adq2OKJ-J1r9uiLeW28TuZBdwVELoP7kZvWaUjVkAzCyapgPTSS177TK3el63McqElk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wpGB1QW6QO-xNmCdM4YYxkuTcRDsvdqaaAcFaRDfqQQ&oe=69E64034"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=Adq2MBlyZp0Jocw5LOILXijpmuOzEjVWEptIks_4XAi7xnOr231vE-HQraBIwpHPlJQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy6T1HsaUpB4vFRWIfbqLId8fCpvh002QKHvFWTGFJeBw&oe=69CA8574"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAA24EA3mxIQ7kNvwHrBbmJ&_nc_oc=AdrMfcD7AWwWyC5SmJNAJ_upBQo13mSUMozW8rEVjTB-katT2ZZLbugJsxPFJZlxoMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwE7BYvVS6AYkcYhV2IZqnn00-FYNtWSZF_TW9-MJ9f0g&oe=69CA7F71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=el38fMSWfz4Q7kNvwF-JemC&_nc_oc=AdoKmzWOyQ2lrCikKYbCmwxeHj5OZSCV67fJ5R-_Lp8MjiDUK4AID2Akb51dDBpJLSQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw4ezzvhAmIY_VYcmRH0p0sx6kMCVO0j96pMK5wY6972Q&oe=69CA859A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzNKvOmrB1IQ7kNvwHTDOfp&_nc_oc=AdqO1xBMJENCIXv3GeSlTbZtufa05rO4m3d4F2uVI2IW5ovaYF8FktzYxi3vdNHZFs8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyR4J6zA3rFo9T2ITE0ytGlggJZwG34KhnVUlT_J3k53g&oe=69CA6763"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zFUoPtLacgQ7kNvwEKbDw1&_nc_oc=Adq-pvwr6qy3UP4t-o9u5YTFseWDnpkIRW8BTlBIWqX7oVB7ku-NLljB3rHNAuZsLxI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDwh08QCziYv6A14Fq6GY-YRiVgcJDZfVWev2vqCeqhg&oe=69CA5874"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
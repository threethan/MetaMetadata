&_nc_oc=Adr6ZmHir-5f5UYXwqP7xaIkiP98coo-nj3nkN0JXmRhwiLoErsbFRYWLW4MPUUgUPM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7J4QVeDTxLKHRvaTSuHysHBt1x2CwyI4QdE0KZCSSZ8Q&oe=69FF4174"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqwGEIbT6w0Q7kNvwE8i7vc&_nc_oc=AdqMfiN9MoU7vVemvxbVMfxlLWQ706FXc_HGtEEF4g2-w_9hNaFTC9_3uhfE6Pzxd4Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6uuB0Z4phCtelcUP1hRyyIBdpPjU-2jYS6vkn5d8-ToQ&oe=69FF3B71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfdR-tT5GBkQ7kNvwFQOiNW&_nc_oc=Adpi2MDVjcq53sru0SRo3mdVsWuwMc7O5pvykMWG3bD7NIdH6HwYuLVKt6sjvPo783U&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4yLRz45iM84G8wZC6lJKTshuc-3ScMPnNzV16q_Jl5Vg&oe=69FF419A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hf6aYg-I93EQ7kNvwEb8uNc&_nc_oc=AdrvyOzF2w0tMIRrl5OgA4dn510w-bFfiExQ-p4QImO4U6_73MBQSrxilNz4T19YxvY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XYG40YTtGPPNs_wNepW5-grCSzhu-GOQSyLASVtDnqw&oe=69FF2363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNKYiPWt_2wQ7kNvwFLCLlR&_nc_oc=Adr8GhNmefFF15opg25-dzQqJo7Qajc8L9DxQRUMgC6Sf_n2z-DwDuFH8On3d8SquHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7a3tTFsS2ebTPZKH5IarhURzV1vqsfmF0qFQlU8YDqxg&oe=69FF4CB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
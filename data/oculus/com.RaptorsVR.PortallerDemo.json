&_nc_oc=Ado0ep3kZ--2LRd-hsdw6VYAT13tvTMLALkhNIjN3i88OjQ_NH6qGaspXr-YMkX9BEA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKZOSffWF09ngPeopOJEGdkgog35UGsspB9jTy6Zkh3Rw&oe=6AAFEA74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iqAQcFgsxwQ7kNvwH7kJnx&_nc_oc=AdpQ-Y2voAK0o3WmfxH1vhPK1jez1G4XW7pm1ZDZpqNX9D4lx9cw2LH5siX11hWBfzs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkL1xc9eMM6b2uwMuvG_o9lEAX8G7WbPjPLwhejAD2tw&oe=6AAFE471"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoQ2Y6jF1T0Q7kNvwFNryOz&_nc_oc=AdokGdmknuGA3XGtzstayj93E6RtpDMyflZe3mED0m5lj2MoaOHXWoRcL3-thn1FMuc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqiz-wrygBbt25uKc5qnimCKOkZXcbEdIG5w2p8E9ycw&oe=6AAFEA9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xd1c4GV85CsQ7kNvwGuef4G&_nc_oc=AdpM8oDelzSBH6i8ZULRZmhrvyKR_hnu_l78QLweVQIhmbqv7okMIs4hSi8j7CHOjuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwEx-4g3xOL4yJ6M608X9KTQNVu8JRMYXySR9PhlFOKA&oe=6AB004A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NfNm7ZqFWgQ7kNvwGA6q4-&_nc_oc=Adp7WKUGJ64XtKlDFkA17fxaIrVTVTjmu0pe6g-a-xsGyGy2KkWsyQo33tm0Wt6L8GY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCjQeB--z9guJ4K_eySTNrK23KWkVCvN5FddWsVwVZCA&oe=6AAFF5B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
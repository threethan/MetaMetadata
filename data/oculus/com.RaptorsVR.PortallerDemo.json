&_nc_oc=AdpgEF6gkn-WCYlLdt_UTt71dIAtEFokMpwJz7hJkOshS5Dq6QDq7JwCbB_0N6jJhWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTwpNVpR3DquLC6_tZ5MhZLICdxAOaKUchCzkKo-eW_Cg&oe=6AF8A534"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bD5LEd6oFWsQ7kNvwEcjQaI&_nc_oc=AdrOFJmItGEZHXWv_6B-p_wbfXk41jigwV8hXlGEgDgzPSsUOIdWSPKF07Ht6yzRxq8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQReotK12Q2bdyiN8e9dd4KnwFzOM9Cvy9pDw7ppahXFoA&oe=6AF89F31"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XB-5mgzcZMAQ7kNvwFKXVDh&_nc_oc=AdqJklBfmfT8SZpaFvXoa-6I4duuJP9Qt4tYycJ1m61vXuPM22DhWNZvNh0OaPkTo4Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQb0uS2tSkU0n_qJGtnXk0iTCamI_HWHhTovdi7D_itVQ&oe=6AF8A55A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ1P6R8vrBQQ7kNvwEBpnLk&_nc_oc=Adof1S0GjX3S-mGFTu6RVAS0WVU6VcJCKJGdHQMPwR7535YwAEvGYWYvDlMV-xnao8E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGdC5AJkLgLqIa6rNy6vINsUm93RvD5G6Pl7EelsGbuw&oe=6AF88723"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INTgzrAdoKwQ7kNvwHJwZJM&_nc_oc=AdqlYdn98csF9DKlo2W4dUzvYoHF-m_aiuItHkgkCqkTmPu7dm4CHl2HjvZOWyGuccA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyj2BdbPimzhiHvvgJkLgHE-spOn_RADwpBdbJfwd7iA&oe=6AF87834"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdqXzRHlt7mzX9tcTo0Ryy0woK0t3P6QilN8LI4AKq0wdfskMSeZZNBepNbdgYE5Lcs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8czpSlErkxBnPcPT6xDxzRzzTni9QqNhl8vVcJaIeMXw&oe=6A3008F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SogB1ioDJ4Q7kNvwHoU6zK&_nc_oc=Adomhl97Olayr5xcUqEGFO5WXpQ9QEagaUneGIig15RB6yww8RvSXwRtaELGTM5V4Rk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Ca8wpEKTm9BlAmmulm8NP2OEnYYjgU_68u5goypvdFQ&oe=6A3002F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re1h8tOcUe0Q7kNvwFOZP4D&_nc_oc=AdowiQjC2nyi7EvTCUn6c8m2nMcSbOJVdA4xAtMf4hsBAuiRUxQeDJOUy7CRNHIINHw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89pJk6Fj4eGAK9aidnf6kRMGDW5eMnd0afKWU8Qyq1iA&oe=6A30091A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmjDUiBS5cwQ7kNvwFkhzw1&_nc_oc=Adp3zrfAdI3oMJtz-zuHmaVyy1CIf-r7_OBIEbepYGFfgFYr-XtwhMNZQ-tg6Z0cdz8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-viqxs9MlUOgyIXniCjNkctatra0UJCDFnzastNV8a7A&oe=6A302323"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yCRhJ2nIjgQ7kNvwFXrjeV&_nc_oc=AdrrficdewNNp2yDHzbbd5rfhf36bgmRZK0bM8J-ivNG2A0fFrbfyMLnoWM8DYs3Nrc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rgRb_jFXytNhKFViOE7gPsvhUqCFOr4bAXpn6B-cdmA&oe=6A301434"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
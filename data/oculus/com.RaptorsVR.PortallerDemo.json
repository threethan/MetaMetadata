&_nc_oc=AdrdNi28EmV509oFWGC9PvfGju8Dq8aJZexND1s0TJ1dIGMtojPQM2CPubXjBuO1Crc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3Jh8roqrPoZs0yEvRWory8bJyn0ArG_VfIZi397U27w&oe=6AE354F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGmxYcJ1QwAQ7kNvwGDzCSQ&_nc_oc=AdrAMVeW2eYjpbvpZxYGDD7wx6e-RZaIfYmcbQlqM5SNmEueSChA0klGKwW8peYop6Q&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPbIlFmPfYxXik2aE5q0MVl-xTLeAfyhrl62UTmfjHSkQ&oe=6AE34EF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OFPGV75lgAQ7kNvwHAMCcN&_nc_oc=Adp1HMwNMAfUn-ljkjUyYrE1I2mblJ4NHScdogyAUUzZf4Po39NRkm86H14ywt6zMa8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx1yKay0BjT-V_fNDlKO0jkXyNN6zkfsGqYHw4LQa5rg&oe=6AE3551A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QI7jiDchJCYQ7kNvwF6h-Uj&_nc_oc=Adq39oLBQBS09ZfyTiRnHMcIKjffYF2o6IgNd0ezxENadBjADGv8t8WORbFA_hEd0cU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdQ8MO1nUpu22pF2aBtfNfdDkP9KK5tYjMH_EGQ15kSQ&oe=6AE36F23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iXkopAptfrkQ7kNvwEayKaP&_nc_oc=AdredHHXR9lpjXhkU73mP2g1EzAw4x00VAO6aVROquCqGrPgePzDzMoJIB9UVYPs8uQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzaAGoscJ93KA6z2sz7-f_3ypoVTmIP8xa5LZveF201g&oe=6AE36034"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdribNtkKFvKF0rkIMoJNB4KRajhB9suiqz4oosw0IznEutMTfDSweC7i6-VEO0d1YY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDpN66oC5Vv954jCZlqEoUJnDNHmCh5OUrCWANT5u80eA&oe=6A68B974"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZvOzXB1njcQ7kNvwF0cJDV&_nc_oc=AdoXBIQgGCLEbtU37YKbuJ2Wv1SkFYyaQNWHc8pS7cmLV0EjAKvbbCBRguTLeL1IM_s&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcSxxedmHxRorhPmZrP0GeGktdnpiK-FWGWMBtoA5OTA&oe=6A68B371"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gCxqHkiw5DsQ7kNvwFkS5TL&_nc_oc=Adr9b-H1H51aZvPl1R4Yoyam8AfEc_6jiaNuwOgjQgiGBFPtCBBckolg5Dqr7SuQVK4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaMazKgDd0C-V02YvoK2ylfnaBb2MNDlhZIBY4LVc2SQ&oe=6A68B99A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIgaTLT4bxAQ7kNvwHqPhnL&_nc_oc=Adq1saeFwCYiZ3rxKVCM-YBe3TcXt-G-1p-x8SZsvGOrmwz9YgyrgvW8qYj9yegX42I&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYoVejatabxr0FSQ9FPdPlCCCPHz52NkU1L__PgC_LWg&oe=6A689B63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44_jB_yrdzEQ7kNvwFqGyo4&_nc_oc=Adql6CLRmFCsy0UFy4OW2Gn8a2RXA29ORYqQA9RY5Py_g-vWlCH0s2BVkbPq4qGEJGw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6xipVxNzyWY7ur7iaV-52wLFgisKdMtRlZ1DJK9ulrQ&oe=6A68C4B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdrHBOr3Uv3qScEvZo2sc44rR9doYquwnJxqSW3KGvwUbxvSG05k0xcK82IKWgDNhlg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ubXuGNWyHESx-2jqtWYUHPhtvKbqcWXsLaAYQ-db9lQ&oe=6A1C4274"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Sos4SulfLsQ7kNvwHOCFCx&_nc_oc=Ado5_I4k2yOQPxaVH_fZxasI7pddzFwxO3jU4X9ZtzdSIAvFxKsHfoX0u6COSuix3hU&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ejsK-FjOae22el7fvf1HyCNGn9ebupeQhnqsgHpn8yw&oe=6A1C3C71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gExOLOI9LV4Q7kNvwGghGGf&_nc_oc=AdqG4QmsVHtozx7jyXAeTehlMtIMucgifk1gJNeYF6m-pV16gI7pXJOOnqn3uiMT3wA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7j8E1uaZo8xOZcgnEksElx8CWrsFw9jKnNO9hBU1UaKA&oe=6A1C429A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5sdFaZvSpAQ7kNvwHkHsCN&_nc_oc=AdphuieuHeArjk42pr-RZs5JuZr-c00O2BAN6CoiWefJ-BHqc9oEBGP1329a05NaCl0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af47tdJqGes2i0J72YkWNWR1M8wK3PVcKp1Y7g84kK48bg&oe=6A1C5CA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wSJTvm1JOtEQ7kNvwEIBk_3&_nc_oc=AdpLYszm7oD037FXVPWXvBnz5TAtBR02FY6b_FAWgytFEv9J7z2Dlo8TizcY18dPBU8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ogKDbl-HLl8QK9_b96YTmQyZKqbHtQwg795S0PJT8Yw&oe=6A1C4DB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
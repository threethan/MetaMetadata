&_nc_oc=AdpwDi8-kcEYCvr-6S-tmEyQOzbYql3sR0LucMQv5lRrL9ojlG77eiyxyuKNyKxffQE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6n12uNttt3YLCDEOF5-WzfZ28kKIpNkopiLvNd8EtXg&oe=6AE74974"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxAkT4wnlE4Q7kNvwEHKWnc&_nc_oc=AdpB27ZGkhOmECGRqSi7s-yE6RV-mWMaUN83kmYLfAwr7M2qW4WuuaNsx6rpzGHJuYA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMxgWfY5HVfZ7oi51WID7kvN9Vd0ib6ZkWXYQ4imQ0NQ&oe=6AE74371"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0jx3cGyW6HEQ7kNvwGAxhd0&_nc_oc=Adoec5NkCYkBxsdt4krDlC0uUgTtMslYmAlw5GRfhaPOxPTJwRPSBPoTvm7QWyuO8MA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjyaQ8rB2vvQ23Ij8bxP9bJOMxoFVKVw3L-jmKlAJhng&oe=6AE7499A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NBPja9X7tBAQ7kNvwHfxD8j&_nc_oc=AdoRLaaGAjGLA9mLpWTxtnHtTnGnvhaR2yHp3kyVFiefAqcntfy00Fka2c4mIRHXVcs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTKrpv3LxaAd208bEu38sCxb5xMButPtlfOus4E3ff70g&oe=6AE763A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zqpHEyCWIsIQ7kNvwFdliQw&_nc_oc=Adqaqo9q9ndIlsPI2ZqzlDS7UjOZS5TcMt3i3RmO8432bgrKbaFs_dUq-LzSpCRo-EU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzbO6kjZntrSpAtVqhrTN5Z3R_Up5yB7WV2ekFcyNtKg&oe=6AE754B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
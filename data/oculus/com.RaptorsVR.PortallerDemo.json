&_nc_oc=Adoc8AUSbkE6iKp8Qek7_xRTeP3H4WjlVlR-otrCAtM3lRzbi1kn51raG0wVejId5ao&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iMx1e0i3IQgpc--BYHlxWsEmr8QkaFhB1WlBM9-I_lA&oe=6A0335F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yju-DJ7YUs8Q7kNvwHRop65&_nc_oc=Adq8b84iZecjpQ8vPCj61MksKs2GzHP7JXSYSEJzSyMc3iSOsgWiXNML0U3voiaNizQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4lBZPTsdxMER8AAxQEun3u7CG9J83MtV4vPpP0tgeYig&oe=6A032FF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHvdsuCiZ30Q7kNvwEry47Y&_nc_oc=AdqJA16pOgICxUeoL5cLLGZCS3JsuMqIrD1X8KoP_8HVFYvt2MulwK8v84tmVu7TykM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7r7c1V7mTXhbW48TqoEl-tmix6K_Z-V1BgOIkzZpnyuA&oe=6A03361A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CT06xJfn_8sQ7kNvwF_Riwi&_nc_oc=AdpW5CTzHzr2xMqekkjPt3xU8tj_U3_74bwYezES4jnP3DSopPiEqtKkrAWy8oH12IY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7UqE61CoYxUpBnzwMoQ-hy0TAD3qaHS2AwC-4fpEHsGg&oe=6A0317E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmFp-HT7qkwQ7kNvwHrRSVX&_nc_oc=AdpA55tFrpGU_vy4X5JW5jO8-IG1c_DmxgNIGDz1yX7pAKnk6rrfcb9jiY8mu7fQSHg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TWWU-Fhit4gA7MJN7Lr6bcDzX4C5DXyHEKNAjkKlMow&oe=6A034134"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
knrosd6kW-s_Xzsgp46S-z7NIi8YBO8qhA9zw-x54&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&oh=00_AfvKXpyNcEoYo64fUmZX-liL_WgF_-1gp-Xi71Oor60x4A&oe=69986C9A"}, {"file_name": "migrated_image.png", "id": "191623088951747", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12386220_447595682356269_3799769657104138240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N7Y0YpteFwQQ7kNvwFL6Qbo&_nc_oc=Adnc2hdbVM_cLP1bGfHgKJD2TeG3Fda-MJcdsIfu5yWzSFG1jcsNl-sJmy6-DpM33FE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AftjRFU9YHo0PIYFcqEVehhyK7ttgZvkdkBe2lM0_DkO3A&oe=699848A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "304176820116737", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/10000000_304176830116736_5149671989836775424_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RBrQRgslF4sQ7kNvwGTZtfp&_nc_oc=AdmY1cUt7B7cOwaCBQScP83l8ryFH_NeO1s8f6gX6i7sgCmI4awv8q4rp6NbEYazJwQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&oh=00_AfsE0Zohn7ykQuGZ1EjiPckrjCwTpp6hCLGOl67U__pkqQ&oe=69984465"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yuri Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": null, "developer_terms_of_service_url": null, "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "http://raptorsgames.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "2149768438507099"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "183635952323998"}]}, "baseline_offer": {"id": "183635952323998"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1528304400, "status": "PUBLISHED", "id": "183635952323998"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1895838293774083", "version": "1.0"}, "id": "818865614975482", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1884707998220446", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1895838293774083"}, "release_status": "RELEA
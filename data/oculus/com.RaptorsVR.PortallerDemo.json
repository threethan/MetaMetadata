&_nc_oc=Ado1e9L4RTrqMdDM4q-TSjV55hdvWr7PohUO1yvwbIKovIpMGG49i16dqaeVLnh4rjA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPn4Lc1Z4-L_5J4HntkefIlPKMMyFwTU38ZmCS5AQq7g&oe=6AC10DF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFAKZSW88LAQ7kNvwEKU6ws&_nc_oc=AdqLteDOIrnqN4uvd5uF0lwc6RVsv2gsiLk5AM78jIhX-HJsZ-17ScRo4f5yq6BUJr4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP2Tm5ZIsUKoLoVH3sbiIYW83-MZFjrAu3RM1jr2TTEfQ&oe=6AC107F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4usIPWFYRwQ7kNvwHuf_Ij&_nc_oc=Adqht5_XVB-sApfGlfxumuCfk-Tc5tJP8uAxcx7JFrx7hlJkZiQofrQ3CnEqvVfC7J0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo0F9MWPhm6H3sxLoTET58lW9F3oYsWjhxRiYHjTOSVw&oe=6AC10E1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grcauwuKuEoQ7kNvwHTR9s6&_nc_oc=Adrmn1gpuAvidr6R3FcodXonB5CQssZFnmtgZUg40-uX_OvFXJP9461XgPS1N-kPti4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOC7CUSKROq6B5uk01MUL-uVW7pz5S_dlOcusg6a8IKpQ&oe=6AC12823"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXmy4TD8vl4Q7kNvwFjDq6i&_nc_oc=AdpVqnaGC7CxQ_yzm84omUDF7J9hveeYFD2lYwB1VOos2RdTd8fbU_jKQ-8a2kW6pOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCWga_vQzX2smtDFHW6IRz67a-YoQC4Ow0gPp8Vro3pQ&oe=6AC11934"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
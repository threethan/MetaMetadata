&_nc_oc=AdppxqaBpv7nBL05acwbnZbNraymuAccmNFsj_2tUs-SCoMPPSe7viX2SotUZ6IJCaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wde8w8N0xs1ywfsFpj3hxP9XHLPkYx5g0H6RU4AevDA&oe=6A37F1F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=200JttOMEPsQ7kNvwFW84u2&_nc_oc=Ado9P_E7XtL_Q06Mr21OiEv5tdU6-ar6Wcrsvy-6J_Eri45Ouvf2g7yXxlX0hzyrrIg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mmcyT0ZwYzQzSV_CaTrmknisDoMHP0b1mTNy6JpATuw&oe=6A37EBF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8TTkRAY-dcQ7kNvwHPDDzI&_nc_oc=Adop1N-HLnCy2j93ln6OosCPT18OkNJKde5wpK_o5A1qbFd4d3_P8HHAaive7VOcpIw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-oeJr64yAkc_vGIVw7U3xJSRSFsGUy0J2WhxN2PFLHEg&oe=6A37F21A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc6DXgFD_J4Q7kNvwGOsLwd&_nc_oc=AdoOYDqGuz5YAgjvMaqLPtthkqVySaipOykd6WCD-BA6C0g6g1SMpDaAvuBJTHlZi_Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Qq2jQfXgEeZmtgWM6LZCSdeso6BL8WiSVX0pXQsm8xg&oe=6A380C23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbu_COdWS2AQ7kNvwG4IRH7&_nc_oc=AdrH3Qz24IShcFdeKsvvnLaXy2B69QDGmEO1WIzUkApVzIzoUzyz4NcVc3N1yC9HRLw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8wSSASAA2d3qzPDlXoGzhCz850hQvtQkMQuz8cCMsPfg&oe=6A37FD34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
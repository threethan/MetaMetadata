&_nc_oc=Ado9kGunnZb5-jQHgzPCX-iNk0A8YhjKCzaiWfKhy_MMgX6tcVaYlJCO9htF21VUUqI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEK76__D-b7Kmb22fis-jOujbotcGlRIrG_TdmiCnEcQ&oe=6A7F22F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpGTqTKQiZYQ7kNvwHBJi2r&_nc_oc=AdqW4cWskiUlg4MliwL65-HUNr0V4A8n6LPBLMGc1248WGpVbvfC62s1PVzuz-i6XA8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcfGQmaAxEY0kSIgzXUVu2guQTHRzRaWjkPhFj8ePYZw&oe=6A7F1CF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uQIkbCcWNkQ7kNvwGyBXV0&_nc_oc=AdpYhoe1PEnHhm7KxM0T_DWtDa9z0K0OM5vjXTb_K8gcOZ9GSZ_RkiNUb15PDnKRBAE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXqllBzRsCpde2-SXIO1f9AR17SsizcPHsLJ8sQK1hCA&oe=6A7F231A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8JbXNlIuhMQ7kNvwE0HDGz&_nc_oc=AdqFW8auAUn0ZV7BYk5hGgsgOZtdBNua93SsRpduON2cm5M99cgK7fmAAvdw308nh0Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEn1NpAQ-wE1LZcERWtI93LuoK_U2ihK8hJlctrPOJ83g&oe=6A7F04E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVDxOK6rGEwQ7kNvwGKafZa&_nc_oc=AdrRfWy64IVO2PTIMPzgMB3nvqq6FAzCTycD0Wc7Uk0goO0wotN5L7bZDiiyANj-oRg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFROJDFCHIvOv6zzubvwFTdN9pSwRU3p3vNlACgtWD-BQ&oe=6A7EF5F4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
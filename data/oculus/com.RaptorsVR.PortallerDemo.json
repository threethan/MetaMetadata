&_nc_oc=AdriQQKbuUq4rJvigWDQFWxArIqEGe04N_W892G-FSu12sx4jCV1huTF9pAD-R6gsUc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zm2iUEVBj1OrMkZZJshQFFAooPqeLStXjwoecIZYOGg&oe=69D905F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgTShW1gX_4Q7kNvwF9esAb&_nc_oc=AdoL1YwUGr1M6SRm4KJ_-RNXfd_sTLsph4V5JEtdwm566q8ejGw7E1OObS7gFgmBc38&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28s4n2W1Uwny0EyyAgCtEDjVtlBRDi7yu54UzZfSNRMA&oe=69D8FFF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptgearYvsoIQ7kNvwGQkGYy&_nc_oc=Adogc1G5l53AEVXhwr_ENcc_Iy8UBFqOQQE7EkMN-jDBq-5SO_RPHvAhw_PfPfcDlyY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xiAE3MaaiRBK_07mlZXzdSaw-ubeqrOKKAslsuUQiFw&oe=69D9061A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2qNcwYiQjDEQ7kNvwHQUHQV&_nc_oc=Adq3K0zhnP5sB-3HQmgSJaThHTIfc1QiIjqEuTWy4vE8Hln7YdC9oWPhM2sjYU7HAMY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Acn1Vv1BZf-uhKzkFuprzliqkYeT1cL8h5oAi21HxkQ&oe=69D8E7E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VpGuZA9TUTwQ7kNvwFPMV85&_nc_oc=AdqIczhP8yC0MtiQRdypWpaUMI4N910Qpe6WXJSiHTDJ1YVxxQ0QUdrAyNIpemisjuo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Afdxil3koJrJ-x9ZVFvuNC-LYzQdAToFqVrWDtva8Gw&oe=69D8D8F4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
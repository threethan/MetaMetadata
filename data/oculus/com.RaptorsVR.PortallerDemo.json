&_nc_oc=AdrYCQbRdLYQXbP9wRoxQoZBxoTv6mwy4HvSqb1S3G4Ax_USgjzGPBPveup65-128pw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFcvvmauvqjhtUNh2T_E7KzbhbfjgMdQ86Ufh-xq-jeg&oe=6A7B2E74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4DU2XJAV1QQ7kNvwF_rP8-&_nc_oc=AdoudISkKCDg4FXfKc_UQD4Z6wDakCPj2rpKNSCPdYL26-iGmYRWR-KlQzXonYMMBdI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWXYZvi5XXT4oJyE2Z46dx5u5bdLzIzFXJdoscQCabnQ&oe=6A7B2871"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2STghmrJYt8Q7kNvwGYXV1I&_nc_oc=AdrAIZKhbp10j8vD-uZbSq7pm7FkCslpBXf_VM7kkm_Ebpyfu1IMSTivELzC3r2g0S4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6TaGqlkXf_dcAllK0n4pk2iTWZbeKNud-8OANBzhalw&oe=6A7B2E9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7iPM97o03wQ7kNvwFLY7mU&_nc_oc=AdoQ9MtmsC8zz57XgKtvcIRxvcgSLh5S4HfblN17xEFwHUhoXUulSVdpkeAC-CZuKDE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ-F9cs-PWKzPIxmgTaqNAGjLQLbmPw7K-NPpwjSCCLw&oe=6A7B1063"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eZr7Ehl4D0Q7kNvwFJr4M7&_nc_oc=Adrs-25cHa3Sf1aSLSLXiegV1Q9kysl1TSe4FkpTCrBHvPSsx2wYBXjA7_Fs6ZhyZGI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnQuXmL1G1pBQKhpbyNqkWGOKlPK9OXu2cu28tsVlLqw&oe=6A7B39B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
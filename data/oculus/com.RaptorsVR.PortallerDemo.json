&_nc_oc=AdpMIM-tkoMWDcxpjeNifxI608rOJ2n7cE6L5YLKwLNqdoa7ac_Y40NyUxww6iplFp8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCkZoEarMgQhgnYomJk-bt9lAG5Izx8JukFvMkbhafcg&oe=6AB924F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9mff26T36kQ7kNvwGXAXNI&_nc_oc=AdrpRKj2rhPEH-deOGdoqGjnpaF4HxYnWvXgfK32LjmghRgKLoQlF0EjZYRkN9j9-8o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXz13NZpSzJp1_k-R3znu0LKIKT3diJf9oN1_07wZSwA&oe=6AB91EF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNxidYysnHYQ7kNvwG9u2r5&_nc_oc=AdpBIvq5ht2lEWgjiDgUuB1XLo0P5w1kr95_4bmnvyqrQIwGgOHOFlKzNkSGV8vCsh0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFdnID6OPUNH6flsX6a6rYYWKfKk5Nl7mL7MAzOgVz8Q&oe=6AB9251A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQTBaSY7qzQQ7kNvwFfKvgA&_nc_oc=AdriskTi4j6sVgEjrhGhG3jZjFmDlskg5t9apR63FWEjVOY8VOYl-lXUMBjnEh5i3kY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJFQI5OOeesqITLiljnzTxxcJ8OIe1ANZoak82k2QYEDQ&oe=6AB93F23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqXZjVWAnaoQ7kNvwHl7l0U&_nc_oc=Adqw1jFpAiEqhmFDr2v5qQuVlDdUwao5BPRIzttAcjHS5xz2Rbqq1XBx4IPiZFmthPI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgOtLdC-Ow7NQT4Oe4C03YdLSLhaqtizUGM6Sa4hMU6Q&oe=6AB93034"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
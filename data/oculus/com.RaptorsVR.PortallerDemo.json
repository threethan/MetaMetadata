&_nc_oc=Adp3OEKCkXM-xpGs0PiQpJhKrkQhPkhiyX1BdnzTHKncsTDiB9V6UsAGsUycEpcdKvs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42NiZIxdjab9WPnTDNBG03Fy_bHFk18IwxBxm4A9C48Q&oe=6A0F1374"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1GxYhZKc4IQ7kNvwFDuR7C&_nc_oc=AdoQee2Q25jYWMrY0JAFFqDhLxphOY1Oucvmc2D5x7fl8Acnr-kxLQPcKruzznaLCl0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RmCmQ5cXPS1k3OKqh4hNU9-Otd_i3kMfgGqoT1a1AFg&oe=6A0F0D71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmBHe5H9zxAQ7kNvwF-ivFx&_nc_oc=Adrk5Bk-mQxnjXw3BXGi2mBm4vSTUJ6NIQ2BFuhmpsKOSYev41_rftfVj7fYhVC6vgI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6sO743CqC0TeUFoc7m2yBvgD3KgRXMF3aq5P795VClbg&oe=6A0F139A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlROCoY1sQIQ7kNvwFFYzCN&_nc_oc=AdpkY_c-uMAsipSXAArv0DkW2bXUlU7sqVEoW3XlCXoqZUZrE36CG8SfKw9QQr98hFE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58OFzLL99J8RV0H2wDbQJ2S8p_BrsbBIAu9F8ufe3Tmw&oe=6A0EF563"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WTii4KscwEQ7kNvwGYaL6R&_nc_oc=AdqHzlkcJW2aYXF8SGGAIIfiFJ9Zj2fKnuATEXoqoTtZBq_fCXhdWWegPYRFo67gKIY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xuqD8KuCQiUcakNCSO7cyFFe0E8llNrjraT38I0M1rA&oe=6A0F1EB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
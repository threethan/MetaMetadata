&_nc_oc=AdowTQce4k0n6oDkd0zTbBZlenCdGtnbDiuPC0HapNUatT4gbat6ZvR_hV0AWnhMCxE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB8Z-x2TIQMn33pSyT4RDpEEbR6vIHhrzel6KI-Qk7w3A&oe=6A4A66F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJS2t6-PTawQ7kNvwHnPOnO&_nc_oc=AdoE090K3EbuVgSodrZwXJnj_sAKKAYsd_gaB0uK2kuaZaXaFxT5t1pKyUupr5T-Fqg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXgyhn9UfYWqoSHkbGKb2YfgSNHcz3f9j_UyAsvAu-xA&oe=6A4A60F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8Dk5XcGCaIQ7kNvwGidoMF&_nc_oc=AdrDdLI2oowEI6_iVQqGyZPrwbIOKBbSxOY-Z-0X12OdHEuNoEaECFtGDTTPMIC2gQw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIhBk2omUQjwdA3PSabZVz1-4MgtgJtRWMqmT_ChP61w&oe=6A4A671A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN2XXHiJhdAQ7kNvwGpClq1&_nc_oc=Adp_2T0DIP8XHiuUWD55XxwMg-1E9ftaFBW2-riDnsK9dUl2awVlwDWacQyTpzu6SQs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB35Cc-hNtTaxx6OtnijvHEwjAaAfS2CGZSEDzl4zzWFw&oe=6A4A8123"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYdCwJB-WjwQ7kNvwH_M03M&_nc_oc=AdrLnzJSIrqoy2LhFXGedfAAEekP7UGmfEnOey7wibHGeYPOTb8DYtyNl_ZOtYvxnsM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIrgnMXUPspXjT00Ar-uAuq5pglJKjM1k0U1Rmpx4ipg&oe=6A4A7234"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdrRy6-mnFO2rCHcw9Jiy1B5KaXu03F5RLqxR9JNC-Ncr0o9pDS0lkjHSJ17cbM8D3c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4Pqf6GErtg4IhiqBMYNr_EcNj3l6pBEQDTqn9Azzz_A&oe=6A7C47B4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4DU2XJAV1QQ7kNvwHH-PsR&_nc_oc=AdoAZgeCoVGTIoE66N6znlnV6Eg3oKZgb7LKoiFNmH8w2MJM-KgHH8vAzLGPdFDt76U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRTtlT7TtAmd4WgrJ44q8Rs0Dot5Twk_mvk4v8MuvWiQ&oe=6A7C79F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2STghmrJYt8Q7kNvwE98ELr&_nc_oc=AdqJwoBVC8VZM07T25uCcLA5f7GPKSmTjPtCDGO-WDx2Cvoz0ga6xRrUo_rqmHQz7-s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGa5XT48O7QzNyYwmlgi8aUviSD6p9EZwUxS6FY2kSAkw&oe=6A7C47DA"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r8JbXNlIuhMQ7kNvwEN-Jcu&_nc_oc=AdpJu8DEZoOKEH89F9N4PaSAA3wXaUdcFoHttnNkufF1ww0RjhEokXhUKBRufHbPrVc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgegNNABxh72VpOuaVa_tGtrEMxUSuGUz-wgHW08AFEw&oe=6A7C61E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pVDxOK6rGEwQ7kNvwHfA89C&_nc_oc=AdriNZvaKJrBkPZPdZX9KUVI7IjgRDqa_A7YF6D4UoUprMW6efAMJEqg9PT-ZKZj_F4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLtopkJBOv8VK7SiaRD70Lr7nNZxAgMnrhVV9wkx9u1g&oe=6A7C52F4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
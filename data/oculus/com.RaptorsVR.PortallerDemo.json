&_nc_oc=AdpZRKGg61lrB8BYfgGClVUnyZw0lgbhOJLaPAPG7wBLePeXZNDxBiPP53FVT-CfUNo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3SdKtEn1ejz6jxrHO0Fixn8YwAoCAfDEan_reZihGSOQ&oe=69E78674"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zc3xMYcgnMQ7kNvwFBK0ya&_nc_oc=Adq4WkvdHjyogtGWW8Ofpv1nLCdtwm2BDbRV77VihQD_eBpAsrxkngVdnGa5QKOvkqI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af00O9T5wct405M3FQPRR-8STEW-ukwXrzLTEJw5iP9d6Q&oe=69E78071"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hp5q0CkGVo4Q7kNvwHxCwtH&_nc_oc=AdqQDn3laVM6wecyFe2cUDV0ygAHFLiv14cnIs2o9KxvHz1iFAXZwD4Vcpmz8QZGre8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HGcxgYhqIjoBYlNd5wc_n74MpmTnRT8nyCyTQdayhuw&oe=69E7869A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shboh1W2nKIQ7kNvwH4CzuU&_nc_oc=AdqHoUBi2BJq4GP9ifgIEd6Ekucstx5jAHQ8p5x4bLFgz3KxY0hkHBeBW8ywHLUqy4o&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15GlEpboNMLTiXT2lbrSzGw7Ur_cM2EYbMiw45zYp3Fw&oe=69E76863"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPjV5o9DZWMQ7kNvwECL0hG&_nc_oc=AdrZq_WHtHzeZOvKnZEX37SbAA-luZrlKYniquPG1DKmcI19mbis96M6MwPLbKhgm4E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1t8vTRMmRktfOt_6QZAXMb5QB0AEdqnCIEJCiKPWnyqQ&oe=69E791B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
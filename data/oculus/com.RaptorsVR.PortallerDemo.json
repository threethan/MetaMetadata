&_nc_oc=Adr4QF-K5PpIOJLXYe8PfCCUDmzgSVcCUnZfQexy_xrm9VAXdxIr6abtajvYGYHTpqg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN0m9DM7hWwWCwpIZ0TFDKCSNcUddOfPso8SHc1eHI-Lg&oe=6AD3BB34"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmBGvcm4wlQQ7kNvwGnZaPh&_nc_oc=AdpfEmzLwb9dPtqX_1lNhS3nfJcqzMXhNR7QzhscizGkoun7_S3bKOoqoE7lGzU_d4w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfyqkH-UCrG0e3hwJNRPOBON-icDmtRfNeDiIhvfp_3w&oe=6AD3B531"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6haUt7h42UQ7kNvwE8um77&_nc_oc=AdpNEifVJez1AV_wRxW9HGZfuUQ8_iNmc9ZJGdSE1vr5hYhptaqPrtLuwB5_rvulbvw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGLLuxtGqdrKL9fi-ltqc0W-eoZsQxmKMIfGseDbK5VQ&oe=6AD3BB5A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrlmWWVxSZwQ7kNvwEnEgYA&_nc_oc=AdpsVMyAq2DWhTdNi2z5VjkkrxIN0zn_evPLQUDljEJhNOiB7y-TKgJ3RGQd8FXxuxY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2GlqQwaspo94n3zPXXdWu7fiHvlcS1w0pRWjjKmzkDA&oe=6AD39D23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQHYTQbMNIcQ7kNvwEnDrEa&_nc_oc=Adq8wMEmRzX_RQ53_NS8qlbwmNVWRqCf31-eDrkWSi49OvRqW9eNSHxuXndaquNMU-g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO0KgW2wgHc-AGu13lo2HgdXY7jnpffuc8uGQqgdQ-iXw&oe=6AD38E34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
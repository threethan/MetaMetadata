&_nc_oc=AdqH1WLl6orYy9C1xu4XLCbQhhFOx0AyiQo6bxzMyNDRkl0vhfi51XI2-etCRE2UQL4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0S4zYWvfAM-fy3JyWWFaM4JW_jLXOKX-gDmDP_LIbxKw&oe=69F75874"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8E3ra22o_AQ7kNvwEHUnjM&_nc_oc=AdrqCPeM3RRDgakQr_8V25G830ykth6IzOD-y2J4sGrZDZdL9iuBYD-kbGcgE3ElRQU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3kL7e7o029TTALO4ZOEj146_aVQhIpIXHLNlnsXg_bsA&oe=69F75271"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WodkuAh4hMYQ7kNvwGY3E2q&_nc_oc=AdoluNjoLz3Sf66yhpCEh8qMMNK4M727_KAIKOCe98wD1QsOxXjqr9YsrE-zSMWQ__U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1CoMGpGeM7xApW7KGSIYaf2sHiDXheewKV7MX3iEPwcg&oe=69F7589A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNOAKlu6n-oQ7kNvwHMZGEb&_nc_oc=AdpXMWl8Fl6LU81BPgDpXnUb-qtjTBL-EcTAzv46okjk2EJ4-c10AbgLtiemJ2LcMqM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0ajXudqlMuxAD1MBHMRNdFPbpV_D5jBvNooP6R9ys8hw&oe=69F73A63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlUqvVaXwYIQ7kNvwH90aV_&_nc_oc=AdrVuhDiuwSlCAFp5EtpiSZuNsex_NRihmuvd5CWt3eJtO43lZU7cbxbVxPwikHof3I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1Asb1if2N6gF4syHH7pegnGJyg7e_OJf8Jz6eqNiY66Q&oe=69F763B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
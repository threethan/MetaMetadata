&_nc_oc=Adq2wu1_tK0ottGpi47VC0dhxNVbiT1075vnJekRrW9hRHM4ktEcTQJG30Qz2lauo2Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQShjeQ3QWPuNVXI4oEHZO3DBUYTChdbREu78aVvc_QZuQ&oe=6AEDE0F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LesX8eaQV2UQ7kNvwG8Ofzo&_nc_oc=AdowBv9gZrIfX3EBnAF916V2zTrP359cMFoNETj7iexQZdJorg4SoRc2TAyfwrsHERc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqLGJ3qqpwWnN-CLIA9k5O_K4PwyDStzNkStQpC3109w&oe=6AEDDAF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-848-19IuekQ7kNvwHSBA9R&_nc_oc=AdpCUqfIzXShcV4So4YAtr1Mc7Fv-tdv3k_IVDhZ0yYc4mU8TMSt8etcLC22elemsNc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSNMnYcp3WcgfakHs81njMPivsGN8PmZZ88yI5Hy5x2Q&oe=6AEDE11A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSfAI7smEPsQ7kNvwEdsBTY&_nc_oc=AdrfWBFqEwrBHOHez8bqa4vIANkpXzEvuK0NxmWS7MsgjaqDfMIt3g-Qnma-zvf48mo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQUg-ePC7Bp7YkW__Nc8VtOZ59d10GPr2XfVURD495qSA&oe=6AEDFB23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_83lvTkZvoIQ7kNvwHWNOq1&_nc_oc=Adp28N8RdsDqWp5wmwlmIP5iSyQw-GxGfP155X0xUWsY0aEcx6Ly0AtzGjpVGcd25wk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSc1fr6Iz2X3v1T7GgqYAvFMBP5nluh6QCw9MXXukuN0Q&oe=6AEDEC34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
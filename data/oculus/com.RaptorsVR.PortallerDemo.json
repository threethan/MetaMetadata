&_nc_oc=AdpJzNG4AJEEIpg3kvnBI_dUuchNz8jNEAqIEmGzBudIl6W9ddwCyG0vOzKwKV69av4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVBEAizd1QbgnZKo_rRvhHBEVX1S-hcyGLxD930tUGRA&oe=6A788B74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfuBsaF95T0Q7kNvwFMLQh6&_nc_oc=AdoJVccALjCwt_rgOb2Ni2ReIXm5t9MkR5mIbun-ip3A-CoIoL9eicbBGsdNtVHVmic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHLve4gE0sJStgOIobL0wXY-S8xsD6-8vGyE5wNBIFqyw&oe=6A788571"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MS6YjKZ_fMoQ7kNvwG8z0f8&_nc_oc=Adrh94NJ8jezL3pvw-OXFZB0ZPA90drs2zkkHy08kraid2PmnBGTzMp_A9yd7tU-KUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUQ3KNCL6YIIk7F2Gd6J-zkvwpRIM9d44huiAKl5l8jQ&oe=6A788B9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7iPM97o03wQ7kNvwHd2SZx&_nc_oc=AdrBH6dwtnfjdoaZA4mAGC9PJulUoMAOjd_fEP_Wp6pvL-gSPmUSDSJL0JUBLoaSBLk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFtD5zmY_CMuyE8rOQfmd1mDiD52EJOb-rmmaCId8ASzQ&oe=6A786D63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eZr7Ehl4D0Q7kNvwFiWGtl&_nc_oc=AdpXlGyndkpiWw8aIRBSaHwMY3xtJZj4uuBfURZINT3fZgyAJsh52cBKwylDMgWL3hA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlP8-bIsYTceCS_P0Iznu2qcGrYbrXksbdF1RBVmfWUw&oe=6A7896B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdpmoGlVCLd69BeiFIB-UI0GHIdY87Ic0ea5RRO7WcLgwRs--_8duKS_dwe23rVo4Do&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCErQ3pdIiAAFkV7uFZ3-BCU1fy4vs-6m3SOCWF2aQkbw&oe=6A637374"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dwScXRl7hdAQ7kNvwE3EGLG&_nc_oc=Adqk-Armx5orbC0yPF-FE8JPl7N0RCo1jbyy40gqAQhmW1m4VYgW7qLUr2e5rltp1zM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAF9QQTkJISlQIDZ6whqhlPsOFi8kslXzB7zxAtP7rvXg&oe=6A636D71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ozOS0oigTZcQ7kNvwFihy3A&_nc_oc=AdrCMu3uNHjWme0B3BrPaxnWzwDx295-bpXxvBegfI7aLS3ywnyh2a3uMvTHnSb-ssY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzBDE_qnz7-ukfKkZmUA1YD10xo2si-WlBwOEws2xWBA&oe=6A63739A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CwgYmlW7tDMQ7kNvwFgZ14f&_nc_oc=AdrbSQbhf6P8NkM39kUfPdHwrHeqweaLCoRDftUk24w9FtwpAi8TSfAtj96nFg9SQxk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAte0n7lfM6ZbdYZz3TyiHF5qg3Dg-loh_-oepFafm7Uw&oe=6A635563"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hxCpw6ZeNEQ7kNvwFJQIvH&_nc_oc=AdoBHPQ9nh2L8VBwukiHXm24dMGyS43aoSUeSwW_lQAOx5PjkhkHGZwFe9O5NSHmYkQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMhEVf2cqDRI4PZi-KGSsjs900IBJQlewQFQwj6zGMhA&oe=6A637EB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
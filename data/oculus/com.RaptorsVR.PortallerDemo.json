&_nc_oc=AdqS2ti0KhxyxVy2B3tXbiubAFpJ6CLd28EOEMRIWPQGy6zYpUYqSRrFR0O9G44v750&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PqN_XM0C5xnt8FVLngqgNCiIAwl-ZhbiNcm7flrLk-A&oe=6A2C1474"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5SCb39MbXQQ7kNvwE9hMEv&_nc_oc=Adp3VvPuiavvZZPoXoFo8VbzDi4DgDn0vQg-aSSNLSdpC9RZz7b25rMXupubCq8VsLg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8uM-2gfr2AvCpM_3xoL75J7vO0K0_MN9g12Syo3f4yHQ&oe=6A2C0E71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmXhjTEReAsQ7kNvwGV-2sX&_nc_oc=AdrJCJef6lo4_vBEJaSt_-ilmmJGnnHtZLXyyEHMC64oAB_pErLHFU9-P97AKJSdNqs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9AkUyYZGoLlBhYqYd7lhIrYuN3CbqZ2fVCDl1GItN_eQ&oe=6A2C149A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpsnUGHZKBgQ7kNvwFEMKne&_nc_oc=AdrFShbc09_kX-v74IEObadnNGv3jFfR5VzJH0F5LL8UVkZAThq07WfF5KdFTI4CGUI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TsaG5q3mY1muEelyif21AwP4EzBX9rFoXJApa1D6YoA&oe=6A2C2EA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ukfCdGU565kQ7kNvwEmvWLG&_nc_oc=AdqlJ2q778bjO05s8XTs8Fjtg2po37_nIQ-r0swXjchDeD5kIis1P2dp3Xdwd8tfyDY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8d5jBbTq6ejfCSTm5M28ZctEPuUbMYDojaXsy-FDvbBg&oe=6A2C1FB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
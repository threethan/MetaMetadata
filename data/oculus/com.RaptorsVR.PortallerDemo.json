&_nc_oc=AdrLqn4aOvTmJU1f-ug0cGMlwft0_uOyj3EfAzOGmmT5NSeETfvzr_vs4v-9OdsCSs0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vO2Oj_qcGFE4oAkVU61mD0YFQ8ZR6AkQzc9IS28agCg&oe=6A1D93F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Sos4SulfLsQ7kNvwFwZJyG&_nc_oc=AdoUD6YJoypcLaOrV8tWv7quM2fHHJCCnrWkUTLjlDylgUIa8TtKLZB3euRT9cw7lbg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af765dz34nq93Gt2vqlBp_HmVaGWt-RzotwnXuvSU5Te_w&oe=6A1D8DF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gExOLOI9LV4Q7kNvwHzIJmm&_nc_oc=Adpcs1Aad9uDhyz3YRpslVSBDW0oUOSnxdTZQoUR1qkZRLSFLDQ-k_JVeEche56SrK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gOwZapPgFdAsKiVWNHXZYyGLyPh_DIgg0ZT4jMxRfPQ&oe=6A1D941A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cFiS3ANWrdIQ7kNvwEpDUjS&_nc_oc=AdpVDYB0H2iO0t2D4HAxZ-TrCD2hqGaE3MMNnY9JtkbZq28MkDqyfbY2f4YNPnnlvJQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6BNw8nt7c-EYOSCTZrmQveTFTPRyGME5cFpNfpysu9Lw&oe=6A1DAE23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yIQHvrGJPCwQ7kNvwGUUTJ_&_nc_oc=Adp2wCqob2B02_Xr6PW78fAg7NkN2JwlKt6gDSjBtBdj4f9gqV1nt_QJwEhHzp3oDTs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cOWAW7pQG4UZmwpJ-Mlsd5ldcvX_3S5J9GZyf0AXU-g&oe=6A1D9F34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdqbVIsTPMlTONg4rmOd8EN2zkG8wHXd_L3m7CfC8mdiBwpqTusz-QGl_7jIN7b55gM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO9TZX0R7nfSkkuutRUdfbrHVFkTMBowp9Mqo3y1ytRg&oe=6A4BB874"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bJS2t6-PTawQ7kNvwHR3c1o&_nc_oc=AdpVHSL9YYTbmMuw3l0hDdPeCXpi7GvwU6jPHDo0dhyt6ROUtWjZM-A6tkdtC-9Vfuw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9iAJwBspVa3e8l_ZrM8uxc0RB7MhLB6KaHIZXmEFWqQ&oe=6A4BB271"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x8Dk5XcGCaIQ7kNvwFyYKXo&_nc_oc=AdpUGLDm5CIkz9wVs4AHxT2r8nCeedBObrqh_zlCRiJCP0yoxjEO9m3aSxatwXYHkDo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC36G5Yiw3C5nrIk9em6S25GFGZP8RqeuYvL5owDMiCSQ&oe=6A4BB89A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN2XXHiJhdAQ7kNvwFgGvSs&_nc_oc=AdpFzyXtGc7z3q3CsPJPMtfTdpc9em_-_jv5_w92cprVpU9FqIAmujmQ2T8IjkEGNCA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKhIhjutP1Ta1BN8O9uHjZ6hrJdCZfm7zSkJIpj-jY9g&oe=6A4BD2A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYdCwJB-WjwQ7kNvwEKH_Pp&_nc_oc=AdoMXeed_DehpPquG1Hnx3Qew3vTK4g2Fu63BWfnJ5fukIb-WVu49N5mQMF7NBTBcP8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOlXJtRv45Ks2QWmTl6_0SlDul72SNKQQQMtuejJ16rg&oe=6A4BC3B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdrFI2xpdJlhg3a3E7dFB4osZf-lwRmEB9xgmkzX-NE-flYGDF20jYSpigE7NzAjecQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af43rvggWwgv8NUonRyFlXGbRmH4PHF8v1xXOPlx8nfEwA&oe=6A01E474"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QqwGEIbT6w0Q7kNvwEUmcq_&_nc_oc=AdrfJWTECfND05td-Qoh4u3SOb0rJYBzZTMIprRWKhvjmcxs3jO9FgTna1UAaF-1BNw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4N1SQFrf3ZiTSQvhk6gWaPvNKEn6WJXABvPhJ37fkHjA&oe=6A01DE71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sfdR-tT5GBkQ7kNvwGbJkPo&_nc_oc=AdoFY3ljOTxhPG3W1psTgCHDwdW5VYKYKgyXGO7LyPWFcT-bphEarcEEVSa4wFCWomE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k9grBVyV8KC4ABTpRObFDluLVB4BrF6XhGFO1KAV15g&oe=6A01E49A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CT06xJfn_8sQ7kNvwGbpmDE&_nc_oc=AdocPo0pnNXjO0SK6yrIUG3i2mprlKay6dSeQaw_cx5A8n-Q3ipKNzlK2CcsSC9ljpo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k2nW9pu_bRpRZjjI9revLccaqi79SfxIECuCHNnDG-Q&oe=6A01C663"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmFp-HT7qkwQ7kNvwE3AebE&_nc_oc=Adr3ToCjFWzpfopzFvXjq3TuTo3J5a2j4u871mBJnP6ffKVH9qJMWsv8QK0ytKval0U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7y7vmH8Mez4ge1ZAnW0A2x7ZbJ_ScbUcGa2-99PRiwYQ&oe=6A01EFB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
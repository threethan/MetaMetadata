&_nc_oc=AdpqzJwRYqlFuD8q6YoCU8QU7oRmnQXRTc7D9DI2RQt8rT4ozTnYBLkO6eQmKVftMEE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIk2dQ48AHHugm-Qy-Ja1BaflnGBKw-iuqQK5pBKzh2Uw&oe=6AA169F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL-NNNl2SjwQ7kNvwEHj89m&_nc_oc=AdpWgdFtZ8I_r-9deG_9TeStKswWFSiN8TuHO9uiwaI4kA0VpiWdXJws4E69alxS1mk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgo-Y0Z0X33-aE-N0F8u1HZLObHZxVa30N04dqjVeqAw&oe=6AA163F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=usxRTuk7CQQQ7kNvwHM5fog&_nc_oc=Ado_aVU4fMKt1XGGMh0HY-Ly3t4uAlg4HVYQsdjPQoF_mTRnum_OEsv6j_gPOZXKLkM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfOv4mPp_81yNfSk8ImVnLgINCZ151aQ4OYO5drlnPbQ&oe=6AA16A1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQEMiOtFOpIQ7kNvwGcsXsG&_nc_oc=AdrYMIIRpOp1M3moO4zwiHodpgzBfFOxENsRHKgCzIo-c_sYkxQ6ZWd7UskLIAsSdMY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLO8kxYRMhNwRD--jmcbJlKCneAqmj4ywB8llcaFcXJbw&oe=6AA14BE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_KX7dIeNJMQ7kNvwFWorop&_nc_oc=AdqVZrtN4rRSvu3NR1-SfwCb-p8pFVmrwanXSli2UCi-yvaRCSwNa0hi1j3yq2UXY8o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDcRBM_xxFmA4IsNxJ7mCbYfgIm2FVz_MAxbEC_Psx4Q&oe=6AA17534"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdpQFb2nBMw1_kBGL-v6OiugF_L4jJPdlVAOnV8rh4F7MbIe88aAXqfAcX7MAmY0Yos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCYhX0CsV1ZTZYoujLltrv3nE8_Udlu9rBccm3P_goGyg&oe=6A6CADF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5t-fnoqhr8Q7kNvwGfcKrU&_nc_oc=AdqWil2D20457pvg48W4oPibbjUM4J9aZNQXACjr7T0nOWmFDOy9JQQpieBXz1pvFno&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDw5mmJF8nhB6VrLuCG575SvoBUMpgmCK11G3uHfV9xAQ&oe=6A6CA7F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45M-EQscP9cQ7kNvwGZF9sm&_nc_oc=AdrvHTfkyoBttUY-jfo1nsFcV8oLf9fWt7mg1rjFcYZLae7cHPX9ji_nsEYwYEOL8h0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYD2Tv-hdYJNndfWnBycYg-8wlZCM0HkbXlOYtA8Dylg&oe=6A6CAE1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-c4n0N_3slwQ7kNvwEFdySU&_nc_oc=AdpLoZDpvLI8ahS4Q-zYux2Mq60kqthDLyiTzTouEcYDt2U5R9eit99741KZ10NtkKU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBO2Wp7JWaNbLupYwv6_nnDTvRnPPGCDMSdgDaZ6kzwww&oe=6A6C8FE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TrV0ZcL5wMQ7kNvwG6hYwX&_nc_oc=Adp9ePV1ZFTGCWdZwA7nXSMpmw8uGSeSIhCyVo7Y9AW3QmiVOWXcOyhthoh7GlZDKb4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2tlVslTMnxT3zhHxuukNT6syHQULV9bhH6duamB3XKg&oe=6A6CB934"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdpcxHtd_mBkwM6OoA2vsy0JfgxI-KtaWYh5ZxqnfAVzaHfayjEtp4DOMG6QIw6U46I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23rQU8JZsmVryk51MEeYmIQSjCL07vq2tWVxqGptFjqA&oe=69D51174"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ddFHCRjo-dUQ7kNvwH7-_pW&_nc_oc=AdoPIrCgb5TWVrxNNA8Y0au73sdH9P2fAlEjOfwOXaqUpJBITWocfyN_AHWt4N6hfk4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eQ_Y_LILz2GeOqaV3LFpTpQXjOMxxinTwC9IlTnj3jw&oe=69D50B71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vI4L5aZEprcQ7kNvwH6vUNQ&_nc_oc=AdoN_d7VzbxbhOk1k7ZIbTeaZUlFqMNYhbrAi1rnLbLKVgHWKYrnOgm9iXBxDEbj2Xo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0j8ZohRvCoc_IzPWS1r4u378tpPIC6rm5KbS-8FWBHLw&oe=69D5119A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFAxaO3PYHEQ7kNvwE_abeC&_nc_oc=Adpq68OwTXPf4AkCEFwzy7bTRrrMDGiF0jdrrl9itsgdWqoMZDqPWGl8ZiQ4B9bUO24&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0AGib1mGyfYUPM85AzVvoj_0juA0SBA50INAAr01MfVA&oe=69D4F363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1uCU-mfUDgQ7kNvwGpNdiM&_nc_oc=AdoABsoZD_vtymXNoiEyvfA9mr8FPe5CC8tQ56HhZluqY3_PhA7pP6IFL_sAdRtD3I0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kKkywBxE3ufUxiRSCnl6sS9aMf0Knka3DrwWW7q-SQw&oe=69D4E474"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
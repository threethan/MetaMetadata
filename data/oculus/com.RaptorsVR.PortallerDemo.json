&_nc_oc=AdrSDyPl6Ykt-faItB1QIq56N9MRpFnQSfp-vvCzbeMRtEv8d9a7-0XaCV-Bdex5ERk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74yNRuxkGlyEY5l3xq8XlGDaUvm1jZmhV0zkJ0bZ6FPA&oe=69F9FB74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8E3ra22o_AQ7kNvwGz6EQo&_nc_oc=AdqpkPMYL5OdD10dChLwWhsetdqVfZiAaRmldXoxs_skh-K5Pl6p-6PWzIUDVfCIhdI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jsyGVH_GHniUiy4Bp5EqklMIIvASYaZ31kb-5782qvQ&oe=69F9F571"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WodkuAh4hMYQ7kNvwH3-WtW&_nc_oc=AdoGflk3s0Q6jqLHSfNB1S8fFPgwj1QTtWOIMDizYFacmulynhMw7h5_ThIKmY36Zh4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cgdkZx5_IxYT48j_zpjRoGKN_x0chEYOvmMXj2rhWuA&oe=69F9FB9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKDzeLChr3YQ7kNvwEvSYK1&_nc_oc=AdruluzQr9I9XY_-TOy5K0lacnnl0X_hzdYoscQw_MPEHUYLE4fm71YMZMd5ExxrH44&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75qFlTAIcgLeuvLJRe06JbwZ_vrQoZvd-9oooj47u9sQ&oe=69F9DD63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNy90TuGgGkQ7kNvwHQjfuR&_nc_oc=AdpqhrQUeSMjr2wntAAkdVczY9BMbRkuWpzKOfFj9e2vb3ffRom8bPsMP-tj4Lt6Rqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Iy_gpaLIaNljOQSKMb6ZnWC9TD5A5lMmDmZVpLS3-Cg&oe=69FA06B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
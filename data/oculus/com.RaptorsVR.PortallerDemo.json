&_nc_oc=AdqoqQJjLsUDfzhUpXsQSqZ3oycN-jSIz9A2hlp55g7KwofHN_SjufbHd6kDXntsjYU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKIT3EsXoDFF38MV5WRSGPHMfz1-9qj6hTjc59R2S3i9g&oe=6A9C23F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVMA_o1tt74Q7kNvwFtHaqO&_nc_oc=Adp2_9srxlJxKJp29KR-b_xwHSKLSAmr-fbKW2xmPL8skHdLaJv5Gv43PvMLnFXBxtk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLU1bUSoYWcLjf1S5DuSbSSj4a_GCI22uEXICVavtbxvA&oe=6A9C1DF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kl0hp_udk8QQ7kNvwF61Xbe&_nc_oc=Adq8Y9mv1c4HENeffMlRKdGkQmOpM4WVFQrwk_Nwpp8NiNCRlCRmGoSLqrxlh1MItsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ7-ibFNQ1j5tXPrUkGkHX4_k3unEzppMbuNq2Cg75iTQ&oe=6A9C241A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T2Gx_IuY4NoQ7kNvwFSBWr8&_nc_oc=Adr-stzrpIPUMQQGc5TE8isoV2C-yTvWiOwezN-OwgPwBeZs-TnKbQQ1vfeVekZC0Lw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIGmgWjW1s_yXhWIPSrMk2NiXaUu8imlFS1FewzF4AlCw&oe=6A9C3E23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QFQE8eK41eUQ7kNvwEHJGta&_nc_oc=Adqk4nkhVKnIVJIKwan-Wu3Kf1g0s-JEt_pc7q_omTZC2Ndz5xlaG7Au6Lnoxztplbg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHsiKjM7MJJrQEDvRd2YSA05RP32ZpXN8F53cgIz0ggA&oe=6A9C2F34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
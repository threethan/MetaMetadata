&_nc_oc=AdregpgnhLprUAUN9F2fNWZyyD2DdaW1YmSVCgLY1OrAYBWc50Ihhdee2NmOS2SfL9g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5IyiufuO4icns-PjLe5uStHvgUoZ8qMu56dJd7w-ZhA&oe=6AAD4774"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iqAQcFgsxwQ7kNvwGCvHfj&_nc_oc=AdqrlDvZXpnZn9qXbehTngkU7_pEgEBBYhwaNMgTEvFGhVPc5QJgYai6rVDtgXPT2Mw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKApvbVtiCDks-SjLJt7MrgYv0IXjfGQ2BTYrvAKqO5Ow&oe=6AAD4171"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoQ2Y6jF1T0Q7kNvwFlVm9C&_nc_oc=AdqJHBIJJwIk2QTHT8510eZO9sK5arrcw4RdqPY_c9YkleCWDjDRbmptHZZHfV1eKjY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDyGdoT_KlT8YzTbo-nd_dKcypjoZq5r9Rxfe-fsMQew&oe=6AAD479A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWOIZRWopr4Q7kNvwGBQkmK&_nc_oc=AdomJMNKWA_-8OEIYFgsdihFnQWPUIwxA9-WkbnzHIs3FXs-JAUg4YlbHtIo6t7a0a8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi4WM0nXLFvR5qlD16qXG6uDq7HC7LvcHQ6DSV9P9Z1g&oe=6AAD61A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sb25KoffG6QQ7kNvwHUn9m3&_nc_oc=Adq9qvGPLgA2-2QC5Ck_n78mAhUECmeNkjQ_IrVDAQNvKTdcRDU7WyvJZ106eoFwhkQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeyiiSxym5a_gLlvJ6cnCbKnViqYu5rBX3FLMUhY8M-A&oe=6AAD52B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
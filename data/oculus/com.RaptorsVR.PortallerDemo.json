&_nc_oc=AdpAAcADRgTGE_VXjm3n-wFDrEnj9g2-sSJpn1VZoJRBfEGmN54bhUwzuIb_7OHqOVI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qCiMrf6SquS6Qta0nPXHGpASEduVyqjsEqsqdtVG8Rw&oe=6A1064F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o1GxYhZKc4IQ7kNvwG6bOdi&_nc_oc=AdqG8kO2W8vOsncSxDtYDDEAZzoV9U877PWdQg6DdVpJP13hNujwh57Cgl6r4b8p76w&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MGgxuG5Wv1zq3bHIQqHoTfcrvXMU2ko1uEq0PkJev6g&oe=6A105EF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmBHe5H9zxAQ7kNvwED-52V&_nc_oc=AdoiDVP6AvYkZTPuraIMfIFZ9KPGyyf2JbOvWdN7kVgxqPMSpSGKdgZ26_YFv2C_CyU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61F2BA5XNyMQheFeDSIhvu7ZtIsbABxClYksE8Pd3jWA&oe=6A10651A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlROCoY1sQIQ7kNvwFWzv1N&_nc_oc=AdqknS52_Ve5nKUQwjs0-0uPnccpxGDSCUaqJvHfWLs3VSu0-5qSB3XtDG_HDKyk6Sk&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ahS7aWaXiTw1odzOD0N4U6pvqeE3Wq_v9do3znWRgzQ&oe=6A107F23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WTii4KscwEQ7kNvwFcoAPE&_nc_oc=Ado-H2ze154WO7CEqslp3FKGuGkf3AW3SiDctyXu80OqAxeQ2sdXy1zBA1RsYu91guo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LI8PDB__R3d7Hb0wwr-Un7Wfr9MImmpWLpyhQ0rlymg&oe=6A107034"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
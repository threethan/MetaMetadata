&_nc_oc=AdoBVc7KW1VZ957qhx4Y8lFLufJasnaR1KcF2vqiU9jsAJaRGFJITvoR7FxXSH6kMUM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FYm-9983Y-minzEc5vGwmQHGL-UQE105WMPHtJDc8Og&oe=69E0EEF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0IBgmoC2eYQ7kNvwHvXycU&_nc_oc=AdoawGaEKzu9KnoQUR5CfhPQHuL8Xu51SLgsN95I2A4qLYPR-K0CrW2l9Qzy5dNcT-Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K2I9MpUPD5rZjw5dE1kLOEv-KlSBOoxv52_wc5Q3NpQ&oe=69E0E8F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NG7LInVHsAQ7kNvwEf0Bvt&_nc_oc=AdrwfMYIHGNCGsMtf_LxlMDR6SN-2iadErdzLxZGMIzhQxV6LQi7SfL_egssw4d1Ok8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3sGrPbvZ0ig27tjVi6_2iUQnzEGdWw-VpZm7d1RlBJtA&oe=69E0EF1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EfCHIV59dYQ7kNvwHWwVyB&_nc_oc=AdpT5MyrNbUK-MYYuZqtOGFwjAFRbeyKkg1o4tjAHCvm-UgjqZp4zuavXlWtp8w8_xQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2d4r1OgBCHtPduE-cMXg-xH-cZnY2y0t4-BOGaa1tBng&oe=69E0D0E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEDb0_tgTesQ7kNvwF7e93O&_nc_oc=AdphPV2Ml76iz-YJHE5QdLP9P8p7vvLDLzfv6WHWuMa99_YtG155Hm-21R4IRG2-QUA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2PC95gygiGQIYiluDQqlf0IIkoquU8n2dawQNuLY9GYQ&oe=69E0FA34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
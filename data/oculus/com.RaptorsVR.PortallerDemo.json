&_nc_oc=AdoyJd1Sk5mnWchPoxwQqk5Re_f3G4zOg03g57Nt1rZJs-YqURuVNnrnx1nGjVq_-p4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YllWhm6jJYm95YtQ9TG7JHhfS-wZzRywvjCaARRX3pg&oe=69DF9D74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdKmb0chFqsQ7kNvwGt8TQ9&_nc_oc=Adq_diX2CIlPmDpjYnpUyBT-N2JCguKQ3U20fzS3DG-NW0LA1AJJAkgeVI8Hbm9rFK8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1p2RlvHsBHUnODDG7FdnQ3YsjXCxwrnn3FgMdpF43xHA&oe=69DF9771"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8NG7LInVHsAQ7kNvwEnq3gR&_nc_oc=Adoo7dvaT8AoEDznZMffsff4p2FRJGDPa0wFwifkhkZY_5U2PtJ4SUZB0eyfcapJjn4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nvfs-isEkiasExe2Au_Bgp7n3xwA5Kw6vYkVU7TlDXA&oe=69DF9D9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0EfCHIV59dYQ7kNvwGn_TBw&_nc_oc=Adr2AIn2QY1CoqRJTczeBzTDbFwaSgJzHE_m1SL4FJoYb99CUbeSulRM_kDi0Ifgn4M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zyAuGMWTjh1PuDzxUzi-D_IqZY1ijEc-_Il6la9VdpQ&oe=69DF7F63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEDb0_tgTesQ7kNvwFJZeRI&_nc_oc=Adq0mNS6BJvCcOIlBOipggrFR68N-KeHJDpunhzcSqVxqLb9JbOyieSftKDNCJcsZo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pKlXSce7eiCjQFpOdF12IuAfXChnnBxRc1jXtJ5IC_A&oe=69DF7074"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
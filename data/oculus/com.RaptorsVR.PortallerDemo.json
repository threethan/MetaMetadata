&_nc_oc=Adr0yYehbrP7yPGrX1AtAL8ppe5KCzckpEDAgWxVv0cHhhFAmS9LiS5eDd0SSSUT5Vc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPc150-EMIe-uc4DmauhN49dvcJgPtm1Dj95gMKQLJTiA&oe=6ABFBC74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StKqHX1xIFcQ7kNvwFL36I9&_nc_oc=AdqDc3EOkdJi44cMgLci2VeXfFHX7c9W-fN48uM8MJPuAtlVBfTcKksx6vD5zL-zJ6k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkMyRkP8gVau5kWZGJKWhySMw5pYRIEibPxrA4qRUdBQ&oe=6ABFB671"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GfENp46Ni8Q7kNvwFG66OC&_nc_oc=Adruv_e83XaIQBrnjJBQN-K2fj913fj9BGGBNRu6McT0EMdf8uXGZedYsqAMZIk2Gv4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiDBfj-NprO8U1GJdS747jaez8tPrPfTg2xU_iyiE0LA&oe=6ABFBC9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=grcauwuKuEoQ7kNvwHLstnX&_nc_oc=AdoRIlm19vwPcLScQg_T005Jbna28n_GAEvpmby-LreLRaqHxiv4ZepULt6-HuGzhmU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNV45P_2QlGgmPkKFq9_Vh37NU5fqhA3bDWRJ142nqfZw&oe=6ABFD6A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FXmy4TD8vl4Q7kNvwHUoiqd&_nc_oc=Adp1Dj6X-XjMoirexpVNK_zmuzUQSLcwJ3vtskC3bBjZkXzVD4YPUBjXhEiRQhBtCRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOv3AnkdCjvj51l6-pDp2JBu127VjUZIru9G7hAtSMoFw&oe=6ABFC7B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdpfIxOH6SKl4V9e-Tt3M2hDyYKJtu7_gRw3iVFb3Gft0pdNtBQmn-LcqPPn06HOGBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3fAg8THDh0Y7KCyPtEundb1F-vfVCI7S8agWBU7jQ2Ew&oe=69D26E74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQz0hrkiFhgQ7kNvwFSg-5K&_nc_oc=Adp5AmZs41K3yOzQpVJKx6qj2k5bbWZhReLOHkvuY22VkqoCDm9BeRZ0uhMPo5FPKOE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jSjUupeXQDfel8sL89363459frc1WTfMa5co2dsEfdg&oe=69D26871"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdrpzUNDG1MQ7kNvwGQFz2w&_nc_oc=AdrnYdlpuJV-2i7fqFDP5lwHS-epqc2lOD9T6Yp9rbKKim8ebZooMMrP18_hSY5a11g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3rIJwk4Ykq6EufrgMzklz4twFQHdvpCIU60qTHHumrlQ&oe=69D26E9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFAxaO3PYHEQ7kNvwGquOj3&_nc_oc=AdrBrgI1MlkHKmAlTqAWroLh1AXYgHIfl5mOSOhkk59GSMNUc6fawIWq45BE5pV5ZiQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2r_GcawBzRYtBshdp5zNWo78niqelTEdPPbql7gpk3Cg&oe=69D25063"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a1uCU-mfUDgQ7kNvwF3ZvRT&_nc_oc=AdrGnAvZA7tLlcQfn5nTWxI6rfpOz1bRy_msLt-ScVRXWk0eAZ_NRlf4bOnawPWXPSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0aQ1hvPjFZ3ndclcUthyxRj4O0rcC4YoPu1BXh8DKPuw&oe=69D279B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
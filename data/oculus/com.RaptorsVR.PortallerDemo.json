&_nc_oc=Adp10b5J_6Te_SFviN992fkv4-WhH5_W8IGfaNUFL1_cdKnpZNvUglICFCu16gzhsrI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bAhCY0i4mmMvMhGt8imWj65cq7OGXJTpMS87VbbHydQ&oe=6A354EF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3Tw4Eh8iMIsQ7kNvwGVv5D3&_nc_oc=AdrsnIwpnNaC0i1pEyqYhFtQkTM8vw6JFNC_oWwxHlUFg1rcTJ2IfCm6mu_zfSazfNo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_7Fqrf3UTqtVc4Y2UgRem8mCftAPJv4ZJ6UTKT8uHGPA&oe=6A3548F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cNSz12ySvJsQ7kNvwFZQUU4&_nc_oc=Adpl-MoD2893pc98ipdrD66lMAjO1_OUGehE6G0XorePlFA8R5Sm3EObx3OJ1JUOmJQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WBXBbNHy-z10oAApvXEkxhDH8kyPKxqhiq6tBWnB00g&oe=6A354F1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pc6DXgFD_J4Q7kNvwGYvwr8&_nc_oc=AdrIouzaHqrDS3SsEmSc3JIjLtvRYuq19t2SQenqRxDKwq4i5xiToaw6YnqVGRCPBM8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_W63TfGSERKJAN8RGttxaH2p9ND-ehiUAkacaVq3W6Cw&oe=6A356923"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jbu_COdWS2AQ7kNvwHJT6xi&_nc_oc=AdpeW8RLq0z8Y6EJqtyun02U82q4804qnxP-MchDtCOn-l6Qo_oQ7NKsr9XamjCiNek&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80Rh97rH8AY3m2ODFEPVcoLG8GKHjSdITXnKFeAOI0Qg&oe=6A355A34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
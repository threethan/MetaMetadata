&_nc_oc=AdpKcl-UZlpMhRGrrkFHlRmVcXbXjtIijF1jqdLXpG1Yl_0ZkpOrCp2zgounG6x5UwU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAfbXfgrUi5N1p4toVCWhiOqWtM8E8X348OpVJZaDVbfQ&oe=6A4FACF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u1m6b1RMFgwQ7kNvwE4JtL3&_nc_oc=AdrD4HTuswifIyEzk0edhoIAGwHcmzinVZ3Qhz9UPWLpb9rXtzFRG7mbOC8-R0cGnHA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAT2ohIANomZm7LgGDJKeao_EhGl0-GqbhCnV8imvZz8g&oe=6A4FA6F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xchys2Bf5ycQ7kNvwHui6AE&_nc_oc=Adr2zAaffAusDnGBus2SFyaknQWMoRjTsUVq0lcQ0m2xFsCO5zYDBF1f64p-DDm0png&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrG1ot6494AK21aMga-rGzkUguiX4viGiKxohJsLjIGA&oe=6A4FAD1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-YuCALhjlkQ7kNvwFsgjbs&_nc_oc=Adqt-hvAG4qtfUTSFy45GdhwHkuxFQt17u8XqWrcg9eEmJWv6tdX_tBNapg72w64c7Q&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9WmGCp6Tzd63BXSx_ZWQSHxPapeNQRsLZTCgIHRLfeA&oe=6A4F8EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCcGmQT9N3YQ7kNvwE8cJ6l&_nc_oc=AdqvtNGicqhPhvReZP-W8ryoTOSKcoHiajjCVBys_9uJaNFmuYxMtpvUazpCdBQingk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCe1lv5UesKWinuPS4FUOLpihTaSsIK9VSNPgoHSK4r3g&oe=6A4FB834"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdrJJPNQWRXOYM-dM0LtYtLJOlWl4rayTh7ASB1ynPJi_ov1BCyFHhWNwebUP0En0rM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2822nMc6GMPkY0GtnycS4BPWoZrhXOS4FnQyEgptnFug&oe=69EA2974"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_zxVQZ9ffMQ7kNvwFbTDPp&_nc_oc=AdrBVsAnmuAqi3nij62CKR4RU0kMiWEMXgjha0NuoZmu2UiTLHDy0oeEyQYe5AfzWfo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0-nrcVeLIn-0rlC8cuofGX3e_iuzwQCTd-6I7QIZfKAw&oe=69EA2371"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hp5q0CkGVo4Q7kNvwFOnc5v&_nc_oc=Adom5llpKOANmKG-u-uyNDxqbqQl8p1CrYwioaANURlzFyRYG8Rwt3Klyb_0JhyLASg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18MgZWwcpFEqaT53gMxR1WIKwZ7wpwY6S4z1-6d9_euw&oe=69EA299A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZV7vnu2cXsgQ7kNvwEq023t&_nc_oc=AdrUuI_k3pSbCXis9L18h-5OK3jcXELI_s1QOZQdF6xnXu4XJQiaNR2FLvWtEcpW3e0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UqFdx8zllA5vtr_9KoUUtN2nPCRg0EA3qKaFs-eKPbA&oe=69EA0B63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KmEtcPZGV8Q7kNvwFT3tcs&_nc_oc=AdrXc3dvHbMkw_RQwTavN9u04-0sZpgSAas1Uj1G8lW8AFfXH7m2KNdTfeSMrNSIKvg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oK35iXxK1id8t3u9ERO7ZZSCfbm-Wiz2A4FD-vwsl0w&oe=69EA34B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
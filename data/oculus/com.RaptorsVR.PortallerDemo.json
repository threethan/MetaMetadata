&_nc_oc=AdoqUq5IK8784hnoy-pLf4fEitMUEqXKtK5f-2lMQjnKqZtfEtPBBmJO-sGnNVNwHpk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JHocG_WFFXzE6hhb1TpTafhjzB1KLjS868jO0syZLMQ&oe=69E8D7F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m_zxVQZ9ffMQ7kNvwG8Gmyc&_nc_oc=AdoYyeGk5eJD0Rkm0Rc-X2NqMIEi27-c4ztMFyRfw6Ifud73hchrYVtInHbBrj0GEwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28mfxOE9g-DwXpq3bbkr_tU5S5396Mg-somD0veZksTg&oe=69E8D1F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hp5q0CkGVo4Q7kNvwFJYQmc&_nc_oc=AdpXHVDI-bF2TEEnX_IAhm6NpcK3EOt8eYV0STa_1HGY6TmWU9MCoFa1FhgjkRMQ8Bw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3eobGrVIas5TpQfjA_hm4HUa0PaQ5CMNDJfWRArLyHBA&oe=69E8D81A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=shboh1W2nKIQ7kNvwFWDD29&_nc_oc=AdpzkIHv1JYILSxieH2qOwyO8JUt4K2gr3kr9T_PWRgZQKS6S0n76ZejfyQZoak_rXg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hgs1g40-2iFSK57PUD1gLeK4_ONUC3_iDm1y2IfNFyQ&oe=69E8B9E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nPjV5o9DZWMQ7kNvwEV7J2L&_nc_oc=AdqvSUrOmtjngW80Zg7IXDjCZF4qNhFfe_VztWOlz_9amrZJT--tXXMZZhqtWwS7q6A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ig98mYZuqW1vGD7Jh-fLqj_t1RhwhVxNFB4Ak542kow&oe=69E8AAF4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
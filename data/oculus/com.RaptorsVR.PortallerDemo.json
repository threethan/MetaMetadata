&_nc_oc=AdpOsbhyVpjdf07_IcxYU3pcmraIrinB5kmP-WFGHNUOUUD8GOT2yRMPvyvjkv4PHU0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1o1qch713HGPHK_o3Jg_jPjMV6PJyuSvYK4wyuJya9dQ&oe=69EF6F74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPXKbIrq2hkQ7kNvwFXrCHx&_nc_oc=AdpI0v2Q154ebaUo75K_qSFIgaR4W-KqhS4CBLKraXh3PwKLfO_yvggKFhfXwG5UAS8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af35yOUGOZnY7PD2BeORGuPA-mZKw5YYzcgfnSgWkHKpXA&oe=69EF6971"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7Eo9WZ6tzAQ7kNvwEo_MMG&_nc_oc=AdpaaBVqbw_fQH3b18jloi7oiz_0_hsgjDCh1UBwNyCHMZHSK76BEOI48UQKO59RLtE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hfw5-9d_nr6PiIjR2WZp_-QVQ9oClJ4XeZQ6vdDiCXA&oe=69EF6F9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYe_9_j5fhAQ7kNvwHxAovy&_nc_oc=Ado7rmL2cUGX6gIpetebugjfa6vMBZYRXc6CTJ-pTgEXPE8EIws1IOQzQkUc8t7TOx8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vZqwiCIFlIxxLy0Q4gbQ1cckX92Mbpae0gCOJwgdrLg&oe=69EF5163"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0epOpHT0K5kQ7kNvwEhiRgS&_nc_oc=AdrzxuH8CG8xvB5PrjAVY-ZGZOaLhId-ZJ9K-kltumCsvL7JS8pFfeAVNO8st-Qmb04&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0uhxq4buasxemU5G9KNdkgUI-oo3-BzxtFtyEWO-TLbg&oe=69EF7AB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
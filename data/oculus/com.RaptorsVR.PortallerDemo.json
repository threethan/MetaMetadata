&_nc_oc=AdpjNt_iHWG0zHRxMw65HWaBIM5ie6YyfVVijUUVCJ-zh5vjDcAMdGz0qrQ2gulPjMQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9bp5hj6QJHrciME9OR1ve68XAQwofqcp6g6KxEoFSyMA&oe=6A2EB774"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4SogB1ioDJ4Q7kNvwEVu1so&_nc_oc=AdqpTWMZdRuKMiXi2tFal-j7-jshn_W696wzWv3L0C1fHaJnl0rxwnRSnl7jBMDkQ1o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-kCA0HvlAS2arA3B49Jy-1FqKvjBb7bzfwd1_DTs78Bg&oe=6A2EB171"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Re1h8tOcUe0Q7kNvwEp2QHO&_nc_oc=AdqQH8xSEx6m3IZ3VTrFCHrucJ1PAFiLt1W0HmweQeegGvVE8u4BJA7MX0iO6zMk2mo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-7GQI14eMcENZpmoWoZU7_hKjIaQSwtZ5Z5TPK6DbIqg&oe=6A2EB79A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmjDUiBS5cwQ7kNvwFQg9sJ&_nc_oc=AdpXMS1h638d91dZI1O0HkBXBnLXZEOUvWRoxhUKWfz9G1R6PsqqYSUgyfWc_X4CmDw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8kT7mmM9mBLk6qwAKw7ljMsnJ8EINB4E9Jx5JvQZbpew&oe=6A2ED1A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yCRhJ2nIjgQ7kNvwFebzFw&_nc_oc=Adq_1Gio-X7dX9OWKVzzypdnADq_pnF_JO7qB5_B45v1LXFL1k1fhjLw5ss_iRiqsPo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9mTklDm9xtZkHx7Q7MzhedMHfpNsqRv3bf79Kl2e480Q&oe=6A2EC2B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=Adq7SkpWmVTz1AG33vRZPCHsMrFSZcacpa2tfKeGmIL2yg8SCne-OohucFHt5f9C3EA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1g6drZ1Eo5Jbp2tvKRGBbL7XftqS4Bx4zBm2SAtV-9og&oe=69F363F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpGdDyq4oJAQ7kNvwGTic_y&_nc_oc=AdpdcWCQdeGlLOSAhXA-_7ydcZqNPZJ-MP8B3nZJZKMVM7f0xf8c4EaOS6obv5hnWVI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1AM7WfaqQHh55DhzxOGCChsCysGuqg0PnESJpENaCbBw&oe=69F35DF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9zakyhMhRUQ7kNvwG7xF_y&_nc_oc=AdrefkMD-RPzfJIOppOZ7lKz0Ab_5fjrZ1iGvLkOVkbRwDHjtuvsHnSPAkdw6pdE1Os&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3GF4l-mlC-ZbukwEt7ZeYNuKMYXMhM1a6N1sz0j4BgUQ&oe=69F3641A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVdgHdN5zy0Q7kNvwHiMCPa&_nc_oc=Ado0AXT5u9AriaVcuUFdnrJ2JXfClrp7GPyfHVLZ9jnvw_tNps81EelgsdEelcvWhnI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0v115ip79wREmDqknaZVi54nZqPcrmLNDfcx0JZN28eQ&oe=69F345E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IxgcFL4qqIQ7kNvwGqKPzZ&_nc_oc=AdqUt5s2ZKbv3Jg8-mmHk1TrBy_2kOVxUNzNV3dEl7nfG6BTfuA3SceIalOcqgYKFqE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1ZYkJgPLY7Bj9kPs4epXDDHk9J_cZQdPv_Of6HJHhUbw&oe=69F36F34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
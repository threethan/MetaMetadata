&_nc_oc=AdoZG72Uf_zn2Go1qMjPsBhZDYugAUDJMs6kv1MKZ5DjADuquK4-48h4YAUs8AycX3k&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7SRHniRCVBM_HR1JA7m-H8VRYsEz9-rGIhn-Vokxd9A&oe=6A92B134"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gtQNH3UF530Q7kNvwEGH0tn&_nc_oc=AdoGjDnnrMscfdHM48pSaMbUzCTbm0HARjBhGMsyLOUM1a7zIiDlk1jDMRbylG0rZkA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJpcgMtIyB6kaZX4JErTzSSO2o5X8MGd3o7Xg9zSG0ww&oe=6A92E371"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9kt24PNagwQ7kNvwEAi506&_nc_oc=AdoSwkt5q6Nm_ZHsVF4S207gqMB9QvBtFISnKc2PXaUPJjTnd45cru9tPe3dsd9TupU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOnhoXr4A4XEcbraIXTcpRKvpBLa4d9Bc-fVf2_QguDA&oe=6A92B15A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mzme4R8dvgQ7kNvwGCRkrV&_nc_oc=AdqzrvKbFltEuk9OaROVp0Eqy8xkP_lT4RXeu28VzrhpJpWkhBPboUT3kYizgvyvmco&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEv_c3grQWsMexbEFJRLMNzvGwh5ZQOoIrC2KAcZfrE0g&oe=6A92CB63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mqukwrHwOMQ7kNvwGaLi9G&_nc_oc=AdoBhfHyXoeOMYlOYJdSDPA1XBUUdG1ivHGoiw5-bhP-q5JTCaTmemYsbKkah1uCXTw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9gv3B0mDHR97VrOgKE_pG4dM3QCe-dQeOb1xwB6mvcg&oe=6A92BC74"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
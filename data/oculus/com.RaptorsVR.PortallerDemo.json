&_nc_oc=AdoC9Qf_M8rnovSNIPcFaUtiBDiIsGVLB7ogIPueY2NA0E0_v_aZfH9ssjI6heqcx9c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDn6Z_a-ThieBJPgg57Qk_qE21Fr_uXW40UYMvzRVC_w&oe=6A803C34"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gpGTqTKQiZYQ7kNvwETyAJx&_nc_oc=AdrMZs6BxqGbTNoexEyF_kVMiLqeDmBQ53BRE4fiXE7W3sO18BKpnlBbNFu5WI7cAs4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpKW5WA-AeMjyhSAXDI5p1fOf7tlp7bzzxBqM_BjMfKQ&oe=6A806E71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6uQIkbCcWNkQ7kNvwGr1o5f&_nc_oc=AdolZ__DwBMPusjcFlUTXkimxJKpZYsRdUyRb_-Oa1u1Uy59SpTnCaKlFlae4RQ2RYY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfluBK9fOtIQByiHiY_TRPDnxBN3hOeHSY99XEoDJ-5Q&oe=6A803C5A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wipi_nlwBZIQ7kNvwHw-LhX&_nc_oc=AdrRpbs_zwEUzigPILy68uGR38KZ2yXicNZ6Qspwi044MhK8K8Ix-jO3YEmo26MwmG0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkyev4_jaiPN8q_UugBuJz8Ib3IdLOAt76YwSEUmWvCw&oe=6A805663"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_M-ezD6qNPwQ7kNvwEIqRsf&_nc_oc=AdotEgC35Nh0KFhY43-vKWiVZLtiTVMeJtbVuUpEzeG5EPDaaCDi-r-qEytwbRoun3U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeFZAaBOXvgmKofuc5yliRsRE31yfV_IjIfT2pA3mS7g&oe=6A804774"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdrKAD7DQATHir0UQFVt3rRZxzh81StsD1fmGFNDt1-T_1RxiQ0sr3JSmCcG9xMT6L8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLapiA51QOZY8SGPhMfTo1gD8H6M7oVj8xvP9owogK6yA&oe=6A9AD274"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DVMA_o1tt74Q7kNvwF02xYs&_nc_oc=Adqm0bzy-miGbcHR5FapmwzSPovTDOjfi29mHcaVO0s_C7cn3xnPoPW0b0Ga2racNXc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyACFgPToepR_8z_I6wGGd2nxYOmL6WjMZiOYFxwgAgQ&oe=6A9ACC71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kl0hp_udk8QQ7kNvwHkDzJt&_nc_oc=Ado5aAD4oC8PuqeHqTNNYRNA-Let5oy6KnjlZS2mBDPcLDFyWo5A00WDaph7S0ocgvM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSlh_7b6r_iuo0DzGti-t2iKZq7hf3amsJTSG45Tpagg&oe=6A9AD29A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dc4-7yljgcQQ7kNvwGopZcs&_nc_oc=Adp-3ekSjq6idDiCgi5AlLxjSmPEmcqNnCcUXN18xSBYZJMolT5AHcZH-l9Po_DT7xw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPeMWZsFfhjL02Z84KWT6T-R-sPFkIMZ22kK4mWQ1rMg&oe=6A9AECA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w5u6Vlv9OwMQ7kNvwFOSty3&_nc_oc=AdpIRnGck71whNG36xo7NAM3z9yEJJ7ED-T2xjOrtizPHgpKu3hPb3qwtz6VJQl65E4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKnetb-kziRydu1juoR81lQOVCwGcecwnrTnwQTS9FN1w&oe=6A9ADDB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
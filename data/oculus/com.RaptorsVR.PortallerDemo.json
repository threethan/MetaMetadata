&_nc_oc=AdpYzA4AH8M6HHVryHhlWzPIfhownPjloVyLuuc6Pn-uVwiVCp61MhKeSSOfGHc1GSk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iIQ-l3SN2s4jlPfjT9kuvVGUCezw3KkoS4lQcxURo7w&oe=6A072A74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdnjauO7GX0Q7kNvwGeoyAk&_nc_oc=Adrry-2J1TNV2qHNG98wdL1CjnowBrSTQ3ZsmxABqW2NO0udYIBRz4VS7C_l-80jLR8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O9yyTjEJ7vEtyvf9mLfObt1cDdsyWDBWk0j2sQlwVgg&oe=6A072471"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sovea7XKr50Q7kNvwEQA-Ha&_nc_oc=Adquc0RawKKSJsfpNjk2cthoxY4Q9WO3mBVG6pmpaf4yZGhnfLeE__F2nnVXQEaeApw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FHXdrnaXk_hRtSy7fqTDCGYq7BBsOMeyE1ar4Mc079A&oe=6A072A9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVzOB-HfrrUQ7kNvwEyQCkE&_nc_oc=Adom36VRczkqSTnde2KSAcwoVQpG5tEKTMOKDWjm6t_mfz2pyBLbibypUAW5JBGMLsw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Y93licAFR3olBvZr3ZeHhGX9ajQW4cwUTYDolHYatxg&oe=6A070C63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DEwH13kWQgQ7kNvwG6skrP&_nc_oc=Adpb6Af0BcJBMj9lIOJMF4a-zaK7kWWKo-QhEb1OWFzeoOs1o37kDzKMagwxAZncCo0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46e_wR9j9qSDTaMQ8aTF5wfCeiNWoJZN-SOPDM6pbt4g&oe=6A0735B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
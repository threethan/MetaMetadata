4-1.oculuscdn.com&oh=00_Aft57EEp4NsgXjABH5BgLA13VshoAcCIRVODBxgIAfo4VQ&oe=69A1A6F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-sgDbyot5PYQ7kNvwGvt-2h&_nc_oc=AdnGXYZLxvqDWRS3asp8C72eXhub549oc6BAuGF7hOULGtKI5_ethevgo6EYwGgUeRQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftGWvw-Wb5L0TtU_b0BGeh2h-6C5eymFMWEUtzV99JLhQ&oe=69A1A0F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-hNlzujsU9kQ7kNvwHHN3pt&_nc_oc=Adkr13qFl4xmZtk_Q4LfyOUuFo6xTD0h8N7BaOuNtPlvAzWGXu8YaqrykCQjS7PTY0c&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfuZDmCZCl-OFwE1EwM41efprW8-G2s3s8MlPeJUNuxhTQ&oe=69A1A71A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8CIWyXeX1kQ7kNvwG5VTit&_nc_oc=Admfd8DyGmeEbep98McN2yo4DTC74kI3evel53f3GyO_6REMNTT9YVfXVsMi9AmmQo4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfumwKAZQrQg8uAurOwLNkQKPD2aQbgxMKtsZSvwDFN4uw&oe=69A188E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_u8CFpA4VksQ7kNvwECX7Gh&_nc_oc=AdkxqnKkmBNSKMHtPpEOOD124FurTIObWYqwRDItE5G0rxHIGUWKm67q2BnPgNxdUUY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfsIqpBD2hSpCb1qNjBmaPtJx69OCabq0QErPCc18BimWg&oe=69A179F4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER", "TOUCHPAD"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_m
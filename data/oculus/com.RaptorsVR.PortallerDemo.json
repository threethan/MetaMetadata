&_nc_oc=AdrpDefQAOGDXg84LMdSPVMVq1gikMkDaim1Ne1XgDf0sbcZryOU8arocDV9NaxS8FE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQf5gKOKANC_qRtkk6OilZkm-6GBmB-w6ZmPsM2J-LHcg&oe=6AF71B74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oJvfUwFkt8Q7kNvwGrUiEt&_nc_oc=Ado8QwNVchieokGaNN65xAabYBKOwdgTJtf2tzQLM-bNHPnkD2i3ZPDFAhlozRyilBo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTbhDBLkmjFmOARN5Fbx8amNDm9Qyi12zP3Wy-OLWCDZA&oe=6AF71571"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAXWoqjEHH4Q7kNvwFTbtfd&_nc_oc=Adq-LJPVjaiNL5qpiZnyRR4CEYq8xs96irJdbq759oG4R8rCgOanduYNOFAbrhqRI-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8JpRFl5ZZ5u1fAJhqXRXOgIH5obdH2E9MXOWLpRnU7w&oe=6AF71B9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YQ1P6R8vrBQQ7kNvwHAwBVk&_nc_oc=AdoWFg4cNkW9ActexOcD_6Ts6l24t2vx1_z7co7beFw2p-t59ALh4oMy7RvylNtEdtk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT5ZNrXE6JrgLFxmEeOjKakMyOLie5dELOTov3aUBpdIw&oe=6AF735A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INTgzrAdoKwQ7kNvwEUmvOy&_nc_oc=Adqkm_Ts1KYXYDNJdA2zg7T2EnDG-7IT0wLkPyLwFbYqEsrMhgjWf4eAXgFJpBRjQGw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlHz0IRHDn7FhtGqcxia8WMzmK4Ovc6k_or6u7Rx1JhA&oe=6AF726B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
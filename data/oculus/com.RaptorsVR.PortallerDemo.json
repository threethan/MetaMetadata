&_nc_oc=Ado9iqYZXMGXkLXSEYaE38uQy4MqCfZoRRzFHR-UQ0JdRxKNbNZ3CjiuX9o6JYEbFbk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQz1ifoLDq1gPQtKIayXJc_k5o9qNhk-K7Ba1V3BTH1FQ&oe=6AEC8F74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LesX8eaQV2UQ7kNvwHoqIdC&_nc_oc=AdpnzMJHBE-84di8F2nrV9O0s0tOnO_GFHbQLxx4x114bhYjqntj-I_M1y1gZFLTupI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6Oz97EQmcXK5coIV4YGb0im5dzUvn1P2h4Thcr3n3vQ&oe=6AEC8971"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-848-19IuekQ7kNvwGk9p1L&_nc_oc=Adq23796rlhYT7jdd0pVAmbQCbTVGp9ZQoSvOuNqyEYm5w0C0W_nCZtyVoHeuP-ua-U&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSTjma8T_-zJo2Q4tZNdr6-UIUrNfszP0hwNuTN7ie-uw&oe=6AEC8F9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSfAI7smEPsQ7kNvwFu9FzD&_nc_oc=AdoPWzD_PEMwfEGGwQ_ULvP9S0cQ21l_O8AvTL16odQ2a8YPWiP-7YPAIvaemi8WE7w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRoIau2Vrf_4Bj3UK7TOjc28ZOyokXAmdEjoJdg1pMaWQ&oe=6AECA9A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_83lvTkZvoIQ7kNvwFwVhRA&_nc_oc=Adq0Q3CKW2Faq_CygiHgJLKg6SEJrOFDASzttUU1CqW7Lmq0jUTTOahWj76Ye4zDziM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTffmVtYtoQXYct5xn960IxzyTD0sUENTcJ3mbrVO3-uw&oe=6AEC9AB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
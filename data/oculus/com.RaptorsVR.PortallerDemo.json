&_nc_oc=AdoZn-370cDh4D_ZGDTY_GmQU0cNRfoZq1UTZd-S2N70Ekngn0T5KsT5HOuajf5Gubs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMhBlpBjxDB996hfo96k_YJ42oKxb2QdbU6qmoNCnPw4w&oe=6ACF8E74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-ijxFPd2CQQ7kNvwEMESbi&_nc_oc=AdpmFm38ZyJxGMG_HPUZhaRx1K64ZH5T-6GdnqWlCYOxQkvbrU2xMcDxgnB2ML7U_Dg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxAMTFhIslUh5kjTC15nptBj5vI3CWMkfX2GZXEfJvxw&oe=6ACF8871"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=acigzp8nMwwQ7kNvwGbcuab&_nc_oc=AdpVPdWRGj8k3VgAZwWZyIW2kC4GK_mv3mT7WPdQTnJMMVNSz3Db_t0IHzFBIiDlUVo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwtsA0NYXUcfhHjsBV5C324TiiJvAxj06Jo_OPcss15A&oe=6ACF8E9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHIFNJKdb0kQ7kNvwGHJ1RO&_nc_oc=AdoE-_p_92C1Ts8syJkxk5vbDIDBzulEewV0C9YK6QESGJyLUsfCAIIj9bs9NLI0pmc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOLZzJDb7Fy2LmbXhCzolqEGxKbW1gpcsJ2Fg2kvGXUNA&oe=6ACFA8A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU1Y7O9iursQ7kNvwF5Y6Ci&_nc_oc=AdoBhyp7HPZCEn30Im0_om7mBn_XcNtCGc2gneHuNtvXBfd2Ktbw54tq3Ydma2ip1mo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhTeBEqkQoxMS33v2uyD3etfaFuJEjjpt0pJxyapru5w&oe=6ACF99B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
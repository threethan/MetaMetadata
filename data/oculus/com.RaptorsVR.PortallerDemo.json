&_nc_oc=AdqrpgpNlCaPqT7k7IkDirY7S3Aw6iAcl3OtfuG4F12OH4hCWhqQqbL48gknEbDoM8o&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vleirS-oh2A9So-PeI0lqyoGRvxJxaUycfFbzfAmvww&oe=69FDEFF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVE3bJAq6WcQ7kNvwFl1gOQ&_nc_oc=AdoINZWSWiGXlJ7z4wAuIvcOR8_W0N6SvObpQjSbtngc3OdGZoP1b7ZU-LPX7RqskmU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50HAgZay9VnaWxQqT8zAHOoqADOEXAc4meiYDsZmQJ9A&oe=69FDE9F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxvTTxKLI48Q7kNvwEKgqYt&_nc_oc=AdoOVXNolGHus7XiMKXtqm6-oel3BXu4CLIPlhCueWDHCMVuHmYkfL1zUu3nfw7iBfg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5LdoCdx3u6CQ81FkuwXjWQdA9dqZ-fp7SRL_iId-7XoQ&oe=69FDF01A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hf6aYg-I93EQ7kNvwE49G5s&_nc_oc=AdoqRNEAAuvQWlNSp9-hlRbPV9a8jghilcM9IatWatx0agt4lKTGLmvwlfpwOW6diWc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mD2vYYMBD6k13YsrsHDOHTrT0dBcdpp1ZgBsc5oU_YQ&oe=69FDD1E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sNKYiPWt_2wQ7kNvwFkO0X_&_nc_oc=AdrJapWrjJPOqQfuJSm9gBfvaOaURTZmJEM_iHdDHKUnGQXWD3MysKhslCZlfBQqQAc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51c3vKVw6baGKd6ld-gNVSpJTabbu_lWxZOgi3ROTOvw&oe=69FDFB34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
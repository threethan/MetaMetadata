&_nc_oc=AdoHzL5dQzNZC542fmPf8AwaS7KpYt4bpvd8AV8TXbpYy_DOx_nQQDDOp7VZ5wSqNak&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0FZyAOZsdnu2nRi5ARRQywgiXgC5uVGfklXUc1Z-_GXA&oe=69DBA8F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cgTShW1gX_4Q7kNvwHjIo1D&_nc_oc=Adqo2frulCAo78zi-ydNGgF1PGuw6bFzzcuY6aF7WUzUH5yn2vTsyIBptLpjOaJMCb8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Qspe1CNa1CkDl0iksaVtBIKG9VM9HvfkVtf2bC8i6TA&oe=69DBA2F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoLw--HLO-UQ7kNvwHkCwnO&_nc_oc=AdrrUN45PFfsGS7SBa-j6XlgEqdzzdSIremRa_Fr8VsA-G_FochgXgjZBQs3GGZhfUg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2cHaCl6EFz9e1kI2CmlxfAe4rdCj5IyxJtofvFjDOrnQ&oe=69DBA91A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJILyR-RlNQQ7kNvwGgOCNq&_nc_oc=AdogylFigaFS99FK7OtydFv8hkzjBTn_jx8FhbllLxjN2i8Xh7vsdbZF2ER7xBV3gtM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af06zu24aJoMmH9frHhiwqa51Zgaqee5_QajM1E73tSXgw&oe=69DB8AE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7L9mOJNqc4Q7kNvwErmEQw&_nc_oc=AdridjVdGftdkRQZqSqK1CS1voLxV29MAeJhYwluNhSuudU7PeJz-PDnKsnywxInh4w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2etBzzM7Of0vtfOHmpG1FkOnRHvYLXGr_4j7Scd2WzUg&oe=69DB7BF4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
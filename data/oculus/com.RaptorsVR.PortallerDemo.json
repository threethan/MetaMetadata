&_nc_oc=AdpxV2i0ynwLSXcuH8J6Dw1BwxAnry587chhjxbGC9oEE-ZO-OwkFmupU3HFI33Sgow&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS3seifPG6C4rvp8ZKKTvVN_-EOQokn5h0VT6KRygpZQ&oe=6AF326F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q3RbVhALIhgQ7kNvwEEXGzk&_nc_oc=AdpyesFRYLGm5v4xwQodbtwzQcgkZbkIU_s0IFdyCOqgm0Q2YQYU5tZ6KyiyFnnReeo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdi4moTmy-LHfTRm46oL4oRFJ_WQbmz_I8iYpa1HGnKA&oe=6AF35931"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KPVBNMdpMskQ7kNvwF_y1gQ&_nc_oc=Ados_Dd2khIJeg5tZxAVDXijYvU9CXCA-VM-lE_YltSSGfnDDb_8iW9UF2ZH0qWQBpM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQROJ86M6I-TNc4lqtz7TMUIXClgXxYAoFdzjiroN86IYw&oe=6AF3271A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GqRZagifY-oQ7kNvwHa5qo1&_nc_oc=AdrDG3PL-exMxyekB4ezkY22Db7nl1J9nTbQRVfE8XsJ30NIUQpHmFn8HoE95T1Sivc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8g0nZjNQ75wuZ-sM95ghgHXRCTxVrPFrdiVLBvkQdgw&oe=6AF34123"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti8fYhOtFCEQ7kNvwE9BfiL&_nc_oc=Ado1huwN8QX-UyyhsGjW1cVHIpa6dVqj7w5WpjCQDFFiCftNFtAe2RDW46A9Q4cR_Ng&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTHFKtWsyRm2HALUlWkyfdKtZbGbwZaei5OEzjjjKTJlw&oe=6AF33234"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdpmFHvYqj_5fA0tiy93NpbhRae69tvlXDwqDdVZDGHdduC47bwlYP2WFBWJ2b9S8aQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxde4n59Juellp4GzOdh4ENSUN--nFzYvrD9-gRhYm_mw&oe=69CBD6F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AAA24EA3mxIQ7kNvwGjs5eO&_nc_oc=AdqCLycLErO_9IQCiDyfZNlFOkDVm1vH5mI3Brgy4FxnlW-82JSCYbLuDoBdurGzZwU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyhT5nZP3nPZkZlfkPZZ55J-evJ92-kgoFuAQ6l14Huqw&oe=69CBD0F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pbUH-DUxJM8Q7kNvwEysKHV&_nc_oc=Adqjq3vY-8mbiSKpJRx8OL8BBHDrmXznMCbpvSMCVAXn3tcVEq-8Mf4hXrDbzQPJQiU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzC9XuHE4f75A72mTwXA-8wZjHnsK2T3WxaNAflJau0Ag&oe=69CBD71A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzNKvOmrB1IQ7kNvwGaN8i-&_nc_oc=AdqF1ZMLljKBMhZKfwt0fxh4bzxEBczVSpD7kTjWt99YwiUEYDaK88tnwfHSJKrqnk4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNcqDNaV-iUo_e548WR448-KPx8x2yBLQ3k7HIoapV-Q&oe=69CBB8E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zFUoPtLacgQ7kNvwGJnSjC&_nc_oc=Adr4W91L7LvVnLCulgli_nI-K3pQzYdfdfT7JwnC_U0W01vnjVwO9YPSsGVKdVdJF3c&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxXDMdUXqG734f6-Ok_27I1scy1KQJF8RA5hO7aUR8QoA&oe=69CBA9F4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
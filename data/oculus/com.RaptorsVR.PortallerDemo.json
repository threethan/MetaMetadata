&_nc_oc=AdpRu71Zf9k8pqb-EFNweZCoZDPDNUfB1tOo_KsxVt6AzZ0tKi1czbUkVZXBRMuggeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDj_JuipEefGtM9jGiZ9MIWx3osSJLUMzcDCw4Tw_1sVA&oe=6A491574"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioJS0SECgI0Q7kNvwF1lWFI&_nc_oc=AdoeAprCPdYXGErmOWFxCG9-54P8WDySV-49fKzcKLrtD4FSLieR9Zc975C9nEOhBIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVdz1lEeXjQyifNH2lrZvINeLJtSFXoFb4BPp4NnGsnQ&oe=6A490F71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4Q99LAtpZgQ7kNvwG7Nc56&_nc_oc=AdoWRh_R0v2cjvZW2dNj_CEzfsOK_9MGeQWU3MBX6HlVU46s4KDoC3qNlG3QmiAGAkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB533-QgE-PBrnGWwjE-tU0Cr7hQcerHQsYbMgov7X2Hw&oe=6A49159A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WN2XXHiJhdAQ7kNvwHnkXls&_nc_oc=AdpPTEcXaDyOH4cot814kof1YH_cDjrjW11ThTPL7kocTwW0nT4Ebv2z0iE_qZ5J3OQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCKi2xGWwSc0n9FYB2o7bng8XEJsKAo_-y2LjEQ6-j5ZA&oe=6A492FA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hYdCwJB-WjwQ7kNvwHxgwE8&_nc_oc=AdrXanzzxYTIFs0vqZIiTToPBlzcrcyXfzUcO7C64Nwl8B2lfVeUrwJ86pp1ip3qyZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBoQpkqfRqXmR4VV4UJXGRPaItiYCgOuqAAfQW3M-aNzw&oe=6A4920B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
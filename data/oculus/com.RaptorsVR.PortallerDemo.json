&_nc_oc=AdpHLcXHqIBDSrS5WB4eDfVh9APN0IpNUNRQEw5NW2LiQzS4NOPhnMKlvMeFXeHlf9M&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25KNbi2OmkEoasmP13WJF6cQjbS7twJCuw1skbv4Vfkg&oe=69F4B574"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FpGdDyq4oJAQ7kNvwEXoKRx&_nc_oc=Adoaxjjs8GzXTBcCwiMnQvvUDl1gcIe9p_cf0t0_wf3QmxeHrp5iTyWzEFdalDYTXlA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af14I-g_H_z0JgXrGzRGzLxkNuGs24nhACFY2nYWPI4-sQ&oe=69F4AF71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s9zakyhMhRUQ7kNvwF4uTFH&_nc_oc=AdqDS0mXplnXxznvbQs_7tjMcu7_Uu-PM7T60LaN_tL1V_l9X66yNRx1VBiA-ui73j8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1i7IUHNvf1jYyz5DmTPVWeCwTsIq7gs_Mo5e7JI-C-PQ&oe=69F4B59A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVdgHdN5zy0Q7kNvwHmnPrx&_nc_oc=Adp9sI4i3j-A529zNCMhi9PY5_vDqLZgZGNBg5ivkxjv47pHRzvpmvRFbFLuYxmT2-8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1xX2PwBcoi2I55KnDZ1ndtr8HC2ablaHwj9WICUQOLGA&oe=69F49763"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8IxgcFL4qqIQ7kNvwHvUTlN&_nc_oc=AdqQA93_xWF3k9Yn1bsDQOeual4Inpb1YKG1Of0Mklc1q7cvB1GMchRbqZwAD9gGZhw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1v-Oh6YflG4LmOyYu1rgigyoypW1aiS4pM-cuq9C-URA&oe=69F4C0B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdqsC74stAdEC0_f4h7Pkz64uVXWmnwcT3VBWORw5lVasiUkhGVPsXXtrzPme6JBXMs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqdKIKf5Zqg73iZk3sFGRQL4rkjLE1DaFvQqvgv7NiRQ&oe=6A915FB4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTF3aAFdJFQQ7kNvwFtN8Bp&_nc_oc=AdoS3SKhXNyPMypMVODtaHTZDdr4JiKFMVskGjE9Mr4gSgmmoK-ZtfEflGPkkH-N-6s&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7ctgpKLxdmZwSQiDY_jL6ucMAZADtqpvTLzOcTae4zQ&oe=6A9159B1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i9kt24PNagwQ7kNvwEDcXiQ&_nc_oc=Adq4dXRiZErD7p34DbuOhCwlgCGYC57vjw3C6MVvTijMC-bzIwv3UmfHh-0Z0F_Nrw0&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFQ6m5NA66KSzbgDkGWecDxeeGTD-8VCFWEXGYv7XAnjg&oe=6A915FDA"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mzme4R8dvgQ7kNvwHghz0o&_nc_oc=AdqdsW7PtP0crHqpfRFtFhQEUpxmm3Ycrh_LOp8yc55gW3CY7zuZO_dr2kIuk_7v_aU&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJ0XMU9ckaTds4W0SEAefi09S4KCZaf9Fd094cZ5Ss6g&oe=6A9179E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9mqukwrHwOMQ7kNvwGzgHND&_nc_oc=Adpcysiid6JlGTCNz1bnQ6u-Be0rTDO8TXfvRcUSJuFaIRuamvW0pWQMAShorAAUKQ0&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtLZgTlpfLu3_LjE_jR791Ds8Gxr4mJ-86PQaVP0v_3g&oe=6A916AF4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=Adooebmt2FJQzxw1JnG-aUefRszujHgm1B8FGHR9BOf4Q5Inu1NcyAonzrfbrphumoU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af71nAZ7EocB1ZEr065PtSqTt4gJkg8QuLYSlTqnqh4u-g&oe=6A16FC74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8XTwpYWOFwQ7kNvwE8kSno&_nc_oc=Adr0cPN2ImUJPOBrHJHgg87pI5zdDXAI6OROWiHL1-LCHkJ9fmKn94YxfphFkIZNZ38&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jPCEzuxJ7pSHj29aRyUQW9LZGdR4rsrTiNfJr43VZDQ&oe=6A16F671"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VSTFxTsRiSUQ7kNvwFYGUSg&_nc_oc=AdrTd2H-wR7SNrwcSNCo_ySLLCvns-qRAhFYRan89tW-YGrhpkLF2knvAv7sjVyTHrg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yjXJDl_Y7pfURoIQMapaNeM43aZbmL6sEl8OcAiV_Cg&oe=6A16FC9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFKVRfKVo9UQ7kNvwFAEy_Y&_nc_oc=Adq5fICgyZk2DJ7bmfg2Qvsnu3JRWZtjMppMauXtSI2pmKnN6t5TZfTIjCeab8nswg0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MpltZeMx6tlF8EWTCvMMM15u8_Hjh_9jc0DijpeBj5w&oe=6A16DE63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CmcX2IO25d8Q7kNvwE61s_t&_nc_oc=Adoboz8_hILdRzLvtiYX0wNVEzJtKtXYfnmV7ZYTWC6gVy7SFBY0v0ypLu11z68p5EI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4cOmtafdCYLtEByGlYMmb4w4o8HlvcKYBBWaqJWe_Hmw&oe=6A1707B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
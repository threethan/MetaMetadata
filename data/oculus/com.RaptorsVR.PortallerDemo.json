&_nc_oc=AdoZ5X6RAmzGo6UaweKT1i-LJNMS8Xto3EoVGQbKiei_WgwQRbNq9Fir7lMmOI2N-VI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af81YTBwI5aLbyAVOc9jU2xtdJ9PJUxJNUtIV_JBnYrqMg&oe=6A43CF74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vj6onxMGnCEQ7kNvwF-r7q8&_nc_oc=AdpbFOAByDzj_gadUlSJAEJPE2fU_tM9ELfReahKnXwonI1cEBYnOY55i-8JZXJ7qb0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9hsvGbf2okZMk-k9D1NRYE92MXPZseB5_UuQxgQq1gpA&oe=6A43C971"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LWTR4SnuopAQ7kNvwHVbOQh&_nc_oc=AdqhVBV6bVnxxKehzmn1Of0cFIWHgr7fnDkPOLRwRHN3nF3OGghBZe1I-_hlITqfQMo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9XzcFQ_spzjNkIxEVGDXNUH8OBoTNnLaIcH8PXaNLNWQ&oe=6A43CF9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wnJvXECImxIQ7kNvwEQFzxa&_nc_oc=AdqPVvvjFOrcvX4mTEBK7LPGEpgk5Le6YTnFxjNfD3OoAAyqR6_3Z2COs4u3P1V8qPg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_xGC3GMZ863MZT1TWbouKaSFnmNhU6k58i9JO7Qg_qGQ&oe=6A43E9A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvnzjiJgsE4Q7kNvwHs4Te9&_nc_oc=AdoQajS6fI6Pa-n-GrhBpDwiXaRdqg3n5lZ56xU1gNvJ-l9-k1G59O4qKH5i_URl7OI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zUK-624wQtH5iOojmFQbAFPf5s1oJXYnLS6bVGx8F7g&oe=6A43DAB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
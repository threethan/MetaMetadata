&_nc_oc=AdruEIIUk4nu1Kjzeo1rvRAtwb0cr5iXXWRiQhshQJGH4xFvS-_IcuD5z7VSS2kumNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4O0X8npDHmVuIXnO5i-qbWyoIEhrEDVeQQ76rTBWM6Jg&oe=6A087BF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdnjauO7GX0Q7kNvwFqbadb&_nc_oc=AdpOXnSkfb628M-6OZn1U4vX44wUUtmArt7GmBrrntGTPuo76fORobet3NMkQraJZlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dAecbB7qcsOSZPAsGZ0tVFOwvOU9nt6APMMYcQ1YL2w&oe=6A0875F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sovea7XKr50Q7kNvwGmot65&_nc_oc=Adp4lxqumdjD2ZRvCgQATJ98cetvLDfe3kGihg1jHqNDw8Hu-sZ86f3khZVlSrX9oHw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Dw-VWT0Qy2qK1HWEnGpS0XHokbNmhvxOXX36hZRthyw&oe=6A087C1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tVzOB-HfrrUQ7kNvwHpQfeB&_nc_oc=AdpUk9KswwJaO7bYZfQ2dH9NI4f77wUvkimwLN8KxCwGw7uNKP4ndl9lI_vD9m8eCo8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gADLyI_Ni7LnMyyOrYNpfRK2jJEz7PH-mf0jwaOG_kw&oe=6A089623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-DEwH13kWQgQ7kNvwEcq4rO&_nc_oc=AdpgbvP4swT5Qk_41pTxXzIyuso-DfHYnPDedb-7XulScyOj3aY5WwcR8yzuYJs1xxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5f1R3pzZp7FmmuNzbqHeUX9vrLwmizPIWBYAFjS9ZHSQ&oe=6A088734"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
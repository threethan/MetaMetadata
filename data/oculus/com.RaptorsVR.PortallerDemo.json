&_nc_oc=Ado95L0x5CXHqT_oexqemMMGdCiy6-Hwwp66YlchX1_LtUU_qND1N433lNdmilqIzbU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKOmv4z8T0gESbLqsPuxN5EZSZAbXW5JyHjEt2bYGDwNQ&oe=6ABBC7F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9mff26T36kQ7kNvwG2Pf-b&_nc_oc=AdrrMSF7s70l5gHl4P6oj1GGo8N7TsKHQS50SZMa08vdq6LWcHgY2EvCr4TSbQzbvwo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLcVaAAkV5QrieneaPBkVIcZeKed2jobS5hNs106_0nLA&oe=6ABBC1F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNxidYysnHYQ7kNvwHIwB1i&_nc_oc=Ado0TbyHKHaW89LR4mykd6jlXvfndU0Wlgq8gWGnaiMGfXkwWDNRrUxi40mhAXqlpy0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK11cbxZ-hW4jP1rTOBZecWT3eGwdZqR8e_m6gJ5xoSFQ&oe=6ABBC81A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yE8G5GpSNccQ7kNvwFsJLxy&_nc_oc=Adq2UM-rAg2i_Se8YwTaPN2mt2f-mKt33qhHKDNO8jgGbe2_7ea5Yntvz8LegzWfrZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK31h9AZdTjMLal8qLfzl_sfEB5fe_x-JrXhONQ3yGzEA&oe=6ABBE223"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbNRnmWMtiMQ7kNvwHvrbTK&_nc_oc=Adoo2U6MqARIr120USPTUOFtKz9PZ62ymE3M1j6uQ8_Yi8jaUoGKNjPQiAATplLpI08&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgoz5Mrod-OzNGdQcfwZGlptOI8Jy-ucnQuQ2LWbWpHg&oe=6ABBD334"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
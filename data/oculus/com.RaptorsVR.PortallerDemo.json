&_nc_oc=AdoRK07HYmr_J3ottjn-oPqbY8GRdQFkG5vDsWTe0kiFScv8jvB-3C1SpgHee7tVXBc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsNTCgGXwTKX5EkAJYcY7uAwrmWxc2p4zgqdU5vOvSgg&oe=6A6F50F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYO6I4vLylcQ7kNvwH_0DT2&_nc_oc=AdpTIRgY8Wpu1hRw79gT3oRtGvkITYAIkRjjkc1UXaNlyoMzghpcbVrDVR-KynmR9PM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJTMPiSmB5F141BL0gPSrTp-CGZjxtr565SnKHuWhSIw&oe=6A6F4AF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tbKtGudXIsYQ7kNvwHFjORg&_nc_oc=Adoo1dl6XmD4uxLH2avFDrrNX2MGzbiSsa21CBcqBaab5OjlZ9Xtzu-d_H-Sq9rgzWs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3Agz3SOBYzbWyxw1x0i-mI8rLTC7Qm3RFmIiT_32qpw&oe=6A6F511A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-c4n0N_3slwQ7kNvwFO-YXT&_nc_oc=Adr7ciaI8t84PV9B2AdNel3zUcuJWi5eHZJAQ687MpMqhnY204-IjMiggMMVid1h7Jg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeGKuzcm19lzrtENW0BmpdDjvrjU1JzwYcU8ApBbLhlA&oe=6A6F32E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5TrV0ZcL5wMQ7kNvwE4Ls1u&_nc_oc=AdptnZC1fIWjJLt1oJ-zNN9d7iEbw4dj23rMkgOC512erTA46dw76lAyeFfaOK8i-VU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABwqKtrloc12Sg1vqRIpHCGzWhEXjXsbVjbY37F0583Q&oe=6A6F5C34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
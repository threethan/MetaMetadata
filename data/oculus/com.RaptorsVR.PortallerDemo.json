&_nc_oc=AdoeYCdt76Y7xycNNDXOnVOLCoUxFr0bZ5FFM-r5dhgrQcNGn9UeAObeUF5PrCMXoi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_yfs1HhUejBLr5XJmvtbChxkFwAuW9uKchiIZxihRJg&oe=6AAAA474"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xWsRdkrfPMoQ7kNvwEB3vJT&_nc_oc=AdoEu5yDrlSF9f1kz3s2I2w2NxOFlL5RaJOxEe0xw2pAr0DMGEgbuCoaFDajU5auUn0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMyjG-lzwl3xbKRLbYb38z1P6i9Sf3HOKKlYxAYiURLA&oe=6AAA9E71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8x3PV0_r-7kQ7kNvwH5mXwI&_nc_oc=AdpH58LeDN2B85vK19vrX_NT9Ur2X0-lpF140CMwS2w4cW5K3RRYpsk01yRIsrqoVW4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVig0slM-DTu5-cNEBpdieks9tTvftQPlIUlrcDjd1ag&oe=6AAAA49A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQUiGJTu47QQ7kNvwFiMU2n&_nc_oc=Adrahf4n5yCKcAh8XWpJgxHO8DYKCnnHZjIvOpEeK9BlSTkjqXpM0KFQ3zBweWIV_u8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLloKZPOSaPwkbYI2FK89_1L5-UrKvKiMHsDx25yblRGg&oe=6AAA8663"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r-LPQCGyVTcQ7kNvwFhkk9O&_nc_oc=AdrDKHigSBexEjVg1d9KAgz_STWagukNIiNpN08btr_0Dqq-DiJWQ1KasWGeV6gVdyQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKMDxlkZBrNphbJ0D9UM8K3kFGYck3cOdyYxJnm-N46vQ&oe=6AAAAFB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdoYvkb7kFTKGSU2h3oU15Zi-hI2_18gMbNgR37M5H7zgjuDmDUfI7pXsQpFu5Wiqz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLhmVMs9yyIIP330fnMm3ft4BExKbFdzCtQi3sFm16D_A&oe=6ABE6AF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=StKqHX1xIFcQ7kNvwHwlUjj&_nc_oc=AdqED9mvPp0Bew4xRNdGEdRLxDh9Am3Gw64nncxXVKOXWkYE64NR3CgN_0fwZdjwbPU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXrzcAqje5PU7UYKfIj4sWaFti8kSF81kyfO_xEhNIJA&oe=6ABE64F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GfENp46Ni8Q7kNvwEmWOGk&_nc_oc=Adr8EmzNK1PDJ7XVZQRBhSLrAT2Swx4ZdWx6DSry_AZHJVA6mMhcDp3T2voTuCFpHMo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzWlCfrb42B80zgjyy2p5cGPUU19g-jXxPjl07QoOLog&oe=6ABE6B1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yE8G5GpSNccQ7kNvwHS704g&_nc_oc=AdqPldcfAAtgnSUqNVh_JwXmaKX_j38SRzecYrUUz5hbgIj1HABN4q8-wo8qupjAZRw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLeKb7mscMlvX1LWVMfcksg-0VizL8U5c6aPIYBdI-hKA&oe=6ABE8523"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rbNRnmWMtiMQ7kNvwEtElzG&_nc_oc=AdoViHo3kBqxMq3wljoxS02q4cjUZk-88u4nm32JGSliqG0d--yQareZjLT970yVbiw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJT1RiKct1DhVI1wITtA7X-aLmuvYPfr5SoOWvDItox2w&oe=6ABE7634"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
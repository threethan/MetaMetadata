&_nc_oc=AdqmqMO4SEvQG95_ZEUF1B4uhKmQEp_ZWtbF52VATiR_-mhNTllfhsKJuN-pdczNF64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtDde3U2ZiavOO-CUkb8XyEx5BBBSwqnbsaiWKTDVRPQ&oe=6A6B5C74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5t-fnoqhr8Q7kNvwGWqK2B&_nc_oc=Adp4Brk4WANiJY3hkmYCEJyreBFjBtpdkURudx9wPYYvYQEft8vHzPwU1XojbtyU_1M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDE7jmf2cvtgknwVUj3Z4xwbyoD0lztc1j2XOO0nu0tTQ&oe=6A6B5671"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45M-EQscP9cQ7kNvwFjkoWU&_nc_oc=AdrQiXEAs6T9VBcMMDJtMNHtLSpdSZTXc1FAckqraqnnC8EX_y9nuE5oT6YYoMmIxk8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDIVMLyWgU_8h8eziszRUctAAclRzKwCALOXY9teUQmtA&oe=6A6B5C9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CIgaTLT4bxAQ7kNvwHCiNIx&_nc_oc=Adp3EF7cUz2R4FNuFg5AdlGJhDRt2EyOrTr7ADP06km_iX5n3J9QLgotY5WASjDHBNk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB1X5DXQdSo91WzCdSfcEYlQhgAJU6itkWvKW3VmPes8Q&oe=6A6B3E63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=44_jB_yrdzEQ7kNvwFvsUvs&_nc_oc=AdoYcfrcBoJ-_lelGEbB142BJH9MtDFr-ZiyjaiANBNYbd9_L0TW7N7IHqSrd1mQRss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsvTWyo9Bfros6RMZ9Uw-KuIodN1gBcd6wZQXTWB9eBA&oe=6A6B67B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdpXYuYw0-EDaYPFCjPy_bN0tW-j8jVcK4adrm0Au3wAwLCYsk4VgUNuOzRlSDeuGtw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3QZyGpMWGYNTjN93lihgonNhFoDYuaa5IssnmP1deiRg&oe=69DCFA74"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YdKmb0chFqsQ7kNvwHrO8An&_nc_oc=AdpOSaHUUdLjBfIIibuqfK8vTyI2X84xVxGmNEO6LfUqEnpFZY0GFKlP_ribPQKz7bk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13Cmj5HL4Yx4heb7Sm8Dan4Gg354YgG2spwZyX9jP70A&oe=69DCF471"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EoLw--HLO-UQ7kNvwFjjgLQ&_nc_oc=AdpB-HJ0DwoVlhL0JZXC0NmXK-VjGsaLvJMLQOWcgJKw7abCee20hjJ6nDix6vhc2-U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0UnJHAzFJHPIljwvEomdqtrI_rqjwMUGxbW6drI4CIUw&oe=69DCFA9A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJILyR-RlNQQ7kNvwFTXAAy&_nc_oc=AdrqcUM4RlD30fem2utzq0PkyRkjnaXnMSUPv0RUOi55-BDpuwOFtRMCrCJ2T65DTHU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30jXBf88kNj-itM2D4Lsnx4yISjbtw2sEMscrhaIYxhw&oe=69DCDC63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7L9mOJNqc4Q7kNvwEEqLLh&_nc_oc=AdqFTAqb36Wv2sBLUT0GR3620bhsyv1f_Ck2CgfJbONcYMKq7u2-0aXcQ-jb55Z5eso&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0JPfFz7Py4IY7QyktBuk5BXacXXhyDALAyahy-rgUBSw&oe=69DCCD74"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
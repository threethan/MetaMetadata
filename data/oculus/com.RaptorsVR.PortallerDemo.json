&_nc_oc=AdoBY-70G_i7W9zNmuNFPo0CFMvqNCISfqfK3e__ht2n1XxWTiWHrs3MvpFgf5DfsAY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt4PaH4_6TbPUj7_vej7gXLOfX2C_-h9wNVJCpQoMDrw&oe=6AC3B0F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NFAKZSW88LAQ7kNvwH3JkQK&_nc_oc=AdqYZWoYimJQNyQZeuIOX9sC_ONqRtNKfhge82jFZOXMnZPhWiEUmQvG3AkqOWKcuDs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4RxUTxMqUKtyj_uAvSdz1fyoT_uUUp6Rjuq1BisIzEw&oe=6AC3AAF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D4usIPWFYRwQ7kNvwEDLHcG&_nc_oc=AdoYUc6-P_vyD_D1ILw3vkVQmPZMeKSBskfjxR7qBY-bB5HU_HqTgmPBrM9VbNdwOco&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbcZwBnWbeHLqvP5h9nWCcC4YbOhc87vnUzbZcYOo-ig&oe=6AC3B11A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbGWRqnbtkIQ7kNvwH8wdA7&_nc_oc=Adqp7j6FSb290FQNHfq0nNs8jL2FBmLX_lpqWVa4g6ZvH9GnDpgJvKp9zqdTKpPHSr8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNVyLdOpbRtWfEmMqXp3AHUtxI2mWP7OXe3-JA3jzegA&oe=6AC3CB23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UDxZWHyizCcQ7kNvwGZXNDs&_nc_oc=AdojZEfsGBT_lD1mKlvrwHyWJvs5dFQCHjGA5C_ydrvWukpf1eARp3VCtzyvILnX70I&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQProEQh_wD5lMe52enu6UG8NyF83Mu8J56Ka4ZLbzcQlA&oe=6AC3BC34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdpgioaCgc4Ezm4M59i6kFvXJlb86eiODmpvl2d2VNQ8FbsC739kuug9gNW88TLRRcM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BXSGx-w117N7dQpSaq88XfTX3cnXgzzZC7sD5SbJOYQ&oe=69E4E374"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zc3xMYcgnMQ7kNvwFR3bF9&_nc_oc=AdoTZJ-bFOuS-SS1wvIns6G4IKod-yaZwFqL5pS7mj0qeK9aX7ZSKZYbbOvZWu0fhI4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18enj3w4FhH6HtrxFPJ32KcrA_70M3pFa5fiG3s54a3g&oe=69E4DD71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D-MuBUfyS0AQ7kNvwHOXorJ&_nc_oc=AdpA8vKV7WkEkoAI2ldKolfQO1iapcDZ_i3LlKaIOT1KI9kvnTUC2LwCfFXIMcIjrko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3wfzSJRScxXJLUJ-ihJyJ_y_FPvhk9ie_OHq1t0tVhCg&oe=69E4E39A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dd-OmI3JpRsQ7kNvwHTINJi&_nc_oc=AdrYu5sLRsFVkONVM6KjL3S-_PNEzKTsc9XixvzHPNq4v9TjhU4FkQlcG4_iEeKoR0E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2JF7KPTCSwyFK7LCvtkzBquK6SJ8meybrEeOxQHXxNzA&oe=69E4C563"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MiXJoTlwc8AQ7kNvwFbmb1i&_nc_oc=AdpaoCHr15vz491h5hrSys456al4fV94SrAvAETC-01qxp6ieET4C47SxX70_Jbkcm8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N_FKqiZuUFv0-u-0-whQaMBLs9xm3HjNkM3z5saSZWA&oe=69E4EEB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdrqRyDTRjmcvqPyCPvhh-w3AIOzKFD-wyJm3_lKRDZzhv7jcmoLIn8FrwNnMpkKlus&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmLLoErHye870YUp_qWDy3yg_WNlqDJzkYMa9h2o_CDA&oe=6AB681F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egBStYhOtD0Q7kNvwHn8mjG&_nc_oc=AdpR_evwjQcPGfqBhJUuPhSDNbcTCgIvmmzwQCtv7nW0Jy6dan3VhgCvqYv7tVynvHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ712-cRTQxOjDPbmibY4dESFof9BiQFEAkgb7bk1ogqw&oe=6AB67BF1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKraMjO_ODEQ7kNvwE9zFk8&_nc_oc=AdpsKJH0v2_MyVK7ReDKZSOBP3-CCsdIXHAIup027MhZJXst8H_CtTLs0BSYZYmFzb0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtO1t3lUSFJsXGQNmMclJLS2ac9yI89_5hWQYxhbMt0A&oe=6AB6821A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nCD74-dQEEUQ7kNvwFMIe6o&_nc_oc=AdrS0Vc7p1hjc-E8WhHJejYtFVwoT5KUy0We3AiyLajGmnV1Gly9LpiDwlka4mx722A&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbmviKOOsDKFQlythWVEogfP0ndhcb-CWKidhFHd8TSw&oe=6AB69C23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2_DdTto26cQ7kNvwG1fcJH&_nc_oc=AdrNR5cBsws1c7ldbgC4qyXcNRxko8FCe9KKWvnlHxsp0AFMrSPp2F96rwO_HbOSiBI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQID7RQB6zDXeN7V4UsIozFZO7A2Kq2EgIB5N66XNlr25Q&oe=6AB68D34"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
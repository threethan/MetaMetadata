&_nc_oc=AdqCTsF8RgKrutqC7H1Z-6hPRN8aaABoSuKP-3AX36SsN4J5PSVi22gU6mDhW07Mj1M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af11kWhMp3ZnoSr8SV7Six2l-4lto84jdkIuDn8EZa_E5w&oe=69F8A9F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8E3ra22o_AQ7kNvwEaUN9S&_nc_oc=AdrBnSEqxdBg84dj9JBI13z3pJhfYOEXQR6Bw_mY8nVYYoDeBPXlalcCzzpDLp74UJM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2P-d4xA7QvW9GoIewpEXfFT_pTpPRyYEBmq0cA27Wb5A&oe=69F8A3F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WodkuAh4hMYQ7kNvwHSgt0G&_nc_oc=Ado27SUMs1dj-pBvsJsYsJ0D-oJSWxano-DVgUpJf7Zyv8P63Z_IlDbV_wxZSPi9Yys&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af25Zhl7h7qUsse9TeFgpRvVfcHNLJFIcOFdoaBbjIS5_g&oe=69F8AA1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TNOAKlu6n-oQ7kNvwHtPeRr&_nc_oc=Adpv9CiAt8iTXqeBMJhxXSYaghOjnuLI8OoH8M8VCQiY2Nz28uM3QQtWWnTnbPyN8LU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1oQUIegr97XkSTz11_mSu3Sf5X-DRKW_nCvixL8cHfEA&oe=69F88BE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NlUqvVaXwYIQ7kNvwEd6WNK&_nc_oc=AdoLD6iE2WjclDtF5yuGn4DstAwNSvMhdv6bwGJZmz4x8EthwzoSalPEkfiPMTfsS_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3rzXxcYPRMSeqJtpYRb5uY4XRxmC4yP-KcmRegLerIgg&oe=69F8B534"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
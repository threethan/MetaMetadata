&_nc_oc=AdrkA9ePBf4H9-BQLGPr5EsKZ4HjKbXmQCEacA32ukFAx82PhJf43OTG_Ejkr7cjfxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK4-dhEIPbB3APV5np_xVLJFa_BaYMQ3340DcLh8GL2cA&oe=6AB7D374"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=egBStYhOtD0Q7kNvwESxVmV&_nc_oc=AdruB07cyU5pnnlrMD5UxOIXWR40QL3_YVNKkLwav_vq9cPb-FG8Ir8al0NBke4IsqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnXjWMnIhQ4QwaWVXf2J5lnspMjXsajQMUVG4dDtV0Bw&oe=6AB7CD71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKraMjO_ODEQ7kNvwF-zrUL&_nc_oc=Ado2BezgESk8nqtHLo8FCZ70vH5H_FLoS4V8VzFwY6OY0fAt6bAHX87WyQJJAa9j5e8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJkOSuRhFAHGHdQBjK7xT9En9hoNePDac72Qk4feqzsyQ&oe=6AB7D39A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQTBaSY7qzQQ7kNvwE-rBIO&_nc_oc=AdqUQg7kE5j22EKvHt1ZuBC1PsZj_L0iTQjXhM3qPIWkyosq_bW2WDAdWG6a7ugyVGY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLpZR4OtcBDjDc2Rw9L91AZx3dce52rlrLuxtbDHiExHg&oe=6AB7EDA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqXZjVWAnaoQ7kNvwG-jMJR&_nc_oc=AdrSchHxdqwb_BJQaRXE5CMhkUXO5bn1M3HILLiOJweo5ICQltnO6YhjRlpTpJpYxy0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJINiuKICP8byQp033Jp6AZKHcze7soty4tJLpHyUr2YA&oe=6AB7DEB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdrwkBP3mZ-iVro32epDOWvlrcKDvuxOZuyaMbp4jpwNzpLZY5pTfd4-48CyQ5H4cYM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3hi4F8_o-a-uCJ6YZv-ZoxUqFjj4CBHEnlG1aEH4KZg&oe=6ABA7674"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9mff26T36kQ7kNvwFNp1lC&_nc_oc=AdrZwtgUQA8OcF_z7G3H2y9lMCvpq20_E9_Uqg_V04WV5By2FNmXpyZNPebiIaOE0VE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA2JsOg-h3vQtnkYIZ74SyjfT81yLJEoUsnykj9DnR4g&oe=6ABA7071"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNxidYysnHYQ7kNvwHTLv1l&_nc_oc=AdrOTMYfi0rmn6bopkZouPYMnhB0W-WzRJ1Vk45VZLdshj5vLrcjvksgT-4RojI2y6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLXJ7S1ZEKHYIU0W6h_CUz2smaAkPGHTCOV-u03IncXqQ&oe=6ABA769A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQTBaSY7qzQQ7kNvwF2w2R7&_nc_oc=AdrmQ2VdP3q3NdEuje9JSz9PjipQKenNBkbQ9DyzmzUF3FvFqIBGJBPQTtUSXiU_fto&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtvgG3moanhY31Xw6C8-tGOsRQmYYT4HA3BAeEtFs9qw&oe=6ABA90A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fqXZjVWAnaoQ7kNvwG5hyJj&_nc_oc=AdpSkOwNm352ovcCqOQH_L9ct5vKkPSwKqGxdQWl99i4a0T6M-k6GAhZ0tlF6khpUFA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLlPpvOP4xtloFMNxLiSEE3ZRCyJGOxkzNUmbZh1urLg&oe=6ABA81B4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
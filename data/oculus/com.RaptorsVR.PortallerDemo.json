&_nc_oc=AdrO0OGcf_HY9WxNjYqsA1fBk57e9I7SWoh6llF1xiGctBf60Pry_OdjFBvn5UvReOE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFALs1H2kcaj8EDZ42FYsqqmTr7KjSvD9sUX95Bucr9ug&oe=6A7739F4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mfuBsaF95T0Q7kNvwGxq2aR&_nc_oc=AdrHZefLotzxKmPeLH6Sl7nT8PH3COvCpH4ZQJofWWHnj2wU5wNM0yxro-2DBgtnbqM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1S4EKnv5Egwfi3oH6oNSKAo2XiNqNW6PfGGbHkwNgIw&oe=6A7733F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MS6YjKZ_fMoQ7kNvwFjDvgh&_nc_oc=Adpq8yokt37dD4tOnmD7F1wS_FFCkuMv-XMlV6nYav7zt2q9keUhKSqV97ytj6aWr_I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5lFyY05LAPzjbbX9ZY0SfGgXYj3fCq9wB4jHuYc2HFw&oe=6A773A1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=18B5iMOvFV4Q7kNvwEIPdGg&_nc_oc=AdqHfSWyL-VvLEOOxWfz3ZCK-a5kvy7qhyLOnwEhaqZ72GqXlA3p8akgzWuBzVOIlLM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-ZYeNjxwhEg0SMzyCfL83QJ5nzC_sxt5Kf7rahtP7ow&oe=6A771BE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JAFKPU5cQPgQ7kNvwHT4gOt&_nc_oc=AdrE1DFL9iMuw0QcxJU8IuGhRYRzM9qjWPxQO-L06iAor_-6b-EHXdpYHsV6ztztfBo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfiAd-f1XufmswVVlN61rPg5Mvndca2lX3WsQzwM3XLg&oe=6A774534"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
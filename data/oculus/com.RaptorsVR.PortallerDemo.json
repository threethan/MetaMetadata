&_nc_oc=Adq8j_g4mbemgmH-9U6ZL0uwGez3cJz-DeD1a_VmyRKXC_ypQjIRDuWP2pEQnzoqe3U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM2B4BNh0bQ3nThXa-ShdbXYlnUPnhE9QtK5V_nWA_1Lg&oe=6AD23174"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tmBGvcm4wlQQ7kNvwGsmE76&_nc_oc=Ado68F7Pox8F9pSyB5S835l6_KamFLvS7hImek66cTxfFBsISNQjtFmCzuAztZANcMc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNM15fNUCskFy7lZhHlXbekjtP6s5xAdE2AJ9NhtZXqGw&oe=6AD22B71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_6haUt7h42UQ7kNvwFh6sCA&_nc_oc=AdqEOZlR99XM8w8lJ6slJumlFc4AjFBqqCG4omqdzqUTjDOrHUBhSQsL53Xec1YQhUk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOtaet6iP0YTvflgwpXOBeeKG7gBU0cD3vB1i7u9ic6eQ&oe=6AD2319A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WHIFNJKdb0kQ7kNvwHyeCc7&_nc_oc=AdqtWdwphb8tsg4bcyxobA7IVN4lqhjSZwSV3DWwLWvnHxEqMrYCbng6tQ36m0GGFnQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu2yXusXBOYlC6J65Y1wNpmRW1lAYKCYi2viNB3g1liw&oe=6AD24BA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pU1Y7O9iursQ7kNvwE3iZB5&_nc_oc=AdobjREfylwT3h0nnMKXU-nr2VPgyMxyKSMbMSUPRv4CYUBBnCR9De4IlJ0oKqvWS_g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOrZiLv5UUmhJluA3FxeUlUXSOzUi1MQdP3yjFbXE0KGQ&oe=6AD23CB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
&_nc_oc=AdpAF2Z-fuJAy6XmnbilrjovEAj1iESHc3Il90nVDyxgZY2HMpW0sIhnbRB-T3sB1C8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af33dUlIXkUL7hWX3y-NyTZmibuyBaCK4HsCG-6nZnG7sg&oe=69EE1DF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WsvSywv0YgYQ7kNvwF0tYVB&_nc_oc=Adqs2s9Xm9Rlz0tPEQNJa0sjJ7XOy3K-S_E5YkIe-3yi2GNXHazz1T4s1Po9LurQe5A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0hL7-lQm88eXLSLZ0AvnaHllMjrnN1fdL9tOh2fivIQg&oe=69EE17F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JJmufaQTjY4Q7kNvwHAofR-&_nc_oc=AdpOPp-ZPKYjHIGHe1iY18GeL1MZ6IkeXsHrVCjtlnvqOG2Zgi2pQz5VapEpRHuUlzY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2KueCQiG1PSdXGVliLJX3RxCrDtn1GlupIHvVi9di19g&oe=69EE1E1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NYe_9_j5fhAQ7kNvwFft-Qf&_nc_oc=AdpRuem3mGjPHMeSx6Lelaw3qIL8ulgDBwXlKmoqZ24P_gHvnAIIQEySDhcjVcXooFg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af05kpuZcgIzGnYHhWLHxobAZV9CL8t9LAjxjyS7Baui5w&oe=69EDFFE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0epOpHT0K5kQ7kNvwGYtFxJ&_nc_oc=AdooOJVeRJTI7X-VehmcgbLAXO2oi1YkP9DcGs2pa8hsr1pEllUvmNvDhuTVjyKspXM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3dCD7msWqf3CTDQ06vixutB6ErV0urUK30EfjmQbyBSw&oe=69EE2934"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
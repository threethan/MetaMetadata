&_nc_oc=AdpRiFh7IQ7wqOJLq2_duGliw8YOlJmjkB2UqZ7ts_z0VuYDa-UuVr5UhhV2pZjIzqA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCBdb2qNz1cCSpLEQGsowrSSGkrdQBEoVJDFFy6IfhnA&oe=69D11CF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQz0hrkiFhgQ7kNvwH9Kp_l&_nc_oc=AdpM7paXyNpO0UN0IIsO5nJoB-HSUxI_3mdxSsAJQeR3sBfw9SaqbWqXumTSJ5ywHSE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjlAJ9LaFqnAP2_xTglufrrhlbRRXyFSu4xqJXPMA5tw&oe=69D116F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tdrpzUNDG1MQ7kNvwFKX4Pl&_nc_oc=AdpwCNhLcksZqrKp6Pr6j4bY3NYeobo9qzM1nidmjwqhYyE1DF2iJ60b0yG2-KK9ejg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxjsqEo9__49Z3WIypRfj837d2AyUnMEr0NmO0S0lCyOw&oe=69D11D1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcW2tWsKmasQ7kNvwHphnyR&_nc_oc=Adrbl7hlnm8RMhlia6ehtLdrj7XAjyYzRxNnW8SKa2whzinZUOao71UCb82REznnf_w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjyfPO8qo2-K21652DUu__vuhU2rJbhaoa9I3MSGdLZA&oe=69D0FEE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iVPpIXTcNgQ7kNvwG3laEr&_nc_oc=AdpOt5i9VQHhYhVrawI5lqhLqQI6oQoLrJSDUTL5DHB5CTFk474IgPhsZiUGcutTB-0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz2kmYblFYTi4FHNHaQXR4dbjQmbQUMkFo86HVA8g7slA&oe=69D0EFF4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
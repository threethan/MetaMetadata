&_nc_oc=AdqK03lYPA9BBh5iE4AunPmrfZSV-bAepZ6oA9ekfeC9igkF5G-spJ7CF8EkgvMLKmI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDeuAlwVw8yLf6Mz1ijsQMpcdJ53utmyMZBnRroZPtvGA&oe=6A564474"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SjvUgVpG_cIQ7kNvwEEobEO&_nc_oc=AdqMF-iEo5xu0UFa1nFGY27AxZZEv6zHz0PhBXq8CykCTazd-TiyJpJYkOfG4aTPs5I&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3L3Vc5fLd-0MuhsUNrn_QYtQJrp65Hno7LXOGCSfgcA&oe=6A563E71"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lfnRR4U3HioQ7kNvwEkZAqR&_nc_oc=Adq4hT728aNpBvo3Wf0RiVe_dWZ0I8XjKh2IPLyedisTQfwXsdiFEpMTJSS6pqqQ1E0&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDdkL3huL5lUNThQrjRdCQsR8IPzlcL_KyvQSI26zmCVA&oe=6A56449A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zCgbNvwQc40Q7kNvwHVPDFs&_nc_oc=Adr5u7x6_o1sByfI8TIWmgbvXX6ooKsPv7CPA-p4YKf3GIsH2yehIFH194wdK6UvRxQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBBtHSQb1y6MzO8E2T61zWM-NJkJU0m4kePMa59TPUdlQ&oe=6A562663"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0v2oGCMsKusQ7kNvwFCMInE&_nc_oc=AdppfPgEpAgSgCA6gLummx-_flYn9buSIhTT_Do9JYUrsE6wDqshjkGc3-4bj1XCuZI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3mpD5WHajMsleml_pw6hh-NpEY7Q-yNUxKwC5kEQAFQ&oe=6A564FB4"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
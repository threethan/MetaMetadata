&_nc_oc=AdpLxJnxNDbSfZVZoEItQm5_e5s9Nvht6o2KlMxCpIF9G3Hx_Lrh_PbGICwA8Hk8-iA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4us276YIFnfzb1yC3zg55JG-8uu2Gd-NG9ZKrh5GSxWQ&oe=69FB4CF4"}, {"file_name": "migrated_image.png", "id": "616387445576361", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12427574_1371597466274598_7998219760833658880_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HVE3bJAq6WcQ7kNvwGxTd2-&_nc_oc=Adq9L3_0EfKBSSxTHkQQUsgMUus2IZDBEfPW9rKFA24tLaNX4JlMU288k_f2w_QNTpU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7irNlx8Rqw7vRtOeCCudkliS6KT84LeXCr8xu9cfo3_A&oe=69FB46F1"}, {"file_name": "migrated_image.png", "id": "546536159328490", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12533893_110014479879234_1298073579392335872_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxvTTxKLI48Q7kNvwEyMmTa&_nc_oc=AdqSiboSpoQNHpCT57Q1qC24bD5oU3rkNyyM24wkmu-FpuBZdBiJUA9ZtDD-ML6NA2E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XfwOzdS51x2gZ1kllrkkLXYoop1gPEB7ACe5U1Ur8Mw&oe=69FB4D1A"}, {"file_name": "migrated_image.png", "id": "230464991677652", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/12410441_2375362719356793_9037149861287297024_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SKDzeLChr3YQ7kNvwFLkmwU&_nc_oc=AdqzAYXELYlIGsWJsZvywvfLqZ83EY2tCnvddPNMKSvL5XhlXEc984GH6WWj5U69q7w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6d1cOK6WCKIRhV7SRji4ge1XU-y5KWZpu0xWrTEMp4Hg&oe=69FB2EE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440px.png", "id": "270918352690336", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031429_270918356023669_6941782260272540985_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNy90TuGgGkQ7kNvwE8GVmn&_nc_oc=AdomWtX10GMw7AYvEDZF3A5ISu-0YTWQ1Do7tjesuuJAkLgCTvJXjWQ8YSiGal6_8YI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qEy2bmiJ7Oloem5s6lA4LQc1NjC4AWeTxEbuWmyuH2w&oe=69FB5834"}, "display_name": "PortallerDemo", "keywords": ["shooter", "space", "scifi", "hard", "doom"], "long_description": "Zeldar\u2019s planet used to live in peace and prosperity. But the insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy.\nAll Zeldar\u2019s inhabitants are keeping their last strength, thanks to the shields, which create the core artificially, pumping out energy from the nearest stars. But time is running out and the artificial core gradually die ...\nThe core must be urgently returned so that the inhabitants of the whole planet do not perish!\nAnd you are the only one able to do itt! Miraculously, you managed to hack the enemy ship system! The portals are now open! But beware, the Carnagians are not going to back down! Return the life to your planet! Get to the portals of the ship\u2019s main reactor and get the core! The future of Zeldar depends on you!", "short_description": "Insidious Carnagians found their way and decided to conquer the universe at any cost. They took the most important, the core of the life of your planet, which filled all flesh with energy."}]}, "developer_name": "Yurii Kaplunov, Yevhenii Dekhtiar", "developer_privacy_policy_url": "https://raptorsreality.com/privacypolicy.html", "developer_terms_of_service_url": "https://raptorsreality.com/privacypolicy.html", "publisher_name": "Raptor's VR", "support_website_url": null, "website_url": "https://raptorsreality.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER", "SPACE_UNIVERSE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
7a0a&_nc_ohc=S4Nr0gxj-IYQ7kNvwHLsYxq&_nc_oc=AdrXHII5mZh29mGxhy8KYdV-3VtImGLANgMBqLrWECuPVLBr8F43tmIi2dBOVlJCCjs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHX3oyEwtFgz4wpnyVacDWsBy0_mi4BvmS8N6MOzVQQg&oe=6A95DDA1"}, {"file_name": "Prints4.png", "id": "1403462658366205", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499308050_1403462661699538_3287026660564174196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uY_vBgBEZZkQ7kNvwH9EbRn&_nc_oc=AdoIeXNhg7WIZXn_hl38EqbZcafQxNRfDliAAIRxJEPwCsmDCbZFO0G0YiCPIw8_i28&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGHfU-CJUOBwCAQByo70mMrY9a8_hkUyEJM4Q5wuT0eCw&oe=6A95B7F3"}, {"file_name": "Prints5.png", "id": "1035108015932317", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308699_1035108019265650_4234455384700684536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9yQ0LazKG1MQ7kNvwESxXYx&_nc_oc=Ado6RWU7iNG4f9YGvH_tg5z-pcJXmDQb6QBzuSM2tKcns-Iic6pzfIRES5AkDSVvQqs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExW2fuImtbdu3_4Snk-BcuRQ7gyaXL65LOZQ9ptfYSCg&oe=6A95CAE8"}, {"file_name": "Prints (2).png", "id": "1076996075000358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507840145_1076996078333691_8130946381337112298_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpYo5uBIQWAQ7kNvwGaEp1a&_nc_oc=AdpOV7UutnfHpW7s0gyEs-yzph8_iAW_bMxNCv7eaP8xAnP5oFVXscZgocNdsp7T4Co&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSk4JRQscVZxRnpvUf47lSq_esm_gVXAdq7Z5cyLB-fQ&oe=6A95B5AD"}, {"file_name": "VR-Vision-Kiosk-Screenshot-Settings-Corrected.png", "id": "1582599710049063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310731_1582599713382396_2364419666069612995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqBOx07YnjsQ7kNvwGQf1lV&_nc_oc=Adq80T8u5FG4c5euIEha-JOaA9eGBdzJvIIqIhLiye0a9m4vJAviPYKKLllODbgDOaw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQExbqslIxylTvLbHlptkXpgwdOm16Y3-Qcv0c2vNcFf6w&oe=6A95E5E8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Vision Kiosk Player", "keywords": [], "long_description": "# Professional immersive video playback for Meta Quest\n\n**VR Vision Kiosk Player** turns Meta Quest into a reliable 180\u00b0 and 360\u00b0 video station for events, exhibitions, training, museums, showrooms and branded experiences.\n\n## Kiosk workflow\n\n- Branded waiting screen, ready for the next participant\n- Start with a controller button, Volume Up or a thumbs-up gesture\n- Automatic return to the home screen after each session\n- Select one active video stored on the headset\u2014no playlist required\n- Persistent language, event ID, headset ID and tripod-cover settings\n- English and Brazilian Portuguese interface\n- On-controller diagnostics and playback progress for operators\n\n## Projection and file naming\n\nProjection is detected from the file name:\n\n- Add **`_360`** for 360\u00b0 video, for example `casa-02_360.mp4`\n- Add **`_180`** for 180\u00b0 video\n- Use `_SBS`, `_LR` or `_3DH` for side-by-side stereo\n- Use `_TB`, `_3DV` or `_OverUnder` for top-and-bottom stereo\n- Without a stereo marker, playback is monoscopic\n\n## Add your video\n\nCopy a compatible file to:\n\n`/sdcard/Android/data/com.vrvision.kisokplayervr/files/Videos/`\n\nOpen Settings from the left controller menu and choose the video that should always play.\n\n*Video content is not included. Compatibility depends on the codec and resolution supported by Meta Quest.*", "short_description": "A professional 180\u00b0 and 360\u00b0 video player for Meta Quest, designed for events, exhibitions, training and unattended kiosk experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrvision.com.br/politica-de-privacidade.html", "developer_terms_of_service_url": null, "publisher_name": "VR Vision", "support_website_url": "https://vrvision.com.br/contato_site/", "website_url": "https://vrvision.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28068440832760826"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1377381223775103"}, {"status": "PUBLISHED", "id": "1349004574041555"}]}, "baseline_offer": {"id": "1349004574041555"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1377381223775103"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28242512798686961", "version": "1.9.0"}, "id": "1014766844522811", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28068440806094162", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28242512798686961"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1014766844522811"}]}, "change_log": "Version 1.9.0: Added an official in-app video library picker, improved hand and controller interaction, a two-column settings menu, world-space interfaces, playback countdown, and kiosk customization improvements.", "created_date": 1786471901, "id": "28242512798686961", "version": "1.9.0"
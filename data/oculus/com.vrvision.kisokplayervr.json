x 1440px.png", "id": "1339083184572172", "image_type": "APP_IMG_COVER_LANDSCAPE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314660_1339083187905505_369250650765459061_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hnlbNJPiwKgQ7kNvwHoaMgo&_nc_oc=Adrz6ea8xrV4RHz--iWVYyK6Chdahh1ZSBzZEuCPW2oowHiXQGtXunH8nGNY9Cid_v4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLREy-k2SBbjh3cEEfal_LkQWUDeJYbG6XWbeA7DdzCHA&oe=6A9ED72E"}, {"file_name": "Meta-icone-novo.png", "id": "899010306604647", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593776279_899010309937980_6418098416228299179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TolmtExta6YQ7kNvwEO3GeR&_nc_oc=AdoPABx1C6TPN9MuWGUSzOLh1-HfE1jvrcrNPtKr34g7wAj76Di9dIXyZS-xNhvCLh8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwK9JULxL7KP4pcCBuZx3VnFmSX-ePt5O7MjHq9Xzs8g&oe=6A9ECA3D"}]}, "id": "1028618650156723", "locale": "en_US", "screenshots": [{"file_name": "print1.png", "id": "1276411521083166", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499311597_1276411524416499_5921528657757754989_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y6Q27j-vwp0Q7kNvwFyhjpQ&_nc_oc=AdqL_cQABrXhzcnKD5CIaksJqh-bGTbxnsxU-UjoIXnHbybcD4oEDXWViAN_pu-KyKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRC-TdyuxF0HsZlJ-djTvL_Eshk5uyHwpx9xMW3Dm7dQ&oe=6A9EDFE1"}, {"file_name": "Prints4.png", "id": "1403462658366205", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308050_1403462661699538_3287026660564174196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVPdRaFUFeoQ7kNvwFfbBc-&_nc_oc=AdrCSYWcajSX_9E7aa_Un0xKsCRuR6d52jYr7L52FTCjJQAYQVBJ5M9VkmUJkyN9SvA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2QvfXIbybljwCzVNHMAeFSvZ4mVM2-zUCmmpTSjvhdg&oe=6A9EBA33"}, {"file_name": "Prints5.png", "id": "1035108015932317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308699_1035108019265650_4234455384700684536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5-QoSA6rYkQ7kNvwHzyn1S&_nc_oc=AdptEIaDHPiE8MCEzDi1XC3BWYojdV6s5ZSUCIyptTw1DURUqZIyGCK06Q7CxpOrJR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq3OSTXKPsJPActGzNCkq2JIZ6m04pH1ljFILgwkt1cw&oe=6A9ECD28"}, {"file_name": "Prints (2).png", "id": "1076996075000358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507840145_1076996078333691_8130946381337112298_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKij6JtoYagQ7kNvwGhoT2t&_nc_oc=AdoXzyg1IHvJYXTriAjxb6_uY1J-P-9ro5B2-lG9ESh9iB_YMwNKsjJWi-9xgk8pQ10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo_6fwI6Ksw0rJUliIq-bC4AL7DEhnOZpEfwljK7BzYQ&oe=6A9EB7ED"}, {"file_name": "VR-Vision-Kiosk-Screenshot-Settings-Corrected.png", "id": "1582599710049063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1582599713382396_2364419666069612995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJGSlphv1nsQ7kNvwEkYbIC&_nc_oc=Adr-SX-VH2A_ocehw1QuIVyXTwL5iSZK4MQDizi9hXp82Tp9GLqaurnwpOp-ILu5F0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtdQZ0MW-U5NIqeeQiZMhGYL0uMx9WYaANL0tkS21BJQ&oe=6A9EAFE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Vision Kiosk Player", "keywords": [], "long_description": "# Professional immersive video playback for Meta Quest\n\n**VR Vision Kiosk Player** turns Meta Quest into a reliable 180\u00b0 and 360\u00b0 video station for events, exhibitions, training, museums, showrooms and branded experiences.\n\n## Kiosk workflow\n\n- Branded waiting screen, ready for the next participant\n- Start with a controller button, Volume Up or a thumbs-up gesture\n- Automatic return to the home screen after each session\n- Select one active video stored on the headset\u2014no playlist required\n- Persistent language, event ID, headset ID and tripod-cover settings\n- English and Brazilian Portuguese interface\n- On-controller diagnostics and playback progress for operators\n\n## Projection and file naming\n\nProjection is detected from the file name:\n\n- Add **`_360`** for 360\u00b0 video, for example `casa-02_360.mp4`\n- Add **`_180`** for 180\u00b0 video\n- Use `_SBS`, `_LR` or `_3DH` for side-by-side stereo\n- Use `_TB`, `_3DV` or `_OverUnder` for top-and-bottom stereo\n- Without a stereo marker, playback is monoscopic\n\n## Add your video\n\nCopy a compatible file to:\n\n`/sdcard/Android/data/com.vrvision.kisokplayervr/files/Videos/`\n\nOpen Settings from the left controller menu and choose the video that should always play.\n\n*Video content is not included. Compatibility depends on the codec and resolution supported by Meta Quest.*", "short_description": "A professional 180\u00b0 and 360\u00b0 video player for Meta Quest, designed for events, exhibitions, training and unattended kiosk experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrvision.com.br/politica-de-privacidade.html", "developer_terms_of_service_url": null, "publisher_name": "VR Vision", "support_website_url": "https://vrvision.com.br/contato_site/", "website_url": "https://vrvision.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28068440832760826"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308050_1777023629990198_6793121780676598508_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IqcGm8cqUNUQ7kNvwEULXHW&_nc_oc=AdrFourdKqZ7mRdUoiQOt37_Rv5avwKLXSqY4He35lmPBw_S9PbrM5jd55ZHRXwp6e8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKSAe2f6p8MqX_tt6CmhGrZYSt502f16mJm24Q0UfAqXA&oe=6A9EC47C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Vision Kiosk Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1787243280, "lastRevision": {"nodes": [{"id": "28068440862760823", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "28068440806094162", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1921239611865139"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2508593572937663", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Vision Kiosk Player", "keywords": [], "long_description": "# V\u00eddeos imersivos profissionais no Meta Quest\n\nO **VR Vision Kiosk Player** transforma o Meta Quest em uma esta\u00e7\u00e3o confi\u00e1vel para v\u00eddeos 180\u00b0 e 360\u00b0, criada para eventos, exposi\u00e7\u00f5es, treinamentos, museus, showrooms e experi\u00eancias de marca.\n\n## Fluxo em modo quiosque\n\n- Tela de espera personalizada, pronta para o pr\u00f3ximo participante\n- In\u00edcio pelo bot\u00e3o do controle, Volume + ou gesto de positivo\n- Retorno autom\u00e1tico \u00e0 tela inicial ap\u00f3s cada sess\u00e3o\n- Sele\u00e7\u00e3o de um \u00fanico v\u00eddeo ativo no headset, sem playlist\n- Configura\u00e7\u00f5es persistentes de idioma, ID do evento, ID do headset e cobertura do trip\u00e9\n- Interface em ingl\u00eas e portugu\u00eas do Brasil\n- Diagn\u00f3stico e progresso no controle para a equipe do evento\n\n## Proje\u00e7\u00e3o e nome do arquivo\n\nA proje\u00e7\u00e3o \u00e9 detectada pelo nome:\n\n- Adicione **`_360`** para v\u00eddeo 360\u00b0, por exemplo `casa-02_360.mp4`\n- Adicione **`_180`** para v\u00eddeo 180\u00b0\n- Use `_SBS`, `_LR` ou `_3DH` para est\u00e9reo lado a lado\n- Use `_TB`, `_3DV` ou `_OverUnder` para est\u00e9reo superior e inferior\n- Sem marcador est\u00e9reo, o v\u00eddeo \u00e9 reproduzido em modo monosc\u00f3pico\n\n## Adicione seu v\u00eddeo\n\nCopie um arquivo compat\u00edvel para:\n\n`/sdcard/Android/data/com.vrvision.kisokplayervr/files/Videos/`\n\nAbra as Configura\u00e7\u00f5es pelo menu do controle esquerdo e escolha o v\u00eddeo que dever\u00e1 ser reproduzido.\n\n*O v\u00eddeo n\u00e3o est\u00e1 inclu\u00eddo. A compatibilidade depende do codec e da resolu\u00e7\u00e3o aceitos pelo Meta Quest.*", "short_description": "Player profissional de v\u00eddeos 180\u00b0 e 360\u00b0 para Meta Quest, criado para eventos, exposi\u00e7\u00f5es, treinamentos e experi\u00eancias em modo quiosque."}, {"images": {"nodes": [{"file_name": "Meta-icone-novo.png", "id": "37691423030471092", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310646_37691423070471088_5349673270830492937_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DO1vELuKcOQQ7kNvwEAibFX&_nc_oc=AdrDVl0g-7r4oBQ_hJ_x-XCL6T81itEgepJ_f4DgHGDNXlQ2Ow74Q0Ll7bnczi3fP-U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJJ3_MFSv4YsZzYigjA8dwIJpaItc88kfHn9OQKKPHH_Q&oe=6A9EC555"}, {"file_name": "Kiosk - Hero Cover _ - 3000 x 900px (32-Bit PNG).png", "id": "4663594827202928", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499293825_4663594830536261_7121342605201416589_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&
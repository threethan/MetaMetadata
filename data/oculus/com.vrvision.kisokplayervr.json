"1069784689186624", "image_type": "APP_IMG_LAYERED_ICON", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/595119480_1069784692519957_6796666747244139367_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZlL6rwuiTAQ7kNvwG5loDA&_nc_oc=AdqQTB8zTqVoyhgyVPAWutLXOUj0JaI3469q0gA1qT2s9NdwVlRnMFkgmcutS6xwoKU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSQEPD8oES0GIFVETGZk37Dkl1ESTarDPw5De4HwxCyA&oe=6AA965FA"}, {"file_name": "Meta-icone-novo.png", "id": "899010306604647", "image_type": "APP_IMG_ICON_FOREGROUND", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/593776279_899010309937980_6418098416228299179_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZLIWMxiLavsQ7kNvwHNsJgP&_nc_oc=AdoN7JXXCShMFVLq3ZWFnJC-aKDppQDb--amU6cYYGPlLUeK_HrAWSPwf1oicgG2Pl4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUC7D1OtXrW6MlzOaAUQPk-QXQjZVQm_Qqp_LffEdhNg&oe=6AA9563D"}]}, "id": "1772831567351082", "locale": "en_US", "screenshots": [{"file_name": "05-Importar-video.png", "id": "4631877893804181", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/604366035_4631877897137514_6938117853099422484_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DXl6L1P0nUQ7kNvwGyLqtz&_nc_oc=Adop3FIpIk-QBsJu57ZFYEZFQlMMQQ_EUCI41oAoihirqzD7oi7Rx6P_DJNc_b_DZH0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn9uD8TWTJt3_NA0VY4Ww8oXokORhMpjmJaQmerwd9mQ&oe=6AA9671F"}, {"file_name": "02-Configuracoes.png", "id": "1088691987426854", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491831279_1088691990760187_5191848967938064554_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQfPVhv93JgQ7kNvwGwf8PX&_nc_oc=AdrQZBadPLpqIBkgbm-8i_7WTmv97NJFX1cqafEQuLfMC8psmyPgDRJayC5B-uxIg64&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSCx916t6TRawWIRtvT-KeidCIt-Fd3MQ03C9bwAJNXQ&oe=6AA94998"}, {"file_name": "01-Home.png", "id": "1383572856658052", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/673751957_1383572859991385_2133347007759186769_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mnRMtJ_bTmsQ7kNvwGjHEVt&_nc_oc=AdorJP3zxPbAVxXYGvjo7Pioc1O903W16JDPEIt8ud0gi3I-Bum25m0ct8q149TVo-I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6HvNeG_wcSoEy4ic60q7pJE_wm62MdG-zS6A2jT-yhw&oe=6AA94C5B"}, {"file_name": "04-Contagem-inicial.png", "id": "1795029231521594", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/673652249_1795029234854927_8936538694905330180_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UHhsEAhEo5UQ7kNvwFucKUq&_nc_oc=AdoqaEJ72UlIfDf9EhrbDNdxpqpo2qspdY-xWRP8BRqbOKRxXSFy5HOpG6OPTk9DjZY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwTDT_0vRGZwQSfAOk8tN7BVcjQEKkNorhrjCktcXD7A&oe=6AA964B5"}, {"file_name": "Kiosk-Player-Screenshot-Video-Controls-2560x1440.png", "id": "2280054776088583", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/604370996_2280054779421916_5926351415945882500_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xnvVT8808YQ7kNvwG6DiBn&_nc_oc=Adpv2NO-9no1ZRnB0e2WUlvqNFZQWyj5scGAWSspRHCaDRmgc7KcPKFiKgRlRjH_KtE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKLrSqi-eN5bzimI4Aji8uBjW2Ib_XRer6vpz4wsJMmvQ&oe=6AA94784"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Kiosk-Landscape-2560x1440.png", "id": "1114279841258685", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491830822_1114279844592018_7140375758495843235_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eq6bJKSFo9MQ7kNvwEuLN_n&_nc_oc=Adr6vVDgvu1eK-oVZr27gNu102JtvYQmXpCEbeMCtSL9T4X7QTlkdsMUm3NIg72XphQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIvH1wWKfr4IDBijmewp0TR-KIZUewDPliVhjKxkcii7Q&oe=6AA94DE9"}, "display_name": "VR Vision Kiosk Player", "keywords": [], "long_description": "Immersive video playback for Meta Quest\n\nVR Vision Kiosk Player turns Meta Quest into a reliable local 180 and 360 video player for events, exhibitions, training, museums, showrooms and branded experiences.\n\nDesigned for reliable offline operation\n\n- Videos are stored locally on the headset, so playback does not require an internet connection\n- Start playback with the headset Volume Up button\n- Branded waiting screen, ready for the next participant\n- Automatic return to the home screen after every session\n- One selected video keeps the experience focused and consistent\n- Persistent language, event ID, headset ID and tripod-cover settings\n- English and Brazilian Portuguese interface\n- On-controller diagnostics and playback progress for operators\n\nProjection and file naming\n\nProjection is detected from the file name:\n\n- Add _360 for 360 video, for example casa-02_360.mp4\n- Add _180 for 180 video\n- Use _SBS, _LR or _3DH for side-by-side stereo\n- Use _TB, _3DV or _OverUnder for top-and-bottom stereo\n- Without a stereo marker, playback is monoscopic\n\nAdd your video\n\nCopy a compatible file to /sdcard/Android/data/com.vrvision.kisokplayervr/files/Videos/\n\nOpen Settings from the left controller menu and choose the video that should always play.\n\nVideo content is not included. Compatibility depends on the codec and resolution supported by Meta Quest.", "short_description": "A reliable offline 180 and 360 video player for Meta Quest, built for events, exhibitions, training and unattended kiosk experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrvision.com.br/politica-de-privacidade.html", "developer_terms_of_service_url": null, "publisher_name": "VR Vision", "support_website_url": "https://vrvision.com.br/contato_site/", "website_url": "https://vrvision.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28617318147873089"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499308050_1777023629990198_6793121780676598508_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQlaCm2d4KIQ7kNvwGjk-fG&_nc_oc=AdqCtjvD8fG9d-YsI_HiuNyu9nJeYHqLdkJJLpzFTiRr0IEU3HaPEDTMTvOTm5TXScE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPIc0dLmhku8E4fAhIx0523dl_v-lMeVoicbvK0MRI-g&oe=6AA9507C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "VR Vision Kiosk Player", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1787243280, "lastRevision": {"nodes": [{"id": "28068440862760823", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "28068440806094162", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1921239611865139"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2508593572937663", "locale": "pt_BR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Vision Kiosk Player", "keywords": [], "long_description": "# V\u00eddeos imersivos profissionais no Meta Quest\n\nO **VR Vision Kiosk Player** transforma o Meta Quest em uma esta\u00e7\u00e3o confi\u00e1vel para v\u00eddeos 180\u00b0 e 360\u00b0, criada para eventos, exposi\u00e7\u00f5es, treinamentos, museus, showrooms e experi\u00eancias de marca.\n\n## Fluxo em modo quiosque\n\n- Tela de espera personalizada, pronta para o pr\u00f3ximo participante\n- In\u00edcio pelo bot\u00e3o do controle, Volume + ou gesto de positivo\n- Retorno autom\u00e1tico \u00e0 tela inicial ap\u00f3s cada sess\u00e3o\n- Sele\u00e7\u00e3o de um \u00fanico v\u00eddeo ativo no headset, sem playlist\n- Configura\u00e7\u00f5es persistentes de idioma, ID do evento, ID do headset e cobertura do trip\u00e9\n- Interface em ingl\u00eas e portugu\u00eas do Brasil\n- Diagn\u00f3stico e progresso no controle para a equipe do evento\n\n## Proje\u00e7\u00e3o e nome do arquivo\n\nA proje\u00e7\u00e3o \u00e9 detectada pelo nome:\n\n- Adicione **`_360`** para v\u00eddeo 360\u00b0, por exemplo `casa-02_360.mp4`\n- Adicione **`_180`** para v\u00eddeo 180\u00b0\n- Use `_SBS`, `_LR` ou `_3DH` para est\u00e9reo lado a lado\n- Use `_TB`, `_3DV` ou `_OverUnder` para est\u00e9reo superior e inferior\n- Sem marcador est\u00e9reo, o v\u00eddeo \u00e9 reproduzido em modo monosc\u00f3pico\n\n## Adicione seu v\u00eddeo\n\nCopie um arquivo compat\u00edvel para:\n\n`/sdcard/Android/data/com.vrvision.kisokplayervr/files/Videos/`\n\nAbra as Configura\u00e7\u00f5es pelo menu do controle esquerdo e escolha o v\u00eddeo que dever\u00e1 ser reproduzido.\n\n*O v\u00eddeo n\u00e3o est\u00e1 inclu\u00eddo. A compatibilidade depende do codec e da resolu\u00e7\u00e3o aceitos pelo Meta Quest.*", "short_description": "Player profissional de v\u00eddeos 180\u00b0 e 360\u00b0 para Meta Quest, criado para eventos, exposi\u00e7\u00f5es, treinamentos e experi\u00eancias em modo quiosque."}, {"images": {"nodes": [{"file_name": "Meta-icone-novo.png", "id": "37691423030471092", "image_type": "APP_IMG_ICON_BACKGROUND", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499310646_37691423070471088_5349673270830492937_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tRpAFNyZh-gQ7kNvwHSiqXH&_nc_oc=AdrMmW0-MmSOR-nMaAWD9HytQliPD76UfdV0S5dkyf-eo7Msl5BGfLGUuftjfSeK_jQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6v-Kc6iRcwMm5iQpbsRgQ9D3DF6bQRSnavSswio8uJw&oe=6AA95155"}, {"file_name": "Kiosk - Hero Cover _ - 3000 x 900px (32-Bit PNG).png", "id": "4663594827202928", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499293825_4663594830536261_7121342605201416589_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-D5PU84r2EcQ7kNvwGRJGnc&_nc_oc=Adq6WsU8fLWSO_eksp9QF7Zb1l-TIFFL50TcBIQgKp_Eq8blYZPqBa7kS_EqFSd4pgI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLINkn6RUnkltf3cP6uz7uLI-a3xPiFmVtKWmNZx9B0ow&oe=6AA964D3"}, {"file_name": "icone-lioskvr.png", "id": "2401142277046021", "image_type": "APP_IMG_ICON", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499312454_2401142280379354_1564528515856864418_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zLAfkEKPP2QQ7kNvwG76r_G&_nc_oc=Adprah5uZjxAV6RX0p_S6S_2O0chU8P_i1-yuU4mNQQ2aCodO8oD6Q2R_EJ2ETst61s&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQ66MILl9FqUo2VGMKxKBYbSqyh9aFJaVizW9oa97uYg&oe=6AA95F0F"}, {"file_name": "Kiosk - cover Meta MQDH (1008\u00a0\u00d7\u00a01440\u00a0px).png", "id": "1777130906812494", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499312310_1777130916812493_4063265332251125560_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c1f8CSrsTOcQ7kNvwHTx88Z&_nc_oc=AdqKMglhOY98fU9_BdTlSHfQKm9b5n4sOXcDqZ-KVnnFc434ArO4mboUoWwRIJSGSjI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQmS-CcP5hTu84WjUlxNhVgpWMJCDdF4rFPSRBvTad3A&oe=6AA95811"}, {"file_name": "kiosk -cover Meta MQDH (1440\u00a0\u00d7\u00a01440\u00a0px).png", "id": "1777023626656865", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499308050_1777023629990198_6793121780676598508_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0
7a0a&_nc_ohc=y6Q27j-vwp0Q7kNvwFyhjpQ&_nc_oc=AdqL_cQABrXhzcnKD5CIaksJqh-bGTbxnsxU-UjoIXnHbybcD4oEDXWViAN_pu-KyKU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRC-TdyuxF0HsZlJ-djTvL_Eshk5uyHwpx9xMW3Dm7dQ&oe=6A9EDFE1"}, {"file_name": "Prints4.png", "id": "1403462658366205", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499308050_1403462661699538_3287026660564174196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVPdRaFUFeoQ7kNvwFfbBc-&_nc_oc=AdrCSYWcajSX_9E7aa_Un0xKsCRuR6d52jYr7L52FTCjJQAYQVBJ5M9VkmUJkyN9SvA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL2QvfXIbybljwCzVNHMAeFSvZ4mVM2-zUCmmpTSjvhdg&oe=6A9EBA33"}, {"file_name": "Prints5.png", "id": "1035108015932317", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308699_1035108019265650_4234455384700684536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5-QoSA6rYkQ7kNvwHzyn1S&_nc_oc=AdptEIaDHPiE8MCEzDi1XC3BWYojdV6s5ZSUCIyptTw1DURUqZIyGCK06Q7CxpOrJR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJq3OSTXKPsJPActGzNCkq2JIZ6m04pH1ljFILgwkt1cw&oe=6A9ECD28"}, {"file_name": "Prints (2).png", "id": "1076996075000358", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/507840145_1076996078333691_8130946381337112298_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKij6JtoYagQ7kNvwGhoT2t&_nc_oc=AdoXzyg1IHvJYXTriAjxb6_uY1J-P-9ro5B2-lG9ESh9iB_YMwNKsjJWi-9xgk8pQ10&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIo_6fwI6Ksw0rJUliIq-bC4AL7DEhnOZpEfwljK7BzYQ&oe=6A9EB7ED"}, {"file_name": "VR-Vision-Kiosk-Screenshot-Settings-Corrected.png", "id": "1582599710049063", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310731_1582599713382396_2364419666069612995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZJGSlphv1nsQ7kNvwEkYbIC&_nc_oc=Adr-SX-VH2A_ocehw1QuIVyXTwL5iSZK4MQDizi9hXp82Tp9GLqaurnwpOp-ILu5F0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLtdQZ0MW-U5NIqeeQiZMhGYL0uMx9WYaANL0tkS21BJQ&oe=6A9EAFE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Vision Kiosk Player", "keywords": [], "long_description": "# Professional immersive video playback for Meta Quest\n\n**VR Vision Kiosk Player** turns Meta Quest into a reliable 180\u00b0 and 360\u00b0 video station for events, exhibitions, training, museums, showrooms and branded experiences.\n\n## Kiosk workflow\n\n- Branded waiting screen, ready for the next participant\n- Start with a controller button, Volume Up or a thumbs-up gesture\n- Automatic return to the home screen after each session\n- Select one active video stored on the headset\u2014no playlist required\n- Persistent language, event ID, headset ID and tripod-cover settings\n- English and Brazilian Portuguese interface\n- On-controller diagnostics and playback progress for operators\n\n## Projection and file naming\n\nProjection is detected from the file name:\n\n- Add **`_360`** for 360\u00b0 video, for example `casa-02_360.mp4`\n- Add **`_180`** for 180\u00b0 video\n- Use `_SBS`, `_LR` or `_3DH` for side-by-side stereo\n- Use `_TB`, `_3DV` or `_OverUnder` for top-and-bottom stereo\n- Without a stereo marker, playback is monoscopic\n\n## Add your video\n\nCopy a compatible file to:\n\n`/sdcard/Android/data/com.vrvision.kisokplayervr/files/Videos/`\n\nOpen Settings from the left controller menu and choose the video that should always play.\n\n*Video content is not included. Compatibility depends on the codec and resolution supported by Meta Quest.*", "short_description": "A professional 180\u00b0 and 360\u00b0 video player for Meta Quest, designed for events, exhibitions, training and unattended kiosk experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrvision.com.br/politica-de-privacidade.html", "developer_terms_of_service_url": null, "publisher_name": "VR Vision", "support_website_url": "https://vrvision.com.br/contato_site/", "website_url": "https://vrvision.com.
sQ7kNvwHNsJgP&_nc_oc=AdoN7JXXCShMFVLq3ZWFnJC-aKDppQDb--amU6cYYGPlLUeK_HrAWSPwf1oicgG2Pl4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUC7D1OtXrW6MlzOaAUQPk-QXQjZVQm_Qqp_LffEdhNg&oe=6AA9563D"}]}, "id": "1028618650156723", "locale": "en_US", "screenshots": [{"file_name": "print1.png", "id": "1276411521083166", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499311597_1276411524416499_5921528657757754989_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hcV25VddEkQ7kNvwFku4j3&_nc_oc=AdqpNfRmZDyjCfbYZ42oQiaBuHQmgsqeXu4DfpwMGwbsr3WeL3wGIMjDHZpXrStvPRA&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSyEptjZcwLHdUWDhxFaYlveVH7wiRvC4kAl-Fi-fMfQ&oe=6AA96BE1"}, {"file_name": "Prints4.png", "id": "1403462658366205", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499308050_1403462661699538_3287026660564174196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z0ZZgz_i2ScQ7kNvwFoGNgu&_nc_oc=Adq0BsonANoSqWCupRgFVukOPuyKXtXRoch5aPyssnlrawF06YOHpOlH_Bt1JNj9skY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcqzNXXhKdQE3Ofl4Bnpw6_KEoN3Ksj4LRPDYwQE1jZg&oe=6AA94633"}, {"file_name": "Prints5.png", "id": "1035108015932317", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499308699_1035108019265650_4234455384700684536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bgi0qLj7oYAQ7kNvwEAoKSu&_nc_oc=Adp2TPbtpqKhHPQA6iE24dUWbOmroI4Xy9aTmiEzO6RVYSAbvL6DvAC4Vfy6j_WReCg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJQY606L7Rsy4P4-VhwR2r4tg7hsjfiKLjFDi6mME6jAg&oe=6AA95928"}, {"file_name": "Prints (2).png", "id": "1076996075000358", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/507840145_1076996078333691_8130946381337112298_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wHv9HL44JcQ7kNvwFvbsuo&_nc_oc=AdovffuKCG9LGFtdJGK6x1y2IWjH39H2mhh3GwjT-QWlph1ZZ6ob8FDdJA4niKi39CU&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU92FKhH1Ipb_k4pP6tRg6v7b1kLwe7RFNsVsTylfN-g&oe=6AA943ED"}, {"file_name": "VR-Vision-Kiosk-Screenshot-Settings-Corrected.png", "id": "1582599710049063", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499310731_1582599713382396_2364419666069612995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AH2-9YmRLwQ7kNvwETBlJs&_nc_oc=Adou4FyKofmLn-rm1An-ZgP2-fnkEE9YIOJJZv95lUa6CPdeJkaaqG_WzniGy6gNcl8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIE3l9h9RF0LbJErOb8a6GiGj3jcG6YlrBZ_VFxt7qFvQ&oe=6AA93BE8"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Vision Kiosk Player", "keywords": [], "long_description": "# Professional immersive video playback for Meta Quest\n\n**VR Vision Kiosk Player** turns Meta Quest into a reliable 180\u00b0 and 360\u00b0 video station for events, exhibitions, training, museums, showrooms and branded experiences.\n\n## Kiosk workflow\n\n- Branded waiting screen, ready for the next participant\n- Start with a controller button, Volume Up or a thumbs-up gesture\n- Automatic return to the home screen after each session\n- Select one active video stored on the headset\u2014no playlist required\n- Persistent language, event ID, headset ID and tripod-cover settings\n- English and Brazilian Portuguese interface\n- On-controller diagnostics and playback progress for operators\n\n## Projection and file naming\n\nProjection is detected from the file name:\n\n- Add **`_360`** for 360\u00b0 video, for example `casa-02_360.mp4`\n- Add **`_180`** for 180\u00b0 video\n- Use `_SBS`, `_LR` or `_3DH` for side-by-side stereo\n- Use `_TB`, `_3DV` or `_OverUnder` for top-and-bottom stereo\n- Without a stereo marker, playback is monoscopic\n\n## Add your video\n\nCopy a compatible file to:\n\n`/sdcard/Android/data/com.vrvision.kisokplayervr/files/Videos/`\n\nOpen Settings from the left controller menu and choose the video that should always play.\n\n*Video content is not included. Compatibility depends on the codec and resolution supported by Meta Quest.*", "short_description": "A professional 180\u00b0 and 360\u00b0 video player for Meta Quest, designed for events, exhibitions, training and unattended kiosk experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrvision.com.br/politica-de-privacidade.html", "developer_terms_of_service_url": null, "publisher_name": "VR Vision", "support_website_url": "https://vrvision.com.br/contato_site/", "website_url": "https://vrvision.com.br/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "pt_BR"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28068440832760826"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1366516411849567"}, {"status": "PUBLISHED", "id": "1377381223775103"}, {"status": "PUBLISHED", "id": "1349004574041555"}]}, "baseline_offer": {"id": "1349004574041555"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "1366516411849567"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28613390631599174", "version": "1.13.4"}, "id": "1014766844522811", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28068440806094162", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28613390631599174"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1014766844522811"}]}, "change_log": "VR Vision Kiosk Player 1.13.4 (Build 44) \u2014 V5\r\nRedesigned compact home screen with a centered logo, prominent Play button and clearer Remote status. Improved settings layout and closer menus. Updated video controls with progress, Pause/Resume and Stop. The left-hand menu gesture opens video controls without pausing playback. Improved hand/controller navigation and headset resume handling. Local videos and saved configuration are preserved.", "created_date": 1788957563, "id": "28613390631599174", "version": "1.13.4", "version_code": 44, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "28068440806094162", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28613390631599174"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1014766844522811"}]}, "change_log": "VR Vision Kiosk Player \u2014 Version 1.11.2 (Build 34)\r\n\r\nThis update addresses the navigation issues reported under VRC.Quest.Functional.3:\r\n- Corrected hand-pointer positioning and button selection.\r\n- Improved switching between hand tracking and Touch controllers.\r\n- Made video import, playback start and Settings accessible from the home screen.\r\n- Improved connection recovery after headset suspension and rejection of stale commands.\r\n\r\nTesting instructions: No account is required. The app uses user-provided videos. When no video is available, select BROWSE 360 VIDEO LIBRARY 
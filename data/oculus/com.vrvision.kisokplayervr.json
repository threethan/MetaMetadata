7a0a&_nc_ohc=q_8kv-ZCoDMQ7kNvwHTFO0u&_nc_oc=AdqZjBOOZkAyCUgJ_x9rkxLtZk5apdEpCqMzqyqIR8P6nnPwEzL7SyY4KkXdOmVo1tI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeDmD5aoGntfbTCorn5e4sL4eNriw-AkLh6g23VdMnlg&oe=6A9999E1"}, {"file_name": "Prints4.png", "id": "1403462658366205", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308050_1403462661699538_3287026660564174196_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nJEJLWPElkcQ7kNvwHgVVGv&_nc_oc=AdpcTPIOKlaMprlkfDh6J0BCX2hwEdNUE9jtpIlbs5bfy0M3AP912Q-Krqfj6U9Pp5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGxYhQvI5Cz5_-XtbDxlTtmWZkh-CZWg4wmBSXZYkI0g&oe=6A997433"}, {"file_name": "Prints5.png", "id": "1035108015932317", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499308699_1035108019265650_4234455384700684536_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJDt84x3W_QQ7kNvwGUCBcX&_nc_oc=AdrK9v77qS5F0T9H4JzSgeTt7qUZn_I02TZxtqW-IVS48bdag9aBwJjDRTqqTjwAxUQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJibeRsxzp6XBEsEI1-oRVJ-l95liHnP67lHCpPdAnh6w&oe=6A998728"}, {"file_name": "Prints (2).png", "id": "1076996075000358", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507840145_1076996078333691_8130946381337112298_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=445O0G6MkPoQ7kNvwHKO6_a&_nc_oc=AdqlRmmerFHwEOOtXg4FyUwcexg6Ofv6hqZtiwUbAsEeEcReodaM3LFRurFvofnflh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKUyuCiL7_ZuFprpCwsgumh9UJBBecbNmjl_C7cOhgsUQ&oe=6A9971ED"}, {"file_name": "VR-Vision-Kiosk-Screenshot-Settings-Corrected.png", "id": "1582599710049063", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310731_1582599713382396_2364419666069612995_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o1pPA99vvMQ7kNvwHSQ7js&_nc_oc=AdqAoYciy9AGVEAShwKLGDVQHCKUxywEdGwICIL3TlEcH9bQIYj15vzXENdACTvNITc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbGTlVDKNgNaTcH2SL15EmrxfzXcg69y_r2aBqkX8xMg&oe=6A99A228"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VR Vision Kiosk Player", "keywords": [], "long_description": "# Professional immersive video playback for Meta Quest\n\n**VR Vision Kiosk Player** turns Meta Quest into a reliable 180\u00b0 and 360\u00b0 video station for events, exhibitions, training, museums, showrooms and branded experiences.\n\n## Kiosk workflow\n\n- Branded waiting screen, ready for the next participant\n- Start with a controller button, Volume Up or a thumbs-up gesture\n- Automatic return to the home screen after each session\n- Select one active video stored on the headset\u2014no playlist required\n- Persistent language, event ID, headset ID and tripod-cover settings\n- English and Brazilian Portuguese interface\n- On-controller diagnostics and playback progress for operators\n\n## Projection and file naming\n\nProjection is detected from the file name:\n\n- Add **`_360`** for 360\u00b0 video, for example `casa-02_360.mp4`\n- Add **`_180`** for 180\u00b0 video\n- Use `_SBS`, `_LR` or `_3DH` for side-by-side stereo\n- Use `_TB`, `_3DV` or `_OverUnder` for top-and-bottom stereo\n- Without a stereo marker, playback is monoscopic\n\n## Add your video\n\nCopy a compatible file to:\n\n`/sdcard/Android/data/com.vrvision.kisokplayervr/files/Videos/`\n\nOpen Settings from the left controller menu and choose the video that should always play.\n\n*Video content is not included. Compatibility depends on the codec and resolution supported by Meta Quest.*", "short_description": "A professional 180\u00b0 and 360\u00b0 video player for Meta Quest, designed for events, exhibitions, training and unattended kiosk experiences."}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrvision.com.br/politica-de-privacidade.html", "developer_terms_of_service_url": null, "publisher_name": "VR Vision", "support_website_url": "https://vrvision.com.br/contato_site/", "website_url": "https://vrvision.com.
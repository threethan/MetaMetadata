11E2JwaXxvKsAjKTPV2WQi-EZMQAr5M6P4O5jC2ydx2c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSX7Hb1wohwyoGJaAuHFsPLefJkYqkS26DxiaB_k3BuEA&oe=6AFDCA44"}, "display_name": "Shinobi Breaker", "keywords": ["action", "diet", "fitness", "calories", "classic"], "long_description": "ShinobiBreaker is the next generation of the classic brick breaker + action game in VR adapted to Virtual Reality!\nIn this game, immersed in a geometrical cosmic atmosphere, accept the quest as a space ninja and defeat monsters that bring harms to the universe.\n\nTo battle and overcome what your opponent will throw at you, use your weapons to slash through the enemy bullets and return their fire by sending your power shurikens straight to their blocks!\n\nIn this highly re-playable game; improve your score on every run by optimizing your unlocked skills and use of different weapons, and aiming to the weak points of enemy monsters.", "short_description": "Hit the shurikens, break the bricks, get ultra instinct and become... The ShinobiBreaker."}]}, "developer_name": "Donuts.Co.Ltd", "developer_privacy_policy_url": "https://www.donuts.ne.jp/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Donuts.Co.Ltd", "support_website_url": null, "website_url": "https://www.donutsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USE
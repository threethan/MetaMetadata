w-NkfGbym4zsDkUZnT5V06mKlrA&oe=6A58E660"}, {"file_name": "10.v4.png", "id": "383798632971452", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/39031529_383798636304785_2021281812685023729_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gmHjV04F8UIQ7kNvwHqut0b&_nc_oc=AdqY_BJ9i79-CT3JdNuVfW91d5tH8HAjOJ5lQV-zryIEOZRNw-xhk5ctQMPSbuq9TFE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDtR_JCiJdQv_HiXfPayvsaE5kMnW-NXoa1qBxcfoAv0Q&oe=6A58E51E"}, {"file_name": "8.v4.png", "id": "343542636937687", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974879_343542640271020_2026056982066219531_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Mi2GzZ0S-EQ7kNvwFH4bDR&_nc_oc=AdpXSD8CMPQk1H190cEDVu6fnIJjuObkKbgrTTwP1Blj9Dhbkm5vFiv4W8MX1ZZYPfI&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDei9SKVPq3YVq03vZ6AkazDxe0HVVVqQk_ioZD78UCeg&oe=6A58C4F2"}, {"file_name": "12.v4.png", "id": "352787729133780", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036666_352787732467113_1656587751106080319_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DjWxlr9gBqsQ7kNvwFxjDKr&_nc_oc=AdryI_h8nOzEM0JfQq0LTmf_YaFCNyJ1A53FtbQvztx4Af0YWgHnqs0Dd6xQPyCeVqQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9XSZpBT-6I0r8nRYhmX1LRr5qmBG5DPPp_tjN33m5Lg&oe=6A58E769"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ShinBreak_Landscape.png", "id": "273601214105605", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39035354_273601217438938_566749196331230402_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ahsJljnudLMQ7kNvwFiT93I&_nc_oc=Adqzck0m7ibs1562tXMPBkkfHyb0rFLMag_mdmJWKVDCpnL0V3tALSSrVir34LwQiQI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDziWWEb-ysNWCL1QVoHDgk9EjiIZolZzWK9yy-ScJAyA&oe=6A58C684"}, "display_name": "Shinobi Breaker", "keywords": ["action", "diet", "fitness", "calories", "classic"], "long_description": "ShinobiBreaker is the next generation of the classic brick breaker + action game in VR adapted to Virtual Reality!\nIn this game, immersed in a geometrical cosmic atmosphere, accept the quest as a space ninja and defeat monsters that bring harms to the universe.\n\nTo battle and overcome what your opponent will throw at you, use your weapons to slash through the enemy bullets and return their fire by sending your power shurikens straight to their blocks!\n\nIn this highly re-playable game; improve your score on every run by optimizing your unlocked skills and use of different weapons, and aiming to the weak points of enemy monsters.", "short_description": "Hit the shurikens, break the bricks, get ultra instinct and become... The ShinobiBreaker."}]}, "developer_name": "Donuts.Co.Ltd", "developer_privacy_policy_url": "https://www.donuts.ne.jp/privacy/", "developer_terms_of_service_url": null, "publisher_name": "Donuts.Co.Ltd", "support_website_url": null, "website_url": "https://www.donutsvr.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "RPG", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1864257757103357"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39035425_669146430644624_3464696786091526396_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uk78kmKkN94Q7kNvwHP2nl5&_nc_oc=AdrDQ6Y_O9XaRN6pGlGJslD3A8kfzpGOrpJV2lkeHqhRK7HQ92b
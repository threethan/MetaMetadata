845754432860_2836148457885290370_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwAL9rDpcS8Q7kNvwHUU5zW&_nc_oc=Adp6LKvO_gPmKDjR6TxvmPR2ZceqJE7mNzb8kk9FUxhxQ8R3NVYflwYmu1rmScApvPs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzczW783IftmrlVafHKx2eMUcfenypxHM6FNLyifBy3Vg&oe=69C51DB8"}, {"file_name": "Screenshot_1.png", "id": "1625809768383320", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499618297_1625809771716653_8922082133443755887_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmIoWw_OvQsQ7kNvwHRCzbY&_nc_oc=AdqMwcqlCDE4QCxsJjGUmvFBZewTLgURhygbup-MCxRKu1zvxOyWX1r7Oj8SiSMInuI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_yJCooS1z5Jsl15GvCBYHAuvZJcwQ3GpWG6Yt7ZwITg&oe=69C53E9F"}, {"file_name": "Screenshot_4.png", "id": "1387218866442104", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619680_1387218869775437_2153259362698849257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA--vO2wOCMQ7kNvwEC1hzW&_nc_oc=Adr0cbvWz5WgOS5GpvT1XEs4wKNSnI70lMs0kLcIJpUXFvK2klDR-w2wkOBZCis8jA4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyHF9PlDE6mNHGhwoS9TW9kK5r2fwBKTWvNyyTKwBe-Yw&oe=69C510E6"}, {"file_name": "Screenshot_3.png", "id": "894540063243679", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618251_894540066577012_9192835818432946758_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARnV1RiI05UQ7kNvwHXK2tJ&_nc_oc=Adquop37dZbViXAcHLRftzklgDMZppE266MsU95hB5cMPOc1Opauxi5x8RJvqjK04SQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxmucuB7ly_sFqLUWDA1ZdW_or_kG_sJkm3ermg2dQ7sQ&oe=69C514E2"}, {"file_name": "Screenshot_2.png", "id": "1796569854388259", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499619751_1796569857721592_6219083564477116289_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY-vtyOuDB4Q7kNvwHpR2jt&_nc_oc=Adr_tCt1Lu4svW3spIQDDGMF0AgUgDxdRYyv69PWLjrLFJmwxfegV_P-lgkYwxEs584&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzl2Q62WyxQOlv1Adpaee5Tx9NbI5CY3URP0WHAYNnMkg&oe=69C519A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Movie Colab VR", "keywords": ["moviecolab", "vigaet", "theatre", "review", "annotation"], "long_description": "MovieColab VR Review moves critical creative reviews off small laptop screens and into a shared, immersive virtual theater. Whether you are a Director, Cinematographer, or Producer, meet your remote team \"inside the cut\" and see every frame exactly as the audience will.\n\nThe Conversation is The Documentation\n\nWe\u2019ve solved the biggest pain point of remote collaboration: note-taking. With our \"Data Round-Trip\" feature, you don\u2019t need to look down to type. Simply speak. As you discuss shots and draw annotations in VR, our system automatically records, timestamps, and transcribes your feedback. These notes instantly sync back to your Movie Colab web dashboard as actionable tasks for your editors.\n\nKey Features:\n\n- Pro Screening Room: A distraction-free environment for accurate decision-making.\n\n- Perfect Sync: High-res video playback stays perfectly synchronized. When you pause to point out a detail, everyone pauses with you.\n\n- Cloud Workflow: Access your projects instantly. Videos load directly from our backend\u2014no local transfers needed.\n\n- Smart Transcription: Your voice commands become timestamped text notes.\n\n- 3D Annotation: Draw directly on the screen to communicate visual fixes clearly.\n\nReviewing on the web is functional, but it lacks presence. MovieColab VR provides the shared context teams need to speed up production cycles.\n\nNote: A Movie Colab account is required.", "short_description": "Don't just watch your dailies, step inside them. Meet your team in a virtual theater, review cuts live, and let the app automatically transcribe your spoken feedback into actionable insights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moviecolab.com/p
nt-ord5-1.oculuscdn.com/v/t64.5771-25/499619751_1796569857721592_6219083564477116289_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HEiQLfEwrvIQ7kNvwEbuSyZ&_nc_oc=AdoXRY88ZGBL0xvK9Ky6SOmLXpmdI64nSo1STUrz9PnqvJHpd_owpNeCAKkY826ZCgM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsRI03QoysAe-Y1adnmZAPwwjSyTTi4a1sDfs2BL0YfQ&oe=6AFDC560"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Movie Colab VR", "keywords": ["moviecolab", "vigaet", "theatre", "review", "annotation"], "long_description": "MovieColab VR Review moves critical creative reviews off small laptop screens and into a shared, immersive virtual theater. Whether you are a Director, Cinematographer, or Producer, meet your remote team \"inside the cut\" and see every frame exactly as the audience will.\n\nThe Conversation is The Documentation\n\nWe\u2019ve solved the biggest pain point of remote collaboration: note-taking. With our \"Data Round-Trip\" feature, you don\u2019t need to look down to type. Simply speak. As you discuss shots and draw annotations in VR, our system automatically records, timestamps, and transcribes your feedback. These notes instantly sync back to your Movie Colab web dashboard as actionable tasks for your editors.\n\nKey Features:\n\n- Pro Screening Room: A distraction-free environment for accurate decision-making.\n\n- Perfect Sync: High-res video playback stays perfectly synchronized. When you pause to point out a detail, everyone pauses with you.\n\n- Cloud Workflow: Access your projects instantly. Videos load directly from our backend\u2014no local transfers needed.\n\n- Smart Transcription: Your voice commands become timestamped text notes.\n\n- 3D Annotation: Draw directly on the screen to communicate visual fixes clearly.\n\nReviewing on the web is functional, but it lacks presence. MovieColab VR provides the shared context teams need to speed up production cycles.\n\nNote: A Movie Colab account is required.", "short_description": "Don't just watch your dailies, step inside them. Meet your team in a virtual theater, review cuts live, and let the app automatically transcribe your spoken feedback into actionable insights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moviecolab.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VigaET", "support_website_url": null, "website_url": "https://moviecolab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25539008062396107"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1232931882038789"}]}, "baseline_offer": {"id": "1232931882038789"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768452240, "status": "PUBLISHED", "id": "1232931882038789"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28983547681275444", "version": "4.2"}, "id": "1135412745335313", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25539008045729442", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "
0370_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwil9toOPTkQ7kNvwFsIvOv&_nc_oc=AdnGMsjUlWaKKzlxCJ0Q2XDh1y1E_2e5xB0zq4u3Xb8t6kPeu9pLJG6fVFqE-t0od1U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzhEDe4EXq-tYqSKf_8kn530isL9oGEeo9qrDyM9Hdgow&oe=69B94038"}, {"file_name": "Screenshot_1.png", "id": "1625809768383320", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618297_1625809771716653_8922082133443755887_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1_2gN8uE-4oQ7kNvwGtcX6C&_nc_oc=Adnnlp0_N2aP0ut-m0iTaP5pcxfbXnYp5V_QLNs-nAF3OjWP5dk8FDoSltumFzD4Wts&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxPiT2O7SptxLMHbOU-JlPjb7Q1rZeddUoDUBjnjyCawQ&oe=69B9611F"}, {"file_name": "Screenshot_4.png", "id": "1387218866442104", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619680_1387218869775437_2153259362698849257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c0UF_n5S7YkQ7kNvwGLIoEM&_nc_oc=Adll8K3rJD0NJUEAM8-K36KKSUaFzJSk3XpRDe6kZkU1FqJbbA3arfhEXWXshJ7JZ74&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyrBu-Tq79qkWfwehBnSasNzQzPcX7laRQUHlcJk5uVYA&oe=69B93366"}, {"file_name": "Screenshot_3.png", "id": "894540063243679", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618251_894540066577012_9192835818432946758_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wb1seZoBGxUQ7kNvwHWQHpZ&_nc_oc=AdnRKouZfx71m0MJXpW8anwAtLjxNpuECRyU3Y70AOMMz3Rn81x3-rTtQtB0F1v_wRE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzpyLXP8TJG0Lf_1hya5bc9czcPaZ0zTIG9tXYdcqzRSQ&oe=69B93762"}, {"file_name": "Screenshot_2.png", "id": "1796569854388259", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1796569857721592_6219083564477116289_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6WbH0SWzbkQ7kNvwGdcArj&_nc_oc=AdmtPqGKdGFkEqvWHnINl3gwrW1ZqAhzFbzBdY1lgQ8wcy6VhiQZc2XcxM7WdcJ_9uc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwuZYYQp3ZqyMQL74u7bdSjyL9dzs5B5EO9fiADhFIW7A&oe=69B93C20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Movie Colab VR", "keywords": ["moviecolab", "vigaet", "theatre", "review", "annotation"], "long_description": "MovieColab VR Review moves critical creative reviews off small laptop screens and into a shared, immersive virtual theater. Whether you are a Director, Cinematographer, or Producer, meet your remote team \"inside the cut\" and see every frame exactly as the audience will.\n\nThe Conversation is The Documentation\n\nWe\u2019ve solved the biggest pain point of remote collaboration: note-taking. With our \"Data Round-Trip\" feature, you don\u2019t need to look down to type. Simply speak. As you discuss shots and draw annotations in VR, our system automatically records, timestamps, and transcribes your feedback. These notes instantly sync back to your Movie Colab web dashboard as actionable tasks for your editors.\n\nKey Features:\n\n- Pro Screening Room: A distraction-free environment for accurate decision-making.\n\n- Perfect Sync: High-res video playback stays perfectly synchronized. When you pause to point out a detail, everyone pauses with you.\n\n- Cloud Workflow: Access your projects instantly. Videos load directly from our backend\u2014no local transfers needed.\n\n- Smart Transcription: Your voice commands become timestamped text notes.\n\n- 3D Annotation: Draw directly on the screen to communicate visual fixes clearly.\n\nReviewing on the web is functional, but it lacks presence. MovieColab VR provides the shared context teams need to speed up production cycles.\n\nNote: A Movie Colab account is required.", "short_description": "Don't just watch your dailies, step inside them. Meet your team in a virtual theater, review cuts live, and let the app automatically transcribe your spoken feedback into actionable insights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moviecolab.com/privacy-policy", "developer_terms_of_service_url"
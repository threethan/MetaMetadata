845754432860_2836148457885290370_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oh-mjmxvH90Q7kNvwF9d7bm&_nc_oc=AdpYo_SYko5S8JFdsYE1ptlDuKl5ljC6kCErqaGxUzBcAjB9nMwbiSEZK3jE4x1lnZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIt2r9khA84StNT48-CQIINI9f026j1OwzqyJYriq-Ww&oe=69C27AB8"}, {"file_name": "Screenshot_1.png", "id": "1625809768383320", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618297_1625809771716653_8922082133443755887_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JlDiwOiqeMQ7kNvwHyuDN5&_nc_oc=Adr_XVfZJL-cFjVB2GI1Ck4dba9AvLitH5ncoaBLQTDBexuRjEvNi-xln22Y194rZaI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxY7wZT1zCD9RWt5Krw68gISTSV_AQKM0XJmTLXQMC8Nw&oe=69C29B9F"}, {"file_name": "Screenshot_4.png", "id": "1387218866442104", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619680_1387218869775437_2153259362698849257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gaw8YCZE_48Q7kNvwGXY8GY&_nc_oc=AdrikCiEPz6yqzJ2Tut6hWa-bW8TJwbVJtxn5Aw2XWfaFI_5HPAyhZoOPooSYk8kN3g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxsijHahmsJr_L2zfSRdGxOKf6P4S4WdYNGivh9Wyt6rw&oe=69C26DE6"}, {"file_name": "Screenshot_3.png", "id": "894540063243679", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499618251_894540066577012_9192835818432946758_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3VFJJRWwwQQ7kNvwFkzMNd&_nc_oc=AdrY_CJnKgzPrqCHgVhPNz8kpc0S_LAZNLrwkOo0JW8iI4mF7cuxFc9NPt6JCFV-BCQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxAVqgtBWZOUhqAvY_S8ZA4oFMly7tfAC6w21GDq_jEKQ&oe=69C271E2"}, {"file_name": "Screenshot_2.png", "id": "1796569854388259", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619751_1796569857721592_6219083564477116289_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyGgLI2twF0Q7kNvwF_mWzk&_nc_oc=AdqHL21zmytMEFZNLliqw_sjmmOuih5y-b9kCtnfQ0h9Dbwx-BBlbkDf38uL006d8p8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKkBnEoWDRa5paUkp1Ah9UFwvMCLBqv7S_qj3zVDnY1w&oe=69C276A0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Movie Colab VR", "keywords": ["moviecolab", "vigaet", "theatre", "review", "annotation"], "long_description": "MovieColab VR Review moves critical creative reviews off small laptop screens and into a shared, immersive virtual theater. Whether you are a Director, Cinematographer, or Producer, meet your remote team \"inside the cut\" and see every frame exactly as the audience will.\n\nThe Conversation is The Documentation\n\nWe\u2019ve solved the biggest pain point of remote collaboration: note-taking. With our \"Data Round-Trip\" feature, you don\u2019t need to look down to type. Simply speak. As you discuss shots and draw annotations in VR, our system automatically records, timestamps, and transcribes your feedback. These notes instantly sync back to your Movie Colab web dashboard as actionable tasks for your editors.\n\nKey Features:\n\n- Pro Screening Room: A distraction-free environment for accurate decision-making.\n\n- Perfect Sync: High-res video playback stays perfectly synchronized. When you pause to point out a detail, everyone pauses with you.\n\n- Cloud Workflow: Access your projects instantly. Videos load directly from our backend\u2014no local transfers needed.\n\n- Smart Transcription: Your voice commands become timestamped text notes.\n\n- 3D Annotation: Draw directly on the screen to communicate visual fixes clearly.\n\nReviewing on the web is functional, but it lacks presence. MovieColab VR provides the shared context teams need to speed up production cycles.\n\nNote: A Movie Colab account is required.", "short_description": "Don't just watch your dailies, step inside them. Meet your team in a virtual theater, review cuts live, and let the app automatically transcribe your spoken feedback into actionable insights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moviecolab.com/p
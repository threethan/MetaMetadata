4435215369", "locale": "en_US", "screenshots": [{"file_name": "Screenshot_5.png", "id": "1371845751099527", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622285_1371845754432860_2836148457885290370_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9ma1XKdqNuoQ7kNvwElBH3J&_nc_oc=AdpLsi_5b7ijqC7rJF2XN3r5yuylU0uyIR-sod13QwOVjT3qn2_kENXkB6zjiXpRMEs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQWAJQms4403Oe9incvS86CC-G0SSqCeT8UHyl1bVHhhw&oe=6AFC77F8"}, {"file_name": "Screenshot_1.png", "id": "1625809768383320", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618297_1625809771716653_8922082133443755887_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ik4XFOFwdtcQ7kNvwFPOGcv&_nc_oc=AdoQnW2-OHdMDVNtzuvBz0sP2-zqLYxl6LZbOj9g_esRYiDlFp08zOQLNOZDi3Bi2d8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTSJtcwWdZh5iOH-DPU_Z56uRyQwgvqUl3pv4dUDs2anA&oe=6AFC609F"}, {"file_name": "Screenshot_4.png", "id": "1387218866442104", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619680_1387218869775437_2153259362698849257_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u5obBOHtfi8Q7kNvwFYjO6a&_nc_oc=AdoKoS8UFVYKvTwBjyJbvCPR7wxKIM3EkjGlT-z-pIt-D9N71Tn2FR1KEwblAe_neog&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTDhhAWF-8_XKKUfpLRGDkriEIPrAJ48_17lvrDaYahdw&oe=6AFC6B26"}, {"file_name": "Screenshot_3.png", "id": "894540063243679", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618251_894540066577012_9192835818432946758_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WhVSALkwiwgQ7kNvwHtqwTK&_nc_oc=Adok_tGg58ra-Osjcop_ex8xQHA5fq_VhgoTfHKX_oZveYDd8vo-N9AoS71XI62z2CA&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLbFZGTZifuFLT-AYg9OZNH1UZlQ3G0pwL8FWxqbruaA&oe=6AFC6F22"}, {"file_name": "Screenshot_2.png", "id": "1796569854388259", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619751_1796569857721592_6219083564477116289_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3VLTmEnO8PIQ7kNvwFWzfAy&_nc_oc=AdpD8-3ybUALMxi007v4iGZ_C8zQqkjtgtsHYxkh6ilFflgLyunaAWWaLDd5Ej7g6N4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzcUprCccLQWQTbthv9ubzB20h5DAzqqH49pmrQPzobA&oe=6AFC73E0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Movie Colab VR", "keywords": ["moviecolab", "vigaet", "theatre", "review", "annotation"], "long_description": "MovieColab VR Review moves critical creative reviews off small laptop screens and into a shared, immersive virtual theater. Whether you are a Director, Cinematographer, or Producer, meet your remote team \"inside the cut\" and see every frame exactly as the audience will.\n\nThe Conversation is The Documentation\n\nWe\u2019ve solved the biggest pain point of remote collaboration: note-taking. With our \"Data Round-Trip\" feature, you don\u2019t need to look down to type. Simply speak. As you discuss shots and draw annotations in VR, our system automatically records, timestamps, and transcribes your feedback. These notes instantly sync back to your Movie Colab web dashboard as actionable tasks for your editors.\n\nKey Features:\n\n- Pro Screening Room: A distraction-free environment for accurate decision-making.\n\n- Perfect Sync: High-res video playback stays perfectly synchronized. When you pause to point out a detail, everyone pauses with you.\n\n- Cloud Workflow: Access your projects instantly. Videos load directly from our backend\u2014no local transfers needed.\n\n- Smart Transcription: Your voice commands become timestamped text notes.\n\n- 3D Annotation: Draw directly on the screen to communicate visual fixes clearly.\n\nReviewing on the web is functional, but it lacks presence. MovieColab VR provides the shared context teams need to speed up production cycles.\n\nNote: A Movie Colab account is required.", "short_description": "Don't just watch your dailies, step inside them. Meet your team in a virtual theater, review cuts live, and let the app automatically transcribe your spoken feedback into actionable insights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moviecolab.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "VigaET", "support_website_url": null, "website_url": "https://moviecolab.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "25539008062396107"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1232931882038789"}]}, "baseline_offer": {"id": "1232931882038789"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1768452240, "status": "PUBLISHED", "id": "1232931882038789"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28983547681275444", "version": "4.2"}, "id": "1135412745335313", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25539008045729442", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "
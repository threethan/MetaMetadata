845754432860_2836148457885290370_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwAL9rDpcS8Q7kNvwHVx9K4&_nc_oc=AdqoR1l2RkQLoe6QB13yyjOJCUqPUPctwkEPm5dQDUl0Ir7CZyh00Gl4gJsRz9tEvvg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyG3Cxaqa02dfMsrMMjRNs-yq4i2ZE1EuaaCMlgs3k0Sg&oe=69C66F38"}, {"file_name": "Screenshot_1.png", "id": "1625809768383320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618297_1625809771716653_8922082133443755887_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmIoWw_OvQsQ7kNvwHq46iP&_nc_oc=AdqTzukBS97l3XCrwI93zo-E7vA9zGOglbJKg-9HGtd73Tb3WQi_krDjemiVU3IK5SM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxloAS-yzOI5MzFOWcCTDzizlvPhGqDIeHLFuf4SHEaAQ&oe=69C6901F"}, {"file_name": "Screenshot_4.png", "id": "1387218866442104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619680_1387218869775437_2153259362698849257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA--vO2wOCMQ7kNvwFFuWY6&_nc_oc=AdqCbYu7AR1LsNGHenvO1hwYo0Sh8-P_7FjiWvb1eo-9MDJ_Vfl1z0RQdRpOGBW5pTs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzYYgVl6fhgS_C3xy5_F0HyIAFRtYPcRfX3sReaRr5o8Q&oe=69C66266"}, {"file_name": "Screenshot_3.png", "id": "894540063243679", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618251_894540066577012_9192835818432946758_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARnV1RiI05UQ7kNvwGYpmoc&_nc_oc=AdrxegDRWW_vPEharc7RodiXwdmtKD-N6mnqXB6LADMG7v1kzpICGTUX6rAo7s8hWpk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxvjGJW-ajLskipmqYxbgsc4OJlcZKZWoqmra7ysjlHWg&oe=69C66662"}, {"file_name": "Screenshot_2.png", "id": "1796569854388259", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619751_1796569857721592_6219083564477116289_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yY-vtyOuDB4Q7kNvwFALVnB&_nc_oc=Adr_FH0yRC2--EuFlU73lztrn1IodJDufBjQUNeuDouMLbXhvUaad9SIBgMGUCVZ9h8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzCZyKbfdWaFj_Hoew1TlWNb50OHvO91pgc5pdLgVwKfA&oe=69C66B20"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Movie Colab VR", "keywords": ["moviecolab", "vigaet", "theatre", "review", "annotation"], "long_description": "MovieColab VR Review moves critical creative reviews off small laptop screens and into a shared, immersive virtual theater. Whether you are a Director, Cinematographer, or Producer, meet your remote team \"inside the cut\" and see every frame exactly as the audience will.\n\nThe Conversation is The Documentation\n\nWe\u2019ve solved the biggest pain point of remote collaboration: note-taking. With our \"Data Round-Trip\" feature, you don\u2019t need to look down to type. Simply speak. As you discuss shots and draw annotations in VR, our system automatically records, timestamps, and transcribes your feedback. These notes instantly sync back to your Movie Colab web dashboard as actionable tasks for your editors.\n\nKey Features:\n\n- Pro Screening Room: A distraction-free environment for accurate decision-making.\n\n- Perfect Sync: High-res video playback stays perfectly synchronized. When you pause to point out a detail, everyone pauses with you.\n\n- Cloud Workflow: Access your projects instantly. Videos load directly from our backend\u2014no local transfers needed.\n\n- Smart Transcription: Your voice commands become timestamped text notes.\n\n- 3D Annotation: Draw directly on the screen to communicate visual fixes clearly.\n\nReviewing on the web is functional, but it lacks presence. MovieColab VR provides the shared context teams need to speed up production cycles.\n\nNote: A Movie Colab account is required.", "short_description": "Don't just watch your dailies, step inside them. Meet your team in a virtual theater, review cuts live, and let the app automatically transcribe your spoken feedback into actionable insights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moviecolab.com/p
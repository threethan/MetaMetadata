845754432860_2836148457885290370_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oh-mjmxvH90Q7kNvwGGZBwO&_nc_oc=AdpMpslFf_Jrt-RJPRiZdI-DK6c7YnGmxz12E-QwjKdQVNooDXxhYiWzHbO81ZYAHMA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfweiB9lJzjLBWtgqOrZbBT7xf85JzZDRWC5Zv3FzvjDwQ&oe=69C3CC38"}, {"file_name": "Screenshot_1.png", "id": "1625809768383320", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499618297_1625809771716653_8922082133443755887_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4JlDiwOiqeMQ7kNvwFTqqpC&_nc_oc=AdooA_Ya1eopT7WxEofeK-rON8nxG8gONQle6DTUW4jzT1Y_4gMhTTN1gh7lMivNGpQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwU9ZbChpEORQomPvleCDOzdxPzk90JD-dJUzLaDKTiTg&oe=69C3ED1F"}, {"file_name": "Screenshot_4.png", "id": "1387218866442104", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619680_1387218869775437_2153259362698849257_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IA--vO2wOCMQ7kNvwGJSFKO&_nc_oc=AdptrpGvh2XpnUrA574yiNtt0pUJ5ZkWIlWK7UY6Z9lm99mrETKioJJXGigRoltYz9o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy71_KzqDLHo4pK1XnLJ7ftkMpEdeD62sB3cjBtbz2Slg&oe=69C3BF66"}, {"file_name": "Screenshot_3.png", "id": "894540063243679", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618251_894540066577012_9192835818432946758_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ARnV1RiI05UQ7kNvwHYmE0v&_nc_oc=Adrd6WDPxccnZ-sG1efavny-1h9iNIj8F7LAM_hoCDqKGBqKnlxJy3MgpdrHuzhAzgg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlfCF5Iw59LVamohJ_Mn08Zl6pV_LvD7lYnL32-8kLgw&oe=69C3C362"}, {"file_name": "Screenshot_2.png", "id": "1796569854388259", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499619751_1796569857721592_6219083564477116289_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kyGgLI2twF0Q7kNvwGj3_Fa&_nc_oc=AdquDEE5Drb-S0ljI0vEaE3eOvh0Vks7Icag_98ieIGMHJkoW7nY6ch8UWqNDt_ZY8I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy8Rv3IgttoEtR9zpECW9CPG8Fekns2gEMlfLp6jcxbQQ&oe=69C3C820"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Movie Colab VR", "keywords": ["moviecolab", "vigaet", "theatre", "review", "annotation"], "long_description": "MovieColab VR Review moves critical creative reviews off small laptop screens and into a shared, immersive virtual theater. Whether you are a Director, Cinematographer, or Producer, meet your remote team \"inside the cut\" and see every frame exactly as the audience will.\n\nThe Conversation is The Documentation\n\nWe\u2019ve solved the biggest pain point of remote collaboration: note-taking. With our \"Data Round-Trip\" feature, you don\u2019t need to look down to type. Simply speak. As you discuss shots and draw annotations in VR, our system automatically records, timestamps, and transcribes your feedback. These notes instantly sync back to your Movie Colab web dashboard as actionable tasks for your editors.\n\nKey Features:\n\n- Pro Screening Room: A distraction-free environment for accurate decision-making.\n\n- Perfect Sync: High-res video playback stays perfectly synchronized. When you pause to point out a detail, everyone pauses with you.\n\n- Cloud Workflow: Access your projects instantly. Videos load directly from our backend\u2014no local transfers needed.\n\n- Smart Transcription: Your voice commands become timestamped text notes.\n\n- 3D Annotation: Draw directly on the screen to communicate visual fixes clearly.\n\nReviewing on the web is functional, but it lacks presence. MovieColab VR provides the shared context teams need to speed up production cycles.\n\nNote: A Movie Colab account is required.", "short_description": "Don't just watch your dailies, step inside them. Meet your team in a virtual theater, review cuts live, and let the app automatically transcribe your spoken feedback into actionable insights."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moviecolab.com/p
"Crefty is a VR sandbox inspired by Minecraft, with single-player, multiplayer, Survival, and Creative modes.\nChop trees, mine ores, craft your equipment, and build a home. Explore different biomes, find villages, head underground into caves, or travel through portals to other dimensions. You can grow crops and raise animals too.\nPlay Survival if you enjoy collecting resources and working your way up. In Creative, you have access to blocks and items straight away, so you can focus on building.\nBring your friends into your world to build and explore together, or play on your own.", "short_description": "Crefty is a VR sandbox inspired by Minecraft. Build whatever you want in Creative or gather resources, craft tools, and survive with friends in Survival."}]}, "developer_name": "Unknown Knowledge", "developer_privacy_policy_url": "https://unknown-knowledge.com/#privacypoliciescrefty", "developer_terms_of_service_url": null, "publisher_name": "Unknown Knowledge", "support_website_url": null, "website_url": "https://unknown-knowledge.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "1501726935154843"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823259_1875058643465166_3278431489501006945_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_
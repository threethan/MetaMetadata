3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQs8Um8JkU_oGehvnDwHrGzfQeo33BHlMRBs7wPlMRD8w&oe=6AF47FF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12_trailer_cover_2560x1440.png", "id": "1798517648093170", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593909648_1798517651426503_2463643075265234252_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ym0Bjw97dlwQ7kNvwHtuuu8&_nc_oc=AdprzzPN2_WZ-8zNYpMhokCCwaUs8ZLhaj3WV_fh1n7NtvdluYf6VJbF9PmMUkzzxZ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzBcSLWoT3GVIt88JyEAc305xjimzeXa_SlDTkZbuaTQ&oe=6AF47302"}, "display_name": "Violinest", "keywords": ["music", "violin", "orchestra", "viola", "instrument"], "long_description": "Pick a song from the music stand and play along. Each note shows up on the fingerboard as you go, so you can play Canon in D whether you\u2019ve played for years or never picked up a bow. 46 pieces to choose from, including Bach and Vivaldi. Violin or viola, your choice.\n\nOr skip the song. Draw the bow across the strings and pick out any tune by ear.\n\nNever played? Pitch assist keeps every note in tune. Already play? Turn it off and find each note yourself, like the real thing.\n\nPlay whatever you like, show your friends, and don\u2019t wake the neighbors.", "short_description": "A mixed reality violin and viola. Pick a song and the music stand shows every note on the strings \u2014 or just play."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/violinest/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": "https://fncore.com/support/", "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_RE
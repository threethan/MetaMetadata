.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhfL5Rb8kri--2MgKexp6ay3plzi4MWczxPO42RIj1PQ&oe=6B046706"}, {"file_name": "screenshot-5.png", "id": "3230074770526221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623185_3230074773859554_9171674226798320542_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMdbM5WBC4kQ7kNvwH7DLQ_&_nc_oc=AdpJ5wD5o5tuKubO_ntb0OSCvvg9dPZ1bCHT8Yd5BT_KtYsxE-JWcj8SI9nuFIgIRuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWmteDdwWrx-Rt2rv5XxRitNgBkNcputB1HTq8o90ncg&oe=6B048A36"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12_trailer_cover_2560x1440.png", "id": "1798517648093170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593909648_1798517651426503_2463643075265234252_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hNLjUEmMCo4Q7kNvwFnMsNS&_nc_oc=AdoDRHEn-iWUf3KIQBOwcGdof3tjiWS72RFQGohrs2cK-UigrSpxy3qb6hdyA1v9CzY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTghk_Y36l0QnqoI_wdAUsdqOM42gTImnQ8hbdlOlhbzA&oe=6B047D42"}, "display_name": "Violinest", "keywords": ["music", "violin", "orchestra", "viola", "instrument"], "long_description": "A violin and viola, in mixed reality.\n\nDraw the bow across the strings and pick out any tune by ear.\n\nNever played before? Turn pitch assist on and keep every note in tune.\n\nPlay with friends online, whichever Fncore instrument they have: Violinest, Trombonest, Trumpeteer or Cello.\n\nThe music stand shows you how to play 47 pieces, like Canon in D, marking every note on the strings as you go. The viola has 14 pieces of its own, like Telemann's viola concerto, Bruch's Romanze and the Harold theme from Berlioz.", "short_description": "A mixed reality violin and viola for Meta Quest. Draw the bow across the strings and pick out any tune by ear. Never played before? Turn pitch assist on and keep every note in tune. The music stand shows you how to play 47 pieces, like Canon in D, marking every note on the strings as you go. The viola has 14 pieces of its own, like Telemann's viola concerto. Play with friends online, whichever Fncore instrument they have: Violinest, Trombonest, Trumpeteer or Cello."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/violinest/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": "https://fncore.com/support/", "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29505779872349279"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593895988_1135532879435155_5663603011904992100_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFI-V43YtOQQ7kNvwFFqf2P&_nc_oc=AdpoMgqyZFQxrv_Frr4H_KHCsGGMjqP8iABvus2CVo-wOZ6p9Jw8o-29i2QkU7MS6qA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSesk4GU_kwekO9kfr27y0H94lytofn7cAuC1lrm0qqiw&oe=6B048026"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Violinest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": 
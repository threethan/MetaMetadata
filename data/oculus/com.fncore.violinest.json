.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRq8Z21WCZTCSvg9umI46ExAisT_ICmGguOCaFz8heiuw&oe=6AFF2106"}, {"file_name": "screenshot-5.png", "id": "3230074770526221", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623185_3230074773859554_9171674226798320542_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kr5yLuwg_n4Q7kNvwFa7FA1&_nc_oc=AdpQQbTQ-3oUv9h2QFIwrgLZQnIVLEqJYRJhdHP39UhRyZThcCYc4XmDeZJYnMXasBQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZeYYUXPQi32sfak7-8T8WFJsPecPpAAhVW0cIzLbvJQ&oe=6AFF0BF6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12_trailer_cover_2560x1440.png", "id": "1798517648093170", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593909648_1798517651426503_2463643075265234252_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gLNAnxgB7kQ7kNvwEB33So&_nc_oc=AdpqclxIBUDGGn4ZNeVk0xTXoyp3dYwRyjGM9VgNmxcEcyq2RapOIq5xs933hRRl_H4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQMF5r8VVtJf6YOb5itQNn1VugfJq5NpKQ6OfWm91VBRw&oe=6AFF3742"}, "display_name": "Violinest", "keywords": ["music", "violin", "orchestra", "viola", "instrument"], "long_description": "A violin and viola, in mixed reality.\n\nDraw the bow across the strings and pick out any tune by ear.\n\nNever played before? Turn pitch assist on and keep every note in tune.\n\nPlay with friends online, whichever Fncore instrument they have: Violinest, Trombonest, Trumpeteer or Cello.\n\nThe music stand shows you how to play 47 pieces, like Canon in D, marking every note on the strings as you go. The viola has 14 pieces of its own, like Telemann's viola concerto, Bruch's Romanze and the Harold theme from Berlioz.", "short_description": "A mixed reality violin and viola for Meta Quest. Draw the bow across the strings and pick out any tune by ear. Never played before? Turn pitch assist on and keep every note in tune. The music stand shows you how to play 47 pieces, like Canon in D, marking every note on the strings as you go. The viola has 14 pieces of its own, like Telemann's viola concerto. Play with friends online, whichever Fncore instrument they have: Violinest, Trombonest, Trumpeteer or Cello."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/violinest/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": "https://fncore.com/support/", "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29505779872349279"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593895988_1135532879435155_5663603011904992100_n.png?stp=dst-png_s360x360&_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wa-NMimAcw4Q7kNvwEqMHoY&_nc_oc=AdpwGGpMDbi_1qM9cJbKj_lranKllOpdhdOyYC0gUEH2e_zE9H98sQm-HUcS57of-Tc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQq3uPKpPW5ZehJ05MSUg1QQFI5ME4-3zWG8NoofPFL3w&oe=6AFF01E6"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Violinest", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}, {"topic_name": 
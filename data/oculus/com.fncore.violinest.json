499624592_992707689906920_7092148051430461982_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Veh5o5LvVwcQ7kNvwF86zBF&_nc_oc=AdqNfoI3KU0J9k05PD1Abb5kqE2tJtM2q6Mkl3M5_bChuuvNkyRnqezCY65hfn63wcc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTqnVhoXX4hWpsuAfkR8IPBA-TiYgLvNUQRTe0ZtpEtIw&oe=6B0B36C6"}, {"file_name": "screenshot-5.png", "id": "3230074770526221", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499623185_3230074773859554_9171674226798320542_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cEqL1p-gtmgQ7kNvwGBbMYs&_nc_oc=AdqyMGYtkNHGdto_JV29ijkW2-uWUQHDfiolr_HMRmKLc1R6X6pAU7f01QZR1PJdokY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT7iDYhm1EvA5JWxYUxoOR8hLXslGog4ypZP6LO7g3R8Q&oe=6B0B21B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12_trailer_cover_2560x1440.png", "id": "1798517648093170", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/593909648_1798517651426503_2463643075265234252_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1dtJPih6I8IQ7kNvwGRes_D&_nc_oc=AdrhvO0dgjGdRL89kJoF1bgwMCtXMUs_mO1Ke9BMZH0RuNqdiIm_OF6Jjsf1y3gTwog&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRxskfu9VQjgMli5c9xFmBFI4lGH2aodmPEml2flHooxw&oe=6B0B14C2"}, "display_name": "Violin and Viola", "keywords": ["music", "violin", "orchestra", "viola", "instrument"], "long_description": "A violin and viola, in mixed reality.\n\nDraw the bow across the strings and pick out any tune by ear.\n\nNever played before? Turn pitch assist on and keep every note in tune.\n\nPlay with friends online, whichever Fncore instrument they have: Trombone, Trumpet, Cello, or Violin and Viola.\n\nThe music stand shows you how to play 47 pieces, like Canon in D, marking every note on the strings as you go. The viola has 14 pieces of its own, like Telemann's viola concerto, Bruch's Romanze and the Harold theme from Berlioz.", "short_description": "A mixed reality violin and viola for Meta Quest. Draw the bow across the strings and pick out any tune by ear. Never played before? Turn pitch assist on and keep every note in tune. The music stand shows you how to play 47 pieces, like Canon in D, marking every note on the strings as you go. The viola has 14 pieces of its own, like Telemann's viola concerto. Play with friends online, whichever Fncore instrument they have: Trombone, Trumpet, Cello, or Violin and Viola."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/violinest/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": "https://fncore.com/support/", "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29704887139105217"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/908839717_28610046102006879_3884204272095308226_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQo1tOGAfNsQ7kNvwFsvz34&_nc_oc=Adpz_mco490BtV-RylQc1gFIxQnjnQomoB5x2BqFGm2-bE5r423UoYGFhs1hj7WF8sA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1CpFqa7NwRm7o_sr_qQ9AWZbzjXEh7QDsnn_LBrRWmQ&oe=6B0B1A6C"}, "is_concept": false, "is_
499624592_992707689906920_7092148051430461982_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ivgkOas3MVQQ7kNvwHWjQPq&_nc_oc=AdqkFkADXonqsqWHjYXOlkdjdmJYPKv3CjfSurvUxiDS6TdOuK0S0WQW-MXu0sFelGk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWvSCuUPPYQqP5TJ_APG7RMU6SdN0ZGdwXFrqIqL7PS_w&oe=6B0EF306"}, {"file_name": "screenshot-5.png", "id": "3230074770526221", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623185_3230074773859554_9171674226798320542_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RlX0Jv04J8sQ7kNvwHUXKOp&_nc_oc=AdpwLhiJLlpBmJ83qYiZCIyK1_87BQPuYgSs96vh1whIFeGg4pTngFq7rz7uX5Nb0Cw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUjG5tV_xdkImFBxX6xMm5nGwNQPI74GWiVikWSZxhdow&oe=6B0F1636"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "12_trailer_cover_2560x1440.png", "id": "1798517648093170", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593909648_1798517651426503_2463643075265234252_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ygyoJWkSY-8Q7kNvwEf7RoW&_nc_oc=AdrYdAO9kXsHg4txGpKuEUDMUQFwyn3--S1y5D28MDAPIb_3sJtzolHOP9By6E3FPLw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXlwLK7QcTPVnK32UG3ap5zKJxo8KQbhceiJj5raASfaQ&oe=6B0F0942"}, "display_name": "Violin and Viola", "keywords": ["music", "violin", "orchestra", "viola", "instrument"], "long_description": "A violin and viola, in mixed reality.\n\nDraw the bow across the strings and pick out any tune by ear.\n\nNever played before? Turn pitch assist on and keep every note in tune.\n\nPlay with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest).\n\nThe music stand shows you how to play 47 pieces, like Canon in D, marking every note on the strings as you go. Ten of them are Christmas carols, from Jingle Bells to O Holy Night. The viola has 14 pieces of its own, like Telemann's viola concerto, Bruch's Romanze and the Harold theme from Berlioz.", "short_description": "A mixed reality violin and viola for Meta Quest. Never played before? Turn pitch assist on and keep every note in tune. The music stand shows you how to play 47 pieces, like Canon in D, marking every note on the strings as you go. The viola has 14 of its own, like Telemann's viola concerto. Play with friends online, whichever Fncore instrument they have: Trombone (formerly Trombonest), Trumpet (formerly Trumpeteer), Cello, Tuba, Drum, or Violin and Viola (formerly Violinest)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://fncore.com/violinest/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Fncore, Inc.", "support_website_url": "https://fncore.com/support/", "website_url": "https://fncore.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29744820675111863"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/908839717_28610046102006879_3884204272095308226_n.png?stp=dst-png_s360x360&_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nHSRL6fJ_PMQ7kNvwFkQ_Ju&_nc_oc=AdooNKYDQ7TEJt764k281oTtBJRPAQdPwnDunWSLZcbOYsqLlNrI0f2lWA_APxft5v
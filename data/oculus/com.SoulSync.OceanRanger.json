1m5A5ryO0kU4OR86Q&oe=6A427D71"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3JPw97DLT-YQ7kNvwHgN_a6&_nc_oc=Adoj4D6_GhqFJ4U1LhLlSO5CgllaXT-BIPJHy46oZYCxooSzGgpc14scF-2UmLfbx40&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pZse8XgtVhGqwmiGOvU062dth94dc9LMZuJeFbjN7PA&oe=6A427D66"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z3gZIkWdajEQ7kNvwHDKtkR&_nc_oc=AdrzEdm2qt7MPRkyJwMg8q5DPY3uHyeKREOXHCH2N13auR6lw8chTe2QqdcR3QgT2vE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y2WEO86vH3v3Fd4aMIZP06CF2Jqt5Qv8BoRq4xv-UrQ&oe=6A426310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "26508685195474344", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622919_26508685198807677_4146757607931705014_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQSzQrYZMbAQ7kNvwFakW8F&_nc_oc=Adqzfqnk6IZQjT3w0Ko9h2E5Tkza4hFlMqm5lgPP2dOxLIdDTaGzga5eT0wweyBws6Q&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-83Oa4mGKbbLhlwM1fMXi0AZQua_2zeaUG9U0NvfI_AQ&oe=6A426325"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "27858511023741175"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619685_1035728168909753_4445111049151019192_n.png?stp=dst-png_s360x360&_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Gi6g5j7wwoQ7kNvwHb6Ze0&_nc_oc=AdoRdWPfQTHczjiceX7Zn7JOi-XnAZhMTWdZeovD9wlFbP_wPW-rqBX4UifNrZdTQgI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ae-kWDzAjkdgqQgiQe_0-yhpo25bzEQjNytffQM5M7g&oe=6A426907"}, "is_concept": false, "is_test": false, "is_
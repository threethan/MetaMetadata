VbE4M3PqDF3hFhg&oe=6A106471"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FM2w1RFGF04Q7kNvwG9rITv&_nc_oc=AdpHrtTv4KgJ9Cqdxt-knfBxf6IeoqE3ouSwyQty6smLh0aSfjLLqYhpZCREGixi49w&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7E4EJ2HAUNWFfZjp_FeWJq5GYcVsoU-0g0rcpG4UGFtQ&oe=6A106466"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ypFE8YdpZyQQ7kNvwF-uyAw&_nc_oc=AdqO5MeXyytHR8GQP9s4iVVA3D9CDZyHhAgdbFjxklFDuM0YxJZ1VaaZFbfHPl2DcQg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Yg7EGXytaYlbX9j2VObtlQbrwTzhjPWtlhUQGuMN-0g&oe=6A104A10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1299588809039890", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491822779_1299588812373223_9132593990556757843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wXzGLZdJ-AgQ7kNvwHqH_zi&_nc_oc=AdpkOAjvYF0076pP4hxy8eKh3yJ2osOdb491mZbWlstcLbzJP4eaqGHPG5Ajnmb0Kqg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af769bgPAOV_pSxFJ4RMFbb06s-LU_hdo35f1VWr2C2-4w&oe=6A1048CB"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "27333579986234284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499623400_1533998534995282_4453544856095461751_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ptajkj_TVSAQ7kNvwFw3mVL&_nc_oc=AdrHRYkAfK-CjMEGuK6ryd5FozJw9QdU87f2jd1X_dddabutztRrRg8GHsOhGYi0zMg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dO6NqQpAtjNjuQvlOcFwYI9j1kbZz4u9gFoGCaLoP5w&oe=6A107558"}, "is_concept": false, "is_test": false, "is_tria
vV4Bj2K49tw&oe=6A05D871"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xaBrFoX8FA8Q7kNvwFlzhUL&_nc_oc=AdqERzVh5g1yd-Jc5ISn_fghKUkSUP1XH5-3H4drFL3gkPGDz-FLp_QN04uhz0E9zZc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7l3gtWpQSQTb8MqdWTuWgTY2ydWdnxNRYAdWIXEYgq4A&oe=6A05D866"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W3wnKoQIs7IQ7kNvwH9YG3Z&_nc_oc=Adq5mHO39COqm3U3XsfWk4iRA1oZ_ZJDyUfA2JlIgJSPQxJ-M7wx2OvedxIJL0Mw5pk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ESVnTdfvnD3VoTyVvqyUS7kL2g02VlrZ3EJ2n0CSdXQ&oe=6A05BE10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1299588809039890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491822779_1299588812373223_9132593990556757843_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N_vpeSJ_LdUQ7kNvwEMvwt-&_nc_oc=AdoCGB8jaska8zGtkWVlRe57gFjNHidiX9uRJPvVxidIbNC3f-95pQ3Sj8faGbO-6-g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5am9xE24NVbx-DeOsXzlDnh1HCWdJSpmGV9NX8ulntfw&oe=6A05BCCB"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "27333579986234284"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499623400_1533998534995282_4453544856095461751_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1FeFlFsdn6gQ7kNvwFLEBFT&_nc_oc=AdoB8ukYXwe2IRV3GzPsFrpCmA83itC16o5jddob61mQ0BUio0chiJqU2Xp4uMjRFvo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XcUZIsatZP6EtSZUllI8qLu2fgxQ7HCHaEmezmEWWnw&oe=6A05E958"}, "is_concept": false, "is_test": false, "is_trial_offe
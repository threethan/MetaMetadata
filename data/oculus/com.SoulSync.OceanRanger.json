SXh3kmAQxQ4IKrmwO4bKA&oe=6A9C2371"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-udMGy5-3BcQ7kNvwHq1F3n&_nc_oc=AdqQ-f8nW8AzPeYK1nuwHYNZXNfde2rbVJtJilLUb_TSe0Z4h-2YURDpO3IvTkxfRH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJKfJveEtYIIdROlLY4KvpRQKoBTQKBxy-JwJgHsvwsVQ&oe=6A9C2366"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0MYreqTgZNwQ7kNvwHlTMpz&_nc_oc=AdrM6Oit9RpN5TZWtnhZkdng-rsCEF6imA-1fok5qxoaQ2vuGvQ70lvdfYnW4Oc70g0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLb8laD3asvPCuii6ybHtTgUUOlIQcd-gJ96KANQDAS_A&oe=6A9C4150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1753212262489792", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619751_1753212265823125_4837899938710867541_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_tJtj8L_t4Q7kNvwENk9DC&_nc_oc=AdrUQbh2n2Z8obmasDNYOt1QidV9RT2vjX_iT2sgvVjLdt2_lMax1c9qbyBnB2_VMhE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIv0FytttWGaZQh571ApDGBq1wG7XexaLGNEWHn3SQ6Yg&oe=6A9C40A5"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28528820940043510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622334_1390270392559452_1475651224912285998_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F-4rsv_-k3EQ7kNvwGkGBs8&_nc_oc=Adr8FuskCAZ5mCuRDHtngg70uX_fXe_5o-npY0zd9zylK4P7-Wyb1N53LguBvMiMoY8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuMeVmq5vTiK5KGGWlqG2NDpe2xfY0yycBiKqL4vhIdA&oe=6A9C3141"}, "is_concept": false, "is_test": false, "i
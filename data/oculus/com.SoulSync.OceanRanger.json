rch5y9XsCTJL6wRXGYT6w&oe=6A95C431"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GST_hXO_gIcQ7kNvwG_6DIg&_nc_oc=Adp2uYNxmaYojYquwg_VAPwLjj0foYnY1H2jNWSdS2MTtoNvuPY53klqyTOaGrvLPf0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEpmyHMeM9v--KugafdgqaEayyA5BoVlqYXBKrS4moG_g&oe=6A95C426"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GkCBfKdwzCwQ7kNvwGKhc-E&_nc_oc=Ado6DwfJ9zZ-7ZgxOADEmcXRjcanYp_ZPq31G73913W-Qe230Uex2Z3LxW1L98uTPR0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIee9QCbxCFPAdcVao4dppp6cg0YfieUvQ-U5Sj9AqEQ&oe=6A95E210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1753212262489792", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1753212265823125_4837899938710867541_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0NOLm1Z74oQ7kNvwFlMDMp&_nc_oc=Adq53uW-Rl2iXVoEt449InsMgySKDmeOMlODvyCDpL7XuiJzkdQRygLN6g6gdSft4v0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4E4Ldnf3QSyqePfKgpDiaaaWnBxX4ieaRGWb-DtwXdw&oe=6A95E165"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28528820940043510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622334_1390270392559452_1475651224912285998_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uZQcfpTfAYYQ7kNvwG9Sls-&_nc_oc=Ado6EF3ML4nCTcSAtHFeVqey3P8Bue_ZA4YMlHH3Olnio6p2gch4RjencFco2YQyaTk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHILruGXv8CB3Uz-C91R4zeqHHPRcVcY8vU5Q53D6KENQ&oe=6A95D201"}, "is_concept": false, "is_test": false, "i
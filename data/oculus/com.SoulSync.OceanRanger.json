EeLW_WM22ziPaiz6JsIyGD1_A&oe=6AD3BAB1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zxOSXSpxwIQQ7kNvwEb0CAb&_nc_oc=Adp648z2fGEvDsG55R5sHDu-YNfit_HtrFqlkkLLPYRewm_s4vySJZPX5rI5AdBjdrI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0ArRdi1KIw2bCtwI2GeNsfjAkLXCd_v7qYFnhlVM8PQ&oe=6AD3BAA6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6G8K4yfbbdIQ7kNvwHdZpWv&_nc_oc=Adpss-cIbaBo59ZyQ3O1_SYkgz2XNTQzCWImvISfHiDUEheUgXU7Woa5T7JpYSajWIA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOod9KI1uCwgwnSPiMuWaiXKXmN1mhfJksQ9VT1Uc3EeQ&oe=6AD3A050"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1681803443946887", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/593723055_1681803447280220_8554441312708257333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ulvsglXYTvAQ7kNvwGpwozw&_nc_oc=Adr_X_lChEH_7rbXtrjdkFsU56EYTzX9NpLmfi3wQVqVP7obuNw9yXAv2QjOkjgQeHo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA5ATnZj_psZTq6mbJcRatvCc7JjEFRfUWaTouMT_5EA&oe=6AD39FBD"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28800487359543532"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/593749142_1753818512490755_7452645588454837950_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRYpmHeoG8IQ7kNvwFM4AyW&_nc_oc=AdoBweHmtfusR8WJll8fAqD049-fuR-wpDmv0dVcTFfeyx4kcFj26PPc7Rd8xlpRAOE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfKDJIS2t-YLY4j9hUDqMw3w1KnN-t2ynxpq0aPpZilg&oe=6AD3B6B2"}, "is_concept": false, "is_test": false
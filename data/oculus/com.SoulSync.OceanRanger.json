adCBX0A3TtRh-1H-OWM2THA&oe=6A4914F1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S5gOW5Ba-0EQ7kNvwHHRxvB&_nc_oc=AdoOzNTh_11fdTb4E9Ucy1W1NZuFicvgKIFwW9t8pIPh8fUljt6cqMcSVvFKB3Y2-cU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI8SkEgfutT3n-He5V6OQaID3K40jJnjlMh5uz5zWZ_g&oe=6A4914E6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMuy9fjPNxMQ7kNvwGnVOYf&_nc_oc=Adp_SmlrDYz8cRm3dhxYqBjotMa6SiaQ7z5pXoXzOABi2iyWyFA6APDtiCACNGF8BPs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVHMc0afGnnmtP6GyyIDuCP_K_iBq-X4cTfM5aJaANmQ&oe=6A4932D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1592480559165666", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620875_1592480562498999_2298388557790923462_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqeW2O9FYPkQ7kNvwEY3Q_0&_nc_oc=AdoE4bn534tC8yCLXxG78qUtLzQtb37IhNeOhzGSJoudZdyHWwAWqNVHewUOT3hLzJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCX2D6tVmP4cbJBeHmEE6Ixid8c90AVWT4aHrcUO6PSYg&oe=6A490548"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "27954624097463200"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619187_1023045196772703_4325935200251910829_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1nflPNztWTsQ7kNvwGQO3rB&_nc_oc=AdoqSyijJJYV2pAzcI9zxnhFP51plrlYFmPEm-R7ctieuzbapHgwldlH8ew1YK44zNU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWRrJDkXkvKOUQ4WnDl9FuzS4d8x868eM20i02xx5DXw&oe=6A4919B5"}, "is_concept": false, "is_test": false, 
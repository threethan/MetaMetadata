content-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EktEjuG-RukQ7kNvwE6tR9O&_nc_oc=AdoTqrPD7iucO9NYX4nvYll1fvR4UHTmgDODVfy_i98LnzFrouZT9gbHfvnkEIPMnUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af2hVRLXKwNMJjRd6eBQeUlxESQN-tKM7M_Iq8EkuILCvQ&oe=69F0C066"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-BzO49FqBIQ7kNvwEMbBia&_nc_oc=Adqe8MxLN5mhrVNQ2ZF96vnbSgyj0Vtxt2Qzh57M9NGkiBnFC35ehofgDtYAJ_D1RDw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3W39JPCVmRJ9lNJjSIvzVCJeY-X8okmyltyGX9UnEZfA&oe=69F0A610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2080079289441058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618938_2080079292774391_7368180464223553295_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MoDgYuaKBcsQ7kNvwFFBr51&_nc_oc=AdpapplZ5XdS5prAt2MOfXHQr06d48KnhR08pDRUhPGBsXpI1m5IMEAZT3DjFNIbyeE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af38u4Hc0SL3ejUwUh8GRzGBHXEdO8qB3JcquWpTC2KhqQ&oe=69F0D0AE"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26935410142717939"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620940_976522771810779_2364624373948473211_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FyXRg1iLVcEQ7kNvwH3bADd&_nc_oc=AdrySCQrdRabRJvfhdgJ0UK9HGBliUnMz4sU9mgeiV7TxTMTCxzaV6ejxyr67D5kQuI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2JhJMe7saFANUXx54lszPpsSBnaGnFfz0Zq-2tiHdQIQ&oe=69F0C15E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shark Go", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_top
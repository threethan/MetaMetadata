SLvxYnoRM68a6CelA&oe=69E39171"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ajGcDN-i-GgQ7kNvwGH1MSU&_nc_oc=AdqrxdoWgsNB39dNddGsipk0pl8pOWtl_utRbyOsb0kXlf2Z8SMH8haIPpX-fD0VoKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Rkhr0e2L9lUR6hnOl56OGXUROcQTrjxg5twUqDYkMWA&oe=69E39166"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qk9JTsdLpzYQ7kNvwGj6_Fu&_nc_oc=AdpBXH-gdrK8Tvt_cr5tzLUdLWO3pTy72x8WWVT0TaCVUZ-Gq2mk59gtxp8hstdvC_o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27d9KMTM3WcywoMWEoMu6z1OuPOVQRh2WQupUuO2h2xA&oe=69E37710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2080079289441058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618938_2080079292774391_7368180464223553295_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3eRjJwoQ8KgQ7kNvwGgP0ta&_nc_oc=AdphUVOtJI8pOY5MYETlW8Znl0Jtfxwlbi8OlEWA_p2jiFP3PbSQzgix0v9hW3txbvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jxyoZWAkQmEAuKg-ZXu1XQubmKkp-NBkmIWhC_5Vumg&oe=69E3696E"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26935410142717939"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620940_976522771810779_2364624373948473211_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GFxRQO80MAoQ7kNvwHAYb6Z&_nc_oc=Adp5Y_V8dXI9AQz7ohnd1AoQJntKh7WbSY-tCC1MCZOMJSE4nkMn33QJQB3ICYgCoGc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qj53ul3uzY6OVKGypmqAcOr4X9022yDXn40u5c3Vtbg&oe=69E3925E"}, "is_concept": false, "is_test": false, "is_tri
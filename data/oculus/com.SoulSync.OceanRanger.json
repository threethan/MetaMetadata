zVRsIca53wfOCWXbs6CQdAQ&oe=6AB13B71"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5hNtMyKxxYQ7kNvwFcTX4w&_nc_oc=AdqJNoqp9CpJujgNDU621P8BN5DsK9njLA2pfEIDgQbKaPqjhuR17rTlvMaowh0gSG0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITBtwc66IceAC-RW3j-l30AqPULVbbyHmtpgeMyHU4vA&oe=6AB13B66"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PpakiWz5C0cQ7kNvwEz80UT&_nc_oc=AdoPZycLBmdKH4z-qRbLE9gutbeezotN3ImMhtIVvs2Ll-tE7iKr0DZGb1QfksS04c4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLT1c6ZmeafSr498YEpYwvnnIO1KW6B_Ftjn0x2zudSCA&oe=6AB12110"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1681803443946887", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593723055_1681803447280220_8554441312708257333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hemey3nFh9kQ7kNvwFFSi5V&_nc_oc=AdpBeqQ2io-kjWFMiYkMzFaXUnHsucX6CuNVuELSENWxw7jUyRKa0f3kZJi7V5sgyus&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxV8LeP7ddJh5gSZrfC7MrUJ3BupfxfAq2OnuXEeqT2g&oe=6AB158BD"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28800487359543532"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593749142_1753818512490755_7452645588454837950_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UwlM-yXbYXEQ7kNvwFEsRIl&_nc_oc=AdrWzfl9dT-aKH-9UTLLA-3zRclO_NGjSK3RuMejo2meuhJkpCJu706qHgrZkfKhggA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJALXbhh9Ru17HKV-Gx_KFdEul6ah8cfsOWG6h7PxlvCg&oe=6AB13772"}, "is_concept": false, "is_test": false, 
O_Gz3rJOSYH2Um-6HLwYlGjA&oe=6AF8A4B1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqeNjFPPxpQQ7kNvwHRu9dn&_nc_oc=AdrRWPzYNMGt5iuDTkHtNSKB1JTmTi71fPBcR1l3WDFv8U8_kjcX0gQsT9OHKkbrmb0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP8URFYnw7Jy73C-0MnU_bgGvrY4htFCnltbdj1mbL2g&oe=6AF8A4A6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8m16_0j6PgQ7kNvwGw7Uts&_nc_oc=Adr9OW9j3_LPxi4N6S_cHM3Kfxb6vXfpfPqBjG1TBEAx1nNLjVKMV1hnUcFTOdodEyA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1NDHMTrL7dmAuihYr1zrLhQbw_Hlcy3R4Mq8d6qo0Zw&oe=6AF88A50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1079385158249391", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499623876_1079385161582724_2484945788192467912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FeFkoY4JTBsQ7kNvwHCoNjG&_nc_oc=AdoRVIM1a0cpLFnrKavL55eXYAPM_Yj32mFcT1YlXRe125oDHgZKgjEyvTBDKcT53Bs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrkkcr3GVkCSlG8T1pj6wd7LOGWUgQBoJnnjNdyTpRIw&oe=6AF8A96F"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "29476509778607950"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622153_1340676259138333_6737400952738914797_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xri6yli2rLUQ7kNvwHZdu1l&_nc_oc=AdoPFc-7V5jRR4f8gYHc0I6X5pPVEiKEQeOaRD7uTn0D4g2D-HzfTvmDVGVHSeRpqNI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZ0aHpXoTQlaK0DnqB44-4XO0Eosr_9Af11gZcPIMn4Q&oe=6AF8A272"}, "is_concept": false, "is_test": false,
xlDkYtA7jAqvsZWjxA&oe=69CFCAF1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8nYTKSM4mo0Q7kNvwEYJjPe&_nc_oc=Adr7D6O0QtP2_VedJShY-Ymx_hGGGRr_vG-_fbKxBxc7feVv2expJ83NTmhWgw7PwrQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyY5-yBz5VJAuAW0dcfenYqY3ZNqNggJXX7ZcYUpux3CA&oe=69CFCAE6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6ewWhqSqwgQ7kNvwGBRGDH&_nc_oc=AdojVD81mwrXixRQOkRelc1a6xJQQn5Oq7xyHo44hMBHjGZIn65R3KaYZEEmFv8TKIk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxLIFlXnzMarIJsnRcoTbEo9loMwWnHjVJp1Pvi4U37fg&oe=69CFB090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2969015289954321", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825415_2969015296620987_7220503234661123708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93oEV4oJC4QQ7kNvwGrikU1&_nc_oc=AdqiNCUNQp97VN0LUvWZqZOc8qpva39eA_p7kS27msNj7xoGF1k6_PfU9YdJaNazLJg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2O_S2ylLRiPoWa01tO--Yt7-BcUkaI5CUFmxSlp0FJQ&oe=69CFC602"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26843457815246506"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491818890_1869461227776414_2159721458527835090_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3UE2-SmWFEYQ7kNvwFGhh2p&_nc_oc=Adr9ylgxRLUXSkBvVnXQ4VfqrY6H7aa4dMsnobPDDEP9JAj67euBjQicy_iI2jcs7P0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxUdZcm17PsPizPQ6c5OsfOK7FDWDLgyTe1KIIWuIrxvA&oe=69CFA0D9"}, "is_concept": false, "is_test": false, "is_t
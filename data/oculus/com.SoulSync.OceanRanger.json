xRbaqm_6n2Lwgxotw&oe=69E785F1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1StT2xDXIp0Q7kNvwELlIdU&_nc_oc=AdqhOXsY3Jx0cWSt7AxbaGPbyd8tOdw3KhlKZpObQEI_3T7wbq_4Iajlc2JREb_9TaM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2xPgHTy8u_NMDjCZbWHmXgynp7bMNCnF_6flFz5a_h6A&oe=69E785E6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LAGOvul3gAQ7kNvwHPfbaH&_nc_oc=AdqvRV83H91dG1uhzuTe5d0YJ1m2748zG2StOKY6QmSMlTZX5xWQHc28fhI0T_pCMes&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yy9T6x6vlRwRvHLJCWKA41wvzJ3ychtP0Ce143zuv-w&oe=69E76B90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2080079289441058", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499618938_2080079292774391_7368180464223553295_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xO4f0U331cQ7kNvwE5XUAO&_nc_oc=AdqZgIa6YQ1YFjIxzjGFHLidgI3YDU5fhU31CEaDu_GoYmtci9yFl3bHyYpiRFwrAag&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cp2ZKHexCREHr0KBqOCH5c3ONGQk590t5JfR-J2wbrA&oe=69E75DEE"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26935410142717939"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499620940_976522771810779_2364624373948473211_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZPr933eN_oQ7kNvwFwrKuH&_nc_oc=AdrrEV8l8D4h1BgL9aF6t_j2Zey_uTvsWUTqGM4rU8DVIpFUV6M2JtHgwf29uunJw9M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2djWVhBysqCtOS2sHSwTRf44hPtjJ8OtYTGPbNyGiGFw&oe=69E786DE"}, "is_concept": false, "is_test": false, "is_tri
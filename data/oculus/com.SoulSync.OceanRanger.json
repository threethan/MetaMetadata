wTlnV3HGJStXBxozz47lnUA&oe=6A54F271"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oRIoBjSB6lYQ7kNvwFMhK77&_nc_oc=AdpmpEssjPqN7n35OSGOGBJbWIvLevuFk9YELMftUVRQA5l83jJlpuJ6vP_pCrSogZE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMx2YAGhWcVJUZeW5J8GgT1goz0lFdpdg_ILwvRYJdgg&oe=6A54F266"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RpVfAXCVDQQQ7kNvwGSbIzX&_nc_oc=AdpzH-94X_U8_c8y-8ZsR6nmp9ZeQ5U8slHYNDL7ByX3akCK-cmF-cmZvWXus7fP9OM&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeXTYjaAE0Au2N-pop0k-8HZq3exiigWyYpgblUDAzKw&oe=6A54D810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1592480559165666", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499620875_1592480562498999_2298388557790923462_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=muudVk6MovkQ7kNvwHuN096&_nc_oc=AdrHRPIrCj7vszXmhMqkO_AO9DGTq-JEY1jeNZOJvUB5hlm8VoJpiFYoZ8xGms97lok&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAkyzfK2h4tPUCBlrmaYlt-l81qVFtOOqC-7StA9M9UQ&oe=6A54E2C8"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "27954624097463200"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499619187_1023045196772703_4325935200251910829_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8gezY7iiWgQQ7kNvwEMPlet&_nc_oc=Adp2HHm5IPa2o5nSAQE27NNmH6uWO-7GHVnpc1FAA6_sZj2KZ4y_JapWyIXwbEg-nDk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdWHh8-BQrBRKU6ARB60ciB-ecIC6njxo2BkeLwDvFwQ&oe=6A54F735"}, "is_concept": false, "is_test": false, 
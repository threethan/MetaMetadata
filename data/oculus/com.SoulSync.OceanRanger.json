4y7pu8Jl3LpsC3GKkIbAGMJ5A&oe=6ABBC771"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0rNMMEmEeIQ7kNvwFXNfLZ&_nc_oc=Ados6ap9L5mDl0_Ho0IYESQKz7q1ns9UGnumxpSMQ3FnZft4AggnkrZACuxM1-p--rE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB1Yy2YJK7Tvq3e08_RblWF35RwcDLgo_zydA990xNIQ&oe=6ABBC766"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BtBT6nN_7DsQ7kNvwGdSW5B&_nc_oc=AdpGJ-ST9BVawsDJNfmRuNQRG73cLfYR1shPxPA0dBazkQero8iZRAqQxssX02rRTh0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhw6djkbmZTav8gJZfE4KoVWHtYfyraua09WNDNMQgyA&oe=6ABBAD10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1681803443946887", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593723055_1681803447280220_8554441312708257333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2FHweiwnJgQ7kNvwEMPW7R&_nc_oc=AdoeDL2hG2cKmU7VzIbqdPi6tfI99enOzls5m8xe2Bugc08nIgR71q9Z_XHnngMbrFk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDPpwxXzXo8H5Wz43EUY0bfXSnffWpyNcMTaauU2hFVA&oe=6ABBE4BD"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28800487359543532"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593749142_1753818512490755_7452645588454837950_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v131jdgwkhcQ7kNvwHrl_r2&_nc_oc=AdorNS4ZZCYSBer1CoeNlX-QzaneEG5miG0y-ISWiHtXaChHf1VJcihwri1MCuF6qvQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSrenUr2LEuvlmocCk4CXYetseT1Hamtkn4giYbIUk_w&oe=6ABBC372"}, "is_concept": false, "is_test": false
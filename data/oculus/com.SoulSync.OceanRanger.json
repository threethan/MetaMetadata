ZDCIY0nC7MX5od2JK5rh9E_zg&oe=6AD0DF71"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GpETNKDeKAoQ7kNvwHH0q2G&_nc_oc=AdqIDHgSPW3RxRZ_OBBK3MTlZIMeARnXRbMCtq7YSKlpOA7Y5d42zVUFWM7CwRV97OE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP7LDNXIVyOIDPjaCT0383pNhNggUJyT4z3h1eNpaBP4g&oe=6AD0DF66"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6G8K4yfbbdIQ7kNvwHy9KSF&_nc_oc=Adq4zbkgNgy9ZP2jhuAMNqCzxADlgE8BZ7W6XD3EXbCqrD_bmjxmIhV7VTMskVKsTE0&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMt45Rt58HDcl1Tiy9mbCp3EYevtPuf9sebxzouryyU_w&oe=6AD0FD50"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1681803443946887", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593723055_1681803447280220_8554441312708257333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlEbQ07dT_wQ7kNvwGqwBrE&_nc_oc=AdqNhO1vbmU7CPya6x3XKr-a6hqAX8WYBYmQjTAsIqexa9gII--BCXs5K1NcGC_mytI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_VDtzl5gQkGh_0BlDyqLbUiVK5tYXicW2HAGDspcBew&oe=6AD0FCBD"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28800487359543532"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/593749142_1753818512490755_7452645588454837950_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZRYpmHeoG8IQ7kNvwHYWj0P&_nc_oc=AdrEkxR6NiADJucB6qq-8HCf0j4hSlpMSt0jg_D5Z_SRtj-as3wHm0CLOMMfeJta53g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPggG9KLha5lMO0kXP8InSf8XlCUJteb2l-5qPed8_8KA&oe=6AD0DB72"}, "is_concept": false, "is_test": false
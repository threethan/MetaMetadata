Cwd4alxJ_2C0k-ddA&oe=69EB7A71"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emc-m8i0Ez8Q7kNvwFzg6c6&_nc_oc=Adqz5J3Re2-xReBseX1BJME3HxKdHKQGRr8VO_MER52VUQR5fOz51I6op-gMRKlK6jA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HcuKqaI8GA2Wl_eYSHGvpkTSgcUvQgyda6o3FBO7p9g&oe=69EB7A66"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTqmWwu4OHsQ7kNvwEgL7PZ&_nc_oc=AdrFEz5W8AgB6cH1wJMUGuLN8cI16GWAl7mjeMQr3zJFNpZpOd8rfEV5Ei8GZB0qmx0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1K7ivrQKfBOCuZw2Xtgq01v5g7qBu6Uj5SRtKFkfjwNg&oe=69EB6010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2080079289441058", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618938_2080079292774391_7368180464223553295_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGrovQUAQf4Q7kNvwGog_Qz&_nc_oc=Adq99cywdsR-qkO6ZU02Wwf4FfUDsimIKMMBRBJLi-zUQUgGCHKP-ZS9T0FpNDcqxnI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3-I-RddNfgbRxz_FBy61TpTbDsvEL6FSErx2elGQGlUA&oe=69EB8AAE"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26935410142717939"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620940_976522771810779_2364624373948473211_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIL8u24Ngo0Q7kNvwFLFVKD&_nc_oc=AdosAVlHN-54I3X7DCHhB8HDG16k1mPP-E_zcn7RjbtHp6TfiFHKyVOGAgsB5soRIKs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IICjRYQQsz23R0LygGAX8tIPk98erd01NiYkgkjQSBw&oe=69EB7B5E"}, "is_concept": false, "is_test": false, "is_tri
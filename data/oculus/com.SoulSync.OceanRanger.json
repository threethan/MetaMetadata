oLNJgXAAzukRc8ng&oe=69CBD671"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0TG_KoCl00YQ7kNvwGjLdSL&_nc_oc=AdqxhqoeIRRPwEaOwzYKaESsDCejFqQvz5FGU7wqq2jvYZ6PGhxzWDOxvOeMcw3n83U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyU5V5xKo_YWy_W8_DXvh5bCqvTrVEQckb_CLP0gVUCEg&oe=69CBD666"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1OcVgWULhQQ7kNvwFWc0ss&_nc_oc=Adr_17TucqMiG081THjWStWiaz0EzaptrtC4f68F7CO9zq_CDpHp-rBxMbH0oySn2w8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwydKvSjP5jaohhPofWsjy5qSZg-tFvoIeJ7Iib-KOxrA&oe=69CBBC10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2969015289954321", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825415_2969015296620987_7220503234661123708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h4-ipTqcFPQQ7kNvwHLYUd8&_nc_oc=AdqLk1y5zp4xrbWkSgMnWsNEHsIWmjCGupFif9VA9m88Jmb7jD5TS6sdmbtXhCxNI6Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwwpidff-aIENDksZVUywz4hMpCpnrM9AGEQEG1FyKSCQ&oe=69CBD182"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26843457815246506"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491818890_1869461227776414_2159721458527835090_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O7I_jvBKcjEQ7kNvwEZ3ERd&_nc_oc=Adp-f7ySGUknjijS-9uDXhaWwbGLSpswj5mifhgeOg7Un-WlJ7NPdZKpQzavYblT8SU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwpsRCc2K9YOwPWb2Br-fEsg9kndRM0-V7YGyyANX-TJw&oe=69CBAC59"}, "is_concept": false, "is_test": false, "is_trial
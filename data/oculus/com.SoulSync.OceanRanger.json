5Gzz1KQqcw_yxDgAjDdQx9mxiW2IiBBvHg&oe=6A7D98B1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdRb7HGT5G0Q7kNvwHNaZpL&_nc_oc=Adpjg72Oml7keOW3HVAsS2pomdHjw3Z_nZSki2aSXILk6RrHo-8VaZPwUTkz59FHbFc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGv0kyFdntcxnKG0tZDZ94m8W0ZYLlQkulJzsRVwNQx0Q&oe=6A7D98A6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wGdzv2rMgfMQ7kNvwFzvODS&_nc_oc=AdplXB_TzKwDa5v0rb9-l0bVANZxbYkPcwXDIAYlkywLn0uK75NlAszsr6gXOpQjwow&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6s4UFtH0KykQLqPUS9cJsji5ulmmgbQTj85EcBWS_HA&oe=6A7DB690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "980034831705714", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/499625099_980034838372380_4321342989750387418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=roJHSWUqR5IQ7kNvwH6PTwD&_nc_oc=AdpzaFMWpgeKA9HC-1ohwvhZgR-VJv_0yxcWU6O4JyR0l3ehxVulP6v3NMJAQf-AnvE&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3jvP4A92x1bGly5wX2vOMh1RJthSR-fiWijCARgRxwA&oe=6A7DC673"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28189846740607600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499622276_1987975601842031_2376532585822133561_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MT8L2ua8f-cQ7kNvwHL7hjd&_nc_oc=Ado0xbZVPYpYEFYxVZCwx_E5cDhscw5NGbCoHp2mfb2T8cAhOY65a4pUgo1i4A8vsdE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGqamlN5lqEFcVYrMlV5Fa-1bygOvwepnhfheaCjfpp-A&oe=6A7DB8C6"}, "is_concept": false, "is_tes
VeBwPmA1Hjv5CtzHbJ77orq1-5Q&oe=6A4671F1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5MbHanp44E0Q7kNvwGaVff_&_nc_oc=AdpTQcazCv-Z5xCi8MgiOI5XJjSn2s3O9NURaqARwoh6M4DeGmjXmLfMCI9VPfc3ZAA&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qP-4ohNRHxzZXTQPlGh5GcbMOFovMxk1zrdX8FUIsrg&oe=6A4671E6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMuy9fjPNxMQ7kNvwE43176&_nc_oc=AdqFQw9tRQKVt2ENQU9aF6kARZcRL-2MT3wa7TPTCnRCt79VXQw-dlT4REREZJH5cD0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y8NMg3IOfwl618myg9NYC2aSjzIoWAqqz0fsNUhTPbA&oe=6A468FD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1592480559165666", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499620875_1592480562498999_2298388557790923462_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqeW2O9FYPkQ7kNvwFvqvpy&_nc_oc=AdoCZkvfXUt7Ex84yyXjVAIBhlO5Es8kEAo_9bXPefWzqaItsOo9g97V5AwL_q7ctgY&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-roftBeJSARWwbqpHxBwTJRueJ4IObSlEzv5JhItcwkQ&oe=6A466248"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "27954624097463200"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499619187_1023045196772703_4325935200251910829_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bSmsCHbuUfUQ7kNvwFRtNvo&_nc_oc=AdrZKMKAeKhk9pBlcqZ_KR0U_y0z1LtRlwXziq1qs6aLn0Yr8cJICrNpgoHKrUHB-H0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AcBu2LXqELDJCjP7bCfm_1T_tnaDAbQJ_gCubSkkZOQ&oe=6A4676B5"}, "is_concept": false, "is_test": f
UC0dfJS2ndhc8RTRmg&oe=69D3BF71"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9I4F09qylD8Q7kNvwG3aXrl&_nc_oc=Adqx5E1PPRCRKlSOagvRGVrF-nVj7RV4VD41yQbNMIB2xML44pAWI283iIS8n-ueSWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EUafTl3GwjxqiQIud_jde96j2RA2dWrjjh-KOCL0QKw&oe=69D3BF66"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7qVHzkOMdh4Q7kNvwHT88mM&_nc_oc=Adrb95qd3J8c3HCASTzlEhW93__CWGIa3Mi7I-gEK8uq_7aqQCPBh6Eu3kh2C31LTsM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0xjzDW3DuZ55qYKe2B__be8SEQveY8EImOjU_rx9i0Og&oe=69D3A510"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2969015289954321", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491825415_2969015296620987_7220503234661123708_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QVaAWgVgfakQ7kNvwFupDcU&_nc_oc=AdovyNf6SBWo1lHXN8NWwChsvbd3SlPCp8Sp5rqFTMoEqsirQP8fol8pSTR8LzAK7MA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xiSZI4ggbxgq1DuZwqNL-2U25PCxUhxoPjX774em2KQ&oe=69D3BA82"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26843457815246506"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491818890_1869461227776414_2159721458527835090_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Aj_e1yI8yhAQ7kNvwHUmly1&_nc_oc=AdoXxlO6AtKbJaKCfo_hTpjkCgqJbNWBYJP9ZxVLV0NBGhPCOd1YuSruFpoTTBD--LY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zQf3CX-rxG4p7-oScGt33Q1APvuqfyxj0kLT76DbBJg&oe=69D39559"}, "is_concept": false, "is_test": false, "is_t
NBrbgUfRHUEf5hF0nZIfwZ6FtBjjuNQ&oe=6AAE9871"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klaKUfoPLrMQ7kNvwEcFnCT&_nc_oc=AdqaAy6BsAO0yKZ5raPsAKGxmpxow5a-wxO9bRwgn7U1s5O3kiChwBbuINbRt1XvWCQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPwowvUnyS7c6ihVXZH4X0BdBDt0BLKti65I1CNRc1SA&oe=6AAE9866"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_T2KvYPWLcQ7kNvwFf1g5_&_nc_oc=AdorcVNprpIcpzjxqINJaFwpo1y8cFXNWrECriPHmWIkIc_qHyuNW9TDE32C5Gf82-w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpzfKRtlLAt9BgyXeignc0xeNXdEGsuOAT7rb_XGoa4g&oe=6AAE7E10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1681803443946887", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/593723055_1681803447280220_8554441312708257333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hemey3nFh9kQ7kNvwEO9_EF&_nc_oc=Adr2fngUrIxn1tFvSzmTRbVznhgSMQi79uqr8ghpwrTA_RlB-6mB0ptmhDthlKSJOzc&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi5p0mmWumz5M21ggc5FQD9rqDulZtOSGXwbcZC_pT8w&oe=6AAEB5BD"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28800487359543532"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/593749142_1753818512490755_7452645588454837950_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvApzrQWeRUQ7kNvwFxyrPo&_nc_oc=AdrVhAWc6SrsfKYUbUj3OcKUDASoN1fMm0qXDBOL2Q-6L3BLYU11T_HVWrbjmLZtKuw&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjkVIg_y8gp5wi3lnApP3ZEDXeI_IxqOVHzbU9Z8OWQA&oe=6AAE9472"}, "is_concept": false, "is_te
UlywVNh0Q9rVA&oe=6A3E88F1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-8s5a98dx0Q7kNvwFHgWQT&_nc_oc=AdoJC-SxI8Y2rGq3PnnN6erisPTR3UtDTHgLqJ39W9voAdgAIYiw7uGzM2VGZyiYMeM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8i5f1Znlb1O1A77VAB6wrARMf2xYM4nMt_z98368sNaw&oe=6A3E88E6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uKIEQK50w8EQ7kNvwEw0c2a&_nc_oc=AdrWo9jH5-L6cG5K7r98uRTCheVqcyS6dz8oz_IEBK0Zrmnxxwsl11zG6-qg0iBZTS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8NmNRC15Ms1ykEfAhPfFjFjeg_zrKjsJmJga4XMif3cg&oe=6A3EA6D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "26508685195474344", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622919_26508685198807677_4146757607931705014_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tnPWHFEN6z0Q7kNvwHnAUCP&_nc_oc=AdrFsNqoUTEGe1JSH7jlyohtbneKZkMqAV4jc2mJolqsj5UwwfP0lo5IGsqLKLwWbQE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z67hSk2cR_qie-6XqT_Hzl534ess0L3q8n99FtmE17g&oe=6A3EA6E5"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "27858511023741175"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619685_1035728168909753_4445111049151019192_n.png?stp=dst-png_s360x360&_nc_cat=1&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LtKAWKoUe7EQ7kNvwGjzwfl&_nc_oc=Adqp11TdEK8EQxuACRGxIZPl4cUv1WcIB0MLZZq9YLlgvOSjR3A0RiPh3U_5bvsBKjU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1Kt-eHdz_ho7I4AZsWquPJYq_MLhgMmMPmYXfwMpy2w&oe=6A3EACC7"}, "is_concept": false, "is_test": false, "is_trial_
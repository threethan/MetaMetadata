jUgeTeDsy_H7aRsvOieqNm1YdqSraA&oe=6A68B8F1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMg2FX5Zw6gQ7kNvwHMdub4&_nc_oc=AdpW4RwVMFA0Dbrcj8DLXE5Pf3xdilSpeLg92YFBnPKp7xVRUy6cz_kA6DmIAiG9Hfw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsuEb0yXO4Um3sz6AUHK8-8nDrV8nEipdzfFy1aGHKnA&oe=6A68B8E6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tb5vLbgVoMYQ7kNvwHiKctK&_nc_oc=AdoGuKCmrRqStEYrLit4lRwjsbFqCu3uKPDUGhvT2SzXoe4CmaBH09gn-NzmKtpMaL0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBAgELX-87EfKoYj_1Bp-DilW6WRop-UaSwJBBa5iJKJQ&oe=6A689E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "980034831705714", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499625099_980034838372380_4321342989750387418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LGFecowpewQ7kNvwHs5Zop&_nc_oc=AdqS3gtoiHkBo_Tp6bX6rT2Cvm4Vy0Gf1cBMP5yfj1zKjWRPXutnjfqggCAB8zN-mm8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCl40XCUTM8vkMC00RO_zlbPlef7B0L1HiUi0E9hVrB9A&oe=6A68AE73"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28189846740607600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622276_1987975601842031_2376532585822133561_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEb_EF1SYUYQ7kNvwE-LIPZ&_nc_oc=AdoM8AlZcljEbQt4SX9YQ6pJbCjyLYrtcxmVX2DcDbsX5TeUybKxPm7YynjFGknBAy4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJKxKERuTMoNf8EW3_jMqgyvkavM9v5ahPMd0oqdxRYA&oe=6A68A0C6"}, "is_concept": false, "is_test": fa
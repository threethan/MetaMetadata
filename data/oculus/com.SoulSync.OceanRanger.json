IMdwJ6Nbcu-p6rzU4dwuQY5ZqBAYZg&oe=6A6A0A71"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dMg2FX5Zw6gQ7kNvwFPJE2k&_nc_oc=Ado5H7KSfrEedkY7LmwhPFgsN-KnR5YjZTVPa15dt3KQTo8KwmCHLQLyDVEqcTyIcGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCED4CrUvSFeAAm63gXaB1Hh4UaoVFue7DXs0zc5yNtmw&oe=6A6A0A66"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0rsS0RQG9kQ7kNvwFkXb2L&_nc_oc=AdpQcRrJ4-SSIL4CYiYGjjv_3YEzALW9s0x_4JNa1K0poMi5H6WR8N2qGo9INslXSE8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAB2R0iaPGIl7NB3TFn9HXSkWIKm3p4mwmIXfosD_fx3Q&oe=6A69F010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "980034831705714", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499625099_980034838372380_4321342989750387418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woU8xFXPn5wQ7kNvwFG_aLy&_nc_oc=AdqLmPOzu-ks4M_QSab5hAxphkreT6a3fjL3wsArc7KxglFn5VEMcliKlAOTxeqDCNE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM7lNgmsgbuIJ6uMzPM6PlZXRU1I05tOxRsOiIyXWKsg&oe=6A69FFF3"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28189846740607600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622276_1987975601842031_2376532585822133561_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEb_EF1SYUYQ7kNvwFbVEPK&_nc_oc=AdpNgvakw5IBnDaUvmKXv1yY5mUQvK0G2dl0SHowFJMalTXHZfB2RjmmDBhrqrGw3nk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPYIz5Ke8gDJUkJP24KVX5RxkVu_tdCqfymOcgZkj7TQ&oe=6A69F246"}, "is_concept": false, "is_test": fa
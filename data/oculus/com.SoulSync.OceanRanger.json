a_LjcQEXQ4mYar9G1URwMc69Y8imLQ&oe=6A6CAD71"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzX_d9MKufIQ7kNvwEUQa3j&_nc_oc=Adqdt72FHmAvNylIlpLk7QuXrD8vLwF5WpBz7h4fRi1zrQZ02y1HuYy-IdDLd8JyNk8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDhaVAdvnxGNGeTczbVeweO_wHER9vBCK0RMlQpeKKvig&oe=6A6CAD66"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G0rsS0RQG9kQ7kNvwGcH9dM&_nc_oc=AdotX-9_Dl1rW1TW7gXa5PbwocFfygaLlC7CQ3NMCn2TjEl5i0VsS-lTSWcv12k0eLc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrTmJqzgKSszXFmANCgXoy__IZl5QECNR_yoWul9Vqkw&oe=6A6C9310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "980034831705714", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625099_980034838372380_4321342989750387418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=woU8xFXPn5wQ7kNvwGUcytT&_nc_oc=AdoZgttVxoC4m2TpCfk2HzFIZ4H9s1TLWoIDtZGUYZ3KmiamKu-dFakHdDuxuXVU7MI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBckXijhVyYMSRqPVUqidFMB4KgD7zN9rJ6_YUoFST8xg&oe=6A6CA2F3"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28189846740607600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622276_1987975601842031_2376532585822133561_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MlzrxjVYgecQ7kNvwF457pD&_nc_oc=AdqT8rYWnejdepbzkG84mQOBwpLccpOMi_6j66QUDoveIhprJSVtRi1ZHrWPk187uJU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAP-msV_Jmm8H2iX6m4PhmA40KNHD-kjjEbiDnUvA6ytw&oe=6A6C9546"}, "is_concept": false, "is_test": fa
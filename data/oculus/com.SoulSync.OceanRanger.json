uC_Ss0hcjXWc0MpVO7N0hpZ6amhA&oe=6A369FF1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qYvpHkAoEtAQ7kNvwHVfMKt&_nc_oc=Adrs9oZYU9LlfJvmpw4bPt2IyhRRadKDY4tI3FxEoL173Mxg08H-WSqSomCHD3djtzM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nMCI-_uk_IU1ECVtyRxAo60RQHfh6jkZXeOiZfFv0hA&oe=6A369FE6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rw8wOqkxZAcQ7kNvwHtAlnt&_nc_oc=AdpXhm3gvNAE-1DNANlXqhLcZB-i6au88F0PdRfEllwuhYrTjZJpzcu0VUYQNgEuNdo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-t3JNZOWH7zvwvb8LdiKcY5y3gLnQkpqJt4pSFOpx-MQ&oe=6A36BDD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1344572840865593", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499620940_1344572844198926_3781510607721141095_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-Rr9bc5jCgQ7kNvwEE_kfF&_nc_oc=Adp4Fg4y1drxNzbQ777Gs5sENEVGVn6oi4DrElxJcLOJxtQbtc91H-0FY32McCXAke0&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2JELc39cqJlug8_mvj1_GDVQf2O1_QXYadsnsNhWjrA&oe=6A36B5C2"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "27693390103586602"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/673638530_824177987204318_3957836280336600136_n.png?stp=dst-png_s360x360&_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foR5JFIDqnQQ7kNvwF77BxJ&_nc_oc=AdpuxHlTN2JKvRItRq8DbsJVOsKUTT-818mu_Y9HnpdHmgCj4-fLMkBrxg_yb6_OrBk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-LtvH0gZi9iPekzBds1VgjETYYKnt_sHNyGlqn03FRYw&oe=6A36A524"}, "is_concept": false, "is_test":
ywfAVP7gJZuPWUfEYpA&oe=6A940231"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GST_hXO_gIcQ7kNvwFeQpUw&_nc_oc=AdoqssufW5wrzHFgstQ_qOp-TZdY159WoUjEuTYeVn1mGvZb8UVAlsngB53tFEHgOwE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfGZQsZqTR8cNcgmRo3p8CnHhoAwR6wJ2fxp1y2vU_lA&oe=6A940226"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2itMU2sx1MQ7kNvwGYKhfM&_nc_oc=Adotj5PrOzpDtfXc51GDKumw1EEsVameIzEUxKUXyyf16QTgc7pt0VGDJntu4e2MhME&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe3yVUjayx2_WUDQtGDomhPEjbDcVEPELCaXQGpDKMCA&oe=6A942010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1753212262489792", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499619751_1753212265823125_4837899938710867541_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0NOLm1Z74oQ7kNvwHyPKDl&_nc_oc=AdrBQ3uKXrpEWGZVcRRBbw0sN79DElOov9bxT8mVWqwgLywAwmZ5bZAMXjI9ilPrgeA&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjkkjU7CLKQTEwyuwxioEogsEdy_WOAvQjbT2IFzTcgQ&oe=6A941F65"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28528820940043510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499622334_1390270392559452_1475651224912285998_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAPdW_RLkB8Q7kNvwEF2XqZ&_nc_oc=AdrYW-rTvms_CyzGpjAS8dTYq_-9SuzGsuD31Rb9JBSxtPn96rKg0Y75y7MNNwNAiO8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGI0yeBwDOj4J6bC5oVLF0Is6zbyZ8BqxBSLbbgjAYK7w&oe=6A941001"}, "is_concept": false, "is_test": false, "is_
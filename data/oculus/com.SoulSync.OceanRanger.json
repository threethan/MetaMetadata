Fh8CVQaWDFxveZXhA&oe=69ECCBF1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emc-m8i0Ez8Q7kNvwHqitKY&_nc_oc=AdqQZiKMQv9NQ9J00_xsev1Fuj-Pr4g1dZ-iZP8_mKpM8n3RMxNc0AE3qA_3gX7Fk0Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1yxEXV1brf7fBeyvAMuR8Ou4egqwxCSY5ZK-GkRBCBlA&oe=69ECCBE6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTqmWwu4OHsQ7kNvwGbsnvi&_nc_oc=Adrq7hbrQTdf6uKjHEO4Iy-uVmPmn2O2BCWCLXUSF4DzDeFqgrTgqj0hP6oa9xeH65o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XSHw1rHy4jKjWhLZGRDIpOB2241psFfi997x3LUQkzw&oe=69ECB190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "2080079289441058", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618938_2080079292774391_7368180464223553295_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GGrovQUAQf4Q7kNvwH7MGZ1&_nc_oc=AdqxC984eJmhGIDGC5K2B52RPqRB6uD2FzNvMFRSTwTABL8Av4uOTytlIAaDnHfE74U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Z8ob3jSzff0iRbuY0-TRGbKtHdGXZtWCfW1GZ2-rKIQ&oe=69ECA3EE"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26935410142717939"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620940_976522771810779_2364624373948473211_n.png?stp=dst-png_s360x360&_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MIL8u24Ngo0Q7kNvwH-NUPq&_nc_oc=AdqPtxgwk8HWf1qbaxFng3SNT_MGJKe9O4bZ8LGgyyzSeJ3JnoGy50VikMH_xlL9tX0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24lDwWoBebux71WfgHgVZZQYwmDI4bb3rALKRrK_oB2A&oe=69ECCCDE"}, "is_concept": false, "is_test": false, "is_tri
Ftk0BCDftH_h0SwkM8kUw&oe=6AA017F1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sDK2XLcqocsQ7kNvwF0LYns&_nc_oc=AdpWzcoRJN5eTklH0wiVlk-IHTPFuEhBYBmQ48feAurj4Zwrl0FSfsMa_1qlbWsMIDU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJcTK96IcS6TvoxLFGrTBqKh-UIMh6x87tDDO-e9K32fg&oe=6AA017E6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c8ROIu7jzioQ7kNvwEmxV8D&_nc_oc=AdpvCuMlzwbYLFNEJii92MasfLjNWv54J86iGPvUlRNeJGB2f-qFQr6jiwQaV_C9BgI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLZHZp15Ed68Pd4LbJl1Pq-XoCZXY402xuhj_8tiQMTqw&oe=6A9FFD90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1753212262489792", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499619751_1753212265823125_4837899938710867541_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VCfPfgp8040Q7kNvwGxr-9U&_nc_oc=Adr3jPrvwrfCzCPeAt1jMDaMgHSLa75ZFtBKPel3aoeRm44UY4ZSxRzww1DhiJzhT8E&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKi8Oql8PA0MfSHKQbqvH5Lqmq1MAJvYTBTs2oB4S8PRw&oe=6A9FFCE5"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28528820940043510"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499622334_1390270392559452_1475651224912285998_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tss7dccM9aoQ7kNvwFqIN_9&_nc_oc=AdqdEVOPzHSfjamPpRSO-Tdexxrsmf1NtmAao7K5ImwMRuQSJscye_CCPyIP8KdinCY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJSaDVdmdpDLR5NImL903CtqkvWJD8nYkLu6ZXDkG8kHg&oe=6AA025C1"}, "is_concept": false, "is_test": false, "i
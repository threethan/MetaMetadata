hlFMHwPU52WtL9TgXkJREypA&oe=6AF9BDF1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SqeNjFPPxpQQ7kNvwEWohDW&_nc_oc=AdrvLsNbQSVL3K2UfqFzKFIQAdCXRFl0Nl4DwJ4R18yMfRt-5hbTAftj8a7SlIfpZmA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSd3sEuCjk-FS95C3EbdoxdnLPY_UyA8cQ-vTnf0ySBAw&oe=6AF9BDE6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8m16_0j6PgQ7kNvwGZud9v&_nc_oc=Adop7KajcRzeI2mUzwcFbtlAq9FrBy01C1HVGjTGMMq6jNlCahj3mP6LYD4cN-_y8gM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTEKtvQbbovd-E_teqVY2TsBuoLfxFG5F9NclC5XnBxYQ&oe=6AF9DBD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1079385158249391", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499623876_1079385161582724_2484945788192467912_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elWgOmQ5LI8Q7kNvwEGiSE_&_nc_oc=AdoMZWguEdgkSz1H3notyqK-02jZRwk0OUXoOrH9NBAXxl35mM3RVFxBklINO360858&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJhJOS7B9-0qKIo0ub_bwzdJ8bUDlkUraWluUVogG32g&oe=6AF9C2AF"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "29476509778607950"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499622153_1340676259138333_6737400952738914797_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mt5EPhRfuqsQ7kNvwEEo1ro&_nc_oc=AdpfeoaCdOlEhQVJswYjL2gLVzCNqyYkonv3rqhQLjyWi7OrS1kENESTyr16I8avgiM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYIvqO9ni__oUMuuN-MSrSknpPH8thzv0GGICnudWxWA&oe=6AF9BBB2"}, "is_concept": false, "is_test": false,
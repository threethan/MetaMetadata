GErbUUpAI4_GQLV6X4GhOULog&oe=6ABD18F1"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0rNMMEmEeIQ7kNvwHPKYqX&_nc_oc=AdrANOlplA_3y1sDe15GV1fqSTv0c2s8z2CX5AKY_V3O1Cp-EQ0as51SEAp_FaAqnGQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-LyVG3z_HmxcTSZ3p-pjHAuEz0Yil5Vlj_Zb3ekV3iw&oe=6ABD18E6"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KEWl3qSubWUQ7kNvwHljSvk&_nc_oc=AdpoFxhgjgwg3Pk2VMmImRG1EmS4Q8tkYHrR0K0cilJXhWJsn6LGBza2mvWRlEFL3oQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL5WD6QgHhrOOIXnZEtohfnXHu6swfWgqokj4XuF2Qe5g&oe=6ABD36D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "1681803443946887", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/593723055_1681803447280220_8554441312708257333_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R2FHweiwnJgQ7kNvwE8D7wL&_nc_oc=AdqtOwzApIX6hRdfDf3br4Ap6WxvfsyiikJ2EIukvpBtRtjSpayVLIqEacziDVefZfM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJUEpUS8kuKetYEvaTG9KH28hx2_2e7Wmu_3Yq6Xb_htw&oe=6ABD363D"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28800487359543532"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593749142_1753818512490755_7452645588454837950_n.png?stp=dst-png_s360x360&_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75Wlee9l2_sQ7kNvwHFueQn&_nc_oc=AdqipcrWSumz3tON3cROUmyhLx3If8XFDJr6-QQqZwfJKMNVc6DrmO0vQxO8UDyiXiA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInvz3x7N90JPdJZpNQnyjQdbVdWr7LKEFkMDe728CDrQ&oe=6ABD14F2"}, "is_concept": false, "is_test": false
9_Cc_HYF4l_ecshV25w5SJX8AakfjA&oe=6A6F5071"}, {"file_name": "metastore_bossfight.png", "id": "1438747767889060", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622325_1438747771222393_5176064760860400832_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tzX_d9MKufIQ7kNvwFnAQur&_nc_oc=AdqpsZhmQ-3U8m3Zk4E3Bnonqzvo3U3r_EfGosCzoBG7Vs1JHXna-XMMI_eP2Wlf8eQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4O5_kd5-aAbP4t1THYJfPdN1NfOA1b-3APYAT9FIA9w&oe=6A6F5066"}, {"file_name": "metastore_crab.png", "id": "1405913924560823", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499617831_1405913927894156_8983879103898694293_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tg2FBwOUE54Q7kNvwHHjm8-&_nc_oc=AdpGD3t9OCSH39JYGFWMGFZ_OMre6tZ21NM3ue2ZXkwpStZXml8HG22b2tHixGpUaFw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBvtTHrIFECnTwmO_cFcAnwLSThUxKy_z8ni_IGzGcEoQ&oe=6A6F3610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560x1440.png", "id": "980034831705714", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499625099_980034838372380_4321342989750387418_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=256zTa14iMwQ7kNvwEoprNj&_nc_oc=AdrWa5KeKfX4Dz5lKnHVoMOhL5NeMRM6xuQFCln4KiH7hVjtay6ItWWySI8zI6xpWdk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMIAjujZ9eInfV71RqB2RP26aoYeAACPgWBJu_dFaOug&oe=6A6F45F3"}, "display_name": "Shark Go", "keywords": ["shark", "monster", "pet", "fight", "riding"], "long_description": "# Join discord in [Discord.gg/SharkGo]\n\nShark GO is an underwater adventure game centered on riding, combat and customizable equipment. \n\n# \ud83e\udd88 Collect Sea Creatures\nCollect 70+ unique sea creatures, each with their own abilities and distinct appearances.\n{922018800468228}\n\n# \ud83e\ude9aCustom Equipment\nCollect 10+ completely free equipment items and assemble them in creative ways. Attach them at any angle to your sea creatures and build your own personalized combat mount.\n{1559842238447859}\n\n# \ud83c\udfca\u200d\u2640\ufe0fSwimming & Riding\nEnjoy full 360\u00b0 underwater movement and high-speed riding for a smooth and immersive experience.\n{1666190407718333}\n\n# \ud83d\udc12Friends & Challenges\nTeam up with friends to take on powerful sea monster bosses and explore more game modes together.\n\n{1456077149349643}", "short_description": "Collect, equip, and ride powerful creatures to battle ocean monsters!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.stealasigmon.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Sigmon VR", "support_website_url": null, "website_url": "https://www.stealasigmon.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "528142316460358"}, {"id": "2710427532541308"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "28189846740607600"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622276_1987975601842031_2376532585822133561_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azhfenlFymIQ7kNvwEF2tz6&_nc_oc=AdrCpTeKwldCcDBwUuFhVolXCJzJkDvpfQNmc_qYPZVl2_EFhbEPSYEpksrYDfEZYvE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD0PWPkVlnA2HUyYceKhsiBQ6Swds2I6NZieywaI3_TLg&oe=6A6F3846"}, "is_concept": false, "is_test": fa
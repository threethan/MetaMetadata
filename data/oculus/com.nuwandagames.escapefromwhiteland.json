0f&oh=00_AQR_H-afxbvuOSLSwa64dY9s8A3MT6ilh-YaTTBZajPBZw&oe=6B0DC495"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Escape from Whiteland", "keywords": ["VR", "ACTION", "PHYSICS", "COMBAT", "STEALTH"], "long_description": "ESCAPE FROM WHITELAND IS A PHYSICS-DRIVEN VR ACTION GAME BUILT AROUND IMMERSIVE COMBAT, STEALTH, PHYSICAL INTERACTION AND REALISTIC ENEMY REACTIONS.\nEVERY ENCOUNTER IS DESIGNED TO FEEL DYNAMIC. ENEMIES REACT TO WHERE AND HOW THEY ARE HIT, THEIR MOVEMENT AND COMBAT BEHAVIOR CHANGE DURING FIGHTS, AND THE WORLD IS BUILT TO ENCOURAGE CREATIVE USE OF WEAPONS, PHYSICS AND YOUR SURROUNDINGS.\nMOVE FREELY, CROUCH, CRAWL, CLIMB, USE STEALTH, ENGAGE IN CLOSE COMBAT OR RELY ON FIREARMS WHEN NECESSARY. YOUR ACTIONS MATTER, AND DIFFERENT SITUATIONS CAN BE APPROACHED IN DIFFERENT WAYS.\nESCAPE FROM WHITELAND IS CURRENTLY IN DEVELOPMENT. MORE LOCATIONS, SYSTEMS, ENEMIES AND GAMEPLAY FEATURES WILL BE REVEALED AS DEVELOPMENT CONTINUES.", "short_description": "ESCAPE FROM WHITELAND IS A PHYSICS-DRIVEN VR ACTION GAME FOCUSED ON IMMERSIVE COMBAT, REALISTIC ENEMY REACTIONS, STEALTH, WEAPONS AND FULL-BODY INTERACTION. FIGHT, ADAPT AND SURVIVE IN A HOSTILE WORLD BUILT AROUND PHYSICAL GAMEPLAY."}]}, "developer_name": "NUWANDA GAMES", "developer_privacy_policy_url": "https://sites.google.com/view/nuwanda-games-privacy/inicio", "developer_terms_of_service_url": null, "publisher_name": "NUWANDA GAMES", "support_website_url": null, "website_url": "https://www.youtube.com/@nuwandagames", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null,
7iHncBUVhFSksadO-pD1RbE7z3t1dKGvdQ&oe=6AF0AED3"}, {"file_name": "gal s2.png", "id": "3201204526801354", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57566693_3201204530134687_159926600682445557_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jw7a7kxtv_4Q7kNvwFD7wTi&_nc_oc=AdoTqgvQHq6Vq9OwpJ-JcdXEXfqm5BlggNikXlRAJzONA8Q6LPtAC_wuAVVmhqHvwjs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRzUxOz4ZuMN7oPAcAxSTClPI0f3HJmXPiUMTAdihuE_A&oe=6AF08932"}, {"file_name": "gal s3.png", "id": "587072519751187", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75282167_587072523084520_3713040805437607309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sR4HQNKZ0GMQ7kNvwH2xwg7&_nc_oc=AdrPmygxgXjd_pDhzwMnA4a2dIzZvoikhenbs_2OKSvxb3bdDwEZOB0YjFjVMh_TFl4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2YaBM2MiYwz92g0ao4RX6d-VGsatvIxu-zoIMASjilg&oe=6AF07F98"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gal s3.png", "id": "1514499102305455", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974629_1514499105638788_6769382629812589385_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hrtyP_JsUlAQ7kNvwFIAzy-&_nc_oc=AdoKLq-AdALpDl9GIkyWeFtMuvq1XK7gJwQ0wtHM2kCh0xt7ctPEGT1MxrgfvKp9PQc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmYt4SzYyrFowAl4sC1_XZuHuvRCgS4GxVRRvWOf6Zww&oe=6AF0A4B8"}, "display_name": "Pastel Gallery", "keywords": [], "long_description": "- Full gallery with over 300 pastel paintings from the award winning artist Dr. James Southworth\n- Beautiful paintings from around the world including beautiful countryside and urban locations in Europe, the Northwest USA and more (Oregon, Washington, France, Italy, Turkey)\n- Paintings include stunning landscapes and pastel colors, as well as cityscapes and people\n- Additional bonus paintings in pastel and other art mediums by Dr. Southworth and ZOSU\n- Includes mini-game to locate all of the artifacts\n- Includes bonus features with the ability to draw on a set of canvases and to be able to climb on most objects\n- Paintings scaled for maximum VR effectiveness\n- All paintings based on direct onsite inspiration of the painted content\n- Produced my solo indie hobby studios ZOSU Studios LLC", "short_description": "- Full gallery with over 300 pastel paintings from the award winning artist Dr. James Southworth\n- Beautiful paintings from around the world including beautiful locations in Europe the Northwest USA and more\n- Additional bonus paintings in pastel and other art mediums by Dr. Southworth and ZOSU\n- Includes mini-game to locate all of the artifacts\n- Includes bonus feature with ability to draw on a set of canvases\n- Produced my solo indie hobby studios ZOSU Studios LLC"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zosustudio.com/", "developer_terms_of_service_url": "http://www.zosustudio.com/", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "https://www.zosustudios.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1064214587538033"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "548198794889445"}, {"status": "PUBLISHED", "id": "443579020959607"}]}, "baseline_offer": {"id": "548198794889445"}, "is_approved": true, "first
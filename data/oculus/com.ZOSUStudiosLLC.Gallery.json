ent-iad3-1.oculuscdn.com/v/t64.5771-25/57566693_3201204530134687_159926600682445557_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=naR2CCOWvd8Q7kNvwFb5x9o&_nc_oc=AdpnaaPOmGy2SSsIfLAh2yhEy1_qWLf6uMWtBEKZPJO4oJnkVIPs2RMHLMB12uozRZM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBkv3EEz9NqNCvNmMusY_Rf714YmLHoXeBvTQw0irg5Q&oe=6AE4ABB2"}, {"file_name": "gal s3.png", "id": "587072519751187", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75282167_587072523084520_3713040805437607309_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DR7cK5Tyj3kQ7kNvwELzflK&_nc_oc=AdpirvdFZQKJYzMy7z7q-DE49z12RNIjPxT-Tf0kKHcDvx5LRs7BqgfMhd7quSc_eAg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMwDNQF2B2l_von6BCEFu7mJoXMn31lwobr9-lW7xq9RA&oe=6AE4A218"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "gal s3.png", "id": "1514499102305455", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974629_1514499105638788_6769382629812589385_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiKNkwrWMJEQ7kNvwGs9eQl&_nc_oc=AdqffjQaOQzNqGyQoGVADC9RnV1uF3XRZiYFzR3ZmPwHsn-LqVAbQD43Ui8sKGPjEcI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpc3Vca6VzNcpTp5_b38nbj5ldEhAJLNSxyJDP37Xg8g&oe=6AE48EF8"}, "display_name": "Pastel Gallery", "keywords": [], "long_description": "- Full gallery with over 300 pastel paintings from the award winning artist Dr. James Southworth\n- Beautiful paintings from around the world including beautiful countryside and urban locations in Europe, the Northwest USA and more (Oregon, Washington, France, Italy, Turkey)\n- Paintings include stunning landscapes and pastel colors, as well as cityscapes and people\n- Additional bonus paintings in pastel and other art mediums by Dr. Southworth and ZOSU\n- Includes mini-game to locate all of the artifacts\n- Includes bonus features with the ability to draw on a set of canvases and to be able to climb on most objects\n- Paintings scaled for maximum VR effectiveness\n- All paintings based on direct onsite inspiration of the painted content\n- Produced my solo indie hobby studios ZOSU Studios LLC", "short_description": "- Full gallery with over 300 pastel paintings from the award winning artist Dr. James Southworth\n- Beautiful paintings from around the world including beautiful locations in Europe the Northwest USA and more\n- Additional bonus paintings in pastel and other art mediums by Dr. Southworth and ZOSU\n- Includes mini-game to locate all of the artifacts\n- Includes bonus feature with ability to draw on a set of canvases\n- Produced my solo indie hobby studios ZOSU Studios LLC"}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.zosustudio.com/", "developer_terms_of_service_url": "http://www.zosustudio.com/", "publisher_name": "ZOSU Studios LLC", "support_website_url": null, "website_url": "https://www.zosustudios.com/", "category": "ENTERTAINMENT", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL", "ART_CREATIVITY"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1064214587538033"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "548198794889445"}, {"status": "PUBLISHED", "id": "443579020959607"}]}, "baseline_offer": {"id": "548198794889445"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1737107100, "status": "PUBLISHED", "id": "548198794889445"}]}, "liveChannel": {"nodes": [{"
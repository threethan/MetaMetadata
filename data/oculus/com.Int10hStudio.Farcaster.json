tent-ord5-2.oculuscdn.com/v/t64.5771-25/75340711_167902382484915_3235464187256375891_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6v6y1TT5F0Q7kNvwHJJYQy&_nc_oc=Adq6cgDgvB2-aBjcD1KJ-dcjf3cpxOJd-5sOuogOWTrzCjE8qp-0YRSFfRzGG-nMr1A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxpIziWPJ88QlYJbN5n3lQh7t-2h0duXk3zf9Rr8DqQg&oe=6AF897C3"}, {"file_name": "image_061_0000_1440.png", "id": "1569544130203050", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035394_1569544133536383_7373882074707570719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rpKDAmrDaQsQ7kNvwE8JFBT&_nc_oc=AdrjoI0LRrY8RSnFyJyYgtCHXqO5h5Q-zKkVs5RCVViXgxYfEn3vcg5SD_stmUk70UA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqtwOkWAHrI_2jte_j2JhO42q8UqJTzG-oWQO5gDN3qg&oe=6AF89BC9"}, {"file_name": "image_097_0008_1440.png", "id": "753134563188764", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/43931335_753134569855430_1758135874468232761_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKSSQBJDeu4Q7kNvwFtmHVD&_nc_oc=AdroYLuXdzhT7SqT2o37hLo8e-glL1A-paLpHUlBei5MNjfEUBM4iqdlGqD9xhGNPwc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTJaDSnn1aCg8h6k_XweLM6vxYjc8stAt-pHP-gCB56Ew&oe=6AF87690"}, {"file_name": "image_163_0005_1440.png", "id": "1144324952903724", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39035326_1144324956237057_3232583676580562193_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7v70l13WEbQQ7kNvwEftAYI&_nc_oc=Adr5J_FKJnjjA5sqSDgSG1tO6yDNlxw3dsNljuPlvwOILG__uWiv0NdNiLKwDrzF8E4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2duLpSx412K4snFu_DKPFJygxOuOQypOVoPFPwjXVpQ&oe=6AF87395"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "farcaster_logo_with_text_2560.png", "id": "570467751705243", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39001664_570467755038576_847966326999389405_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uRapQLcCXy4Q7kNvwFMSN0x&_nc_oc=AdqCzu0NQWVSnxFppuCDBh_Y4wOuc4RxXGMA0hHjDf1SMsXS7LSZ5mYaRiq_IV02iZA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTsKTZWWV2r3zNEbhtwyJTO-9OwmV-o_6sny6_Lc-Hr2A&oe=6AF87B0F"}, "display_name": "Farcaster", "keywords": ["shooter", "fps", "military", "scifi", "guns"], "long_description": "Farcaster is a game that seamlessly blends classic FPS gameplay with thrilling on rails action and wave shooters. With its immersive world, arcade vibe and addictive gameplay, it's the kind of game that will keep you coming back for more. So what are you waiting for? Strap on your headset and get ready to ride and fight your way through the worlds of Farcaster!\n{1564388484169497}\n{409978752166677}\nWelcome to Farcaster! the heart-pounding shooting game that puts you in the shoes of a quick-witted gunslinger on the run. In this thrilling adventure, you must navigate a series of action-packed worlds, battling enemies and dodging bullets and obstacles as you ride on a floating platform. But don't worry, you won't be alone in this fight: you'll have your deadly revolvers at your disposal, will you have the skills to use them to defeat your enemies?\n{1977480732763103}\n{8634517866595562}\n{358015070667064}\nNot only will you experience heart-pumping action as you ride on the floating platform through the Farcaster portals, but there are also times when you will get off the platform and engage in classic FPS gameplay. \nThese segments are crucial to advancing through the game's storyline and require you to use your skills to fight enemies and figure out how to progress across a range of different environments, from sprawling military bases to desolate wastelands, each with its own set of challenges. You'll have to use your wits to move through these environments, taking cover to avoid enemy fire and making split-second decisions as you take on the game's bosses.\n{896459549100224}\n", "short_description": "Farcaster is a game that seamlessly blends classic FPS gameplay with thrilling on rails action and wave shooters. Ride flying platforms or paraglides, shoot and kill enemies, dodge bullets from all directions, and run and climb through immersive military bases."}]}, "developer_name": null, "developer_privacy_policy_url": "https://int10hstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Int10h Studio", "support_website_url": null, "website_url": "https://int10hstudio.com/farcaster", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28671195655883830"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43997712_926577508784809_4716327228495571907_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MQuUpM7DU7kQ7kNvwF3hn2M&_nc_oc=AdpHPxaDUILW2Dk3XMZpzSmZxRewhjDZKdQeu3NGRxOBbuci9ZReNEsdpA0SPLIv5L4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTxXDFgx1aO0A6wZTeJpYkuiPgXGw6UXvwmrPsKRBMiFA&oe=6AF89C4A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Farcaster", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "15921929743
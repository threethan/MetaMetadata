tent-sea5-1.oculuscdn.com/v/t64.5771-25/75340711_167902382484915_3235464187256375891_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nj__KYKEHH0Q7kNvwFy2Rry&_nc_oc=AdpDsphlTJ9tnzQOF4kNE_LU3fbuoCLC27OjkLmhqUnBvXXY2sYDPUWA7nr63xk4k54&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSobWN63U58SJDim8yY6GRJQ0Qag5K52GuAOObD28MHhw&oe=6AF0AEC3"}, {"file_name": "image_061_0000_1440.png", "id": "1569544130203050", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035394_1569544133536383_7373882074707570719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-lbKg5wFEHEQ7kNvwG5b11Y&_nc_oc=AdpBBsvc5HyuOaV724t86vZqHWz28aLt1weznnvuI_T3Wbz1tmhv-yZ2YFMrhMesbPw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSE9ePAQlt9ZzhQzPBpMlngD_TMNls7h8Kmf6EMsN0WRA&oe=6AF0B2C9"}, {"file_name": "image_097_0008_1440.png", "id": "753134563188764", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/43931335_753134569855430_1758135874468232761_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GXlMJXh_A9wQ7kNvwEqMMWk&_nc_oc=Adr8Ja7LkiHy7KjYN2YZM32wU56MZ6Ufxu68grmVey08JeKl285nfRb7_b0keYdZOsw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRK17EJYn1YMOcZ6CHQsSjVc6a3paKQ_lf55WG3SEGNkQ&oe=6AF08D90"}, {"file_name": "image_163_0005_1440.png", "id": "1144324952903724", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39035326_1144324956237057_3232583676580562193_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yrU87JZp9OoQ7kNvwEiFIv0&_nc_oc=Adoqdecz347VQpnITLIl0B-d2hUPe0c5Mfd2VR5udU5hNbwp93GfHFvqdrMVCfeiPBE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaaRRzgCe507HkMZ9wHnbTW8kt9cuX-43w5BZkVOB8QA&oe=6AF08A95"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "farcaster_logo_with_text_2560.png", "id": "570467751705243", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39001664_570467755038576_847966326999389405_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xbS5G8rZWGkQ7kNvwF0ZaPS&_nc_oc=AdoZkxKBY_kCE9njVRb-1QtcWoeBkiu2imTgmzrW2IJrR5TRBhha6w3KVp3OpKjp1L4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTPvecqJdifS_UEQylwXcyuj_deIzOq1BL_Nl_Zk1OVuw&oe=6AF0920F"}, "display_name": "Farcaster", "keywords": ["shooter", "fps", "military", "scifi", "guns"], "long_description": "Farcaster is a game that seamlessly blends classic FPS gameplay with thrilling on rails action and wave shooters. With its immersive world, arcade vibe and addictive gameplay, it's the kind of game that will keep you coming back for more. So what are you waiting for? Strap on your headset and get ready to ride and fight your way through the worlds of Farcaster!\n{1564388484169497}\n{409978752166677}\nWelcome to Farcaster! the heart-pounding shooting game that puts you in the shoes of a quick-witted gunslinger on the run. In this thrilling adventure, you must navigate a series of action-packed worlds, battling enemies and dodging bullets and obstacles as you ride on a floating platform. But don't worry, you won't be alone in this fight: you'll have your deadly revolvers at your disposal, will you have the skills to use them to defeat your enemies?\n{1977480732763103}\n{8634517866595562}\n{358015070667064}\nNot only will you experience heart-pumping action as you ride on the floating platform through the Farcaster portals, but there are also times when you will get off the platform and engage in classic FPS gameplay. \nThese segments are crucial to advancing through the game's storyline and require you to use your skills to fight enemies and figure out how to progress across a range of different environments, from sprawling military bases to desolate wastelands, each with its own set of challenges. You'll have to use your wits to move through these environments, taking cover to avoid enemy fire and making split-second decisions as you take on the game's bosses.\n{896459549100224}\n", "short_description": "Farcaster is a game that seamlessly blends classic FPS gameplay with thrilling on rails action and wave shooters. Ride flying platforms or paraglides, shoot and kill enemies, dodge bullets from all directions, and run and climb through immersive military bases."}]}, "developer_name": null, "developer_privacy_policy_url": "https://int10hstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Int10h Studio", "support_website_url": null, "website_url": "https://int10hstudio.com/farcaster", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28671195655883830"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/43997712_926577508784809_4716327228495571907_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pCx8X74XAqIQ7kNvwGK6fts&_nc_oc=AdrAwAGkhUuZ2iz-M4hWdBCsGESjNAHdmhzK1WT8cn4iLAgMjQKpS54Z2amlFN9xMOY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQmjlQSilFp8Sep-w8ip0rz16rL7BEh6A9PGKg08BiVg&oe=6AF0B34A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Farcaster", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "15921929743
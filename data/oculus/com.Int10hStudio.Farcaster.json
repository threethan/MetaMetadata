G4fF4CS25mORMBKew_txKyRA&oe=6AFDB995"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "farcaster_logo_with_text_2560.png", "id": "570467751705243", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39001664_570467755038576_847966326999389405_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7yi23stkNowQ7kNvwGCiXhz&_nc_oc=AdqA0hLfLXc8MKtRVxPvtT9OPupW-on2gDYpbXEkPhQ9IP5CztdgB8S3swGJ8ARNvMw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9pyy0ErnR6hid6icvo5FXJlshLVIJoBEpvSNjjZzcDg&oe=6AFDC10F"}, "display_name": "Farcaster", "keywords": ["shooter", "fps", "military", "scifi", "guns"], "long_description": "Farcaster is a game that seamlessly blends classic FPS gameplay with thrilling on rails action and wave shooters. With its immersive world, arcade vibe and addictive gameplay, it's the kind of game that will keep you coming back for more. So what are you waiting for? Strap on your headset and get ready to ride and fight your way through the worlds of Farcaster!\n{1564388484169497}\n{409978752166677}\nWelcome to Farcaster! the heart-pounding shooting game that puts you in the shoes of a quick-witted gunslinger on the run. In this thrilling adventure, you must navigate a series of action-packed worlds, battling enemies and dodging bullets and obstacles as you ride on a floating platform. But don't worry, you won't be alone in this fight: you'll have your deadly revolvers at your disposal, will you have the skills to use them to defeat your enemies?\n{1977480732763103}\n{8634517866595562}\n{358015070667064}\nNot only will you experience heart-pumping action as you ride on the floating platform through the Farcaster portals, but there are also times when you will get off the platform and engage in classic FPS gameplay. \nThese segments are crucial to advancing through the game's storyline and require you to use your skills to fight enemies and figure out how to progress across a range of different environments, from sprawling military bases to desolate wastelands, each with its own set of challenges. You'll have to use your wits to move through these environments, taking cover to avoid enemy fire and making split-second decisions as you take on the game's bosses.\n{896459549100224}\n", "short_description": "Farcaster is a game that seamlessly blends classic FPS gameplay with thrilling on rails action and wave shooters. Ride flying platforms or paraglides, shoot and kill enemies, dodge bullets from all directions, and run and climb through immersive military bases."}]}, "developer_name": null, "developer_privacy_policy_url": "https://int10hstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Int10h Studio", "support_website_url": null, "website_url": "https://int10hstudio.com/farcaster", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28671195655883830"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43997712_926577508784809_4716327228495571907_n.png?stp=dst-png_s360x360&_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WCTDspPQeIgQ7kNvwEDlifv&_nc_oc=AdrgihqZQxlTLfK6NrUqZQHU6qyJTo7qSK62-aA2r1IYvs-hu7VKgMReU9nlEq0Du0w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f2
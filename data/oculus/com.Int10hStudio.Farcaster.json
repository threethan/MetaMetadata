tent-iad6-1.oculuscdn.com/v/t64.5771-25/75340711_167902382484915_3235464187256375891_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F7VbmrScOMgQ7kNvwGfxfEZ&_nc_oc=AdpOuARj4PTfyq9m6lKLeesxfrtgAZrQq6y6bxHEdsulwmugD24RS8rpKFWp5S12dqg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRnnk50SzDs4rz2wxYvtPuJiI5mqL3-ASVfnEzvh_tjzw&oe=6AF5F4C3"}, {"file_name": "image_061_0000_1440.png", "id": "1569544130203050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035394_1569544133536383_7373882074707570719_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bp09oOY0apYQ7kNvwF9kuvu&_nc_oc=AdqNx-N-4zPRM89dgDisSMZ0sqq34qFHGIFqluPOm9Yw5JlVXqGxEUAObmy66C5iHYs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuVySzj6Ovu25DpEgkC1PX5PohmtpGijT6Ohg0P2xXYg&oe=6AF5C089"}, {"file_name": "image_097_0008_1440.png", "id": "753134563188764", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/43931335_753134569855430_1758135874468232761_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mLxKObgZDGUQ7kNvwE0IBC6&_nc_oc=Adp1K-y3GOi1-E7Ou5rqfEN99ibta4aaOcy9VsISW5cQ-I77mctWdcx5aW3n-SM5smA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQRBgbzMHlSf0Z68Jkq9F1VslFHiFXqB0jcKAhaKuEYAA&oe=6AF5D390"}, {"file_name": "image_163_0005_1440.png", "id": "1144324952903724", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035326_1144324956237057_3232583676580562193_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6WuZFzbpaIQ7kNvwH4ZvDT&_nc_oc=AdpkpddjjswsbLLmffnQ8Sk4Swq_cfPuthhK32qKcmUmKbp0NTC6x6bGoGR9sQyEoDM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrf-8tXOKIaBs-d2MjtKpXfg4iytvg1zr7dKcFcAqqtA&oe=6AF5D095"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "farcaster_logo_with_text_2560.png", "id": "570467751705243", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39001664_570467755038576_847966326999389405_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eff_be6LGeIQ7kNvwHDWziS&_nc_oc=Adq_pBzytgLlHsAbE8ab5t0QWzcxAiWpQzbcUPocZ2JK_Y_ZgM85hliINJrhjpQjE3g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGd1bWfrevAA2bjgiBhIGgyrd5J2GB3gJrAubf_aR8aA&oe=6AF5D80F"}, "display_name": "Farcaster", "keywords": ["shooter", "fps", "military", "scifi", "guns"], "long_description": "Farcaster is a game that seamlessly blends classic FPS gameplay with thrilling on rails action and wave shooters. With its immersive world, arcade vibe and addictive gameplay, it's the kind of game that will keep you coming back for more. So what are you waiting for? Strap on your headset and get ready to ride and fight your way through the worlds of Farcaster!\n{1564388484169497}\n{409978752166677}\nWelcome to Farcaster! the heart-pounding shooting game that puts you in the shoes of a quick-witted gunslinger on the run. In this thrilling adventure, you must navigate a series of action-packed worlds, battling enemies and dodging bullets and obstacles as you ride on a floating platform. But don't worry, you won't be alone in this fight: you'll have your deadly revolvers at your disposal, will you have the skills to use them to defeat your enemies?\n{1977480732763103}\n{8634517866595562}\n{358015070667064}\nNot only will you experience heart-pumping action as you ride on the floating platform through the Farcaster portals, but there are also times when you will get off the platform and engage in classic FPS gameplay. \nThese segments are crucial to advancing through the game's storyline and require you to use your skills to fight enemies and figure out how to progress across a range of different environments, from sprawling military bases to desolate wastelands, each with its own set of challenges. You'll have to use your wits to move through these environments, taking cover to avoid enemy fire and making split-second decisions as you take on the game's bosses.\n{896459549100224}\n", "short_description": "Farcaster is a game that seamlessly blends classic FPS gameplay with thrilling on rails action and wave shooters. Ride flying platforms or paraglides, shoot and kill enemies, dodge bullets from all directions, and run and climb through immersive military bases."}]}, "developer_name": null, "developer_privacy_policy_url": "https://int10hstudio.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Int10h Studio", "support_website_url": null, "website_url": "https://int10hstudio.com/farcaster", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ARCADE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28671195655883830"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43997712_926577508784809_4716327228495571907_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zt5fmGlb2ZQQ7kNvwErMPi3&_nc_oc=AdpHqvVdjZNditIqWpRPidjNwZbUAE3QAAmAM9-ZOucGmdXV6IxzlR-yiUwfLDoZ2Qg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwt-HIy4SCZ2vGyktrMnxBOO9gs14Hm3LljS802lG0fA&oe=6AF5C10A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Farcaster", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_name": "Arcade", "id": "15921929743
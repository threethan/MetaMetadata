8_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wVW2j4fwGRkQ7kNvwEm-vLu&_nc_oc=AdoRZSDLzcwVQFiHfYoJfrWB7hgwQnzsVRAPT2nrfVEkO21tFZnJNsjj6ZTbJ8dx8as&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuefHml0zwn-0hQjC0aTfrNZqn8dOZUxIA3YNEduIZ9Q&oe=6AFEFFDA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1163584144222679", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38982476_1163584147556012_2610006929063235668_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LPyfuRS7pJMQ7kNvwGpwud0&_nc_oc=AdoRV7FFqqpBL4_i9S_DlhfpFm8ubekQtpPidlBFyzuojUKgWFoERIe15K39hCfhmX8&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtgAdgQi2grr5LSThrNHoSc5q-oLTL2VEYGFFvEUQqxA&oe=6AFF11A1"}, "display_name": "Slurpies FREE", "keywords": ["arcade", "casual", "multiplayer", "snake", "space"], "long_description": "How long can you grow your Space Slurpie? Relax in this free version of the multiplayer arcade game and control a colorful space snake with your hand. Chill out with your friends while collecting as much food as possible. The more you eat, the more the snake grows. Try not to run into other players or all kinds of playful baddies! With a calming Zen mode, multiplayer modifiers, and over 30 solo maps, there is a game mode for everyone to enjoy.", "short_description": "Snake, slither, SLURRPP! Chill out with your friends in this free multiplayer arcade game. Relax as you grow your colorful space snake by eating lots of food and avoiding playful baddies and other players. How long can you grow your Space Slurpie?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.starcadearcadellc.com/space-slurpies-privacy-policy", "developer_terms_of_service_url": "https://www.starcadearcadellc.com/space-slurpies-eula", "publisher_name": "Starcade Arcade LLC", "support_website_url": "https://www.starcadearcadellc.c
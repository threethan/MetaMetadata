8_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI-xgla8HMcQ7kNvwFi5vkX&_nc_oc=AdoExk-iORJFi82Gmc_iatlfU0DIpni7kGBHYSApqmu-Qm93ULF__Vc-kMdmhmAUexU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTB1uRhQBI6mZXOs722Ss2miYnyru29gN67yDqu7jm2_A&oe=6B032C9A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1163584144222679", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982476_1163584147556012_2610006929063235668_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ao238geWfYwQ7kNvwEq_emc&_nc_oc=Ado7DIY_TFPRv-b3bdzHlHEya0OX4F1XX-FriQkN0SILJUvX0BeEBcoJwR2N6qnHvbI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQiaMFcHWpyWFjhdzRJWDeAF_SgLRA-6UDpDpqefOaVCA&oe=6B030621"}, "display_name": "Slurpies FREE", "keywords": ["arcade", "casual", "multiplayer", "snake", "space"], "long_description": "How long can you grow your Space Slurpie? Relax in this free version of the multiplayer arcade game and control a colorful space snake with your hand. Chill out with your friends while collecting as much food as possible. The more you eat, the more the snake grows. Try not to run into other players or all kinds of playful baddies! With a calming Zen mode, multiplayer modifiers, and over 30 solo maps, there is a game mode for everyone to enjoy.", "short_description": "Snake, slither, SLURRPP! Chill out with your friends in this free multiplayer arcade game. Relax as you grow your colorful space snake by eating lots of food and avoiding playful baddies and other players. How long can you grow your Space Slurpie?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.starcadearcadellc.com/space-slurpies-privacy-policy", "developer_terms_of_service_url": "https://www.starcadearcadellc.com/space-slurpies-eula", "publisher_name": "Starcade Arcade LLC", "support_website_url": "https://www.starcadearcadellc.c
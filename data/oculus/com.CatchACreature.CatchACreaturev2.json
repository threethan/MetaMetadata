66487180_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9LzYx_B5V-cQ7kNvwGUrZKw&_nc_oc=AdpVgG47n4XJ4QsaqDmubLMvMnLQ7MBmNXaJAfv_OoW8hEzZr3tYgwQV6Q9V6tgF9Z0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwH9qHyFvX1n0YAQbtuIOyLvwsEIC9326jpo75K6PXZg&oe=6AA6C9EB"}, {"file_name": "New Project (11).png", "id": "814649671615466", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823757_814649688282131_289693061568935600_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol0zvCPbYLkQ7kNvwGRwP2-&_nc_oc=AdqrHLKGdOijPpmnsRI3lIEQveetUuoTU9iO7okk8gJV0d6tssX_k9O4lPwoH7JXKSY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7hCExJfA3u19ZuuubyJDG8kG80Ant_4Q1Q_mqKNrN7A&oe=6AA69D87"}, {"file_name": "New Project (8).png", "id": "28147845428141218", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823746_28147845448141216_5247229030507536820_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrhuDxjiRU0Q7kNvwGDiTPV&_nc_oc=AdpvEmr3PIYNnz2_RiFAN0Wjc73RzIqKQxpJiCfmHd5bgcqwZuWpE5wGo8Q-bhptREI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICRiOoZoJuCygLu8Lbm_GR4VW7ndNtAsijgLizDnpR8g&oe=6AA69426"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Catch A Creature", "keywords": ["CAC", "CatchACreature", "Monkey", "Gorilla"], "long_description": "Step into an exciting all-ages multiplayer creature-catching adventure built for Meta Quest 2, Quest 3, and Quest 3S! Explore a variety of colorful biomes filled with unique creatures waiting to be discovered. Use your net to catch creatures, level them up, trade them with other players, and battle against friends to become stronger and build the ultimate collection.\n\nEarn and collect Sticks, the in-game currency, to unlock awesome drip cosmetics and customize your style. From cool outfits to fun accessories, there are tons of cosmetics to collect and equip while hanging out with friends in public lobbies. Players can socialize, explore together, compete, and enjoy a fun and welcoming VR experience designed for all ages.\n\nWhether you want to become the best creature collector, trade rare finds, battle other players, or simply chill with friends, there\u2019s always something to do. Sticks can also be purchased with real money for players who want extra cosmetics and customization options.\n\nCreated by the amazing owners F1OW, Joshua, and Gbrayden, this game brings adventure, social fun, and creature collecting together in one immersive VR world.", "short_description": "Explore a fun all-ages creature-catching adventure on Meta Quest 2, Quest 3, and Quest 3S! Travel through unique biomes, catch and level up creatures with your net, battle and trade with friends, and unlock awesome drip cosmetics using Sticks, the in-game currency. Hang out in lobbies, meet new players, and enjoy endless adventures created by F1OW, Joshua, and Gbrayden."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vTo8XfIDNLFoZpq9Re6qDb6Mb2gK5fxPPF-yVAwfDutc7ySxxMWHvPwuXIxqtddTo1AMQg0TprLLyPs/pub", "developer_terms_of_service_url": null, "publisher_name": "F1ow", "support_website_url": null, "website_url": "https://guns.lol/catchacreature", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "37849894501276760"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status"
RPU1tNQa3cFoDT9LOi6XhgXiwuDZBRPDZMwWbiHHVtI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRS4euEY8bkbFLMNVpHkuXm1aVrxcNhVKWit9jx1mJ0Aw&oe=6B0DA591"}, {"file_name": "challenges.png", "id": "1487454572664419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_1487454575997752_1359098796122101900_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcgcncPVdDAQ7kNvwHIyzlH&_nc_oc=AdprqWjPOg5IUCBS6f59I6NPHQSW8kGiVAKaREjsJeSJ1A4YEM1zZSEtz2_A81mReZE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSKh9nAD8SK1bOFzhLiLF9f-IvKp8snPP1puAWEoEXXrw&oe=6B0D99AB"}, {"file_name": "painting.png", "id": "1649957736791575", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_1649957740124908_7746751873012354013_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bVU4cOGWkvMQ7kNvwHsxd9_&_nc_oc=AdoITzrfajNbt41ee6GfxfW_ObXlpICc09vtGnerIaRqGLj1oToVk42eiO_5-YgABuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQwGLrnaMMP0bnHYkUMMlBW_rUjTnWP4p3ri6y35vcltQ&oe=6B0DC6AB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wonderstructs-MetaCoverLandscape.png", "id": "1414272797066637", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619751_1414272800399970_7704222797003891838_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TOYtfCQPvb0Q7kNvwFbVzOs&_nc_oc=Adr8yPM1I423jYMP2DXF_6riqHlwIMNWt1mcs8eO4qbo5TSbxIQgD3Uxk5awrULpmM4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS8VKmsFjAbQHJMZG-uTyv0dah28T-ZwJ5d10FxTCRmxQ&oe=6B0DB83B"}, "display_name": "Wonderstructs", "keywords": ["sandbox", "puzzle", "simulation", "physics", "marble"], "long_description": "\nWonderstructs is a Mixed Reality application that lets you build massive, intricate rolling ball sculptures right in your own home! Drag and drop conveyors, track pieces, bowls, funnels, and switches from a virtual palette into your physical environment. The parts automatically snap together, making it easy to put together complex tracks that span your entire room.\n\n# Gallery Mode\n\nIn gallery mode, browse the built in sculptures or download sculptures others have made.\n\n# Challenge Mode\n\nIn challenge mode, select one of the built in sculptures and complete the sculpture by filling in the missing pieces.\n\n{1496463588438212}\n\n# Build Mode\n\nIn build mode, build your own sculpture by starting from scratch, or base your sculpture off of one of the included sculptures. Publish and share your creation with others!\n\n{2211439722943493}\n\n# Paint\n\nPaint your sculpture how you want.\n\n{1990261924934918}\n\n# Early Access and Roadmap\n\nThis is an early access release. The following features are still in development.\n\n* Configurable Conveyors: Allow conveyors speed to be adjusted.\n* Elevator: Cart that carries balls down and a counterweight brings the cart back to the top.\n* Rotating Arm With Hooks: Scoops up balls and carry them up.\n* Spatial Awareness: Place sculptures on walls and tables\n* Resizable Sculptures: Resize to fit your space\n* Co-located multiplayer: Work together in headsets on the same sculpture\n* More material choices for balls and parts\n\nWe are looking forward to your ideas as well to see how far we can take this to 1.0 and beyond!\n", "short_description": "Wonderstructs is a Mixed Reality app for building massive rolling ball sculptures in your home. Drag and drop parts from a virtual palette and snap them together.\n\nIn Gallery Mode browse and download sculptures.\n\nChallenge mode has you complete built-in sculptures by adding missing pieces.\n\nIn build mode create sculptures and share your unique creations with the community!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindfulgames.io/wonderstructs/privacy-policy", "developer_terms_of_service_url": "https://mindfulgames.io/wonderstructs/terms-of-service", "publisher_name": "Mindful Games", "support_website_url": null, "website_url": "https://mindfulgames.io/wonderstructs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "27808109982126512"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1646325310288921"}, {"status": "PUBLISHED", "id": "2156459171971105"}, {"status": "PUBLISHED", "id": "1012901334464847"}]}, "baseline_offer": {"id": "1012901334464847"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1797271200, "status": "PUBLISHED", "id": "1646325310288921"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "29167471699523660", "version": "0.9"}, "id": "2285736695240239", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25668967069374158", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "29167471699523660"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1795028625, "id": "29741134865490671", "version": "0.9", "version_code": 216, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_b
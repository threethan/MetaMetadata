699104570191889_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FnoBRqvG8QQ7kNvwEf1S3s&_nc_oc=Adq6y3uZHg7rQfDUd1BLGBYlnNijZ29ELyMeapaMKLKo6pTi8lCZ0k7qsY2YqYOr0kE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0TWmUeZD-548Fx1U7rWxTlXlGtARG0l0kbfgr2iIiHA&oe=6AA546D1"}, {"file_name": "challenges.png", "id": "1487454572664419", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622919_1487454575997752_1359098796122101900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8H_NFpnFHUQ7kNvwGrdTyT&_nc_oc=Adrq_jWKNqUDG4PQvFG8IlLuMSxz3lFL4Rm0iJjerCrlqnpwMGtQzTUOtAZgGmqq8Cw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3xn_hdHt7ZZvhELAf2LxfsqLsPSfY6XmqZWqzh92-Hw&oe=6AA5732B"}, {"file_name": "painting.png", "id": "1649957736791575", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_1649957740124908_7746751873012354013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_UaMpgGot0Q7kNvwEG32yP&_nc_oc=AdqriQOcpZMCXye0xLVk764Qs3gV77oULj3cWS6tRDYOauMJ1SbgPru5h2qAnVAcGL4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImVGe7yo87B8IxAjmxpVaS6kdpjwppVLXnm8OFo_m9TQ&oe=6AA567EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wonderstructs-MetaCoverLandscape.png", "id": "1414272797066637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1414272800399970_7704222797003891838_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74dFkqtM2vkQ7kNvwFS5BbE&_nc_oc=AdofBShQyzUD0CdybAczqF79aH4-UcOXyoh06uYQJ6EmRK8JpjjwbF7YJmxICPIZNWY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLuH6OCoQG-ICAIQUBlV430I2cjF7C_TsecvFTr6E380w&oe=6AA5597B"}, "display_name": "Wonderstructs", "keywords": ["simulation", "physics"], "long_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality application that lets you build intricate rolling ball sculptures right in your own home! Drag and drop conveyors, track pieces, bowls, funnels, and switches from a virtual palette into your physical environment.\n\n# Gallery Mode\n\nIn gallery mode, browse the built in sculptures or download sculptures others have made.\n{1554713779566082}\n\n# Challenge Mode\n\nIn challenge mode, select one of the built in sculptures and complete the sculpture by filling in the missing pieces.\n\n{1496463588438212}\n\n# Build Mode\n\nIn build mode, build your own sculpture by starting from scratch, or base your sculpture off of one of the included sculptures. Publish and share your creation with others!\n\n{2211439722943493}\n\n# Paint\n\nPaint your sculpture how you want.\n\n{1990261924934918}\n\n# Early Access and Roadmap\n\nThe following features are still in development.\n\n* Configurable Conveyors: Allow conveyors speed to be adjusted.\n* Elevator: Cart that carries balls down and a counterweight brings the cart back to the top.\n* Rotating Arm With Hooks: Scoops up balls and carry them up.\n* Spatial Awareness: Place sculptures on walls and tables\n* Resizable Sculptures: Resize to fit your space\n* Co-located multiplayer: Work together in headsets on the same sculpture\n* More material choices for balls and parts\n\nWe are looking forward to your ideas as well to see how far we can take this to 1.0 and beyond!", "short_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality app for building intricate rolling ball sculptures in your home. Drag and drop parts from a virtual palette and snap them together.\n\nIn Gallery Mode browse and download sculptures.\n\nChallenge mode has you complete built-in sculptures by adding missing pieces.\n\nIn build mode create sculptures and share your unique creations with the community!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindfulgames.io/wonderstructs/privacy-policy", "developer_terms_of_service_url": "https://mindfulgames.io/wonderstructs/terms-of-service",
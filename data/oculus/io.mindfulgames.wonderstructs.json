/t64.5771-25/499622919_1487454575997752_1359098796122101900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b285pwhGbbEQ7kNvwGwNKY1&_nc_oc=AdpkwDV1Mzib6VgTEGkAbU-QG4vsYXneAucv_2l_BLoX6_qGm4O74Yrhmme8Z4IK7dk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUDeHnHJztJGLZpkXshepIe5A9B2IcoJnnmF2xgoQBlw&oe=6AB7E82B"}, {"file_name": "painting.png", "id": "1649957736791575", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_1649957740124908_7746751873012354013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=og4mvEdP9uQQ7kNvwHb_iIn&_nc_oc=Adq44UvdipENd3YqPYGYPkhgvxbqJrnavvYAsk7ejUvTC0jqgrsfIvc3AX2ZS5v1R7c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOmCZ_nVr633ccahkFK4oJwcD4KQpOB9L4HI5s6KUIdQ&oe=6AB7DCEB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wonderstructs-MetaCoverLandscape.png", "id": "1414272797066637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_1414272800399970_7704222797003891838_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p00qLwpMPHUQ7kNvwH2Pcbp&_nc_oc=AdoLZJW9u7il7fyG6Zx9jNZh7dR5eR4e7QPCf6oU3z1dkPi3Mz3vLm0hYTC2y1Lexjk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJW1IrAnTueDyr2bvFS4agJRue06-ngDX-z6OAB_6_pwA&oe=6AB7CE7B"}, "display_name": "Wonderstructs", "keywords": ["simulation", "physics", "marble", "puzzle", "sandbox"], "long_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality application that lets you build intricate rolling ball sculptures right in your own home! Drag and drop conveyors, track pieces, bowls, funnels, and switches from a virtual palette into your physical environment.\n\n# Gallery Mode\n\nIn gallery mode, browse the built in sculptures or download sculptures others have made.\n{1554713779566082}\n\n# Puzzle Mode\n\nIn puzzle mode, select one of the built in sculptures and complete the sculpture by filling in the missing pieces.\n\n{1496463588438212}\n\n# Build Mode\n\nIn build mode, build your own sculpture by starting from scratch, or base your sculpture off of one of the included sculptures. Publish and share your creation with others!\n\n{2211439722943493}\n\n# Paint\n\nPaint your sculpture how you want.\n\n{1990261924934918}\n\n# Discord\n\nJoin the discord to see our future feature roadmap and submit your ideas! \n\nhttps://discord.gg/Pcu9sxwYUB\n\nWe are looking forward to your ideas as well to see how far we can take this to 1.0 and beyond!", "short_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality app for building intricate rolling ball sculptures in your home.\n\nIn Gallery Mode browse and download sculptures.\n\nPuzzle mode has you complete built-in sculptures by adding missing pieces.\n\nIn build mode create sculptures and share your unique creations with the community!\n\nJoin the discord to see our future feature roadmap: https://discord.gg/Pcu9sxwYUB"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindfulgames.io/wonderstructs/privacy-policy", "developer_terms_of_service_url": "https://mindfulgames.io/wonderstructs/terms-of-service", "publisher_name": "Mindful Games", "support_website_url": null, "website_url": "https://mindfulgames.io/wonderstructs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes"
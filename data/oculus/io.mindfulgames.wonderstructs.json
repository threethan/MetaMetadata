8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoTt88qNhYLwVGBZM0xqwS3Z39LdMTs07lRMP3BXzufA&oe=6B05BC91"}, {"file_name": "challenges.png", "id": "1487454572664419", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622919_1487454575997752_1359098796122101900_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D9B5El9dXKcQ7kNvwEi59E_&_nc_oc=AdrLzbsJ_4-yG4e11vPy4HS7qf8T1A0gHBUyklatkbDhjVeqhBQrpvQIJyRwrv_Zqbk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxhnLveNGfb54GZJwzwI3-X7MD91JAoN_w4VV8W8enPw&oe=6B05B0AB"}, {"file_name": "painting.png", "id": "1649957736791575", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_1649957740124908_7746751873012354013_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YESlTcpKIWMQ7kNvwEFGORN&_nc_oc=Adr6pdss2UVn_71Y5JhWHhGws3B4E-fv6nIbrtlb27vAWBkWqjaN8ROQD8wwD0LSt0s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1IKq6C5W1XOFUNQ-BMOZjdVNZ_0DnYdUsPGkkgaQv3w&oe=6B05A56B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wonderstructs-MetaCoverLandscape.png", "id": "1414272797066637", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619751_1414272800399970_7704222797003891838_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abWtYZhJBuYQ7kNvwHS8fEG&_nc_oc=Adr-gz0v3bukA5Hm03127eMzDZhaY-700cpr0aVKq2QhjhiS6jYhBtPEI8rANAkQeHk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSHMChWNhdHLsBOJrc1Se24wNrMid3o63lYNxfk4xtMUg&oe=6B05CF3B"}, "display_name": "Wonderstructs", "keywords": ["simulation", "physics", "marble", "puzzle", "sandbox"], "long_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality application that lets you build intricate rolling ball sculptures right in your own home! Drag and drop conveyors, track pieces, bowls, funnels, and switches from a virtual palette into your physical environment.\n\n# Gallery Mode\n\nIn gallery mode, browse the built in sculptures or download sculptures others have made.\n{1554713779566082}\n\n# Puzzle Mode\n\nIn puzzle mode, select one of the built in sculptures and complete the sculpture by filling in the missing pieces.\n\n{1496463588438212}\n\n# Build Mode\n\nIn build mode, build your own sculpture by starting from scratch, or base your sculpture off of one of the included sculptures. Publish and share your creation with others!\n\n{2211439722943493}\n\n# Paint\n\nPaint your sculpture how you want.\n\n{1990261924934918}\n\n# Discord\n\nJoin the discord to see our future feature roadmap and submit your ideas! \n\nhttps://discord.gg/Pcu9sxwYUB\n\nWe are looking forward to your ideas as well to see how far we can take this to 1.0 and beyond!", "short_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality app for building intricate rolling ball sculptures in your home.\n\nIn Gallery Mode browse and download sculptures.\n\nPuzzle mode has you complete built-in sculptures by adding missing pieces.\n\nIn build mode create sculptures and share your unique creations with the community!\n\nJoin the discord to see our future feature roadmap: https://discord.gg/Pcu9sxwYUB"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindfulgames.io/wonderstructs/privacy-policy", "developer_terms_of_service_url": "https://mindfulgames.io/wonderstructs/terms-of-service", "publisher_name": "Mindful Games", "support_website_url": null, "website_url": "https://mindfulgames.io/wonderstructs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
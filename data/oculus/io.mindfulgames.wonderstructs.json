580KrzFz1o1qecnjtviOAjA&oe=6ABD2E2B"}, {"file_name": "painting.png", "id": "1649957736791575", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619672_1649957740124908_7746751873012354013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LKtxraf5fxUQ7kNvwF8zZJz&_nc_oc=AdrmNZ0Bfxr48ZyeflXz9_WPbJcsLFEfRXtsUiKG24IO3Q252EfVumFu90W_w9naJBI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6z4xiBE0GmrCciqN3amtyzPpn7S7kyd1u1vsan4bLoA&oe=6ABD22EB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wonderstructs-MetaCoverLandscape.png", "id": "1414272797066637", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619751_1414272800399970_7704222797003891838_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nlaNWVQ5YfoQ7kNvwFe8q_y&_nc_oc=Adqx_Pfg9EHqBlOpcbEmyEhhY1CyuztJjyyg2zET-Yn8_cS9f12-Wk3jNgpsZws2tuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBHvr1UzdBNbc7o6rvmJOHQrEH0hfUB-wEELsNDuEKJQ&oe=6ABD147B"}, "display_name": "Wonderstructs", "keywords": ["sandbox", "puzzle", "simulation", "physics", "marble"], "long_description": "\nWonderstructs is a Mixed Reality application that lets you build massive, intricate rolling ball sculptures right in your own home! Drag and drop conveyors, track pieces, bowls, funnels, and switches from a virtual palette into your physical environment. The parts automatically snap together, making it easy to put together complex tracks that span your entire room.\n\n# Gallery Mode\n\nIn gallery mode, browse the built in sculptures or download sculptures others have made.\n\n# Challenge Mode\n\nIn challenge mode, select one of the built in sculptures and complete the sculpture by filling in the missing pieces.\n\n{1496463588438212}\n\n# Build Mode\n\nIn build mode, build your own sculpture by starting from scratch, or base your sculpture off of one of the included sculptures. Publish and share your creation with others!\n\n{2211439722943493}\n\n# Paint\n\nPaint your sculpture how you want.\n\n{1990261924934918}\n\n# Early Access and Roadmap\n\nThis is an early access release. The following features are still in development.\n\n* Configurable Conveyors: Allow conveyors speed to be adjusted.\n* Elevator: Cart that carries balls down and a counterweight brings the cart back to the top.\n* Rotating Arm With Hooks: Scoops up balls and carry them up.\n* Spatial Awareness: Place sculptures on walls and tables\n* Resizable Sculptures: Resize to fit your space\n* Co-located multiplayer: Work together in headsets on the same sculpture\n* More material choices for balls and parts\n\nWe are looking forward to your ideas as well to see how far we can take this to 1.0 and beyond!\n", "short_description": "Wonderstructs is a Mixed Reality app for building massive rolling ball sculptures in your home. Drag and drop parts from a virtual palette and snap them together.\n\nIn Gallery Mode browse and download sculptures.\n\nChallenge mode has you complete built-in sculptures by adding missing pieces.\n\nIn build mode create sculptures and share your unique creations with the community!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindfulgames.io/wonderstructs/privacy-policy", "developer_terms_of_service_url": "https://mindfulgames.io/wonderstructs/terms-of-service", "publisher_name": "Mindful Games", "support_website_url": null, "website_url": "https://mindfulgames.io/wonderstructs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": [
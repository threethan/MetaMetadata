699104570191889_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-FnoBRqvG8QQ7kNvwEvH7mM&_nc_oc=AdrsuLtqWLDFtF54bAgHFj6H8KsDLjohqwDnNCLc4o9yUxaB3AdEopRIRUEFBg31l8o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI27YL2KbhFCZ3EtWnI0FZ5PT3kUvwvwQ0FkkXXTI1g3A&oe=6AA69851"}, {"file_name": "challenges.png", "id": "1487454572664419", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622919_1487454575997752_1359098796122101900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8H_NFpnFHUQ7kNvwFEE48h&_nc_oc=Adqlv_EQ2uwamvDOjNQ9BwrnYuNXu9hHrX8SId5Sr-nLjgmtfdAqjS9RnEXazF5J8XQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKHBaWrwp4lje-tifTEjqT8G35htxDNgURWdEMaXjuYkQ&oe=6AA6C4AB"}, {"file_name": "painting.png", "id": "1649957736791575", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_1649957740124908_7746751873012354013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jRVdBrHItLcQ7kNvwF4gCnA&_nc_oc=AdoVWvAdVIdI42CSRVeHR8cXIyhwQzSdUpkqTNOADzA9Z7Uo1Mh4eI87bP7eAHwwpOM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNQpgWpTq-PJdwSLbmKxSkPiaNZriz73Cj4zoCvNUqbw&oe=6AA6B96B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wonderstructs-MetaCoverLandscape.png", "id": "1414272797066637", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619751_1414272800399970_7704222797003891838_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=74dFkqtM2vkQ7kNvwFmcD67&_nc_oc=AdqF9LBR8yL8uLz2bt7zL5DBQDPWWbObTdvIjhrXhhRIpxAVH6N9k-heRf7FvrllXoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1aRMnfBrk5dVTHqYwPBpxy0q7TnZVEdipi_Z8X8vUEQ&oe=6AA6AAFB"}, "display_name": "Wonderstructs", "keywords": ["simulation", "physics"], "long_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality application that lets you build intricate rolling ball sculptures right in your own home! Drag and drop conveyors, track pieces, bowls, funnels, and switches from a virtual palette into your physical environment.\n\n# Gallery Mode\n\nIn gallery mode, browse the built in sculptures or download sculptures others have made.\n{1554713779566082}\n\n# Challenge Mode\n\nIn challenge mode, select one of the built in sculptures and complete the sculpture by filling in the missing pieces.\n\n{1496463588438212}\n\n# Build Mode\n\nIn build mode, build your own sculpture by starting from scratch, or base your sculpture off of one of the included sculptures. Publish and share your creation with others!\n\n{2211439722943493}\n\n# Paint\n\nPaint your sculpture how you want.\n\n{1990261924934918}\n\n# Early Access and Roadmap\n\nThe following features are still in development.\n\n* Configurable Conveyors: Allow conveyors speed to be adjusted.\n* Elevator: Cart that carries balls down and a counterweight brings the cart back to the top.\n* Rotating Arm With Hooks: Scoops up balls and carry them up.\n* Spatial Awareness: Place sculptures on walls and tables\n* Resizable Sculptures: Resize to fit your space\n* Co-located multiplayer: Work together in headsets on the same sculpture\n* More material choices for balls and parts\n\nWe are looking forward to your ideas as well to see how far we can take this to 1.0 and beyond!", "short_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality app for building intricate rolling ball sculptures in your home. Drag and drop parts from a virtual palette and snap them together.\n\nIn Gallery Mode browse and download sculptures.\n\nChallenge mode has you complete built-in sculptures by adding missing pieces.\n\nIn build mode create sculptures and share your unique creations with the community!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindfulgames.io/wonderstructs/privacy-policy", "developer_terms_of_service_url": "https://mindfulgames.io/wonderstructs/terms-of-service",
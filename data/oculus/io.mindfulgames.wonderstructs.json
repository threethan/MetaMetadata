699104570191889_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5oUqROWwMesQ7kNvwF7uoM5&_nc_oc=AdqUqsyA8Ydp4uPBAwpu627WDQOadNTrDIqLvvGOEh_o-MV6Y10FEIbpzycjAoZxw7c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVsrAoI6DGKsTCNRlK_uc2D1OdickIrkdPShHYfkO8MA&oe=6AA15251"}, {"file_name": "challenges.png", "id": "1487454572664419", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499622919_1487454575997752_1359098796122101900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dHvZSLGs0ZUQ7kNvwGx-qmw&_nc_oc=AdpNYvfcA59S9Xu_HrYNgkkFDPSgYOeFPkPmZSJFV9Jj0lfpEi7SzK0yMWTsI-3qWv4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKY52d4nCncTk-RZ0XIe8wfYJlVPrrk4RFibWk-dYCNtQ&oe=6AA17EAB"}, {"file_name": "painting.png", "id": "1649957736791575", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619672_1649957740124908_7746751873012354013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2A4TooTVxkEQ7kNvwG-9O34&_nc_oc=AdrDxWu9-djLCrrgpZxXimZdlpHJSLAJ5w9yOTghnrmVnorDgMfdYRv9KllaJ3HGDoA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIb2zUr_9lGnyYDwc8d4Vp82nce9ufI3bbYbS-neOCSQ&oe=6AA1736B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wonderstructs-MetaCoverLandscape.png", "id": "1414272797066637", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619751_1414272800399970_7704222797003891838_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l-8CPchN4QkQ7kNvwG0tPt3&_nc_oc=AdqxdwvdHsKKaakMeLT_D_YWOWYNn-1xHD3CjFBxAcQtmLDnI8CtqXDpJKkw5pi3azE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRBqfKpaiGL6gu9ZBR06KqaPBpPGZUec-rd3ikDywO2g&oe=6AA164FB"}, "display_name": "Wonderstructs", "keywords": ["simulation", "physics"], "long_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality application that lets you build intricate rolling ball sculptures right in your own home! Drag and drop conveyors, track pieces, bowls, funnels, and switches from a virtual palette into your physical environment.\n\n# Gallery Mode\n\nIn gallery mode, browse the built in sculptures or download sculptures others have made.\n{1554713779566082}\n\n# Challenge Mode\n\nIn challenge mode, select one of the built in sculptures and complete the sculpture by filling in the missing pieces.\n\n{1496463588438212}\n\n# Build Mode\n\nIn build mode, build your own sculpture by starting from scratch, or base your sculpture off of one of the included sculptures. Publish and share your creation with others!\n\n{2211439722943493}\n\n# Paint\n\nPaint your sculpture how you want.\n\n{1990261924934918}\n\n# Early Access and Roadmap\n\nThe following features are still in development.\n\n* Configurable Conveyors: Allow conveyors speed to be adjusted.\n* Elevator: Cart that carries balls down and a counterweight brings the cart back to the top.\n* Rotating Arm With Hooks: Scoops up balls and carry them up.\n* Spatial Awareness: Place sculptures on walls and tables\n* Resizable Sculptures: Resize to fit your space\n* Co-located multiplayer: Work together in headsets on the same sculpture\n* More material choices for balls and parts\n\nWe are looking forward to your ideas as well to see how far we can take this to 1.0 and beyond!", "short_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality app for building intricate rolling ball sculptures in your home. Drag and drop parts from a virtual palette and snap them together.\n\nIn Gallery Mode browse and download sculptures.\n\nChallenge mode has you complete built-in sculptures by adding missing pieces.\n\nIn build mode create sculptures and share your unique creations with the community!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindfulgames.io/wonderstructs/privacy-policy", "developer_terms_of_service_url": "https://mindfulgames.io/wonderstructs/terms-of-service",
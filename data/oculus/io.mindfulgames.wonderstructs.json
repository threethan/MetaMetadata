c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPG9sDJoLEfbNnteOxx0qmixqyGbxsFGDJIKBuvB6Ehw&oe=6AFDD391"}, {"file_name": "challenges.png", "id": "1487454572664419", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622919_1487454575997752_1359098796122101900_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IS6hqv54cz8Q7kNvwEl0T2i&_nc_oc=Ado8jR3qVWF67mSlDEmPnPD5SC73fIzjOFyNInL3tVgdgFFGYCHvHh9ra5xxl16ZuuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRZXQCG76u49TD0NWavSkQ-Q8WWCkYAxYTNRSienUztqg&oe=6AFDC7AB"}, {"file_name": "painting.png", "id": "1649957736791575", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619672_1649957740124908_7746751873012354013_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=361JrnBOmNsQ7kNvwFEoRxH&_nc_oc=AdoxDtIjR0Cu2BFoqLY5qDw6x9hhZCGZ78diao8Kh9n_B2p9BOuWxAHvqT1Swb0TIJU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQTRllrWiKNsTU9BFYSkikUSchqjiwOtFZy6XmBh2POtw&oe=6AFDBC6B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wonderstructs-MetaCoverLandscape.png", "id": "1414272797066637", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499619751_1414272800399970_7704222797003891838_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vx3MV4-KQqoQ7kNvwGqlIW0&_nc_oc=AdoX2xlaBrGDRRwmqnp1QbltKFsyE6GDhJ_FXoGaBxijedaxbyyZCwrOxZ2-vL0xKR4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF_9qGy9JakoQ-k3SyXu57fkYdPPcsy9hgZxUXTzw3Ug&oe=6AFDADFB"}, "display_name": "Wonderstructs", "keywords": ["simulation", "physics", "marble", "puzzle", "sandbox"], "long_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality application that lets you build intricate rolling ball sculptures right in your own home! Drag and drop conveyors, track pieces, bowls, funnels, and switches from a virtual palette into your physical environment.\n\n# Gallery Mode\n\nIn gallery mode, browse the built in sculptures or download sculptures others have made.\n{1554713779566082}\n\n# Puzzle Mode\n\nIn puzzle mode, select one of the built in sculptures and complete the sculpture by filling in the missing pieces.\n\n{1496463588438212}\n\n# Build Mode\n\nIn build mode, build your own sculpture by starting from scratch, or base your sculpture off of one of the included sculptures. Publish and share your creation with others!\n\n{2211439722943493}\n\n# Paint\n\nPaint your sculpture how you want.\n\n{1990261924934918}\n\n# Discord\n\nJoin the discord to see our future feature roadmap and submit your ideas! \n\nhttps://discord.gg/Pcu9sxwYUB\n\nWe are looking forward to your ideas as well to see how far we can take this to 1.0 and beyond!", "short_description": "This is an early access release! We welcome your input and suggestions!\n\nWonderstructs is a Mixed Reality app for building intricate rolling ball sculptures in your home.\n\nIn Gallery Mode browse and download sculptures.\n\nPuzzle mode has you complete built-in sculptures by adding missing pieces.\n\nIn build mode create sculptures and share your unique creations with the community!\n\nJoin the discord to see our future feature roadmap: https://discord.gg/Pcu9sxwYUB"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindfulgames.io/wonderstructs/privacy-policy", "developer_terms_of_service_url": "https://mindfulgames.io/wonderstructs/terms-of-service", "publisher_name": "Mindful Games", "support_website_url": null, "website_url": "https://mindfulgames.io/wonderstructs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_are
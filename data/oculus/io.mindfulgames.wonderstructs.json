//scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620817_27478891398433599_27699104570191889_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BDXmbHS3tD4Q7kNvwHywd4h&_nc_oc=Adr-NlG0aUtiTf4ZqJSW_37cllj_kyASmoi6HLRgSAA2AwkazZiKo5HITJQLyvCtu3g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINzwOxJjRLZAsmMn8QPRPpj8rWemWZ9QpzTkhYsT4zsw&oe=6A9EAF51"}, {"file_name": "challenges.png", "id": "1487454572664419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622919_1487454575997752_1359098796122101900_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NNeiH4arccwQ7kNvwHuJY0g&_nc_oc=Adps6A3Fuj3qsn2lMCDeVtj9emhV-agsYdsqv-IZNbMeCBy7EoAGOs3DZ7G9PBsGoJE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9V3G7uFNmrQ_V6SxYs3d-jdKctXVLz1XC-Gki8RVZtQ&oe=6A9EDBAB"}, {"file_name": "painting.png", "id": "1649957736791575", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619672_1649957740124908_7746751873012354013_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2A4TooTVxkEQ7kNvwEZqZmJ&_nc_oc=AdqMMpNQ3WZfhk9_QZhhQYq4bWItSbmISaPHm2kSfNOVPyXuParI_8N-FC8hsWe4-NY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiS3lixSHWSqStSODXQEqLN6qSe_GwV0ANSAH8reEQog&oe=6A9ED06B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Wonderstructs-MetaCoverLandscape.png", "id": "1414272797066637", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619751_1414272800399970_7704222797003891838_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AMT5MN0zzzgQ7kNvwHZVe-L&_nc_oc=AdqQ44Mtm0HTUaosx7rdvVZ1WgEavWlYgi2UTftwRfqCBYsjfu4rj2hFr8ZwpCrvFJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLS-OePjxz_X8qRCpOKqgs3XSX4IHejW-bhcCBeHd51pw&oe=6A9EC1FB"}, "display_name": "Wonderstructs", "keywords": ["sandbox", "puzzle", "simulation", "physics", "marble"], "long_description": "\nWonderstructs is a Mixed Reality application that lets you build massive, intricate rolling ball sculptures right in your own home! Drag and drop conveyors, track pieces, bowls, funnels, and switches from a virtual palette into your physical environment. The parts automatically snap together, making it easy to put together complex tracks that span your entire room.\n\n# Gallery Mode\n\nIn gallery mode, browse the built in sculptures or download sculptures others have made.\n\n# Challenge Mode\n\nIn challenge mode, select one of the built in sculptures and complete the sculpture by filling in the missing pieces.\n\n{1496463588438212}\n\n# Build Mode\n\nIn build mode, build your own sculpture by starting from scratch, or base your sculpture off of one of the included sculptures. Publish and share your creation with others!\n\n{2211439722943493}\n\n# Paint\n\nPaint your sculpture how you want.\n\n{1990261924934918}\n\n# Early Access and Roadmap\n\nThis is an early access release. The following features are still in development.\n\n* Configurable Conveyors: Allow conveyors speed to be adjusted.\n* Elevator: Cart that carries balls down and a counterweight brings the cart back to the top.\n* Rotating Arm With Hooks: Scoops up balls and carry them up.\n* Spatial Awareness: Place sculptures on walls and tables\n* Resizable Sculptures: Resize to fit your space\n* Co-located multiplayer: Work together in headsets on the same sculpture\n* More material choices for balls and parts\n\nWe are looking forward to your ideas as well to see how far we can take this to 1.0 and beyond!\n", "short_description": "Wonderstructs is a Mixed Reality app for building massive rolling ball sculptures in your home. Drag and drop parts from a virtual palette and snap them together.\n\nIn Gallery Mode browse and download sculptures.\n\nChallenge mode has you complete built-in sculptures by adding missing pieces.\n\nIn build mode create sculptures and share your unique creations with the community!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://mindfulgames.io/wonderstructs/privacy-policy", "developer_terms_of_service_url": "https://mindfulgames.io/wonderstructs/terms-of-service", "publisher_name": "Mindful Games", "support_website_url": null, "website_url": "https://mindfulgames.io/wonderstructs", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "27808109982126512"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "2156459171971105"}, {"status": "PUBLISHED", "id": "1012901334464847"}]}, "baseline_offer": {"id": "1012901334464847"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792774800, "status": "PUBLISHED", "id": "2156459171971105"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28568378542766315", "version": "0.5"}, "id": "2285736695240239", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "25668967069374158", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28568378542766315"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2285736695240239"}]}, "change_log": null, "created_date": 1787712760, "id": "28568378542766315", "version": "0.5", 
s-RqlakNz4ef9gBUQ&oe=6A7EFAB3"}, {"file_name": "Screenshot_02.png", "id": "779247987510888", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982716_779247997510887_8957427737899856742_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpQXZbvcSn8Q7kNvwFXltMC&_nc_oc=AdqGd3heJ8UvO_s9_qFqIA65S3-UMqeUcM5QRAezjd67UIoYZr94uHni-Ua3290lfbU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDq3xiIZaE8cAvCNzwdI8qO0IMP_T-FHPsFoZ34_FiKw&oe=6A7F0431"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_EN_2560x1440_new_BW_glow.png", "id": "447444668000576", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39036681_447444671333909_79004351879861573_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zlWYc4lbuMMQ7kNvwFPZSYY&_nc_oc=AdoU3KTfUMSpJknwq_dbn-jj5p24dHxcPoaL89DnjTGF5NBuZ_W-XHzDitn9GwYzr9I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwWDa6b7Ej1ST0DdG2TYBjgdZLKBzYv3EBqDuXGfb8-w&oe=6A7EFE9C"}, "display_name": "Laser Dance", "keywords": ["laser", "mr", "party", "action", "lazer"], "long_description": "From the creator of Cubism comes LASER DANCE, a mixed reality game that turns your living room into a laser obstacle course straight from a spy film!\n\nPlayers move between two buttons on opposite ends of their living room, traversing a sequence of laser patterns which adapt to the room\u2019s size and layout. Different laser patterns will have them move in different ways, as they dance, dodge, and crawl their way to the finish line.\n\nEasy to learn but hard to master - Laser Dance\u2019s deceptively simple gameplay makes for a perfect party game to get both newcomers and seasoned VR players moving in mixed reality!\n", "short_description": "LASER DANCE is a mixed reality game that turns your living room into a laser obstacle course. Dance, dodge, and crawl your way to victory in this intuitive party game that's perfect for both newcomers and seasoned gamers! "}]}, "developer_name": null, "dev
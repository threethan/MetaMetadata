Snt-Fbjjuyg&oe=6A884C43"}, {"file_name": "Screenshot_05.png", "id": "664187566473060", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/473391890_664187569806393_9111774395775014092_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjcmGRvsyQsQ7kNvwFW7Hjc&_nc_oc=AdrmTRY_j_VTbx_u6V-ajr-UuIfQRzycUrvsF5alrUe3mXrjC0tVZ84VCCk-n7YvRk4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEhEKIko8XwFvih2ZUWaItiDJ-Sn4hns-213HcWznX05g&oe=6A88235C"}, {"file_name": "Screenshot_03.png", "id": "981935654115371", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473391890_981935657448704_307157377739897106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7u98MzEnQ4sQ7kNvwECWw63&_nc_oc=AdoEfEljZTr5a0mI5L0MDv4RNF-4N3Am1R51jZOAI-hBM1rAfe3a-GPJcLs6VSrBETQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGp21LWtZNw6G6Cbld_X034CmOUQd63t8olLFZNFJ-7Jw&oe=6A88215F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_EN_2560x1440.png", "id": "722150633503085", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820496_722150636836418_2049878435011383833_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SeRhIuER9n4Q7kNvwGDZfyV&_nc_oc=AdqVytMfkRLvqDQ9Mmg8yDkViSk9hNz8Ke5z2ybbg73KIm-jbjmSMJP5TpHnSMjudqM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFchuQbPvSp81eLYIX_pRPBxk5CPis3GFbP20X5W4yf_Q&oe=6A88248F"}, "display_name": "Laser Dance", "keywords": ["laser", "mr", "party", "action", "lazer"], "long_description": "                                                                                                                           \n**[NEW] Mimic Update: 6 new levels with a new laser that moves when you move!**\n\nFrom the creator of Cubism comes **LASER DANCE**, a mixed reality game that turns your living room into a laser obstacle course straight from a spy film!\n\n{2852105388322782}\n\n# Play in any room\n\nPlayers move between two buttons on opposite ends of their living room, traversing a sequence of laser patterns which adapt to the room\u2019s size and layout. Different laser patterns will have them move in different ways, as they dance, dodge, and crawl their way to the finish line.\n\n{1666431438080748}\n\n# Easy to learn, hard to master\n\nLaser Dance\u2019s deceptively simple gameplay makes for a perfect party game to get both newcomers and seasoned VR players moving in mixed reality!\n\n{466159999918888}\n\n# [NEW] Mimic Update\n\nSix new levels with a new laser that only moves when you move!\n\n{3213097608877239}\n\n# Early Access features:\n- \ud83d\udd7a 24 levels containing 118 unique laser patterns\n- \u2194\ufe0f Levels adapt to your living room size and layout\n- \ud83d\udc74 Levels adapt to your level of mobility with accessibility settings\n- \ud83c\udfc6 Unlockable challenges that will have you playing old levels in new ways\n- \u2728 And more to come during Early Access!\n\n{2784601745066105}\n\n# FAQ\n**Do I need a big room?**\n\nLaser Dance is played between two buttons on your walls. As long as the shortest path between them is about 3m (~10ft) you're good to go!\n\n**How is my body tracked?**\n\nLaser Dance supports Quest's inside-out upper body tracking - meaning head, hands, arms and spine are tracked. Legs are not tracked.\n\n**Where can I get help with a technical issue?**\n\nwww.LaserDanceGame.com/help", "short_description": "LASER DANCE is a mixed reality game that turns your living room into a laser obstacle course. Dance, dodge, and crawl your way to victory in this intuitive party game that's perfect for both newcomers and seasoned gamers! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://laserdancegame.com/privacypolicy/", "developer_terms_of_service_url": "https://laserdancegame.com/terms/", "publisher_name": "Vanbo BV", "support_website_url": null, "website_url": "https://laserdancegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_cat
982716_779247997510887_8957427737899856742_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xlv3e38ojJ4Q7kNvwEbpQ9-&_nc_oc=AdkT_6ludlfG4sHnXV9_u6zhfnJFseBaAVKmQmzGlDcqXE_IZ5KNIqCX9uvR1SHoKZw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Afsg_uakoyMb7Gh22p4Sl_khz4TRAkiWBnVKM9JjPcaUvQ&oe=69A57CB1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_EN_2560x1440_new_BW_glow.png", "id": "447444668000576", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39036681_447444671333909_79004351879861573_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eENK3xTC-lEQ7kNvwEVPLFh&_nc_oc=AdliVapf7B-IpIVXBK1DmBW5EzqlW93Cups8dcEQ_tySPbPR_v6xwTdP7uUv6MEtzjc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AftBnZevn7hpTreudaWSvYrj7vn4QbUewzEKdQi6DGkiXg&oe=69A5771C"}, "display_name": "Laser Dance", "keywords": ["laser", "mr", "party", "action", "lazer"], "long_description": "From the creator of Cubism comes LASER DANCE, a mixed reality game that turns your living room into a laser obstacle course straight from a spy film!\n\nPlayers move between two buttons on opposite ends of their living room, traversing a sequence of laser patterns which adapt to the room\u2019s size and layout. Different laser patterns will have them move in different ways, as they dance, dodge, and crawl their way to the finish line.\n\nEasy to learn but hard to master - Laser Dance\u2019s deceptively simple gameplay makes for a perfect party game to get both newcomers and seasoned VR players moving in mixed reality!\n", "short_description": "LASER DANCE is a mixed reality game that turns your living room into a laser obstacle course. Dance, dodge, and crawl your way to victory in this intuitive party game that's perfect for both newcomers and seasoned gamers! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://laserdancegame.com/privacypolicy/", "developer_terms_of_service_url": "https://laserdancegame.com/termsandconditions/", "publisher_name": "Vanbo BV", "support_website_url": null, "website_url": "https://laserdancegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7209598122466981"}}]}, "scheduled_offers": {"count": 6, "nodes": [{"status": "PUBLISHED", "id": "1444090227386245"}, {"status": "PUBLISHED", "id": "1563692691541171"}, {"status": "PUBLISHED", "id": "1193836215410734"}, {"status": "PUBLISHED", "id": "1817035508931817"}, {"status": "PUBLISHED", "id": "2742679549397018"}, {"status": "PUBLISHED", "id": "1347922466945252"}]}, "baseline_offer": {"id": "2742679549397018"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1773421200, "status": "PUBLISHED", "id": "1444090227386245"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25626190780381102", "version": "0.12.20"}, "id": "787111759958699", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7209598115800315", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25626190780381102"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1772052426, "id": "26004064149260428", "version": "0.13
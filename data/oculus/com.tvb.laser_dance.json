dI4PC63YVbw&oe=6A899DC3"}, {"file_name": "Screenshot_05.png", "id": "664187566473060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391890_664187569806393_9111774395775014092_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BjcmGRvsyQsQ7kNvwEh9hpi&_nc_oc=AdqVd2W8DTNZyXMGI8ZIrDT44aMVwY5UCHNtvraCJHjjxCjAvuboXGnOYW9n9MJROJw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEay1cF94SlOZqzVfCscGUmVOLzALoDJ-wyp9iTQF3zfw&oe=6A8974DC"}, {"file_name": "Screenshot_03.png", "id": "981935654115371", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391890_981935657448704_307157377739897106_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7u98MzEnQ4sQ7kNvwG2U4H_&_nc_oc=AdqN-bR9hzZobL1Hxp1NefsHgvLegzh36-AJaRJOGjU9t5r-v4Ies6sJrLmBPw6FwGI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEL8g49f96klfV5Zzv1TzXeNeDThiMcuoS6T-d7LAEpwg&oe=6A8972DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_EN_2560x1440.png", "id": "722150633503085", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820496_722150636836418_2049878435011383833_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_7b9WRuHKygQ7kNvwGN7Ttr&_nc_oc=AdqNBaqXUH5pT9BJVfpDofZbqG5kEtA4aMupfRxLnZPmdJ_NpcAUINSshdfqxFTTGW8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUKsOfDkhyWlqaYayoFCcPsKjmMesnNhOJ6wc-OS0shw&oe=6A89760F"}, "display_name": "Laser Dance", "keywords": ["laser", "mr", "party", "action", "lazer"], "long_description": "                                                                                                                           \n**[NEW] Mimic Update: 6 new levels with a new laser that moves when you move!**\n\nFrom the creator of Cubism comes **LASER DANCE**, a mixed reality game that turns your living room into a laser obstacle course straight from a spy film!\n\n{2852105388322782}\n\n# Play in any room\n\nPlayers move between two buttons on opposite ends of their living room, traversing a sequence of laser patterns which adapt to the room\u2019s size and layout. Different laser patterns will have them move in different ways, as they dance, dodge, and crawl their way to the finish line.\n\n{1666431438080748}\n\n# Easy to learn, hard to master\n\nLaser Dance\u2019s deceptively simple gameplay makes for a perfect party game to get both newcomers and seasoned VR players moving in mixed reality!\n\n{466159999918888}\n\n# [NEW] Mimic Update\n\nSix new levels with a new laser that only moves when you move!\n\n{3213097608877239}\n\n# Early Access features:\n- \ud83d\udd7a 24 levels containing 118 unique laser patterns\n- \u2194\ufe0f Levels adapt to your living room size and layout\n- \ud83d\udc74 Levels adapt to your level of mobility with accessibility settings\n- \ud83c\udfc6 Unlockable challenges that will have you playing old levels in new ways\n- \u2728 And more to come during Early Access!\n\n{2784601745066105}\n\n# FAQ\n**Do I need a big room?**\n\nLaser Dance is played between two buttons on your walls. As long as the shortest path between them is about 3m (~10ft) you're good to go!\n\n**How is my body tracked?**\n\nLaser Dance supports Quest's inside-out upper body tracking - meaning head, hands, arms and spine are tracked. Legs are not tracked.\n\n**Where can I get help with a technical issue?**\n\nwww.LaserDanceGame.com/help", "short_description": "LASER DANCE is a mixed reality game that turns your living room into a laser obstacle course. Dance, dodge, and crawl your way to victory in this intuitive party game that's perfect for both newcomers and seasoned gamers! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://laserdancegame.com/privacypolicy/", "developer_terms_of_service_url": "https://laserdancegame.com/terms/", "publisher_name": "Vanbo BV", "support_website_url": null, "website_url": "https://laserdancegame.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_cat
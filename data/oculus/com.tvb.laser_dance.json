bqcBG49f8X-_Epr3A&oe=6A819DB3"}, {"file_name": "Screenshot_02.png", "id": "779247987510888", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982716_779247997510887_8957427737899856742_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KpQXZbvcSn8Q7kNvwGokrtn&_nc_oc=AdqjOFE2fbJSCGsl--NRSpIiVMd7FKNxHsHUgGTmXqy_eEfkrhXwHOXNGs-9XsHSbtc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEUTXiBc8oJC19LhPSYyymvP2rtVzK--fszFz8YRqwQSg&oe=6A81A731"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_EN_2560x1440_new_BW_glow.png", "id": "447444668000576", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39036681_447444671333909_79004351879861573_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75HQuOoroFYQ7kNvwEbMiuF&_nc_oc=Adp_p6-tfXLF1lUvQWjEzH590Eb7VqyYugDzQO4Qupwd6ggmL9PkeuQh26rTB0K6sYs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWlw2T6A-7WsA7vtXYcDLOYzp4Dj7GfsDvsYqs15Kffw&oe=6A81A19C"}, "display_name": "Laser Dance", "keywords": ["laser", "mr", "party", "action", "lazer"], "long_description": "From the creator of Cubism comes LASER DANCE, a mixed reality game that turns your living room into a laser obstacle course straight from a spy film!\n\nPlayers move between two buttons on opposite ends of their living room, traversing a sequence of laser patterns which adapt to the room\u2019s size and layout. Different laser patterns will have them move in different ways, as they dance, dodge, and crawl their way to the finish line.\n\nEasy to learn but hard to master - Laser Dance\u2019s deceptively simple gameplay makes for a perfect party game to get both newcomers and seasoned VR players moving in mixed reality!\n", "short_description": "LASER DANCE is a mixed reality game that turns your living room into a laser obstacle course. Dance, dodge, and crawl your way to victory in this intuitive party game that's perfect for both newcomers and seasoned gamers! "}]}, "developer_name": null, "dev
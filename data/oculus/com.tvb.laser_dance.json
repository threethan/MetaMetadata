FCuXXQXW52UvRaXjGg&oe=6AF093F3"}, {"file_name": "Screenshot_02.png", "id": "779247987510888", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982716_779247997510887_8957427737899856742_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D0fJ2aYtYvYQ7kNvwFcaqq7&_nc_oc=AdqqhLWZoUalDAcZ9n5bw7JC3TPREQnzEkeCG86I1w76cmq2y0mJ-tEIhe5oKq_cV2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLQRi_xOLLkm_4OPznfArWYpHrk3xnLZ2glCo8B6UGnQ&oe=6AF09D71"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_EN_2560x1440_new_BW_glow.png", "id": "447444668000576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39036681_447444671333909_79004351879861573_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Mx90vIiwbEQ7kNvwF5S_ha&_nc_oc=AdpkKJPtqSrVJqD89niXA4n9igwF6iMRzwta13IUDuJqies2qUJt5dEz9HYnwkCwGwI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQVGJeX8cCYbp0RTReDVZ223hEiwYVCWKNYsszO6NV0aQ&oe=6AF097DC"}, "display_name": "Laser Dance", "keywords": ["laser", "mr", "party", "action", "lazer"], "long_description": "From the creator of Cubism comes LASER DANCE, a mixed reality game that turns your living room into a laser obstacle course straight from a spy film!\n\nPlayers move between two buttons on opposite ends of their living room, traversing a sequence of laser patterns which adapt to the room\u2019s size and layout. Different laser patterns will have them move in different ways, as they dance, dodge, and crawl their way to the finish line.\n\nEasy to learn but hard to master - Laser Dance\u2019s deceptively simple gameplay makes for a perfect party game to get both newcomers and seasoned VR players moving in mixed reality!\n", "short_description": "LASER DANCE is a mixed reality game that turns your living room into a laser obstacle course. Dance, dodge, and crawl your way to victory in this intuitive party game that's perfect for both newcomers and seasoned gamers! "}]}, "developer_name": null, "de
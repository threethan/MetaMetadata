982716_779247997510887_8957427737899856742_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_GDwaVdfIQQ7kNvwHeYvLm&_nc_oc=AdlYymzwGa7mOOZjUHXapTkxqTR7X3reah7VmQJmeGsRO3ChRPNHySnrF3qpnDjRv0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu7GP323UIltxERqmv1_CKQ8wdKcQyT7zSr2iySZAQoyA&oe=699EE531"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape_EN_2560x1440_new_BW_glow.png", "id": "447444668000576", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39036681_447444671333909_79004351879861573_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2f9fOs87GcQ7kNvwGlqpV7&_nc_oc=AdmlJAXHGm41D4z0ZRk_KDsV2UagNB9aeJ-Krp565F2VWRyq0OGocOGrWtxhpff0Woo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsmXUerooBCX27A-Z4BTx4iUE8Cv4C8wyB59EmBaM8VVw&oe=699EDF9C"}, "display_name": "Laser Dance", "keywords": ["laser", "mr", "party", "action", "lazer"], "long_description": "From the creator of Cubism comes LASER DANCE, a mixed reality game that turns your living room into a laser obstacle course straight from a spy film!\n\nPlayers move between two buttons on opposite ends of their living room, traversing a sequence of laser patterns which adapt to the room\u2019s size and layout. Different laser patterns will have them move in different ways, as they dance, dodge, and crawl their way to the finish line.\n\nEasy to learn but hard to master - Laser Dance\u2019s deceptively simple gameplay makes for a perfect party game to get both newcomers and seasoned VR players moving in mixed reality!\n", "short_description": "LASER DANCE is a mixed reality game that turns your living room into a laser obstacle course. Dance, dodge, and crawl your way to victory in this intuitive party game that's perfect for both newcomers and seasoned gamers! "}]}, "developer_name": null, "developer_privacy_policy_url": "https://laserdancegame.com/privacypolicy/", "developer_terms_of_service_url": "https://laserdancegame.com/termsandconditions/", "publisher_name": "Vanbo
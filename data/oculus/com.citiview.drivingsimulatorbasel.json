.com/v/t64.5771-25/499303707_1087413577420716_7026375691870959522_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ztyMwGaJykQ7kNvwEeQ_lg&_nc_oc=Adr26HM2Af7PTP8MLUoI3jlAkLm0d1hclYX_r7JZN7Oa-mvvs1gTc2XoOAT2Gr5V_dg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEFxnxdwAqf-1gJxnJderrkLCgPYi2QH4T0pvTrDPiPg&oe=6AFDC396"}]}, "id": "1854303506014835", "locale": "en_US", "screenshots": [{"file_name": "screenshot_1.png", "id": "2074747453169297", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499303976_2074747456502630_1176608506117051799_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WRInXXOWyOAQ7kNvwGWxHXD&_nc_oc=Adpi4BUwBbW03xNC-jV_dCfX-UERIinuusYNHT4j2btpjMdVaI8T03_1eF4TNeDLIbE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQp6TCXzZVNVHqd3TfvuchRqH7Hj9K-xIeaw5XINe5RcQ&oe=6AFDCD8E"}, {"file_name": "screenshot_3.png", "id": "2093604127926111", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307444_2093604131259444_7415810052093807355_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8CyvL8SdKPQQ7kNvwG-X35M&_nc_oc=AdrKMDHOcv5wfeyAyckQlsbmhtBj9jsykaIo926rFLjFPKO_AffdWtKWweYIxljMAT0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQmTpP1iPNPmJGLjpR6ZJFL9FcpeV_vWp4TyqKaKAOn5w&oe=6AFDD0E1"}, {"file_name": "screenshot_2.png", "id": "1435754891982047", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312338_1435754895315380_6438687017938126141_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N47-2O0yuYMQ7kNvwE10l8F&_nc_oc=Ados-lsvAcyh8sKersw1OEA51725dzPF6xZbC6zmYTNuTK6fmtI34-3wLdUuf_UMET0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQScsrnLiHmIhAWjgKf6ZTQ8mB7m_pLDgbyOGwHQJwEY7A&oe=6AFDCE50"}, {"file_name": "screenshot_4.png", "id": "3325442937643717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499307303_3325442940977050_7305818163554035649_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRdx0gfu6b0Q7kNvwE5lcse&_nc_oc=Adq2-h9O-G_Z7Bwg7lOuzPv2tl5x7MogGMLtsWtRVliMui59mUJSfdn0f14QkODjy94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ35vlmHeo96kx4oZKj9tyU2099Asinm6-FNjfjI3hGTg&oe=6AFDB802"}, {"file_name": "screenshot_5.png", "id": "1127498006687774", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499313069_1127498013354440_6760642118093902109_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iEeqfokqqHkQ7kNvwFjMul1&_nc_oc=AdoR-qire2HcYJYAW1OZNq8CjE8mTjz9jEokkINPbWmX6z5nmvSMHEus0r2axNc9E7Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcWDL52MOB1-wcbxnyLtfHXKWY7h-l3LsNT3EKKZxMpA&oe=6AFDBF77"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "3709085042573155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499307444_3709085045906488_1528944297026215628_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0qSZpd1OFEQ7kNvwHmjey-&_nc_oc=AdoNwVEMuYH5EbYFBOSGbftVqXHhf9mBDTmJT2JQ-1hTs6WKOb_lZ-lA1cYtRQ309I8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0ZeJiBXePGKqwcwl6sMVwPHUFWZgnUwQ39rbBknciqw&oe=6AFDB4D4"}, "display_name": "Driving Simulator Basel", "keywords": ["driving", "car", "simulator", "basel", "racing"], "long_description": "The dream drive, from the driver's seat - in Basel.\n\nTHE CAR\nA V12 sports car with a race cockpit: racing wheel, bucket seats, roll cage, shift lights and a live display. Grip the wheel, work the gear stick and pull the handbrake with your own hands - or drive with the joysticks.\n\nA REAL 6-SPEED MANUAL\nMove the stick through a real H-pattern, rev it to the shift lights and snap the next gear in. Prefer to cruise? Switch to automatic.\n\n45 KM OF BASEL\nThe A2 and A3 from Muttenz past Pratteln and Augst to Rheinfelden. Through the old town, then Route 3 west with the Rhine on your right, past the Roman theatre of Augusta Raurica. North over the Rhine on the Schwarzwaldbr\u00fccke, through Kleinbasel under the Roche Towers, back on the Dreirosenbr\u00fccke and round the Spalenring to St. Jakob-Park.\n\nROAD EVENTS\nSeven events on real roads, from the Rhine Road to The Full Loop. The lights count you down, you race for gold - and your best run comes back as a ghost car to beat.\n\nSPEED TRAPS AND RUSH HOUR\nSix speed cameras record your top speed. In Rush Hour, close passes build your combo, a crash loses it.\n\nSUNSET, DAY AND NIGHT\nGolden light along the Rhine at sunset, bright Swiss sun with cargo barges on the river, or the M\u00fcnster and the Roche Towers lit up after dark.\n\nENGLISH AND GERMAN\nThe game follows your headset's language.\n\nPlus an original soundtrack on the car radio, a garage of paints, twenty achievements, career ranks and a map with quick travel.", "short_description": "Slide into the race seat of a V12 sports car and drive a 45 km loop of real Basel. Run the autobahn out to Rheinfelden, cruise Route 3 back along the Rhine past the Roman town of Augusta Raurica, cross the river on the Schwarzwaldbr\u00fccke into Kleinbasel under the Roche Towers and back over the Dreirosenbr\u00fccke. Shift a real 6-speed manual with your own hand, race road events against your own ghost, hit the speed traps and weave through rush hour. In English and German."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/drivingsimulatorbasel/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/drivingsimulatorbasel/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "33152918
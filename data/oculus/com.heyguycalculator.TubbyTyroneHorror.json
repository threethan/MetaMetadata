00276771_8867733815712486019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FkTxudISaQ8Q7kNvwE9xRJd&_nc_oc=Adqugzpc60AqtC2o_4I8kpERDkBa2GPaA69w8vkjsYJrcYOvVwfXS7Qm80iwzWDM5Dk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSM7Tg4rVzxVK7EYHU6zljxFcnmFjopVNbNvG6TuOYsVA&oe=6AF33742"}, "display_name": "Tubby Tyrone Horror", "keywords": ["gorilla", "tag", "horror", "tyrone", "fangame"], "long_description": "Tubby Tyrone Horror is a narrative driven horror VR experience where the player is plunged right into a terrifying environment, being stalked by the frightening monster known as Tubby Tyrone. The gameplay is more than just a scarefest, featuring a proper story that is revealed as the player explores, which puts context to the places the player visits, as well as the threat the player faces. This game utilizes hand interaction in VR to its fullest, which enables players to interact with the game world physically by grabbing items, opening doors, and moving around the world with their physical hands, thus increasing immersion levels to a great extent, as well as fear levels since it feels more realistic to interact with physical movement as opposed to joysticks.\n________________________________________________\n\nYou play as Haden Hee Hee Stand. You're going to investigate \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 and the head of the operation, Tubby Tyrone, is here to stop you. Find the keycard, and escape. Tubby Tyrone's \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 is insane and Tyrone has worse  intentions than you thought. Why don't we dig deeper.. shall we?", "short_description": "You play as Haden Hee Hee Stand. You're going to investigate \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 and the head of the operation, Tubby Tyrone, is here to stop you. Find the keycard, and escape. Tubby Tyrone's \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 is insane and Tyrone has worse  intentions than you thought. Why don't we dig deeper.. shall we?"}]}, "developer_name": "heyguycalculator", "developer_privacy_policy_url": "https://sites.google.com/view/tubbytyronehorror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "heyguycalculator", "support_website_url": null, "website_url": "https://sites.google.com/view/tubbytyronehorror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27814618378121828"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499307311_1437632167778084_1036078489898280812_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EIt_SuURUisQ7kNvwGNR_tu&_nc_oc=Adr2OAdkOmvLpMCvVP4yfWo3WVvPMobpphBGipMWKhiVuLCVPcX0j_ahGudBvxJNccI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4iJkSAsK4VnxCBV5LBYW5h9w18cZmEvy8VFH1uDWuRA&oe=6AF325DE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tubby Tyrone Horror", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": 
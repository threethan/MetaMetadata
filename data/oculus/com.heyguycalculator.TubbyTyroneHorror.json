9310651_864348219650982_1095847370370062608_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V91FweIawi8Q7kNvwFWKYSG&_nc_oc=Adk4hc45fnvVNwUGHZ0xSo_kUHVjFhUn5Cx95G5OTqkhr8U8AYRISoGnQ_9aLR6jtjI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfudQuRWMF3yNxPIhaAgWfHckEJ1xSxQEccMHumFzuVcnw&oe=69A04C36"}, {"file_name": "eb94ac15eaa64c169b989773ad3ec0f3 (1).png", "id": "1919444849448850", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297507_1919444852782183_4987247106149561445_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3LyUFsSxBDYQ7kNvwFRKW9w&_nc_oc=Adn8Ae17PhGLSuNW6iC1fG71_H1kCEFoqE66RrsLDDnfivaqXCU-N8C2uMKyBCI4AyA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuJaHYvzgv-8AtswpVM1_mtbuFJ1xf3dfsWXyitMca09w&oe=69A025B8"}, {"file_name": "0d5be140-6843-4208-842d-9acff2a6e123.png", "id": "876479871512165", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822883_876479878178831_4890427622875764841_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZ5-8t7FdXgQ7kNvwGn56Vb&_nc_oc=Adlf3Ctq_O297OnsI_HoangX6Qryny22Gq6Nj9dLwMd1VmPpZ3X8M0sxoAW-vvIO8DY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftVJ1NVtJeanYS0sY7mOKpZ6a8Li5Tuf9RCt9piGfyehg&oe=69A05224"}, {"file_name": "aebacc23-0607-4e1c-a38d-dc44dac860f0.png", "id": "1603960091039783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308307_1603960094373116_8964734268015967979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_Gellg9GKwQ7kNvwHoR38G&_nc_oc=Adn-MQpXgye153VHvVbj59Q83RxOrxC7F5BHRIDyNkxKzkPQdiVZTkmUV0Rxg2DOkww&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsaEiMfUz8Rw5br92yiyq8cIUD7lMgpRJaKbqpIHGHqgQ&oe=69A03AE0"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tubby Tyrone Horror", "keywords": ["gorilla", "tag", "horror", "tyrone", "fangame"], "long_description": "Tubby Tyrone Horror is a narrative driven horror VR experience where the player is plunged right into a terrifying environment, being stalked by the frightening monster known as Tubby Tyrone. The gameplay is more than just a scarefest, featuring a proper story that is revealed as the player explores, which puts context to the places the player visits, as well as the threat the player faces. This game utilizes hand interaction in VR to its fullest, which enables players to interact with the game world physically by grabbing items, opening doors, and moving around the world with their physical hands, thus increasing immersion levels to a great extent, as well as fear levels since it feels more realistic to interact with physical movement as opposed to joysticks.", "short_description": "Tubby Tyrone Horror is an indie game where you explore a creepy environment while being hunted or stalked by a terrifying monster called Tubby Tyrone. It\u2019s aimed to be a scary experience, having tense situations and jumpscares as you try to survive or escape the horrors that are chasing you."}]}, "developer_name": "heyguycalculator", "developer_privacy_policy_url": "https://sites.google.com/view/tubbytyronehorror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "heyguycalculator", "support_website_url": null, "website_url": "https://sites.google.com/view/tubbytyronehorror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26
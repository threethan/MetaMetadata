9310651_864348219650982_1095847370370062608_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFykw1l-RtcQ7kNvwGo48N8&_nc_oc=Adk9wVzfIGsdaxbSIPtmVC4WI9Piz6hCzbu5tpjzKrucWsaoL2Mc5LP321W6GjldxmM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftPGJdc_LWc3AtBtd5jhdNcGMo-TpRrsepK9uVrNCEIaQ&oe=6999B4B6"}, {"file_name": "eb94ac15eaa64c169b989773ad3ec0f3 (1).png", "id": "1919444849448850", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499297507_1919444852782183_4987247106149561445_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEGdXaGbepYQ7kNvwH2Byq4&_nc_oc=AdlxKGKStcCCbieJKSl7oAu4a7o6sAOXUaxdjt8SCKoBE_AJQIU6jjGCK7XNYQ3h2Is&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftrtsktKX-WvzzhXmWxHqiGUepEUMwiEpKL9UPokJO9wQ&oe=69998E38"}, {"file_name": "0d5be140-6843-4208-842d-9acff2a6e123.png", "id": "876479871512165", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822883_876479878178831_4890427622875764841_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gxT_88eLmyAQ7kNvwFUowKg&_nc_oc=AdnaTDwanSj73THIrvVQpyc3I4i_o8Andi6v0WzM5qDO4Y44lvA67hW0uK5Gghq08Xo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvnYxtuauciG8Xaf-tsvcS6LKRjMVHAMP0bw6r01WoiZA&oe=6999BAA4"}, {"file_name": "aebacc23-0607-4e1c-a38d-dc44dac860f0.png", "id": "1603960091039783", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499308307_1603960094373116_8964734268015967979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5Y1SuNmu_Z0Q7kNvwH69pSP&_nc_oc=AdlFe7tEjVJgxuC908jRyRe1WfjM5qK-T6hyv-MCU4w9XP-sZ0ZkWJlq-lKN8tFYjGs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuygB9Jq8yTOyK8yTn1DHqaze2xNowaAVNI88nlw1ErhQ&oe=6999A360"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tubby Tyrone Horror", "keywords": ["gorilla", "tag", "horror", "tyrone", "fangame"], "long_description": "Tubby Tyrone Horror is a narrative driven horror VR experience where the player is plunged right into a terrifying environment, being stalked by the frightening monster known as Tubby Tyrone. The gameplay is more than just a scarefest, featuring a proper story that is revealed as the player explores, which puts context to the places the player visits, as well as the threat the player faces. This game utilizes hand interaction in VR to its fullest, which enables players to interact with the game world physically by grabbing items, opening doors, and moving around the world with their physical hands, thus increasing immersion levels to a great extent, as well as fear levels since it feels more realistic to interact with physical movement as opposed to joysticks.", "short_description": "Tubby Tyrone Horror is an indie game where you explore a creepy environment while being hunted or stalked by a terrifying monster called Tubby Tyrone. It\u2019s aimed to be a scary experience, having tense situations and jumpscares as you try to survive or escape the horrors that are chasing you."}]}, "developer_name": "heyguycalculator", "developer_privacy_policy_url": "https://sites.google.com/view/tubbytyronehorror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "heyguycalculator", "support_website_url": null, "website_url": "https://sites.google.com/view/tubbytyronehorror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26
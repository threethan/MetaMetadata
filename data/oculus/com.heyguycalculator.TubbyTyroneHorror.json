vL-4r-RwXKK8c2cdv7A&oe=6A71EAB6"}, {"file_name": "eb94ac15eaa64c169b989773ad3ec0f3 (1).png", "id": "1919444849448850", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499297507_1919444852782183_4987247106149561445_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RQ7hmDSW1YIQ7kNvwEI2NDR&_nc_oc=AdpllHhvnYvf-zBgJAZFRAb9Vm4rOzwhxMbRCWNZ7yuQjzSheT_SVtLrHWtNmpV767g&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVSUN2M3-OkTiIxtcyZHImsZTP20Mosj3qFFUVGuu8zQ&oe=6A71FC78"}, {"file_name": "0d5be140-6843-4208-842d-9acff2a6e123.png", "id": "876479871512165", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491822883_876479878178831_4890427622875764841_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUY0BjlLeNkQ7kNvwGMZ_-4&_nc_oc=AdqPrbcoUZNs0xJnI6V_3keaiq-broW47LCagiql4gG1pzU_4hGsRoTA6mLGk-KWel4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWEE6hXJYQIskrW89djaWLqN3Hbp3N4-PvPDCnULqG1Q&oe=6A71F0A4"}, {"file_name": "aebacc23-0607-4e1c-a38d-dc44dac860f0.png", "id": "1603960091039783", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499308307_1603960094373116_8964734268015967979_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PcWJp1T54LMQ7kNvwFhlDwe&_nc_oc=AdoZuskHNDxNerirDyXK3wCiRF0oZDfDH1V3y7ugDIQeOwFUSGNsRtjo7hJ-XcUG_8E&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEw5M_BSdqnXCsQ-N5ahVyCTszDiGrshFEYqLCXLj7UDw&oe=6A71D960"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Tubby Tyrone Horror", "keywords": ["gorilla", "tag", "horror", "tyrone", "fangame"], "long_description": "Tubby Tyrone Horror is a narrative driven horror VR experience where the player is plunged right into a terrifying environment, being stalked by the frightening monster known as Tubby Tyrone. The gameplay is more than just a scarefest, featuring a proper story that is revealed as the player explores, which puts context to the places the player visits, as well as the threat the player faces. This game utilizes hand interaction in VR to its fullest, which enables players to interact with the game world physically by grabbing items, opening doors, and moving around the world with their physical hands, thus increasing immersion levels to a great extent, as well as fear levels since it feels more realistic to interact with physical movement as opposed to joysticks.", "short_description": "Tubby Tyrone Horror is an indie game where you explore a creepy environment while being hunted or stalked by a terrifying monster called Tubby Tyrone. It\u2019s aimed to be a scary experience, having tense situations and jumpscares as you try to survive or escape the horrors that are chasing you."}]}, "developer_name": "heyguycalculator", "developer_privacy_policy_url": "https://sites.google.com/view/tubbytyronehorror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "heyguycalculator", "support_website_url": null, "website_url": "https://sites.google.com/view/tubbytyronehorror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "26119927547590928"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "715136878066129"}]}, "baseline_offer": {"id": "715136878066129"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 176739300
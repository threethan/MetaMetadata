ttps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820548_2135303583912716_68782914333182076_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z47s9PLhr9QQ7kNvwHI-r_0&_nc_oc=AdppA0TvF1sxxkCJ3YkrZVngg1X4K2Go3j2fs5EB7Y-BGVs8c7b_2GNA5dByNhT1a3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4dA7HV7c8DAt2X2jfopKX_cje_Zk62Ej7SJqLS24Xbg&oe=6A50EF3C"}, {"file_name": "promopic4.png", "id": "927681743400170", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618274_927681746733503_5118019043309327688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N0uJOeodeokQ7kNvwEUYtRl&_nc_oc=Adrf5FM4PrHH9N5Zj8HUJcObA0_hskIzdK4nAZMuNV3BiCZiifxqGb_DePGXpzzwU4I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9ZuECwlyapkUkRul8QiaQosxSpSrBU2vxxYp454PoCA&oe=6A50E0C5"}, {"file_name": "promopic.png", "id": "1465178438444851", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618264_1465178441778184_1802980976052858218_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWgh9yVDr9wQ7kNvwFK2BqP&_nc_oc=AdpfFMFZ_nisP3TYEVqx5CZB4v6dZdeyTSZhKXMAqagcI4NFZTncfH4NUd8bsqcFFNw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDK9HikcskrwB6XyHtAotXiRHcnnd1bCKAvmoMLDejEvA&oe=6A510944"}, {"file_name": "screebnshot.png", "id": "1667863234468614", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499297507_1667863237801947_3510320029324730949_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MSiMd_UyNukQ7kNvwGfyeA6&_nc_oc=AdpiSHnLQhEUmHpCnDW9BgT6eml8VmO4Fli2EBRMpdK_vlQZMnxQEuAITy18amL1d94&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuWeXVWWB5OCbh7JYND-oXqrQowgdNu7F7FajrwcpJKA&oe=6A510AF5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailrtx.png", "id": "1710746196943438", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619774_1710746200276771_8867733815712486019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qLWcBAmM9VcQ7kNvwGpcV8N&_nc_oc=AdoZGHtYa8Dnb7cmY8Q9LtXOGsoOVMkVicppIrlAlTkPK2GxyhqXzg13JEhinp458iA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCvWrJPWX4er8uHiUZ34E_pjikFZpiLboUxucINXLcG-w&oe=6A510EC2"}, "display_name": "Tubby Tyrone Horror", "keywords": ["gorilla", "tag", "horror", "tyrone", "fangame"], "long_description": "Tubby Tyrone Horror is a narrative driven horror VR experience where the player is plunged right into a terrifying environment, being stalked by the frightening monster known as Tubby Tyrone. The gameplay is more than just a scarefest, featuring a proper story that is revealed as the player explores, which puts context to the places the player visits, as well as the threat the player faces. This game utilizes hand interaction in VR to its fullest, which enables players to interact with the game world physically by grabbing items, opening doors, and moving around the world with their physical hands, thus increasing immersion levels to a great extent, as well as fear levels since it feels more realistic to interact with physical movement as opposed to joysticks.\n________________________________________________\n\nYou play as Haden Hee Hee Stand. You're going to investigate \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 and the head of the operation, Tubby Tyrone, is here to stop you. Find the keycard, and escape. Tubby Tyrone's \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 is insane and Tyrone has worse  intentions than you thought. Why don't we dig deeper.. shall we?", "short_description": "You play as Haden Hee Hee Stand. You're going to investigate \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 and the head of the operation, Tubby Tyrone, is here to stop you. Find the keycard, and escape. Tubby Tyrone's \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 is insane and Tyrone has worse  intentions than you thought. Why don't we dig deeper.. shall we?"}]}, "developer_name": "heyguycalculator", "developer_privacy_policy_url": "https://sites.google.com/view/tubbytyronehorror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "heyguycalculator", "support_website_url": null, "website_url": "https://sites.google.com/view/tubbytyronehorror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27814618378121828"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307311_1437632167778084_1036078489898280812_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SbZRXOr9UH8Q7kNvwGHtoM3&_nc_oc=Adr9OxssFFjBR7FnfNGtT3ixkAwf3-J8xe6mkAkXRcyrzG4keBUn1nq9abGqqFrmEuQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5PYVUXhiw_bDAPns8Rexcoaq2S-IIQ7azTWefDMMxsw&oe=6A50FD5E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tubby Tyrone Horror", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Survival", "id": "644354873106712
ttps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820548_2135303583912716_68782914333182076_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MGkrLX_ms38Q7kNvwH4sXdU&_nc_oc=AdqIa0JJoqgZx1rDIFpl0WvMr-beGNj9477p_vC5z6ST-LdrLtB68KyrWevpff5sFJc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC_KeA-FCHCoNkaeXuih2yO8pp9f64e3m4Tyn3eEqhssw&oe=6A5E1E3C"}, {"file_name": "promopic4.png", "id": "927681743400170", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618274_927681746733503_5118019043309327688_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ezMOt0K_tAQ7kNvwFimVoN&_nc_oc=AdoeeU4SDxJrdG4eJfD8bt4kH4fNGH_i_2HOrg1tGRV6NuB6UyjEUUNOADio1wtPG-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBcgFtA_6TimLch6pXSj88uMyzegrR6skwyiW8PXrUF3A&oe=6A5E0FC5"}, {"file_name": "promopic.png", "id": "1465178438444851", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_1465178441778184_1802980976052858218_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pAkOUTqpxVAQ7kNvwHgI1bg&_nc_oc=Adq4wD_f0GqCuN7eiPhErsDHA6q0chp2JXJK_E6Tj9L8vPxKobiGzq6GVpOwxqneaiY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsYh-VrA5pKkDNsPXK9s17FYRFycz-wSZvf_dcukGZ_A&oe=6A5E0004"}, {"file_name": "screebnshot.png", "id": "1667863234468614", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499297507_1667863237801947_3510320029324730949_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HSHJvDNGG8Q7kNvwGw9Atp&_nc_oc=AdrMyF7-NV8P1Qow_csjbNl48hjAYd_SvLFWequU6tfuKaNlNIvzvSeSKCvkaJQZj0w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDWMR67XXGHAF07YT9IU2e0rIWy4UY-aGzLG30T7Wxs4g&oe=6A5E01B5"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "thumbnailrtx.png", "id": "1710746196943438", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619774_1710746200276771_8867733815712486019_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GNsXKVQZ3g0Q7kNvwHTIs5E&_nc_oc=AdpMbmuOR36R_I5s5jOEFqnhkAnq7n5PHh6-_99ZxWjewyVVViI0l_Qu4H90diKh_Lw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBDFdvW7yfCZYxu0IjErT0WlBOZizBF6Tho95XQnZubig&oe=6A5E0582"}, "display_name": "Tubby Tyrone Horror", "keywords": ["gorilla", "tag", "horror", "tyrone", "fangame"], "long_description": "Tubby Tyrone Horror is a narrative driven horror VR experience where the player is plunged right into a terrifying environment, being stalked by the frightening monster known as Tubby Tyrone. The gameplay is more than just a scarefest, featuring a proper story that is revealed as the player explores, which puts context to the places the player visits, as well as the threat the player faces. This game utilizes hand interaction in VR to its fullest, which enables players to interact with the game world physically by grabbing items, opening doors, and moving around the world with their physical hands, thus increasing immersion levels to a great extent, as well as fear levels since it feels more realistic to interact with physical movement as opposed to joysticks.\n________________________________________________\n\nYou play as Haden Hee Hee Stand. You're going to investigate \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 and the head of the operation, Tubby Tyrone, is here to stop you. Find the keycard, and escape. Tubby Tyrone's \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 is insane and Tyrone has worse  intentions than you thought. Why don't we dig deeper.. shall we?", "short_description": "You play as Haden Hee Hee Stand. You're going to investigate \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 and the head of the operation, Tubby Tyrone, is here to stop you. Find the keycard, and escape. Tubby Tyrone's \u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588\u2588 is insane and Tyrone has worse  intentions than you thought. Why don't we dig deeper.. shall we?"}]}, "developer_name": "heyguycalculator", "developer_privacy_policy_url": "https://sites.google.com/view/tubbytyronehorror/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "heyguycalculator", "support_website_url": null, "website_url": "https://sites.google.com/view/tubbytyronehorror/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "27814618378121828"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499307311_1437632167778084_1036078489898280812_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAfqlTTBsE4Q7kNvwFdDKpo&_nc_oc=AdpFr6viVHjlhEstAQjygoLEsGI0olhPMnzmB1TjQfUK559OIyHb7ErX0SAWpzqFg3w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDMUIXjD0E6NvAK-Mq3CihHbKq2o7Xl1QEFDQVS3C6K9g&oe=6A5E2C5E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Tubby Tyrone Horror", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Adventure", "id": "2691890164460465"}, {"topic_name": "Survival", "id": "644354873106712
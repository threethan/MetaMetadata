ps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982689_1964616650615883_5226801006588838598_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h8WhHLXCkzcQ7kNvwHlYVjA&_nc_oc=Adrl8nBYhtS6rmLGSLNHCLGMkY5pTFFt3wMjnKzR94_Vw6W9cTfdmWr9AiONpPoga3U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yqxVCsekr50HqzUlZeLiP1mCfCCGDtTEn9GxRCwz4aA&oe=6A2970D2"}, {"file_name": "beach_2560x1440.png", "id": "9109646092417793", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035379_9109646102417792_5685654441275726515_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nsed7xoYqggQ7kNvwFVB911&_nc_oc=AdrdmKUlAqGpPtlUrJBv_EmtKMLfyjFkQSQG8rW97CUKHxy6pDR0jWY8a1nuRupHeIs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ADEFxUBtESBrCWtZc7u50k1alKg5Xi5togigwhzvcFA&oe=6A2970E9"}, {"file_name": "breathing_box_2560x1440.png", "id": "1111814917234904", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974757_1111814920568237_2152694396692833212_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zVnPv39bPA8Q7kNvwGq7qLL&_nc_oc=Adq9pBUkmgI8NgCIKiejwegV_2_H7JaKeAjyCgwGbs14ujp3LgyfHMQ9tY8RSzJUlcE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xEnZLGepEdcCFOd3BJLBFYmk18ClF0x507fhjLIVS0A&oe=6A297638"}, {"file_name": "imag_1_2560x1440.png", "id": "1492441021384829", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75241700_1492441028051495_4780186442185829279_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3P84fatrLckQ7kNvwGnFJkC&_nc_oc=Adr-zhesQkaIJQGy8LolnK4Vldhn8NCAu0YeGFKxL3TAWiN8uf2iU5ZFC_AJ08qznzE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Lm4YFXst2yjNIKSJd5ac20a0vt46Ntos30OXgxCg1Sw&oe=6A2988DD"}, {"file_name": "cabin_2560x1440.png", "id": "588240450319585", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75443241_588240453652918_7838642347634187579_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fbmaTWPK3IsQ7kNvwGADa3w&_nc_oc=AdrBggYNbnGx4doM1ele3iEDv1EDklZLFJ27DrPHmlVvROCzJwEJi0iuwUP6m5fKuZ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ClHg9ziNtkl1N8Idndl6QbUiNHNoE-n97LylWD89L2A&oe=6A29764D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "1209563563445145", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035448_1209563566778478_7417743551310567282_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A4GbTNq2bQQQ7kNvwE2Q8ey&_nc_oc=AdrKJ0DMJ-INmIaGXTGt7rpI2tFnHCdGr8QUrvjeou5HGOfm5g7U7UIF39jB67aQwMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8BDgHmFSVDP4epS9MH2HgeVjfg_UBI9XxOruJBZq1y4Q&oe=6A297E84"}, "display_name": "Brain Symphony: Relax & Meditation", "keywords": ["relax", "stress", "fun", "meditation", "Wellbeing"], "long_description": "Explore:  Brain Symphony & Relax Meditation today! \n\nWhether you\u2019re seeking to wind down after a long day, improve your sleep, or carve out a moment of tranquility in your busy routine, Brain Symphony & Relax Meditation offers something for everyone. With its intuitive and accessible design, the app ensures that relaxation is just a few breaths away.\n\nComplementing these stunning visuals, Brain Symphony features soothing binaural soundscapes that synchronize with each environment, deepening your relaxation experience. Guided breathing techniques, such as box breathing, help reduce stress and center your mind, while positive, calming messages encourage mindfulness and inner peace.\n\n Harnessing the immersive power of virtual reality, this app takes you on a journey through diverse, breathtaking environments\u2014from serene beaches and tranquil gardens to cozy cabins and the awe-inspiring Milky Way. Each setting is designed to provide a sense of peace and wonder, allowing you to leave stress behind and rediscover balance.\n\nDownload Brain Symphony & Relax Meditation today and embark on a journey to serenity, clarity, and inner harmony.", "short_description": "Brain Symphony: Relax & Meditation helps you relax, reduce stress, and find peace. Immerse yourself in calming virtual environments, guided breathing, and soothing sounds for a complete relaxation experience.Let soothing binaural sounds, guided breathing exercises, and positive, calming messages guide you toward reduced stress and deeper relaxation. Your sanctuary for calm is just a breath away."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainsymphony.tech/privacy-policy", "developer_terms_of_service_url": "https://brainsymphony.tech/terms-and-conditions", "publisher_name": "SC Rehabvr SRL", "support_website_url": null, "website_url": "https://rehabxvr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9976436049049997"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1164506718617758"}]}, "baseline_offer": {"id": "1164506718617758"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1739192160, "status": "PUBLISHED", "id": "1164506718617758"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "27300322076234792", "version": "2.0.4"}, "id": "1050479369860245", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename"
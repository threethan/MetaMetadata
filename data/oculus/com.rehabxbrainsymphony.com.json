kWA&_nc_oc=AdmHgTEqdZ5gbIeWrfBaV0q0BwqwuL4V4qou5zvT3kzKYjB1DXMNj5wOkgQZPsOxGEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyQw04iSIo3olpqrm7wm9cdaLOEj4tUdVwsZ0bNWpQHwg&oe=69B9411D"}, {"file_name": "cabin_2560x1440.png", "id": "588240450319585", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75443241_588240453652918_7838642347634187579_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pj41d3mftccQ7kNvwGfXvhQ&_nc_oc=AdnRliQ5C3my-9oqCZz-7s579qYRTnHe_g3Gbuih68L-UjnHBrTFf-JNSRsk83I1_SA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzxGjtCvLaFv7C4lTlmyjT5_sstWDqK-L9YWcO7YTO0Xw&oe=69B966CD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "1209563563445145", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035448_1209563566778478_7417743551310567282_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CuoRzsXFYgQ7kNvwH8Rgy4&_nc_oc=Adl6RW71i3Pot-LL38lGvBrBGQft_ngk0U4ue_4u7VS2xt0AlR1p34DzA9Bef0tYDaU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxQRbUAG-Idlk7NcC9uTHa_bqDj4s1kh8RvSTnbr7AlNA&oe=69B936C4"}, "display_name": "Brain Symphony: Relax & Meditation", "keywords": ["relax", "stress", "fun", "meditation", "Wellbeing"], "long_description": "Explore:  Brain Symphony & Relax Meditation today! \n\nWhether you\u2019re seeking to wind down after a long day, improve your sleep, or carve out a moment of tranquility in your busy routine, Brain Symphony & Relax Meditation offers something for everyone. With its intuitive and accessible design, the app ensures that relaxation is just a few breaths away.\n\nComplementing these stunning visuals, Brain Symphony features soothing binaural soundscapes that synchronize with each environment, deepening your relaxation experience. Guided breathing techniques, such as box breathing, help reduce stress and center your mind, while positive, calming messages encourage mindfulness and inner peace.\n\n Harnessing the immersive power of virtual reality, this app takes you on a journey through diverse, breathtaking environments\u2014from serene beaches and tranquil gardens to cozy cabins and the awe-inspiring Milky Way. Each setting is designed to provide a sense of peace and wonder, allowing you to leave stress behind and rediscover balance.\n\nDownload Brain Symphony & Relax Meditation today and embark on a journey to serenity, clarity, and inner harmony.", "short_description": "Brain Symphony: Relax & Meditation helps you relax, reduce stress, and find peace. Immerse yourself in calming virtual environments, guided breathing, and soothing sounds for a complete relaxation experience.Let soothing binaural sounds, guided breathing exercises, and positive, calming messages guide you toward reduced stress and deeper relaxation. Your sanctuary for calm is just a breath away."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainsymphony.tech/privacy-policy", "developer_terms_of_service_url": "https://brainsymphony.tech/terms-and-conditions", "publisher_name": "SC Rehabvr SRL", "support_website_url": null, "website_url": "https://rehabxvr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9976436049049997"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1164506718617
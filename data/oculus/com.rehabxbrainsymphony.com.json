&_nc_sid=6e7a0a&_nc_ohc=acLQDKTUb64Q7kNvwFP8fUD&_nc_oc=Adq9nybNcOWpfbZKZsXYIvTaEY8D8ZeAgUgeu4dJD1vK2KVC88VL76dACtGVhMTllsU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvqpGazpEKTwEpb1UhB0H_f6PhaZVlHgPickQh_bf2Ng&oe=69C51E9D"}, {"file_name": "cabin_2560x1440.png", "id": "588240450319585", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75443241_588240453652918_7838642347634187579_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3fPwlK83lmoQ7kNvwGnn-7Q&_nc_oc=AdpU4HW42ffSUNl0nJe4X4ih2Z4lP37GA2nb5OsEGQOsMdXe7HgccI75ASRohPLo0Zc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxCBoAmY6MhgRaHur75ta3mOzb3I-AG98iu3-sxHimoZg&oe=69C5444D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArt_2560x1440.png", "id": "1209563563445145", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39035448_1209563566778478_7417743551310567282_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=He7ECHV4PekQ7kNvwEIXF0y&_nc_oc=Ado8FbbrW63v_9n07vtAH00Pkdd52x_BamHSWG_twm7fUp4QZuzITjpHSacqZ09X9Wo&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfycZbDknrJGvTZd8i4J4aVLcL6eSJlrdKy4WewzKZ0cCg&oe=69C51444"}, "display_name": "Brain Symphony: Relax & Meditation", "keywords": ["relax", "stress", "fun", "meditation", "Wellbeing"], "long_description": "Explore:  Brain Symphony & Relax Meditation today! \n\nWhether you\u2019re seeking to wind down after a long day, improve your sleep, or carve out a moment of tranquility in your busy routine, Brain Symphony & Relax Meditation offers something for everyone. With its intuitive and accessible design, the app ensures that relaxation is just a few breaths away.\n\nComplementing these stunning visuals, Brain Symphony features soothing binaural soundscapes that synchronize with each environment, deepening your relaxation experience. Guided breathing techniques, such as box breathing, help reduce stress and center your mind, while positive, calming messages encourage mindfulness and inner peace.\n\n Harnessing the immersive power of virtual reality, this app takes you on a journey through diverse, breathtaking environments\u2014from serene beaches and tranquil gardens to cozy cabins and the awe-inspiring Milky Way. Each setting is designed to provide a sense of peace and wonder, allowing you to leave stress behind and rediscover balance.\n\nDownload Brain Symphony & Relax Meditation today and embark on a journey to serenity, clarity, and inner harmony.", "short_description": "Brain Symphony: Relax & Meditation helps you relax, reduce stress, and find peace. Immerse yourself in calming virtual environments, guided breathing, and soothing sounds for a complete relaxation experience.Let soothing binaural sounds, guided breathing exercises, and positive, calming messages guide you toward reduced stress and deeper relaxation. Your sanctuary for calm is just a breath away."}]}, "developer_name": null, "developer_privacy_policy_url": "https://brainsymphony.tech/privacy-policy", "developer_terms_of_service_url": "https://brainsymphony.tech/terms-and-conditions", "publisher_name": "SC Rehabvr SRL", "support_website_url": null, "website_url": "https://rehabxvr.org/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1819021644882647"}, {"id": "810139357995560"}, {"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9976436049049997"}}]}, "scheduled_offers": {"count": 1
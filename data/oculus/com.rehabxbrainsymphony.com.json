0yJFbTGrGZWBMzbeTeedmpj4WYlx-sg&oe=6A295565"}, {"file_name": "V6_2560x1440.png", "id": "994171106343624", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491818849_994171109676957_3985768327418697797_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8oFE192w6vEQ7kNvwEjIhGk&_nc_oc=AdpsIZnr9uVVWpCae4jqsv4551bIbCyc0Oq9WsaAJiyW4q0z_LtokV28yH-K7t-PwHY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__sUBvGNJeZYR0gQTDMq-ZagNnUNPvp-UORUN3lybp3A&oe=6A298049"}, {"file_name": "V1_2560x1440.png", "id": "2170541813787380", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827611_2170541820454046_1140636066004176243_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vtSRI8gltaAQ7kNvwGcjftF&_nc_oc=AdqcEQxQhwVjMosCRTmsC_-yrU_sklJMXJnGV9wT0oSB5U228iC--yWSsYCVHOuJ8O0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fCcQl3SIJ8CkF19X0X01zZxwuv36zYt3S47veKS_InA&oe=6A297F4C"}, {"file_name": "V9_2560x1440.png", "id": "959650876982622", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823837_959650880315955_6350768999511771855_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SYNXB2cDHYUQ7kNvwEotjYo&_nc_oc=AdrcsqeiJHfJDrAVekIKw3Qzex2MnkUw-mS9c02osTCIYmtFpdBHFblaxNeBapPBWp0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8puJ3B4H8kFhmkDmCGZKHs8fRLgE9gIcpdG2P87DiS2g&oe=6A296130"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "V7_1_2560x1440.png", "id": "953459264138558", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824328_953459267471891_5881249671066954958_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3sdnm5iJU4Q7kNvwG6YVSd&_nc_oc=AdpyjOtE17WJDeLEQWY0329B6zCLbzhyb45EWCfmehKjgkzLuv3s02qqA4bjmKFifYc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-KFSQpBHBD7TQKvI4ol1-4lMOlmZz1CRqJ5EH50W95mQ&oe=6A295A53"}, "display_name": "Brain Symphony : Relaxation & Bien-\u00eatre", "keywords": ["stress", "calme", "m\u00e9ditation", "d\u00e9tente", "plaisir"], "long_description": "\n**VOTRE ESPACE POUR LE CALME, L'\u00c9QUILIBRE ET LA CONCENTRATION** \n\n\u00c9chappez au bruit, am\u00e9liorez votre humeur, ressourcez-vous et profitez de moments qui vous apaisent, vous recentrent et vous procurent une sensation de paix int\u00e9rieure. Laissez de c\u00f4t\u00e9 la pression du quotidien, boostez votre humeur et votre concentration, et offrez-vous des instants de calme quand vous en avez le plus besoin. \n\n{1607399457000492} \n\n**VOTRE ESPACE POUR VOUS R\u00c9INITIALISER ET VOUS RECHARGER**\n\nD\u00e9couvrez des exp\u00e9riences immersives con\u00e7ues pour vous aider \u00e0 r\u00e9duire le stress, \u00e0 vous vider l'esprit, \u00e0 am\u00e9liorer votre concentration et \u00e0 vous sentir plus \u00e9quilibr\u00e9 au quotidien.\n\n{1973625599924774}\n\n**Dans l'application, vous pouvez :**\n\n- Apaisez votre esprit gr\u00e2ce \u00e0 la m\u00e9ditation guid\u00e9e en anglais, en fran\u00e7ais et en allemand. \n- D\u00e9tendez-vous et exprimez-vous \u00e0 travers la peinture 2D et 3D \n- Lib\u00e9rez-vous du stress et am\u00e9liorez votre humeur en chantant en musique.\n- Profitez d'activit\u00e9s ludiques con\u00e7ues pour vous aider \u00e0 vous d\u00e9tendre et \u00e0 vous ressourcer mentalement. \n\n**\u25b6 Commencez votre essai gratuit d\u00e8s aujourd'hui.**\n\n**Faites une pause. D\u00e9tendez-vous.**", "short_description": "Retrouvez calme et s\u00e9r\u00e9nit\u00e9, un sommeil plus profond, une r\u00e9duction du stress et une clart\u00e9 mentale retrouv\u00e9e gr\u00e2ce \u00e0 des exp\u00e9riences immersives con\u00e7ues pour vous aider \u00e0 vous d\u00e9tendre et \u00e0 vous ressourcer. Am\u00e9liorez votre concentration, apaisez votre anxi\u00e9t\u00e9, favorisez votre \u00e9quilibre \u00e9motionnel et reconnectez-vous \u00e0 vous-m\u00eame en \u00e9chappant au bruit et \u00e0 la pression du quotidien. Que vous ayez besoin d'un moment de paix, de plus d'\u00e9nergie ou d'un esprit plus sain, votre ressourcem
scdn.com/v/t64.5771-25/499619148_940819725320811_9094562040048462230_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7LhId7UbRjQQ7kNvwGvc_kT&_nc_oc=AdojzSvcvQRb7WEwYk7T40uw7IeiQWNi_MIQ6aOLD1dtpYXwq2f3tDj2c-Vn25VLmxE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ2_p2VHuqukfssS4AMUbTkqaNGSqhSh64OPYYx8Yee2A&oe=6AFB3D78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImage.png", "id": "980359531187881", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499619113_980359541187880_4609360478203087046_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6cVHCcyJC8IQ7kNvwEmKXKL&_nc_oc=AdrU58L-UdUtKKdtCTOyQewDfz1dadWbMeJCghqr-ysGHMszVeB2CNGUWfzL67UhKxY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRC_OcUMveP3JvV7oUWnF2BY4HQ5Z37aZbZJoAPEFgiHg&oe=6AFB1BD5"}, "display_name": "Battle Beyond The Wall", "keywords": [], "long_description": "BUILD & PREPARE YOUR ARMY\nBefore the wall falls, you and up to 3 other commanders get to prepare your own military force, customizing every aspect of your combat approach. Purchase tanks, bomber planes, and a variety of troop classes to establish your opening strategy. Place these troops and vehicles wherever you want before the battle begins.\n \nCOMMAND YOUR ARMY IN REAL TIME\nWhen the wall falls, mass combat unfolds. Manage and direct your existing troops & vehicles, deploy new waves of soldiers, and ensure that your team has the upper hand against the other side. Eventually, your goal is to eliminate the enemy king, while making sure that your defenses are strong enough to block any and all enemy attacks.  \n\nJUMP INTO THE BATTLE\nSet in a varied open-world environment, players get to jump into the battle and directly participate in ongoing combat. Arm yourself with any weapon you prefer, place yourself in a tank or an airplane, and have a real impact on how the battle unfolds outside of the safe confines of your castle. From sneak attacks on the enemy castle to strategized bombing raids with friends, anything you do affects the outcome of the war. \n", "short_description": "Two empires stand divided by a massive wall. Build your army, command it in real time, and join the battle yourself as the wall falls and all-out war begins."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.globissinteractive.com/bbtwprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Globiss Interactive LLC", "support_website_url": null, "website_url": "https://www.globissinteractive.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}, {"id": "459781504968480"}, {"id": "1990104051447093"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER"], "id": "26735728112731071"}}]}, "scheduled_offers": {"count": 14, "nodes": [{"status": "PUBLISHED", "id": "1943932613250247"}, {"status": "PENDING", "id": "2673560456433313"}, {"status": "PUBLISHED", "id": "985855001224881"}, {"status": "PUBLISHED", "id": "2331262744369132"}, {"status": "PUBLISHED", "id": "1576065693399499"}, {"status": "PUBLISHED", "id": "2001232501280119"}, {"status": "PUBLISHED", "id": "2110973809547712"}, {"status": "PUBLISHED", "id": "3154988694701496"}, {"status": "PUBLISHED", "id": "1735042521170187"}, {"status": "PUBLISHED", "id": "1646734356388516"}, {"status": "PUBLISHED", "id": "1581984733633266"}, {"status": "PUBLISHED", "i
592298331_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcKyFPWqXAcQ7kNvwEjpeMJ&_nc_oc=Adpm_1Y0zPSvWvwa8OY68vT44qh3l4fHnwE-CKl6XgQN5T2RpBvEV5_96rJ2zpV5lKY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBnNRhlTLg41puseWqIJb2bXXUXdQlQAUxCNtSGTolZGQ&oe=6A64CD52"}, {"file_name": "com.oculus.vrshell-20250822-002555.png", "id": "1302512085235611", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619668_1302512091902277_5092072394901969758_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vxqMUVq1VkQ7kNvwFGlZxh&_nc_oc=Adp4R-qDrn7V4w5Em3HiY3XVZYJDEMwqFw7QdWkSebjh8n0ACnpZYkOMiUtKxysolzg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCi52OXrQHR6BAs1k2orhW8RCNq91KuQMt3XBVqjP5lHA&oe=6A64BCAF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Herding Caterpillars VR Play", "keywords": [], "long_description": "Hiding beneath our noses in the Adelaide Park Lands is a story that you will find hard to believe. It is a story that has taken place for thousands of years, every year, in the grasslands of Adelaide and rediscovered in Victoria Park (Pakapakanthi) in 2011.\n\nThe eggs of a tiny caterpillar are checked by common black ants and when they hatch the baby caterpillars are herded to their favourite host plant to feed. The ants shepherd the caterpillars down into their nest for rest and protection at the end of each day.\n\nIn return, the ants feed from the nectary gland at the end of the caterpillar. Eventually the tubby caterpillar pupates in the ant nest and emerges as the beautiful Chequered Copper Butterfly. \n\nThis VR rendition of a real-world play retells the story. ", "short_description": "Hiding beneath our noses in the Adelaide Park Lands is a story that you will find hard to believe. It is a story that has taken place for thousands of years, every year, in the grasslands of Adelaide and rediscovered in Victoria Park (Pakapakanthi) in 2011.\n\nThis VR Rendition of a real-world play tells the story of the symbiotic relationship between the chequered copper butterfly, and the ants!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.beerlabs.com.au/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Brewed Engagement Extended Reality Labs", "support_website_url": null, "website_url": "https://www.beerlabs.com.au/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26256237093974143"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499617850_1686225039422187_467849698929740798_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQpuyXjeCGoQ7kNvwELz_aE&_nc_oc=Adr5MYpLxUo3kjGpYoxUwBxRG2DXx4IMY-J4jOXoNtnuCwG9FfVUKhJlSM84iJoBE6o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCmf8m6n6gSpg_nLC6DAlY9l9aCrYmmj9nnX5Emc_F4FA&oe=6A64B695"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Herding Caterpillars VR Play", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Media", "id": "434961926215971"}], "release_date": 1783912620, "lastRevision": {"nodes": [{"id": "26256237113974141", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", 
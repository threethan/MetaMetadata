-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWThWZDJ2MEgPr2wb_DrRtzQfLGw2jQCOtG01EXZw4dg&oe=6B09BD84"}, {"file_name": "04-measure.png", "id": "3474215529425532", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823930_3474215532758865_6971843280197298484_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=db6nJymEVPYQ7kNvwEQBYPC&_nc_oc=AdqPP-LMisDwlbBe13_pE1Gz9Xbn9rcNEXB1s6zjgIOi_2U3DKZHtNudXQiqrT_qv8A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgdPOnqQ6jQx8tQCrdpUPdNwaYW5Y4g0P9Kxz_998C1w&oe=6B09B8E2"}, {"file_name": "05-notes-with-photo.png", "id": "1160276500128393", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823802_1160276503461726_6315233559736274795_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6J7cVZoksZgQ7kNvwGCrtqT&_nc_oc=AdoJHh969kACBr7UDuvu15FdHLPwGa9LN23kcdyW4Hzhedoysf6PYr-qN8kBXntCRq0&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQU78Jnh8XPtRH6f1LrifdglSB32xE_dRpL5whaCZltxw&oe=6B0999B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-cover-2560x1440.png", "id": "1659501662565713", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823296_1659501669232379_900681033686979965_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c-2bbZnT-zUQ7kNvwHZ52UG&_nc_oc=AdoegS3TlJ6rFUnyT_8cbAE5vwLoYiqVa7lOAkjIgnUuhD9fHsc1tmJ-oGrzkv7PmDg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLlxm5bSkg7eGi25jWB_uOWH13B746fcCR066yr5HJkg&oe=6B09A654"}, "display_name": "Plan 1:1", "keywords": ["floorplan", "architecture", "interior", "renovation", "blueprint"], "long_description": "Plan 1:1 lays your 2D floor plan on the real floor around you at true 1:1 scale. Put on your Meta Quest, walk from room to room and feel how big the space really is, before anything is built.\n\nHOW IT WORKS\n1. Upload the PDF of your plan at plan1to1.com.\n2. Get a 3-letter code or a QR code.\n3. Enter it in the headset, place the plan on the floor and walk.\n\nWHAT YOU CAN DO\n- See your plan on the floor in mixed reality, at the scale read from the drawing. You can always check and correct the scale yourself.\n- Open plans with several floors and switch between them on the spot.\n- Try the space with the furniture you already have, or place virtual sofas, tables and chairs.\n- Measure distances on the plan.\n- Pin notes and photos exactly where you stand, then export them as a PDF for your architect or builder.\n\nWHAT YOU NEED\n- A Meta Quest 3 or 3S.\n- A floor plan as PDF, JPG, PNG or WebP. No 3D model is needed.\n- A reasonably open floor: a building site, an unfinished house, a hall or your current home.\n\nPlan 1:1 is made for getting a feeling for a space. It is not a surveying or construction set-out tool.", "short_description": "What will your new home actually feel like? Plan 1:1 lays your floor plan on a real floor at true size, so you can walk from room to room, try the furniture and find out before anything is built."}]}, "developer_name": null, "developer_privacy_policy_url": "https://plan1to1.com/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "AndriesGeens", "support_website_url": null, "website_url": "https://plan1to1.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "11260379004233
XlQ&oe=6AC65C9A"}, {"file_name": "HighresScreenshot00001 2.png", "id": "1065394006437016", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/507829686_1065394009770349_4756363336804822168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R8YXF7fTKT4Q7kNvwHcBWDF&_nc_oc=AdrUeftSQ_BH44i3y1qDKYN_9eX3_yNAebBPvVAz4BBmpJIvU16A5v-QpYkd31VHsoQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqg-mCHr-kjuyKLhKor_eScGzJV3VeLSAkmhKdFQ7NMw&oe=6AC671BB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Chiller Inspection & Maintenance", "keywords": [], "long_description": "HVAC Chiller Inspection & Maintenance is the official virtual reality training application for the ImmerseLearn HVAC Chiller Inspection & Maintenance Micro-Credential Program. Designed to complement instructor-led and online learning, this immersive simulation enables learners to develop practical chiller inspection and maintenance skills in a safe, interactive environment.\n\nThrough realistic hands-on scenarios, learners practice chiller inspection procedures, preventive maintenance tasks, component identification, safety protocols, operational checks, system monitoring, and basic troubleshooting techniques while following industry best practices.\n\nImportant: This application is not a standalone training product. It is available exclusively to individuals enrolled in the ImmerseLearn HVAC Chiller Inspection & Maintenance Micro-Credential Program. Only authorized learners with program access can use this application as part of their required hands-on VR training.", "short_description": "HVAC Chiller Inspection & Maintenance is the VR hands-on training application for the ImmerseLearn HVAC Chiller Inspection & Maintenance Micro-Credential Program. This application is intended exclusively for enrolled learners and provides immersive, real-world practice in chiller inspection, preventive maintenance, safety procedures, and troubleshooting. Access is available only to users enrolled in the ImmerseLearn program."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1665721812221290"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1678238839924457"}]}, "baseline_offer": {"id": "1678238839924457"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786978560, "status": "PUBLISHED", "id": "1678238839924457"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1691595269633944", "version": "1.10"}, "id": "1246030128593298", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1665721795554625", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1691595269633944"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1246030128593298"}]}, "change_log": null, "created_date": 1788876533, "id": "1691595269633944", "vers
uluscdn.com/v/t64.5771-25/507829686_1065394009770349_4756363336804822168_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a0h92hxl7_gQ7kNvwFaYyt4&_nc_oc=AdqmMPM8xXNH8tyhUuGfTs0SbPvW9kwmJGEsj2X_icm8xRBw-KZA8ZaMnOyzGgEgiw0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFY5gWahrURHxBJGgIgrBVm3HSMNqiwehbFSiOXAWNgqg&oe=6A92CEFB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Chiller Inspection & Maintenance", "keywords": [], "long_description": "HVAC Chiller Inspection & Maintenance is the official virtual reality training application for the ImmerseLearn HVAC Chiller Inspection & Maintenance Micro-Credential Program. Designed to complement instructor-led and online learning, this immersive simulation enables learners to develop practical chiller inspection and maintenance skills in a safe, interactive environment.\n\nThrough realistic hands-on scenarios, learners practice chiller inspection procedures, preventive maintenance tasks, component identification, safety protocols, operational checks, system monitoring, and basic troubleshooting techniques while following industry best practices.\n\nImportant: This application is not a standalone training product. It is available exclusively to individuals enrolled in the ImmerseLearn HVAC Chiller Inspection & Maintenance Micro-Credential Program. Only authorized learners with program access can use this application as part of their required hands-on VR training.", "short_description": "HVAC Chiller Inspection & Maintenance is the VR hands-on training application for the ImmerseLearn HVAC Chiller Inspection & Maintenance Micro-Credential Program. This application is intended exclusively for enrolled learners and provides immersive, real-world practice in chiller inspection, preventive maintenance, safety procedures, and troubleshooting. Access is available only to users enrolled in the ImmerseLearn program."}]}, "developer_name": null, "developer_privacy_policy_url": "https
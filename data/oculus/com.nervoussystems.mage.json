7ISZ2Kh7EboU4w_Wwz_OGUL90u9zzQ&oe=6A1843DC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "1546411486644278", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830147_1546411489977611_991397400042196411_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_bnRpsxOCgQ7kNvwFGUNBD&_nc_oc=AdqHWBR1hxKFzYOOdLwdc1Iqb7x_iWscoebv9hQDG-6HOj9SiVlKJYSM0eo3-AZ7AGc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5plQBtWyEaRVRPthYLDy1zCIHHidXJsgoI7gY-nPkdtw&oe=6A183AB8"}, "display_name": "VEX MAGE", "keywords": ["FastPaced", "BulletHell", "Spellcasting", "Coop", "MovementBased"], "long_description": "Merge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter. Claim your immortality on cross-platform leaderboards, alone or with up to two friends. Your name is eternal.\n\n# FEATURES\n\n* **Vexatious Combat:** Enemies strike from all sides - survive by mastering your movement and aggression.\n* **Combine The Elements:** Assign elemental runes to each hand and fuse them for devastating results.\n* **Fast-Fire Sessions:** Dive into a rapid-fire campaign of levels that explode with speed, chaos, and pure adrenaline. \n* **Co-op & Solo:** Fight alone or with up to two allies. The challenge adapts, so every run is a test of survival.\n* **Global Leaderboards:** Leave your mark and fight your way up the global leaderboards, where only the deadliest rise to the top.\n\n{849035310808875}", "short_description": "Merge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter. Claim your immortality on cross-platform leaderboards, alone or with up to two friends. Your name is eternal."}]}, "developer_name": "Nervous Systems LLC", "developer_privacy_policy_url": "https://www.nervous-systems.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://nervous-syste
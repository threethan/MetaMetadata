&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LFOhBvVFeJYaFh8lZGuIrIFCOJSWNuhAGr8X_0Ad1eA&oe=6A22EF4C"}, {"file_name": "4 Portal Ramp Screenshot 1440p.png", "id": "729850272999380", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491831000_729850276332713_2540624756466494590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=md4b1YNNbpQQ7kNvwHY7M8A&_nc_oc=Adq-6aZ1ty_tjaYL-cViMMmj51l4V3rVJlnkiCzmOCqnb4bb_tEtDQj-GTlt-corwyc&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8QtwcWXxMHTnj4xwVRh2ODlAxn_ilSQDSuecWgzYXQGQ&oe=6A22FDD5"}, {"file_name": "5 Dunes Screenshot 1440p.png", "id": "25032141656386321", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491831056_25032141666386320_1416697415066200177_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cSjySRgksh0Q7kNvwFDX_Gv&_nc_oc=AdpmRFvLsH33GjIOdWdbGih_HChbNi6_EmqvDAkZ0lDkmktYQ8zFSldJjB2rbs5vL90&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8PLFwJRJgs1dUpBjhGlTssGNNDJnGPdbpvgcUrp-Z1cA&oe=6A22F45A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail-Announcement-Meta.png", "id": "564085896669965", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491827038_564085900003298_2050004744367679070_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kb4B71q8m5wQ7kNvwHEScl1&_nc_oc=Adr4j5FxWjFZStwylp5I851lPBmXZtFZx34LdXgqbxo1WN2Cx1qLBu5dJlwL27sZlmk&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-DzxXGYTMi-t9bX2QWWyhEJmHtSlumbKiCVLhjkUJFoQ&oe=6A22E720"}, "display_name": "VEX MAGE", "keywords": ["FastPaced", "BulletHell", "Spellcasting", "Coop", "MovementBased"], "long_description": "Twin elements. Infinite momentum. Danger from every direction. \n\nMerge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter. Alone or together - Claim your immortality on cross-platform leaderboards. Your name is eternal.\n\n\n* **Vexatious Combat:** Enemies strike from all sides - survive by mastering your movement and aggression.\n* **Combine The Elements:** Assign elemental runes to each hand and fuse them for devastating results.\n* **Fast-Fire Sessions:** Dive into a rapid-fire campaign of levels that explode with speed, chaos, and pure adrenaline. \n* **Co-op & Solo:** Fight alone or with up to two allies. The challenge adapts, so every run is a test of survival.\n* **Global Leaderboards:** Leave your mark - fight your way up the global leaderboards, where only the deadliest rise to the top. ", "short_description": "Twin elements. Infinite momentum. Danger from every direction. \n\nMerge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter. Alone or together - Claim your immortality on cross-platform leaderboards. Your name is eternal."}]}, "developer_name": "Nervous Systems LLC", "developer_privacy_policy_url": "https://www.nervous-systems.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://nervous-systems.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "24258182193792774"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "25289482350640943"}, {"status": "PUBLISHED", "id": "1100178795559710"}, {"status": "PUBLISHED"
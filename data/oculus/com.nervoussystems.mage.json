E9-tE7AL8p6Hip-AumIiTVCC5IPRjSwg&oe=6AD3B11C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Art Landscape.png", "id": "1609418293482417", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499620666_1609418296815750_5619805930431487336_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jj2eIt_aBzwQ7kNvwGHQi79&_nc_oc=Adp0sbhnsk1wKVUTl6_I2AUI6eoTEr8eKyd0hfrRd_UfiZJvkuhadtuhq9OHl0yAmhI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_xOc87JJRcasUeQUPi629ydLujjRSA18SRtxIIg1jBg&oe=6AD39E7A"}, "display_name": "VEX MAGE", "keywords": ["FastPaced", "BulletHell", "Spellcasting", "Coop", "MovementBased"], "long_description": "Merge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter. Claim your immortality on cross-platform leaderboards, alone or with up to two friends. Your name is eternal.\n\n# FEATURES\n\n* **Vexatious Combat:** Enemies strike from all sides - survive by mastering your movement and aggression.\n* **Combine The Elements:** Assign elemental runes to each hand and fuse them for devastating results.\n* **Fast-Fire Sessions:** Dive into a rapid-fire campaign of levels that explode with speed, chaos, and pure adrenaline. \n* **Co-op & Solo:** Fight alone or with up to two allies. The challenge adapts, so every run is a test of survival.\n* **Global Leaderboards:** Leave your mark and fight your way up the global leaderboards, where only the deadliest rise to the top.\n\n{849035310808875}", "short_description": "Merge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter. Claim your immortality on cross-platform leaderboards, alone or with up to two friends. Your name is eternal."}]}, "developer_name": "Nervous Systems LLC", "developer_privacy_policy_url": "https://www.nervous-systems.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://nervous-sy
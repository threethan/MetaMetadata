5/499311613_1286498043177621_7495787486654202965_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-HpCnb_qS_wQ7kNvwF0QI0a&_nc_oc=AdkD0IHcCoLXp_Bh3T1t7r1KTjYme81UllBihAPKy8AqBe34O3MmhLs9OclzSYgAOgA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_Afykvc3G8ah08Vuuy4ZpuQX3ePieMQJ40_w1i9Q1vLOa2w&oe=69AABE8C"}, {"file_name": "4 Portal Ramp Screenshot 1440p.png", "id": "729850272999380", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/491831000_729850276332713_2540624756466494590_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ArtgSmHY3EUQ7kNvwG30gYT&_nc_oc=AdnI_8_Mapv2yMr__x7zoAC4nFWZOsftZoHsdzibYmyCGk9jcnBk2bJhXqbb9bYktfM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=8&oh=00_Afwa-XZCmhPZvGWrO9ZL9U6T_u_RKPlZnSPVtrDMIT8IiQ&oe=69AACD15"}, {"file_name": "5 Dunes Screenshot 1440p.png", "id": "25032141656386321", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491831056_25032141666386320_1416697415066200177_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aMYs5d8VRUQ7kNvwE1bH1K&_nc_oc=AdmpLeNP8GsRf55DIbuZR7RUXJq2Zzi7WrpIC9ygN4k9nF2wRsnmCczvQ0D6xFZpY0E&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_Afy3r6ux7QLzlZt73qKTZT4cm6A5yJZqAh8SNoBNeuCddg&oe=69AAC39A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Thumbnail-Announcement-Meta.png", "id": "564085896669965", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/491827038_564085900003298_2050004744367679070_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vhxtpBk3fwQ7kNvwFulZgQ&_nc_oc=Adk15SvdJWPuf-V2745pCf-AcWlVBeSiMjKYDxulymDpKRTlwhzAVkorFSmuNyhtHZ8&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzBOx4uqlO7lrbkJ3m9oETVPKx76tWeiszJdCB3tj-pDQ&oe=69AAB660"}, "display_name": "VEX MAGE", "keywords": ["FastPaced", "BulletHell", "Spellcasting", "Coop", "MovementBased"], "long_description": "Twin elements. Infinite momentum. Danger from every direction. \n\nMerge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter. Alone or together - Claim your immortality on cross-platform leaderboards. Your name is eternal.\n\n\n* **Vexatious Combat:** Enemies strike from all sides - survive by mastering your movement and aggression.\n* **Combine The Elements:** Assign elemental runes to each hand and fuse them for devastating results.\n* **Fast-Fire Sessions:** Dive into a rapid-fire campaign of levels that explode with speed, chaos, and pure adrenaline. \n* **Co-op & Solo:** Fight alone or with up to two allies. The challenge adapts, so every run is a test of survival.\n* **Global Leaderboards:** Leave your mark - fight your way up the global leaderboards, where only the deadliest rise to the top. ", "short_description": "Twin elements. Infinite momentum. Danger from every direction. \n\nMerge spells, cross dimensions, and dance through deadly arenas in this lightning-fast shooter. Alone or together - Claim your immortality on cross-platform leaderboards. Your name is eternal."}]}, "developer_name": "Nervous Systems LLC", "developer_privacy_policy_url": "https://www.nervous-systems.com/privacy", "developer_terms_of_service_url": null, "publisher_name": "Fast Travel Games", "support_website_url": null, "website_url": "https://nervous-systems.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "CO_OP"], "id": "2425818219379
Af7qfoSUpnZxNMI1iSHVB9aC-BuD2p-FtrCmIMRHKP6xDA&oe=6A032608"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xUIVSDJwa0Q7kNvwFlC-w9&_nc_oc=Adp8glKAXel40AwdK-X8uN2KHJcfLki7e1fMF5Hh90lFOnOEYo2vYWrmfhOEQGpvT6Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5yfFgeKFS8yty6sf6Kb1JlZfMkN1yHhaBzxtgvVIc6fw&oe=6A033D6F"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eHzJTzYWvy8Q7kNvwGcERaH&_nc_oc=Ado2cFMxulC8x2Kv9ChWTEKHW9UQ_FlYIaDnW4dROzNASEDoLLicCwK8xtvO4rmYN7c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5pGNvW-FrVq1fyUaG76v42DvR6vn2AxlYDoAYWjQCKrA&oe=6A0325FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TGdurvKS4wQ7kNvwGTn5tG&_nc_oc=Adqet3V1RKsetn_PP-IsChpwTI5USi2iv1SRaXWDvLGSNNVA1wF0wgjzC9FFw1am3_U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iJOWCG81cEdEXCz46eBMhpD-J4D_Vhbw2w4U9nsO2Kw&oe=6A032545"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26972471472360176"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298900_1241546657748471_2178876449822130744_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6lwhatmeSz0Q7kNvwEuBn79&_nc_oc=Adoj2SAxoGYdIMKaUAUWHxt2MHbAvOkBANUIZvpn5oRmnE5ckwEo8Psv_AAtLF2TWM0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40PMom6UBk7Ve
luscdn.com&_nc_ss=7f20f&oh=00_AQF3XRj0IAOkNde6_aSzz8VWXL-WGDpvYxcCEfwlDFYtNQ&oe=6A8D6FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLpbWQwpHtsQ7kNvwF7md4N&_nc_oc=AdopcFL6AlQm3ajLdtxVekmGlbcKP1H6WYedT5imOio_5CFP25sbFDtWgVYo_7XptqY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-WM4z5W9Tvihu0QKTYHm8TMQCCqpmPms36mKyIT7-5A&oe=6A8D92C5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.c
t=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3QY7fPqslpP-MS481YZAIBSNMzwNy59mxDJszlPZmsQQ&oe=69F5E53B"}, {"file_name": "ScreenShot3.png", "id": "1360304706146411", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499622325_1360304709479744_2970550790323903502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1rGou4vaUskQ7kNvwGiXCgz&_nc_oc=AdoJoVIMhvO7GIfU2-3SlRef82M_wcsxwdgQXWIr-8-KmoiDFOghtiJPblV_8SHyv2w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3xRywg2Zk77_v408UThciJPSc_oyeuzfxXueaxQbWIDA&oe=69F5EB1B"}, {"file_name": "ScreenShot4.png", "id": "1504094964574810", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/595112037_1504094967908143_2211669407358132130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fp3A-esyYZoQ7kNvwGZjM4G&_nc_oc=Adq33duYFECq1NIw230TMc99y6ANj3C7zzUO_l8i3dU62r_otLQmd3omRov5V7dwNCA&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1lVGtAWxix-TmaLduoVpftR-9ulC4rt9sMDgqCorpl1w&oe=69F5EA3A"}, {"file_name": "ScreenShot5.png", "id": "25774661712208146", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/673573223_25774661722208145_4882846667084287800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=35zwUD77VL4Q7kNvwF2UFA9&_nc_oc=Ado_q0fmqTDzNcZ7fhzR7KntRjBPPJdynaQ3Dwm9CSDPVdGq0Co4JnRxThwEAUAUq9g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af04_neK6E-VcAZl25da6n_bSz7SJR6Brluu3caKyveHqg&oe=69F60B9B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zTSo7WHlqmIQ7kNvwG5f2Ri&_nc_oc=AdodDsbtg-MJYF6szDxcM0DO7qUjGpvI5Jav66EHZW6C6hEWP4Hp3WXdB_GRLm-lRvo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2w-PvuaxXSb4a5l_6TE4kaDJL0OsAFCBnxRm5sOyq2cA&oe=69F5F645"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported
Af4sh_gisW_s83xL5x4JDC5dI6JNFQHKcirx0scBqTPE-g&oe=6A198F88"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5o9bzEKDLY4Q7kNvwG_bigC&_nc_oc=AdpRzmF5_5wYr4JYgkYVn7Gp6WGHi5J7L2wHbJnwhrL3KKh3gzVLzYT176Bcp8qoCyg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iQ8SNQqy43no42MkR-4tGfUdKHK45JaUDL-dI3yzg-A&oe=6A19A6EF"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kmlse6vJ2zkQ7kNvwE8VUOZ&_nc_oc=AdpFt94IGVFSi2fSDref8a0ZF_mF6ZXz6dq0mS160K4fdiJbKG4t0xZ3M2iu5v4tivw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yBO_iRAonnfZhec79baYE4TmtwzvOMO_2LykIwOT3PQ&oe=6A198F7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHkNnIdXA_4Q7kNvwE-_xZg&_nc_oc=AdrWK_0hpm50D-8RW3Cvyu4aH3KpL3RhWd46bM9rofGanx4rtBfBszo_iNNGnWGZzkk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MEnmTMKWXkzsy682pHUUDc3SGsLRNqy_u5ETwLGi_0A&oe=6A198EC5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26972471472360176"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499298900_1241546657748471_2178876449822130744_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JIakDdUXQBgQ7kNvwG-dH_5&_nc_oc=Adq2ca9llH4jp4uqkYBQIWGNfyJOQCZCMaVrRqQJIU4yKiI-vHsZrxftkTdQimuxka0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nlaeswYOyiZX
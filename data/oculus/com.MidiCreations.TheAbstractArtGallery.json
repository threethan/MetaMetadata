b=1-7&_nc_sid=6e7a0a&_nc_ohc=VAix9oaPdYcQ7kNvwFzKgob&_nc_oc=Ado1h02jADCODjXOL6d6HqwEu1Uet-AkCaz-llDAf3RoEjjUPq6Jv5Svux5jmfZHmnM&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ5XT85zu-xIoPp-cyoYzy1ubn8syBwUxT6Jt4bKJTovg&oe=6AAE8E08"}, {"file_name": "ScreenShot3.png", "id": "796010373336947", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499619672_796010376670280_1622690528672245878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RMlXKUSdwocQ7kNvwH9-jHu&_nc_oc=AdqD1FCCb5z3Bn1yO2l3x37sMEctJN10SETlMQUDAxF9kj2eZQyJda5tGqJnlxNK3Zs&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv0eK10FJtXfUtGzqR0AgRhyJbunZ6V3TinFAO01uCNg&oe=6AAE8908"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ej9O5Rmav1IQ7kNvwGuFdv5&_nc_oc=Adre0v2KLMAOqxu6FO8Q8Y-fAT96j0HEq9Rr7cGgWi_rS_wNTg8N1R7bTJqydYOQ3SU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnBtcdgtar9BAyCp7rsOtzu22F9oz2N_bb9MrovxNUYA&oe=6AAEA06F"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XjPNkxvqQoQQ7kNvwEmuzmr&_nc_oc=AdpBIuDaUfsjNQ7NQy1ByRtGXW10jrMGfIL1rgR_CsKeolooNU1cMuDdHyNOkjVm028&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJaiLwk9WcMEYdqupUY2UG1Ax9N2OsNEc-rtfQybMM-xw&oe=6AAE88FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oOc1GOnQFlsQ7kNvwGpbShE&_nc_oc=Ado_SwBNfJzkRLxm2OFH9RhwTVo33WvCZREcrb4mMgUQhihm7-Dn8xvLBP6ZuXC0GWk&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLJ2npcMP8qMS5DkJfTUo6EixBY5zteCRWIvp1SIspfDA&oe=6AAE8845"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_langua
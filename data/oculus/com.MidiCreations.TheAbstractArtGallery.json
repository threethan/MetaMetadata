t=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Fd2ylP2tqo534kPIgTmq_gVyQ8AGVfHnh-N1t7yQQfg&oe=6A16DABB"}, {"file_name": "ScreenShot3.png", "id": "1360304706146411", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622325_1360304709479744_2970550790323903502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eBboYrG9ZgQ7kNvwFBOWiO&_nc_oc=AdoHONMvTVSHskLHYik0Cg6FgNKAwFi5C3c7R_qOb4XpmWaBk_grx_St1GvBNYkGRy4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eHdGu6iqVcNhw6iCNNCymEw2CuPRG0ykX3dyQtGhfwg&oe=6A16E09B"}, {"file_name": "ScreenShot4.png", "id": "1504094964574810", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/595112037_1504094967908143_2211669407358132130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oBukRbjtIR0Q7kNvwE9XBZr&_nc_oc=AdqEtPnhgHuZnXQ2_VhJA512DVg84whyyWkKpmxEelTYptHivAkVVFomh9rHsSDc74w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TvB9JD7AUQX-SNTNzSa6K5pq5x2oC1oycxdhSl-DvJw&oe=6A16DFBA"}, {"file_name": "ScreenShot5.png", "id": "25774661712208146", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/673573223_25774661722208145_4882846667084287800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SG3rlsP4TfwQ7kNvwFhrHXB&_nc_oc=AdpZuyRP31bx7_JvDJipnqpTRXeFiU5VWu0_BgQ1UPndjsGxLeEIUmZ7bbeTnzcKd54&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af46bM8aRPReYip-0TiSxedGNgjKkkPVqlrgtsZhP8tW8A&oe=6A17011B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fo1mcDfdtyoQ7kNvwG0RTg5&_nc_oc=AdowWOXEfpuh6L_sVz-B9MmlvX4AmVXb10dMBQiQWLAW0-yYCrHgMPFX0AL_-fVep2s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dfhYDj6ZBzwZvxtMGhk30-rftrNDdi3HQ6cGqT6CTKg&oe=6A16EBC5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported
ile_name": "ScreenShot3.png", "id": "796010373336947", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619672_796010376670280_1622690528672245878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auPMN1IpfEgQ7kNvwF8MLCL&_nc_oc=AdosmMK3IJBoSbioy5S_-OojZI1CYOmqsygj1JcPztn_1a8e5Rjqz2C4x42RVoSAuuc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8l_mqb8ep49F3SHq55KqJfmFgUD40I3xhUiVBgqdVFRQ&oe=6A411C88"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2A574kyL4XEQ7kNvwE7Wupz&_nc_oc=AdoGnR6gTjCp3DPZQ5F6EH-yuPwy-k5NnMmboAnI2zhVzc4-41v9RU203hIS2CIDb5Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wSI-uOo6bOKrltFa4xAnk7JBQNa54d75_dYa0LVUNWg&oe=6A4133EF"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ORSku48DFAQ7kNvwEnU0A3&_nc_oc=AdqIB2XdeC2DzGeYJhZnZqhvI0onGSs8UfR_7b6MjlRH5b_jhgHbHKARGYpS-FfFm30&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97l2s4frON9Ar4KZdxQjtV7ghakdpTXWASc1hsyICSCA&oe=6A411C7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALMcgGhNfQMQ7kNvwE-45Mx&_nc_oc=AdoPXrJpQxNqyOnuktSX1sJeBxUrZxlpA-EJM5FeDahNnuOl2p1c-C1kCgLJVXC8pkQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8iXCM8uMk6crFglNGn-nmmfawys4Diln3XJ1w1iwWR9g&oe=6A411BC5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26972471472360176"}, "review_messages": []}]}, "cove
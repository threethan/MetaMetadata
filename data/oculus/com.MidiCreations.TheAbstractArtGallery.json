vWxJf3dx9VKr7_znzGLXy4cQTa33Iizuzv0TQpw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQY4277AhEieDGeecOt6AAMj7OHg1K9pRgsTDjoG-KAOw&oe=6AFF1FFA"}, {"file_name": "ScreenShot5.png", "id": "25774661712208146", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/673573223_25774661722208145_4882846667084287800_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4RaD7UIGQQQ7kNvwFwzr6p&_nc_oc=Adp3rfzdMBVTci6p5QM1k35_iBk_pFyaMDZp33_BqO_QaucUlPeawBvxrQJiwFYrokc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaj1b7xBj2992MCvjyBvc5k-A-RDugVnhTtaG0G3Z6nw&oe=6AFF091B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29T46wHs7BgQ7kNvwHGLCDa&_nc_oc=AdppD0pgUHLRoTDpP-em5W3Fuzz-Cnc2ysPmq4IAErutb9sn0kuetkkMZ7UQjXHozGA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR3W2DoZTwtndkDtGvcxUmmldUYnTPUd_rioWA88tJUjA&oe=6AFF2C05"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26933730269567630"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "976554924749695"}]}, "baseline_offer": {"id": "976554924749695"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1776772680, "status": "PUBLISHED", "id": "976554924749695"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26968299406110716", "version": "1.01"}, "id": "840716725056319", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "269
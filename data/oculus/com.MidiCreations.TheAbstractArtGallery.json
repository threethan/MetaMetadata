7IlGZTBC3YyJ_rWQgKorYdnBUum36E6nUOpZLxkxRO6lCk4QO_H0xXbNBQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_v5Z7eodOZgX1Mrm9H_tWpYOFcuQogHD8dsJCDDk8h2w&oe=6A2EA788"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q6vb61E7l7QQ7kNvwHJ6Mcy&_nc_oc=Ado7OV_rZf6cductMZUmvYd_qXLAAWslOd-8DOKwBaj75uZn9VpK7EO6XRX5M9gB9EI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-V_v-PI-THvmv2g945hVDnt-IcUJ-tjKZqMAq3S_NaQw&oe=6A2EBEEF"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywwB3cX1ZC8Q7kNvwH70aDQ&_nc_oc=Adp0Ur4sT7spgw7HYF1Z5-296JhKt6DN7vVxETuU0i9NbrDyCiPrth0sB6argQSgEoM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QGutT_DPb0uZuJdRPHwv9hVEt7ApmoOreQJgx0a_agA&oe=6A2EA77F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbFyhl0G30IQ7kNvwE7nYTZ&_nc_oc=AdpJVBYQKR-JRBtmmTlaHz04bk8vAdj7maqcHBMhTww6M64zfN2inn3PUOFd8NMUeVg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D6zXYwPIJXjo80jx0F1MnTqgW4eczn7TASP-le4ThnA&oe=6A2EA6C5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26972471472360176"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298900_1241546657748471_2178876449822130744_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pe7IaQ0lP2gQ7kNvwFvRrMe&_nc_oc=AdoqPxIU9oBEB4TDbTJactPw
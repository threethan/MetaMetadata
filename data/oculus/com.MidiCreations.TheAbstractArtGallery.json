796010376670280_1622690528672245878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6nEGQHWsA0Q7kNvwGVs_lC&_nc_oc=Adq9I1OQBhZ4RK3L_dE1MjmaX1owPKLDLBstx2hdU6DOrrXPzRoc4YpG5c_Es6bQIro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fafHcS_FuWsCDP6v1EujD7-r39p004bCDEIs4_MYDDw&oe=6A37E208"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDe16t_c71oQ7kNvwEOE9JP&_nc_oc=Adrg1iaSaJD2Gx-BfmJ_Tw0onzH4PhfXUYlgZXFDcFc0fAwfepT0gO4CvXvBR5E-WSY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8gP3yxkuwCI1kMfiS1tQYqQI7GRriRIS3XTqyS_oh7xw&oe=6A37F96F"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsvLH0qpIyoQ7kNvwEDYVY0&_nc_oc=Adpq6wwc0Upgae7QRwRl5eh_7jwZaSc8q6MaY5SVXfOf9iHf5q8ByJ7b2up50ipVzfc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_LOT1pjVJ9j2tMg6sL2S-3e5ODPtN_MeYQA3QKhfxjVw&oe=6A37E1FF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTFBtRXvFNcQ7kNvwFdd-x3&_nc_oc=AdpI8hzszuaOkiUsUYis1YLcoej_tky-a9gqc6e4lMjVQugUtpRZn_oCJH-IGYog_DQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_s5s5j_Of6bhf9OCyVeOq6QmAp6od7BaSNp_dwvP-6fw&oe=6A37E145"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26972471472360176"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298900_1241546657748471_2178876449822130744_
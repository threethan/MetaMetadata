t=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af42B96DlPnrnV474XWrXHOIqgtpg5_KlP14iYr2OZnXOg&oe=69FB2B3B"}, {"file_name": "ScreenShot3.png", "id": "1360304706146411", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499622325_1360304709479744_2970550790323903502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zQh3fJOKG90Q7kNvwGcUaGb&_nc_oc=AdpUcH645O1vIZ_8zsNTFHtPc9jrVURGiuYtI6tvD-ac1fJ3kLSaqbqoqadkz9doVWk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6J4pf6_ZL4-Xw9WObAY-VpWSUBjuNHojLMTXuGH-YF7Q&oe=69FB311B"}, {"file_name": "ScreenShot4.png", "id": "1504094964574810", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/595112037_1504094967908143_2211669407358132130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JJ1U5XPyhgQ7kNvwFIQtpc&_nc_oc=Adq_Vf4z-go7INlF3HTcV8HKXb6zW_pzrFQOlrRaKkBSums6dA9p32NYGhsY7vztVfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7lwZGyUL1n-1rUHZ3hXKw2DUYs3Nuj9nU9E_aygZJQog&oe=69FB303A"}, {"file_name": "ScreenShot5.png", "id": "25774661712208146", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/673573223_25774661722208145_4882846667084287800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBKgd4RPkf0Q7kNvwFMsiJW&_nc_oc=AdpKMcg28DY0tRoixUOQqCC0z-7OuTvmFMdzuTm2oDFHygPY_oySdsry1gj2z0cOoSw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41nnT66jNX3ieG8oMtwDSWgngrcq-_1xProcdekC5eMw&oe=69FB519B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zvkOxw5M0MQ7kNvwHcyC_q&_nc_oc=AdqWUKirRHAfW2ONTxs4X51ZtC-fXdY21o2YgUC-YY2UKX5gLhtObNZuaU9j068ANVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XpN1wKkR4a8th3UfSm6VIx6SZCu_kTTj_Pwz0S1-_9w&oe=69FB3C45"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported
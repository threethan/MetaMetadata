Af-3oU2XdOrMk8d5xYWOUH9ABmgSPRgqk_Hf9lyoxBDjRg&oe=6A241B88"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7q0NH5pGmC8Q7kNvwFnZYtr&_nc_oc=Adogmyv2LbDtwjYHPo-xXjDbweNvyYZDMZW_1z9x8NwpQ2W2ES4dVHpECcbCWgfvlr8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8J6xwc_e1ufQdrjCHEdbNEV5Dq-c9-xAQscDnq7bACuQ&oe=6A2432EF"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0OJ_FTCW-RcQ7kNvwH5tfNd&_nc_oc=AdqpYtjgat6wqh5qD1JQn2KqhTB9kiU7YBCM_tKJEahX7hBDZM8yYrIVjSIHvLUAYTg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5PqlSIZtqRvJyc8_3t5DAqtAhDaHL-cgaC2QF8rdREg&oe=6A241B7F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h2JGS9e_GQQ7kNvwE7WcrJ&_nc_oc=AdpGy3GpNnHVoNRZ4n_E7ObPKMIP9lKVgquJoDQcH0XvIZglLWYavk7qx5GthASc3lQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ijy7glFWN7RIULjdobOq5PWD3_uNhSQCQ_tUVHcdxWg&oe=6A241AC5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26972471472360176"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499298900_1241546657748471_2178876449822130744_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlE-_q_9uFkQ7kNvwExQroO&_nc_oc=AdpWpyjuWLnu3Q0csJD7Of2Aj8aC8ul1Sxu2wEiUk9IcJqc3f7FEgbYPhl7t3LYhpSo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_atFMSEZaHvsw
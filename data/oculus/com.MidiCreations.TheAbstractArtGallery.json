t=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g82HnbEkPRcu8bSxfec-gbVskpXcLlG3XENngzo0LnA&oe=6A0C86FB"}, {"file_name": "ScreenShot3.png", "id": "1360304706146411", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499622325_1360304709479744_2970550790323903502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VFa1R230kJMQ7kNvwHCqXUU&_nc_oc=AdolDAZlbXDTqE-ZX5oMiCbcEaEs-KRj-8dEs77z4kajHwMKTWqNLO8tjzCVBQ0vO2s&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XA0svkJ6QM2KyHzcQVXP6DKjH_RBuWDnERW3wdnewQA&oe=6A0C549B"}, {"file_name": "ScreenShot4.png", "id": "1504094964574810", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/595112037_1504094967908143_2211669407358132130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxkd9kGguHoQ7kNvwEchP1H&_nc_oc=AdpodAhhEAXlrM6hsjO_bYBkLDloHoEHVbj3DyPOTZCOi32TupnVYdLFDcr3c6aXUi4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af497pMiMqeRS8w0-yRfQI-OpDiGEIb2McnhAOC5CGS_Eg&oe=6A0C53BA"}, {"file_name": "ScreenShot5.png", "id": "25774661712208146", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/673573223_25774661722208145_4882846667084287800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCUrxrjaP7QQ7kNvwFN8i5U&_nc_oc=Adp_3Rp5KcbNVj8OjYpUYF0xRxHAyAMK8Oar-rk5RNeLwsxDJhjCxUpuKHCNpnDC7As&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BDIgooyRpjjoRXaYUWM_rJo2U9XQNRUD001-mXbuYkg&oe=6A0C751B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4g_sLEisWs0Q7kNvwGf6YxD&_nc_oc=Adq98jLUzXrtYvK8XulJk5jh4XvQZKKF-r0S6yonLD56e5irt3G7fuBetqHLaRtub2E&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Yb9vr2_lFU-BB3xGBoQSL8YgZemV0P1RgF3JptCwe-A&oe=6A0C5FC5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported
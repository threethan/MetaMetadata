19672_796010376670280_1622690528672245878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymfTJl1QrEUQ7kNvwFcM4fA&_nc_oc=AdoA3xPttctMQUIuodMNVTQrGDey0otsNGVqa4C40EFMFIzqg3MwNxQEFAlHfk8SMa8&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-MmsWU8qVVSFf-V9NCHQAZPb3QfstQAAVFjWcwUXw0A&oe=6A369088"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SAjw4gx9LwQ7kNvwFJVeN5&_nc_oc=AdpWeGD9SzUGtMlDnErr2QEg0657DEmOFuKoUGN6P3JwxA-JUHTSq-T4XLzkVidxoRg&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4DAbD5mBtn_pLn5qR03jFqCMwy4RR6dhtnWXEvnLJUQ&oe=6A36A7EF"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GTPG--mHIsEQ7kNvwHxsUI3&_nc_oc=AdrmRDbx58YTDQe3CJuGmcuo0pX2Ex5p9ZW3cktJMiw-pZkzuS2Xfhn07ScmzCNFqcE&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-z4uXGnI1TVIGabVUlzEFf0kFRtyrfsQCKEG9XCinu6w&oe=6A36907F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTFBtRXvFNcQ7kNvwGfLjy4&_nc_oc=AdqTl0yVU3BfORaKBcm9drZPMxlIPdvZCOPjZVkR3Tjoq9QbziY7Xg7HBvGQZvwjT4Q&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WxHXlv4lPjT4_xdynLaCQBo-P3FqdAZ7ZyRcNHLs63g&oe=6A36C805"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26972471472360176"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499298900_1241546657748471_2178876449822
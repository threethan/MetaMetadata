.5771-25/499622325_1360304709479744_2970550790323903502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U52KNPkU9rQQ7kNvwGgIZGk&_nc_oc=AdpgzaYCxKbiL6NBLExyyjXSI08Y9QlHZFEXCrhIgMJss2YnXxjkVHwGf_bu0fo4-T4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Il2KfCCWlGwJIffTZEfFKAn2cHv1LoaZbtPydjMS22w&oe=69EE021B"}, {"file_name": "ScreenShot4.png", "id": "1504094964574810", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595112037_1504094967908143_2211669407358132130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2sSAvFE43aYQ7kNvwHgbQt9&_nc_oc=AdrO10iNCdmtIHA3mRoYG09rWxzko9ULH8wXmUKIeJqjTXv8H0OfbiTrH8X9fLFq3WM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mHePGSIvpc3uZL-HYk7TJoQO9WcAJqZ6n5PFwh0to0g&oe=69EE013A"}, {"file_name": "ScreenShot5.png", "id": "25774661712208146", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_25774661722208145_4882846667084287800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XWM4zqW4dOAQ7kNvwFMAycj&_nc_oc=Adp0ms978cENUOPFeaPR4N_g_1JKyK6j-3G3ViPNv7QNQOxtNHvSfEsAjRB5Y5_Oq4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sSC5IuxKrSmSDp4aqAIgJgts5q22KjdH-XSguKEufQA&oe=69EE229B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MlBMIZZl6sQ7kNvwHX-2Kw&_nc_oc=AdrdDh_KZ2ulQPoHRffMSYgSrI342LJ3G6vfttbjmLn6zA4YKkW1FdU9yFATJdGAsH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10E5zAWaE-jwAZt9wqwKfCNI12fokHWOqNjn7FmQawvg&oe=69EE0D45"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26933730269567630"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499298900_12415466577
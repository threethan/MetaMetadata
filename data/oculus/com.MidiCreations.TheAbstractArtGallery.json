&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ppyac3tlljEQ7kNvwFQkYZx&_nc_oc=Adrcd0KDANTY6fmsTmckJJBRbxwSRFHDvKeZqZJ8449tRzoaMXuEt376pbasuMncBv8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqc9k7dwO7hvbxO22OCvKSFP1YbB5_nyO-JzOeH9Mjbw&oe=6A8D9888"}, {"file_name": "ScreenShot3.png", "id": "796010373336947", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499619672_796010376670280_1622690528672245878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OsfDvgwPOnUQ7kNvwHLoLwH&_nc_oc=AdqppaEYQO1LVO94kmYPQIbUS5j7oCPgLUrfRMHK1mLLzuvlaqcg-0N6LfaS9m5nGZU&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzn2LjtDQG7qC0EZn3I7QFGies5A4NwqaJ4qiooEnn5A&oe=6A8D9388"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=euNGju5UpLQQ7kNvwGb37An&_nc_oc=Ado3vO7Y-UtKHVSEJds0dHRK4hkeDN-Rh5XcL3FLsWCArh_0thxgwkOWyjAetYjZqeg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF2LSxAMySa5f4jv2cS0iORAmE3o8lrNyA5--_atooQrw&oe=6A8D72AF"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVpMOUtbbnEQ7kNvwGOSVdb&_nc_oc=AdqUF4cEXHQNwYcKezqsSJmbjalMZviC2NNOdeXAkUZKx_zoQvJV--gdmMSMIFR14XU&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9p1vZQPqeE85DsQrWI7J5UC_iFFnNP5586k0V_-CA1Q&oe=6A8D937F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DLpbWQwpHtsQ7kNvwF7md4N&_nc_oc=AdopcFL6AlQm3ajLdtxVekmGlbcKP1H6WYedT5imOio_5CFP25sbFDtWgVYo_7XptqY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF-WM4z5W9Tvihu0QKTYHm8TMQCCqpmPms36mKyIT7-5A&oe=6A8D92C5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
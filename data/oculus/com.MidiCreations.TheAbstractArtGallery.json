t=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aCYjvaUFz5g_8QjGq9qVPzSYMGxW18tGuUhvdhXXuyQ&oe=6A01C2BB"}, {"file_name": "ScreenShot3.png", "id": "1360304706146411", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622325_1360304709479744_2970550790323903502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6E4pL2XzuuQQ7kNvwGnxTCa&_nc_oc=AdqYYuneW_h-BOetzaTWx_EyNGeihfEuMg_27dxoVfDFSEUhMAyu17UI8h_xs7d79ro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Kcu5nCn2dEQfbu-2ClAYuVcY4QZ06yiwyhMtdkhLUFw&oe=6A01C89B"}, {"file_name": "ScreenShot4.png", "id": "1504094964574810", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/595112037_1504094967908143_2211669407358132130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mbeYv26cfncQ7kNvwHy681D&_nc_oc=AdpMPRHCI8rgHYqorrlBmeHQDjSkQhRHf58bJPWMjkAzd7LqpMpQZM0HvaCrJ3w5cnI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af67CO_A4H60hZuAs47OSQdwdr8s5ahcY-1DRMD7dwOyKg&oe=6A01C7BA"}, {"file_name": "ScreenShot5.png", "id": "25774661712208146", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/673573223_25774661722208145_4882846667084287800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_XCJ6ig-dfMQ7kNvwFBqkRo&_nc_oc=Adr1jdwHadXyJx8wV6mr2UHVPdMkJE7erma2u0PWS5YR9M7X1rI5gu89dSOga11sHPg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cHGirH2saU_E45dcwbE56DMvfyvDhLRIlIaFgNoIzXw&oe=6A01E91B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7TGdurvKS4wQ7kNvwHbtJp6&_nc_oc=Adpq8D0r8IUefqfl0VD9EYoguXoxgUifJQZgf0iWbWT3zkzziz9q348P_h06nUSP6mo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wHXGlwGIvMNnXLAo5FadgETcmRkjnF9j9XwgZeT7UJA&oe=6A01D3C5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported
19672_796010376670280_1622690528672245878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n6nEGQHWsA0Q7kNvwGiZnq0&_nc_oc=AdrrZW0cR_emKxDz9pZ0KbJcTreD3sS3l-lPt2NlyhACeiRUgpCQAZeVgFW8FoZFbAI&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8OuJwfE1bODOLDTzDD4Zy1t4_GXZNpou9eUZbVfAJF-g&oe=6A393388"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tDe16t_c71oQ7kNvwFpf3hs&_nc_oc=Ado6019e4Mp8ipx29SfOAGfXESGBJX_S4KZ3RpO-8vazvfC9CO0OhuxxraOIEm8nlV0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9-aKKm8fzWFYa9b8JoC4IPpGn8aJCMPBEM5GPMDsG7MQ&oe=6A394AEF"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TsvLH0qpIyoQ7kNvwFwCcbd&_nc_oc=AdoLhEPm5nn3JxXTySSnG0kJsOWYb4dN53GRU8aPQx6ma-ZuGkWwu9xE-H1CoujHnk8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_dG4ji47Cae_gdxvH6WD0bb7xfp2MtzesO4Nx1tA8BLA&oe=6A39337F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPWkq4MmU-oQ7kNvwHBDEj-&_nc_oc=AdpjrsQe3Z0aw-kGGgvVT4Y9YRmFpx47ZQeolETj4s0zzBNio_5KWdxbN9Q_mB_W4GI&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-Sf_1suvLm3CwTwO9xmvoFc5NAWrhtQ2O38o35qVbYg&oe=6A3932C5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26972471472360176"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499298900_1241546657748471_2178876449822
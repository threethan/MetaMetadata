t=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y_QO9bhqiQImNNBaQtAGvj8dM-ihfCscuMw2vTudsZw&oe=6A0740FB"}, {"file_name": "ScreenShot3.png", "id": "1360304706146411", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499622325_1360304709479744_2970550790323903502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j8w5oA0LHVYQ7kNvwEnqtk3&_nc_oc=AdrV3bujs_aligi5moTs5JgqpIXLeqW-XShbiacfG-8Xs9Ml06RdI0gs-8nc7a_H3xA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AKVxJst2jX6fhJAAbOsXiEJEbwtReqGmMw8rOunM-ew&oe=6A070E9B"}, {"file_name": "ScreenShot4.png", "id": "1504094964574810", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/595112037_1504094967908143_2211669407358132130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0geQ3JoKPAQ7kNvwGAF5bH&_nc_oc=AdrJEfHdHSMajjOGcWZyEMpM4rzwCzP-raTe0cjoVANX1sHN0gye0XC0e-LPlANML0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EAnL7wj1GtJdMNjHKEP6uCNlruH4UItg-oI1P8pkrVw&oe=6A070DBA"}, {"file_name": "ScreenShot5.png", "id": "25774661712208146", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/673573223_25774661722208145_4882846667084287800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cbZInRx9nDsQ7kNvwHbO4Ar&_nc_oc=AdqGiidLn4jcycg9LQGrzMUOx8-gYGWbs_au_nxKKbYHmnQqXMLho2sBX-C4itdvfMA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qbdbpA0YqxRzkiFthovKHtE8ivnbXj0G228sLUtKTPA&oe=6A072F1B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVH-keXVifsQ7kNvwF40Wjh&_nc_oc=AdoY7SwnFK2GcXFJ3l9DMSoI4oR-T-sLjscpRfK9HehGzOK5cbqXIccVhyopatYRcpI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Uhcj5oZLe_28cy2e73nqkD-P4a_bLrKJkgXzA132mNQ&oe=6A0719C5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported
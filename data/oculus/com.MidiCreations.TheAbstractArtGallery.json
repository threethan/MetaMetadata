Af-zl5WSDVVBDs5VLn98nszYbC__IQlsEd-ZXn2I62A4XQ&oe=6A217888"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m8OWQE_nJMkQ7kNvwGikDAZ&_nc_oc=AdpKz5nJl3IHaZ7YjIxGa_j3FpaxMnhNsfDperKsQl9lSJqpcJCwT9BboSFWOe3dnLo&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_MXEZZQmcogECyIGmoBx89yjXqBiYo8CoFLA9jNJ_qbQ&oe=6A218FEF"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6TYfQIAHdR4Q7kNvwFtnyiR&_nc_oc=AdokU8IE2SmPF4ZYz5VgGlfX_p_TDi7EJPPuKC0zH4rzPIM_mNL-CgQNSTsD5I476z4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_434cm4T4x3prtSFkSUA4dFHXysO6JRaqDBK3_RjcdqA&oe=6A21787F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h2JGS9e_GQQ7kNvwEJvlz7&_nc_oc=AdpwKM5aZ2zoTndNYuzRQodRKLxCl6JO_Z5tXQ1uxjFeBc_hArtKcX8Akb0GYfMETtc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Gn6VvfPeimIjr5HZfeTKsT7LScELTtYa_EZYvsT1wXw&oe=6A2177C5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26972471472360176"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499298900_1241546657748471_2178876449822130744_n.png?stp=dst-png_s360x360&_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CX3EzVOCZvoQ7kNvwExxmVy&_nc_oc=AdrUgTlQprMmzQTmQk_0x5IGqXq6KV4sAU225vsdbh0QPrVs5e4yAVUkSRRQMj7VAus&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Z7jKZt09vsZ5
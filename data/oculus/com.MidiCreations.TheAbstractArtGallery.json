ile_name": "ScreenShot3.png", "id": "796010373336947", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619672_796010376670280_1622690528672245878_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=auPMN1IpfEgQ7kNvwE9C1ub&_nc_oc=AdreHbUlVy-4LaZMm9XqyI_p2jrX0uvF_ffw1v_QR4CCXMd2TjG8YvfHQPBoChuBmeA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OrbFQQvHR4XjEWjLqDtNrwHOrysQf6nPK6CKEfWCEUA&oe=6A3FCB08"}, {"file_name": "ScreenShot4.png", "id": "900207153052082", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499619594_900207156385415_3810073691747307333_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2A574kyL4XEQ7kNvwEHQv3n&_nc_oc=AdrMiVcLtxI-xcQvDIQw2yr9DP8gD12yL0WSiaIC7jO3zjvV9jV2QDOeZhXKrAUrr5o&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-rqbXdiuiJFvlIDW6QhBvG1oGu7wK5tluCRndd-jFYWA&oe=6A3FE26F"}, {"file_name": "ScreenShot5.png", "id": "947398901258988", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622214_947398904592321_4765479034696321724_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1ORSku48DFAQ7kNvwFYtYOR&_nc_oc=Adpa0F6Nb1dOeO8Li7FBQCDxIXtEKWGdiV8osfTzHaBIgwAGUQaUkblpA3jg1v3uxi0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EZxwBwPzP64lLUTbo7yCvkGjIU3EVWelpNDTquTartw&oe=6A3FCAFF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3SFCuYhq89sQ7kNvwFbCoO_&_nc_oc=AdrVX-3RNEq3TKSIse0kbhOcertKxIbiNRQ7Qmk3G8DemIqbeos4BTpNFQXRZdOHsEs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Wd5xBx9U87tPlV_95rANQqJSA71588VaTgpw_PzulJQ&oe=6A3FCA45"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26972471472360176"}, "review_messages": []}]}, "cove
t=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tYuNMn5wdfDECFTyiusm8-0vG6J9IKXiftzHF_ZrO7A&oe=69FCB4FB"}, {"file_name": "ScreenShot3.png", "id": "1360304706146411", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499622325_1360304709479744_2970550790323903502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24M0WIyAl-kQ7kNvwF5olzq&_nc_oc=Adrw_OLBm5ExfAnYB_5A2iheUTx1fkIjM-6rWIhdtqn6isjg3GtRq3ndTcHK1xb0cKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58nD-o-oLNYPwfrEHeBfpLjpmdK9MyLf6mk3GWwIXEYQ&oe=69FC829B"}, {"file_name": "ScreenShot4.png", "id": "1504094964574810", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/595112037_1504094967908143_2211669407358132130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JJ1U5XPyhgQ7kNvwHTQ64O&_nc_oc=AdpXA3Xj0DsEOY2tEmp7vwjYNAPW7b7AKqMsL9h0aEOPMZlfKuDIMHnoBiNcSXuLUQY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IVicZAmelPwTTZHwy1846sbThvDKRiBQD5Mef1VA_8w&oe=69FC81BA"}, {"file_name": "ScreenShot5.png", "id": "25774661712208146", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/673573223_25774661722208145_4882846667084287800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d3IhE3t2EwEQ7kNvwH1Q9z2&_nc_oc=Adr-3BILTPrJ8i6K5Uv3xzQthLBUohrxAZ7TBxNiRX0-LZf8IC4rud1q8DniS-HP_to&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v1SS2n1ng1WtNwU7pQtgwIDqxKdWHEsr8iEKwb1Dagw&oe=69FCA31B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zvkOxw5M0MQ7kNvwGQQSnM&_nc_oc=AdqYH5ZAgAqrzT8ZsXWEG-QYKQ5yIIWZo_Y0gbvPSippJCt-IzznFigAvweja1eZX_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C_EmuEbxWmD9OfvRNvxHTQTq1zr3fcKFZjY5s1kJgfQ&oe=69FC8DC5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported
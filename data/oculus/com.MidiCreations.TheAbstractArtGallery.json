t=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YxvElY9rCGt2f17sGUYK10UZQEUtoG3MLa9TUMhCyGw&oe=6A26E4FB"}, {"file_name": "ScreenShot3.png", "id": "1360304706146411", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499622325_1360304709479744_2970550790323903502_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xHPHIQpQim0Q7kNvwEB4j0i&_nc_oc=AdpDWNsgHNRVceSVcQnmFaONJh2_Ny1Wfjt0RGo1kEYRI1pz-LSjBq7AWH86eQRTa5A&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9tsWQlTyQaVVS0jMZwbGuY1G4aXYq8qqQm54s39_TTBg&oe=6A26EADB"}, {"file_name": "ScreenShot4.png", "id": "1504094964574810", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/595112037_1504094967908143_2211669407358132130_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tq0yiOMWm_oQ7kNvwHCcbJa&_nc_oc=AdrFNaxUO5HIJw1X_EBKabtqzxLli4DOhefy42FvGo0atbjCIeCVDmy6UYEscUI2Oc4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91ASyUbJJn3dkrLUnLubJdofmmhQYXfG3o5tpDf5eg0w&oe=6A26E9FA"}, {"file_name": "ScreenShot5.png", "id": "25774661712208146", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/673573223_25774661722208145_4882846667084287800_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTo3FS0tEKoQ7kNvwEiT-XN&_nc_oc=AdrG7VdlXJe5AjzTf--9JE8bLTHOb2dDDkYyBEkcikoZ7gN8dVZeqSf2JA2_jE0xSt4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-jBGfU1iQIdZOuP0iCAbm0gcrbQOppC2KnfiD-0H6DhQ&oe=6A26D31B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Snapshot_1.PNG", "id": "712382138600986", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618444_712382141934319_6039130477330376030_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfkndClgwqIQ7kNvwGvWc7n&_nc_oc=Ado2MDAZFRmEVbhnhCAMHiZgANr7VlGAMpQ9rymvXmOaWi0WG3CxcDSKdvEDws8NsxI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8AV-5aZKo5v5Z6okjy67mvJmrdY9Z_qBSb_mr-7EERuA&oe=6A26BDC5"}, "display_name": "The Abstract Art Gallery", "keywords": ["Abstract", "Art", "Gallery", "Neon", "Paintings"], "long_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944). He was one of the most important 20th-century artists. He was a major figure in modern art and painted some of the first modern abstract works.\n\nThe experience does not show the original paintings of Wassily Kandinsky, instead it presents a Neon-Futuristic version of each painting. You have a play button on each panting to see an AI Animation made with the Meta AI.\n\nThe exposition is divided in 6 sections (each section contains 10 paintings), and there is a transportation point to move from one section to another.\n\nKandinsky also developed a theory of geometric figures and their relationships, claiming (for example) that the circle is the most peaceful shape and represents the human soul.", "short_description": "The Abstract Art Gallery is a VR Experience that shows 60 paintings of the famous painter Wassily Kandinsky  (1866 \u2013 1944)."}]}, "developer_name": null, "developer_privacy_policy_url": "https://midicreationsvr.blogspot.com/p/privacy-notice-last-updated-april-15_19.html", "developer_terms_of_service_url": null, "publisher_name": "Midi Creations", "support_website_url": null, "website_url": "https://midicreationsvr.blogspot.com/p/who-are-we-indie-virtual-reality-video.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported
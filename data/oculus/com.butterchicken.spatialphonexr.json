0945379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031613_1269386104278712_2642012443224571991_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQZNv7VgjH4Q7kNvwFYi2wW&_nc_oc=Adk-CQ_UP-63HgzKhvVUTHXrd8uDgG690mukfYT9SoT_I0Luw4YZ3He5aPbfy1DsiZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsz9QdxRUpKOTcYPMqj1yBIYf-FX9lH8ezDkC6m3svsSg&oe=699C3320"}, {"file_name": "ezgif.com-resize (1).png", "id": "604716535544349", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974902_604716538877682_1509591903956243602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrKMGOPi5k4Q7kNvwHFO87B&_nc_oc=AdkEDR3854kkbDHgQtQleslP2wmAKm47w1WUD5dCFSKLNhaFBEMUpC6qrti2tvyzx0g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afs4rh40_KIdVmC1kJqnI23AXXceDD6O0crvuRopVM_kTw&oe=699C4EE8"}, {"file_name": "ezgif.com-resize (4).png", "id": "1116109296895857", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_1116109300229190_1490366970929533063_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrMw4SK5-Y4Q7kNvwGmMOvN&_nc_oc=AdnyFxQ1X9uRVmusWHuHs_TdrRPxhYu5V7PTl0MUWOB5LZxYpoE2nHXyl9Px4F8xsr0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvQidAvM2SNN7NntC0F-qq1YzLTlS47_jU44O019BQ2pw&oe=699C48CE"}, {"file_name": "ezgif.com-resize (2).png", "id": "611529381330656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035319_611529384663989_2761552413337527397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBXFKQbS7g8Q7kNvwGYsVQa&_nc_oc=AdkaDxnyi-zpBM7XavbSZVR9o3dH48I3fW8ZhrDpmNT2TZx4I8AMQEMmHE1pg31i7yk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afsec8eiDN0OX-EedUKpYUeZno7XD6E0QgiIwfUkXsbBqg&oe=699C4C32"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photoroom-20250103_203510.png", "id": "1657393174816640", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031604_1657393178149973_8342254906667433932_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4C0ro9Zv6IQ7kNvwEr4iLM&_nc_oc=AdkStabHiBmJ4flvoSHcMypDLemkOfyXeZW4HraMsBPri1Hywwk3NALXR7aP_ODP6rA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfskB2qjl1v3R2qvhEuYenQl3zu0lfu_7en2_m85dH9DkA&oe=699C4F92"}, "display_name": "Spatial Phone: Mirror & Control", "keywords": [], "long_description": "Features:\n\n**\ud83d\udd39 High-Resolution Passthrough**\n\nEnjoy crystal-clear visuals of your Android device inside your Meta Quest headset with very low latency (40ms-90ms)\n\n**\ud83d\udd39 Can be used with other apps/games**\n\n This app can be used in background with other app/games\n\n\n**\ud83d\udd39 Full Control with Hand Gestures & Controllers**\n{941354184612882}\nNavigate and interact with your Android device using hand gestures or your Meta Quest controllers.\n\n**\ud83d\udd39 Stereo Audio Support**\n\nHigh-quality stereo audio with good studio quality bitrate\n\n\n**\ud83d\udd39 Easy to connect**\n{633878145824376}\nConnect on the same network or internet without any custom setting \n\n**\ud83d\udd39 Secure Peer-to-Peer Connection**\n\nYour data stays private with end-to-end peer-to-peer connections. No additional data is collected or stored.\n\n\n{1332147561551809}\n\n\nFor additional help you can reach out on discord :  https://discord.gg/99qgmSxUZ9\n\n\n\n\n{566002019538238}\nRequirements : Only Android OS 8 and above is currently supported\n", "short_description": "You can mirror and control your Android phone or tablet directly in your Meta Quest. Which offers high quality passthrough, stereo sound quality and Meta quest controller trackpad support. \nIt's easy to connect too.\n\nRequirements : Only Android OS 8 and above is currently supported\n\nYou can use this to read pdf, watch videos, reply to text, music and control your device without leaving the Meta Quest headset.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4f218ce8-3057-4610-8545-49362731f8ab", "developer_terms_of_service_url": null, "publisher_name": "butter chicken piz
349", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974902_604716538877682_1509591903956243602_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JHWC1uI_chkQ7kNvwH7Lhiy&_nc_oc=AdqSpI5EenvyXgSiBDymm1YQdpeWJ1N_wjg6wOEunBIZ_SNHkChAz4uXgp10_zMx2og&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrJ11ItNvZtb0aV993RQUf-nDj0xGpCIEIG_GR7HIr0g&oe=6B0B4068"}, {"file_name": "ezgif.com-resize (4).png", "id": "1116109296895857", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974891_1116109300229190_1490366970929533063_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbF0Dc68lhwQ7kNvwHmEjUT&_nc_oc=AdrdSWcqY_HmPxKK5-tNg6un3jsW4y7znfM4X1y_8AUarC1JULEeb3iEdhVKrXf4jXU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR16AUQQxXw42T0PJG8AS0lNhVa3nxz4fsPMpL20BXvuw&oe=6B0B3A4E"}, {"file_name": "ezgif.com-resize (2).png", "id": "611529381330656", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39035319_611529384663989_2761552413337527397_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NC8iDgDoFy8Q7kNvwHekhA6&_nc_oc=Adq8p3RHz7cUGQ29wpuBvHnAe8cFof2ED_grcVDpARDp-QUzZ5UB6zGLlaD27f-uogc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQdSvRd0_c_L8DTysaupNRIQRExNBM4fUB5yDgvUEQG2A&oe=6B0B3DB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photoroom-20250103_203510.png", "id": "1657393174816640", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031604_1657393178149973_8342254906667433932_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=153Y5s2WMg0Q7kNvwFnpfox&_nc_oc=AdoMGWidrsufin1SoHEh9XHlg38Xkgpmu5hv2nSs7OLuELqy30ySFeVEU2S1Kx1KkEc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTYfdmvq3y8IWVQvmrWsfcFibPlFmBM_t-Pe4f1xH7ZJA&oe=6B0B4112"}, "display_name": "Spatial Phone: Mirror & Control", "keywords": [], "long_description": "Features:\n\n**\ud83d\udd39 High-Resolution Passthrough**\n\nEnjoy crystal-clear visuals of your Android device inside your Meta Quest headset with very low latency (40ms-90ms)\n\n**\ud83d\udd39 Can be used with other apps/games**\n\n This app can be used in background with other app/games\n\n\n**\ud83d\udd39 Full Control with Hand Gestures & Controllers**\n{941354184612882}\nNavigate and interact with your Android device using hand gestures or your Meta Quest controllers.\n\n**\ud83d\udd39 Stereo Audio Support**\n\nHigh-quality stereo audio with good studio quality bitrate\n\n\n**\ud83d\udd39 Easy to connect**\n{633878145824376}\nConnect on the same network or internet without any custom setting \n\n**\ud83d\udd39 Secure Peer-to-Peer Connection**\n\nYour data stays private with end-to-end peer-to-peer connections. No additional data is collected or stored.\n\n\n{1332147561551809}\n\n\nFor additional help you can reach out on discord :  https://discord.gg/99qgmSxUZ9\n\n\n\n\n{566002019538238}\nRequirements : Only Android OS 8 and above is currently supported\n", "short_description": "You can mirror and control your Android phone or tablet directly in your Meta Quest. Which offers high quality passthrough, stereo sound quality and Meta quest controller trackpad support. \nIt's easy to connect too.\n\nRequirements : Only Android OS 8 and above is currently supported\n\nYou can use this to read pdf, watch videos, reply to text, music and control your device without leaving the Meta Quest headset.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4f218ce8-3057-4610-8545-49362731f8ab", "developer_terms_of_service_url": null, "publisher_name": "butter chicken pizza", "support_website_url": "https://tinyurl.com/zp2s2m4f", "website_url": "https://spatial-phone-mirror-control-9ab924.webflow.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "AP
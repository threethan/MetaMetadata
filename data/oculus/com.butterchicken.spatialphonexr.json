0945379", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031613_1269386104278712_2642012443224571991_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DQZNv7VgjH4Q7kNvwHAG2or&_nc_oc=Adn4k6YYOsJHcTkwvtZa1SWFgCS6NUw5tG3W90YapP9vgABSVKQV3AS3et3D3S_ueTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsZ9IwVmmAlOTNGyIEHmlbt4X3W2jprDBylGtUa06gylw&oe=699AE1A0"}, {"file_name": "ezgif.com-resize (1).png", "id": "604716535544349", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974902_604716538877682_1509591903956243602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DrKMGOPi5k4Q7kNvwHfHSem&_nc_oc=AdnmuvjEHEWGFzDV0E-1Si1nsjTeilnzzpjgcfCLB5x2FNGTs-SJkLM73hCbCeCKvhc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsmWI8Eu-IQ2SlcnE65rt1V-DRDWXbUjQIZFouq4TyDVQ&oe=699AFD68"}, {"file_name": "ezgif.com-resize (4).png", "id": "1116109296895857", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974891_1116109300229190_1490366970929533063_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nrMw4SK5-Y4Q7kNvwFDvV7Q&_nc_oc=AdkCtwhRw59gxDTD5ijdATG1EzkbhrfctsRi9xo9lgOZxKl_R2gz7I3xLlhEtpw97IY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvM5cQoc7fYtseCL0PbqI06CjSiGYkYyT0faX2rZtrymw&oe=699AF74E"}, {"file_name": "ezgif.com-resize (2).png", "id": "611529381330656", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39035319_611529384663989_2761552413337527397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBXFKQbS7g8Q7kNvwGkuTmY&_nc_oc=AdnkCGj9e7ZIUqkxib107PYKHt6UUXpyul3h7Os1dK5UwUjER-n8ccgKI0L8fL1OW9g&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Aft33g5lBAx_JL6-oaD2qA5z03QKno8Ck7B4NvLN5cuoXA&oe=699AFAB2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photoroom-20250103_203510.png", "id": "1657393174816640", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031604_1657393178149973_8342254906667433932_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dmdm8LK38kIQ7kNvwEH-jmP&_nc_oc=AdlOwkeMn1qulpEns5Rn_nbgfLQQBe56DfgjcevBSsrVFvUMc-ChEKeFszeVXNSvrxM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftJQ9Ajpw75wbv9zdImJzV-9Jg8kWrJfgpL71ozQoa3NQ&oe=699AFE12"}, "display_name": "Spatial Phone: Mirror & Control", "keywords": [], "long_description": "Features:\n\n**\ud83d\udd39 High-Resolution Passthrough**\n\nEnjoy crystal-clear visuals of your Android device inside your Meta Quest headset with very low latency (40ms-90ms)\n\n**\ud83d\udd39 Can be used with other apps/games**\n\n This app can be used in background with other app/games\n\n\n**\ud83d\udd39 Full Control with Hand Gestures & Controllers**\n{941354184612882}\nNavigate and interact with your Android device using hand gestures or your Meta Quest controllers.\n\n**\ud83d\udd39 Stereo Audio Support**\n\nHigh-quality stereo audio with good studio quality bitrate\n\n\n**\ud83d\udd39 Easy to connect**\n{633878145824376}\nConnect on the same network or internet without any custom setting \n\n**\ud83d\udd39 Secure Peer-to-Peer Connection**\n\nYour data stays private with end-to-end peer-to-peer connections. No additional data is collected or stored.\n\n\n{1332147561551809}\n\n\nFor additional help you can reach out on discord :  https://discord.gg/99qgmSxUZ9\n\n\n\n\n{566002019538238}\nRequirements : Only Android OS 8 and above is currently supported\n", "short_description": "You can mirror and control your Android phone or tablet directly in your Meta Quest. Which offers high quality passthrough, stereo sound quality and Meta quest controller trackpad support. \nIt's easy to connect too.\n\nRequirements : Only Android OS 8 and above is currently supported\n\nYou can use this to read pdf, watch videos, reply to text, music and control your device without leaving the Meta Quest headset.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4f218ce8-3057-4610-8545-49362731f8ab", "developer_terms_of_service_url": null, "publisher_name": "butter chicken piz
0945379", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031613_1269386104278712_2642012443224571991_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=891EHRxYLBsQ7kNvwGCLkv6&_nc_oc=Adklr28-smIKJNBAyW5ODq1is4Dxt-KNaPyzrn0FbvW9RvEsShKuQ8ng2T2Yyqte854&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEU22idP0-60y0HGiMfuMqvyk52LygzVGXcVaEI0mE5w&oe=69A027A0"}, {"file_name": "ezgif.com-resize (1).png", "id": "604716535544349", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974902_604716538877682_1509591903956243602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQIodZM1JWwQ7kNvwG6N8Z5&_nc_oc=AdluD-qY7TU_KbYQ08jkOhGqcMR17YZNhjA6QkC3yNRIHxY7DglDJp9tcBTjI-fG4lc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu2uCTLwsmbjSqKtDhCn-E1clU0d5RPlxKWy29P5aTFAg&oe=69A04368"}, {"file_name": "ezgif.com-resize (4).png", "id": "1116109296895857", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974891_1116109300229190_1490366970929533063_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I2RjPHKKES4Q7kNvwGIjCC8&_nc_oc=Adm6_mfXbJ9qUEKbFeab_bpFsy5telUS1nASCn8KDor-vSBuqN06hF5K5IpDMLvLf9o&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfteTXbCssKBtMpMWzBYFTMs97x2y8skwqQY8cP3LLVTIg&oe=69A03D4E"}, {"file_name": "ezgif.com-resize (2).png", "id": "611529381330656", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035319_611529384663989_2761552413337527397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8Wu5hh90H8Q7kNvwHk34Vh&_nc_oc=Adk1juA-HnpJU0_OGCdtBNV__vCfuwUBCsXil-LvM1aOPim-L3ZDHpi_biKRYv6o3aA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afuq4-25vhNZ6LhAj310JU3x8WhoR31FAAuMCqnmxEh7BQ&oe=69A040B2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photoroom-20250103_203510.png", "id": "1657393174816640", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031604_1657393178149973_8342254906667433932_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrjE3nLWX7IQ7kNvwEAKGmD&_nc_oc=AdlV27Uwtkb8IbZ6tREuS4gsJSkHb5Zz2BKC0fyz3c4ItujyAd8AGe_cIrBsrFPNjo8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu0BW21QmqllgD9CWypDwTvfufMVIJD2nKmvGSAat0iXg&oe=69A04412"}, "display_name": "Spatial Phone: Mirror & Control", "keywords": [], "long_description": "Features:\n\n**\ud83d\udd39 High-Resolution Passthrough**\n\nEnjoy crystal-clear visuals of your Android device inside your Meta Quest headset with very low latency (40ms-90ms)\n\n**\ud83d\udd39 Can be used with other apps/games**\n\n This app can be used in background with other app/games\n\n\n**\ud83d\udd39 Full Control with Hand Gestures & Controllers**\n{941354184612882}\nNavigate and interact with your Android device using hand gestures or your Meta Quest controllers.\n\n**\ud83d\udd39 Stereo Audio Support**\n\nHigh-quality stereo audio with good studio quality bitrate\n\n\n**\ud83d\udd39 Easy to connect**\n{633878145824376}\nConnect on the same network or internet without any custom setting \n\n**\ud83d\udd39 Secure Peer-to-Peer Connection**\n\nYour data stays private with end-to-end peer-to-peer connections. No additional data is collected or stored.\n\n\n{1332147561551809}\n\n\nFor additional help you can reach out on discord :  https://discord.gg/99qgmSxUZ9\n\n\n\n\n{566002019538238}\nRequirements : Only Android OS 8 and above is currently supported\n", "short_description": "You can mirror and control your Android phone or tablet directly in your Meta Quest. Which offers high quality passthrough, stereo sound quality and Meta quest controller trackpad support. \nIt's easy to connect too.\n\nRequirements : Only Android OS 8 and above is currently supported\n\nYou can use this to read pdf, watch videos, reply to text, music and control your device without leaving the Meta Quest headset.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4f218ce8-3057-4610-8545-49362731f8ab", "developer_terms_of_service_url": null, "publisher_name": "butter chicken piz
6e7a0a&_nc_ohc=xHAMvnlYCQ8Q7kNvwFKzfnR&_nc_oc=AdoiFd6CJk1aB6O0loQAQyjBYM-9tDdnkaYP_vP7yJ0sn0C894HxWiKDhSoPvdxiIlk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_wr31fwHly5hme8NH4inNcgvOfvwQHgNebDFFbI2zgw&oe=69CBC232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photoroom-20250103_203510.png", "id": "1657393174816640", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031604_1657393178149973_8342254906667433932_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UBFYHqWjAW8Q7kNvwE4tXHw&_nc_oc=AdoivgHjqBpTmQMX4ehGEeF04kiy15INeeSmJ2KITrpeaRqxLVrCAX4EuCqz-ApPgjM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxe-k106kymdRAv0L2Uh3Ivu16kljcoAwRg7Zo3NxhOJA&oe=69CBC592"}, "display_name": "Spatial Phone: Mirror & Control", "keywords": [], "long_description": "Features:\n\n**\ud83d\udd39 High-Resolution Passthrough**\n\nEnjoy crystal-clear visuals of your Android device inside your Meta Quest headset with very low latency (40ms-90ms)\n\n**\ud83d\udd39 Can be used with other apps/games**\n\n This app can be used in background with other app/games\n\n\n**\ud83d\udd39 Full Control with Hand Gestures & Controllers**\n{941354184612882}\nNavigate and interact with your Android device using hand gestures or your Meta Quest controllers.\n\n**\ud83d\udd39 Stereo Audio Support**\n\nHigh-quality stereo audio with good studio quality bitrate\n\n\n**\ud83d\udd39 Easy to connect**\n{633878145824376}\nConnect on the same network or internet without any custom setting \n\n**\ud83d\udd39 Secure Peer-to-Peer Connection**\n\nYour data stays private with end-to-end peer-to-peer connections. No additional data is collected or stored.\n\n\n{1332147561551809}\n\n\nFor additional help you can reach out on discord :  https://discord.gg/99qgmSxUZ9\n\n\n\n\n{566002019538238}\nRequirements : Only Android OS 8 and above is currently supported\n", "short_description": "You can mirror and control your Android phone or tablet directly in your Meta Quest. Which offers high quality passthrough, stereo sound quality and Meta quest controller trackpad support. \nIt's easy to connect too.\n\nRequirements : Only Android OS 8 and above is currently supported\n\nYou can use this to read pdf, watch videos, reply to text, music and control your device without leaving the Meta Quest headset.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4f218ce8-3057-4610-8545-49362731f8ab", "developer_terms_of_service_url": null, "publisher_name": "butter chicken pizza", "support_website_url": "https://tinyurl.com/zp2s2m4f", "website_url": "https://spatial-phone-mirror-control-9ab924.webflow.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}, {"id": "393222478507326"}, {"id": "1055187466124150"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9158197440868318"}}]}, "scheduled_offers": {"count": 8, "nodes": [{"status": "PUBLISHED", "id": "2357239468078085"}, {"status": "PUBLISHED", "id": "759379853786394"}, {"status": "PUBLISHED", "id": "1958242551640886"}, {"status": "PUBLISHED", "id": "4184296681858451"}, {"status": "PUBLISHED", "id": "2338234496578140"}, {"status": "PUBLISHED", "id": "2044872306018994"}, {"status": "PUBLISHED", "id": "1300334441245053"}, {"status": "PUBLISHED", "id": "1317117702616301"}]}, "baseline_offer": {"id": "2338234496578140"}, "is_approved": true, "firstOff
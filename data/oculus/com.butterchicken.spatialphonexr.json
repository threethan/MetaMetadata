0945379", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031613_1269386104278712_2642012443224571991_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BPZnYjHZg_wQ7kNvwFJhnwA&_nc_oc=Adlqp9pwNyLxxznioU8zmesC1E8EYBuTFVK4LHlc62EWH_u_C6WZjCT0MYEafZIcr-U&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu8EQfhX_JdWPAMrr09Ox9VJotRyLNfilxT_-1HS40Zgw&oe=69A17920"}, {"file_name": "ezgif.com-resize (1).png", "id": "604716535544349", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/38974902_604716538877682_1509591903956243602_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQIodZM1JWwQ7kNvwHfkAuz&_nc_oc=AdkY5Bd8NVRZ1nlyMWNp8eveyGj81DrEeM_3JA9XMwNfPv-IHacGakKMoW4NrA2Onvo&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftxZc43W0HOZ7DozT61DJAf3grvLyVDbFS27YbWCaLdhw&oe=69A194E8"}, {"file_name": "ezgif.com-resize (4).png", "id": "1116109296895857", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974891_1116109300229190_1490366970929533063_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwfh5S4pUkcQ7kNvwGtBreE&_nc_oc=AdkoaXVI5Rm6xwXyrB01o88gbjaDKMlx6zuaiKvN9jp3FN7U362G6ZtWY_hgelLhbGs&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AftqXo0SHYU-Q2I53RV4ELHpkBOmbxXekquN800RunPdUw&oe=69A18ECE"}, {"file_name": "ezgif.com-resize (2).png", "id": "611529381330656", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/39035319_611529384663989_2761552413337527397_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-8Wu5hh90H8Q7kNvwFri9AL&_nc_oc=AdkrWWbtLU194A-mYMQzPLfTSCBcpE_D9SXrhDxCF2samV2y06abh5zGSZNVouIb79w&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftQbNQwDB6e2-Zdan1npODCYz8OEMx3Cc4xfBx-8yTraw&oe=69A19232"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Photoroom-20250103_203510.png", "id": "1657393174816640", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/39031604_1657393178149973_8342254906667433932_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrjE3nLWX7IQ7kNvwGkhOoe&_nc_oc=AdlxfpyOCNCreUO5MH-tNQYTnyi1r9BIOmOLTuNjYCUR_Uf49FB6UtrIzLHf-_QrQIg&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_Afu_M2ZDOZTmW4xnyCCTlpM06jbD6M1EXfm1basGSq8QYw&oe=69A19592"}, "display_name": "Spatial Phone: Mirror & Control", "keywords": [], "long_description": "Features:\n\n**\ud83d\udd39 High-Resolution Passthrough**\n\nEnjoy crystal-clear visuals of your Android device inside your Meta Quest headset with very low latency (40ms-90ms)\n\n**\ud83d\udd39 Can be used with other apps/games**\n\n This app can be used in background with other app/games\n\n\n**\ud83d\udd39 Full Control with Hand Gestures & Controllers**\n{941354184612882}\nNavigate and interact with your Android device using hand gestures or your Meta Quest controllers.\n\n**\ud83d\udd39 Stereo Audio Support**\n\nHigh-quality stereo audio with good studio quality bitrate\n\n\n**\ud83d\udd39 Easy to connect**\n{633878145824376}\nConnect on the same network or internet without any custom setting \n\n**\ud83d\udd39 Secure Peer-to-Peer Connection**\n\nYour data stays private with end-to-end peer-to-peer connections. No additional data is collected or stored.\n\n\n{1332147561551809}\n\n\nFor additional help you can reach out on discord :  https://discord.gg/99qgmSxUZ9\n\n\n\n\n{566002019538238}\nRequirements : Only Android OS 8 and above is currently supported\n", "short_description": "You can mirror and control your Android phone or tablet directly in your Meta Quest. Which offers high quality passthrough, stereo sound quality and Meta quest controller trackpad support. \nIt's easy to connect too.\n\nRequirements : Only Android OS 8 and above is currently supported\n\nYou can use this to read pdf, watch videos, reply to text, music and control your device without leaving the Meta Quest headset.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/4f218ce8-3057-4610-8545-49362731f8ab", "developer_terms_of_service_url": null, "publisher_name": "butter chicken piz
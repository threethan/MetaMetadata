dn.com/v/t64.5771-25/12331069_2072918859661464_8079457748682539008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sR5HcqXRs5AQ7kNvwEMBgSJ&_nc_oc=AdkITUN0d_YtbfTnpZxFQVw7H8bOxt5U3TowDmEK77UiNMx7GPzz-0dI0agX1bODRvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs7Ggac6vlFL41vs5vN871PcMMc7VJbwiAgyM7XIgA0HA&oe=69A41B91"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Samsun Gear VR-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40tfG9puBClTHdO_TxCgyB4ZnRCQje_gihetT7dw/edit?usp=sharing", "publisher_name": "Metropolia University of Applied Sciences", "support_website_url": null, "website_url": "http://gamesblogs.metropolia.fi/salakapakka/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
_AQQE433ap8QJdq0TXOY7jLA6t13jrTfeumnYakur7IOVWw&oe=6B0DA84B"}, {"file_name": "migrated_image.png", "id": "546444229334068", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427636_311030506063097_7684297530267402240_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHAHwfnhssoQ7kNvwHl9PHW&_nc_oc=AdpwcP4Pik0yDw4yLEyzAndf4_edCOYOMiozEq_l9CqoyyXsHNZpOOo2wBOQEmJLXbg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQiEiuGFJdRR8CuTVNYEKDa6aXx9f4PGE1T660FvqdzDw&oe=6B0DB08D"}, {"file_name": "migrated_image.png", "id": "525156238413587", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12727788_1112344362202494_1865804376874942464_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prN8gTALFrQQ7kNvwFYlsqY&_nc_oc=AdoPH0wnLtG-n8ldkQ-vx-68-xQ1nHGZRNR75XqmATHvgOO9nadk2dZi0QwIUgPTTxg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTz6yXE3TGWMJiNYHCqkN_pXdHv8SmlUS7tuJSYFjXGug&oe=6B0DA274"}, {"file_name": "migrated_image.png", "id": "213147453230509", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12427649_1965146287093375_8741213768345714688_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNyiJGmhal8Q7kNvwH7GDVT&_nc_oc=AdraQWKXYH2qnk_npXngsan-dYUFIzN7Cn06o_P2UIdouGx6Klet2G8VmEKFgGrMBkI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRKJbTfgmvLg0JtK49hKb-GjZPpOu1levz3XxELO39anQ&oe=6B0DC8B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Xp1HuB", "id": "1724395234343341", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12410441_1724395237676674_6604651178502389760_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jCMSKfBNNvcQ7kNvwHNsy_3&_nc_oc=AdrjEdZoddhPrpw8c-Gdc83O71A0WS3I0s0_g5aFMXcPsurTO_1DX3LwrS5K2pNohK8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRHi7dE8DHJ-RoEWdS_yI_YAm6tHGt7se4JUseTgMmZ1A&oe=6B0DA528"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Oculus Go Vr-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}, {"images": {"nodes": []}, "id": "229386665099998", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salakapakka", "keywords": ["salakapakka", "kieltolaki", "opetus"], "long_description": "Kurkista historiaan Oculus Go Vr-lasien avulla!\n\n1920-luku, Helsinki. Kieltolaki rajoittaa ihmisten el\u00e4m\u00e4\u00e4, mutta viina virtaa silti laittomissa salakapakoissa. \n\nOmaksu etsiv\u00e4n rooli ja selvit\u00e4 ep\u00e4ilytt\u00e4v\u00e4n kahvilan mysteeri. Soluttaudu, etsi todistusaineistoa, \u00e4l\u00e4k\u00e4 miss\u00e4\u00e4n nimess\u00e4 j\u00e4\u00e4 kiinni. \n\nPeli on tehty yhteisty\u00f6ss\u00e4 Metropolian kolmannen vuoden opiskelijoiden ja Ylen kanssa. \n\nLue lis\u00e4\u00e4: \nhttps://yle.fi/aihe/historia/kieltolaki \nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Astu 1920-luvun Helsinkiin ja k\u00e4y tutkimaan salaper\u00e4ist\u00e4 mysteerikahvilaa."}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40tfG9puBClTHdO_TxCgyB4ZnRCQje_gihetT7dw/edit?usp=sharing", "publisher_name": "Metropolia University of Applied Sciences", "support_website_url": null, "website_url": "http://gamesblogs.metropolia.fi/salakapakka/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fi"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "510491140417426"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386286_555864938090815_4744680728720048128_n.png?stp=dst-png_s360x360&_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWsbWEJHckQQ7kNvwGGXE2q&_nc_oc=Adrn610ORnud40vGyIHrC3VJNKgUFz3uHmQXtzlSQKyA94E55npANJVjIXsoE087zhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5PQS5mKHHnLOwufZlSm9dReUXHvPFzWjxBEx02-5_XA&oe=6B0DB172"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Salakapakka", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1517212800, "lastRevision": {"nodes": [{"id": "1711909842215091", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "1556971604391491", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID"}, "iarc_cert": {"id": "128531224593739"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "2644903882390320", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salakapakka", "keywords": ["salakapakka", "kieltolaki", "opetus"], "long_description": "Kurkista historiaan Samsung Gear VR-lasien avulla!\n\n1920-luku, Helsinki. Kieltolaki rajoittaa ihmisten el\u00e4m\u00e4\u00e4, mutta viina virtaa silti laittomissa salakapakoissa. \n\nOmaksu etsiv\u00e4n rooli ja selvit\u00e4 ep\u00e4ilytt\u00e4v\u00e4n kahvilan mysteeri. Soluttaudu, etsi todistusaineistoa, \u00e4l\u00e4k\u00e4 miss\u00e4\u00e4n nimess\u00e4 j\u00e4\u00e4 kiinni. \n\nPeli on tehty yhteisty\u00f6ss\u00e4 Metropolian kolmannen vuoden opiskelijoiden ja Ylen kanssa. \n\nLue lis\u00e4\u00e4: \nhttps://yle.fi/aihe/historia/kieltolaki \nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Astu 1920-luvun Helsinkiin ja k\u00e4y tutkimaan salaper\u00e4ist\u00e4 mysteerikahvilaa."}, {"images": {"nodes": [{"file_name": "migrated_image.png", "id": "3092869367412511", "image_type": "APP_IMG_COVER_PORTRAIT", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/11162702_760613700793011_4081331521003192320_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Z0nhhDsM5IQ7kNvwHQ1SuS&_nc_oc=Adpz0yhR7KOnfOGNKpGRTfRqsk7IGhGhArRdDnuKhFJV8mecBcWU5rBFumyP4IvBVNw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQ7TvAXzbHa0iTyzNTNAuhac5t1T2TFL98EhKaCHwSIYA&oe=6B0DAC94"}, {"file_name": "migrated_image.png", "id": "3052622228115034", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12386286_555864938090815_4744680728720048128_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWsbWEJHckQQ7kNvwGGXE2q&_nc_oc=Adrn610ORnud40vGyIHrC3VJNKgUFz3uHmQXtzlSQKyA94E55npANJVjIXsoE087zhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSdQyg0yhU1sXr6QY7VhJUeGERWDUN1oACDUx1zb2pjdA&oe=6B0DB172"}, {"file_name": "migrated_image.png", "id": "635734543935653", "image_type": "APP_IMG_IC
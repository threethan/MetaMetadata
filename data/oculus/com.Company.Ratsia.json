cdn.com&_nc_ss=8&oh=00_Afxm47Vm3nYUzEXchaF8X0Y3eiBGe4tAcu9YxSy63gFJ4Q&oe=69AACC8B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Salakapakka_cover_art_landscape_2560x1440.png", "id": "2072918856328131", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/12331069_2072918859661464_8079457748682539008_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMF_awN-P5cQ7kNvwFRBEgo&_nc_oc=AdkqpO46a3DwfdlHRx9TLm2Um3aLy3A2AGFuDZpOHYDvHWn3WiBSZ5btItRkPlSyOVo&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=8&oh=00_AfxBX_qr31VycI_nyle-_52TAfrMzGtOV3E4v7oLZt558g&oe=69AAB311"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Samsun Gear VR-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40tfG9puBClTHdO_TxCgyB4ZnRCQje_gihetT7dw/edit?usp=sharing", "publisher_name": "Metropolia University of Applied Sciences", "support_website_url": null, "website_url": "http://gamesblogs.metropolia.fi/salakapakka/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics
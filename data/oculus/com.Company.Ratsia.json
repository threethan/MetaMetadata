_AQRIetohs4bc2NCY4mxk8IVCsDrvq0HSlcxE7e0tKBXMig&oe=6B046DCB"}, {"file_name": "migrated_image.png", "id": "546444229334068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427636_311030506063097_7684297530267402240_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOtgscbHDG0Q7kNvwHCK0ir&_nc_oc=AdqtDC9GJDqYPbeTIktP8i2fUn5-KwuBTknQpVkkCxfUOgvZ-F8etVdjvJ08u2jQhuk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjB6oim-m6XRTGzo81dC3qxk-V1X1txA-Prlvv8hoPCw&oe=6B04760D"}, {"file_name": "migrated_image.png", "id": "525156238413587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727788_1112344362202494_1865804376874942464_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eNL36HaogFUQ7kNvwGu97t-&_nc_oc=AdrsDPu2SX9F_lXNp0JS7pf2IHas3klHcdTUQlUCFOm0O7qoP7k3ITCnYuSAWMcph04&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuTmr49FGLS8mUhgv8yCZInJlDrlN4IAKqqXJM19BXYQ&oe=6B0467F4"}, {"file_name": "migrated_image.png", "id": "213147453230509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427649_1965146287093375_8741213768345714688_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hKfyhIQl0QQ7kNvwGtz36k&_nc_oc=Ado7ShMpamCP5AYRG3nyo0C0SK7bzhC4dCZFrWe_sl45j3DtyFw4TNYyae4UvxdXGhQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLhoq2uFo5ufDyLifuAnmA3XEFXK5fpu0Qe3OWOyKrIw&oe=6B0455F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Xp1HuB", "id": "1724395234343341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1724395237676674_6604651178502389760_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K2iuaeDxqDgQ7kNvwFoTkRJ&_nc_oc=AdrwdQnwxZ0mk82xX_FbaX4mmgT0EHQHdeQtiHLleDg8fxZh3gGcmWVFzY-WsPxVeLY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRv7VcY-P5hZN-mAQe71uc_bJCKqPru4Iq86eqQoirVkw&oe=6B046AA8"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Oculus Go Vr-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}, {"images": {"nodes": []}, "id": "229386665099998", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salakapakka", "keywords": ["salakapakka", "kieltolaki", "opetus"], "long_description": "Kurkista historiaan Oculus Go Vr-lasien avulla!\n\n1920-luku, Helsinki. Kieltolaki rajoittaa ihmisten el\u00e4m\u00e4\u00e4, mutta viina virtaa silti laittomissa salakapakoissa. \n\nOmaksu etsiv\u00e4n rooli ja selvit\u00e4 ep\u00e4ilytt\u00e4v\u00e4n kahvilan mysteeri. Soluttaudu, etsi todistusaineistoa, \u00e4l\u00e4k\u00e4 miss\u00e4\u00e4n nimess\u00e4 j\u00e4\u00e4 kiinni. \n\nPeli on tehty yhteisty\u00f6ss\u00e4 Metropolian kolmannen vuoden opiskelijoiden ja Ylen kanssa. \n\nLue lis\u00e4\u00e4: \nhttps://yle.fi/aihe/historia/kieltolaki \nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Astu 1920-luvun Helsinkiin ja k\u00e4y tutkimaan salaper\u00e4ist\u00e4 mysteerikahvilaa."}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40t
?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rNzYjpSkRs4Q7kNvwG-vzIg&_nc_oc=AdrAi6cQeA6JE5vG2isOo5bg9_cKjtJHseXXx0cV3cSLcVvkIfve0oZtnSUsqrPqW-s&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rp1PRBwTh8tyRQvS_hTMxECazqV4NtXDa3uYFFv7HPQ&oe=6A1C35CD"}, {"file_name": "migrated_image.png", "id": "525156238413587", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12727788_1112344362202494_1865804376874942464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c2iHFRqC3BsQ7kNvwGYvA4B&_nc_oc=AdreZsI7zNKdxclRqW-TaLkqoDmq02jNNibE9G9mfQgoycEhToW12oVxULIBVxEqdxg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rpCzAnun1tZ-9E9yjfs3T3pdCfXbuV8KCEDfxqAucrA&oe=6A1C5FF4"}, {"file_name": "migrated_image.png", "id": "213147453230509", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/12427649_1965146287093375_8741213768345714688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDld1dhTYKYQ7kNvwE9oPES&_nc_oc=AdoCS-F94W9whvqSQ93MFkRwcrNjRrn5KBq6iSuB_u_rb-G6S9TW4RYkP0lxmqjq7xk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZirlcSdZ7o7Yibe8Fc-7Om9Ze1XFe4cWKeuDe6-LxaQ&oe=6A1C4DF0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Xp1HuB", "id": "1724395234343341", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/12410441_1724395237676674_6604651178502389760_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R4Lo56nI8L4Q7kNvwHYHrri&_nc_oc=AdrZqwnkVA-vbRlDL5J4Bd5Cwm0TFQ1TFuqkgii1DlPtbyvvWry_CnPtdRjRLDi8bNI&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RurheZ1eFgOYb7NU7MkJ2zUEFBM8sB056sLzh5siiAw&oe=6A1C2A68"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Oculus Go Vr-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}, {"images": {"nodes": []}, "id": "229386665099998", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salakapakka", "keywords": ["salakapakka", "kieltolaki", "opetus"], "long_description": "Kurkista historiaan Oculus Go Vr-lasien avulla!\n\n1920-luku, Helsinki. Kieltolaki rajoittaa ihmisten el\u00e4m\u00e4\u00e4, mutta viina virtaa silti laittomissa salakapakoissa. \n\nOmaksu etsiv\u00e4n rooli ja selvit\u00e4 ep\u00e4ilytt\u00e4v\u00e4n kahvilan mysteeri. Soluttaudu, etsi todistusaineistoa, \u00e4l\u00e4k\u00e4 miss\u00e4\u00e4n nimess\u00e4 j\u00e4\u00e4 kiinni. \n\nPeli on tehty yhteisty\u00f6ss\u00e4 Metropolian kolmannen vuoden opiskelijoiden ja Ylen kanssa. \n\nLue lis\u00e4\u00e4: \nhttps://yle.fi/aihe/historia/kieltolaki \nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Astu 1920-luvun Helsinkiin ja k\u00e4y tutkimaan salaper\u00e4ist\u00e4 mysteerikahvilaa."}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40tfG9puBClTHdO_TxCgyB4ZnRCQje_gihetT7dw/edit?usp=sharing", "publisher_name": "Metropolia University of Applied Sciences", "support_website_url": null, "website_url": "http://gamesblogs.metropolia.fi/salakapakka/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics":
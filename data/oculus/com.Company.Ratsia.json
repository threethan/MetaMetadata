_AQQQaJO_HKNuPLsV6NVfidL4fqOTnH9ZntZrlXmMcz6kyw&oe=6B0B3D8B"}, {"file_name": "migrated_image.png", "id": "546444229334068", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/12427636_311030506063097_7684297530267402240_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHAHwfnhssoQ7kNvwEYB6AE&_nc_oc=AdqGEArmuBqrUd2AqJij5K0PtscQF4MuCQZA-NTY6IdXtaO8twUwPuZID_4YAxG4EX0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT5UGmo4XKtq-uEet0H1CUuKRARMVidb-ID6K3cSnSz2A&oe=6B0B0D8D"}, {"file_name": "migrated_image.png", "id": "525156238413587", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12727788_1112344362202494_1865804376874942464_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=prN8gTALFrQQ7kNvwFm00nF&_nc_oc=AdqQiusnpJPnmTkk8J4Qt2mVB-59axftZSZRLeGt3-xsquzJdO-98Xh3myn25j2dCDg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQBkGXZmO0OztJeVVtEXwp2Lw-9yvu7pqWS1UKcX5Gktw&oe=6B0B37B4"}, {"file_name": "migrated_image.png", "id": "213147453230509", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427649_1965146287093375_8741213768345714688_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EGZZXnNcpaYQ7kNvwEAhKz3&_nc_oc=AdpI_7yWuGZe7ggj_f3_NAJ3dD2m7b3VvQbACCqqZuVUjVzX5l5H6fcd-diKUtH6ULc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTakitRyzPoKBn96MuVkPi2HyJk_utjD3vugX21_gtoxQ&oe=6B0B25B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Xp1HuB", "id": "1724395234343341", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12410441_1724395237676674_6604651178502389760_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TX9dmt9WIk8Q7kNvwEViASn&_nc_oc=AdqPqu763VQA0eNMe8cR-G-863oW_UyArkKzsgOxpW8P7M9PXbUSIkxFnalDe5lIKmk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR7TLs0oky0m6WIFiNHyT_qGerFzLlFth2kxTbSpA-XaA&oe=6B0B3A68"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Oculus Go Vr-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}, {"images": {"nodes": []}, "id": "229386665099998", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salakapakka", "keywords": ["salakapakka", "kieltolaki", "opetus"], "long_description": "Kurkista historiaan Oculus Go Vr-lasien avulla!\n\n1920-luku, Helsinki. Kieltolaki rajoittaa ihmisten el\u00e4m\u00e4\u00e4, mutta viina virtaa silti laittomissa salakapakoissa. \n\nOmaksu etsiv\u00e4n rooli ja selvit\u00e4 ep\u00e4ilytt\u00e4v\u00e4n kahvilan mysteeri. Soluttaudu, etsi todistusaineistoa, \u00e4l\u00e4k\u00e4 miss\u00e4\u00e4n nimess\u00e4 j\u00e4\u00e4 kiinni. \n\nPeli on tehty yhteisty\u00f6ss\u00e4 Metropolian kolmannen vuoden opiskelijoiden ja Ylen kanssa. \n\nLue lis\u00e4\u00e4: \nhttps://yle.fi/aihe/historia/kieltolaki \nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Astu 1920-luvun Helsinkiin ja k\u00e4y tutkimaan salaper\u00e4ist\u00e4 mysteerikahvilaa."}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40t
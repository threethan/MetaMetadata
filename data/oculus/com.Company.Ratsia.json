_AQQEKgg15fHIm4WcGDfuhQoro-STjLHfWqgE5uSU2gxPVA&oe=6B01CACB"}, {"file_name": "migrated_image.png", "id": "546444229334068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427636_311030506063097_7684297530267402240_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Li6JUxiuCCEQ7kNvwEz4CZu&_nc_oc=AdrpnOnOHCek5hmNMPVbm56OJDxAmFW1kJYexMf1jz-JtS8qgquekkh18zaYtFok7cc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM2HdO35vUmbmfg3npobsN8-wnIbhe-YgOfC6hq5pE_A&oe=6B01D30D"}, {"file_name": "migrated_image.png", "id": "525156238413587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727788_1112344362202494_1865804376874942464_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B8eOLU-e5bsQ7kNvwE4_ZW7&_nc_oc=AdoJydYOXPGsizoLbguWomsppoJDT2jtfYf0cKCTySU-kfU6x8LfpYi2o-C83wga9Dg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0zM7RHJO07P5Co7aIt8xOOrCLz8BACd0BJbLheGDPDg&oe=6B01C4F4"}, {"file_name": "migrated_image.png", "id": "213147453230509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427649_1965146287093375_8741213768345714688_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_hKfyhIQl0QQ7kNvwFDIaRJ&_nc_oc=AdoQaFhxO7wfV0MSiHkhSLTl6dCsR8xXIXW3qro1RE_P1UU06Z4_GDqD2Elv0crfSZk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIYaT3GBvN_vVE9hkrzq3cBK7XZsv4WR6WyPR4kRrV-w&oe=6B01EB30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Xp1HuB", "id": "1724395234343341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1724395237676674_6604651178502389760_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtomblTeD58Q7kNvwFCVyss&_nc_oc=AdpBoaYt-8CfuAmsSnW3BQhGv87cSHFmj3_wod2ITEV_lbOCTYONw2jrulHm-k3cYgA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTpLyP_5SWbP0TCIGDhJBQfcPqe5i5tqJrYYtiUJ0V5rA&oe=6B01C7A8"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Oculus Go Vr-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}, {"images": {"nodes": []}, "id": "229386665099998", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salakapakka", "keywords": ["salakapakka", "kieltolaki", "opetus"], "long_description": "Kurkista historiaan Oculus Go Vr-lasien avulla!\n\n1920-luku, Helsinki. Kieltolaki rajoittaa ihmisten el\u00e4m\u00e4\u00e4, mutta viina virtaa silti laittomissa salakapakoissa. \n\nOmaksu etsiv\u00e4n rooli ja selvit\u00e4 ep\u00e4ilytt\u00e4v\u00e4n kahvilan mysteeri. Soluttaudu, etsi todistusaineistoa, \u00e4l\u00e4k\u00e4 miss\u00e4\u00e4n nimess\u00e4 j\u00e4\u00e4 kiinni. \n\nPeli on tehty yhteisty\u00f6ss\u00e4 Metropolian kolmannen vuoden opiskelijoiden ja Ylen kanssa. \n\nLue lis\u00e4\u00e4: \nhttps://yle.fi/aihe/historia/kieltolaki \nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Astu 1920-luvun Helsinkiin ja k\u00e4y tutkimaan salaper\u00e4ist\u00e4 mysteerikahvilaa."}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40t
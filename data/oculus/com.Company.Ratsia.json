rX-ZOf3kj3TOtJCpmSiSi9ROurW38fRis54rtES_5y1ShTcERHc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0UcqJ27UV3p0URLZmJpJv9de6AIPi3T0X4o1NcqRRRIg&oe=69F205CD"}, {"file_name": "migrated_image.png", "id": "525156238413587", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12727788_1112344362202494_1865804376874942464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OA88T7ukpwQ7kNvwEX7C1C&_nc_oc=AdqqviHAZwwip_txOAfRQc2e5jOm9EQ-kvkfCEU6zaIhayUh9zcqBXFz4aKSeindz14&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2zYP66h59vQXk9cgq8D01qc9GbA0RGsCEnkUVCGTKTlQ&oe=69F1F7B4"}, {"file_name": "migrated_image.png", "id": "213147453230509", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/12427649_1965146287093375_8741213768345714688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6tFhxSdqyU8Q7kNvwHcVGwA&_nc_oc=AdrOlgqCU5xGrQajWS3jHmrg7AAyc0fmz_emAMYkeqHwVyGk1v4HrJikO5qOVfErhLU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af18bCRme_zmgMQHWtm9IR7SXxZ0cNoi5SMKq6QSTEx53g&oe=69F1E5B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Xp1HuB", "id": "1724395234343341", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/12410441_1724395237676674_6604651178502389760_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J2ap-4sA0NAQ7kNvwEWGGQ1&_nc_oc=Adot7F2GZAPVLL7vDFIkSwWHycreUy2ihFb454ZUtYekH8I2UhGfikS9SAnAMLKbIe4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3iwHHi_7ZxRg7yIgMkyEn_RxJKPijqkmzhfaQ0IzCjdg&oe=69F1FA68"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Oculus Go Vr-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}, {"images": {"nodes": []}, "id": "229386665099998", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salakapakka", "keywords": ["salakapakka", "kieltolaki", "opetus"], "long_description": "Kurkista historiaan Oculus Go Vr-lasien avulla!\n\n1920-luku, Helsinki. Kieltolaki rajoittaa ihmisten el\u00e4m\u00e4\u00e4, mutta viina virtaa silti laittomissa salakapakoissa. \n\nOmaksu etsiv\u00e4n rooli ja selvit\u00e4 ep\u00e4ilytt\u00e4v\u00e4n kahvilan mysteeri. Soluttaudu, etsi todistusaineistoa, \u00e4l\u00e4k\u00e4 miss\u00e4\u00e4n nimess\u00e4 j\u00e4\u00e4 kiinni. \n\nPeli on tehty yhteisty\u00f6ss\u00e4 Metropolian kolmannen vuoden opiskelijoiden ja Ylen kanssa. \n\nLue lis\u00e4\u00e4: \nhttps://yle.fi/aihe/historia/kieltolaki \nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Astu 1920-luvun Helsinkiin ja k\u00e4y tutkimaan salaper\u00e4ist\u00e4 mysteerikahvilaa."}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40tfG9puBClTHdO_TxCgyB4ZnRCQje_gihetT7dw/edit?usp=sharing", "publisher_name": "Metropolia University of Applied Sciences", "support_website_url": null, "website_url": "http://gamesblogs.metropolia.fi/salakapakka/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ADVENTURE", "EDUCATIONAL"], "has_in_app_ads": null, "internet_conne
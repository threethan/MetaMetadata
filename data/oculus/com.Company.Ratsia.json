_nc_ohc=j0cMqQmEX30Q7kNvwF8DeYk&_nc_oc=Adntpnvaw2JmA2piNzdROdDNGBjL6OSxg7qNqwGG4HTinmUfp1ExFLqCiK0eWbReahY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwbGOZbulPMF7jj4cA5wdHKcD73X-L4gFrgP_b9ii3CfQ&oe=69B16C4D"}, {"file_name": "migrated_image.png", "id": "525156238413587", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12727788_1112344362202494_1865804376874942464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6TUUdtJbZoQ7kNvwFuzaJ0&_nc_oc=Adl_n_kHwg5unDjvFkhDvLPSjApjid2Ymys_MB_CkM2TBQEuB2kMBOFhNMWumzxl4aM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxU30njsh0CCpwOi3ZYwaihTIPJdih5LjO_ORkPg3bjfg&oe=69B15E34"}, {"file_name": "migrated_image.png", "id": "213147453230509", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/12427649_1965146287093375_8741213768345714688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFDt-dLmmPsQ7kNvwGQZHyH&_nc_oc=AdmnNS2-KnbJdvw67Bc16qW1yHCDBNsciC8dF19j-qnNJPdfkhJpwOLA_-z6Kuq4KsE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfytYT2Fgv4otdaqOJOAoPrstA3TDY3ehTJ0UBAdhcKPvA&oe=69B14C30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Xp1HuB", "id": "1724395234343341", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/12410441_1724395237676674_6604651178502389760_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJV0Hq3oTGEQ7kNvwF6Xg5w&_nc_oc=AdnldzIKVBV_5HwKMGNIy9jiflmK5QMkjlk1WYiLukMuuR4wrK7x6mkBCajGJDmwm7s&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyyNGNuhNgbSqqKQ74GhMt1fc3AKISIRmD9jo4O5GJRVQ&oe=69B160E8"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Oculus Go Vr-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}, {"images": {"nodes": []}, "id": "229386665099998", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salakapakka", "keywords": ["salakapakka", "kieltolaki", "opetus"], "long_description": "Kurkista historiaan Oculus Go Vr-lasien avulla!\n\n1920-luku, Helsinki. Kieltolaki rajoittaa ihmisten el\u00e4m\u00e4\u00e4, mutta viina virtaa silti laittomissa salakapakoissa. \n\nOmaksu etsiv\u00e4n rooli ja selvit\u00e4 ep\u00e4ilytt\u00e4v\u00e4n kahvilan mysteeri. Soluttaudu, etsi todistusaineistoa, \u00e4l\u00e4k\u00e4 miss\u00e4\u00e4n nimess\u00e4 j\u00e4\u00e4 kiinni. \n\nPeli on tehty yhteisty\u00f6ss\u00e4 Metropolian kolmannen vuoden opiskelijoiden ja Ylen kanssa. \n\nLue lis\u00e4\u00e4: \nhttps://yle.fi/aihe/historia/kieltolaki \nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Astu 1920-luvun Helsinkiin ja k\u00e4y tutkimaan salaper\u00e4ist\u00e4 mysteerikahvilaa."}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40tfG9puBClTHdO_TxCgyB4ZnRCQje_gihetT7dw/edit?usp=sharing", "publisher_name": "Metropolia University of Applied Sciences", "support_website_url": null, "website_url": "http://gamesblogs.metropolia.fi/salakapakka/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "
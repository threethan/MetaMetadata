?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hdjwm6TVWsUQ7kNvwHkQUKM&_nc_oc=AdqXKqIV-xM2XhiWyvRTzQF4VPt8oSO6ZKm5yiOZhNYRFtnGdqNIMV5y5i2XnKa-dI0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8tdJoPPVnZ07QmGPhNPQWPc3jwfdnrzp4xkWJZd7tjnA&oe=6A2EAACD"}, {"file_name": "migrated_image.png", "id": "525156238413587", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12727788_1112344362202494_1865804376874942464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2iKXB1n-TaUQ7kNvwFOExRD&_nc_oc=Adpnc_B_yfhms9six77DH0HJ6RiSw6XfvvxMgX7sDmzz1WtJWkgWtHlSTf55bhfpPTo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9trxOI3EnP_BlUphJYOnJwg1lN1IzHdFSLbaT0ElT29w&oe=6A2E9CB4"}, {"file_name": "migrated_image.png", "id": "213147453230509", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427649_1965146287093375_8741213768345714688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nL2sRyB5Z_cQ7kNvwHxM2C6&_nc_oc=AdpunFKzf0W_D2ocnk1Qco26ueGmfVhdAROheBJCoHGYnpSRtTual0jYr-UN115RvmA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8h96womPqHmz4KHXB_d6eIvYye-57GM_AhVN-D_36msA&oe=6A2EC2F0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Xp1HuB", "id": "1724395234343341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1724395237676674_6604651178502389760_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDURdNDtX54Q7kNvwFkKUt0&_nc_oc=AdrYx5qeXbuDZtNCGb6KC2ijGhNbJrSw86BuGRoy8QzKksLqGSgfr8Pe5lCqza0k68w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9BfybcvziiRtBURcu8iF8O6ZJz8F3UIknK9W9YOTv6PQ&oe=6A2E9F68"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Oculus Go Vr-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}, {"images": {"nodes": []}, "id": "229386665099998", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salakapakka", "keywords": ["salakapakka", "kieltolaki", "opetus"], "long_description": "Kurkista historiaan Oculus Go Vr-lasien avulla!\n\n1920-luku, Helsinki. Kieltolaki rajoittaa ihmisten el\u00e4m\u00e4\u00e4, mutta viina virtaa silti laittomissa salakapakoissa. \n\nOmaksu etsiv\u00e4n rooli ja selvit\u00e4 ep\u00e4ilytt\u00e4v\u00e4n kahvilan mysteeri. Soluttaudu, etsi todistusaineistoa, \u00e4l\u00e4k\u00e4 miss\u00e4\u00e4n nimess\u00e4 j\u00e4\u00e4 kiinni. \n\nPeli on tehty yhteisty\u00f6ss\u00e4 Metropolian kolmannen vuoden opiskelijoiden ja Ylen kanssa. \n\nLue lis\u00e4\u00e4: \nhttps://yle.fi/aihe/historia/kieltolaki \nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Astu 1920-luvun Helsinkiin ja k\u00e4y tutkimaan salaper\u00e4ist\u00e4 mysteerikahvilaa."}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40tfG9puBClTHdO_TxCgyB4ZnRCQje_gihetT7dw/edit?usp=sharing", "publisher_name": "Metropolia University of Applied Sciences", "support_website_url": null, "website_url": "http://gamesblogs.metropolia.fi/salakapakka/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics":
_AQUGF5ChEZcAwbIGlmyDQfFr6Nt8kFxY-eZB2x_Nluw6gA&oe=6B104B4B"}, {"file_name": "migrated_image.png", "id": "546444229334068", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/12427636_311030506063097_7684297530267402240_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7LHMHAJhkgQ7kNvwG4D5WK&_nc_oc=Adol2TOqQDbYrDHQGCD8402qU4bqK-jaOkw3evVe5bKZ7fdAJ1a5h8_yfpGEKbgY6Sw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQU0XH-MqGjqQ943M6c07B6vEkICQz21qjIeCmXJYdb1gw&oe=6B10538D"}, {"file_name": "migrated_image.png", "id": "525156238413587", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12727788_1112344362202494_1865804376874942464_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OwQ1ZQH3wA0Q7kNvwH41gpk&_nc_oc=AdrSoGRaVQZPZwoGYeZSbub1zJTDsUe94fzg8ej2KBhFuCPsHvZN17iY6IIFJ5WH_JU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUMDQuJV-Ph8rgqZI0JZIDgkL5l_ds1EendNgw1ZX4sVA&oe=6B104574"}, {"file_name": "migrated_image.png", "id": "213147453230509", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12427649_1965146287093375_8741213768345714688_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNyiJGmhal8Q7kNvwG14P10&_nc_oc=AdpXLnlTjiSrpBUxqRquRPLBWB4URVx1U_krqFIjyjrcFG-91ns9a9oErzPVhBI2Jv0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQURD3qyII9OpYPn2spuQ5qh0OnI4DEf-TbEOeNQR6hBRA&oe=6B106BB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Xp1HuB", "id": "1724395234343341", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12410441_1724395237676674_6604651178502389760_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=isnIpEN0vt0Q7kNvwEQPhOF&_nc_oc=Ado2MKfWwRgDp-5CfC0t182ZqP6yqI9j79nILF9S0eDEIo-Fi6ivjzSSw-6ey9b8si4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWldeyWEi8ldTPJvgG2EP5t69igjiXhMKPbg6uXEHC1xQ&oe=6B104828"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Oculus Go Vr-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}, {"images": {"nodes": []}, "id": "229386665099998", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salakapakka", "keywords": ["salakapakka", "kieltolaki", "opetus"], "long_description": "Kurkista historiaan Oculus Go Vr-lasien avulla!\n\n1920-luku, Helsinki. Kieltolaki rajoittaa ihmisten el\u00e4m\u00e4\u00e4, mutta viina virtaa silti laittomissa salakapakoissa. \n\nOmaksu etsiv\u00e4n rooli ja selvit\u00e4 ep\u00e4ilytt\u00e4v\u00e4n kahvilan mysteeri. Soluttaudu, etsi todistusaineistoa, \u00e4l\u00e4k\u00e4 miss\u00e4\u00e4n nimess\u00e4 j\u00e4\u00e4 kiinni. \n\nPeli on tehty yhteisty\u00f6ss\u00e4 Metropolian kolmannen vuoden opiskelijoiden ja Ylen kanssa. \n\nLue lis\u00e4\u00e4: \nhttps://yle.fi/aihe/historia/kieltolaki \nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Astu 1920-luvun Helsinkiin ja k\u00e4y tutkimaan salaper\u00e4ist\u00e4 mysteerikahvilaa."}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40t
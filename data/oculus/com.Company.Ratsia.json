_nc_ohc=qmNaNibeVNsQ7kNvwGKh1ij&_nc_oc=Adm__PH3j_UmCiOKlZG_Fo6xbX9HXWIyP6OeFk8U5Blh8x4ZNP-5P_qFRGekBpGWswY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afx8-3piwKXSuL9_wxarxQXHaTSOCXoYjlg9i9N2oHM8IA&oe=69B2BDCD"}, {"file_name": "migrated_image.png", "id": "525156238413587", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/12727788_1112344362202494_1865804376874942464_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R6TUUdtJbZoQ7kNvwEbkYPK&_nc_oc=AdkFc3qZtMOua_OY3IT6Tef795lKckqzG1v0KS5EFX1_zNH2L-PWsCcRuUd1_JPtmxM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFBIHn1QH1sqJcP9ER8i7x9rSNsI8g1kzVxjdtNDBD6A&oe=69B2AFB4"}, {"file_name": "migrated_image.png", "id": "213147453230509", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/12427649_1965146287093375_8741213768345714688_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pFDt-dLmmPsQ7kNvwHcBhR3&_nc_oc=AdkqDiupkeMCBMomUD3KkBvXkq4Bz8neOqCfUaUqlceXtrQsPVUK9QlElV5j51EqhQE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfykJWOZMUz234-OBAYTOwcChO-sZfShi7C79EWJ2UL8pw&oe=69B29DB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/Xp1HuB", "id": "1724395234343341", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/12410441_1724395237676674_6604651178502389760_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJV0Hq3oTGEQ7kNvwFkeViw&_nc_oc=AdnrecwvNYy2oyio-GnHZujOhRWSlhKHn7vyrovxIgfGj03IHzzXTJH-x8B2BQ1RAtg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwoHCrhKw9MVQ3YqPiPGtlwLQc7CVaSV8PBF38A6JEIkQ&oe=69B2B268"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Oculus Go Vr-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}, {"images": {"nodes": []}, "id": "229386665099998", "locale": "fi_FI", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Salakapakka", "keywords": ["salakapakka", "kieltolaki", "opetus"], "long_description": "Kurkista historiaan Oculus Go Vr-lasien avulla!\n\n1920-luku, Helsinki. Kieltolaki rajoittaa ihmisten el\u00e4m\u00e4\u00e4, mutta viina virtaa silti laittomissa salakapakoissa. \n\nOmaksu etsiv\u00e4n rooli ja selvit\u00e4 ep\u00e4ilytt\u00e4v\u00e4n kahvilan mysteeri. Soluttaudu, etsi todistusaineistoa, \u00e4l\u00e4k\u00e4 miss\u00e4\u00e4n nimess\u00e4 j\u00e4\u00e4 kiinni. \n\nPeli on tehty yhteisty\u00f6ss\u00e4 Metropolian kolmannen vuoden opiskelijoiden ja Ylen kanssa. \n\nLue lis\u00e4\u00e4: \nhttps://yle.fi/aihe/historia/kieltolaki \nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Astu 1920-luvun Helsinkiin ja k\u00e4y tutkimaan salaper\u00e4ist\u00e4 mysteerikahvilaa."}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40tfG9puBClTHdO_TxCgyB4ZnRCQje_gihetT7dw/edit?usp=sharing", "publisher_name": "Metropolia University of Applied Sciences", "support_website_url": null, "website_url": "http://gamesblogs.metropolia.fi/salakapakka/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "
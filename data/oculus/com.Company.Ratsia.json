cdn.com/v/t64.5771-25/12427636_311030506063097_7684297530267402240_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Li6JUxiuCCEQ7kNvwEz4CZu&_nc_oc=AdrpnOnOHCek5hmNMPVbm56OJDxAmFW1kJYexMf1jz-JtS8qgquekkh18zaYtFok7cc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRM2HdO35vUmbmfg3npobsN8-wnIbhe-YgOfC6hq5pE_A&oe=6B01D30D"}, {"file_name": "migrated_image.png", "id": "257908231893567", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/12427537_153407198748341_4554638566289833984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTC6zggci_wQ7kNvwHobDUY&_nc_oc=Adp-Hn0lZuZ53U5YxjSfsqhcpYL7lRfXX45fpo8UokVb9YpaPRJekHEkiMlL4yo1R8o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQEKgg15fHIm4WcGDfuhQoro-STjLHfWqgE5uSU2gxPVA&oe=6B01CACB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Salakapakka_cover_art_landscape_2560x1440.png", "id": "2072918856328131", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/12331069_2072918859661464_8079457748682539008_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wd8XCfkMsPgQ7kNvwG_6BSy&_nc_oc=Ado7JUlpDa56nxA0Jnq7tahCJNOZ2qivKT7F9qACguvmMK6p-XMefvhqBMQ0jmLaVtY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSS9Lj_-6hedcd4-1lco89FsN3m_-3t0G9U1khe3Tf5FQ&oe=6B01E991"}, "display_name": "Salakapakka", "keywords": ["speakeasy", "1920", "prohibition", "Helsinki", "educational"], "long_description": "Peek in the history with Samsun Gear VR-glasses!\n\nIt's 1920. Helsinki. Prohibition limits the lives of common folk, but booze is still flowing in illegal speakeasys. \n\nAssume the role of an detective and solve the mystery of a suspicious caf\u00e9. Infiltrate, seek for evidence and above all, don't get caught. \n\nThe game has been made together with the third year students of Metropolia School of Applied Sciences and Yle (National Radio). \n\nRead more: \nhttps://yle.fi/aihe/historia/kieltolaki (in Finnish)\nhttp://gamesblogs.metropolia.fi/salakapakka/", "short_description": "Enter to 1920's Helsinki and investigate boozy mystery caf\u00e9!"}]}, "developer_name": "Metropolia University of Applied Sciences", "developer_privacy_policy_url": "https://docs.google.com/document/d/1HAGoEAuEA9nNde_z6CKiuWe4tAgKM7gakRMlY7DNGmE/edit?usp=sharing", "developer_terms_of_service_url": "https://docs.google.com/document/d/1Ytt40tfG9puBClTHdO_TxCgyB4ZnRCQje_gihetT7dw/edit?usp=sharing", "publisher_name": "Metropolia University of Applied Sciences", "support_website_url": null, "website_url": "http://gamesblogs.metropolia.fi/salakapakka/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": null, "genres": ["EDUCATIONAL", "ADVENTURE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "fi"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1655739294773830"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1611752482246736", "version": "1.0"}, "id": "513876702327905", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1556971604391491", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1611752482246736"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel
7376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-cFkw5AI6lAQ7kNvwGRCDOt&_nc_oc=AdolXxR8VSmgjPYo3P6wWt-UNelnCETeG4GPChocDXC7RjHv9b_EGpAVgPvJH25cIYM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0qaEca0aK2bAggHjo2rVWXnHHJ9t3B9t1UL-B-TH0s1w&oe=69EA1B78"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_Video_Thumbnail.png", "id": "241687419673855", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/11162694_241687423007188_3236688866094088192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yx_yqKOBr8IQ7kNvwEX9MZZ&_nc_oc=AdqOPSaBFU0ScAbT0FRCKK7PiZlMsXXXcrLhbglzGl9aJ97MVr62fTYVsTaaR96u-TY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af064CTl_q48yEqmxizIxA9BZiE3sYBQ0urr0U_kufPjig&oe=69EA213D"}, "display_name": "Sneaky Bears VR", "keywords": ["bears", "kid", "shooter", "gun", "coaster"], "long_description": "In a forgotten toy factory, Frank, the fiendish teddy bear, plans to unleash a horde of cuddly monsters on the world. It's up to you to uncover what's behind Frank's mischievous plans.\n\nNon stop action throughout the dramatic factory surroundings; this is one you could bear-ly dare to miss.\nBest of luck human, we think you'll need it...", "short_description": "What do you do when the local teddy bear factory gets taken over by an evil bear turning all the cute cuddly teddy bears against you? Play Sneaky Bears to find out. This new VR action adventure game is all you need to get involved in one of the most exciting adventures of all time. Finish the game to play against your friends in the leaderboard measured \u201cSurvival mode\u201d. This game just keeps giving...\n#dontletthemcatchya"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/377885", "developer_terms_of_service_url": "http://globalagents.warducks.com/about/terms.html", "publisher_name": "WarDucks LTD", "support_website_url": null, "website_url": "http://www.sneakybearsvr.com
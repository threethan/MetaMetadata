7376_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMCMf3KonA4Q7kNvwEdygnH&_nc_oc=AdpEmnX1raKSTfiA7u_05qDUksNvMhfVrOT3ix8wHGJziFeiuiHBXvw7ArrF4wvLUZA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ybTibGmUrq8yVZc4ylRwehHs-i7PnytWzEodQU22BaQ&oe=69FF3378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Oculus_Video_Thumbnail.png", "id": "241687419673855", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/11162694_241687423007188_3236688866094088192_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DTAoqhaGZFgQ7kNvwGqAToM&_nc_oc=AdrnHbkKaNpXNFek9VZLKdTK6lApAWYyYa9fsUEvBw6U_4h4x9y_T2zYisdKZIYzGs4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WjN6pWyLvYK7kZHOsoUDeLsiYVfKSmv_7xemxtIxj4w&oe=69FF393D"}, "display_name": "Sneaky Bears VR", "keywords": ["bears", "kid", "shooter", "gun", "coaster"], "long_description": "In a forgotten toy factory, Frank, the fiendish teddy bear, plans to unleash a horde of cuddly monsters on the world. It's up to you to uncover what's behind Frank's mischievous plans.\n\nNon stop action throughout the dramatic factory surroundings; this is one you could bear-ly dare to miss.\nBest of luck human, we think you'll need it...", "short_description": "What do you do when the local teddy bear factory gets taken over by an evil bear turning all the cute cuddly teddy bears against you? Play Sneaky Bears to find out. This new VR action adventure game is all you need to get involved in one of the most exciting adventures of all time. Finish the game to play against your friends in the leaderboard measured \u201cSurvival mode\u201d. This game just keeps giving...\n#dontletthemcatchya"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.iubenda.com/privacy-policy/377885", "developer_terms_of_service_url": "http://globalagents.warducks.com/about/terms.html", "publisher_name": "WarDucks LTD", "support_website_url": null, "website_url": "http://www.sneakybearsvr.com
st location you used, and the last PAGE you viewed will be displayed.\n\nThis app offers only the PDF function among the features of the __Paste Photo VR__ app for free.\n\nIf you want to attach more types of media to the spatial, you can use the paid app\nVisit ' __[Paste Photo VR]__ ' where you can use all kinds of files.\n\n[Paste Photo VR]: https://www.meta.com/experiences/paste-photo-vr/8767138216715369/", "short_description": "You can read PDF files and pin them to spatial."}]}, "developer_name": null, "developer_privacy_policy_url": "https://blog.naver.com/uc7/223929197098", "developer_terms_of_service_url": null, "publisher_name": "woojoung", "support_website_url": null, "website_url": "https://blog.naver.com/uc7/223680590174", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "10005617446200160"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620817_752232810593116_5342391254279568017_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pOYsZHLsKYAQ7kNvwHtfJ1I&_nc_oc=AdkjU41ejNl7V6JURyW3brux9geOOwdBnYc7PPluM4NLSJZbrJG0sJ3pSvuJ-Q-wAc4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvp-gj7pegcOED2jZ8laqGCgeKZIwiagOmsIOd2RvoAeg&oe=69A2F39D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "PDF Viewer", "platform": "ANDROID_6DOF", 
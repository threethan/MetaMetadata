ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VzeZakzJoLQQ7kNvwHseOqc&_nc_oc=AdotVubkYLGwTTJ8dVXi4GscPTnImCFhLTXMs5HEstn9NUTEnsUFYJKsDxa3GN7DgSU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_B-X-3b9sSN5nKCbhuZ12LAc5aP0G9n3iLOt-zw6TJA&oe=6AC3CD7F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTRUMfilVdsQ7kNvwGcIldF&_nc_oc=AdrYby-FIhgjDOK2JfxqFFHze3mWzAhJW8FttUQsVbWOgI0U2wHoy9vNw36vz-LjKWo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsNoPaWorS-SNviviM9-ojf8Q3m7VUGmVtOSGvy4i2CQ&oe=6AC3C5FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4plhHYTTIssQ7kNvwHrNFYu&_nc_oc=AdqZQVf0Oyf9mvAw2xtraJn3CcbdQDUrkLe9dKGexJJIzfln7x5Q19dUV8aEkBKH7TM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYvgc8ApF1fHWVNYzI8kxDRoM2vEcIdMtG9b-f-bHFAw&oe=6AC3CC53"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wah9CN_XxZcQ7kNvwHthTgA&_nc_oc=AdqKt1tSm5h1tXE_H8W29si5NrzPXB4Wx43jrlpjQwZumNFa0FsuYJKjevPaNrsAFjs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPzlHKdCnLdF3uTPia6GfZQqzc30h7AEXySkeAQrJQDlQ&oe=6AC3B410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dD4qwcAYzucQ7kNvwEGbOzN&_nc_oc=AdpyhaZzsB-vJHBHojsaTkWkRvZEaFAn9Bu_GPcOgPLMbcszc2mrBKf9KbEmATAWVsc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMMmClY-5UQbyG8vkyVRC8ATxHvti9htHJBySA0vpRm8g&oe=6AC3B8A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
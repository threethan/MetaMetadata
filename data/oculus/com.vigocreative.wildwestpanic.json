1440_1.png", "id": "1437623151225920", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqc2ZEVapmcQ7kNvwHm_r4_&_nc_oc=Ado0fVPk-vqrA_xukJsEgTw5xLGxO1_Y34G4Z-hvzRNqYVeTBh91nfRYDjKpDlA0ajQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQINkFVouQ-SVBx_SYwFE2yEon5Mf_akCA3Q63RJwUKpkA&oe=6AA9373F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J51glvIUvaQQ7kNvwFz0fJS&_nc_oc=AdoZ29--xbR2AWtmV7RAIcSctihQbP2E47LVjg_yfF-js-zYgtWE5MxTxjAKgU_aBek&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYeYp-ewiokLPsB6sshNLxeUVqoxibw-EMgP2kajDF8Q&oe=6AA967FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zKbUtYxig4Q7kNvwHprcWy&_nc_oc=Adq_v5yyhO2IozdyHCnmgfpvj9RREmZxCzO6hAcOXROZl3flEuyDEEAyx9ubJ2N2Nlo&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJVn_f-b1_9mfBFy_jJ1SlL0pV33VVJWFaLiGqooVRwrQ&oe=6AA93613"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oJ_v7tHne4Q7kNvwGq8Ez8&_nc_oc=AdpBrJoYOKqGjugNE5WX1WMr_xJJ2Ppi1vRw1kO75BvwItdLxx3lgFlqLQXBM2eGWyE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiaoO98XWubMapFtwfJJRxI7EVKEeHcT-bEV2lJPlK1A&oe=6AA95610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkWQmXNFvbUQ7kNvwFQNlwy&_nc_oc=AdrRO5rRPWeaw998JV9Pnp00IkRqNOOmCLS2XkE-7yS69rMnJLW1P8UsesO7v22Gjh0&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLyZyouNJxV17q_CS9PNdy9bD28yBILvnXiYikqv1U7KA&oe=6AA95AA6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf", "developer_terms_of_service_url": null, "publisher_name": "Vigo Creative", "support_website_url": null, "website_url": "https://vigo-creative.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24573726615634161"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PUBLISHED", "id": "1078918094645203"}, {"status": "PUBLISHED", "id": "1532703385011480"}, {"status": "PENDING", "id": "1742512047175041"}]}, "baseline_offer": {"id": "1532703385011480"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790096400, "status": "PUBLISHED", "id": "1078918094645203"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26787729187567215", "version": "2026.07.16.4"}, "id": "1192992962932228", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24405775765762581", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26787729187567215"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1192992962932228"}]}, "
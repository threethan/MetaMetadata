ps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L_mNUSX0P0Q7kNvwGqHVL_&_nc_oc=AdrSHeZ8cW_-yFnlCVeMj15eFAndZqsVpGic67K-wuJnYRJVIpYubAMQ-n2lhiH6idc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEwPKCzBT1Bhx1U9r3OWihdXgXgOWNrjyLZ9BhZw8p1w&oe=6ACFAAFF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrcFB16fYsYQ7kNvwH1RLIW&_nc_oc=AdrRgqgLWiGW4smUrPBlgAg7i-Uqn_14no-NAKJNE2WunmPhhfQc5SssGCHjQbTErYg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNT_EqxqMRBLlYLMmW0QJZXOpAHcVrWsifaQs-sRe_bMg&oe=6ACFA37D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEiiFhsaGecQ7kNvwFT6bQE&_nc_oc=AdoHTwcWdJYoZDXJB2HfvEpYZn8AsbpgiV-VLv4Pied31_QWhXicTXuYrD9Fiigi1eY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOscXQqJPo71kTwpA-XvUgsC_BfLopMhJ6ZK-9DM00Q5g&oe=6ACFA9D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iQ4PnhaaC0Q7kNvwEEFyck&_nc_oc=AdpeSMHgsgkSPutfzt8X6l__Lw28ubvFnocPjWwXlt6Q23zOiqv0tnqWaUPrWa4KRQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPm1rAtUEZZeGh3EsBKdQdROTm9g2ZUJlRlEJNBEPR4ug&oe=6ACF9190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thC7LSLSuCQQ7kNvwEIMt3F&_nc_oc=Adq0LL5OMMn5vWSG-6PoDE9ueETLCPNv3XyyZAyb2wHt_1WPBDEJke1de7PlGOvBouQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3931LtVcNEFtN5KxDLWxo89hdxHu2ztE6eUZd2dCjfw&oe=6ACF9626"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
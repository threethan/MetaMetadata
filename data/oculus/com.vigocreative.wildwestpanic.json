ps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoO1Bcy-Ke8Q7kNvwEor_-t&_nc_oc=AdoSW8p_bPu-1WJGJ6FXCG1cFLzTVu3pnvPE_TI9PFo7pv2JBgAIUsD_vmCJQQHfgro&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQHHHQ6KD5fleaCM44Wv6TgDZCIU3Ks9ZE1B-p-yiVpA&oe=6AE8B77F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugqBrUuoXZEQ7kNvwFE5FoL&_nc_oc=AdqU3BKIor2mi4Wfwi6Ayie4rLUFzlrWVZlvXXav-PMrLNiHAK8xecpc6cnAmS-F2DI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWkhRJjGVOTbQsUbk8CiJrcTbHyj53KR0ihPYbXWNsPA&oe=6AE8AFFD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2im_HOfkVQQ7kNvwHFZgfE&_nc_oc=AdpXm4YSr8Sxjx938XtZQNt_tIAqw9MH4aH3ckUC_rlGxAffytkHoxtpiZ0Ue-3Vbw4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS3U7GPDxTweg2dDyVn9hYe7LbdTEnnTSnORJ__0aobPg&oe=6AE8B653"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSKsjoOTESAQ7kNvwEbMGdY&_nc_oc=Adp02a5zx3NHI558wME8HJfsPjnr8YEkxxTidRfpPugIGWdm9PGHAwkrFu0LKC8n2Ts&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYU4xg6oOaTp0e5SweUIMyewv-joWdhu6cyC61Mc6Tfg&oe=6AE89E10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ioiOHwzCyokQ7kNvwEuJjt3&_nc_oc=AdqezqDLT-9iBatjUo7FClUXx9AZl2AieWIYecIEGjTHEHxZur362eA8GhnUIS87_Sk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRlUz1vrIlKL-YgY7Oj3533Gxa-n0U6PPMemGKXh2O1qw&oe=6AE8A2A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
ps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA522AFCSyAQ7kNvwF4Pgub&_nc_oc=AdoA16iQ5VV3zYl16KitO1uQd1xP8XzpajSACCGRCKhmdweQSIVUxRZgYNqvGkSUnbE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR76HOXAV-eppKp22b_6e6XEcp5veGSYJZBp3xrzBEx8w&oe=6AF0A07F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BS2L7ttJuUQ7kNvwFRAmI9&_nc_oc=AdorXSnSdpvVeQBG5CE7uOmKNPRKzNW8360bOmNX0CrEPYC78UR0hy3dKThgwQRypJI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm_mv8jP6MNXOLMZ-fyUcIo9mI3qkQYtMXbdaO5mrGSA&oe=6AF098FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u33AX-yrq44Q7kNvwEjcrWB&_nc_oc=AdrTKGetpf1GHIAaxxVbrU9OwJIazes_12u0W0eJudTK2bKbZ_3-W9vd52wSjSCIEew&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_yApv1wnnPH4iH-bRz-P2AVq9hW7_jFzCkZfODYY0NQ&oe=6AF09F53"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6HjL_Lq4TAQ7kNvwEGZ4W9&_nc_oc=AdqrmDeJaS00cCacaLR8RNjEKVSUKkbYg5g5GQDtain7TYBjwbmRtandEOBPIDUQ8kU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0rYWqB_Y9BM_-CQ5sDHRI5gOuLYiq4meXgM-bH8fcfA&oe=6AF08710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njtNc1dL_IYQ7kNvwF_G6WA&_nc_oc=AdpKW2bl0FL-UwLWbpjl0GxBoxQm-27PZsa4TxrHTDhIQrh2_dCT9TNxRmN1i4zCAF4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTz1vva59S5ZkbTCSS8koI3Z0GXkCg4NIkgOwzy9zNVpA&oe=6AF08BA6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
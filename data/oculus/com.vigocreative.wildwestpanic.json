ps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sgyK8LOI0oQ7kNvwH4DX0e&_nc_oc=AdqHZGE20vksma3tmJxfANNwCX_WJvWmzNHdUaG562Q7Yojhlxr1YQsGyUpofYQQDHI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQORi6AQ1K-Z93FcixqCkXV2F9HUI9fYQoZ6Lu-2btpw9g&oe=6AE0963F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYrPH03nEAIQ7kNvwFRuEgb&_nc_oc=AdrMVafucv8MAmIUmZjbG8ynJgK_B2UnXds20jL56FMyRLXZQYuxWS11xj2167p0exs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu9B1Arqun4m1upzCG-V_yqIIK8ZcbcPsDk8fy2Meruw&oe=6AE0C6FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFnGsXPpCBMQ7kNvwEvJoaH&_nc_oc=AdoRgqCffzJ7JM7VtufsxylxFSTE4WdN9Ox1nQElaf-FAYZJfu0pGx2LM05v_qDYnBo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTtkNGvVF-5P_BNHj84OnV7xn5mWQpU_FC-FWBpqRB0A&oe=6AE0CD53"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6CagUQCm80Q7kNvwE4mGFX&_nc_oc=AdqQ76QfiI4PRuOhH-6J3zcqeVev9tSMxYlSr6mUMZlnC2ruynRMIOtY9MMCrPaNRUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfv37mxRKTgkh7SUD9pvldVJvDs5DIdc_YEs_fIg4RYA&oe=6AE0B510"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktldZ5nj7GcQ7kNvwHiOJx6&_nc_oc=Ado5_noLE7sk7X8sQo4yZArIejXsysX23RJ-VQmz2K-9hmgMdPrtiyDKHRaCrjx8xHk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfN3Fz_HRSO16wPtWQ0LwDbUKVdmkIMxl_C1BQgZV0dg&oe=6AE0B9A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
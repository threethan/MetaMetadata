ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQMWjiAaBxsQ7kNvwG19RNW&_nc_oc=AdqpJFgcRdH-W1zR0MaGbw5-puO4TSAb8XC0mweVX4Eg--EZckcwtfu5Vp32GgOSJEM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJHMBXdf2LbtGlSZh0XYstHm4OL3eTKkcJhoHnQdZYERg&oe=6AA6943F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9rKMmMkXoEQ7kNvwGNruFO&_nc_oc=AdoScgKkrXY9j5rZWNMbPP05_milsxdCc3JtAv67dE_TiQpiez_YXCct8BU_l1AMIvk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLbxASXPoUmg4hfzlhWxwovK2klnAGTnk8h8QuyTTI_rA&oe=6AA6C4FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDLg2EwEWIsQ7kNvwGkIfJU&_nc_oc=Adr2HbKcxdi5WnH0gOHh12xBpDUmFtCPZe-Jybdnenhc1AbsYWrxA-5neFHhS32Cj0c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK-2lx9A2Qu32PmZbAW6WyMmMuTVTRL0o9WexpdPnuj_g&oe=6AA69313"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeTqKW_m9VwQ7kNvwE1_koD&_nc_oc=AdrP1FmwUxaPTDrvRkWiU5_BhjUYdK6P1ViE6rqBOtKIPV9-GseWRdU9fz9zN_0dhNQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLV5BFaupZLiLTrX9FQlsnGpDJrx7E9y7ZU3nBcGNx3Jg&oe=6AA6B310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkWQmXNFvbUQ7kNvwGQfMfi&_nc_oc=AdphfryFXWx8YVZ9N4bW1r0-6XbUWyRbsecWTJRlURB7Cpcfj0nUpiHsvFzeSJDb_XY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8CJv9ImmQw5G1zgO7cGdnmrg0-3spp4h_pGD5s-j-Pw&oe=6AA6B7A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
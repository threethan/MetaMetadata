ps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHH-kZyZpLEQ7kNvwEW9Tg0&_nc_oc=AdrNwRiiLtaz3v81Gs_WzFtuOHZIYxFaaT5BJo6e_s_N4mxF-XqDTDvRhJqVL_XJACw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ-RUrJEzoe9MPZp0SnhkZUIpGQpM0LeiXp1XwN2eulPQ&oe=6AAD2BBF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb1v_o1J6qIQ7kNvwFjbTIT&_nc_oc=AdrpbAWOLPgK2Qofi8_EfMb_KNd9ICgZxSWd9VJ1H5t7UcyFE2o0kvQWIxZCROu-ov4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl3CMyTbcCVQsNpuRmteSw5bjVUAf3na4SdIEk_QKraA&oe=6AAD5C7D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHLQZke-U64Q7kNvwGP6tWR&_nc_oc=Adq8Ev0q6mcrpL94FgbHIcekAMOq8_rzurfCvD4iy4vK5gfo18Z0vm2L5O9NOOlRwbY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZT3Xc63q_qnYucPH9VKz-acgAh-dRgKmnLNbJgSswSA&oe=6AAD62D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdAz8sifOUYQ7kNvwGduvrB&_nc_oc=AdrX-WLfR5aOlmspDQNS3F8xVHstYijFWPczHUSRPrAgdfwpfdVpb9-S6XJWc7y5pis&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOFl7EhOWqCWP5RtUf16BjpuhuG8szBMv-3npc6OTZ-w&oe=6AAD4A90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u23L-U8mmv0Q7kNvwGCULog&_nc_oc=Adow_mRYLGUCxR4BjKkN-r8RF2VtMZOTJPJIkq__TNkYbmw0RHnI2Ov4LQnov84UXqk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJPDLwHUjKV85CiA0DYaN6RScfBE95_nX1JWgVGGTjd-Q&oe=6AAD4F26"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A_tQp7EJA8Q7kNvwECoAXy&_nc_oc=Ado3uipzvO0FpuVbsog3cqJ95tXZ-0U-W8l6kMfg3qJ5lrU-kpEW1yDIGsVDzY_aBbk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNamxJY8k87kcoo62ieIeuW1smL9gZEr_1lA1-Dq9srww&oe=6ACE597F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrcFB16fYsYQ7kNvwEMYThP&_nc_oc=Ado8OhzSo6K8ff6YJqNdSXQMbfn6CPycsfvDc4KW9mVQ3FUADRmJLmr3NeiM0K9W5Y0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMZEAz1sfCxNFR-O6CJ-qeqszBoJqgaUybeP7KAwPPh5Q&oe=6ACE51FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEiiFhsaGecQ7kNvwEY-dg2&_nc_oc=AdoeB5-qT1e-MLtSO34hyJJ9cBwPPc0GVJAZRlycbBLmCYsvpm5YGblI9owjIG3hpmM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMyKNpa39o2pfhsNkAwYJS5FCYVH1TchqTUDQcjcAyPiw&oe=6ACE5853"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iQ4PnhaaC0Q7kNvwEFqtZC&_nc_oc=AdrUxj15PKhv_gjoModELJaCYAAuQXmEpGihBBqunWuJD92lzJSi8i0OsnAJgWG56uo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM9RzeFnPey0y9jD1mcUoqN-uYmI9XdPL4AfiudJdN-uQ&oe=6ACE4010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thC7LSLSuCQQ7kNvwEHgFuh&_nc_oc=AdrHfuVnMUXLhbV5IAuuSUlPLgfQPtfP_qb20f-OR-aCHmIzrgUYkDCx-CHD-_hQero&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_1_gp0E8fT2O2PFFcDXDJzSvnBFPRkxhMOV643R2Tmg&oe=6ACE44A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
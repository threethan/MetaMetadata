ps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_auOfm2kGg4Q7kNvwEZxHPi&_nc_oc=AdqixjnAThueHW241jCrTLvF2PF1sKH2JRZ5A3CvP6fKbwsQ_jVcVo5B9J6aMtn02jo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMe-MgIfUwcd2MAf90r3W6UHYl1uZChIIof4imXOLe8tg&oe=6AC7C1FF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RWjoxfRtIE8Q7kNvwH9rGCn&_nc_oc=Adpw_xYbmFRvsYRFIdoFSb1xKeLPyIiynT46VapKRiG1Lz2BjZD0PAzszMdi8e0wFpU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVxVRzq8oOZWdOUtQGG-vdZ-66aRB7g1anWiBToqyjDg&oe=6AC7BA7D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OrIp6IcVzHYQ7kNvwEpegUN&_nc_oc=AdrwqBW6Y-VPUxhhY2imXlI-P0gRgtTBTURX8VH2vrjfdbSvmrwJT91lUvhfvEncgDQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNsKlgN79_6Mbyf8br6_Mz0Riac3vC5qf_k_-dfRauM5g&oe=6AC7C0D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ErkV-19q-rYQ7kNvwHvkG3l&_nc_oc=AdpvL1bhHsGyJb3r1nYMZgIvmACOLixrEHl0G7WZgWSzdy8gVT2rC3RF_piu-QJT7is&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkCH1FI-hAHxsXRaC8jCbUPEDqP6lFB6MWshyCsGzNNg&oe=6AC7A890"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDQhlNDfGdUQ7kNvwHWKV9w&_nc_oc=Adp7RSUtj3cjCiZG7xVZPVmmxWtOQeRernM0nrwU99aNTSjsDO86wy28LReBZBmVZd4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQ8-MkKTIo7xkBiHPdNhTqiXhl93w_Rm5to5IAR-uklA&oe=6AC7AD26"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
5AdLzovTVdI9BYAgPjhNnvvJQ5Z0GmxBXA&oe=6A9FFCBF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n79LxI9yASMQ7kNvwFP38Id&_nc_oc=Adox3YXG3MKKn4xAPQlbr1yMVwccYDl3CtT6v3rOwnXQ99Dr_ywocRz74D5ymWq8yh0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVE5VR-54ABLHZsFD8CXwIywqJZBcH7OFH6Rgvl7bZEA&oe=6AA02D7D"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "1023554306810317", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491825563_1023554313476983_7659786202526969718_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qnp9uXIIqsMQ7kNvwH_H3b3&_nc_oc=AdrQ4HiDldTpaP5OVzcua3fkhQbiL7fIdBDwYcS0SXFptlCjIUkdfU_lFJfH6mw5IQE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGUKoUljDacbvPOXEHpxgfCfYQjGXC7qYN8292A8Ch4w&oe=6AA003A6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjSz64BEa3EQ7kNvwFE-ij7&_nc_oc=Adq8oWnAYkCbWoMZ4Tb8EPeGWehHT2bFY02_mH26uNipdeKZ-fwkaY8BBCgiUPbVnGY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcuFtnRPH4EW29WYu3Vt0xXAdSwqc0Qvu6jMyyYZWFpA&oe=6AA02026"}, "display_name": "Wild West Panic - Early Access", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "**Wild West Panic** is a hyper-casual VR arcade shooter inspired by classic Wild West shooting galleries. Hunt bounties, earn cash, and beat your high score!\n\n\ud83d\udc49 Join our Discord to get the latest news and chat in the saloon https://discord.gg/APqtpRwyX7 \n\n{2223173828460337}\n\n# Main Gameplay Elements :\n\n- **Ever-changing levels** : Missions rotate regularly, offering fresh locations, challenges, and replayability.\n{1691469755605115}\n\n- **Pick up & play :** Jump straight into the action with intuitive gameplay that's easy to learn and rewarding to master.\n{1323109135980384}\n\n- **Shooting-gallery feel :** Shoot wooden targets, avoid innocent civilians, and improve your accuracy.\n{2767208070326014}\n\n- **Bosses with a twist :** Every bounty target has its own unique mechanics. Observe their patterns, understand their behavior, and find the best strategy to bring them down.\n{2189658808525654}\n\n- **Challenge yourself :** Climb the online leaderboard, unlock 45 achievements, improve your score, and discover new strategies.\n\n- **Risk & reward scoring:** Every shot counts. Precision increases your rewards, while mistakes reduce your bounty.\n\n{2210337659506582}\n\n**Coming during Early Access :** \n- Character customization\n- Bank to store rewards\n- New buildings\n- New levels and seasonal events\n- New bosses and characters\n- More achievements and challenges", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf", "developer_terms_of_service_url": null, "publisher_name": "Vigo Creative", "support_website_url": null, "website_url": "https://vigo-creative.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
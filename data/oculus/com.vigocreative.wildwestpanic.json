ps://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1DR4tDk754Q7kNvwFz5eYr&_nc_oc=AdoPw5xb9rH45b4GuGvtPD_eyFDv43EWs2MG4B1Ja7krmTtCg811QwUHyJ6NMQqmGPI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfBsl2xOdL1kBPSBrEm4A4k2ptztDQ0XQECHmErSrPKA&oe=6AF9DAFF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i-3tm-JxARAQ7kNvwEEDLpU&_nc_oc=AdrAdkE-WeoWHsjJ4JLIGa70TxcCoyp4SkSUmX3LWhVBc5P961ZY9QyzdIPWm5M1xvg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFjP-7UQI7UHpcPD6Pu6_8QQ6793hYVwFVIb2COxax5Q&oe=6AF9D37D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ndQLcVlXKm0Q7kNvwFbAZ6Q&_nc_oc=AdpI1YZ7CePbVgznUlHl6Uw4TDT2ST1UOoDxGrrUj4N4VWng0_laNNyNaYtqFM44Kh8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmS1_JsPLgq0S0KYo3oXjdqp225t3onqUUfCpKLej8Og&oe=6AF9D9D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KWo1NvQMosEQ7kNvwHbWp6H&_nc_oc=Adoc4T4s-QdN1O525KqSjWsoR6doAA-u4heCNL6Eqkn76zEPCk_CB5mhGuWapiNlQHA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPuI4hSXEcaJT-zTK0bX7L-5Ez4Cd-PP0pFXQTNp5ggw&oe=6AF9C190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JztgTxpme8gQ7kNvwGD_q4f&_nc_oc=Adr8hgYmSc-mUC3Z5z0dNqV_t_gu-OLJXOaaQRHkemnuAX4wMhU5AyhJVtjIZj0kqvQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSInInKvipEWS1YdvYrpvo6FouWI5EDqZ6ljk3gk8MQWA&oe=6AF9C626"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
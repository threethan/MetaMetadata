ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eoO1Bcy-Ke8Q7kNvwH2HJ_X&_nc_oc=AdoB8a6IAKgDwkQ3CrlMLCqZsF7_wrlev58JuCXZuoiKLSx8i8mg2gAS2KXL7_1haOc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRuYDElU1oeIRJT7m2sC5k5Y_AWtz_m8P280Iv8Jwi4Bg&oe=6AEA08FF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ugqBrUuoXZEQ7kNvwEKSzkA&_nc_oc=AdonRGOfg6Qey9Ysjj3PwK4L20L8zHMQrZKvKlipu8XLXCmwNCr12ljl5ZjtIhpb_Kc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQI0dtUTFR7GAg_x7B3j_7amrc2DsM2J5boK-n_FJGXaw&oe=6AEA017D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2im_HOfkVQQ7kNvwF0vPTK&_nc_oc=AdrCqjgswAd2aDJeiv30ceeyif9KUSIICxv2O8QnErrothQinYxOLT8OiS5rq-p_ouU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwUOEozOAPoR3T8V7adZRQzfFKAzlF10R-4gTkcvdB9Q&oe=6AEA07D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XSKsjoOTESAQ7kNvwEMPeS1&_nc_oc=AdodhNHTUNJleQsLlJcBzqPxKvjgUnpNQRYiRFx4UwA-BYTzsmbI-rSwh_QdnxX2q2Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBqEMyJNg7q5y-HPOKh0lXNXKoRZ-cDDRdKhj_mFbEpA&oe=6AE9EF90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bVgLCTjo8EQ7kNvwHOtnDE&_nc_oc=AdrfIDgixrI_gOdfDI9_pKK4kPXTgviKrJJlhejRMH7GRfW4P4LM2mc2at32ANHp1QU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRqHI2ZvxCaH2fj4kbKkHiRiO2V9e3422BDHxlEJm36sw&oe=6AE9F426"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
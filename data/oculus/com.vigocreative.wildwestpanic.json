ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_auOfm2kGg4Q7kNvwE5xnEo&_nc_oc=AdoXnKgjio8wflknrXY5UxY5hj2J3UFnz64e8hFYf17EFPVLS7dK88P46VJSVQBBqYY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOIxPGdWm1uPimOqhzHzZSFVEGopuXJbtuVDKC3KLAS-w&oe=6ACA64FF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNpNidB_gFQQ7kNvwHXKhiF&_nc_oc=Adqe-u2mM_TBER9oNE7NEdUIDVRwZrIH_xJuEAnWCKnHa-dKRuex5RXnrV4v6CIfx-0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcEFcC2WCHZI9UTI1-9gyJXZ6jLZZADVeNHImGvMQtjA&oe=6ACA5D7D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug4BrOhGvOUQ7kNvwHCsGlX&_nc_oc=AdpgO_aSTondaQLcPuZmceYYU-MrmkfUf4Q8jQn_E-q-T7u0IRu_jR8GQV0GC4OIbMk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMv58vDVua9u0We15-JLDVnA-y87x9Ura2dsuQyy7I04g&oe=6ACA63D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7c2CIIjk3kQ7kNvwEC576i&_nc_oc=Adom0hhTExJgb0tF5JJ01ERwN6fMv6BLBrlGYzX98UVQpEkSbPhYJm_2S-ZUu35fSIo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTnonWhFuicm2KVHeeDwn9xsrkZC7BtMtUgoGABa2H-Q&oe=6ACA4B90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSuUEQOIh2YQ7kNvwGG-7gq&_nc_oc=AdpNTlwN7u8LqAsQ0syoc0_Gz1Ns5R_JypPRMIgyfVTMQbb58Uu1qV4u5_OWAW08UUg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIbdk2XHkZM0vsVfQB7KZnMly3-fdjVyigwnIS67t2JA&oe=6ACA5026"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
ps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL27cE8dtfMQ7kNvwGRjOBv&_nc_oc=AdppSHEoIO8xyOdB2pz4o0n40xRLh0y8FSXl19YrGT8hdtlsYgS2F-5rt243Clwj_q8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDgxbVGh_elwagIcE6T9IxlZkHCgPTjo87lvrVDAzqtQ&oe=6AB6663F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKf7hWANQ40Q7kNvwEbrif8&_nc_oc=AdqE_gN570ubfx9VzujjCIoRvBhmYCQbbv1GB8cUT8cHOmwljBVGkWHUab85LOw0aJA&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0rzIlMEA5x10OoJ83JtsoxP6qpnmYm7EOMlKVqU2dfQ&oe=6AB696FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP-TkLdXnDIQ7kNvwFlzcTO&_nc_oc=AdrGXa5BiSOGY9C7Qxz00BngyXTILB6UVlPe4gfDm43aelfBYouXMLoEqUisIdHwyGo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7k2E89Y0eEwensvwxG2OjAnMkG4HSkWqvdFyPMD0O6g&oe=6AB69D53"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2J3A_b1hVoQ7kNvwGSV8XV&_nc_oc=Ado3_7kEXWYJ30o2jRaM30Ix8N-e6E3K8LJVHxI2P0Rr36Rs2HpOMjMdFU04bzk8IOk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNma8mJzJm7fkJt3KPiTIm5YRU1rOTsBjy7e3WPMyETg&oe=6AB68510"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1fKTQa4ZlsQ7kNvwFEaOeK&_nc_oc=AdqFHgoeFeNcYY-IBn9-63XWXHdtI7r5HMvWwQQpPCKgXzWXjtZNt6gXxdJXXwDBnSQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZwKWrIYufM6bBn52WOitDqX6KrsnCy0VVQCvA06lJ5Q&oe=6AB689A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
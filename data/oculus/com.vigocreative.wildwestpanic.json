1440_1.png", "id": "1437623151225920", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BHH-kZyZpLEQ7kNvwEBR00p&_nc_oc=Adr3WCf3Ka9C29zzvzirQgpVa1IF2CccSMGcxQhGK1BFpJSYbMgNnMIJ0vu6i7YfYfM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLr3V1W79vnFv6yM9c5NxJWT3TvDDZTraKvngkXkt5HOA&oe=6AAEB57F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fb1v_o1J6qIQ7kNvwECzPrp&_nc_oc=AdpTUYDiZc-wOzjAlL9I7iP69XSGrCqYRC1dXLSvyeH0CF4IMLNqhj6_R2SAfgfxNmE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIm6OlHhxUhW5jHFaj2xBTh7mElxzEywknSIneE3rjxIQ&oe=6AAEADFD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHLQZke-U64Q7kNvwHkN7Hl&_nc_oc=AdqI9YqFmPmuADGAiSyqtxFFTvaqNNeOm8p7f6R_lufmUJwLMorwkG2F9XFQbnbo-rA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKisrcc7PYnpmTJeRm03q_5R2sT85VB6r_1QgyOSEcrcw&oe=6AAEB453"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZdAz8sifOUYQ7kNvwGWCl4H&_nc_oc=AdonXFSXdQpMHeDL-vR9eqvEXwhYsETeksNds9c1vta9tz3192jbnKIJc03ymB01AgI&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0nEg5mJ553_qJHbMJMfF1Wa6fT7FlVEXhCJQ3ZRSOCw&oe=6AAE9C10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn_DKVo9skcQ7kNvwGzDZZ0&_nc_oc=AdoiufhQypXWcewa1TWqqZj_rEnA38tVaAW41tjdtrd3S75XYnYbH28AYiJ9uxQSj5o&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJzZhBuryhdrzJgGyOq93XU1__3KuQ1_svmLdAR_APrJw&oe=6AAEA0A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.c
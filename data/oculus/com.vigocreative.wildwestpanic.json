ps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1y_0YcQ19IQ7kNvwGuxHHy&_nc_oc=AdqMLLKduUT6hLenXVkfIkyGaX0-QrTkZXFZSj7tpgkb4iS3wct41UDv2dDCnjhyJ2E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlE_mSJ1VDdMQAkcw0276C1M2CACJiXjt7lfnYGqkrgQ&oe=6AF3437F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BS2L7ttJuUQ7kNvwE-_3H_&_nc_oc=Adp1W5YQh-F2ul8OKlNEOXFu7EQOqqpLq57GDdH6463AP7PBVJQRdeL4o9PKOephduk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0vET_tKbqc098ot9Re-Cv_M15YyOAiwCLMG7york0VQ&oe=6AF33BFD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkHWmnFdOzoQ7kNvwFs1qBv&_nc_oc=Adp1BjYChmoGnOd1b03WsuW4O8uS3vRE3YYUzsQHtBV_U_VQKiH0rCbe9UNXopmntdQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTE4VO0tHd8iUuXQGDC5hmN5FgSfHg0CmfrjtuUZVgV4Q&oe=6AF34253"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6HjL_Lq4TAQ7kNvwEviN-D&_nc_oc=AdqOG7qewXvzcH77d03n8bnvaNpE_JYnhNFZIa110ex8ZJQmxhToNkMsZAixKH3o3Fo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHrVAWIR6814mdWpwiMKPr4zzUsZT5HGdD-Tapm7hpJQ&oe=6AF32A10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_uKxaIVN2IQ7kNvwFEMaaA&_nc_oc=Ado1u-aixFYd9_ZINhyFqmH5CUgMgnP-D7_o2mcSBrjt_mIgf-23SxQe0yBQjXUEPV8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSqj2tisXiqK44vbLBlAtr6kA8el30IH0D8UiFK9b7A0g&oe=6AF32EA6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
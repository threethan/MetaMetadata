ps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baVl9pp392cQ7kNvwGmieQF&_nc_oc=Adrr05YXtam9xw6X_NUI-Qk-itITHffcY156YYu8McDmSOVqtaryYX9bCYa4Sm7zZ38&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOmUAkhBI_jSWrus6zAYr9cGlbIQ8eUQqkzMuCajCraKQ&oe=6ADDF33F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qrrn8WK0x7AQ7kNvwHYMmcl&_nc_oc=AdrX8spHD-i4MOPyerLK2e-H6zzU7CdZxQYxAixKPuQEyn51ho56wmaPbvTkzAnZQ5g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTg-lSYIJu7dV7G9EZ9uME7KgYvjseqlc48SnCGa4K-Q&oe=6ADE23FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RVziitpfaYQ7kNvwGzv-E9&_nc_oc=AdoioRGuAmOU4mkZTTbxInku9Noq45nfQ44cI7BUbXnbwVjUv1DZtn5ZERJdQIwFBuU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbeCMEAHEmD0tEj1sKRJBIZID78qkDx65iMwsM6XbcEg&oe=6ADDF213"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJbaRp8sRLkQ7kNvwGPfwDy&_nc_oc=AdqGmMVpeRJICcbgDqSrkyPOMA-_Xev2rs7QHSI67GHdg7CP9Q63o2G4uyAVxJZvp2Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOogwKQNN9uF-jQ6W9VaQTz217z1mBUZ0-4By4FkpSOuQ&oe=6ADE1210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktldZ5nj7GcQ7kNvwGiGbEJ&_nc_oc=Adp_X_wrEdROPEEVqR4i7-Q7vBZsq7wVJqOQnvhmmptHaOA2cvpIOkhm77ZqsMNEn3o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNf43VXDsSxDSu2mrNq6a4vAdFm64Vnmi68bAaSrqtWTQ&oe=6ADE16A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
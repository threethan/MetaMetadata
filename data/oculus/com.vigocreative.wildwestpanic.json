ps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8EptgtvRisQ7kNvwHzNq4J&_nc_oc=AdokX2-0g53hUenOnVrCwudzTjcnGFEU6qvQf8YkOQsVreTA-UxafwmZhWJfTFnvzl0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKXhkQZIBEY5AdLzovTVdI9BYAgPjhNnvvJQ5Z0GmxBXA&oe=6A9FFCBF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n79LxI9yASMQ7kNvwFP38Id&_nc_oc=Adox3YXG3MKKn4xAPQlbr1yMVwccYDl3CtT6v3rOwnXQ99Dr_ywocRz74D5ymWq8yh0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVE5VR-54ABLHZsFD8CXwIywqJZBcH7OFH6Rgvl7bZEA&oe=6AA02D7D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGjaUH--mDIQ7kNvwFmSG6V&_nc_oc=Adom-W78dOdLyGwENyGiLy6I8Trf8QYv_1nKfxVo9jRQo_xjqUz0v5FX9g53JM2IZxg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJldXu8ACW_oawNhXy-MRR0IK4WUVIVIsDbz8UXDXu2LQ&oe=6A9FFB93"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qP48NDPIrgQ7kNvwGBBG4-&_nc_oc=AdpqaiJdBVe85Uo68lGn60Cw3H-_mOpB4rZ3C8n-oE_SXTYscPGGMXjzuIhzFm3XEFs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnYqYcagJWdpZuNR2wbzgEzdM1Gzp4YXc4D87dzrlvFQ&oe=6AA01B90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjSz64BEa3EQ7kNvwFE-ij7&_nc_oc=Adq8oWnAYkCbWoMZ4Tb8EPeGWehHT2bFY02_mH26uNipdeKZ-fwkaY8BBCgiUPbVnGY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKcuFtnRPH4EW29WYu3Vt0xXAdSwqc0Qvu6jMyyYZWFpA&oe=6AA02026"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A_tQp7EJA8Q7kNvwGNuBtP&_nc_oc=AdoIK-14EghYkiA1_Bu9zqtRdkAYDnKf9p6AE4vwBhJiCymnXwXmj-7pwu8N8l7nmG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO3M0xDIJBWHiPLWrzvuspBG2uk6WPS3Q2aGwb4bVavvg&oe=6ACBB67F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNpNidB_gFQQ7kNvwFGIXBB&_nc_oc=AdoTtMeV5_WLzcU9e5gP8AOgplW1CtlfB9alGRGKEUK-gjJvy3jLkpt7Ev_uoYTyLo8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMDIoNgh7hCnVJ-8kbtXBCyqrYjW3I0UJti9JX5LHXvfg&oe=6ACBAEFD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug4BrOhGvOUQ7kNvwEk9Jxr&_nc_oc=AdrK6bMpNH0jJJhITs9cg6JPhIrHd8gRssr6oM6GbZnIPohSFsZMDcL74x0Me3skxhM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDK_8IqQKjE8yHsVexZCTlXxgTbyuNMruHt9xIJ48R0w&oe=6ACBB553"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7c2CIIjk3kQ7kNvwEQ9kHh&_nc_oc=AdpgZGEaLed8WfNymKK0RKHJO5kqvwHZSgseAwaG0kVBtbhiGaYSPnkCuwuYsZ8qFxU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2SE0p8sZxcEgYpe77X4vjlvkWr1F4W2Ox_poKm8GLTw&oe=6ACB9D10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSuUEQOIh2YQ7kNvwGi2vpc&_nc_oc=Ado-MywHgWflFq-oWjIYU5W8oj7SwaHG_CCelJXEJXGoXXrdxIZWzQmZi0Agzfm8GlY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzb9TwKiqalxx1EZ08n9GSA4bLCbC280TkU85xeq3O6A&oe=6ACBA1A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
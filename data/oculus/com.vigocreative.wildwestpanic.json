ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApkxBqLH_8IQ7kNvwEXLyx_&_nc_oc=AdrEsxNyoXCQyUFXyKl4nxKg-lGJNHSTGsJTpRv-lxcn8SycuveqDbGGOGYo1MfvHcQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJAiOrypzV87h6HVabz1tuI9vsNsUUtn7f3iNaY4hBPuQ&oe=6AB7EFFF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKf7hWANQ40Q7kNvwEFXW5d&_nc_oc=Adp2Zy28TNlekP-Nbv5zFk_SmogA7zQlatTSROgl4lnzLYHQIyEpr_w6KgqAoXZn6IQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKVW40A1099HCHqCAFlDE_F_OYRhpuylYfnFwX-y--l3w&oe=6AB7E87D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP-TkLdXnDIQ7kNvwHtYSuz&_nc_oc=AdoyUiU3Rntmd_CgxvgzNERkjJU-9jKy3GyRpbBUaNIjjGA4WI7cxw_O72dhNIKfGUA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQmH0wt4Fw8wPzWAHXhju-8ljGkHLeT8yd7f3G6rmccQ&oe=6AB7EED3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2J3A_b1hVoQ7kNvwGlVe-I&_nc_oc=Adq2Jf48siRG-C_RzTm1kBmQeW8xM41Xo_1ImYTDQg59yIXNCQwc8KpVJ3ogHoIgN3w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLo_e8YSxMsxYKApKmyZETjMb4L_95g6K_N4-YaH_0NIg&oe=6AB7D690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1fKTQa4ZlsQ7kNvwGL73rT&_nc_oc=AdokSNly3C-88bvssx-mamlH-ovBhLliCLN5qX7pTu7Uf_whhh_rfQYQaTuOXIeL-BA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpMEP-GYncIWbKpnJyiMm2gQ1Vq29_Z49UcaehrUd8hA&oe=6AB7DB26"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
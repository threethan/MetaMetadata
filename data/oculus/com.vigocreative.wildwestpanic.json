ps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRTHNe-6WskQ7kNvwHfNgW3&_nc_oc=Adoyc-OJSjMQruxHyh3yRSaDqm7nfLyNIZa_MYaSQ1fZ43kCa173MBVMZgMAozJjOr0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBj2Ygjr0oAIx-VSWccwFzprpGswPbFAeMQU4YpxPleA&oe=6A902ABF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeSFsDk8QkQQ7kNvwF-BBGS&_nc_oc=AdpLWZx99Zv4nTkO9SuLjW355HyDdDoflHIms09rj-I4nMM-I_irLUItOAy2upBdiN0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzA5aCcXJp8HLO-Hly5Wh9wTvO8PjJ3CWJC3GrAfBDBw&oe=6A90233D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVduqRaAohIQ7kNvwE_Puvo&_nc_oc=AdpPEF9Yw4zr39amf6nSxS6LbAPjwk-eXdAiBL2s-0EjuDH1a0ge46WLC9uXMifCNKY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFrsj38QOAfrjpx8HuFT71iOoAmBppXYCIEdkRpxSEnhw&oe=6A902993"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3WCgScUWlAQ7kNvwEnZcA-&_nc_oc=AdoAcOdIJQhcgRmeT2l-YEdm3WuNpZXx4yv0YITYHvEQjX4v02Argr5HtFb6w9BjuI4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJPvEpm8ChxBAaVvxalyI5DewFZ56iyd4UVNu_z8VOFg&oe=6A901150"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mnge4SgDBwMQ7kNvwGsj161&_nc_oc=AdpwEpxNawnEKF2D_dMPqNeRKPWKlAg3mcBzYQJIwOXDPY15UOIEY67yaxqt_pCDa9c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFYCi4XePOZdD6G1lhFbG8dG83Voi4u7g9fA0QUJG6pdQ&oe=6A9015E6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
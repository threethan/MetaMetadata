ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRndK63KiycQ7kNvwGlS1ay&_nc_oc=AdpF3qgEDnuVdRBcFpDMUUPFvzW2VPTywRkbKWVYXCT70_-pRlRqTTX28gDBel9iZes&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHV9ha1wHqCxYvW6Ngak_x36xWmLfUBk9Dt5iOx9BCDw&oe=6AE48ABF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSFoz0m42dYQ7kNvwF5v9dW&_nc_oc=AdqjdhcZ7MBQa2U0vq9hsZvoP_-E220c2VoDg63XtFWpr6XK8FTsD61BsjaxZmlTMO4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO8cCsLBrOFhM55LP-fDDTzNN7Ns6-p4OwPpxMx_k_Izg&oe=6AE4BB7D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xNBgeCj5dLQQ7kNvwHnJkZ8&_nc_oc=AdrwtDsWyzS8CB_5O4nSz-5x_I3luh7XIWnCSSD9tCooKlVt9j8-jlyxKyo1SUxJ3m8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgpBEL2FPrdUM82fIgVqFKx_8c8e8yC5US0-CvRnDDbA&oe=6AE4C1D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOH2228f-1oQ7kNvwHbY7PY&_nc_oc=AdpJ4a4DBEMaPhxTyOvkJG5_rWnGhdLNa4v8mcAMSKSOqZ8vHMbIz3AnM5TIvJ371eg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgehyl1osqr75clCTOYwckUnGXILiIMIKroQko3rP6mA&oe=6AE4A990"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G_TL_-8VmMQ7kNvwHQs0lz&_nc_oc=AdroHY9kXXzVioPJIfjkMvJLMokgpouZppYAErVb-UZxAIaD_WUWISyIZF8cEq4pjm0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8MHmEUccJAq_D9g215U68xYbh3fvsT6bW5KrYcvv_Fg&oe=6AE4AE26"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
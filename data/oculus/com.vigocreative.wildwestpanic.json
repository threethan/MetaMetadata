ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_1DR4tDk754Q7kNvwHbi5id&_nc_oc=AdrqfYT2fumtWjVGlN3HfLuMIVYJatmY1_MXxkWHypRHydFX1WrbY8ivYGwY8oRSvY8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzafj1H97HWV7UBH1TT6uxXY3OpR4ohq52i4T9DbpPFg&oe=6AF737FF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPVveMedE4EQ7kNvwHpoTQo&_nc_oc=AdrJaXOqnJNRkpEwPU32HMA1iZX19DfwHxrIVjCDeFdDhVn_qdCjd0CTWIFb16FsIvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQR5-8MreWNI857SMUwtLbeSNNhZpeGzB22rtY4C6LKQ&oe=6AF7307D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkHWmnFdOzoQ7kNvwG0xxze&_nc_oc=AdrySVCoDUnGPYEt7L193Ms-_RFLMJ-cNygQ5pi3jn7GPX1yjgLG9jtnC-VLTEH08jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTzuWfPDL-3JBUrn3qyXzhGXRpTuV2WwaQ-CQZt-u4VTg&oe=6AF736D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-tUwvLcSB0Q7kNvwFFu1im&_nc_oc=Adrs1w2ITBRnKtzuF68nrOKo2VVeCe_JTvtYmzi-_sXXjSNlFTREX7ImMARcoaPyllc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQ8CQudl1TCetGhnr1gDcUxTlVXYTEXAbL1msHFUxbfA&oe=6AF71E90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f53TnzMRpCIQ7kNvwFQlyVE&_nc_oc=Adqso8hqhL8lDc4hrDT3mwXhSgzOgeLWW1Kl9WDtvObu9RImPWgg9wpsVkfEFx-YDPE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8OSEA4ps2TvxZvGd9rtdfIMdq7HdH9SyEHPfWfyT5Hw&oe=6AF72326"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
lYGsW_QyVEHupLetfFCxZRkVDJCqXvKkXQ&oe=6AB1587F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1ffrBhgul0Q7kNvwEva0Sc&_nc_oc=AdrBGzLT1JzAm6AuTJM-QZm_SnYCSujFbx6aE047OVGGPENLzhWLunt8epEpOfQhGT0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9NXztdIKV_VsRbRLl5e9Q8JoIUIbQtnNzxxtHFO_pdA&oe=6AB150FD"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "1023554306810317", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825563_1023554313476983_7659786202526969718_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kFDvPDrrRDQQ7kNvwFA5QJO&_nc_oc=AdpcktusLxdY-st_T1UykUlNOougvGJcr_Up34vy0rA6lHEVtg_nv6oMhGTkSNvGkg8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYWmNN_Yuyjkj7wEoL67zOw2lpa93AZobXXRyIrHpYww&oe=6AB12726"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cn_DKVo9skcQ7kNvwFbsk6P&_nc_oc=Ado69N2dpFkl5q6T3cQrNcoRdwmVo975I7opFsavxc1jN650dwhSDKYLVBRciEwKA3A&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn4kCZMHIt44iOKBZxe882919MyhehGsjKHp0479ilqQ&oe=6AB143A6"}, "display_name": "Wild West Panic - Early Access", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "**Wild West Panic** is a hyper-casual VR arcade shooter inspired by classic Wild West shooting galleries. Hunt bounties, earn cash, and beat your high score!\n\n\ud83d\udc49 Join our Discord to get the latest news and chat in the saloon https://discord.gg/APqtpRwyX7 \n\n{2223173828460337}\n\n# Main Gameplay Elements :\n\n- **Ever-changing levels** : Missions rotate regularly, offering fresh locations, challenges, and replayability.\n{1691469755605115}\n\n- **Pick up & play :** Jump straight into the action with intuitive gameplay that's easy to learn and rewarding to master.\n{1323109135980384}\n\n- **Shooting-gallery feel :** Shoot wooden targets, avoid innocent civilians, and improve your accuracy.\n{2767208070326014}\n\n- **Bosses with a twist :** Every bounty target has its own unique mechanics. Observe their patterns, understand their behavior, and find the best strategy to bring them down.\n{2189658808525654}\n\n- **Challenge yourself :** Climb the online leaderboard, unlock 45 achievements, improve your score, and discover new strategies.\n\n- **Risk & reward scoring:** Every shot counts. Precision increases your rewards, while mistakes reduce your bounty.\n\n{2210337659506582}\n\n**Coming during Early Access :** \n- Character customization\n- Bank to store rewards\n- New buildings\n- New levels and seasonal events\n- New bosses and characters\n- More achievements and challenges", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf", "developer_terms_of_service_url": null, "publisher_name": "Vigo Creative", "support_website_url": null, "website_url": "https://vigo-creative.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommende
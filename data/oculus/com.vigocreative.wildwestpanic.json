ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8EptgtvRisQ7kNvwEChPoQ&_nc_oc=AdqD6RHJk8eXjs6hDhGyt4lkVrDIoMyzSkHraGh2BiJ7KYlGxxMT1okf0kNaD3mdnlY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-MGnBcQX5gG3cvojUY5mSLNbe8g3LnPaExnSRDATzOg&oe=6AA29FBF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_CBjGRyCDoQ7kNvwEMQt5q&_nc_oc=AdptDSoq7hUm8o62wzCaTHVFDfEdEkk7LY6Gmq5mNDKR8j5DvaAPiZ-VQ538AP28N6Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL728CCpv4tdR5uS0BF-mkfbuaenruC1kIQ3JheAa0xUQ&oe=6AA2D07D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXvPsaE5L-MQ7kNvwH1OLlo&_nc_oc=Adp8umJQ3v1Sb7XzD-sRVofxbYzH24n2Q5W_6kmxlATB_goZwkDZ4Jbvq5IHhxuxA14&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7goo8NlkxXQuKuk4ljiW586Oa95UGYdRjpPslZx96og&oe=6AA29E93"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9tM71oNjtgQ7kNvwHe55Sy&_nc_oc=AdpyuV7trSKt9ksnjHMcwpTy6h03nNCcLxxRXeKh0nx9VpUFTvUqPzpW0m_Ob5TXCbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6MekZoTv0eQ4-EF8bBeacx9vDFq0jeyxy6ADD4upVQw&oe=6AA2BE90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG7flTgrEZQQ7kNvwF6YStO&_nc_oc=Ado3RbUXAQsbroCyC64GmD8Aze7oFogjTpnZ1Fi9LkNn47Xe6BCFS71H06HI-cegJO8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCq3ILzGyfRk6SD8E_tmn4GUbxGmZJPILAXFYcCmvfLg&oe=6AA2C326"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8b2Rz5ntMS0Q7kNvwGjEyT9&_nc_oc=Adq9s_Jxi7FtERKIvMLLwzuKbBu5CzLwINN6_RTEI62LAOmaDfpEhQe6uYGrVwYO-YA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQt5RGf7RDdPqnSuW0cT1fVQVZ2SJwPM8C5z8QBkXesQ&oe=6A9EAB3F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n79LxI9yASMQ7kNvwGagE8I&_nc_oc=Adr-4z55DxpypYOJoywv7lvgDZ9mp_PrRiWPgHOOAXRuJ70C6yXp0miS47i7qSEYBZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKyJxnCuGfdG2Fu3AUPYx4_fzqz4mZrH6GLNLoOiJqmWA&oe=6A9EDBFD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGjaUH--mDIQ7kNvwFXGO_W&_nc_oc=Ado1626pmlaV3Ij8ZAaJrJ2ZKof7GICho7ihagiQfeRHX6MgPmxFh8JrgWiuwdOEi3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI4yxjiDIJvI4l_S9ZegbD6vVFzy7trgJh4nksS1EP8Zw&oe=6A9EAA13"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qP48NDPIrgQ7kNvwE1w28s&_nc_oc=Adr4nEJEbPmm5h0BTRZfVB36S8ySbTqtrDwHxN9KfR_bFmx86cRmClOThu3sA0UdIlU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRHyvKVpGWFaDkbNm9UNn6W4VkZKpsKaICvWWLXqE47w&oe=6A9ECA10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjSz64BEa3EQ7kNvwFis0Qv&_nc_oc=AdqM-aASlP_SFeRiKOnbdNFeWzYBN5Bgvtv_B5UcxPjfitEVfvmdj2ICrxh14AYK2VI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ0d2koYqc4-P10o3089Et5esTq1fxQjT3Y4b-wM_E_fQ&oe=6A9ECEA6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
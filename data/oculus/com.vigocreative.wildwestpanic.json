ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L_mNUSX0P0Q7kNvwE-Wc93&_nc_oc=Adr4kgegmxRlLublZFvwFQmlNxLpIzXA8RizfALjLvp3YTY5MjLRJB5E9gmGV_fr9lA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3ygDFeVp-d9QsTJagviW9zHhE7dgz3sYIqpMA6aWuww&oe=6AD24DFF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20JiJCPl1nsQ7kNvwEMlLeO&_nc_oc=AdpOOsWFLqHoopFNDoJJNZsATw5zEeNaGlmzE44EhL9oWaN4Q8zKplSijmIkJ0ae3H0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQON-AZ7LI9ItOFyQtYuQWSuBwwqwRk-r1G5BenxbnG7Xw&oe=6AD2467D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EpdIyosvw4Q7kNvwFUXknt&_nc_oc=AdpuuQX_XccpXuZRz2wKLsG_coOrfKOpjdEoKKrWNmk9Io4cxXxZW7MtbDMzWy03jCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOiUlRUG9eeaJWTXAq6brb3R1mITuxdNtUZhfrGMB4Pbw&oe=6AD24CD3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxBXYc78xbMQ7kNvwEYoTtE&_nc_oc=Ado6l7g-bjYhGDKQit3tIOxqj39V1aRuyRLFU5dFw5XG5TPJxVTxVjvleW_RGjCrl3I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPVFyBd4Do0Xz7XWcYbXQ4N1zT1L6S9O361dM0PM6x3Xw&oe=6AD23490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oo648QSp23wQ7kNvwEe8bzV&_nc_oc=AdpVhICB18hsNzqb0wtW5HpFewPre8-5Y2ZmYvis2PPg2MW_KPTBJA72-WGuZ0KouLE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxmhwgQVUy3pLr-10pH1KdCbbVLZxj3lm0PRwJ6qzN8g&oe=6AD23926"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
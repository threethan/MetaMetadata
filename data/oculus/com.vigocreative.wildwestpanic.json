ps://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sLOKOW6T9rIQ7kNvwHEh8A5&_nc_oc=Ado5EgMn3rcigPEWuRovYfG0EFx0nHJVcX77G3miKCRgZjsoTZJBITh4R9q53oX27lA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMrHnUJoxEmIvLvSQVrRLnYuZVCP-RuHRCtd2qEdmS4WQ&oe=6AD39F7F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20JiJCPl1nsQ7kNvwEIxIeR&_nc_oc=AdrZB-4obzmz5YI8WgSnIgefKjCNnhu2ht2IFqZAKIQ5LJIF0GG8EGfMPezhLOgxC3g&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOMk2zyqrIWPd6lB59JwfJcbA65BWtF6wLgeQIPBK1WkA&oe=6AD397FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyZq1bxG-ugQ7kNvwHXP8X1&_nc_oc=AdqdhDQSVALStk1IW2T2d7weSYdOantbusu458ftxujhix1wG61QB-Fs9CSc0Xmq1Bc&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPn9CCNTp76gs1xWjrZ5-phQzZtpDfLuizLiI4bimurBw&oe=6AD39E53"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxBXYc78xbMQ7kNvwFgL5vl&_nc_oc=AdqSSqr_ny6LYcyQQE2RvYJqxbnASLUKWAIlA4vm6ImTr0XBZD_3BX4R_hely6tPQcU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNpP84e13X-j__uDN0GsWJcNogCf56Xjl362oFBN6jaAQ&oe=6AD38610"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oo648QSp23wQ7kNvwEXeTpg&_nc_oc=Adpy__4cVYpEO2IOGM810oOWY6s7CVz7ZE8JxJ33DzMbWEnoKwHShHFSkFeasCQ23Rs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHLyUR7sXfiHjRBhPXqjxxx4hx0KoXdAdBTc9Mm8Onpg&oe=6AD38AA6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
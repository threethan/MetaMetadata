ps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8EptgtvRisQ7kNvwGgZP2b&_nc_oc=AdriBrQuciD15xhSYk0bpeI9bfDxkmXlWNBapZHfeyYQIBAk9oivqksmLkHeg_K1NKc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI7mjHCKG2BsLkl3JNJ9yG1GXW5NwQxycdvrOjLkqgGbw&oe=6AA14E3F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_CBjGRyCDoQ7kNvwHPQIEC&_nc_oc=Adpf_AsW3b1Slw4NXCgou0nSuxi3jJIO-79FTOv00tHFRndnXtaFvihdhG_PEb7awG0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC5WfUOe4xkAwAI6QZJUpbF7PsxhedjTht6CvSlCVdJQ&oe=6AA17EFD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXvPsaE5L-MQ7kNvwFaR3e-&_nc_oc=AdpWgq6QLXnN7OuOGKMRJyIAS0z9cjb26vdiesSgCMr6Zn7zx6qe4iq3YW946hetft0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDLQsN-lFGmA5nIZWaq7LxVEA9RFZJ8Ch4rHFZUu1cQA&oe=6AA14D13"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9tM71oNjtgQ7kNvwGI_KMH&_nc_oc=AdqUVsby57TssXfF9h-d6x3eSHF8xOF0j4xsrZ-U6awZPXZBuOL-4XUXhWsiiMZijag&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjUvPHYEgNpjDqJQ5Wn_cptOPF_tavFjr-XOqGq8JKhg&oe=6AA16D10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UjSz64BEa3EQ7kNvwFQLaUE&_nc_oc=AdrWj-cmabALmhJZfvHMrokZSSVgSvXJSZAyiiEGoDORKApRQXpeJHSdb1Qgmsjp63U&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIXz8in3_DSwH2uYYHnfmSBJ-5id86UWzw32yMUKG2R0w&oe=6AA171A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApkxBqLH_8IQ7kNvwHjXIrn&_nc_oc=AdpowDQv89qrsZILbj-572RJf5F0NFf2K1pwX5H_8F8kUNIsExuxygIIC_i27l93sWw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTyjwEmoXRsZiJewyZrn04zPoI9ujH6pupjQOhKIpVRw&oe=6AB9093F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TzxFcj4fLTgQ7kNvwEeSCH-&_nc_oc=Adp4ZijW_TqDlru3gysixUhOj7hK7knZHOTGcDT72D8JS_8l-xwqKh-nR7vRhVfIzaE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk5I1kUEr4G1t2tk99Hed8w-KepKenxp1uRcJ6LkC2-w&oe=6AB939FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gV6Gu7584dEQ7kNvwHAznGc&_nc_oc=AdrzjNx7VNgsHUR_QrRJAjT63hp9VHZ-LJjzHOwQ-nSbpxDEyR7zkrUaW6TWmidlTJs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIc1vn3C0-Wknl9BndEwF8-5WrF41-3WbeS2up3c1LSow&oe=6AB90813"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mTjfunyBfisQ7kNvwGuekMx&_nc_oc=AdqD7J8jOz6jHN4yYZJNMqdbOWGt364MWmRvJvQO74e4ZwaNOKb8AskWPfQ7DpaTXIE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJox1rrj4B5Zjd9fzETNDzF3KZBPYxxwkh4wTIsfInREA&oe=6AB92810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B1fKTQa4ZlsQ7kNvwG9Fl6q&_nc_oc=AdokX29P3cFHfTb-3aQOI8UeBF3un0D75zN1Ke-03C4qaqzaXd77hhNbgZCVDVLHRAU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIN73tGJfGTzEbf36tA5-dpjFMRk0T9Z1kxKxmiE8GLfw&oe=6AB92CA6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
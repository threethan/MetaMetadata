ps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKcyCvw9W9gQ7kNvwEylmUA&_nc_oc=AdogDMy2lrpK3oPBkZWM-jnoKhli-E4WtGLT_3OLNQm9nJzQ1YhETNk2YmWhcj0lW-8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRH4IDrtL_eCLkL09_A9qZgKulRs_-CpsLwZgZxc7X0w&oe=6AB271BF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1ffrBhgul0Q7kNvwG40n7c&_nc_oc=AdpwgjT9RQ4DA-ickOgubvMN7tBqrU0iag339i8QJzhFrSvuPtx5SL7SeKaU8jBwMos&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLQKoyUDSsLRNw6AUEC2v1Ym909DnuCxJj1Wrntko713w&oe=6AB2A27D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZd3KU9-wRcQ7kNvwEozMvk&_nc_oc=Adq72e1O4gV3Cm6jzNamWk99TMVu63tOIsapSJlak8hMPxDCDgwlrsgwdnDQTVKRPI0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLlb9kJWau6kwwyhwOpygQy67Q8eoys_l2gbQhE2QpY3Q&oe=6AB2A8D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6imgqG59HQQ7kNvwFcXhPW&_nc_oc=Adou8iWk9nn--EDiGstOAYAz_11-E-RTukm2GzKDdHJLk5s3gVzhfvvlgM6VWNBZSyo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLC_u9VhSU6kp2srvapD4lfvBWLdaM1ALSLsmqgGHWbjw&oe=6AB29090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-6hat61D4EQ7kNvwF-4W0L&_nc_oc=AdpgB87_PTOHrpu6kpvyalsrPG8iU06xHUQ1PKW5ZoZD0U1tLp3izeNyfYeyEIg2_yo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1lXxgin99D1Nqum5MsEbAv4-hAJGwv15xOMtYJhmiVw&oe=6AB29526"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
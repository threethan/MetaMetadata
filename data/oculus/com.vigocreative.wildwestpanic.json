ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqc2ZEVapmcQ7kNvwGgs4LY&_nc_oc=Adrl6p42xH80H14Jq6If6XgotjsmX6og1dl4TRrVwezUiR2019NXJAx3DIPNYZVUIS8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKe3x1ki_s1CtGOcH5v12SUnCmh6o-8na1BZ_JRnacPdQ&oe=6AAA88BF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J51glvIUvaQQ7kNvwFIPvNA&_nc_oc=AdqP49wr9Rnb8zq64Nkn4FISIk5L5683OJ2GzXWHnFMVeYrIrZnHDPov5zO9ie4TciM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKGxV0xXEEvbozMKXaevlt_6kcnCHnajsgDJNNfvrmV0Q&oe=6AAAB97D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8zKbUtYxig4Q7kNvwEx5Dvq&_nc_oc=AdqkCu--NpdL2NOzcpvAJN12uaRJflehQgW1_kEC3N3HQcyfdGLPhrsPui5Bvf2ek1o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL0YrZxUrhGuGsSIYeEZGlvkOpE8O7H6TG4qxuxOv0MoA&oe=6AAA8793"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7oJ_v7tHne4Q7kNvwFVJBjp&_nc_oc=AdpIOo0PvaPEfl6XROdG1vAlrrHVimNXM6-yrWZ78GlgCkcdNk-y6YJNNLo6BGTQCQQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJIvOw4dePs_aq_I15HaAi2edJFfSnGM3UXa2rX5rHZmw&oe=6AAAA790"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u23L-U8mmv0Q7kNvwFAaEGX&_nc_oc=Adpmdy8rJsZ8koGCGlVzOZaDptim4wzjmv-auBUik0f8ojazVyS1L39BaF-ypE4jSvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9E6go98XnjN29bI8D5-6eFFDpgPC2UTzA0fIrsbpAqA&oe=6AAAAC26"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
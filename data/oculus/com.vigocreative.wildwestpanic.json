ps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRTHNe-6WskQ7kNvwEG9Bb4&_nc_oc=AdrCAHdy1sKeP5-DMF_syyJIOGSyBrRVtiNJ2Rec_NN3QxoYsPNBv3WxM-GQJei9wQQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0a1pGJwjUPSPudQCLyOITWjiNNQGq_ud4dBJtoZx6kg&oe=6A92CDBF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qydg0SRjk_wQ7kNvwGzNXKF&_nc_oc=AdroTFR8pa1Ze_l0cXRqru-gsegjCdSONkfz-6VR2O2tqW0V-_-7a74KUa3AVLpZEq8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFhP4qoPy97RfefqQzKLRTnO-OyxqSgwRFOuj1_5ZZ5iA&oe=6A92C63D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juzE7WOkK7QQ7kNvwEUAcqY&_nc_oc=AdpJwS43zTyER2UYJBTMkZV-h4G8Jhl0HYxTux3SjrHMWA4SHXYkTenklgrvMOo-BTg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwAAtJTx8_pLzVv9aNO673HelzLJUjRdUoQ7Q-XsAhOg&oe=6A92CC93"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZa2JPWR4H4Q7kNvwGwFQGE&_nc_oc=Ado7D5i6erRklA4uRM70cam4TaIur7UAMvpYnSPAvt8eUcmf_bSuAzIiqq7WGJIlgnQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfKK2aIqw3b767tJpvEqOlmCowCQrErdwpE2IVF5MeIg&oe=6A92B450"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yOfhUCeZTIQ7kNvwE_XEYC&_nc_oc=Adr-lWN_fnhE99RHWk_sOVQ5JHUsflOLfUdR9zYVSdwFsiNrKaZOGdhKS63psp8sSAQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFS_njlHYCouBqPVmuNz1wiWtOD6WD5r_Ic1-ZERf3pVA&oe=6A92B8E6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
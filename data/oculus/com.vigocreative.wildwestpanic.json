ps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjChoUhkgDAQ7kNvwFHlE1l&_nc_oc=AdrV9CnS2GLOL1rnJjnh-42O5ZYOC3N1yI2g3ggd4eyk180thrdMi17KQvT7MDAd7S4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkRmNmnnzAr3SUHtbsRIeav5MNPxUVXnCN1hl7lF51Mw&oe=6ABE877F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoaRxi9tOJMQ7kNvwGi7_ej&_nc_oc=AdolRg2XXsg3IDYz2i477jZIou5RRG54EbC6xzPedA4nhSr0XavLLzovwwWqALlw7BI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMaZaiYdcjLM2l6bSKpVf9ITUqvN9Yq-IFpyodbHRMRg&oe=6ABE7FFD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxaKTep9H8QQ7kNvwGwDpEt&_nc_oc=AdrkS9ZR8IK5ZiL-c4vgvdcxNfUZtUrfqDEYXACyzbZyodNtrRJk6y0OohO6PbNshSk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLL2CkYX6yJRMbw3gk86kW0v9iVHOvmWCVD73US3Gqdxw&oe=6ABE8653"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT_Vr4S-yEgQ7kNvwEr-JeH&_nc_oc=AdpzvPXR3-dPKirxreBj8Zi1YwAJqZX8cQsAUbBWOdC7epwY9DEUf2qVeC6_Uxy-cdk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTRft0L9urpGZZnYbJAbdP0W3MG5NJ7Tvk6Ql2JdxvMQ&oe=6ABE6E10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXkzdp18LF8Q7kNvwFOvM5V&_nc_oc=AdozkRmQFSgkvFMQ86hudQPj8qbTMe1Bu6vNsWsXSRIOkkAFoVcqJKh-nvpx9h8dDEc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWj6jpWIa78DaRnGOsH8vW5Gqj1I5ZdRmtqqoerGGKjQ&oe=6ABE72A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
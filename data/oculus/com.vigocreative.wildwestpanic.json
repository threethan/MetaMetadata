ps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4A_tQp7EJA8Q7kNvwG-VfG0&_nc_oc=Adp_Xqj-F1oZ9b5IA12HrHdBLgjxA6JaE6GJpm-0krateboVMXVVMQcJbW2GfQq6kpI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNjsc8652rxt-luaMPzMx2GVVjZ3ifeHFFCsConxu-wA&oe=6ACD07FF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SrcFB16fYsYQ7kNvwGWUbwE&_nc_oc=AdqBFw8hX0CjavY8ih20iuQQwo2WiFuJiCfWKy3vS2pUA1leGFEsOcKBkq88jTzMtrA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM8mGbVb1UO2QxR_iw6plBfYpbH8rvZQmiK1fOVvzUKxQ&oe=6ACD007D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oEiiFhsaGecQ7kNvwGjIWoP&_nc_oc=AdpDzDHreqjK127yKYeuwi8mYrA9xFx9ML-GxJDpFFi7oASMAnDG2j8t6Rr1f2_HiEw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO2PmneXwJMMrGLgk9XfI_oNgkcV88fzma2qoLhA0r9ig&oe=6ACD06D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-iQ4PnhaaC0Q7kNvwFcXKdg&_nc_oc=AdqhenHNGgVQFCpy1j3JbDg-wDhpbCky2zi6yT4mowi6u-u8MKuKUB0_-vaUhXvw-UQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmsIUMcAYMIGIQAqS4mkSTa_vxCnNTwmZQmieZmgEGdQ&oe=6ACCEE90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSuUEQOIh2YQ7kNvwGhZQrC&_nc_oc=AdrHPym163FO-iPUK3HNVDIhNY72b1LqKxnXrVCoAUs-MSX5Kg0jydDanZPqDKXe6PQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7Sl3QoNOsYxKNm38JjSNTvn64dU1A29A3HZ207U6rFg&oe=6ACCF326"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
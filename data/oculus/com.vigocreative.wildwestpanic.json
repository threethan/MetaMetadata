ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBBpCbuQXOMQ7kNvwHPXY22&_nc_oc=AdorfC4Yk1pDfRUO41as4lWjLBg-x0XR7m6QTuO08N1u5XV3k3g7B2ScgcGDOtIIx54&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGizZ0HkplXgMNg_dpDRZ9YHnYIrhZ8T-S1Cj7M__hMA&oe=6AEDFD7F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cM7pAgVnqAYQ7kNvwFUzEdh&_nc_oc=Ado_tsaT_kqu0nnZa7AkNkWzhouEQvZ1F65v0ahxDVwZFguKxqOCZXYhhedEu6GB_Ro&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsYq7QLJ6dAx-iT2aPSp2856nerZbGQFqoBtVrdOXAVQ&oe=6AEDF5FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEBUlR1aZ6cQ7kNvwHYazK0&_nc_oc=Ado4ow_RUqp3f_5eqvK-1kYxGOD1nc_h3auOX_zvxmDWmOHvvCxTI22TEbdn_-xM9XY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQkykimU2biJlmEaTBjLLTNB8DeHcl09FnL3Ap5MuW6bg&oe=6AEDFC53"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GGQ2BBpcaQQ7kNvwG6pE5q&_nc_oc=Adq3hJ86XP8Mx6YZMXhRM86NxTo6zT0ZjEfvqS4jYlFoJv547R_q2Sn7iReV7QxSlDA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQfX0Ng7awZRwhwCj648bfatFMV2Oz_a2n7BwTDiyk-DQ&oe=6AEDE410"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=njtNc1dL_IYQ7kNvwGKexUp&_nc_oc=AdotqRdE6s-FgpWE4lpMejEus498_toNJxz6HoqEPZwVzdqL2h5LMERLsAfIV0uWpKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4bPsg-FglhSgsJnmCcFsCDDMn8cDbJmB6-cYWbzfzcg&oe=6AEDE8A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
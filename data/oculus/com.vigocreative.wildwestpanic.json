ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj660byNM0AQ7kNvwFKfdsE&_nc_oc=AdoquXkLrwmEjZXwqmugbuLGyNrS62p_3vexpmRhmbqAUfQzxnm1OhlJJ0mCrLHcrNU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHUm7yNF6e--Y1qauOqjY5tToZBmWRKzN_-Kj7udYn2Ug&oe=6A95E13F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTQQSZWCg_MQ7kNvwHO8RlC&_nc_oc=AdoYET5zPJdF2sL6_DtYCFAC3uNSJrNWhDcjpNxUR3xzBX65dT9jEq9xuSix7Wjparc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEQh4Gqa5QUakD7EXP5oeX8TMNIUMEahtrZjTCu3EOoAA&oe=6A95D9BD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQNAJKQvtUUQ7kNvwFzDQ2k&_nc_oc=Adqp5HptE-NiwgG5H2YxmhvJ1ZpNus1jAZlJuJLqEmmzppigT_cfiTpmnAsSw8nYQFM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFa7eMAUIcdIng2ZAJKtJuhcyuOGKY6t1HxY8xZTHlZKQ&oe=6A95E013"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6lr2pUF59AQ7kNvwH5sDk4&_nc_oc=Ado8nc70XgRpiIBFChfcDoxNhEsrkldB-I2VWJYkK2z5XblizVeY19xpa3ucQ4bbX5c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHalKLS01P5Fyi9Ih8wuKgYSoP6Wwb3yXRuQTBk05h3zg&oe=6A95C7D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VVVUgz_6OQQ7kNvwG6H3nH&_nc_oc=AdpNnyxq7UdPUMtZQRzPjOIv1BYl8gZsNzO9fmjDu3RhcUcDBb31Iu1kfZEXhLxi3rc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEupBefLWNiedkPXCUSjbIT19OXBj6QEIQ9env227n83A&oe=6A95CC66"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
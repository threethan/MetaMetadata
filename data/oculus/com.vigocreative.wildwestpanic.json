ps://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj660byNM0AQ7kNvwGkv1gI&_nc_oc=Adrh_uM6EE0buCSABN1rf2hHSX2NP681dXaKdiyFuK-THGGDS7u3Ss0BxeSIk51PD_4&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVGX0u0aqhrJW1FEqFvtzJj7E1JPY-ee0QHeQ1STwNHg&oe=6A941F3F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qydg0SRjk_wQ7kNvwEoewNT&_nc_oc=AdqUUUWKvZyaN7tMtYi61isg7foJYnphckgSwgLA6U4F-BvsPR0yhB4fr_G5ZoOekeM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKQrgmQdukfsilF2SFbc9vBWPN2Hx1EmcfzNlGWwGUNA&oe=6A9417BD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juzE7WOkK7QQ7kNvwEtvYmH&_nc_oc=Ado-RFBrDBxxpoNGwkA8xvOGwhGBEQxkzGAQW-kTLjk7Y4-on3SBaQE2TODY8U-girE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHs_EKh3RWZGMC-wNTdoSbLjsI-hX32oU6I3IKuuleR-g&oe=6A941E13"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZa2JPWR4H4Q7kNvwHRaMqY&_nc_oc=AdohYWuaaSqDhty6tx1cOgsUPcMHLFucmhlabnmLRBmg7mSch3wI-LsqgvUtGrC0NuA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG5CXY72cZLti-Ok9kG8AaNvURcJ8hz2JH5W8Ti8-xhxw&oe=6A9405D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8yOfhUCeZTIQ7kNvwGpqp55&_nc_oc=AdrZ_RFoDLpkKexa5BMnr5ibnfkMZO4zBmuNUxf2lo6DO7s1iWXiR3MeRx0UBznUkQI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGATExAupDVszCwX9Lark9Qq3mgYO1VRG5UA6EJ1VqgTQ&oe=6A940A66"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
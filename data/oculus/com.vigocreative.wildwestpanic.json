ps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sgyK8LOI0oQ7kNvwGrk2Km&_nc_oc=AdoOc1gJO1rMsK0_nV9Hgkt5p0ISgS_gKBG9l1aWizKZ2Hr6N1CNw8qzs0CkPsSCWos&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOyTEyFGM6dVyOJElMJDI617DFLx162y-p-KXYgoHHPUw&oe=6AE1E7BF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYrPH03nEAIQ7kNvwEP3hyp&_nc_oc=Adon4XYBlBsR9tMCbs5kP-OIzf7vvhFzyoju_N_N1pbdxWu8RLA62ENhdgFWCnxPf8g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYGxe1PXGF2b_rjWrouzyL3sMxOu31YHM5PEtgcB0KrQ&oe=6AE2187D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFnGsXPpCBMQ7kNvwEvfqOq&_nc_oc=Adq-2UtjQXJhFSedJtgXpp1SqAiScSKUzRuaMe9L7bl2edjmdjONt9dObGgmH-jR2Yk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSktWv4_Ntzbd08ddvp_FLPo1xT3CcZCg_wjDVaH5_HA&oe=6AE1E693"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6CagUQCm80Q7kNvwHA1WKF&_nc_oc=Adq6cUQ6tlnw36KZfE0xNSuS3ZhsDsp9V6iTE0SQFQNwkfyJKvAUdFv1KlAuma_BUAg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlD8IdlIc6r3QZS015w0rzvqfD-MQ5oks2fAlrUDeYfg&oe=6AE20690"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G_TL_-8VmMQ7kNvwFcq3F5&_nc_oc=Ado6HYF7_C-D5MBC6-pLhBbAGwiqx0kpq9_v5ckZao_3b5Du06f6qzWrLowz58WREJs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMq9Px3bEeyjuLJxSTVyPXxaLPMg9G__zFTAjcGcCvRbg&oe=6AE20B26"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
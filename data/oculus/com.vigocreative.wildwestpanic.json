ps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2L_mNUSX0P0Q7kNvwFmbdfy&_nc_oc=Adqo26irkUkxCvgiSHsFEVR29KeKbJGYbR6WDYM9pPxDniL3Tynhsr1zaEvTXKSy9yE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP6OaStnDGj2ZtfzBNYqwAoKgUfOdR9OS6lwXxKACXMsA&oe=6AD0FC7F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=20JiJCPl1nsQ7kNvwEYY8fH&_nc_oc=AdpbQwgtYwh2X324HwshyEiJy7BPv_J_afqP_PFUCz9TbA9V8OxXuz_cvb2fxKME0WE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHQbKjNiH6qNzxLTmy9U_E3Sjs92HAwTMOwlmyJzh9hw&oe=6AD0F4FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EpdIyosvw4Q7kNvwHhBV4K&_nc_oc=AdoH6TvEJxYF6ea7H7nQelul04BCr46GmvB6ScqFrN7HD88ToKGz0lFW3aaflN1QO7Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_LtMNSf9i8bFFg5oxofxU3SON2JmEyBULhiulpZmBGA&oe=6AD0FB53"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YxBXYc78xbMQ7kNvwHznxhw&_nc_oc=Ado1EXPDzalk7Iw03TpVvwqf6KtkJOlH1haPMrEEpKr-NnCMV9hFYC_FEh1VInCa82c&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPfhZKdPcLX-VhxaXTZ818_-I-hkOO9s5m5Ea6kL_zF1w&oe=6AD0E310"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=thC7LSLSuCQQ7kNvwGYfCkT&_nc_oc=AdqBKWAIEuBnr4w6uJVGT1g9ZX_ms-21rNFscDQ5Pgjb-nY1v83f_UBzQ4h1bM3pTEg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM71KyebXHEgbCUYlau_7Mpd3OhlZKybMchpreiL_Z6Rg&oe=6AD0E7A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
ps://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qj660byNM0AQ7kNvwFXwlLN&_nc_oc=AdqsPyz5eTLcsAIcDeidHUTe57CQ5gDYCZoybrtQvO9ZPjDj8qsAd2Yl5UUGZ8XT1kE&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGGtQ6zDPgJuqb6YxdGGKu3GeKczo9dqDShlP1D8Mwj7Q&oe=6A9732BF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTQQSZWCg_MQ7kNvwFrlBT_&_nc_oc=AdpI-mQlycYooKHg_jNV2-ryPiLqL-xqvyk-vO_vWF-nf4n5vdwvbcA1lWI8QNJl1dE&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCKmPu2XHZ-T-iMh5mwj3VskxJJqS6ZjD6c4dObKuT9Q&oe=6A972B3D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mQNAJKQvtUUQ7kNvwHRkgyt&_nc_oc=Adry5zGeQC-o86xPnvhoZjf5r9k5n8fOt5qAlzXnE1OI7NRfzeT33286rV85MHwCMgQ&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7dwL0r9zDKKdyz4zdhDKs_G3D7NXxaU0dlaxxNvDazw&oe=6A973193"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6lr2pUF59AQ7kNvwHTd7WR&_nc_oc=AdqKhzQPK_0JPUH5xstNKtUp1eKr5Buk8S8wWTW8rRRCz3uRRpWs38oRZV-Eiyy55dY&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOFnMS4Uoh_Fcyd9L_2Wi45HUWil5WTe2lUI7gmxrH3Q&oe=6A975190"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VVVUgz_6OQQ7kNvwGfWLmh&_nc_oc=AdpSGhdstZ18-ojK1GVy9Id6UTUylqzqenb6SM53_GjycX4VOU1UJUD3mh22cW1CeC0&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7JoPWoZ3SYaILVercGCYN1m9A5E794qxZQziw_pSCRg&oe=6A971DE6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
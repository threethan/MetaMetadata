ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kqc2ZEVapmcQ7kNvwGK0F5u&_nc_oc=Adpj0tQ8_S-t4_zzJ-liDPl30ootwXwdCk0OBcp8FT2-lhjGeZTxqRyWStkefK1aPDs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIAw3cUAFFBKhVBAi6sTgZXVscqb-pBv2exlqhLt5NrNw&oe=6AA7E5BF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9rKMmMkXoEQ7kNvwHig3Zc&_nc_oc=Adqg4K6TDQ5-n15nN_PCnmZY5lVtjoWhID0kr3cBCSNE6_29-Z-lM848Q461CWacP94&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGYuPeLHg3B0fY62RcphDwZkqevddq_UHKyiQWhJp1wg&oe=6AA8167D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yDLg2EwEWIsQ7kNvwGLBkl9&_nc_oc=Adobr5lMVnCH-8nAI6cvBXOeIDd8aQf39XRojQRC8rKANXloiR-o4TZNve_VHVplHqU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsXV-Oz7_zNKHgoBomYFeMawlTWhwRgzEd-ogZe0DEpg&oe=6AA7E493"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IeTqKW_m9VwQ7kNvwEpt0-o&_nc_oc=AdqMy7drsK4HfrgjZ1GnvwOX5I3fnjKnLbz96Fo38h8noh5leAEpgBUcZTjwiLdrSe8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLfQ8mz8smi0PHBvSdk2RfVzyJC2bb0r8Mo8rwanM22Lg&oe=6AA80490"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RkWQmXNFvbUQ7kNvwEVVlLQ&_nc_oc=Adp-81Rf_DTIGQ4L3oX03Chqypdr6JHZO0ou9d8SRStXLVDihxoDwvxH5GpD0GWOTbw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI2UPtHyaQUUIzuTckYYqnWs9lzRqwyfZwB-6f6dfzyMg&oe=6AA80926"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
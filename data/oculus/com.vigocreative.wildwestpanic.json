ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1y_0YcQ19IQ7kNvwHZyGwR&_nc_oc=Ado5CS21g6HTN_tEAVDHU6JRMpdR28XT6DEgPESpeymRD_xYrd9jv-8PmVBSRQwpRJY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYTHwY6S2CtGdKzXNzCL4-I3WErw15sJUvjzHMxqu_pQ&oe=6AF494FF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPVveMedE4EQ7kNvwGOb6Mi&_nc_oc=AdrCyqp8r3TVs2bFHXT6wZ4875zyw5D8lJBiGgjyo8jshUqG3QjCU7y4BFPSvGMMUXY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjpJptNQoNnLSJ_YgYUduyDRaovuPypwMCzeRe01lXxA&oe=6AF48D7D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkHWmnFdOzoQ7kNvwHT4wPj&_nc_oc=AdrHn6i3JO0mKUb6mRsmdTUK0IEvbUwCFePTrcKouqkhQypQEw-pZrhf_X7-JIhMO4o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqXG534oE5SWEymgShnkehVOpJHTZ7xq2iVCmPimsHlA&oe=6AF493D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-tUwvLcSB0Q7kNvwEHAUyo&_nc_oc=AdoP-A1Ltk3KUqp3SFrM9WmWNXCLprEpqm7lxBai8JhPLA3Vq7DWCEIJdOn0ugLhgTQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpSuCW13fLvP_nF5D9mDeXO9eMjOVU8QP5YQD1mUbimg&oe=6AF47B90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_uKxaIVN2IQ7kNvwFtH_eT&_nc_oc=AdqLuBrqPKK5FYJ99qmEeB3e7VAKttuZjmBvCMAEEqJVy_8rbU7XhZO-fuDVEP7nB2A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRifubNVDBIHk4LUQA1iNObrg1SIa3jgLtSYQBfgPNvgA&oe=6AF48026"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
ps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_auOfm2kGg4Q7kNvwEDSjFW&_nc_oc=AdoFB31Pe_9fekTWsRqGtoTxFZOyrxT9mWL2VcXg0_wa9dHDx1Qd2TGHU029NE9S9uY&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAzny58amf5rG0D2qqVJHn7lZDixVD8ZSn4uKrd-pTYg&oe=6AC9137F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bNpNidB_gFQQ7kNvwG-2MGM&_nc_oc=Ado_5eSB-pLjiDndeKVdUocpHRH6ToxLl1zYEE6BtjmIK38jwFSNyZJ8ASmEQTKJnfA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3vL5grgTmSKOAv-x114awEZdSGHcDlT2av7MB5ignoQ&oe=6AC90BFD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ug4BrOhGvOUQ7kNvwHIWmd1&_nc_oc=AdqW8KGYGavKfTn5Z2GP5dI6yF67mn7MIgIBX_v19862KUhR4zx_JRSPNMJu4iMacIc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNok-ctYhPbSb6HKkppLkr1oUXxjbElwxqX9wvZTsNIcQ&oe=6AC91253"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E7c2CIIjk3kQ7kNvwEOq-Lg&_nc_oc=Adpqjd-v0s3mAA719ibIpK9D1R60rFGWik0Ynv0K7XxpzI6WAWdjYcELZ2Sg8kJFYsI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMknFQd8l4RPwR8EoqOzg16OwAj6TYJ_lql5tiQCJIceg&oe=6AC8FA10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rDQhlNDfGdUQ7kNvwHwHRe8&_nc_oc=Adr3Bbd6mPc9i1K7dj3wp0rpxx2gVktpqLxoaBR4P8s3LRQ7NAadbL4e_r3LRd-nn18&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlMkyPxaJK6MAHgqaRZGdKnMM4dPV7IF-gYRPEjnjpmQ&oe=6AC8FEA6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
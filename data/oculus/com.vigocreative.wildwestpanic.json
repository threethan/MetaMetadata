ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL27cE8dtfMQ7kNvwFEut7S&_nc_oc=Adr9OGc-eGPMEL5DKE7KjkJ7G0tx4Nw-aqTnfFzrKN-kbkjxy66yKSkhOmUiTwrctxM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-R4knkglbiod_H55uJm8dYc6G2ib3btFayowOow3Lag&oe=6AB54CFF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mKf7hWANQ40Q7kNvwGaDUxF&_nc_oc=Ado1S-1lJOXksy7aqlTpXT5CnWSsbku0IGK3GZjfRK6apM-Pri9yQ5naMRphDzf9JZ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-ffbWnYVgX3FjWumlay_Z_6_Y49WZ7ZEKaa5Y0cSAiQ&oe=6AB5457D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP-TkLdXnDIQ7kNvwG29pl1&_nc_oc=AdrZNiVQ7ehpZBPMnarb6rs0W-FI4CJRsDQ-hrVPVI9kt14lQEa6Blif5yx5zKQGafM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiHzHuWKyCmmk5qL4RbfnfRK8z5UFzuJhBOPHfYIJa-g&oe=6AB54BD3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y2J3A_b1hVoQ7kNvwFql51u&_nc_oc=Adq3M2gf9xSuqbX3q4y1Rq_ra3-6Z3Xkk3rlg4yTj9Lo2dryLaXQBYQ9tgTaNw8CptE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8iJkqyUOSA-njfQMsO_SGzVW0-p0rXxq6kJqDTm9k3A&oe=6AB53390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-6hat61D4EQ7kNvwFk7poE&_nc_oc=AdoooZDg09DBXKwqDH5e1UFi_MJRYIa-kGkrBJtT3d27VclAYu18WhqxsSIgkhtT1M4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjP-YBxElgiK5Q85L7XqF4Gy-LvHEOTpPYfEM-GLHmJQ&oe=6AB53826"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
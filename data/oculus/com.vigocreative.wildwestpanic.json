ps://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gRTHNe-6WskQ7kNvwEcQ55S&_nc_oc=Adombwmnig21EpZjqyEhtIw0iNXBD4SapUv4ujfGNagPnIuL09LQpGze4Sp11inNm80&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGkbqUlEPN4dc5xj8rXMV-5amLGnpEPU48Fk4vlwBphbA&oe=6A917C3F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qydg0SRjk_wQ7kNvwFxQUYJ&_nc_oc=AdrzpaPaDreyxGz2_MycJA8GjONGw88NSea4aYYa2WLcdVEFVehJ_-WR-wZhYeXmLb4&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFelogn7gYbYjVLGH6Z-sGvur6IBSC6Tc4dhuuPGS-vWQ&oe=6A9174BD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juzE7WOkK7QQ7kNvwEHq0E4&_nc_oc=Adqwp_Y2abGfNyRAofeGMa4I_-6YrL5TtElV1El2sKfUPoSm1FMSANVgBw4mQtoWKE4&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGugk69-nfJ85zKOuqNb8m10IsnOwLE48k-N8FrP2fIAw&oe=6A917B13"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZa2JPWR4H4Q7kNvwGMyQaZ&_nc_oc=AdqshqI1i8GP72UiZpyky8kczneHJ3KGLyT2j-vaHCUMXfwCT_Fh6hK9mm6SIU8Q4eA&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQETgIxoq_dPeONkdKITajvs4A7liNmaeFAZPtytRS-G-Q&oe=6A9162D0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mnge4SgDBwMQ7kNvwFLq8Ye&_nc_oc=AdpQRJE06rKwTefItHouogJNOpP8UUvf4Rgyx-1D5gqpMMtoMz_WPENPmSc6xnKEiQM&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCEHK7sZZhVFK9Aznin28EzRmqUq2mERKxVMqp_E5f1g&oe=6A916766"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
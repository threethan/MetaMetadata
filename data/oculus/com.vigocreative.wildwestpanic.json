ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6ENFaznM1gQ7kNvwH-Gw6-&_nc_oc=AdoDhuEuWGNjYoBQFmIGNi6bD5iaPL7JKkgoy2IoV_G80l7miZuALUQl5SX9JGvOpzc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbbgT5w4TBRLk7s1mp18aZzrmrrtRgCB-LG-zXAq2EEg&oe=6ABFD8FF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoaRxi9tOJMQ7kNvwHf4Gdw&_nc_oc=AdrSNlUv-T-hcADa-OJMGMcH02826pOVEK306DZCKe4KvIH1BDaGfUndkVB0bws5t4c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMPqYsJXffT7voAodaZ63CdTwtzO2lXrd7b1RUr_OXsWw&oe=6ABFD17D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxaKTep9H8QQ7kNvwGzOb5x&_nc_oc=Adow9bdLKtZDVt9O5Nkas3R1Mt7pzLBNjNH8m3JzuwVA2NqLP0znptzuTrBiOBzziOA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMiupMJjz_PI4Q8QO6jWmFIBXC2KuPLVQOPjdB251IQEA&oe=6ABFD7D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT_Vr4S-yEgQ7kNvwHbm8GI&_nc_oc=Adp5y-zuhreSJrAdca9hvhVUxuuQR0wp69SHmxGT7NCy9zpiqzxp4pjPXqD3GLWgBcM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO49_Ag5Be5eIJ5870nY9709DezmvaiCC0awhyhZZiAZA&oe=6ABFBF90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXkzdp18LF8Q7kNvwFuBPvR&_nc_oc=AdphVEW9PMcQdYXtizFEXKlDM4xrr_cdZpSsQVgjbqRIxBAx_c_2puJ-bY5vUnmlGQY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPkn1ISahsz59kMc-Ddtr7ZPWURZuTsaJtS-U9mWIDosg&oe=6ABFC426"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F1y_0YcQ19IQ7kNvwFNh3tu&_nc_oc=AdpCfkzzuFZQtWLxm8pQoP6kkXGsuOHs26nVerF6PVz_VW5wijrtZaxPoO7QYkcxHdU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR-rN0bOQZFQtAEoiRER5MD5T_IfcDKQNjLTrzzf0I0tQ&oe=6AF5E67F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TPVveMedE4EQ7kNvwFu3w2o&_nc_oc=Adpkt6deLBMCYzg2yU1vz1fRbVYfxfvsAoqJZeVOBvzyYUkP7PLPRGQqmoWp-s7w3-M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNhhZz-q8DaUq1mCrc_Qt5qW3MbDjoDwj8FPMp3fpYQA&oe=6AF5DEFD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mkHWmnFdOzoQ7kNvwH84llx&_nc_oc=AdqwtjaLgy7u0u96K9EjaqJ4zhd4CzPi6LgdH34VmApmClX-2PlAxJv7P_oTkjDgN_U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQvhQRDQ_gYhn779GEITZJdRyUxC8e2_hx3oGOytSnqTg&oe=6AF5E553"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t-tUwvLcSB0Q7kNvwE85iL1&_nc_oc=AdoBOMfH-A5exA3oALb4dwMv0lp_30Ao9P5pd9z0wYUeDnVgzXR7gp5Pa8eZkIBXkyo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSNwQs3W-31b7PjIliJXMvlIALQZ3XG3ZOoQ6I-41ZeoA&oe=6AF5CD10"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f53TnzMRpCIQ7kNvwHrMVMx&_nc_oc=AdrumD3nq0ZmYRznnA-nQvX0YdHN0qybDbF_BdoJRPWEWf0_fPHy0GFZ9H0FUliHIVQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRg_KKJsbMoF1_vXopOorZxEngawZobfsCzevGJNxgJjg&oe=6AF5D1A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
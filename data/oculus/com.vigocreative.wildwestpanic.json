ps://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjChoUhkgDAQ7kNvwFz61Bz&_nc_oc=AdponzI3weYFEnGcVoDFOU5JHebK7Foy8eMrDjSvNt0hexsBO_1E4LJb3TfZ8_prbCI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJXQTp-aHM11CKEZesH6Hk33D3Aa3813ZCondCGl5xIHw&oe=6ABD35FF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoaRxi9tOJMQ7kNvwGPor6N&_nc_oc=AdpgRRxezjQB4n14Z3jlTvtDaO2bb7aeq8e9n-dlAm8i0wSr5HcqO4E-AASnEeMO_Y4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL9u6cqxFBZKHtMh_j5bIsBzCZFDDE71drLyn6SO58eEQ&oe=6ABD2E7D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DxaKTep9H8QQ7kNvwFGXBkC&_nc_oc=AdojARNPqyhUSjVX5yuBj5LIXtKY6duz1THrQZSD870qPf4tAedmuU_aoTPfzAlt61g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJY_Lr--TCkt9nPgEjdYS5kHIdGqD1_OL7Tq9qOa9_s5A&oe=6ABD34D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IT_Vr4S-yEgQ7kNvwGbVFbd&_nc_oc=AdoF_ltvi8Mfw6DbzdZFUUQlU90I7bJ9YbOTOnxc3gmagO6HbwNhG2mXXjNrTVpY73Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzSD8kko1QvOXjrMHGcmqpuwUUe0r1sXaGx7lf9Imm9A&oe=6ABD1C90"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9j746iCJGEAQ7kNvwFZO-Bx&_nc_oc=AdrE-tDpKx_gWGLGfYd9QzuTg0O3AqDM4Kjl86u7wESCrQ3wNHyOJuM124E-ZqsTXP4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITl6fBmiNbV61hu3nNiQZTtG_0kX7crmvgVy8zAGJc-Q&oe=6ABD2126"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
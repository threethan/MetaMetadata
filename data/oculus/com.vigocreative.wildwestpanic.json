ps://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBBpCbuQXOMQ7kNvwFjKv2d&_nc_oc=Adq24Wsj76y6bv4aMKcsYgnb31I9RGlh1xnjsm0KdzLD0IX2Pbrix4dpo2azl7qYlu8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTRRTF4z3JxXZjmo425IVDRtG0gmkjtOkcjUQrMQsAoTg&oe=6AECABFF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cM7pAgVnqAYQ7kNvwHSv1GC&_nc_oc=AdrjfIMYVs8n2RTzI3cSwWTtnSi_jaSrOk5LTL_hb_vly5g4-4r4TtP8oHx4VLYp7jQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQYYwOTpw9Fi1FRdyBWEryO1yo0jx29QpukSuNJNljGtw&oe=6AECA47D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WEBUlR1aZ6cQ7kNvwHiBGXa&_nc_oc=AdoQwnLpjLPz7-KrRrO_tjnBoSkzaQgFcmPARB1VhyW_vk0_9OiP0rIxORRArs9wMx4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRG-w0oqZAkBQAwUhcQD4s38wt_U7GvjP7wo2_B853Fxg&oe=6AECAAD3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6GGQ2BBpcaQQ7kNvwForE4b&_nc_oc=AdqjqA-C-nJpYCinsAC4QNmypfcuFTeutGfNXneYkUzg7ENA_PO1_Gy0WCcqrapsXLc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmp_AaF9JN9gH_DxLIjansFD_mjHCnJvptJEJ0sOUa7Q&oe=6AEC9290"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bVgLCTjo8EQ7kNvwFMyNDj&_nc_oc=AdrYIt4RtCk2tnH21X9bmFdd4kjAXyqs-eImrW1FvlybAvKEmpEWlZcLDpImPfbBc4Q&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSv45GG6Fp_m679UrkM_l0Ly032e8TsAwTULIN7LJDjfQ&oe=6AEC9726"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
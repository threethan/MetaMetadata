ps://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8b2Rz5ntMS0Q7kNvwGR2XDv&_nc_oc=AdrdvNDdgqZgM5KWVjZMyOMGd3QvvV7atKrWVmdFlhSaGw9BuR1DmMxh7_twcdb0dL8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFvxPAx2c_j2fFZNUsnc2Tlns6l3uuoRaRjoHUDP6HxA&oe=6A9C407F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI5cwa1gb78Q7kNvwFQ0CKs&_nc_oc=AdogyTolwIqzihbkAlPZSTEOTM7wBh5PdT8BS45yIHMnUJuxwCSiCk2cxdqu0HMfjyU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJMuDVx7zgAZk3Ir5TEiTP1iWL1afSSOV7ZLnRuv5w9Ww&oe=6A9C38FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLVrgpmLyj8Q7kNvwHoQt6u&_nc_oc=AdoegavYBlKVDxS6cCB9vO3Z-cNHF9s9sg6dqNVnlBBcHjYrB-Y6MdcHv1gvdNcW58U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKv9ekyy7NQ_sv01NA4ZzY15zd3dBF2SZc6zF8hEM4isQ&oe=6A9C3F53"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1t1D2RRJ7_QQ7kNvwHikNug&_nc_oc=AdqQ7SB6mfzEk73BQNny2a9sDD8zPzfPMVjH-gXfPgPGW5nls_5PBuKHjPaDS7trv78&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIijPchMJjzhogP8eIu_crqCE2VWrKp8SGuPqYJdAsgvg&oe=6A9C2710"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elh2qa2Hyz4Q7kNvwHceYoG&_nc_oc=Adri_GrlgmNluuNRsyuSOTQPUJ6b6nlwBy1B3ENzMa0EreqMa_QS9z_a0MUUtLpz4M4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtT-1C0XsjI_Zlw7PQ48heA7VaJ0OmqmCgATi_4Rpy7w&oe=6A9C2BA6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
ps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBvRgZDa2NsQ7kNvwFs6y0R&_nc_oc=AdqlA9JwLPB7tXLaWbMXAAry_xG1VzUT1Px0IlqRxLwcvQhPOvQlpBLJ2LhoO4IqES4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6tJUUT4byuimWHDRXTl7DsS9pChPxBzacsTBRVjRiFQ&oe=6A9AEEFF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AI5cwa1gb78Q7kNvwFeT0r6&_nc_oc=AdoX5EffGqp-ahEFebD5_ts6CyNcqVlzSAJKI0rI7yjt7tF0nqoXQpxCcUHitoaOF7s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk-1t0aIVPgTetPOKcsFS_vgi7hEIrI1mbUwc84MtcYA&oe=6A9AE77D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLVrgpmLyj8Q7kNvwGrjPNf&_nc_oc=AdoBgFR31YNx3icREK0PXgpYxSYuEjgrndQhmDHux20AtLIqWMGi_YB_bjB93WcmsqI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2HflhjK2Pggk23T5RQyLvqpyxet32DWR3gPhVBosJQA&oe=6A9AEDD3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1t1D2RRJ7_QQ7kNvwFl-Qb8&_nc_oc=AdqQOgDoxAsiHT-AB5MQAe99-U3p8e3gErBSkN-4lh9xEdICfPsy71ZEt3UgXUwLMrQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIaLuVqJJopOYzkyc3udpFIQEWjBres11vT3QdMAgkNuw&oe=6A9AD590"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=elh2qa2Hyz4Q7kNvwGnVeQt&_nc_oc=AdpsTliHhD2ResNfxFf4_E6VZLy3S9E0qeHoc7izH1SCP19jYUYBtbZztt3C2T9-sfE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhGDW26H-2rsHIlNwb3gBmLegaE3iI4r3Oe1GuFU2U1g&oe=6A9ADA26"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
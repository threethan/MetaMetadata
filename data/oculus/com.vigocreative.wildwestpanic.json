1440_1.png", "id": "1437623151225920", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TQMWjiAaBxsQ7kNvwESYTzx&_nc_oc=AdrCfzkcuUELmyL6itnvjyW2sw2sv09cvCruWg9dXCPtwOR3kRANV-7N8GHlV3MIli4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiqlblcnJiQS5uiszqk83K--VXlWTK-VdHwQazqCklow&oe=6AA3F13F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_CBjGRyCDoQ7kNvwEGDbRg&_nc_oc=AdojJ0SalkzDttpeWOXxFJ5XaEY1bzB6ZiHwxGNfWSNpIjrMUTkCkUx1ufl5F30MrgE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIqI0h34UqgOR0WnwnxZt-_uQWb-OXU7ejtWtWDeAglHg&oe=6AA421FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXvPsaE5L-MQ7kNvwFyN7vW&_nc_oc=AdobELHqYGWrrKB0w1-WQQZinyytyBCD4fNNxXTN_z4mrv95NNLi5GU1osIftyfhThQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKvDQNOjhDGlvuRpdJ1D2KqgoChjWOw6fvB7fDVY8mzeg&oe=6AA3F013"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J9tM71oNjtgQ7kNvwF4xSYV&_nc_oc=AdrFOKmqSuOTUFpfQSoGezt0a-01a048YT9Z3IXOTDbv1IC1C_KsSaA26AkG2APQjHk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlNmE0D-zUuaA7PFgH7ih0COUO4Pbo9Q1HzQ6hSV6QnQ&oe=6AA41010"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG7flTgrEZQQ7kNvwH2aAMK&_nc_oc=Ado8tGG046LB68Eo154jTkpRmNawWc5UR3vDSbUZxfC5mLHpp2qXFM-FxPYL7GMQKuA&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILA3_dq0aa7KxFcHKT7RNTvlrceLVDVv2jDIv3aX4oiw&oe=6AA414A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.c
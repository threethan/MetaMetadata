ps://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yRndK63KiycQ7kNvwF7xlxQ&_nc_oc=Adow02LcEaFyAlU5-8wNoiHo-tIL0TUxxx096jI9ksCZMgOtEGMV4czKEkBRHFIpKlc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNncGIC39nWuxNJjM4d-477j0AOReyHlauPlZKhlp2mQ&oe=6AE3393F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WYrPH03nEAIQ7kNvwErJwB4&_nc_oc=AdoJ1XMzIbB2181dbLvAH66Rrqh0-VHF3oqHsrmQK0Ijogy1yj9tGv9nKhvSR06BGU4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMEVEx98g2UEuuFVTUPRzh2hFQYwD1_jBEaHhnoV2iACg&oe=6AE369FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sFnGsXPpCBMQ7kNvwGtywUY&_nc_oc=AdoRpR-XXyvvqRGtXvxOmwIi7DVhKhD9mN6Z2giduChE8OwYphUr-ATEmdMcRBX1xek&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOKA-wEi8ytWPj19W4QxtK97AAJ9ydSRqSC2OLRw1iZig&oe=6AE37053"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F6CagUQCm80Q7kNvwF_CuYC&_nc_oc=AdoMB3pnSRYK4qcCyzErCY5oO356DsNoPgnRjUu7K3BKQagKdM4GIn3sVqukXITuZpY&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOCApHXI11yu3jA1d7YGTXEJQHcsMlmT3s_Ai1siP4X7Q&oe=6AE35810"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8G_TL_-8VmMQ7kNvwF0AauA&_nc_oc=AdpHXmiUsXMnGL1HP396fKzmDQB4KN31rpGRpADB5c65GZ29v5pW_IgxM4n0rnBLDB0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTXjo_6FQvtftKBRQnVmrEnxiFQa8nIef-Mf01JWP4iw&oe=6AE35CA6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
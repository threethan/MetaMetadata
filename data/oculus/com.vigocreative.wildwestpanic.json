ps://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=baVl9pp392cQ7kNvwGr5Dma&_nc_oc=AdpPHatT2jelxY8I0DiejQbLmi-msOPEj_JDuE0ge3DCgqCkNMQDmF1po3l9JzlBwBQ&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgjrzNCUKutXjbsMz7MTrGTmQnbICTt5fAwBg9EkKsbQ&oe=6ADCD9FF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qrrn8WK0x7AQ7kNvwFF5ujg&_nc_oc=Adq0hIwmlRBT1gUKcpY8nyRYJ3q60JiYhDHhf0NdtRNiL0uG7ghKqJ5yrT-33a2zm1I&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIIAn-UoWuOlO2f2IqIrO1Ta5dESvW-C8yHrzj22Lh3g&oe=6ADCD27D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RVziitpfaYQ7kNvwH8lcCr&_nc_oc=Adqz5qt-ajnU1gaDhZy5UwRcTDSu1C4tUjqhe-xDOnV_OiWQWBAIaFimKh1shXRWwM0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOvq-7veCq_y8t6WPOHR9jyAxP932JzsW7j6_9GqDcMZQ&oe=6ADCD8D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJbaRp8sRLkQ7kNvwEzc9sU&_nc_oc=Adpb6abZdSWX5EhOVZ8FLvLkgc6qPdSrTmRJQtX4mjvO80xyqK69tEHsLQQi60Eskys&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6k0Tt_PmfeygR27h3Qygdb33dKnrriDM74j1YDLwHpw&oe=6ADCC090"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sre5z5isVPAQ7kNvwGQVGMv&_nc_oc=Adp8tN9zY-WhCwsBuBKPUAjmHcefE6kvHb2zYgnJRC516cyXoKx4jlZSM0AvCoZktRo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPC7qxPF9as_llS4oYnQlTWIkJ4ZhUhsgs3fIFyzodLcQ&oe=6ADCC526"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
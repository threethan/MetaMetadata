ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7sgyK8LOI0oQ7kNvwGluETq&_nc_oc=AdosjNTgCXV6eSYIR20Hc03BNNiIT_13guenSmKsdSvhkbv_cGW2MhsCguTvsVvsYg4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL8ikZKYEyzLjSaKLJ31Vm-FhjAUr6S3sK1GRDarxpHg&oe=6ADF44BF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qrrn8WK0x7AQ7kNvwHVV-vl&_nc_oc=AdozcnxL_Pd1AYh-Lpv8M6J7fOmlU7lsQREXBMIU8t5GjKs72J_uAgSfXUq_LX37c4Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPNMOgOLRD9w3J4CFfDOjg77QeOYaCmI8cPqsM9KTJusA&oe=6ADF757D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RVziitpfaYQ7kNvwHKdkk9&_nc_oc=Adr1A8MrElKKWSM9kBm_kr4Cklx6RjVC3-UCGjflV38IM-pJ_hGW_tt4xBHmwIYzWFw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCM5SuydxYdynRXgvpEo3svYUyRBPGDK3B1GhWhnDeTw&oe=6ADF7BD3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sJbaRp8sRLkQ7kNvwGn-AI-&_nc_oc=Ado32HwK3ejCIaQkOjq187NPn4DPmmXRfL3EqhGY8u9TftEOoRj4RyYwxDcbCT6QkDQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx4gaAoClxhVurmJWKksAXuhOlc0aoRcyHIcLU7vCSDQ&oe=6ADF6390"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ktldZ5nj7GcQ7kNvwFMVNbV&_nc_oc=AdoQO2m97SOHHQ0jtBE957-cgJPcZIl5-lP8KGJ2PL2IqJ8nNSH7xyAWHp1dRloNl2Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO7fSAIc7lPJ_zAc88JK24e-BQbpzQ1YniN8pfIiw-KFQ&oe=6ADF6826"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
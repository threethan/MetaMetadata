ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BL27cE8dtfMQ7kNvwFlgnTT&_nc_oc=Adqo8EOccd5DdriNRN3gE6NZYAzX7IPxKmvVGO0Vy8Q9-L5hDirN2LxgsvR0lVK2JKQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7WFZYKKd9QeQ5sOQ5A3T_RId9VH8bL0HmzK5r5CNsFg&oe=6AB3C33F"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V1ffrBhgul0Q7kNvwFayBUH&_nc_oc=Adp_phr10Oh6b-DXIB89ts67Zmmp22RR6zC0BNKmBk68BPBcqcd1vuGxJaq3m52IZeg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLy5tOgmHPsyoYvuKcD6T5T78Jh-palYsqFTmsnF7-iww&oe=6AB3F3FD"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tZd3KU9-wRcQ7kNvwGwiMW5&_nc_oc=AdrwP7_Sx1eGn9iYL4aOgNJfUKTe8otANhKYCJp-liISpQkf7G5a9ki1Niv61bumHOY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJeorBiN3Nhj3cvHtEjZ33EyATBXXGo-ovK7clC_hukdQ&oe=6AB3C213"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H6imgqG59HQQ7kNvwHF6EE4&_nc_oc=Adon-gpdr9Wew_LFxY1qpG5H4gFKBoEaISkWCye3mxGax0_fjbv1PV8-IBtLKnC6aL8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlVsg_aq6M4ZXWnapyubmAZuvAl-YMq6--yMud1A_d9w&oe=6AB3E210"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A-6hat61D4EQ7kNvwFns5IP&_nc_oc=AdowIb9Lic9VFXjSulZvHc37MpjQ8zaIVyfm5Mg7TahXmAXQJzZH8gAICQvyhgCabfk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFawgsvf0pcthn6VbUrEpodlhBYm-4dcDmqFSu7Oxldw&oe=6AB3E6A6"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
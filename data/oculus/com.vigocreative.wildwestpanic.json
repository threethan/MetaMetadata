ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SA522AFCSyAQ7kNvwE624uw&_nc_oc=AdqY2RoBZ94hDFIYStmsEzVHNFb5RGzX22BRY_U_gRKPZIz925NefimQ_i5F2JMnrjY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMsJ9IeMnUhsLt5RP0SHWgRtj57fYtRqEmtA5p_BWytA&oe=6AF1F1FF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2BS2L7ttJuUQ7kNvwEGrvH7&_nc_oc=AdqGYVz1UbAYSqIVeSMKrV74LiUN0q-y_NULtDhEsy5AdHYJdhU-5OuVB9GHQIpoPJ4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT6c1g1bv3r5EMoX5Oonz2BzZ1QMkdu58c59ke3H2fW6A&oe=6AF1EA7D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u33AX-yrq44Q7kNvwH12LVI&_nc_oc=AdrJlxVRjNo7CpuAgr2oWrHBWwCd6dVa3A1prIFpTB9wtFdVPEn0C4Pi6dkeWb1ngYg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0zyfnVi1XPN2Ev5AVLhK9P-a3wYg_hlK7y9qVl8xEtQ&oe=6AF1F0D3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f6HjL_Lq4TAQ7kNvwFw9dcE&_nc_oc=Ado8iLvfrKVhtjL4b_EIqzak4mD3BjEiypphxui4bAS_rlDiY4g26PRupYbhMquqkXM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQoJ4lOw6u5TEDundi4l5oTYj91-s8PoKqgyef8kwvUFA&oe=6AF1D890"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u_uKxaIVN2IQ7kNvwF9Tm14&_nc_oc=AdqotiZVCrNrBpli3SmtLrttYvF9kMPzPRiM_kFgTV6vd3ebsNGegLa25wWAKFM0HSk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSlDOyVfmPyIkiD6h6LxmB1sfAf3Z9oAbKBig9xDNaT7Q&oe=6AF1DD26"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
ps://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820141_1437623154559253_6957459600206667060_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tBvRgZDa2NsQ7kNvwEwcC3v&_nc_oc=AdrVOt28sYGvUoMiGHHc76cfx09ySdghH6I03f7fRuSd-9PfIY0TfGPfxlSS8oZXq4c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKT4mXgPtkAwEOZEoAsaL4qkdq7_lXAbI3Jte2DJ6Vudg&oe=6A984BFF"}, {"file_name": "SaloonSharpImage2560x1440_2.png", "id": "881789314314580", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827646_881789317647913_1810837243343415905_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTQQSZWCg_MQ7kNvwHFoZX3&_nc_oc=AdqviFT3oqvKzUkfFksuqfkL4HO17FBulwb5i-8C1tLMTjRnz5-YOCs-2h2VYt5WcFU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJqH7hQGfKJRmDY_XXGXBi77VbPxbVeuIKMsrfCsUCVPA&oe=6A98447D"}, {"file_name": "SaloonSharpImage2560x1440_4.png", "id": "619492824542122", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823812_619492827875455_2534869941881102016_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLVrgpmLyj8Q7kNvwHP4ffT&_nc_oc=Adr4_4P3XnibE9rVUGAh9glLSBxrD5uqcHbYmrgsfJtx9ERBvzsVxY5Z9_Mx1J5k-Xw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL00x_vuodCUyNAFy-SVV8lYyLNmL_4ELHLsQTCD6bFWA&oe=6A984AD3"}, {"file_name": "SaloonSharpImage2560x1440_5.png", "id": "2116597272206324", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820141_2116597275539657_2379481800360106716_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6lr2pUF59AQ7kNvwE-JBKI&_nc_oc=AdqsmID8v-t2TQCs-TJhh5Ytm6CdanznHAQsHKKbp9iaVyYBaFXx_RxFn7mUMvfSX40&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQImKy10IsqlJJTbIS7GnDehbqSKZceYWUoG9tciZw5ZgQ&oe=6A986AD0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "ThumbnailVideoTrailer2.png", "id": "1178572387619198", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491821796_1178572390952531_3033249853253997231_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_VVVUgz_6OQQ7kNvwGTSjns&_nc_oc=AdpB4IcljarxMT5f4GycRlTywMICZstujwe8E4GkOV7k4t1qBedU-qOzEwqbtAUJ3GU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6lrA6E4ubnEb-0wXbNrgWr1Tm1VPgRUmu5T_UMw5wzw&oe=6A983726"}, "display_name": "Wild West Panic", "keywords": ["arcade", "shooter", "cowboy", "casual"], "long_description": "Immerse yourself in the shoes of a famous **Far West cowboy**. No one is around, only wooden targets appear everywhere. It\u2019s up to you to shoot faster than your shadow!\n\n**Wild West Panic** is a hyper-casual game designed to introduce you to virtual reality. Explore the 7 levels and try to beat your high score !\n{1369934868174516}\n# Main Gameplay Elements :\n\n- **Environment & Level** : Experience seven closed environments that you can replay endlessly to beat your high score!\n\n- **Gameplay :** Jump straight into the action, no tutorial required.\n\n- **Game physics :** Enjoy partially destructible environments where you can practice and refine your shooting skills.\n\n- **Weapons :** Choose between one or two rifles for extra fun.\n{807953895607114}\n\n- **Enemies :** Face off against wooden target dummies that represent your enemies, turning the game into a true shooting range experience!\n\n- **Bosses :** Encounter surprising and entertaining bosses that vary depending on the level.\n\n- **Scoring :** Your score depends on both the number of targets you hit and your shooting accuracy, missing a target may cause you to lose bonus points.\n\n- **Replayability :** Play again to improve your score and try out different strategies!\n\n{1428852595510134}", "short_description": "Saddle up, cowboy! Step into Wild West Panic, the craziest VR shootout! Smash targets, rack up points, and prove you\u2019re the fastest gun alive ! A super-casual single-player game, engaging fun. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.vigo-creative.com/PRIVACY_POLICY/PrivacyPolicyWildWestPanicENG.pdf"
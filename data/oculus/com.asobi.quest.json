576583620497492_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bad1T_rUlBIQ7kNvwESk4Y4&_nc_oc=AdreehC31xP3Uu3FPPznxN59abCljsoMHD7rE8FDYfvqqdnt-h0ruOU-FJVyL3BXoKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPPw7EK4uPZTGkYZvNoX-QIzgBmnhfFpcMU_BhoKOG_UA&oe=6AE49295"}, {"file_name": "screenshot-1.png", "id": "1634755384670118", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823802_1634755388003451_3027461345746400515_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrEeDm-aMOYQ7kNvwHTCvXt&_nc_oc=AdoEYG5X7SN6Font9iZ4hts7fPGOKnEo2z8qiwaCf2TJG1YLg5NPT-RtQHvPBfQfoAc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZnSEidunjfuh6xutQ_S2ZM_1wtiZR5YM8jTybmww6PA&oe=6AE4AC48"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Asobi: Remote Play", "keywords": ["playstation", "ps5", "cloud", "streaming", "remoteplay"], "long_description": "Asobi: Remote Play & Cloud Streaming for your PlayStation\u00ae\n\nTurn your Android phone or tablet into a high-quality PS Remote Play client for your PlayStation\u00ae 4 and PlayStation\u00ae 5, with real controllers, virtual buttons, and smart streaming.\n\nCore experience (free):\n\n\u2022 Remote Play from PS4 and PS5 over your local network or the internet\n\u2022 PlayStation\u00ae 5 Cloud streaming (PlayStation\u00aePlus Premium required for cloud games)\n\u2022 Multiple PSN accounts with one-tap switching\n\u2022 Game info & progress: latest trophies, currently played, and how far you've come\n\u2022 1080p / 30 fps SDR streaming: smooth, sharp, just works\n\u2022 Automatic bitrate: the app adapts quality to your network\n\u2022 Automatic console registration: pair without a PIN on the same PSN account\n\nPremium, a single one-time unlock:\n\u2022 Full DualSense, DualSense Edge, and DualShock 4 support (USB and Bluetooth)\n\u2022 HDR video: full color and contrast on supported displays\n\u2022 1080p / 60 fps streaming: double the smoothness for responsive play\n\u2022 FSR Upscaling (Quality 2K / Ultra 4K) and up to 120 fps frame generation on supported devices\n\u2022 Multiple low-latency modes for tighter Competition / Ultra Low\n\u2022 Realtime 2D to 3D conversion to add some depth to your play", "short_description": "Asobi: Remote Play & Cloud Streaming for your PlayStation\u00ae"}]}, "developer_name": null, "developer_privacy_policy_url": "https://asobiapp.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "Inside Internet", "support_website_url": "https://asobiapp.com/support.html", "website_url": "https://asobiapp.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1055187466124150"}, {"id": "393222478507326"}, {"id": "434961926215971"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "34601133392818455"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1776172486926695"}]}, "baseline_offer": {"id": "1776172486926695"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1792671360, "status": "PUBLISHED", "id": "1776172486926695"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "39663041293294281", "version": "1.0"}, "id": "1460942718921559", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application"
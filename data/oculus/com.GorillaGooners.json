ttps://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391855_1841820943269715_5863209362557819044_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yw5HiLTzjtkQ7kNvwEIhVrQ&_nc_oc=AdoevEfTqhKuQrx_fb3XXZM6HjaitCDQFlwv2Uy6VgAV8NusawTNSdCmyn92C5Jrr08&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSEIkUjHMkFSRtO8nmYxYt4p-tSMvebFM1pDsip1-r7-g&oe=6B09B147"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla Runnings", "keywords": [], "long_description": "\"Gorilla Runnings\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Gorilla Runnings is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns.", "short_description": "\"Gorilla Runnings\" is a captivating VR game designed to immerse players in a tranquil yet engaging environment. Set in a serene virtual world filled with lush landscapes, calming music, and picturesque scenery, the game offers a unique experience of relaxation and creativity.\nThe objective of Gorilla Run is simple yet delightful: players use virtual reality tools to create beautiful, glowing art installations throughout the game world.\nThese installations can take the form of intricate patterns."}]}, "developer_name": "VIPER", "developer_privacy_policy_url": "https://docs.google.com/document/d/1IYnxsmRB6Cm1fe-IljaAqX7uRUrX98CDUd6OXaVSsDc/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "VIPER", "support_website_url": null, "website_url": "https://docs.google.com/document/d/1UNNsXLZU54Pj5svUBHQW2iN-caMl7YiUvIshFxcPDNM/edit?usp=sharing", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST
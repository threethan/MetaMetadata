51439212432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-C8gGeAlPZ8Q7kNvwHomHCG&_nc_oc=Adkk1Ftn-9WG9k8A5H1v0AQjxjkvkKtO_txJg3tCz8nJvRGq3r4cZQk2CqU4xGSknRA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxoBUNP7gY6AQungoNqcWyw2qKCj3WykA1m5papB4xvgA&oe=69B3FF7A"}, {"file_name": "ScreenShot1.png", "id": "447180074821381", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75392880_447180078154714_2977992641172799059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zpXw6iYlMtUQ7kNvwGBUkMk&_nc_oc=AdkyWnhkv2R3gXDs0c4JmeIzjQ-nWbHcf0GIoMm8fz03IxA4-CxXjXst2RPWp_rrSbE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzWQehjqdUrQlWOlFVjs7kekGN35lCfezjCeewo7VncLA&oe=69B411D1"}, {"file_name": "ScreenShot2.png", "id": "1211999636613444", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031492_1211999639946777_1748634987387877181_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FfvfPpCjz9sQ7kNvwGUKS_r&_nc_oc=AdmHkd41gzVAU9f5GR0I7kDa4lErMr50wTZ4F9Wx2qGo8AZKUcxWYKqGW0Qa8zdidmM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyicrW_iaOqMrgajlyUSGoMeLmTy0kgKanzKoQCAE0eaQ&oe=69B4224E"}, {"file_name": "ScreenShot3.png", "id": "1825257994632994", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974528_1825257997966327_6379464755957542704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxLs2KxLARsQ7kNvwGWMhYb&_nc_oc=AdklmaTdQi6_KL7vmc74v8LWWExzs8XxrNsmfKbVVaTzfEtpGCuWFuSnoWr9M5jDRJo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzRHe9SQ9qRM5y6EGVSvbBBF9pyj9M67_cMw1ygFLB6tA&oe=69B3ED22"}, {"file_name": "ScreenShot4.png", "id": "841419990840334", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982637_841419994173667_5268022981001009628_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ECTz7OP3xooQ7kNvwE3P8SK&_nc_oc=AdnkXfTuvHu0ZShbpzjh_--CVnovRO-jXRbECrlszO65TmCh8yh7sFrZ4iQ3AsOI-TI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyBPt07kP2-6Zon7FhO48x_FExsayPBdxALjpmYWQEAMg&oe=69B417C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash", "keywords": [], "long_description": "In Monke Mash, you dive into a thrilling murder mystery where stealth and strategy are your best allies. As you take on a unique role with distinct abilities, you gather clues and identify the culprit among your friends. Trust no one, knowing danger lurks around every corner and everyone has their own agenda. To enhance your experience, you can customize your look with a plethora of skins for your gun, knife, and character. Whether you choose a fearsome appearance to intimidate or a stealthy disguise to blend in, your strategy will be key. You must piece together the puzzle in high-stakes multiplayer matches, testing your detective skills against players from around the world. In Monke Mash, every player is a suspect, and every moment is a fight for survival.", "short_description": "Become Monke, it's easy."}]}, "developer_name": "Banan Studios", "developer_privacy_policy_url": "https://enderdragon0928.wixsite.com/monkephobia/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skizzo", "support_website_url": null, "website_url": "https://enderdragon0928.wixsite.com/monkephobia", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7768805733151041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scon
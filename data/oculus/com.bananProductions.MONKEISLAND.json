51439212432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a11eEcj4jlEQ7kNvwHd9maE&_nc_oc=Adlt1DcKQjtoG01SXeIUL-vLx6muYZ1caOyirG0u4ky5UDi1L8maCOMPYmXVab_eymA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftWEJUusELGFi2qZDaFxfYA9CN5ZLZe-1ylXua_3vg0Og&oe=69A9737A"}, {"file_name": "ScreenShot1.png", "id": "447180074821381", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75392880_447180078154714_2977992641172799059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=esTTnUAbcMcQ7kNvwGheFYR&_nc_oc=AdnIQnTAGRilWXJ6KZhW8Qy68otW1wHiOgUjZyuiRuTVKstlIubd0k-PJJwMlABpETg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AftClXfYs4mukB2wvhDcA3lN-RGp44E06KaNWaTIP_FxFQ&oe=69A985D1"}, {"file_name": "ScreenShot2.png", "id": "1211999636613444", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031492_1211999639946777_1748634987387877181_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rj1iOzsM0B0Q7kNvwF2XIYI&_nc_oc=AdmqsUl3ivscvVp39WtZkL6uifsd1zUNn9skw6d34ycDmIzQT6dp0biwuRNl33_qV7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfvAoueCWFC7-5lyCU6Cj7U0Xlmyht7tDok33jgn2pP6cw&oe=69A9964E"}, {"file_name": "ScreenShot3.png", "id": "1825257994632994", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974528_1825257997966327_6379464755957542704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B_V187In0hkQ7kNvwF30f6h&_nc_oc=AdmHsNZncvBIrMa_pu4XCGY-RMAopwlbeUtamRHUVLOge20kRwA2xiP_MYI94e8bJbw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aftq_pIN58BWBTHbBmb7w1A8buRDqNjOA5Nhkc2kqVPLVA&oe=69A96122"}, {"file_name": "ScreenShot4.png", "id": "841419990840334", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982637_841419994173667_5268022981001009628_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZFLDmkLiUnYQ7kNvwGLQUjh&_nc_oc=AdktJ5rjcXH1KTIxU7YhF0eKNrHrw08eQQezOqRECZjTQ7T-IkbX0yvmfYjNqGQw6CQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Aft5dY3Qz5d11z3SdjyiflaMr6i2A_JfsEmrCpmKVY01gA&oe=69A98BC7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash", "keywords": [], "long_description": "In Monke Mash, you dive into a thrilling murder mystery where stealth and strategy are your best allies. As you take on a unique role with distinct abilities, you gather clues and identify the culprit among your friends. Trust no one, knowing danger lurks around every corner and everyone has their own agenda. To enhance your experience, you can customize your look with a plethora of skins for your gun, knife, and character. Whether you choose a fearsome appearance to intimidate or a stealthy disguise to blend in, your strategy will be key. You must piece together the puzzle in high-stakes multiplayer matches, testing your detective skills against players from around the world. In Monke Mash, every player is a suspect, and every moment is a fight for survival.", "short_description": "Become Monke, it's easy."}]}, "developer_name": "Banan Studios", "developer_privacy_policy_url": "https://enderdragon0928.wixsite.com/monkephobia/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skizzo", "support_website_url": null, "website_url": "https://enderdragon0928.wixsite.com/monkephobia", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7768805733151041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scon
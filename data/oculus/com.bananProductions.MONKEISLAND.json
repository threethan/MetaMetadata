51439212432_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEbgvbYJ7ZAQ7kNvwEuoP_A&_nc_oc=AdlAvtQ5QPJIPEmb_hpsv_k0AuJfUAgeJp8KEufQwSQJiKQAw6guykUZOGKW4_2d0Cc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxStjlzJndLvXHrX6eMWM_fOMjsgArRC0o9qMq1u2BMBA&oe=69AEB97A"}, {"file_name": "ScreenShot1.png", "id": "447180074821381", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75392880_447180078154714_2977992641172799059_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTyRKjrtCbMQ7kNvwHs9kfb&_nc_oc=AdnejlyJVJ4yxJs69D9dNtbGh3OiTBQSLGjr92Pe6eZBCitA4UGmPO1sz7Z5FnYOy2Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afwu1MnayewxME57ubUYVuoFdgNPMCzHZvTWY1-7NN6IMQ&oe=69AECBD1"}, {"file_name": "ScreenShot2.png", "id": "1211999636613444", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031492_1211999639946777_1748634987387877181_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JyXeTyCKlSkQ7kNvwHZFeL2&_nc_oc=Adlm2a98S-EQ5_PxOt0f4qQip0093As7Qc522H9RwNPR94glkJebuWfQSsXxluSxoo0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwyX4qnzjZJKyroRRQ38LDgQFLQj-WTfHkkXx5JR1dbmg&oe=69AEA40E"}, {"file_name": "ScreenShot3.png", "id": "1825257994632994", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974528_1825257997966327_6379464755957542704_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_v_0gzI2_6oQ7kNvwEn455N&_nc_oc=AdnFne_pg54aGh2H71GfBszuSf7_0cMUXYwNQ5MDs1mgL3tO9YbcSdHlhQw8grbaWjI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyuhSa1TAkbtkc0teY8rTLyafEIJv-tVu62d5aZGfZ1AQ&oe=69AEA722"}, {"file_name": "ScreenShot4.png", "id": "841419990840334", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982637_841419994173667_5268022981001009628_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8h87kcdlIoUQ7kNvwF--pjt&_nc_oc=AdmVTS1uFvGXjORzgH_LIPfZ3YDCTrTidAPg5odJiWjvD_C46k5R0M6KV4Yv4Oi4Sf8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrrBSyovZlyUN510jBimfDX515gIMjUfbhClzxiM7L5w&oe=69AED1C7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monke Mash", "keywords": [], "long_description": "In Monke Mash, you dive into a thrilling murder mystery where stealth and strategy are your best allies. As you take on a unique role with distinct abilities, you gather clues and identify the culprit among your friends. Trust no one, knowing danger lurks around every corner and everyone has their own agenda. To enhance your experience, you can customize your look with a plethora of skins for your gun, knife, and character. Whether you choose a fearsome appearance to intimidate or a stealthy disguise to blend in, your strategy will be key. You must piece together the puzzle in high-stakes multiplayer matches, testing your detective skills against players from around the world. In Monke Mash, every player is a suspect, and every moment is a fight for survival.", "short_description": "Become Monke, it's easy."}]}, "developer_name": "Banan Studios", "developer_privacy_policy_url": "https://enderdragon0928.wixsite.com/monkephobia/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Skizzo", "support_website_url": null, "website_url": "https://enderdragon0928.wixsite.com/monkephobia", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER", "MULTI_USER"], "id": "7768805733151041"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scon
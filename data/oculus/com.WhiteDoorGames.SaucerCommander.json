964381050", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491819239_1209905967714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbLvsL0VOFYQ7kNvwH04jpG&_nc_oc=Adr10qPTBzC0KmzGWcogCfdapnhG2K8euHOPDW_TuoGJDX1GHZlkH1Ld1gODKsnUtJ8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0ZYPdRyeasdblpZjWsBwzW-CrFxGrOD104vlc0IrHv6Q&oe=69E22330"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-1440p.png", "id": "867619185693817", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/491827626_867619192360483_147268499530826403_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA2nRDkxSa4Q7kNvwEQY040&_nc_oc=Adp5NjUSusApDqu2ymEl5dBVdSjjRscqUfpblaJUudiSPdZ0NvBzhLZQw3oiy6ua2Kc&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af290xLZFC-6ecGYhSGs-hgDRWeqsTCQ2Ch3a906vCjMXg&oe=69E23C36"}, "display_name": "Saucer Commander", "keywords": ["saucers", "ufo", "alien", "tower", "defense"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build a new tripod, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}", "short_description": "Invade your living room and keep all your saucers spinning in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_se
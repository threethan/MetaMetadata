964381050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1209905967714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W_LKHqZAe3QQ7kNvwHVpzot&_nc_oc=AdoFotL9jUIfY6WzDCHb-ddEczfaqwAYuiym1uOgGWt1nqFmHutw9kwuo9Ph_NO_KQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDX_TWCN6nY73FgACgYtgVfjNs9bg1WeyE6fGGvR9Hpmw&oe=6A4F8FB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-1440p.png", "id": "867619185693817", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827626_867619192360483_147268499530826403_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=znWxXYO4NtAQ7kNvwEwpOPC&_nc_oc=AdoTHu-SBIFboiDjU1hED449PWqKE24ES4_-n26Ph-fwOoyvWlexlERQh5KOH_66Tns&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAux67LUjjnKBUYEs1oWsKA6K8YYMIGw_OwLMBH0MFvuw&oe=6A4FA8B6"}, "display_name": "Saucer Commander", "keywords": ["saucers", "ufo", "alien", "tower", "defense"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build a new tripod, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}", "short_description": "Invade your living room and keep all your saucers spinning in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_se
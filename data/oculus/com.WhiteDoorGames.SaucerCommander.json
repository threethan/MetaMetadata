Zbz80NnZVJbKyGT2Scgc4bv369vJh6t9cQbMppzs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxaMQCLvxw_XvlUJtxGdLGLes6vj0Ijw_k4NO0YWyjv-Q&oe=69C13F8A"}, {"file_name": "Screenshot-02.png", "id": "1524210312152539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820441_1524210322152538_466917977597961700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q540NSYEuWEQ7kNvwEPiyAi&_nc_oc=Adq0Fd9E8APYVSCU7cNoq4Ta4j8E_SflZhq2kaiPt--N6nsli4fWytVF9wvudEC3EcE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzJJQMQE-syAB7S-IuCHZdrvIg5VX-2J53xQxgDmTZ3ow&oe=69C12C37"}, {"file_name": "Screenshot-06.png", "id": "823272524211017", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820875_823272527544350_3944514131614494974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kPxmwOClaVsQ7kNvwEV416z&_nc_oc=AdonKYVmayXgmAtqi7dDyNnZhZYS4s2m22zIxc0wPgQMKgNzlyUf7V_ZOMnLhxzui4k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afwx05IC1sIFllfHXzcXCMyyT26Uc29O0amL57VXRgOd3g&oe=69C12C63"}, {"file_name": "Screenshot-05.png", "id": "1209905964381050", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819239_1209905967714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ-icTdh5_cQ7kNvwGCiI0E&_nc_oc=AdrAUKLxr7CRHaL2nl-xHUsy_9OWOa59fWrayYx92tTBrQ26NQ_MA0BfFG06wdY5Lcg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfzqU07p995_9aJCAI0FJjHZG949CfiyNAUrK8Cuz62yUA&oe=69C12DB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_SaucerCommander.png", "id": "1959060144818155", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823746_1959060151484821_3111483554570488280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2kS536w9cf4Q7kNvwFdQYmn&_nc_oc=AdoqaIcSESjXe4WCyyIAMVftpGX08O1-XoohaGq1rbvl_NXYzqflOgpq-ukH2nzB1Y8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwPumnmj_-BhxRKBfMlpKjssR36m0_7q8qyqzFqY__AmQ&oe=69C145CA"}, "display_name": "Saucer Commander", "keywords": ["ufo", "tower", "mixed", "MR", "handtracking"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build new units, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}\n\n(Supports both hand tracking and Touch controllers).", "short_description": "Command an alien armada and invade your own living room in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3/3S."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support_website_url": null, "website_url": "https://saucer-commander.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256595765770357
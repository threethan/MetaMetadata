jeWv_mrZjfAjxVbY3s26wbnDtbLy5ieAYLp9GKEU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzeFPuEH-Xcg_o1A4TAYfxBG89FvHTCHDDpub9xNDVdJQ&oe=69B2BF0A"}, {"file_name": "Screenshot-02.png", "id": "1524210312152539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1524210322152538_466917977597961700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlsY04_MSpoQ7kNvwE2cvsH&_nc_oc=AdnpBYXi9Fq0KGWCVc8vTxTjiOFZG82QUjTBgmSaCS2_jRVr-f44nzjZnEWcMCvmxo4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyZqiLqlGpSBQQ3eGLYPMHTSSEjF4vJu_CL8wds9Ob3VA&oe=69B2ABB7"}, {"file_name": "Screenshot-06.png", "id": "823272524211017", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820875_823272527544350_3944514131614494974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8uwCIJDRrzoQ7kNvwHCqXhc&_nc_oc=AdnWUjicHPqgux8ARb54D_RuuU2C6NzNG_NMZaNVrBF7JXvBxYJExVEWYX8fkKUoPm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzUS8Tm4jaUKWBkbcSQOH1cNXCpHL85al47HnewmJMv9w&oe=69B2ABE3"}, {"file_name": "Screenshot-05.png", "id": "1209905964381050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819239_1209905967714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RwtUoOHzjS0Q7kNvwHzoKsa&_nc_oc=AdlwItTO957YaH_zylV50XaY6LNQk2Sn5-2s29Rzt3-eSHMv7mQ9HN62biG7UeTyOEY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfzLXBCl--xyJ7sGOPCwvOcO0UltuY2WA9JpCMomy02taQ&oe=69B2AD30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_SaucerCommander.png", "id": "1959060144818155", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823746_1959060151484821_3111483554570488280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZNPpsyKJOPAQ7kNvwEghHA7&_nc_oc=Adl1l289snoGHZ_k0bQ3S1iQnDOvJcZhHULviRgOb5fLoZXNbdRJZSvlV7NDeyUWqBg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afxwuf7VKBvMYLAUuVlVmE4E5d-a_uGQjaV_zSt7gMP9aQ&oe=69B2C54A"}, "display_name": "Saucer Commander", "keywords": ["ufo", "tower", "mixed", "MR", "handtracking"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build new units, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}\n\n(Supports both hand tracking and Touch controllers).", "short_description": "Command an alien armada and invade your own living room in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3/3S."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support_website_url": null, "website_url": "https://saucer-commander.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256595765770357
714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2Iiiv8d2T7QQ7kNvwEorfXc&_nc_oc=Admu_08ZjluYaILBXgZGPXGGXBHmK58kYypzk_ZaHo2XhE1sIJ3v9BfczHqPz09yq7Y&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDquDSk7UEyWkyGemEicFI-1BnKi-6l9zMXc56ku3JBQ&oe=69B6A1B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-1440p.png", "id": "867619185693817", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827626_867619192360483_147268499530826403_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lLwmNr6q6RMQ7kNvwElhZfL&_nc_oc=AdmaoscE76OkPe8VtEwpz1Rwa8fEidn62ry7uta3hNzX1C6EA93fLrCG7xbTum8PIRs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwiAnHNZgZEaA4w_956MxMAuSm6pJNr0HsQM69nuZJ1BQ&oe=69B6BAB6"}, "display_name": "Saucer Commander", "keywords": ["saucers", "ufo", "alien", "tower", "defense"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build a new tripod, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}", "short_description": "Invade your living room and keep all your saucers spinning in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support
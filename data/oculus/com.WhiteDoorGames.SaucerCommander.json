W5VuLREym42v5qYTwGrPkAJeAPFY-kVp2YVAI-Ys&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzuT6P71zY6PqBGoRjrHAsoX48X5maFTJW8hxXy1c3t7A&oe=69BBF98A"}, {"file_name": "Screenshot-02.png", "id": "1524210312152539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1524210322152538_466917977597961700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZZebUUi9-sQ7kNvwFbutDS&_nc_oc=Admyy2vS13Hz73KW6NaulC6xdc_W-XMquSwmny93aC6Q0A0mmLDzxxQe7eDcBdp8Xk4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzM5QtFC4eSdkjUyrAYvcJkddXfcl77QDuOc_F-BVKYmw&oe=69BBE637"}, {"file_name": "Screenshot-06.png", "id": "823272524211017", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820875_823272527544350_3944514131614494974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rLOTJnY5I_MQ7kNvwECx1vC&_nc_oc=AdmSQy_dWh_9HChnVRuIsXEw7uuMoy_SGlVn9F1ElqepvlqXTHPTkUhNl-wdLaOcbVA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxAlRIub6YUIJh6NSr3sNwJKudymT3mQm5oB1qxpCekVQ&oe=69BBE663"}, {"file_name": "Screenshot-05.png", "id": "1209905964381050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819239_1209905967714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UTMGmuSNdgQ7kNvwE8IXtB&_nc_oc=AdnX9Zmk1Loz6JCCMYtkqfwvyXSHhKQzkfd3-pfE1XgLD9S6QRxpXIMLRrhMBqXdc7c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_AfxTeY-l836i5uqak-H6bdqyU203HGnVjeNe1nzjUYtR2w&oe=69BBE7B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_SaucerCommander.png", "id": "1959060144818155", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_1959060151484821_3111483554570488280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lozq5A1sGsYQ7kNvwG4Vv-W&_nc_oc=Adk7OXUAZIgm9mMwN_NtbpbxPhwINkOrXGUrL7hc-8GIqzKSVgNh6jZ51xaIGliNHss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyqJMuXxt-eB0DCF9wmm1FVrPt9lPpm2DVncxxVk5ZpsA&oe=69BBFFCA"}, "display_name": "Saucer Commander", "keywords": ["ufo", "tower", "mixed", "MR", "handtracking"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build new units, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}\n\n(Supports both hand tracking and Touch controllers).", "short_description": "Command an alien armada and invade your own living room in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3/3S."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support_website_url": null, "website_url": "https://saucer-commander.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256595765770357
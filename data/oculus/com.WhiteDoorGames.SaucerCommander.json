nt-ord5-2.oculuscdn.com&oh=00_Afs-rckQkqARcCVEAOa97XOXsT1_cSU5dUx512CY5YhMGQ&oe=699B040A"}, {"file_name": "Screenshot-02.png", "id": "1524210312152539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1524210322152538_466917977597961700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1UkmVIdy1YQ7kNvwFC51xN&_nc_oc=Adn2r2UlyTVcknWLZBRU3hxwSL2r_sagCreGdr6nykVumsxAa9RjSn66_fZSC0S_4zA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftjtxAP5igg9pJe-RKXiYys2JtxHsZ1_G1oxZ-H2T1TWA&oe=699AF0B7"}, {"file_name": "Screenshot-06.png", "id": "823272524211017", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820875_823272527544350_3944514131614494974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oM_qLrLCd8oQ7kNvwH3-0lk&_nc_oc=AdnLdGmSsx0DdS1HDPjHXjfYXkmZm20s3pWIgvVrEMfJ6oLsSBO5elQ0-FGDRBVceSk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Aftqkxw0gwUT_udn_F6sXWVbh-5ntzhShFt90HW9-RuiCw&oe=699AF0E3"}, {"file_name": "Screenshot-05.png", "id": "1209905964381050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819239_1209905967714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1q1FjtWSW5UQ7kNvwHTKD-N&_nc_oc=AdlSsyDsxEUveJ1Yhr30SgZu4yIB6P-BNnWf4P__XODramW0-kH-0lVNjxEiwwl9JyM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfuO2tfYPWmid6m8thP1OJbZ70bZPxFqgLoz1ZUO5-Twiw&oe=699AF230"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_SaucerCommander.png", "id": "1959060144818155", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823746_1959060151484821_3111483554570488280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ScMjoBqMpyYQ7kNvwGsRTdu&_nc_oc=AdlwOXYt1Yw879uwPwNaTgqLoowHacWvtx7PfDKogd_3CHkwZPKx92DpewvesIcYskA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuFhUroGRTkC7W3y-QElXpTYB7xgXIJNMI2YtUMZnyLyg&oe=699B0A4A"}, "display_name": "Saucer Commander", "keywords": ["ufo", "tower", "mixed", "MR", "handtracking"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build new units, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}\n\n(Supports both hand tracking and Touch controllers).", "short_description": "Command an alien armada and invade your own living room in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3/3S."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support_website_url": null, "website_url": "https://saucer-commander.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25659576577035782"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5
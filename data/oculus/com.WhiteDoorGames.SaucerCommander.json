0jYpvUN1-d9kTlqrvSxq7rbM8yBkqWyEWdMwT28w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxVsts_7YHGld_ggguDsWP1ga0NPZtSmoF_dFz0ndV8-w&oe=69BAA80A"}, {"file_name": "Screenshot-02.png", "id": "1524210312152539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820441_1524210322152538_466917977597961700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZZebUUi9-sQ7kNvwE-xUQ9&_nc_oc=AdlWSQ2tGUJZjYwDk65sOwJjOM2KPVer-DmHGBwxVVcZLdz5vSUrSQiyeSKajoihhxc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_Afx93R2AC1veomkHaOt4vn8e69N1D6vN-HeHztSUsO13iA&oe=69BA94B7"}, {"file_name": "Screenshot-06.png", "id": "823272524211017", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820875_823272527544350_3944514131614494974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Te7OPLn30ogQ7kNvwE54_CH&_nc_oc=AdnjBXYqFvfmWWxDY4vc3wlCZ-c5B3sWdG7ZVSsuLTAAb_dWKW2zchy1rZFqYj5r5WY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxLWC2j44VAXpZDD8B2y2wwb_gDRZi_HebTiIsV7b3rNA&oe=69BA94E3"}, {"file_name": "Screenshot-05.png", "id": "1209905964381050", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819239_1209905967714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1UTMGmuSNdgQ7kNvwGFZY6A&_nc_oc=AdkayHZmGZSeg_Wji2ZuGWSvTbs_k6kZFUuv3WHY8Z_48Y7iThbTtSjBApAc4LqOV8c&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz7M-bs_U3h4aKLrmTZJZXMgW-Sq7V1-bchFfRxzvjTpA&oe=69BA9630"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_SaucerCommander.png", "id": "1959060144818155", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823746_1959060151484821_3111483554570488280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lozq5A1sGsYQ7kNvwGD-N_N&_nc_oc=Adn5AewR5PM9HI_vOu6-sATC4DgTHqaAjf7vZB9QxnZJYvUgy0au0xeCft3oFW8Dh-E&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfwhPN9vtbnGZX1mHxCT--VZ5UV8NESZBOt85UK3baGoNQ&oe=69BAAE4A"}, "display_name": "Saucer Commander", "keywords": ["ufo", "tower", "mixed", "MR", "handtracking"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build new units, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}\n\n(Supports both hand tracking and Touch controllers).", "short_description": "Command an alien armada and invade your own living room in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3/3S."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support_website_url": null, "website_url": "https://saucer-commander.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256595765770357
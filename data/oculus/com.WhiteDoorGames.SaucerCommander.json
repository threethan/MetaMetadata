nt-ord5-2.oculuscdn.com&oh=00_Afs4HfM5HrgaWS9YEgqwu6-DNvSO-tK4Ljk7DQGHOpxCEw&oe=69A43E8A"}, {"file_name": "Screenshot-02.png", "id": "1524210312152539", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820441_1524210322152538_466917977597961700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cjZk1aRYXLQQ7kNvwEaGd2B&_nc_oc=AdkCUHsFzd7BSDfooYF6u_kz-PH8PF5SlGiejUiMCymNoSgaYupOrrv1ItKF-Dd2wrI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftUVR0p6Mhp4z7NKeznIuuRyGpDCwORCboL59QtN7gssA&oe=69A42B37"}, {"file_name": "Screenshot-06.png", "id": "823272524211017", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820875_823272527544350_3944514131614494974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2DKtjwvOrwQ7kNvwE-c9BK&_nc_oc=AdkdYtlwJb_9ptBaQawKBHybTW3dOHT6L44H3kxl-DyNCVp1zaE9UMX3kpSqK5caYJw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvgO_ldCH1pSaMq4vGhLbr4l4HE7ykfcvL7MLbe9tStMA&oe=69A42B63"}, {"file_name": "Screenshot-05.png", "id": "1209905964381050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491819239_1209905967714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FQtl4yeYChoQ7kNvwGLmPQB&_nc_oc=Adm0eM9P9p3NO0iEBwswgn_x8Bm0tH8drrQCTyQ84VLgisE-3rAcZLLt_kOqSKqASe4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_Afuf_vnZuTkaKj2lgt1GFd3yzWDqg98Q9eXM7OkqLkjCrA&oe=69A42CB0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_SaucerCommander.png", "id": "1959060144818155", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491823746_1959060151484821_3111483554570488280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8y_JdnBIUgQ7kNvwE1yMVv&_nc_oc=AdlulRioTvDUjfHRwwreP-RVjKGXx5YTLBe6U_yNjTOw5iOzpanw-EBnpYC3r10HnDI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuuKl4-ATZd1v-U7LAhV8kBPig6xwIVZwrq0kV5Ax7XTQ&oe=69A444CA"}, "display_name": "Saucer Commander", "keywords": ["ufo", "tower", "mixed", "MR", "handtracking"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build new units, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}\n\n(Supports both hand tracking and Touch controllers).", "short_description": "Command an alien armada and invade your own living room in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3/3S."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support_website_url": null, "website_url": "https://saucer-commander.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25659576577035782"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5
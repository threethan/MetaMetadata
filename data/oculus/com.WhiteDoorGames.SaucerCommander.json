g5-2dbpmYwm8YoLMueZRYukpqj2l5871LbN3_opA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzWZrnWb5WfATm4A1tZhDM2AF_bkEDKZ8C81WeX_t0ULQ&oe=69AECA8A"}, {"file_name": "Screenshot-02.png", "id": "1524210312152539", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820441_1524210322152538_466917977597961700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9pTUyn3zc80Q7kNvwH_IaUS&_nc_oc=Adls3XmBRcJPIq_4s4J3kQHUOMBGuo4JZJ9YlwFR_bUQO-65Wij0V0XVou2AKuV8fFI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afw7zxywEEr5NhFxDc5QMuWTjmaKKfgycOd1BB7-Qhedmg&oe=69AEB737"}, {"file_name": "Screenshot-06.png", "id": "823272524211017", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820875_823272527544350_3944514131614494974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UGN4BwUeBVEQ7kNvwE-J90R&_nc_oc=Adny8jtIdGKfZSQu0WXj9_Ts6GlnhklBayJDSPF1dJAzoSbjjVwcHgIkQ37I0FcBfjE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxsU76BEzLk0s1hnURP-cs7-336wYo6Mv-HxYSAvDlvCw&oe=69AEB763"}, {"file_name": "Screenshot-05.png", "id": "1209905964381050", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491819239_1209905967714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wMsyB_9Fd4oQ7kNvwFHiThv&_nc_oc=Adk7P4MKZw91dpCHiofoFCvkFVh5Us4PHi5KQtOd_AF3L2Bi7UhB3M327D5nt4o_gzw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyD1DNwfeTGObQ_g5Ur3yoZK6xpHUw5rc0BgtnXVTTVIQ&oe=69AEB8B0"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_SaucerCommander.png", "id": "1959060144818155", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491823746_1959060151484821_3111483554570488280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZog4bzl340Q7kNvwHgRRXQ&_nc_oc=Adn7zXPSBKErJkyCwgimTC5zaB5Zu-Eee2mwb1HOA8MqCyTzvXFch2oyU0HJmgrgvDA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfygVvEnlqTIRTcCVR3xx0f6xjc34QqStQSaHCoAc6UBbQ&oe=69AED0CA"}, "display_name": "Saucer Commander", "keywords": ["ufo", "tower", "mixed", "MR", "handtracking"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build new units, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}\n\n(Supports both hand tracking and Touch controllers).", "short_description": "Command an alien armada and invade your own living room in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3/3S."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support_website_url": null, "website_url": "https://saucer-commander.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "256595765770357
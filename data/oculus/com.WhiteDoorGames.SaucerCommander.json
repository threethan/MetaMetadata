R7nVEqs4eTSW1bI0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WgK8eeP5lR66-C4r1FrYjsZA-C7wo77wI_mdFtQKPyw&oe=69F2070A"}, {"file_name": "Screenshot-02.png", "id": "1524210312152539", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820441_1524210322152538_466917977597961700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Gi_n0826ngQ7kNvwF-krQ1&_nc_oc=Adr3Lqq5FYvcXduwrAVkA3W3u1LDz2nkvqtwq4v-bIwrBj_9nWKL_V7OWxV2lSyhYNY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1eNbpsB0ZjkQkuzr4upUHP_n2SOQRr8OZ9wiUB6zU3-A&oe=69F1F3B7"}, {"file_name": "Screenshot-06.png", "id": "823272524211017", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820875_823272527544350_3944514131614494974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ES2LceiAKTgQ7kNvwE_2mXZ&_nc_oc=AdqntvAikdOlBYxfxws-S2P6qCD_MqiiLxImjScdlZBm-yNtkUynCcYTXXt_WinvU_k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0jox_hOVwyTarMP959WvoPmKShBt3EHqzSzG_yyM5jIA&oe=69F1F3E3"}, {"file_name": "Screenshot-05.png", "id": "1209905964381050", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491819239_1209905967714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGJypR7_6ZcQ7kNvwHYgzmQ&_nc_oc=AdqVtFpyiUHc6EPsvv4Yzr9oM3auSxJTePnxwoWuLZfftzGeKuJuIl2zsAEQSS1YcPY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3aDY_C-ulN74vOfE3PGNzOlNj4xfH--Xa-sQxw2IXUOQ&oe=69F1F530"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_SaucerCommander.png", "id": "1959060144818155", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823746_1959060151484821_3111483554570488280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XHuNneH8K0UQ7kNvwGOrf4U&_nc_oc=AdoJwWNRkvtw4h6BxMwtJQv21fdkgXqvbIwpJhLtKUejhHxXKszslm2gEA3x7if6fMg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Yc6x6SBxDwIoZPyfEdL4etR0gSrl6dnoL6QnPCvia0w&oe=69F20D4A"}, "display_name": "Saucer Commander", "keywords": ["ufo", "tower", "mixed", "MR", "handtracking"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build new units, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}\n\n(Supports both hand tracking and Touch controllers).", "short_description": "Command an alien armada and invade your own living room in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3/3S."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support_website_url": null, "website_url": "https://saucer-commander.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25659576577035782"}, "review_mes
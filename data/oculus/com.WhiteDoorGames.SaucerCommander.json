oculuscdn.com&oh=00_Afto8mix9b25x5jFUI8o5yA_-7MBakScADNSltciQUAfzA&oe=69A2DB30"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Trailer-Cover-1440p.png", "id": "867619185693817", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827626_867619192360483_147268499530826403_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3PWPUhGdcMQ7kNvwEy0YYM&_nc_oc=AdniZXVibCY2lDjy3e-NznPZ800gOm0kEaa7X8D81TSnmdtoXOVwnxs7N26trTWHvzk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afu_tNljAF7zr2e46SfM8Pl6gU4hFtPog7JlwLiJEFTJJQ&oe=69A2F436"}, "display_name": "Saucer Commander", "keywords": ["saucers", "ufo", "alien", "tower", "defense"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build a new tripod, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}", "short_description": "Invade your living room and keep all your saucers spinning in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support_website_url": null, "website_url": "https://saucer-commander.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"},
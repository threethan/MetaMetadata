=AdpVFv7xfpet_eamFuWiSpIIaZDDhrLeL23o1GDPpw1_V-OEaKesRpZHxC5o4ONQn-w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k8ih0jSMHQauBc3y4aE5ZPDkv8o-IkxvlT-RLvjPuPQ&oe=6A1EDA0A"}, {"file_name": "Screenshot-02.png", "id": "1524210312152539", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820441_1524210322152538_466917977597961700_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGDgrN64qcoQ7kNvwHvkJUR&_nc_oc=Adpf24WPYYtYWlkyho5Kzed7RQDjq0q_kuGhnBJrhIW9vlPJlWCXbUVxQh1saey6hiM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OaFXyl1qXTFjclVGu30nnEn5J2Drh_GF9Ne6fOqSY2Q&oe=6A1EFEF7"}, {"file_name": "Screenshot-06.png", "id": "823272524211017", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820875_823272527544350_3944514131614494974_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GUCZTau0GoMQ7kNvwFbDXDp&_nc_oc=AdpAeNZ4o2GqQVxL4sJ6GEXr-cWcsHXv9JF3J-q3AT-smND6tiWzddQA1oC899hsaJg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4WVQXOHggd0tJ4cRKsCMs5MnhtgQ9Eov0BRZ-VxFLf3g&oe=6A1EFF23"}, {"file_name": "Screenshot-05.png", "id": "1209905964381050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491819239_1209905967714383_4996711554762590040_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F2GOo-66zWsQ7kNvwFiBIbN&_nc_oc=Adok1UBwJgaHRcmHc_P9r2dTsqqBdVzYVeazgyjhJXZmOrQCpUQtC-3QAz08MAQfVeQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4w1JUkFSpQZQaV3OfPKhVBbRayYSdNnGPtiLsvTEcrNw&oe=6A1F0070"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover_Landscape_SaucerCommander.png", "id": "1959060144818155", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823746_1959060151484821_3111483554570488280_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5f3MVqlpO0kQ7kNvwHizdw-&_nc_oc=Adrn3iW7X3ECQZx1yQazlMrs3GhLPS9MwruS7fHsdgAXU20485HOE_dsk5bSRduoprY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vL2m20QdPXym03JuDTnk3mWu9ugTguO_T5evTTNHPWw&oe=6A1EE04A"}, "display_name": "Saucer Commander", "keywords": ["ufo", "tower", "mixed", "MR", "handtracking"], "long_description": "# Invade your living room\n\nCommand an alien armada and invade your own living room in this mixed reality action-strategy game! Position your saucers over a miniature town, and defend your Mothership from the incoming waves of human defenders.\n\n{1613174853284819}\n\n# Keep all your saucers spinning\n\nUpgrade your harvesters, build new units, activate your abilities, collect power pebbles... a true Commander must quickly learn how to be everywhere at once!\n\n{701913495844166}\n\n# Customize your fleet\n\nThe humans will keep deploying new tech, and so should you! Evolve your tactics with  more than 30 saucer variations and 8 Mothership abilities to choose from.\n\n{1223055599884052}\n\n(Supports both hand tracking and Touch controllers).", "short_description": "Command an alien armada and invade your own living room in Saucer Commander, a mixed reality action-strategy game for the Meta Quest 3/3S."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.whitedoorgames.com/privacy.html", "developer_terms_of_service_url": "http://www.whitedoorgames.com/tos.html", "publisher_name": "White Door Games", "support_website_url": null, "website_url": "https://saucer-commander.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction
t-iad6-1.oculuscdn.com/v/t64.5771-25/491821704_1580921693834100_4457119826377575688_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFn3O8mCOJkQ7kNvwG9VkLN&_nc_oc=AdokeSUP_cT5kkQqy_iPOD0HDpVyhQAGKQ30_xrgTGqDd7ZGqx5n3Npm9ynhOTBUXmY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCOtc7ELj2wapWqqi0mrijU1xr38gPgdnboCLWVDJWrw&oe=6AF5DDD5"}, {"file_name": "screenshot_5_2560x1440.png", "id": "1006594172486205", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825257_1006594179152871_8074026077833320025_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Gp58HB3jHcQ7kNvwEqfTdL&_nc_oc=Ado_05u_UxhvLKBmkNvIjDfevqVctFOcwUUjEXsG2KfzLqQ9i1np2jvVJfJu4AaUCEc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREv7ERX1oIWZ0CdmD2RyI34hQ6Em0YXkn9ZBU1uuR7pQ&oe=6AF5CBB4"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "28760206203650299", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823910_28760206213650298_8990242915453116506_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=48nBkebHAyIQ7kNvwF4TSLx&_nc_oc=AdphtgHNcNY3OMpGQEKGWKlTUTzO4gfMz3w95mJWt1sbHNhVdH-kRTp5ylB7UlhV_IM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYqbfS7uiqnv_4pvrtU0fzxCsg76r5S3wLVwkdwmzb2w&oe=6AF5D3D8"}, "display_name": "UR-EY Player", "keywords": ["IPTV", "M3U", "Xtream", "Player", "Streaming"], "long_description": "UR-EY Player is a media player for watching the streams from your own playlist service on a big, resizable panel in Meta Quest, and on your phone, tablet and Android TV.\n\nIMPORTANT: UR-EY Player does not include or sell any channels, movies, series or streams. You need an Xtream Codes account or an M3U playlist from a provider you are entitled to watch.\n\nONE ACCOUNT, EVERY SCREEN\n\u2022 Sign in by scanning a code with your phone. No typing in the headset.\n\u2022 Playlists, favorites and watch progress sync across all your devices.\n\u2022 Manage playlists and channel order at ureyplayer.com.\n\nBUILT FOR QUEST\n\u2022 Point and pull the trigger to choose; A opens the channel list, B goes back, X plays and pauses.\n\u2022 Thumbstick up and down switches live channels.\n\u2022 Resize the window or use the wide, curved view.\n\nA CAPABLE PLAYER\n\u2022 Live TV, movies and series with posters, Continue Watching and search.\n\u2022 HLS and MPEG-TS, audio and subtitle selection, resume and next episode.\n\u2022 Automatic reconnect when a live stream stalls.\n\nMAKE IT YOURS\n\u2022 Favorites, custom channel order, hidden and PIN-locked categories.\n\u2022 10 languages.\n\nPRIVACY\n\u2022 No ads, no tracking. Playlist profiles are encrypted on our server. Delete your account at any time.\n\nYou are responsible for having the rights to the streams you add.", "short_description": "Watch the streams from your own M3U or Xtream Codes playlist on a big, resizable screen in Meta Quest. One account for your headset, phone, tablet and Android TV. UR-EY Player does not include any channels or content."}]}, "developer_name": null, "developer_privacy_policy_url": "https://ureyplayer.com/privacy", "developer_terms_of_service_url": "https://ureyplayer.com/terms", "publisher_name": "UrEy", "support_website_url": null, "website_url": "https://ureyplayer.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr", "pt_BR", "es", "fr", "it", "de", "id", "pl", "ru"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes":
f993z1As4Fquw_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRuld5uGfz2OsK35PrdYduamukvSr_XYx7IegseBD_HVg&oe=6B0DB0BE"}, {"file_name": "captura_tienda_04.png", "id": "1637423051188496", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/596149727_1637423054521829_417958329295471931_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ri7mQPrt8DQQ7kNvwHO6XB_&_nc_oc=AdqzR25Ewuro3po-qB3uZnlB_k_8mB63NafktKDzupVD7A060IiYlU63G2YA28rbDiU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQcpvNCiwhNVSKWcYqgjFSpMPNccTXvhZKaO82wWIJ84Q&oe=6B0DC887"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "8_trailer_portada_2560x1440.png", "id": "1351322268069475", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673652249_1351322271402808_2902802580444003394_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HSgpaN3mY6kQ7kNvwFYloZX&_nc_oc=AdrkLhP787JZJZ0qZd0QvV_jHXrt-jjSMSAGUqGSa97ZkPnLEF1-kQsKPWIR4kVhnqo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRaOBs2zOKlh-ayP2T0y8XhU5P33CM8I0mW_RRA5I32kA&oe=6B0DC95A"}, "display_name": "Snail Skater XR", "keywords": [], "long_description": "Put on your headset and become the slowest... and fastest skater in the world!\n\nSnail Skater XR drops a skating snail into your room with mixed reality. Race tracks packed with ramps, rings and turbo boosts, land tricks in the air, and chase the best line on every lap.\n\nFEATURES\n- Mixed reality skating: the game blends with the space around you.\n- Ramps, rings and turbos: tracks designed for speed and big jumps.\n- Air tricks: pull off stunts and keep your momentum.\n- Three bot levels: Easy, Medium and Pro, so there is always a rival at your level.\n- Day and night races, chosen at random, with glowing lights and turbos.\n- Collect tomatoes and unlock upgrades.\n- Available in English and Spanish.\n\nNo ads and no in-app purchases. We do not collect any personal data.\n\nComfortable for everyone: simple controls, short races and easy to pick up. Play standing or seated in a clear space.", "short_description": "Skate as a snail in mixed reality! Race ramp-filled tracks by day and night, land air tricks, beat bots on three difficulty levels and unlock upgrades."}, {"images": {"nodes": []}, "id": "2271650296738197", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Snail Skater XR", "keywords": ["skate", "patineta", "caracol", "carreras", "mixta"], "long_description": "Snail Skater XR es un juego de skate en realidad mixta para Meta Quest 3 y Quest 3S. Ponte las gafas y convi\u00e9rtete en el skater m\u00e1s lento... y m\u00e1s veloz del mundo: un caracol sobre una patineta que aparece en tu propio espacio.\n\nCorre por pistas llenas de rampas, anillos y turbos, haz trucos en el aire y busca la mejor l\u00ednea en cada vuelta. Compite contra bots de tres niveles (F\u00e1cil, Medio y Pro) y desbloquea mejoras recogiendo tomates.\n\nCARACTER\u00cdSTICAS\n- Realidad mixta: el juego se mezcla con el espacio que te rodea.\n- Rampas, anillos y turbos: pistas pensadas para la velocidad y los grandes saltos.\n- Trucos en el aire para mantener el impulso.\n- Tres niveles de bots: F\u00e1cil, Medio y Pro.\n- Carreras de d\u00eda y de noche, al azar, con luces y turbos brillantes.\n- Tomates y mejoras por desbloquear.\n- Disponible en espa\u00f1ol e ingl\u00e9s.\n\nSin anuncios, sin compras dentro del juego y sin recopilar datos personales. Controles sencillos y carreras cortas: f\u00e1cil de aprender, divertido para todos. Ideal para jugar sentado o de pie en un espacio despejado.\n\nSi te gustan los juegos de skate, de carreras y de realidad virtual o mixta en Quest, Snail Skater XR es una forma distinta y muy divertida de patinar.", "short_description": "Juego de skate en realidad mixta: patina como un caracol, haz trucos en rampas, compite de d\u00eda y de noche contra bots y desbloquea mejoras."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.aumentadosco.com/caracol-skater-xr-privacidad/", "developer_terms_of_service_url": null, "publisher_name": "Aumentados", "support_website_url": null, "website_url": "https://www.aumentadosco.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es_CO", "es_MX", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1765070208120761"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "4129391570687119"}]}, "baseline_offer": {"id": "4129391570687119"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1793991300, "status": "PUBLISHED", "id": "4129391570687119"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1772209017406880", "version": "1.0.0"}, "id": "2947618268924380", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1765070204787428", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1772209017406880"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "2947618268924380"}]}, "change_log": null, "created_date": 1793197541, "id": "177220901
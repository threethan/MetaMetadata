_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OWSFHCEYRoEQ7kNvwFLI0Dk&_nc_oc=AdqkUCKTWOE5sr1PqChB4xRtXUi4OyYGg5DzKHkZ4xBrTlNG4PsIJ0oG98Kj0_XI4ig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-BTdn8cYqc2CdpIeebbOZtq4z8Gv8RXkl4JNxhtVv2w&oe=6AFC7FF1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Combat Camp Shooting", "keywords": [], "long_description": "\nCombat Camp Shooting is a simple and exciting shooting game set in a combat training camp. Players can test their aiming and shooting skills by taking on different targets and completing challenging shooting tasks.\n\nImprove your accuracy, reaction time, and shooting performance as you progress through the training environment. With simple gameplay and easy-to-understand controls, Combat Camp Shooting provides an enjoyable shooting experience for players who like action and target-based challenges.\n\nFeatures:\n\n- Combat training camp environment\n- Target shooting gameplay\n- Simple and easy controls\n- Accuracy-based challenges\n- Fun and engaging gameplay\n- Challenging shooting missions", "short_description": "\nCombat Camp Shooting is an exciting shooting game where players practice their shooting skills, aim at targets, and complete challenging combat missions."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/top-art-games/home/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Top Art Games", "support_website_url": null, "website_url": "https://sites.google.com/view/top-art-games/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphi
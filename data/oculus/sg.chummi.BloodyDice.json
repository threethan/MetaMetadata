u56fe1.png", "id": "1464445738424463", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618103_1464445741757796_4181123987956802088_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W6zZtd7mZ4cQ7kNvwEaLUzS&_nc_oc=AdoMZIaHT_1nm833UhHttHHkpBpMfVluLr1Dj4Evx8RrjL_2F8_LsuO3ANXHYAzfGqY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSwyRO54knh250E1IQf5E4FXmwqGUnXD9LJ8OclZughA&oe=6A6DD50B"}, {"file_name": "\u622a\u56fe4.png", "id": "27441624112094101", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618093_27441624122094100_8734755796455335990_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPB7kMo_3JcQ7kNvwHPDVBo&_nc_oc=Adp1EHpwvmnQYLFvyW0EXnbBxwMPPjHzKYO8jGYVaGm2Vpibcvua5eMDYjiNKtwM8yA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDNbzLKPzXGiVQny8wW6FlcIFam6nY1lsjKyqo8pbaNqw&oe=6A6DDAAD"}, {"file_name": "\u622a\u56fe5.png", "id": "969371279108710", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298248_969371285775376_502370745858510471_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E9xTe_LUcpkQ7kNvwFiSrJb&_nc_oc=Ado4Oh36vbprLNIYIJDyvS0IzMPzyVkzXZgOrYxbowl4gIEVzSGowavnt3WIwZ6j-ZY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCO7TZ2QsY1dV90WC-onLtNYGFp-trmvCi2mLxCXXCM-w&oe=6A6DFAEC"}, {"file_name": "\u622a\u56fe3.png", "id": "1485925936511579", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499617729_1485925943178245_2623227013735594102_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yUiymsOtzT4Q7kNvwE8q67_&_nc_oc=AdpSpWX-X56WrAD6fNXTaBO2yNAbXpZunN_IIsouF2xhGAIIjLiiTdFRgAiU6Czqnuw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDi-toqUeDThr3FafbaScZP0Jv-YXzGH3pfof5R1efoug&oe=6A6DF437"}, {"file_name": "\u622a\u56fe2.png", "id": "950995167640268", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499618277_950995170973601_3570033635091394420_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nRF-cOIHrCwQ7kNvwGsq0a2&_nc_oc=AdoS8eLZ9Yth9KHNfyRF6hATN1_pY3H-aguTxP45liMYZdRjy9hGSZOqp4iqoXML9K8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKhIORKTLEv5MVOo2igNbbhJM0Z5eB0UoBynSMxQdxmA&oe=6A6DDC9C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bloody Dice", "keywords": ["Dice", "PvP", "Strategy", "Horror", "Psychological"], "long_description": "Bloody Dice is a 1v1 VR dice duel where every roll can change the outcome.\n\nAt the start of each round, both players roll one hidden die. From there, you take turns choosing whether to roll again or stop. Every later roll is visible to both players, but your hidden die keeps your true score uncertain until the end.\n\nThe goal is simple: get as close to 25 as possible without going over. But every choice comes with pressure. Roll again, and you might bust. Stop too early, and your opponent may take the lead.\n\nWhen both players stop, the hidden dice are revealed and the final scores are compared. Lose a round, and you may face a punishment roll, adding long-term tension across the match.\n\nBuilt for virtual reality, Bloody Dice turns a simple dice game into a tense face-to-face showdown. Grab the dice, read your opponent, and decide when to take the risk.\n\nWill you stop in time, or roll once more?", "short_description": "Step into a deadly VR game of dice where every roll carries real consequences.\n\nIn Bloody Dice, you face another player in a tense duel of chance and strategy. Roll carefully, stop at the right moment, and try to get as close to 25 as possible\u2014without knowing your true total.\n\nBut losing isn\u2019t just a setback. Each defeat may trigger a punishment, and with only six chances to survive, every decision matters.\n\nWill you play it safe, or risk everything for one more roll?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.chummi.sg/bloody-dice", "developer_terms_of_service_url": null, "publisher_name": "CHUMMI PTE. LTD", "support_website_url": null,
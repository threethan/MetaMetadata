t-iad6-1.oculuscdn.com/v/t64.5771-25/491821796_1603052224305721_3619479479972414921_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Ix7PRLnjyYQ7kNvwGZ56Sb&_nc_oc=AdpZnKCzNw6zo2uOmwomIZu0FhkMtoIgucPyE_qXMV0Wtp254FjsIIU3RJQqQQDKziA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQR4VgCjodEBfgAvZbCKPSkDt9HWdNnbKxTfG8EugepDA&oe=6B0C4FD0"}, {"file_name": "gm3.png", "id": "1142939798251462", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823757_1142939801584795_2417809002382971442_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aBda4rMyUSQQ7kNvwHGIAZM&_nc_oc=AdobThIUqPrX92KWpI44E2AK012jAJzj1dxyUQTErZ7I8MhF6HuRU94yGrcfCCq2Vc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSI-cZgJ79xrlKKpIPh8FexKf9zXWrW64Ttr_RWk9Z5CA&oe=6B0C505D"}, {"file_name": "gm4.png", "id": "1582474780302974", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825575_1582474783636307_218564576281836944_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t1M5_WHzFDgQ7kNvwFwVlVs&_nc_oc=AdosfrcS-L-trUo58WDJ5CpGPXhsB5sj7xoo0pMxBUdPJVwuWSD2PARtdGYupj7WqYQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRvzH47bTiOQmmPp4GsPtiUpBEJqW08u4UgJX8JxXZoqg&oe=6B0C7767"}, {"file_name": "gm5.png", "id": "1473276414727123", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_1473276418060456_7223992620323038197_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q3dsDRCsjdAQ7kNvwEAzKjV&_nc_oc=Ado778xaqqHh8YKXIoir-9zJ-z2qs29hGM8T3sjmmmJT1BzCx_ikvnKHqCy-neKzrzk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQW0p_7Peo43z1kKUEiIlvGhL4CWhNyc3rLxPcCkkEs3A&oe=6B0C68EF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "video-kapak.png", "id": "2413235465873730", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824292_2413235469207063_9143874291579208736_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F5gR3LiIdjsQ7kNvwHyVgLK&_nc_oc=Adq_LQB6DAAMU_aGoxC-ABGm9HXM_vaS_TilBbeWwqY8lrmJlrpQX7MDF8Goq0lcwUs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS2k48Om2iASVRxhLiL6g4Tf02JFCaCZMZ5TYz9fWKq4Q&oe=6B0C80D2"}, "display_name": "Violet Siege: Tower Defence VR", "keywords": ["towerdefense", "vrstrategy", "alienshooter", "crystaldefense", "defense"], "long_description": "Your defenses won't hold on their own. In **Violet Siege: Tower Defence VR**  a glowing crystal core is all that stands between your outpost and a relentless swarm of alien spiders.\n\nBuild your defense, then take up your weapon and cover the gaps yourself.\n\n{1633024202172123}\n\nPlace laser, cannon and cryo towers to hold back the swarm. Manage crystal resources and reactor energy, choose your upgrades and support your towers with direct fire.\n\nSave your one-use Plasma, Cryo and Storm charges for critical moments. The left-side armoury gives you three powerful ways to turn a desperate wave around.\n\n{1622994718987692}\n\nPlay a 14-level Arcade campaign across the violet outpost and emerald forest. Learn the controls and core systems in the guided, hands-on tutorial, or test how long your defenses can last in Endless mode.\n\nChoose fully immersive VR or bring the detailed tabletop battlefield into your own space with mixed reality. Plan your strategy, react under pressure and protect the crystal yourself.\n\n{1474414924558647}\n\nThe siege has begun. **Will your defense line survive?**", "short_description": "Build the towers. Take the shot. Defend the crystal. Violet Siege blends VR tower defense strategy with hands-on shooting, alien spider waves, and immersive VR or mixed reality battles."}, {"images": {"nodes": [{"file_name": "02_kristal_savunmasi.png", "id": "2527252541104504", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827626_2527252547771170_1788776233495267792_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JlAV5UuxHOYQ7kNvwFxwsdv&_nc_oc=Adr_E0R2mkyZsTVLbf1lysOldh-aSh2aNZbttatkEuOvCewSS427WzDEQptO--YkAhE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRKPTA-CWTD6wiLcBgK_LXyAUM8mju-S91JCPH64TrYog&oe=6B0C63B8"}, {"file_name": "03_iki_farkli_dunya.png", "id": "2012001276154311", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823790_2012001279487644_3304618990789040131_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oW1XP92rrdwQ7kNvwF8FvBZ&_nc_oc=AdpKvPtFGXm4kwps8woMqafuhhlSn5voksjZjRejrVNVv_Dr4NVS0SZgorp-uTUAUbA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQVR9hixYKDc8KxAque0qmecIsDF2jZoWnjHkv97VGwBA&oe=6B0C4F7B"}, {"file_name": "01_kule_stratejisi.png", "id": "1789450658943310", "image_type": "APP_IMG_MARKDOWN_INLINE", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825470_1789450665609976_4158242294385703000_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SzIheC8wvDcQ7kNvwFfvwsD&_nc_oc=AdrxgVAki49G--02CBVGcMsfpUql-4hH2I5HzJVj2zcfhlvoZ2PIgzfUHE91U1uBMik&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQxnXBTDw6SGVDiGdc_81OP0V7ZuwFAYPBL6JTA7OKXcA&oe=6B0C60B1"}]}, "id": "2209754722915892", "locale": "tr_TR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Violet Siege: Tower Defence VR", "keywords": ["vrstrateji", "uzaylioyunu", "kule", "savunma", "tower"], "long_description": "Savunma hatt\u0131n tek ba\u015f\u0131na dayanamaz. **Violet Siege: Tower Defence VR**\u2019da \u00fcss\u00fcn ile durmaks\u0131z\u0131n ilerleyen uzayl\u0131 \u00f6r\u00fcmcek s\u00fcr\u00fcs\u00fc aras\u0131nda yaln\u0131zca \u0131\u015f\u0131ldayan bir kristal \u00e7ekirdek var.\n\nBu VR kule savunma oyununda hatt\u0131n\u0131 kur, silah\u0131n\u0131 ku\u015fan ve a\u00e7\u0131klar\u0131 bizzat kapat.\n\n{1789450658943310}\nLazer, top ve kriyo kulelerini stratejik noktalara yerle\u015ftir. Kristal kaynaklar\u0131n\u0131 ve reakt\u00f6r enerjisini y\u00f6net, kulelerini geli\u015ftir ve kendi silah\u0131nla savunmaya destek ol.\n\nTek kullan\u0131ml\u0131k Plazma, Kriyo ve F\u0131rt\u0131na sald\u0131r\u0131lar\u0131n\u0131 kritik anlara sakla. Solundaki cephanelik, zor bir dalgan\u0131n gidi\u015fat\u0131n\u0131 de\u011fi\u015ftirebilecek \u00fc\u00e7 g\u00fc\u00e7l\u00fc se\u00e7enek sunar.\n\n{2527252541104504}\n\nMor \u00fcs ve z\u00fcmr\u00fct orman boyunca uzanan 14 b\u00f6l\u00fcml\u00fck Arcade modunda m\u00fccadele et. Rehberli, uygulamal\u0131 e\u011fitimde kontrolleri ve temel sistemleri \u00f6\u011fren veya Sonsuz modda savunman\u0131n ne kadar dayanaca\u011f\u0131n\u0131 test et.\n\nTamamen sanal bir d\u00fcnyaya dalmak i\u00e7in VR deneyimini se\u00e7 ya da karma ger\u00e7eklikle detayl\u0131 masa\u00fcst\u00fc sava\u015f alan\u0131n\u0131 kendi ortam\u0131na ta\u015f\u0131. Stratejini kur, bask\u0131 alt\u0131nda karar ver ve kristali bizzat koru.\n\n{2012001276154311}\n\nKu\u015fatma ba\u015flad\u0131. **Savunma hatt\u0131n ayakta kalacak m\u0131?**\n\n\n\n", "short_description": "Kulelerini kur, silah\u0131n\u0131 ku\u015fan, kristal \u00e7ekirde\u011fi savun! Violet Siege; stratejik kule savunmas\u0131n\u0131 aktif VR \u00e7at\u0131\u015fmas\u0131yla birle\u015ftiriyor. Uzayl\u0131 \u00f6r\u00fcmcek dalgalar\u0131na VR veya karma ger\u00e7eklikte kar\u015f\u0131 koy. "}, {"images": {"nodes": []}, "id": "1564353235718669", "locale": "en_GB", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Violet Siege: Tower Defence VR", "keywords": ["towerdefence", "vrstrategy", "mixedreality", "alienwaves", "crystaldefence"], "long_description": "The crystal is the last light on the defence line. Violet Siege: Tower Defence VR puts you in command of a futuristic outpost under attack by waves of alien spiders. Build a clever network of laser, cannon and cryo towers, balance crystal resources with reactor energy, and take up your own weapon when the defences need help. The left-side armoury gives you limited-use Plasma, Cryo and Storm attacks for the moments when a single decision matters. Work through a 14-level Arcade campaign spanning a violet outpost and an emerald forest; learn the controls in the guided tutorial; or see how long your tactics last in Endless mode. Choose immersive VR for the full sci-fi setting, or use mixed reality to place the detailed battlefield in your room. This is more than watching towers fire: plan the defence, react under pressure and protect the core yourself. The next wave is already on its way.", "short_description": "Hold the line in a tactical VR tower defence game where you build towers and join the fight yourself. Guard the crystal against alien spider swarms in VR or mixed reality, one wave at a time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://wizardmedya.com/violetsiege/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Wizard Medya - AEY", "support_website_url": null, "website_url": "https://wizardmedya.com/violetsiege/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "tr"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1390637120806693"}, "review_m
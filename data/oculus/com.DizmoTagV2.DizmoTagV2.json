592286685718694585_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vuc7RsC5lQQ7kNvwFg0msn&_nc_oc=AdqQSm1w9Vgi8aztD615aDQtpAWYw2eboqPL3S2KldzkMosbGKuGba4I_EBazk9K-EI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9E4jAiAMNw2Yqz5f_clk8ThWXGPkHLbT2HtZ7FU2g7kA&oe=6A2EA4D3"}, {"file_name": "Screenshot5FIX.png", "id": "582922424866113", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499312032_582922428199446_4379498238582008023_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DkqhRSELQt4Q7kNvwEpzYcu&_nc_oc=AdoWD_hYYriUC3n-HjYf1Xnu43QifP7aQQCQOMZ8M2U_PqLTiSXg6F2r4Vydk-4vyq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ik7aXA96xwFPdvv7rD2paAez6hBj5reM7D6k-RC3JrA&oe=6A2EABA0"}, {"file_name": "Screenshot2FIX.png", "id": "1252380796602047", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830460_1252380799935380_2653668641342142608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mox4b0ar1esQ7kNvwEEZd0C&_nc_oc=Adr49Ph0MNPwGWH_1L8BejyOtVs-S-CbHGjmLlcGS2WmiyF1hi2VDQhs9S4hY5vaVv0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8bI9erZ1TqHGCyYPvEjReT6iV0YXMhSkanE3cSOsVM9g&oe=6A2ECEAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dizmo Tag V2", "keywords": [], "long_description": "In Dizmo Tag v2, you\u2019ll master a unique physics-based locomotion system that lets you run, jump, climb, and vault through fully explorable 3D environments. Whether you\u2019re racing through a dense forest map, scaling walls in a neon-lit arena, or sneaking through tight alleyways in an urban setting, every surface is a playground\u2014and every player is your target or your pursuer.\n\nBuilt from the ground up with community feedback in mind, Dizmo Tag v2 introduces new maps, smoother mechanics, and a growing library of custom cosmetics and skins to personalize your primate. Jump into lobbies with friends or match up with strangers for high-speed tag showdowns that test your agility, awareness, and creativity.", "short_description": "Dizmo Tag v2 is a fast-paced, multiplayer VR fan game inspired by Gorilla Tag. Dive into a vibrant world of parkour-style tag where you run, jump, and climb using nothing but your hands. With enhanced movement mechanics, unique maps, and a growing collection of custom cosmetics, Dizmo Tag v2 delivers high-energy fun and endless replayability."}]}, "developer_name": "CJ", "developer_privacy_policy_url": "https://sites.google.com/view/dizmotagv2privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "CJ", "support_website_url": null, "website_url": "https://sites.google.com/view/dizmotagv2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23881490288150545"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499298205_705121622410641_756073568088139069_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4epwZWcasXEQ7kNvwG1OC0I&_nc_oc=AdrKTYWeape7Q7NCbGJ7oW0qYo-lqVRGvcsnvupefuBa2bKHhskHzL9od4FK5XPNUIs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9nqT1paN4_MGfPy4OV1GIkrx6rfDjAYZwBEXzGD2vo0g&oe=6A2EBBD7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dizmo Tag V2", "platform": "ANDROID_6DOF", "context_category": {"context_ca
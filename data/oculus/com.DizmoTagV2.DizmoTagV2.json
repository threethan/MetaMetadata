&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LoFeIRa_qPMQ7kNvwG2Iwp8&_nc_oc=Adm4vS2m2m1_k85OKuJBzA6Jd-P0p0o7XeO9B4b5mmg5mxAyAj4W2wk_bpS-0JPxnpk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXxdu7VuL3ntwINxy_jrb-3boMhgsYBRkHnzbMP7AhiQ&oe=69AC2053"}, {"file_name": "Screenshot5FIX.png", "id": "582922424866113", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499312032_582922428199446_4379498238582008023_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOpswNEs3BwQ7kNvwGlDKyF&_nc_oc=AdmSARc300gEO8j3BJyBIt3Pg6UB2JGKeJijW4Ni6nqK4davozJLAHCFbw0SraP_VYE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxhaF3DgyVDZWGx0MEyysc-TTvw0hQx6EkkaR8xTOF8xA&oe=69AC2720"}, {"file_name": "Screenshot2FIX.png", "id": "1252380796602047", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491830460_1252380799935380_2653668641342142608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qD3zKFTv-qMQ7kNvwFMHTO3&_nc_oc=AdkmF0scsMt_P2xGm5BsdSnH40JnCHOGN7JbqbgAoMy-3Pz7TsJTRs2B-9UkRlRAT_Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afydbj-YamrgZsp37h2iNo4NbX6MdYt5Xetapk8Ht8pJIQ&oe=69AC11EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dizmo Tag V2", "keywords": [], "long_description": "In Dizmo Tag v2, you\u2019ll master a unique physics-based locomotion system that lets you run, jump, climb, and vault through fully explorable 3D environments. Whether you\u2019re racing through a dense forest map, scaling walls in a neon-lit arena, or sneaking through tight alleyways in an urban setting, every surface is a playground\u2014and every player is your target or your pursuer.\n\nBuilt from the ground up with community feedback in mind, Dizmo Tag v2 introduces new maps, smoother mechanics, and a growing library of custom cosmetics and skins to personalize your primate. Jump into lobbies with friends or match up with strangers for high-speed tag showdowns that test your agility, awareness, and creativity.", "short_description": "Dizmo Tag v2 is a fast-paced, multiplayer VR fan game inspired by Gorilla Tag. Dive into a vibrant world of parkour-style tag where you run, jump, and climb using nothing but your hands. With enhanced movement mechanics, unique maps, and a growing collection of custom cosmetics, Dizmo Tag v2 delivers high-energy fun and endless replayability."}]}, "developer_name": "CJ", "developer_privacy_policy_url": "https://sites.google.com/view/dizmotagv2privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "CJ", "support_website_url": null, "website_url": "https://sites.google.com/view/dizmotagv2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23881490288150545"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499298205_705121622410641_756073568088139069_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=haFW0CRcZjwQ7kNvwEme_d0&_nc_oc=AdkT8GjY8FuVKQifOjVLEEyiBIV3UXwEag1KQoTOkXGo1hjaRFSZRriPj4MykCOuZFs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxdbnzxyKT9IakH0gsUVME4AnTDBu4osHggZrvMs6qa5Q&oe=69AC3757"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dizmo Tag V2", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "contex
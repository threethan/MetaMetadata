om&_nc_ss=7f20f&oh=00_AQRJO9-YCqqOa_kq09aVjN4UhRPGv111hjfIV1NJ8mBNjg&oe=6B08402D"}, {"file_name": "Screenshot4FIX.png", "id": "1273704554100677", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822817_1273704557434010_8592286685718694585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b4UZ82pVF9MQ7kNvwFw0lpw&_nc_oc=AdrOmwWO76yY-I_6qTPTm7BhR--YsbG5vMKH8CjXI5wPk4x4BGfnrmkDngjZ3oNkn60&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXmHBy5DRZCPIFs76WufVvTdgtIDFXYJ7_aRqDyTnIgQ&oe=6B086493"}, {"file_name": "Screenshot5FIX.png", "id": "582922424866113", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499312032_582922428199446_4379498238582008023_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CSBZuyOe7yYQ7kNvwGWr9_U&_nc_oc=AdqslmvtVmiRuUHWuQFw14F3qsS-rNZApYCz5eMm9vHdNRxoVaZTXClVdnLGCrvDFoo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQGhauGqH8KaWrG0JwzBPVhQBnT8NQOhb3eKziJ3eScw&oe=6B086B60"}, {"file_name": "Screenshot2FIX.png", "id": "1252380796602047", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491830460_1252380799935380_2653668641342142608_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IFUWOCvhdqsQ7kNvwHspD3N&_nc_oc=Adog6HJsDQ2Pjv7YrgCFaYzKiOlW9vVmDw1HVAxDvKZ_cIng14EIGaQIgrmfgA3mtcw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWYpsG9br9ufgMS6PVLd4Ss1BvNvHtlkcVzCjJB2zNWQ&oe=6B08562E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dizmo Tag V2", "keywords": [], "long_description": "In Dizmo Tag v2, you\u2019ll master a unique physics-based locomotion system that lets you run, jump, climb, and vault through fully explorable 3D environments. Whether you\u2019re racing through a dense forest map, scaling walls in a neon-lit arena, or sneaking through tight alleyways in an urban setting, every surface is a playground\u2014and every player is your target or your pursuer.\n\nBuilt from the ground up with community feedback in mind, Dizmo Tag v2 introduces new maps, smoother mechanics, and a growing library of custom cosmetics and skins to personalize your primate. Jump into lobbies with friends or match up with strangers for high-speed tag showdowns that test your agility, awareness, and creativity.", "short_description": "Dizmo Tag v2 is a fast-paced, multiplayer VR fan game inspired by Gorilla Tag. Dive into a vibrant world of parkour-style tag where you run, jump, and climb using nothing but your hands. With enhanced movement mechanics, unique maps, and a growing collection of custom cosmetics, Dizmo Tag v2 delivers high-energy fun and endless replayability."}]}, "developer_name": "CJ", "developer_privacy_policy_url": "https://sites.google.com/view/dizmotagv2privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "CJ", "support_website_url": null, "website_url": "https://sites.google.com/view/dizmotagv2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23881490288150545"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499298205_705121622410641_756073568088139069_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFhDUzkDvAgQ7kNvwHJeorT&_nc_oc=Adoukjrnhb_HHly6AHg
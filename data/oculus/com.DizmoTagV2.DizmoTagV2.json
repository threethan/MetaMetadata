4557434010_8592286685718694585_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umUrDPE4jrgQ7kNvwF6P36i&_nc_oc=Adp7VQVvRHv541FoIAWwKXpOK8khCY316-9dBNRCTtC_BViWOUs7wqLqhx_jvgodC9M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFwAW4RzPycd1WfAS3NprANgA02OpfLOPwfiiiWkfLBvA&oe=6A8EE253"}, {"file_name": "Screenshot5FIX.png", "id": "582922424866113", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499312032_582922428199446_4379498238582008023_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ib6daZrjP74Q7kNvwFD3zRU&_nc_oc=Adp2eroYn0YQIXilRuOIYnSCjjKAek15jI3S5kT_psk3gm0oyg0MrsIl7YyxPpZak50&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFT8O9M8eRg92mcR7re-Hrmm7TiqlQg0-4jWjyQfFEihA&oe=6A8EE920"}, {"file_name": "Screenshot2FIX.png", "id": "1252380796602047", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491830460_1252380799935380_2653668641342142608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqgGJZaEAW0Q7kNvwFS-hO1&_nc_oc=AdqF2mtd7xeARIk2Km2Mo6DNetSPR6ddfPcLnvE5JjXdzrbi-0rXAbQUm_jpGYtFEFo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-T8DL3Wy4VI-Hc3kWQgGhCcR8XmMEBi-CUcpIeUgqeQ&oe=6A8ED3EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dizmo Tag V2", "keywords": [], "long_description": "In Dizmo Tag v2, you\u2019ll master a unique physics-based locomotion system that lets you run, jump, climb, and vault through fully explorable 3D environments. Whether you\u2019re racing through a dense forest map, scaling walls in a neon-lit arena, or sneaking through tight alleyways in an urban setting, every surface is a playground\u2014and every player is your target or your pursuer.\n\nBuilt from the ground up with community feedback in mind, Dizmo Tag v2 introduces new maps, smoother mechanics, and a growing library of custom cosmetics and skins to personalize your primate. Jump into lobbies with friends or match up with strangers for high-speed tag showdowns that test your agility, awareness, and creativity.", "short_description": "Dizmo Tag v2 is a fast-paced, multiplayer VR fan game inspired by Gorilla Tag. Dive into a vibrant world of parkour-style tag where you run, jump, and climb using nothing but your hands. With enhanced movement mechanics, unique maps, and a growing collection of custom cosmetics, Dizmo Tag v2 delivers high-energy fun and endless replayability."}]}, "developer_name": "CJ", "developer_privacy_policy_url": "https://sites.google.com/view/dizmotagv2privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "CJ", "support_website_url": null, "website_url": "https://sites.google.com/view/dizmotagv2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23881490288150545"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499298205_705121622410641_756073568088139069_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ar1BPl1NytMQ7kNvwEjtygx&_nc_oc=AdqVHn8i9n_FHzFJ_0Uk0o7CRYMuyiudo4V1EIOmghpyyquPY_uSwbgQjpdEuh3xw_w&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESDSAyLqRn5MrfqkPn_YqtgHdsmLnvCGV56eM3F8jnAg&oe=6A8EC117"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dizmo Tag V2", "platform": "ANDROID_6DOF", "context_categor
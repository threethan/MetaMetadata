592286685718694585_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RT_xCvGo998Q7kNvwEWFHPo&_nc_oc=AdqD1TzxOhFS4FZYXVPWY3RGCCBN2RC48p6VV0ALRFhv9wX4Nuvkucs52NssCqbIPqY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYOWhT9yF-3gxhitDdAOc9I9nW2x5pyj7k0D2J1i-cyQ&oe=6ABD06D3"}, {"file_name": "Screenshot5FIX.png", "id": "582922424866113", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312032_582922428199446_4379498238582008023_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwJNuL43OzcQ7kNvwH8Qd41&_nc_oc=AdouMyHQbgKJHTZtWuqcFswGklG1gMR2gqvubTxnIIvf9g-mQBFG60S_Q2XgxxPhKPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqi69zsqVq73OveIue3W6uxtd1PKuF2ME9FpnuD7X12w&oe=6ABD0DA0"}, {"file_name": "Screenshot2FIX.png", "id": "1252380796602047", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491830460_1252380799935380_2653668641342142608_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1gKtU5iflicQ7kNvwEatqB8&_nc_oc=AdrBJT1erfeFg_huLRKlY_XNSCcziEEMUAXpzUccArshQyFG9wAeYFnI6rSgeDezmZs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCNQ_G2Q6ut71hCL8cgPZ8MqpwIUdfVQe7P7rFJpMl8w&oe=6ABD30AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dizmo Tag V2", "keywords": [], "long_description": "In Dizmo Tag v2, you\u2019ll master a unique physics-based locomotion system that lets you run, jump, climb, and vault through fully explorable 3D environments. Whether you\u2019re racing through a dense forest map, scaling walls in a neon-lit arena, or sneaking through tight alleyways in an urban setting, every surface is a playground\u2014and every player is your target or your pursuer.\n\nBuilt from the ground up with community feedback in mind, Dizmo Tag v2 introduces new maps, smoother mechanics, and a growing library of custom cosmetics and skins to personalize your primate. Jump into lobbies with friends or match up with strangers for high-speed tag showdowns that test your agility, awareness, and creativity.", "short_description": "Dizmo Tag v2 is a fast-paced, multiplayer VR fan game inspired by Gorilla Tag. Dive into a vibrant world of parkour-style tag where you run, jump, and climb using nothing but your hands. With enhanced movement mechanics, unique maps, and a growing collection of custom cosmetics, Dizmo Tag v2 delivers high-energy fun and endless replayability."}]}, "developer_name": "CJ", "developer_privacy_policy_url": "https://sites.google.com/view/dizmotagv2privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "CJ", "support_website_url": null, "website_url": "https://sites.google.com/view/dizmotagv2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23881490288150545"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499298205_705121622410641_756073568088139069_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Nb3u_FGr8wQ7kNvwHGduG8&_nc_oc=AdrgsoK0ML9naVF2OWKbh7jtH_y0CQYK2MRjxoGwQ-A6S7xHKy52VIUYvFZt0Wei1QU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3-IhyvhIsli6uU0Vgqm0lw35KZZ4wL6wSOqNMWRcvlg&oe=6ABD1DD7"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dizmo Tag V2", "platform": "ANDROID_6DOF", "context_category": {"context_ca
om&_nc_ss=7f20f&oh=00_AQT0z92cQl6U0SChUqrsHwMOBk9GClIpNH1NImNNA3DwyQ&oe=6AFF05AD"}, {"file_name": "Screenshot4FIX.png", "id": "1273704554100677", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822817_1273704557434010_8592286685718694585_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2RJbGI2XSlAQ7kNvwEg9beK&_nc_oc=AdobpTEbz_Ph2r1vJ0_zsQPTyXXDwmL1eTvkZq8r9fD_kO3QcxBqwwMRRbyhKsPAHgA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTqXXIdxkZS2bWYh7Pfk6YOVq3_I5SlF0VYC-We2uv5cQ&oe=6AFF2A13"}, {"file_name": "Screenshot5FIX.png", "id": "582922424866113", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499312032_582922428199446_4379498238582008023_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xz7ejJtBMXMQ7kNvwHk0hCi&_nc_oc=AdowzmJaA-PCBq4o0wxJRa6fkByVYBPT4APi2qNqGiyCHGxtnV9U2t-rNQV6fsijsdA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_LZqUPpKObl_QeZfe-4oxCvg5MdJ3nrzUyGa7vNe0Lg&oe=6AFF30E0"}, {"file_name": "Screenshot2FIX.png", "id": "1252380796602047", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491830460_1252380799935380_2653668641342142608_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5tw7x4njX0MQ7kNvwFtZc_q&_nc_oc=AdoJGk6JROmP8cegf9akRtfT0a0J8huinPc58UQo2Z07v6us8sdt4QOqnhSiUKU_qkA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRjtfvRNMbXv_y5iDPgBjF3t_l5-HWa_AnoV-bktdJmTg&oe=6AFF1BAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Dizmo Tag V2", "keywords": [], "long_description": "In Dizmo Tag v2, you\u2019ll master a unique physics-based locomotion system that lets you run, jump, climb, and vault through fully explorable 3D environments. Whether you\u2019re racing through a dense forest map, scaling walls in a neon-lit arena, or sneaking through tight alleyways in an urban setting, every surface is a playground\u2014and every player is your target or your pursuer.\n\nBuilt from the ground up with community feedback in mind, Dizmo Tag v2 introduces new maps, smoother mechanics, and a growing library of custom cosmetics and skins to personalize your primate. Jump into lobbies with friends or match up with strangers for high-speed tag showdowns that test your agility, awareness, and creativity.", "short_description": "Dizmo Tag v2 is a fast-paced, multiplayer VR fan game inspired by Gorilla Tag. Dive into a vibrant world of parkour-style tag where you run, jump, and climb using nothing but your hands. With enhanced movement mechanics, unique maps, and a growing collection of custom cosmetics, Dizmo Tag v2 delivers high-energy fun and endless replayability."}]}, "developer_name": "CJ", "developer_privacy_policy_url": "https://sites.google.com/view/dizmotagv2privacypolicy/home", "developer_terms_of_service_url": null, "publisher_name": "CJ", "support_website_url": null, "website_url": "https://sites.google.com/view/dizmotagv2/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "23881490288150545"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298205_705121622410641_756073568088139069_n.png?stp=dst-png_s360x360&_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1xcaOC7oaHgQ7kNvwFOnix1&_nc_oc=AdrErd5J9O4DxOZanM-
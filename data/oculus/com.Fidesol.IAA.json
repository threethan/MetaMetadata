": "1924776441425346", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491821719_1924776444758679_6325647046597338830_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcNC23zmujcQ7kNvwGI7EJN&_nc_oc=AdqJswERev5M5mUCuxKj6Mmpa9JAusjIOdxnx9P5KDNLbeR3yRRbn-lt4EQiUUj8KN8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPk0_COhdrLSHUEGed4I5WF7nsLl0LhVUN8hXrxjCkZGg&oe=6AE21C4C"}, {"file_name": "491821719_1924776444758679_6325647046597338830_n.png", "id": "1199301822259695", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499304764_1199301825593028_6529866373013982083_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3rhAyWFA9GIQ7kNvwFgScZ1&_nc_oc=AdpzXMt44JZ3njeGO6lrG10vC-KwmwiWyQ3KxZGddkJ4o7tK1PrsFVr3eszkKexB7qI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz5LeYuGi5ncbuni_K7ugtbe7YBD9xrGC1HPIGyCwo2Q&oe=6AE1FEBB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soninauts", "keywords": ["space", "astronomy", "galaxies", "stars", "sonification"], "long_description": "Embark on a cosmic VR adventure where sound rules. Dodge black holes, cross portals, and survive supernovas with the help \u2014or the taunts\u2014 of a sarcastic AI. In Soninauts, the universe speaks through sound, and only those who truly listen make it home.", "short_description": "Listen, dodge, survive. In Soninauts VR, the universe sounds, the AI taunts, your ears rule."}, {"images": {"nodes": []}, "id": "747934274974523", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soninautas", "keywords": ["espacio", "galaxias", "astronomia", "sonificacion"], "long_description": "Emb\u00e1rcate en una aventura c\u00f3smica VR donde el o\u00eddo manda. Esquiva agujeros negros, atraviesa portales y sobrevive a supernovas con la ayuda \u2014o las burlas\u2014 de una IA sarc\u00e1stica. En Soninautas, el universo suena, re\u00edrse del desastre es casi obligatorio, y solo quien escucha\u2026 vuelve a casa.", "short_description": "Escucha, esquiva, sobrevive. En Soninautas VR, el universo suena, la IA se burla y tu o\u00eddo manda."}]}, "developer_name": null, "developer_privacy_policy_url": "https://soninautas.iaa.csic.es/en-privacidad-soninautas/", "developer_terms_of_service_url": "https://www.iaa.csic.es/aviso-legal/", "publisher_name": "Fidesol", "support_website_url": null, "website_url": "https://soninautas.iaa.csic.es/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "es"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25160227770296605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823313_1749550682602107_941518948005383719_n.png?stp=dst-png_s360x360&_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SFq5tghRsucQ7kNvwEGhxyu&_nc_oc=AdoUnfDkIuzar4ZydVZr6mk9qUIppzZQXmQG9BXjpHKR5Q3wdbGXYGKahcwAj2CNMMw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoSSzVIpq-oS91fiG1Orn4aPqS8LTg92W3v-eKdQ9F8g&oe=6AE21711"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Soninauts", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": "2691890164460465"}], "release_date": 1762189200, "lastRevision": {"nodes": [{"id": "9618756491536984", "release_type": "SCHEDU
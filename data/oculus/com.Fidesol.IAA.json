046597338830_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2j17baId8kcQ7kNvwHfqpyo&_nc_oc=AdmhRcKgvxTDEJQETen1Qr3QM5Pjtpm9GaOYYZRlQFvk6RjXqi9pe1jvw_QUs6GljLc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfsbmC1dcO3E-ChSwLIIZz6ujxIJCWzM0G7-8t9cotKVAQ&oe=699C418C"}, {"file_name": "491821719_1924776444758679_6325647046597338830_n.png", "id": "1199301822259695", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304764_1199301825593028_6529866373013982083_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3GtqNgE3TcQ7kNvwGmo93a&_nc_oc=Adl4cu8sx5ftiKAQUy5uQ0aDiGjGqbzsB-s4tN6UCVYT8XxaKGshqwpVFbOWrNLhs2k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afv5QSA7Ey7S6HsxhcaK68Ll9ARHVkwSgkvLWQvaiClgfw&oe=699C5C3B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soninauts", "keywords": ["space", "astronomy", "galaxies", "stars", "sonification"], "long_description": "Embark on a cosmic VR adventure where sound rules. Dodge black holes, cross portals, and survive supernovas with the help \u2014or the taunts\u2014 of a sarcastic AI. In Soninauts, the universe speaks through sound, and only those who truly listen make it home.", "short_description": "Listen, dodge, survive. In Soninauts VR, the universe sounds, the AI taunts, your ears rule."}, {"images": {"nodes": []}, "id": "747934274974523", "locale": "es_LA", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Soninautas", "keywords": ["espacio", "galaxias", "astronomia", "sonificacion"], "long_description": "Emb\u00e1rcate en una aventura c\u00f3smica VR donde el o\u00eddo manda. Esquiva agujeros negros, atraviesa portales y sobrevive a supernovas con la ayuda \u2014o las burlas\u2014 de una IA sarc\u00e1stica. En Soninautas, el universo suena, re\u00edrse del desastre es casi obligatorio, y solo quien escucha\u2026 vuelve a casa.", "short_description": "Escucha, esquiva, sobrevive. En Soninautas VR, el universo suena, la IA se burla y
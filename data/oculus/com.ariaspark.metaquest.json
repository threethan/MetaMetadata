6C6Uw&oe=6A3162E6"}, {"file_name": "storepage_01.png", "id": "2084717389059552", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295588_2084717392392885_6929371389221384283_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xTAiyhhcqwQ7kNvwF3KVoB&_nc_oc=Adr-gY80ErSGkLs8RpscPjp0s__sz-vUgLTZ_3TmQMiMLgW-rjPosJ2uZoE4OlaI8Jo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9NCjPw4aA5iUfiNS6txZBR-3hwj0P6PfBCU8qrVAjoPQ&oe=6A316040"}, {"file_name": "storepage_03.png", "id": "2014657072733410", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618103_2014657076066743_3339019053445904818_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UgnHUHh-bkwQ7kNvwHeVZS3&_nc_oc=AdoQ90E4fs6FClYSaMyk0j_8v-mVW7UNYRomm6c4Mx8nh_8nqbdrj7g4SWjPm7tZ8so&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ThPyUqakb_zf5u-ib1QqhRXXwjI5h9UUkKVKR93TXKg&oe=6A316D02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_aria_2560x1440.png", "id": "3979684828990344", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499295547_3979684832323677_6127445064984455443_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SfcqAyvE5x0Q7kNvwEXbx7T&_nc_oc=Adq-u9BETm6DImyfTaHtESMXJp_RtpUgtemCcZfhbTYZD1RIFPOrLCirRj80Lw64vHI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9CRRH1N5UsEYIMAMuqUwXPGeuVmyTb0Ng3aLT9DU_SOA&oe=6A315754"}, "display_name": "Visualize", "keywords": ["AI", "DIY", "Passthrough", "Design", "Visualize"], "long_description": "Visualize transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions \u2014 before you buy, build, or hire.\n\n*  **Material Swap:** See your kitchen with marble countertops, your living room with hardwood floors, or your bedroom with new wall colors \u2014 all rendered live in your actual space.\n\n*  **Room Makeover:** Describe your vision \u2014 \"mid-century modern living room\" or \"minimalist Scandinavian kitchen\" \u2014 and watch Aria Spark generate a complete redesign overlaid on your real room.\n\n*   **Before & After:** Capture and compare your current space against proposed changes. Share screenshots with your designer, contractor, or partner.\n\n*   **Virtual Staging:** Stage an empty listing with virtual furniture in minutes. Walk buyers through a fully furnished space without moving a single piece.\n\n*   **Renovation Planning:** Show buyers the potential of a fixer-upper with live material swaps and layout changes during the showing.", "short_description": "See It Before You Build It. Visualize transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions before you buy, build, or hire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ariaspark.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aria Spark", "support_website_url": null, "website_url": "https://www.ariaspark.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26599615949733605"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.
cb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tdy6VfqAtjYQ7kNvwGsNZER&_nc_oc=AdorYUFX-5bcuoZZnLV6YU7rL6I79dnopDwPBjj0MNkRIhNTxy2-IZWSkFvC7dFYDX4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuI_te77wmQ8nHFK92VTWk40qNvioNnnuF-NUHxf6Z3g&oe=6AFC69E6"}, {"file_name": "storepage_01.png", "id": "2084717389059552", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499295588_2084717392392885_6929371389221384283_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iVFMlTk2NE4Q7kNvwEFQXMI&_nc_oc=AdqYcaGQEagxpQlu3VewTua7BZLF-FD5PCnEBRjRd3vfczdz9pl-jhFnSgJvSqP1Zi4&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeV5q2WQ4JBYSOMHfj8crr5SZzH8gvB74KVp6el-lMow&oe=6AFC6740"}, {"file_name": "storescreenshot.png", "id": "2148195712389118", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620940_2148195715722451_4841864387368478157_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0dD0sZekh30Q7kNvwFn_9TU&_nc_oc=Ado5YSu5HO20fN-CoIuVnh_n2zsJnxZBUOUSMuMctT5jAnMZTofToOVRVTnL5z4SunQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrBFbcGXcmvGZHWsfRHYxns9n0eZVbL1QIjmnuYcAZ9Q&oe=6AFC8717"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "2040685160155796", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499620497_2040685163489129_301846412278165358_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OPIWMzeEGpUQ7kNvwHVaNzc&_nc_oc=AdpLdbb4MHIbJzNzazUp8Bs_TRWZij-4UkcI3dUW3OJnHLktIpEAaZjUqjtcoR0mOEM&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSoohyOmNiJpxwO7WVWVuDFMQNmJNLqdJisePIDZNLCdw&oe=6AFC9257"}, "display_name": "Visualize", "keywords": ["AI", "DIY", "Passthrough", "Design", "Visualize"], "long_description": "Visualize transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions \u2014 before you buy, build, or hire.\n\n*  **Material Swap:** See your kitchen with marble countertops, your living room with hardwood floors, or your bedroom with new wall colors \u2014 all rendered live in your actual space.\n\n*  **Room Makeover:** Describe your vision \u2014 \"mid-century modern living room\" or \"minimalist Scandinavian kitchen\" \u2014 and watch Aria Spark generate a complete redesign overlaid on your real room.\n\n*   **Before & After:** Capture and compare your current space against proposed changes. Share screenshots with your designer, contractor, or partner.\n\n*   **Virtual Staging:** Stage an empty listing with virtual furniture in minutes. Walk buyers through a fully furnished space without moving a single piece.\n\n*   **Renovation Planning:** Show buyers the potential of a fixer-upper with live material swaps and layout changes during the showing.", "short_description": "See It Before You Build It. Visualize transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions before you buy, build, or hire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ariaspark.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aria Spark", "support_website_url": null, "website_url": "https://www.ariaspark.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
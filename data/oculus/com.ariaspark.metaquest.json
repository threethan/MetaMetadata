cb=1-7&_nc_sid=6e7a0a&_nc_ohc=kpAaI9pE1SAQ7kNvwFjwkYr&_nc_oc=AdqsZF7O51_SUKMxwxQJOslsXZkk9Jcu8Nn6rrs41tygVgIX4xVEFB95IwC74AWZ9XU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_Sr4rXR9rr5X5cFe8jKV2zUpkJpp59-W9wIy2bV8mXw&oe=6B06F5E6"}, {"file_name": "storepage_01.png", "id": "2084717389059552", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499295588_2084717392392885_6929371389221384283_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sET9fizmJyoQ7kNvwHlLZYO&_nc_oc=AdpSMnSI7UHXLuHfVaM6SivQt1WBXn0z6Tuk9Ge0WKlicrUSDqHfzGU8VDllGQ13G0E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQSylGG5JMejT-eYoOuACGTnbXcAnY8xtsbpxHv0ApAKw&oe=6B06F340"}, {"file_name": "storescreenshot.png", "id": "2148195712389118", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499620940_2148195715722451_4841864387368478157_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1S-uItzdzXMQ7kNvwG69A7k&_nc_oc=AdqiKR5NxTSswPnb3SSuljt1g7Gfl2nFtaEVsTkHiyenhztiZoi-cFxxu8sxsDP6cO8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7s47XPOEEGcXbimm2r4gTT0CT7DHQYsB3w6ROMKFYvA&oe=6B071317"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "2040685160155796", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620497_2040685163489129_301846412278165358_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_g_QQJesAxAQ7kNvwFn-blV&_nc_oc=Adr62Y6LM8PdlGZJd4PyrgewzNCjKrVdMTOypnyhjQNdHROmD_9rXA7ZAs9lZCXsO_8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQjWiNZqTtjk7-PWbDPDlqBWQPjUbmjbSeI2pYY73HxYw&oe=6B071E57"}, "display_name": "Visualize", "keywords": ["AI", "DIY", "Passthrough", "Design", "Visualize"], "long_description": "Visualize transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions \u2014 before you buy, build, or hire.\n\n*  **Material Swap:** See your kitchen with marble countertops, your living room with hardwood floors, or your bedroom with new wall colors \u2014 all rendered live in your actual space.\n\n*  **Room Makeover:** Describe your vision \u2014 \"mid-century modern living room\" or \"minimalist Scandinavian kitchen\" \u2014 and watch Aria Spark generate a complete redesign overlaid on your real room.\n\n*   **Before & After:** Capture and compare your current space against proposed changes. Share screenshots with your designer, contractor, or partner.\n\n*   **Virtual Staging:** Stage an empty listing with virtual furniture in minutes. Walk buyers through a fully furnished space without moving a single piece.\n\n*   **Renovation Planning:** Show buyers the potential of a fixer-upper with live material swaps and layout changes during the showing.", "short_description": "See It Before You Build It. Visualize transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions before you buy, build, or hire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ariaspark.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aria Spark", "support_website_url": null, "website_url": "https://www.ariaspark.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
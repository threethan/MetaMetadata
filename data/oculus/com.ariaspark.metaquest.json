0g_-Ww&oe=6ABD21E6"}, {"file_name": "storepage_01.png", "id": "2084717389059552", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499295588_2084717392392885_6929371389221384283_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLhhD8G2984Q7kNvwGHihrE&_nc_oc=AdqnUsZrZ4fiGGEOCJI1GwR4N8n0Ds9SBo11PFFEP7IcH7f3LjbPWeJN4RxsHvBXR30&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInR0cul3Hk4tkYYGJbcMrMAnYp9JH0D9lW-Udnr8e0Bg&oe=6ABD1F40"}, {"file_name": "storescreenshot.png", "id": "2148195712389118", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499620940_2148195715722451_4841864387368478157_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PQeY6tC5p-gQ7kNvwEySH5J&_nc_oc=AdoibE-V93Xfdv5BWPGYcFmWvtci831bhVjAvk8gmQj18Y1WPRt2RW_BKhgt6knHcNE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrWmvOiCDPMNc2w5bos-ZftmiY5qHRuzYft34KA6Mt-w&oe=6ABD06D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "2040685160155796", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620497_2040685163489129_301846412278165358_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vS-SU7GAavMQ7kNvwHm01Ub&_nc_oc=AdqJ2LMJIM9--Yq3TblnsrFh66R1ZxSAhYILPXOEBMUMjZlI7pdP2Gzlq-pIAaxY-LI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInHNho8Q-EIwKUN1iUw3r4s83OK9SSDoATZ5b5eXKx-Q&oe=6ABD1217"}, "display_name": "Visualize", "keywords": ["AI", "DIY", "Passthrough", "Design", "Visualize"], "long_description": "Visualize transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions \u2014 before you buy, build, or hire.\n\n*  **Material Swap:** See your kitchen with marble countertops, your living room with hardwood floors, or your bedroom with new wall colors \u2014 all rendered live in your actual space.\n\n*  **Room Makeover:** Describe your vision \u2014 \"mid-century modern living room\" or \"minimalist Scandinavian kitchen\" \u2014 and watch Aria Spark generate a complete redesign overlaid on your real room.\n\n*   **Before & After:** Capture and compare your current space against proposed changes. Share screenshots with your designer, contractor, or partner.\n\n*   **Virtual Staging:** Stage an empty listing with virtual furniture in minutes. Walk buyers through a fully furnished space without moving a single piece.\n\n*   **Renovation Planning:** Show buyers the potential of a fixer-upper with live material swaps and layout changes during the showing.", "short_description": "See It Before You Build It. Visualize transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions before you buy, build, or hire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ariaspark.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aria Spark", "support_website_url": null, "website_url": "https://www.ariaspark.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26713144485047417"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.ocul
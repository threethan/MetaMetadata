cb=1-7&_nc_sid=6e7a0a&_nc_ohc=tSsUKEa3D9cQ7kNvwFDEBvK&_nc_oc=AdrQJX4opRVDmUqELshMW384czWN6WCr2tX6fAa5_a2jw-oJXb5AjLqoWbDBbsL1WlQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR1_OJuaDTn29x5_hu9DTXgjpuRTK5xJQclvC22v1P0Ug&oe=6B0B22A6"}, {"file_name": "storepage_01.png", "id": "2084717389059552", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499295588_2084717392392885_6929371389221384283_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dp8K_utY_98Q7kNvwHI5NQC&_nc_oc=Adpkb_-7pdM1UxKoGzcyOThK-_7AGJkYQpfuPg1Z1oe0TSpWxioBUlg9SK61i9DhUsg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTg2_R_9I61l_z1Eg9ouUfm0gcg564EykDtnn14HOrfZg&oe=6B0B2000"}, {"file_name": "storescreenshot.png", "id": "2148195712389118", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620940_2148195715722451_4841864387368478157_n.png?_nc_cat=103&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OaTyZT0HaB4Q7kNvwHhM-Dd&_nc_oc=Adqyo87203cgXysUWAqiZ_2pfswQmWD9VyGFT4wEWxjcatcWNx0p8dFyjp1bR_OFgdg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQd9OiRABxmARsHXv3AvTwt13ITUZgCk0gR0VDGrFX_dg&oe=6B0B3FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverLandscape.png", "id": "2040685160155796", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499620497_2040685163489129_301846412278165358_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m2nAeGYHtbkQ7kNvwH8IeJ8&_nc_oc=AdpfZ9ICRaHYT5v3pLcftrl_9HjmBfk5eozl1a0baDN2wPV2YA6oOlpLUduNTp0bfHc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT3QecNnI5BxX8qik1JaMNnQ7B0xSdts6zLjJRXwulIvA&oe=6B0B12D7"}, "display_name": "Visualize", "keywords": ["AI", "DIY", "Passthrough", "Design", "Visualize"], "long_description": "Visualize transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions \u2014 before you buy, build, or hire.\n\n*  **Material Swap:** See your kitchen with marble countertops, your living room with hardwood floors, or your bedroom with new wall colors \u2014 all rendered live in your actual space.\n\n*  **Room Makeover:** Describe your vision \u2014 \"mid-century modern living room\" or \"minimalist Scandinavian kitchen\" \u2014 and watch Aria Spark generate a complete redesign overlaid on your real room.\n\n*   **Before & After:** Capture and compare your current space against proposed changes. Share screenshots with your designer, contractor, or partner.\n\n*   **Virtual Staging:** Stage an empty listing with virtual furniture in minutes. Walk buyers through a fully furnished space without moving a single piece.\n\n*   **Renovation Planning:** Show buyers the potential of a fixer-upper with live material swaps and layout changes during the showing.", "short_description": "See It Before You Build It. Visualize transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions before you buy, build, or hire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ariaspark.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aria Spark", "support_website_url": null, "website_url": "https://www.ariaspark.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wduVHdko6RsQ7kNvwHvnFbQ&_nc_oc=AdqfisEN9DQPkpzzBsT0ynexN1_Jf9KWQRMttKoif0zbH3jYlAOh32JO1iQgSNgnsHc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8miSVwIXWUdctgFkAvKnJaiShyW9bn27kG7nEuK2VqKw&oe=6A2EB4EF"}, {"file_name": "storepage_06.png", "id": "1227401682807850", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499618264_1227401686141183_4994036638655432199_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T6IBPuuRILIQ7kNvwHqLQHI&_nc_oc=AdpScvfy4hHxbh_pPFUjhYqp35yFUhTWv5df-gJY94rm8YIcRBxDgsghtIwAo65XR1w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6MDk88PJ6uEOf9EA9HjG-8HZ4mDnkztC0hwhjDRDsiw&oe=6A2EC46F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "splash_aria_2560x1440.png", "id": "3979684828990344", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499295547_3979684832323677_6127445064984455443_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V8pp51qzJmEQ7kNvwF-5_oQ&_nc_oc=AdqqjdoD9Frwc-RtlE1r7Y-LCLeJyLSp95kO9ZKiKt1U2t87UePd4FqlRbT4mu55cec&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8jjcPlBTunZxL9swFx9aM7olwbrykLzCNAgf7xyHaupw&oe=6A2EB454"}, "display_name": "Aria Spark", "keywords": ["AI", "DIY", "Passthrough", "Design", "Aria"], "long_description": "Aria Spark transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions \u2014 before you buy, build, or hire.\n\n*  **Material Swap:** See your kitchen with marble countertops, your living room with hardwood floors, or your bedroom with new wall colors \u2014 all rendered live in your actual space.\n\n*  **Room Makeover:** Describe your vision \u2014 \"mid-century modern living room\" or \"minimalist Scandinavian kitchen\" \u2014 and watch Aria Spark generate a complete redesign overlaid on your real room.\n\n*   **Before & After:** Capture and compare your current space against proposed changes. Share screenshots with your designer, contractor, or partner.\n\n*   **Virtual Staging:** Stage an empty listing with virtual furniture in minutes. Walk buyers through a fully furnished space without moving a single piece.\n\n*   **Renovation Planning:** Show buyers the potential of a fixer-upper with live material swaps and layout changes during the showing.", "short_description": "See It Before You Build It. Aria Spark transforms your Meta Quest into a spatial design studio. Powered by AI and real-time depth mapping, it turns any room into a live canvas where you can visualize changes, test ideas, and make confident decisions before you buy, build, or hire."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.ariaspark.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Aria Spark", "support_website_url": null, "website_url": "https://www.ariaspark.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24187840534244504"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "970725692141627"}]}, "baseline_offer": {"id": "970725692141627"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775062800, "status": "PUBLISHED", "id": "970725692141627"}]}, "liveChannel": {"nodes"
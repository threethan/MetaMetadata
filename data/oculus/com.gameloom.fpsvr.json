3-2.oculuscdn.com/v/t64.5771-25/491831279_27075302185501181_5859882331957136339_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZVPjIFc130Q7kNvwGi_uyk&_nc_oc=Adrb4nNNa2ifkG0m2ss063jRUJbF7KDBRZWi8qWSn80xUhY37_5II7iQZvTynRIhtCI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRCPZJcSqzMuebf7bu09nRMZmJ37t4KABqFkkH7Nmia3w&oe=6B0C4F55"}, {"file_name": "12-LastSignal_Map03-contact.png", "id": "1399287205753905", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/596168449_1399287212420571_5799701071637117624_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mv47fdmqYJwQ7kNvwFaBvpR&_nc_oc=AdqDuV5izDHjBjRSx6srlhf-b-1shB5BMEgyhysrEkFXQIf2KCw4X2P4-yOA723-09M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTzhLgkqXoirKerAhfw-CsF7elQu4dKahAlRu-Sbco8-w&oe=6B0C730E"}, {"file_name": "15-Carry-the-power-cell.png", "id": "2937541723260300", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/673536876_2937541726593633_586209944074930624_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gk0hKgoErYQ7kNvwHtNFnb&_nc_oc=AdqdkBF2TuDADc10Xm18JHzShoqNhV9XxCgfVXiihmwjEO97j8ZTiq26xCu8AYc4gEI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSfKN-PZ_e6jBQHL77DcIafwnRRXShmJYq6NuKzJOFjFw&oe=6B0C5FD9"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Last Signal: NorthLine", "keywords": ["ActionAdventure", "GunCombat", "MissionShooter", "ShootingGame", "ShootingAction"], "long_description": "They cut the signal. You have to bring it back.\n\nStep into Northline as Sam, fighting to open an evacuation route after a deliberate lockdown. Follow radio guidance from Mara and Lena, uncover what happened and keep the civilian convoy's emergency channel alive.\n\nFOUR CONNECTED CHAPTERS\nDEAD AIR: Recover an orange power cell, restore the relay and defend the transmission.\nPAPER TRAIL: Retrieve three archive records and protect the evidence uplink.\nCOLD CIRCUIT: Restart the substations in sequence and hold the grid control.\nLAST SIGNAL: Override the roadblocks, authenticate the broadcast and reach the final rendezvous.\n\nFIGHT YOUR WAY\nChoose nine firearms, from a pistol and compact SMGs to rifles and a pump shotgun. Use a support grip, crouch behind cover, sprint and jump through industrial districts. Guns stay loaded with unlimited ammunition and automatic cycling, keeping the focus on combat.\n\nGET HANDS-ON\nCarry the power cell, operate mission controls, and choose from three grenade types. Grab a grenade, pull its pin with your other hand, then throw. Security soldiers take cover, peek, flank and investigate combat noise.\n\nMAKE THE NEXT CHECKPOINT\nGuided training introduces the controls. Local checkpoints save your progress, while unlocked chapters can be replayed. Choose a left- or right-hand gun setup.\n\nOne player. Four chapters. An evacuation depending on your next move.", "short_description": "The lockdown was deliberate. Fight through Northline in a solo VR tactical shooter: restore a sabotaged relay, recover the evidence, restart the power grid and hold the evacuation channel. Choose from nine guns and three grenade types, carry mission objects with your free hand, and face security forces that use cover and flank. Four campaign chapters, guided training and saved checkpoints keep you moving toward one goal: bring everyone home.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/gamelooms-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "GameLoom", "support_website_url": null, "website_url": "https://sites.google.com/view/gamelooms-privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "2691890164460465"}], 
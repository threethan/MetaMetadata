 enterprise metaverse app for immersive product presentations"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app-v2-test.frame-s.com/privacypolicy.txt", "developer_terms_of_service_url": null, "publisher_name": "Vection Technologies", "support_website_url": null, "website_url": "https://vection-technologies.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}, {"id": "1819021644882647"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "23978375291823795"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39035326_909787617153500_8159991670902208222_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oQ707UClplUQ7kNvwFZfAxf&_nc_oc=AdpJjYbxPoTvBFOMuik9u5pyHoOFreOwsZqtUXsou5TSJluzkXQxj0Vj36PUJ4aoNRM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1INSXXIVsn8Zkv29xB4IldWSOg89djpsfPcCMtxPG_Ag&oe=69F0C68F"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "3DFrame", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Productivity", "id": "1063584910766706"}, {"topic_name": "Creativity", "id": "1819021644882647"}], "release_date": 1708970220, "lastRevision": {"nodes": [{"id": "5716909045063698", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"application":
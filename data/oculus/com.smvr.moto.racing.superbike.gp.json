_name": "screen5.png", "id": "1397173342235858", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825470_1397173345569191_7356897494502212708_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zWejblEtvtcQ7kNvwHS-VK8&_nc_oc=Adp96NiGXaI1quigCSI2mhbV4o28r_d8vcf1pzkXrvb9zz8r-kvxonzU7AegrSTxgNs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkx7p5YPtTXlzzJi8J-e7CQLWUkXTGR9HZ9SBQn2UYZA&oe=6A996FE2"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Moto Racing VR: Superbike GP Simulator", "keywords": [], "long_description": "Moto Racing VR: Superbike GP Simulator - The road is calling \u2014 can you hear it roar? Jump into Moto Rider, the ultimate bike racing game for anyone who dreams of living life at full throttle. Feel the wind, the vibration, and the thrill as you take control of your bike and race like the Moto GP legends. Moto Racing isn\u2019t just about reaching the finish line . \n\nMoto Racing VR: Superbike GP Simulator  Game which every second packed with action. Overtake opponents at crazy speed, squeeze through tight gaps, and prove that you\u2019re not just another racer \u2014 you\u2019re born to be a champion. In this game, the faster you ride, the higher your heart rate climbs, and the louder your engine screams. That\u2019s the heartbeat of this bike racing game, where skill, courage, and instinct decide who becomes a legend. \n\nKey Features\nMoto Racing VR : Superbike GP Simulator lets you experience pure adrenaline through high-speed challenges, intense visuals, and realistic controls. Choose your dream bike, and push it beyond its limits.\n\nHow to Play this Game.\n Use both controllers together to drive the vehicle.\n Right Hand Trigger (RT) \u2192 Accelerate / Move Forward.\n Left Hand Trigger (LT) \u2192 Brake.\n Left Hand Grip (LG) \u2192 Reverse / Move Backward\nX Button (Left Controller) \u2192 Pause the game at any time.\n Hold both controllers as if you are holding a steering wheel.\n Turn your hands left or right to steer the vehicle.\n Use the brake before taking sharp turns.\nReach the destination while avoiding obstacles.", "short_description": "Step into the world of elite motorcycle racing, where high-speed thrills meet precision engineering. Moto Racing VR : Superbike GP Simulator combines the adrenaline of professional superbike racing with precision physics and stunning 3D environments. Whether you are a casual rider or a pro, this racing simulator delivers the ultimate thrill on the track.\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/smart-games-vr-2/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Smart Games VR", "support_website_url": null, "website_url": "https://sites.google.com/view/smartgamesvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26521195090888380"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1928802811141289"}, {"status": "PUBLISHED", "id": "1021858653829142"}]}, "baseline_offer": {"id": "1021858653829142"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1784746800, "status": "PUBLISHED", "id": "1928802811141289"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"no
08121394555485_685486298753398730_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KK3CLVInTK0Q7kNvwG8MP8Q&_nc_oc=AdnpPZ5Wl8NR_xu3SuIzjuFkpoYW6lXsOJTRjGDbYL3znlee_rAylIhOFsOsLXiiO4E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfuyK1Te5wy4k_RdgRAcuWWq9QuPoyeUHJhH-l4me-mQ3w&oe=699EF0BD"}, {"file_name": "tml_final.png", "id": "2504349059937546", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310840_2504349063270879_5178219034751840674_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iKTO8dA718Q7kNvwGabWjA&_nc_oc=AdnUP6LF3vI5YXtV3IipurwGEYwU92X7zItKC8i1hBWTULG4OcnSmPKYmJSI_0AsyRc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftXZCJ0hgpcuEPnvuVUeTbEFd1Zz54INW7qemce0FQb_w&oe=699ED378"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_VR-App_Trailer_Thubnail_illit.png", "id": "1770473303606765", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499619773_1770473306940098_8939161564335805310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAeMjaGSyMkQ7kNvwGApP-y&_nc_oc=Adm9NYQfD9_hnkT6OM6VDtDrE9FuZM4k2t4-6TLC3zkylcpuPqzgVVI3OKvmCpL8DL4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftchEepiziIlmx_AZrtujPe0cNN0WbrpW4iqy7R6QTzcQ&oe=699EDC5F"}, "display_name": "CALIVERSE VR", "keywords": ["caliverse", "kpop", "edm", "tomorrowland", "concert"], "long_description": "The front row of a concert, right in your space.\n\nCALIVERSE VR is a VR concert app where you can fully immerse yourself in K-POP and Tomorrowland performances. \n\nFrom the stage unfolding before your eyes, to the cheers filling the venue, to the heat at your fingertips as you wave a light stick, every moment of the performance is captured just as it is.\n\n# A Variety of Stages, Guaranteed Enjoyment\n- **K-POP**: Download MBC Show! Music Core for free and enjoy them anytime.\n- **Tomorrowland**: Lost Frequencies, Dimitri Vegas, Oliver Heldens, Krystal Klear, and many more leading artists of the EDM scene can all be experienced in one place.\n\n# What Makes CALIVERSE VR Special\n- Immersive Production: Experience a VR stage that makes you feel as if you are at a real concert, enhanced by 3D videos with vivid depth and the added realism of light stick and bracelet gestures.\n- Comfortable Viewing: Supports both Sitting and Room-scale Modes for comfortable viewing in any environment.\n- Simple Usability: Download and start watching right away, with resume play and library management supported.\n\n# Stages Ahead\nK-POP and Tomorrowland content are regularly updated, ensuring fresh stages are always waiting for you.\n\nDownload CALIVERSE VR now and turn your space into the front row of a concert.\n\n**The moment the music begins, the world\u2019s greatest stage becomes yours.**", "short_description": "K-POP and global EDM. \nStep into a new dimension of music and experience its exclusivity up close."}]}, "developer_name": "CALIVERSE Inc.", "developer_privacy_policy_url": "https://calidocu.gitbook.io/caliverse-documentation/rules/caliverse-vr/caliverse-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CALIVERSE", "support_website_url": "https://support.caliverse.io/portal/3155", "website_url": "https://caliverse.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32632770056337172"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.ocu
EfOkrZ&_nc_oc=Adps_TaSGm8OPzkkHJWEX9PHjqtcD4suROM8XL1veSm6Rw4Y3YicwdpKFjga-qH8eyQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSBZgFlbXkcO20aGqyS4fGizvpsv8UK_iHVJ1mG3jtOjg&oe=6AFC65FD"}, {"file_name": "04-1.tml_mainstage_3rd.png", "id": "1208121391222152", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499618293_1208121394555485_685486298753398730_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJaZB3CFPq4Q7kNvwEqdspO&_nc_oc=Adp664nMv1cg9nKfxZwQFw8irTAZRAHyyGuwHy2HsvSlPdurGV8EgExKBlYjDfk3kdk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS4MxNAw1JqeLBVoK3cznPdR_Q9G1i8kYT7pSHWIrZYQA&oe=6AFC867D"}, {"file_name": "tml_final.png", "id": "2504349059937546", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499310840_2504349063270879_5178219034751840674_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbGVVnj_alAQ7kNvwFNIGUZ&_nc_oc=AdrLOkpWI_QNmSlCjkXptt0w8sq0vFIXg4RkQi-ip9uISOfXRGGu8A98nK7KyUauXLY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqSi835tTskwatmkwAQldwPXQd592JO1Pm2AEZQcNfxg&oe=6AFC6938"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_VR-App_Trailer_Thubnail_illit.png", "id": "1770473303606765", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619773_1770473306940098_8939161564335805310_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61dJlYYMlvgQ7kNvwGvq8_6&_nc_oc=AdpmaOFmzdVrSNqwzzewszmkQRU1b1t7_q5Pqex8_LSGgN6OtNK035QCT563ik2fBOc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRF_mRze1NL5rZ0jBYX0jLfyfKFF0bqZq9JZ7H7AdOJ5g&oe=6AFC721F"}, "display_name": "CALIVERSE VR", "keywords": ["caliverse", "kpop", "edm", "tomorrowland", "concert"], "long_description": "The front row of a concert, right in your space.\n\nCALIVERSE VR is a VR concert app where you can fully immerse yourself in K-POP and Tomorrowland performances. \n\nFrom the stage unfolding before your eyes, to the cheers filling the venue, to the heat at your fingertips as you wave a light stick, every moment of the performance is captured just as it is.\n\n# A Variety of Stages, Guaranteed Enjoyment\n- **K-POP**: Download MBC Show! Music Core for free and enjoy them anytime.\n- **Tomorrowland**: Lost Frequencies, Dimitri Vegas, Oliver Heldens, Krystal Klear, and many more leading artists of the EDM scene can all be experienced in one place.\n\n# What Makes CALIVERSE VR Special\n- Immersive Production: Experience a VR stage that makes you feel as if you are at a real concert, enhanced by 3D videos with vivid depth and the added realism of light stick and bracelet gestures.\n- Comfortable Viewing: Supports both Sitting and Room-scale Modes for comfortable viewing in any environment.\n- Simple Usability: Download and start watching right away, with resume play and library management supported.\n\n# Stages Ahead\nK-POP and Tomorrowland content are regularly updated, ensuring fresh stages are always waiting for you.\n\nDownload CALIVERSE VR now and turn your space into the front row of a concert.\n\n**The moment the music begins, the world\u2019s greatest stage becomes yours.**", "short_description": "K-POP and global EDM. \nStep into a new dimension of music and experience its exclusivity up close."}]}, "developer_name": "CALIVERSE Inc.", "developer_privacy_policy_url": "https://calidocu.gitbook.io/caliverse-documentation/rules/caliverse-vr/caliverse-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CALIVERSE", "support_website_url": "https://support.caliverse.io/portal/3155", "website_url": "https://caliverse.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "
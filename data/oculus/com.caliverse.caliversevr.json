08121394555485_685486298753398730_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XeoC95y1TjMQ7kNvwHvFff1&_nc_oc=AdoJ2rKzVBY16arv0cLRcQN_DJkZ0PCUbJi3rZkT0X-s257z2SqPLm4JyVqzIYm5el0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1tsv1Vdj3vdJMk5asGhPgvnZqSA3d1MMYVW-GyjJgpLg&oe=69F0ADBD"}, {"file_name": "tml_final.png", "id": "2504349059937546", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499310840_2504349063270879_5178219034751840674_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PHroWUjuwK8Q7kNvwHdEPTZ&_nc_oc=AdrEDE-41d0jI6BHgDbLXxYHptPDwMqa48mZbD3StJ5qLdcQMIGskd3JbIW9x0zoxGs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3-SPCpUiMlmidFc4IlJDRyNRtu--07VW8gHcGRdXC2gQ&oe=69F0C8B8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_VR-App_Trailer_Thubnail_illit.png", "id": "1770473303606765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619773_1770473306940098_8939161564335805310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RNZbVqDwcysQ7kNvwG8_F4W&_nc_oc=AdryahMdiuqaLu9yPHGO7JYoXpd-boTCuu4HZUol2FgbcryF1Qfn72g5YYsFbjwO-ZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3748YQngJmEwlrvewUaL1zUIFZADUYo6C5b0LYN65rsg&oe=69F0D19F"}, "display_name": "CALIVERSE VR", "keywords": ["caliverse", "kpop", "edm", "tomorrowland", "concert"], "long_description": "The front row of a concert, right in your space.\n\nCALIVERSE VR is a VR concert app where you can fully immerse yourself in K-POP and Tomorrowland performances. \n\nFrom the stage unfolding before your eyes, to the cheers filling the venue, to the heat at your fingertips as you wave a light stick, every moment of the performance is captured just as it is.\n\n# A Variety of Stages, Guaranteed Enjoyment\n- **K-POP**: Download MBC Show! Music Core for free and enjoy them anytime.\n- **Tomorrowland**: Lost Frequencies, Dimitri Vegas, Oliver Heldens, Krystal Klear, and many more leading artists of the EDM scene can all be experienced in one place.\n\n# What Makes CALIVERSE VR Special\n- Immersive Production: Experience a VR stage that makes you feel as if you are at a real concert, enhanced by 3D videos with vivid depth and the added realism of light stick and bracelet gestures.\n- Comfortable Viewing: Supports both Sitting and Room-scale Modes for comfortable viewing in any environment.\n- Simple Usability: Download and start watching right away, with resume play and library management supported.\n\n# Stages Ahead\nK-POP and Tomorrowland content are regularly updated, ensuring fresh stages are always waiting for you.\n\nDownload CALIVERSE VR now and turn your space into the front row of a concert.\n\n**The moment the music begins, the world\u2019s greatest stage becomes yours.**", "short_description": "K-POP and global EDM. \nStep into a new dimension of music and experience its exclusivity up close."}]}, "developer_name": "CALIVERSE Inc.", "developer_privacy_policy_url": "https://calidocu.gitbook.io/caliverse-documentation/rules/caliverse-vr/caliverse-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CALIVERSE", "support_website_url": "https://support.caliverse.io/portal/3155", "website_url": "https://caliverse.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32632770056337172"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.ocu
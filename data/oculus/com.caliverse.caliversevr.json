64_741992028672913_5894109170408825877_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IwID0TlbaaUQ7kNvwFj9wms&_nc_oc=Adr2PZnOt7cURt_HcspQwJ54PfuiYGM_5VVFGkehA70RtB0oU5rws05X7UdpyTdxpcQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGdqGRYpOThNqYPmx6OprNKB-VMnU8PnCfPkuVo8bwc6w&oe=6A8D6EE3"}]}, "id": "659133197039473", "locale": "en_US", "screenshots": [{"file_name": "01-1.kgma_aespa_main_3rd_01.png", "id": "1494995314972307", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499294704_1494995318305640_7583692100518297475_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fv6vCF6suykQ7kNvwH3SOWn&_nc_oc=AdqPmmkwpXwn7IdhAtag3tclygzwHiNNK1qraET5OIrEeNsAp8JbDg39-4F826xPxoo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHyeqihERWu6BSoZkudtbHELkemrVNHSeoHEPJ9m_4t-Q&oe=6A8D8C61"}, {"file_name": "03-1.mbc_zbo_main_3rd.png", "id": "1335147484798136", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499300913_1335147491464802_1318614513520490786_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-Pe2g4zHMcQ7kNvwE3BNy2&_nc_oc=AdpdmS59kMmLZTD5ao1yj70Zk0bj8q2KwUcdi28AmVmKJPCROOISlVt3q36-YrlFVtU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVSOrm05_yyBZpm9Zfo98m5xsVaEeL5Nordn7FVXjPxw&oe=6A8D804A"}, {"file_name": "02.mbc_izna_main_3rd.png", "id": "780308675168254", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499618512_780308678501587_5416519580831670893_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sqqShCg8DO4Q7kNvwFQBKal&_nc_oc=AdpVphkBn5tOVYj75rhT8eZ0c1c9Ro2jSiYCQkOrunCUmrqLn9tj8fwz171glfRGICs&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1jiyzU_VKBhW8UE5VgnCQjId5TUGWxpEYby_v8nh2fA&oe=6A8D8289"}, {"file_name": "tml_final.png", "id": "2504349059937546", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/499310840_2504349063270879_5178219034751840674_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GirCemmnRmcQ7kNvwG639ka&_nc_oc=Adr1CNPcktdyAw2idYYIujcn015RBpBRGhhFh1OaIO80J2xBddjtLqs4Eq885DYsXsI&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6pZm5eMa-F2MoAFTMVatAKs4Ur22E_TV9uw5PzoYyTQ&oe=6A8D72F8"}, {"file_name": "04-1.tml_mainstage_3rd.png", "id": "1371522218310728", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499620871_1371522221644061_4404375004555321769_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m47FXEP6U9IQ7kNvwG0lNkG&_nc_oc=AdqZXJR4W3PwY3UH8CYBw2TLJ9jl72mbEJzaFUNntFekKbJcvVpgLamyX6R61fUJxjE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFDRP2996WmVGgrCVXgjzVAI4DBXfzwxpJMMEP__RP6pA&oe=6A8D83F2"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_VR-App_Trailer_Thubnail_illit.png", "id": "1770473303606765", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619773_1770473306940098_8939161564335805310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vza2Mw6o4lEQ7kNvwFxj1Wq&_nc_oc=Adq6z6geWD_NMzGmskIAyYRlbasINja9fdzV1aedf8PAG-B8dfyQilABpoSeuqePPGw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEuP0EaVDTc5YmtIIbpRRAS_IQdVcl2QTrIu5Mva-1cjA&oe=6A8D7BDF"}, "display_name": "CALIVERSE VR", "keywords": ["caliverse", "kpop", "edm", "tomorrowland", "concert"], "long_description": "The front row of a concert, right in your space.\n\nCALIVERSE VR is a VR concert app where you can fully immerse yourself in K-POP and Tomorrowland performances. \n\nFrom the stage unfolding before your eyes, to the cheers filling the venue, to the heat at your fingertips as you wave a light stick, every moment of the performance is captured just as it is.\n\n# A Variety of Stages, Guaranteed Enjoyment\n- **K-POP**: Download MBC Show! Music Core and KGMA (Korea Grand Music Awards) stages for free and enjoy them anytime.\n- **Tomorrowland**: Lost Frequencies, Dimitri Vegas, Oliver Heldens, Krystal Klear, and many more leading artists of the EDM scene can all be experienced in one place.\n\n# What Makes CALIVERSE VR Special\n- Immersive Production: Experience a VR stage that makes you feel as if you are at a real concert, enhanced by 3D videos with vivid depth and the added realism of light stick and bracelet gestures.\n- Comfortable Viewing: Supports both Sitting and Room-scale Modes for comfortable viewing in any environment.\n- Simple Usability: Download and start watching right away, with resume play and library management supported.\n\n# Stages Ahead\nK-POP and Tomorrowland content are regularly updated, ensuring fresh stages are always waiting for you.\n\nDownload CALIVERSE VR now and turn your space into the front row of a concert.\n\n**The moment the music begins, the world\u2019s greatest stage becomes yours.**", "short_description": "K-POP and global EDM. \nStep into a new dimension of music and experience its exclusivity up close."}]}, "developer_name": "CALIVERSE Inc.", "developer_privacy_policy_url": "https://calidocu.gitbook.io/caliverse-documentation/rules/caliverse-vr/caliverse-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CALIVERSE", "support_website_url": "https://support.caliverse.io/portal/3155", "website_url": "https://caliverse.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32224092460538269"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1564585657853285"}]}, "baseline_offer": {"id"
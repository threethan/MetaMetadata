08121394555485_685486298753398730_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dl7y5F3thH4Q7kNvwHpadXx&_nc_oc=AdkVILFaCSz4SfB3ZSIUP1Z9sKbnNY6D2AAcy5CSbi9DXLIfdRm867DRGYSRFbUtUTw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AfssoyKzDu9P-7FqqDs5-YS7AaYOeleJ7DQFxXFLnvbbxQ&oe=69A193BD"}, {"file_name": "tml_final.png", "id": "2504349059937546", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/499310840_2504349063270879_5178219034751840674_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4iKTO8dA718Q7kNvwEhkDag&_nc_oc=AdneqX9PyXn0fBtp_2zdkA4IpSDjKP6SLGCGpRuf2SGYZ9WSi4-t30ZEX1kmrfSFwbw&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&oh=00_AftoIz-oMBmZDKoRudepYnAKMNBUasszTejpJbf6QGu8sw&oe=69A17678"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_VR-App_Trailer_Thubnail_illit.png", "id": "1770473303606765", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/499619773_1770473306940098_8939161564335805310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TxYaAs0h3L4Q7kNvwFrkuCZ&_nc_oc=AdmXfrQxA7TElptdC6RtFeqwXyw19GBE0D6nqPt8lvieiwACf4z5Nt1XxKkYzA5CovY&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Afsv3sf0aDbORifl6JlWTn_8jwqH4aArfzHuQ7haaOK5Ig&oe=69A17F5F"}, "display_name": "CALIVERSE VR", "keywords": ["caliverse", "kpop", "edm", "tomorrowland", "concert"], "long_description": "The front row of a concert, right in your space.\n\nCALIVERSE VR is a VR concert app where you can fully immerse yourself in K-POP and Tomorrowland performances. \n\nFrom the stage unfolding before your eyes, to the cheers filling the venue, to the heat at your fingertips as you wave a light stick, every moment of the performance is captured just as it is.\n\n# A Variety of Stages, Guaranteed Enjoyment\n- **K-POP**: Download MBC Show! Music Core for free and enjoy them anytime.\n- **Tomorrowland**: Lost Frequencies, Dimitri Vegas, Oliver Heldens, Krystal Klear, and many more leading artists of the EDM scene can all be experienced in one place.\n\n# What Makes CALIVERSE VR Special\n- Immersive Production: Experience a VR stage that makes you feel as if you are at a real concert, enhanced by 3D videos with vivid depth and the added realism of light stick and bracelet gestures.\n- Comfortable Viewing: Supports both Sitting and Room-scale Modes for comfortable viewing in any environment.\n- Simple Usability: Download and start watching right away, with resume play and library management supported.\n\n# Stages Ahead\nK-POP and Tomorrowland content are regularly updated, ensuring fresh stages are always waiting for you.\n\nDownload CALIVERSE VR now and turn your space into the front row of a concert.\n\n**The moment the music begins, the world\u2019s greatest stage becomes yours.**", "short_description": "K-POP and global EDM. \nStep into a new dimension of music and experience its exclusivity up close."}]}, "developer_name": "CALIVERSE Inc.", "developer_privacy_policy_url": "https://calidocu.gitbook.io/caliverse-documentation/rules/caliverse-vr/caliverse-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CALIVERSE", "support_website_url": "https://support.caliverse.io/portal/3155", "website_url": "https://caliverse.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32632770056337172"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg1-1.ocu
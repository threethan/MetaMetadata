waS4YhoR1XsZdjv64qsYm8bQABYTHeabBy-fbwgAG7TobM&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFy2neJndjhUiD759YX8UUL1foAALIruQM1kkM6M9l3ag&oe=6A8EC478"}, {"file_name": "04-1.tml_mainstage_3rd.png", "id": "1371522218310728", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499620871_1371522221644061_4404375004555321769_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RHC80y4t_y0Q7kNvwE7hTpC&_nc_oc=AdrnYeiMBMCATyG6tr2OHGnSYeeu16XV2qCKUWKRbGVFZIQUEhJitv4ysa8i_nBAqX4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHR_RVmhtXqB7j92qomcpuSFbi8EjaS2tIx_rjNbxJ3kg&oe=6A8ED572"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_VR-App_Trailer_Thubnail_illit.png", "id": "1770473303606765", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499619773_1770473306940098_8939161564335805310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vza2Mw6o4lEQ7kNvwFogrJn&_nc_oc=Adqh9SW31Kc7gormz_hY6cDA8iMA4We8hZahV0MdHQ85cdAjBQXq38Pe05vm6PeWDZ4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHcrOH4oJ3KT5qlxx9fEb8865j6fOS-6MWlfeIwtAtHqQ&oe=6A8ECD5F"}, "display_name": "CALIVERSE VR", "keywords": ["caliverse", "kpop", "edm", "tomorrowland", "concert"], "long_description": "The front row of a concert, right in your space.\n\nCALIVERSE VR is a VR concert app where you can fully immerse yourself in K-POP and Tomorrowland performances. \n\nFrom the stage unfolding before your eyes, to the cheers filling the venue, to the heat at your fingertips as you wave a light stick, every moment of the performance is captured just as it is.\n\n# A Variety of Stages, Guaranteed Enjoyment\n- **K-POP**: Download MBC Show! Music Core and KGMA (Korea Grand Music Awards) stages for free and enjoy them anytime.\n- **Tomorrowland**: Lost Frequencies, Dimitri Vegas, Oliver Heldens, Krystal Klear, and many more leading artists of the EDM scene can all be experienced in one place.\n\n# What Makes CALIVERSE VR Special\n- Immersive Production: Experience a VR stage that makes you feel as if you are at a real concert, enhanced by 3D videos with vivid depth and the added realism of light stick and bracelet gestures.\n- Comfortable Viewing: Supports both Sitting and Room-scale Modes for comfortable viewing in any environment.\n- Simple Usability: Download and start watching right away, with resume play and library management supported.\n\n# Stages Ahead\nK-POP and Tomorrowland content are regularly updated, ensuring fresh stages are always waiting for you.\n\nDownload CALIVERSE VR now and turn your space into the front row of a concert.\n\n**The moment the music begins, the world\u2019s greatest stage becomes yours.**", "short_description": "K-POP and global EDM. \nStep into a new dimension of music and experience its exclusivity up close."}]}, "developer_name": "CALIVERSE Inc.", "developer_privacy_policy_url": "https://calidocu.gitbook.io/caliverse-documentation/rules/caliverse-vr/caliverse-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CALIVERSE", "support_website_url": "https://support.caliverse.io/portal/3155", "website_url": "https://caliverse.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32224092460538269"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1564585657853285"}]}, "baseline_offer": {"id"
rsH_FFmVKreGGMT4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAoekXJ8numCdSosFblDeq4-CW7tAxbkyIfZ-xkW9NAg&oe=6A7C4F78"}, {"file_name": "04-1.tml_mainstage_3rd.png", "id": "1371522218310728", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499620871_1371522221644061_4404375004555321769_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGCnBElmZDAQ7kNvwH7kuDr&_nc_oc=Adrt6kFlPFJK3YZUqgdjCfUraNVg773gbc2wz6kmb3u75-8Yl0app5CXYh_cCdbOuxA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQET6LwmWEMQPFa9OOV9y-mxdY8vXeWxlM50WSqp6E1ETg&oe=6A7C6072"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_VR-App_Trailer_Thubnail_illit.png", "id": "1770473303606765", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499619773_1770473306940098_8939161564335805310_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zes4hjQ2IyMQ7kNvwG5nIrP&_nc_oc=Adqgu8i04Yx1sk0f6tpShhjv0OiJxZOMorup2yjH4ehYZ6vIfLoJ2CZj1tlD0rWRJ8I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmqx6kmk8BxwtTb_PXM_VCEiPM8ALBsen1XA_QYSJL2g&oe=6A7C585F"}, "display_name": "CALIVERSE VR", "keywords": ["caliverse", "kpop", "edm", "tomorrowland", "concert"], "long_description": "The front row of a concert, right in your space.\n\nCALIVERSE VR is a VR concert app where you can fully immerse yourself in K-POP and Tomorrowland performances. \n\nFrom the stage unfolding before your eyes, to the cheers filling the venue, to the heat at your fingertips as you wave a light stick, every moment of the performance is captured just as it is.\n\n# A Variety of Stages, Guaranteed Enjoyment\n- **K-POP**: Download MBC Show! Music Core and KGMA (Korea Grand Music Awards) stages for free and enjoy them anytime.\n- **Tomorrowland**: Lost Frequencies, Dimitri Vegas, Oliver Heldens, Krystal Klear, and many more leading artists of the EDM scene can all be experienced in one place.\n\n# What Makes CALIVERSE VR Special\n- Immersive Production: Experience a VR stage that makes you feel as if you are at a real concert, enhanced by 3D videos with vivid depth and the added realism of light stick and bracelet gestures.\n- Comfortable Viewing: Supports both Sitting and Room-scale Modes for comfortable viewing in any environment.\n- Simple Usability: Download and start watching right away, with resume play and library management supported.\n\n# Stages Ahead\nK-POP and Tomorrowland content are regularly updated, ensuring fresh stages are always waiting for you.\n\nDownload CALIVERSE VR now and turn your space into the front row of a concert.\n\n**The moment the music begins, the world\u2019s greatest stage becomes yours.**", "short_description": "K-POP and global EDM. \nStep into a new dimension of music and experience its exclusivity up close."}]}, "developer_name": "CALIVERSE Inc.", "developer_privacy_policy_url": "https://calidocu.gitbook.io/caliverse-documentation/rules/caliverse-vr/caliverse-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CALIVERSE", "support_website_url": "https://support.caliverse.io/portal/3155", "website_url": "https://caliverse.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "32224092460538269"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1564585657853285"}]}, "baseline_offer": {"id": "1564585657853285"}, "is_appro
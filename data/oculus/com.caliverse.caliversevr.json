HOi-2D&_nc_oc=AdorCwMK-uDUjITUOjwJext2s240fmurrG9oxrelymezrxKedfGauQ6J2PqQ4H34aCg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4sZZGWDjSEM93eEH_4qbgL_U_MltaCz2t65Wd4kSjEA&oe=6AFDB77D"}, {"file_name": "04-1.tml_mainstage_3rd.png", "id": "1208121391222152", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499618293_1208121394555485_685486298753398730_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJaZB3CFPq4Q7kNvwEZAOT0&_nc_oc=Adp-dor9bPgOfXRL0qrlljzjw81fdTc4qKh21dU-zPoy7Mlkd4OiyB5Add2Pu541zzQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTiVKD9n1uIQwtxVGdheeHGAWwcVAB9Dln-Mii7qmTLKQ&oe=6AFDD7FD"}, {"file_name": "tml_final.png", "id": "2504349059937546", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310840_2504349063270879_5178219034751840674_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vbGVVnj_alAQ7kNvwH5fota&_nc_oc=AdogOuOwq6TV-XQVEpj2vuq3DThHvH--7WtnFRFe-8wR9sFNMUoWnZob-D8_JvYHCMc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRrJ3eVFdKHuPlKBb-kfhkkNkiq-jsSedCvL4HsczBLg&oe=6AFDBAB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "META_VR-App_Trailer_Thubnail_illit.png", "id": "1770473303606765", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499619773_1770473306940098_8939161564335805310_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=61dJlYYMlvgQ7kNvwGJ0tyj&_nc_oc=Adpq9cQjGD3Pkre-I44gneFuL3l9N2hVpbuKllV1gLnTwFSYlzE3m6WjTIBQG--X-YE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgzU06LiruYUMQtwb58o97M3eHh2Rrd-72t6pNSkliNg&oe=6AFDC39F"}, "display_name": "CALIVERSE VR", "keywords": ["caliverse", "kpop", "edm", "tomorrowland", "concert"], "long_description": "The front row of a concert, right in your space.\n\nCALIVERSE VR is a VR concert app where you can fully immerse yourself in K-POP and Tomorrowland performances. \n\nFrom the stage unfolding before your eyes, to the cheers filling the venue, to the heat at your fingertips as you wave a light stick, every moment of the performance is captured just as it is.\n\n# A Variety of Stages, Guaranteed Enjoyment\n- **K-POP**: Download MBC Show! Music Core for free and enjoy them anytime.\n- **Tomorrowland**: Lost Frequencies, Dimitri Vegas, Oliver Heldens, Krystal Klear, and many more leading artists of the EDM scene can all be experienced in one place.\n\n# What Makes CALIVERSE VR Special\n- Immersive Production: Experience a VR stage that makes you feel as if you are at a real concert, enhanced by 3D videos with vivid depth and the added realism of light stick and bracelet gestures.\n- Comfortable Viewing: Supports both Sitting and Room-scale Modes for comfortable viewing in any environment.\n- Simple Usability: Download and start watching right away, with resume play and library management supported.\n\n# Stages Ahead\nK-POP and Tomorrowland content are regularly updated, ensuring fresh stages are always waiting for you.\n\nDownload CALIVERSE VR now and turn your space into the front row of a concert.\n\n**The moment the music begins, the world\u2019s greatest stage becomes yours.**", "short_description": "K-POP and global EDM. \nStep into a new dimension of music and experience its exclusivity up close."}]}, "developer_name": "CALIVERSE Inc.", "developer_privacy_policy_url": "https://calidocu.gitbook.io/caliverse-documentation/rules/caliverse-vr/caliverse-vr-privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CALIVERSE", "support_website_url": "https://support.caliverse.io/portal/3155", "website_url": "https://caliverse.io/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "
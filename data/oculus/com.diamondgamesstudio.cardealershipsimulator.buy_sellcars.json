oculuscdn.com&_nc_ss=7f20f&oh=00_AQTUOEndPPLu6HnD8sqBoc97CNstmazT1gNdL9cCRDrGwg&oe=6AEB3DB4"}, {"file_name": "4.png", "id": "985625414539320", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491827973_985625421205986_7211694938433963524_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFi40gSymbIQ7kNvwFVLZxX&_nc_oc=AdoSdXnedfMXKfwn8V2k28_pvZnbK7Xd48QQfu_4PLf1zkupnvE8SD90daXZ6EtW0b4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7Ql138xMLlXSREbA5o3rjluIReB71eWqeBJDF_ZOkYg&oe=6AEB3B13"}, {"file_name": "5.png", "id": "2795583734149526", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825575_2795583737482859_7857103901894828997_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mn3DxkA_FEIQ7kNvwF90T6U&_nc_oc=AdpP1WcM4oo_g81L3Aj6sm5oZp2FwPVb3QZahQrQEHCK3oLApVY5-vwCkeT8ETZ2tYc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQgGqXDFbCb4c9K8RDYcdQxQ3Dy15MG8HR2THGX--Gg4g&oe=6AEB2FBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Car Dealership Simulator Buy & Sell Cars", "keywords": ["cardealershipsimulator", "cardealer", "usedcars", "carsales", "businesssimulator"], "long_description": "Start with a small showroom and turn it into the most successful car dealership in town. Search for great deals, buy used cars, inspect their condition, repair damaged parts, clean and customize each vehicle, then display them in your showroom for customers to admire.\nEvery sale is an opportunity to grow your business. Negotiate with buyers, set the right prices, and maximize your profits. Upgrade your dealership, expand your showroom, unlock new vehicles, and improve your reputation as you become the ultimate car dealer.\nSuccess depends on making smart business decisions. Find valuable cars, invest in repairs, and decide when to sell for the highest return. Every choice affects your dealership's growth.\nFeatures\nBuy used cars at the best prices.\nRepair and restore vehicles to increase their value.\nClean and customize cars before putting them on display.\nManage your own car showroom and dealership.\nNegotiate with customers and close profitable deals.\nEarn money and expand your business.\nUnlock new cars, upgrades, and dealership improvements.\nEnjoy realistic dealership management and immersive gameplay in VR.\nWhether you enjoy business simulation, tycoon games, or car trading, Car Dealership Simulator: Buy & Sell Cars lets you experience the thrill of building a successful automotive business from the ground up. Buy smart, repair expertly, negotiate confidently, and become the most successful car dealer in the city!", "short_description": "Buy, repair, and sell cars to build the ultimate dealership. Upgrade your showroom, negotiate with customers, and grow your business."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/diamondgamesstudio/privacy-policy-meta", "developer_terms_of_service_url": null, "publisher_name": "DiamondGamesStudio", "support_website_url": null, "website_url": "https://sites.google.com/view/diamondgamesstudio/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1158853960655509"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823790_3506026836225429_6378971538647759342_n.png?stp=dst-png_s360x360&_nc_ca
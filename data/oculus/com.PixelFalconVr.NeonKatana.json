oe=6B070667"}, {"file_name": "6.png", "id": "4677554782487055", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/604360590_4677554785820388_4532866203461096139_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iAgwH3_AwNgQ7kNvwE4jE4-&_nc_oc=Ado0uogFWgntwsNIa1eWcRZk_1wgmwxVZR_W2b272WfgWw0fZfg-DsOxbhji_mjhLSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaPHBEAiRti9ouhXhB8C-ZHi3ziOFgcSyNA30zcMArbA&oe=6B06F5FC"}, {"file_name": "1.png", "id": "2335601333906976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/767585477_2335601337240309_4409747567225492946_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bpp5vvUBGC4Q7kNvwG7fpKG&_nc_oc=AdoLO9xc0KLfdC5JJmztIFLwMTjXckzJT3jZ7EDvjTMg7ONZJ0yhFJVodk1EwICjmgc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNNuGpb8DGbGMxhnwd4DgZ8suWjznzGzAwZKyDF7kq9Q&oe=6B07233E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1452096066901055", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623565_1452096070234388_1744071463423666441_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lc1z5KNdRnYQ7kNvwGWZ5PU&_nc_oc=Ado_3m3a2gTczgiR__tf_xspAtToodEBDfbjLsJZdReM8CDCT7X8pXZGdS9vutJPLyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNy8Jhl8bKD7-8GkQ4Ik17xDcLPkuhq9xIu8wLWg57_w&oe=6B06FDCC"}, "display_name": "NEON KATANA", "keywords": ["katana", "rhythm", "neon", "sword", "beat"], "long_description": "Slice to the beat in \"NEON KATANA\", the high-octane VR rhythm slashing game! Dual-wield glowing energy katanas and cut down targets in time with heart-pounding electronic music. Match blade colors, carve through dynamic flight paths, parry hazard mines, and push your combo streaks to the limit.\n\n\"4 DISTINCT GAME MODES\" :\n \".CLASSIC RHYTHM:\" Pure flow-state beat slicing through the signature neon tunnel. \n\"\u2022 CYBER OVERDRIVE: \"Intense 90s Time Attack\u2014every hit adds seconds, misses drain the clock! \n{1845941359893468}\n\"\u2022 POLARITY SHIFT:\" Reflex challenge where your katanas and incoming targets flip colors mid-track. \n{2710581152730819}\n\"\u2022 SHOGUN BLITZ:\" 360\u00b0 open dojo arena with heavy armored cores and 2x critical power cuts.\n{2247030992882087}\n\"HOW TO PLAY \u2022\" Match Colors: Slice red targets with the red blade, blue targets with the blue blade. \u2022 Read Trajectories: Track targets flying in sharp zigzags, wide curves, and multi-lane fan walls. \u2022 Parry Hazard Mines: Deflect explosive bombs with tactical blade parries.\n\n\"KEY FEATURES \u2022 \"Dual-blade VR swordplay with responsive haptic feedback \u2022 4 unique visual environments with custom 3D geometric targets \u2022 High-energy electronic tracks with per-mode leaderboards & S-ranks \u2022 Rock-solid VR tracking: Seamless support for both Stationary and Roomscale play \u2022 Optimized 90 FPS standalone VR performance for Meta Quest\n\nReady your blades, master the rhythm, and rule the neon grid!\n\n", "short_description": "Slice neon blocks to the beat with dual glowing katanas. Match red and blue targets to the correct blade, build your combo, and beat your best score. Play through each song, react to the rhythm, and experience a neon arena that moves with the music."}]}, "developer_name": "PixelFalcon VR", "developer_privacy_policy_url": "https://sites.google.com/view/neon-katana-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "PixelFalcon VR", "support_website_url": "https://kashi45248-prog.github.io/PixelFalconVR/index.html", "website_url": "https://kashi45248-prog.github.io/PixelFalconVR/index.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_
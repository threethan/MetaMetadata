c_oc=Ado0uogFWgntwsNIa1eWcRZk_1wgmwxVZR_W2b272WfgWw0fZfg-DsOxbhji_mjhLSA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaPHBEAiRti9ouhXhB8C-ZHi3ziOFgcSyNA30zcMArbA&oe=6B06F5FC"}, {"file_name": "1.png", "id": "2335601333906976", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/767585477_2335601337240309_4409747567225492946_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Bpp5vvUBGC4Q7kNvwG7fpKG&_nc_oc=AdoLO9xc0KLfdC5JJmztIFLwMTjXckzJT3jZ7EDvjTMg7ONZJ0yhFJVodk1EwICjmgc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTNNuGpb8DGbGMxhnwd4DgZ8suWjznzGzAwZKyDF7kq9Q&oe=6B07233E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1452096066901055", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499623565_1452096070234388_1744071463423666441_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lc1z5KNdRnYQ7kNvwGWZ5PU&_nc_oc=Ado_3m3a2gTczgiR__tf_xspAtToodEBDfbjLsJZdReM8CDCT7X8pXZGdS9vutJPLyM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNy8Jhl8bKD7-8GkQ4Ik17xDcLPkuhq9xIu8wLWg57_w&oe=6B06FDCC"}, "display_name": "NEON KATANA", "keywords": ["katana", "rhythm", "neon", "music", "sword"], "long_description": "Slice to the beat. Build your combo. Beat your best score.\n\nNEON KATANA is a fast-paced VR rhythm slashing game where you use two glowing katanas to slice colorful blocks to the music.\n\nRed and blue blocks fly toward you in time . Match each block to the correct blade, time your swings, and slice them cleanly to build your combo and increase your score.\n\nHOW IT PLAYS\n\nUse your two glowing katanas to slice incoming blocks.\n\nRed blocks must be cut with the red blade, while blue blocks must be cut with the blue blade.\n\nSwing at the right moment. Accurate hits increase your score and help you maintain your combo.\n\nMiss blocks or use the wrong blade and you lose health. When your health reaches zero, the game ends.\n\nKeep playing until your health runs out.\n\nFEATURES\n\n\u2022 Two glowing katanas\n\u2022 Red and blue color-matching gameplay\n\u2022 Curving, spiraling, zigzag and straight target patterns\n\u2022 Different target formations and patterns\n\u2022 Combo system with score feedback\n\u2022 Current score and personal best score\n\u2022 Challenge yourself to beat your best score\n\u2022 Results showing your performance\n\u2022 Multiple songs to choose from\n\u2022 Standing, stationary VR gameplay\n\nPLAY YOUR WAY\n\nChoose a song and try to beat your best score.\n\nImprove your timing, maintain your combo, and see how accurately you can slice", "short_description": "Slice neon blocks to the beat with dual glowing katanas. Match red and blue targets to the correct blade, build your combo, and beat your best score. Play through each song, react to the rhythm, and experience a neon arena that moves with the music."}]}, "developer_name": "PixelFalcon VR", "developer_privacy_policy_url": "https://sites.google.com/view/neon-katana-privacy/home", "developer_terms_of_service_url": null, "publisher_name": "PixelFalcon VR", "support_website_url": "https://vr-portfolio-blackboxcreations.vercel.app/", "website_url": "https://vr-portfolio-blackboxcreations.vercel.app/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1672577396871977"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1261836733690064"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "1489485306433652"}, {"status": "PUBLISHED", "id": "1628457495317614"}, {"status": "PUBLISHED", "id": "1771377790741917"}, {"status": "PUBLISHED", "id": "2195490081033921"}]}, "baseline_offer": {"id": "1489485306433652"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1795015560, "status": "PUBLISHED", "id": "1489485306433652"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1333862046487532", "version": "1.1"}, "id": "1110084121787931", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1255286791011725", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1333862046487532"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1110084121787931"}]}, "change_log": "\"\u2022 Added 4 Distinct Game Modes: Classic Rhythm, Cyber Overdrive (Time Attack), Polarity Shift, and Shogun Blitz (360\u00b0 Open Dojo).\\n\u2022 Unique 3D Targets & Dynamic Paths: Incoming targets feature custom geometries, shaders, and dynamic flight trajectories (Zigzag, Spline, Curve, and Linear).\\n\u2022 100% Katana Color Matching: Target cores, trails, and reticles perfectly match your active blade colors across every mode.\\n\u2022 VR Boundary & Orientation Fix: Unified player position and forward alignment across both Room scale and Stationary tracking modes.\\n\u2022 Meta Quest Performance & Visual Fixes: Full single-pass stereo shader support (no pink artifacts) and removed motion stutter for smooth, beat-synced slicing.\"", "created_date": 1794642499, "id": "1333862046487532", "version": "1.1", "version_code": 2, "release_status": "RELEASED", "st
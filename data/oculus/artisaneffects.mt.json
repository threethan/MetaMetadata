m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XCpUHF3QvIEQ7kNvwH_4Mqh&_nc_oc=AdrNCEfSL6UNNd2s7uBK_JD33-t2JLA-T4CRdjXjX8qWtBfz6O8ZW5x7WNYuFWcaR9g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6dybUfMXDuU9i7TfAB4vG1MSceyPAeUk0VImhvQ0G-tA&oe=69FCA21D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bT0g_DDaa4wQ7kNvwEGSz69&_nc_oc=AdoKsugc6J8fmXWQT2t4XZijVVyORGcVlq_K2uNGZZXfgnRy-SRaScJB7l6jkXo8dQc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cFAOxXVzL4auSRcZ2DPeYmPGqAv5Yd97YChnaqwAlRA&oe=69FC8F7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qefWXfWMdgkQ7kNvwE7wele&_nc_oc=AdpJ_9u3hmQyeJwVWEEzjiQXMORpsoSerYE5DHUROXIQoZYJ1ADrbkWJqPAJ-v1AFq0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vUeFqUuZ8fFfMJVBi0u6AnTisTp544mjswJY_LK89ng&oe=69FC94FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=913ftTE_cssQ7kNvwHFIHOo&_nc_oc=Adon0MbKZTBiubmz2hKnK5WCEZ2ojWt8EoR55pgUgQl6huXZ_rU-9ypdDoy0hIlxfsk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4m9DUHf5yCq2PNQ14aVZcWxnfOSMW_eJ4aHHQREjLAqw&oe=69FC91D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CtpN5-3LgF0Q7kNvwGkzKfx&_nc_oc=AdpqmDafb1mkHQR67hvLBHsOrd_UriU0uVr_44_OnVtP1-vqj1DOnBVSUs6qc8nppJo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5AXN18lx_L88kFR5mCy-sndoT85B8_FlG5UXk1duAC7A&oe=69FCAD42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
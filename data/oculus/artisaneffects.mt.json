m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8zn9-tWSOUQ7kNvwGBbnTt&_nc_oc=AdqLrrxxc8E85Ri5zXao0dRiVtrYXX9rMUZOUch2Vxoj6UNUTY3GgV-ZXEXo294x1b8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGVqFak5G294zCITXmnx-b-2baai1zEE7O3KWWS2g3AA&oe=69CBDA9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rzuYRMPCWUQ7kNvwEZPJKZ&_nc_oc=Adqegv1VY_22ORJW3isOo_otuaC-nB2B-2lIEQHELv2Uwfa8L0Sasu-QqSXP3INYu5Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfymZvJ-B59Kixd0SnwD9H2N6idTWjrXaWalYKHyMKNAkA&oe=69CBC7FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rn263iawPIcQ7kNvwEE13F7&_nc_oc=AdoXpfLswAekSOEauN0IDEeVAvHRHsYmxNg5s_tsstoxsyW0tbnmW70rsRSMuHIykf8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSQO8sAfMS3vtRFqXfegjnMnr-DQXJ8QC6bsno5vqGaQ&oe=69CBCD7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaWp28Rbk_IQ7kNvwG0a-XM&_nc_oc=AdoUO9YFTOOtowTsajXbCfpA3KCGEeEN8rxbKE8bQtI8GL8pUlnhJLhGoVwV3FT8cl0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTuAzPugf-XyHjOr44VinO0r7Gt9p5MwG6qtNoL-KWvw&oe=69CBCA57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHw6Bc8LTW8Q7kNvwFxayEn&_nc_oc=AdpZuLSD2kh4mrWAlMypY9rfLch-yuTItSkMB5b5Jv8vp_3N1e4Efs1_kftpduT2vM8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyGyz_y-4We6Ws-AL1ungbpTRT_wU_8jfcJPpexpTnlwA&oe=69CBAD82"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
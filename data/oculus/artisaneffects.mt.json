m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=olh2GC8_uGMQ7kNvwFVtAZa&_nc_oc=AdogzI4AGD6NVKRm-XrM9vuZFx6vI28ChyQ2bJUyhXrBzDQDUfoBQTB_Bq2CmN9ZRUc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0BK2RYKbr8VYMAmcCHALQDdbHlgWQFh0ACa4IkdxXuiA&oe=69D2721D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHSPMiewx-IQ7kNvwFm28uP&_nc_oc=AdrJOcv4ufbhTkKY0iq4dz2UnFkh-0pTwO7tugT3z2o1TIU3iF3GdffA9nN0bBgC00Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ftD0Kb2HjelXYG9BSxQMYJtBhaOMPr3NtU7H9yyftYw&oe=69D25F7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bP9YTqQX57IQ7kNvwFiq0Bo&_nc_oc=Ado5cvVbqUuXjlkUMBgKiksQTSQdGnvgbUyup821qMpLfocW_fts4IU8yXehJEEeEmc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pf5KpBi4rT5fljUQxK6CLPK_b9DmY7eVV818e6coQXQ&oe=69D264FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubOnq6-djFgQ7kNvwEaFQeH&_nc_oc=AdqjEguQYQYvrjGV56srr-4jG83dMY-gErq-rNMVkxqDrxsd1bGUcih8iDz6xkBDw7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af37tZuRDXiYf0X2R6F6T0cJI_BgMBakSmnv6zqAOXyVPg&oe=69D261D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WodZTpHo9YYQ7kNvwHdfpde&_nc_oc=AdpWu4H2L1nf0dUKqmKlHSZ_5f2yGOvzJUlYKrYUkZj40olcrMctdv8-QomLi3iKvt8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hQ6WZ7NC5i33V7mitmENgU3X4VRsqcueb_tH3WNtCZg&oe=69D27D42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
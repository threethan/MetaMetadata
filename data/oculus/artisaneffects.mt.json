m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJwcIWYvkSEQ7kNvwHK5Csi&_nc_oc=AdptC_cqx3Uj3Q6DWMEu8vR8-MC0u96Gqbhr8vxjC0xSBuZwXKbfOrnwmZA7CEqj520&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCsUqu1ILn83Ci-oggK3qIS1ev9LpiZFvSjSslOJmi5MA&oe=6A5F829D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiPWD_ZK44YQ7kNvwHPYOuw&_nc_oc=AdoKkRZ5RNmom-JY9ZZ-FSthGTs5jHTsnVoZaj0_v6VajyANEHDRMQJeND_OA5-kdGM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3X0NlcuCdrlXzVKBFEcp-u_EQft4DbQO3efKwa_pAgw&oe=6A5F6FFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfb4D96mWq4Q7kNvwFayZ4A&_nc_oc=AdpbPdf63Q54Fh2zo3GzSb7-qMBRgspkNUzKfTSUfstUrjrFUcgItnkJf7usWYTH9Kk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAN4m9GVAEFCSesh0LR66aa1E7_QP2CPAarlFIvq-AG1g&oe=6A5F757C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bILp_8nEGXUQ7kNvwE6g5S0&_nc_oc=AdqrxP2b9XU8C8miCqdytbPUXCsOrdPDuRZaOY1j0-RgBLH65fVzOu5n4-HJ-OD01tI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuxtZcvGQBvF7pYa_W_2FPZgx81qISIzSXT1gup5DsVQ&oe=6A5F7257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjgAlo1fXT8Q7kNvwF2WCDp&_nc_oc=AdqRq9VMu-BZJkHK32kFm7aexZvGq9MqXyyQJ58qUmXKn3JwKQTIiLWi4CLrepfe9CU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQApFJAQUpTfz5JQVssut7cWzkMlpP6s6VMNa9H--38MYQ&oe=6A5F5582"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
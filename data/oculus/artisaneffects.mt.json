m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kz6nhkKqdtoQ7kNvwHETD37&_nc_oc=AdpH4jJa8f7yvwAOHH5VQbXfVJ9LyD0p3L8TcQw5a5Op8FhRZ8lRaK0I-YqE6d7Kh_c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL10sXqKfQGp1lb_4vzlJOT2Uoy9RSGJfVLv3X7MFThjA&oe=6A986B5D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfNnpJNk8okQ7kNvwEhKIJB&_nc_oc=AdrPcR1CLT_adDRnnInPCrEfhmUjYxA-ttshKAcTR3GCCnSigyJodrL32VJePdEcTrY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIrPwsS9bQo4wPDfjWcxyV_Up_AXl_yF2C1aRdMVGQiqw&oe=6A9858BE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K5_xEBEmz_IQ7kNvwHD4SXG&_nc_oc=AdpzHdMrAyzUKoVcqqahuzsiwDJLOqXWvm0q6BungXiZXUlln0WJ9RDR2eOc5wA5cw4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJB3DG0-GsTgkcIkFfV-LksJs9puszwDI27Sp06FzI-vw&oe=6A985E3C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gm4mABMHKHsQ7kNvwGP76Ge&_nc_oc=AdrEnJ6ctITPs3AOsOlzdoWjqaj4posXxv090mZydpwhV_n-deYEjMpdUkaAzBAUicY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWKKTko-iiiCyPmH1XoNMf9G1kusT3wGX2XWlp9XD3oA&oe=6A985B17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-6o11ASs8a4Q7kNvwEV_fXs&_nc_oc=Adqlc8EHM5uO1By8nG_BqNmAOXg9b714k7BVPEEk1ZB6kXxSQL-I_bXLiAmQARF48Qw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJOl2I1fT_o7jedkDhc3xLcKmpZqEyXz3FPDCirzv5yzg&oe=6A983E42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
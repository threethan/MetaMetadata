m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyXQVbt0SnsQ7kNvwFh3GGG&_nc_oc=Adp7aZNaW3A06imqyJkltD68p7yUXmLQwDEwPoK5t85LojsWv1PeKaYe91_nlUS9XUY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7gtFIi3xfpO8RA7olQNBogqjilKP5dvhpc3IazabZLiQ&oe=6A01E81D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez9aAYz-2l8Q7kNvwHhmcyZ&_nc_oc=AdqxKdzPcHXFtW8ZCR-PVURsOWZsgjWlTwbx5DB0YGuy-D1k_P4hIqn1uVawOIfGkdc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7TiWyU--dnA71Jg43LJD6P-r-NmPDKuPpplL9ltS3KwA&oe=6A01D57E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt8x3VRUKNIQ7kNvwHPrica&_nc_oc=AdoIbOLDOAamJFGNOr4GPiehIinPzoo63wBiyxMOOOLJWNbOf9y8REZqponHOO05CmM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7aJFpAWejrpE3Il8Clmy1Vyxssw9SqeKdNnUhU8nzqXA&oe=6A01DAFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCBrNi9D1vsQ7kNvwHbiODo&_nc_oc=Adr24TF9dvTghQyYmqJ5VZiNzsW7ddCxsjveUzEQDj748FAsvLBAf0QHhYq28TYmJto&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af41pfK_313OE--mHKx3RiBRQPV7StEZ18Cu7wIwSz7JOQ&oe=6A01D7D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsxI2STRfjIQ7kNvwEoY3WN&_nc_oc=AdpDVYnZmvx66WmdMLb95__mXw5vXu_bySEa-EOIc-kFbN3UIrX0ny8mquAo_dDBBsQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6tnGm2XnCz89m1LBXE1bCArgpPVh2w5rMvkJWmR0azug&oe=6A01F342"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
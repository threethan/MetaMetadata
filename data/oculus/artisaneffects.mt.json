m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trW91gP0uYwQ7kNvwHgZTrc&_nc_oc=AdpQ0bZ_Fmhi5FweZZPTGCRhUOOAPw8BvlyoTwznWkQuVDGJFkbF2unOf9_WsPZKhIM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Dm-VlyzjR90P2Mlw1S_PTMN9i4d6kuYk54zxa5nZstg&oe=69D7B81D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFHHy6X09eoQ7kNvwHaGbE-&_nc_oc=AdqT43m7CVuADufIoLrc6PaNUkK_Zt9fsiTfqJyK-Vau-eXP5K4tyQrz_e3jvm-mslM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2dzlwN2fP9FfkST-I_O6fzMDOUc9SI_oiXDOcp7MZkLg&oe=69D7A57E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mouTgPldNYEQ7kNvwFvjOYS&_nc_oc=Adr4LBLB6D9qjKqXvVKL0sY2vNKFXSVNBCGP0yTqTHC8d4VlikT8CGRiCNTuJpYKHN0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1C9GU5KwYFG8IdGfoFMCp69ZIna7TQO8LAQWonp4w5hg&oe=69D7AAFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itOkvabbQdQQ7kNvwHEYMjc&_nc_oc=Ado4vxUUndnH9ASBk_5ZnMXlGHk6zLAFb4nUCuJU0O1R9ZEGePJRQnifmL5qOSTJFv8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0LfNx_F-0ksfFv5j-nYuE9V78zFfpgXmdGuLvt1xsLjw&oe=69D7A7D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoosRf8_FlMQ7kNvwHO2fDE&_nc_oc=AdqDQD-VHsUJY6Wlr7xBvNfxHuCrH8gUYlkH-ZC7N0XcFcShfjRsVPAzDA5n2AFvNS8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3JayIWnHpjIa9BSktz6AyiovBmclaZWZfDRHgL1Qy7ew&oe=69D78B02"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
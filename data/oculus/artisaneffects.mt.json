m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DknMpuRbSUQ7kNvwGT0SGu&_nc_oc=Adqwqr6rnWnqFAhrbnwGLOhWUl9aG6a5Omsu0zkW-AJet6z4TyEFeJjA6vtumf_KzBg&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdJo4sX5DWbllOypEtMSQZtgOavZLlrUTc9pZAJrmP7Q&oe=6AAD4B1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXhJU5_3BysQ7kNvwGYHTHZ&_nc_oc=AdrZBhgDDUcUX-GXkIY5CZ8msE_vJTZj8jh04UMLgtFKdjUmuC2FHriIa99Cpna5dGk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI3N39hmrmuU3DyJKyGptXgWC4pfe-A5F8pRQT_Ywy_HQ&oe=6AAD387E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EUEY-fIZwcQ7kNvwFV7-jM&_nc_oc=Adopy8HW38TKzf6Pev0SmeszloAlSUCfRG0u-shKR8xMqPwNDDJcoZdnQL7H-eZSk8M&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKYz-KZgvvHC0kaBlZpiwRjg10zTVlarjwGlj__1RUrQw&oe=6AAD3DFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZJnmbp6cusQ7kNvwGAMQk9&_nc_oc=AdqefUCZmI45dChe5Aoqn2zpTB811E04_NAdDeRqu0HmOMxDcUtjUMcczI6KoPhGFvs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKg8c5n90GZtoxzYIWV57-dKqydLjsVWOiUaygaBZF_Og&oe=6AAD3AD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ9Y7hjWx5kQ7kNvwGIefBE&_nc_oc=AdqlYXcSyTtTdtq7POWQsVv4z6RpbJzXKPtvDiUQ1dQx9OVnutts2ve5SneoDLSq9LE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI-Scu9YoaQXj6nczAlvlDCASM8jht80NqXEbcnrnJaxw&oe=6AAD5642"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
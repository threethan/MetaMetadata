m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3pJDb2aU6IQ7kNvwES2Gkp&_nc_oc=AdodHvGWRqCfk6-RnWt9SQlHAw7PHeB2vOVyBW6eww43EU1Vhg9yHg9P5adx169Gvb8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H0YbxUUvQLLm_WfE25PsOGmeGkCZiVfwblzfREDDm_g&oe=69DBAC9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiUhdGQMiGQQ7kNvwFLnyk7&_nc_oc=AdqvmLlYH-9LqExgQRIXG0hHsqUDYG9R5zQOzqKiNsqOpI1T9WmsjFdCsmahxBKERTc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0m9ixmOlKCrKbgPS5IvdQYKH2sugcvp9aDvofNy2eWUw&oe=69DB99FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6WjJ0QLAooQ7kNvwG6bURD&_nc_oc=AdorG_4BE1oIsAxczK9irVCSMdF5MROy8oLTUAuK0iRKWBn6IImNJFzdNqLIacxeJN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0h8vMsoi_6TpwVMWRyMR621ZhZnZ4sUs45To8zE6vh1A&oe=69DB9F7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q4Cp3xTcEUQ7kNvwG9GIiY&_nc_oc=AdoMgDYdN77KpMawjNwwQxOdSXLLUQML6_Mha21pSXMi6gFsnkV9g4NIfpdKskCi9Iw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2nsRs0IXuD590C9A9ayPrrMzQs3Fdl-sPSBMFO4nGY1g&oe=69DB9C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F_N4i6vze4Q7kNvwGph7pY&_nc_oc=AdrYrQYAr-RMpWYlqOe6GS0z1-3Kqk-97Z1-cc22mIzEUHM63moMgL1FBpi3mk4-FLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bHOZauAnFsDTX-0e8Fv0MTIJKA6d_KRg7x108DMPmPQ&oe=69DB7F82"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zENopozxP14Q7kNvwHUUr33&_nc_oc=AdrV9xTfo8vcI_SUhXDwn5-00m-mSk-HQXSnBhRBkQC4z97MIm4EP_cxcSyYrwWyalw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5e4Xm8iRkCLK442Bef-Csz7YMWsDu8FOSjHxL2rvGIFg&oe=6A048B1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DsisU5uOUpAQ7kNvwF4K3FQ&_nc_oc=AdqM7Dt81ZzNekoMLSG0Uy9ropFVsWY4NRVr38BgKv0t3Rp_4Kz6OKTXx3nDj2ZRNtY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5oFW8IyXSxn033bs72mnAgrXdw1Z8qbJFJPYrUmPuJqA&oe=6A04787E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4Hstxv6dhVYQ7kNvwFSXz6E&_nc_oc=AdpaXYr_tXmIoYGptgH-9ht1RKnABjwinxS0SJuG7XbamQGRewlsD1ZyxokumSyUUvw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69sgP1pNqOb6mFJhq-MEA23cHo692aEZxklN3jlHWdyg&oe=6A047DFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC8d-GyeADsQ7kNvwF-78me&_nc_oc=AdqTUlM7rUmxWbherRtVvgVRfPpiC3ZSPRnI7v2uq16I6vwcgX_oT3Galw8WNVRP0rY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54AeLETTkHsIFz1b6vy8SwhdfW6Q4x7mdBSCayFqayQw&oe=6A047AD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n4p3UkqkF5YQ7kNvwGqXSaR&_nc_oc=AdpcmRTF1TpWzzdM_30X2ynASsny4P6yboT-uAl-0m0GpH1I3Lz2yOzUoFew8UU7wig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uLH_E-xzfyLvFsqVnweYAqyyrFAH7hUTPfA_c0cw5eA&oe=6A049642"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
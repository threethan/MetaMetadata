m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzq4cz5EaFwQ7kNvwFjMEPH&_nc_oc=AdpB8gIKDaikjO9EYK4WRvteVgAehDeVp3ZMKwFRrzFCWjEeRygRdY_Qc4UFb55Lk_4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw37_P5TiN-XLXnLHrg7HO7lbNIljkN0cHkOF7vTh_taQ&oe=69CFCF1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tHSPMiewx-IQ7kNvwGcjUvm&_nc_oc=AdrdPRcblc3R5uV0bCY_EN4xUklDEGPw0GH2Kk_ML-V_6HrXDEfm4RrNlG8YXjYaXEQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyj2uxc8LTNz4DRCNtO_2y7cvQ_x9C5a73YK-Jwf0zHMg&oe=69CFBC7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aOvpqrK9q8Q7kNvwF_zjep&_nc_oc=AdpIBzqspFZQfdfzCUjDjpuZS44dxeVMpkUWcPDBRxFEWVoHQS0P8ZZrD84roxxzK9k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwItDdnYor10TQqirVsUkUtwF2OL-MBHvpudmQU7WXWfA&oe=69CFC1FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ubOnq6-djFgQ7kNvwH9yv7i&_nc_oc=AdoWF50OJiQU9-EIJVAA2DAgLZp1fY31SvXy7l_yLB21wLUqFh82-rXE9StNg4fswWI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyfthztZ9BHU_unTyDyFPjQ0Fl7SuYAPSn5CeEJute-lQ&oe=69CFBED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WodZTpHo9YYQ7kNvwH3KWTB&_nc_oc=AdpXRhn24gRyu4GAja3VpaCOOmP_8t-1hEU7CCxNEtLFM5YtNk-8rYZsOAicN_Bd0i0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzuhIISU-mNLpHrV3ofs3iRqrMg0OYVlS9CRNuK-vjBig&oe=69CFA202"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
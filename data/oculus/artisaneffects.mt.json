m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UJwcIWYvkSEQ7kNvwFB7vLL&_nc_oc=AdrdT6bIhBmysyjTwFHInGI26iSra97PcFA19mFSHjtCJZLUygOa0UPR1CJVc8xAy3Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCMCj3GAzC9Q9__JReFwGVdjb81L7f_wVMV6FDUrC8mAg&oe=6A60D41D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wiPWD_ZK44YQ7kNvwHoLfbz&_nc_oc=Adrb9wsdtm9lPuKKXyy3W9oooG1J6e1DktMsGmwx8UFxJBfjP1bjmbsaCOBCycLBS_E&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2tAW1WvX3S7yCK77pr_ZRK6G8Cl5GgJpOUWqLElUjjw&oe=6A60C17E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vfb4D96mWq4Q7kNvwGOMn7E&_nc_oc=Adp1vOkliWEcdwczHWCoXanutf-EgLAG3FXo3cHN-xQg6XEs10QtLx-iQ7PC_HhALSk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAS1MhHajF3ajGB-Y_nyM29jyQ24sSd2YhmDh65Hw2fMQ&oe=6A60C6FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bILp_8nEGXUQ7kNvwFm_Sr7&_nc_oc=AdpQB2RDXf5722CFnB8lqJXheQkMm2mT9YAeGY-9TmlmMjvxwgOPVSI2f2QG-6PGo_I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABQcj3lbW2x23UspdQcP4SRXJA4KPiRQ5Y2YHiAssmDQ&oe=6A60C3D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LjgAlo1fXT8Q7kNvwEFyvZk&_nc_oc=AdrVeqe5rib7VdLiPMruFDWXDEV2p2FHnWJWQ4nWNGpblkAXA5XRQvBJlKBJ-UgNk0c&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAELhb2JROGs1E5pScZfz6Bc11U3-8FTjTDV2tus93Vlg&oe=6A60A702"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
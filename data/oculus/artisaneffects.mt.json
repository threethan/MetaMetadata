m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK5hJiWej9IQ7kNvwGmGjGv&_nc_oc=AdrmzmKyiP1WQacwrQJKJeXno-9yAdPUYi5U3JZKVl4p-azdcaC1vh0mimOmpZnF1_8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ6lylRv6RsjOS-Hgf0kQ2_Fg_paWU8c3o2l0QpR329tA&oe=6AB13F9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gArOght0KwQQ7kNvwHQak5a&_nc_oc=AdoSGK4KfUWypCBDGxU6QiftdqT29McLTbB2SOew2-c0Qu28SqziWzae2n9dSx0xQAQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJwRRS0E_MbTXDfYnuq8Hl5Vxh2E5H8k0YhKzG0lMEX3A&oe=6AB12CFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVJAm27BXq4Q7kNvwGAp54Z&_nc_oc=AdpAfuHnPHeOgbA1P5k-Ar_zfnCGv8CEuksgts0fh6J54xyKI3Rb3H8H4JUr9J1Zj_E&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKxGSK9vR8NBF6aIKGQpFV_nb9VevfFA7pqKt0z4c1MUg&oe=6AB1327C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-GGqpO9MbwQ7kNvwGC-l4I&_nc_oc=Adp0CrbimDChXSRPAEDUqlii-I_QWSlxkJmZGRfoL7NJ8uhA_Sdb-qlhZrxLMWHdkIw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbdwOu0rORMOfCEe6eDctTJJk8tv61LH4np2KVg1SLlA&oe=6AB12F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px7EaQrfvr8Q7kNvwFqh5eN&_nc_oc=AdqYjfhvvuiOQa-Yd-qihgVr0ffvIYqQ2_Arabhcha5XAJZDQAiV3MUXxHnIYqsoK7I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIuTEwdW9ODkW7OCglkFrdHt1jZ4KURph_HPq4fRcjtbg&oe=6AB14AC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
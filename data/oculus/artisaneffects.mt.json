m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dm1GtDCtQZsQ7kNvwGx-9Tp&_nc_oc=AdrQ43DU1lexwGC-ETvTRdKVf-h99EOEzjCqkn0qLxpvjoLrsl-dlUqPZ-6TGyVZ2FE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQE44WO2tPaVewlZ8AyhIiFXp19MsIdozHMM48q6jaXg&oe=6A9C279D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HWZWjPDZaEQ7kNvwFpqdYp&_nc_oc=Adq_pSL6_nYEMh1JmjT1hxgehK1l2KZurtLFbZxBhw6P_8pOPX_s1vidIfFdTcWdU7A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9POKFJ0VQEsGVoo-mcQ-6LVatnkua0C1219xvb_dMug&oe=6A9C14FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNpKyFIwtJcQ7kNvwF8uXOJ&_nc_oc=AdpfBFJhuIpAJcS2G7wzh5BTbB-4FxcLGpKyexUGahTUhzhPbG9k14d77M5WbDqISjw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIRKxgsvu4erewHTj8LOAOsn-iNzCcYhRGTkrGUdfc0hA&oe=6A9C1A7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G6v-sSjDAAQ7kNvwHxSWyw&_nc_oc=AdrIySfBK5V28MHu8h0QV0E8qx9ognmsyqaFNWZUrbGDC3fw5p5AD3GAa4S6e0EP48Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEMMwnSYqrWlUySkUtRQiKkB8TXW2992uuoyHtI1SlpA&oe=6A9C1757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLo-pXwuWnUQ7kNvwFRN9Nm&_nc_oc=Adovrawcpa2K-xo7nQwwsHj_JhLVOYQl7bgdnxaAYihZJ_KBDXousMmxbWGpX-SLwdE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKemnSxRXyLJg-LvcvCXc_joPozs6OZJa-YE_aPobSFeg&oe=6A9C32C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
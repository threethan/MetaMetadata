m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bRb5qHXsyYQ7kNvwGslttK&_nc_oc=AdpXbDJSWhQZI3PlFmsy7vyBC0eFs9cnb8gndziVoMmjbo9QDoSl0A_0r2Bt0Hvh1A4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ZcIMQOHXjfq80TDayEeyG1IsMmlydGc7KXkPB-ELCVQ&oe=6A41301D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt88TMPqQlYQ7kNvwHCQZQv&_nc_oc=AdpGRiQZ2taTrq2VLPFKg4xzBeYF3uZyGIj0BrtMe0u9xFwiPLhOm6jG2ibK-oIatqY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P5egAGRUcfHknRhdfPr8BNJV2ThmWf2Kz1vGqTkL6Dg&oe=6A411D7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYYLgd1sCS8Q7kNvwGefA7F&_nc_oc=Adqr3jILcmDe4lPNBCrsqSp75sCaCtixIFpPsc44nScnqGKw7lXnxaSWrC4FB8Fpmy4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-wmxYI2Fnxf_M-aW4VfAR281cO26LKa541duHowykqBg&oe=6A4122FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJBAbp_wbkwQ7kNvwENfoCG&_nc_oc=AdpVANk0sSuXh9waGdOJcG7iwRvIiAf5LZgK65MgBE-hQH-0a0ej3oQFt4A4IjcL89c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_I1g3eDfHiWwJQ-5Z-UZz7PksTQj1tr2df1DqOtyGLIA&oe=6A411FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4reztE_8xQQ7kNvwFa_nE5&_nc_oc=Adp_omiUT1OENhFQcrRpT6N6Tj_hQfSBMuATBw0_1BjQn4ptXmbM6YaPyqm8DtF06Lk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99PZ8rH17CIN7UtgNNjRLlCVofqK-Ik3WHuvc0gxx63Q&oe=6A413B42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
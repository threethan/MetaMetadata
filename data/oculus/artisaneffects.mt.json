m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnONL4ncHHQQ7kNvwHKWVFi&_nc_oc=AdrfhxBwwJMJbY9Bj5E3zxQmFlBm1MQAfocmnXuHcHjY3P4ACzV84dC2h3NuT1jZdho&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5pXOa-1voLqHNA_x27E9HZXwnbH_5saNoHRUT5m0LAQ&oe=6ADCC11D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IASMrYWRXcwQ7kNvwE6G_eX&_nc_oc=AdrIN9SxWX9VP1mb7gZtU3FJBPmjd913IP_1Jxlcg_Vc_HPpnfj7A9vI_LiUvIEmBXs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMggExeff3asapJ6YF1SS1BP5ZtSK34AjIS7QUpf19gxA&oe=6ADCAE7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2vE10qDtEyAQ7kNvwFSeU6s&_nc_oc=AdqYbg_VQ7upNJKAIsf8z6920TytOijvymB6ruqPTTYhlIE7eUwBplfgGmDkqGrYfaY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPRErr9IEwclMjNMwyxsx8oeqX41lFduX2WNChKEMo74w&oe=6ADCB3FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr7IYu-oucIQ7kNvwEyjErm&_nc_oc=AdrFZUkgU__63USagGYD5gTRqhe0-TbH19pfe5zn7S2JMuI8f5goRyD4A8Ezrg9cHwA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO5TX2kqTGLa9e5VrOJLzMl1teZKwHXoMe8KBrD3aN1RQ&oe=6ADCB0D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cFAvtu_D7kQ7kNvwHL5D7u&_nc_oc=AdobXGRiDSUPsBbmW3nwduRHsqIre33FxvZjvF7HsKtgohsFl1MI6iKv-NjWLiJRCrg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPioG-HRyQtlSeDiZfAnn_EKTQoNXQ-BUnMzUCh6C56eg&oe=6ADCCC42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
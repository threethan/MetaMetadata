m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiJ5fRxhuqAQ7kNvwGq0RcR&_nc_oc=Adp-5yAlI8ZHL5eff7kik2CnX15JCWXGLwqYwvoV7sad6bQSiebbwmYxdSOsbuDhUF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV_AE4IL7-54CSO5CzZ7ZK7g2zJ2ZurRcId10kTpglxg&oe=6AE9F01D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaot20OcrFUQ7kNvwEMCCQ7&_nc_oc=AdrL5ZyGAFR1F6uArWCi3WIZyXSYOJJWMJh0QdxI4Mg0Le5GT-84JsTQoEQy-6kiEcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNbLuHTkfZIC0ty6rQ-yITmTRr2Rd_RqIGOU-z5CDgZg&oe=6AE9DD7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydauOctVp84Q7kNvwH8bP2S&_nc_oc=AdrZz_M_GT4TamwHdg1tlKi7eiQRmWNWpy82tQtZLC-aZfZiUqyXtZXsD8ocyXQJ87k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLnaOSe7blRH-Xt_teLOZVQMHnrIqQxletv3g2uKYppg&oe=6AE9E2FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFjW_XwxLlsQ7kNvwGyKmW-&_nc_oc=AdqnMYQqh2k4XrPru4Y73vba9bwJO-dVRtV7RxtvijvNUEYiJah7AiwenN4pYoDgG1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTcJnCzCom6y4NzYTJ1vp8ASidjFQqXUsXGvhhE7bjTvg&oe=6AE9DFD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sNk_kiJBV4Q7kNvwF-DOny&_nc_oc=AdpwPWIc3xw3aGEOZC4w_qPMx8zl-gTJPm4vWdLynjG3kvcXu4ybu3CkY8pk6pnbeL8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8SSwHpBviNU1j-k090GA8fVCMgp9IWUds7aM9xlMJaQ&oe=6AE9FB42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
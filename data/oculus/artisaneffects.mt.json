m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuGrXK0ButoQ7kNvwFWz_Wu&_nc_oc=AdrbjflAZRbwR3wNqUsCIAsbym36bJpWj5ZYeR556PtGuJF0YOlMgcgKgVoCIZTZ960&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREN_xt0IX9bL_u_p4nhKZc9wGISxSEzpmaoW-t40N-Iw&oe=6AF0879D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbfXY7TNFDAQ7kNvwFBoAIJ&_nc_oc=AdqqHPkiCNFyR9IprzxlOf4aTDkL-SvSlNL8ggFTEiQ2xD1mGJ2PlXjK76QqDl5ea5I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTedKOC7sPt2v83JYEaD7jPSjNRUTfNysbewpZOhrN8Qg&oe=6AF0AD3E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QX-vZmVq2CEQ7kNvwF34eRs&_nc_oc=Adpcyj3WuF6mOFO7g4K3iXa5f8QVbo5uZqhdadqsap4pZ86p7fmmGuYDy78ObhDb1rs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGUkm1z2rIXtAf68WnZEwBJ8_79E4c5a5CuiyanGfxQw&oe=6AF0B2BC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTLhd2lrTRIQ7kNvwEB-mmT&_nc_oc=AdqgVk-amUZ76TaNJ3tkucUpZgc587HSMqP9CXp-gyEYYwUhVYSNAwLk1PxGAfzABxo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmvEFzz-8jMCW_diS07-P6QfPsFKxOf8N874YYz7lORQ&oe=6AF0AF97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTBKTKa0TW8Q7kNvwHE68f2&_nc_oc=Adq6w0PIBp64-E2hul6zSMubiWg8fLzAfmVoj4Hd4dtYFzYfVeIqP8l2BIHDNlUPT9Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7UYl_52CdDffERJpFAt59kut_YxJUlbRC46JXxvCfJg&oe=6AF092C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrQRhQ9JXWIQ7kNvwEZm6p-&_nc_oc=Ado5-leb5QlcXZB5KPHBH11pCpaOtRtGi6Sa8UKmjFgSaT3v5InnJjYQNfrjRtXFxz0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNki9Aj6vOuYrZN9bB3LiptJNyEWxTNdjc-ZST8W3J_gw&oe=6ABFC01D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv1_B4Hg4soQ7kNvwHp23Tt&_nc_oc=AdooHXGkat5Cy3U6oYZLOc0sorJruY4Sz6aPN3SV378FiwHSxJ9OACMz6aZVwv7Exuw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNNzkWN9eHM-nHnlccK5rN4gdxz6uVLGTAYCzpnehov9w&oe=6ABFAD7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faMDKJUJEwUQ7kNvwFxF18x&_nc_oc=Adphmkt_7WTH9YIRSdQthGENhvlboxi1XfzoO24BcrVlrkJ03IDbSkW2I2FVbprJAhA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMSlSybPdv5Tn6Xb1bPALDxsTqW7HG3BKCViB_btFIX8A&oe=6ABFB2FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsoeT2KY9FQQ7kNvwHUXKXf&_nc_oc=AdqAulOUnYuyxS3UoGXvWoBHQm4vHvg6oEeEhj_KJPuLyhU8hPdJL9Gwu596hSa6Zfw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRggRrkyuTMbL5zWI7Mewv3etGFfFkq7xSGLZ-tDOmeQ&oe=6ABFAFD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8A556zV6tMQ7kNvwGd_SpO&_nc_oc=Adrr6nWx-ZtmO4zHl5rjZjguvJ3RPnA5p7cfQ-yJ7HXwA00jUmH4RiUSVbEDJnfhOvg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbN2fMlb0v-GZ9IxsB3acJSkz6IekPXQrcuJhV4eFO2g&oe=6ABFCB42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VEtwBA6SXwQ7kNvwHk-aaR&_nc_oc=AdrY-ncasvSCmdP7MiboMgE1g2xCeyVklUvAuRQAYm5JfRc3iDMeruCgkwEwk9ik1iE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJMaDWIVWJEc97iu9uIGeGho_EY2NLPLVwVbWBrF-O8A&oe=6A676B9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wq0MnYp4NYUQ7kNvwGpAMsK&_nc_oc=Adpgo309pFmh59xgNsjxrVukH1XK6rfjqlhgyeMwMJNm8QzclxI48yzoH2vWZNmggsE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFWA-AMNr9GZ14tCTmwAE6WmFVh7H-aPncPvi4vhw_jw&oe=6A6758FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cje5AWMg84wQ7kNvwGlQlOK&_nc_oc=AdpDFbOrvsO1kTRm_MTMWhEO6km6_05d_BfxOnu4_DB60bhRUFh4M7jimBphVIgaZLg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAM0XBP7CsGPVLlGxdd375NaeAxinQIHnuEI3pB8cGCLA&oe=6A675E7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRuSrNccQHcQ7kNvwFdxs43&_nc_oc=Adp2ndjI2_7ae2mwD2l0NNQvWHSit0FGUZDLKBFfffjhwLtrFlbvsc3FX7tyTAXnciA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBczPiKwgwOIUcGgtlKmZ_2v54i_U3eUCdwBA9N-YfSpw&oe=6A675B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lR0ADO3pe4gQ7kNvwGjV2B_&_nc_oc=AdqwzzmqsR-johOqIOeB4f0TO9hBVI9vxZ65mnlRygp09sB38Lf_rg0GM-P35famduc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB3PIiV9l3szGUoGIp9voYwoeU4cAZkTl5VLZEQkpqrOw&oe=6A6776C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PYVe6GD-HoQ7kNvwHEsN-K&_nc_oc=Adrws6OoY-OU4D5-mmXjY3Ifo89N-0gYJ9dACR-pjIM-DylSHBX7x7ComyJ-Qm9i79k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCD_wBtvlIga4Cq30H-bX2ivx13Cjh-M8xQAsJIbQMFiw&oe=6A4A6A9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwjTCF6w1eIQ7kNvwGRS6cu&_nc_oc=Adrh2LwHzzZtu4-Wz0e1FnfgWWsEkqGjcUu-w095SQ3b6_DSqsfSrhj1JdIp22CJzks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD2urebeHHskLX0Ts2FCC1ok1iDzp-m7gX091KhFdq6NQ&oe=6A4A57FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_-nFoNMpAUQ7kNvwGfMXSX&_nc_oc=AdqmfcZQpB9F2eEi07URbHTndfh0laHlHMWanKGxiywuJ3HohKDVvrHhFbJDgmbXhSM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaIkMomdvjSG8mUZe5Om4CbqmNKCBy4C4AYcnc8rzYvg&oe=6A4A5D7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LA-O5hmG3kAQ7kNvwHUaEeJ&_nc_oc=Adp1B_pryOiqOVknMmM8p7dyfAOSl_GyY1NPM-qbhaOhMMQyUfAbH6W3MZiloVACvXU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDif1CfokqlkVt54_7WCoTbx1Eq19N2AmlcDeFp51qjFw&oe=6A4A5A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7ivZgT_A4sQ7kNvwEsVWLV&_nc_oc=AdrMWJTncYx_V4e-e7lkvB9fPaSYNYiNQXaRnttt_YnseZhekC_OzE9OaeRgxMfou1E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBy7T8t-c6ltJYHmPZwWNx8Mqrt-qem7L8M3kg28swyxg&oe=6A4A75C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
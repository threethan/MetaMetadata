m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88ITDq0qVaUQ7kNvwEbRExw&_nc_oc=Adr6eNGoenohUE3VpfvsAyfQHwYwFJCYOJGDMm9OjFIPMajqRaSkDiuvrfTmb-8IG5k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9b6IELpFM5E2vOFN1PRipVIePbg2VQTwHLMp5iyS4ezA&oe=6A315E1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cPIor9Ijn8Q7kNvwFIinQS&_nc_oc=AdpUrWYstbb3kMTjOn9ZFeKjDlYCqGviDG4uhL52IVO1qfPLqj0uZ7m_9o9HtN4zJ0Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ekV_Q34JhYr02PTafXG5hWD62lsWH30sMVidwm8E9qw&oe=6A314B7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOgtuxNT2DUQ7kNvwG3CESf&_nc_oc=Ado87XUEuMDYHUPLSfev5cFuYCPurjTYJsTPB78rkI36oBMc1RNXpIcv_RBBq1Co83U&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TNO-T-ei1Ff42hMSk9M1Ro3OjcAdmuPFdmL1hB9X64w&oe=6A3150FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovQg1sQNV6QQ7kNvwGm9OXp&_nc_oc=AdobEWrcR8LJdz1NBZFQQ-FXMwuVKuWATk41XXCus9nUAxwSZMzQb6HMUhLChVKOWQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zFoN0VlehI52k5Y2siQSmC2t7g_haA_UjWI_JkLRLew&oe=6A314DD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wiWWBaQUGwQ7kNvwHDUoDH&_nc_oc=AdopAjfHf3Rrm3nVxs2HkTkEoqUB221zPgbeaFbLpUcafiUdGpLaz6OOPVlc1WGwfio&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FjlIBuTKOuEunlF8sFewfAErU52XJDLrCesnUazQirg&oe=6A316942"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
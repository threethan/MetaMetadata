m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PawHfs2hiYgQ7kNvwE6eWQX&_nc_oc=AdqVlPmnzlfwIynhHphqwDpuGOAx3Ya6fy2VaeExM_MSxs8Du4gxfgmM_0lwO_L_P6w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0DOXItlMXh7vPZGTMVsLTK-P_OkSfEk9s7-mQ8UsJ8jw&oe=69EF731D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWHleh9bmDcQ7kNvwFwpLdW&_nc_oc=AdqyszFiK3vEFs_98Xpiq9y5w1r13wdyKtPkRkNiOQxsf21e3KkOxQjXJHMQIMtvrYU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0pcilw_5Q4ThF-AIwUVhMwIXTVDs44unbxsrfpon5YQw&oe=69EF607E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI-uemAYO3QQ7kNvwEcdspy&_nc_oc=AdrgO7JgB6F5O9_wOT9Jrynv80gPeNHwALaQtveYk7OhBfxQIwS7FdoI3yqY7e_LDpI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af27ZIwmYPKe5ENzpPq67r1eqYLM1paJXRyDcvMOs4E9ug&oe=69EF65FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh_xhKC-AWwQ7kNvwGXs6LN&_nc_oc=AdrfTS7X1uK_AOWS6eFHroTk_XcHAjC3VqmxI2zsF_VPgmD-RsjKRhsSRHFLODNM_KA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2mahT_nY5oYwGi5OOJwGSEIHe3XlMvhl8AeEJ_9mXKwQ&oe=69EF62D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVOuDI5CNIoQ7kNvwH084T2&_nc_oc=Adra6l6YIczaQ6vn0lzfBEkH0Feg93orJ9eYVXmRrosjNdmr9VGcGlDz8-bWywM61yE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3o5G09fMLZAJYRSing-oy2wSdQxJcJ7sqGtQMyEeVAxQ&oe=69EF7E42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
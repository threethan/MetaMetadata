m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbctG-GpZ7wQ7kNvwGl_RZW&_nc_oc=AdpAC1lvtjxJjTQi4ItPq60522tneCLW_4IW7dtE0GwhhuqdSCgAfdVfYvFVW4-Rb1w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRJGvcCXXLzSrf_5GeadukMKmrq65kUnF9M5QeFGxekw&oe=6A661A1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wq0MnYp4NYUQ7kNvwFfgbpV&_nc_oc=AdpCVKBbAgeA7GtYeWgwfttLSIvE1U49YKVYY2Dv9VeJXrD7Bl5QSgA48C52ZGRDro8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAV7EmMo2SvBSi-xCaMHnKW6iq5NppXWWnilpuwzHCONA&oe=6A66077E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFLpRbF7wgMQ7kNvwG3LbTr&_nc_oc=AdqjuLJQo9t0xFE_kiNaWEWKzrUweHppQtla29dks8mRai_t_but57iQnnBl7zwmVOw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCzo24ohOMyGMzn2KojEevf8NLwHRtA0-AnxUGGL0oL7Q&oe=6A660CFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRuSrNccQHcQ7kNvwGsj2ne&_nc_oc=AdqlzuFW-Dqcqjc-JlxKH48gelLYexrLDsJckGzHKvs6xPoDL0x1taPO6wTKmKEmA_U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQClgLwa6FgXhlb3MEzdTGJLQM3yT5yYL4wcnP1usFWysw&oe=6A6609D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lR0ADO3pe4gQ7kNvwEs-tjH&_nc_oc=AdrDHJiu5VHmkSqsflX345Ccd1-P3aVAU_Ge5M57uq9x90Q8UeUGFAudKvCCNtWtMFU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaTGphJT6gfxxktsQPBhYiMQr-Ep9xneXAwfkpFDqoWA&oe=6A662542"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bRb5qHXsyYQ7kNvwGCpiQz&_nc_oc=AdonCtyF5hhQDnJwP60WP2rNjGsrpJZLG8qK5eDH3Mdv4obW-x4Krh8pb3y9jLYmYsw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af90ASembx4JgZKHX7K_GA9eaZJeqi5WuOU0kLtYbPha5w&oe=6A3E8D1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt88TMPqQlYQ7kNvwHld419&_nc_oc=Adp-8nEF1FAxqI0Re7ybE0358WlpfPkL-2ZhHoVc9kotbrb5eKQ0c4ApoWVib84v3yE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_V1T27FLWvTVd0bcvaJj0UE5ru8B8HTUfmCdjT0OvI0A&oe=6A3E7A7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiEFQj4K3rsQ7kNvwH1rLiS&_nc_oc=AdqXJOEJYiCwuCEgIPUI2EGJjZE5wcO6fBqmJR4AhYKf52bIleonM0giNAv8gVLKkEo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91iMvlXBOOAm8x6Bp7UTqVzP6Q8eKxMZ4wkN047A9cBg&oe=6A3E7FFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJBAbp_wbkwQ7kNvwGxMcD_&_nc_oc=Adrk0QkuC90ygwY8ew8lb6-oxwjOZ9dhCYsoWeWMqR4z4274n0m6ohTW5VloDbbxBSA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_R3TZ-E6O2gPgL8-oUbvlt1kO-OylxlQkZhzGNF1t3mg&oe=6A3E7CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4reztE_8xQQ7kNvwEYQnGD&_nc_oc=AdptiZMuPIx63eY9kvgqkc2KRWaVWrERar1Gt5nPXjorQCHJOH1HHsN2zQHNPSpDNB8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-p6zT5CKH2p3P555Vq1ynXhkGDNbXHcjhd6j74h9UWCA&oe=6A3E9842"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
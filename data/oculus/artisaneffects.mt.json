m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzq4cz5EaFwQ7kNvwEC3MTD&_nc_oc=AdrZ8zAjQnOYk2aWoBSj7sFQW4D0FaOAPWgrMcFCUL-EusqI0r-BZMaQl4MiCo-bJ_8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9epfj2B4MyeNhwj6DnAj7e17qeRbzhh38z1N05R543w&oe=69CD2C1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rzuYRMPCWUQ7kNvwGiblUH&_nc_oc=AdppfDesgOGLSRPrGudN2A0k06-h87TiWN-jTjS1qo1RpmSRC093pxVzKHwq1NOw5no&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwV1Pp_U_gv3TSspaenn6OiDmq1-od2Vp8-kymRs8H3BA&oe=69CD197E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aOvpqrK9q8Q7kNvwEtQfxP&_nc_oc=AdriTxYJpr99iqGXqdFJELmVqNl8nQkidITjhWWCdFt_3dYAQaw24cSNXld9cJmfl58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfydMgeedVvX_ImXJ2PrJD16rDjPLHfXLLbJYTpYS3BQqA&oe=69CD1EFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaWp28Rbk_IQ7kNvwHsiRQi&_nc_oc=AdoV0VJpasBirhc9ws8bsiT5Gth1DopKnZ7sTCGcwSlLbJNMhin0py54tXW3POv5Xm4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzPuKaNYnEOTlveWc5RXftFIeO7GZa2g4ly_ZbXtPOEww&oe=69CD1BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHw6Bc8LTW8Q7kNvwESMGCu&_nc_oc=AdqKv8-YxE4jjqeQBzrfn4u3MQkhpL_57l_s0188jlGqW3gCV6PCauIizY1CXN3AHCo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzZ2IlyzZlkf82i-uSyB1sQ9CZLGR_6djDmh0UcWpiWGg&oe=69CCFF02"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
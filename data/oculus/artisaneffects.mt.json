9_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFY0SN3wyWYQ7kNvwF3vER1&_nc_oc=AdqXnc5hS0byZLKt8hjkX8tSEUd-8UMd7au8apRlHLGq6bVvI0f_jrlVKKSNh-ZAXwM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0kZne7Ho70vRmCJHkJAhX2vrdsOo8BW4zyR_loJc4FJw&oe=69F2161D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hWHleh9bmDcQ7kNvwHSEaa-&_nc_oc=AdrHASKsZaiHRbsnvV9Fn4wyXmOaI5TpXxLpF-WDyastQLlqJpRQ_jHrQ3kXcz3wIBU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1IqSIsbjh4ucfBVqdFhyYXYj_El0ohGnSCGXrfklUrNg&oe=69F2037E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3obsDbnoiJgQ7kNvwEIdUL7&_nc_oc=Ado-sJiVEGWDVsX20fzJjp7X8LH6UUin9QJF3Dlq05DYBmZC9Mlpv1m9uhlsF0s65Vc&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af1U_D1IEG4G3L1agKFkqwuRXswDyZ37oCkWgnjgCIUMbA&oe=69F208FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dh_xhKC-AWwQ7kNvwGv8eMs&_nc_oc=AdrUsXlxHep05RIAUGtvShu4fqyGc_BsIvn3bROP7FVyfshxKs9zLdrOkNOtnCbIId4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af0rH047Tr3-g0LwChDxyrAys4VpfNKefGUjlAVYd6dDog&oe=69F205D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVOuDI5CNIoQ7kNvwFA9_wG&_nc_oc=Adona6yFasTeZ_abiaeATm6HscMIfDdSGA2D0HdunujrMlLSe-DLFY6IaMpvVje-7Qs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2TVnSKhaOer1yARgiq1lKE-peNPS3cerN8yFQUMMA4ig&oe=69F1E902"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_i
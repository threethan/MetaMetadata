505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1aS92PozkrUQ7kNvwF2efHH&_nc_oc=Admucqf2aQkLC_3j2y4MMTxla6UCFnfbOSCC8AuFSSsZVuHMoDJTCKk5an3Sxx2_-e0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftRIcIE1oF2OEvoO-Ij5r8a3nHpvkY1dtzA3Z3F8mmG-w&oe=69A809DD"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixyprfzV9gIQ7kNvwGpoN9v&_nc_oc=AdkGdaBjeGeZt2tjhpu7ZwomCrZIYfDU_lODsCcK5lpEzZc3UB8W2rTWS9xM2iEQBhs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfvY5T0btzORzCOF4xdK2rnatVlj8e12L6Vb47Wr0kcqEg&oe=69A82F7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2NRFxp1ckoQ7kNvwHhc-9S&_nc_oc=AdlxdBozLElFgtqfieP1hu52sUFJRTJgAK7TatBfseTlr003V1zQz3cu4b1VH5t-bTg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfskP9_MHlvNvMyd8HMJAmQDTHEky7-noM6qAb7Sdzslig&oe=69A834FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lExa-tYFdsQ7kNvwHiVVOx&_nc_oc=AdkZK_QSOlYQDfSbeBgxIkKoYq9Fzch1Ed-pGZkdNg9l15Y-gA3TGqjf7B0ZtsiO-jU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AftoNxT_HvB8-DCYw2KvR71CCmnGGUkU4HGys2XLePsEzA&oe=69A831D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OroajwQNuUgQ7kNvwHNyy0G&_nc_oc=Adke5lMk0wVTeeXzYwhGIYZFa-ICHDLLrpaGQdMAbvZdsgid3crRylzKd0BfilNi2og&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfsG40sFk6fMbbXiWXchQ_Xv5Oja1vqgW_HneHGW2DoTCw&oe=69A81502"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_
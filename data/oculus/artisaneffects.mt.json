m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-cjstwrnp4Q7kNvwG2L4YW&_nc_oc=AdocDZY--8HOarlFQgSFqDQza4BJSGOVC4UIuXljH9mKu-_rSJbxsqn_PJKBJqrfKk0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7-dP9ZlCVR9XCKUiOGgGKYt1hmwwiVJmHgFrTzxFe7gw&oe=6A130B9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvfbPEXHGBUQ7kNvwF5mjl2&_nc_oc=AdqpnBprTfWLN1Q4JTC9SR5IAr5xrycyHFtYxeSufFDUccdvqlTRf7uxrcZbIAXzDmQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5a2x_CoULg4g1cEZCvC9lLmIXzD_n0vequkMxRq0euJw&oe=6A12F8FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsT852LfChUQ7kNvwEAQLbj&_nc_oc=AdrVNCV-PJa-iGzZ7-2is61y4njJrmI2gDDgvOPE2DKkgAS_9ZTohf5uf3jhtzEWSZA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DG14cSPb5QlspK2mRHUHLuNPkvFTaMezoG6j2B1nNpA&oe=6A12FE7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NcNj053XrE0Q7kNvwFnn6UI&_nc_oc=AdqK8rFhd2NPNCyBpz2QO4jwAXiffXPlgk9xSZB6CH05-swXOgpCatZ6EZ4f9Tj3aD4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7HJWf6bM9J6FA_rzsAwj_TlMl9UjrDKUvql6xLqEaOWw&oe=6A12FB57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PyXhwc5RvQQ7kNvwFgCkUf&_nc_oc=AdqD3GcjfxDUmejDXX1AlYU-EAqTX6h3oSdSZiS1sVatCSwjluvUkZ493y7-NQTnuVY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qAlk6-OUuKIXYH8RzfbPsCrFfdLj4HvqVbZ7dp33F_w&oe=6A1316C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbL5pWC3iwgQ7kNvwHP-S5J&_nc_oc=Adr39d1R6DT3_EKJmlnI-81LEO3DfVXPqxFZIK6N99WeOR1RPMdISWVsewYva_ndF3g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0V2T7oB0TxMXDZPqDBbuYLlHPXm4XiICQQS952gN8FHA&oe=69EA2D1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l2PG2vcLP4Q7kNvwHRrjc2&_nc_oc=AdoC2Nu85UuH-4QL52hH3-oS5vp09D1aj3_rD3ZMQJKjMyM0mpWS6FBV3k4arOcQTHM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1vU7jF4qkca_2vmRtozRjr2mRf83lQjPfJaEu2pux--Q&oe=69EA1A7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMNgSikTAXYQ7kNvwGaGUBL&_nc_oc=Adp7c73RhawOuthY0Tb8BcFIr12iiGrpYU72DzgC6tKwRf61_B1Kgc4rM5TmQwOC-gM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QkDWuUsHjvzdNKJRsMlB3shabW0-8ZBJe4bBq3HAgVA&oe=69EA1FFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5u9lmhwarz8Q7kNvwF-xDYb&_nc_oc=AdqFA_rAuVMHDvaZcvHlBADxB-r6sK3c8SiEeMjZDF-BkrX23Izy2RDjf0qyTghU7Ro&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ZvzjWwArBAsLb5sX8Bb19L3qMqK68IMctoVxxjmoGwA&oe=69EA1CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6i7jRghZMAQ7kNvwFw5ENb&_nc_oc=AdrRApf2ihL2jo2RbxI-EFUQuKpJk4ge0pYg92YkeTc-YfcJfkNEAAQ00PFTgFXcAtI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XDh9FojhbvJRA61BZAlKEAUBD4X_350Nk5TXerUmpqw&oe=69EA3842"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
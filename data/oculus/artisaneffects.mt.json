scdn.com/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8YpZcJn7tcQ7kNvwFrK07x&_nc_oc=Adpcsxn100zBzZ-0EhhuJgZu6Py4vDKz5KTmGRtcosWCe2XFQicM9kqbrfQLTGIQytY&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLg6Hzxphg-hKRbYz84ljlcVYiz_HQGp3yqvK4sx8ljog&oe=6AA9569D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDm4pJIZMAIQ7kNvwHvWfC-&_nc_oc=AdrDd6bj0QoYMwVFJ1nIhdWw1jKIvnge4qdO_zr4cSXqhP_CyeuIz63QMJiDwCq3guY&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITaE79mHVWsu6Fb27cgJdBfaZmIVQx7M9OXTPwbrZHSA&oe=6AA943FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6dWi7-Ck9toQ7kNvwEd9D_v&_nc_oc=AdrttdIAxigqR4d2a5v33G2pQerQSJRtsU-ea5PmrgljypIQGfV-yRoDM3AMJgnpkdE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJxTxFAIzwiCMVNd31a_j_ny_J55-TrUKf11OmyF1EwBQ&oe=6AA9497C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdmvpmWrS8YQ7kNvwG98-EI&_nc_oc=AdqBToawJKXZP7GfR_B-PZRn5OnzzA4g6Zla1G-DqeOD-09SqPBOZgmmWQBbe9oNMOQ&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9YfBM60sAEYrDAw_6Hb10M9pJKWfMiN3g5H_F4X4clg&oe=6AA94657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZb6cukW15wQ7kNvwHD6Auw&_nc_oc=AdoB0jauePgDvKI8himrTGVUNGp-CY3QdzqY_DxeM3iZouihS2ne0QFxnL4Ej8lIAoA&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLROCMCXC7e_KCgYmQbVYI2UEmqETGW8rK8qo97R__1WA&oe=6AA961C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278
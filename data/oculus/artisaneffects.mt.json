m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SX23l_TqCigQ7kNvwF3irnt&_nc_oc=AdqmAzdgtSI0CxPIa5M4-2kstiLA-xXIH5HkTxxVHXzW86Jn5aeq_-omKhFh3E8CC3o&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-np0b7O_ZI7GcH33i5ik2EfWW1xzH81yF3_F9WihHz5g&oe=6A29751D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFOkpEiYH10Q7kNvwHDrKDh&_nc_oc=AdpEasTCMY98aBbrTqbwxiE-tHvcL7fdPR7ld3jNDRcewocimusAzGpCfjXv1IH_srM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_WXIkqOmSSmu9XUJpnnsAvM_FlvYgRDoK-eJsohKuRQQ&oe=6A29627E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vz6zv5Q7_BwQ7kNvwE2iNdo&_nc_oc=AdqlLVqKxCF6MUv0piBO29RCdBCabfVfPi8JMzDKu240-OzxzJHlFl_LIG09xg8eTao&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_m4yC4t-lSQOYbvxixw_qKhxLSlkwfjjFyWJyP1nff6w&oe=6A2967FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQyWEsMfuy0Q7kNvwF3lZ-S&_nc_oc=Adp1PePWlPAl9NSrk8AjvtVhIt5kt3qYusRUy8wDESTEYWt98Otfi-B9XzwQPLplDiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-EKC1UJyCEC4NYBjYY1OHVm9v5OqvBC9Yv5Ap-2sMeAw&oe=6A2964D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MT7U7iqb5MQ7kNvwE65u-9&_nc_oc=AdpedEU2vU0KgOeaJRqvAEg-kY2kPIkumNvSJRmpT_gpcm5RaTLQcW1-JprakB6ksBA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_FYVF-_LestzmtUFDQ0eaPIQUd6MYGOCJghqvRdROC_w&oe=6A298042"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZgvEa-PBuEQ7kNvwEB733b&_nc_oc=AdodLaIHYMUlYh4BmDbyqzDu9Nn8XvfZhO0dOYqJ85MjrRnNzu7nKJH_WhW78LuYkAE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af909IpuM222IcfFV79NjNXNDXdXfxfZqGEx7mymskmLtg&oe=6A34011D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zySjf074meYQ7kNvwFVEXtK&_nc_oc=AdpgGWVTKC2iw71idslRhG4warQxk1-BgN2gVZRcna1FEXbVB7gSjBzIeWLyRjIfsw8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9whTKsgUcOj_Hm8PTopLJmoP6SpUpHEzfFA3F6-n5hyg&oe=6A33EE7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZlvf3WbwLQQ7kNvwFmxXgB&_nc_oc=Adqdexnv5OnICS2iYq2DdikI0u1cVmWWfWiFm5KRhFfIhM0X437BlvPdOcOM7AFEv3U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_PJBVJnnrTZEsazm8W_qrHWg4hlGoI9TeKA2L8-JHIdg&oe=6A33F3FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_RHnDpS_pIQ7kNvwFkR6uf&_nc_oc=AdpJ7I96lYW__XGjBXIrc9y2Kj_Ld3ibafXY-Pt-pHuKRrj4uAWPzlxBz5SuY985Fzw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6d4Mm5T3LbJly8Wj6hgic76teT11OLfNNMfrVjxAhSw&oe=6A33F0D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvE8M8cBwAYQ7kNvwHmRM7d&_nc_oc=AdrDNNwf5NhSb31ymXI9qZN9y6HNFJ1QK6_YyNijTes9UoGd8rPKW7AWyWHogEstC-c&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yE-mODVC48fGpWm5f_WbyJqUFRSRxvNbrT0HlNK4SxA&oe=6A340C42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
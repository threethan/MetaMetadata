505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MtfFw_hJUdsQ7kNvwEKu9JC&_nc_oc=AdlKOoQRfCji8CKI1GJGi7TQ6pcpjkLONZZTeHzfcF5W11mLCDJBLiPy1nCnc8FOtrc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuOg0-Z9yZWHwIdCAk0PrkoWVWCPSPOg_pVLLVSPpr6Ag&oe=69A9939D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixyprfzV9gIQ7kNvwEy_4yb&_nc_oc=AdkxIHVEf-IipnzBKFr3V0Di9oOsK-hu3cKgBVhXiLFhE-lRt2V827-DQBOfiTjpNw4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfuygiQTeQF2Ttw7fH7HaqO7la_lEhQpRSsKQ71YHcY9ZA&oe=69A980FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbfler78iEUQ7kNvwGZ2Yrg&_nc_oc=AdmeTVgybgx7RPxnXKlO53raZBSOVeFNsGOTJSnx8flBAhDNP-v16hGM5ru3wzt3jNo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afu1QPXkcJTK9wimxJIDRLqytdtWSUv_DC0LbBKRHy5kww&oe=69A9867C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7lExa-tYFdsQ7kNvwHD2Y-6&_nc_oc=Adn-wrnK0Ytu-ahDuSyJEkh3HvdpmfwTWAzSKYC9EeUVbPFoeL7mu0Gbuiwc7tzHmgM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsxbS1dnWFixykR4Xz6rxwA2rCdj4LTk4tlC2aM4s3jnQ&oe=69A98357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OroajwQNuUgQ7kNvwFo039Z&_nc_oc=AdkHA7HFQ9qF-5JpzXiKbnQ_Gv5vG1wGQbkr5GJnHeW-1AjPLTjagyKeb-7SrbBjzNQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfsgawMjiQkoyHha9USKQ1iPrA9uZ9XFvPMyHEqzJQNVIg&oe=69A96682"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_
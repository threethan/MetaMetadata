m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i0wLx61vyKAQ7kNvwFLY-AK&_nc_oc=Ado7V2KUnums9xqrF07Tm_i8VSlA9kQPSpG5SOH_X2OYlLFibOixyvQwXDa8hQRsaSQ&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHtQNd8ig-vWkpnxhqy5ePZGrdbu05wZe8BtfJ9zuNPEQ&oe=6A91635D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWwsoU5WxYEQ7kNvwHldu8K&_nc_oc=AdqOnQYFfJT7tN5EJymA_p3A6dNRjHjPjSHWsIf5wPScvX-s2A1TBF_mTIly_GYum5o&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGeko13pS5X6QOCSC33qntIyY2rhIThF754CqJENXhPhQ&oe=6A9188FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nj43HRE-HNYQ7kNvwFrNi3Z&_nc_oc=AdqcEDL_Q4PcI8MYMVqETqJ4sof0hfNEP18Xz2e52nGJx8WuM3z9COFHSSLrO7wdp8g&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEphHgi-fOr_WFO91FkwJrI9zAor1Wc6GP1TylENyM8Pw&oe=6A918E7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmVj7RebJqIQ7kNvwETMgHE&_nc_oc=AdqAqjxlbGwT5GdJyOaxMjtconFjo4SgDpe6tBEDvhSXdWLvOZ-9MsVjpeUuMytxEDo&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE5E25wsHehvZf4j-6QAVd_eA93OrhoKelNFX7aZoT2Aw&oe=6A918B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiaNAbRlck8Q7kNvwF-DIoN&_nc_oc=Adr8d69vy6L4i7ExfxzDIs3UJjQFomWgeGK3E1-F2sLsFiVmJgGZgtmS0DIyeJrpHjg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF4VwaNfLSB14ynIhqrMTt_EgQr_hQwv3Sp2srJvktIwA&oe=6A916E82"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
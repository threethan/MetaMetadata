m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_sMJ3qyJDMQ7kNvwFeaGVu&_nc_oc=Adped2ZuDovO4bk6BYZBGNEgjwjtIV7L8c64Sl-GkI_KD-hh46b9YnpzKblFXFIk-Oc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP3d0HiHLud8PJwAlvNJilkyLeRSEbDA5ji8Ouyb1xELA&oe=6AD2351D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6PIiXevYWsQ7kNvwFUu088&_nc_oc=AdrFNH7Cq-9xNJ5fmaPARKxYOSCwRJFREI8VKLB5szfXMz0EUPHXdQyefY3gSKlnQpU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPOmOBPvLwRO3G0sZukQFBbRlU0_9mkeu7W0NB8_27fRA&oe=6AD25ABE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pllVIASshR4Q7kNvwEnFrWh&_nc_oc=AdomnocynG96BEbxEs0_GPhnsSsAkHwhg-A7ZUssL_7ql5fP36fIlxWbKxYz8xKG1tE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqcmJUWaqsjzY9fzLTwjtyHOlI6CYkxv_83MHKU7JsTQ&oe=6AD227FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGM__LdWJQMQ7kNvwH5Ae3T&_nc_oc=AdrDsix9hr9LmV8_dxxWNjAIH9SV5oE4Qbmmpq_SuaP9W2_0gxz0O1yjOCRwozcqx3o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNW-UiS8hLDmn1yF5EbSxlnkkWP-Gjt6jaYtm-dbfl1_A&oe=6AD25D17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoMrJ3eGTIcQ7kNvwEvHV_r&_nc_oc=Adq9ZlgO6aweYN4evptsc8YZsaqIlUkBPp7rIHXwLd8FkCrAOmWBSmb0sYva0CdKIxw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaDq9vcJTftqnWc5Hb1JDFVqwgYS4diGEWUIHjHYGqMg&oe=6AD24042"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PawHfs2hiYgQ7kNvwE4yNoV&_nc_oc=AdoNEUmcr0h-jk9fTgHgPOS6YZrnXGcWkYA913CJhLRRAEWwlrJ987GaM3RpM4iflmQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eDQFSFvqOh1mKBQwafaScPBzwuB9pEZT8AHgPOjUH6Q&oe=69ECD01D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1chOUFFgCQQ7kNvwEnxiI4&_nc_oc=Adqpd9XluDfcAZtGpJfw8MBxY0Pn1-SITQscxYYdY6tQsosg2mo0Roh6LMZb157k1fM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cMVrpWcLNPU_oDxRUHkseHleFIrkaxWuottWHT3Ezgw&oe=69ECBD7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KI-uemAYO3QQ7kNvwE1_U8Z&_nc_oc=AdqxRqpnweuSfDvQ5bpnJu1s9vQSkL3MY_3juRVRlBvuijlW_1U7gOWN9DLjMC9GNtM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cdPpnt8mKgMQaSH68kHpd18jMo_sJ4crzPbhsQ_Afpg&oe=69ECC2FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t3u0kv5YzawQ7kNvwH17YTf&_nc_oc=AdqMKlM-yNXS4yikJIj9t4_l2A7X_OhxzAIyMT19gDi7XO0YH-T7PzzTYXs6-D0M2UE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JQeNKeSh6zK5ucoFtsOcDeaHzdV1iypi0jPHNqzz-cA&oe=69ECBFD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aSgZsq0vWEUQ7kNvwGJrYdw&_nc_oc=AdqV7utSunceEGf_mWuAVvdu2LEVc2RTO952stc2bwNrry4foIHpKV60rCOHKnB89OA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af26DgQocYhd9WUjdmPzD-1-aCpLSwkHwR-Lqq62xSzoaw&oe=69ECA302"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
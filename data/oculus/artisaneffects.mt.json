m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RjTwVSCYBMQ7kNvwHBhoVf&_nc_oc=AdpVk40ERe-ZQQGHumJLBSTtKXnwH1Ub6i4xpdAUO4BoqeDk0xVgbGt4hvkFpU3Uf1g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zLgyeY7Cs61-5qW94muk8ggpvp5xy8zEHLG_Xn1IIOQ&oe=6A3D3B9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVPc4DkKtpsQ7kNvwFPvuaw&_nc_oc=Adq_E1t4zIgS5WrptAZs0R0xk0kGvUVl77IOKBwTk1HDwSbwBA99JSctlqs6Uy8Vos4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af95cBeMOUUV7MqLBgssx0GctE9v_MFV-AkoVPgcAjvA_Q&oe=6A3D28FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiEFQj4K3rsQ7kNvwGYN20d&_nc_oc=Adqp0SsyT91NxBpjiwOz0vpSMKRE9DpQa6SALxZ6AK6CE9nS-mvTdVzwJUbKMurW0D4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ozYf4nnpaamUbeo3vibSw3rmkm8PkFifPOKvY5yB96A&oe=6A3D2E7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izx4hFMRUV0Q7kNvwEjFUWA&_nc_oc=AdofgR6ajyZlFUvEtNE7laEUjVT7QC9FKbjglYBqyBnM-dkbNNIs9RTEDXK-XD5YcRU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8mrUdbBWfE3VBCbGmLHcWWHpHwbwkT6c6L1j4Zpn0T1w&oe=6A3D2B57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IgTTvNE0ZwQ7kNvwFmse30&_nc_oc=Adqkjm0OCCzfOb-r5pTNSKXBloCXt00-48EGA1sxBrgQ2H1nEY36NJG436Wxj6w-6_w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9MBF5-I0bszERYsxZJXY2XStU1IpxvPNcJ5RDXz4pq_Q&oe=6A3D46C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2kHyEw-MQ4Q7kNvwHt2-eR&_nc_oc=Adko-fsLlCwwIO3jc-ST3JpqvipoLRfgFfdYRlK3IuxtJCemPH9FzazrZ6Ij-JVxHfw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzjmvK3V2-GqVDhq8n2FN4MrBknPUzft967_oHwz1qofQ&oe=69B17C9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUagDyrDqoEQ7kNvwHSwoJQ&_nc_oc=AdnY8GHjWwBdhp5uC_NgPoNLoUaBnXN5fSfx8XvbIa4WVGpeMjVZlfTjIZJtbpo_3zg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxDTXgnqVYp6kSnsvjPQPQ_OWQ2dqIc2dIsucOuldb43g&oe=69B169FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZGAn7UjM8MQ7kNvwGcNCTk&_nc_oc=AdmdOABPwB95PitVBpHBAbUZ6hUifKMfHhXgYu1gGi1Mg2Rdx9K7co1QAaVUWx2RgMY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyQLPIQEQ-NyVbsdo9I2BAmnOSABXx0qgikVurQyW4CYQ&oe=69B16F7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atDdzG1R9lUQ7kNvwFvS_xg&_nc_oc=AdlbnbLY3S1kXvPGOo8WyTyY1LbB_kNK-4hK6LyK6cnpYVcw6moxWTJwJNN-H08pD8w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afyd9zxf1DLPMFWYP774cAX38-OOLdEfQhujjbXY8cDpCQ&oe=69B16C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SD_i45g_FbgQ7kNvwFcEeg2&_nc_oc=AdkbRKBq9jZOomp2rL_2PDZVGt3GDadpgTBAGn1g-MLq4cv1oCifU7IgmGjFRri9-wM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfzeMdleRUWU7F7s04NTO-TrdqFf3b5z07UcMVN-8Cj_NA&oe=69B14F82"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_
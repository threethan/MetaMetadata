m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eRU5iltJ6YAQ7kNvwF4lZf5&_nc_oc=AdpFgOe_gMsaIktFxPF9hdFnwIwJOIF3l0piv-HdFHX8HorJfvIEwrErhqmqezHSaRk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeRjyMm7fH3tTGR4-EBAyQVoqYHk7jqICzGBL_yI_GYA&oe=6A51021D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTlx16-J0o4Q7kNvwHmn-nZ&_nc_oc=AdqpVGGIbv3S4DPf30TXYPNDFKYGgLkM5gKdc16Y9OqIxAF3pUNACosm0a6D8VMl5ZI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCxY5mvapAn58i4aOqNbYrzm0I7LnJs9gn0APr0sHj5oQ&oe=6A50EF7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKAEjYKadhoQ7kNvwH5wB21&_nc_oc=AdoJjMmiAZBi1vJfZZzKD3fLLwqZ76Q5V2ylkZWkhI3-GyVjLE8JkK2q2RRhNesLZJg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYudWIv_PunUtoywyOVxQSUDpeGN3MgSrrGJnt3ez4SQ&oe=6A50F4FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-egI1jD4n8Q7kNvwFHTsCY&_nc_oc=AdqK9-54jqiK0Fdd6IuJnfPZA9XSMEd_McqndEdZuR8iuPh3vW1hO9PsimPqV-HMO0E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTVKY1J7GkHL_Vm96nfohA7PFAHrVqwrclx56f_XJpsQ&oe=6A50F1D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FauE41CBXtoQ7kNvwHQ58H4&_nc_oc=AdobvLbaJNjif-TPlad3-mwOi6rrBSB6QqY7m6m9wMoMIekve6D0n6Y_fp1cPUx22Ko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRA6-NcE0duYD8oMg1Pu6lPoB9qqnU-7rhdUQJys8RBw&oe=6A510D42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
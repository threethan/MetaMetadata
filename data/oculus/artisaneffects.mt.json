m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eADCwcu-X9kQ7kNvwENUqQ8&_nc_oc=Ado9FVj6FwOUQRihEx4CSouS8bVBgzMTeSLDZfcgEBP25EkpnJ5X0k9VuLU8uA8TvIY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQESIjgz7F0jrpVdb6xT158V4Yqcck4NW-H1zoRaj9ypGQ&oe=6A788F1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=02Tw5-ZNQlIQ7kNvwGTVmOX&_nc_oc=AdrVDWccOV65AK7eyaBB3r_WwHd_bCEK19kYuN88gTAuI4Qlam9xhdP4T63kcfeLI_o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFitnKRbvAoVlsZni4LnlNv033rGxUX04zFxc93x5Z0Xg&oe=6A787C7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YG0Ig845qmYQ7kNvwHyavs2&_nc_oc=AdpAnfcDrx4WA8_IbW8zZt3s8Hhd7stufb4qGlQiPk60ujk56FdZANNuUD26SGfu2pU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFVlPUf4sVklo-Fb7rg_AYUuhzz-Efb6gvijnF_LrB-Jg&oe=6A7881FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TwHw5tbrriQQ7kNvwFd5BqD&_nc_oc=Adpz5TcOgsUEbvUZI16SLrZJ2fdh5mG47V8hfCjvaHbY9YTgJU-5hJW2KldbHcX-yb0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLD5LzawUZgYFPWZemESarrJuCBdqNRTOXKYoamJ9faw&oe=6A787ED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NPWik0urnwkQ7kNvwFnN6HL&_nc_oc=AdpEEgbpJTV4l7xdPyetVmtfLd01gBfgc7O6qp54VOrfhOOcX70pSlfhwiNK1UOxcFE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFUR_qvuBv3NQ-W8liZtLK9Yp7kl8Kx7jw0aWwNT9jyNQ&oe=6A789A42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S8zn9-tWSOUQ7kNvwHWRx_g&_nc_oc=Adpmywbjk1YR5L2Ds0TcPR4pnb_M1np7dTZkhq-r8mFiHCg4aluZvalgfeQAw3J5shI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw1PCHuAgxJOt2QaMP4L212PgUz3uzgpmdWQe53aDJwFw&oe=69C9379D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRQG60MSqaEQ7kNvwHMQee5&_nc_oc=AdqFS_xaeaGZ8nVN4Ub0F7XTy9DFdvP2J14PW0lj3Kr2wi_OwyXytjnr6gGE8rRO7zY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwstUnxGBjmSOnZlrcaAEc3FZpZIWnuA_OTQcLh3zckhw&oe=69C924FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rn263iawPIcQ7kNvwEGZnyn&_nc_oc=AdohQXUaHEhJo0FSiSOL34v5OKioiJVfg_iNXg_a_weV89upqMjAwJZAK6OUAppNhus&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw0UGiJSvFI-rr1iyn3x6bIAV1PzHrtBoLoXTW2qFTNUw&oe=69C92A7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyi-xPwssSQQ7kNvwFDLuIt&_nc_oc=AdrhyDyHi9SGnNOp0ScO1r4dfzy8AnkG5cz70z82oy8S1qwuYGt2lO6TKTpw9UGHQwM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyUY0DmHZf5fz8IkH-YKvKWkmf_mwpwkQeEOiRwVstx5w&oe=69C92757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhIM19p4gvMQ7kNvwEWKFqG&_nc_oc=AdrxplWsozi4D7CRcdjtVvxbpL4dxu54tOnRydXtzrCk7WHoOIBk_kAyCkclq0nm2eU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7v0SPirM1gjMS6Lb0lBxqIqx_g_aW-hJbzOVQ_4vc7w&oe=69C90A82"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dm1GtDCtQZsQ7kNvwEy84c7&_nc_oc=AdodjZk3SnwTTvzWyVuPetNPRMt0QDRWNrHRgx5zvr8fKyA1f9EfxCni0008Eug7FOE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJjE5ydds67dfbpjucmNKEySHhIlHivTWVMQz8St1iBrA&oe=6A9AD61D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9HWZWjPDZaEQ7kNvwG0WOZG&_nc_oc=Adq2z9mTBvfnzGNNiiKlbb5fH9DvleigVSw_gl7_b_9Ha7U1k6Rxuo6t6WljAP_0o4U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnmMTccWVSY7UFalqQ1G6Duk2CtuFcxnyP1fh4hB4aRg&oe=6A9AC37E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNpKyFIwtJcQ7kNvwH7t1pu&_nc_oc=Adp4mG7zcdiauKzpsf0ufUo_HMsb6qg0Oi7ZuhRXxR_MXXU2jdQT7MoajKv-Ej1AUzw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIznLzxSU2df6QqyTC1EwzOwAl5UfJXq_viuWZGo-L_vg&oe=6A9AC8FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2G6v-sSjDAAQ7kNvwH01G41&_nc_oc=AdqXiOKPwlpX9C-fgEovN8wiyuXUlkMSP942MjdmMuQccgWkWpKw3QuuG0Vr_iY5aDM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJfK-3Eu4E9NT8EAE9umvpVZ8TSWsYDiZHdnTR58t_gCA&oe=6A9AC5D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HLo-pXwuWnUQ7kNvwGRGonb&_nc_oc=AdoX6clOfZUWwrmkFrSRfSseKZ2gDmjDn0ydQ7NBzyrWq9VTq1S7N2u0Q5ym3jpgBi8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICgFgVNKSW8qdnhG14G7KEDmna0F4h-_HzN4pb0OTtFQ&oe=6A9AE142"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5xgyBAagFoQ7kNvwEx67eT&_nc_oc=AdoUmTv3qi2_mNKlu0D97xNzNV1yzXMz7jJzPNic0ivtViFk2JwM7oZBwRKnWc-9hpA&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0Oqq_nQN2IFuKtZMl6AylbBI0L_pOYJnNPf2rlIp6Eg&oe=6AC8FA9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGbJaiVZsAQQ7kNvwHjAXMn&_nc_oc=Adrc0TwXdtF4VqPPez5MDhU3jgVvLo4Ky-WYRqQ-RydjKJa08L5rnQGHkTiPAENoRTY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNmdobc-vbtqfUgSlKpGtfpYrZ2I5memF0jAgATODmzwQ&oe=6AC8E7FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2NFCdYEnlYQ7kNvwEIb596&_nc_oc=AdqBqcDy-6Gu5zFoSc2IitLL4k5meTqt22_oC4MJEo5XhLuSqyLX9klYRzj4RXUpCYE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPYSR4v6JWYbK947BW_OjSPMq1wd2VVm97AUZtE-Ujx_w&oe=6AC8ED7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAL4aAG1_h8Q7kNvwGJmPNs&_nc_oc=Ado8WifIXFaj8qBSesv0t7iJAnHdZiDQ30eTs5nxX8cJvu-KlIKFnRQKQu2xBta5aAo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNiDuQ69Q89Mr90WDzVaTrGp8eYb5hKyLMu6tzIy0MuBg&oe=6AC8EA57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvGZMeMrGcoQ7kNvwFNy7W1&_nc_oc=AdrbhUChN7iIiT2SbgrAhzDLkiLOUhFZrMmKeA07NfzqsLP7G0XnkZXPbMjIRW7u_y8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNm46oOer15ELgqkxvh3aXonIBeL0-7KiPhnHY62nhH0w&oe=6AC905C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dm1GtDCtQZsQ7kNvwFaHEkn&_nc_oc=Adpkv-wN6OMSqRo8HD-e08vBIjGDLdaRGCCkctmKnSAdVx-fMkSTiOhv_yukTFUeBJo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKRu0T20aEekUbfGFuqqfBwtYdOQJK6wgdaTZsR7kjKXQ&oe=6A9D791D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8nrJueopmMQ7kNvwFuVUzy&_nc_oc=AdrjXdxgXY73t9nDj6roAcBN9pN57c8HC_LDBsbksnCsFA8gk-LGiwkUoq1UE_Xuqvw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK8TuQDqYV3NNQGlcP7MFicwUHkEZMHd_B6ytHDHe7OxA&oe=6A9D667E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BNpKyFIwtJcQ7kNvwHRChrk&_nc_oc=AdpwMF3sd_z3i8O3vjpk3CF0zqALgh1l98O5XLJqrqb6d3grOWVbXN7Ir6NDjM1uJtA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIZTviQLUD9wMbqDuaMWK_v66XPK1aWP54igxh3RCoxCA&oe=6A9D6BFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkxWqu4KxkoQ7kNvwEXTRPV&_nc_oc=Adp8NuDbjSyrQZksiwkENsEXA6LAm3h5wH5cLAbpsMcK4aAi9tRz5Ljb9NujbX_88Xw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIq3YS8G6z52AHchzKNUAGHLKZW-2b-lFJ-Lhc4le6u7g&oe=6A9D68D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rEiXVorL4oQ7kNvwHcmt4S&_nc_oc=Ado6iSUsNEIsyuGw3DSGCKStV9wtMpDNfyHVr47Y0Xld3C6CnTkvNt9npmqsPGdq38k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK5kxqgwRQ0PltYlW-gHuyvjYubq2NDenKKv4wkhLxEJw&oe=6A9D8442"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
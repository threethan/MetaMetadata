m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VEtwBA6SXwQ7kNvwHelOdY&_nc_oc=AdrUhSjFIvUf_cVTAFM28zxAYLpkHxgT6_1-en_6jNTipbbBAmTqLitu4dY_vMOEMMg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBaBt7JshCgT7lEg_DIpj1wd4BLWZ2-XTRFi_x2bkPTqQ&oe=6A6A0E9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNbqTAeLkpUQ7kNvwFct3Lw&_nc_oc=AdqqThcasAiXd7tB94vZGUMi_xvVCbdCrGPTbTQ_rgKJ3qQs-5KOBZX5G27q5RvKSI4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqGBfSul7fIR5iMfON211Uoc3_y-WdxLJ_jEiKQ3D0HQ&oe=6A69FBFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cje5AWMg84wQ7kNvwF_cSYO&_nc_oc=AdoQOtxUa-jnN7PXmB6nZxl5tJqDncN-gPaEivFGGM3yrh5ppPv4FJ7nTSDLEV1URS8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCHjKh3FhIg8Td8SXHUuR1Tj6fZ9yAwRLQoKHfZWa6TAQ&oe=6A6A017C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJr8O7aLt0gQ7kNvwGFm62u&_nc_oc=AdqbaNqW20XWxgZ8wxgOcAZAafzzTZYl9iXYqOkX7Yw03zgH858RJGnIq8A2IWuHrM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjzuyjolCSIW75IV8vmoXOa8zZroD13SK71eZyJh4wHw&oe=6A69FE57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_znzt97NkgQ7kNvwGLPWUM&_nc_oc=Ado42j6zEOGUT0A4D-u3dSy0qTDltpYLvDiHELSftgTIrqLSdqnw7M_kF5GO5p4A6fw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAG3olbARKRhxt2NUmxK-HV0HCxeZ4Kkz3nzLNwcgEKlA&oe=6A69E182"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iEOa_31ZK0Q7kNvwFOxOkg&_nc_oc=AdolUuOeV9Gk_GgK3Z6QCVLJ8Wj1cLwrk04xPBgxaCGE8zFWEkJlVdOBQm2VIWp14M0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMKsJyUCZsrLb6LSRMT2kzwkwuZ5dBUzhkQ0-CyZa5MA&oe=6A749A9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rUg7lLEI3cQ7kNvwGsRwcX&_nc_oc=AdosZEpArWLhSdPt2NvkNqgEw0dPb9awpJYBVlqLNxo-s5QKaioQ-GMOEKzgOP34P3s&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOFTN8qQm1jJjSvMMONNmuk01HmsCKrQqt2qKyAUT5xQ&oe=6A7487FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7bGqAnK5lMQ7kNvwEkUUoV&_nc_oc=AdqvYo5wUAFGcJUh0X1IfZ6HT8omhRgMx1gWt-jaeJ46VXCzvmP5k0Ecr0AiPMF5frU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1sM2zJaTrqrMy4dYzO-MiqFgECdlrQYsQcV1ciQQO_Q&oe=6A748D7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk4GDw8cCnkQ7kNvwE5hkIx&_nc_oc=AdrcHjc1wphi1VyFzkNXw3hBTXkVQp9c4Gc4KyT3bYEyGUcb7Pg0AjRJ7ZSTpBJKFF4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqjA5Zicpdxpu3Ln-ihVYgWvv-8p7ANw7ayh7Bg19KAA&oe=6A748A57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfzeNAzNDY0Q7kNvwGg8Epo&_nc_oc=AdrizBlaHOq2NrTkNpqIIWulIHzBXtjpjbTt1X4pL1O31v7pW7ecwER55q77JBPvkz8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFRKcOooh34_t5rj1AnPdqlej1vhQ8TKpJ-gm1nzWqexA&oe=6A74A5C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
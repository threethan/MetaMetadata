m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DknMpuRbSUQ7kNvwG-k7yI&_nc_oc=Adoaol8_bGQg3qLQ1r2A2PEH4VLLdBqgqabSqRgIWOHZbhFDQiQE8GlcERUKGv3bJak&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKhO-AKtTQSc0Oy9L-WLHIIwPGdrNunPBndT9KZTt8tdg&oe=6AAAA81D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDm4pJIZMAIQ7kNvwElTBOk&_nc_oc=AdoCH05c7h-Dyx_4odH3uvJcjiG_ZbZKvDXtzmeA627yUdYTsOWOp7Ps6htJV4XrkN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKTeSEUtFgYh3rPSEiBtvUygv2RhZjzZwOBulmFv0VJ1g&oe=6AAA957E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EUEY-fIZwcQ7kNvwE50U7C&_nc_oc=AdrPEzBMg--qbVJ8xggxlTvIpm1P1ny75ZwlM-uFiW6utRkpX0XvHSVjcLpHQgoJNvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLAShFastjx_VUilXV5qOSwjX9wbIXZMYGyOaHOGjSxAA&oe=6AAA9AFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdmvpmWrS8YQ7kNvwGCuOdT&_nc_oc=AdouUHwBwLY1LgynYeNWAY3eHgh7ROW9p0ZBvxNy-09iHsoCPVuMoOeXo6lQ65_I7dg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLCzDjWqZjqaHu5AuYKVAYZ2uV4h3MiQA2X0QpKAb9HGw&oe=6AAA97D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZb6cukW15wQ7kNvwHbSHiN&_nc_oc=AdpqALQo-aLajMiFxh4EJqknXIWi-wtpqrNDGfV3_PUmA29v8iTQ1x6liDCa3RTJZEI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6mnK3FTuVQ5WScuWRXjSQXS2surRxgB91eklenHb6Rw&oe=6AAAB342"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
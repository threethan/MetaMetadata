m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGRga37mF3YQ7kNvwGLAmWd&_nc_oc=AdpDlOfRs6QTJEsz0Sln_PU4Qxjsz_fW8OAkGSDgWVipl-AdIQcnFG9NO8sRgI9HMgI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3MYen3X-PMO7W5C8fZlpambtyRZKhko3BhWfvLh0-SJw&oe=69E4E71D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kIvjzW7AMyYQ7kNvwHsT6Oj&_nc_oc=AdoZ7YHYUwOysab6G09EfF0UveVXHRYBAnYERkaNv5P3ABHcy9lgb1lcfJGFqV9j2qk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2RJAAYCgKs1ZFeI9rQlmUTUp8iP88eSLpUYvRoH_KkMA&oe=69E4D47E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvVk_seIgxQQ7kNvwH0AI8t&_nc_oc=AdqiB4EzEWcdtC21FIUCtYdo0nVk0ojShyQd3aMmoWpIYglFtYRRZz2Qqi34XFNwsZo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zZe7SaESX0Wj6QuDBPxw8PgfN2eHxz7WWDiajZao1Zg&oe=69E4D9FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kYaYJgA1icsQ7kNvwGXGNDf&_nc_oc=Adr21jWHVAALpSR1XcM9OlK29FNaM3TRp9g6lJwXqPnZJPPMamYl0nlLOgJxo0L-0Ic&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Aep5BdGPoEEYUNQzkr__6jcGd98pe-4dZJTsAOWgCOQ&oe=69E4D6D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KLhzFHoe-98Q7kNvwG3MC-p&_nc_oc=Adoq5UpwqHgjifdIldImJ-DdbTuzkwmaPvfOyCXnMM2CFKPh-ZGcOBidGP3XSbNtTy8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1u0CaH7m-N8R_bjdhnU2kvLWMpzkU_yXX6f1EwfO4gzg&oe=69E4BA02"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
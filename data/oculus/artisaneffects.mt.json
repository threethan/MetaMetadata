m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_RjTwVSCYBMQ7kNvwHJjWw0&_nc_oc=AdpsCv1uNhs2mi0kmoFSKiEC4alAXidn-8JG6Jgk923Pnwq6hOq6z_B2NiJaQT4F15o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_jmKs9VR3oXTFlu3Saf22mFuDZtZvGhTJ-QZg2GZsqpg&oe=6A3BEA1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVPc4DkKtpsQ7kNvwEYMtcH&_nc_oc=AdqheodKRvYcDEtAxG4wQmUVWPc-ccJj-AzX_ZC7WG0t2POuZPutDrOjUco8jsSaZmc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9h3vAJRfk_NIp9FLVlKhMTIBi1AcUKMu4aco_BPiuqAw&oe=6A3BD77E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YiEFQj4K3rsQ7kNvwEmD6xd&_nc_oc=AdryXMj8kT6Sap9KDw_XY5FSvoTk6iP1Ed8_OhTmTKig0kuCNESaNjkFuU5H1ing1H8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af85sI2NlCoI_fK8LzczalqSx1n8E1vSvzg2lvMaPDclCg&oe=6A3BDCFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=izx4hFMRUV0Q7kNvwExBzUW&_nc_oc=AdonLyrPWh0KiZcyjhXhUuy_a10P8HA0PNKpl_Z7HiAljsQrLCFlMPw2WPvT2tCmV74&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fWTdDuyok-buC2Y_X4IXj6n7uhcXCh-hiHaKc4UKfHA&oe=6A3BD9D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0IgTTvNE0ZwQ7kNvwFl8UwQ&_nc_oc=AdrXY0x5HOWl7ZFiVL1YW0WsdGgaJDrFt8RKF5uiz1rs3LklsjaiAYezZMMXm3FKyts&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8omHtppXsb9126vbfKMdbplc8IzI0CKxW0dGOvH9GkSQ&oe=6A3BF542"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jyXQVbt0SnsQ7kNvwE2dm8M&_nc_oc=Adrx1llFDuTXTrrV40C3LZ5RFBEwcMmpUqLUhyh_vsscslsTU9q_WqHW5iP2iE03ro4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4L-9VBPozpb5txfL_LATEN569yBJcjcmToNOB1SCO8bQ&oe=6A00969D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ez9aAYz-2l8Q7kNvwEfxrDe&_nc_oc=AdqNpZ4Ya2fqgcThNEAccUdpZrV9-FBVJd53iHFJ1T4elTHOahnjjUaJ4BNmSXi-S08&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UJGq8CYVVJpcwnoof0W83seHBAM0BJ8bAVCdCcSsZkw&oe=6A0083FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qt8x3VRUKNIQ7kNvwEtuWvF&_nc_oc=Adpur1FZ6egPNY2lFrkh2BnFyUYjraYgchVMy5YQmjQYS0Bu1msQ09meM9Y7A9g4h64&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-NmeveDZF4TXy5OKip7O2kOA-E4riN78iob6cJzcUsQ&oe=6A00897C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mCBrNi9D1vsQ7kNvwEr2pvA&_nc_oc=AdokTEXnkUXQ7qsCsd8L-TTGHeds_5Jt0kjpyT1pd5mu-6ZG66SJqU3CW4QviwUbSCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VbkNQaHiT6-RwuhJoK4UHpMSUJP69eOKy0RtHbP1g1g&oe=6A008657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MsxI2STRfjIQ7kNvwG34i8w&_nc_oc=Adpkd3yw0rnSVheUGMzqaXXpJcndA9Qk_Ma3Tz3sKZQsatNYtPg0gdLocuTqiPNBQKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YmpB6lc3gbSq44ChVRqVQfHXPkfabLiOqgZ1ijlS6kQ&oe=6A00A1C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
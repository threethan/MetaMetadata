scdn.com/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m-cjstwrnp4Q7kNvwGxrAjR&_nc_oc=AdrQrau1YvPgq7L81E4SuxZJxrmj-_e_BM2ejO4ITFOxXx5fryKwlS_z5z-RWkCL9dU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TqJXzTMrGq_0rpZGIV45cKJxQ-hp6imLN_3R5VdPc9g&oe=6A11BA1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCtJfmtrbVoQ7kNvwFSmWNN&_nc_oc=AdrZrGKUWxDv2uKeHDPe9MP8fEPL9Pd0RmIHsim47mKMy9Li8TfGwCo37WgiFcpipow&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4YPNzty3THuH-6udAjU3CnGeGk0W5hgN_vK7ihhQLfmg&oe=6A11A77E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dsT852LfChUQ7kNvwHDShgf&_nc_oc=AdrlBqQkMbqgkpG2IYMZ03E46Nqbz9kLFnooOSV_G3ZAiaXWrEMOvcJdy11SH_XQPBE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ysxlL0YG0Ha1fg9C0wCDPP8uudGLgO5sKlvdW-QeJzw&oe=6A11ACFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHOIa6hDJlIQ7kNvwH3HJff&_nc_oc=AdoUrA-9V8du897jKJPnORu4RifbsKRhy01-utt9mG3svO88ii3_-BsuP5Wv3xeDn2o&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53exHtXpmqcfxzF9vjttHuMQ5P9OqE024sYgbGV71jZA&oe=6A11A9D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmisvykfo1QQ7kNvwG4uCPA&_nc_oc=Adph9_51lwpm8K6kYXGYPWzZT-ir1F7SE1UR0lp9IYehsYaXWvjexfXQ6xxo3opk20E&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qB5E9UUOPNw4-HNHcfNdtZKflo-gLBH73eSiPVC-H3g&oe=6A11C542"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278
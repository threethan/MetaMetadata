scdn.com/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96NOHhlb_QkQ7kNvwHDrGUy&_nc_oc=Adp5VyfPNN-CbOrLe3I418gzhV9eJFh2I4Z8IehoCBEOrTqaIEQ-Hl1M3s6pVIsdAQI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHoxvCOuvYy7YY1D11CNioM6yR6yCWsJEScZGa8CIMCFA&oe=6A7D9CDD"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSuXOah3a0MQ7kNvwF7Bc9v&_nc_oc=Adrr6tJyIgNOO7T2atIa9ReGGgDIC-E0MU_5Q0fNK4TnyeTS00raWmtEjuGW_Alaruo&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFBZF3KZ4KlW4HbMH7eL_1kF2mqPX7GnArf2-47bCmRfw&oe=6A7DC27E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmKOXYDvChAQ7kNvwEznV4M&_nc_oc=AdrFTePDKUIRuH46hiQcKvSkc6P4SKa1tv9m83rJzDO6Qfno44g9hZHFa_OT8Z_rg7w&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEkGRsEITdTjSHyIeKy4KlGjxsdss2OuVA7FYFVd7G7Vg&oe=6A7DC7FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xATg4qX3LREQ7kNvwFWv8Nw&_nc_oc=AdojckTjkBmhaOIU1ayieYRNJJ_j_lafcuity7QnbgsLMafvReVDszM-vD4KmMLQaM0&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE4sohGWX82-bpg0AQHnYwISFHet62DWWAvEtTAAylLWQ&oe=6A7DC4D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVgqTkw3kaAQ7kNvwFVvTIq&_nc_oc=AdrPV2bKiZPlTrVqOB6218WqQ655pAP86b-W6JoooMtiZCaRsWi3FSNv6APJDDXfNPY&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2mq-zBO1HdzsL9K7kxfDzM17M-w1xUbt68oSFsjlN-A&oe=6A7DA802"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278
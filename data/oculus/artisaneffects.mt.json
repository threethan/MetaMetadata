m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1IKETRkrQYQ7kNvwFAYg7U&_nc_oc=Adp4Rrfi3LmLDQRtWOqpmSYYVkn3Lnvl2EsnRqYUFAeQ4b6ANlVdEmc4d8MlmERwby0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv6o7hf1Aig2VVG1qRMdtXSyIMFt9xI5tgd4PhLOy7QQ&oe=6ABBCB9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFjmqJOfDkAQ7kNvwFFbnzd&_nc_oc=AdoF3WtnKVrhUpvgnJSTZaM3TwJtlZxfxjDrlsujUGll3KQ17NZboAGd2OBD_38lm5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdEI2ia2LsJe72cYuiU9Ym0knFNgJCzIrWpfxc79SWhQ&oe=6ABBB8FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5FM5MOq46IQ7kNvwHJFE4d&_nc_oc=AdoxMIYei8k93JVlQJZ7oM7qWyE_2C2eqSrkhCdI8Lt-hXJblkH1dzq66snzSNuginQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKk9qXS_RTelFNt4UGSbVXC17kbWZIRLyq7qtIUyexjbA&oe=6ABBBE7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT8MjP-0XhsQ7kNvwEHvsOy&_nc_oc=AdofQoRjTuUrTJrtxgUmeO04dfrt1kHYuvmTNZjCBnGqWHJOU8PSvAgD6EY6FNit6QI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJH1e1-zVNcb3lee5fa7DNCIaG6D-1Aax3rglUgOypoTQ&oe=6ABBBB57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vWJTB7JUYIQ7kNvwHfIPFl&_nc_oc=AdrSm4zAC_Mmx0TsEliRHVhmMHblaoBgo2N-o-9WXzKFfzT8B26IwLcw0QhrLUct--c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGcBmi44xjrvtA458tkHUSIkQ01twn1dzRC3u_UUNUAQ&oe=6ABBD6C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
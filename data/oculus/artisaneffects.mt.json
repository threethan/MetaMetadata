m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjZmz8c0HU0Q7kNvwHndGjT&_nc_oc=AdroaoErLhrhZe5wqtUm6pllDVjgO9hGYEgXJFJ9deXEPxMd4Jg8gklKk5sYSfwm-Yk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIyvIHjMvLqnnkWE7JTJKr950AZRg1T0DrQY4_gSXZCAg&oe=6AA16D9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJ40j60e_gIQ7kNvwHotjki&_nc_oc=AdqbjuhBN4GDUoFIIkNeEQJNaH7n7Yts3jCV0jNmwzGkpTBuu85YAKsIoOkEwjaXXSM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv-S5TCeSoaro3XwJtnil5hsQuZaIEgl-8JfZQ253hTQ&oe=6AA15AFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enCKcyCKBeEQ7kNvwGoOHTr&_nc_oc=Adrut51OnmEA194D_RcleofqpXjgqgPbeSeU8mrCQvlPCjMb7tFyPQQ_EA899zHf4Cw&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjOccmDayulbHkZReRcH9UPGKy6Oli4u7TIxCxAknRYQ&oe=6AA1607C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpwZDrk6oTIQ7kNvwGFzCws&_nc_oc=Adr6-BM5VzpwEF6ZSPuHtCeebjco2nWWcvoh7JnN0ZaXMEiXaXI_y3aOV6Md1GcyRhM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJGa9ais_rwTYwwJf1I-Z-sUpnSQefKzJni0QpqUTrHsg&oe=6AA15D57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4--pg8THrTYQ7kNvwEvsBww&_nc_oc=Adq1Zc5ALxIAXKjxxxz0nwwMPCBd96qtoFtRO8QXmzv-PLtsyilJvTzPAtuySS_yWoY&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLadYLFZWl2Tl-fybkwClZCE-zgBSpYblwzn3hvYZlbjg&oe=6AA178C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
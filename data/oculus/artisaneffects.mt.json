m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3pJDb2aU6IQ7kNvwGFrKYK&_nc_oc=AdqixKTIvYWryqreOtrkOAZr5fLj34a7Mo5bSmQt4kQGBv3AH5qCKKsy-K3-uxGbFx4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nHSDyGbDMFOBMotzy6dr1wRRAXOYKUUcGaTplLI4A7Q&oe=69DA5B1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yFHHy6X09eoQ7kNvwHisz01&_nc_oc=AdqHJSRMxWDCVRDljE2qqHhN54jF1ZFlLj3lun2MltxxAd11XIgb9NAiECweiWyYVZc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af04xUfd8W-A2ZDQv1CnzH40ejxfxhB3QO-DnGdNot_EzQ&oe=69DA487E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6WjJ0QLAooQ7kNvwHKPd6S&_nc_oc=AdrMnoMXCFVSGwuzydG86m78K3mFjjqLyvLbFpYOBApIusz0lr2mGgIccA0VM7liRSI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Q1HYrwTnImSc2WLpuEKxo0ve5cQqSClx2fRnDuqFpJg&oe=69DA4DFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=itOkvabbQdQQ7kNvwHCDRIj&_nc_oc=AdrpQC4C37ChRhCNuh8K6aGabKkrfIrROKfUL5siG9cop7O0c80rtf5yCIMAFXhyzDs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af30iNLBVpFoptiWiN7bqIO2hvjgkXJDYChiKoqzsMs1Vg&oe=69DA4AD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoosRf8_FlMQ7kNvwFvdx4U&_nc_oc=AdpzxoJq-Yl2HIcwelSYp_K2xC28XcpfJH3pI0G6979hJpn3L990fkd8JEh_DT49RGw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2U3W4ztX0SmUPkfZCu5So9j-GNy8pVX0TJ5FlK3aIEJw&oe=69DA2E02"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
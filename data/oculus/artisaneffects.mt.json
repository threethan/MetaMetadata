m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=398MeQuuUPYQ7kNvwFBg793&_nc_oc=AdpmRIb1XtPDwZPwqovMxlSFKCUhWN7v5N1NXZLp711GhghBddBMn43y3SnIOLK9FBQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA9bLJkd9jDc4DgieYUCvGo8Z6YBw0ORpI7O5Ztx4SR-g&oe=6A5CDF9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yGjXYz3iEUQ7kNvwGvEJZ4&_nc_oc=AdrqKYFPW2VAXovQEizHcQnn12D08HKJTzDwl6B2-AXxeY7A-jjQFbLxkGvr6uRlidg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB5minOZ7_DgfVgdt9cR09ipEQ1jnM5raHUAOIuKj2KVg&oe=6A5CCCFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y_Je9pQadswQ7kNvwHZ2-sH&_nc_oc=Adp0r2jtAckHcE8dvUXauC8pWnAA4QOpptTwL_WRFrJJg9i_OW3LxWqi_yKpsGyyP3k&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAetHzgyeWPJVH-I4kQ8KoQlCeXP2ZamMzXW6JWp-7b3A&oe=6A5CD27C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DalRaISM4fEQ7kNvwFacq96&_nc_oc=AdrBTCEG_QdnatuTx2E2wJFxTUrX5iDOCQnDJpMgo-GKOAitiMUyxKTTEmlYWbEf9Gw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4-chv9MtcAeEybt5tUObe_4X5ldLytFTef5s9CCygEw&oe=6A5CCF57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB8mUuFHQ8gQ7kNvwFVD9jx&_nc_oc=Adpw-5rUSgvv56DusDdTFEzwrkdVhfEEjRqzilWSyVFbaJ-BuJFzYMZyQaS-bOiEKds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVl64K1YCRq8tMed9p3LwxW4eu6v4YyaYBhhmK6xdIhQ&oe=6A5CB282"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
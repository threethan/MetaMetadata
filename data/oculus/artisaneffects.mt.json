m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JrQRhQ9JXWIQ7kNvwHmjAPa&_nc_oc=Adrn29tJlNqwifwpYEwy4hZ5QY5zq_xZaJuY0RIywHuqUPtSguX239QXXotQjfarrLM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0iu5qlRXnatLskxfNzZCcYQej76hAbFIeJB6f6mRumA&oe=6ABE6E9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lv1_B4Hg4soQ7kNvwFVs4u7&_nc_oc=Adrz0o1kxtybR8iiDPWDJGPikZB2wwI-5cRXOcE5PoMgG8_40L2bIG6jkaVAtHd_is8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKR9W4ocxCPyItLKZoFowCsmtgy7lKPk62EHnwJk9rCyQ&oe=6ABE5BFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faMDKJUJEwUQ7kNvwENfcjK&_nc_oc=AdrmoOaVRgjVJT7Zcl2BzfwMadFJoBeRMdvm2UbzBjP-OkIxGF6NQVETzt3FfDuy2dU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL4eCJjdEU5W2xdMV6TU0oOZSRtn-fHbbZDHJbZHLrBZg&oe=6ABE617C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsoeT2KY9FQQ7kNvwGPMTps&_nc_oc=Adr75LGWaAyZxZO937lm2mDYJ4RF5goJUTEbjRkgcjWKd0ZHK2wfT71b4-7DIImHmeM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0plkUH80sp6gFHvWFPG_pyiV7Xc4GHn9eHz48jjfNmg&oe=6ABE5E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8A556zV6tMQ7kNvwFtMSVc&_nc_oc=Adr_hVoa0vgaDs-heCEVJXI9dQ8Jjm8FOV645LwpVi8i6X7Dad99UbVDUtqbYr3uOBY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJnbd_reBaiJQIrrNKHwQhGBFmx65KHUewJJDlhIcLeoQ&oe=6ABE79C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
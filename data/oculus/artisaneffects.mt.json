m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d91ecg1F_JUQ7kNvwELEpBq&_nc_oc=AdoKq48qgP_09Z_zenaKDddtbWgQynDCTihWPLoBw74wfO10GKt7cS1yCmla5YnDZRc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNPvSh9ecxK6vn7uCzE8I7Td-GKTADvzyXgylOL0LoIpw&oe=6AC2631D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=stssWBM0YyIQ7kNvwGBcLuv&_nc_oc=AdrFUWl-Gv9v9uxkZdSTMq4vv7UItWXqx1l5y9ebExmdmX4cCInoBjYWbK_ck2OYzbw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNjsf6Dv3Q4nRc4K1yDX2atV_67mZp0SYVvWT9c63NHKA&oe=6AC2507E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RsMgj-WaPrkQ7kNvwGbQfjx&_nc_oc=AdpNDxP2BjD8oYnzUF4gH_BRymHfxbXPa3BW-c69yuBXtQTQKHpzZhG8AaHII3zxGmE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDMzRHG58uhD5-CuJA28eLxMKcjsvsleuzKRECSr8zIg&oe=6AC255FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=REMUXfOucsUQ7kNvwHaxhsJ&_nc_oc=Adq4CA4heL4mbeVv4lnv8ge_7t6H4w9kn1ZHvk5fRE0lQJJWx52Cv4m88UwkUDhJ74g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNTODkHmecgmfRueecmkSmhqZ_cJKeJ6e0r3w3QrcwGHQ&oe=6AC252D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PhWZn8QfYKMQ7kNvwGdjshG&_nc_oc=AdrnauapHIOvA3SWpuKRsBxunCE1MaTprdKrdZeFy4dw8rAKP_9K_Xx265G9-Xs-l4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMoD8i6zRzPjEY1o90awc9aH-eDUDoIlhDIoLr1og7Gxg&oe=6AC26E42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
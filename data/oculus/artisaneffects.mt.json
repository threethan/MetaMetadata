m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jXfXe_v3jYQ7kNvwFhhs6U&_nc_oc=AdqQVLqGNmBIDtIuKhCgLxDSGndtn4-x-sKLchbXLuWVgFsBuNtatlZxfdZW_Fv8AUk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WOI5AwdtXQgxpbzW0kPx5QzvCSFQHHvgTDmGmZZm35w&oe=69E0F29D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWnvsA9BjoYQ7kNvwGDAhmV&_nc_oc=AdqhxlMueLQGRHqgid9b-_D_fJijqBaz8Ti_KESYA8b9xdphGETUZoqyjYV-MoDjvOI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JwPfADmuSGSpURx3CLZLV-wKihFDXjQ2QA8ZAKGkcWw&oe=69E0DFFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btxHv0pbMxsQ7kNvwE2lchZ&_nc_oc=AdoR-qTr-qP8Mh6ZpAuJyFa_Tn_z3Tvwl4-97MkuS6kAEWSYzikIB1M8JsRpoKQHkxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S9X_leEPd6-lzAO9uZE5AFQawlJWpt2DsVSKFRW8Szg&oe=69E0E57C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_x5VOq7abYQ7kNvwHoIXrY&_nc_oc=AdoaKWZijGZrA2OHFl-2TCnNHgp0Fro-JtenEn3vDn7YUtjPVkoT8c3sjER0lbEoQzc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2rixDtm2HKPD0bnzruvHkE_pgo1nROs0oemzMcROf8nA&oe=69E0E257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsXuwF3qEbgQ7kNvwHEFrts&_nc_oc=AdpHtz99r3Lm7kCzIhZh1Vrzks-oqAamXJ-MGBMdfk7HJYpiR50eKGWiVDpBo_iJ1h0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Wfn7PmoYb8IDa45i50NZdqtBoETAYT6o3Jf8MAf58pA&oe=69E0FDC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
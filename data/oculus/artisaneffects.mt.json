m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=edK55ZanwvkQ7kNvwHxztPD&_nc_oc=AdowU_h9aw4NLtrS21LR_i7fEkNsH7ov-3kx3yXevH3nnUPgkTGGgofzmCBr7Tb6CtU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1KTJWWTp6yNKJu1CG1HO-IY3BLKo1rPYsfmIcJKpwicA&oe=69F4B91D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9Azh4tNLsoQ7kNvwGJXkLC&_nc_oc=Ado2SjULyJhmV_28uTV-BmwFdeyKjjSnHAFRttz7GDK8Ir8waTQyqa3XyLOGKIxsIOE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1FloaOfj9HxUsbaQyOlZ-Us1ph7go44d0QTAA_7m876g&oe=69F4A67E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k5BIoy-5nscQ7kNvwHiGcXD&_nc_oc=AdoR6GfdLRdL78SbAvVAwK4oxj7B03wzNEfKXOAlHMJ-N9MWD4xxe9hYXpL_kxIV6Dc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EdGwSsZe-P4jqSi6R21B_YSPJI3GiTu5lhhkxBPN5ug&oe=69F4ABFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EI_-11-swIQ7kNvwEVMLR3&_nc_oc=AdrUrSmTzkadIa2cUDNqV6_C7po6Q4M6bRL1B_GG5-hxviKgB3LmIYm_ab3fisVrtGw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af298HAczfjcIk61E4t8FZzau9421lDOC4wzGtLvnTxv1g&oe=69F4A8D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LviQ39BfJnAQ7kNvwEA02hC&_nc_oc=AdqIkWowDATDEDNqir_FcCXmyqkYRYPKZqYRDD174CZPLy318mpr3hGuz7Ecd9xKekU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0n7M1-A98C4djREG5r_I4Hf8R8ERrnox2zR4zCK9GtFw&oe=69F4C442"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
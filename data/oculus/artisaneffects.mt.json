m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKsj9r0EPwsQ7kNvwFDAk-Z&_nc_oc=Adr4uRfOzp9qxuUNGeznMG5ABsqHI7M4XFSSlFflnftk_Ga5Lhd9UqW3dEb5H9Lw36c&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTBBjUDVyOozq8zlanaXPDUVLLtCd-m_LmTQqzDOJzjaQ&oe=6AEDE49D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRBQWkWIJn4Q7kNvwHhqkIw&_nc_oc=AdqYRlab7z95GsXm70pHSl-ZFD5NCeo7_c7_QInMkvMw62jC21Q79QmLtIWR82siDYI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8fV6TkRytbLUCuk-sdzXfcmSWBIt-FIeoU66zbQPqNQ&oe=6AEE0A3E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QX-vZmVq2CEQ7kNvwHbE_QW&_nc_oc=Ado9E2eM6pBcT04qSp7NOQJLmMXwqKxoQKxg5DwZKLA1vaHw2tFI_BWGgVu7WZwivUo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSgrJUyQ56v5VlkaAHm-6BLMlG9jU0dwaCpo5UIWXLww&oe=6AEDD77C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoH6FOv8KIEQ7kNvwGFs7NE&_nc_oc=Adquyraur0eLe6Qd4qDD33IyHS7k2nA9ST88kn9CWsGBlIerxTdmhJN3edwwu8W_niQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqN6PtwaySpLIW3y5rlWkjfPbPcLN5XGvfYYDVGlUiTg&oe=6AEE0C97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF-oD5Zmlj0Q7kNvwGik3CX&_nc_oc=AdpOQnT8uXRo3VVC0Z_RZRisb8C_MLexvxMNWb_Kf9EbpM3cu81w60nScg2oxJ4hNOw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTASsBsCyHXv5ud3z0WpGZmB6_0KUerVastS68pVZl_LQ&oe=6AEDEFC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
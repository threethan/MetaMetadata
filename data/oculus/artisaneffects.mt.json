m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UHVwt-4wiwQ7kNvwHeU44m&_nc_oc=AdpeBgNKQVGM2xWH6W8CuezKP6l8HCD7uKp6YeKVx5NDL5Uu86T_PSffc8UzoVHbwek&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eiM7nsR7Mi_2Mbef0xaWi4HYAGkjyVzDs2t3VpPmNTA&oe=6A087F9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mv-NAaziHuYQ7kNvwHwMR7H&_nc_oc=Adr9bbpkMYYSyuu1GD4li5ek9eWgbvfAnVjiPyNo1tiH-8UJqB_anXnEGe6bEzQjcrU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wouYqyw-SQj0aOVgVSi6cXPjBozmp9gNPYSbHmtzq3Q&oe=6A086CFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPmwvQEbTz4Q7kNvwE4RiBG&_nc_oc=AdrOWhsgcPUrHtBburJOXTWGzk2Cq6uaVeb6VrO-d5Pt3Ie0LwXxlFV_Ba91wvi1_jM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DUVARFYZvMTodN24L2UCkBxECtS9HCXmNAtJeDHjGsg&oe=6A08727C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2mD7OPXYZwQ7kNvwEVsFjW&_nc_oc=AdrvS0YaHbW3F2cEouL3EH3z7-qsT1bZ-elh2ss7V3BR1oW3UdH5CEfyiTj6birPi6Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4SSm0AZdHmFG_MyE3RO5tzXDCkoj30LDM6oo7oJ4Q_EQ&oe=6A086F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QNwPZ0KOuEQ7kNvwFMYNy9&_nc_oc=AdrG9ATM1QcthBG5n282-QaMMW5DQVM_e8ByletELBNLZT5eferai8AbVU_gADy7DMo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7fp54gR-uW-zjtELAGpjQ30Q_FXa6TWE0M0MAdUMeYxQ&oe=6A088AC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
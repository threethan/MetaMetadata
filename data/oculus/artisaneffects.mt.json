m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAHXG63mdywQ7kNvwFLdLMB&_nc_oc=AdppvGOa2-1QLpYwmncT10_mhm1TfdSZfT-FqHTFjNtHCNvj_RyBHiCSeFKu2TW2zEQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5vqqRjYHZHcJJYZM7-Hq-ruiD-BHjd5mSVoQjCWnOKxw&oe=6A0C741D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4huuXEvN0cQ7kNvwEvFKeJ&_nc_oc=Ado63JmXqab8nif40-xCIQ4jFUhSmpI7L86WYq8WvfPlz948C08CR_el5FnHyigrZ7o&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5KTsB7qczLNmx2maqRLu06s3N3xGMbp-fo38PxDth9jQ&oe=6A0C617E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coS7w7pA6fIQ7kNvwGneFfM&_nc_oc=AdpKMheR8EpLEC2DxTahSYYY7IsfmOzv9O9xAicUqNlscWXrGI5N_6lswoUQ7QSjt_I&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4aK75bIfld07DedUtbieyE6BqywqRMnCl86iw4XjOhww&oe=6A0C66FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKG_sPiegysQ7kNvwFrlAfj&_nc_oc=AdrNIQCc7ZsYZzNPI-Xx2O5Uq0qgkpYgkG1VMyOaD9-fTfdja6QQWkY2ODJ1NWO6fWU&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50gF5kPZkt4IEWwMw2K7on3qWjEjJYDUF-OcqqfvvQjg&oe=6A0C63D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nIIwKKMjxkQ7kNvwF5cXte&_nc_oc=Adq0vSUweQ5TPbiRR54iHVLQftGjxiCt2-1ptftrADQYbHOiEmgUWN8jxxBqxIbqo-Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EgBXuMl9OREmj6dqnOSsaN_LecqsZRF5guEeVCPcoFw&oe=6A0C7F42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=88ITDq0qVaUQ7kNvwGluhCa&_nc_oc=AdpfgFIEJ59NQu1qVJi0UKOlsptte1ntpwa338lTY9WRsUjJl1k3vP_hszS83y1_zC0&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8MccwusOmkHa-_jpOsLDvZ_DglHZGgiT8bFVzBfU2Rpg&oe=6A32AF9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zySjf074meYQ7kNvwHLV6Jy&_nc_oc=AdpNXcY7tiyemDyIvt8K7u0D6g66F9hslnuvmqR_PYhnlkbrllRpi6G5pHhqF7WPDWw&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9aGR4IFeQkrLq56MkBdHOueAY-j6VdgCFab7_dRBQWHA&oe=6A329CFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WOgtuxNT2DUQ7kNvwHgB-KK&_nc_oc=AdoJ366tR2mVeiGG5CFIJJaLaVdqOEJ9E0wAWVEN0gdYDvya5p_fBT2MVeWnAwzfRDs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-XBPZWwGI4fL1POhFviJzgJ46I0r8nnHH3JZ56KV4pQ&oe=6A32A27C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_RHnDpS_pIQ7kNvwH6kWvO&_nc_oc=AdqSxGmtrQo8dMEcbdP9XPOTSNTDRe-usbPGAql2J0v-NcuWs42rEOK9lvQlF9n26oQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8vNVE5b__3tGwOEdzOAR96JoL-_wpYd62pNAYgZUybxg&oe=6A329F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvE8M8cBwAYQ7kNvwHcfwo3&_nc_oc=AdokNsQvPTwV09OH0k6r-UAyFaUq8rq4aLfG9_gVC8A7dWC0YyxhCu6iuUi0-BupBm4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QFuGV9E5wtASYJhvjSptxJN5NLQngHCAnnIvL3hwJ4g&oe=6A32BAC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
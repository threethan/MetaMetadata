m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiJ5fRxhuqAQ7kNvwE5gdcw&_nc_oc=AdrHbePVQsbJcnZjM2FZtkGk3RYoxjT71CWu2dkN4RPC2cfq4AKdAZFsMat0--Nuock&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1xm7-Rpa-8VUEjUn5RroJMobWkWp1MnxhZSEGikfgmg&oe=6AE89E9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaot20OcrFUQ7kNvwEW1QhH&_nc_oc=AdpfaUra2MPPSgPa81rjWH93I2aR9JlsoeA82RUpOS4UGi0a_3vkoiC95xuPFvXOlQ0&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQCzxIVlxinpBOjHnbPmkx72RkRxBqO7LOO0_LdUwAWpA&oe=6AE8C43E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvVLsrFnLgMQ7kNvwEEgteE&_nc_oc=AdoUkvfqXPM1EIExnRUwIAXIwQa7gsLR_-1s9LcbTkXhZkHENjcgfGz0c6Lm0clvc-g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTg_oEUWN35pl9OcnrvyXAlwm3qUu7nwCnv-B-QUyrecA&oe=6AE8917C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFjW_XwxLlsQ7kNvwEBJPgc&_nc_oc=AdpHDkMfz7BpWmDRs3gsM6DZVXVSh3nVeUGOTN3wyaa0r7Q1z8rLMdBM79TrC3G_ZXk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRxpJ0c7O_3ycD6bLFt0sEGt8QlHkGVjU6sx7vgHL3mqA&oe=6AE88E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6sNk_kiJBV4Q7kNvwEYfMSZ&_nc_oc=Adp7SyfftVKA4tuWiNAtNCpez2f8l_GPY1hKX158XcbML8hDaCk4fPwA3iO3MxTfMDE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQIHL9481pabV-Wa_3BgwM8vUjIGqDiCwHK8GiKKm0PAw&oe=6AE8A9C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwwBInl5zQkQ7kNvwFitvbb&_nc_oc=AdpEVtYVhA5kGlKmcjyvLR4A70qohspmCKz3FMMSWFwP0cFWWL0zzEutQqXK5RUmaQ8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxokoovw7wduWfxE1n_y_GyokRn5XbZfcHizEAqc2x3Nw&oe=69C5431D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rd_R75SpkBIQ7kNvwHRcohJ&_nc_oc=AdoiLLYQ52acUYf7kOaHYTtXp9JmYbEf4-mVuJcMWXKlEf4GKsmwZHtwKFHjX7EnkIg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwEDTgIioXWS5Vjd8f3oYC65mNDulGRecvMi921DlMGCA&oe=69C5307E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SFKvZj1emYQ7kNvwH72LSt&_nc_oc=Adrj6xhPSYLu7RPQ8POFRxYU3WKTGr15Pw3IjhD7QFjH1btywVX6rDWHTKaXgV8eJog&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxMoYFSmvrlw5bXBsbr8oiydi2iTN27ecedRm4utw0-aw&oe=69C535FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9lxshS5aTQQ7kNvwEoT8sL&_nc_oc=AdpQ2Q_eVnXz8GEdDR50ehrWowk_HoeB31q6ezFtCGfVNgZ23J6Vr15q8z5L--1r8NI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAAp4W1TqJHNsQIP4JtmJ7jg03lJKmRHmLV4rDT2j-KQ&oe=69C532D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVMCGuSYjYoQ7kNvwG_eTVt&_nc_oc=Adql6KSOtPwt93JBuE0eI1i2IfWeAIi5W2WowB1G5ZmK1wu21HLZidSSbFzSInGcU9A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfynGVuaa1JDrhCC4lcE0kXma7sAwVQbAx9QYKl5iClBcQ&oe=69C51602"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
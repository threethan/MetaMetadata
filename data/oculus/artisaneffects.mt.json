m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=trW91gP0uYwQ7kNvwG8CkNR&_nc_oc=AdrcEKPUcbZFWGHiLWWY_4PYfExstqpYEai5E2KBrSiusxFeeGc7fpUwstb3BaQ2vro&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3W34OXxdGDsHCggqwcNYcL2lmmT4Eh_PlcisHe3zkmCA&oe=69D5151D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1sEsS44k6tIQ7kNvwGtMdOl&_nc_oc=Adp0155xXijBguYXRfANWtRRFiZ8mbBKNbiSJorcutgDa-MIFCSV5yjbEB0EheGYAII&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zXr74Jf0UbfCKhj60mW8cr7y1YLS772zXHLXCGFP5zw&oe=69D5027E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mouTgPldNYEQ7kNvwFYuhJw&_nc_oc=AdquLSpKrPlnOyovfNBBb5SuR0-M4-zcyRKR4YSwWjeBkJE2pO9IrXJd9RWkYMAhKVc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2aSvoVxBDPgr2Bs9Ac_S0o79qIahuCyrwX7ube3fyUvQ&oe=69D507FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lm-nE7DdmpgQ7kNvwGbfiDe&_nc_oc=Adp06qa_xbhSEMm7QyRWaKADw-HcVEojRdTAOOnegjM0feFuvlX0Qy-DCywhp212NPI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jc-YeL8WaEXuRfV8NnSaCjFIN7n-0hCf4eHgb7b6QYA&oe=69D504D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HH_xW5XXJ4MQ7kNvwE3ZWD_&_nc_oc=Adq0vlj3jdugvfHZgILocIz7ZTrNxZaQp2pt7fphOE398D2EI71cjmfqowBGwNpYkBY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0rFLQQa2JQVpCr067th4yYEFKAsp2C3wPtr7quiihgpg&oe=69D4E802"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
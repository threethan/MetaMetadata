m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X5xgyBAagFoQ7kNvwFfm95r&_nc_oc=AdpHPM-3d0uxqAFOhHQq6AyPTqhExXBwBbrEVDbD4qEdSf9eU-NuGN8co_APUL40Jos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN1EI2Q6nTcvGSiWU5XSZqdmdD_Tnj8_gvlVC-OHgjrDg&oe=6ACB9D9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGbJaiVZsAQQ7kNvwFehPgY&_nc_oc=Adpxzs9-GK1l4hZZ3ycEybRl20R0mLMo91x2ys-mPMnhwoL-OSYsxW35A22c3doTgk8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOhF2H8bzPeeD23dbyEnBLA3bMC4xgitWbkg3AV5spIaA&oe=6ACBC33E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W9yspIlFVP8Q7kNvwFHwmb-&_nc_oc=AdpOzBRKGK-fxVNIeFoHNhWwDVqjg6g9bDddHPukU_loHQxuPvgblSXM_CUUyPm9Wkw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5BWTVi9nGDYHJojxyah9l_svx0hwphKjDQ0Ib9IBCtA&oe=6ACB907C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kAL4aAG1_h8Q7kNvwH8-eIY&_nc_oc=AdooD7BEAl_F_9T-MPmCaQx6aOzT9dbxvecdrGsyzH0pN9QKYqiybwlLS_dndwOjgzQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4dYSolN6uAe0Psge3RN72-Nbib431e-owZw7-73syZA&oe=6ACB8D57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rvGZMeMrGcoQ7kNvwEIlxyc&_nc_oc=Adoan--085qEzgo-864TOA3RmbOmTpZbh902IMUggd9lg1YKKJRG-udWYTIFbK4KPIQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMcuzI0H_IFDQM78vdiWtY0__qKSU2ToeNCr36wJ61AqQ&oe=6ACBA8C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K01GokW56loQ7kNvwFUYzqW&_nc_oc=AdphYuEOC9nRBGh0rg9-ILZEeuDUNkUznFhBGQdWS7vH1uz_idHkt0QP5sT0XXaKgvs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B1wCeHfPTyV4q8Ja_Xzbe1N1OdGoc9Ab6KR_yDOKKmQ&oe=6A19A31D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1pFbjtPxNiMQ7kNvwHS8Pz4&_nc_oc=AdrljpxqXHKrS08pRDNCezrlDVsQ4ymIi0sY5dxsboAuui9a-WQIpW2f3KpvOEVB630&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Y4PlxLwdNN2PalBQy4Y42jxb5dvDadzsZ0zOXe7dm5w&oe=6A19907E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOY9l49Nlm4Q7kNvwEL7SX9&_nc_oc=Adp2EJo1hhH8DPdJTc0Q0YRUBjbG9D_ToA5X5fVqvopICAtyQXySZ-T1bk1M1VtDSF4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7tiqlPdmGCb_-g-Lnhu96i5rjRSXao6iFUEDf8_3aZ3g&oe=6A1995FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkuSX_nEfpYQ7kNvwH5gqMY&_nc_oc=Adqi4QdZenDW-HX6GJy1fRm1E_j7zg1IXgR00rBhuce3rk_Ez7DFXVlXuC2llABgLQ4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u3poaYXbdVQlaExkzgrPY599OP2gtyMD4JhXjQ03g2Q&oe=6A1992D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ogufxdrY-wQ7kNvwEBueqR&_nc_oc=AdrwFvEu_LBynccgP6B54Rbo22LsB3C3n91V4eCUD9evoEMGARd4DyyLzdceRYYLujA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Br6YTycSNSZt4LF_ZslPTxk1Xj6_c2_L5mCu-PPZzQA&oe=6A19AE42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
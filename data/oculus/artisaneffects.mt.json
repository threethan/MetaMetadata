m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMOrgIMDSPgQ7kNvwHMxrI0&_nc_oc=AdomITWHVrQqVebVX-tr9ijZKrZlesG9QtJFZpW0xpmRV8-OHvFNutLbxOj2eP26fA4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOGt0wHsPom2FxoJx3cdmygDi5AhQdLCWD_OEyK6wafLA&oe=6AE4AA1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnBiAlVNKq4Q7kNvwFmlm9i&_nc_oc=AdrZfdx2UFFhhIv-GuwEkYqfyC4O-u7CAMyCgKZAhPdlepJvD7tlKtH2JWp5uWGcWn0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOekz7aUiCr6Jbt3W7UQ5Y0tMXEuc3a4KONcqi39VDmSA&oe=6AE4977E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iMUibMPGTMQ7kNvwH2z6EE&_nc_oc=Ado7lqSsy8FVf3NKXVbDWylDQ-7oruZoF0ShCOfHBYvG37Eezf5l3nV33eABlx8NYQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOI-oe2hPkkf1ZrEbEnWH7LG1ONb5gzkRZEnFXWsg-6AQ&oe=6AE49CFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ShYtrYMmvYQ7kNvwEswzMg&_nc_oc=AdqxgojyokrafgP9jqfjAYpc2Bl_t3NGm18OWbxZOFHX2tOVHCXku3CzC_YDCSzVo70&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOseQZgIVP0ueFtdypzB8zE_3IDJ2h3jDpVG6PHTdAdgQ&oe=6AE499D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qr_B8sWysUQ7kNvwFFTcHg&_nc_oc=Adp9N0rDPOPx-1RkN57yeficPcwfM0q0AFJxtsRySCq12Ir_gJsZXuDIzE9-4DshQu0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNbY4aA1YkfXR0WvGhD5TkgMeI1ABwKOPwLJW0b5Wx52g&oe=6AE4B542"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
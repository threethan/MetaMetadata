m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZgvEa-PBuEQ7kNvwFqpAYh&_nc_oc=AdoR05xcQQMjjKE_eguNaWxOLD5c1cNtzSKI7y0G-otyuyGjOl6eCiHF33dao4vN5f0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PTO6ANOvnqJl7VAumXlYFaOBBdYAMAFizCjM8I8CkNQ&oe=6A35529D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zySjf074meYQ7kNvwEaBzVd&_nc_oc=AdpgAyMeUAvwZ4d2HaADjVqKO931TwDnrwIh4E7e60Ham2IwM3v_EZhC8xXk1J0tsBg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Ra0WtJm37_fzmh0fRqoEzTgEsEFNspGps90EzFfJrMQ&oe=6A353FFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rZlvf3WbwLQQ7kNvwFZFsJq&_nc_oc=Adoa1XUktp0zRFyg-j1hnJo8JVcvox0YEhqWFr34cnrHyeoLEYGCK5c8G9FFmsZOEIk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-6HviiiTrhTBLxVJXDQyEVc3ejck18oiqXjzO4hnGJ7A&oe=6A35457C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q_RHnDpS_pIQ7kNvwEvD2jF&_nc_oc=AdqzqeAf4etgNz7v9yqXk-kw24_7SWSEdom28Dhqk2xwKF2NR__iF_45MFEl0n3RjDQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9EjnJmOPpj-p8zBuWtLoI53XiC4hQT8m8pAHjRk14FFQ&oe=6A354257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvE8M8cBwAYQ7kNvwG66-xm&_nc_oc=Adoix22PHJhMsf9ARh9Jy21n0L3Oz4bzdUt2u6iOFe1v5rX80tTCyS8CGbwgXNix56I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qjcVWMzmaCRCGY2DM4Evy5WH-qeHGMx_AmnJnaIgJrA&oe=6A355DC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
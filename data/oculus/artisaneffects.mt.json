505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2kHyEw-MQ4Q7kNvwFJMQ7j&_nc_oc=AdlHomIApHWCUvvK6FOrIpRu-P4g0T9lbnM_GQZ-cK-k5Sg9h0BcfASbbj53oOjYg6Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwpNrCdQawr8QkbqkTV-ZG2XM33D6CT_4ase2ltWR1ZwA&oe=69B2CE1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUagDyrDqoEQ7kNvwHzoEWo&_nc_oc=AdnKSA6dpdcArOnx_OX2J4Xz4rOdvn777HXvh5qv4O7lnpN_Lhc11BnMCF648llEzA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afyc8cLsxkFAO8tUVMQt9pFhVzXXsjkv-c0TFBqbUntrkQ&oe=69B2BB7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZGAn7UjM8MQ7kNvwGscgmA&_nc_oc=Adk7y2LBE5wx10n4nwWfgHXd242gg_ebYVaKBJdMW8OcQbzPOCJrafGYhPhnbTfaam8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwYh96gOYZDp_ZGf9bV_Xp0dWOGBB-Y7hS6J87klKQ8fQ&oe=69B2C0FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atDdzG1R9lUQ7kNvwEpMbXf&_nc_oc=Adm_eTp9FoGuBUi3bN0E0XEIQQAqFjI7THsNHzswI7ax0Z0Wky0ULzPjjxmUEfBCOO8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwdTXbF6TC411L_y1QrhYybjx20EtzciT2sMp3k_UE79Q&oe=69B2BDD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SD_i45g_FbgQ7kNvwFQrnvk&_nc_oc=AdkB6CLfUak6hdd7JDFcjHLfd0qT_zO0a-Mg4Dghq4_x8fMiUS9a_-DZqnQFSNN5PGI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afx3pBP9Y1swL_rquVKqn1wKXh4NyKjHdrldC-kv7Yu4yg&oe=69B2A102"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_
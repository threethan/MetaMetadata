m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J5KNfy8dNQQ7kNvwHul_zv&_nc_oc=AdoI-jkNZBheziSoudrIGbqdGXXr6D7kGLjG-VST8BxvDnj0tc0VACOiNfkE-MkxHv4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1hN2db3VZxX-DivrMTTSqPAyXcfbV-z8YNOhELzAThQ&oe=6ADE129D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IASMrYWRXcwQ7kNvwHchoI5&_nc_oc=AdoyW0Vb_j09ruPqfDV3LxkmdwFxK85PW7ywooTL-N4_8yXmH1UtmP5BYPKWupC-evo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOu-qcmOpI4dwwJO6GiufSO8dUByMMcgoOYywycNw0fIA&oe=6ADDFFFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8exqZcMwBMQ7kNvwExU90L&_nc_oc=Adr9FAU_Uhr5c3_MSH6Gb5WU6IV-yS0cW4Dxv4tP4SyuBkf3JmfMCaTif79_2d0uDzM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_5RTMKp_tcrX6-9Ggh24ST6fX-c6m5cLd4244uEYDwg&oe=6ADE057C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr7IYu-oucIQ7kNvwEcLp0N&_nc_oc=AdpYDTN1EZyorVd3sCWTjV-V1jGrxcGlGCaQ7C0l6FBmOJe6tfNN7t0pxm4qF24U0qY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2dBSlH0wH1LA1A4eKfIhof0r_lgF94yogDoo9M78vyw&oe=6ADE0257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cFAvtu_D7kQ7kNvwFeL2he&_nc_oc=Adrvqw_iwOHgUofUnagtY2r1LjBsifz3lck86joKlY_uITDrLU6ATRyn4nLck48iOtI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOW_cxZYo3KIQFPwfQwtkE3x47YnbfSxAzrzWE-nNJQZg&oe=6ADE1DC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwwBInl5zQkQ7kNvwEQtTKN&_nc_oc=AdpKJRQjmZUnsi1OU-ZpRvcl4ukxrLLMYxYroTqK33aPXvy6TVQwWW7C7tWN8gMC0lo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxHAa7BK9KnGpuRlkr9LnZMTdilvRnWZiS0VR7k9T7WIA&oe=69C6949D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rd_R75SpkBIQ7kNvwGapsh3&_nc_oc=Adromv0NJ-vx4-jUxesRcJSZXGaEMvYyatHemkC3y_XkMJlF28_iVJUY9Z2UzSPR4qo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzNw2vFjrBnZYQ7VN2cBqR7BCFqJQ9U8SIrxUH6jbnQTA&oe=69C681FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SFKvZj1emYQ7kNvwFtr9IF&_nc_oc=AdoOvS7Rnyd4d6wdJamYEvxTmac6Oqye2LcCZENUoAuPH_lUVqE0fvf5Wd9kjJGnWe0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwlsEd1xJMgNB8d-RXgO520Ox2VTlzjq6Ij1WUGXYHWpA&oe=69C6877C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U9lxshS5aTQQ7kNvwG2tUZn&_nc_oc=AdoAnc6Otj-y_3ro28tCUJhiHkxi8kL4Lm-tDwXEi7D1m16WmQ-ewX92SyKErx9gYDE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzleJgHlsIBEIzmGuoosZR1QvYPjkRwOIOpjFh1T9K8fg&oe=69C68457"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JVMCGuSYjYoQ7kNvwEQ6pKP&_nc_oc=Adr7mIPl4RsdfAwgDj6ZNTWv68d3WFk1tfOTa7lvyi2CZExYka5pThtA9VBW4L9P3GY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKH1wISi-V6V6frPF1rRn0IXgNE3-ktgdSfF79FTGmPg&oe=69C66782"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6PYVe6GD-HoQ7kNvwFb3LzI&_nc_oc=Adq-SCb7LiPMVsmSVZ9ZtObDLG_V4IBGkwr-b-w98iX_76c2IXJ5KzYmOgoFCbKuTdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7l3IKFTzbbAkzQxtHldIzLrE5r_FtKN1nNJpiqHXguw&oe=6A4BBC1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MwjTCF6w1eIQ7kNvwFvfeLY&_nc_oc=AdqTKSEAP8gVittt9SlVzHsxSafD26IWRk04ugFDfa_AMCDm5pOadcoZ2YxGp99Je-o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnTwg5CUnIulF5duT82HQuGdKPDv_aoeCwqqHxv468qw&oe=6A4BA97E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WV2CGlifFbAQ7kNvwF7nQnL&_nc_oc=AdpYkRXYVAnF4hw-o9e9Szq2VwCtvNM8gAOYhr7SClGBuG7NSrylW5Afj4DBoGYnB20&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAMKhxjAfckKPnQJb3F7eGHXhqXE_aIoKCto6kjCEwhoA&oe=6A4BAEFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LA-O5hmG3kAQ7kNvwEyBp8V&_nc_oc=AdpLEwRI4KHpjw9PiLN-H_RayO6sZVrYi2_fB57v5fGqhyAIJsMAKukqXuIOCAj7XmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDEpB0DI8f6OpiagDZif_FAaKhBFkDd2qiqCb19KuryEA&oe=6A4BABD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7ivZgT_A4sQ7kNvwHeXAzX&_nc_oc=AdpmplL7tQPGGH8wm8W6gTPv7OT06RCXgiXB7cgmMgIAdRw6GXJ7NOufBYgTxD98pLA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCFkxhDCa3f30w4sLwF9OsRtLw4xMEAPAdDp1lX5zkpHA&oe=6A4BC742"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzq4cz5EaFwQ7kNvwGC_b0u&_nc_oc=AdrH5WRslcBhHy9gFkvcaaXNMrk1OwiKgZwsOX9roHk5FQTXZMElOBvAhUz8IRKcdfw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy9VAgEKZAwkVtsBRqlvRy-_ot2WJ5qBj1KqA-lhvcEdw&oe=69CE7D9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9rzuYRMPCWUQ7kNvwGIMMeQ&_nc_oc=AdpBlwdCZf6RXXDOIg9E9zcSVT0BbWqGoTVsPQNhJmhnRM08_mBUcwoyZRclbnt_inM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyg8eB_UH__yguSK6YTxK49RDYKyZJIpEAAakGuAWM2dA&oe=69CE6AFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5aOvpqrK9q8Q7kNvwFfN3j4&_nc_oc=AdpP5rzwmtfZPVa7yXU8WB3MGRRn_2qH68pnAiDLT0sMoPGsVrwRr3Y8hZOLlcjkKDc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyvLNzw8g_RfANQyVJDw9XSrfbJFWlYegiIJvcje8glAA&oe=69CE707C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AaWp28Rbk_IQ7kNvwHsoA_l&_nc_oc=AdqhYwgkrORJ5tLpy7elHopQCfhumRyKFflHK7gJe6wXgR5uWhntmY0On_FD42sNyJU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxIx5dqaReHMHLAlnR8Zb3tkg_sXrzCRtuwHcJdWkh-0g&oe=69CE6D57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cHw6Bc8LTW8Q7kNvwHbw172&_nc_oc=AdqZIx3PF-_lsqbqREMC78r2aACwodGZKvP-0yjQV2wTpuG8xEI3KuxPJD2dgWEDU_I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz3tcss3hL4UKU1iXn11k--136LBZ4b3CELw3Lt9jLREw&oe=69CE5082"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2kHyEw-MQ4Q7kNvwHQn6MK&_nc_oc=AdmEoUXbLfxpVquuJMMrhOnIjIMND0cXwu5OBemP7W5YWhb8pNF3PvNcZ_faoCxV6Dk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfycIO8NdP6rCx733gVCWxypwLUXwlqccJkLoJ1vAzA6qg&oe=69B41F9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQfgtp9eqBIQ7kNvwFZrtIK&_nc_oc=Adl9oGIupLqcO8WNWXKWtYv0Ko26E1mb1Dh35KBtrnXVsCyRic_w03Lc-ZxnDI_URKo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_Afz1iTf8bsYFZ4RaiXHCDAdsW0VWYg0xAswLpLQgltECaA&oe=69B40CFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XZGAn7UjM8MQ7kNvwHWiRwS&_nc_oc=AdkSTG_KiChFQc46IUgyWBqpq1XQsg-aekWQzhu7DJ03BHf9s1O-JNggwx1B4LRiTLw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwHJYhjO8kaS1TQ9HXFdgIizdT02_w62Urq9LMbCqpdig&oe=69B4127C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxNbCNWNwOoQ7kNvwH735aN&_nc_oc=AdmQLXY-nOMHWhUbpYv-iFEgd4K5T3-_GS3z1a30tC7jLQe6MR3JzpQPgZCczsZNt9E&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxkKWDcA8_kM7nep1B0l9ZjSGM02kMAL3MOsUo-WnFV0w&oe=69B40F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEmOAf1j8R8Q7kNvwHGIPhn&_nc_oc=Adlmx4e1jhq9ASz-HObsmSwIu9DK6HBaQa4uFWkXNrId-vjhtrHGR-C4QpreRiWX0f4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzcHldurw840jnN_Df0S9twvq2FdcPQpbOXwR5n0MGwRg&oe=69B3F282"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_
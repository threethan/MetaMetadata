m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZKzN9K5yZ8Q7kNvwGSdkyr&_nc_oc=Adrh6XRykvU7uoE2Jm3C7hTqTZRtzl3tlG0VyR6gYOMcUE5TjGgQtJGj-E2hN9N4ENM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwPDeaEfqa2fn4yYdcm0zDQI4xYCk9DzSFMFKDaBSwtg&oe=6AA2BF1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJ40j60e_gIQ7kNvwGu_84f&_nc_oc=AdoUXWjPLJeMt_bj5rYyW_0QQfLahXDtmysS4gX2iC7tb-axHkn-oiTohyuqP1bM45M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKgXFvkwBq15Q2XCGn0xsRLi6JnqDzelTxKT6Y_WW2Kdw&oe=6AA2AC7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fZzcLNr-RbkQ7kNvwGA5u7o&_nc_oc=Adr9YjUe8OCWs1lBtdma-sIxic3TFx3KCkkb9H_u_ahJhT7dnkXMGlS53is8NjCDPnw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQISA2drRnnSRttPOHSrN-64UcyfY4sk8KvWtRbyCfMQAg&oe=6AA2B1FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpwZDrk6oTIQ7kNvwGyxMa_&_nc_oc=Adoh7kMYgIHCnYcAWa14LX8cCJxpyYlzrlfCMywkH194g8yTIxBwAwq6h0Hi_aGbEKg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLY3ArpsT1DH33QCexFApx5Gd4Tmup8whdz41H7ik6iSg&oe=6AA2AED7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4--pg8THrTYQ7kNvwFqowDl&_nc_oc=AdqcT18JosMRbj3kQ38W2P6GdxRuC8pkdVR7zjPQ_qFIXLpkHfE0e4HegP1NnzufMPg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI1q6DxUyfJZqUvronX4h3FCwHasRxmcj6ylGtUYDmumA&oe=6AA2CA42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
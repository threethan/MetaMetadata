m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0DzJhy4fEZEQ7kNvwFusDtP&_nc_oc=Adpj0I9rr6q6RlpuowpAdo_ZfE2_JD3-nN8WKCInRUWBYEzo94RAEA2_iq5qx3oivEQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLk_gLDUCgMY4sfzMGiE0VPIQimNBO1ZZW9e4xoQZjhpQ&oe=6AB9289D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFjmqJOfDkAQ7kNvwH2885Y&_nc_oc=AdpAd2coIaT70_ewJ1fT9t3rnFCqutfSxoE3UUa8QB_Rl5mx_Tl-RLpyVM919fTlzjY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL91rqKuFCy6z8p7VUud4ShH-GnQugzAjHstnAqE52B7A&oe=6AB915FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=36aGMLFpEB0Q7kNvwEgci7W&_nc_oc=AdoZ8pQP5AOC10yq3iutB81nuM4hwu2x2MRwmqxmCTuFrNdW6DZ-JonqYN_fAXalbfc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK28IZeUh8YYcJ5ht46k5-EtWFQ5YAka33KKRgoVtAmSQ&oe=6AB91B7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT8MjP-0XhsQ7kNvwGAiPWz&_nc_oc=Ado953ULMdvDbbV5dZO6YXJwLkoWfF7JDP5Ntmf5w6K-4gScl5VbdU1f_82f-6NQ67Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKx8LrEIL0AWqtRHQJucJ-dLXmDzNKfMG75huDctxc6Dg&oe=6AB91857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vWJTB7JUYIQ7kNvwFA4I-Q&_nc_oc=AdqxUDjK0E-0lwkWSlBOXmPj79M_BbRGDT0nOQnegNi-k43nNTsXyJxScpKkmn7gO_k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI47tExWUUXcDufhxv8bTwjFURLwDclizjS7xLkv645LA&oe=6AB933C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
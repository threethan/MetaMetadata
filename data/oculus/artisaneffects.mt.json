m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNJWEnamEDwQ7kNvwHWGLrj&_nc_oc=Adonpwr0opZGA9LBgU6MMUE_VwRzf7c54MyA5eaJto-sOD-qXcMTcbyHE8X7wU06Z5o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR6zj9rrxOuw9vaFJdO4GJNap4Bj9xEC7XNUvyUNhgEDg&oe=6AF8A8DD"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUH8uRnOEK0Q7kNvwGwIU9d&_nc_oc=Adqj1sLQkE0NTvgXyJRvlck9Rkauzfax2PiKs4ccYLdnCc8Ts73RcimsVhEU3gW-OUs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6bWYP_G5TLdZ9M4djd4Cg9Q8OyKB3KrwVXtQf6b2H6g&oe=6AF8963E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIfACK6PBy4Q7kNvwEu9MdV&_nc_oc=Adrv2oMWEQGLFqEAvgiQHSlCPmGCRewzo-wZNrGU_Es52r6O8mjagMvnnnOySS2Fv6k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQShD6KKsBmdxq-3q5vW2CKV0ecjJ3wPPduAd4jIm-ajg&oe=6AF89BBC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOFClS3f0vIQ7kNvwGjXZW9&_nc_oc=AdrrZhvSKXbxp-o3K4pbhVxuXnVB0idXcKEk5tEH8w4Bpbg6R9PwqK-wSEwC-pC0Pm0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSjgX57JOna5u08xZ84YPmkEbwLpkoQjsM2rG9hl8mBsg&oe=6AF89897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mnF7aEwNTEQ7kNvwG8IOgY&_nc_oc=AdrE85nov3jb_PQ22Jpggfce3WJVRIn4qYLTktEOO9wByCc3EOwcH2P9Yc0Rw0SgJAI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRQjHwpdaSwm2xEueo6Z6CRPCJ9nTaEfVPqkHAhQVmXnA&oe=6AF87BC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
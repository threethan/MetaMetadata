m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FbL5pWC3iwgQ7kNvwHA5IBC&_nc_oc=AdoZ1RCEs8P-7O_CyUMAQhr0Ceo3u60JwsirRK0mF0OYt6j7PazggoknJJefFfWYaag&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3XlFTkATKgngvpHUWGRb1arPWaRGiRFnYnj_hBv8dq9A&oe=69E8DB9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l2PG2vcLP4Q7kNvwEMse51&_nc_oc=Adpkhw0dHzYlzSZHi67h-lb1jRlKKeHMIYapTK0263a1_c-U8M_BsiLSREbadE_ZDBI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3zZl9fTXQdUA7S0DUk4hkeCzD10N4wB0s-cb57DKVotg&oe=69E8C8FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMNgSikTAXYQ7kNvwFQwD-x&_nc_oc=AdoTGkerx0ylSvCdvJgEPwpq17NX9f2TG12SOn29GCeBXRRdz3LtUpwIg9sL7b93Tmo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35xzL9iclT5nRFjsBYc8zqbdMf4YkgkEyB_fDwUKpReg&oe=69E8CE7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5u9lmhwarz8Q7kNvwEZvdup&_nc_oc=AdquMzW9OYsHU_cn9SrzzVWBaqZ3aLgE-cvLwX5oZJZDoD5IXjrZK7XT-83o4JJNlIE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0No9aiEMvbgO7bbRazDdIQP1VpYj8GWutwT9uQ35Doew&oe=69E8CB57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6i7jRghZMAQ7kNvwGsTyRS&_nc_oc=Adpi4-BRJBoMycizIXWmQH0SzRLftlwwfXhwipyd7ZA7krhh5TvCmBKVpsvaouz69TQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dno1EC_0RDnK0Vm5pioAFVefGcOLBim7GxftZlFXMXA&oe=69E8AE82"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
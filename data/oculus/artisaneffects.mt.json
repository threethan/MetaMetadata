scdn.com/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEU53BlC5RMQ7kNvwEGtwMd&_nc_oc=AdoZiBsB0ZF1s_MPIPzOmWMqvvP1QF4bsmLqh2XMqAN3gvqyEaVGOfrPbHMGuh39rbM&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Jq7v5lfLHrz_58Q1ZjL-QSUqxX6oQHYnw-D7YCm-j6g&oe=6A22DD9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zh7lH90ombEQ7kNvwHivuIr&_nc_oc=AdrBMhgI7kGGc60ylhcW6bUfK38x4oSm7QV98mMxYZyatdCoxxkonjAdJCLzMH392go&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8hboR7TRcjI3rg-Yp4Hv6C-EeQV5eMGSipVda1hYFWSg&oe=6A23033E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6m4bz8k2mEQ7kNvwFgpluf&_nc_oc=AdqbF5_oq4CeWj-uGvOKZ_lFHkdiA8BZ8tKABPLjwPhW7VC3PUhP6eQ9yv-fAk5f800&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-uYFUJB4FhFyP9kHtC9P3VMf7p1WG2wGs2_ezQrmX-cw&oe=6A22D07C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_zDlCo6lW1QQ7kNvwFQBY2o&_nc_oc=Adpt-Zm3g_xeIfSCTEHwevY1ASz7t2gmoqlJbRo018zLXWbIa7zweDz3Z_E7GMol-2U&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_52INaEYT5k0wa_Xm1a1s3cekbscSxpUuINPA4D2eTzg&oe=6A22CD57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jiuEEF5kcoUQ7kNvwH-237w&_nc_oc=AdplceqqJWTvUqAZ7jGvSzcGv7nBLPDWy72DSL0uxu2fAmCdUdOslL5RLR_u_eJJFzw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9vH2un8OocxvV7pLjXUDOgRqSxONSGNG5JUKCHVQ0L1w&oe=6A22E8C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278
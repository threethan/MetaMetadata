505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKFcw-qFujcQ7kNvwFBA6ln&_nc_oc=Adnowda_QdVjh5_L9h2oXxkrkHdSHJ8dugeI25otsXf7-IRzy2JgQneoenpw0v42lD0&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxh4xvN6FevyYBaKEKtIZ-VB7yetcaqrx7af0eAwWYEiA&oe=69BD5A1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uFMSMzaMI1YQ7kNvwHYinUU&_nc_oc=Adkm00GaS_c_2rMPMSfVCLFjUIexXBwKjlA0jLm4attg9nGRw2dM9yxJ5iIBPfe496w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afwvdwq7ToNDqzaMGa2DB55MbML9EiRLEC3Yz-6wfmVrCg&oe=69BD477E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uDY19ISckVUQ7kNvwFAVzzj&_nc_oc=Admtx05dJ0_zfKdKz_UTxrA20Htl7PCKHhM8nrdOwyczBrBu_PL0NGkHM-VWVebc4UQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxaR-yyyaS-TyLWBH36ZSen6Mafv5yixCO_K1SbcKc1TA&oe=69BD4CFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azVkvUzBLQMQ7kNvwHGsaP-&_nc_oc=AdkE4QRZAUzltJTJGeQzci3UW3yIEzjDmMGfshQbTMpHnjaJGELn-o0-ZBY7K2CerNg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwXWyxoABrc3ZzBBEsxMoioouPZ-wzIUjO4QGJWmymvUQ&oe=69BD49D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCHlhtBa9z4Q7kNvwEUkPH0&_nc_oc=Adm_SdWRS0jd4aOCvE91zm_plJnU0zP5l7-vqhbRlN2IgfQJMorFrKldVKArQ_0XPLI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyKUc3vFxiQxpXKNWrd4T5T_-KfDZPif1uKArIp0quH0Q&oe=69BD2D02"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_
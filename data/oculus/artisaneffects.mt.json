m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQWoTzIlvL0Q7kNvwFfOnvq&_nc_oc=Adp78x7JBYNIQrsXyp_C1BsVa8AoHtRoAXjr2iInrSMipHCKZqfw7Mbnc10p3UTQ7ks&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vgtjEi0-C0xfwIMpNTxW0f4ysr8yqGWiz631yXGETiw&oe=69DCFE1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiUhdGQMiGQQ7kNvwEwfJtd&_nc_oc=Adrh_gxFn3J6-q-1Jn9i2rKJfntvkEN3OV543gvo0Ef0ehFHPBQDttJ0tNempZgDzcQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3brnXNhb2IQ68m79zF3Kd9On2Og34KjjoUKM-rTcDo5A&oe=69DCEB7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRXUeEMiMMkQ7kNvwE07BMB&_nc_oc=Adom5VjLlb9UJ4mRhtRyNr_1S-BxV3A_q-gHto29V-Jy2cmjr_iX4CQBV1YcHt2r5Rw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YWonZMr93kMIFPJEtas3iHdth_R35ggypIusVFFLKhw&oe=69DCF0FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q4Cp3xTcEUQ7kNvwHZYfpe&_nc_oc=AdrBd7o-lO3otCvNiylz7ThMuME5oRAE-JfMX9Gz5UepVGjhzdi3hmmOHPr3Ru12xx8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af28fvZKisxpMMVpRKkaRhaXQPaBhyjv6Gk8tyR3WL5bKA&oe=69DCEDD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F_N4i6vze4Q7kNvwEdanmL&_nc_oc=AdpSRQ7lwVjuncopvL-WHAojf-SS8fBVVw0gtP3R3vNAOuXLvAwPiLpPdUZUcNb_Ek0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3vNU-3s4Odz11ulyJeRstMT7GwhUxLGquqIzUPPp_9ng&oe=69DCD102"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
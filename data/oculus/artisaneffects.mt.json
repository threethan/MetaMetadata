m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UHVwt-4wiwQ7kNvwECz-_k&_nc_oc=Adqjmk94KxAuwevFEiKEF75tdJ-wNd6wsethNQmSbXtdAbOEBm7rYB5TjPWn3r7xQnI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qsVL0QOwy7F03SW5GnDcKfq2XzKSQiX47GRFYbai4nw&oe=6A09D11D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mv-NAaziHuYQ7kNvwGLRmTN&_nc_oc=AdpdBDrFpQfQIMacVa4dFL1IRlDkRlVU2hB3ixbLzSse2e04tlBI10ibas3-Zi3aS5E&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wjX__Ulw_rBUkOMzS1JNBtQflGp7q9jcL3A-sIMTYhA&oe=6A09BE7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPmwvQEbTz4Q7kNvwFxCW-D&_nc_oc=AdoWW_CXSeyhcVxkDN8wIncokE5I7jzIjU_P7XiYFDXIbk4BLWatcPJCfYw806snTx8&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7K25keZNTh9YYrD-uL8N3LUZ2vIllXQmYAMRi5USGSZw&oe=6A09C3FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r2mD7OPXYZwQ7kNvwHhwTUr&_nc_oc=AdpEc8LKSTwo8pef20RgBNiKEP3RATaWLz5QigqOJITcFOWg3Puhk8ybxI8wXvEphOA&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4wOgPF0CgXpJS4bEIsoI58eFvmK17EPbVmnRICKlQ7Hw&oe=6A09C0D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9QNwPZ0KOuEQ7kNvwE3C2pE&_nc_oc=AdquNysYdr-BRtUN8GeyzTiNaNRRq-SQE90X1y7fE4OCpdDa5MUXzXgjGiA6kmghE28&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4bgIDnNip3L5-4pgKSMmX6VHVQY_uxCq5YYdhTAQMlqg&oe=6A09DC42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
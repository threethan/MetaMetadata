m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jBJvFvon0wQ7kNvwEANnsr&_nc_oc=AdqOjNXQjelQ04t9NtfTtwjXEX93KYZ8o2VyVf7WZ49T8mQuSDDJSvKgcs7VkhlmmC0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDC8uPo6reG347_N-oz67ahtGkspoyTQhIj3ZqFQxjSxQ&oe=6A6CB19D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNbqTAeLkpUQ7kNvwELAJeb&_nc_oc=AdpiT6dwpra9h8WlM2H01a4my_F9V19J5lhj--Skjc7BVMtDyvo7uyjRwp_Yggr4A8Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBISwHc3KxNtFhaEEcOL_PdQxr-eDtF8BZ5pBl5CCONDQ&oe=6A6C9EFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GuIFP8LOfYQ7kNvwGdpEaZ&_nc_oc=AdrdFzqre5uIHdNTHU90_QVT4YIcbgN2qOvVlXnUO8DI8GHrfhwEtIzLkMQ6diZFmnw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5ytzm8Q6tE5hZjOC5zmbQ-dbkG2Q9jeyP3b0tYkYUgw&oe=6A6CA47C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJr8O7aLt0gQ7kNvwHhRggq&_nc_oc=Adp7ctyZszhgtYeOxIFiqrVcjuCukAPiEsRqv2s494m0A7HQyYuwyrOck1NJs8BoBhc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCi0_v7Krd406or266TWhuGLNjYEjihUf-wroAinz-Aw&oe=6A6CA157"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_znzt97NkgQ7kNvwFWXM4e&_nc_oc=AdoxquV_8lxpXiRGAmTvihXbmwiBfoLSCSoxOgSSV_K-zzfSeveevHoog0bcf098Mbw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2dV64kYHVs5dXarpIg3JyvN1MFYPCN9dt3kJUpu1LLw&oe=6A6CBCC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OjZmz8c0HU0Q7kNvwE_48Rv&_nc_oc=AdrBVxE2rgkGzfbJuUjQ-SXEnZa8Y6PTXEh06CThpnYjAOkp28ZLGFbirltzTrpZgZc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBuL0IMf9UMO0seqBmNmFHaaxDbodL8dIULEnI2fZaaw&oe=6AA01C1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I8nrJueopmMQ7kNvwG5CKPs&_nc_oc=Adr2LDNwGZpIPToAYGcBnHglzZ_lSLqid_fGFrDPETZIzNC38eGsUwhE8_aseoB_8TE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKjMys77Ma9THx4L3to20vK0g5btFxTqEHYtYOWfeNAJg&oe=6AA0097E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=enCKcyCKBeEQ7kNvwGM5POc&_nc_oc=AdqilvLJzqpypBgw_UR6RxLh_pagqc98Lvy98k3_JrdzJQtlP2pnTJeN8sM71eXWHSU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ70HW980-f5AXygvtScp22x6axDVXxTy0Ht6Q7tGwwwA&oe=6AA00EFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jkxWqu4KxkoQ7kNvwEAJEKf&_nc_oc=AdqlCiQpaylf6mwASIUFC2f-Vp0fA43zunL5FuuG387ow7tfLWGNCrUNWh9JzmRfZvg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJiJv73rDF1nDeg_QH0df4yi3dqKmSq-2saHmdsjZOSgA&oe=6AA00BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4rEiXVorL4oQ7kNvwHRkc7n&_nc_oc=AdobZG1b5bcyCBPc0EK8Plt5Lt-_LBgiGcqIpx_4NXDHqlsOzIxiwc22AgjLbXXn7z4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJBIYGq25hU1B5rymmcIdUUlV8EN3RZIEaC8FKBLXZzvA&oe=6AA02742"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dtn_bx1j8YMQ7kNvwFC3Ne3&_nc_oc=AdrNUsWJ94FTY0G7h2jlzsGyedKUjuHQ4qObKU5H7_jIaGYjx3AP0LEqzU9iBcjCDa8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEfSbXFjF6y6ImDafc_f1lI2s2jO3cdv0AlwOLZOoOpLQ&oe=6A8828DD"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxDW1Hr8GQkQ7kNvwEwu_bP&_nc_oc=AdravnnnCeBn2p7r97tiOC--ZAp0hwLS1_2ZcvbbBJTMdtuqvK_1PZvmWsMN8g2kYZ4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7vk5orpp9Hlc5LpW8DysLYYRNbKRKamQ6dBqkSBp_pw&oe=6A884E7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cVWarpqXHcQ7kNvwH7lpEN&_nc_oc=AdpJ_ZpmHPF4_eBXhjSH-Dryrnyp712vxF6Coc-M5rukTpR5KkGBOPMSh-RMQQlh6ec&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEKix8taWGXYG_Gfd3Gz-ZCoFDWH_B28KZiY1zstv4Ltw&oe=6A881BBC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51SwI6R-dlIQ7kNvwEfPVOs&_nc_oc=AdoyruPNXuZz-IRYahieCDLfxHZgHmRPXawCFfK3TXfy1d3du1_c5E7LG_d5NcViV-o&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECfG6tniBsRWRq3Xq6ESti4-HgYMoD4Ic8lCqeUsFZiQ&oe=6A8850D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnvTbv_RTGYQ7kNvwH3nwgY&_nc_oc=AdoNf20kRWiGZCSIzCx387dVgZIssCW41VTJndfJCVlWIOvnrK3ipJCNip5JJR8yO1s&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7wWh0EFVTjdE9CsRz9tWLMPTSkcou5PwanDFU-qQkkQ&oe=6A883402"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
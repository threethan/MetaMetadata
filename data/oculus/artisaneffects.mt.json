505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i_s7qthubFsQ7kNvwFM7FB_&_nc_oc=Admo-wswd7S8WNIL1pB3vfV9zoMwNB9jWpprvAiUB4ibZ-uD36CgzspVRPxey8yx8zE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyidquOMMxCGoBG0nseOfpvW2swkIWW08im38fRy-Oj-A&oe=69B9659D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xarphTYrAw8Q7kNvwG_ZcYn&_nc_oc=AdkIbJeqNxQM1A-7qr9Ajxx_7hKE3F3zEjDHm-SCdqjg5KRRnnhRwLPyGWamn4_p9kk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfyRxaNO9LBzisfIUGSHNhcE_Cp0RjNzKGY3tdoKXUOMSw&oe=69B952FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eZcSzFCcBiUQ7kNvwFXPG1K&_nc_oc=Admyb9lo1t7vK5H2G9brn_CiFvUapx9x4CPSsGrbbwtbmOqPnand_hP1q6aA9X_nLhc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfzvtiEym9365UzF7kyHxk7jARZiO5fMRTBA0rC4h01NWQ&oe=69B9587C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKQM6MjIpZAQ7kNvwHQqWKv&_nc_oc=AdnIyc7E3bHeVH1x30SchzF7F8Ma-Vvl1-kF7Dr-qvz118uFbeq45cC9v2VezfqRsYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_Afwdu91NjgsaMIETycA9CUJkufVU_Qz2FQyNWoqZXVQPNA&oe=69B95557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jf770r0Bt0YQ7kNvwEWqi3a&_nc_oc=Adn4h1YJ41FQoH2S_rxl98pbiX4sX3SmznwUPYF5t6YoC1tSZ4n-qqL7NqxV1dfk0WI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfwpTzdeFo3CeIG1u-fOwGip-hoMPKPeXE1xKGfe2kii2g&oe=69B93882"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j9hST1hq5MUQ7kNvwEWiS6V&_nc_oc=AdoJ-T6wclgLeKS8zCZo-m63o5CO5R99ifICCaqURJfYGudxkIRaYOg1deQZXBAUri4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEE6gZA0JT0HgnBlgOVEMpILw_H91PJFHntb57H5aqWQ&oe=6A5A3C9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2yGjXYz3iEUQ7kNvwH5pHcr&_nc_oc=AdozGcaIJqHfP3bENLu_DzuaAFc6_5_WxL441zaDA3Jloep7CR4-NgCI34hqZQ-Hpl4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA7P4wmyAFwBeJVpR2Ohbw9nBVhTV8tELfDSJTIT25UeQ&oe=6A5A29FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YagUphCH7PsQ7kNvwGfGXDB&_nc_oc=AdppCP5OGHf5k7SxLrwhc2v8AAxmK1Nerz49ckbXh2G47z_eQe0TREk6kFopxdEOX58&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCFHk9MPQQuKqTpYNzNTYTYNSbBtSlBS412hvHPIOWcA&oe=6A5A2F7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DalRaISM4fEQ7kNvwFWMORV&_nc_oc=AdqqxpXVcjit025UV8Rw8d3a1GekoF9VuAT5OJxxTWaPHW4QYJ62O114scnDFv4DRyM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCVgI_iYJexxyOpl89tMbMKbeSJEfg3u589Ey3aimZukg&oe=6A5A2C57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nB8mUuFHQ8gQ7kNvwHewo2u&_nc_oc=AdrEWvYKN5rFJ7Y-VhTyjh4ulZZGiMtNIyE4cTOv_elSgIzr7j0zppp9M7tR8W7QrZ8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKPItrgZqXll4SOHxnk5FRlgvZJw_SpHkK6rXxZf4yNA&oe=6A5A47C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
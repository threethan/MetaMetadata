m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaCUiJhpa6wQ7kNvwHaGOHX&_nc_oc=Adq1n6ziyrsdy7IZs-tjCjht6kV8j3eGGlLr0zzrzzT-C_UeqREybeCV9PWviPMs4NM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMbH0gUYooTPhQpsn87KewbXyyJLi4CLrkbsIStMa_N_A&oe=6ACE409D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be1H_dG5UYEQ7kNvwE-aNed&_nc_oc=AdpHjn-1EpftgLMrPFiDJSfdHSu4l2tUZ-BvGqx4pkwCjG2ArqJ82qCEQsDKsTLi5pY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOelzvIkgc9Hwg_ZglF9cKEazszxr__WrAibI5adrB78w&oe=6ACE663E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IlFL9Kt3OUQ7kNvwGGhaJm&_nc_oc=Adow1bm5cjo1trRYyboM_kx8e47Cgod2rxESaIHnVg86YdtSNkfzM8me3eGjsYdFh8I&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWnf-ROUnljknUO_iNwEK5tD2LTu6hXYBBLRJ0oax-ow&oe=6ACE6BBC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQZnhIHC0YMQ7kNvwHEysbp&_nc_oc=AdpvgUAROkDM7SBfgkzlDvY_rpY1XLR_aR1A73E7CMFiHzoIt2f8xO-z6FJ9-SXlh0c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMU23ZllOeZ1IR9DGCnjDIo91QO-VWfD__hov0i3eZ63A&oe=6ACE6897"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qppup_nzMI0Q7kNvwGfFioI&_nc_oc=Adq-1ULKTkTEerPOmZ-hR642MY1xwVPwCw1J8lmxdXw-ydWZwXId6FgyHhvKiJDTh-c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoyQKMqSBLTnmRI4otig0exOXTPeQa4925jeQhrKvBxg&oe=6ACE4BC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
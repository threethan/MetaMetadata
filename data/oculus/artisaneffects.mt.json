m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jBJvFvon0wQ7kNvwF3guKk&_nc_oc=AdpsSvpEWLW6bpoviD7Q_E7RpYWb_UrNYnGy-iQoYPGF5DrQOPjps0WykMUgb2hqDj8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHmsgpQ_7WS2_xeZsW-urCV8orm5A_CGiGe0fmQa6Iug&oe=6A6B601D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNbqTAeLkpUQ7kNvwG8LCiE&_nc_oc=AdrnyQHTk56hzsFnOSMGPh1RFm1rYJFCNLiVsOQn14iGCbjNKoy2tjPyr2PoheNvezo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDypaoC6_exOLG7ApFREBUL3zKz6lLp_4NNps0UIOyy2Q&oe=6A6B4D7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GuIFP8LOfYQ7kNvwE7cja5&_nc_oc=Adr41JvFsTXU4JfcEtyksHxg4O5lOtn021Y0Dlp-UaVCOHsyJZifw951snW0jNQunD4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuDB4G8EDPPg9oKD1g5MrwIJwKl-8wjkMLFkidqP1h9Q&oe=6A6B52FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJr8O7aLt0gQ7kNvwF2JTDe&_nc_oc=Adrtnw_GJS1Q-RLbbG2EETu_Y-mjg4sL9w3pW0CXLiDQhayIVD9Ta7Be5gL8Tt8CML8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC2wwaoEh6lvrK83p7ahuITCJaak5Sxe-j_SblNHwNe5g&oe=6A6B4FD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P_znzt97NkgQ7kNvwFgFmwf&_nc_oc=Adpl0MlwsRSPGZGcMCdeDlgEam5QkQi-3lh98oIzeiIzO-wf0oQjR5aIH2QHWifNCvE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAcvsuaDeQMLLCsqIF691tYNFH--6A1vW3Qw9zEe7zEcw&oe=6A6B6B42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qJQT2HI0yQ4Q7kNvwHsEsv_&_nc_oc=AdlwFKjkKjw4SQ6HEhA7uaoGy8qDoCvCVnOUucBAGATbjBrgwD8xR33vnpmSjXhZCxc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxwpK_dekwgBY1F2bQaFl9SIUS2XCxGjwCWWzj4so8TVg&oe=69B5711D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kQfgtp9eqBIQ7kNvwGFmJjC&_nc_oc=AdnwolnezopfrtPLuOhWOA1IxWsHutk-m2UQAQFzdWAx0csvuNGrc29PnJdc8GoMFEM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwvVqWh8IPqWUTSuWeEQwZHN3OQGN0JpDHLKW8jotp8ww&oe=69B55E7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqS_KhKE9S0Q7kNvwFnCtjP&_nc_oc=Adm9pXEDoyq1-ckSxvx8czdD5Xy4I291N_Nux-thd6KJYTos0iFCl_m1wDzYJZD65Pk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxrgE85WAd5vpQ83rcrZ--JXjlQCOhObM9S-xxvw8ABUg&oe=69B563FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SxNbCNWNwOoQ7kNvwGTm2V5&_nc_oc=AdlOLz2NT-qBdAAh6y4Qb12Qu8nbnogxt6qL83k8wMVlWegCGa7TwHi--7cjmHlGnJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyAVsP2j__A8U1tMIJJzcoBrmA06JiunAorcbnB1b405Q&oe=69B560D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vEmOAf1j8R8Q7kNvwFMO3UJ&_nc_oc=AdnVKrLiPZMKdu4BgOrnNYqluebVXQWMorknxGi3L4YCF2nh_1yh-KN-SPW1GLCx6GY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz-Y_T5Zn9lSPWNLuqu2NnPytt3KokPaYTZjo9FHvL9lQ&oe=69B54402"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_
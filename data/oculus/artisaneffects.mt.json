m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=96NOHhlb_QkQ7kNvwGcziTF&_nc_oc=AdqHs7uBYeVNyPg6ZjWyXIWBXt5zdSAKNHaxUd71syZc2zCIInXOgGI1cCh84pyvPxQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcv-NGlS8Pb7e3RZr4fBxhV8pmQbAEXJaVrymJHL4hYg&oe=6A7C4B5D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9hNrfEyzYI8Q7kNvwHLA9Hz&_nc_oc=Adr7PVP1X4B4yTWzXlBBT5shZ0yvOJ-6LnxqM0QN5XEQ1O8G1kRAbynimnIkoSusrGg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHhwQnjd6HFGj9MspjO-Rwp33c0Kh7PS_-XSxWHDL5S-A&oe=6A7C70FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmKOXYDvChAQ7kNvwG0Vy21&_nc_oc=AdrrDFDbbCNAwNTdttDtiKo6ebTIdSyVWe12_L6v6lFVwU2rvQLLSRuIzm-vklCAdwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQErRaqaKkgpml4uvUTHdSU5ntrfbTO_RMmus8Pb8iRXQw&oe=6A7C767C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Y2m_RtobN8Q7kNvwFfrFLO&_nc_oc=AdqvTK_atKmTNht7GSOzlVj2RyOSuHxtbZt7LKzxoJtizgpy0lcrDTClLrH4UbPAIsE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJlcT1xqKkZsEnjWr8pK4YFJURr164Q_a_ZidKcpFZ3g&oe=6A7C7357"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OZljuk4be4gQ7kNvwG4RepT&_nc_oc=AdofdCJOqnJyVhoewEy9BN4WMQgM9iK7WfdhXlBA7x82QrrpxWxF65ntqwINENFC16s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEFg0VyqfRDgtuPfsPXgr3MXersAsORJNQVX69C6d5-EA&oe=6A7C5682"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
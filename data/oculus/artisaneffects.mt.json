505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L31WuuR7z1QQ7kNvwHS8vBz&_nc_oc=AdlCfjcKwlhhMYj5BTQckH3G-lftMP6VwgPUOwHKBjhZBxnGvvD2VS9whGrAfqC43KY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwCWPJvd2aj04G5wmfuU5lNHYrrtwV9XXrdmf-bLsIXhg&oe=69AD881D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xZDoZBBWyMUQ7kNvwEQP_ss&_nc_oc=Admrhr2705470DLGM09oyFk5kHCz9QyAjOVtgMeEW5j2Y0FCix7Xl_kh3BybsIXZlZA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyzvdnp2jLJCTgMu0Zd5HBcVVk1GHaJOf_SGmlHge7FLg&oe=69AD757E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag_KrKYdYdEQ7kNvwHzsgmZ&_nc_oc=AdmqKYQSiLrMi6PejZSiq6gzDMDyjeBVEl0TBdDHm0Be2-yliBYGo2jum5VVnLAdXJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfyEw6iEm3gwcEBUrnvwsYQLPZq6NJ-_sexTDaYUoyAynA&oe=69AD7AFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TT33-xKHqWIQ7kNvwFYj0Zc&_nc_oc=Adl-FLdXAwZcm7gEidm7TtSY4kM9kGgiUz9YEWwnVAT0GzUHfLzxShw0Hw0vKuSR7f8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfxqTW7Z8KlmO_sCABYtVkNsWrfKdDvqkD5aWUa6SmjzAA&oe=69AD77D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CH78BCW3FN4Q7kNvwHj7Mo2&_nc_oc=AdmJCcgD1SRGRYUozFoM4G5J6LH0ZgSLbIG24aSCJdlDNAgcvQQ8M1l-WVKxOCfjpvo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwFX9umX30c4BovAFwNBYNEQvmwK9iBlHcViIfEBZ_Ukw&oe=69AD5B02"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDtUijWtfEkQ7kNvwHxH1zB&_nc_oc=Adq9-kwALtz9pMNGOzCC5N-P1btszj9-ChixDBNglCVOyhkQX2vCjlbQTeM18oN3ZFk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_hBgyiwcM-N62bclGgkxRZcWg_gw27HwKhkKgPZLsRWQ&oe=6A2D699D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mVNapep37MwQ7kNvwFwB2vX&_nc_oc=AdoCv-ZjWn4p2v-23zPhzNzTy7v_qGHOTtAz0fVgCmQ3KXro3-8l7fl3nYsOWntA_Rg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8P4IahXSlIiu1PPgfDBh_LSu2bi3KaLjsBFMBa9U2Z1g&oe=6A2D56FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2fgY5XZct8Q7kNvwFfK7oN&_nc_oc=AdofRk_m8hzlxypqkG4kDrdnZHpI-XUhJiaCsHIKcoxZO0CiAGRKJjg7q5RHnHibh1I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8B4cNyAnIuFEqE4_jsDrwEYxuIJXwRZtaW6MQ13qIHWg&oe=6A2D5C7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2tq-4NBFgO0Q7kNvwEUqY48&_nc_oc=Adp1x-LU6ivpPQ66QCiQUht3MK4lM6QyWhvGK8pcOC0s-gie2kll-1etALla4AW_UU0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PlcuELPRLn6s9Qn5tD42R87St0ExGVoN58_G7cpifRg&oe=6A2D5957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DYMnRNdjWt0Q7kNvwECVEwa&_nc_oc=AdodMDvorNATMW1lTgq9GMYgy7m4WVK3rUtrYyg467EQ2-ztrcoOIF_t4F6cteUb9X8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_3K0zRjp6RqbeOzYP4FXp2SEDcJtOlJTGQzI7ikel8CQ&oe=6A2D74C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
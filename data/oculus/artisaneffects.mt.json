scdn.com/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Yv5qPUTfYT8Q7kNvwFuWy0M&_nc_oc=AdoTgg-FRmD-opXVFSv0sVPb_kr40ILNQLBsrQfx5ZfNsTFIFU8HwdQ-ICbmmjDhhDI&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af91hZPE2I99m3lfEOZd_Rv6hGYJEDaJnfpDCZL4qGrYeQ&oe=6A39471D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DZT9gK805OwQ7kNvwHoSqwp&_nc_oc=Adrxs1M6rmU1-8_V7AFum1jS9fkAddOconbRIWWOroQiIwPbDCaQT9f33zS1cZO5Hb4&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9DbCKczltCarJHYSwTD28dU6GSmLXx1-NKWaf2IgGi0g&oe=6A39347E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQKs16C3PUsQ7kNvwGsOPw5&_nc_oc=Adr2RCW-PTiSO9QhNdyN5WUb5ZFgkpIza9N_spZGKLiWRLQU_-dS06PTMJdYRYhbbB0&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93F0cIgl2KD-qRpwGI5e1lhAH28e4g6Wt_9Lt3sOxeng&oe=6A3939FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v6QkT1FZW28Q7kNvwGXpU5W&_nc_oc=AdrgWoAolEGT59cdT_W7ba7-Kp9rLNJO7KsCLJgho3oWAtWg8Msf-3sqtMCVo21yzXI&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-H6puFfJY6l6BXeUAI_hbNwyDITBsaI4Dfrs9nqnKSAw&oe=6A3936D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BFuS8KLbeawQ7kNvwFf2vG8&_nc_oc=AdqFkw_XIdws4V_o23f9uSYO1_c8sQ8wrP9t4K6oVB5VLLhqtAxtEGIgt4hzf0jSHNQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Ckssp9-qC6Q2UF8FTF5Z-gH0Mz3T7TeGbTzfkJGD5sA&oe=6A395242"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278
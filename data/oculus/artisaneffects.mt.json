m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L9_4ujDJHGAQ7kNvwFOz43Z&_nc_oc=AdrUn7Dg7MUDI6C0Mcg8d2HIa-UTTDTtlLp2CA3MUoqz8_NBa681YbS7xuXA9RBmk38&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXtkZIaWEThNuxqxGp9yea5fEBoSd54urvqpnWhOS9Tg&oe=6A71F79D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rUg7lLEI3cQ7kNvwG0AgZG&_nc_oc=Ado02Efl0SAqUfTY-hVGTP1KbL0MPezuuWqAM8qayoZqG6jMvDlO9IItwHJmqLc_-x4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzqHiYB4KoXeQGFzNwIwbHpb3EVZwooI7RJ6rcyL1Uhg&oe=6A71E4FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q5pGjTV3pRsQ7kNvwGcXsdl&_nc_oc=AdrHuvr_W8m_Hk_93bQ7kUwo5U6F7d4z1hDR0akUOGkKpBHvCmNRHEBwRbogJ32OkzQ&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpBRMWaN6tfolRmIOSI2d6k1SnIYzXFOQWS7QBz5S81w&oe=6A71EA7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk4GDw8cCnkQ7kNvwHAAYW7&_nc_oc=AdpX5h7awp8goe-cbqbkmF2D4N6yJpzGwMIWCSxEbZBS7rhzZM2thXWiROWp7F6bkU0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFk8wctwI32RGhtRknotbq0J_4HcLIn9Bj1LTZCGan_AQ&oe=6A71E757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfzeNAzNDY0Q7kNvwGcJj2s&_nc_oc=Adoy9iurH-oC_y8NhMuWJJBnxEj8Pitt86B5kgA400kl_3_3GznIU2RPr5heF0v2ceI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_ZyE1RJwd2jmJxUXoubN4nB_qIECP42fbPFAMZfR1AQ&oe=6A7202C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
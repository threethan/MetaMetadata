m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fzsKwU7IG8MQ7kNvwHOwMqA&_nc_oc=Adq3bWsuv1YJnz1QlO9EM2SDsiASldlej-uwrIH8rqXib_hbGfYt2kqp6zoqnOukEYI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ89BkA1XUJ4IT7wAWKpmUekHnvT14BWyAN5LnWyFemQ&oe=6AC6579D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BUsibl9AYzcQ7kNvwE06qFs&_nc_oc=AdquvuOAugoXyuYelVxyt1BppqmGezC9t_6dvMnlUoMsJexEuf6rMwSyQivBSolEV1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPy5shv-bjv-MlE4YCnj0EZq2iMKBV_x5gixbSxOmawBg&oe=6AC644FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B2NFCdYEnlYQ7kNvwGSd2E-&_nc_oc=AdqNRt1ptoJ2HvEJxLw9XRjSrppL9TX0ecB93ro3USppEH6Jl5NPUQGjwC6vPmj0naE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNfDlw_FpNmtlcfjYv_5x6BObwvoXffRI1XW8fEqED1cQ&oe=6AC64A7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QTfmtLQndksQ7kNvwE7YiFf&_nc_oc=AdrMX0OgekjcGN5M8RULlK9F7gz1M1caYcQcfWtTIqkhb0fn_zVViUNXPdHYCPjk7Eg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNv1_7wgd6V4pekeXQjZ1pFK5LX-ZEoSqCosOJ1FraSqQ&oe=6AC64757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CMeEMgU9fEgQ7kNvwGmx0j_&_nc_oc=AdpNrpFWglgn_X8S70WeKk1nFGLtLex_nby_51eKALQ4s2UcOYaczUSnIRxRdwMJ2x0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN2gCXa0-PlBuhghInCtX1QJ7gH1dbmeMh3n5NS7vkdLA&oe=6AC662C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
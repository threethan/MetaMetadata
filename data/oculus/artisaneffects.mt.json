m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bRb5qHXsyYQ7kNvwHqCOob&_nc_oc=Adop2b4dFc4A1MHAMzA9paxGWfoRwSEe5sqBKKocDOFg3uEEPsPAiRh9iuypsuKaw2M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_H2-uyQzVR3-dX5sFSnGLTyo7_C8Yqc7yE8QpT0B31bQ&oe=6A3FDE9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xt88TMPqQlYQ7kNvwGgdvzK&_nc_oc=AdrUPGgfI3kN7G_27YOU4RpX-HUozpvhEmmx_Cy1kfkYml2PCqcAWyQ82lpS6l-Kut4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-aS1RzmecQz88HLb1WzKFRs2RbRKbfeVw-SuEjgeRNRA&oe=6A3FCBFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EYYLgd1sCS8Q7kNvwET2qu4&_nc_oc=AdovQD0diAYhQdGNiWzaH0gmw9K2Iwe8djFTC5P1Uyte4q6nMPZXxhHyT5Mt1oyHgZw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Y3hwvIdlPkAMs-kctwFd7adPXa30dmMtGAvoS3dCW0w&oe=6A3FD17C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LJBAbp_wbkwQ7kNvwF0YF5k&_nc_oc=AdrUyyZyt_IFVmk8ndje33Z2jFDBncs1Mj9E0PM_01FEvszAge4IGqzc_U1L4yqol-s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_rqOdUle411MtGkBM4rJK1vI8gbuLxfSgO6LhBJk-fwA&oe=6A3FCE57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l4reztE_8xQQ7kNvwHtLYpS&_nc_oc=AdrtgXkAcpOy8utkNBFgxZR_qIYwlbpGAAFIlJ6wuAMF_YXsNBN7h2DikQ2Y7JhOK94&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9laqFMC8V1DUnJxGErx7r9ho2h002_ru2bOZ2AfaGF5A&oe=6A3FE9C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_DknMpuRbSUQ7kNvwFz4Sx9&_nc_oc=AdpAjwcHP3mCZMIrrvTRRtl16276BrlPFdEEyYcPrgCDceDZKyqtHROry843qFxcbZU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIwCX6imf22fd3uoRBNfQA2mYcHHLTH8cLfeGjG1sB5UA&oe=6AABF99D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IDm4pJIZMAIQ7kNvwH_XXh-&_nc_oc=AdrSQdt1sCWFisb96a7EgDEeYMMuR3HyIpaCRF9BiUevXyRu-Ftr4N8DDlufFr9JdoM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHBIPoobnqkxzce7djKiPQ8v_7CdyWUxCeGkaUJSA0ew&oe=6AABE6FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4EUEY-fIZwcQ7kNvwGLZs5C&_nc_oc=Ado5PxB1tyiDPK5C8JmuMH6XooS5-52V56OKFcogDG-HN8Zf6AM3Xgw1RuIKQhqVS-Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKtqEKBX-cCondlqjLVd4hhLRLCyFp83cgnjVOfQZMkPg&oe=6AABEC7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WdmvpmWrS8YQ7kNvwGh58ZF&_nc_oc=Adpa8OENiLerLgJm04ZFyK8KTtYfjlqFU6caluFDzbHIy0djqmG5dcBKUJqGD4W6pdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLwwL2XL0FWnxB35gbACBVBL1Fh3qdTpXblKWNNHwrIKw&oe=6AABE957"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZb6cukW15wQ7kNvwHnTuK2&_nc_oc=AdqiHzj3Xs_4sJgUw1Q1dhz40TxedJUzlYTQxvc0c5t2v5KnYRUMHX3eG9v9mwq_QdI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIfskh0aV8oAnIb8zRGrRZFO22sEF6U6P0aRJTaNgR3nw&oe=6AAC04C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
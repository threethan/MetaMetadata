m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4jXfXe_v3jYQ7kNvwFjErBp&_nc_oc=Ado1FpkXWsLadIWCx2WCdh3YF96GirHWP5aNSyvs-CLPnY5i1P6Fp1FL9Fowyi-sFIA&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0SLoqzt_Tg7XDHWz07Y-RZyIXpahCOCy5y8-3--p0wXQ&oe=69E2441D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AWnvsA9BjoYQ7kNvwFW99AY&_nc_oc=AdpvNEi7ICx-9uZ_tpKOxvzeKcy2sTrdPzCxck7r1mmFhF41jWT3jE-lhyTjcJkBuJ8&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af38gYIBp8WYouY_r1SDU8NTE9TWB37hw7mMsmXzTnd_Tw&oe=69E2317E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=btxHv0pbMxsQ7kNvwEzBzRw&_nc_oc=AdoJvQlHhJM7t4Y0vwm0-x0WpDD6OkCCSk4xs2JJjIssCReBZ2hoajmNKkCFGlpLMPQ&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1pn4hx4zFFp9i7lH_Catan2ZNykCVy3UemjTv5y2gaLQ&oe=69E236FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0_x5VOq7abYQ7kNvwFrsw00&_nc_oc=AdouVr7I8riieqhJyKoOEJ_V2_XolrKa2r8Aq0-_D2wmgtsEDmZyEM-nWdE5sj89JNI&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Hjk0ECYQ5rTeAMo6Bv7dFjMSNu-MEdd_S2ng0nwXYcg&oe=69E233D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EsXuwF3qEbgQ7kNvwFSBiKd&_nc_oc=AdpN-99BhEcKAmfMOL6xanJgg_6SCfCtt4QOz8j0jVwPGXRF0lsiRJx9qvOXROTEkOk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Eb81JytQvprsWTzHqgCMWBvvgzQ-y_Qnzfi9Vlar-ow&oe=69E24F42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAHXG63mdywQ7kNvwGqNM4s&_nc_oc=AdorMGZ2IBIIdGLIF9l3sq32l0TFh5L84QzcalTfMUXLQTtYFGdfm1Zn8mkHGaIut4Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5If0RVi3ohGp4K5LXynV92afCErh-KuUKGYFb0LQhH1Q&oe=6A0F171D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCtJfmtrbVoQ7kNvwHgKl7g&_nc_oc=Ado32NS9Ndz9vYz-yRLiVcOWCtOsDOgBYVseaTEtM0zRtVW2Ie7c81ikz9YsHXYnskk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BKn1Cih-FjGCsOkEtbXVcgH7K4g1ksazmyCxUUBKXhQ&oe=6A0F047E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coS7w7pA6fIQ7kNvwFG2N0w&_nc_oc=Adod2iT9LB5mHpHno8RIKYW9nZ2_TiEncwdGZxi_4LP45NA_y01I2Uw-DMTP_E_r1js&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ykFlPwb6dF5vFFpvS2rWYrCF6k05UAnC0zaTzLHWHhw&oe=6A0F09FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FHOIa6hDJlIQ7kNvwGIFs77&_nc_oc=AdoQV_nd2K_NHrIvR6_1X676xxZmyKzQuGkHy9gPi0NBcfpc5UQqkhN-ETUbSwEx4_4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Eld99LU-HbJTuZkR3VeMQdWlkRo1QWNHxF_oCi8Qgsw&oe=6A0F06D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmisvykfo1QQ7kNvwEfcj7q&_nc_oc=Adr66_V6zGwmOUah6RaREvLSY2EHlBoQf7tsWZKLfded5IRJ0yjPo6CxNHcsvDTIU1Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vRaqs8SIv2gtLieA9DgWQd1rWDuj2ce8jNxpc14lghg&oe=6A0F2242"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
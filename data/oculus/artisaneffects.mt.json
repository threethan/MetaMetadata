m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AQWoTzIlvL0Q7kNvwE9m2Pq&_nc_oc=AdoA81T-RrAW4TrHMrZIc2FvpXt4iSChLnKDjP7fG1bkQCuGHjqxM_M-RjrKBeMbtM0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1mus1QbvkqIvBFLaNvPsoLUEGHsBz7TBKGSEyp4H4p3g&oe=69DE4F9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RiUhdGQMiGQQ7kNvwFm5dk-&_nc_oc=AdpTP3TozIirKndOCskHsf_cFbn1KpMCdlRuyR1ZoWeC9vRNM3_Kdf1AyTSQppbN9VY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3nUk8kSC-6VOBMlf8DFwlNqbV8P67vLSNMJBzyv5n6_Q&oe=69DE3CFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wRXUeEMiMMkQ7kNvwGvwbd9&_nc_oc=AdoFy2zqrBL44M59C4Fvbmmf6TNTWPUVzNL9nmCSYZ_DzKRu3bO8RRoY4q7Uiunm10Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oamN8GIEIqFAwyTJERWjsyOJdKwUmrTJ_wdLBSc7Xgw&oe=69DE427C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-q4Cp3xTcEUQ7kNvwFgZpIs&_nc_oc=AdoBsA3z3qdeibb6RL-ncU0jryRyZ-KMy-tw6ufaz7OmRYjhquQ1ErT4F7kdzAoCyvw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Fopf0mOH_mGuKf6CtXFoIawPvF3XGmv-N8ank5ng3zQ&oe=69DE3F57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6F_N4i6vze4Q7kNvwEvkbrD&_nc_oc=AdpIc0sb9ggFCNKaAgxIBVSZnNcwAu-vdX4--A4A7NmpdfO2pJesneEHSoBpeE8Z3XY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pfjOlZn5dVb_7Yd8cGmzevAJRiUX-gxl71Eso3Uia1A&oe=69DE2282"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EhYnWboQoRgQ7kNvwFR3jw8&_nc_oc=Adqe7V-1Ft5BGsxjVNgfcAX0Zubz-IyjR0smUF-iBWqMB6ZtlMUrnOWeIwtj0759vPg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEyHNm-jW-0jR2tad8Avc4a7qRwcLIECokqyCbmHfkKug&oe=6A7F269D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RSuXOah3a0MQ7kNvwGwb-OM&_nc_oc=AdqG4jOzmE6dSL4kgK7UKp_FlTT7NVpaCq7LRi4GF8Yghu8Rq1mdt-OKj8ePl4JzFl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHJc1wgh01VK6D5IGYim5OauRkkAaGc3MxENUEYgkXLYw&oe=6A7F13FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MyDOo3MruOgQ7kNvwGtOQ15&_nc_oc=Adp6yChRaXeOefVGb4Z0W2qXTbQVuMtxnvMpaSVcrB59rmztS4Y5YNFscsmv9uxJHM4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZXGixbqIsYSI7EScWY9sQ26JjPbuc963uLoLoT-iunw&oe=6A7F197C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xATg4qX3LREQ7kNvwHYdslZ&_nc_oc=AdrkrMnwUU6g6OGlT8wMznqUQ3cPYbbHbaXIYFavRQmlBnWjQCaXNbAtkL3SvJlCigY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEORhfQET09qSasL4DzClPddltlPRZ-evMI1-VH3kNf-A&oe=6A7F1657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TVgqTkw3kaAQ7kNvwE4Dxrm&_nc_oc=AdpHYzjYtUCPfXramTe_muyPe7UHuK4nVbJdg-6EX54GoPAwWQ8GYYOnCVHuohHd4so&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFt_RoUSWYfqTFZi_oB5IkuRdtZhH2wl4dZexNKtAJZQg&oe=6A7EF982"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
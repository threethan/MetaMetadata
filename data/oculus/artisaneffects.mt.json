m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FFY0SN3wyWYQ7kNvwE6xDO9&_nc_oc=AdoTxQ3q5Cr1J5XEcCSoZhxXsLhmefWGklbG5Fp3ddVa7NsOlV51tUwHmy9wlAqtkFc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1qWx-3aBIeYgFy9kThVq01e5bjKjDrtQwo9jzsixUm6w&oe=69F3679D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9Azh4tNLsoQ7kNvwFh_ZF1&_nc_oc=AdpOnTeqnUnc3EetJQLd2DTwFgeHumWzjI0mrXWojrGAVFa_atLMKrwuTqh0NpEKGuA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3p3-POF0tDadFVI8Lo3dPeO2RikknB0WODQtjg1pS11Q&oe=69F354FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3obsDbnoiJgQ7kNvwHr5BAY&_nc_oc=AdpI2lV_uSfinIog0lv8rTpTOu2QRHoHBEOKJuyOZ9R3j9lABPOrbhiqSJjGlF68xtI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0e2Rt8zpvEiv9-gYw5B2LuBZHli322kyZEzanBDTooCg&oe=69F35A7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3EI_-11-swIQ7kNvwFTtXcS&_nc_oc=AdqvpKXDCXl1FgbohvfYcaref_QhXno_n_sNpsL-fXMsRYaxcNy3T3T22MjPvI_GduA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2RUpdvLMOcrtlDPj1ZlQY9CVtCbjcmxupkNVYef_DBAw&oe=69F35757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LviQ39BfJnAQ7kNvwGDmaHL&_nc_oc=AdoVTrMizII1jS7XsH21xQvSIOsljsHrcdR0vAvZe9rKp75BCtmJY6dRgGVImwpjLc4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2y3aqB2gFId-wuCPBumQrmzXC7L_PinxGVb25Ns9flyw&oe=69F372C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
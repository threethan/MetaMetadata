m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-B7UpVGF5bAQ7kNvwEAyosn&_nc_oc=Ado-G2Kk-Yo_W1Kk9UNXbRctxEQjJO6dr4nFQX3QxN6YecUDHO7uk_cMIEBm8u2vYQU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7UcJlgiXstg0yNusXbVBT59XE7Tkfxwj-5rPqPdS9Ww&oe=6A8ACBDD"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rQAdynFYLJkQ7kNvwF3XSjo&_nc_oc=Adqt2PlFv07U-QM7KDOAYb8TAnhEQ7a0SkQOVZYwWyn_5PgHfK0oh5p9Ssvi_qdmIag&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGB609uN1wuVdPThJ_uM-EdWUkLmrhXOSnt1O0LRyR_UQ&oe=6A8AF17E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aqq7B2wZm30Q7kNvwH8kmue&_nc_oc=AdomSEulG0S2iIpWlzP9tdoKpNrRzBksA7wa_dQXhStJhhsUfPdS_OfhaTtmblIR7mk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX_P1NhJVuMsP-Zv74q2panRbfJS2Vcgj5ym5xpnp-PQ&oe=6A8ABEBC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b8aCc3lgy74Q7kNvwFQeo47&_nc_oc=Adrcd4BYV9qSeIud_29xUeDSgOGsx_10PYk4-zwXuGmtu6LDpF8TSCucyY5bgWx_Dh4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHA-NienWv06vFhHA0THKap6WInbJfMOR6o0YiCtXHy1Q&oe=6A8AF3D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QeKzdRhsn30Q7kNvwFpWikO&_nc_oc=Adoz_4QfeNcENCC4fRZ3ERYHIsDR4qbLmNV5sZtpunCpz1Df86kQG4XfqTm8bXOU_qs&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGr60PTRHE4Fo7Dg51fadWZQLfioa9QZ-lssV2LSOs24w&oe=6A8AD702"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
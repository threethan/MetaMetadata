m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rwwBInl5zQkQ7kNvwESZenB&_nc_oc=AdpPzDpezoQZS15KX-ZQN6KGV5GUUTywsoyVrA2_kYilmm7M5mwY_XJRv9d_BFZ5c8A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz-WFnWRZP4qvKketdD6OytRfqqQ6fEII-xIFICavcf7w&oe=69C7E61D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hRQG60MSqaEQ7kNvwHegw7B&_nc_oc=Adp1FzmaAFGLNk9NeW02GIDcVzoYSfDBI5b0bQGfCUVvmKHwRmvk-pf7JsZK7UrDM9I&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxQq813BKo607fQRX3u_-arQxdABTr9X9hQCr0RsCiwZQ&oe=69C7D37E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5SFKvZj1emYQ7kNvwG9Jhyh&_nc_oc=AdoAmo99u3LUOthZuDTpRceOoIABJmJ1UeGaLKkYSS7mq5k9P-ZdPdvE_LC8jKSIvaQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzikUxS5raEyviAnGNxTJ9YFzgDVs5o0bQ0jfoBKY3e-Q&oe=69C7D8FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tyi-xPwssSQQ7kNvwGoR7hH&_nc_oc=Ado5ArmMhp7Swhbf8B-zeL4N-1SZ1Lf5QZUbveuyZmLpmVOjqRHfpQKuoLqqRvfcVtQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfySRaxp9twPVGgRcwW-1-R5O9CPC5Swt4kNMxAk40sMAg&oe=69C7D5D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhIM19p4gvMQ7kNvwHj8XM9&_nc_oc=AdpyDlAWgo6YS-orV40KhSB35uJ_Km2UjcjxUmCTx-_AyLNpw9PoWoko6YXz0eZl5Z8&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwyLXR3sy-hN_IkAC4NRfQyXPyX2mEv3YMZ5v_iZjJu1A&oe=69C7B902"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3iEOa_31ZK0Q7kNvwEtpRuV&_nc_oc=Adp92VgEDeXwiJU0XS6-ohWBsYvOonYE39nR2PYG9T9NwJI1rMg4n4wONEIgRCokNso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFj3FOVWQKLBNCiFAyaaLJYpy0Rssh-FnGj8yRrrlYGyA&oe=6A73491D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8rUg7lLEI3cQ7kNvwEpSZ-_&_nc_oc=AdorBRtT-IF-QjZNHo_zCXnn9LqV0PwlitXDlbFrZQawKtH999AEJ7OKn-ONQ4_FDOg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHdJaMv6nqPGdbOfzeE5r61LYaPcfKu3wvnCs-PoltT_w&oe=6A73367E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7bGqAnK5lMQ7kNvwGgw5R5&_nc_oc=AdpF1YUNm1vMqa_ZIkg13NQp0FqLxw9X_JK96ysP2xHbTBsMV-BvuVCFYcVL5GfUtY8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6BdzZnlBvTvK6CCR465uGNix87JVQHGXFZlGFkYz2Ig&oe=6A733BFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rk4GDw8cCnkQ7kNvwHSI71W&_nc_oc=AdoWK_7iP7cWLOXlwu62WKRQoPFIL6bbdhViXo1_l5MlXhqJAGm4KIM1tObZwf6Pebo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7is5iG49TwrOVezl12rwolPqTQV2hpAzdhk5UC4z2VA&oe=6A7338D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VfzeNAzNDY0Q7kNvwGidckw&_nc_oc=AdpgyR1tMf1YEelK06l7UYmKX_ha-gmvvda-5IRSt-llATiE5NEZRw0FqVADSrA-Xic&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEDwnYhnibjYyD87vqDCZlm8bdUFwJJ7Gjc4n5C635onA&oe=6A735442"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
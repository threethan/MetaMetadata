m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEU53BlC5RMQ7kNvwFtvOEo&_nc_oc=AdqGS1nZ9OeNwdiJUe3DhwFxpbhlKshPRj21CN-z3R_cytgbYPfCgdDU2U7hd31sa6A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af97KDfbbkb4_s-ggbnsMPEBi_JQrnklzoUVqYDkvN3Tvg&oe=6A26D21D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFOkpEiYH10Q7kNvwHNS27b&_nc_oc=AdrFK5u9MPyoe2CuDGOUI8PZfaQeIx9EPXhHcfxt0P-T8Rpg042fGi2kGHUUxScSlAQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zr6zpou8m7hARaUA6PljKAXtelB49vY5Go2SK75_ekQ&oe=6A26BF7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5HTsRP6QCU4Q7kNvwGhCNRJ&_nc_oc=AdrQ-VN6TBPVLMCMMGKJRM8OI5yNEGh0DlT9mnoWWNwSUNiMVrCRP5GRdkmFQmUBpyk&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9WiGYy33Td0OZHIKKOOwUwgraZNJFeBlofD5bc1dW9Bw&oe=6A26C4FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LQyWEsMfuy0Q7kNvwGqXUap&_nc_oc=Adr3CCkvYMxgRnAIVOBx1Z9OenK38KzlnTG4Z62KGoqQA7F-EdImiK0KmxvWAlojxKM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8dqjN-fGATdT84RSAcjfT1VC3HHm2UK-EZHOFxq4nHqA&oe=6A26C1D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8MT7U7iqb5MQ7kNvwGCQBPD&_nc_oc=AdrrgeokFkIzliIeNHYBTFRVxrH48jkiDZrN4bR171eOdAA0YzLG5V_L2nUqxpIZG5s&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af93uXq5nLfx6FnhyyHTK3Ji9zw3Hwv_jXlln2icfW4gAg&oe=6A26DD42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
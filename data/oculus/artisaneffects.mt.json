m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umZU05tQ6IcQ7kNvwEDcR1T&_nc_oc=Ado5TGcqyGJGVDbGZXRX5r3yjXy5ud0kzUZG7JU_W00GTOc0LND1OJI0q1Oiy7F2j_g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af704QJs4nuDz_nvd3LzM2rYpxgF1HJvxjXSisUnY8Q_-g&oe=6A1D979D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-F_yxzDdDYAQ7kNvwGThViq&_nc_oc=Ado5zF_21bz2Cp3mJmTlGSHFs7fJITCW6tZCUQ-jdD7gJU9xIlrtdPvs_rF5YrOektE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nEm0qCkH5FeWlsQmpc0Qboay0PWxPKTt4HaGMEs8UqA&oe=6A1D84FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X0aRC_4oL74Q7kNvwGXS-ln&_nc_oc=Adp6Q71f8S_g1alsFJHtTMC_8XrNywu5WfY8ce6HFRuP9s5uPo5RPeVqsBA4e6ZPmOs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7MEL4g38uqKTZ-8Y5rrcE72jPt8vp-UPWwnsKVLgYoYA&oe=6A1D8A7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7WTgtKp1GUwQ7kNvwG-DPxJ&_nc_oc=AdonExYY8SLfGOju0myAHd9bqS4p2ieP9cozp6RXcUO_XeFWRSq97u41hKa7JRyImSs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af64SxWU1pVRi56xK3lfZBHjPQMhrKC9frlUV8hS7h7gWg&oe=6A1D8757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fGb_Wz3noyEQ7kNvwFMvUms&_nc_oc=AdqgDYsUdChU1cnV-WHHus1ku7leodS_8KHQ04q5ipMWMAYqeGknI9AcjQxHbQnZM9A&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cmrjM5gPOhscKTqjQXN1WLrwmUD6zWYsIOTM3KkA86g&oe=6A1DA2C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
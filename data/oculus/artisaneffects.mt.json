m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dtn_bx1j8YMQ7kNvwHiNSrj&_nc_oc=Adq7QXIZ0k-30qLgreUQgLVVfz9OLIJ5mLNvM6garkiLICjrB5cdAMrp5zVZSXcAXuI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7-xukkkVNVr5aJPRlwEziaf1hrGderDbNRkocxq285A&oe=6A86D75D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HxDW1Hr8GQkQ7kNvwErgtie&_nc_oc=AdrKiGJ8WxaLKgpWmrJCA3qv-nhgqqMqp9x9ENuLBNSkS7jKaa2a9uCU1l5ASHzy2AA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGXs2GteTk5HgSZroG7KVejYdpbQFuDgCAIILo57JqRJg&oe=6A86FCFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2cVWarpqXHcQ7kNvwEF43lN&_nc_oc=AdqZQV-oNgPj7To-KQFoQWFRO_GNsrjLvNVPqpnzld3hZH7HNbj0z1qzgaNGhMBNG_k&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3Hbk6KBUfrjKwHty_s7t-OJ-E9-foLJnHsj7dyP8tqg&oe=6A87027C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=51SwI6R-dlIQ7kNvwE7OScY&_nc_oc=AdpUND3kPNAWHEwFWFOgJ_FmzTNo3BMT-730F_9YNMynrhTitIXgS7HG3rDwnac60YI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH96bzgI3qGJx5_nvZ1fXOycjXZXqELJLnVHH1US__4xw&oe=6A86FF57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnvTbv_RTGYQ7kNvwE5DBGU&_nc_oc=AdoMnmHw_2eNyFhdNM-qHcK_YIgD_EPaC_IlbMKTjPpnp290L4LP2wS65psBpQqHcTI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHk4in7d_EhKrOrKQjF_kuVLnYkuIR9GUXij_J5_bUx4g&oe=6A86E282"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
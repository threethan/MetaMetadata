scdn.com/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnWySvrvKpYQ7kNvwF8vxDf&_nc_oc=AdqqLtS5PredREpftGZru3BsTVRwTFukuuktvzMlvIi1wJT5T_l-mo17GsY6XetuOHU&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_P4FyYRpchVxprG2VzUAGIwk0YG5BXgus7o12YzLiBcA&oe=6A46761D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sin2-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tiqahz5OjVwQ7kNvwEW_eC9&_nc_oc=Adq2L5d4LyhLdAYqh7QLTVGCLaXFh-K-dudV69ogcNRaRuE6ML9ymDOL49AieQoGcX8&_nc_zt=3&_nc_ht=scontent-sin2-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_2dZ4oMCVQeYO4E0oqddxyu9X19uugyF4nY3CWqt3DPA&oe=6A46637E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-jSSNbOCo3EQ7kNvwGUJJ2P&_nc_oc=AdrJNKuKUD3XYlCxcG0EjJVZSgZaz6w58T8SxAU5jpRx-mfpf65yTWNMhbWSLO3eIoI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HuC5lqnCcomexGxHmDtksgP_4Am3EU3368q4NslLngw&oe=6A4668FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbMfzBg4eVgQ7kNvwF4kewp&_nc_oc=AdrJKiMpdHumH8GNHbkv5yhgoCNtRqwH2KvQB3M4eYg3eK8krBgr-xs9ceoqf7rx4A4&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_OLiFIozOK2BwRsXXJ_MZm24QLVbom6rK7SabuLF4NfQ&oe=6A4665D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5M8NhuB29IQ7kNvwFGuDjV&_nc_oc=AdrpVwb4b4vhjATgO6X2KvQwZQBt4XgOYCnCBfqkVIOVGO7b6yIRetwRyKZKSriSLJg&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af80UmcwMtH_Fpuhmh79UbGuJl17_Xi2vZAoyMb9x2ZHWg&oe=6A468142"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278
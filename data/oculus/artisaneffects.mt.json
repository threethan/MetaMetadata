m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZKsj9r0EPwsQ7kNvwHoCOsx&_nc_oc=Adop4HRIT9r0j1G-G1td3Z7D5PlGB4tl0x8MoXNqgKGcOjzm3MORHfJewiu81KEzmxw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgNjUhkztxW8mIQxEZcjfEx6yHsPwG3qwNGMfUQHYXAQ&oe=6AEC931D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FRBQWkWIJn4Q7kNvwGz5ZDI&_nc_oc=AdpTvnLAME5n95gKvMk5nMIdmoKuEqQBsKpidIaripcfc-aidGWL8W8HQJBh3uvekXQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQM_QmdhDJalvmtwnF_PPVh9Ny6fVrnOysMLN-GmmXwpA&oe=6AECB8BE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ydauOctVp84Q7kNvwH1wDox&_nc_oc=Adq_jSb5oAN9-PyJmbs_NfZ-SQDIZaOXyjw0Eemy31o7zZG8GexvGkbePw4kVlRnGbs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTN_Lr1ehqvagZmM_Pv2LHel2IEseWRg9KvKjJ-gWfpBQ&oe=6AEC85FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoH6FOv8KIEQ7kNvwHqd5Ac&_nc_oc=AdqHSRkiG_-9PDP8_6Yc0dm0OP1HmP6Pokj0tQSNMEo4Gz6Hq2i1np6nwFD-dme4pYo&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8XbsY90H__xrWV1fY632NmlDxQhA5DbaKa-_DR6pzrg&oe=6AECBB17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF-oD5Zmlj0Q7kNvwF2xkoH&_nc_oc=AdoBoZUigc7DFOiTQzKQNymOu4j7BX01MS8SkxVdfEoQPvyjZtZhRxnfLJcEXON1x5Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRcVXKh7DgaPNRElpMwd_5d2VoZw9iYX44pWAHCUIfelQ&oe=6AEC9E42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fuGrXK0ButoQ7kNvwFGYWlx&_nc_oc=AdocQzfIAdkDcCfAUTg-iubIy1aawW378ZcSJjnzqgbSRLFVy8Fj03AQKeannYbuDhM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS7rEUQrwtfKdBHwIKp96eZP1L1IsgvQSw_hPPf3Ru4fA&oe=6AF1D91D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbfXY7TNFDAQ7kNvwHeaw_1&_nc_oc=AdpJYM5ZwQIC3Rkc7NQLZ3f8_ep9B7dqcQomUCQh32QYXO8os8H3zo0p--kuUtDi6tM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkPdake-EdFI3TugH1zrmh-8MfeENzUlStR4TLfUL5ew&oe=6AF1FEBE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIIgMlG2VqgQ7kNvwHc3tAk&_nc_oc=AdpX3WU3nsT0D2DgJ09FJFtm3vtV2rfWvjdJY2kW7NZx7dA0uY3vPuuZR22TcWX_4rE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSmybNTobV-XYeZmZ1wznLCgasbZBgyaFxWhauZE3207g&oe=6AF2043C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VTLhd2lrTRIQ7kNvwG5EI39&_nc_oc=AdpPmk4JZkql2NrisIeleVK-5zLRQqTGYnbZAYZNmASBZR-f7cKNjMk6Qinduy3iaWg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRos8sjQYtmKiHxjwad_HJd3bJ4sy3ycbELbbvDA9_LBw&oe=6AF20117"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTBKTKa0TW8Q7kNvwHO5nNE&_nc_oc=AdqITvSlXYFk4_ByBfSSB6LCTMRfLR6USSEHpS9CS6aj1rlF-vASLA1URaXVUm5OCMs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR7fSPQOzAThVR3tFp8LJb97hZ05m8BWgQlwvt4G_O4eQ&oe=6AF1E442"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
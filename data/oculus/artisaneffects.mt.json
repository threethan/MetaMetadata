m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4VEtwBA6SXwQ7kNvwFCywfV&_nc_oc=Adp3MPyo_DnLfoDuGOGfqOAjemH01VnLqxri4nlMTisrQRmg68lRoa6MlggAH4iWhT0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzpb-W5cGlJTkN2VWzvVPX-FRWRGijWQQg3BQ8g2eKSg&oe=6A68BD1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wq0MnYp4NYUQ7kNvwFjYXlI&_nc_oc=AdpwxXa30JwuiEgB_L5y1QpoP0v_TfIOmJh3qZlZDNzHPju1M042_PEUJPk0paqU8kk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCtrsmoG7Q9iJN3dOvfpYoElPH4AB8Uw7LI1NKF-yVlcQ&oe=6A68AA7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cje5AWMg84wQ7kNvwEyRnNv&_nc_oc=Adq83D7yP_cpfWxoFb9VtSP_-Ys8ejLRjEIgpBCNcRYtDiaitniXRqLkn9Sivi0HQV8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAJSmlMbNtoZaYIcM191w3WdhepyRCRuIxMsBFBEJiG9Q&oe=6A68AFFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XRuSrNccQHcQ7kNvwG8N4gq&_nc_oc=Adqz98AQ9QXoa2aTivj-VKoG38MMSoBQXQfp-KbY5xINE3SGwsV6OOyFiLk5a2j8p9Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALE9JFZP_yf-AES7-MbonyvxZdP4OSXEMv0djFLS2o-Q&oe=6A68ACD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lR0ADO3pe4gQ7kNvwHjnIII&_nc_oc=Ado5s2cfvMqu4f3x4FRF4ULyz5WrHYiV4wxUH-f6eXyKw4bX0yshv3wFWLwjYAjpFQw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBpMM8cfadZeIbXC-JD0g9eLuT083UlLc7pDAoSol7Hgg&oe=6A689002"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
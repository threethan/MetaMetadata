m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_jBJvFvon0wQ7kNvwHBbocK&_nc_oc=AdrXnIAesw_Pi5YCqeHYkoie4fIyXhanCk2yDjujh3EH_xwP4H-hSyjjctlir9Ra3u8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC-Fz-TGjvJgHFThl0b2uWpNPG-HIyyhyoNkOxvqdjMNQ&oe=6A6E031D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ptP05zVqnn0Q7kNvwF4V-GY&_nc_oc=AdpGeoEoQUzp5POog6PVw99B9IkLlksJ-a-7Z36iummvMFKeDbWN_C5fn99gOGwC_jM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAhgtQSFkdJjJOJF_PQJru051kBxBAoptlUOTwQB6LklA&oe=6A6DF07E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0GuIFP8LOfYQ7kNvwEvHEAw&_nc_oc=AdrWDhGF98f5GUQhGcBhUcbX8ks6dinhbu3pJcJ6n7LNWsIB0zyNEZNn3BOw4laQEt0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBPH2_Ko4x0iDa6PRq54sZ5evu7zzjXaJTsRVuRSE2LLw&oe=6A6DF5FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y1zFxg46QyQQ7kNvwGGTCpI&_nc_oc=AdomURWt0wa05qwMqBoZciHNLPp1sGgzpaQmCHodqVEV2nQnvCVboYwbqRvKrcR9lwA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBCmn739YQcAl8Ld1WO9_pXs70xpzwzBpGEGmmuDkfW3Q&oe=6A6DF2D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LmvlzJBBhnsQ7kNvwEpxKrx&_nc_oc=AdpkJvEiiXF3TZH0z54or5pSDpyEIEmTarPOzkzvhF4O6XIom_lkPNFdqDRmQwJWWJs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQATay1VQegIfo2VUNX-Bgk9opBayVhCxAq9ez4nEcJEew&oe=6A6DD602"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
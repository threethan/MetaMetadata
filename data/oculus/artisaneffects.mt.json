m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u-5m-Wr5H6AQ7kNvwFTngHi&_nc_oc=AdqfyF3TVX_9IDld5sNmMronyYZXjG_vnJojOi8rWcMX8z4yzmFcP1bvpQhMdvREn4Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLOxxsUG0kulKb6QVGd_FAg46633AMlMTm_tLTP8QuSA&oe=6AE74D1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qnBiAlVNKq4Q7kNvwFox3To&_nc_oc=AdqMvB_KaSlS2ggJWRJuZjdwcRTaFOwjebPJK7md5AT-gjb1j__15nhFf11d5k7uSwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ1MZ9JLh4gwyGnKNa8nBJVm6H-JfwgcsdemfXByfqOxA&oe=6AE73A7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvVLsrFnLgMQ7kNvwFaTiL5&_nc_oc=AdqlT8CCzr31J76SJFVegkiC3axi8FzfkNZwKRR7Hb4_EPihdozLYC_6bOEy4Y85CZA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQAqEZY_C7T0U_JvStvvuOWD89aOnOTi5N7y22wLjx8Qg&oe=6AE73FFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6ShYtrYMmvYQ7kNvwG4WtVE&_nc_oc=AdqQajskWNghVbVea7I4eladrdomE00nh-lvHqgjlcmlrJTB6RfGfS6UHUxDuD4IB_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRACIxr0yOlvm4vWlrfy1NU96ToKTvl5Ni63wzja7QX5w&oe=6AE73CD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-qr_B8sWysUQ7kNvwHL2vzo&_nc_oc=AdqGx5kp80XOSJSXfjBoolaV2yv5wDubk0UIaqARNjI4-zgs7eFxwolcdmyL8Fee3S0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-_BRbvlkfCR9-xvr5k7XPV4Jp1qkLmv8Z2AQRHQxjQQ&oe=6AE75842"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qq2A1jiL7I0Q7kNvwEFIcjA&_nc_oc=AdpN0B3BLk-XOUwUB98rsjlofcqpWWOk5NIaNbY0bsyGQS3OYONTCEFv3mlr7ipL1_w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_nmtPykOH9ZvLozllsqfxWkzT2NoGJ1HZ7ABpvmTQbIw&oe=6A47C79D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tiqahz5OjVwQ7kNvwHoH7wj&_nc_oc=Adr1A8coMTHPb-zy5d5lIBAflEjysOPrHY6GX2Im585rwO_zIGpGgzvKs2MgAJPaBtQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_GuVenH9y8Eoy67xsaEB9lG5FWCoR3k-XVJ-YbUGcHdA&oe=6A47B4FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_-nFoNMpAUQ7kNvwGhkSpJ&_nc_oc=AdpQ6maVa6qjQmWuFq339Tgv5OfH5672GEsv_HRj0mWYtKNU49s6Um_JSXs3_aHs7HI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87q0Y0fPTOT5vTPdZ9OOw9iJGW8HrvJgZfNebx3n3Cow&oe=6A47BA7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hbMfzBg4eVgQ7kNvwEnopvs&_nc_oc=Adq1KWj6_3I2NNzoXKpt5QSvoFQulC6_Fv3zNe39CuHLyxF7NAxDaX-s4N_yQ5lrBcc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_POEqR1MwBvRaM6m9ODdfK42ScbSLsrPT8dCrgzd4-BA&oe=6A47B757"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j5M8NhuB29IQ7kNvwHzzfXh&_nc_oc=Adpu9qC3tBCIfeg5KVJdlEwx5rFSxxhihy_LJFaD7ZdNRXXbzgh7Mhh5n6B6Hhh3ERw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yg-Xp0foT04XxCI8e2PFAiC2YGsjXr9pUy-0FSkTm9Q&oe=6A47D2C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_QxkJFpTFBAQ7kNvwH6xq4l&_nc_oc=Adpx6qhLpIL58-7eycVEmvZ99FP62vaawzmVFjy1aY0wDD4VuHsO6Pdl-T-whVoVh8E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDHEkRi19HCMDFMz0g3mkWCLquVfqKMOk0woR6M4d-2Tw&oe=6A54F69D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CQDOf4Jv2XQQ7kNvwHubeYK&_nc_oc=Adr-ztjvexT2jNBzFhk6Nx5_bCcNA5WVbtglYA3ogxgyirBp9yzUufTUns1di1YVJXM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQADA7OXk82oA-ty_qCoLYYLByJknx3qYEyQNsT51CZOAQ&oe=6A54E3FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AVPXCigq_5kQ7kNvwG3VGRL&_nc_oc=Adqk3slaSENIGoFQXepzEw5PpYA8Gty6QzY2Kz86qi1Gx8L0NU6sj8jDshyN1G9DTDk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuszAa8ao-8LUaJpa7yy4bzA6fFTQodLGM5QwIc4UQwQ&oe=6A54E97C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QjoTpMo-Li0Q7kNvwFngpdA&_nc_oc=AdqQkg14L6oJuAgzwrGxPW7H1e-Re48z67I-NCJ1cQBI88l2RX44_ldqJYQ6A5SN1Z4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDqrMT8ZbIC2Pes0QEMbh7c_pSjM4Q0Mjvnglfj2V8Mw&oe=6A54E657"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ob0RrTNaXOoQ7kNvwH3b9u7&_nc_oc=Adp9vtegaZfXQZX8PLERcDQAQyPckSULa0RMglej7WFbzb_SZLNvTBy2ON5J9qQTjYU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDghFLFPWPYcry8_UiHdIUFfOGkFbQtSqcSIWXRbk8tIA&oe=6A5501C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
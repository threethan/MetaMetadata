m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2rI9GkJxcYEQ7kNvwHUpd_Z&_nc_oc=AdoyZxFBxIyz7zf9TgEpte-U3gX7sbshy5Y4B0nSk7ixrCkQWJTVR7F1CpQMb57RFtU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uYwpafcv2k_g4SRg3Tv1SLEidDKKieiTLBgv3jF8mNQ&oe=6A218C1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YO7dHLVDf_UQ7kNvwHjuTVX&_nc_oc=AdoD7xIsEK0cemkxOTQQZ7pjScvu6GyGvFo_Yp9dXTrEJijVm7-uyBabXaWjTtyqt_o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XrB6B0jdpnnJDqOwhhNzEsdzhYcRf4BmO-kUTwg4wxw&oe=6A21797E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P6m4bz8k2mEQ7kNvwHLfpY4&_nc_oc=AdpmY1cGGDGJW1ncb5angDpjYmz3-GNOr32JNOFUpI3Dgp9ZzihreVeOk-9Sq_3QePo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Y3Ca--UE_9RxjExqZdUqxV_SVmFINQHoWT0edZwRA3Q&oe=6A217EFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpp0Weuue7QQ7kNvwHgnyVb&_nc_oc=Adr2hqldztYmlwDp3Z1SYtE5846JG7q38Tx5egT0VIvNIswTqf4gBDy3D6TYvdd3uOU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8j3jmDkYl--Y3K6xuahTZ6GnctRl6EY3e_Kcr69TS-bQ&oe=6A217BD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tz57z5J7cU8Q7kNvwE4OpBr&_nc_oc=Adql5pQfLj55qq9_u-RB-fyq5GgKoZw40eBcNhOQLFUFPSEb2SphQ6zmqBkrUjT9hbI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Lfje17PR7_a6huKDTGSOzcY_Ae6YcChJthX3XEk6v7A&oe=6A219742"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
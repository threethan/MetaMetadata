m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UHVwt-4wiwQ7kNvwHGKu9p&_nc_oc=AdppJEUBgiTdq1GOdcTnV0ho0ozVJ0rT1jge6FQL0E73EbLy6ll-JDmMhUpWhIpnonA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7zky50j3woG1oWmF8-EVAMecAH9B32LJ7-9Jkv8SJroQ&oe=6A0B229D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4huuXEvN0cQ7kNvwENA1kW&_nc_oc=AdpAO7Yy9StQvEPIooGFYzvEHVzL68H-ytRI0-tqRtrTwmJc-orFB-eCJVR52znav9I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-G3vIf8usmqOr_ls8cXHJDxPZp-4jv8cP6SqRpXP9RQ&oe=6A0B0FFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPmwvQEbTz4Q7kNvwHlRSly&_nc_oc=AdpOvOwTiFGD-Nk7sXsPTzKZR_zwO3J5grXl1KCplcCcS2Gmz5CMBFRqQ-yb75KoZlM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4g1F_bQzp-CbForI-M2TEYI9fvY-xpD5eFof0UPPG0IA&oe=6A0B157C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKG_sPiegysQ7kNvwFJ0XHE&_nc_oc=AdqFWjWLxpxwVf2Um6H6OsePFAUyy5_49Hsd_jxnSEtYqJ-fG0jqRqGipsnh31B706k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WSRH7QP2pLpKhY0TD9g0c1LDJZRFbGjijbLtVQ_9rIQ&oe=6A0B1257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nIIwKKMjxkQ7kNvwFWnaZu&_nc_oc=AdocUaMvwlkcyjJNZY03qbBepMiePMypxre_JmdmgBUCRrA7lEPxgDop2uBK8iUfdtI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xG-2vMnzWWERDxkS_4j8_j2tkhdOnfURC0pFmJ2YvRQ&oe=6A0B2DC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
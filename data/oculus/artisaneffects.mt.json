m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qNJWEnamEDwQ7kNvwGSWJ6f&_nc_oc=AdrSOXqz9S3eGUEXmd9kIWG3vBghgBB0AP5wzmEw8DQ9aPbxYpRBNO-lWjzgcXYl4DY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQST5fuO7P-Gb3DDwuOlf_ONWVyLGfYecr9deu6kMDRCxg&oe=6AF9C21D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xUH8uRnOEK0Q7kNvwFThgFj&_nc_oc=AdqLtyUzCwOzRhxtNZgN9LtzkpArLlsI3nXWu0LPElpg9H4-n-XpoF4WNLLrBykpeE0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUhoSHuAmDVjtG_xHNhH2ZkOClSdBsfsIIDp3j8RVXuA&oe=6AF9E7BE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBbvGfzm2CMQ7kNvwFXpU_w&_nc_oc=AdqOxrlYfl5qqkfikCgHzWD_mmsncrBjkK18gqJ5SVAmcsH0faYusDpvVO6Z54PWyFE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdNEtFsHDW9hCkBKWn60Ihh8DQo9yGL_vdW7hgQMcEMA&oe=6AF9B4FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOFClS3f0vIQ7kNvwEiLXaE&_nc_oc=AdryV_W1q8bfrbUiOFAqh8Ge2RbSNq6NwKh_KV5lRWp-9dR6TIyKQ6Q26eMKb5Xbt_E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSkECzlR9Pieo9nCbo82qsS_cJNdkdjBq7BY9I2QPEBHw&oe=6AF9EA17"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mnF7aEwNTEQ7kNvwFSx1QI&_nc_oc=AdrKmbcXitaZ5Qkg6BIqlLXA5BcgrcY0BEDxw2Py3F5XCPGvtW20dcXc5t5ZxyGyyM8&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgkTiimr7Pd6nh_WEQJ1rM9YoY1KM8UOU2euWbzYBIsQ&oe=6AF9CD42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
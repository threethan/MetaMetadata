m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1J5KNfy8dNQQ7kNvwEFraup&_nc_oc=AdqocoT1T6PGe5ygZR5dpX3Vbq9dCuIt1nZWEg_Pfg-TsT9Ud7RGAQvZlb47jNqsNVM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP95fuIH4R3b5jHfh9Uqg_5eUf70AzaTsFEZv0dkp6SCg&oe=6ADF641D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IASMrYWRXcwQ7kNvwFqXuAZ&_nc_oc=AdrdifxHcbmwMfaOFta8zOK5WTQMcXFXEqpoDLKB_eoWiIo33qqYNag94iOnl2FfRxc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNeIwTlsrKA561p1aHPMGOL8zAll1zUfarRLj12tPGOJA&oe=6ADF517E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w8exqZcMwBMQ7kNvwH0hJvt&_nc_oc=AdqHODIL_mVrjOIXzDCWTnwjK7XkUkqJsDDf_rEpS_JktxJXeKRcPJ-b5aT8JGed_EY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNL5oyitN3ezO1oA3Pb81zwsYPGY8EOIeMigme6GV6wWA&oe=6ADF56FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dr7IYu-oucIQ7kNvwEEXkHk&_nc_oc=AdpPtABDuPzPeEpQMCiVLkko7W6r5JgGgLQzktGeCFNcjQwm6pMEag9UbDjeU3LSV38&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCLq__Gl3KUJHk60yYABqp5aICeCQ_F_Z40nxPFU5gjg&oe=6ADF53D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3cFAvtu_D7kQ7kNvwHCJ2-a&_nc_oc=AdovFa-J-rzSA9GpdA8mu7v269A2vbXob982ax0S_TjFhwuC9DRzeSAbWT8CM5_367c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPu8u73mFp6d-FE0hbkFR_47YMOeyPEzw_cf_5NpPFc7Q&oe=6ADF6F42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
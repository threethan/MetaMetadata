m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u6LH9mlU26IQ7kNvwEtPFQK&_nc_oc=Adpwxosv-6k254RkneCTv9Vdc9XT5hs9w5ipKoT0BcVRoFoPaHUnD5fLipgV6hG7ywo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRazZBKGqvp0okHNKS-JV18aLKkEQUOreWxSMQBB4RNA&oe=6AF5CD9D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G-Hfa3YRf8wQ7kNvwFkis2v&_nc_oc=AdrOi1uHHholPplydlpwSxGTjEsPUNPEZ6NnTJRVzh1XGoodTUq0m9fhZ9iupBexGJ0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSfGt9Jgj7fYpu2iQLIzHWCYVZz9IbtyXummad_2gOATg&oe=6AF5F33E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIfACK6PBy4Q7kNvwG0hF3u&_nc_oc=AdqreLYiK_KsEpfiJd84erZzU6JAV78L066gjP3VJCQpxCAXHHADnT6ki2BwlVsmGFI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTyxnJy6lxzg4sTsApWNoAdxmecXO8UYNs2zr4Bw19oBQ&oe=6AF5C07C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gW6iiY8Qp2sQ7kNvwFMTbAw&_nc_oc=AdoyjlcqfH3jWJOCratP-6a2xg2K7jCeQ_IA4MmW8WvzcQvXD5muj34QWjGmQt-ztgY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxtulbD-Qg7EQLdN5kZYUbDhCwOceC_uM6gzWL-F2ZYg&oe=6AF5F597"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PbOL07DTkEYQ7kNvwHmZ2Vf&_nc_oc=AdrK42LrwZF-x9Io0t5gHS3WGAptIyMhY4YZy-udMxXphByPqGMAd_qk5Z4pR9IKnPM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRWRpRTQ6sVZlT62_TdBB2Mt9JMMarEtYXLgkOrWsrZuA&oe=6AF5D8C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.my.canva.site/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3315291881322
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbctG-GpZ7wQ7kNvwGySkR-&_nc_oc=AdqAv1Qh98xai0AFYBL5XzMq1YYtgIJ0GT05TcTHb3Ev1_3JqULqcEmRbDU84jj1XKM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAaKZEHj27Sccn6Cs6r3cylkHbUaSjXknMvrF-Pp2WUQw&oe=6A64C89D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxDqSrGiNisQ7kNvwEqratD&_nc_oc=AdqzRg7X3RWyF9EaMHiLOoWArhtAS0w7ujcKW1TVCquDh6LHQGqJov5V74nAUDnzWAI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCY73eGilHvofAt1gw_4UNEZ-bGbsTZP4rHyXTQhybTtQ&oe=6A64B5FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WFLpRbF7wgMQ7kNvwGBR5fY&_nc_oc=AdpfUadLBsgoa3BrIlRjgy7beKNyoQnQv_HQXXPnlqBuMiNtAkZ-XWsmbezeC4XDIbM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDV5tDWqF9pOEgmvffD9ROkcim1FLw6bInLeYuYUsy3Tw&oe=6A64BB7C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0qVwSETmdoQ7kNvwHulcDz&_nc_oc=Adp0gN_wNGTXI83Q8DXZCgff1lLbVyd54CzGg7y6lhO7-tG6z7H6Y2dhfmrrWiX3f4g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDokzdmq4BtdMIv7aXL4p-jqMPgdfoJFp2Jugh24L81nA&oe=6A64B857"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GgWhooCjN1AQ7kNvwEUwekM&_nc_oc=Adr2lJCkHqcDlF-VZE-iEACHIpyL-XlPkpAmbGz64xf_qhv07eOGBdRRANLjzO6rzcE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQArPuecmjef48fE1fp8VuonP-N5-QhfHqTpTs0HcugCIg&oe=6A64D3C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cJiUS6QsI8Q7kNvwFvpklO&_nc_oc=Adopvsfs6n9MUpN6QC1fQQaaJ8rwUWNrJHlW8h-TxeH_2TuP7hMwnfiTH3qQDpoizbg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwe6t7zCmctBGR1p7wWx8kP0pTQKMi0ySwk3PBZs341Q&oe=6A92B4DD"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWwsoU5WxYEQ7kNvwGDTgyL&_nc_oc=Adp9-jRKYYI-6YkFTTEVa9MQRRHbNq4DlIRc5nPK812xvyWkLO0uOuqkaHCuR3hXpro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa3Sh1xMV8-sRQ3CgyqSyJDtF2yCmT1fuihuA5zs9q1Q&oe=6A92DA7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXwxj-lBhBYQ7kNvwGQXz5j&_nc_oc=Adrk2h7ZPHfQdqk5eZEEefV5LJPXeb8KZjyRSyeuVbv7kgESgH8X-XErskQkEpt6Jvs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy0zPQXafIAjjDkdkr9uNAZqtLjoZrc6dkQC4qXPvp_A&oe=6A92A7BC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmVj7RebJqIQ7kNvwG3nZCi&_nc_oc=AdoSIZy_rjDSWfed0TyQSLRLVS5554VkLH43dhS93ReA_butnFnrwb_dafO31v2o87c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXU8skA4HAkrWPvsf9hYfRpjikX92o-qKmgdRRPv0l8A&oe=6A92DCD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiaNAbRlck8Q7kNvwFcXEfK&_nc_oc=AdqxqOdb0lmuKG0aottTT1OkEYU8F9KQXWEpYk8JGtyjPliKJkQRM7dZyXjNNfOv3Ig&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEXsOwQQFO92y2XOXCead8VyU6LvaAAjFaL8-Yy5_ZfoA&oe=6A92C002"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jGRga37mF3YQ7kNvwHPt3Z8&_nc_oc=Ado85RT6QibzR1hDeHHm7kYDZzyQ2OXZrTXLGaJB02utI71Cs6kPYPmtjky0vaefp9Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HQuY6Jo8viOJWv9FQlK0IbYjNrFwR4hFzmWg6sCw_Cw&oe=69E78A1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3l2PG2vcLP4Q7kNvwEnSJ5D&_nc_oc=Adq3v1GrhoxfpD24I_W2Szro9ete9vExm8hLclhHpzEHTBcpRMdq3QddcMu8LLF8vjU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1zMmcR0l134kvAgp-0AjdDS2VBegbBgn82zVjiTk9Uow&oe=69E7777E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zvVk_seIgxQQ7kNvwHc155l&_nc_oc=AdqG3-cKo__kF-K1F-aWC_qFa7udIRuxJ8CQ4Wlj66sSHhT7qUpcjo6xWchpe8GKT8g&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2zyRfU5bQ5DfOLX-7wr7lFFWfEW5jiAUEcXJwm5fhW5A&oe=69E77CFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5u9lmhwarz8Q7kNvwFous2f&_nc_oc=AdpwEQ81ZwCuvpJylPOkoP_9lj0AuZgsV46FO4jJ-zOUNuGeRZAPc3PV492NABlzvtg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af001Jdt8qUYFa9O7Rk1NRSnavnKbnjfDX78zk0bMo47gw&oe=69E779D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6i7jRghZMAQ7kNvwFG3fMB&_nc_oc=AdrVXBRrRyw_s7iKngltNQBw8hkVLeVRh5FJ-6wi-PJm3WT_wQb04k1i7eQWDbyuhmQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11H19tgE0rnKKcYhBPOV_OtNRfZHmWDbkG7rRKaQy8IQ&oe=69E75D02"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
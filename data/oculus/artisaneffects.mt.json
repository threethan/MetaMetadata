m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f1NxkazMXdgQ7kNvwEWQBQ-&_nc_oc=Adpy5vxcFv6K_dU1CtPXT3V8RTUXvzkrpU_pRJ53i8c72xA5ReITPE5QM19oox0yE1I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE1hTZHh1CvpJn7omDH76Lr5msCxe3eh4TvO1OHw7Uqbw&oe=6A831B1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwmr7oDWhhMQ7kNvwFT-Qxv&_nc_oc=Adpy34obZEzHq9r-qQbvfwB_BAORKNcaI3yQRfx0zNICH1Gf2l78WEJHzEpjyFiaXfQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWXdpQpmQ0zvZHqJv13DriTzJ9B25dmuwBoOM9T7Ibuw&oe=6A83087E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n_JEaooM6YIQ7kNvwEgE203&_nc_oc=Adr1GcGSJ4P2M8l5oAwnvVIrqSfPSlSEWv6X2i8GBSBO6ClYPdCFYaelEGQ7YZU2dww&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTDtY159sNcEJDVA-VJ8gtSY331iEViJ4RQT47IwrKuQ&oe=6A830DFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QEdiCwDrwrYQ7kNvwGNtZlD&_nc_oc=Adp4BGy70_yrTuDRx-r9TchRaVRx1W7EE4bBgxYTepKfRyulCAy0hrDekxpQuurYTuA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHz-NnDcMzWWSb-uwY5Pk7bXb9cxo7gxBv_EXk2Y58e5Q&oe=6A830AD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoLTa0mONc4Q7kNvwGXL2Oh&_nc_oc=AdqO-Y3VD50lVaETF1N3_nm6AqqNAVuSbajvdyeVHZD-pZCwcu8mG1-Z2xteSZ5eob4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF79GLzDiv-iPa83yZdo_9DW4tyMR2-7rrOq5C73TBMnQ&oe=6A82EE02"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
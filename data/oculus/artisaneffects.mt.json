m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LK5hJiWej9IQ7kNvwFUMF7L&_nc_oc=AdrvEFFiPYIT7q5J354IqHSWQDALfzDiGfgZCksT2cD7KvyW0i7CR5ywrq4b9UrYPCI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0zqCcRpfGlqiVqUCGA5FxfmkuQPnZ2gT32dlIs5KjVQ&oe=6AAFEE1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YXhJU5_3BysQ7kNvwECfB5E&_nc_oc=AdpC0tFz6uGAHO_vPvWiQxmK6BFLcIoB0KqwHSgFveujgwZSb5MxMBS4jKj4wFYvy30&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQ_d9uZJbi3Ime4pi3zwX-t91RfaMAkkfCU2hHHvqVOA&oe=6AAFDB7E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVJAm27BXq4Q7kNvwFKkPZQ&_nc_oc=AdpT4JsyScoo_wXf9M184HmoH62EbmHJ_4DjeJlNh_BI0fxcbO4QzU-AZMF4JBPWE94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGBRJqnP_csfx5c2a7uRKRNklCagiTHHUGDyjttbbecQ&oe=6AAFE0FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nZJnmbp6cusQ7kNvwFrf7KP&_nc_oc=AdogoosPTsALP50oEiVO81_nCFS270esT-sjWc2XWRjB07FfWamNFQRGE5KKa5vE1wA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTMMRF1XDlKgdO6zuGUoFTrnwD5dXmg-i_G2taOo_ALQ&oe=6AAFDDD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rJ9Y7hjWx5kQ7kNvwFzYxPY&_nc_oc=AdoKM8mFVGXYTfFsNNK35hPj6wIXisZ1FcGFYG5QTxFEYYBJbtVxHZECj7ncM7EkvJk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9J3QPEi4n9w4MNrnsEYCM6DEloobItqizoO-NODB6cg&oe=6AAFF942"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
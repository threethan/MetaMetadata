m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZDBP3nnRiHUQ7kNvwEcZvFc&_nc_oc=AdqGQnvCMVH2ZyP1V1eplAuAFpkuO6izyt9s7kFpzRwLxVTRb8smAKpwZuu3fQXsbrc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKBSojbG9Ynck1-RUyzrNZQkXSoelh8lZY1HKGVvr3gEw&oe=6AB3E29D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gArOght0KwQQ7kNvwG8uVic&_nc_oc=AdoB1dAx8pzHMi1qEd7ULZz8gT7QozklBv6_bY6-hM5terVjHsymFs7zodLZ5IJ-Ou4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-3cXbbErQ5dw4NLyqLSWFhTIw9iaplrVvJIAkNPZQ8g&oe=6AB3CFFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lMsvSj2bx_oQ7kNvwFD_vQk&_nc_oc=AdoC0WfwGvQyxVLtu00wQ2fscKddlPqSNREbuk2BH5Jqm0M3cNShPcXR6vtdDnS7p18&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ8nzzvmQm2-gOl6Q6rJlmjuv5mvdN8DIYGQVUKAtiNvw&oe=6AB3D57C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o-GGqpO9MbwQ7kNvwHokoPW&_nc_oc=AdqSehHIBJuNoy9ewWTdM-hPBnhSzI6nrePEIjW3kKl_wthPqbuVnt3dUBPfrco7S00&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9JRB-7VdgiXfwM-ox_yDumLOQyZDWkOJ87W1tY_fdYA&oe=6AB3D257"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Px7EaQrfvr8Q7kNvwG4A2t4&_nc_oc=AdqTXzHq9KeJl9ZkoDeglH-_qEdA_5EozJBZack43kPfnhA99QNtFwaJmbW1_q4yYng&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJr6zRx9IqLVI8zv0dCefMXvmIKzs5PrT3RMREObGwVqQ&oe=6AB3EDC2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
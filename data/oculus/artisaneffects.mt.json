m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-1IKETRkrQYQ7kNvwEmlsQu&_nc_oc=AdqnqNciLkw3d5_OOBrozWNmqm7BGCb3o-73ADR4KKB0emacZPoa0U3NVA6_kM4S25c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH7iIXVji3YFoGHnWXIVoBrUiItV1NMgdu1MCMvXnhxA&oe=6ABA7A1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PFjmqJOfDkAQ7kNvwGbcUoG&_nc_oc=Adoamhq93xcIQ6ni69rbDchtl5TuyPmrlmk9KOJkbmunRUFKds9s75GnSx3qD8mIrH0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJR_lyODL8yjtdrAmzc-FY3d8XVHOZcVvQcoum1wyXppg&oe=6ABA677E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5FM5MOq46IQ7kNvwFi42tu&_nc_oc=AdpxNzg3Gp5IHJImGtTQMmSHQQxZpAFvs3pFGkVD1vyTNbfkA6uVnW75OEQf6bJySFE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLv32Cx6sP8OycRg6Q2coko9G2KCSrqDkTFbapYOYu3bw&oe=6ABA6CFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NT8MjP-0XhsQ7kNvwEr-HvX&_nc_oc=Adq1CJfAVpZTmbApnXuFE37r11wEocmdgyhv3-p2jkYhSwU-hxvtu8binD4NCjg6iZw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJk3jbM02p-Q8GikoqiSdix1ZfimvucgNfm-VcYTDeGdw&oe=6ABA69D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3vWJTB7JUYIQ7kNvwER7CPB&_nc_oc=AdpnRBTsdhjfrd2ZbkoTTbG56PpywRICcvhLoOdcvHTY747-4xUuF2pBUfEPmI-wGOM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9neTny3xBfjeWklYRgiMgYWI0SfqNLzHKb4wQnpCS5Q&oe=6ABA8542"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
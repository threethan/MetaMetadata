m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cJiUS6QsI8Q7kNvwEAi9ze&_nc_oc=AdpyNfxMjYppJDfIiYR4NNQOBRWy49hCIQg4xdFpoH6m5A7_FwS8rr1G2I7Ij2izUao&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_YONR2-FoO_CmCjI6im7LHCFdXKVLHG84AnuDDm5Pig&oe=6A94065D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWwsoU5WxYEQ7kNvwHxNvqE&_nc_oc=AdppEjBRdeNZeSUxP0ksqTBuXTlc7BH_72PV9PSh_QbcarLqBY0aERyM39U7tKSltVg&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGgerGPBvGyvvFRcPc4nkbWDgJKONiaFDhvSc9erIDMuA&oe=6A942BFE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZXwxj-lBhBYQ7kNvwFqiVQD&_nc_oc=AdpFBCu16DFMzczgBxtEmDN9KhrOq0KhPmUrB46qfrmeKDyNNy2xGBc8dXLq5-_va9Q&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGCLIvjB60I07xNkOA6C57bQYf5AbotoOp63M3NLiPmww&oe=6A94317C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HmVj7RebJqIQ7kNvwHC5qV9&_nc_oc=Adoi1UzPNJtUgVRVrMa81fIvj-To1qnUTgtxsq5jTB_WyQxvA-bTbFEJVkIXipdGiF8&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGjjAdXjPIYHeXPpukJdsrSo3RWR3xHcx2mJLcMhckBHg&oe=6A942E57"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZiaNAbRlck8Q7kNvwGaVuS8&_nc_oc=Adq9LUPUlijYwz7XqoUVb30bYKWG789G3DsQmdUNfcI9TGDpoPxJvgPvyGnfqgsweH4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFpjOlSwfEc5hHG1A8ARP63po5oyDIFg3naRHvR_oUy8A&oe=6A941182"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
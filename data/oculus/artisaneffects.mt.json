m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uaCUiJhpa6wQ7kNvwF4K8Ue&_nc_oc=AdqudReiOFED2EboMSEIrVYnxnCFfKu9pxoGu6rXtX7jWjgEcL0h-UMW7T2mTZtdAmY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTfj95Ejf6rSUzYDeB1PjT-Q1_DR-ehzOnFDDyU7hG0w&oe=6ACF921D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=be1H_dG5UYEQ7kNvwFGgx0j&_nc_oc=Ado7kCmGG8Zncoo-svN0yEEDLAU1vPUx0g-KBgF8zTyzWOVeeC2sPSbj58hTH2GekRs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDodW1yigmEiSeVvcQExHdW5hgx-ENj9Wb_dwN0l50zg&oe=6ACFB7BE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9IlFL9Kt3OUQ7kNvwHuP2It&_nc_oc=Adoio8hjiFmBDLVfqjOhxwCQUKbcTdB-zDiGdmUc27vuTcASLCSwTAuFb6uJZO-i2-Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjw1InPfHPWT7mp6_qWm9Ah91HkgE1c9WoVYn51kwYNA&oe=6ACF84FC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQZnhIHC0YMQ7kNvwG4vdfM&_nc_oc=AdqfnK_Cs5s57rcu_NCW-bXcizidsM7h75GTP8I67bFMEM3eKXeiDW0POCT9zI2BYGg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjTOmkM3nXFoIM_ZJBf8x4AdpPboywrLGTJtjifz0J6g&oe=6ACF81D7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Qppup_nzMI0Q7kNvwFJlrvJ&_nc_oc=Adr8iqBkvzUUajcOsWHP3EbW7zpwqY-pxqDceou3zGtb_yXgE9j04d5Ag8nybSj_1l4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN5qPeKhgS-c_Z3dsx0ak6YyFdJatdn2UWlv9HIcUIBOQ&oe=6ACF9D42"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
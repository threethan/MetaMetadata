m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PAHXG63mdywQ7kNvwFHTc4G&_nc_oc=Adp8mvMGS3xZpaXy0O8_g8HwNFeL_yl4aGMZlrWKw25zbDzL1uNly_ht0jd1eZekcgw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5lxTYFFux5jTM5jhPnx_uywciWsXqPiMgSHCG3agbEsA&oe=6A0DC59D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4huuXEvN0cQ7kNvwG0QRR_&_nc_oc=Adp6JRtek2lr7ZJwzijs7jQh4KRfahf6xzDsGhvnpu_CZIES7walNxBxHe5xJbxTv10&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ah0_XVOoIhErVgJY9Yx40OdEXZu-zTHxLoLNgAnenYw&oe=6A0DB2FE"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=coS7w7pA6fIQ7kNvwGlQjiH&_nc_oc=AdrfBNx8NzIckXInwZWL2XP8LtGRyd3G0DoEgv4l-jntlqN3ilfnBpa6PQ1Jv-CG60Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7BWCO75yNh5TdLovyE983KdTPFhgV-Knl9olWSj7k5Lw&oe=6A0DB87C"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yKG_sPiegysQ7kNvwGx5lUU&_nc_oc=AdrI9zVWjXuqxqvXWTJ22_BmuQUux_A7gO8e5r0VDOGJWgOXNWXQxw_QTTwoReWvERM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6EV5dbOigJoKX6x6NYMLZ3ZyrQ7U9ut6llihLSzQUV6A&oe=6A0DB557"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-nIIwKKMjxkQ7kNvwEKbsN8&_nc_oc=Adou61KFueUw6l5QCExgaRqXV7NBW9cSq6Yv2hqmyh_ns8pIvtBjp-Qp3AuRPUKN-MA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fFlfy0w1Yg1W5MqrHvGsVoZUDAD-SvifFJ8uUzj84Pw&oe=6A0DD0C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HDtUijWtfEkQ7kNvwF7Lg6d&_nc_oc=AdqfxIIMqSg2qvIvUna-XIdNCuPbq531t3T9xBAursI4Qndy1ZslZzF-3lZQj4_oCSA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8nYvFCCPdLwiq8SGwZpK4LRO89aVlW3jE-G05MYm48MQ&oe=6A2EBB1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cPIor9Ijn8Q7kNvwEVOdZW&_nc_oc=Adqrmtcv-wEVHcmEwOS7D_p008Pd9BiUed4c5VclPZnY2eKsd7MxGESFVsyLXdIhlN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Hoc5wM_9AB51rLGDZ9HI0u6q6NxFOo6X2L7sVIHuR1w&oe=6A2EA87E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z2fgY5XZct8Q7kNvwEGjEx3&_nc_oc=Adp7vXaTPbkxqMc5a39CjY8nr5p4SFQYmkSy9WCff_I5mrkHWm_sZJou1m2LCoPKQJI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-psV4VV0E_xj1x5s68UnIr0t6e4egA7ioYIg_AEEnIGQ&oe=6A2EADFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ovQg1sQNV6QQ7kNvwEb0kid&_nc_oc=AdrAWF9SwOWqHe5tDoj7LGdWQEqVB-3N5ynzxlpE5zqplOLAHMu6TwzKLQafgIOzoko&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_VEwHjTaq05-kIqjI3oGsQOVj-xMm3Kef-Ea2mLHLXgQ&oe=6A2EAAD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3wiWWBaQUGwQ7kNvwG2F9cX&_nc_oc=AdqyA22w02RWqr5cGSVnsRDLHrQbrB4t8J1a4voB8FpVosoDm_7Sb9mhs8z5378eItc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9iyxaDNW1_03Ks-CTOPNsp6fZAaBmNChmwICki2rWbOQ&oe=6A2EC642"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
m/v/t64.5771-25/38974551_500505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_sMJ3qyJDMQ7kNvwH6nonB&_nc_oc=AdpjHTHy_7b7hXE5ELv3p7ZAGD39GLqX3z-C_4HxvaEWBGJpEn5tcFuhQVYSXaLpJWM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOjS1RcASGbs4LNYm-s2jesT0SjtxGUFsfrnp_rh2nI7w&oe=6AD3869D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X6PIiXevYWsQ7kNvwERzLKf&_nc_oc=Adpxej54c3TqTWA96GLcFw8BTqONWP_fSzyE4eGIfPbQwpq2GcIilj8M5Rc6mqNfHN0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBS8nhB5GOrDcGat3HhFrHOETFR1Of0yNGckaQnonIXw&oe=6AD3AC3E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pllVIASshR4Q7kNvwGoQQ0-&_nc_oc=Adr6K8TtIc0o5wDa1Gaf11miPjjxGr4NovsNKZKQn4lCfyrOSsu5uqN1wnvHEdFyNQk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPlGFk0us1b5cftarAzaB7p3APpSNQxFsPROC6EsFn2jw&oe=6AD3B1BC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HGM__LdWJQMQ7kNvwFSvWFM&_nc_oc=AdopG1-QG4c9Bd_HsEmpDQukAhKAqxDgoe1E8nml7fUpe9zWmLzuFLhUm7HlUER7GWQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdhtwa-qiFrpbPNTTJsh5DCJNS8gx7-XNPCLMObQcW_g&oe=6AD3AE97"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AoMrJ3eGTIcQ7kNvwE5knd_&_nc_oc=AdoCwI6_pGrVNOb49eUnjX7gyEBgSrdh-1euwqa6y8ZDmBP0iqcgREnOqsFl7DDrh24&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPmesXZbWmt-78KReVI1K9O2qbe2VR_wVD3prSXkqC6Kg&oe=6AD391C2"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id
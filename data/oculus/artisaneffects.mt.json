505099643359_8184966478487214704_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L31WuuR7z1QQ7kNvwFIRZ4c&_nc_oc=Adl6aA1yzcuMsErpXPbBnNWA74oHjXQEzNIFi0nGF0uXrvfDXZjN-mrD3lvV1bUTPrs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afyl9Wo52XyFEaXyzMA1G4wEfWDDbVbQ05Q5sAKaabgXdg&oe=69B02B1D"}, {"file_name": "1.png", "id": "865282648895358", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031632_865282652228691_7458420071604465470_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tUagDyrDqoEQ7kNvwGep_Eq&_nc_oc=AdmU4tfk853agLPJ4q2ACbILH5t5n6HjfttqsH9FVorVZBHgvAHf9a9LQSqCvjDBTvE&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afzi0U2E0R5lRj3nNp8afYUYbzuDinTk_MEFF3lK5CDxHw&oe=69B0187E"}, {"file_name": "3.png", "id": "2245538989150890", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/57572954_2245538992484223_8598079660398496648_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ag_KrKYdYdEQ7kNvwESqvAQ&_nc_oc=AdnlJtS0Nw-CaaIl4pWba7hRgQgjpKk3eA2Ujm3aGb3rFSPOR_DhlL7JVZpMh9in5Yc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzSKIpe7zoScG-t2qg8GbFMwWP1CtnFT3frBiO_7GxUHA&oe=69B01DFC"}, {"file_name": "2.png", "id": "2673319909520060", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982510_2673319912853393_2503569918825159240_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=atDdzG1R9lUQ7kNvwHIvpWW&_nc_oc=Adl9jOWm4QIS_NaPmYSKU3nu8MdBPJ03xFHQny-lEw0p39uCPNICE4hE4v6pZrHoqMo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx4cW3_6cX2lf-vTfyGJE1Ca3uIRzxz3pcEJ7mIZ4ZZUw&oe=69B01AD7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Drum Circle Cover Art (2560 x 1440 px) (1).png", "id": "1161447404916858", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982625_1161447408250191_2650284731583729103_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SD_i45g_FbgQ7kNvwEy5uyJ&_nc_oc=AdkR13x07Sh_VRBDRmreq9rugwrSiko2NxFw03H-lbzi8hz4jhXDsvei29D9yx17tdU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkZlzqfeNLeXuhPk6ClEUq1iPOM6PcJ_stjMgnB7eUUQ&oe=69AFFE02"}, "display_name": "Drum Circle", "keywords": ["Drum", "Music", "Piano", "Jam", "Songs"], "long_description": "Unleash your inner musician with *Drum Circle*! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, *Drum Circle* brings the joy of music-making to life in immersive VR.\n\n**Features:**\n- Play a range of instruments: congas, bongos, keyboards, and maracas!\n- Play along with *music tracks* or create your own rhythms and melodies\n- Intuitive hand-tracking lets you perform naturally without controllers\n- Get real-time feedback to stay on beat with BPM Indicator mode\n- Use passthrough to enhance real-world collaboration and participate in live music sessions\n\nGet ready to feel the rhythm, unleash your creativity, and make music like never before with *Drum Circle*!", "short_description": "Unleash your inner musician with Drum Circle! Step into a vibrant virtual world where you can play a variety of instruments using just your hands. Whether you're grooving on the conga drums, tapping out rhythms on the bongos, creating melodies on a keyboard, or shaking maracas to the beat, Drum Circle brings the joy of music-making to life in immersive VR."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisanreality.com/privacy-policy-for-drum-circle", "developer_terms_of_service_url": null, "publisher_name": "Artisan Effects", "support_website_url": null, "website_url": "https://artisanreality.com/drum-circle", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}, {"id": "1672577396871977"}], "external_subscription_
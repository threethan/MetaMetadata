pl-X5_Xg0eBY_G3BVO_WcPxG9je2oRhaOrY1ixY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxGu0FAat0pNDAmUzi0uDg4sqhUQy6wxRnHMsg8z8WSgw&oe=69C6654F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5kMdCHDCFoQ7kNvwHVCBBy&_nc_oc=AdppXckdcL4cuMUWQDelrX9Hz2q1b9HFSS4bTfgrCA-2tumfVVUYFBekmTcW8dxXJUc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy1IjNl49mkh2nVLmGjXpxAuIX74M5bAwUmGgDJFPax6g&oe=69C66EE1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcMFWnaHZhMQ7kNvwFxbOjF&_nc_oc=Adp3-oocIIc1aV6QptINMTFWcuxWnzbaI2gvXpQArzwp8iu17ZNjB_rsAp1JZW79OmE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzh07wlgWdDHh8kHM7y6g5kuB7a1jT4Nb2LE8RwFV8KvQ&oe=69C678DD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeZLIUua9YkQ7kNvwFeaqEs&_nc_oc=AdqeNXpDHFzkJP-2TMYm4w04kcnNxa-hMGVlMBr9N-ydOkNlIaZXfMl608T0eECIVsg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWLH1gczUwKvV6adlPv1_QsJarug3SWXbxVOqXwR6pxA&oe=69C660C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJStzGHPTfsQ7kNvwGFIpIJ&_nc_oc=AdpzLjNHuZfMbdqpJbzBClQ34as2y1PX6fmAI1oAIZhVgkIwP-OMx8XKb4me5IzouKA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxEC4jYAGtmrqgL_IKR4QufItj5wkdTj5XXGLH4YfPqNQ&oe=69C67BB5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
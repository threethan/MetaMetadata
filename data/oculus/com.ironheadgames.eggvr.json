xVEo3WEh6JtPNEvUqhjvf32TsnggoWKOHXD8w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyNivplrhcxI_5mNgDMW93F8azvVeQsCaP-pJ6BxYz9jQ&oe=69C270CF"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8xB0hpiVuioQ7kNvwFD76Vq&_nc_oc=AdpLkQP3CChEbn9bgJizvfBm59z_KwRjCcM8IdI5SEZs9VUkRTgcYcZ0PQoqhhWRBwQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyCJ3oikccNvjguOc32umiUE2RwH41iW_V4xxNI2pxNVQ&oe=69C27A61"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2TcbT_CUXsQ7kNvwEd7SW3&_nc_oc=AdrP6LdfMeOdfT1oOvR_zt0W-QSLGxAcMSAuAjp6feIExwpkiB1JHuQx_SSk4wOnSHo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afxosld1PYBR55XCRR0l7_mWXwzWLLAZCr7YNq4UKZ8cNg&oe=69C2845D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T34NQHWLl3IQ7kNvwGYVGB_&_nc_oc=Adqo0Fu0OZOLwMYz426DdofV7-8gsC4fAp1QccUCqli5YSLpKt3HxRe58WkeEapuG7Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw8dYsNFSvKjgJsiYINOnyjUYIKWAHUy_kDpGIHTKv2wA&oe=69C26C41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_csXmIv944Q7kNvwFRpj2A&_nc_oc=AdqlmuGMO0HtWqGrAgsnMCgzuNdPdWk-0GMpkjcl0ovOKXWVPKav4V9Vuj3cSx35G_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzSd9aFLUfU888Rv7_7dvWH5fTPUY1ux_KepsREK232DA&oe=69C28735"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
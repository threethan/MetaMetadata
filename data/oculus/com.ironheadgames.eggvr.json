_CkdqMpn6EIPuccSf6J7x0yQR2Lr5jYLiPrftrRKrOvn-Ks5d7y26g&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jXkHTfRrWpzYd15qeViHt0EIiX_ONVcTGdZ-2xFEO6A&oe=6A11C30F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej8MZV_7iaAQ7kNvwFqyNM3&_nc_oc=Adrufi8_VrVZmI72hCPzaiXULApEsX2FXx9JTiqpocBrqdV0qRG9eSy0zoq0JaI0QhI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4k7hk5_MJpDSQg5nPgHRcxpm4xAndno9bohgT9ezBkhQ&oe=6A11CCA1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mpUX8iN3NEQ7kNvwFBex0b&_nc_oc=AdrpQTiHHBYcgHZAeVFWrCfJHc3OmpNM6e0og2RZYDbgrkBwlCIK0drQqA4oAn_wEwE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OBHeklG0Teeqp2fzQKKHFOLmtF465Btt4Surom6G_Iw&oe=6A119E5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhcHQEuMhbQQ7kNvwFwCZGv&_nc_oc=Adq6QJtt9dgafCQusA-ahuts8xFaQTPk9gb2-WwfVTOJJ88Fu3E2dzWNptqadbNTcKo&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5jePRqrRiko1No-XtiXgDXZPyBEpmhVL9WqtPPkFOPqA&oe=6A11BE81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6O7uReGGhYQ7kNvwEXq8ri&_nc_oc=AdqjFV04pNKMt6r1bc88o41LS0iwJoM09qVL19fK9ijGzIEdCoNcXrq66zvVZRNZ7D4&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6jOcl5PrWkFNHH0DEsrySK1AtZ0FySG8TTfdU3nO8Ybw&oe=6A11A135"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
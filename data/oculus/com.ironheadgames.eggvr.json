d5-3.oculuscdn.com/v/t64.5771-25/491821674_711899944652391_4944235026436662407_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IbAK0WDpNGYQ7kNvwESmMtO&_nc_oc=AdmKyp8iJ_H7ZGhnmRBVWmIKzq0lqcsagtRQvjKKJS7oxgfC7UruJHJT5xuGQCDkH20&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxzFfNW6E4-da1ev9Vpv3j4htlynb3LPJ6aJNQiChBptQ&oe=69BC0485"}, {"file_name": "29.png", "id": "1454224625646339", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821682_1454224628979672_3828715767483634636_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rj1rx3iTb2IQ7kNvwGOjewD&_nc_oc=Adnji3JK8qLpHhvnhXZnlvR4kBVG5AgSsaIr8VBVr8J8GygoMZECyqaDeB61kb-QZaM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwldCKghOHZ9X3oCy651twWlR9r21wl1a-6oIidlzUiKQ&oe=69BC0A7E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape (8).png", "id": "2390516864711782", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507840145_2390516868045115_6927857699831385045_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3FQWQHyVfacQ7kNvwHHxzDS&_nc_oc=AdkKvWJt38xAyDopYfggnJIFNhh7ER2zcO4RbyC-1umXpa5GzG2g3cb9JChzLI4zNDg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxjfraM_eR-HJzENhvq324THGtn0CbqGz_6g6XSGEGvHA&oe=69BBEBDB"}, "display_name": "Egg VR - Tsunami", "keywords": ["scary", "baboon", "dino", "monke", "animal"], "long_description": "**Run, climb, and jump in VR using a unique Baboon Movement inspired by Gorilla Tag.**\n\n# \ud83d\udd79\ufe0f Mini-Games \n\n**You can play different mini-games such as:**\n\n- **\ud83d\udc40 Squid Game**\n\n- **\ud83e\udd88 Steal a Monkey**\n\n- **\ud83d\udc7b Fun Horror Games**\n\n- **\ud83d\udc12 Hatch Egg**\n\n\n#  Steal a Brainrot\n\n**Steal Dino Brainrots and raise them and get rich**\n\n{2842365595962805}\n____________________________________________________________________.\n# \ud83d\udc7b Horror Mode\n\n**Run away from the Baboon Monster,  and fight against the boss**\n\n{851464257334354}\n\n____________________________________________________________________.\n#  \ud83e\udda0 Smash Mode\n\n**Tag Everyone and swing like a Gorilla or Baboon**\n\n{1317578033136114}\n____________________________________________________________________.\n#  \ud83e\udda0 Giant Mode\n{1554376978890768}\n____________________________________________________________________.\n# \ud83d\udd2b Shooter Mode\n\n**Play the best Rivals Shooter game**\n\n{25044154225189929}\n____________________________________________________________________.\n# \ud83d\udd2b NEW BOMBS and Mini Games\n\n**Get eggs and hatch them. Name and ride your chicken, snail, or your dino.**\n\n{4134103796903773}\n\n{1852341419024466}\n____________________________________________________________________.\n\nAnd try to survive in the new Forest in 99 nights, Egg VR 99 Nights Survive from Deer is Coming.\n\n# \ud83d\udd79\ufe0f Mini-Games \n\n**You can play different mini-games such as:**\n\n- **\ud83d\udc40 Squid Game**\n\n- **\ud83e\udd88 Steal a Monkey**\n\n- **\ud83d\udc7b Fun Monkey Horror Games**\n\n- **\ud83d\udc12 Egg Smash**\n\n\n# \ud83c\udf1f Become an Egg!\n\n", "short_description": "Become an Egg and play all the popular Minigames."}]}, "developer_name": "FutureOfVR", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": "https://futureofvr.games/egg-vr/", "website_url": "https://futureofvr.games/egg-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "reco
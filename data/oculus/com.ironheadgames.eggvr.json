WAUWQDVYJ8Do8HrgpS_VNe7pAzE0EYkc_cC_ZyrVHpLP5pBr2KGaSc_T1w&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HZkWaxgKJA6aqulACWWovNNGRDdgQ5VMYu2UabPY-eQ&oe=6A467F0F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt5n1kiiUlkQ7kNvwE5PXtH&_nc_oc=Adp_blkg657dUO4hz6bfZyA_lXS0ajmBD3bzvKztelxOzf6foSymcLe-9ONf9Vv8BVA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8zYLJgxmYozF_qYKLAT3ENM7t09Kev6mBzAhfGzS7QrQ&oe=6A4688A1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K8JNgjTJdpYQ7kNvwEzGCrP&_nc_oc=Adpa1wlRXo-OLJchmCMBqYjvei2XuEC-3BF-T8jiAUOIS3b6uPgfoq3ekDcoBmWeXuA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9xX7Br4u8leWmMWRuxgTOlwqK6iJgDqGcKXfsPL4lUoQ&oe=6A465A5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lqKILhMXsGIQ7kNvwE56X_l&_nc_oc=AdrgEkik9mU0XQHN8bFW7etfNdxzZV6QZ1tbhjmAVKzWtm7YAvdwJxwR1mJETTWQPQ4&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8HWCGut-kdbjnVSoCXYROHDPCtbDHyRAnxkb4Hv06T_g&oe=6A467A81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oMUxFCd_sosQ7kNvwE_xdR8&_nc_oc=AdqKNE0ohPAVoEV5AR28f-mYbFyGrjcT4ZxMK3W2FSD8XGLnjdReldZ7qqBWz2nka4s&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-vHCFNPEcQ4S-YmeeVudLNB7rSM24aIeWgOXvk_kZ3lA&oe=6A465D35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_dev
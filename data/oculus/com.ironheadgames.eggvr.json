wKiS80cs3puXy5SAxKvL9i7GoiEpzn2_0hzlLv5PjuoDiIPwBGB90&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSGtmuTEy7u3L9e5WFItm-TT5dxjfghv0ilsbzKTRWQZA&oe=6AF1E20F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5jtw3xC8VEQQ7kNvwFedJs2&_nc_oc=AdreZQDlOlKJNEVUCh8Bmunnq-owIeb1z2kZOaCzwtAnS0XNkPCCeFhnHi-ozJYR2qE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSiiBoNrpHZ8hPdaAprglqnFfX8k5cI0w2BtB4lP7Y16g&oe=6AF1EBA1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzFTSvCBrQ4Q7kNvwE7V5cj&_nc_oc=AdoJMrLCdgej4vPRMbehSCSsyUCMUfB7DLTHjwwbaetR5wBpIDcUrUK4OHON4uHmVCM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaSSwk9-XYeC_FI0GIqQgRXD6QZ8clbuyw8eueLvM1qw&oe=6AF1F59D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNkQjsLB2CAQ7kNvwHy-mBR&_nc_oc=Adr9GMujdueW6XHWEmuiygbaLSNwpE2W2Pk2AS7kwpIDkptVsip1nQjCOq9HqDqBZ5Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT8Wm8TkR1DsHs0lRELh_9LLPt_3Ap29yuBzjcTfNO3ag&oe=6AF1DD81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6tGKFhCY-4Q7kNvwE8TrU3&_nc_oc=Adph8DZZUlx9zB5ZHIHy8EJfLd5tBLSJbPpTGVG6HEV7IXxCYzKhwqX-3bAkuSyWGEk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRIAwjDZcRuivXMi3_SHGZzVwxohAVVjf6Dat0xVpv5Aw&oe=6AF1F875"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [
uC3fITat3xzQwdgo0fWCYiTAOtOvEqAcIpqTPcqSOogtV5Sp_NtH8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2NYR4SPIL1e1imVn_2oy4RRCc02E4Y2AaV9kPuyfI5A&oe=6AF0908F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9C_CtkBFglcQ7kNvwESgisZ&_nc_oc=AdpNU_sMuOEc2DTWFnCtihWvtyH-3e6YlpVx4CjC_cdIkl9YKnFw5BPR1PIk1yf3NGM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRW2krwwwLIARCfZG4561xTP-ZNqZynQ_tahxvCtOV5Q&oe=6AF09A21"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MzFTSvCBrQ4Q7kNvwEGy20O&_nc_oc=AdoGdbsyYEAHEEZ0u9ll9GRcqE-OXb2DhFhZ2xeErEP6rr3KY6_g82Hkrafqi7eUhps&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT1QjcgUpxb5PgKPrg9-5RcqBiDQ1_Br-d_HK5rczLXAQ&oe=6AF0A41D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MNkQjsLB2CAQ7kNvwFP-3ZI&_nc_oc=AdokqdpT-ficLyprLTOGJnEZjfXMZalFqKYVZGp6H9MmSnHRsusest2k0azmabzh5Ls&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQePjEH_MYJx-lcXGOFrH6_9Ldl-hS1VcEg8klyvG_CbQ&oe=6AF08C01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V6tGKFhCY-4Q7kNvwE7EYcq&_nc_oc=Adr-M_KAUAZTng-ILs148C0a8hXqGfcnGUoknt1IjqQLF2J8eOscSLrSTpivdkoGOXs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSpx5IOQsusvIDu5laXtNQv9kkuZ_h-Grk7tXpd0N__zA&oe=6AF0A6F5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [
_AfxKrliapt9EoC6xsENxuf02HdL-GfiIM_CuXSrF7-03sw&oe=69BD2ACF"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m6S7lUKBoV4Q7kNvwGTQGRY&_nc_oc=AdlaOnn3b47i0juZAQA9wyABWx_xajdBidNJpKryfa55GVm1c6t7l9uIvFveSEzuI70&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxzXc-o6M-jd8_ea45mN9R0eF0KL4RlLPYwS1oLvk-W9A&oe=69BD3461"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5v6oroC6QpAQ7kNvwH6PwCi&_nc_oc=AdkIxHXok3RUNm6OGU3dBR6vNrrU8Sh-w_dZpgS994Oo9qo8zzby1x9XBGRLFrBb214&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3gz10RVp9CvbQtC37OEbnDugX6lxY02nK2MpwicBoug&oe=69BD3E5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dWU_Rzv_niYQ7kNvwFAHvqD&_nc_oc=AdkR1aYYanD9tJfzLuA9y9w0SyR-R9egk7Rr0q4L6-uNO0ckLa6RAdgQ6XyWFl9LN5E&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxrKcmzag0GNq1uZAM3GoiMih1wsK8aQstKtOjssOMwnQ&oe=69BD5E81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4V9EzdeT9nUQ7kNvwG_I3VA&_nc_oc=Adlx9lHyy9eXvEZbmLgbAoQ3nG0LABkPsWs6s_I3EKLposfgtYizGltItO9JXRQcq78&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfymS56msThduY8LHUEfA2tHnZCOn2U5qExg4tVFq85avA&oe=69BD4135"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MUL
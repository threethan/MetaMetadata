zi3SBFLe4kohhcPr_DQ00rdAphihK3JjEK-w8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzAJOJ1_0DnlT2v4PQ4RrSQXExt9TME8JK0VJeYIKKbQ&oe=6A58F40F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWudtcoHx-oQ7kNvwFwl1Jg&_nc_oc=AdqGEB8VNWFqM8i_lGAziye7rJoFLvljsjD5lv0z61sft_gOa6Fj6GAHA6or-ADGXeo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAKB8cwCI4T_DKSKabig_JLdElhLd5p_eR8nt910WxW_A&oe=6A58C561"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xpyKfwIZtHoQ7kNvwHhkB2v&_nc_oc=Ados6fhz-9kFyFeGe7XDoqIScc6v7w6ZHGq3jvYD1ywzw9NE6UEZyGyOCJnbHLaWv4c&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHB3LFyBStx-haDiJp456WBzOD1CoOyeiOy9TCluGXxQ&oe=6A58CF5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0d-6DCS0rmcQ7kNvwGQfrun&_nc_oc=AdoMJryLxi0pVofZx9f7U6gc_r2o9MLMSV0ZV6eOyNcmqKWwStvLskvOKVC6DfueLSQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC4XpxxIDWzW5cB4sKAyrXNDRA4cF-NO7NWu0U9loNeaQ&oe=6A58EF81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gdJAVAAfU-wQ7kNvwEbmsCu&_nc_oc=AdqkONyjrbfxGLloHhglmKfSs9ucHr7FBwK5GnoQDS8ZDoVsHp-TIqjcEFialcveHEM&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7QQHDhSX7dtGMSHCMJojMWmM_eVcIQONevjw9DZj5wQ&oe=6A58D235"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
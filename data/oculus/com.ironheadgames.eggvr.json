yTLwAWeflY7b7ixSbmTH4S8UWwv_9bd1yVzoJSE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LkfbKmXk3TaXD0qh11TFFhGCrzFJjOrQHTkBkAgWNTg&oe=6A1EF20F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF_zRMGGTKsQ7kNvwG0x0AQ&_nc_oc=AdqdNHBkuTkIS9zHu1sQxfhk4JT-4E43ZHODeI4V-WIrMZLS_u8puhUNNujJ1DuHl9w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5dWx2okJyowjas73UQw_YK7OehxktnJARvOzMXWCFNLQ&oe=6A1EFBA1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD9yS-uDN5cQ7kNvwEhYRjM&_nc_oc=Adpag1qJO-7mugD8ygC1bOMoPhwSZF80c3Q7papu849fjGybzQ_WemP9M2uMmtNXRlQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5tFjyqb2xib8VkfkijWd6v07gBbn189gplebvmBqcO8Q&oe=6A1ECD5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgaf_Ppov6UQ7kNvwG6dQ40&_nc_oc=Adqq8bEfN_nVdU5rLujM3XOrT7blDSlxsy0YmcvolSkf89cHVFqQf3Gu2HDXztsufJc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Ex9MngyNE5dFG7sDmfoslK888xLyVtXeuG79bX7MihQ&oe=6A1EED81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=robMoX8KFaQQ7kNvwH1qEBO&_nc_oc=AdrBOtJu_0b8xuxOM658JvEt8z14pV_5B7ds4BJhczim2bgbBHAtymJyePEGomHuGTw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5cDdGMGyQD7SpcW02hmgCUm_ovVncrfkaE3hHpQJqMIw&oe=6A1ED035"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
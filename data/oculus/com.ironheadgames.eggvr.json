qAswVNNQqFU4XBub57BvIkibdlkNw36q_7QsAz4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0VuciIneI1ZCsJee1VGGRpszBaPrW1ZmymzoSHfexJhg&oe=69E6418F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyJdYDkJMLcQ7kNvwEp06wM&_nc_oc=AdrzsJgFjUmIXmAuq1iNYK0CghsW-MbIodHVtGKg0245y92ak6SuHBnA6A6W6su-vlU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2QWgy5QfzYgbrM4R8D5Z2IqxbZTeacR1Egf23tWeXyrg&oe=69E612E1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pWyDyzyU8iQQ7kNvwFsHscK&_nc_oc=AdrOR0fnQ6YEI8GIFCYQlOxqHHTSOeZneh2z4Bpw5S8LOv5hTXdyz-T_L91B_3fFVKc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1I0LxiHur-3M_PFSIaxzQa5iblZlpNXvOWo4w-L3OSxw&oe=69E61CDD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w-GnYjVSsVMQ7kNvwFwbLxY&_nc_oc=Adq0LoiqbAtq8J705nyE4dtKVLwBh5g2pLd6T4l8jeNaThhq6CTFZ0D_VQDQl_EG4w0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3hR5w_J7HZ71yTr5gdCHD-skY3b_R3ptW3el275ykaSw&oe=69E63D01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PKiNZlEakYQ7kNvwFUI4wQ&_nc_oc=Adqe_f7oBw0qKyAeDdLguBCnFttNxV3ibmgUlYU13Nc5JegIU7qq2sQ7almmsx71p-c&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2UV4y9CZP4xcZYmTGBSeyNP1mO6hJ8K-uw1IdBxP1FGA&oe=69E61FB5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
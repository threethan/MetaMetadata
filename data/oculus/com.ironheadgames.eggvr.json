TXzWcoP_5Amg_4-OR6i5MjNEDg4Daokt9gQUKLg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2mUnOHKn6C9IwxYlp4Zf4i6Fs7nejvmP2CGcQSdcN4rA&oe=69D8DA4F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nOTTiJISjn4Q7kNvwFR8ZxA&_nc_oc=AdonPcg_d2-HVwXOUWaN2egqSjs4jNWuS-GnXkkb2nH9u3icknY5eRKHWO93l7MT5Ks&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2R6ZZ44MoFoE3BhwVPoMWgyPjaih-jveGcARa9Q5L0Mw&oe=69D8E3E1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uSebHHVwCIUQ7kNvwHKklFO&_nc_oc=AdqNXxEVyEXRVTBDYLLTAEZq2BG5BuHOiWTn6AagBNGZ_FeVHp-_pLEH9jC5Zb_Mf0Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Nj7zLx_dUsbdi-IlXQdg9mk4SgdPukyyj-YiyFi_vRA&oe=69D8EDDD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_CUaa1xATT0Q7kNvwEy8-jE&_nc_oc=AdoMJSkLvGwWsul_UXagi_mlYnfMwd8k271RYvl0zhyQdMK9uuZbjwcvFj7U2Du_SFQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1WzacU9cLVfSSU33mitrS3YoCqQQYkDCLvYhK8Q8PhQA&oe=69D90E01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=va2bKSA9QUIQ7kNvwEYo9XW&_nc_oc=AdoxxdP59ng8A1hQ0TkB2K9TP4n-ZJn5qyd1Udt6YB8V6_xc9XZd2Vv7yhJ_oCllZr0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af18gKpTDszrZOo75gixwHTPNDq_MTRXvWOk1aob3jCd5A&oe=69D8F0B5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
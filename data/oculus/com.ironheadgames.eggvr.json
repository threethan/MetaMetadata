DLLD99RmekFpfjq8tYkx60Od3J3Gp4pGpeYcE&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTUAB8XbA0p8cMSiYHYPtY3vgGyKYo_O6TjLOjiobBCA&oe=6A56510F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_24GGugXwPsQ7kNvwG25MRY&_nc_oc=AdqXB3IoTiIzYGg1cnBwlgA0Q0uB54_Nj4K4DAIfOsAp0GNKyC5eFo9pFkLitBuNyHc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCnQtaVkYXElbd13i_AFOFXzNV-70a01F6_OKOE-Qac7w&oe=6A562261"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBQdkQxwz0AQ7kNvwFGdaT-&_nc_oc=AdrpJmsD0ZnhY0GQUH5PpVnNgdWv3IufDxzVBtSKOhv5eG8zm3GKAimhncS5eNHC2oI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBLl4XcEhPzDU47ESSWIPVV4RZQuNGt8zPC9YaSXX9Xuw&oe=6A562C5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdVg_1P3BbIQ7kNvwEsHQkM&_nc_oc=AdrtmtwcA4Fk0nVKnW6ACqITKFZS9MQ2Y5IZSGwLqnDIdRNQxBWFIxq0niUv2durLk0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDW-B9OtoUkmmxdVAbxhCC1cdUAsOYBDACuhAbU_k4D9A&oe=6A564C81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYAR9xOlxh4Q7kNvwHs62ju&_nc_oc=AdodItwgid0gTkZB1oOBxAEyCIE7MlogUhMbDKEpTdnQ2A5SycEX-Owi7BWL8AjfphE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9bsgU5eidEHVehdM5WeA2J3qCCxE1mCNxR55uduBdkA&oe=6A562F35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
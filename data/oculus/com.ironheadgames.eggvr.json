Xf3FvVdfoAO9FU5fm4-jYPsz6ITZp5fYG3ta5zM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hlO0ZjqMi2Gxbeq8DF7-PZD1WoYssc5JCMm4z5CY8Jw&oe=6A1DA08F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF_zRMGGTKsQ7kNvwHWMiee&_nc_oc=AdouST9WngddcT8e_O7IwfNc2h0-8rgyKZZEDTau0LMGy4Mp6lCBHLuHNkJ_PrrVD5o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Eh93IFOy_AlScMsxB3ax6r7EPwlkKQeqcfXj6Yzux8w&oe=6A1DAA21"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AD9yS-uDN5cQ7kNvwFQup7z&_nc_oc=Adp3TCPakyawxbtkNbO--tRWMN1b4FiDWLpbcZW4Lq-QocXRmRPMkVSCreKDx_fbhqc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7anpM1RaK2oYjo-9uHMw0xg2h29xR7pF9zfIpMqynqKA&oe=6A1D7BDD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Fgaf_Ppov6UQ7kNvwHfjbfB&_nc_oc=Adob3_WyIk5ECLqnJFAjKdxaPPMNxhY0IMfrkZDGzdaXLrphaNcD99YqBVT4d3rur34&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EKBP5mbwwQZf3JGN-2wgDuxOHHP9bFQJPrgSSWaZkLA&oe=6A1D9C01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=robMoX8KFaQQ7kNvwEmB2JZ&_nc_oc=AdoJ_1zsYY3G4_WLckC7JwxHEIR0-Q3LFbraoLAsQ8ZZkhVmd9204ty55U9VKH3ZPVk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ILOsfS4FV6r-7zbjQUbTd_lyW1Cjg99c1P3F1Tx6v9w&oe=6A1D7EB5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
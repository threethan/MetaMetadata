HR3Hx_LCtOSznH9h5a6ywe43WVroaWzthAUgZjw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tEyE39bGYrKqFMovsJZ8f8wqc8JSbvlw4qm6nM38-tw&oe=69E24D0F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RKDRQyzSj5YQ7kNvwFm2lWP&_nc_oc=AdotTz6uogrh4OaslPKD8P5A4PNC5xcB9gsXB2Wgubxt5xYjzhUrkF5fhZL4UZVsboo&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1iEwef4ai7awqMXxYIKdSxVPxuQ3oVIsAkSzUzM7TZHA&oe=69E21E61"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz6KX0eRDdcQ7kNvwGkr4yf&_nc_oc=AdoNX870JfgIVfXKEtq75dDqkMWdrX83m1ueS-_Mxy3eOkOizUq8Bn_APr91DTFudaY&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xiJXwGjihkACqKbD2Td06lEBHBYesaeylgsK0hkP9Ag&oe=69E2285D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEPPAFwnmQIQ7kNvwF5jype&_nc_oc=Adops8_n1K7_Q1_nDlhFo251UPUzOBg11bkRHqyPQKbNbqdxTc5oDpfi0RHr1c18ZWA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hXJXEVgvILFUMARyCMdngmciHOTd8pLPU5jtUEhG3gg&oe=69E24881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaHCPdtTqxkQ7kNvwFLgRGr&_nc_oc=Adp-ZT8GAAnVPHHyjqlpC5JeNK-PVRMeOF9nXiAlssoKE6xTseWHm6TxG6QNVfKtukc&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K8bSkqYbNPlNybXUaNMhgLoe3pEKsDIGbI9awFJ6igw&oe=69E22B35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
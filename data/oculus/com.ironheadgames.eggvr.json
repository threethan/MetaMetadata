_Afzvd63TXZQmXJmAzs-UCiMjTkyFInX99c4a8CGze5D-fg&oe=69AC074F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBGCjTBVbFkQ7kNvwE2zEqQ&_nc_oc=AdmM0mk5BaBkEQxbLqVXwvKAnagZUCzhCl28HhqV8VkkEx8C71kEX3l8WsquHZZUmKs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=8&oh=00_Afxhr6dxEWNz75km0nc7ySq5PO09GB-uRHf2u6wTNNATyA&oe=69AC10E1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Er_AcDGXRYQ7kNvwGMD89f&_nc_oc=AdlAF0HNUvR_XIHcUfZLlHzK3lgt_WnGp5gYhwCFBtsbyRf09ILepRx126Fp8lQoCWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=8&oh=00_AfxUR43Wkt10tF2Ang6_JOh51sUz7F1jkKXkFkZLZd7Png&oe=69AC1ADD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imEo9PaeoS4Q7kNvwFVI-c5&_nc_oc=AdkAxLTO22S3KWxS3GoWAwiHHm1hWLbBpkmw1J2Yq0wfZvIJ-_NS9iylbdxAAmfRUJQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfyYDmQVSMK-v7gHhvkfMx2LmFUc9mw4nZMoWg-V_9T8zA&oe=69AC02C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC775hE-l6sQ7kNvwHoLguX&_nc_oc=Adkqihk-IhoAitujQLr7Ey-0lwLvrkclOeaYGuJrc75bzHB3k6TZVmbGDs_jxRarrPo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=8&oh=00_AfxqlgFYwIS1rSAMBvSMti2og1WPF1yin4jmGmqYUUvK0g&oe=69AC1DB5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MUL
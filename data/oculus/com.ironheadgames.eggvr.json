x_MAc-ZMckX7Ibp-noF6Too7BP4Ovj9yI7fwc9aNtQSkZDcK4MJdM7gM&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9OfHFI6WWLxpnJKYrHjmCxLIggi0p3APnyOHbFloQrdw&oe=6A36AD0F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYa7vgP4pmkQ7kNvwEGwVxA&_nc_oc=AdoWMX3h6W-ETCbgAM21ervUIjwkDWdE76ROvLP7CXXLm-HKILohKooa687C9-tgCyY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8m4A7iNqpU4yVnjuRUfKRLkLxHERJkwHRn8k5d0vi4fA&oe=6A36B6A1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QdfVujLWc58Q7kNvwEEhVd7&_nc_oc=AdpUgrcklb3rlBg7gSmPG5PabFznlpnaCmiiLIuAOgJRt95ZynMR6dxpUoWYJmCYXuA&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dmyeMqi7JCK5b-t5Ht1Ua4F0ay1BT0ksT5b8VU-MPHg&oe=6A36C09D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U_KTFr5ETbAQ7kNvwGVNmHj&_nc_oc=AdqwzQWaG80LvLKuCngli833vUQz-lrnB5_ZdnyMvDXaquRH8bXGn4IugnSvYPKVrxI&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-zcz-lITw-juAiDAH7lTtCfeIk0jUFtkmO4OCd4rNvwQ&oe=6A36A881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wPzNEqWw2YAQ7kNvwHkVoh1&_nc_oc=AdqMP_1mUPQ5qKoq-JoYH11Dgs3J3Ahz5HZwI0IaM75ptM6klNmiwicdQfe1qAHqD5A&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99-FNy5RKfUqdXJzZjeF_FtLJkkv8ZdQXlpIKmOiVYJg&oe=6A36C375"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devic
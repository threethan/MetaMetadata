wMvx9yu1VN2J97pb0r7OerrRhW5HXcHnhl3xY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sQLiRuGRwFKv1IBCfpIXSMRg_oKLUlFRm_EJXZrT1_w&oe=6A282C8F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LqARo-bf2YsQ7kNvwG1B9rK&_nc_oc=AdrVP77iiM3MD_5PVscDx6cIlDdHMa2DR0QmpdijEHKKoiOQthrxaRqOeg8IDPpjWCc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8xQXLC2C2Ys6NaCYQw-3fEDv6rqOQYh7bgjIQMdW1jMQ&oe=6A283621"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZ0CjiLRocAQ7kNvwFG_ev7&_nc_oc=AdpVi1vboJ6ZO9HnKPjPm3unRmlabdzfbneFphCdIEBxHDYRdbGi5y28dglnx_H3-qI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QTWmnP7leJN7QtGSWiOSL2ZLPDddWGg3loM8Sdp0q4g&oe=6A2807DD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGqeZJK7x-wQ7kNvwFFuHMm&_nc_oc=Adp0vxmU6Rorw2Hu_pOPYejJFBXNYfJ3zxvn8SXKExQ2mR37w0AHHdMJfOvzBW9ap0I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cKw7Lwg79dvK8AXF05OtUE011Y-4pLOKhHE9nc_m6mQ&oe=6A282801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jYNnPegpLbgQ7kNvwEtU6d1&_nc_oc=AdqWW_i_AY_2KunpJx785gH8ABHxO7CrXDisInaYlsRahZzjXXQWvx1MhHwutPbaK3g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_iV7xTphelXP27S7SGJwTCXPeThWty6hv91F-HG5NuUQ&oe=6A280AB5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
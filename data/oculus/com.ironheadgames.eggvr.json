9824717", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4b78mXg9iqkQ7kNvwG5J1Ww&_nc_oc=Adr_2a-yqGu1aNJMNFzyv_DmM8NGq7MerjbXgXRhqE1dNxJdZ3cPQcRlKCtf9jUIrZE&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af1xbuluk5YnPZ0N_P4MgyrDpqT3mUN9CCNnZO_v6JZQLQ&oe=69F1F061"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i99QZIO_v0sQ7kNvwEs5s51&_nc_oc=Adqz47yXFU8zNWuuyHZDqBcLL3HLg--Y_GquXKgOyroqbtLOLqA0wY36P_uWws1eWk8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2gpHU5n1uYa8GZBKW3khA-bZwEGta-ai90g_xWucZ_gA&oe=69F1FA5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KDOsVDJ1N7MQ7kNvwE2DyOl&_nc_oc=Adp3BOy1Yd6kW-yepqaAWOeCBKNuUnvLO_Xdp-hRC9JxRx8q2wO1d4nRlLncAn0d8Oo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0Du0461iyiGPO5WZ3kwV1QccmWazX3DY-LC0jsn7c6ew&oe=69F21A81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=79w_n0gM5NMQ7kNvwFQJYa4&_nc_oc=AdpVUkfa0jH6uroKjDFQ2VlCPTgQZ7SGu0To3qID-tl48tq_fRnmhFj4nfMQ2MGKFAQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af33Qqoi0oabY9RDmT9BaOPIJoQrler0-5WXovyD8PKWOg&oe=69F1FD35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7275543395800660"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": 
m&_nc_ss=8&oh=00_Afx9hWUcEJEYAY-wCUKy1WgHQBQvB4zOwwY_4pB79xRANg&oe=69AAB5CF"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBGCjTBVbFkQ7kNvwH_OTt7&_nc_oc=AdnB84uab1yalTg5GNOFElS9M-Z2CbO58BVxtzeP3T8dsXpIm3qjF13ASsZUoC4DZiY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=8&oh=00_AfyPq1xuWZA0X9Ea7YQiqWm9PlDdOfvfO9F_ek06zijnxQ&oe=69AABF61"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Er_AcDGXRYQ7kNvwEcyAhL&_nc_oc=AdlkbFJZqo-c9ikQzcENhchSiWIoEkWOmggq98qUFfLvC_qV743Woq0mlAeTlXMfJR8&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwYO7DTRrKPewLlWilEY37DXM8_6HX_MHiwFsKjQtdiaA&oe=69AAC95D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imEo9PaeoS4Q7kNvwFxtgTz&_nc_oc=AdmWWHoNos8Jn5gifKAsAqLv1Bp9dsTN1smmIUqyymSIh4tgUuYCQTujLXGCOqTobkQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=8&oh=00_Afyv3QkS_Y8vO-yfaS2vPFXQUOhEGIzO4Iw7iw_w-foppA&oe=69AAB141"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bC775hE-l6sQ7kNvwE-cpDr&_nc_oc=AdkrpttAg_obzdjjCNrcbWFwX216jIwjr76jspNuiNNlSK3gR7sTArlh8QVt4Ae2Tiw&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=8&oh=00_AfxTtRlPfVSUMyGvDI7cEyTxCXHlxXXBm-qP1nf2jCoc5g&oe=69AACC35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interac
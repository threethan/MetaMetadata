oH-FDLS7Pnx3Ni9391SWQ83bmWYgKwxTAkNVPcA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5c3dX6iW4MsjjTyLTrRY5mLAqjooVQw_ES46gyoJ6NiQ&oe=69FDFC8F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVbsSEvLdN4Q7kNvwFcVO4A&_nc_oc=AdpF0zMW2Ca-XSesfEghu59P1FjdwkGm5Vhd2CTYEZf-DhNP3B_JhPnW40rdlZSM2jU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7dOFuB58NCcIfM_T3rpLO4stuShtRgVMl-Ta-Ve0AGNw&oe=69FE0621"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XFOGG7BTLUQ7kNvwG3X2gb&_nc_oc=Adp1UEgxzwBCxQzX5rXGD4tj0IJGB-PUVpM3CztV0p5za5YinNqexCKhJEY2sVH1ftM&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5DoiUqlZqaHVFyd8simn90-df3fDIY16X8A2uSaefTtA&oe=69FDD7DD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lDhXX3ZorIQ7kNvwHu_z4K&_nc_oc=Adr598bC53EhKND3u_Mnf-tFt63qapicgBSTghZmn4_fu1EV8mHUiTU4Z8drV7KZU2Q&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5InW8BtOL0NsQjbeviMzPMNrL4PD4EUlJX9yi4iNKxyw&oe=69FDF801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWF-dZlzmxwQ7kNvwEV-d8U&_nc_oc=AdoaNOLiYjlUs0MPr50b-yuGzgaWGt4yD65-9qBZc8FrMo54YTjIwLU6_XUgWGfiCDY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W_d80Lj4LuLNoYLVng7Po22qyZ80ao5S0WJ23yxNiVA&oe=69FDDAB5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
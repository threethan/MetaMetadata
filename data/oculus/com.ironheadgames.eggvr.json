HVGXerU0IxuZpD0N6PGeFm_cc27rRUgTuEdja4I&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxSw_B4GBY8XTgFgJKrjPInQM0VQT0WQ2Uaxyiuo8Smkg&oe=69C513CF"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5kMdCHDCFoQ7kNvwHpXjPy&_nc_oc=Adq7-nJwfXGvgKPdlJSscR55X8Byc72sXlwZMcJ8mdivaupGgDS7tk0SzOuuqFnhZKE&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwTg8npZPGGeOw3yLj3tIjQq8Vp1dUVCeTo5csvFwKDug&oe=69C51D61"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w2TcbT_CUXsQ7kNvwEOo-sQ&_nc_oc=AdrFqmB44llEyK1JukcTI45My9MV_1Ht6kNwCwoVGT5wIVK9vKhkI0n_b1mQ1eKJUvI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxKx03E9tuhFs2hI4FlqajeCZ_AG9-0_gVMHIrO67Vl9g&oe=69C5275D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T34NQHWLl3IQ7kNvwG9Igmu&_nc_oc=AdrHa1jX4fPhJfHwbbOW_1RMLhlIKVM_4MLuDOg6P5YnRUb699oEmxRju88dlginOUA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxT5kwYdM__PXVy9kuozweBvK4mU6ZuUpgtF3LJx4EQAQ&oe=69C50F41"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2_csXmIv944Q7kNvwHp8e6c&_nc_oc=Adr2qeNAv1DaRq9lF1uHFpRUrK3u6pENn9Hu71qkLNejiL3T31xjN3Uajj41m-AQEHM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwZBVFOvcNbh1_lMEtnMkkP444G6qLarDYtEZX8apQDEw&oe=69C52A35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
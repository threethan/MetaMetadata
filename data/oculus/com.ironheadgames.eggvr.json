Zdlo6YFOIYc5sMusephrZOkpgzPzjvNEFe5xQIEBLdm4m0rfzAwDM&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6mrx8mKTmGIwXfX5aVt-EUB1bIsSbriFl9g8hy5Qr-Q&oe=6AF9CB0F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1S4R6f97psQ7kNvwH05iEN&_nc_oc=Adq7CDHScmHJ-c6OlPYXSZFXy9PVDvj-gKjL2q48CgSb0LXhsdfBtygS1m8rG5y9I2w&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS2FJUzk4JFc0DaeIZgBTBj7YFmo_mkXydtkafBwewiRQ&oe=6AF9D4A1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUaua9MteC8Q7kNvwE96ZRB&_nc_oc=AdrXCbg9Z4gpSiRnoqCGdgJSh4ext9_1IYIps8DJxG6QOro42ftaoeoD_6lp5eZcRc4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSSHKVGscC_lMpByV6ksqrINWJgndOyGI7tVYShHWHaOA&oe=6AF9DE9D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=emK4dgsvIHgQ7kNvwEziGTB&_nc_oc=AdpR2i3GgxXzX6SyQHJ89P8eurZlRvnGxln5ARi875DFHkZ26BvOx_72HTXeY2fM-_4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ-lTRPzYrx1xBx0JSXXl_BELUoRv6qri7cWVaRWQdCEA&oe=6AF9C681"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-mMcPXYv_YoQ7kNvwHXDKTU&_nc_oc=AdrwXHHodeFG5BgxxNp2zUc8vJzjmv1gVZMGV_lTvmf1Ju9zm_tr1gAsTv3jpbmul9U&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQREPrHy4SYxHDPTP2CTaMkmAoL0N0gY3o0FwEuMHgLRtw&oe=6AF9E175"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": [
p_y3BJG9YI-ON0gWvAVjB53LsVYsFznHxjeq6Ri5Xg8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFlUk6ZiwsftDvGF9PWp1E6p_eZ1TSb28RiLIWp5-OmXA&oe=6A8048CF"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4RFO5dC1OgQ7kNvwGRchUw&_nc_oc=Adr-8Zzf238a0nB--nRQeVK0jdTlTDitVl2-VZMPd4BWU04NjxVz_W3a7Ui5Bt6PGw4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFMIyIcs0Jei-weBQwldHsZH7wceEkvaaLyulswq5c9HQ&oe=6A805261"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bjp6v3qCDwQ7kNvwFMxi9M&_nc_oc=AdqfKjsHSu82dwyEIc1zcuNrvxLHVK3wO34-1tTPy6hISZpx-rg4i2bnQWr0bKGnW2k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHPA1mkRIUgcglz2V7xh51sbcS1tmAeMqjbZZfvdhXBRQ&oe=6A805C5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okju31aPEtoQ7kNvwHsfd_H&_nc_oc=AdrhQ10Rq8zjRUU2piZXujWanC_z7pW_u3-_2-DB4qKbpflmgJliySI40TywtH30NX4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNd8lS5nPZm0-G_Hn40lhC9Ewvc80cAzARiItQ9otvgw&oe=6A804441"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkQGCDko39wQ7kNvwE1mEgS&_nc_oc=Adqm2sq4iNc88qPVoG-ZjWbS9v45aaKXoBTkdGWKpw4IZeHLA4TYDreI637BemjyuSQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEjXj061tsIKQ28d-OufjO9bkLoyizBTwxh-hPcpRH2qg&oe=6A805F35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
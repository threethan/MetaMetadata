HNeAJpIhRI3-2OHMp9KIz3nKO3n4kfA_d_IYPn4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxD6vnCC0FsoYX7LsuNGmBlqW_uzuV2XuyUt78YzaehvQ&oe=69CCFCCF"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KTTRzJYQD4MQ7kNvwEhAyEV&_nc_oc=AdoLol7c4oPxMprghYxcpnMqatIcPLbtT0lAdYOammHuAORxE2g1mCS6q9Lu9VTqDMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw7q_kRMEKEZMckdn_pSgPNbUghtXqzB33UbSdQtjuJhg&oe=69CD0661"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_4v2v3_8TtoQ7kNvwGRjTGQ&_nc_oc=AdocEpCOryYGA5LALIe2FrnzsUCapKxtmpIRT4t6ozjmc1eSfm7euH4WVS5t0vV2K2c&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzp99VstmjWt3aFNIxh2FPmjCmDCCchrv42S8f2NnpN1g&oe=69CD105D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AcrE4KmFpesQ7kNvwG0G-7k&_nc_oc=AdoJlIZ8MSm6J2SMMjhTBsUzZHlUodvzyBLOZVKKm7E4580rs4emI0tiyh-jWU2czjY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwvzuooKrIgOaL3fg4BeH6J-11Jv3IP1PUfmioIfsZPKA&oe=69CCF841"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Tqz1K_A7SAQ7kNvwELh1sv&_nc_oc=Adoh34-wfOh3yqF9jCgmhRt2819WryoqWwTE3QbOTR7SdkBtdQQzIC7Rwd74nB9TPZI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzWbV4KcT-3o1qMBAwoQl9hrIPs1IZF1AsnSLy3C9D9Sg&oe=69CD1335"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
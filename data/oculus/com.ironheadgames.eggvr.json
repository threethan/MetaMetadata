2SFM5BV1ukttu_8jaVYNx7iV-QmnKHiB9q0wXxzkEgU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFjTbQtlqdCqz3LIO9nqt-Uam9kY-HjLP0dMsSD1oR2CQ&oe=6A73520F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pyijlb9hk0AQ7kNvwF5AfSe&_nc_oc=AdpAac4au2uOMyNhsMx8jVpX4uCDR7Sx_pYPmvd9qZWraN3wUlrn7tFI_E6D1wRhsNc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEqKtI2DXkqd9SFrJYCr9LLzv-S2bP5mSEsvyt5qRBwmA&oe=6A732361"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G6k5t5tb3C8Q7kNvwFXLdCB&_nc_oc=AdqGtq54HexHcaRjEPh5TdrRDz5q-MDp2yfgSUYaYV2egBtv6MBFbZoMygXo5yVCPoM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWOwyslT5aJXe_TC2u3Ayq4oOQgKRgwvaPJcWcckO-8A&oe=6A732D5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Bng4hX2vhcQ7kNvwFZLCWq&_nc_oc=Adq7BLejVKPOOjDk7xRn9fC4DctkPphQyAr0ULEZfMA6QxHAmmu2Kh1fEFuitKptGHw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2_gAJ9Y9vCK65ER2Fvx5T78lZ-rtzHjtHmvk56xYDwQ&oe=6A734D81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KHGonR87GR4Q7kNvwHNCPrm&_nc_oc=Ado8AlgcWatXMq-5MQV15dPCdKKx1JImJjj4kGL1-VofDKS3egWBCNWU2Pqo429zWbI&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmMyySfszxZikg9dJjtOeZN9keXnT5wTsj7KEyR7hYkA&oe=6A733035"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
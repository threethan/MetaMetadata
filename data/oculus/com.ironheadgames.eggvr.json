b0XRBuqImXuNww2W7P8Ls85y7EQpxmDJi51EFcU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6a1-JFLe8oRpBo4mKd2IGbtNlV7kb8qV03V9sKP174CQ&oe=69FF4E0F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BVbsSEvLdN4Q7kNvwGlCQV0&_nc_oc=AdoVFS07MCTvLsQr92YqbC_r04m_I5m9wszdV1c4kBCJBK3XbGtLH4hSQjbhm_opxXU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WRDO7flG3LCwNQAx3ke_0GQVY7ta3vsHRyF0M8eTkRQ&oe=69FF1F61"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2XFOGG7BTLUQ7kNvwGVKPN1&_nc_oc=AdpfqNpnqcP6-HfCj0RHLokEx_weDYyQxhS9zzayeO5C_28O7r7Bk3XEy-1pAHZXtCE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7DqbD92e0tgtZEJugDVffuo8XUrQH1-p5MYKi3CCeYhw&oe=69FF295D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lDhXX3ZorIQ7kNvwEeSVZF&_nc_oc=Adr4WdNaQNISCPCK_p6w-GFzHiGOVu0qtO1xTsBqlVi3vi2WSjvg911LN6HBWYkH6oI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7L5wHRkiCQ7z6n14k5IV1MOwg1x0-CAIZijUTns_arjA&oe=69FF4981"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iWF-dZlzmxwQ7kNvwGM81Jy&_nc_oc=AdouhD8kLj3g_IJZK2ltNHwhq67wcCtD2VS1mEEov3TZ3aDmwflQpkCxFISRt2lblww&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6fk5Ide9dKazsuqyKZ1GH2INOhyf89TGLtz4f_sZnBKw&oe=69FF2C35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
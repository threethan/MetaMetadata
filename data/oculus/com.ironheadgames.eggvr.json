m8whC9RH6j2GZBuv8qUNRDL_MnaYSipNJGPRydozZJRLb0v34pcHtg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PKPDpneoE4nc7H-dUcLyC3cuWfncOYPVxRCDq3MwiFg&oe=6A22E68F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avN20gM0J6UQ7kNvwFwOlPQ&_nc_oc=Adq9tu4RmhfSkUF-KBL_lsKkmD4TJdfnStO9xEbv4nqEXcTbIUglBndB5CEV2NGpv58&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SPAxxWDK1XfPkMpJnBp7Q340IYi9jJGykfNACkbU4wQ&oe=6A22F021"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01uXOIck1NAQ7kNvwHusc3e&_nc_oc=AdqCxmPQ0Y9FGmaL_g2fj7KnC7VsCPMRJhVAdwiwkVgF2iHzXQyvsy8r3jrzyr0jRrw&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8-qlhceIbwG56_UTv-yRoaQg8T07LL1JO7r5UnGPYCOw&oe=6A22FA1D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2w7vTvgg3gQ7kNvwGKe1I8&_nc_oc=Adq9fl19vFjjlXQm_xVgteRV8CQLdYzYShglR6Fryf27QjLfRJU6dey3_kJnzcOnmwE&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-PsIDFqnSi-nsDsDJ1K-LRivz1BmmnXfJVK3cMpaWm-Q&oe=6A22E201"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3Q_uuIx5gQQ7kNvwE4GjWH&_nc_oc=Adp6jhtB3rx0sjFRf6o6DwWZCWRnoIsRD6vpksoT_YuyGZ-Ab6jXUtd3-TKbqUM7GYE&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9W-squ8fHjqWm0fuuTnq6GPwmX2_pLpo3tQK6emYa5jw&oe=6A22FCF5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices
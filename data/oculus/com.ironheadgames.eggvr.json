fs7kQcQ1vvLDT7tg6gpNYLUNzERggSNLphWlnGJ3Z4VBA&oe=69A9644F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PBGCjTBVbFkQ7kNvwEfHCOJ&_nc_oc=AdlmzmIhWm_lxsr1Lzs2H8tKsC2oJyiUVhTlQzKL9TfDpiEl3lKfOn--4eARrLQ6hnc&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftXL0-hEoh37nqPU7CcNvQFwKbMUNp1gbnrpOXTizJdNw&oe=69A96DE1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6IxZyFggk8Q7kNvwEXIyJ8&_nc_oc=AdmOQDTO4HPcbAAvj9G4oWWam9chBZQA5uMp7W_u5TPeMQPiRN_puxSliFL5C7eVEB0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Aft2iL4EHrMXmzzonJtp9T0NoBJC5XUcbqGE--42gcZAyw&oe=69A977DD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kt23qz4b_IoQ7kNvwHziNcT&_nc_oc=AdkZHQZMXDOolCwJ68xQCDbOKH6LK4FaukFMppglTz0NtKIzOZVkx9_6N2Qh92R-j7w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_Afsjxonr2YiKD0wO9-OCL2ZMajUWjgcRL71g4Yb5Rkv07w&oe=69A99801"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_eelYdd8cuUQ7kNvwHWOkAZ&_nc_oc=AdlK5IzScCwNYw1C83lAHsy3duwI00evTXTEFjCwVNmxto8nPTzKucoBNZgtDuUAJrU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AftYpZr4k8Dho_ocIIt2l2JGciEX9L-wOVldYQsaVG9czg&oe=69A97AB5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI
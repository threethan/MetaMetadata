MjcpP0ksn5mMhRHziaOn4X7Q77GpS4cJ8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53hkehrWO2JJOr2F3qK0IPhZZ1j5BBGBxic55BFDIMOw&oe=6A17090F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G8AOhP5jjosQ7kNvwHRB-2p&_nc_oc=Adoym7NAH87yuim60l4AXhoAKJhIaQDqcXdjKR6fuRkmnmV5QNpmivwHDq4O59YlS8Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7iBvUMAM2MoNx1_OsWd0Fqxaz6i7w2Pi5pBo3wMoHctQ&oe=6A1712A1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L8fDyzSplVUQ7kNvwE41Ohg&_nc_oc=AdroAVfCOhkHhYWm7i8z8mxDVEEpS80FX9aFEEm2HDfAZVLiKIXCi9o6X-gKvyzeVCc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MXxe9keZQNmqM1jM9AWcOSe-cDFzY2VIK8raKeoWuHw&oe=6A16E45D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGGyqjdvnxIQ7kNvwGpGZJ_&_nc_oc=AdpUd-_zNIjA6KPZaaS-jAswg1SWq3EFOAFlXEwRH6X_hS8FhExoRO2Vxv_lQdZV9oU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5B6f-NCisnns9ovNHqEZ_jQGcWQ0Yc9qSOlRoZ0-2DOQ&oe=6A170481"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pz3SULJUC-0Q7kNvwHqH87o&_nc_oc=AdpbTcHjfboSgYlyr3OxBOqPdvhcqUkT0nBDWUhjwaFdnBrldBZUSv3MPRBR9oweGH8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ucVujFzS-P__z8vrWWuIfE_DSnbts823d99rhfB6sAg&oe=6A16E735"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "su
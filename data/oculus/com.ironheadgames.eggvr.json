_s_UC__Rl1b0IiRRCsttDaX4-kfBez5SdyPydpHfqpc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7H-Q8ihobmYrpws2CgGGVDqwxFXlkChVsL0k_zwvFlw&oe=6A819A4F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y4RFO5dC1OgQ7kNvwHDDklH&_nc_oc=AdppTLjY4bLo9S4VIAt4SLM-RiHqgAj8JvH9Zi5QkiibMBEm79Z7uqkcSwDMIAoJhUI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0jRnQH0NHzgkgZhCFzaapgJlrOSd8K6yw_QSB75zg0Q&oe=6A81A3E1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2bjp6v3qCDwQ7kNvwHgjeXy&_nc_oc=AdplU-NI9aqiV3UAD_RkcmsePcKz-ttOABIPDD3la0SU8ey1NHDUwM-0b25E7poypbY&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsbG0G5jwy5SCPnStmKt_czRJ5ZfjpKwTEPGiy5TkRDw&oe=6A81ADDD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=okju31aPEtoQ7kNvwGDXbeX&_nc_oc=AdqnjL78YBKeraREbVnQ4Y73CkWKTKRm6tDmOS_-BHA6njDB3wghnapC5rpySVvVbgk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFe6lhfJABNaTLtcqG_WZznrW4CMH0bYHxtMHk2EUP3_Q&oe=6A8195C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pkQGCDko39wQ7kNvwGdTT_m&_nc_oc=AdqJnR6czV946HdtB9kWba4aFrj8CbJ-TkEVfM9gEu7cIIwE6EKYRFfEvyBWeI1ucgs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqrtbOE7RhnIi0H2AzW_XtMd8dkZHgoAl9tO6z2TWMKA&oe=6A81B0B5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
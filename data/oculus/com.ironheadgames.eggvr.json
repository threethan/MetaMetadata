tPBcaFw_Vmq9zehJaKcC5uwMzMhixwbx6cHvH0g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwfz9tNof6JMSs3q5h8iTvniVoCoazAvEt5snWGa9Oc3g&oe=69D0F14F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Y-Dd97TEmUQ7kNvwE2Ev7D&_nc_oc=AdqHo8xWPk_fviUNdb2kP2oUSSS-p9L49vl4iuhv-9TEYVDTX5dCpSi44W3YfyH6IRo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxnfVvvsEFp8q-EKde_LM7ivpqBPPt-h8BlwCmnaPPjeQ&oe=69D0FAE1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8YQa56VM5ygQ7kNvwEol3h8&_nc_oc=Adr9VlKlMzvCjdxgxLYyzl5QadESFOC9LrUuFD1nm-EaFTQOchPElULiNBTbG5CpwOA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyeGgjJINZAIEJNw1YcX05TBptqOm5NLU3PLNwpjFZEGQ&oe=69D104DD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NoJ82wLeO4Q7kNvwG7XUzG&_nc_oc=AdrUgsc15SCspYUWtxv2pepTJ53Dsd3GUOFCaJ6qjaE5dht_q87F2dw9ogVfYC5j-Tg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzLb6adqxMqidFG2l7vzwr4dgRgrNm8qQtf6xygCEngkA&oe=69D0ECC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AFe0l_DL3F8Q7kNvwFN3fOS&_nc_oc=AdqQ2qdjFMlJrZ6dw32-9-9EzYhKgGd-F84ACmAlNAaLsyKg-n4wBsOGdKF6o2FfcS8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAavYXYAixMLfLGelZi8DNJncsfXiZsEBDcYOCaZxDhw&oe=69D107B5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
UJFT_TpR24IZ31rPtPETZK1NHs8qSTnmXh_89-o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzHd4YNsXaGv7PwjX7AY8NUHU3XHHKGK8z0DvgOAUsUUQ&oe=69C7B6CF"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s5kMdCHDCFoQ7kNvwHRA4Us&_nc_oc=AdpYuUeAse-QS_BIE0jbEnEqNFpcEM9Y3qC7oH1pkUxs0u1xpwTCBSI9qczKRF9vzYM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzjD4N2udvNzuCsBjqt1C-Ki91MTY27Xo3oQh_guB7c2A&oe=69C7C061"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcMFWnaHZhMQ7kNvwHg9wQ7&_nc_oc=Adq_MLcHWBOyd3dssLc-yYHn3IpovvPuV7i9YHC5ZJOVd_9g3P42po94QEkWh9UYqmo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAS-lsaB-7j0U0jmc6tZohlsW_d6bhGkMvClKKTUsIQw&oe=69C7CA5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UeZLIUua9YkQ7kNvwESHszR&_nc_oc=AdrqlXfjKfTnMp-oWU5XrexQHyo-7UlJ7IglQCA2nyWf9KoVrgLV2uNj0HTS6gZN20w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAKTZtmiveetypwEBKRIVkCq6OzLyN__A7VTiaIaHCzA&oe=69C7B241"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wJStzGHPTfsQ7kNvwGzTm1-&_nc_oc=Adq_tJ-NdhQPYfvPTzePkTBvZAGqeEoHv49CzinIan9UtFEcmIjKVV7Zov60HyoyJ2A&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzQOL3ydj4bl_X-t4_0Dhy8CNw2Y-a2ZAhD9CueEQHrWw&oe=69C7CD35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
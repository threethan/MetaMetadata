_nc_ss=7f20f&oh=00_AQKEkbixyH6kKDRcxP754SsjyRPHyB9W70R2L2IUYKdNyQ&oe=6AB546A1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3woL4jHE_LYQ7kNvwEz5BUk&_nc_oc=AdoQPdSfUABn9PCMKUukE_7rlbgN-tx1NbWBdFKhp70UCErnMKW3iqOeLwXlh-5X21o&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIX6KXHea2i23OZEyO20-8Jfgq__5ECAau64FYz4HLquw&oe=6AB5185D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufHd1uG06vgQ7kNvwF36O1Z&_nc_oc=Adp1Ujyz2r_sgyLgwAcc-OpT9n5N6CHPyz5NpBg-uniuXpCAgz-JpE3vknC_7GVL8EU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL6urF5mU72OrjQl5p5wNSRnBhaSbJFmpSinpfTKHQm6Q&oe=6AB53881"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OIWyLMc945MQ7kNvwHgKnsU&_nc_oc=AdooiImA1eQTH3mEm2wZCWwqXCOrOYiGWlNEZ1OTWXepgLwQd_mEVmX6pLrtZB1aJTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJRQZ4CKr3u2kCvT8DBM5RbUO1Py2RyX59k891B25hruA&oe=6AB51B35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "7275543395800660"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "363429549830841"}]}, "baseline_offer": {"id": "363429549830841"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1707930360, "status": "PUBLISHED", "id": "363429549830841"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binar
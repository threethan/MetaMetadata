7b5OZy3RX2mSktf822BOLRsWTU0TT3Jaw2acI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Lv_kQ3y7C9AnF6ZGsXFyw4UGRYXw1p4FYYkGfn20DzQ&oe=6A43DC0F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bt5n1kiiUlkQ7kNvwGR9JTf&_nc_oc=AdrmGOg-lGOHu72TCiLHR_9dpRzVKoHEc9mYcy_Cv5pp2p0yYCjYDW8F8jXZ2hhMolk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_KJV8LwKxZnsKPAqgs-GzLf-GFoOw9wtPI-Hi0C1whxg&oe=6A43E5A1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cDrsyHe_qyUQ7kNvwE8z9Qw&_nc_oc=AdpcArYCyBdaTv2bKdg2hC3evj4mia4mW9JkyLAsBq9Mn-HOdGQZ_3KnaHFPGaHJOOQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8D6wPi1knx5g6z9rzDK7LhsgeXeqTqK8eklCWoMxO_lw&oe=6A43B75D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFfgVX0MqaEQ7kNvwHNt6Cp&_nc_oc=Adq3yFLMPJzwXPd2CxgV0BMFFq498Ghrr4hxMdtv-_yttMgrEI__hoIlhARTy-_nIpI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af87wOGVPaIjlMd3_lsVIJnr97K8PsTPUA_b1wget-aZ5w&oe=6A43D781"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QtitR-srbNEQ7kNvwGmgrjp&_nc_oc=AdrnADUxYTyxvu6z8CZ9DskCLCXDAJK2pwr2pUWfGJxqzNM-3Kfyy6l8ctH3je9zoXA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A0JBdHDyOpXAAqGKV2dNt2jW3s69i8Dc7kezWPfjqeQ&oe=6A43BA35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
RKobkey1owQCaH5_qi_mypPpwQpkA8QP8apcM_k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Kia-dEE7cCjDbGeHlWKiyy7qSsvUUKGYf9eumFZG2BA&oe=6A13148F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ej8MZV_7iaAQ7kNvwGv4wPc&_nc_oc=AdpfmxZa6aingwmiImSyGaERQoCRPyL39Py8oEpsBQhBdQMAy0CrqldCracSxyC6ODE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79pQR3N5jY00Ag93b-AecKoE0CjVNgi0PBBlcl0fL2Og&oe=6A131E21"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5mpUX8iN3NEQ7kNvwHZNEUK&_nc_oc=Adp2IZR0uqbiB2maRDjzg_eVkabJw7wTLOCbsvq8QoKRfF7U8SoAG0-ImGsD5rs3ThA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4l1pvnJsqxwQOBHiK2jcrJL0RiH_xer7AhrSgFFVIPow&oe=6A12EFDD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fhcHQEuMhbQQ7kNvwGdOjl5&_nc_oc=AdqoPL1nfxDNFAFFZgUBodx5H5rMUjlNUSJ8S57uIE_nJMRYU0GeeQYjCHwsw8Ds1uc&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6LRSRV7MzgMhd5aywPoOh8cCMJ2OPAnnw7o9vYFnqjgw&oe=6A131001"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y6O7uReGGhYQ7kNvwG3GS_6&_nc_oc=Adr3Gg-tRB2jmDW8dVsxHbJgZz4KqxyDHNgDBXxeaNJmCYQjZyej9iDHrzfZJXQ3iSQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6gmCO4Wdms8f8XYqrMhUPOTd5sNT6DqTQEocb-a7T-oQ&oe=6A12F2B5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
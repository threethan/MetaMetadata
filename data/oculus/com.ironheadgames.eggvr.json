4yN_PBeAU3MsBFIVvSJMU8gdqINyB2RKXMMI4Hw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10yRVB0VwDADbLrOXugAL9kA85VJRruOf0q2f8Ph7Y5Q&oe=69DF71CF"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iq-1cdeGdOIQ7kNvwEvXgxH&_nc_oc=AdrflV-K3j1EwhwOmHoL3reUOgO4GmUljTAUBQPkTeA-LQ_gV4Z91lXFFPhUdfeNk7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2yOJ7ReQO5lfGcr8a8p7S_PYvNi7XviH0fw7ALO8LDsw&oe=69DF7B61"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9T6pe4tJ_mgQ7kNvwEvEVL8&_nc_oc=Adq-YzfSWhW0yiauWEslYlRqToEIfap3wQl53MRGxhav9_OtfV7vyi_yA2TKAZNVMXM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2L3CBfHh4Y1BCqHoaN5VLn-ReQqzfawVyz9tgsAhyX0w&oe=69DF855D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U2vOSti37sQQ7kNvwG0auW8&_nc_oc=Adoj5gM8S_i5yKBZO9aLJdoLx8yXvHF1yNgmcpsuATefKfm8Z7xu5CtMkk2_phWggRc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cEHO2hXKKviEx9xTWLqL9OhEHdEPvKWZ24Oc7FcmysA&oe=69DFA581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk5qAWL8J0IQ7kNvwGwvh7u&_nc_oc=AdonJaMw7RSKlAKIZmzCPw56OTh_5fNjpcpceqzYvSeiZVMjHUQy0uMzVDzzbRQCWE0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2CTOa6bYIb7ENs-tRR9upTX78nEhfdCmfphs9m379Hkw&oe=69DF8835"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
Vo4S74H0BIA-hDKH-aHFEtq7jNCily8ECntiDBI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-QKGh8wRC9BnC9tImqBuACAn8C1yA6E0XGbsk9TS_ecA&oe=6A340A0F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYa7vgP4pmkQ7kNvwHcu5uP&_nc_oc=AdpQM1Uwrho58SxLe_h0o-zSu1yk6OQgb84tQ4HF2mFvBCf12dqAlC0lh9HPNfzMPCo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8EaAcYxet7mQhk8uAEoUZl6C9PPJK27N-J6_YMW_PWnw&oe=6A3413A1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2lfcz187lvAQ7kNvwEqTt75&_nc_oc=Adq09C1bNqILajiLL2Uqoc5k0y1T4qKyJyItArc8nSM_XNRZXm8H9u-6Y759e3HfMLk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af89xVqlGge0_Xr7N2ZwahXgmkgpXKt2HHPlk7ObF9wsOQ&oe=6A341D9D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6u_ri9ow6hMQ7kNvwG235gv&_nc_oc=AdrWIz_uikbKnKjUCUHa_2cO8oGVeTpsEJccju5uwm3dRdsYCDxgFk587AJLjjvyWQo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_CY-hTU5q1QYAEpfUqdxCxbBRLSCiJaKj2Qeywi6DK_Q&oe=6A340581"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ogrk81JUL6MQ7kNvwEKkuXC&_nc_oc=AdrXrs0R0l07uI7dVzsxNnFYm_2T4nTOb20erUy74dRlfY6EbyysJoe8lGjqu3JbX28&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-b_NmZfLYaomuFcI8ITvNTmI4_yRFLmLUvt7OynUR7Uw&oe=6A342075"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
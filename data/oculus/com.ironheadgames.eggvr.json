XppVBMlgd05o3HwPdDev2noqemSNi3towZG1M&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA4v71gf31LOKyHwVj4_Kj6XSJ9Xi2wr3C2ZRhxlOFtuQ&oe=6A53AE0F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_24GGugXwPsQ7kNvwHZe0MY&_nc_oc=AdqjqI7ducYnjUiiRy1jgN3TLxm0kkHimiz6DsBkfVWBMHF5bs-ql3a8Clcugfh5w1g&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDDdayc-2Ix3Syaan8XVNoPXc3sxHudt0lwlt1FrLoY1Q&oe=6A537F61"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-aSRKVkdfkQ7kNvwFngxOw&_nc_oc=AdrMjmtWP_zBkVRu4nIaPUiXD-PWyr_DgdpYWZ-C4kT08FhFyupHdLk1kClXEXR7bJ8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCRlS55vTkR6O_n16f75cQRCbL7UGjrlwKXdlNQyS9kvg&oe=6A53895D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HASqd6HsAwMQ7kNvwG98Dq9&_nc_oc=AdqVBM373T5h1I75iejDFwJIRR3I99QrgGTi4TnUWFqJf7LuQs3VD5kZlWWnqI5O1k4&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB252FlcJara7vU52NQpFLCSAorVPfKhteszu7wjmOllQ&oe=6A53A981"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XzAjnjIagjoQ7kNvwFACB5f&_nc_oc=Adqii686oy7QJOFxlQ3rX8FcRdvsF-OuNVeMCROYXBndUTVVQvZAP0zXAHAl1O3rZWs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJD2n63CIcZa3df-jkU5ei2Wj22vQ7g5mcEqBjhVEDEA&oe=6A538C35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
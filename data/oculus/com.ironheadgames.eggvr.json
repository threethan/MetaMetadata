O5CMvCzZdu4wo5uUvDJFuE8FoK3GCuh3PAW1DhFLCso&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7cbJxPuIHA4xJNmKC3FhRsbe-fL5_Y0mBqtvh1Iy8fg&oe=6A7B02CF"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BcUT8lZDYUsQ7kNvwGGukD-&_nc_oc=Adp8os8339pOuaxcEbBEwSIUbm6iv5KEkseii1hQqs05RQWbkh61Ii1IZI2LEavo33Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHa8W8ZawXGZWqceP3VQhpcHNQCts0-AzWJyIJ5cN20AQ&oe=6A7B0C61"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s1DvT5czcnAQ7kNvwHhenZ3&_nc_oc=AdohCYUhq95YrnzoUfNWFolLd3CuIYr6QEWAfpsIgsaite0H8ayZ0KHYRjzK4AnPtdY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHXfP22GR6cQcVIQJMq1Ji054g0Pv_sbgAu2I8fSiRuqQ&oe=6A7B165D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hslf9vgh0pwQ7kNvwH1VhCY&_nc_oc=Adrp3-LLwC-XcTUbOVNwRueSm5Lp0nzyyt3gRVxS3_hYmt97PHbIfzNy0FjM2940jvA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH3N4MMMi2RWIeTDTq_Jt5hNVhl7Te4rSUX2EJqE_0Lbg&oe=6A7B3681"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaMuVN_tmhAQ7kNvwEqXoOh&_nc_oc=Ado0tYJ8atZaIx_YBQMRzVu04X7tRR0ILng-HyUw8dyptlGRrKvEjx7E2eSj5XdYgTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0X0MOUmzVJ6o-kMmrvzfZKnZjEm3x1KwIsCDKXCOYnA&oe=6A7B1935"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TO
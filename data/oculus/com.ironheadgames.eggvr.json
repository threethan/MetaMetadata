GxPz3Or_1EB-hiITFMW9mxahLdDHRQAllCPuU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCH7V7stl-arXEqqYaah1jMUYGkjaC17CkWyAlOBQ_ziQ&oe=6A54FF8F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_24GGugXwPsQ7kNvwEWAcT9&_nc_oc=AdrHAFmni2RfJHEfS0tcCWcZ270UgfKoM2u3IDalqV2PSSdDunL_K-26n-FzTtPRc3w&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcMJtYvKM9kXWlsWsmcAqKFspPJCFCiFAmuXrmju3ghQ&oe=6A550921"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBQdkQxwz0AQ7kNvwGggoh9&_nc_oc=AdoyDWdjf0R03voWKI9kEPUbPI2Jp0DZR1BXijSl78BaG06nIZRg1QzWuEF2zq_6r2o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrTx-osd37g8ImKAEVi4dMXgR_wVRTfZkhre-wjUQA4g&oe=6A54DADD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdVg_1P3BbIQ7kNvwFcIS86&_nc_oc=AdqPX0J5dwrXW8ptsnO_5ItS3TbDnD0cwaoYVOKL5bgDjJt_WvcmA1MwgU5FamRvYgU&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBL8sM-FkY7eFbTLXAFt96yytOLQQcP93nakLpUMVz0Yg&oe=6A54FB01"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eYAR9xOlxh4Q7kNvwGrgOuS&_nc_oc=Adr4CgOCbozXq7XMfbZM5lRWGrR7g7ICCYVefHS-rIx-4ES8CeI4qj9-lv7uU1z19us&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCaD-PY227kRgiiSv4xJt80W271_bVDXMXBDpahVgC_JQ&oe=6A54DDB5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
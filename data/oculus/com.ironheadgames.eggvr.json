SIprMizmQImsbGkW_eaMImEQDlPAJ5jKqR42A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBauhnTpdkbflBbBO3X8lxPI9q0y5MRDlr9Qjqhc_ux2Q&oe=6A4E680F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sUCm3eBXXzoQ7kNvwFUSm5f&_nc_oc=AdoQA2QOBGiN2JR0BdC3AjqDTBfqPcQPxeSpqk-PxY7Okl8TPDIF4EWlGgMsXxtz45I&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAZK7Imzp-54XOwMG9yjnqfrUyUOjS3EB76wnCYW9sQsw&oe=6A4E3961"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eWPwP8GDB6YQ7kNvwGTOW5n&_nc_oc=AdoAQAEBQEeH1bZgeST-y7CJYERAbUsz62y_Wprk1RfsX0C6_cLqNo1PklF-Wced-FY&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-fGwlP1mnFe0wxtjCv9ELEDnVJ58bnTEGgHBA2feXLA&oe=6A4E435D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YMBGZ9Kbk3IQ7kNvwEEd1M2&_nc_oc=AdpWEtVxx7omo2EtXgu6Tg0ynncyFpPnWdfojvhH2inmXw_VTMNgMRCh3j29C9Og2_Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC1-hzkoJpGjzc0rxE1SeiYvBDAbhNsFESNuEXp4y_YJg&oe=6A4E6381"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZVVNBwOVMAQ7kNvwGvTNni&_nc_oc=Adocv2ISW8bvlsKqIFSA-tAt03qxZJ4ZA-M2KkLwQnmbhEV6qSpozIotvyK4eg0T_BQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABZHRxFxlt8wMIwbd7AhyCujLpgcf-DMoVU7Fh4A6C8A&oe=6A4E4635"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"],
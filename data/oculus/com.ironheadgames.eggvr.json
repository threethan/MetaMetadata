NZLjWCwOUjZC6-tUHkaVYk9GBOMcSEjn_LpEHY8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af219rOcFqveRZ1iiFlpjN-ASJcehFqyp3e19J4elaG8bQ&oe=69E4B7CF"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TyJdYDkJMLcQ7kNvwF077aw&_nc_oc=AdphhVtYcpCymbVJPqKAKb1HyGJMZwGZl96X-sd-21mPlucVYt-Nag69YVIu1X30Z6A&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af10UuT7djhrRwCq3XO5hLYoOPiFFc_KBhTkz7ZYM8wMQQ&oe=69E4C161"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tz6KX0eRDdcQ7kNvwHmQr0l&_nc_oc=AdpIM7XNNkKXCqwhIMXN0Kv9fPvBJ93fs9NFy7jOMxOROAVsGB5_c7kPJB7p3aW9E4Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Gh5JOr7kwO3msOh2L3FR251_uxyv9RwP3UBdXiUeHHQ&oe=69E4CB5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CEPPAFwnmQIQ7kNvwEW-42D&_nc_oc=AdoDx79NvNzN2NTLmrgp0MHY7qnfazy3SVZyRZIxShvGfoPhXm3OMPiuAiswKRLZ0dw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Ne5QPk0F5euT6_I77Zx0fNaqm5aMFzJzw8izeh7SUgQ&oe=69E4EB81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LaHCPdtTqxkQ7kNvwHcXFzg&_nc_oc=AdqpSXA-k8Qk62eNTDcQ9S5dramEDoYuAIJZ8cLl0scA8yWJtLG9t9XHshxMw4okMHk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HRxePO0uMFVrHbk4fxQmesSr13kcterDkQxItj623EQ&oe=69E4CE35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
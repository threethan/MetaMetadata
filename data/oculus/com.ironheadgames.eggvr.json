om/v/t64.5771-25/499300619_841714195009958_216825495650438070_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1AuV8bMFsacQ7kNvwH8cFl8&_nc_oc=AdpTFBrfif8Fh3-lX9LNZitoyrN44MzVqDBtYSREOY8V5S2alWzUIo1A7hPQ_N_M5aQ&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIA-veV33qSsiwiO0ReBBs8ZXgcctvAoIWwnuN-rUF0WA&oe=6AA9412C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Cover Landscape (4).png", "id": "1393329596074079", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/491823930_1393329606074078_1309265898559846584_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1ohIUyboTIQ7kNvwHVCDNb&_nc_oc=AdpSfEm_Vh10PeSCcSstvQh_DETxLyT93MlOhUv8VM8JWdx2Wwxd_2IsxtvDTP_0-YQ&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ9eyUcl-u9HTQJnsp-5sN2ZZqExIsWU9nVt54y0OvO0Q&oe=6AA959F3"}, "display_name": "OG EGG VR TITAN", "keywords": ["scary", "baboon", "dino", "hero", "fun"], "long_description": "**Run, climb, and jump in VR using a unique Baboon Movement inspired by Gorilla Tag.**\n\n# \ud83d\udd79\ufe0f Mini-Games \n\n**You can play different mini-games such as:**\n\n- **\ud83d\udc40 Squid Game**\n\n- **\ud83e\udd88 Steal a Monkey**\n\n- **\ud83d\udc7b Fun Horror Games**\n\n- **\ud83d\udc12 Hatch Egg**\n\n\n#  Steal a Brainrot\n\n**Steal Dino Brainrots and raise them and get rich**\n\n{2842365595962805}\n____________________________________________________________________.\n# \ud83d\udc7b Horror Mode\n\n**Run away from the Baboon Monster,  and fight against the boss**\n\n{851464257334354}\n\n____________________________________________________________________.\n#  \ud83e\udda0 Smash Mode\n\n**Tag Everyone and swing like a Gorilla or Baboon**\n\n{1317578033136114}\n____________________________________________________________________.\n#  \ud83e\udda0 Giant Mode\n{1554376978890768}\n____________________________________________________________________.\n# \ud83d\udd2b Shooter Mode\n\n**Play the best Rivals Shooter game**\n\n{25044154225189929}\n____________________________________________________________________.\n# \ud83d\udd2b NEW BOMBS and Mini Games\n\n**Get eggs and hatch them. Name and ride your chicken, snail, or your dino.**\n\n{4134103796903773}\n\n{1852341419024466}\n____________________________________________________________________.\n\nAnd try to survive in the new Forest in 99 nights, Egg VR 99 Nights Survive from Deer is Coming.\n\n# \ud83d\udd79\ufe0f Mini-Games \n\n**You can play different mini-games such as:**\n\n- **\ud83d\udc40 Squid Game**\n\n- **\ud83e\udd88 Steal a Monkey**\n\n- **\ud83d\udc7b Fun Monkey Horror Games**\n\n- **\ud83d\udc12 Egg Smash**\n\n\n# \ud83c\udf1f Become an Egg!\n\n", "short_description": "Become an Egg  Hero and play all the popular Minigames."}]}, "developer_name": "FutureOfVR", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": "https://futureofvr.games/egg-vr/", "website_url": "https://futureofvr.games/egg-vr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "528142316460358"}, {"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "MULTI_USER", "MULTI_USER"], "id": "28176416668620028"}, "review_messages": []}]}, "cover_square_image": {"uri": 
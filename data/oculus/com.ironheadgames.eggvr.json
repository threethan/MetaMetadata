fw6Y0GXREHdWmMv24bwnN7wuH1v5ByohuDih9A-6BY5_Q&oe=69B6934F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PaLpZlCmMmEQ7kNvwHLm9fZ&_nc_oc=AdkBIvMJpTdJvMKyZwyiUcsx7InTt0tZmRagl44ZJroJwuJRTrqB29ZD1wBgTwXv6wo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfxoVQODo0Dn4wCARbN5P40jVyv5wKQtSR90QzsalTRnLQ&oe=69B69CE1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BAjBnGHiSfgQ7kNvwHz631H&_nc_oc=AdmJzGJZi3M1UmmgB4Yfwgq0lax4cOSawI5BXynHaYEV-B3B15Pjo6NEkwZRQNcj_6I&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afw3jEL9nj85EC1JBQtr_mYBHD_Npu-pHlLe15LQqp7tIg&oe=69B6A6DD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EfcgQvlAmBQQ7kNvwHnxcWk&_nc_oc=AdkzsFm-nOCWoND-OgmbayDlnWh8fQi4yz8YXHhs-2O25RPjkBfihdczkK4S5hPhMig&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfymJaUKWukYoHTP43Mv6_Sa1eCJToG-bkVu6rUD9tSytw&oe=69B68EC1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KhvJW_5EWbgQ7kNvwHqTP4l&_nc_oc=AdlR_sMMG4pwvjvM8syed100iwdFdPTm2G5M0GE2fGqiBSiiXdX3kwe-0mWBxzxJXRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyO8o6b1RPP-mAZZIKHnoE1I_BfNBmQ_qM1hTJLT3XEYg&oe=69B6A9B5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI
fwqGiFn824Ofd-3jQwhPO5pmaR2gmKq9KSgQWZWkEQmUw&oe=69B14D4F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At8ekTZKa-kQ7kNvwE47R6i&_nc_oc=AdmN6vM5ckU4T0rjwxTcBFyBZ_SYeNUfYmsWBB65aHWVGB-LBIYtQhKGH8SEpO1P6-8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afy5VWn4RXGUh568rJya0G_JSdFFNDXU6Wn6Rt1XhS3dYQ&oe=69B156E1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMxoq5UlT9wQ7kNvwEErByu&_nc_oc=Adk973WjFfgEbOemwcrqsLWnsC9W9-8nzVD8GAgPM9L1w7xvEJbTXV8MP4bNxQGkPYY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfwfojYoIT0kBa7cOtRkKMZ84Mjszem8ajZwgy_Gi13v9w&oe=69B160DD"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0LnAlCvTJpwQ7kNvwG6kAkG&_nc_oc=Adkg2R8r0RaR2jujE-GIQFXtgPuV4szy1d9WIRN8DMs7xLqKvvTpw16pxfg_RuiXQQI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_Afxb8jGzaABnPSkIZzO22taDWLefUtf_LKKhusXCDc0Pbg&oe=69B148C1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k-m-Ga74uoMQ7kNvwGLv11t&_nc_oc=AdlNQ9TpZ6gU0c_EcY8bHnbwgq-XvIFGSkcskzfK33WtgDwpvYwlwCZp0PQTJR-S6JM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_AfwDC-lvn2uxdRnWJht0WyTZQdNoEFKLM0vv3z5Vqy6FKA&oe=69B163B5"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI
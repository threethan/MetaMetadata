8nrvPFM2vaU7KiPBhqaGj3TQgb-iOxgqB5IsHIQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4FciHwJ4XUIyKABeqaHWc4JByDlrtXghZmWfrCdwNzcQ&oe=6A1C4F0F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zF_zRMGGTKsQ7kNvwHfSIN1&_nc_oc=Adqa6V81Qd2lMaprAqjebLoukeThE1vqcohZwPU9E19234XgGoL2w7rDjYin9CcW3Vw&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af62VKxkie2q3ncISZLoT53gJb0gtDBJ1f878qU-H6VFiQ&oe=6A1C58A1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oKz9AMizunAQ7kNvwGiqxTZ&_nc_oc=AdraycnKuavr-At4gO4MZho1WXvqe5LygRjASHx4BXsoSoTdSRcNSNU4iJ9NfmO1E4U&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5XrGCTapa0fwcG16huLPDGGPXtLeYgsB2tFQ0q7npNAg&oe=6A1C2A5D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j82pbJ9PGBEQ7kNvwE0_tto&_nc_oc=AdoxFDr3FEVuCNm_57h61hXoPjNGiHA_YX2eqxkZMDdbqZYFZmrWdAAmAQmzEEUuqAg&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4vfiAf0t9ZIT_HJoE9CeFRASvogi8aGm4W96mnFoyMrQ&oe=6A1C4A81"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yhM4FadWEoYQ7kNvwHaJS5-&_nc_oc=Adq1OuhIx3n7JLzVs4dD5DF4D0432G8zWMXbUf6TNnsM41VTdsrSGO26m2wwEjyuznM&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YCiidpVUCTlFOzBw9hvtnghPcL8_Xl3ai7PJ-mzIAXA&oe=6A1C2D35"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
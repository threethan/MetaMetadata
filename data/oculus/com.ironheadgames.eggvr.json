XQCL79xWCkayrvft63JyLu8NlpetCjJTTc8Ubwo&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Y-Eo4IUMLa98f_L8z-jmalAefFcof9QT-wxrtzjklYg&oe=6A24380F"}, {"file_name": "SCR2.png", "id": "950360659824717", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982588_950360663158050_6148223050477784806_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b-VM8qF-OwMQ7kNvwEa2eii&_nc_oc=Adon8oBs5tjAzFcdYBIOfTI98mvIFRY7cVsqS1C2h70fWylqycG7fzXKviwvh0lRqGs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LxOQhtlR7t9nhNZsewgVyjJIkvf4gTaxDsHDXYJtd7A&oe=6A2441A1"}, {"file_name": "SCR1.png", "id": "2032042583863286", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86610714_2032042587196619_6781272509647889245_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=01uXOIck1NAQ7kNvwGba3kD&_nc_oc=AdpzcHVjQJ5mTXCAd588Hy8oeEdQN1EAS4rso-wk5b-mmEk3QngpMXdWFXPdwLit0W4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_bJ3Sq_tmmm3K3iw1nY0ZTJJmQ5nrFQX3_kB9Oyq98pA&oe=6A244B9D"}, {"file_name": "SCR5.png", "id": "911001180553401", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/75223482_911001183886734_8320042508041395063_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a2w7vTvgg3gQ7kNvwGxNzGa&_nc_oc=Adp317f517uDY5vWMUPxd0LraTm1xUDb3qETiNZXnw9z9-DrC8r6x2q6RQl50guS6nI&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_AcR0ingnixGUCQzOWhQku13W2f4uT9cYBMO-fK7zOaw&oe=6A243381"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "VIDEOCOVER.png", "id": "910405713797165", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982613_910405717130498_7165191762179409940_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I3Q_uuIx5gQQ7kNvwHPT0e1&_nc_oc=AdroyKPFLLeRHXXKVG7LTxQnY1KPHzRy56Ne48qwO3ZRXX6rIdbNWIjg4an_PwGqJYc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8U946lrIQB8Jh4E2_bOOfBaFiQnoh1txT4tlxND45exQ&oe=6A241635"}, "display_name": "Egg VR", "keywords": [], "long_description": "As you travel through oversized air ducts and sprawling kitchen landscapes, the ordinary becomes extraordinary. Each room is a playground, and every object a potential obstacle or hiding spot. Playing with friends becomes a thrilling chase; run from fellow egg adventurers or become the hunter, using your wits and agility to outsmart your friends. Experience the thrill of movement in a magnified world as you navigate through obstacles and climb steep cabinets in Egg VR.\nHowever, Egg VR is not merely a game of pursuit. This game offers more than just entertainment; it's a social platform where you can interact with players from around the world. Join a virtual kitchen turned jungle or create a private room to play with friends. Whether you are looking for excitement or just want to relax and chat, this game is designed to help you make connections and create lasting memories.", "short_description": "Embark on a wild multiplayer adventure in Egg VR! Crawl through oversized air ducts as an egg and explore giant kitchen landscapes with your friends. Dodge high obstacles and customize your character with unique cosmetics in this egg-exciting social playground. Where will your tiny adventures take you?"}]}, "developer_name": "IRONHEAD Games", "developer_privacy_policy_url": "https://futureofvr.games/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "FutureOfVR", "support_website_url": null, "website_url": "https://futureofvr.games/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"
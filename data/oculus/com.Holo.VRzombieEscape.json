uluscdn.com&_nc_ss=7f20f&oh=00_AQKwZoVpghI2Px8F0s4X00_V7D1t-m1-jOYoWbb4a7MaJw&oe=6A9C3B56"}, {"file_name": "1.png", "id": "9543126012369889", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974654_9543126022369888_1314598922850701453_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gMfGDtcUc9AQ7kNvwF_g9ll&_nc_oc=AdpheeVCw6g3tVDm3lHetEHCLf9RwH_M2Ksulp2ePHkwzBJcrpXNYnwt2fsXmkyyX2k&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhIf_lTS-85yRUV9rByEkeQrl4W0jC9L_V3uqP87kWbw&oe=6A9C2AB1"}, {"file_name": "5.png", "id": "628012680295114", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618069_628012683628447_6313840828862506420_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZcVqeB-N7cQ7kNvwEMfrCx&_nc_oc=AdrMDwtNy4ywyVLcTV7W7WikFmchbxoe86ozAM4zTESka-O9xDx71HbIFw5dIndvGUk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLIaJ8Yhi-yOIL5Jb4PmStVZEJf3GTKZrJb8ViqOSEUJg&oe=6A9C1E3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "857764556924160", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499617847_857764560257493_6518929680756477415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wDBztO0ilO8Q7kNvwHfl5WR&_nc_oc=AdqbJ_2tmHX9E60Fz72r2nvelRafSxzgAh0d43f5ForFuotq4gyPxE0Ot573X24PA6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLGXgrHBA0FESYbtvfS7G1jQDac3nGrTo75DKekFH5YLw&oe=6A9C1409"}, "display_name": "VR Zombie Escape", "keywords": [], "long_description": "The VR zombie escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened \u2014\u2014Official version"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "26844080825269502"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035376_2381365365549941_658729145781930262_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GzeufsgNTS0Q7kNvwGIZmXn&_nc_oc=AdqReBCfQLBMuRhfDi9ANBK75uNUU0nAHxSKEwjSCZEA-jrzAU6x2DqAnJbE1k9DC64&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00
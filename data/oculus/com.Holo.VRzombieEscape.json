494333", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75429290_577553974827666_8280169207114285657_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TYpgjkTJArUQ7kNvwEnX7lP&_nc_oc=AdrZCe4U3z62JS3LV_tCuoyWF0AMbwY1PkNaYMwbNnDKNznC_E2ZIDberrwG8Bvckx0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af84PXHb5lbSKif58Xbo2HeXnmqbFUJ3Wbc5vIgjJpQp2g&oe=6A3BD8CD"}, {"file_name": "1.png", "id": "9543126012369889", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974654_9543126022369888_1314598922850701453_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ekGzuleMkvkQ7kNvwE9uHpR&_nc_oc=Adqo0XUYfcui8ISFT-MtI4gadJCqs67ssYvkqqglisOLknsihrlrT9OqXVnUZBKBYPA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_DsbW1h0bibcYjQ30xtwSpBtD2rrWbIWq_wqA-GlVRCQ&oe=6A3BED31"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1118959933128013", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974574_1118959936461346_7572217924969105390_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wsJiw6IzzDQQ7kNvwG3YIJh&_nc_oc=Ado4N0GXhKc6fuHkXjaWODQ-eFz2V6vnm-A-6KskhJnExcCc7aB-v4KXKhZ3sq0fwIU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Fs7d_TGH93kx1CMkoxNuZizQ10aqAH-5JRW6iTuFiRA&oe=6A3BEEE2"}, "display_name": "VR Zombie Escape", "keywords": [], "long_description": "The VR zombie escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened \u2014\u2014Official version"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "8224518940985639"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1212175270083077"}]}, "baseline_offer": {"id": "1212175270083077"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1733526000, "status": "PUBLISHED", "id": "1212175270083077"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25824396347237960", "version": "0.4.0"}, "id": "594340886354791", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only"
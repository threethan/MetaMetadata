", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610707_1107006497692131_3459079048530186584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jDQh5eJh23YQ7kNvwFMOm9P&_nc_oc=Ado8UH3ASr6E1_kIZOlifeyZIAndl_h6kQVFqUh6kYm1HjPegTDsYmIIWx_3G1Y9I0E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Af05esyPoMLftWEPiD_FR6OoUFflZQEJi9HkXnUr1U5FOw&oe=69F0A016"}, {"file_name": "1.png", "id": "9543126012369889", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974654_9543126022369888_1314598922850701453_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcaRYzTY7WQQ7kNvwGYtAF5&_nc_oc=AdqbJwdF8Zo-_Agf6GFq5083O-DF0pZrBR71FwvvgvP1IzJlGYajX84yXlFX3KJVBw0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1vU3Ypf-5yrt_W2h6VFbx_vwRa_KSeAyJCM_B_G9yWXw&oe=69F0C7B1"}, {"file_name": "5.png", "id": "628012680295114", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618069_628012683628447_6313840828862506420_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CFHMmf5NspAQ7kNvwHtDyzC&_nc_oc=AdoPCmMTxgFjNWLFHpaGZSG5ni36dg6qguWIQVXZ-Gy88i5o_LYSTdJS1iOxLPWPvlw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3EWRCn2_O7pazfcwdZPvnuZDBvu2wxg_jL2His6oBGMw&oe=69F0BB3C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "857764556924160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_857764560257493_6518929680756477415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXdZayufXJIQ7kNvwG7QWh_&_nc_oc=AdqtR5QlY4tPp6h5qZPPQOZC8qA-dMDMbyGw0ruAdQChLmF93WjAq6YSGz1E-ZdDjNQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af1bc7_4PrM4dPTqHwtMoGNjSTcjAEO0nuTGZtjbZUxsOw&oe=69F0B109"}, "display_name": "VR Zombie Escape", "keywords": [], "long_description": "The VR zombie escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened \u2014\u2014Official version"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25824412967236298"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39035376_2381365365549941_6587291457819
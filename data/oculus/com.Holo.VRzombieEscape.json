etless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e5Y0oDETIOgQ7kNvwFnILAV&_nc_oc=Ado7GKWIjlqnbZ1EXevg7I1N0U5ZfIyMdhR7IiPsvqh5UxeTJ8WXw4RsfikQoHXvxUA&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTt3M0wt82CUbOztzVPmO-4RxPZ1HoXwga8hyDBrTBAMg&oe=6B0B3196"}, {"file_name": "2.png", "id": "577553971494333", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75429290_577553974827666_8280169207114285657_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UqleSQRstHQQ7kNvwFQWSSN&_nc_oc=AdpIoFMHzyzKV-t5mO_Wz7rTqB0xbs8v7oSVp9nQ-cMoT-wvRbvJBTpQoL8t6jbFElw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSpWcfx7RIVXTqLTl7UH9myRpVglf5BBTpnUtsmaGeycg&oe=6B0B0C8D"}, {"file_name": "1.png", "id": "9543126012369889", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974654_9543126022369888_1314598922850701453_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FdJsfZmfj_YQ7kNvwEmLG5A&_nc_oc=AdqSoK4qAPEkyaR0Iuhq1xGYM05eYBj11bDcs56QkW49IINCjrYuiYGL3s8C8M8ex5o&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRBWnYxtp689GI5x769FPjON2bfho7_BNqXPXSU3qL7yw&oe=6B0B20F1"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2.png", "id": "1118959933128013", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974574_1118959936461346_7572217924969105390_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=67hYOmLRXjoQ7kNvwHmxLEm&_nc_oc=AdrR8XnZHGgqNfdwX9Cci4u7216SFwtc4VC_68Vz9LzGwamwz8Mzg-vksDSgTEJRls4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQc0f9241HJLHyzPVtno5ew0sFUfIj8PZ3EhwRkfic0Tg&oe=6B0B22A2"}, "display_name": "VR Zombie Escape", "keywords": [], "long_description": "The VR zombie escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened \u2014\u2014Official version"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "644354873106712"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "8224518940985639"}}]}, "scheduled_offers": {"count": 0, "nodes": []}, "baseline_offer": null, "is_approved": true, "firstOffer": {"nodes": []}, "liveChannel":
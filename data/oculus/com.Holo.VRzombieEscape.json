jnw&oe=69F204CD"}, {"file_name": "3.png", "id": "1107006494358798", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86610707_1107006497692131_3459079048530186584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=695MioLBN0MQ7kNvwEXqQRa&_nc_oc=Adr1o0XIL9OWjW0TPDM9TO01bCda4f0On0-Nf7N_n9pLtKfnQM3mAMGW7ykdhHTyq9I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af3WC-jxZeKJ6ljA6irzeY1lPvk1CsdxuzAKt0d66dxw1A&oe=69F1F196"}, {"file_name": "1.png", "id": "9543126012369889", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974654_9543126022369888_1314598922850701453_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EcaRYzTY7WQQ7kNvwHI0kZG&_nc_oc=AdrViZwpU8TodOGkPanveqwCnHqtihvF_LIMKdWfTHuZztc7tbSGC9Bj1V2NOafPVnM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af2XCugmLzBWlHDOJP8gG5PKYz8cOM-dihxCdrd5Ub3T3g&oe=69F21931"}, {"file_name": "5.png", "id": "628012680295114", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499618069_628012683628447_6313840828862506420_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8m-qA4JibMUQ7kNvwGCxFX0&_nc_oc=AdpOrWPJo1_Hl-_arnmSryLXniE_NEFZRXiF4QpoDjDNaQ6Vxy-Tr97k-hVh7OM4oJs&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1v4oIPUV_S35T5nZhIvOVeTUqCp-pHh2NBw7-8a-_mTw&oe=69F20CBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "857764556924160", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499617847_857764560257493_6518929680756477415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kXdZayufXJIQ7kNvwHyGq8v&_nc_oc=AdqKbY_hFz0rxWDkbRTHNFX_ZknpGiqI7m7wZjOvrh-cFcpkzgiMWuazawBJYQjcxBs&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af2HzT3KgwosqE_N1G_k-IFkKpVYAei2UpUfwYC0IMXk2w&oe=69F20289"}, "display_name": "VR Zombie Escape", "keywords": [], "long_description": "The VR zombie escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened \u2014\u2014Official version"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "25824412967236298"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scont
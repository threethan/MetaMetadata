m3F4Yr4aE_EJzS1SsNdoM3Z77X0E3URwMjoOL7IF0Q&oe=6A0F05CD"}, {"file_name": "3.png", "id": "1107006494358798", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/86610707_1107006497692131_3459079048530186584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ar-bPFzphscQ7kNvwE5zaR0&_nc_oc=AdrgnGH3d26S9BD2-jHbefRuew7pUg694702rMKOB9UPoMHdb2L3t8xBsgtFkLvasso&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5PYKIlcLgc3y-YbVFm6KOL48bny2iSPXOSDhl8ZSov7g&oe=6A0F2AD6"}, {"file_name": "1.png", "id": "9543126012369889", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974654_9543126022369888_1314598922850701453_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WBkLw8uZkmQQ7kNvwGANQ3Y&_nc_oc=AdqExnTByE3BrWnAFdof45UT9abEiH7PkViNrTn2KIXgQbmPH9LhB8A2eUAemZoVur4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4xvJ26x5VxGs5M6wYfhf078_fqqP5IfjZ18K9xybeSUQ&oe=6A0F1A31"}, {"file_name": "5.png", "id": "628012680295114", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499618069_628012683628447_6313840828862506420_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fly6snq_f1UQ7kNvwFE4jz4&_nc_oc=AdrJ9x9js-YjSq-jdoJAte6OlR9YBtWDxlW8KLlnsx2BkzAnf1Byd9Cela7gj7OZhjw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6vyi5sfaFU0-VLgxTCuF6oBqktcNS-R9uQ1twKyoSrVA&oe=6A0F0DBC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "857764556924160", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499617847_857764560257493_6518929680756477415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8ukQSdjbkoIQ7kNvwGd6d6K&_nc_oc=AdpzmXyOha1xV_qa93FsFt6Bf8tJsRUz1VIGbCoC0fi7ivRyn6Pm0wllH8W7xtiJveY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7bjyTBNH-BSyQsADVH1-x3eQkLNzSjQMv9qWs1LepOYQ&oe=6A0F0389"}, "display_name": "VR Zombie Escape", "keywords": [], "long_description": "The VR zombie escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened \u2014\u2014Official version"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "2582441296723
i69oKmb8-ND2XZWiRNjNoU88vsQIKBDX778p_P7CYw&oe=6A2EA9CD"}, {"file_name": "3.png", "id": "1107006494358798", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/86610707_1107006497692131_3459079048530186584_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCqP2wPWdz0Q7kNvwH4zw-_&_nc_oc=Adq6xvq499CLabfE7iLcEGHtl0nIb0J5z35eMJIHIUM1chQicZaLSeDI6jOzGoYK0AU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-iu2TWXwShr6LAfImrjQ4_Rtue1fkxHB0dLsgQenAgyA&oe=6A2ECED6"}, {"file_name": "1.png", "id": "9543126012369889", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974654_9543126022369888_1314598922850701453_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TCtPcACJ9XUQ7kNvwHMXotQ&_nc_oc=Adr9Gu6yZirk-iCuF2tjgVQDqNMmNctDVzzlC_eCjI5Mk-EId-idNhXTmyGPaRqv8sk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8ZHXfrJxMpBac6IXz4qdDy6AfRfdN-ZmuCPmqH8iJ6bg&oe=6A2EBE31"}, {"file_name": "5.png", "id": "628012680295114", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618069_628012683628447_6313840828862506420_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m1WotRtMJR4Q7kNvwEIiB-1&_nc_oc=AdpGqWJXBViaBvqOE6-P08GGc3EYwSAR5SCQocs-1ojAX9Ht-p_-Jl0M-gY7ivFa8OQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-hi1yIfdPm1qr9SM0WsQNzyZZ0xPieNadzKgyd87aYLw&oe=6A2EB1BC"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "4.png", "id": "857764556924160", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499617847_857764560257493_6518929680756477415_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ovtCaGOfBgQ7kNvwFaX8Cj&_nc_oc=Adp3VaEUuPx33WoJ90ukt9YgHWAtmUfluguzpEQhPmO4wbqAFuxGI8S-Ggwqc9JKzok&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8WJHJml9SMU1YVB1G2IBbCjYcB_z_RXDShzwIUQv8ocw&oe=6A2EA789"}, "display_name": "VR Zombie Escape", "keywords": [], "long_description": "The VR zombie escape is a VRFPS game that focuses on PVP network online biochemical battle mode, an improvement from the original CS's popular biochemical mode. The game features two modes: zombie escape and biochemical infection. In these modes, online players must play as either humans or zombies. Within a limited time frame, humans must either annihilate all zombies or save themselves, while zombies aim to infect all humans through an all-out attack.\n1. Biochemical infection: Within a limited timeframe, humans must eliminate all zombies using firearms or evade them in order to prolong survival, while the zombies actively seek out humans to infect them.\n2. Zombie escape: Within a restricted time frame, humans are required to fend off zombies with firearms for self-preservation and successfully reach the designated endpoint in order to achieve successful escape. The immediate infection of all human players by zombies results in victory.", "short_description": "The first VR Biochemical frenzy online battle in history, Multiplayer shooter in VR with zombies escape, officially opened \u2014\u2014Official version"}]}, "developer_name": null, "developer_privacy_policy_url": "https://vrdanceyinsi.webnode.page/", "developer_terms_of_service_url": null, "publisher_name": "Holoren", "support_website_url": null, "website_url": "https://renrenren.webnode.page/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "CO_OP"], "id": "2582441296723
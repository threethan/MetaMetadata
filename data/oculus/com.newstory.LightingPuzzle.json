25/499617847_1985392252309343_6693334905844663695_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WQ5zKFdH4HkQ7kNvwG63pDB&_nc_oc=AdpPASUF3F23n5OjGbxVjS6R2VClI8cMgNsWLA5twZ0han0MZg_9gHX6SBWO6tLPopU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-24uX74zvDD61vFn3LcNs3Vfu-yWVNKLnt6HqWH0wEg&oe=6AA4025D"}, {"file_name": "8.png", "id": "1358537442423922", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/499618069_1358537445757255_8309282852412058094_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTBn9TwYqoYQ7kNvwHZDa6t&_nc_oc=AdqvRIVuZYV0Fw8wRb1Zshv21v9qoUAT411yXIvkOltpUjYVQSxw6s6L6LquEFlO7Ng&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkIRd9AL4343xgCLDQVYIFzDoVo_HenDaAhHqgODHseQ&oe=6AA41617"}, {"file_name": "9.png", "id": "1182730359866691", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/499618910_1182730363200024_5535339937947889702_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFyjK5OtfL4Q7kNvwElfm5g&_nc_oc=AdrwBJASw20yo3QG3aIfVlicX2PfWnFuaYfV7H8sp0SE5g6GimNP3zWQhNz-ELESefs&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKpftyK173pEdTJHm7GOy2PXItdMyi00QVuJuZoDcxrIQ&oe=6AA408E7"}, {"file_name": "7.png", "id": "3731102810519144", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619832_3731102817185810_8199667945986067668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NqRaZJ6aVfcQ7kNvwF4WV_Z&_nc_oc=Adqdyc_0Pp79W8QPxm922e7F3L-as0CvPEoAiZTIP1vIaf_Z4Jnkbea2i2Cu9XlMarI&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJP-VD8erh_WMWEmUOVps8Hucv5ZqjqUaCJyQVtEuBgwA&oe=6AA3FFEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Light Puzzles MR : Lumina Lab", "keywords": ["Puzzle", "Relaxing", "Light", "Simulation", "Zen"], "long_description": "**Step into the Light. Master the Shadow.**\n\nLight Puzzles MR is a cozy, meditative spatial puzzle game built for Mixed Reality. Transform your living room into a holographic light studio where your goal is simple yet deceptively challenging: match the lighting.\n\n**\ud83d\udd90\ufe0f Tactile Interaction**\n\nReach out and grab virtual light sources naturally. Whether using hands or controllers, experience intuitive connections as you pinch, drag, and rotate lights around 3D models. Feel the satisfaction of fine-tuning shadows with millimeter precision.\n\n**\ud83d\ude80 Early Access**\n\nThis application is currently in Early Access. Our goal is to provide a simple, high-quality showcase of Mixed Reality technology. This app is in active development. We welcome your feedback to make it better!\n\n", "short_description": "Relax and match the lighting in this cozy mixed reality puzzle game. Use your hands to position lights, mix colors, and master shadows on realistic miniatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25473462575582374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/499619148_1363342221865864_6461658901976082877_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_o
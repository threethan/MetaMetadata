sjc6-1.oculuscdn.com/v/t64.5771-25/499619832_3731102817185810_8199667945986067668_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a6A0UE00xJoQ7kNvwFN32CQ&_nc_oc=Adq0IjFSNitzKy-az25p-6MsMNgSeftUWiY0BAvhbkhc88HjDoc-YPjD9iasOTblYes&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_6P0y5aHiD9k4OG1mEg73HJjnUXb_xMmQf_EF9hbV2gg&oe=6A2AB5EF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Light Puzzles MR : Lumina Lab", "keywords": ["Puzzle", "Relaxing", "Light", "Simulation", "Zen"], "long_description": "**Step into the Light. Master the Shadow.**\n\nLight Puzzles MR is a cozy, meditative spatial puzzle game built for Mixed Reality. Transform your living room into a holographic light studio where your goal is simple yet deceptively challenging: match the lighting.\n\n**\ud83d\udd90\ufe0f Tactile Interaction**\n\nReach out and grab virtual light sources naturally. Whether using hands or controllers, experience intuitive connections as you pinch, drag, and rotate lights around 3D models. Feel the satisfaction of fine-tuning shadows with millimeter precision.\n\n**\ud83d\ude80 Early Access**\n\nThis application is currently in Early Access. Our goal is to provide a simple, high-quality showcase of Mixed Reality technology. This app is in active development. We welcome your feedback to make it better!\n\n", "short_description": "Relax and match the lighting in this cozy mixed reality puzzle game. Use your hands to position lights, mix colors, and master shadows on realistic miniatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}]
where your goal is simple yet deceptively challenging: match the lighting.\n\n**\ud83d\udd90\ufe0f Tactile Interaction**\n\nReach out and grab virtual light sources naturally. Whether using hands or controllers, experience intuitive connections as you pinch, drag, and rotate lights around 3D models. Feel the satisfaction of fine-tuning shadows with millimeter precision.\n\n**\ud83d\ude80 Early Access**\n\nThis application is currently in Early Access. Our goal is to provide a simple, high-quality showcase of Mixed Reality technology. This app is in active development. We welcome your feedback to make it better!\n\n", "short_description": "Relax and match the lighting in this cozy mixed reality puzzle game. Use your hands to position lights, mix colors, and master shadows on realistic miniatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25473462575582374"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499619148_1363342221865864_6461658901976082877_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2
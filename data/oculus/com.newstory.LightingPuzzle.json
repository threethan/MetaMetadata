_ohc=NM8psKb08uMQ7kNvwEyNLry&_nc_oc=AdqlWv_4ZJGZy2Z0xdb4gj42Frn3kcvUKAYbJai5O_MYnxtLVSsMPd-UQ-FxM5TULrs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2YYjz4U5kdMXpwzm2aNegA9_nyEAjuEUGu72409vEoHA&oe=69F74B6F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Light Puzzles MR : Lumina Lab", "keywords": ["Puzzle", "Relaxing", "Light", "Simulation", "Zen"], "long_description": "**Step into the Light. Master the Shadow.**\n\nLight Puzzles MR is a cozy, meditative spatial puzzle game built for Mixed Reality. Transform your living room into a holographic light studio where your goal is simple yet deceptively challenging: match the lighting.\n\n**\ud83d\udd90\ufe0f Tactile Interaction**\n\nReach out and grab virtual light sources naturally. Whether using hands or controllers, experience intuitive connections as you pinch, drag, and rotate lights around 3D models. Feel the satisfaction of fine-tuning shadows with millimeter precision.\n\n**\ud83d\ude80 Early Access**\n\nThis application is currently in Early Access. Our goal is to provide a simple, high-quality showcase of Mixed Reality technology. This app is in active development. We welcome your feedback to make it better!\n\n", "short_description": "Relax and match the lighting in this cozy mixed reality puzzle game. Use your hands to position lights, mix colors, and master shadows on realistic miniatures."}]}, "developer_name": null, "developer_privacy_policy_url": "https://newstory-inc.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "New Story Inc", "support_website_url": null, "website_url": "https://newstory-inc.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "
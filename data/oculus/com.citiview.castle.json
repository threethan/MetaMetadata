950_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JR6Pt83bsIQ7kNvwGlOjWk&_nc_oc=AdpEZLrliIk7PSI_KKHC1Ozi5tlYGEKr6NCYsd475w2pm4xVKsLxlducy0R3WTekNJA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRR7otNrTXvN50iz-wVxFjoIXuXVL9zt9g1YL-8V-0YXw&oe=6AF488CB"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1092576927067250", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491831299_1092576930400583_8237747778433466150_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moFcnf2LSLMQ7kNvwHj1esP&_nc_oc=AdpD5GZLbkf7I5_z6xZLq0VFGM62q9cMTtkT4s-djN6MDyFo1sRiKv9LYMT8EQEjDUc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2nndAQl6ifMLqGovlcFXn3NYRLFFfSZ2RjhwDuXv6vg&oe=6AF47BA4"}, {"file_name": "screenshot_5_2560x1440.png", "id": "935754929119962", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/604360590_935754932453295_1346531294161031450_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQPPe9sFqrYQ7kNvwE70IbT&_nc_oc=AdpYDh84domM0CH3rh90EDKOFyMUzXb2JrCr2hX_vKW5cWZIH22yYYbv-rlGS7Iggj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9jeXqxGcaWk2QUhykNSDTSkMPioMHlCNbLWKkHfT6Aw&oe=6AF49AB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1090695810131795", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/791586454_1090695813465128_8859687804000569745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZGEXZB_C_wQ7kNvwH9OEFw&_nc_oc=Ado5Q-VQhZpj-m2q1dqRSq2sJWxI_tUPkPnDzOA5rmWLOafGDYjvswzjD3M-rcUFloc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0UENwRZqXIkoJgSeax2j-FxTT2mCA8bLxp0BkXYVrPQ&oe=6AF49400"}, "display_name": "Castle", "keywords": ["castle", "knights", "shooter", "defense", "medieval"], "long_description": "The knights are coming - and you have blasters from the future.\n\nCastle puts you on the walls of your own moated castle. Waves of knights and red-caped captains march out of the forest and charge up the road with their swords out. Your job: hold the gate.\n\n- A whole castle to defend: walls, towers, a keep, a market courtyard and a drawbridge over a wide moat\n- Ride the lift up to the lookout tower, jump up onto the ledge for a better shot, or walk out through the gate - it opens for you and nobody else\n- The Chrono Arsenal: 18 futuristic blasters on a weapon wheel - sidearms, rifles and heavy guns\n- Hold the trigger and every gun fires full auto\n- Wave after wave, each one bigger than the last - your best wave is saved\n- Captains, gate repairs between waves, a wave banner in the sky and a wrist board with the gate's health\n- Start menu, pause menu, how-to-play card and a soundtrack you can switch on or off\n- Smooth 72 fps with snap turning, played standing\n\nHow many waves can you hold?", "short_description": "Hold your castle against an army of charging knights! Stand on the lookout tower above the moat, pick a blaster from the future off your weapon wheel, and stop every wave before they break down the gate."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-castle.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-castle.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_mo
-lga3-1.oculuscdn.com/v/t64.5771-25/673819499_1033510519729762_3802381164364221697_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oGUeh4pxmS4Q7kNvwE1rzVD&_nc_oc=AdqUzBtDNcpCv0hm-eDaKcd-E6InYIjPVEq6uSSpm76hqw2YqggYUiQNwjHL8Oo2pno&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ4hJqb5YI3_DHDFXKYPQdLgGmXuv1kyJFGgIkFgPJ5Bw&oe=6AFB34B2"}, {"file_name": "screenshot_3_2560x1440.png", "id": "2486079591919124", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/596149727_2486079595252457_6341428822022720950_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NEmU_KFWoQwQ7kNvwEPwTwz&_nc_oc=AdofaDcVyy2h24dy1jBFLTtz0suECZMzVnqFWKZVItYj0GILXbbvWm8wslocHAg4l6k&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVninbFkxZQDkrzh_3hK2n5ukyAcM-ILgQjEvmjKHitg&oe=6AFB204B"}, {"file_name": "screenshot_4_2560x1440.png", "id": "1092576927067250", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491831299_1092576930400583_8237747778433466150_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Shcjl8v6SYQ7kNvwFjX3r4&_nc_oc=AdpVReBIER2oQFnbEA3-HTKcx4U4w13SfMHhUPrbSqkNUQhacBXP7pX09dUwsRuioog&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRS7KKQ0Wv0XzIHmnzTYSc6dCU36R2R3-ASAm0xtezbcA&oe=6AFB4B64"}, {"file_name": "screenshot_5_2560x1440.png", "id": "935754929119962", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/604360590_935754932453295_1346531294161031450_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TJW2d3OytTsQ7kNvwFA-z-Y&_nc_oc=AdrEm8IJ1hNbo3IPCCKSoNLNbPAsBgq2_MXSuhHjd7oTeW9v11OYLDQZxAe8GmlemQE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJzvF1JFA1WJaB2r7Vv79_LNuZ3TjfOJXgNq5RPBFFAw&oe=6AFB3238"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1090695810131795", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/791586454_1090695813465128_8859687804000569745_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A8GQWNgzNrEQ7kNvwHdAFse&_nc_oc=AdryeONNOgiq57gP59-_tNGsvTnLK38z8K5lDG4AKlxc5hbvAoCBJs3odD-2cOYBRj0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQP6kZYazCSwozubCzDI9CRW_Wcso6jKZbV-fcfXjbWXA&oe=6AFB2B80"}, "display_name": "Castle", "keywords": ["castle", "knights", "shooter", "defense", "medieval"], "long_description": "The knights are coming - and you have blasters from the future.\n\nCastle puts you on the walls of your own moated castle. Waves of knights and red-caped captains march out of the forest and charge up the road with their swords out. Your job: hold the gate.\n\n- A whole castle to defend: walls, towers, a keep, a market courtyard and a drawbridge over a wide moat\n- Ride the lift up to the lookout tower, jump up onto the ledge for a better shot, or walk out through the gate - it opens for you and nobody else\n- The Chrono Arsenal: 18 futuristic blasters on a weapon wheel - sidearms, rifles and heavy guns\n- Hold the trigger and every gun fires full auto\n- Wave after wave, each one bigger than the last - your best wave is saved\n- Captains, gate repairs between waves, a wave banner in the sky and a wrist board with the gate's health\n- Start menu, pause menu, how-to-play card and a soundtrack you can switch on or off\n- Smooth 72 fps with snap turning, played standing\n\nHow many waves can you hold?", "short_description": "Hold your castle against an army of charging knights! Stand on the lookout tower above the moat, pick a blaster from the future off your weapon wheel, and stop every wave before they break down the gate."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-castle.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-castle.pages.dev/", "category": nu
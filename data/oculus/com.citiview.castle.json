zXb2JrCr2hX_vKW5cWZIH22yYYbv-rlGS7Iggj8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR9jeXqxGcaWk2QUhykNSDTSkMPioMHlCNbLWKkHfT6Aw&oe=6AF49AB8"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover_landscape_2560x1440.png", "id": "1090695810131795", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/791586454_1090695813465128_8859687804000569745_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7ZGEXZB_C_wQ7kNvwH9OEFw&_nc_oc=Ado5Q-VQhZpj-m2q1dqRSq2sJWxI_tUPkPnDzOA5rmWLOafGDYjvswzjD3M-rcUFloc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ0UENwRZqXIkoJgSeax2j-FxTT2mCA8bLxp0BkXYVrPQ&oe=6AF49400"}, "display_name": "Castle", "keywords": ["castle", "knights", "shooter", "defense", "medieval"], "long_description": "The knights are coming - and you have blasters from the future.\n\nCastle puts you on the walls of your own moated castle. Waves of knights and red-caped captains march out of the forest and charge up the road with their swords out. Your job: hold the gate.\n\n- A whole castle to defend: walls, towers, a keep, a market courtyard and a drawbridge over a wide moat\n- Ride the lift up to the lookout tower, jump up onto the ledge for a better shot, or walk out through the gate - it opens for you and nobody else\n- The Chrono Arsenal: 18 futuristic blasters on a weapon wheel - sidearms, rifles and heavy guns\n- Hold the trigger and every gun fires full auto\n- Wave after wave, each one bigger than the last - your best wave is saved\n- Captains, gate repairs between waves, a wave banner in the sky and a wrist board with the gate's health\n- Start menu, pause menu, how-to-play card and a soundtrack you can switch on or off\n- Smooth 72 fps with snap turning, played standing\n\nHow many waves can you hold?", "short_description": "Hold your castle against an army of charging knights! Stand on the lookout tower above the moat, pick a blaster from the future off your weapon wheel, and stop every wave before they break down the gate."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-castle.pages.dev/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-castle.pages.dev/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "1592192974313489"}, {"id": "459781504968480"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1243257242213582"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1438267665073935"}]}, "baseline_offer": {"id": "1438267665073935"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1789998840, "status": "PUBLISHED", "id": "1438267665073935"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1244723965400243", "version": "1.0.0"}, "id": "1706192820484815", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1243257215546918", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1244723965400243"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1706192820484815"}]}, "c
&oe=6B0F0F3B"}, {"file_name": "01_Cards_And_Chips.png", "id": "1779162023160646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1779162026493979_354938128531538986_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dP74b1pCqhwQ7kNvwF2m-FA&_nc_oc=AdrZwCUTe07scwytFzQpqFahXxG9tknwzeMI5lcwnSKKkNQhW0F2aI0dJZMa0N1W-KE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQVDrwN6sRbmV2WzGzor2Rw8OAIY5dcVACtsOYuJEbOuzg&oe=6B0F0590"}, {"file_name": "PokerMR_Trailer_Competition_1080p_Cover_2560x1440.png", "id": "910716002030642", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825415_910716005363975_4238954588746565727_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WY8IbKYfvNIQ7kNvwFtwx5N&_nc_oc=AdquWfNl5Mmd1BAJvJcuoWWbp4eGBsuGEy5U8jCcj0Ht2ltV0NhLECo2FY4IovJUCMY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWFdb2yBvTZL13XlI8Bwn11fActRNlHfb3y0UQnQ61vhQ&oe=6B0F1D2E"}, {"file_name": "04_Menus.png", "id": "1520453020132765", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823279_1520453023466098_4111355761615790784_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7JMrH4iD0UQ7kNvwEZJX1k&_nc_oc=AdrO3NKpxbWgz4L4QMedNLT1UTyEpn_yHUIehNKMDw76EPwIu1Wk2d0YY6qt8NaINwo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWaHGHKBocBKr710AkDUmyCW256M663YRaP36lkvYVdbQ&oe=6B0EECB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PokerMR_Cover_2560x1440_24bit.png", "id": "1839306620551506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823905_1839306623884839_2653310447807575897_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZciyVfABoqEQ7kNvwGyCk3j&_nc_oc=AdoN985Bl_XEouBrhlNFNf19sXSVF8zr64LJTx7JMmYV8pz-o-Bq0VOUwkro2P1B1mE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQW-HC4B81Rr_DARvqo0zqpqn4IWN3RqAtGj0fNLl_A5ow&oe=6B0F19CE"}, "display_name": "PokerMR", "keywords": ["poker", "mixedreality", "cards", "tabletop", "handinteraction"], "long_description": "Take your seat at a poker table in your own room. PokerMR brings No-Limit Texas Hold'em to mixed reality, with hands-first card and chip interactions and a dedicated house dealer.\n\nPlay solo against up to three bot opponents, learn through guided practice and hand-ranking lessons, or share a table with friends. Host or join on the same Wi-Fi, or connect online using a room code. Tables support up to four players.\n\nPeek at your private cards, handle chips, and choose when to check, call, raise, or fold. Adjust your table placement and explore different card backs, sound settings, larger text, and reduced-reach options.\n\nWhether you are learning the basics or settling in for another hand, PokerMR keeps the action around the table.\n\nChips are for play only. No real-money betting, cash prizes, or cash-out. Internet is needed for online tables; nearby multiplayer requires the same Wi-Fi network.", "short_description": "Bring poker into your room. Play Texas Hold'em with hand tracking, a house dealer, bot opponents, and friends."}]}, "developer_name": "XRGeek", "developer_privacy_policy_url": "https://github.com/amrutmuj/PokerMR/blob/main/PRIVACY.md", "developer_terms_of_service_url": "https://github.com/amrutmuj/PokerMR/blob/main/TERMS.md", "publisher_name": "XRGeek", "support_website_url": null, "website_url": "https://www.amrutmujumdar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "s
&oe=6B0C6C3B"}, {"file_name": "01_Cards_And_Chips.png", "id": "1779162023160646", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823341_1779162026493979_354938128531538986_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T4H5oy2ws3wQ7kNvwEB_LKe&_nc_oc=AdpDSSJ2iv-YqhkCBweEVu-DL9u86HXXwyKzKQ496fq4JTNgYILF-xqGu5-M_Icuz2g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTaOkH8aAEzTB4yubxFvoPhJ6PeFWXIWXibXaJllSeUxA&oe=6B0C6290"}, {"file_name": "PokerMR_Trailer_Competition_1080p_Cover_2560x1440.png", "id": "910716002030642", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491825415_910716005363975_4238954588746565727_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8FmZ1Kfe9UQ7kNvwFW1cJt&_nc_oc=Adrjl--bC8wgVBaSxDpETngS4ygK6BnYsTbeekRwu9mdhe7Mh8SLSW1jl5qTqhlsRVU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSB32pWCss0wqaF57OmXqwmYUsMXFvasBTlVZsZZX9nAg&oe=6B0C7A2E"}, {"file_name": "04_Menus.png", "id": "1520453020132765", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491823279_1520453023466098_4111355761615790784_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o7JMrH4iD0UQ7kNvwHribdV&_nc_oc=AdqCVexGg0LIJxTjab-s0Gy40hg77ju09ukOKB-ZlDM9pgIgrSIzqYJ2cjCVQ1acvtk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSrEYH0q3jVgpcGysOCzP90FQdqDGh9dGwVbA9ZbjkaZA&oe=6B0C81F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "PokerMR_Cover_2560x1440_24bit.png", "id": "1839306620551506", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823905_1839306623884839_2653310447807575897_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-Y7EJRdWEgQ7kNvwGWuIk9&_nc_oc=AdqdSrA_-PV0VMm6THF1S_FvXacgTCMmkRPYuOhBzQPFRXd06VCM87k28f9WG6qyDmo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRhjXBflpBqIwePxNnxXoNjYZXaLGl49cYbvfgCXU6xhw&oe=6B0C76CE"}, "display_name": "PokerMR", "keywords": ["poker", "mixedreality", "cards", "tabletop", "handinteraction"], "long_description": "Take your seat at a poker table in your own room. PokerMR brings No-Limit Texas Hold'em to mixed reality, with hands-first card and chip interactions and a dedicated house dealer.\n\nPlay solo against up to three bot opponents, learn through guided practice and hand-ranking lessons, or share a table with friends. Host or join on the same Wi-Fi, or connect online using a room code. Tables support up to four players.\n\nPeek at your private cards, handle chips, and choose when to check, call, raise, or fold. Adjust your table placement and explore different card backs, sound settings, larger text, and reduced-reach options.\n\nWhether you are learning the basics or settling in for another hand, PokerMR keeps the action around the table.\n\nChips are for play only. No real-money betting, cash prizes, or cash-out. Internet is needed for online tables; nearby multiplayer requires the same Wi-Fi network.", "short_description": "Bring poker into your room. Play Texas Hold'em with hand tracking, a house dealer, bot opponents, and friends."}]}, "developer_name": "XRGeek", "developer_privacy_policy_url": "https://github.com/amrutmuj/PokerMR/blob/main/PRIVACY.md", "developer_terms_of_service_url": "https://github.com/amrutmuj/PokerMR/blob/main/TERMS.md", "publisher_name": "XRGeek", "support_website_url": null, "website_url": "https://www.amrutmujumdar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}, {"id": "275629210202852"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "s
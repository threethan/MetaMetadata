5/491819417_762876093404815_2265287201607971015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nkaNO1pj_JgQ7kNvwFLbslC&_nc_oc=AdoVvB8JZiSSRv13F_HJLnFZviGgK09GFBV_wjI1KbgUY7BIRn_mx2oEX_qKNa4NZUo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDZL7X7j18bgfE61BE32f8hFfhIkznYH9E7RXt8YitC6Q&oe=6A562A44"}, {"file_name": "Screenshot3.png", "id": "1493973695238404", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DRzdokndfqMQ7kNvwHzHPxN&_nc_oc=Adq5fC2DK0q-kRJrTDaqESsCUv_3pP8597TwHeD70MfVT_yVxHxp6-71dXEcnXmEMBI&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASr2mMJ9WrZaVXeNA_DBXwuvefJzfksmqVcZ0qBgMBaA&oe=6A5626C0"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xu1stlVmxd4Q7kNvwHS0Eic&_nc_oc=AdrDHemeNPh-XFU2jpTRAFk4EsP_90RdDaibxQ4TWiAkTC0wl7wGhEqP3dwW8G8_gG0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBww6qnyp2nNxTMKPL30_9oz8Xq1x4on2QOsSkPsxSmHA&oe=6A562E98"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vyKXQxpkqLkQ7kNvwGvSNGA&_nc_oc=AdpRyEPaP2yFpMjjbYnLFAoQ00xQh7gaLDSSBBgl23SZaN_Nb42kvfdYGISAHIUQMaY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1H0CN1kthIr_UgfG96UGCrQ0u8brR0onrq_4n5Ydu_Q&oe=6A56235B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHyt_BMhu3cQ7kNvwHPd0MX&_nc_oc=AdquyNVRegIHfyJnqiMtkZD7bN9dUzmgp0K01SoxeBoBBFFp-TGqyu1blWrXEgu__pQ&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCBewMAFlPl0bFukEqCexZ14G8GovFRHAIQz4sfT0S-CQ&oe=6A562B8D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
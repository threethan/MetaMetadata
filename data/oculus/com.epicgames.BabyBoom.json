ng", "id": "765689486332916", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gQic8o1elL4Q7kNvwEUo_db&_nc_oc=Adkdq46Tkti0wxuT9CpitncMjIibOYeS3RMMEtWb-WbA9PK5uVKMnniTcf5OY1yf9Ug&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuAe-75lIhU5FsZoEuHRD7-AIuE7IRwZW_tHPU1rMAI2w&oe=699C4B18"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrdWaCGqAXMQ7kNvwFuxELT&_nc_oc=AdkNi3utGeyccVTn_xAasRegoO2dMsxV7iVu8Kl0GfomeZ4Iq9FcICo4ELgQySXrLpA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvIqjOwRRqRnuUSftcra0R6jujruqOU7Nf4MdD8nnnIjA&oe=699C3FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qc59wJTak5cQ7kNvwHKVAtv&_nc_oc=Adnit8-kGMnidqJ1K_omVuCQl3yaS5ACu5jY5ND5L_yjTCnq6kCyJyhdakSmj_gzOKg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AftG7ejSib7R8EMWjyL6z4g49YWv4lczka99CGVL7E_3qQ&oe=699C480D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24911533498533445"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499314643_1665061630834025_3392617167511406392_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Z8ujyQyOKgQ7kNvwE6m0Ng&_nc_oc=AdlHyv4CpBy2bT0aUWJz3buroMwsSEuCIVGnY4diPS9Tw9JHSLap-sg7_m7rUeUsoww&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvowMWjid_D0TAgdTkGK3LK5utmv5hhIBUW3BcNf4PCNQ&oe=699C54CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Baby Boom", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics
ng", "id": "765689486332916", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Nf1rkksCBtwQ7kNvwFBGGCt&_nc_oc=Adkury0KO_COusUIA2j9Fx4JqDoVN9_F2AS_nG8Qu_R8hNnxC4AJFXaO_r8m67YpwIE&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AfsV92XgltlWxsGVl6IJX3TaFjVORh8PJktBWVMP4wQyeQ&oe=69A19118"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VT1tOs3KK-AQ7kNvwH-nzff&_nc_oc=Adl0JY-bxXAkg0jVWtxR8FCI55BGZV2RIiSGQ7FWuDPRJD0E7twhog6lt1ttrBBP-1U&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_Aft6S3MwlW4Bud_dmII3jGQRyDDjuKqx13fVpLW0s4_RNw&oe=69A185DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8RK3aXx0ygUQ7kNvwFNsmP9&_nc_oc=Adm2RJYiau3J-RFl4DKqdA1yer7pzgbSkRlGi4A-FDT1C5e_VCNYPrTDd0FGrXp5ioQ&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&oh=00_AfuairQCaE_yOgZmTiT3i0YYTTEx9adUy5PR6lAZ4qS4jQ&oe=69A18E0D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24911533498533445"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/499314643_1665061630834025_3392617167511406392_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yCdnNnDIFqcQ7kNvwGyEB7e&_nc_oc=Adl_0zxo5LoY_BznAAXE9siwM8Ab6X8fx9oR7fABbp7pCaw7VWcObNpgLUlDjAzAkTs&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&oh=00_AftlhmPN50cw7DZQlWlGcVxuUIhKsPjDkUUKxHe7fjL3BQ&oe=69A19ACD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Baby Boom", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics
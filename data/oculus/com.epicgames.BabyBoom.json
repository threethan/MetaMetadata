ng", "id": "1493973695238404", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=85ZvXFroUCMQ7kNvwH1G-aq&_nc_oc=AdmNhaVCOc7ZkskvSkmYiDjqcaRPVXZvjd8M9dUIYrEmSgE91WU0itpu1Bv-pCzcS4c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_AfyzkY8FRbqvvsuV7qbgPWBnyI-C7jRJTkWacASmJTbIuw&oe=69BD38C0"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ow-4mR2iu7YQ7kNvwFuk3F0&_nc_oc=Adm5D8lkpWE_c_lpDYzFG2mpH3i37rzVb1nZ0Zwui9Ym7ST84DbvoV7QpjXlPV6SOUg&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw0_V_k7nM6EbUgjlb9yJh1GcDz116au-FOK32cuI9HtQ&oe=69BD4098"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4s7L0XQbbIgQ7kNvwG3_Wix&_nc_oc=AdnSYMl9UzJxmzgjvr1Ki4pamQui3QPiznZRfvbiB22QHCQSyDLD3KIYfcKl5_7CRgs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfzFGLIAkOAGJswr6qGAZtuz-1ms8LJbbpOd1Or7342BIw&oe=69BD355B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RXnzYiKvlVgQ7kNvwGE-ImI&_nc_oc=Adn-Ix_OWPZ93S_9O5fux2tJrgUp9ujiUr8KgMQaVmA-Lk_A49PMQyiRRH8JMNbPFZY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=8&oh=00_AfwtCqQ3TctuaIaz64NeshQdQjm-DxSw8fw229tRqdmgcg&oe=69BD3D8D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24911533498533445"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1675316316469762"}]}, "baseline_offer": {"id": "1675316316469762"}, "is_approved": true, "firstOffer": {"nodes": [{"s
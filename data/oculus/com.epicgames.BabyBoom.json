f&oh=00_AQRiaWJ8KMbINHgPgEZjtbxnUQ5vMc3vEecV4_SVTXsKuA&oe=6AFF2284"}, {"file_name": "Screenshot3.png", "id": "1493973695238404", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_sV5uvLWmY8Q7kNvwE9bH0_&_nc_oc=Adqc1d6MPYyXjfBlWVHqAGna7PaeruKh1Caq_7a_e0jyjbHgscVz6UUBxt_DW2IdXFk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTjlVwvOE_03BxrJUWGUsvVosBeUAB_Xgr7m61MUwsCDg&oe=6AFF1F00"}, {"file_name": "s4.png", "id": "2151413345588892", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491823783_2151413348922225_918868131320597515_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=--3oyekGzw8Q7kNvwH0YNDU&_nc_oc=Adrh2_x9vmQvgRHtVh-PkndnTBkklDNxbZ-CXJmZO6bePtXqmYki-fJctjjLlEQlV-c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR5kDzc_20lwFtMnrNyr-mRGqTPOYQT_6-lkI8bYlyKPA&oe=6AFF30A3"}, {"file_name": "s5.png", "id": "1724107615540631", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824328_1724107618873964_6033311960263565962_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQgfzRtLoGsQ7kNvwE7sfjc&_nc_oc=AdrOpOlEL-QmRV4wUXyJ9RXOherDI_BW0hxmCxbrCjRH0ku4kycDpLclZAtBaZfeD3Y&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQh68B1PqeKpf18JoLP8ftknnEfYBgmiuUYZ6qup69n8A&oe=6AFF08EE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zAAG06AndWYQ7kNvwFulc9S&_nc_oc=AdooaNLAw795rhxF7vGE8BZkqNOrGD2RfIJFSoN3lKgShqMscUH4_yPmmCZU2wyKiag&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQHzb52WafatG_jdG7mhfUPVakZH8ROzuPtQW8cst1Pwg&oe=6AFF23CD"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Use controllers to feed, entertain, rock, and dress him. Mixed reality makes every interaction feel more natural and immersive. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n- **Care & bond**: Feed bottles, rock to sleep, cheer him up.\n\n- **Play together**: Quick, silly mini-games that make the baby giggle.\n\n- **Dress-up**: Mix and match adorable outfits and space-themed accessories.\n\n- **Mixed reality**: Bring the baby into your real space for natural, immersive interactions.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Mixed reality makes every interaction feel natural and immersive. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_inte
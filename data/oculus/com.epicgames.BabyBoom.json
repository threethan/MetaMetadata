ontent-iad3-1.oculuscdn.com&oh=00_Af1CPV5ztS8z8-R4NzfUqxvT-3l7ED782YfckuKbvvAQig&oe=69F0A340"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IORH9NIDH4Q7kNvwGl79Kx&_nc_oc=AdqI_D8tucBPEIN5lnFVnSrwe8Yi7Y32KgC42e0DGIMG6nFWEt3xztRqMZ1OzRNmFz8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af2G9YuuX1CkAT_OhPPIwG0i2p4pcoV2J3EMnPUN8Nx7mg&oe=69F0AB18"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EKqEiDx9JLQQ7kNvwG6IYWm&_nc_oc=AdrANfj4vvLMtttIgHO3mcPZ-SF86_4pIc0bqZVOKd-IRF1TDRPuqk3EJDt6K7i5lF4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Af2F7ddScppwq5isoLBSUEe-I8YJf7uaNWfXwLPoJxMWFw&oe=69F09FDB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkt2OdxgXwAQ7kNvwH-vHjB&_nc_oc=AdofSSPsGtn4LG1TO2tovPFpNGVofx_OLFejwm17z2lRFFrjXdJXioaztjr1OKLz5Ig&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1mQdvIXGBAlJucMGJpSb38KnVvMMcx_eAipcWOqIs1tw&oe=69F0A80D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24911533498533445"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314643_1665061630834025_3392617167511406392_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0RbE8VAGE5AQ7kNvwESxZ07&_nc_oc=AdrrQa3T6Hq_nk8Va4GeoD6IaJGH93Z4oT6na2tLjKw8wWVVVwBf4BUAIlX91Nu7hxI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1muYZ-8eC7CAV2p5XIQBSSPBgmBxaADvmo9WH5NodgoQ&oe=69F0B4CD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Baby Boo
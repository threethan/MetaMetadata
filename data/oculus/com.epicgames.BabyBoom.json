771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g4hHvLGl69wQ7kNvwEmAP02&_nc_oc=AdomlWvjb2cCVfQYWwNv3xtoyOfE1pPM9Rtrk4pE6QMKl8KOefTuVAMWlIzVHhTgxT0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgYKX-tym7Gdfm_qyW7CS-8e-bmaVuxeDzazw2g59i1Q&oe=6AEDFB80"}, {"file_name": "s4.png", "id": "2151413345588892", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823783_2151413348922225_918868131320597515_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jAYuYvrBDmYQ7kNvwFekx_c&_nc_oc=AdqL8OUDHPKgSLOk9y0mHjcCDjF1j3NtV_mBCaPdwF6g3VPNLytG37aIQFLvl95GwaI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT_vSiG5huwg15KNf1qIMJCrR2wGMLSn3lEN0JW8IvDow&oe=6AEE0D23"}, {"file_name": "s5.png", "id": "1724107615540631", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491824328_1724107618873964_6033311960263565962_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fLAI-Ed3YdIQ7kNvwEKzqIs&_nc_oc=AdqEB61GiL8Mc8NrZMNbAxfk_P7U4XUfyX3hjykOn7enw5Vk_Sup_CVUb9DSmDPM904&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSytvzmk79sRhul-C6dVaLXuwgAvLQfSwjdapI5CZx8OQ&oe=6AEDE56E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=asl1xS7-fDEQ7kNvwEDUk3Y&_nc_oc=AdpKKi0kJ8tBBGFCByGTbuC8AqO2gKuxMtTGjOXLZjTtGoTVXwVEnVV2LiToVcD9s_A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmu4sRJeeIOYXXTt9iXFB9NyO7zC3Gqm0kgH3a4rzv5w&oe=6AEE004D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Use controllers to feed, entertain, rock, and dress him. Mixed reality makes every interaction feel more natural and immersive. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n- **Care & bond**: Feed bottles, rock to sleep, cheer him up.\n\n- **Play together**: Quick, silly mini-games that make the baby giggle.\n\n- **Dress-up**: Mix and match adorable outfits and space-themed accessories.\n\n- **Mixed reality**: Bring the baby into your real space for natural, immersive interactions.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Mixed reality makes every interaction feel natural and immersive. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28495411743478918"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499314643_1665061630834025_3392617167511406392_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc
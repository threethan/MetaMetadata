c_oc=AdrDEeCxRQzZN4FXsjB6UF64pnLnnMEmslA9ge5AxlrUadgxbdHXTriZ3n4cgdcJdC0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7YGxdl1enqM4dDXcgPNB3KzOQ9l1HYKXqa9HAdT_Q_pQ&oe=6A19BA00"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ykoJtBtMR14Q7kNvwH2LeeD&_nc_oc=AdowWXVQ7HUWLiRaSbQ3dK26o-AudSoTsRb0A4WmJtgp1e63XIdrkL0YqOXphZu2ADk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gWuY-jLuxPd3jpbI5xINJW9zSGjaZPaLWA0M38nB6cQ&oe=6A198998"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FCiKS35r8TcQ7kNvwGFRQ6M&_nc_oc=AdqhAw__1iB59e7UtLLE0Hu2lWzBvvYa8mLWCP2FXtMZSkvn2tNdR2Bet3hAC9bGTdE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7408vqQhc9yxly5tCJmqSGT70tETsse9LEd4P0nigveA&oe=6A19B69B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0SBN5-efFoQ7kNvwGRq7x1&_nc_oc=AdpPl5ME2Riq1_RyU-G7MUjv5cOgYoltgZ6MrDjPYQgxh1XOwM-t2BjUk-G-98hrA6s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Tz7g2H4L22y-S-00F8zFoahBuDr40Hi3GH3L4V0KmgA&oe=6A19868D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24911533498533445"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499314643_1665061630834025_3392617167511406392_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bCTnzFBI0owQ7kNvwGsSuGN&_nc_oc=AdqfWH1B3kJ3wqUCjIS-W66eskpqACKNejrwmhhylgNg9qfN1s46v3973ONs-WhPNoU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_A
5/491819417_762876093404815_2265287201607971015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PH-klFX2QUUQ7kNvwHq-gu7&_nc_oc=Ado9EqoYX1oeioYk6nIlaMTMYa4WTpRu_4mJO1xNW1coeHF9AolNLJ5PHIXh1avjqYU&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKTuKKAr7h9W_1KX1AXRYZrOiJ1bOdoas-aUSXDl08sg&oe=6A58CD44"}, {"file_name": "Screenshot3.png", "id": "1493973695238404", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XxTvbZef8rAQ7kNvwFa0dwA&_nc_oc=Ado1TnXyy6kDvLb5Z8rMS1sVTVtunfQwg9QwNa7dnNIp0HrQ976TotKpV-85sBSlAn4&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBYCR10Vlunupee1zn0FsGYw9Wm9yM-XnlyWQi1lQBa7A&oe=6A58C9C0"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nAlxT6uW-n8Q7kNvwGO4FQt&_nc_oc=AdpTct3fWfhnq0ImCxncVFJtYZ-oA0oXg1BA3xuHiOpezYcVNqR8Xv1_ZU2Y5vsDwh4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBD7Z87XQPtI6JgUzcZis99pJCmEme9h4Bihc3-KS9KMg&oe=6A58D198"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Fya893ErV0Q7kNvwGKU6Gw&_nc_oc=AdpbcxZVXraWm4P6sOP0STaLXM3VIjP7w33KI4pV-2WWPfb-iVdf799tSz6Onku0QBY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKXXE3H9tixBpgCYR2TmW0ml_NGjEEGHMKfrpspY4BzA&oe=6A58C65B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iHyt_BMhu3cQ7kNvwHYh8GN&_nc_oc=Adq4mLYFsjGkUOxMA5ctzMvZ-cKBfN1WwuG4mse_fJY-uEtd9wETvNOFfL39D7_LmK4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDobi0q9pAHPSBTzumdYtH_tpSAKXUFowJLHVi47Qyx3Q&oe=6A58CE8D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
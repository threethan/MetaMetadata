5/491819417_762876093404815_2265287201607971015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGfIC1K8liQQ7kNvwHOmSB6&_nc_oc=AdpygNnjSxcs-q02vi653uhcmWLi967kTCvco62BY0dmqwFWYF3ci1iixv4lck_EcXs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3Vol4jLD0c-1s2f8K7PN6D0V4a30DBM6hl8mi4-bF7w&oe=6A65FC44"}, {"file_name": "Screenshot3.png", "id": "1493973695238404", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urhNGxXUuIcQ7kNvwEyMfYN&_nc_oc=AdqeUnZNRQecWrFoq1f-2F3t19xSuch4wxrpIExT_Sdb6GqKVZy60_ZzyOuO-3su4OA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJFSjHcFMHnKcW4tb79ZpqYNWuN_JOdRUh7Ka5dNUy4g&oe=6A65F8C0"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-I7cpQLdnIQQ7kNvwH3SADV&_nc_oc=Adp_hQDQNhIsG3If7FztQxyt_7CjhE4sGsbo5coeQ378kJLLGXvUeXhjyqmsf0hwkxA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4rdJAXrayzsQ2TO5Hwa84kDmEqINWXSQbZO2koPWQ4w&oe=6A660098"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aju5rrk8SkMQ7kNvwFc_6EQ&_nc_oc=AdpKv977LbPy9UN_tmJsC-AEinOGg52pqFn-QY9IWDH6II76s1vD33GCMP58PTkRIsM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBI0jIPZXSzGbQD8hVL2zmFr25fM6t9DagKmzpugqaXDQ&oe=6A65F55B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0ppzAlZiYTAQ7kNvwGAoA7L&_nc_oc=AdpcKH1m-_a1mzXL8CM39zSj9yHZnZVHtJFF_FCtPSdAvU4dp8czG11IFeN_GcMGPvw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAIMnymiXc60oANR8LBHTKdiM5tyNiuEESVpCnZq9Jv8w&oe=6A65FD8D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
5/491819417_762876093404815_2265287201607971015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzksutbiRx0Q7kNvwF86hV0&_nc_oc=Adrm4MOxVtwiJ9T_JhQyW1VE-dHL4fji1qUZ-gLjCtuPxag7AMwYc_Ug0BYSlJSebhY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDsAgEWnXoE0QDECsHMhoFSt2vpTK9drkYsLKiN1CJQyg&oe=6A6207C4"}, {"file_name": "Screenshot3.png", "id": "1493973695238404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk3rJq-ieGUQ7kNvwGNmWuM&_nc_oc=AdpBjYoWbnpD206FWZyihDaHyWYa4DTNvYG4ko_hpLQOCKevtGMBAbq5FA5sd4ZNeds&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVzxkyNrWPi_-5xL5NuwyzIsJxdfEyiO3vSKzUBZc6KA&oe=6A620440"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIs3U6LipJIQ7kNvwFuxv5R&_nc_oc=AdrHyImW-VQo2wOG6Md2hjTkCmNEuX2aHeX99nzLTggqQdFPyzAq6BIuH3s8VRouxDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCG-YpRnH_kOViCjJyGVlvXz6NLb37EXy7LD8EQRhXVKw&oe=6A620C18"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEQf_q6k69oQ7kNvwG5YurU&_nc_oc=AdqMxIFwVODB6xVBw5IKQePG2VJUxbJUroMfELfMgY_yJLemfKZcE-LYqqHDA7TW88c&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZoIWK3UvhzUg0sl4EDZ-nXTXVrhdLfD5RsMDsCY_4cQ&oe=6A6200DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXtV6Mg_rngQ7kNvwGnqI-l&_nc_oc=Adqf_tiy98hrU_LXsIeA_6E73rklB6Vm-hhccOeVZALLLtnKGpOlwFOU_D67yXXlV2o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC8CujIvAqn40XDlu8PI9gF-urmhXp2F0Z5ACU0oyr1hQ&oe=6A62090D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
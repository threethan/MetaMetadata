c_oc=Adr_4_R2r9QxVmKQAc42QkZHoRn9oy_FYCATQZfuF-5i0ApYjsyCuzgYWAclvza9rH4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1uGssXkCe86saedsdMPShYoE7l8c_TYv6xzaWvEHuhlw&oe=69D250C0"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8U0dj9I_VIkQ7kNvwFAMj8G&_nc_oc=AdqefGFUC-yV_7y63434ITqZV9JVYQHUvHnRiyA1-ECsXg3sZItMqs1IYBBRY6nMLDc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Dls0lmA2_ES24JrBomFs17tgXoAmzpzXMHf6-YEnKrA&oe=69D25898"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Ky_NJdNVawQ7kNvwHi2Gm7&_nc_oc=AdojHgifsL9M1LRBBvLXFhqEVVzflFagb4J1p--bjoSLwtzr--mPWF6BHfdib09xPP4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1tdzuOerZdd4Q5VxKx4lFXAbCi6s4X-4qLJCCHvSaSZw&oe=69D24D5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GH7PccJ5Hg4Q7kNvwF69R3c&_nc_oc=Adp9G6QoRBOL-mwuHKHYQAIWrvsnf3zSje0eCzQQNNdoh9PGD7pyGJpUVndyRVwPx90&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2hOVT1lyr59PWqsGRsbSdIW7UkuYjpAP2jGOCh4Bd41g&oe=69D2558D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24911533498533445"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314643_1665061630834025_3392617167511406392_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7rIbarJ--eAQ7kNvwHqjhge&_nc_oc=AdoQSrZPTB9qmwunwJm1n_Q40rlAZC7Gc65iW7o96pQhJ4OrHxCeBr2gBj-J_Dh46Cg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_A
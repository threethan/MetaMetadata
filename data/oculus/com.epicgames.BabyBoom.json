5/491819417_762876093404815_2265287201607971015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-42j5VAZMIQ7kNvwGFYodL&_nc_oc=Ado963YUnMq7SC3gJyIuryikm6vUSiuV-JnJrTMQab_7vGeF52I7_hLfDhdI1FMkiWU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPVz3azsvrIiSptJ6H8C7_ZI0mSWqmETDaxPYOqFvrUA&oe=6A7B1444"}, {"file_name": "Screenshot3.png", "id": "1493973695238404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CrWvRHxOlqcQ7kNvwF8N3mN&_nc_oc=AdqfGa8fev5M2Dg6jbgXso25c5oSnyp0QIycHlU3Ij3SUSSvy3OR4FhSLgD8U6HO1Vw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF25s-uxiq0S7xVXy-zHiz-GRyJ5-64IbnHSc5djeUFZg&oe=6A7B10C0"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MxSgDpR8G-8Q7kNvwHW_aug&_nc_oc=AdrOyLngQgMemFnRbrl0vAWAk1zrfbkkV2d1jN7CPs-br4TZ0TzVz58u_PzS6imNr94&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEWhwILLL9cO27tyJAMEQqFpEpf5ypyo3LcZkTjZVDmBA&oe=6A7B1898"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yjgwRw51bRIQ7kNvwFZzR6D&_nc_oc=AdrwdhTjKuvhwTv7c0tkEXGfMrtfyKD0mVxIlwD2hdSl3uZZymjS4nxQrnbcwrvERT4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGym2SGdKfCsNRb2WKx4SFQJBf2GpjAWMZo2AnwTxIWFg&oe=6A7B0D5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NW25wggFDSgQ7kNvwHsM2oE&_nc_oc=AdpDRW3NCKgYW7rbF9Uvdi2LNgy3PnhZBZaJcI8CE7GuOYm0ZsIDuYx0u4wcCicbdTg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxEMYiqfAl58hrexc18vSoFeNTlRnFvX9LitBzIql1rw&oe=6A7B158D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
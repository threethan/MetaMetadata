5/491819417_762876093404815_2265287201607971015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nzksutbiRx0Q7kNvwFp5bwS&_nc_oc=AdqHN6FEqlQaEYwdjxX6msPt_ryizPTlqHLU8NjBBM_WedMLTS5LAB0_QKaj3fxvN5A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDYNFnnd4z7lrrf7JC0sdS8cRH5V-hXjE_vOGznjS8x9A&oe=6A60B644"}, {"file_name": "Screenshot3.png", "id": "1493973695238404", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pk3rJq-ieGUQ7kNvwHg6mLW&_nc_oc=Adp8EOR6pxAyBW0JFzid_lhND24hPk-wh7w96ajthnAMVANDKWPwRtL6ZbZeT6LGPu4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCINcdDl343GHsnc9HntHCG8S72skOpxZgrMlgW327qng&oe=6A60B2C0"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIs3U6LipJIQ7kNvwGSVbhp&_nc_oc=AdpDqrnvwcGxfVnSWDv1vFILvpb-aLrVD3hau87LctceaOoHrv4v9BiksLd1_CK4UBs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBHiMSuGW1HubsC1Mfq-KwTfCbf5bEET-_gaV2TLeYlfg&oe=6A60BA98"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZEQf_q6k69oQ7kNvwHuMmLc&_nc_oc=AdrP7hc13nNZ-Cs0AQzVFyMTiLHcEGp_3FfkMMGkPittuxYaq8YA_8_sDkQ94vQu9pI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAgegfbzXbWRfN_3SGMpJV6HXtly3-8PCkl6GTjp0mAEg&oe=6A60AF5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YV-JOcSaPdIQ7kNvwE0zOti&_nc_oc=AdogS5C-9jwtaO4r4CSh_ZnnoEEcvso4LGFhaYan__g6GEQRKePAWCoK5QTuTwJ-hN8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCdxejeP0xq2IwrTKFCCe48n4iiYAjnoblXvZ1EgEKzZw&oe=6A60B78D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
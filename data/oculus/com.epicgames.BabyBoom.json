5/491819417_762876093404815_2265287201607971015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cm6EBS3MZlYQ7kNvwGfhxab&_nc_oc=AdoIntoprfqbiM8Kapepj30atGIyW9hItOMXTH8lM4J-iGZUw9S1AuuLbhbUmIVbHI8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOp8peLAvfYnc1Po1eX0ZfTfoM97j8fACJTHP-dUFN4Q&oe=6A805A44"}, {"file_name": "Screenshot3.png", "id": "1493973695238404", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nClqKBM7MQgQ7kNvwGKHyca&_nc_oc=Adou8meM5dFb91MJLIJIXMVpFnsNi-HJ-ZwU_Y2R7ORYPhQ6uMno0agt1Rw03VElHKc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHmagdAV1KlLp2DE2UFM8L7i1p-dXwckIjKxxgs59i_Ew&oe=6A8056C0"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YwlnGGmJnw8Q7kNvwHPnmog&_nc_oc=Adojp6RMfeWTjIzoYCkse-OTnlbcNSH8WJ2c9rg8EqASEQQOUOiLo4xtpXqPpocOrUA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE2DPTMLJcyIjef1r3BYdmeRShSZ5BuzHptP7Yb1AQ9TA&oe=6A805E98"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0lx843Lni94Q7kNvwEBbm2q&_nc_oc=AdqU9PIwqFoLdR025ee_hYPldVjM0B4KDF5dXJANHCYCcl3XUt3w6x11VLuaaHR15e8&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5TwlF45DTorxMzDNPplC2Zp_LFP6FHt923NKwwmiP-Q&oe=6A80535B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OHy76TOnbagQ7kNvwFW_rPs&_nc_oc=Adp5ctZQNhjKc99vSVpOpS0hl1lOjuHt1FXVOq9319knJ9xPPe78NmdIF2Z1AEBuRi4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6Y6v2obMAEI8_GyVJ7FKX3WvXX-DFH6QfzJdyUBydDQ&oe=6A805B8D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
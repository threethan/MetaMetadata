c_oc=AdpzlSoufFNXgzyTT2GwmkDb-TkqXGOqVqoa_PT6PSAt2C48FKz4LW5lIGQ3LC0dhzU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70Urqi7--Dbny735VZNNfXyytzNN3XelQf7vqTDIosUA&oe=6A16DEC0"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4W2JZ3ffDrwQ7kNvwFiWAgm&_nc_oc=AdrfwmM0kqRx4Q7H2xJs2_lCeUC57TSJKPk5P1wIUJNy7xPhSjqO9izaMqDgnbR_VN0&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6B_jLZskPcDpQLfm-xTlZo9g8-6A3g-0YUuSPNdf6U7w&oe=6A16E698"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQFQaKRKPiUQ7kNvwEhgJK7&_nc_oc=AdqAaEm9WitZ9lm8Dl2uYBUhCx1MlQUv67CZJDkHAU8WDpQnVpsY7zAlRksTJCj3AnM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5khj5qZojGhQrAtJ58WHgNdek7wfCLg59UT4tEZjWSVQ&oe=6A16DB5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0SBN5-efFoQ7kNvwEnx1kA&_nc_oc=AdocnpfNZ93hPnwHHgD9HU9wrsNcxwGo1jJ12a4achAHAPyB7Jk0yUOYi2d2s726lng&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JmqpYwb0lzLzvrvTEywiNMIZvl0H2HVGjzrftGIsS2Q&oe=6A16E38D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24911533498533445"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314643_1665061630834025_3392617167511406392_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=77aR8niRsrYQ7kNvwG6zjhu&_nc_oc=AdqzfMqtTIz3c7DQB6Ye8dhkN10hkjShB000-7KvunSUlIJRgZ4y6BbGa83t-mH_0j4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_A
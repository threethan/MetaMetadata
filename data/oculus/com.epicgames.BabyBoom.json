6&_nc_oc=AdoRCdG0bWqdOpLmpFd5IdyHv9i-qFF68btrXuXbzowevBm9wY6GRi7MGxEbqZyAmmU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEeHxhTV0Ofdxea68C7JeKd5RwVV19-tzxABXfKIKbZPg&oe=6A8AE2C0"}, {"file_name": "s4.png", "id": "2151413345588892", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823783_2151413348922225_918868131320597515_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RrJW2m8POjkQ7kNvwFXP4Wg&_nc_oc=Adq_RMAv9fynvi20df1DJ-xDuz9pSJ202PFPiWRp7y4i7fxmDNfa7gkDUQq6lDqSUzw&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnZAiPYdtsxWMScciXquLYyD3c7zlOpEB-0n3hXMomGA&oe=6A8AF463"}, {"file_name": "s5.png", "id": "1724107615540631", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824328_1724107618873964_6033311960263565962_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M92cAsQijm0Q7kNvwGKpbEO&_nc_oc=AdpMGcGFTajzVu9ejPgFfGxaUgP_fXH_vbPOeA7khiy03SSDfA43EhmLWRSnVlnMmEs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfEEC67JO1NrTanCa2U1ORrqnXutVOPsCY9zsf7hqj3Q&oe=6A8ACCAE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AIAuq5Lgxr0Q7kNvwFOitiU&_nc_oc=Adr3BzzKfwAMFspNUw2NjkJvWzbsEGv_GPJg5BELZktZrKgueF6lisA6s2AuOhqD2d4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWoQ64PFo1xQmtxV1PxrC2g65R9VDqm1RjeN2_NRnRLg&oe=6A8AE78D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Use controllers to feed, entertain, rock, and dress him. Mixed reality makes every interaction feel more natural and immersive. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n- **Care & bond**: Feed bottles, rock to sleep, cheer him up.\n\n- **Play together**: Quick, silly mini-games that make the baby giggle.\n\n- **Dress-up**: Mix and match adorable outfits and space-themed accessories.\n\n- **Mixed reality**: Bring the baby into your real space for natural, immersive interactions.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Mixed reality makes every interaction feel natural and immersive. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28495411743478918"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499314643_1665061630834025_3392617167511406392_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HNrJ5tNkRYUQ7kNvwHXkrTh&_nc_oc=AdpHzp5nCl4v5YyTX-VS7y5P0I2dGVQeosG_LJoRUza6BLzNMEuDvNyv11i_dtcA2bI&_nc_zt=3&_nc_ht=scontent-
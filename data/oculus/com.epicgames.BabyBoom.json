5/491819417_762876093404815_2265287201607971015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YKRbLkbtB9IQ7kNvwEDYED6&_nc_oc=AdrREIjZl1qm9cfbqyU0QSkR5r5qe4P8LS5s45N2o2Kc39CYvUBNnHhq-rT0ukdflKk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_lRv1hF472m_QBLrxmdK5IVT9UtsCcug-Oo1-iBNQUg&oe=6A5E1344"}, {"file_name": "Screenshot3.png", "id": "1493973695238404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGTqgBRZxGkQ7kNvwEQHeJU&_nc_oc=AdofZtvAFO2PF4mBbdcyXeNSvNdpWm6pkygm58rWEapYc1a0a8gQGpEolQgdPc_SXns&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcZ0FtcyccjATwxEV9ciYrgZx-C0wsfGEneGhTd9oi9w&oe=6A5E0FC0"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AKM1KAxOiCwQ7kNvwFKJ81W&_nc_oc=AdqL2y1oupwHzRRFG2jrIBd1RVoPht5ZalZLz7aZQg9EGb1lbkQf5x1x8RQZvF5fEJs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVkSFKi8_5i3jq35bU-FPq0LRIU7IaTaMQeJLUflV31w&oe=6A5E1798"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nw91olqt6FwQ7kNvwEbr2jg&_nc_oc=Adp8GZIIBKzxacfBpqZy3Vw4-lvnFUnI9rLfAmYgNSEiQEHrsSdnPPw9r9ucSepov0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFPkmZnVygEi-gMqRtjLmJ966f23fR92MQr1G6l2Gngg&oe=6A5E0C5B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YV-JOcSaPdIQ7kNvwEQK1aA&_nc_oc=AdrXQ5nqGl7CS5hIapbM_fgjFnN_tRQmJUC8qeRC09TkXanj_h-IIWUzMhrf-F9ylZc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO14-vh05FjTH0qgoaTJO78pQ1JwQp-C6HxwQ4-1_FpQ&oe=6A5E148D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
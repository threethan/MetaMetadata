771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvBYk4IuofAQ7kNvwFHdnKx&_nc_oc=AdrY2QciMXp9N-yXQHuhyuBco_-kdy74Y7YTEaLn9Ef45JMg3i468iPoVTCjNv8EKOM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKbDg-OTpJP0hle4QVLbYka-weQDfkdDnwebgxO5u7mxA&oe=6AAD6200"}, {"file_name": "s4.png", "id": "2151413345588892", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491823783_2151413348922225_918868131320597515_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FN0Uo8n8B2AQ7kNvwF64Smd&_nc_oc=AdqOvebicQ1s145Wry73e4iQFJbK4MtSKuolRpXo6umk9bKiT3BuaAcPRXYaQffRti8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJtx7aw85sAS1qn3ioXZH6jmnkjYjs6_ZddpfU14qAKPQ&oe=6AAD3B63"}, {"file_name": "s5.png", "id": "1724107615540631", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491824328_1724107618873964_6033311960263565962_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eKOJHUu52xQQ7kNvwGrZ2-T&_nc_oc=AdpkFvsqLe6LiR7pUcJxTcBdosJjyGftaGza8wpCAb8Wjsuqu5R4NTM9J7sQWkYcenk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJj98p66s2uV51pQezme3yqZ0Ch7kBbWZjlKimMtAdB6A&oe=6AAD4BEE"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p6FfVrQHkRUQ7kNvwEGqUKV&_nc_oc=Ado7FyNHvVDEWM4lDKdXCd8MUKKBvJqAXMUi9yQXtAa87C55tOL48xlf82dNH_5w5Ls&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLes0CqWYHzX9Cht2ag6YFVW_Mfgm-0jU5FH3h9TIg2Hg&oe=6AAD2E8D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Use controllers to feed, entertain, rock, and dress him. Mixed reality makes every interaction feel more natural and immersive. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n- **Care & bond**: Feed bottles, rock to sleep, cheer him up.\n\n- **Play together**: Quick, silly mini-games that make the baby giggle.\n\n- **Dress-up**: Mix and match adorable outfits and space-themed accessories.\n\n- **Mixed reality**: Bring the baby into your real space for natural, immersive interactions.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Mixed reality makes every interaction feel natural and immersive. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28495411743478918"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499314643_1665061630834025_3392617167511406392_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc
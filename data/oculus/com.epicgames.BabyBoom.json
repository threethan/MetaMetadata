5/491819417_762876093404815_2265287201607971015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AGfIC1K8liQQ7kNvwGmJnXD&_nc_oc=Adr-u5hRutt6SoSIv3EGLPdjV04cJsGZepJBTzOBFmd5RZpNVRHOZsJ0jZZZu9zqAgA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEO2V-p6KhQ4az-hULFpbM3tS64O8r5BIIWRhBKA2ZWw&oe=6A64AAC4"}, {"file_name": "Screenshot3.png", "id": "1493973695238404", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=urhNGxXUuIcQ7kNvwFe12XP&_nc_oc=Ado5y62Cf-kTKzPxpj-ODHFMrQIts5bsKVwKUU45q-q7XMdNYccS8971coEUv2qRWks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAf16CySse02HHWnvU2Ijw5XP1U64VENJLTGm-v41ujg&oe=6A64A740"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-I7cpQLdnIQQ7kNvwHWG0tw&_nc_oc=AdoTbYz5dq3eO_G5totHj5rEx8EJcocYdJ_1O9sAuvzFoQ12fbq_X9h4XGsb0i1ZVUU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB4qHPhl7qNOMjT2-bqRQ4TJem60lssjFsXH2ytwrIgGA&oe=6A64AF18"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aju5rrk8SkMQ7kNvwGbKmGq&_nc_oc=AdpaqF1rRjyxTjXmUug9KYeUHpjnmEYci3su8m-I1Kc6bDF15YL7kiLyFL98smbhHTk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDaSth3RGLG70ZNcmkwQiVS5HzYzbNxS3-SPq8hMxSNxA&oe=6A64A3DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXtV6Mg_rngQ7kNvwHReNuI&_nc_oc=AdqOHdvhGmSRIFiV3ImzZ3RonNXi2KQrMISX51UlZxyvb_-g7Utc6DCcPSL9C4XXqTM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcgOHq5Tu27LL4cyIRhfmVAq_NQuW3LYBeDxiS3xh9pg&oe=6A64AC0D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
5/491819417_762876093404815_2265287201607971015_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Sw6AGTAO5AQ7kNvwF5eTJW&_nc_oc=AdqjEvML4nOHRRFmktz0Fsb3b4DVgc-4-B4yq_eq7sr_qYStnOAueHh1g3mEC1jhh18&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8cjrbhhaHwkTWYdNEEer1xHQfN-FC5LgPM8JvAsT4nQ&oe=6A747CC4"}, {"file_name": "Screenshot3.png", "id": "1493973695238404", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823968_1493973698571737_3732313782454802067_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lgmCmRT1JS0Q7kNvwHVwy5J&_nc_oc=AdrZe0d2eFS7lolGPDZlq2yYXK46WevgylcIqmZzLDc71ZBRQK58yZoBEMjCShm2O48&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG2ZaM2uaXFZ7Vz2aDJvT4Nw5I9zVuswmwWAXyTmBpW7A&oe=6A747940"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R1tKeF0X70wQ7kNvwGCj4Ub&_nc_oc=Adr26FwvHTAL448-2oZwrXQOtyOLF-3kmNXwrTDbcZlQul5wxXaIaAF_nUlTuLFSXzw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIQaGRi263k2Kltv8HtBvmpckSWH6v0mw8SorEbq6Y8g&oe=6A748118"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YLgKGJNmT7EQ7kNvwEvLvuU&_nc_oc=Adq9wl70jioolzq6ebXvjWB-9e2xlRdbpM5XF-h5gNYjyO2J2GYjc4i9CHZzj2ngzxo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEK1ov3tnIEpDGvCpuOZX-NRv9L0JiULSFnE7PMV5jXhA&oe=6A7475DB"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=49ZhJTX-NJUQ7kNvwE0OfNE&_nc_oc=AdqD0-hZPvRD9sX4oEvkF-jBtCWs5dTk-N-jrRdtH-c43V5LsmDRDp7Q9VVE0HnhsPE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_F6NGdE4-51DPTbxskdkzLAAe--9yEZ1qwUKU3bWx0Q&oe=6A747E0D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input
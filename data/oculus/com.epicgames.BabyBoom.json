c_oc=Adof6LZ8URp1e01_N2z_BiBwQOFGa4sqlwxxocwvKh8JPg_AANysKWYlTJ3B0UZvS7A&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyBO8negRIEXfNBYPfZoh9fEHZbgOQBt3ynMnGhSt9N0g&oe=69C7C4C0"}, {"file_name": "Screenshot4.png", "id": "765689486332916", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491820983_765689489666249_6954906380173755963_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uU43f_qiPF8Q7kNvwGhQk3I&_nc_oc=Adrzver4AYvoqgfPLK78URAo2U78RhS5Ng_lxUJJG9a68SKvQGQ5XihG5FFRzQn8EiA&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwIQNg3zR80AskVg6585IMEimddmgqB8DHhKIrN2Oj34w&oe=69C7CC98"}, {"file_name": "Screenshot5.png", "id": "1080517984067091", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/491826562_1080517987400424_456740474137195272_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VosWd_hylLIQ7kNvwG1rrZO&_nc_oc=Ado4juk0SUs4RYphiPZKr8tVxc5-oNjmA7AQ8VOaBGv72BiSEBxR21zSfu9t0x6RNc4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwoNVGZLOLFAfGXkheNAZatVBrV5ZpEjeLfGsbihpcdrg&oe=69C7C15B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "BannerBB_2.png", "id": "1252391646644285", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/491824081_1252391649977618_8052090914367398690_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nNnIpgUOr_MQ7kNvwG1qLNu&_nc_oc=Adqi7dDgpSNUeFEFyKoxzizOg_a7-R9vmMIoYOwf9OMRa_FMxY9WdFRh5jFOug7V88w&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwssEC5DeWGdllJid_2I6lDci-58ENG2SrN6udSgpzBZA&oe=69C7C98D"}, "display_name": "Baby Boom", "keywords": [], "long_description": "**Baby Boom** is a cozy mixed-reality life sim where you care for a little space baby right in your room. Reach out with your hands to feed, entertain, rock, and dress him\u2014no controllers needed. Unlock outfits and enjoy bite-size mini-games that fit perfectly into short sessions.\n\n{1804321480451609}\n\n# What you\u2019ll do\n\n-  Care & bond: Feed bottles, rock to sleep, cheer him up.\n\n-  Play together: Quick, silly mini-games that make the baby giggle.\n\n- Dress-up: Mix and match adorable outfits and space-themed accessories.\n\n- Hand-tracking: Natural, intuitive interactions with your own hands.\n\n\nWholesome, relaxing, and kid-friendly. No violence or scary content\u2014just sweet moments and gentle humor.\n\nYour little one is already waiting! \ud83d\udc76\u2728\n", "short_description": "Care for a tiny space baby in mixed reality! Play games, feed him, and dress him in cute outfits. Hand-tracking controls make everything feel natural\u2014no controllers needed. Relaxing, funny, and wholesome fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://babyboomar.com/privacypolicy", "developer_terms_of_service_url": null, "publisher_name": "THEIA GAMES", "support_website_url": null, "website_url": "https://babyboomar.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24911533498533445"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/499314643_1665061630834025_3392617167511406392_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d7GSaZXoPJoQ7kNvwHD6isb&_nc_oc=AdoWRAndvrGUK01NwVSOpoPwf69XqYLWIw8kq5zWVCsskTtsxoaYlr8Q6o_ghBXGLzE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_A
uscdn.com/v/t64.5771-25/499296119_810181632067156_8636969592252152382_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yL93qK2LBmYQ7kNvwG3J25t&_nc_oc=AdoB00FS8lDgcczKpjnT5ozTfPcW0gGSNe9vbe9kvkx-MmQQou_5-2-jcazoRoGteEw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnUOxQ7A5Nb4hzm3e8bBIGoqhuIWO-JaQmvOkBTPkvug&oe=6AE4B747"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "monkeh (OLD PAGE)", "keywords": ["monkey", "monkeys", "gorilla", "fun", "capuchin"], "long_description": "\"Reject Humanity, Become Monkeh.\"\n\nRun, climb, and jump with other monkeh using the iconic locomotion method that only needs the movement of your hands.\n\nMonkeh is a chaotic VR  game where you fling your goofy little arms through forests, caves, canyons, and snow-covered peaks. Run, jump, and climb like a true monkeh while dodging other players and showing off your ridiculous cosmetics, from bananas on your head to drip that should be illegal.", "short_description": "Monkeh is a chaotic VR  game where you fling your goofy little arms through forests, caves, canyons, and snow-covered peaks. Run, jump, and climb like a true monkeh while dodging other players and showing off your ridiculous cosmetics, from bananas on your head to drip that should be illegal."}]}, "developer_name": "CDN", "developer_privacy_policy_url": "https://sites.google.com/view/monkehvr/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "CDN", "support_website_url": null, "website_url": "https://sites.google.com/view/monkehvr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1023770785722696"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory
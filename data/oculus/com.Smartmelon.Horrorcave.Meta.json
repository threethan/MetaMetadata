_1127798882661958_1360682723802262374_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iCEz1BuMNXcQ7kNvwF9B0gO&_nc_oc=AdrClN7GHYrLif0F5Kq34QTQjRhwn2pLg0Ho3GNBucBdR9oBlHqa2Euft36NzYmYbA8&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOxNXzluWD8pZSHSpjsrnc2PGZMu34ifRQ_sbr7RiPag&oe=6AB66CF4"}, {"file_name": "\u5546\u5e975.png", "id": "1480763716303268", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491824328_1480763719636601_767198147535322913_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42d5vzV9YT4Q7kNvwE2DL6x&_nc_oc=AdpH4pnAwSQbBvs_RFKkOB6Dnv4ipa7Uj5u6fi17bYu9iIoiXnq41-mfWb2W9B-e7iY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgO6tDP9H8QhT7AEKDps2ZVeKZIbB7RIXZzf2djbyujw&oe=6AB67C01"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "The hole never ends", "keywords": ["Horror", "Cave", "Mining", "Survival", "Escape"], "long_description": "The hole never ends\n\ud83d\udc80 A VR descent into darkness.\nDeep beneath the Karst Rift Zone, expeditions vanish without a trace. Whispers echo through the caverns, strange shapes move in the dark\u2014and now it\u2019s your turn to enter.\n\ud83e\ude93 Features\n\n True immersion: Crawl, climb, and squeeze through suffocating tunnels with only your headlamp to guide you.\n\n\n Treasure vs. terror: Mine rare minerals and relics, trade with hidden merchants, and upgrade your gear\u2014knowing every discovery draws the darkness closer.\n\n\n Unpredictable fear: Collapsing tunnels, shifting paths, and creatures that stalk your every move. Even the cave itself feels alive.\n\n\n Endgame: Find the corruption source, face its guardian, and destroy it\u2026 if you make it that far.\n\n\n\u26a0\ufe0f WARNING\n Not a casual VR adventure. Expect screams, racing heartbeats, and fear that lingers after the headset comes off.\n\ud83d\udc49 Enter Horror Cave. Escape with treasure\u2014if you can.\n\nContains content made by SCP Foundation.\nhttp://www.scp-wiki.net\n\nThis game is licensed under a Creative Commons Attribution-ShareAlike 3.0 International License.\nhttps://creativecommons.org/licenses/by-sa/3.0/legalcode\n\nThis software includes third party libraries and solutions that are not licensed under Creative Commons Attribution-ShareAlike 3.0 International License. Please check the license.txt file (in the root directory of game files) for more information.", "short_description": "The hole never ends\n\u2013 A VR survival horror descent deep into the Karst Rift Zone. Squeeze through suffocating tunnels, mine rare minerals, and uncover relics\n\u2014but every step awakens the darkness. Trade with merchants, upgrade your gear, and choose between treasure or survival.\n \u2014Collapsing passages, caves that feel alive, and relentless creatures blur the line between game and nightmare. Face the corruption\u2019s guardian and escape with treasure."}]}, "developer_name": "Smartmelon Games", "developer_privacy_policy_url": "https://www.thesmartmelon.com/cat_privacy_en", "developer_terms_of_service_url": null, "publisher_name": "Tyche Mobile Technology Inc Limited", "support_website_url": null, "website_url": "https://www.thesmartmelon.com/home.html", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24660002660316672"}}]}, "scheduled_offers": {"count": 7, "nodes": [{"status": "PU
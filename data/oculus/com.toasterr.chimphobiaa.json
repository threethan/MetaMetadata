obia, face your fear head-on as you navigate dark caves, and the unsettling gaze of what\u2019s hunting you.\n\n"}]}, "developer_name": "Toastyy", "developer_privacy_policy_url": "https://sites.google.com/view/chimphobiavrr/home", "developer_terms_of_service_url": null, "publisher_name": "Toastyy", "support_website_url": null, "website_url": "https://sites.google.com/view/chimphobiavrr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "644354873106712"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "24248980934759977"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "747174054904800"}]}, "baseline_offer": {"id": "747174054904800"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1755108480, "status": "PUBLISHED", "id": "747174054904800"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25047956934862369", "version": "00.00.10"}, "id": "1256176142617256", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24220008310990573", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "25047956934862369"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channe
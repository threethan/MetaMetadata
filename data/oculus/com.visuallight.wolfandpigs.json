MUT6Aowr7thV9bi0NTjyCTPlsCIh9Q0k8Vrm8bOlm_74gR0SE&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTMXaiidTVzQA292EjE4BhuSa-f1XEH5XAzMnizpX0lcw&oe=6B09A72A"}, {"file_name": "c.png", "id": "1249047338861270", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974829_1249047345527936_6870531231154212416_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HCRgOxcJzuUQ7kNvwH41UtT&_nc_oc=Adpo0YzgbWUOP_05EyjEv-tUMgOuNwl6HhVHXV7qDIM1Vz7DPHBBE3jqHZrf1kar7Hk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQB4ytRaHipa-Sne6_gyHtDALZ4acOZEwdaHi8gpXVP3A&oe=6B09C437"}, {"file_name": "11.png", "id": "1428676660843008", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974676_1428676664176341_4960148504246094156_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LOSpZgOYpcwQ7kNvwGYqhtU&_nc_oc=AdqxIyb_fPO0OHzBikEDFu5pOvRPMUyyYANFRAC3iKrQEgZ0MFDyMBX-6SrCJvc50X8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTtRsiy8L7t2hg41acYsyJpc3LnuZXklpDHbhFv9eXMjg&oe=6B09A37D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84\uc774\ubbf8\uc9c0.png", "id": "864541667751484", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/38974676_864541671084817_1988819419266658067_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AUTbta0011wQ7kNvwHVQEyj&_nc_oc=AdruEns2hFu8bYh8IwUmnGWS_cYF4DuO5tEaDR8CtImxZZFu6RXQ2_ttEvzjN2jw8uI&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRGdaaFnvEuoBdW23YV28GYWhIFBC89zv0D0IeJXK5QZQ&oe=6B099943"}, "display_name": "Wolf and Pigs", "keywords": [], "long_description": "Once upon a time, the notorious Pig Brothers gang invaded the New World, blasting and disfiguring nature to build their secret base.\n\nPortrayed as evil by the media \u2013 who have been bought and paid by the Pig Brothers \u2013 the Wolf is the last defense between Nature and the brothers\u2019 greed.\n\nWith no one to stop them, the Pig Brothers are laying waste to everything in their path, raking in the cash. Everyone thinks that Wolf is dead, but there\u2019s a sliver of hope. It turns out that Wolf has upgraded his body with high-end prosthetic arms loaded with all sorts of weaponry, including shotguns and bombs!\n\nNature has its defender at last. Will the Pig Brothers pay the ultimate price?\n\nKey Features:\nExperience an age-old fairy tale from a totally different perspective!\nMove freely across the world through an innovative grappling mechanic.\nUpgrade your character to fight the final boss.\nExplore the world along with thousands of interactive objects.\nSolve challenging puzzles and infiltrators!", "short_description": "Wolf & Pigs: Out for Vengeance is a fresh take on the classic fable \u201cThe Three Little Pigs.\u201d When the notorious Pig Brothers Gang invades the New World to build their compound, an unlikely protector vows to put an end to the Pigs greedy, nature-destroying ways!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
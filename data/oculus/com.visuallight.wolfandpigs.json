38974829_1249047345527936_6870531231154212416_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vTN7xQv0S0gQ7kNvwEsESZH&_nc_oc=AdrZ_z1ybthpb95LI8OveSyK0A_JrAMGvMh94hLHoUPaEIc8UAfVBID0eCJ0OIIklIM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af15bbqWu_dYhiclHl8PQDZKaduNBRJHHlZss6GrXmXTeQ&oe=69E63077"}, {"file_name": "11.png", "id": "1428676660843008", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974676_1428676664176341_4960148504246094156_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bbh7rMUCtxEQ7kNvwFOmHee&_nc_oc=AdoUmqn430absMtJJcAQTcFfgJIzWg16AO7Ea38TUTbhrph0UFwWOy4gZaOgPXWgDik&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Uz_po8K1BV0I-PIyoZl7SdQhDP6HiN8L77ZgCoxfM2A&oe=69E60FBD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84\uc774\ubbf8\uc9c0.png", "id": "864541667751484", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974676_864541671084817_1988819419266658067_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=evORcdLiLHYQ7kNvwFY0nwk&_nc_oc=AdqBHAPPrVi3JkZz8zrw6SGItRwqMU693ySFb5EnYj6WzN2ppwKySjc-BniJDcN46RY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lWdJDu0T7P990yIEkrY4X5XbjZaZWKYInS13dJX35DQ&oe=69E63DC3"}, "display_name": "Wolf and Pigs", "keywords": [], "long_description": "Once upon a time, the notorious Pig Brothers gang invaded the New World, blasting and disfiguring nature to build their secret base.\n\nPortrayed as evil by the media \u2013 who have been bought and paid by the Pig Brothers \u2013 the Wolf is the last defense between Nature and the brothers\u2019 greed.\n\nWith no one to stop them, the Pig Brothers are laying waste to everything in their path, raking in the cash. Everyone thinks that Wolf is dead, but there\u2019s a sliver of hope. It turns out that Wolf has upgraded his body with high-end prosthetic arms loaded with all sorts of weaponry, including shotguns and bombs!\n\nNature has its defender at last. Will the Pig Brothers pay the ultimate price?\n\nKey Features:\nExperience an age-old fairy tale from a totally different perspective!\nMove freely across the world through an innovative grappling mechanic.\nUpgrade your character to fight the final boss.\nExplore the world along with thousands of interactive objects.\nSolve challenging puzzles and infiltrators!", "short_description": "Wolf & Pigs: Out for Vengeance is a fresh take on the classic fable \u201cThe Three Little Pigs.\u201d When the notorious Pig Brothers Gang invades the New World to build their compound, an unlikely protector vows to put an end to the Pigs greedy, nature-destroying ways!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "438192231452047"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3229515007323401"}, {"status": "PUBLISHED", "id": "902047457017752"}]}, "baseline_offer": {"id": "3229515007323401"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1650992400, "status": "PUBLISHED", "id": "3229515007323401"}]}, 
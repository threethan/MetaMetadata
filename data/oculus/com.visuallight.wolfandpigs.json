uXgCohd7PLIHqL4Lo_nKBhuXFPY6Chc3rPrWYOTG1Pj9KwwQHU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afs-NVmOGHppa6Z050QWxCqr58fotn8WRGeQNv0ghb0LlQ&oe=699DADF7"}, {"file_name": "11.png", "id": "1428676660843008", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974676_1428676664176341_4960148504246094156_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z0m3EKzx8nwQ7kNvwGylEjH&_nc_oc=AdnZiJq6adeDsob1Ogz0FmPTi9UpppRXZ-RqJr9KtVkex6zDA0JOk8RHUZRBnLYBNeg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvAWZMWtVjOYzB6UgayE7_bhX5HRHzHV-O7AGbGC9xkEQ&oe=699D8D3D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84\uc774\ubbf8\uc9c0.png", "id": "864541667751484", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974676_864541671084817_1988819419266658067_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rdnr9uRhIwEQ7kNvwGTtf0p&_nc_oc=AdnBv9FvytUjs63Z2GOg3e3I3dAeJDyy7aSwpIPiPveHGD2ApX7ImfuU2lW1YKEtUK4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvhqMQ4jJvEuBTdbR6DnPPZ-IhCewhCnCPpgtc2SeeIHA&oe=699D8303"}, "display_name": "Wolf and Pigs", "keywords": [], "long_description": "Once upon a time, the notorious Pig Brothers gang invaded the New World, blasting and disfiguring nature to build their secret base.\n\nPortrayed as evil by the media \u2013 who have been bought and paid by the Pig Brothers \u2013 the Wolf is the last defense between Nature and the brothers\u2019 greed.\n\nWith no one to stop them, the Pig Brothers are laying waste to everything in their path, raking in the cash. Everyone thinks that Wolf is dead, but there\u2019s a sliver of hope. It turns out that Wolf has upgraded his body with high-end prosthetic arms loaded with all sorts of weaponry, including shotguns and bombs!\n\nNature has its defender at last. Will the Pig Brothers pay the ultimate price?\n\nKey Features:\nExperience an age-old fairy tale from a totally different perspective!\nMove freely across the world through an innovative grappling mechanic.\nUpgrade your character to fight the final boss.\nExplore the world along with thousands of interactive objects.\nSolve challenging puzzles and infiltrators!", "short_description": "Wolf & Pigs: Out for Vengeance is a fresh take on the classic fable \u201cThe Three Little Pigs.\u201d When the notorious Pig Brothers Gang invades the New World to build their compound, an unlikely protector vows to put an end to the Pigs greedy, nature-destroying ways!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "438192231452047"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "3229515007323401"}, {"status": "PUBLISHED", "id": "902047457017752"}]}, "baseline_offer": {"id": "3229515007323401"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1650992400, "status": "PUBLISHED", "id": "3229515007323401"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "25357067103906827", "version": ".7"}, "id": "511916
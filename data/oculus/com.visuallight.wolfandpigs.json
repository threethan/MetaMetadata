0QHgSzrl70IqCWu7o5qAooInPXm58Nw70nb_MkkcIdBABK6AI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBiUs8Q6UXzVFzbAFj9rKHbtjR5h5npUSNWYDUO1GMzw&oe=6AFB26AA"}, {"file_name": "c.png", "id": "1249047338861270", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974829_1249047345527936_6870531231154212416_n.png?_nc_cat=110&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YztHoWJr3RMQ7kNvwGpTfPL&_nc_oc=AdrYpPWXY2Cu1Iwz-iheyqwV7PVLTU93ZjIaVCMCNvp3GkBf_zkNgSbZ2ZnkS43gP3Y&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlvGJCur2mjSUyo27e2UsXh5XkDM8YwFxtCkeL-ygoOw&oe=6AFB43B7"}, {"file_name": "11.png", "id": "1428676660843008", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974676_1428676664176341_4960148504246094156_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mF-6HbKgqOIQ7kNvwFUBfU5&_nc_oc=Adpb49QgTGaXNf-eormymotbL3rAbpZfEyja0x1nlvT4jPu-fTx8MHKOWT3zfP897BE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStV0USINVtRc6Pr1pwQk8dHILKKBphYCLRPNPpPUzBZA&oe=6AFB22FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\ucee4\ubc84\uc774\ubbf8\uc9c0.png", "id": "864541667751484", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974676_864541671084817_1988819419266658067_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VMXib3LMlvMQ7kNvwFU3FpK&_nc_oc=AdpqQ7k0DVzB24bVffoDI0r99RBCvIM5nAOwflf7-FwPMhaL1GhUQ1BLxXz0qjNFGHU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT3NV3wpmp5fsXDA5TpbpStuiqoSfqs-z_tG5zMLj6syw&oe=6AFB18C3"}, "display_name": "Wolf and Pigs", "keywords": [], "long_description": "Once upon a time, the notorious Pig Brothers gang invaded the New World, blasting and disfiguring nature to build their secret base.\n\nPortrayed as evil by the media \u2013 who have been bought and paid by the Pig Brothers \u2013 the Wolf is the last defense between Nature and the brothers\u2019 greed.\n\nWith no one to stop them, the Pig Brothers are laying waste to everything in their path, raking in the cash. Everyone thinks that Wolf is dead, but there\u2019s a sliver of hope. It turns out that Wolf has upgraded his body with high-end prosthetic arms loaded with all sorts of weaponry, including shotguns and bombs!\n\nNature has its defender at last. Will the Pig Brothers pay the ultimate price?\n\nKey Features:\nExperience an age-old fairy tale from a totally different perspective!\nMove freely across the world through an innovative grappling mechanic.\nUpgrade your character to fight the final boss.\nExplore the world along with thousands of interactive objects.\nSolve challenging puzzles and infiltrators!", "short_description": "Wolf & Pigs: Out for Vengeance is a fresh take on the classic fable \u201cThe Three Little Pigs.\u201d When the notorious Pig Brothers Gang invades the New World to build their compound, an unlikely protector vows to put an end to the Pigs greedy, nature-destroying ways!"}]}, "developer_name": null, "developer_privacy_policy_url": "http://visuallight.kr/notice/?vid=6", "developer_terms_of_service_url": null, "publisher_name": "VisualLight Co., Ltd.", "support_website_url": null, "website_url": "http://visuallight.kr/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "ADVENTURE", "SHOOTER"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes":
ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3e0172yyKdIQ7kNvwGgWJ_q&_nc_oc=AdqN0fFSpp8A1RbL2t5DGjLYbRhhGPH1jodbjWNS1YbZntLo_DQ2SyVm_pnQyO8ve10&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGlhmZASsfrt0ApL_wT3Ns7fqTqaoi09k4hrUnxmo9gw&oe=6A71EAE4"}, {"file_name": "04-account.png", "id": "1554659979532616", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499623295_1554659982865949_495688055908645316_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tLHCstQATF0Q7kNvwE35VAB&_nc_oc=AdrqWDstXYfC1kuP3lP1kNQQgpJlGjOWOHjgo4mOpg6zTt0sTcsyjmnG_eGU3bAsYT8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFCHUK3Xpoq0ponAlR3hxNy8CHSwJnzwXwYOWkD51Jm2Q&oe=6A71D487"}, {"file_name": "05-discover2.png", "id": "1362521969114576", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499619588_1362521972447909_8168153066989709760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1R-Czxy6RpsQ7kNvwFzh_H0&_nc_oc=AdoOJsE6UHAKiVtQS-4Bl1FJWEIT0t8yXVPjA-bLzSeiQ7Plg3rtV0so5wUDmnslhls&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg5U3t5r25p-qoQNmRAybKfoVDTBMrgaKVThiuo7zROA&oe=6A71D59D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRC NEXUS QUEST", "keywords": ["vrchat", "nexus"], "long_description": "VRC-NEXUS is a standalone companion for VRChat, built for Quest.\n\n\u2022 Discover & equip public avatars, and manage your favourites in custom sections\n\u2022 Import your VRChat website favourites (\"inf favourites\")\n\u2022 Friends, worlds, groups and notifications at a glance\n\u2022 OSC controls: chatbox, live avatar-parameter sliders (set height, hue, emission\u2026), and quick actions (mute, jump)\n\u2022 Visual OSC scripting: drag-free code blocks with loops, ramps and a one-tap rainbow \u2014 including bounce/ping-pong cycles\n\u2022 Sign in with your own VRChat account (password never stored; only a local session cookie)\n\u2022 In-app auto-updates\n\nUnofficial third-party tool. Not affiliated with or endorsed by VRChat Inc.", "short_description": "Your VRChat companion on Quest \u2014 browse & equip avatars, manage favourites, friends, worlds, plus OSC chatbox, avatar controls & visual scripting.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/XnotCykoX/vrc-nexus-quest/main/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "_cykoo_", "support_website_url": null, "website_url": "https://vrc-nexus.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1114781715061235"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1015580800912690"}]}, "baseline_offer": {"id": "1015580800912690"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781571300, "status": "PUBLISHED", "id": "1015580800912690"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1183329421539797", "version": "0.4.27"}, "id": "1305431047944649", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1114160378456702", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1183329421539797"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1305431047944649"}]}, "change_log": "VRC-NEXUS Quest \u2014 What's New\r\n\r\n\ufffd Now-playing music is way easier to set up\r\n\r\n- New first-run walkthrough \u2014 the first time you open the Chatbox tab, a step-by-step guide pops up and walks you through getting music working, with a picture of each screen:\r\n  a. Toggle media integration \u2014 turn on Now playing (device) (with a one-tap button that does it for you).\r\n  b. Grant notification access \u2014 opens the correct Quest screen; just toggle VRC-NEXUS on.\r\n  c. Done \u2014 play any media on your Quest and it shows in your chatbox automatically.\r\n  d. Optional \u2014 want music from your phone/PC instead? Connect Last.fm (free, no login).\r\n- Back / Next / Skip navigation with progress dots, and it only shows once.\r\n- Replay anytime with the new \ufffd Setup guide button in the now-playing options.\r\n\r\n\ufffd Working \"Notification access\" button (no Developer Mode / ADB)", "created_date": 1785300232, "id": "1183329421539797", "version": "0.4.27", "version_code": 72, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1114160378456702", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1183329421539797"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1305431047944649"}]}, "change_log": "VRC-NEXUS Quest \u2014 Changelog since 0.4.8\r\n\r\n\ufffd New features\r\n\r\n- \ufffd Nexus Statistics tab \u2014 live community presence (using now, peak today, all-time) plus your personal stats (favourites, sections, avatars worn, worlds visited, presets, days as a member) and Community Hub totals.\r\n- World / User / Avatar popups \u2014 tap anything to open a detailed card: mutual friends, instance names with hosting group + region + 18+ tags, self-invite/join, worn-avatar save, wear/favourite/copy.\r\n- Settings \u2014 themes (Nexus, Midnight, Ember, Emerald, Rose, Slate, Light), custom accent colour, compact mode, reduce-motion, blur toggle, and a chosen launch tab.\r\n- Full Backup & Restore \u2014 export/import your favourites, sections, chatbox setup, presets, and settings (auth never included).\r\n\r\n\ufffd Chatbox & Music\r\n\r\n- Removed Spotify; added Last.fm as a free nupdating while minimized, with synced lyrics+ progress.\r\n- Multiple integrations per line (e.g. time + date on one line).\r\n- Customizable progress bars for now-playing.\r\n- Chatbox presets/profiles \u2014 save, switch, and share complete setups (fixed the bug where clicking a preset did nothing; community imports now bring all settings).\r\n- Fixed the mic toggle always showing \"on\".\r\n\r\n\ufffd OSC\r\n\r\n- Hue/emission params now auto-detect across avatar changes \u2014 the Rainbow and other set_hue/set_emission scripts keep working on your new avatar without tapping Rescan, even while you're in VRChat.\r\n\r\n\ufffd Social & Instance tools\r\n\r\n- Instance Tools group \u2014 Players list + dedicated Invite Tools.\r\n- Group moderation \u2014 give/remove roles from\r\n- World favourites \u2014 add/remove worlds.\r\n- Favourites section filter \u2014 tap a section to show only its avatars.\r\n- Community share packs \u2014 share and import packs like the PC app, including sharing specific sections.\r\n- Fixed the player roster reading no players from the logs.\r\n\r\n\ufffd Interface\r\n\r\n- Left vertical sidebar with tidy, collapsible dropdown groups.\r\n- Merged Cache + Dev into one (Dev Mode no lg just works).\r\n- Customizable Home Quick Access \u2014 add your own shortcuts instead of fixed ones.\r\n- Help tab with common how-tos and a Join Discord button.\r\n- Cleaner, less cluttered layouts throughout.\r\n\r\n\ufffd Reliability & performance\r\n\r\n- Low-memory crash fixes \u2014 thumbnails lazy-load and release as you scroll, so big favourites lists no longer run theapp out of memory; added memory-pressure handling.\r\n- Last.fm hardened for scale \u2014 adaptive polling + automatic back-off, reliable even with thousands of users.\r\n- Community Hub fixed \u2014 presets, share packs, and scripts now load reliably.\r\n- Faster, cached Nexus presence that scales to large user counts.", "created_date": 1785285167, "id": "1183080761564663", "version": "0.4.23", "version_code": 68, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1114160378456702", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1183329421539797"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1305431047944649"}]}, "change_log": "newest update with last.fm support", "created_date": 1785210516, "id": "1181602291712510", "version": "0.4.8", "version_code": 53, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1114160378456702", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1183329421539797"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1
_nc_ohc=rdf0d136EiwQ7kNvwH2hS2w&_nc_oc=AdrwDrfLscNpsu5C5eVsH2lxubmuW0Id3HFeU3TuAYA28TZAqqiBfoRR1c6-qBx3pRg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPv_ffrYCp2za7o4rhAM9O2NlLgLogXZ3TCxxDeoH5CGw&oe=6AC51C5D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRC NEXUS QUEST", "keywords": ["vrchat", "nexus"], "long_description": "VRC-NEXUS is a standalone companion for VRChat, built for Quest.\n\n\u2022 Discover & equip public avatars, and manage your favourites in custom sections\n\u2022 Import your VRChat website favourites (\"inf favourites\")\n\u2022 Friends, worlds, groups and notifications at a glance\n\u2022 OSC controls: chatbox, live avatar-parameter sliders (set height, hue, emission\u2026), and quick actions (mute, jump)\n\u2022 Visual OSC scripting: drag-free code blocks with loops, ramps and a one-tap rainbow \u2014 including bounce/ping-pong cycles\n\u2022 Sign in with your own VRChat account (password never stored; only a local session cookie)\n\u2022 In-app auto-updates\n\nUnofficial third-party tool. Not affiliated with or endorsed by VRChat Inc.", "short_description": "Your VRChat companion on Quest \u2014 browse & equip avatars, manage favourites, friends, worlds, plus OSC chatbox, avatar controls & visual scripting.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/XnotCykoX/nexus-quest/refs/heads/main/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "_cykoo_", "support_website_url": null, "website_url": "https://vrc-nexus.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": 
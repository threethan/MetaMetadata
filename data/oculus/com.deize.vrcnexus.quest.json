ffiliated with or endorsed by VRChat Inc.", "short_description": "Your VRChat companion on Quest \u2014 browse & equip avatars, manage favourites, friends, worlds, plus OSC chatbox, avatar controls & visual scripting.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/XnotCykoX/vrc-nexus-quest/main/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "_cykoo_", "support_website_url": null, "website_url": "https://vrc-nexus.online/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1228796255027646"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1114781715061235"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1015580800912690"}]}, "baseline_offer": {"id": "1015580800912690"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1781571300, "status": "PUBLISHED", "id": "1015580800912690"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1223763244163081", "version": "1.35.0"}, "id": "1305431047944649", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1114160378456702", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1223763244163081
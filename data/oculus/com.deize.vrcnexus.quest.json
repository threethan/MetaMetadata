rcnik3RhWUUMN0rG5F0lkEuuzAQrBjg6wNKD51myeCFgXXH8eIg0iDWE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9a1aDVht_BoQKaBXOmht2P2qxKzsu7T5e_zfCOmuD85Q&oe=6A4539C7"}, {"file_name": "05-discover2.png", "id": "1362521969114576", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619588_1362521972447909_8168153066989709760_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1Z05XB-C-EQ7kNvwEs7lJz&_nc_oc=AdqIyb6HpyRY4UA66duWH3oOvAWiUmb5U_bK5VzSQ_37Pe4LpIkGoyki4bWvWcXjB4Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-B9FNVEVA_GDv5F_8WL7MeKUf_5jfmscbTW5sYImzThA&oe=6A45029D"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "VRC NEXUS QUEST", "keywords": ["vrchat", "nexus"], "long_description": "VRC-NEXUS is a standalone companion for VRChat, built for Quest.\n\n\u2022 Discover & equip public avatars, and manage your favourites in custom sections\n\u2022 Import your VRChat website favourites (\"inf favourites\")\n\u2022 Friends, worlds, groups and notifications at a glance\n\u2022 OSC controls: chatbox, live avatar-parameter sliders (set height, hue, emission\u2026), and quick actions (mute, jump)\n\u2022 Visual OSC scripting: drag-free code blocks with loops, ramps and a one-tap rainbow \u2014 including bounce/ping-pong cycles\n\u2022 Sign in with your own VRChat account (password never stored; only a local session cookie)\n\u2022 In-app auto-updates\n\nUnofficial third-party tool. Not affiliated with or endorsed by VRChat Inc.", "short_description": "Your VRChat companion on Quest \u2014 browse & equip avatars, manage favourites, friends, worlds, plus OSC chatbox, avatar controls & visual scripting.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://raw.githubusercontent.com/XnotCykoX/vrc-nexus-quest/main/PRIVACY.md", "developer_terms_of_service_url": null, "publisher_name": "_cykoo_", "support_website_url": null, "website_url": "https://vrc-nexus.online/", "category": null, "c
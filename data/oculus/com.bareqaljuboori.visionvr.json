oc=AdrGXLbnEukRvCblLmU2VUsELn34lmROemA35Bn3wW2c2dh4nxpo45-DRAsp0eEGam0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBUwtHLjWlHjk6Et1LFaBsrcHiLAiG_n5D-6ZflfX8jfQ&oe=6A5CB477"}, {"file_name": "tempImage8kFWmk.png", "id": "2486188498491652", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619588_2486188501824985_6374294127098193740_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UFWmabDY4TIQ7kNvwFHoIK1&_nc_oc=AdoZEGhqEc-mQkN5-uVlw_od3LmL0_Hi1aEe2V3M_qyVV8epbFoThD2gUb07IKqJoRA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAABoVfcoggz6akIjWv_gDergR5kfl1sOOIku2YBubqcQ&oe=6A5CE2DD"}, {"file_name": "tempImageCi0pNM.png", "id": "1359023102804281", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499297170_1359023109470947_6908731742593779712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndmtceyvn-sQ7kNvwHfRpy4&_nc_oc=AdpZKNZuSSqlMJgY6DWkkaYeGb-ykLaZKpjYdaEt-8RVxalPBR-x01Jmk_n8c1SqvvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFmglJOdNrBd9Y1lEKa-pqzFDRxzqrlhyy5pIterkOzw&oe=6A5CC44E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer-thumbnail-2560x1440.png", "id": "880652854427957", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499620860_880652857761290_3880383924433938729_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlOTihlE-aIQ7kNvwEJ5GMu&_nc_oc=Adp81A_SBYu3copFa_d-2PBAgPo-Jld02v8Htwlxgqkcay9Qm5UqRqOxM58Fjz2ralQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCTMzVm5O6Hqldq66v2NghzwWhjMGBJaCoxwulsy-1F_g&oe=6A5CD191"}, "display_name": "VR Vision Tracking", "keywords": [], "long_description": "Vision Training VR is a focused, distraction-free tool for eye-movement training in virtual reality. A clear 3D target moves through guided routines while you follow it with your eyes \u2014 helping you practice smooth pursuit, saccades, and convergence in a calm, fully immersive space.\n\nEverything is in your hands with a simple in-VR control panel:\n\n\u2022 Multiple routines \u2014 circular, horizontal, vertical, diagonal, and multi-target saccade patterns.\n\u2022 Adjustable speed, target size, and range of motion.\n\u2022 Choose target color and background color for the most comfortable contrast.\n\u2022 Eye modes \u2014 train both eyes, or isolate the left or right eye.\n\u2022 Pause and recenter at any time so the scene sits exactly where you want it.\n\nThe app drops you straight into VR, runs entirely on-device, and collects no personal data. Designed to be quiet, comfortable, and easy to use for short, repeatable training sessions.\n\nNote: This app is a general vision-training and eye-exercise tool. It is not a medical device and is not intended to diagnose, treat, or cure any condition. Consult a qualified eye-care professional for medical advice.", "short_description": "Follow a moving target through guided routines designed to exercise smooth-pursuit, saccadic, and convergence eye movements \u2014 the same kinds of tracking and coordination drills often used in vision training for amblyopia (lazy eye). Adjustable speed, range, and separate left-, right-, or both-eye modes let you tailor each session to build eye-tracking control and binocular coordination at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bareq4601358-alj.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bareq Aljuboori", "support_website_url": null, "website_url": "https://www.youtube.com/@BareqAljuboori", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": n
9023109470947_6908731742593779712_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ndmtceyvn-sQ7kNvwHfRpy4&_nc_oc=AdpZKNZuSSqlMJgY6DWkkaYeGb-ykLaZKpjYdaEt-8RVxalPBR-x01Jmk_n8c1SqvvQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBFmglJOdNrBd9Y1lEKa-pqzFDRxzqrlhyy5pIterkOzw&oe=6A5CC44E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "universal-basic-asset-2560x1440.png", "id": "1680986250405822", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499626172_1680986253739155_6188615311722333921_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a41PzqF9hRIQ7kNvwGp0e02&_nc_oc=AdpZGIKl3Sk3T9b1OWIXPI8lJ_J6N9nu-1lKmusqn0yU2FjDgN5i6qjNQftgw3bWMVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA3mHZ_hhcDJ6nmG0sEkouZusoh6hzESf5iyAIAFpLS1A&oe=6A5CB906"}, "display_name": "VR Vision Tracking", "keywords": ["Amblyopia", "vision", "LazyEye", "EyeExercise", "VrVision"], "long_description": "VR Vision Tracking is a focused, distraction-free tool for eye-movement training in virtual reality. A clear 3D target moves through guided routines while you follow it with your eyes \u2014 helping you practice smooth pursuit, saccades, and convergence in a calm, fully immersive space.  There are similar to the tracking and coordination drills often used in vision training for amblyopia (lazy eye). \n\nEverything is in your hands with a simple in-VR control panel:\n\n\u2022 Multiple routines \u2014 circular, horizontal, vertical, diagonal, and multi-target saccade patterns.\n\u2022 Adjustable speed, target size, and range of motion.\n\u2022 Choose target color and background color for the most comfortable contrast.\n\u2022 Eye modes \u2014 train both eyes, or isolate the left or right eye.\n\u2022 Pause and recenter at any time so the scene sits exactly where you want it.\n\nThe app drops you straight into VR, runs entirely on-device, and collects no personal data. Designed to be quiet, comfortable, and easy to use for short, repeatable training sessions.\n\nNote: This app is a general vision-training and eye-exercise tool. It is not a medical device and is not intended to diagnose, treat, or cure any condition. Consult a qualified eye-care professional for medical advice.", "short_description": "Follow a moving target through guided routines designed to exercise smooth-pursuit, saccadic, and convergence eye movements \u2014 the same kinds of tracking and coordination drills often used in vision training for amblyopia (lazy eye). Adjustable speed, range, and separate left-, right-, or both-eye modes let you tailor each session to build eye-tracking control and binocular coordination at your own pace."}]}, "developer_name": null, "developer_privacy_policy_url": "https://bareq4601358-alj.github.io/privacy.html", "developer_terms_of_service_url": null, "publisher_name": "Bareq Aljuboori", "support_website_url": null, "website_url": "https://www.youtube.com/@BareqAljuboori", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1087760677763576"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499619668_891445993245397_4018721519560387013_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bGPFIBaCjJkQ7kNvwGJbOIQ&_nc_oc=AdoIeC-t6DHgWAyze7rE-Ab9RKfgAv42s8efMj80vA1jIdV8MYTDVJ35HqKUIFtdx-U&_nc_zt=3&_nc_ht=sco
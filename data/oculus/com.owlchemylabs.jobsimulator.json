=1-7&_nc_sid=6e7a0a&_nc_ohc=hgZWwax3h-EQ7kNvwH0SV_C&_nc_oc=Adp14SkdhBRgya2nV5RtaSpKAiVikzQfRGKbZJxAGDzLS41DyVrVsslCbM9hIgyWcKw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIOReIW7k_HSXXX2QN6UiYGhwHZG2VBkuIsrnl85_0vQg&oe=6AA01E46"}, {"file_name": "migrated_image.png", "id": "255909895572847", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974774_387981685331873_6057595228301295616_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l9d6ecIH4FIQ7kNvwFdllh7&_nc_oc=AdpXzO-G6m-GR4jSZPPlLVeMrGNMTm0p6AS7BrvZL8HPGUUeOhy_YZYwDV4KIcDlI9A&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ1gU40FMCVkp_1XTa7FO-03cPvy1ZcUI8RWzxT7Ehi4w&oe=6AA00A6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "/tmp/qLdHoy", "id": "416428999187370", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/38974899_416429002520703_1841331893740503040_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PwJUxV3obFwQ7kNvwEuWpvy&_nc_oc=AdozxUm3r9r3LuRg7UqTJauQdPITSL4b-3N8LJNveMoQZ6yEQIrwh2dgfSnfq_4hAXw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIkClP7kVkeESbhisDlvS9SsM1ufprNagpCN0rrVf_9AQ&oe=6AA01B79"}, "display_name": "Job Simulator", "keywords": ["simulator", "job", "owlchemy", "touch", "hands"], "long_description": "*NEW UPDATE!* Work the never-ending night shift with the new Infinite Overtime mode!\n\nIn a world where robots have replaced all human jobs, step into the \"Job Simulator\" to learn what it was like 'to do the job'.\n\nPlayers can relive the glory days of work by simulating the ins and outs of being a gourmet chef, an office worker, a convenience store clerk, and more.\n \nKey Jobbing Features:\n\u25cf\tThrow a stapler at your boss! \n\u25cf\tLearn to 'job' in four not-so historically accurate representations of work-life before society was automated by robots! \n\u25cf\tUse your hands to stack, manipulate, throw, and smash physics objects in an inexplicably satisfying way! \n\u25cf\tAggressively chug coffee and eat questionable food from the trash!\n\u25cf\tAble to juggle tomatoes in real life? Do it in VR! Unable to juggle? There's no cleanup required in VR! \n\u25cf\tGain valuable life experience by firing new employees, serving slushy treats, brewing English tea, and ripping apart car engines!", "short_description": "A tongue-in-cheek virtual reality experience for Oculus Touch. In a world where robots have replaced all human jobs, step into the \"Job Simulator\" to learn what it was like 'to job'. Now with never-ending gameplay with the new \"Infinite Overtime\" update!"}]}, "developer_name": "Owlchemy Labs", "developer_privacy_policy_url": "https://owlchemylabs.com/privacy/index.html", "developer_terms_of_service_url": "http://owlchemylabs.com/terms", "publisher_name": "Owlchemy Labs", "support_website_url": "https://owlchemylabs.com/support/", "website_url": "http://jobsimulatorgame.com/", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ACTION", "SIMULATION", "CASUAL"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en", "en_US"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "355537586127645"}}]}, "scheduled_offers": {"count": 45, "nodes": [{"status": "PUBLISHED", "id": "2076525673281338"}, {"status": "PUBLISHED", "id": "2681773678858194"}, {"status": "PUBLISHED", "id": "2186243548532712"}, {"status": "PUBLISHED", "id": "1210465804219812"}, {"status": "PUBLISHED", "id": "1286883435716610"}, {"status": "PUBLISHED", "id": "2586343198218725"}, {"status":
uluscdn.com&_nc_ss=7f20f&oh=00_AQJyL6qbRGR_F1rBApCGwWlVJHJAEqdDTwYhoY3UMk2Lig&oe=6ABD2CD3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Alarm", "keywords": ["alarm", "alert", "timer", "stopwatches"], "long_description": "With this intuitive alarm clock application designed specifically for Meta Quest headsets. Set multiple alarms with ease using natural VR controls including hand gestures.\n\nExperience effortless time management with both one-time and recurring alarm options. The app features a clean, accessible interface that's easy to navigate while wearing your headset. Create, edit, and delete alarms with simple gestures, and enjoy clear visual and audio notifications that ensure you never miss an important moment, whether you're gaming, working, or relaxing in VR.", "short_description": "This alarm has: Timer, Stopwatch and a conversion alarm."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1dFQWVSfWvT1bv5uJM0Ms7a93UPWSfdez3mvr8LEPop4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/alarm-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24655152727420788"}, "review_messages": []}]}, "cover_square_image": {"uri": "ht
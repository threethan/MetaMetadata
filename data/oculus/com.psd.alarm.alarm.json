s with simple gestures, and enjoy clear visual and audio notifications that ensure you never miss an important moment, whether you're gaming, working, or relaxing in VR.", "short_description": "This alarm has: Timer, Stopwatch and a conversion alarm."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/1dFQWVSfWvT1bv5uJM0Ms7a93UPWSfdez3mvr8LEPop4/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "Pop Software Developer", "support_website_url": null, "website_url": "https://sites.google.com/view/alarm-vr/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH", "HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24655152727420788"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491831056_1745867019342686_1501165532938032609_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOYktqlqD_sQ7kNvwG_qAZI&_nc_oc=AdnnVp2aAvBnSrub5eExthorZLUZ9Qqy5VwtOqNAgL3dWvTqliunRcuFPiTrmkzr648&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftdVgTFQbG_5YEvaf5rDvPuIqkTrtkSLMLSC7BUH0oarQ&oe=6999B8DB"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Alarm", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Utilities", "id": "3932224785
63Fi_6KB_ONT3IMtEKz0CQq9Yita_v3nwmBUXv6X2yPA&oe=6A159E04"}, {"file_name": "HighresScreenshot00001.png", "id": "27075490678749478", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618515_27075490692082810_46830551376919340_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=daZ_mOthPgYQ7kNvwEmOCMd&_nc_oc=Ado7dp_yy0vw0TpE85MVKRTssgfYb2m97wbTacTiI7bGM7co67VQwqr_Uuj9hZsknXU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7XKW2vPQu182WBw-fSjP5x5T7D4qSxMQIOTtHZksk50Q&oe=6A159B87"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Package Unit Installation", "keywords": [], "long_description": "HVAC Package Unit Installation is an immersive VR training application designed to simulate real-world installation procedures for HVAC package units. Learners engage in step-by-step, hands-on scenarios covering equipment positioning, connections, safety protocols, and system checks in a risk-free virtual environment.\nThis application is an integral component of the ImmerseLearn HVAC Package Unit Installation micro-credential program. It is not a standalone product access is exclusively granted to individuals enrolled in the program, ensuring a guided and structured learning experience.\nThrough interactive VR modules, users develop practical skills, improve accuracy, and build confidence before performing tasks in real-world settings. Ideal for aspiring technicians and professionals seeking experiential HVAC training.", "short_description": "Experience hands-on HVAC training in VR with the HVAC Package Unit Installation app. This simulation is part of the ImmerseLearn micro-credential program and provides guided, real-world installation practice. Access is exclusively available to learners enrolled in the program for structured, immersive skill development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Im
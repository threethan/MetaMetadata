nt-sjc6-1.oculuscdn.com/v/t64.5771-25/499618297_1528223815574133_8909938432395722291_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qMnchNP1cC0Q7kNvwGrOctf&_nc_oc=AdomDDQBxgiD5TPBt2xuv0LCCzC0ZKnS0RPfBWxIbS596o8IpvNRkBhOCn3gvRmkO9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1pszb1WcXdfkeqjzuejrr3n2uukFg2lJQRfVqmT5kCA&oe=6A2AD2E4"}, {"file_name": "HighresScreenshot00000.png", "id": "2362600940873096", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499625099_2362600944206429_2126767269532005430_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8Z9l88AVtsQ7kNvwEjuvnC&_nc_oc=Adq2TnvSJ_8KDKiDn3cJHgik6UmvngzZVXqAf5r-12SZbwENO5uGKO0Xgx7C1Dm4wz0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af99ljr41kYpcDvP8FLU6XUbvl985rZmqKj1bhfD7vC6KQ&oe=6A2AB604"}, {"file_name": "HighresScreenshot00001.png", "id": "27075490678749478", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499618515_27075490692082810_46830551376919340_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPSLdv_TLiUQ7kNvwGrJvoQ&_nc_oc=AdqCq2hPU1EhO8M06tnjaSD00S9RfKTsvLR25bS3kDPcfyl845l64dtnsls3--_o7Zc&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8p4xLPfLFbFkwRcvYVv_4seqM4h8b4fnIzYl1JehJMqA&oe=6A2AB387"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Package Unit Installation", "keywords": [], "long_description": "HVAC Package Unit Installation is an immersive VR training application designed to simulate real-world installation procedures for HVAC package units. Learners engage in step-by-step, hands-on scenarios covering equipment positioning, connections, safety protocols, and system checks in a risk-free virtual environment.\nThis application is an integral component of the ImmerseLearn HVAC Package Unit Installation micro-credential program. It is not a standalone product access is exclusively granted to individuals enrolled in the program, ensuring a guided and structured learning experienc
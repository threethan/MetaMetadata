cdn.com/v/t64.5771-25/499625099_2362600944206429_2126767269532005430_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M9OLcCDTt8EQ7kNvwHVO1oL&_nc_oc=AdqqtLEtb-y6utkcXYoJM1kTmS_YrdZpbNEGOFsuigPH_ezv1k9Y0BTTslP0mLYY7yM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ovhk2NU_w9_aJrHmvr5nbZOOzKl4yg1dT0Xu1rlpDoA&oe=6A086F04"}, {"file_name": "HighresScreenshot00001.png", "id": "27075490678749478", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499618515_27075490692082810_46830551376919340_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UrZcZefZmIkQ7kNvwFClNnk&_nc_oc=Adqzv828xeYuvUXrPxpvzL8uqRqU26Rnv0WfzzkpJ9v_7TIiNOoNQf_YMLO4TFm-cWY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6-wyDZE4bu1HTnjxTMSBL7ZTDwZPaUAgUogSM5qkgkmQ&oe=6A086C87"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "HVAC Package Unit Installation", "keywords": [], "long_description": "HVAC Package Unit Installation is an immersive VR training application designed to simulate real-world installation procedures for HVAC package units. Learners engage in step-by-step, hands-on scenarios covering equipment positioning, connections, safety protocols, and system checks in a risk-free virtual environment.\nThis application is an integral component of the ImmerseLearn HVAC Package Unit Installation micro-credential program. It is not a standalone product access is exclusively granted to individuals enrolled in the program, ensuring a guided and structured learning experience.\nThrough interactive VR modules, users develop practical skills, improve accuracy, and build confidence before performing tasks in real-world settings. Ideal for aspiring technicians and professionals seeking experiential HVAC training.", "short_description": "Experience hands-on HVAC training in VR with the HVAC Package Unit Installation app. This simulation is part of the ImmerseLearn micro-credential program and provides guided, real-world installation practice. Access is exclusively available to learners enrolled in the program for structured, immersive skill development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35225416817103104"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1032303705788882"}]}, "baseline_offer": {"id": "1032303705788882"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1778142180, "status": "PUBLISHED", "id": "1032303705788882"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "35345247651786686", "version": "1.2"}, "id": "1223052546377148", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "35225416767103109", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "35345247651786686"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1223052546377148"}]}, "change_log"
periential HVAC training.", "short_description": "Experience hands-on HVAC training in VR with the HVAC Package Unit Installation app. This simulation is part of the ImmerseLearn micro-credential program and provides guided, real-world installation practice. Access is exclusively available to learners enrolled in the program for structured, immersive skill development."}]}, "developer_name": null, "developer_privacy_policy_url": "https://immerselearn.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "ImmerseLearn", "support_website_url": null, "website_url": "https://immerselearn.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "35225416817103104"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499617847_3917781301695789_5302596896801220133_n.png?stp=dst-png_s360x360&_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ct9I5ySW8iYQ7kNvwGO7r_A&_nc_oc=AdqWYdi9s2NVhpqTpg0wMGDEPxTZEA9-koBNr5wbBI9pe5nkkTFMdnbvIsf2BKAz4nA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR__4W0uZpxLHFOVvECVEG4pu6fng914FjA9JHElAMrnw&oe=6B08565D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "HVAC Package Unit Installation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211
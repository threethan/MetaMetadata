66318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gDEXkmLib0gQ7kNvwFyy0Hx&_nc_oc=Adon3ujkXbX8ZppX97L9lvvxZIGCTh4uhgD_hAlUQXrt_J6etl_4gGqQuMmyfzm1sqE&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8oCZTXRzD3vOFUuYqPwh9Wzuiag4ptfRyAMgG29A_p8Q&oe=6A39488F"}, {"file_name": "6.png", "id": "940819263893066", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031628_940819267226399_2397100471894061859_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3YF0aXJZ6AQ7kNvwEfqPR9&_nc_oc=AdpPYUYNKPMrUPixTxSddAQ513iZS-LdWfkTWFR2K8Df0SvvZRAYbd7uxD65Ln9Y3_0&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_ViM0RDmYKE48RNlUZq4xwnyV1j8aOem2smgObhwfxKw&oe=6A39386A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DISUKU (2).png", "id": "1427444654739536", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982709_1427444658072869_3041765525580465306_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YWBiKXo8kEwQ7kNvwFea_aC&_nc_oc=AdqApnCgG_Qvofh64D5gkZf_I3zYLD2x5n4utUjhv1OeQMSzIW6Qvdn0cBEnsgo1ei0&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0JJBYg2wG2bpilz4ocHmmV8cWoyKMwghUnBbiL-6RbQ&oe=6A395449"}, "display_name": "Disuku", "keywords": [], "long_description": "Join us for a sneak peek at our early-stage VR game, Zero-G Disc Tag, code-named Disuku! \n\nWith two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your opponents in this exciting, fast-paced game. Aim to tag your opponents with your discs while avoiding their own attacks, and master rapid teleportation to come out on top. \n\nJoin our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN \n\nGet ready to challenge your reflexes and strategy skills in Zero-G Disc Tag!", "short_description": "Introducing Disuku: A New VR Game for Fast-Paced Strategic Fun! With two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your o
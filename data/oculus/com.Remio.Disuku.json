66318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=84ciX67oRwAQ7kNvwEORbwP&_nc_oc=Ado1r9ooZAhnbDO0AGQU-XkInuZDOR923WQfup3cazyY6WQqekZtp6Mfayh-oRvyP1s&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xg_FY3iRF9iHmMaT0-zi6XeV-G7FUtyiytvsqnne59w&oe=6A11BB8F"}, {"file_name": "6.png", "id": "940819263893066", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031628_940819267226399_2397100471894061859_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4wvoSbSnU88Q7kNvwFDX-e2&_nc_oc=AdriNJLkIbmo2Tb8NByJMPAwjmhNGRZPtqPBakualJLmrMHl8euG_dS61meb4Fl644o&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54RYng2wd66NoXPtibgkrk5eRWPNxfmll9qiyYBUThBg&oe=6A11AB6A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DISUKU (2).png", "id": "1427444654739536", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982709_1427444658072869_3041765525580465306_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsSF-QURRS8Q7kNvwF47wpW&_nc_oc=AdoC7lRHKNuBAx8209Bjss1advNI83HZdAVvGdE0UVxh3qISUINGwXmZdGYzhe1VY6I&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5aKc646VditNdvC1keUr5uCPg9zCBMgJeqd5_TTFcHKw&oe=6A11C749"}, "display_name": "Disuku", "keywords": [], "long_description": "Join us for a sneak peek at our early-stage VR game, Zero-G Disc Tag, code-named Disuku! \n\nWith two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your opponents in this exciting, fast-paced game. Aim to tag your opponents with your discs while avoiding their own attacks, and master rapid teleportation to come out on top. \n\nJoin our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN \n\nGet ready to challenge your reflexes and strategy skills in Zero-G Disc Tag!", "short_description": "Introducing Disuku: A New VR Game for Fast-Paced Strategic Fun! With two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your o
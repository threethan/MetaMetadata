66318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fFA6ThnH4ssQ7kNvwGu-WX7&_nc_oc=AdoIU3TZO_r1GeWJ_ZAzv_R_iVFsbFt7g5MI9x6xyNkaQinGeldgw7OTujrXPyynfnc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-T9kT0Ci7XgCgtZDr0Yu1ITXfLX6UKJoxkKsLFSTzUaQ&oe=6A36A58F"}, {"file_name": "6.png", "id": "940819263893066", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031628_940819267226399_2397100471894061859_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C3YF0aXJZ6AQ7kNvwGBqgoV&_nc_oc=AdqGslB2gHy9bkHjj5WLfhW587l0P0xAmtSgThhK7Hrgcz49Ze5dmKM_uhp_V7Jdkgo&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2f79-5v4rn6zaRmwZTJOIe86Dtn0uZPqLwsV3an1rcQ&oe=6A36956A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DISUKU (2).png", "id": "1427444654739536", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982709_1427444658072869_3041765525580465306_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cdrIXhOXjXUQ7kNvwEG_mbu&_nc_oc=AdpKbUPtwaIH1sKOGEXe-V2M-_CHIG9GYnVnMMws_nLct4JHam5p_YlC48K5odEAN-U&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9SgCpBNSTCw0t-qAX3x4_RZP-6ABVIXIJDD-Bjua3YiQ&oe=6A36B149"}, "display_name": "Disuku", "keywords": [], "long_description": "Join us for a sneak peek at our early-stage VR game, Zero-G Disc Tag, code-named Disuku! \n\nWith two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your opponents in this exciting, fast-paced game. Aim to tag your opponents with your discs while avoiding their own attacks, and master rapid teleportation to come out on top. \n\nJoin our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN \n\nGet ready to challenge your reflexes and strategy skills in Zero-G Disc Tag!", "short_description": "Introducing Disuku: A New VR Game for Fast-Paced Strategic Fun! With two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your o
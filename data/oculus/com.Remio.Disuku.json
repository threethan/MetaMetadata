66318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GLgL2YFsDpQQ7kNvwE2SebT&_nc_oc=AdrUKd3eocc3IOVx9W-Bh9JVM2tni2z8rYK2oiSmzXmgPGTW8krdTtIb_ViP_y2cwXc&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHbOnSUK1ovYgNhlDth0JRGDFOI1fx3ES5TgU1pPZ9AHw&oe=6A7D9E4F"}, {"file_name": "6.png", "id": "940819263893066", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031628_940819267226399_2397100471894061859_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUrfu5n4DFAQ7kNvwGrDsmj&_nc_oc=AdpioXbBNVlb6jPoVh1t8Aids9o5Dr2_Ej3QE8O2DBp8r2Q96oC7SEHVWr8Xpluw_9M&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEvF4YNmjCzt54qks88sQ756ssK7jcF97qQUVAV0bUMMA&oe=6A7DC66A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DISUKU (2).png", "id": "1427444654739536", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982709_1427444658072869_3041765525580465306_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCu9_C-azA4Q7kNvwExcsoY&_nc_oc=AdqaUucxYTtqkyqE6B5nuqsE1Fx2Ew5QfBFXMiRsggnL_0CxgKa9J9KiJx0ASAfARH4&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5qd8yM9GxctCbKUFG-r5gg6IZfuq0u_-TH2zgsLxLlw&oe=6A7DAA09"}, "display_name": "Disuku", "keywords": [], "long_description": "Join us for a sneak peek at our early-stage VR game, Zero-G Disc Tag, code-named Disuku! \n\nWith two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your opponents in this exciting, fast-paced game. Aim to tag your opponents with your discs while avoiding their own attacks, and master rapid teleportation to come out on top. \n\nJoin our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN \n\nGet ready to challenge your reflexes and strategy skills in Zero-G Disc Tag!", "short_description": "Introducing Disuku: A New VR Game for Fast-Paced Strategic Fun! With two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your o
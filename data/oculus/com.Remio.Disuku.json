66318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Grxt4CW_Hn8Q7kNvwGuUJeZ&_nc_oc=AdqxhOWZBi0eiP8Ep6KbYg7loDaf45XRMgAiqi_L_AzYFK5tVuuZ-x_3j9YPB6rX8Sk&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-dP4ICc4SuGe706GQ_c24_EZyERXZ9fs5nAsb1HHi8zQ&oe=6A22DF0F"}, {"file_name": "6.png", "id": "940819263893066", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031628_940819267226399_2397100471894061859_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LCTMH6Hing4Q7kNvwGQaRLx&_nc_oc=Ado24c0_gE_vglGAzy9EITH7kV8lQ7fPgkD3pjCOi0HVoHprZLI6Mw0abzLELEHUQcg&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9qsRXJjW3Yu-8cajZ7Sw01aXgpEffUj19OZOl7fW3R5A&oe=6A22CEEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DISUKU (2).png", "id": "1427444654739536", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982709_1427444658072869_3041765525580465306_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HA9BxEVe3v4Q7kNvwGmFZgZ&_nc_oc=AdoH_4d9TqOoKCZHqCl6GzLmhyiytgP_wCeAVFUyOymEnebJoqeepntB_se3GByPoMk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_cZ-sArxqefdlV6Y6yZvsAoIe8AL21eJYDqLe0NwRJVw&oe=6A22EAC9"}, "display_name": "Disuku", "keywords": [], "long_description": "Join us for a sneak peek at our early-stage VR game, Zero-G Disc Tag, code-named Disuku! \n\nWith two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your opponents in this exciting, fast-paced game. Aim to tag your opponents with your discs while avoiding their own attacks, and master rapid teleportation to come out on top. \n\nJoin our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN \n\nGet ready to challenge your reflexes and strategy skills in Zero-G Disc Tag!", "short_description": "Introducing Disuku: A New VR Game for Fast-Paced Strategic Fun! With two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your o
66318_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HB3cklCkYZQQ7kNvwHqD3nS&_nc_oc=Ado5fnxnj9j3zKDF7bRn6aFSWZgPHUPZeRm3qOPR31GIcQXOa2bqcXChMCRlbrJUHQQ&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKoDbRuNIOJhJY6iqLqmvEBxSoAKC2yndO-IHs7T5JI4g&oe=6AAE9E0F"}, {"file_name": "6.png", "id": "940819263893066", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/39031628_940819267226399_2397100471894061859_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-fo1F-OpycQQ7kNvwGfdN4c&_nc_oc=Ado_otWNmWsXYAZ-ppTgsQr7HkgYH4CQyjz-RmILCSWj2RZRUDiiKJV3UEEDkrxwTs4&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLycdQgaaVOXk8DloEbkwJUFaxmlddv5B_0bcRMU7W2eQ&oe=6AAE8DEA"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "DISUKU (2).png", "id": "1427444654739536", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38982709_1427444658072869_3041765525580465306_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ywmWmJWrodYQ7kNvwFd6GZa&_nc_oc=AdqRzKjko4ND0PMdY6C47p28N_v28_V8s9wKzhuToDymxTUCZUWcvt2ZIS24hbkiAtk&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIW0sIZXVbU_uU8MXFg_KnhhYs8a5JM4er3P_8FPfwqJg&oe=6AAEA9C9"}, "display_name": "Disuku", "keywords": [], "long_description": "Join us for a sneak peek at our early-stage VR game, Zero-G Disc Tag, code-named Disuku! \n\nWith two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your opponents in this exciting, fast-paced game. Aim to tag your opponents with your discs while avoiding their own attacks, and master rapid teleportation to come out on top. \n\nJoin our Discord to see where we take it next -- https://discord.com/invite/YrZwpCANQN \n\nGet ready to challenge your reflexes and strategy skills in Zero-G Disc Tag!", "short_description": "Introducing Disuku: A New VR Game for Fast-Paced Strategic Fun! With two teleportation discs in each hand, you'll need to think fast and move even faster to outwit your o
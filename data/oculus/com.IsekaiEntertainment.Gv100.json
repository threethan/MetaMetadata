g", "id": "1105783704944495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298137_1105783708277828_6201468748701041299_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6v28kPayCrAQ7kNvwFOVvXG&_nc_oc=AdqFC1RsxcUhe_dMwyuqF79SWxAP1c1fmBZAt1UyqD4GaoyF_et8tHFxFPWL0rxHecw&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79lIbi-4U2g9Or2IP7RoQDeTgw14noqg9rn50-aIsmFg&oe=6A159D43"}, {"file_name": "GorillaShot1.png", "id": "1162518965919174", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620362_1162518969252507_4202316974183157203_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mi3COwEmc-8Q7kNvwHbtE5h&_nc_oc=Adrk2vrGidFDRw18U7Jt4YwdPA0HCOkbagfCPoBwz4qpufFhuWYRyD3hlqc1C7IDPqE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6DwugUAnT6VZRH370E3W0oPUHfNrrC5w3EEUh4oiuu0g&oe=6A15C477"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla vs 100", "keywords": [], "long_description": "In Gorilla vs 100, you are one beast against a swarm. Hunted, cornered, and outnumbered \u2014 but never outpowered. Step into a VR showdown where your strength is your weapon, your hands are your lifeline, and there\u2019s only one rule: survive.\n\nThrow punches that send bodies flying. Climb, leap, and smash your way through a world built for mayhem. With nothing but your raw power and instincts, take on an overwhelming force of enemies \u2014 and make them regret ever coming after you.\n\nIt\u2019s brutal. It\u2019s ridiculous. It\u2019s the most fun you\u2019ve had going feral in VR.\n\nYou\u2019re not just fighting to win \u2014 you\u2019re fighting to prove that one gorilla is worth a hundred men.\n\nWe are in EARLY ACCESS, so we would love to have your feedback! Good, bad, suggestions? We want to know so we can make it better! Thanks for playing and we can't wait to hear what you think!", "short_description": "Unleash your inner beast in Gorilla vs 100, a chaotic VR brawler where you face off against 100 relentless enemies. Punch, swing, and slam your way through waves of foes using raw gorilla strength. Are you strong enough to survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://n00bird-gorillavs100.framer.website/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "n00bird", "support_website_url": null, "website_url": "https://n00bird-gorillavs100.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24346525301626155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303585_1917020795741314_7199761942863204584_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O29DHRr4S3QQ7kNvwHpLtX6&_nc_oc=AdqkII6vrd_mkopWF4QYyhv5scBxs34raWx-cGruX8sdyS9_tRX7Q856v3H8nnnvkP8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7vxUG_h-9CEExsz6ddtolX8lLFRr1jU3xkoWHJktnJxQ&oe=6A1591BE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla vs 100", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "2710427532541308"}, {"topic_name": "Action", "id": "459781504968480"}], "release_date": 1752773760, "lastRevision": {"nodes": [{"id":
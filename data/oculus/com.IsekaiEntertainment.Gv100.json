oculuscdn.com&_nc_ss=7f20f&oh=00_AQOii4YYc-B1C4GvbvHPYht24VsbBi2p2GkhjkFc74xiRg&oe=6AE1F687"}, {"file_name": "GorillaShot2.png", "id": "1105783704944495", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499298137_1105783708277828_6201468748701041299_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ex7lNjm6uO4Q7kNvwEyY8II&_nc_oc=AdoddD9IfosTWEBR5yWSU1XgeDaVeDt9DbgA4UxXH6163OdlzL8jzGLuwDQQBaPArf0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOILLQoVlOeiAC8HswyG8_kD8xFodoULEjlmRVb8X9pcQ&oe=6AE1F5C3"}, {"file_name": "GorillaShot1.png", "id": "1162518965919174", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499620362_1162518969252507_4202316974183157203_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Rgf1shwSj7QQ7kNvwFpc_JH&_nc_oc=AdphtdN1xHUFKMDClm1XDbSUtsGtwWScMMLGQL3VcAKHt_AGFd-WYyVhSBfT7UZOrlk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNoQ4nyEVAFDuzz3jI148D4tPK2ONj1C2tHjw-dtes87Q&oe=6AE21CF7"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla vs 100", "keywords": [], "long_description": "In Gorilla vs 100, you are one beast against a swarm. Hunted, cornered, and outnumbered \u2014 but never outpowered. Step into a VR showdown where your strength is your weapon, your hands are your lifeline, and there\u2019s only one rule: survive.\n\nThrow punches that send bodies flying. Climb, leap, and smash your way through a world built for mayhem. With nothing but your raw power and instincts, take on an overwhelming force of enemies \u2014 and make them regret ever coming after you.\n\nIt\u2019s brutal. It\u2019s ridiculous. It\u2019s the most fun you\u2019ve had going feral in VR.\n\nYou\u2019re not just fighting to win \u2014 you\u2019re fighting to prove that one gorilla is worth a hundred men.\n\nWe are in EARLY ACCESS, so we would love to have your feedback! Good, bad, suggestions? We want to know so we can make it better! Thanks for playing and we can't wait to hear what you think!", "short_description": "Unleash your inner beast in Gorilla vs 100, a chaotic VR brawler where you face off against 100 relentless enemies. Punch, swing, and slam your way through waves of foes using raw gorilla strength. Are you strong enough to survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://n00bird-gorillavs100.framer.website/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "n00bird", "support_website_url": null, "website_url": "https://n00bird-gorillavs100.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24346525301626155"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499303585_1917020795741314_7199761942863204584_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCReVKfK6i8Q7kNvwHG8RLz&_nc_oc=AdoBZ3fnyBCvoLPJsjXYTOcycm9MSHbsf7rCcSav0ZL77Z-saIODlzJOr5NnruOs_cc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOog0c_4zF4z0qFYr2wrGLsV_I0loXhdDUVUeQ32-eKxw&oe=6AE1EA3E"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Gorilla vs 100", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Fighting", "id": "27104275
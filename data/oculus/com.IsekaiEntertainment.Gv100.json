7_8687951137536948115_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4FFzqtegAIUQ7kNvwGAMAtw&_nc_oc=Adoxgsj-86OG2opsRE8Gc9zDZYeEfl4WNScflx37mYSf_rrwSnNWoXh0OybWrug5aOI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIywdg4IpUN5UwozTm057PFoKkAbSREx-uOpMjQ4k6CvQ&oe=6AB91807"}, {"file_name": "GorillaShot2.png", "id": "1105783704944495", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499298137_1105783708277828_6201468748701041299_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YtG7N3NqLmUQ7kNvwHyQF49&_nc_oc=Adqwbw3hNVZDB4KI5mdm4Xjl4y_4-EiXFwNXjRscyt-1HlYMS20-Le-Ca9itCCG9tew&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK9tSWw8yoTAPE3lWADg-2YNBO3IrTXwLosvOi0p5KN0Q&oe=6AB91743"}, {"file_name": "GorillaShot1.png", "id": "1162518965919174", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499620362_1162518969252507_4202316974183157203_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DbsOGsd9JJsQ7kNvwErtUPs&_nc_oc=Adoi7Q1VfXzDJOX0P63MjbIw6-_xH4_ytxD3lhByC5C0wR72RevGQ85iqYgneuBAJp4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_Fw952lNK9vyMy629sqzekkaXYcSlKX9NQZULvT0iPg&oe=6AB93E77"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Gorilla vs 100", "keywords": [], "long_description": "In Gorilla vs 100, you are one beast against a swarm. Hunted, cornered, and outnumbered \u2014 but never outpowered. Step into a VR showdown where your strength is your weapon, your hands are your lifeline, and there\u2019s only one rule: survive.\n\nThrow punches that send bodies flying. Climb, leap, and smash your way through a world built for mayhem. With nothing but your raw power and instincts, take on an overwhelming force of enemies \u2014 and make them regret ever coming after you.\n\nIt\u2019s brutal. It\u2019s ridiculous. It\u2019s the most fun you\u2019ve had going feral in VR.\n\nYou\u2019re not just fighting to win \u2014 you\u2019re fighting to prove that one gorilla is worth a hundred men.", "short_description": "Unleash your inner beast in Gorilla vs 100, a chaotic VR brawler where you face off against 100 relentless enemies. Punch, swing, and slam your way through waves of foes using raw gorilla strength. Are you strong enough to survive?"}]}, "developer_name": null, "developer_privacy_policy_url": "https://n00bird-gorillavs100.framer.website/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "n00bird", "support_website_url": null, "website_url": "https://n00bird-gorillavs100.framer.website/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24323995573879128"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1470479860611812"}]}, "baseline_offer": {"id": "1470479860611812"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1752773760, "status": "PUBLISHED", "id": "1470479860611812"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "24857802250498455", "version": "1.5"}, "id": "1748133736580535", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24190801483865205", "is_concept
nc_oc=AdrEnz2JYEppJ-1nc-H9lKC-chTjiljptBIl-TExF8HiFWXnxsG4b1RtZxziXrc_uho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNw2jVvHoMfrZEAZ5aKkeg_kPQs-ku9wH3pwpdrO0yvAw&oe=6ACA5AF7"}, {"file_name": "below game SS _ 2560_1440  4.png", "id": "950744794451180", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618251_950744797784513_5203931811197994671_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8eXxsouJTrYQ7kNvwHi9Wmp&_nc_oc=AdpcQ0rx22b815gE9E3E4RQJ2dJrJIIcjCZ8TGmqegh4EChSdje28-8BOlcEsou1zAE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCYbIOGS3kxbh6wsLLCu5m0hktGuMjZnmUqA-S7SvCxw&oe=6ACA66CB"}, {"file_name": "below game SS _ 2560_1440 3.png", "id": "2081470095747537", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499618515_2081470099080870_318214888495061486_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nTkEEUIUwpkQ7kNvwEJl4Ym&_nc_oc=Ado1lFvId_5R4yeplDFbGqZgh7TgnpvGRTcv0n1riSQODxPgyt3ZASyk_DVwytcY3_o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPGwPUQbUS3sGFU-SA2qEmv_v6Mbsskn_uh72VH_reLsw&oe=6ACA7370"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "2560_1440.png", "id": "4196520280677769", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_4196520284011102_979539703147670939_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H7yHlvhhskwQ7kNvwGt1Bkc&_nc_oc=AdqX-rQCBsRYyM8pXFvYXRDGpoHWcSsr3o89ArXTj-ao0g_qImoZbdWcsIdGg-reov4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCYcdK8IgLHZlVcNBxH-VjcJiKYz6Lv2POJkxQltXXLQ&oe=6ACA6232"}, "display_name": "Balloon Shooter", "keywords": ["BallloonShoot", "BalloonShooter", "Shooting", "Balloon"], "long_description": "Love playing with balloons?\n\nBalloon Shooter | Mixed Reality Fun \ud83c\udf88\ud83d\udd2b\nReady to pop some balloons around you?\n\nBalloon Shooter is a fast-paced Mixed Reality game where colorful balloons appear in your real environment. Aim, shoot, and pop them before they float away!\n\nWherever you are becomes the game arena. Balloons appear around you, and your job is simple: react fast, aim well, and pop as many as possible before they disappear.\n\nIt\u2019s easy to start, fun to play, and challenging to master.\n\nKey Features :- \n\n\ud83c\udf88 Mixed Reality Gameplay\nBalloons appear and float around your real-world space.\n\n\ud83d\udd2b Fun & Responsive Shooting\nAim and pop balloons before they vanish.\n\n\ud83c\udf0d Play Anywhere Around You\nYour environment becomes the playground.\n\n\ud83d\udcca Score Tracking\nBeat your high score and improve your aim.\n\n\ud83c\udfae Quick to Pick Up\nJump in and start popping balloons instantly.\n\n\u26a1 Arcade-Style Gameplay\nPerfect for quick and exciting play sessions.\n\n\ud83c\udf08 Colorful Balloons & Smooth Physics\nEnjoy satisfying pops and lively balloon movement.\n\nHow many balloons can you pop before they disappear?\n\nJump in and set your highest score!", "short_description": "Turn Your Space Into a Balloon Shooting Arena\nAim, shoot, and pop as many balloons as you can!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.moonapps.xyz/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Moon Technolabs", "support_website_url": null, "website_url": "https://www.moonapps.io/meta-games/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "us
395771_6037508002929531475_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J0rojTQCyvoQ7kNvwFlzxWn&_nc_oc=AdoqTmFTPgpvMEGQ5JJwVW-4qcCfu-zJ633QqW7B-adch0s6m_meYDIACgQnBScAxfc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1eElXULE98jq_QF_oJm8rN_6CyneuJhhhdrFZZ1Hw4zg&oe=69DF8374"}, {"file_name": "ScreenShot-5.png", "id": "1272173504757749", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491819859_1272173511424415_3602810752139002536_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T80d0XblcssQ7kNvwE3qVs4&_nc_oc=AdqYl11HfIzMlVfuwX_VpxXPniUzdb9Cbq-IaLgHThPDsfv3sf0WH2dAVJdnEC8FG5g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nDGjXA2vPah6ouyjB3Ndna-78bVKYKb5wD1686xoPgg&oe=69DFA31E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CovertArt-Landscape.png", "id": "26817019441240866", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825546_26817019454574198_4337695362179188436_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GoIABUC4IX8Q7kNvwESNWjg&_nc_oc=AdrGLzAIOeevo2y2UBqxyj3t7xlAC8Z-7Eg86epPeJwFqHcYOUDbki-dccMXANwx6RE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1oaLIPu0QzCIGtfJIk3en2G3Xa4qXvPwiWbKMeWzplow&oe=69DF8CD3"}, "display_name": "AVO: Echoes of the Void", "keywords": ["Space", "VRPuzzle", "ZeroGravity", "Adventure", "AI"], "long_description": "\ud83d\udea8 NO SIGNAL. NO CREW. NO WAY BACK\n\nA catastrophic event has torn your spacecraft apart, leaving you adrift in deep space. You awaken alone inside the wreckage, surrounded by failing systems and a growing sense that something is deeply wrong.\n\n{1606428530646340}\n\nTo survive, you must explore the ship, adapt, and uncover the truth hidden within it.\n\n\ud83e\udde9 Puzzles You Can Feel\n\nIntuitive, hands-on puzzle solving designed for VR. Interact naturally with objects, tools, and ship systems as new mechanics are introduced step by step.\n\n\ud83c\udf0c Explore in Low Gravity\n\nDrift through a calm, haunting sci-fi world. Float, push, and guide yourself through the broken remains of your spacecraft and the mysterious spaces beyond.\n\n{943021011446138}\n\n\u23f1\ufe0f A Journey That Evolves\n\nInterconnected areas reveal new tools, mechanics, and story pieces. Every discovery builds on what came before, deepening the mystery.\n\n\ud83e\udde0 More Than Just Puzzles\n\nAVO is a journey of adaptation, discovery, and atmosphere.\n\nDiscover how this world works\nFollow your curiosity\nUncover what really happened\n\n{1278095657631485}\n\n\u2728 Why You'll Enjoy AVO\n\n- Designed for natural VR interaction\n- 5 to 6 hours of gameplay\n- Easy to begin, satisfying to master\n- Atmospheric, cinematic, and deeply engaging\n\n\ud83c\udf20 Step into the unknown. Just begin exploring, and let the experience unfold.", "short_description": "AVO: Echoes of the Void is a direct narrative sequel to AVO Escape Space, continuing the story exactly where it ended.\n\nStranded after a catastrophic space disaster, you awaken inside a shattered spacecraft. Navigate zero gravity, solve immersive VR puzzles, and uncover the mystery hidden within the void.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.avovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NXT LYR", "support_website_url": null, "website_url": "https://www.avovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "377978390272490"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_play
_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=92oEjjYT6GgQ7kNvwGQaQT6&_nc_oc=Adr_H-87OadeyKSwiQu_0Bl6ePQZRcqOe1qLdPtTsqmuq3DWNZj1w0Av_kIXigghLmg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGUm1sFBOrJbqGbjP6GySGs9pC-6gmCr4DGR0xnue_DTQ&oe=6A772953"}, "display_name": "AVO: Echoes of the Void", "keywords": ["Space", "VRPuzzle", "ZeroGravity", "Adventure", "AI"], "long_description": "AVO: Echoes of the Void is a story-driven VR puzzle adventure built from the ground up for immersive, hands-on virtual reality.\n\nYour journey begins aboard a failing spacecraft. Moments later, a catastrophic event tears the ship apart, leaving you drifting in the void with no clear answers and no way home.\n\nAwakening inside the wreckage, you must adapt to zero-gravity movement, interact with damaged systems, and explore a mysterious network of interconnected environments. Each space you enter introduces new mechanics, tools, and challenges that build upon one another, encouraging experimentation and mastery rather than one-off solutions.\n\n\nAVO: Echoes of the Void is not just about solving puzzles. It is about surviving in an unfamiliar environment, learning its rules, and uncovering what lies beyond the void.\n", "short_description": "AVO: Echoes of the Void is a direct narrative sequel to AVO Escape Space, continuing the story exactly where it ended.\n\nStranded after a catastrophic space disaster, you awaken inside a shattered spacecraft. Navigate zero gravity, solve immersive VR puzzles, and uncover the mystery hidden within the void.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.avovr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "NXT LYR", "support_website_url": null, "website_url": "https://www.avovr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "269189016
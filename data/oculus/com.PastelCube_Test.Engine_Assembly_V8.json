501136300869573_3988454085229928562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3oE9RhyyZD8Q7kNvwEDGgsC&_nc_oc=AdlTX63iRk35yDkWZs_88DZ43zjJp6RDfH0SjuWVUND_P37IRUu_MiEZ-MtfNQ1h54Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv-SOLaEYIEPGj-mY1dwXmbGZkXHl8S47eOINvvy-beYg&oe=69A6E655"}, {"file_name": "V8_Engine_03.png", "id": "1078013840882615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499356638_1078013844215948_4431526408350712785_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qAmx1rZmHOYQ7kNvwE3H8iG&_nc_oc=AdllCePs_pRB4CXhehLlyZIidnrtx7AZAe-i-0b6RIpJN6ZKygDXUKAIkOuD8HPfCbQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvrhsVr_ZbinxtdZKboL9ws0cgyxT_byzbgOZVBmKX_ZQ&oe=69A6D70E"}, {"file_name": "V8_Engine_01.png", "id": "548187144806946", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499324048_548187148140279_302708763491369627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7JKR7UCSUHIQ7kNvwGt_KbC&_nc_oc=AdnxV21_H5zZEa9uLdAMZm4xj-SprBOjEaz58kUR_NzYa4xF_FXLK7ot1sMGfsjOAhE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfsuXh2U5wmD_hEUsVj905q9IvJbU5IZqraLD7U3vMRowA&oe=69A6D774"}, {"file_name": "V8_Engine_05.png", "id": "1416446512843773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324939_1416446516177106_7952489805788314366_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wIIRe5Rnl8gQ7kNvwFRsd2R&_nc_oc=AdmMI3gaKCk0DlKXY2MWaZ6M2glngkPNDM0hld24HF8v7yD9h6GoHDTpoIkuAwcFL5E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftGUWWUencbC_CkxgtEdLJP002Xlp1LPTI-uxw80qr3jw&oe=69A6BBBA"}, {"file_name": "V8_Engine_06.png", "id": "1188825093024789", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499333143_1188825096358122_7698089225442683365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ldb3PSkvoNoQ7kNvwG8PhWB&_nc_oc=Adnu7eTZEbyfC6JiovqAL-xr1rdnXlFLuw1x6Q-K7VHBzwC6nV29cNuhSwwi9l7QewQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfslH6tnKfM49uOWoP7ojO7qhGeTbAMcIN-2sH40P_gFDg&oe=69A6D3D1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "V8 Engine Simulation", "keywords": [], "long_description": "Unlock the mysteries of automotive engineering with our cutting-edge V8 Engine Training Simulator. Immerse yourself in a virtual world where learning meets hands-on experience, allowing enthusiasts, students, and professionals to grasp the intricacies of V8 engine assembly like never before.\n\nPowered by state-of-the-art technology, our simulator utilises a real V8 engine model, providing an authentic and comprehensive learning experience. Whether you're a novice eager to explore the mechanics or a seasoned automotive enthusiast aiming to enhance your knowledge, our simulator caters to all skill levels.\n\nKey Features:\n\n1. Real Engine Integration: Our simulator boasts a genuine V8 engine, enabling users to interact with real components and understand their functions.\n\n2. Interactive Learning Modules: Dive into an array of interactive modules that cover every aspect of V8 engine assembly, from identifying parts to mastering the intricacies of fuel injection systems.\n\n3. Real-Time Feedback: Receive instant feedback on your assembly progress, allowing for continuous improvement and a deeper understanding of the engine's inner workings.\n\n4. Step-by-Step Tutorials: Guided by detailed step-by-step tutorials, users can progress at their own pace, ensuring a thorough grasp of each assembly stage.\n\n\n\n\nUnleash your passion for engines and master the art of V8 assembly like never before!\n", "short_description": "Discover the art of V8 engine assembly with our state-of-the-art Training Simulator! Featuring a real V8 engine, interactive modules, and step-by-step tutorials, our simulator caters to all skill levels. Gain hands-on experience, receive real-time feedback, and master the intricacies of automotive engineering. Elevate your knowledge with our immersive and authentic V8 Engine Training Simulator today! \n"}]}, "d
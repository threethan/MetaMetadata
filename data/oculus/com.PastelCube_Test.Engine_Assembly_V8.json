, "id": "1501136297536240", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393544_1501136300869573_3988454085229928562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOQptb-elFEQ7kNvwF5NFbb&_nc_oc=AdpMuiCLy04woJ_okczVlVykREyLYF1k6QM4fPsaHzrSN2EiC33qbiK6NDe_4N9WBEQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGORRBDvDTqBdZ9W_OULYKvSw3GqAtY_kqlGZpig53yaw&oe=6A8D9CD5"}, {"file_name": "V8_Engine_03.png", "id": "1078013840882615", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499356638_1078013844215948_4431526408350712785_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Dz3wIg99bfsQ7kNvwHreF1Z&_nc_oc=AdokvzvIHHknPO-pT8DA_6Gej_yAiOYCr6lYT6rJEnom_hInGAJlngnZDOXavaICU80&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEPxPkSWmPj5OUbEvKgSVi94INfsRQgwaSeEEwOUytnPQ&oe=6A8D8D8E"}, {"file_name": "V8_Engine_01.png", "id": "548187144806946", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499324048_548187148140279_302708763491369627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sKjCjxzv1fsQ7kNvwE77Q7P&_nc_oc=AdowAiGncUzFOuPXVSqjcpCLnZkmaXWDcgryHt19hofYDfN3atSoOdiiWmWjQLeQkRQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFG5iU-z_YbG_v82REMyEpP-PoGdzf_KZwx2-5AqBM6eg&oe=6A8D8DF4"}, {"file_name": "V8_Engine_05.png", "id": "1416446512843773", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499324939_1416446516177106_7952489805788314366_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B90GKtec0_MQ7kNvwHBucJY&_nc_oc=Adr5Cs1uKdKWLyjviYklhX5dIg2pX8q7jknQ4DIGhL74m_tKQsBXX7m3S2XXmaJgkxM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGsIXyHX1x-MG7ciQ1GFS_W6PCw3BNruEOaRvQ58pz68g&oe=6A8D723A"}, {"file_name": "V8_Engine_06.png", "id": "1188825093024789", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499333143_1188825096358122_7698089225442683365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6XWVas0jLMQ7kNvwHcFJJl&_nc_oc=AdqZugPBytMjjlJ02KWnOpw4kdKOjF5Kj8Ze5FdMpEl9bnaEe7hJHnfyycaq6qmy86U&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGpbFp5y8wScmKmuRgCh0LZW1J_cSPHDSxnDhzNSjYykA&oe=6A8D8A51"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "V8 Engine Simulation", "keywords": [], "long_description": "Unlock the mysteries of automotive engineering with our cutting-edge V8 Engine Training Simulator. Immerse yourself in a virtual world where learning meets hands-on experience, allowing enthusiasts, students, and professionals to grasp the intricacies of V8 engine assembly like never before.\n\nPowered by state-of-the-art technology, our simulator utilises a real V8 engine model, providing an authentic and comprehensive learning experience. Whether you're a novice eager to explore the mechanics or a seasoned automotive enthusiast aiming to enhance your knowledge, our simulator caters to all skill levels.\n\nKey Features:\n\n1. Real Engine Integration: Our simulator boasts a genuine V8 engine, enabling users to interact with real components and understand their functions.\n\n2. Interactive Learning Modules: Dive into an array of interactive modules that cover every aspect of V8 engine assembly, from identifying parts to mastering the intricacies of fuel injection systems.\n\n3. Real-Time Feedback: Receive instant feedback on your assembly progress, allowing for continuous improvement and a deeper understanding of the engine's inner workings.\n\n4. Step-by-Step Tutorials: Guided by detailed step-by-step tutorials, users can progress at their own pace, ensuring a thorough grasp of each assembly stage.\n\n\n\n\nUnleash your passion for engines and master the art of V8 assembly like never before!\n", "short_description": "Discover the art of V8 engine assembly with our state-of-the-art Training Simulator! Featuring a real V8 engine, interactive modules, and step-by-step tutorials, our simulator caters to all skill levels. Gain hands-on experience, receive real-time feedback, and master the intricacies of automotive engineering. Elevate your knowledge with our immersive and authentic V8 Engine Training Simulator today! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pastelcube.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies private limited", "support_website_url": null, "website_url": "https://www.pastelcube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24437112279225159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499363722_3318808668283133_1921646549588273440_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxcVM6HXBVIQ7kNvwHjDWCS&_nc_oc=Adocfmuj-wTX2Kiv54TUV2f1wYY43xwqGWpalbJBxNmiVJ3ODI0cCeWE8AVlvDI4DLs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHCqGfhypwFsjpTVMovq1Q52MvZ-bvoujZHLAbPn387-A&oe=6A8D66D2"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "V8 Engine Simulation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1747990920, "la
, "id": "1501136297536240", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/473393544_1501136300869573_3988454085229928562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cI06Cjm98HQQ7kNvwGI7kNz&_nc_oc=AdpbjnWQPVulcNv7vh5dkb2XjCsIuV2J2oJuh9XZbyNLc2dnpK9ApS9v9pbIvyTofHg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEAELWo7xcmPsggAK5Fi25uK-O4ShUvYlpmyppzEbQecQ&oe=6A8EEE55"}, {"file_name": "V8_Engine_03.png", "id": "1078013840882615", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499356638_1078013844215948_4431526408350712785_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HcUwj1F68ngQ7kNvwFmYH1w&_nc_oc=AdofqaXCiSTf5K6vavWv6_U7VDTLQfUj5RfVHuWKs3TF6Ud1CAb81LdvfvSR6S2b-n4&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_SVMVEXtzY5WUufQ00gWhtM_s-ifMPNxDbXhRtulqfg&oe=6A8EDF0E"}, {"file_name": "V8_Engine_01.png", "id": "548187144806946", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499324048_548187148140279_302708763491369627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pI2wjkHLR1cQ7kNvwFb6PFY&_nc_oc=Adq-s_i4tVi5SUd-ldk1hzCn6Nluh2_BDNRFAg5Sb8F8DkDLNjfFJELBhSbolCoM4e4&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzGan7IuPA97UYsVmNo4PaYNnxeVLM1yNLSAs33Z7v0w&oe=6A8EDF74"}, {"file_name": "V8_Engine_05.png", "id": "1416446512843773", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499324939_1416446516177106_7952489805788314366_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B90GKtec0_MQ7kNvwEGjhIi&_nc_oc=AdoQlWggW-ysypyhf_yK7UEArF_gF8L7S8Jbtoh-yxB2XfRAn2cIAB7tCdeP8cik5is&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHpwC7zf3kMSTPsNCc6dL-xsH_fxJh9Y59o5FbKaMO9Rg&oe=6A8EC3BA"}, {"file_name": "V8_Engine_06.png", "id": "1188825093024789", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499333143_1188825096358122_7698089225442683365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g6XWVas0jLMQ7kNvwGVrOlX&_nc_oc=AdoE2XT7y3qZjd6x0_-F-0TFmkr3mq0AFPYEUIkKI134T9MyN9YcH8i6pga4oqmQRSU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE691-usnRthHnfRCtnlIrLvjfoQLh4VFdKMzMBLYrIJA&oe=6A8EDBD1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "V8 Engine Simulation", "keywords": [], "long_description": "Unlock the mysteries of automotive engineering with our cutting-edge V8 Engine Training Simulator. Immerse yourself in a virtual world where learning meets hands-on experience, allowing enthusiasts, students, and professionals to grasp the intricacies of V8 engine assembly like never before.\n\nPowered by state-of-the-art technology, our simulator utilises a real V8 engine model, providing an authentic and comprehensive learning experience. Whether you're a novice eager to explore the mechanics or a seasoned automotive enthusiast aiming to enhance your knowledge, our simulator caters to all skill levels.\n\nKey Features:\n\n1. Real Engine Integration: Our simulator boasts a genuine V8 engine, enabling users to interact with real components and understand their functions.\n\n2. Interactive Learning Modules: Dive into an array of interactive modules that cover every aspect of V8 engine assembly, from identifying parts to mastering the intricacies of fuel injection systems.\n\n3. Real-Time Feedback: Receive instant feedback on your assembly progress, allowing for continuous improvement and a deeper understanding of the engine's inner workings.\n\n4. Step-by-Step Tutorials: Guided by detailed step-by-step tutorials, users can progress at their own pace, ensuring a thorough grasp of each assembly stage.\n\n\n\n\nUnleash your passion for engines and master the art of V8 assembly like never before!\n", "short_description": "Discover the art of V8 engine assembly with our state-of-the-art Training Simulator! Featuring a real V8 engine, interactive modules, and step-by-step tutorials, our simulator caters to all skill levels. Gain hands-on experience, receive real-time feedback, and master the intricacies of automotive engineering. Elevate your knowledge with our immersive and authentic V8 Engine Training Simulator today! \n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.pastelcube.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Pastelcube Technologies private limited", "support_website_url": null, "website_url": "https://www.pastelcube.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24437112279225159"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499363722_3318808668283133_1921646549588273440_n.png?stp=dst-png_s360x360&_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hxcVM6HXBVIQ7kNvwG7I8oC&_nc_oc=Adqoz367mbE4GtPi9jvI6dyB2ema_FYoFw2GZxxyQ0qK5fEgMiXq5WWL7Fldy4iSJqg&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGACcOhVixcRRWsWvfo17QpoNxbez1q3Bd70vuXIX6ITA&oe=6A8EF092"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "V8 Engine Simulation", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1747990920, "la
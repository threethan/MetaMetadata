501136300869573_3988454085229928562_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t0Xj0wwfWWIQ7kNvwG1IWJJ&_nc_oc=AdmA4NQzO9VCtEK3GOWUfEFveSj75KGKt5Ntcg9__4cnT3NPB1Qx8ewb1-8t6Y8LOOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvIC6dnayglRP4-cjdDpI-oSb0ime8A-GlmnMcLneGkqA&oe=699DABD5"}, {"file_name": "V8_Engine_03.png", "id": "1078013840882615", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499356638_1078013844215948_4431526408350712785_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1cQOlkyWKlsQ7kNvwHen3-p&_nc_oc=Admn-rRcmzqo0tZyPcjnQsYUxFZ-LS91jb84foYIB5qTB9giXAxpZqWoxXoPFLbB17w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsvaOHzp9r-M5zY9D8B4srjUx001-Mb2pG0PAJrZTCqbg&oe=699D9C8E"}, {"file_name": "V8_Engine_01.png", "id": "548187144806946", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499324048_548187148140279_302708763491369627_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sXJppRCD51AQ7kNvwHI6w7h&_nc_oc=Adl6zLQETXhcknijRGVTnQSjPxMEikSY_J87RB1kXFvTG9KWHBFIYrmBAQb3Djxrf1Y&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvZYNmqMBg0V0Edb4eStXuBD-M4zR6XTE-g6hzW0qfPGg&oe=699D9CF4"}, {"file_name": "V8_Engine_05.png", "id": "1416446512843773", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499324939_1416446516177106_7952489805788314366_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhY-6AUAZ0oQ7kNvwH-zHoi&_nc_oc=AdmXP9gNTXQ2hh9f4ek45aNOdaLA_OQp-7-eyyXC6j1HpMkXv7vwl2AQ55yWaR80ET4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv66m52GvVi3324zRzKr_GGi5fZtix719SF9V1QPX666w&oe=699D813A"}, {"file_name": "V8_Engine_06.png", "id": "1188825093024789", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/499333143_1188825096358122_7698089225442683365_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L2UGheQxitkQ7kNvwH8WacZ&_nc_oc=AdmL97cCLtzhcJo3VI5IFjyQnPdrCW_rYvvoucgdapPDP2-nMsqVQq4871xCFHaZSzU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvzTAGznqIjXgDRhPN4Hj6NK-ZKJDNpeceuFJx63ixbqQ&oe=699D9951"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "V8 Engine Simulation", "keywords": [], "long_description": "Unlock the mysteries of automotive engineering with our cutting-edge V8 Engine Training Simulator. Immerse yourself in a virtual world where learning meets hands-on experience, allowing enthusiasts, students, and professionals to grasp the intricacies of V8 engine assembly like never before.\n\nPowered by state-of-the-art technology, our simulator utilises a real V8 engine model, providing an authentic and comprehensive learning experience. Whether you're a novice eager to explore the mechanics or a seasoned automotive enthusiast aiming to enhance your knowledge, our simulator caters to all skill levels.\n\nKey Features:\n\n1. Real Engine Integration: Our simulator boasts a genuine V8 engine, enabling users to interact with real components and understand their functions.\n\n2. Interactive Learning Modules: Dive into an array of interactive modules that cover every aspect of V8 engine assembly, from identifying parts to mastering the intricacies of fuel injection systems.\n\n3. Real-Time Feedback: Receive instant feedback on your assembly progress, allowing for continuous improvement and a deeper understanding of the engine's inner workings.\n\n4. Step-by-Step Tutorials: Guided by detailed step-by-step tutorials, users can progress at their own pace, ensuring a thorough grasp of each assembly stage.\n\n\n\n\nUnleash your passion for engines and master the art of V8 assembly like never before!\n", "short_description": "Discover the art of V8 engine assembly with our state-of-the-art Training Simulator! Featuring a real V8 engine, interactive modules, and step-by-step tutorials, our simulator caters to all skill levels. Gain hands-on experience, receive real-time feedback, and master the intricacies of automotive engineering. Elevate your knowledge with our immersive and authentic V8 Engine Training Simulator today! \n"}]}, "d
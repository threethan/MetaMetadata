5BLBT85w&oe=69E626F1"}, {"file_name": "MacPaint.png", "id": "416000154326499", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031498_416000157659832_2324387629214690962_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FL93eU-HNb0Q7kNvwGvTEb0&_nc_oc=Adp4BTv1An7wzRh74U_TQCL7E63poL_OCOu7Z0a0srM2A2215T80XB1b36t4Lg9wN7I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GeCtoEUIBabl0ZbfqAqDqK1SwF6DJVEENuU-ohJKZUg&oe=69E6127F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Video-Cover.png", "id": "739682444559509", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974528_739682454559508_5028058827951312842_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xXmQ6tsB6IQ7kNvwEi6xbW&_nc_oc=AdrQm_Lr59wh8kLy8sRuvEZp9-kkDxgM4uijvTM5-mx1DGchzRBEsVkVLazKKwFgbIo&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1hnMUEUJ3mc0Gf4UaONQ8QVuMJt1XyTyhxjtAmgvHuRA&oe=69E615BA"}, "display_name": "Muze XR", "keywords": [], "long_description": "Ready to immerse yourself in sophisticated spaces and discover beautiful things with people from around the world? Welcome to Muze XR. Experience tech, gaming, and art like never before with stunning graphics.\n\nOur specifically designed spaces and interactions cater to exhibitions, galleries, and technological encounters. Interact with 80s computing tech, explore vintage arcade games, see world art, and join special events while staying connected with fellow visitors and enthusiasts. Create your own avatar and catch some YouTube videos or presentations in private rooms.\n\nMuze XR is currently in the early access stage, with more features to be added soon. In the future, users will be able to create their own spaces. If you have any questions or suggestions, feel free to let us know.", "short_description": "Ready to immerse yourself in sophisticated spaces and discover beautiful things with people from around the world? Welcome to Muze XR. Experience tech, gaming, and art like never before with stunning graphics. Our specifically designed spaces and interactions cater to exhibitions, galleries, and technological encounters. Interact with 80s computing tech, explore vintage arcade games, see world art, and join special events while staying connected with fellow visitors and enthusiasts."}]}, "developer_name": null, "developer_privacy_policy_url": "https://muzexr.com/privacy-policy-muze.html", "developer_terms_of_service_url": null, "publisher_name": "Ideographer", "support_website_url": "https://muzexr.com/support.html", "website_url": "https://muzexr.com/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "726368587961803"}, {"id": "2687655338230691"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "5556914971099461"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PUBLISHED", "id": "1551382532786962"}, {"status": "PUBLISHED", "id": "465732769144710"}]}, "baseline_offer": {"id": "1551382532786962"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1769516100, "status": "PUBLISHED", "id": "1551382532786962"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "10055150027942577", "version": "0.64b2"}, "id": "1535869650502094", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application":
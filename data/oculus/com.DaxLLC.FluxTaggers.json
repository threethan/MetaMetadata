cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAVUpUikshYQ7kNvwEZMeJp&_nc_oc=Adq58u0UFarvLijM5GRXukeWki7H8pibZ_vIRay_CVs8311U3E7Fa9-tg187by8OHAM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96OdRHaElTAyzM7iJiHCPWrMcgblXc5TMnP7yXo9VIlA&oe=6A3407FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project flux", "keywords": ["action", "taggers", "tag", "fun", "project"], "long_description": "Introducing the ultimate thrill-seekers delight: the Project Flux Game! \ud83c\udf89 This exhilarating game is designed for those who love to unleash their inner monkey and engage in a wild chase with friends. Picture this: vibrant colors, playful designs, and a lightweight, portable setup that makes it perfect for any outdoor adventure! Whether you're at the park, beach, or backyard, this game is your ticket to endless fun. The rules are simple yet electrifying\u2014tag your friends and avoid being tagged, all while showcasing your agility and speed. Get ready to swing into action! But wait, there's more! The Project flux Game isn't just about tagging; it's about creating unforgettable memories with your loved ones. With its easy-to-understand gameplay, everyone can join in on the fun, making it a fantastic choice for family gatherings, birthday parties, or friendly competitions. So, gather your crew, unleash your playful spirit, and let the monkey business begin! This game promises laughter, excitement, and a whole lot of fun\u2014don't miss out on the adventure!", "short_description": "Introducing the ultimate thrill-seekers delight: the Project flux Game! \ud83c\udf89 This exhilarating game is designed for those who love to unleash their inner monkey and engage in a wild chase with friends. Picture this: vibrant colors, playful designs, and a lightweight, portable setup that makes it perfect for any outdoor adventure! Whether you're at the park, beach, or backyard, this game is your ticket to endless fun. The rules are simple yet electrifying\u2014tag your friends and avoid being tagged!"}]}, "developer_name": "Monkey games inc.", "developer_privacy_policy_url": "https://sites.google.com/view/projectfluxtag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wilson wyatt", "support_website_url": null, "website_url": "https://sites.google.com/view/projectfluxtag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "23921032430860614"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "941573948521624"}]}, "baseline_offer": {"id": "941573948521624"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1775001480, "status": "PUBLISHED", "id": "941573948521624"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "26491052473858584", "version": "1.1.43"}, "id": "1403624420961402", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "23921032417527282", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26491052473858584"}, "release_status": "RELEASED"}, "binary_releas
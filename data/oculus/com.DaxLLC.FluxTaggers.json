66018_2712731368017626880_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=veyircxbn-wQ7kNvwGLa2sW&_nc_oc=AdotnrcX9wBHuocXt31Jc7eewH0CgzYqMGBtZNWVezMtnLqLffm3hTioOVoME7bzi5k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9niqr4QRTSBGsyMEabY0cClqJ0nUyj1OvpyzLZZREURQ&oe=6A34107E"}, {"file_name": "Screenshot 2026-01-14 172034_2560x1440.png", "id": "2024947881782147", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499300897_2024947885115480_5533541716285275211_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x6wmkHWS6SAQ7kNvwHia-XR&_nc_oc=AdobmaGCmUvMvNwbkqLnSMbmTlPt_xCcldQB0tOPxi5U1bpPEwxKiA7-d2jbK_cIVu8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8blyISedBGp22W1Pj1NVKn7bn8Ui2sS4edXMxMvbtpWA&oe=6A3400ED"}, {"file_name": "Screenshot 2026-01-14 172042_2560x1440.png", "id": "4330314333922529", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499307311_4330314337255862_3040035333773308336_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tAVUpUikshYQ7kNvwEZMeJp&_nc_oc=Adq58u0UFarvLijM5GRXukeWki7H8pibZ_vIRay_CVs8311U3E7Fa9-tg187by8OHAM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96OdRHaElTAyzM7iJiHCPWrMcgblXc5TMnP7yXo9VIlA&oe=6A3407FC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Project flux", "keywords": ["action", "taggers", "tag", "fun", "project"], "long_description": "Introducing the ultimate thrill-seekers delight: the Project Flux Game! \ud83c\udf89 This exhilarating game is designed for those who love to unleash their inner monkey and engage in a wild chase with friends. Picture this: vibrant colors, playful designs, and a lightweight, portable setup that makes it perfect for any outdoor adventure! Whether you're at the park, beach, or backyard, this game is your ticket to endless fun. The rules are simple yet electrifying\u2014tag your friends and avoid being tagged, all while showcasing your agility and speed. Get ready to swing into action! But wait, there's more! The Project flux Game isn't just about tagging; it's about creating unforgettable memories with your loved ones. With its easy-to-understand gameplay, everyone can join in on the fun, making it a fantastic choice for family gatherings, birthday parties, or friendly competitions. So, gather your crew, unleash your playful spirit, and let the monkey business begin! This game promises laughter, excitement, and a whole lot of fun\u2014don't miss out on the adventure!", "short_description": "Introducing the ultimate thrill-seekers delight: the Project flux Game! \ud83c\udf89 This exhilarating game is designed for those who love to unleash their inner monkey and engage in a wild chase with friends. Picture this: vibrant colors, playful designs, and a lightweight, portable setup that makes it perfect for any outdoor adventure! Whether you're at the park, beach, or backyard, this game is your ticket to endless fun. The rules are simple yet electrifying\u2014tag your friends and avoid being tagged!"}]}, "developer_name": "Monkey games inc.", "developer_privacy_policy_url": "https://sites.google.com/view/projectfluxtag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Wilson wyatt", "support_website_url": null, "website_url": "https://sites.google.com/view/projectfluxtag/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], 
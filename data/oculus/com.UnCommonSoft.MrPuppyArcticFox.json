r world, reminding you that love can be both quiet and pure.", "short_description": "Feed, play, and pet your elegant White Fox\u2014calm, pure, and full of gentle magic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/10adb063-6612-41f3-be14-a5be096bd6d7", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/MyPuppyArcticFox/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD", "HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "24607182102256253"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499300738_1252882783190833_8491743936030726366_n.png?stp=dst-png_s360x360&_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EMC4_1fn5d8Q7kNvwGE-YGN&_nc_oc=Adqb6enUekVZpAvSRD55l4jM0P9ThCWhHmbjcx7tGt-g9-yvIFRMzMJvFxKIewq5g8k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSsFNH7SjlB-WrzkxXwC3-szEtbMjmd1fksuFmiWNIx7g&oe=6B09C0F8"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Mypuppy:ArcticFox", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Simulation", "id": "331529188132278"}], "release_date": 1760159160, "lastRevision": {"nodes": [{"id": "24581046528203144", "rel
F5A"}, {"file_name": "Screenshot 2025-10-08 122846.png", "id": "770198286000035", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499624656_770198292666701_2283300169143648604_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uu0h4ZFBfKMQ7kNvwFCNhmU&_nc_oc=AdqwN4Ew92IESgr-ZK3log9WG_MeqkXXwWKe_lqM4YJKLDESGb5pdpoWeWcNIsYjyPs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1_ZnHRSqCv1k6gi1v_jY1h6n8ML9Jfcn7thBij-Z5w8A&oe=69F20EAE"}, {"file_name": "Screenshot 2025-10-08 123009.png", "id": "1182870890581305", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499623115_1182870893914638_8599595091586482149_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2raCtu_gcfYQ7kNvwFzrjnm&_nc_oc=Adpd6BKGdA0C0HRWT66d3SVNRCNCaa3Fs8FpRxROdpuH_H_VSaqlgiS7WWggrsv4yNM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af1Q5O4dhh5Farv63czBG3lnVXtOtgoMTUfCrErkTF-Ozw&oe=69F1F1BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mypuppy:ArcticFox", "keywords": ["fox", "ArcticFox", "pet", "pup", "puppy"], "long_description": "Welcome the elegant White Fox into your mixed reality world. Graceful, calm, and mysterious, this snow-white companion loves gentle affection and quiet moments. Feed it tasty biscuits and chicken legs to earn its trust, or toss a ball and watch it leap gracefully through your space. When it rests beside you, softly stroke its silky fur or give a light belly rub\u2014it will curl up in comfort, glowing with peaceful warmth. The White Fox brings a touch of magic and serenity to your world, reminding you that love can be both quiet and pure.", "short_description": "Feed, play, and pet your elegant White Fox\u2014calm, pure, and full of gentle magic."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.freeprivacypolicy.com/live/10adb063-6612-41f3-be14-a5be096bd6d7", "developer_terms_of_service_url": null, "publisher_name": "Unity", "support_website_url": null, "website_url": "http://game.lvcn.net/MyPup
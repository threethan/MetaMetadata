scontent-iad6-1.oculuscdn.com/v/t64.5771-25/57569423_228645626036490_4904432842489284791_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwoSfn_KY2IQ7kNvwHmJvLC&_nc_oc=Adp6YXMFqMxGAg2TalOJo8LUravWNxE7Bw-2EgvAAMUg27zCKbXRf3tUY_RfQx6YlRA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKp8DZMAoTdvU4vFveW-fVRryJU3UuC69R53VEppC-f4g&oe=6AB54273"}, {"file_name": "7_QUEST.png", "id": "409812280863172", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75223481_409812284196505_8055890214650260844_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7_ap_i6UgEMQ7kNvwGxN1UT&_nc_oc=AdozlRZ5QxNvH2RrykV0xk6VHOzZDpgiBeMwnUO9HSjQkzlD-NXBkHnwXJconGfbp58&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-rPBvdjUi1MIYLKreQb7w4wdn13FyHehN5oLjKdtqXg&oe=6AB51D59"}, {"file_name": "8_QUEST.png", "id": "251465670367884", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031611_251465673701217_8880482302551233076_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qpLdULuk7WkQ7kNvwFJQJPp&_nc_oc=AdqmLC8JIWJNjwxN2EKnaA8LngegqYhL-5HpN_dobkQXejYAX0HBi8o5105B58qqauk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK1N2OVJnvURinkjsGZlVStPgj-_dww5VFbyV1DFGLV-w&oe=6AB520DB"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Green Beret", "keywords": [], "long_description": "Green Beret: Rebels Operation is a virtual reality shooting \ngame inspired in the great classic shooters that we have\nenjoyed so many hours.\n\nPlay the role of a green beret infiltrated on an island taken\nby a group of rebel soldiers.\n\nIntro:\n\nA group of rebel soldiers under Colonel Walker have taken a \nremote island located in the Pacific Ocean and formed their \noperations center there.\n\nOn the island there is an ancient castle that they are using as\na base of operations and use their underground dungeons as\ncells.\n\nThe only way to enter the island is to be captured. In your\nmission you have let yourself be captured and you have been\nlocked in one of the castle's cells.\n\n\nYour next mission is to escape from your cell, annihilate all\nthe enemies to end the organization and get away from the \nisland.\n\nAre you ready to DIE?", "short_description": "Green Beret: Rebels Operation is a virtual reality shooting game inspired in the great classic shooters."}, {"images": {"nodes": []}, "id": "427133935689575", "locale": "es_ES", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Green Beret", "keywords": [], "long_description": "Green Beret: Rebels Operation es un juego de disparos de\nrealidad virtual inspirado en los grandes shooters cl\u00e1sicos que\ntantas horas hemos disfrutado.\n\nAsume el papel de un boina verde infiltrado en una isla tomada\npor un grupo de soldados rebeldes.\n\nHistoria:\n\nUn grupo de soldados sublevados a las \u00f3rdenes del coronel \nWalker han tomado una rec\u00f3ndita isla situada en el oc\u00e9ano\nPac\u00edfico y han formado all\u00ed su centro de operaciones.\n\nEn la isla se encuentra un antiguo castillo que est\u00e1n usando\ncomo base de operaciones y usan sus mazmorras subterr\u00e1neas como\nceldas.\n\nLa \u00fanica forma de entrar en la isla es siendo capturado. En tu\nmisi\u00f3n, te has dejado capturar y has sido encerrado en una de\nlas celdas del castillo.\n\nTu siguiente misi\u00f3n es escapar de tu celda, aniquilar a todos\nlos enemigos para acabar con la organizaci\u00f3n y conseguir \nescapar de la isla.\n\n\u00bfEst\u00e1s preparado para MORIR?", "short_description": "Green Beret: Rebels Operation es un juego de disparos de\nrealidad virtual inspirado en los grandes shooters cl\u00e1sicos."}]}, "developer_name": null, "developer_privacy_policy_url": "http://www.palvesoft.com/aviso-legal", "developer_terms_of_service_url": null, "publisher_name": "PalveSoft S.L.", "support_website_url": "http://www.palvesoft.com/contacto", "website_url": "http://www.palvesoft.com/green-beret-rebels-operation
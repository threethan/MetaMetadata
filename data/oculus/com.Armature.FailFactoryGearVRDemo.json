xcQujLPdkDjMw&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS1kbjKMPUryApzZO_x0NbevhA9ZyGbV0CCW24Q4snT3g&oe=6B0B223E"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "75262744_592055948252052_3174710684126543872_n.png", "id": "2273427452851341", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75363516_2273427456184674_5101230653467287889_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mike-fKWcoQQ7kNvwEiKcxM&_nc_oc=Adq3PGatuAJrEz7OuWktS97_DbxoxlUJttL8UPpSJCBx802g5SBmZ3X3fuaZ11huBbk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQTLnJw8abPX7-kDBk-o5JypCXF85pnBwq1zJ8IZUmAI8w&oe=6B0B44F2"}, "display_name": "Fail Factory! Demo", "keywords": ["Puzzle", "Casual", "Arcade", "Physics", "Demo"], "long_description": "Immerse yourself in a whimsical robot factory while climbing your way up the corporate ladder from lowly intern to esteemed star employee. In a wacky spectacle of increasing chaos, strive to keep up with the escalating comedy of errors as you operate various assembly lines in a myriad of mini-games. Entrenched in a physics-based, no consequences playground, experience three main types of mini-game stations, all with the goal to help the factory build robots on a massive scale. \n \nWorking in assembly stations, sorting stations and quality assurance protocol (QAP), where you\u2019ll control unfathomably large robots, you\u2019ll hone your skills in a factory that feels reactive and alive, allowing for a fully immersive experience. Designed with approachability in mind, ridiculous failure is inevitable as you work your way to the top in this vibrant, witty and comedic stress-inducing Fail Factory!.", "short_description": "Immerse yourself in a whimsical robot factory while climbing your way up the corporate ladder from lowly intern to esteemed star employee. In a wacky spectacle of increasing chaos, strive to keep up with the escalating comedy of errors as you operate various assembly lines in a myriad of mini-games. Entrenched in a physics-based, no consequences playground, experience three main types of mini-game stations, all with the goal to help the factory build robots on a massive scale."}]}, "developer_name": "Armature Studio", "developer_privacy_policy_url": "https://www.meta.com/legal/privacy-policy/", "developer_terms_of_service_url": "https://www.meta.com/legal/quest/games-terms-of-service/", "publisher_name": "Oculus", "support_website_url": null, "website_url": "http://www.armature.com/games/failfactory", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "CASUAL", "PUZZLE"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": null, "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en_US"], "supported_input_devices": ["GEAR_VR_CONTROLLER"], "supported_player_modes": [], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7093413164012358"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/11162702_199460303955810_4956430317289209856_n.png?stp=dst-png_s360x360&_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D8XUaSXc_yQQ7kNvwFaud_c&_nc_oc=AdpCIFUtc7vvikQfpod3APrI9eB2GRla4cO8i3QAqJKRZ8qTAFYRgRDTTrjChcUE2-w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQT9iliWcEDsn4zV-1YX0c8FxuQnEeKm9uYV_vzT-X2Irg&oe=6B0B435C"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Fail Factory! Demo", "platform": "ANDROID", "context_category": null, "context_topics": [], "release_date": 1513966200, "lastRevision": {"nodes": [{"id": "2031658127074970", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {
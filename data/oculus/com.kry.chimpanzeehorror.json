ty-arrival.png", "id": "2035437607110445", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823746_2035437610443778_4328479238039136990_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkKxCdl0JC0Q7kNvwEVlwvL&_nc_oc=Adq81wxTEt-QdF3VTOEUY8lgQ8BZSx1I126jI-A0ompMlziOn_C-94rEpJ2rGhrig24&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTVLAl-1JwEkv63ysMNWV2p0p2Fprn2zdC100o-kBCcGQ&oe=6AFB2846"}, {"file_name": "04-Containment.png", "id": "1864110484954174", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823837_1864110491620840_368512818721435998_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AYjhbRdO3FAQ7kNvwHBOGiE&_nc_oc=Adq8rEDrhSUlADbR2oB_dY4nfk637ZXNgNi6UT9Ub1BZki5UG28HKf0DqgIk8I3ofJA&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS8Yz7bJ2lWONLH_YKHDiPbmoUQ7JCu3Lt_yTnfsQ_5yQ&oe=6AFB1AF8"}, {"file_name": "05-Research-corridor.png", "id": "1809751903674838", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823341_1809751913674837_6773245731105204421_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NdQOFTwBT14Q7kNvwEKYXS5&_nc_oc=AdoGNtUDFN8IBmP3zVf1YsU6T44oSVZCSUqlNlowNXNm1rUuo7yAex-BgVQfYWffqp4&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQXEERBqHYJ4CV4z9aXU395O9lxsHKLaErtngSKO89jQ&oe=6AFB1F11"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Chimpanzee Horror Demo", "keywords": ["Chimpanzee", "Chimpanze", "Horror", "chimpanzehorror", "ChimpanzeeHorror"], "long_description": "Enter Chimpanzee Horror, a free multiplayer VR horror demo built around movement with your hands. Push off the ground, climb branches and carry your momentum through a misty forest social lobby.\n\nStep through BECOME THE MONSTER into an underground facility. At least two players enter the elevator; one is randomly chosen as the monster. Survivors have five minutes to escape pursuit and hide among the laboratories. Break the containment glass, chase survivors, or work to outlast the clock. Winners earn points for monster skins and modest upgrades.\n\nJoin public rooms, speak to nearby players with optional proximity voice chat, and customise your chimp with owned cosmetics. Your microphone starts muted. Online features require internet, Meta app access and an eligible teen/adult age-category result. Other sessions can explore locally.\n\nThis demo includes the forest lobby and one facility mode. It contains fantasy blood, dismemberment and frightening creatures. Standing or roomscale play and active arm movement are required. Expect intense acceleration; the monster can carry and rotate captured players.", "short_description": "Move with your hands, climb through a red-sky forest, and face a player-controlled monster in an underground facility. A free VR horror demo with public lobbies, proximity voice chat and five-minute survival rounds."}]}, "developer_name": "Kry", "developer_privacy_policy_url": "https://chimpanzee-horror-privacy.krywastaken.chatgpt.site/", "developer_terms_of_service_url": null, "publisher_name": "Kry", "support_website_url": "https://chimpanzee-horror-privacy.krywastaken.chatgpt.site/#deletion", "website_url": "https://chimpanzee-horror-privacy.krywastaken.chatgpt.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "644354873106712"}, {"id": "528142316460358"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_i
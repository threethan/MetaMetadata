x8oDlKsx7Q&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR8S93CfRyyvtB_Fp7r85V3aZ6LRTMgA7dLIeuM-xYOUQ&oe=6AFB4362"}, {"file_name": "Windmill-exterior.png", "id": "1116713147710763", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/604317775_1116713151044096_5238405424024971565_n.png?_nc_cat=102&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwUi84fiUnEQ7kNvwGNnufi&_nc_oc=AdpoyFxM1L4NAIP3VMuDSk5neCX-4OZVvF09HF2I2GUjO2OMcMy_xhXBAqWspcB0Uvc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQizDB03NNdneDUizGz-_KDLWgxiSCueJwMOxmgfQlAbQ&oe=6AFB3AA8"}, {"file_name": "Poolrooms-arrival.png", "id": "3345475935633245", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/595119480_3345475942299911_6526114020400935188_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73LZrFFCM_cQ7kNvwHYfLIe&_nc_oc=AdpeGUBH3D1O9zV5QyDTKrtvFlOzT9QDr4b2Kt8F2z27Yom3iIpfiChu36eqIhJjrD4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqFbIYpe4nym5b3t9zA3v7wOAaRW3_LRFZCvfX0Gt-gQ&oe=6AFB291F"}, {"file_name": "Mall-atrium.png", "id": "1581210663761384", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491831279_1581210667094717_1211303018947536404_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vNRcxwn7kjoQ7kNvwF4Ttwa&_nc_oc=Adq8sVflDmGUEOwR34u5eisVE6Nz2_bkE7cKiLeNmgHHguHM9fMAezkfGNZbZpF3ejE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSx8naihAxLnjJdzn08WYjs6Ydgm9saW7usox0TnuaHqw&oe=6AFB20F5"}, {"file_name": "Lobby-overview.png", "id": "27932662349747035", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491831964_27932662353080368_2868503563565707440_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P9nXhx86Xo0Q7kNvwGQOhCl&_nc_oc=Adp_W0drruRoW53OEbh5W8dVafoA_Y6nm-PUyhhNSCk_yJRQKgJ2AQ80u0jZFgUaAKs&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQsXqTdlcCGChkBbqWm11cf8jxkDzIyq3kv8WxzvAz7lA&oe=6AFB2BB1"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hollow Atlas", "keywords": ["HollowAtlas", "hollowatlas", "hollow", "atlas", "chimpanzeehorror"], "long_description": "Hollow Atlas is a VR horror adventure driven by your hands. Push off surfaces, climb with both arms, swim, and control your descent through continuous slide tunnels.\n\nStart in a forest social lobby and explore a multi-storey mall with walkable shops, outfit bundles, hats, hand accessories and pets.\n\nTHE FIRST WIND: cross a windswept meadow toward a distant windmill. The sky darkens as mutated, running creatures approach. Climb broken stairs to reach the hidden slide at the crown.\n\nTHE POOLROOMS: explore tall tiled halls, flooded passages and unsettling dreamlike rooms while a serpent hunts you. Different slides can lead onward, into danger, back to a dead end, or around a repeating loop. Find the route to the sewers.\n\nTHE SEWERS: a giant rat stalks the dark maze. Activate five hidden buttons, listen for the exit opening, and find it. Being caught brings a jumpscare and returns you to the lobby. Complete expeditions in order to unlock the next.\n\nMeet other chimps in public rooms with optional proximity voice. Microphones start muted. Customise your avatar with owned items and earned or owner-gifted cosmetics. Paid Points checkout is currently unavailable.\n\nStanding or roomscale play and active arm movement are required. Movement includes acceleration, heights, swimming and sliding. Online rooms need internet, app access and an eligible teen/adult platform age result; local play remains available otherwise.", "short_description": "Move with your hands through three connected nightmares. Climb the distant windmill, find a way through vast Poolrooms, and escape a sewer maze before its creatures catch you. Return to the forest lobby and explore the multi-storey cosmetic mall."}]}, "developer_name": "Kry", "developer_privacy_policy_url": "https://c
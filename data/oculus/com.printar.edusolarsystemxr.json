77489135567_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWG4jbAY4hoQ7kNvwGi1spb&_nc_oc=Adryogsd_f7bI2Yu8g4xgNcrgUazDuiVyohKs7HQHPXRtoO_kYEXHE3F2pBRcY81AHs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLdKVhcbXBxmZh8b658RDp_a35JDgq9e78VwVjcsGUo2A&oe=6AB9150C"}, {"file_name": "03_mixed_reality_orbits_2560x1440.png", "id": "4577046719201933", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_4577046725868599_7235074290771558666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gnj4O_oLFDMQ7kNvwGENqn4&_nc_oc=Adr_C15D2gaND0MNgvGrsmXpK0PnMMGFwrBzepXYistKey553CLaMJ7fZSHPQ95_hho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKEKcw2z7PdxZqbyDDzNFRENrlsoQB9SBLgotmKmPOmYQ&oe=6AB93A40"}, {"file_name": "04_tablet_ui_and_planets_2560x1440.png", "id": "1801217604653794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823296_1801217607987127_7267839897704222158_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDO-fugHGJcQ7kNvwG-SS5z&_nc_oc=Adq4bbnKjw3N4vurlYRbn0qqqB4iSvPoJirLf1LgVEHOJm7p8Yx7xp-QCybMAmQe_wk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJDWRiUvD24J2kJxfWT-f_rh_7BdkufUnulpBywY7ymyw&oe=6AB91B52"}, {"file_name": "05_earth_moon_closeup_2560x1440.png", "id": "1398854825047213", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1398854828380546_3558900233828066285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEHph9C17_YQ7kNvwEEMlHV&_nc_oc=AdqOw4ntCqjwbcG62MwR7QLc7SyOPc5BDkcJCxKwQ-cuqaQr7qVojk724nIT7kMl5Mc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK2GJsQddMkyDd0IAt4KcCG1iM-8loUH0euDj2YSi5dYA&oe=6AB923B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Edu Solar System XR", "keywords": [], "long_description": "Edu Solar System XR is an interactive educational experience that brings the Solar System into virtual and mixed reality.\n\nExplore the Sun and planets in 3D, observe their relative positions and orbital motion, and inspect celestial bodies up close using hand tracking or Touch controllers. Grab selected objects, examine them from different angles, and return them to their orbit when finished.\n\nUse the in-app tablet to access object information, simulation controls, settings and an eclipse calendar. Learn about temperatures, distances and other facts while exploring the Solar System at your own pace.\n\nThe app also includes solar and lunar eclipse simulations, adjustable simulation speed, orbit visualization and mixed-reality passthrough support, allowing the Solar System to appear directly in your room.\n\nEdu Solar System XR is designed as a visual learning tool for anyone interested in astronomy, space and the mechanics of our Solar System.", "short_description": "Explore the Solar System in VR and mixed reality. Observe the Sun, planets and moons, inspect their orbits, learn key facts, and experience solar and lunar eclipses in an interactive educational environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://printar.sk/edu-solar-system-xr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "PRINTAR", "support_website_url": null, "website_url": "https://printar.sk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1288597067674253"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED"
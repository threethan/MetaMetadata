https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823351_1398854828380546_3558900233828066285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7Yo3sRfVm4Q7kNvwE1KXIZ&_nc_oc=Adqk-Olvavi15Ny4aw1_iZMfcVu2AUBrGrZ3vc7PZMdlo-8tpZw7IUOMBkJWEhpTJ1s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG1BJpY1NLux4w_kddAr3enTeOxYg8rVRnRfm3_ss6WQ&oe=6AC7A433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "00_universal_base_2560x1440.png", "id": "1407826258193394", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823802_1407826261526727_1223894263899578753_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JBacq1EhgBIQ7kNvwEL-qWN&_nc_oc=AdoOC6w7Z9hQP6xXQwMtjChxXbxniGTWENJ0sN0UAWuzqcHsSOq8KpIfKM3gOs5oEZg&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOob3NDzTxiiVHDcYAScvhTn7cDe5zqv1HB2l1iLgcBpQ&oe=6AC7A493"}, "display_name": "Edu Solar System XR", "keywords": [], "long_description": "Edu Solar System XR is an interactive educational experience that brings the Solar System into virtual and mixed reality.\n\nExplore the Sun and planets in 3D, observe their relative positions and orbital motion, and inspect celestial bodies up close using hand tracking or Touch controllers. Grab selected objects, examine them from different angles, and return them to their orbit when finished.\n\nUse the in-app tablet to access object information, simulation controls, settings and an eclipse calendar. Learn about temperatures, distances and other facts while exploring the Solar System at your own pace.\n\nThe app also includes solar and lunar eclipse simulations, adjustable simulation speed, orbit visualization and mixed-reality passthrough support, allowing the Solar System to appear directly in your room.\n\nEdu Solar System XR is designed as a visual learning tool for anyone interested in astronomy, space and the mechanics of our Solar System.", "short_description": "Explore the Solar System in VR and mixed reality. Observe the Sun, planets and moons, inspect their orbits, learn key facts, and experience solar and lunar eclipses in an interactive educational environment."}]}, "developer_name": "PRINTAR", "developer_privacy_policy_url": "https://printar.sk/edu-solar-system-xr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "PRINTAR", "support_website_url": null, "website_url": "https://printar.sk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1306168335917126"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823279_1393471229641603_6717467004384435140_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmSIl437i-oQ7kNvwGDH2HB&_nc_oc=Adpq-OMJxYxUDiIfyARGGkkDvrREbLy9Ea0yeG50T4UHcTtqQ-wZbH5LZhSPtQsa_rc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSGX0tfYOUfmiYmgMO1vMp3A1HWun0_D3Vk5WzfDboyw&oe=6AC7A9DE"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Edu Solar System XR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1790000100, "lastRevision": {"nodes": [{"id": "1277264762140817", "release_type": "SCHEDULED", "administration_status": "APPROVED", "pdp_metadata": {"applicati
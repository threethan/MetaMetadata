ht7sSg5lRerfHvCC3aO_U10i1_pGONOUd8C97wDHo2U3QoPbZtiZmJ7Waji1Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPdH7tShcE_q_-CERM-bV6v-3KfDhDkjS9e7pXBthDo9g&oe=6AC7BAC0"}, {"file_name": "04_tablet_ui_and_planets_2560x1440.png", "id": "1801217604653794", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491823296_1801217607987127_7267839897704222158_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bWtwUp8QvE0Q7kNvwHrSsgO&_nc_oc=Adr7uZ2Bn9_O3je8UECTtosyATAb7Y2Qgw-c-Lg3XMWriMpMyM-3hjkpCjX6BdRV-eM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6op_YcRDYXpkVFcxCD24iz6RL0dO_3smqkeWRAn6mpg&oe=6AC79BD2"}, {"file_name": "05_earth_moon_closeup_2560x1440.png", "id": "1398854825047213", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491823351_1398854828380546_3558900233828066285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p7Yo3sRfVm4Q7kNvwE1KXIZ&_nc_oc=Adqk-Olvavi15Ny4aw1_iZMfcVu2AUBrGrZ3vc7PZMdlo-8tpZw7IUOMBkJWEhpTJ1s&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPG1BJpY1NLux4w_kddAr3enTeOxYg8rVRnRfm3_ss6WQ&oe=6AC7A433"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Edu Solar System XR", "keywords": [], "long_description": "Edu Solar System XR is an interactive educational experience that brings the Solar System into virtual and mixed reality.\n\nExplore the Sun and planets in 3D, observe their relative positions and orbital motion, and inspect celestial bodies up close using hand tracking or Touch controllers. Grab selected objects, examine them from different angles, and return them to their orbit when finished.\n\nUse the in-app tablet to access object information, simulation controls, settings and an eclipse calendar. Learn about temperatures, distances and other facts while exploring the Solar System at your own pace.\n\nThe app also includes solar and lunar eclipse simulations, adjustable simulation speed, orbit visualization and mixed-reality passthrough support, allowing the Solar System to appear directly in your room.\n\nEdu Solar System XR is designed as a visual learning tool for anyone interested in astronomy, space and the mechanics of our Solar System.", "short_description": "Explore the Solar System in VR and mixed reality. Observe the Sun, planets and moons, inspect their orbits, learn key facts, and experience solar and lunar eclipses in an interactive educational environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://printar.sk/edu-solar-system-xr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "PRINTAR", "support_website_url": null, "website_url": "https://printar.sk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1288597067674253"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": "29115014264770606"}, {"status": "PUBLISHED", "id": "2345403202866346"}, {"status": "CANCELLED", "id": "1089649233805796"}, {"status": "PUBLISHED", "id": "2153518818921140"}]}, "baseline_offer": {"id": "29115014264770606"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1790776980, "status": "PUBLISHED", "id": "29115014264770606"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1307875025746457", "version": "1.0.5"}, "id": "1100846538963645", "chann
77489135567_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TWG4jbAY4hoQ7kNvwGpwW0K&_nc_oc=Adogxt3fLm2rKxXIEtJ3jqQPLYYN7g3aM0id9hP060YgU7fXh-ECTqER6nUj0bJviMQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIF0rlaDqdTGC3LyIPuXeaxqS8vC87zwegxVNOnrZDcPg&oe=6AB7C38C"}, {"file_name": "03_mixed_reality_orbits_2560x1440.png", "id": "4577046719201933", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823837_4577046725868599_7235074290771558666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gnj4O_oLFDMQ7kNvwEkcKOj&_nc_oc=AdpyJbFbtbxK56kj5bEfqcdg5nAtQOAdda2CdXu1ky7PqHXQPKk0JYPLc2INwNWy-Xc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLH-xp3zWGKO5OO3ftT1ZxqXlR5WAxyXKHIjPNFuNjBkA&oe=6AB7E8C0"}, {"file_name": "04_tablet_ui_and_planets_2560x1440.png", "id": "1801217604653794", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491823296_1801217607987127_7267839897704222158_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aDO-fugHGJcQ7kNvwFG21C5&_nc_oc=AdocvSdn-ET2cNd2s9WWaPFEjEn9mCEI1qb0GWGATzz6bTTHlLpDyqUHH0fX6XcfLCk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIbmdqLQm7kU_uhTxuUQf5Q1nTGUn3_6smqVgdjComYdg&oe=6AB7C9D2"}, {"file_name": "05_earth_moon_closeup_2560x1440.png", "id": "1398854825047213", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491823351_1398854828380546_3558900233828066285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEHph9C17_YQ7kNvwErHP5v&_nc_oc=AdqcBf6JiIQrszqYefKOuTplfaVecd5jnq3A7V1oXimYlkpbkgqGtyXu2IZsXsHVkDU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKDZ0-9aDdfwbYz59GAlJgOqPeSfuvEdNKVw0jLzUx7fw&oe=6AB7D233"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Edu Solar System XR", "keywords": [], "long_description": "Edu Solar System XR is an interactive educational experience that brings the Solar System into virtual and mixed reality.\n\nExplore the Sun and planets in 3D, observe their relative positions and orbital motion, and inspect celestial bodies up close using hand tracking or Touch controllers. Grab selected objects, examine them from different angles, and return them to their orbit when finished.\n\nUse the in-app tablet to access object information, simulation controls, settings and an eclipse calendar. Learn about temperatures, distances and other facts while exploring the Solar System at your own pace.\n\nThe app also includes solar and lunar eclipse simulations, adjustable simulation speed, orbit visualization and mixed-reality passthrough support, allowing the Solar System to appear directly in your room.\n\nEdu Solar System XR is designed as a visual learning tool for anyone interested in astronomy, space and the mechanics of our Solar System.", "short_description": "Explore the Solar System in VR and mixed reality. Observe the Sun, planets and moons, inspect their orbits, learn key facts, and experience solar and lunar eclipses in an interactive educational environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://printar.sk/edu-solar-system-xr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "PRINTAR", "support_website_url": null, "website_url": "https://printar.sk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1288597067674253"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED"
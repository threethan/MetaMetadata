77489135567_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QKXlDvm8vFQQ7kNvwFKrMzU&_nc_oc=AdrPhCi3INdq-1dyW6rAL47Df3Zof2nG27VTnosiGIwUMPE3dDzHR6zh2NCx28nsItg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIFFq68br-py__tQb13KhQu5U3ySmnhUgpJSuQyOGSTqA&oe=6ABBB80C"}, {"file_name": "03_mixed_reality_orbits_2560x1440.png", "id": "4577046719201933", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_4577046725868599_7235074290771558666_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=na_dSvd0eEoQ7kNvwEF5WaP&_nc_oc=AdquT5GfxaCLpOYXJLBGrvctCpYYdVlA-FiObmvyG-fVG3ZeYZD32nuKEBjpvcyQ2vI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLgIm2zmGzfI52zTJ8x8kTAeU6ae4zAo-LMQ8-8TRi0DA&oe=6ABBDD40"}, {"file_name": "04_tablet_ui_and_planets_2560x1440.png", "id": "1801217604653794", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823296_1801217607987127_7267839897704222158_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hteCF6SnRoAQ7kNvwFZozFW&_nc_oc=AdrQeG-SmyeGOh-h2Z7piaobWbA-1znIvz1y5prv6roc_JWosrDFefPztejlZ4ojluY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLTWeSI2qnBRpqZ4kMLKt71rtrq5PhSP6JV5aokI2Cgag&oe=6ABBBE52"}, {"file_name": "05_earth_moon_closeup_2560x1440.png", "id": "1398854825047213", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491823351_1398854828380546_3558900233828066285_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VuOwLgJAWCEQ7kNvwGanzAv&_nc_oc=AdoCicWrJIfP83QIR8csUifMJJrUuv4Xw7LV4QnNsp6mEWqr9xP_wgHgpV7e_LwonuE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKFnRUFMKoA3oNWr3zw0aglAdu645VFqy5LiHD92aGZ6Q&oe=6ABBC6B3"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Edu Solar System XR", "keywords": [], "long_description": "Edu Solar System XR is an interactive educational experience that brings the Solar System into virtual and mixed reality.\n\nExplore the Sun and planets in 3D, observe their relative positions and orbital motion, and inspect celestial bodies up close using hand tracking or Touch controllers. Grab selected objects, examine them from different angles, and return them to their orbit when finished.\n\nUse the in-app tablet to access object information, simulation controls, settings and an eclipse calendar. Learn about temperatures, distances and other facts while exploring the Solar System at your own pace.\n\nThe app also includes solar and lunar eclipse simulations, adjustable simulation speed, orbit visualization and mixed-reality passthrough support, allowing the Solar System to appear directly in your room.\n\nEdu Solar System XR is designed as a visual learning tool for anyone interested in astronomy, space and the mechanics of our Solar System.", "short_description": "Explore the Solar System in VR and mixed reality. Observe the Sun, planets and moons, inspect their orbits, learn key facts, and experience solar and lunar eclipses in an interactive educational environment."}]}, "developer_name": null, "developer_privacy_policy_url": "https://printar.sk/edu-solar-system-xr/privacy/", "developer_terms_of_service_url": null, "publisher_name": "PRINTAR", "support_website_url": null, "website_url": "https://printar.sk/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1288597067674253"}}]}, "scheduled_offers": {"count": 3, "nodes": [{"status": "PENDING", 
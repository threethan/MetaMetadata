_1295606680948038_532365841870148967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UXApHonqBjAQ7kNvwG1VTmb&_nc_oc=AdpRq8BgqRbth8Nv_gWw4rmFA_jsLvZcspOtq6fMkf-UvUkARbcaNdvE7ZtwORMI2u0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4e9nGLelelZoLVvvZgNDzQAB7HECSNxQb8rv3U2X4QoA&oe=69FA0D74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "3225985711061860", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75292489_3225985714395193_4677245712941848262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=faDqlxvqNJMQ7kNvwFts1po&_nc_oc=AdqMJzxNavpIaASqsFA9ZtBBPmLrMwOaWFgUjQmjBd8bsZNXSYG1OfDy1BUMGYJTxhk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4-F4BMIWuea9WRWG939VMywY_0Z9h6Vyn1ihj54TutmA&oe=69F9DE58"}, "display_name": "Kaiten Sushi VR", "keywords": [], "long_description": "Kaiten Sushi VR is a game that you can experience basic operations of a conveyor belt sushi restaurant.\n\nMake sushi and serve to your customers within the time limit and make them happy.\n\nThere are four game modes:\n\n- Endless Mode: No time limit but if you make five customers angry, game will over.\n\n- Time Limit Mode: In 10 minutes, serve as much sushi as possible.\n\n- Ninja Mode: The ninja is coming to kitchen and attacks you. Protect yourself from the ninja.\n\n- Free Mode: There is no limit. You can practice your skills in this mode.\n\nEnjoy!", "short_description": "Kaiten Sushi VR is a game that you can experience basic operations of a conveyor belt sushi restaurant."}]}, "developer_name": null, "developer_privacy_policy_url": "https://monacrea.com/privacy-policy-for-kaiten-sushi-vr.html", "developer_terms_of_service_url": null, "publisher_name": "monacrea", "support_website_url": null, "website_url": "https://monacrea.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
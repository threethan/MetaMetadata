-1.oculuscdn.com&oh=00_Aft_SI-4UTTtzekcDhjy7F_Ns5l2yUna4K_nNXU3IMpHgg&oe=69A2EA97"}, {"file_name": "screen4.png", "id": "2170451979783847", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/75394636_2170451983117180_5866366382842952110_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=boihC1q3KCUQ7kNvwHKdqKL&_nc_oc=AdnKUkrpzg_jrQQ8_Pepg0JpT0Q-P3QgcdXmHtf-6vEkl91kWVQO6K8wfWfcKjwS04g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aftton-HaMz_n9UkeJY6tGALaFQvVJokswcNdPVwpKjL3A&oe=69A2C985"}, {"file_name": "screen5.png", "id": "1295606674281372", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974716_1295606680948038_532365841870148967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huYVMFHfxmYQ7kNvwEcpVYJ&_nc_oc=Adkb5jyCfeNwMAaEuXrdJnmWfIe2j-xlv6GDj7DBBE312aiSf9VNr7J0svJt-nBsvHM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvOMvgwAheH-BMJ-7vbFo_9EXpZZZZVtSATdqfD8sBiFA&oe=69A2D234"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "3225985711061860", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75292489_3225985714395193_4677245712941848262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i7YkPqLm0dwQ7kNvwE3Ectq&_nc_oc=AdkkvsZE-CGyu24BpX1di1ZPxRcr87IE8vclhTHzcQ1NrnyOtpd3Y4NfHrwZesXGzvI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfuRqeZAD7plX1gysWl9jkG769UG7IR4X0_sFMwzLxzTGg&oe=69A2DB58"}, "display_name": "Kaiten Sushi VR", "keywords": [], "long_description": "Kaiten Sushi VR is a game that you can experience basic operations of a conveyor belt sushi restaurant.\n\nMake sushi and serve to your customers within the time limit and make them happy.\n\nThere are four game modes:\n\n- Endless Mode: No time limit but if you make five customers angry, game will over.\n\n- Time Limit Mode: In 10 minutes, serve as much sushi as possible.\n\n- Ninja Mode: The ninja is coming to kitchen and attacks you. Protect yourself from the ninja.\n\n- Free Mode: There is no limit. You can practice your skills in this mode.\n\nEnjoy!", "short_description": "Kaiten Sushi VR is a game that you can experience basic operations of a conveyor belt sushi restaurant."}, {"images": {"nodes": []}, "id": "470723509307547", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\u56de\u8ee2\u5bff\u53f8 VR", "keywords": [], "long_description": "\u56de\u8ee2\u5bff\u53f8 VR\u306f\u3001\u56de\u8ee2\u5bff\u53f8\u5e97\u306e\u57fa\u672c\u7684\u306a\u30aa\u30da\u30ec\u30fc\u30b7\u30e7\u30f3\u3092\u4f53\u9a13\u3067\u304d\u308b\u30b2\u30fc\u30e0\u3067\u3059\u3002\n\n\u5236\u9650\u6642\u9593\u5185\u306b\u304a\u5bff\u53f8\u3092\u63e1\u3063\u3066\u304a\u5ba2\u3055\u3093\u306b\u63d0\u4f9b\u3057\u3001\u559c\u3093\u3067\u3082\u3089\u3044\u307e\u3057\u3087\u3046\u3002\n\n\u30b2\u30fc\u30e0\u30e2\u30fc\u30c9\u306f4\u3064\u3042\u308a\u307e\u3059\u3002\n\n- \u30a8\u30f3\u30c9\u30ec\u30b9\u30e2\u30fc\u30c9\u3000\u6642\u9593\u5236\u9650\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u30015\u4eba\u306e\u304a\u5ba2\u3055\u3093\u3092\u6012\u3089\u305b\u3066\u3057\u307e\u3046\u3068\u30b2\u30fc\u30e0\u30aa\u30fc\u30d0\u30fc\u306b\u306a\u308a\u307e\u3059\u3002\n\n- \u30bf\u30a4\u30e0\u30ea\u30df\u30c3\u30c8\u30e2\u30fc\u30c9\u300010\u5206\u9593\u3067\u3001\u3067\u304d\u308b\u3060\u3051\u591a\u304f\u306e\u304a\u5bff\u53f8\u3092\u63d0\u4f9b\u3057\u307e\u3059\u3002\n\n- \u5fcd\u8005\u30e2\u30fc\u30c9\u3000\u5fcd\u8005\u304c\u53a8\u623f\u306b\u3084\u3063\u3066\u304d\u3066\u3001\u3042\u306a\u305f\u306b\u8972\u3044\u304b\u304b\u308a\u307e\u3059\u3002\u5fcd\u8005\u304b\u3089\u8eab\u3092\u5b88\u308a\u307e\u3057\u3087\u3046\u3002\n\n- \u30d5\u30ea\u30fc\u30e2\u30fc\u30c9\u3000\u5236\u9650\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u3053\u306e\u30e2\u30fc\u30c9\u3067\u306f\u3001\u3042\u306a\u305f\u306e\u30b9\u30ad\u30eb\u3092\u7df4\u7fd2\u3059\u308b\u3053\u3068\u304c\u3067\u304d\u307e\u3059\u3002\n\n\u3069\u3046\u305e\u56de\u8ee2\u5bff\u53f8\u30b2\u30fc\u30
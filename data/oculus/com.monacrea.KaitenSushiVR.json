_1295606680948038_532365841870148967_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A7Uj3G5gAV8Q7kNvwGZecNO&_nc_oc=AdokaNnXwMl4Bcn8S-9NtSxibfMCYrIrXTjmdWtnfJ8DVE9Dcu0XB4Z8Y89c3jUqiYI&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-0i7vILY5eHTOt3xbZwZzPGpmVqKDTlttgW15XUVCr9w&oe=6A413E74"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "lanscape.png", "id": "3225985711061860", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75292489_3225985714395193_4677245712941848262_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VgkUFJs2qXUQ7kNvwGcfdKr&_nc_oc=AdrmgtW2aXof-foHdZXSaVzw62tgP-n2l_gc6TxXNCOlR4NZ1McwDTyqSSE-n3WsRD4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8JI1XKq99cPDBloO_SmsbFFVj0tl8sSvwfFjhCWUlBIA&oe=6A410F58"}, "display_name": "Kaiten Sushi VR", "keywords": [], "long_description": "Kaiten Sushi VR is a game that you can experience basic operations of a conveyor belt sushi restaurant.\n\nMake sushi and serve to your customers within the time limit and make them happy.\n\nThere are four game modes:\n\n- Endless Mode: No time limit but if you make five customers angry, game will over.\n\n- Time Limit Mode: In 10 minutes, serve as much sushi as possible.\n\n- Ninja Mode: The ninja is coming to kitchen and attacks you. Protect yourself from the ninja.\n\n- Free Mode: There is no limit. You can practice your skills in this mode.\n\nEnjoy!", "short_description": "Kaiten Sushi VR is a game that you can experience basic operations of a conveyor belt sushi restaurant."}]}, "developer_name": null, "developer_privacy_policy_url": "https://monacrea.com/privacy-policy-for-kaiten-sushi-vr.html", "developer_terms_of_service_url": null, "publisher_name": "monacrea", "support_website_url": null, "website_url": "https://monacrea.com/", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id":
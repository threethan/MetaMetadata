s=7f20f&oh=00_AQT8pOPyYP0lxaT4uwdeQ7YfaBmR-klO_T2SCMxhxa0vJQ&oe=6AF880DD"}, {"file_name": "screenshot_5.png", "id": "1755809842131823", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/673525341_1755809845465156_3127846637756384761_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7Rn6iMPViSYQ7kNvwEWUa7-&_nc_oc=Adq_3FmTZ0UEFxI0cf_M81TrFyRHV5vxD3nbA4WSl5y0D1eqz5HBslhbbIH5D_JKQ-8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT2_kRgDpei4FAouHSDewssu5IMkOF79e_I1KtYwl1MhQ&oe=6AF87D63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1080232871468563", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491831393_1080232874801896_7791295876261390986_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ONBmwTCbY7EQ7kNvwGTpQob&_nc_oc=AdqarPfd2tOmwp0lsOsozvkqqeuQhBTGDpLnMi6Zg_zF-BHJulY-OFNwDxh0tlp-eiE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaCyivLXIYdSdj7-XpP-XKFip3jzCkT66Menk_pFuLGw&oe=6AF896EC"}, "display_name": "Graffiti Online", "keywords": ["graffiti", "multiplayer", "painting", "art", "sandbox"], "long_description": "Graffiti Online takes the golden-hour alley from Graffiti 5 and fills it with people.\n\nPAINT TOGETHER\nUp to six writers share the same thirteen brick walls. Every stroke, drip and stencil you lay down appears on everyone's wall as you make it, and when you join late the finished pieces are already there waiting.\n\nREAL WRITERS\nPick your avatar, Remy or Michelle, and the other players see a full body: their head turns where they look, their arm reaches where they spray, the can in their hand hisses and mists. Name tags float over every writer.\n\nONE BUTTON TO PLAY\nPress B and choose QUICK JOIN to paint with whoever is on, or PRIVATE ALLEY to get a 4-digit code for your friends. Optional voice chat is off by default. Mute, block or report anyone from the Writers list.\n\nTHE ALLEY\nSix different real brick sets with deep relief, wet cobbles, a fire escape, the loading doors - and six looks the whole crew shares: golden hour, high sun, sun shower, snow day, first light and autumn gold.\n\nTHE KIT\nEight CITIVIEW cans on the table, skinny, medium and fat caps, 32 stencils from A to Z, a fresh-coat post to start again, a photo camera for your finished piece, and your own music.\n\nPlay alone whenever you like - the alley is yours the moment the game loads.\n\nControls: grip to pick up a can, trigger to spray, X colours, A cap, Y photo, B online menu, stick to move, snap turn.", "short_description": "Paint a real brick alley with your crew. Up to six writers spray the same walls at the same time, with real PBR brick, mist, drips, stencils and the CITIVIEW cans from Graffiti 5. Quick Join finds other writers in seconds, or open a private alley for friends with a 4-digit code. Play alone any time."}]}, "developer_name": null, "developer_privacy_policy_url": "https://citiview-games.pages.dev/graffitionline/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": "https://citiview-games.pages.dev/graffitionline/", "website_url": "https://citiview-games.pages.dev/graffitionline/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1338198016039728"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1758664
&_nc_ss=7f20f&oh=00_AQFHYSDbu9qevrbqci2sAEuhW7xmASgEOU0UZs3ZhxVFcg&oe=6A747FC3"}, {"file_name": "2.png", "id": "1580019053303518", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825503_1580019059970184_8027531295536183414_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mg5McrhQOe0Q7kNvwGlCE6F&_nc_oc=Ado_Fs3rXy9iS_APLCTlAMFrqEH1PDStO_jA7K513P2UMfgTTiF1_gDLoWbKFU15yUc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElnqZCr-YhgOjtsW_T7QyFDt68AUNC5l8vKwi9R7jVhg&oe=6A747A17"}, {"file_name": "6.png", "id": "1574584243806355", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823901_1574584247139688_3918219127132372604_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEqt_8VzQxYQ7kNvwFalwsG&_nc_oc=AdoGz6guX7RRWxljDhAu20k3VmTPrOsrknNRozHCDhyZcBBFNQj1MJSkr46SHJAgHH4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFLdXkcPGuNo9XzOP2jVrEf006m3b6YAp2OemFRvE6Byg&oe=6A74754D"}, {"file_name": "ss 4.png", "id": "1416732076797823", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491824307_1416732080131156_3573683739021869749_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uJLu6278BIoQ7kNvwHrVXjX&_nc_oc=AdrY3n4Zrv1UkauIUX5_YSZel8NfN76OAax663TlGuMSbxFnMKhi8T5xJzH4-MBOn_8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHercfF9-YzWTe8veC6sPUfyA1vK76yaPCrcIMPTUgIg&oe=6A749F8F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Surah Bakra", "keywords": ["quran", "education", "3d"], "long_description": "Surah Bakra\n\nExperience the complete recitation of Surah Bakra, the second and longest chapter of the Holy Quran, in a fully immersive virtual reality environment designed exclusively for Meta Quest.\n\nThis VR experience allows you to listen to and reflect on Surah Bakra in a calm and distraction-free setting. The environment is carefully designed to promote focus, peace, and spiritual connection while engaging with the verses.\n\nSurah Bakra covers essential guidance on faith, patience, prayer, charity, and moral conduct. It includes powerful verses such as Ayat-ul-Kursi and provides comprehensive teachings for personal and community life.\n\nFeatures:\nFull Surah Bakra recitation\nHigh-quality, clear audio\nComfortable and immersive VR environment\nEasy verse navigation\nSmooth performance on Meta Quest\n\nWhether you are listening for daily recitation, memorization, or reflection, this VR experience helps deepen your connection with the Quran in a modern and engaging way.\n\nDesigned specifically for Meta Quest to provide a unique and meaningful spiritual journey.", "short_description": "Experience the complete recitation of Surah Bakra  in a peaceful virtual environment designed for focus and reflection. This update brings improved audio clarity, smooth navigation between verses, and enhanced visual comfort for a better spiritual experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.miraclegroup.work/privacy", "developer_terms_of_service_url": null, "publisher_name": "Miracle Group", "support_website_url": null, "website_url": "https://miraclegroup.work/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "434961926215971"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25898895973146154"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1438894884367814"}]}, "baseline_offer": {"id": "1438894884367814"}, "is_approved": tr
t 2024-11-06 at 10.42.50\u202fPM-3.png", "id": "957207056236521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974647_957207059569854_4724447921387146542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IVZUs4F7PxEQ7kNvwEygkU0&_nc_oc=AdqTx7M27p4YNGKfLDoWZKMBkZ-DsQhRS5ibVYxo0IymfjlE73_ObL_7t5Sg8epJFkc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af3rqrv-l-dVCkVVNdn2pg1_fOHH73YclTvJxgu_cI2CQQ&oe=69F0B761"}, {"file_name": "Screenshot 2024-11-06 at 10.43.16\u202fPM.png", "id": "945779820725681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982519_945779824059014_5487990987730440173_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s6ylxZi3n-UQ7kNvwEDdqw9&_nc_oc=AdpYpuqwY1KzKPNOD9FVhNMYlsUQu3CWhq5Zyme0VY2HBkASqE2mpFAXwZfM7R_RKO0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af1A2MbJFXnFlvBhDEJx0yFvEcKaT8fNIRQ_44Esw3qxHA&oe=69F0AD2B"}, {"file_name": "ScreenShot_For_App_Store_2560x1440_FlowGateVR.png", "id": "2615283935336972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304106_2615283945336971_2045992492782396642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cBqdUo-Bz4YQ7kNvwFjhOLK&_nc_oc=Ado9DrdkiUhUhcyI-Q_Ssj1MrGE0hMjG_Y1Zo7g5K8og_l0pX970JwvWiei2LL5NsY4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af08LrOY6lvDnT8y5xajz8itg0Itdtc5f1RPsMklrnKvGQ&oe=69F0CE5A"}, {"file_name": "ScreenShot_2_For_App_Store_2560x1440_FlowGateVR.png", "id": "1366994261265909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307450_1366994264599242_9185569319492547644_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ws1tH7VQHqQQ7kNvwGLtDnc&_nc_oc=AdoHfAqHnORqWfveF309WmK7eHodcdKRla429LsRiij-ImLjjS4E8kRl1vrx2uKg7Hs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0KRLuLn65nIwn4JWnq99U1oVuGR2n-lAWFgEJt5r3jzw&oe=69F0B4FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TissueGnomics and ConfocalVR.png", "id": "1000799194657373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974859_1000799197990706_5369854154150475545_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=erya5cKFTIgQ7kNvwGtT0oJ&_nc_oc=AdqvJoLOq1tW-9Md7RTeYU4NGyeADWkry30lwgVHnPTpRsMlusM9nc56c-awdSuDs3s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af20ttflo6_IrDOZQI3S1_DD6A9uwIW41Kfri_SrKmvg8Q&oe=69F0A3E1"}, "display_name": "FlowGateVR", "keywords": [], "long_description": "**FlowGateVR** \u2014 from Immersive Science.\n\nA voice-driven VR tool for exploring multichannel flow cytometry data on Meta Quest.\n\n**AI Assistant**\n- Ask questions about your loaded dataset by speaking naturally\n- Query marker distributions, population statistics, and gating results\n- Get answers tuned for biomedical researchers \u2014 not generic AI\n- AI features improve automatically with no app update required\n\n**3D visualization**\n- Map any markers to X, Y, and Z axes (e.g., CD4 vs CD8 vs CD3)\n- Switch axis assignments on the fly to explore different marker combinations\n- Scatter, forward scatter, side scatter, fluorescent markers \u2014 all mappable\n- Visualize tSNE or UMAP dimensionality reduction alongside original markers\n\n**Multidimensional gating**\n- Draw 3D gates to select cell populations\n- Apply multiple gates with distinct colors\n- Switch axes with gates preserved \u2014 refine populations across marker spaces\n- Export gated subsets as CSV for follow-up analysis\n\n**Your data, your way**\n- Import compensated event CSV files (exported from FlowJo or similar)\n- Side-load datasets via Meta Link, headset browser, or SideQuest\n- Compatible with CyTOF and spectral cytometry data in CSV format\n\n**Collaboration**\n- Shared VR sessions with voice communication\n- Co-navigate the same dataset in real time\n\nDesigned for immunologists, cell biologists, and cytometry core facility researchers.\n\n**Need more performance?** A Windows desktop version is available for very large datasets. Contact support@immsci.com for details.\n", "short_description": "Explore flow cytometry data in immersive 3D with AI-assisted analysis. Map markers to axes, gate populations, and export findings. Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26098347426515303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_1601333577590645_7716511477880620330_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfsbrrS-ha0Q7kNvwGN31Yk&_nc_oc=AdqXjBS-c0FWOQADKY4dcpGEarrfbah4PUIIOOgTzCZNyNXE7spN2soaYwYrSVY5H8Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0a2mXXXevJAuZnSHEGNSZGKJg9UaapXfPbrGSHz5T3aw&oe=69F0C8EA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FlowGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"topic_name": "Learning", "id": "1043107547362485"}], "release_date": 1721685452, "lastRevision": {"nodes": [{"id": "7614979291945397", "release_type": "SCHEDULED", "admin
h=00_Af684DyvGv7neN67ju7fXsmn1BvV6VT-BvYDcTLtfRwQUA&oe=6A070E3A"}, {"file_name": "Screenshot 2024-11-06 at 10.42.50\u202fPM-3.png", "id": "957207056236521", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974647_957207059569854_4724447921387146542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eh6dYaX6i0oQ7kNvwGtX5Sl&_nc_oc=AdqiQGPZZfhecXPQy2zuWb-LsTkMKB_RCnTo6T7ZFjfI-ntaULU6LoUDTooHDTtXAvM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5UtfcOQ8lZPwvDQ8XP_TtgNxHTaknaixcpJ6PyORWS0w&oe=6A0720E1"}, {"file_name": "Screenshot 2024-11-06 at 10.43.16\u202fPM.png", "id": "945779820725681", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982519_945779824059014_5487990987730440173_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d1M5viexH00Q7kNvwH75bY5&_nc_oc=AdqigejzfljuMdAecBSyZiknraLx0y8-RSrHvRhUkHLRFFLyGDyl-Xusp8sWPKlnzHY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4J_djECPJ5jePb0QqAsteZryjuPvKNTSJtPg2_JWhauA&oe=6A0716AB"}, {"file_name": "ScreenShot_For_App_Store_2560x1440_FlowGateVR.png", "id": "2615283935336972", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499304106_2615283945336971_2045992492782396642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=81TelgQ5ZVoQ7kNvwFE3c6h&_nc_oc=AdoCXRsQsRdkpRcluHyQrxqIgX7wHda7zgOFRFpNB__ZOpt6OlP59YKY2K5d-qg08aQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5s_I9pk8_gP3gLe8OQ1g027fiuzPKkPI-sW9rK8p4w1g&oe=6A0737DA"}, {"file_name": "ScreenShot_2_For_App_Store_2560x1440_FlowGateVR.png", "id": "1366994261265909", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499307450_1366994264599242_9185569319492547644_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2hfJJKgsFMcQ7kNvwEdldnH&_nc_oc=AdrmO0qKd6_Z5SUJCU8xoyxq8JkeKmoQpIHzZbZnpz6zQ2NPHb_zz452ruD2fCi7Xtc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af50MiSZrqrP-T4m3_aksGKnXMTxKhR80P1aPEL96-_5-Q&oe=6A071E7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TissueGnomics and ConfocalVR.png", "id": "1000799194657373", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974859_1000799197990706_5369854154150475545_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KIZITndwXYkQ7kNvwFbqo45&_nc_oc=Adr97BvyS8QBLvZMImnavGM3jOMJSLNJZcTh-09SNzoA94wcDeTDoOm8oduwmvWtkG0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Sp8BjQnntORfEYKfqojNGseSyTspPyklK00CGGNNn_A&oe=6A070D61"}, "display_name": "FlowGateVR", "keywords": [], "long_description": "**FlowGateVR** \u2014 from Immersive Science.\n\nA voice-driven VR tool for exploring multichannel flow cytometry data on Meta Quest.\n\n**AI Assistant**\n- Ask questions about your loaded dataset by speaking naturally\n- Query marker distributions, population statistics, and gating results\n- Get answers tuned for biomedical researchers \u2014 not generic AI\n- AI features improve automatically with no app update required\n\n**3D visualization**\n- Map any markers to X, Y, and Z axes (e.g., CD4 vs CD8 vs CD3)\n- Switch axis assignments on the fly to explore different marker combinations\n- Scatter, forward scatter, side scatter, fluorescent markers \u2014 all mappable\n- Visualize tSNE or UMAP dimensionality reduction alongside original markers\n\n**Multidimensional gating**\n- Draw 3D gates to select cell populations\n- Apply multiple gates with distinct colors\n- Switch axes with gates preserved \u2014 refine populations across marker spaces\n- Export gated subsets as CSV for follow-up analysis\n\n**Your data, your way**\n- Import compensated event CSV files (exported from FlowJo or similar)\n- Side-load datasets via Meta Link, headset browser, or SideQuest\n- Compatible with CyTOF and spectral cytometry data in CSV format\n\n**Collaboration**\n- Shared VR sessions with voice communication\n- Co-navigate the same dataset in real time\n\nDesigned for immunologists, cell biologists, and cytometry core facility researchers.\n\n**Need more performance?** A Windows desktop version is available for very large datasets. Contact support@immsci.com for details.\n", "short_description": "Explore flow cytometry data in immersive 3D with AI-assisted analysis. Map markers to axes, gate populations, and export findings. Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26098347426515303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/499618102_1601333577590645_7716511477880620330_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fVjxf7h5LI0Q7kNvwE8JY44&_nc_oc=AdofqYEmMEBLznh2-RJGHF0P0UOWleRNS7Nb_kku6J_f5ucX6J_EL_EQYvJ_u2YLv64&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7xvNAtq3AUfqGf2SSwrjp0oy9I6UGkfC4sN-AlRzo91g&oe=6A07326A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FlowGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"t
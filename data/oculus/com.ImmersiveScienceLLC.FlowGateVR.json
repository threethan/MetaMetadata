h=00_AfxDiXDLm0Kt2M9UultMq5lHpNiYTato2-em1CCVHSzz2A&oe=69D100BA"}, {"file_name": "Screenshot 2024-11-06 at 10.42.50\u202fPM-3.png", "id": "957207056236521", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974647_957207059569854_4724447921387146542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6h0NTRxw1-AQ7kNvwF8kox6&_nc_oc=AdodGKw-rqnAq99dUtlwIHP_9s-4Urx6RHFYl14qS4BSzcD8t9kPr_rqGhXgk8IroNk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxkiA8L6atI91D-4r13qyFOXcBN13W_W9AlXKJNy7jwaQ&oe=69D11361"}, {"file_name": "Screenshot 2024-11-06 at 10.43.16\u202fPM.png", "id": "945779820725681", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982519_945779824059014_5487990987730440173_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ucjxxI_T4uEQ7kNvwE_0DLb&_nc_oc=AdpKldsO7TrusgJmeDXZ1veMWLeRz56AfhURPahsBF1TuJbhdDm_R7jefx0q_jY5jFs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwFyI81n_B7-XyFi9z8wpKIEqow2omDLMsjMb7JzylJGw&oe=69D1092B"}, {"file_name": "ScreenShot_For_App_Store_2560x1440_FlowGateVR.png", "id": "2615283935336972", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499304106_2615283945336971_2045992492782396642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J7Q9JxA3xfEQ7kNvwG7Ur4R&_nc_oc=AdqmGdkyeTmcLh2UMJlUP44rOHDVgscvFMcW0x4qAvUNG8oDKa4JQH_lO46Jybr3sZ4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzV-y7qDnLUhRNuC5FZPQwO8yKz2moFc0x-2TMaZemiCg&oe=69D0F21A"}, {"file_name": "ScreenShot_2_For_App_Store_2560x1440_FlowGateVR.png", "id": "1366994261265909", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499307450_1366994264599242_9185569319492547644_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ztV5erEPweUQ7kNvwG3rbkQ&_nc_oc=AdoNGtAVxcs7zJ2kAswUP5HQ_zBWrWuL0AR_c7XeXtWYkt5J2fO7pD_UtPH_LGVkqeY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzAYd2-pCTl09yGLIr_XydrFrpyWUdrkbiq2oWc_MDAOw&oe=69D110FD"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TissueGnomics and ConfocalVR.png", "id": "1000799194657373", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974859_1000799197990706_5369854154150475545_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t4CIvy1ij2AQ7kNvwEdApQd&_nc_oc=Adq_HWRlJ0b-IlEuz9kmRzkLDLGTB4WSznu4ZibI7rnEzp_PW6Ylme8eiWgbN9nn6Zo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2y-jPIDZfKPSDfEbp55gUo8RVwPfcO_wwDaBQ-AR2aQ&oe=69D0FFE1"}, "display_name": "FlowGateVR", "keywords": [], "long_description": "**FlowGateVR** \u2014 from Immersive Science.\n\nA voice-driven VR tool for exploring multichannel flow cytometry data on Meta Quest.\n\n**AI Assistant**\n- Ask questions about your loaded dataset by speaking naturally\n- Query marker distributions, population statistics, and gating results\n- Get answers tuned for biomedical researchers \u2014 not generic AI\n- AI features improve automatically with no app update required\n\n**3D visualization**\n- Map any markers to X, Y, and Z axes (e.g., CD4 vs CD8 vs CD3)\n- Switch axis assignments on the fly to explore different marker combinations\n- Scatter, forward scatter, side scatter, fluorescent markers \u2014 all mappable\n- Visualize tSNE or UMAP dimensionality reduction alongside original markers\n\n**Multidimensional gating**\n- Draw 3D gates to select cell populations\n- Apply multiple gates with distinct colors\n- Switch axes with gates preserved \u2014 refine populations across marker spaces\n- Export gated subsets as CSV for follow-up analysis\n\n**Your data, your way**\n- Import compensated event CSV files (exported from FlowJo or similar)\n- Side-load datasets via Meta Link, headset browser, or SideQuest\n- Compatible with CyTOF and spectral cytometry data in CSV format\n\n**Collaboration**\n- Shared VR sessions with voice communication\n- Co-navigate the same dataset in real time\n\nDesigned for immunologists, cell biologists, and cytometry core facility researchers.\n\n**Need more performance?** A Windows desktop version is available for very large datasets. Contact support@immsci.com for details.\n", "short_description": "Explore flow cytometry data in immersive 3D with AI-assisted analysis. Map markers to axes, gate populations, and export findings. Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26098347426515303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499618102_1601333577590645_7716511477880620330_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DROVeEuVr8QQ7kNvwG2vVwY&_nc_oc=AdonBqVfVq1m6NY4dKuKCQhzDRdO5VqFrBK-GGTy6Rgy0YCaq36H-alZGknsTwHIQoI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afzb_ojjnV1Dw_2ln0lxwjaldgcuqg_AH9qWb6weUSVBNg&oe=69D124EA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FlowGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"t
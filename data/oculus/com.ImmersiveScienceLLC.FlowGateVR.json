h=00_Af_SOgk4Jtrb7NN61wIziOa5_GUbUycz1oXBZ_Vp2PvXXA&oe=6A2E9B3A"}, {"file_name": "Screenshot 2024-11-06 at 10.42.50\u202fPM-3.png", "id": "957207056236521", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974647_957207059569854_4724447921387146542_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d9JJ_-IWKe4Q7kNvwGWGZAW&_nc_oc=Ado1FCugShXToK9tZhUWJ77kbADldtXvnRVGo1r9kHhiO6EEcmaTK7yRDyJCAihHznE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wN_6LH2fPqn4YQTqu_xPOcvThMg7Dh_0XQAstK5Rp_Q&oe=6A2EADE1"}, {"file_name": "Screenshot 2024-11-06 at 10.43.16\u202fPM.png", "id": "945779820725681", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982519_945779824059014_5487990987730440173_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MTi0C630-1cQ7kNvwFRKo3T&_nc_oc=AdoCefpfdtrHwrK1MAczXgKm5NxY24HK6CVzw1An4BvXVzUA8qC5D-xIYBHoLon5Fuc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tf8QsQPPlBlnRpX3t7eg9KE669IUNEWwTwLQQJjnMuQ&oe=6A2EA3AB"}, {"file_name": "ScreenShot_For_App_Store_2560x1440_FlowGateVR.png", "id": "2615283935336972", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499304106_2615283945336971_2045992492782396642_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSDKgWvPgmMQ7kNvwGQg5CU&_nc_oc=AdrUOccA49xKNiabeXzhXUQafrDESAfg_zZ9pQBtvwoH_PMLmpAyEJJsF_aN--Qi38U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9F0v7DW-oUFvTeyU_jhS_sPZl860p9sKfJJ0VXb2_BeQ&oe=6A2EC4DA"}, {"file_name": "ScreenShot_2_For_App_Store_2560x1440_FlowGateVR.png", "id": "1366994261265909", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499307450_1366994264599242_9185569319492547644_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Je-nUPK_MvkQ7kNvwFw2CZU&_nc_oc=AdrUKWWYt8j_9jN7WLAA-wWcO-NfIJsJ6y731LtJfkG68gEoC2d0hUMYVI-lMNxQqYw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-K4XLu9SeVYGXPB6D6Z8mDHnd8GCBl7MJYC9PTcrC5Uw&oe=6A2EAB7D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TissueGnomics and ConfocalVR.png", "id": "1000799194657373", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974859_1000799197990706_5369854154150475545_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z_CTvLYizGwQ7kNvwE0CCLU&_nc_oc=AdrRdkT1nEIpLeY6XvzP_dd2Z0FPVaFXEmfDbKqFYCtpi7DX4R7_Tr9F9Y1gFU9qV5k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_sJP_c32Uz1a8htoJ1xfso5pLUDQrsHrb1j76nZE0gpg&oe=6A2ED2A1"}, "display_name": "FlowGateVR", "keywords": [], "long_description": "**FlowGateVR** \u2014 from Immersive Science.\n\nA voice-driven VR tool for exploring multichannel flow cytometry data on Meta Quest.\n\n**AI Assistant**\n- Ask questions about your loaded dataset by speaking naturally\n- Query marker distributions, population statistics, and gating results\n- Get answers tuned for biomedical researchers \u2014 not generic AI\n- AI features improve automatically with no app update required\n\n**3D visualization**\n- Map any markers to X, Y, and Z axes (e.g., CD4 vs CD8 vs CD3)\n- Switch axis assignments on the fly to explore different marker combinations\n- Scatter, forward scatter, side scatter, fluorescent markers \u2014 all mappable\n- Visualize tSNE or UMAP dimensionality reduction alongside original markers\n\n**Multidimensional gating**\n- Draw 3D gates to select cell populations\n- Apply multiple gates with distinct colors\n- Switch axes with gates preserved \u2014 refine populations across marker spaces\n- Export gated subsets as CSV for follow-up analysis\n\n**Your data, your way**\n- Import compensated event CSV files (exported from FlowJo or similar)\n- Side-load datasets via Meta Link, headset browser, or SideQuest\n- Compatible with CyTOF and spectral cytometry data in CSV format\n\n**Collaboration**\n- Shared VR sessions with voice communication\n- Co-navigate the same dataset in real time\n\nDesigned for immunologists, cell biologists, and cytometry core facility researchers.\n\n**Need more performance?** A Windows desktop version is available for very large datasets. Contact support@immsci.com for details.\n", "short_description": "Explore flow cytometry data in immersive 3D with AI-assisted analysis. Map markers to axes, gate populations, and export findings. Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26098347426515303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499618102_1601333577590645_7716511477880620330_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYEGVZyPoOYQ7kNvwEJ8DYn&_nc_oc=AdoAM57Mh69SNSg-Af3E5ZNBZrtgipWkNE9LY1BHw7BjRj0t6NJLmSbudZjeP7Fxl3A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-HneXUNLg0G40zFJNIfCZe7M_SP4saUWW8YgEq_3SApQ&oe=6A2EBF6A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FlowGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_category": "APPS", "id": "362692211442873"}, "context_topics": [{"topic_name": "Hands-On Training", "id": "514087707868786"}, {"t
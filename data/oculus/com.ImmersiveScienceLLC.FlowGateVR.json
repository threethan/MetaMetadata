m&_nc_ss=7f20f&oh=00_AQSuobxlPG0Hz-zuQVOvUPGFY0lz-rqPv4PCbP9RYmLXPA&oe=6AF0B03D"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TissueGnomics and ConfocalVR.png", "id": "1000799194657373", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974859_1000799197990706_5369854154150475545_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wtBNgPJCUA4Q7kNvwFEsN7A&_nc_oc=AdrT5iE-Qt3mwTLWxBgU9qw72OLd4NZ-kgbE6R9zzloRz9_TWdGCYyYhc5AQRBZpUqM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQThhl0Rsn-B2G0SeHgYJmJhFuu6_AuhTMY7Mfe6J_mZzQ&oe=6AF09F21"}, "display_name": "FlowGateVR", "keywords": [], "long_description": "**FlowGateVR** \u2014 from Immersive Science.\n\nA voice-driven VR tool for exploring multichannel flow cytometry data on Meta Quest.\n\n**AI Assistant**\n- Ask questions about your loaded dataset by speaking naturally\n- Query marker distributions, population statistics, and gating results\n- Get answers tuned for biomedical researchers \u2014 not generic AI\n- AI features improve automatically with no app update required\n\n**3D visualization**\n- Map any markers to X, Y, and Z axes (e.g., CD4 vs CD8 vs CD3)\n- Switch axis assignments on the fly to explore different marker combinations\n- Scatter, forward scatter, side scatter, fluorescent markers \u2014 all mappable\n- Visualize tSNE or UMAP dimensionality reduction alongside original markers\n\n**Multidimensional gating**\n- Draw 3D gates to select cell populations\n- Apply multiple gates with distinct colors\n- Switch axes with gates preserved \u2014 refine populations across marker spaces\n- Export gated subsets as CSV for follow-up analysis\n\n**Your data, your way**\n- Import compensated event CSV files (exported from FlowJo or similar)\n- Side-load datasets via Meta Link, headset browser, or SideQuest\n- Compatible with CyTOF and spectral cytometry data in CSV format\n\n**Collaboration**\n- Shared VR sessions with voice communication\n- Co-navigate the same dataset in real time\n\nDesigned for immunologists, cell biologists, and cytometry core facility researchers.\n\n**Need more performance?** A Windows desktop version is available for very large datasets. Contact support@immsci.com for details.\n", "short_description": "Explore flow cytometry data in immersive 3D with AI-assisted analysis. Map markers to axes, gate populations, and export findings. Meta Quest."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.immsci.com/privacy-policy/", "developer_terms_of_service_url": null, "publisher_name": "Immersive Science LLC", "support_website_url": null, "website_url": "https://www.immsci.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "26098347426515303"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499618102_1601333577590645_7716511477880620330_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DUqvoZyfUEQQ7kNvwHGxetM&_nc_oc=AdrLxA_OEWRK6Izndo8l_pdsG9zUGSak7muSRbMRjSA-zNoIFsBNUplei8f4k5stP5U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQStpTgjARPqgMsast0dHZqhL4B5umaTcS9gSJogmf2N5A&oe=6AF08BEA"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "FlowGateVR", "platform": "ANDROID_6DOF", "context_category": {"context_cat
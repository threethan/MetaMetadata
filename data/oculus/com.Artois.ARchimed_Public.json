=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXGbuWtv_CzUW9Fzp1Pm5X1yyZBmlHm8UnGtknz9__BcQ&oe=6B10621B"}, {"file_name": "Screenshot2_1.png", "id": "1429219711501534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507828589_1429219714834867_8750141787877018572_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9xkbpIh3YH4Q7kNvwFsk-cN&_nc_oc=Ado7p2QN5pHcQKSD_-ZInpuqKGwOZjCUUrPx3M0aOPTQ8qcIxHIQlZyMzt9I_26KKjQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX9-hntBL5OnooemXxnj92xRUSoufia36Syic7-3_q9sA&oe=6B1035C1"}, {"file_name": "Screenshot2_5.png", "id": "795568763333147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_795568766666480_8662038910664187859_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hovHlIOxkS0Q7kNvwERBn24&_nc_oc=AdopNdcIQDrFRc5QJTQrC8oeYtWFjEQZaVI4pftLRzbd6Hdt-iadlj87E3IF0Q4L39g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUz-KkrOLgb9ODAYlj6lqNWaOTI0VSCKjjo4wjqDU6eLQ&oe=6B105736"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ARChimed - MolSym", "keywords": ["molecular", "symmetry", "molecule", "chemistry"], "long_description": "ARCHIMED - MolSym is an educational application designed to make the analysis and visualization of molecular symmetry accessible to everyone. It allows users to explore point groups, symmetry operations, and molecular structures interactively. Featuring real-time 3D visualization, ARCHIMED - MolSym provides a modern and intuitive tool, ideally suited for learning about symmetry in chemistry.\n", "short_description": "ARChimEd - MolSym (Augmented Reality for Chimie and Education \u2013 Molecular Symmetry) is a mixed-reality educational application designed for the Meta Quest platform. It allows users to explore symmetry operations and point groups through interactive and gamified modules."}]}, "developer_name": "VRAI Learning", "developer_privacy_policy_u
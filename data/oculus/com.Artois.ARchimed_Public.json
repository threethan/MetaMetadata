5771-25/507828589_1429219714834867_8750141787877018572_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NjETmGlSEDMQ7kNvwEVyoRS&_nc_oc=AdrmbzZh5IVmeTH2531_V_LZ2eSAmAI3C2EskT1a-YKUZigOj5Qxs0O-ZeHaPgHGueg&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zfbhaNnvu-jDcmiA2Cm2KWuaiYSNv_b46WCG9QfaY6g&oe=6A243941"}, {"file_name": "Screenshot2_5.png", "id": "795568763333147", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491830613_795568766666480_8662038910664187859_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=il9PoLVjvowQ7kNvwEBYQ_4&_nc_oc=Ado_kc_dID1hO5Yg_z62zS1-mwibn7WznxkHTaMmodoydRPWkXxE8wuxo60UvDxIVaQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8VF1Nka4_AUaeKc27soBy0wtekMsR2q2er3KJi1tEwNw&oe=6A242276"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ARChimed - MolSym", "keywords": ["molecular", "symmetry", "molecule", "chemistry"], "long_description": "ARCHIMED - MolSym is an educational application designed to make the analysis and visualization of molecular symmetry accessible to everyone. It allows users to explore point groups, symmetry operations, and molecular structures interactively. Featuring real-time 3D visualization, ARCHIMED - MolSym provides a modern and intuitive tool, ideally suited for learning about symmetry in chemistry.\n", "short_description": "ARChimEd - MolSym (Augmented Reality for Chimie and Education \u2013 Molecular Symmetry) is a mixed-reality educational application designed for the Meta Quest platform. It allows users to explore symmetry operations and point groups through interactive and gamified modules."}]}, "developer_name": "VRAI Learning", "developer_privacy_policy_url": "https://vrailearning.com/en/legal", "developer_terms_of_service_url": null, "publisher_name": "Univ Artois", "support_website_url": null, "website_url": "https://www.vrailearning.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQX6XYeBU9utYNot1KyHSaoZUOBC-L40h5jhs5VK82aRYA&oe=6B0F109B"}, {"file_name": "Screenshot2_1.png", "id": "1429219711501534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507828589_1429219714834867_8750141787877018572_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Va9PE3pgt-AQ7kNvwEb_dLh&_nc_oc=AdrApEQUURLyGgKZ2Uq_WvNy5YtNUeNuuzLyVH3d_jF1kXETuGvQjYykn9H0-WuG80E&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUKxsgfudynOG66YIi9D3k6gsyY9JvJF76AyIvRoVNigw&oe=6B0F1C81"}, {"file_name": "Screenshot2_5.png", "id": "795568763333147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_795568766666480_8662038910664187859_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hovHlIOxkS0Q7kNvwFgwsyv&_nc_oc=Adqi9grAp8zKjMqN-LYxc_UzJ8sI2EHsQ0DjtoId5h7tbr3vUMZwGmWte7EF0k6GZEw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQXJDzlT1iTq3iYaOQwcqvHMimnQixds8QzO42JEGGGAyw&oe=6B0F05B6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ARChimed - MolSym", "keywords": ["molecular", "symmetry", "molecule", "chemistry"], "long_description": "ARCHIMED - MolSym is an educational application designed to make the analysis and visualization of molecular symmetry accessible to everyone. It allows users to explore point groups, symmetry operations, and molecular structures interactively. Featuring real-time 3D visualization, ARCHIMED - MolSym provides a modern and intuitive tool, ideally suited for learning about symmetry in chemistry.\n", "short_description": "ARChimEd - MolSym (Augmented Reality for Chimie and Education \u2013 Molecular Symmetry) is a mixed-reality educational application designed for the Meta Quest platform. It allows users to explore symmetry operations and point groups through interactive and gamified modules."}]}, "developer_name": "VRAI Learning", "developer_privacy_policy_u
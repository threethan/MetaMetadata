5771-25/507828589_1429219714834867_8750141787877018572_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4z2p8qvruc0Q7kNvwE1BYqP&_nc_oc=AdppWfnYpKlJw2o1LwOwBGeszwPF_TWcaLeWRvev2W1PWZOiP-iwUd6-cxDYGo3n9WI&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDqMAvvtN92nmX-hI9smUPS_2cX_BAbLRVZo8k9NGDFGg&oe=6A6DD501"}, {"file_name": "Screenshot2_5.png", "id": "795568763333147", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491830613_795568766666480_8662038910664187859_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=joonqvck9l8Q7kNvwEMR93K&_nc_oc=AdpIhBG6IAa7OJGUfBoH1bywNT4kRy1rhCX3eR_qWRE5guZnYbuqJFbRWaGxt3nA714&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCK4spT8Ol-ClXtjBKnenV5Or7SVFfqWNCWD_y8fZUx5A&oe=6A6DF676"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ARChimed - MolSym", "keywords": ["molecular", "symmetry", "molecule", "chemistry"], "long_description": "ARCHIMED - MolSym is an educational application designed to make the analysis and visualization of molecular symmetry accessible to everyone. It allows users to explore point groups, symmetry operations, and molecular structures interactively. Featuring real-time 3D visualization, ARCHIMED - MolSym provides a modern and intuitive tool, ideally suited for learning about symmetry in chemistry.\n", "short_description": "ARChimEd - MolSym (Augmented Reality for Chimie and Education \u2013 Molecular Symmetry) is a mixed-reality educational application designed for the Meta Quest platform. It allows users to explore symmetry operations and point groups through interactive and gamified modules."}]}, "developer_name": "VRAI Learning", "developer_privacy_policy_url": "https://vrailearning.com/en/legal", "developer_terms_of_service_url": null, "publisher_name": "Univ Artois", "support_website_url": null, "website_url": "https://www.vrailearning.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_categ
=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSPhCuMr684lPgKHyBSRVLQ7YY-724yMpGBROmSGy3duw&oe=6B07279B"}, {"file_name": "Screenshot2_1.png", "id": "1429219711501534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507828589_1429219714834867_8750141787877018572_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-i_D00l4YAQ7kNvwGLTz0a&_nc_oc=Adr8j4wrZEjO4zyL7-JG-eIqIK09D6o3T6U4q1u-smd5mbp0tJf9gS_Rp1INRm4x12M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSQGME0oyeXmXHN-zFOIGQXJCn5ayt5Kerl7_Rz38rzDw&oe=6B06FB41"}, {"file_name": "Screenshot2_5.png", "id": "795568763333147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_795568766666480_8662038910664187859_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sh9mu64ou7EQ7kNvwGpLX9c&_nc_oc=Adrm0fzfRAuUC6SwCNjg2Ou642xwddWZZ4SzFZt8v6RUnXJ6AMo8-DH_qlsWG4Ofl0g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP-PAOihE8P9-lbC4i5zl2nGBkifRCu8rlsjXroFGyoQ&oe=6B071CB6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ARChimed - MolSym", "keywords": ["molecular", "symmetry", "molecule", "chemistry"], "long_description": "ARCHIMED - MolSym is an educational application designed to make the analysis and visualization of molecular symmetry accessible to everyone. It allows users to explore point groups, symmetry operations, and molecular structures interactively. Featuring real-time 3D visualization, ARCHIMED - MolSym provides a modern and intuitive tool, ideally suited for learning about symmetry in chemistry.\n", "short_description": "ARChimEd - MolSym (Augmented Reality for Chimie and Education \u2013 Molecular Symmetry) is a mixed-reality educational application designed for the Meta Quest platform. It allows users to explore symmetry operations and point groups through interactive and gamified modules."}]}, "developer_name": "VRAI Learning", "developer_privacy_policy_u
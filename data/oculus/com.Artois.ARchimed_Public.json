=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRobknZSutNinQsOIV3oBJJrEJcX5Osnlt3xeSqMWHMxA&oe=6B05D61B"}, {"file_name": "Screenshot2_1.png", "id": "1429219711501534", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507828589_1429219714834867_8750141787877018572_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X-i_D00l4YAQ7kNvwFzFY53&_nc_oc=AdobH1QUlheXHvzSEz3V9KXsO1pqbwODclGbP4wL7zB-yGSEphfP9UPHygQqvQaAOKM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSeuyGJ4ZGhM6kxpeLLMXM5ESPj14hcfh-E6bQVjFUf_A&oe=6B05A9C1"}, {"file_name": "Screenshot2_5.png", "id": "795568763333147", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491830613_795568766666480_8662038910664187859_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GQ1GPTjakTEQ7kNvwGI0g4I&_nc_oc=AdrrPNFdbxs6eQNBS8Yojm4uOs0Tfbll8cHhpyoEp1ygV1Fq0ToG4dwDvQtYB2w1tZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQK1fZidphDIUKzOH-S9fYehj8W28dM22-oDWKwXbz2uA&oe=6B05CB36"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ARChimed - MolSym", "keywords": ["molecular", "symmetry", "molecule", "chemistry"], "long_description": "ARCHIMED - MolSym is an educational application designed to make the analysis and visualization of molecular symmetry accessible to everyone. It allows users to explore point groups, symmetry operations, and molecular structures interactively. Featuring real-time 3D visualization, ARCHIMED - MolSym provides a modern and intuitive tool, ideally suited for learning about symmetry in chemistry.\n", "short_description": "ARChimEd - MolSym (Augmented Reality for Chimie and Education \u2013 Molecular Symmetry) is a mixed-reality educational application designed for the Meta Quest platform. It allows users to explore symmetry operations and point groups through interactive and gamified modules."}]}, "developer_name": "VRAI Learning", "developer_privacy_policy_u
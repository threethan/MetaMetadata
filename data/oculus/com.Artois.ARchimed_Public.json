=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQQsJmNrO3wadGPZT5IVS8VROX9nRmq3JVdqVY6QqfKE1g&oe=6B0DBF1B"}, {"file_name": "Screenshot2_1.png", "id": "1429219711501534", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/507828589_1429219714834867_8750141787877018572_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Va9PE3pgt-AQ7kNvwEnlfV-&_nc_oc=AdpLMa5bFqJklaL0lLdlcdqmJrTOKKf1A70F-wHQzYrwtWZQnz98DvbYKGvRt5Ms4E4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQS9gTcXx3cZT0wQ86IA6pd89wnGOmGvu4j7VYIqKFwmbQ&oe=6B0DCB01"}, {"file_name": "Screenshot2_5.png", "id": "795568763333147", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491830613_795568766666480_8662038910664187859_n.png?_nc_cat=107&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5-3XNQpjjJMQ7kNvwH5aH4o&_nc_oc=AdpFVT6nM7Hfa-Galqbsmc6gno_e2jDMmVwUAe9SUTyIhbuHJdPRNkdPYRhqeMsxLTc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRAMXhR6zNj3-DvIvQoEuHfHYo2S6AChy41IyEXosMXzQ&oe=6B0DB436"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "ARChimed - MolSym", "keywords": ["molecular", "symmetry", "molecule", "chemistry"], "long_description": "ARCHIMED - MolSym is an educational application designed to make the analysis and visualization of molecular symmetry accessible to everyone. It allows users to explore point groups, symmetry operations, and molecular structures interactively. Featuring real-time 3D visualization, ARCHIMED - MolSym provides a modern and intuitive tool, ideally suited for learning about symmetry in chemistry.\n", "short_description": "ARChimEd - MolSym (Augmented Reality for Chimie and Education \u2013 Molecular Symmetry) is a mixed-reality educational application designed for the Meta Quest platform. It allows users to explore symmetry operations and point groups through interactive and gamified modules."}]}, "developer_name": "VRAI Learning", "developer_privacy_policy_u
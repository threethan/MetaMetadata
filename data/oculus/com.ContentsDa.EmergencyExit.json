ps://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39036696_532243102994073_7179451583911156249_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XuFhkhcwXgsQ7kNvwE0OSzN&_nc_oc=AdkbAIhYvJdCc3d6XmAd9zfan313tf7_yGgh7aGejfiGiDZSZPkEKYor1pTttdCNqUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvTCqSlYiKWodU71UqiZuHixuEGMMg4Ii-IG86BO4mP5w&oe=699C3987"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Emergency Exit_Landscape.png", "id": "3689929394659385", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/39031482_3689929397992718_2801959339543772262_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dOFsmftrS60Q7kNvwHc3qgA&_nc_oc=AdmmQB275xqKZG8qqxA_YvmUJJ545F93Ms2gPsdN6IIB-kP2NTohzFemPvIfaz-UuC8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvzHuCV31dXobNsWoNNAfLeB2cXQQZOC4Tw0lQ9O1C3bA&oe=699C4E6A"}, "display_name": "Emergency Exit  - ContentsDa Science Experiment", "keywords": ["safety", "emergency", "exit", "simulation", "contentsda"], "long_description": "1. Identify exits: In multi-use facilities, identify the location of emergency exits.\n2. Respond quickly: Know the location of exits in advance so you can respond quickly to an emergency.\n3. Follow directions: In an emergency, follow nearby directions to the exit with the least amount of people.\n4. Go to the opposite exit: If you can't get out of an emergency exit, follow your teacher's directions to the opposite exit.\n5. Open the door: If the door is locked or won't open, you need to ask people around you for help to get out.\n6. Exit the simulation: Press the Next button to exit the simulation.", "short_description": "Learn the importance of quick and safe evacuation during emergencies. This simulation teaches the best practices for finding and using emergency exits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "
6e7a0a&_nc_ohc=0SJs4HFCr50Q7kNvwE8PQfU&_nc_oc=AdnTrAD3JRX8bcQT993QZvWd8NHzy4bk9tWlT_DgvkWmxhlji54WQe1j7sGlBUTTiDM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzkwscL8UON52g1mQKEu872iLNKCchaJ5sbYNr8Z_kWTw&oe=69BFD207"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Emergency Exit_Landscape.png", "id": "3689929394659385", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031482_3689929397992718_2801959339543772262_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mZJcwnpvVOEQ7kNvwFd7eLd&_nc_oc=AdmlScygBNcA7hgkK7Zd2eOg6KJ8eQR-5BdJbM0saXz6w25n0sZ8cl-1t8rNaYx29Nk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_Afz1Yig6R-AescmRPL8YlvFEyW2gvzDAiBqpFxpktz47Fg&oe=69BFE6EA"}, "display_name": "Emergency Exit  - ContentsDa Science Experiment", "keywords": ["safety", "emergency", "exit", "simulation", "contentsda"], "long_description": "1. Identify exits: In multi-use facilities, identify the location of emergency exits.\n2. Respond quickly: Know the location of exits in advance so you can respond quickly to an emergency.\n3. Follow directions: In an emergency, follow nearby directions to the exit with the least amount of people.\n4. Go to the opposite exit: If you can't get out of an emergency exit, follow your teacher's directions to the opposite exit.\n5. Open the door: If the door is locked or won't open, you need to ask people around you for help to get out.\n6. Exit the simulation: Press the Next button to exit the simulation.", "short_description": "Learn the importance of quick and safe evacuation during emergencies. This simulation teaches the best practices for finding and using emergency exits."}]}, "developer_name": null, "developer_privacy_policy_url": "https://training.contentsda.kr/privacy-policy-en/", "developer_terms_of_service_url": "https://training.contentsda.kr/terms-and-conditions-en/", "publisher_name": "ContentsDa Inc", "support_website_url": null, "website_url": "https://training.contentsda.kr
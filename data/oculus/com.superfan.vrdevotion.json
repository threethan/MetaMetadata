556289_4128217505788006643_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WLRv666PfkQ7kNvwHaTtd8&_nc_oc=AdkfSxqHiM-biVgN7p1cLCkgniz87C_GvKN7JJVvuVhMyHUug7nz97mp5_vTH1D4-TM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfswpLEfwT2OEgB6P66dMcx3_pss8mg8BXPaCPB8kJJK7Q&oe=699F0782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1650501399121341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974744_1650501402454674_7603330016418404631_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYGtMC3xewAQ7kNvwFN59TS&_nc_oc=AdnKw-AEG23wkUUEPyCoi55DFWxn8-evhje9N0h1ExphL8_2ZRWDLZspfiHl41MIfuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftujICQRh-OblzhhyiwLlu4h2huRUh6sqKTLEKgZTzfXA&oe=699EDF83"}, "display_name": "VR Devotion", "keywords": [], "long_description": "Immerse yourself in a transformative spiritual journey with the MR Devotional app. Designed for seekers of all faiths, this app seamlessly integrates immersive reality (MR) technology with timeless devotional practices. Step into serene virtual environments where you can engage in guided meditations, reflective readings, and interactive prayers.\n\nExperience the ancient wisdom of scriptures and teachings through interactive storytelling and visualizations that bring sacred texts to life. Customize your devotional experience with personalized prayer guides and daily affirmations tailored to your spiritual journey.\n\nWhether you seek solace, inspiration, or connection with a higher power, the MR Devotional app offers a unique blend of technology and spirituality to enhance your daily quest for meaning and fulfillment.", "short_description": "Devotional app in mixed reality to do all your prayer and offerings through your quest device"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superfan.studio/vrdevotionprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Superfan Studio", 
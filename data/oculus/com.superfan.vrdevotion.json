NvwGtOq3I&_nc_oc=Adljus5cQoAf7i41S6g1ZpKsXY1PIQIXow79m9HUNYwIrVpI88cJADPIeVyE6jk1ijw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsC5hvmh7sPiDyzE2WbwcDlMhXgO9v244v8k4x6Sl7kPQ&oe=69A2E55F"}, {"file_name": "5.png", "id": "686558720290232", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974613_686558723623565_4400456252456620611_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SBEmCVl-SbUQ7kNvwEd3ByK&_nc_oc=Adn05Sj7_E2Dhm2vCIlmpmLAEtx8VbQhOiXmv6eg3bQmDftiDqWloDLwYU5FC705qQ8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftG51s1JV09Z53KDExamRggFm_u0pKJuraR7x3RKOvZfg&oe=69A2DF2D"}, {"file_name": "1.png", "id": "1649118059222956", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982550_1649118062556289_4128217505788006643_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iNu6KH2VS3AQ7kNvwEaTJjC&_nc_oc=AdlKHxcU2A02aavGIflZuEpVRqWAlZeGKF7nfBSEhdsgjNfNcZueW5AaWQaCHhLfLlI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvDTXb6-hAxogp1yW3FD7P5QqBDiqaHCL8eKa0ndKMKOQ&oe=69A2FC02"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1650501399121341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974744_1650501402454674_7603330016418404631_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GICeYuMuDXoQ7kNvwEFKgqe&_nc_oc=AdmhDsbYU2Uby2gA9jl1WNU68S9q8bhfv4nOwqbkUf4Zi6uKNV7oAI66cuPgdiXcl0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvzEzooA0z7Drekv8xTLtLMzp9eickzlDBW45fIBF0Huw&oe=69A2D403"}, "display_name": "VR Devotion", "keywords": [], "long_description": "Update :Fixed Instructions\n\nImmerse yourself in a transformative spiritual journey with the MR Devotional app. Designed for seekers of all faiths, this app seamlessly integrates immersive reality (MR) technology with timeless devotional practices. Step into serene virtual environments where you can engage in guided meditations, reflective readings, and interactive prayers.\n\nExperience the ancient wisdom of scriptures and teachings through interactive storytelling and visualizations that bring sacred texts to life. Customize your devotional experience with personalized prayer guides and daily affirmations tailored to your spiritual journey.\n\nWhether you seek solace, inspiration, or connection with a higher power, the MR Devotional app offers a unique blend of technology and spirituality to enhance your daily quest for meaning and fulfillment.", "short_description": "Devotional app in mixed reality to do all your prayer and offerings through your quest device"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superfan.studio/vrdevotionprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Superfan Studio", "support_website_url": null, "website_url": "https://superfan.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7361627133960902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39035413_1213333253157775_572045307487708024_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GmsjWCXm1osQ7kNvwGH-05y&_nc_oc=AdlaaUx4-pdfxWkhb6TYQ2CDYLMLez5h6RR4OhZsnxf_2yM67y_oXvkWXGGfVjZ4Jtc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv2qLpLlpfJ6URTBBSHDTUzF8K1UiFzYfR65uFyfWw1OA&oe=69A2E3BA"}
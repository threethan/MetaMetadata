NvwF6w1q_&_nc_oc=AdmWfy2Cmeiol17_bAyPxQYu2wGTgMh9flpdISddc_DkznyalFmTWkyNpq4kBUGKbn8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftIKGaxp14cGJGEzh0XL-5L7qLoRD-2DQztyEZAO_9S8w&oe=699EF0DF"}, {"file_name": "5.png", "id": "686558720290232", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974613_686558723623565_4400456252456620611_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HKqcgWTVZBoQ7kNvwG-7hZu&_nc_oc=AdmJwYQLneeXFPEv6vg4z0wBsm-8lGhOHCONFQbSjjgMD2k8XhgGS4dxWhodIa8fumA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsoTm7Ku8aD0NWGANdOvY53SzrI78wLtqfH9OVL9_W2Ww&oe=699EEAAD"}, {"file_name": "1.png", "id": "1649118059222956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982550_1649118062556289_4128217505788006643_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8WLRv666PfkQ7kNvwHaTtd8&_nc_oc=AdkfSxqHiM-biVgN7p1cLCkgniz87C_GvKN7JJVvuVhMyHUug7nz97mp5_vTH1D4-TM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfswpLEfwT2OEgB6P66dMcx3_pss8mg8BXPaCPB8kJJK7Q&oe=699F0782"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1650501399121341", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974744_1650501402454674_7603330016418404631_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bYGtMC3xewAQ7kNvwFN59TS&_nc_oc=AdnKw-AEG23wkUUEPyCoi55DFWxn8-evhje9N0h1ExphL8_2ZRWDLZspfiHl41MIfuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftujICQRh-OblzhhyiwLlu4h2huRUh6sqKTLEKgZTzfXA&oe=699EDF83"}, "display_name": "VR Devotion", "keywords": [], "long_description": "Update :Fixed Instructions\n\nImmerse yourself in a transformative spiritual journey with the MR Devotional app. Designed for seekers of all faiths, this app seamlessly integrates immersive reality (MR) technology with timeless devotional practices. Step into serene virtual environments where you can engage in guided meditations, reflective readings, and interactive prayers.\n\nExperience the ancient wisdom of scriptures and teachings through interactive storytelling and visualizations that bring sacred texts to life. Customize your devotional experience with personalized prayer guides and daily affirmations tailored to your spiritual journey.\n\nWhether you seek solace, inspiration, or connection with a higher power, the MR Devotional app offers a unique blend of technology and spirituality to enhance your daily quest for meaning and fulfillment.", "short_description": "Devotional app in mixed reality to do all your prayer and offerings through your quest device"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superfan.studio/vrdevotionprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Superfan Studio", "support_website_url": null, "website_url": "https://superfan.studio/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7361627133960902"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39035413_1213333253157775_572045307487708024_n.png?stp=dst-png_s360x360&_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jSAnM8l1X6QQ7kNvwHjT7zN&_nc_oc=AdlIHdBKmyQUUn0hv6s-9HJzJ7kLkfEgN8HI7epXnKwSlQhGYOSAbMEAQ2QkI41LFIk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AftBDYhQQ7b_w8rUNfUca-5-KldC2fytwQeuXkC1FT2d5A&oe=699EEF3A"}
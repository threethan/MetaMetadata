556289_4128217505788006643_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jcV4hiJtn0MQ7kNvwFG3Ume&_nc_oc=AdkcQYqS6MBnJGbPZozAebpy-00KcmlVzzT0Q57NUsixq4Rp6wqEaIjGd_abKsd-pmw&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuQxX2wYWk2y72KhVY60BZ3rC5X8YWyjO0fgAMwaxUUmw&oe=699DB602"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1650501399121341", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974744_1650501402454674_7603330016418404631_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X1s37Q8FEK8Q7kNvwFY1qzR&_nc_oc=Adko1kOFkC_MAk3bZJmxbPH83aSrdRiviCpndNlT-ob-jpweOVTaT31nkwA9zJ2P4ks&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfuqW07RrSvGRyRwCljcgeKBow7-4LYKZEv3IBygvL7bsA&oe=699D8E03"}, "display_name": "VR Devotion", "keywords": [], "long_description": "Immerse yourself in a transformative spiritual journey with the MR Devotional app. Designed for seekers of all faiths, this app seamlessly integrates immersive reality (MR) technology with timeless devotional practices. Step into serene virtual environments where you can engage in guided meditations, reflective readings, and interactive prayers.\n\nExperience the ancient wisdom of scriptures and teachings through interactive storytelling and visualizations that bring sacred texts to life. Customize your devotional experience with personalized prayer guides and daily affirmations tailored to your spiritual journey.\n\nWhether you seek solace, inspiration, or connection with a higher power, the MR Devotional app offers a unique blend of technology and spirituality to enhance your daily quest for meaning and fulfillment.", "short_description": "Devotional app in mixed reality to do all your prayer and offerings through your quest device"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.superfan.studio/vrdevotionprivacypolicy", "developer_terms_of_service_url": null, "publisher_name": "Superfan Studio", 
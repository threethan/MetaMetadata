-nplfQe8lvKmW0d9-TU1f9px8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRCyJBVisvalClg_GNsf-Yvl9MwlLyVvqIUkFn10VhMoQ&oe=6AF741BE"}, {"file_name": "New Project (14).png", "id": "2126756124604638", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673531334_2126756131271304_383288057864305701_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ui-lpgZkA3oQ7kNvwFYTXOh&_nc_oc=AdqcTmPp5Xio8iKhK8hngRJrwRmF_6sRcNQVbrhsGCYCeN9Kas4y6G0-E6hgqapDgSo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTTmjt1C8Q_KS8FqamOv3jKePq87aP76BhV4J9dcNA-6g&oe=6AF734B4"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Club Life VR", "keywords": ["bar", "nightclub", "darts", "party", "simulator"], "long_description": "Welcome to Club Life VR \u2014 your own bar and nightclub, in virtual reality.\n\nPull up a stool and order from a real drinks menu, from a $2 water to a $10 cocktail, then feel the room start to sway as it hits you. Challenge the house at darts, beer pong, dice, spin-the-bottle, and coin toss \u2014 every game plays for real in-game cash, so you can win big or drink your winnings away.\n\nEverything is hands-on: grab bottles and pour, throw a glass, rack up the beer pong cups, spin the bottle across the table, and feel the crowd and the music around you.\n\nFeatures:\n\u2022 A working bar with a real drinks menu and a drunk effect that builds with every round\n\u2022 Five stakes-based minigames: darts, beer pong, dice, spin the bottle, and coin toss\n\u2022 Full hands-on interaction \u2014 grab, throw, pour, drink\n\u2022 A free starter area, with the rest of the club unlockable as a one-time purchase\n\u2022 Comfort-conscious drunk effects, tuned for standalone VR\n\nOrder a drink, place a bet, and see how the night goes.\n", "short_description": "Step behind the bar and into the crowd at your own VR nightclub. Throw darts, sink beer pong shots, roll dice against the house, spin the bottle, and order real drinks \u2014 every game plays for real cash, and the more you drink, the wilder the room gets.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://erp.suponoholdings.com/vr-terms", "developer_terms_of_service_url": null, "publisher_name": "Supono Holdings LTD", "support_website_url": null, "website_url": "https://suponoholdings.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2710427532541308"}, {"id": "459781504968480"}, {"id": "1700921480735423"}, {"id": "331529188132278"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1528562809268593"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "893223107059914"}]}, "baseline_offer": {"id": "893223107059914"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791205800, "status": "PUBLISHED", "id": "893223107059914"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1535660778558796", "version": "1.0"}, "id": "939684062034756", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1528562592601948", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1535660778558796"}, "release_status": "RELEASED"}, "binary_release_channels":
ntent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQS5wn19hQu3wu7tABaErVWjUbdky-A57sbJ_M6CeteJA&oe=6AE8A980"}, {"file_name": "screen4.png", "id": "917780834655403", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dSboRbn4zKgQ7kNvwEfdXR6&_nc_oc=Adp2ekPSbOm-RbTO2HMTOh1AShSRIWeUFGcFRNAHIo7arSlVBuhYzhgafV7a0pMOcpE&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhINOmImrCqgeslIfw6aOy0epT3frhAlR9sYBCMFz05Q&oe=6AE88D12"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kbu7x0017WkQ7kNvwFomz16&_nc_oc=AdoYI5w1Jwu7l--gBZpO6FiQLK0USjILs0ZsIYn3kRCPFJT4csPCE6K1qFnoRJEDw-8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTP1a6pqdo2i382-abDytOYQBhabYF-XWkuwAEQYVuqkw&oe=6AE8C4A9"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tblyRLDf17sQ7kNvwFtmaeL&_nc_oc=Adpzb1t7BE4oCXAqG2ql5u-1g39VK4xQI9N1XlIAWXYdR45vmkQr56fPdCQ3d8FCN2I&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSaJdW72jptlR4RIGOzFwOILg3NGK-PCINPOUr1w7c_dw&oe=6AE89FD1"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qPEE23ji3WwQ7kNvwGHyZW-&_nc_oc=AdpqlyMsIfuIxhywsxL_IO-met7NEbcMIbDrTxHVWLftgh6DN3S7_bDwiLvLOCJOWTg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSH3hrYAwFQpmTs69EWR_afFceqmokyOvD5mHzprPdbHQ&oe=6AE8B91A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "47808930179
ntent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJyDBT2Pz39mmJtnqTMMzBdPtj58uY0wBjqPKyB4nL0ag&oe=6AA2CA00"}, {"file_name": "screen4.png", "id": "917780834655403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=slBPGEbf0mAQ7kNvwEwAEkO&_nc_oc=AdqEDGXvfZIFV-R9mO6RB_KodUMIAaGat-oUfEt9-rCC2zq8gm9rSvHh6Nb2TnFDz_g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKES6dGAT69utKOl5eyYwVEdVPhn2xgMT79C9Lu9cgD1Q&oe=6AA2AD92"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5i2HutMuGi4Q7kNvwEyycQ_&_nc_oc=AdrQjGU02rX4rd6OmnrxcJA9VP5NEjpXWU4LrXd8Gq5keDfSvVQRIGhHF4Q2it4RI-k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIU5U19J-gfl2X6CsMo9z0T8wrYUiicjc9jNmsThQSX9A&oe=6AA2ACE9"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0hEx3QetoUQ7kNvwHEwxz9&_nc_oc=AdrZLDdobPzuFYza1Ghr5kojMAMNDGDN9MVjGiWT8NyAH6gA58c_VALAlNyu3UON9k8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJpZgk8_hFKhZ6y4m1i9nv1yKlgli2T9fu25RZ52Ksbnw&oe=6AA2C051"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UQzfvTUeDioQ7kNvwEFXTs-&_nc_oc=AdpEuZ_e0vF6LSQsHjmT9q8p3q1oiren7uR-B-uep7wfsCmDxEjMEHD0GdygCO7i6iU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIUzx_vvlzlE5YLVyTwsvS5rMew6TOPIxpY7uRCaKx6jA&oe=6AA2A15A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "47808930179
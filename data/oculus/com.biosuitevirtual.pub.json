ntent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLjC59GPXwB5bDxQyV6kYwP-sKnkXIhfImF17A64lok_w&oe=6ABBD680"}, {"file_name": "screen4.png", "id": "917780834655403", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5_osk1J3YzwQ7kNvwHQGBpZ&_nc_oc=Adr_08T2iZNnib73Nt9rr1ztmeUd2d042IjGl7uMCx_c0I8k9rjaAxQftcTOmTR2-Ms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJn4Gb1j04aWwgVxuvLdS7Gt1v2D4VkcOj1ds1ZvCnl_g&oe=6ABBBA12"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhEU9MenPKgQ7kNvwH0seJK&_nc_oc=Adrjx-wL1eQNY0fXWoWavIIOIqMBnAy26WwvtV6D0lHEZ1LsZVESYLyMabjxW9A4GcQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPSV2XBv2Vrbo1y7-GHOeQ5zS7B9oClpegRpr_vwvLSQ&oe=6ABBB969"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQIA8xeKCDMQ7kNvwF57a3T&_nc_oc=Adp410no3vUxNg-5wqIQfv9K1ZVqQhicDUAr_D1JsTzRu56O1kUNMWfCiCScpLMWle4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpDuRqG_9R8e8-aKPvIS0Lm4pDi5bIUFhTmf27QT40aA&oe=6ABBCCD1"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_Sj0EqOMC0Q7kNvwHjoh_Z&_nc_oc=Ado793Akzsipcg46S3uRYKA9-vdaLhrzabCJmnotdmZWW-0_DaDqLKBMeaWRP7K5gUk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKji60dLIJlPL933ZB3eUQyMmkWT-X7v662c-sVaGFO7Q&oe=6ABBADDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "47808930179
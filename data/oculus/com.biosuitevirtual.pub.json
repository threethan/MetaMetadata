ntent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6ZQOm3d2oZyCbTM200NMURxESiVnh59XCFrtzH1VX6Q&oe=6AB7E200"}, {"file_name": "screen4.png", "id": "917780834655403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqFjSdor6XgQ7kNvwHBvisK&_nc_oc=AdqfbSx0GplmGmKG_RSDFsvvNZUeoCEu7Cvl1f5UU387xnTrVwC05QyHQCpJpRg4iR4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ11Ek5uyX_rBbRjgrJinaZh7hjfA_PhTZtGb91pT3JZQ&oe=6AB7C592"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=085zBx--oZEQ7kNvwFZQkBe&_nc_oc=AdpFyYmk39su8oB-1TCN_xMjpdsvT8uGTwlHxMMN47_uhUUHg0v16npHatrrkvBzANg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJlJzBCw41fReuCccRhaiFObC5P6lNADu-ov9k9u3Q6jA&oe=6AB7C4E9"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F54ofxsrxgkQ7kNvwENqMge&_nc_oc=AdrWDrKy7-55RJllvGDK0N-q8L6URu8DXs6RX_GWpzSAjmZsYxs-QY_QqvNkCG9WspU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKzuPYDJEng8ntOdQogVBpMu9WA6gIjD2B5QM6llJFKKA&oe=6AB7D851"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YBQ0ocSBT3IQ7kNvwGlCrnh&_nc_oc=Adoh72MiAWGEjtNyUObj728G6WOe4SCfL3F6oaBpVlGvO3ljrvIJ3fyGy9Pt54o9tvQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLrva_wqRUr96efo7n8azR3LuCbJBJ3lhQuJ1SLCcKJSQ&oe=6AB7B95A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "47808930179
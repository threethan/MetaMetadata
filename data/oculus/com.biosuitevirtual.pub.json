reen4.png", "id": "917780834655403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0HMoBxOQmkQQ7kNvwEpYEM3&_nc_oc=AdpcSRrutcT9Pv5v9QKSIDwD4CAcCyfGRpxzjPul0UgZLbYrVX5koLNXaYLo3yaTMgk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGIHKB0irfODY2mp5rfD-eGLYXWPstl0fmxc1TBtux8PQ&oe=6A845B12"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_E6WoKTJXNQQ7kNvwGZSJv3&_nc_oc=AdqAEauAtJxQBbcdqKyjf-pxztFqoVgtryb84Q7pI_s_o-Ebq7VV3pXCWxyW0Yna8Yc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZhPDpsqI-zedOT6SB-dxMgOrP4GqTm2h3p6Z_nmn2mg&oe=6A845A69"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hwqdkNUS6T8Q7kNvwHOLVU9&_nc_oc=AdoL3DV7qVZPp8EwHfxyfVBkOce93Z-BHvWrMkcvOi0sr0On1FlR65RMQB7n9ZSyMRk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuF6gWN3eQ5tUcFJfGzIOhzDB6cwaZbr0_pisnhDh9Dw&oe=6A843591"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=72vg_GcGtGwQ7kNvwHN8AnB&_nc_oc=Ado0WrV4p8GeaXp5AGTn-L8TcMGzxohZan4YHMTxeJ4eml84vTvWsOYyaSlQ7oviWv4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHNfx4D70tsNC_ihXX8GuHnc5Ic15Vzy4p43RKr_Fecrg&oe=6A844EDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ntent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJm-_QeV0UDcZSKcX_iSopf0bSOmumgSbsd1O9aasvMLw&oe=6ABA8500"}, {"file_name": "screen4.png", "id": "917780834655403", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqFjSdor6XgQ7kNvwF_Zt6a&_nc_oc=Adq6R4yUCpWYnVmJWX3AV-R2_JGCYZb-QeFEtsL6SbYva4RxeBVhX7pdftK7BVQYwWo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2XnPi0fLnq7rBRuTFkED0LMwOZvvHRmGGANvu3CrG3w&oe=6ABA6892"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NhEU9MenPKgQ7kNvwG1Bn_O&_nc_oc=AdrfS-3Df6Ju98m1Fty4ZYCdlgc16IFsKqAwHx7kix3eupmpxnUP78GKczHA3-pJbGk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQILYPRf8eze716ul8Z41K468NYtfUoYgzX9bFohYy_8cQ&oe=6ABA67E9"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sQIA8xeKCDMQ7kNvwFEV98M&_nc_oc=Adpq3Zc07rxi5tY8KHi1ktj5yEBX625xKp_dlNoS4OLAqjG9J7tVMPT0DaUs4Relbl8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWiW8zeBkGU6T5KfbDga2cfqRAIm25kB5J9rqZon0tcg&oe=6ABA7B51"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_Sj0EqOMC0Q7kNvwEIAVtl&_nc_oc=AdrF_m46eAvW7o7_A4Zl8OgCZ9qUJLShGUFQiCDB_Zeozgkx_B_xfhp_065muZezjfU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmlbyFQsxVEfvMNTfQUGWLzax610ppWy-ZuN97bLnIMQ&oe=6ABA5C5A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "47808930179
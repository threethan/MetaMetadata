=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNFSC4GX6SQeqcoEx1OPrhWSQXRYDv9fE-qTu6qT5UGg&oe=6AAEA780"}, {"file_name": "screen4.png", "id": "917780834655403", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v1aYCUspYxoQ7kNvwG_h8i8&_nc_oc=AdrMwsL1U8w8dT8lubhvANUUliAKFNznqI6VLD6Bb22i6x0Pd40Gmv7XphYSqAamUBg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ2hvOIq7YvbXy84axI_MMDcy9XgC_De2cfXpUUlbuOXA&oe=6AAE8B12"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4ZHM2dIFQhUQ7kNvwFMfCZi&_nc_oc=AdrmzjEhnQN277NPH8DYlXKV0_jaQ5i6qpkzG5RONeb67wBk0BNZ2Z4DrmoyQrKGewY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKL43XJSFdYknGQ4GMA__jSYu0JB2YI_MF53Kur3DulfQ&oe=6AAE8A69"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-sin6-2.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IxH5DeBbzAkQ7kNvwHK-XqE&_nc_oc=AdpZW4ltyWlSxQWVzCakAl8L_zniG-vc-4_jRCETLCoiZfxLfJtfFEsiqNQDh09ui0g&_nc_zt=3&_nc_ht=scontent-sin6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNVWa6r1AMPYoj4ruR8Fj55T-_RcnGfdY_hsHLv9M5gw&oe=6AAE9DD1"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXFnoXT8RBoQ7kNvwEZr7C6&_nc_oc=AdqjOcwjDk9Dc52UDlUphfF091DpWDsNf9xWjFnughfnlmkCQJl99wQZU4xn1_R-tRU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPnCxbyr59ED9uBdnk_j_JSdrTEx5NdsvAMcEVKTeAlg&oe=6AAE7EDA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478
ntent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDx-JY0O7Jn0ISTMKvvp2-83YgD4bWrI7o0Zy9XZ76Zg&oe=6AC26E00"}, {"file_name": "screen4.png", "id": "917780834655403", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJoDK_StD6oQ7kNvwHaXMQN&_nc_oc=AdoPhpZNRuwK5Xa26W_eOyMssEJDym70hyZcnnulEjraz3eo_ZGWa4gIvUtBjxMYKRE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyC1_5uaMwuNb9lwf8q6lW7q8DnhXz7egbY_sk7R9w7w&oe=6AC25192"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkI44BUU5uIQ7kNvwGph1zx&_nc_oc=Adro7B0RENBoJPhyNbVd0jLVwsH9OVcsFVz7oBTSCmoj8rfMNRbi9n2Up1tJE9t292c&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMLNAD3lTHRbHZc3wRWt-AviNjG9TlnMjmXMUNGSTu_DA&oe=6AC250E9"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AFqP8j8GAgQ7kNvwHpaL1T&_nc_oc=Adoz0Y19gvTmSuIlxy2bg85uiak78gCHtKrC21hOSeHcQ52nqWReBD8-dYqaWWkpsqw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM0ovLkjswLIDVoCRqotVHC0G6_sgoqAdS_08yLhTrVeQ&oe=6AC26451"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qdyoH1WcodEQ7kNvwF4pQl9&_nc_oc=Ado_eWy_iTOXuaKxzoV_UYXwN1qvrHpJku96l95OU7i5iGZhBYKdB-c_SmKos4Gq6LU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOolkvaNPC3ALGeQ5SmW2ezMmc3rureMsUOmXYrrDPmuQ&oe=6AC27D9A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "47808930179
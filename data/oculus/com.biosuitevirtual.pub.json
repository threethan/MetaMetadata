reen4.png", "id": "917780834655403", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_fdGmah4KeUQ7kNvwHyYmNX&_nc_oc=AdoF7MID6tddvFE7qr1s0xZxB4fJkG769blj9sVBiwrwMtYJiWSviM9F2mP0Y84KeDU&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHBrYRQEsrm2jHLh-SaXaDfZv85_q5ig5MtrGH8AqpMtQ&oe=6A942D12"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JwGqCCLtS48Q7kNvwF0oeHT&_nc_oc=AdpHlypoR1c6pdnikJ-Lr-soakNAqXRnGfaZ2njQiHSmldefEUG2vm1StM7RPf6l5xk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHMpBm7v_sshp_4BkpBg_00iU-pPXi4zUYRmpPUdKC4jA&oe=6A942C69"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2tKqqz6qyAQ7kNvwEiR8Mn&_nc_oc=AdqxL9yZ5D5CjUTv06cKMAfHpx1bwJFFLCVJgyCL425-YuKEB_iUhWHZQ7_4M3MU_ac&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGLwf-twIX6y9UBjzMT4d8TuZIv_c-PSQ7_kS-5dFl-mw&oe=6A940791"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6erw0QfWNgQ7kNvwGp64SE&_nc_oc=AdpK0MbEbI-sTRIc2OistfCyX87GJgIQ2DXD6atzxFNNaPjM0sXN-51KfYjZ1yShOKs&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFIh5G-5IrCPwCUDhA5q34ixPLrDIjQcQLHP8P_lXhN7w&oe=6A9420DA"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
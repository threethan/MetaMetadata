reen4.png", "id": "917780834655403", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=glD1V_Mjnj8Q7kNvwGsK-29&_nc_oc=AdpF8rTt_QkU-0gHgXXU1OLJM4hzN_qqe_98bIwV01Mhykuh_UbOCrlPYszVh9bZyV4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHIKle-t6ml9THlP4s-1COC_arjQqCwV8Ehz-O9sAtYpg&oe=6A8AF292"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A0BWT1596M8Q7kNvwHqDuGd&_nc_oc=AdoWxfagJKX0OW6Tte1ouJmSaw-JtmAy4VLKqzQlJwwn8bEiZtGflvB5936qA90_pfA&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJpdvy9v__lHiovNsxP1jNJkDSUJqBq7ikLh458dYc7A&oe=6A8AF1E9"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WPecMhF9dK4Q7kNvwH4_Ny2&_nc_oc=AdqjtOB-gk8QLSlEynI5wcQj14RCByFc-623vE0JMdcSEIk43HjffBp93RYIEXir-Ks&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfBFFJjzCzmkTQztGCXRz5zWOVR961L78u0ZhfmNbUxQ&oe=6A8ACD11"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GRfkhpzZOAEQ7kNvwHaduSF&_nc_oc=AdqVacmMikiqyuPAg8hyChFm38WEfWpABUZIVCLkXE0REyePMa8u9tmNjf93XVoK_Gs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEz_E1SjkDe_oe3KhfSy2InE4GqVvcVbbnd1_gSUlzy3w&oe=6A8AE65A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "478089301798119"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQU
ntent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLiFFxrDxR0tY1R60OzBdSTr7OojC7QjPZpFha_ZasdGg&oe=6A9AE100"}, {"file_name": "screen4.png", "id": "917780834655403", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2OG-TkVw-xoQ7kNvwFxqci2&_nc_oc=Adrfq_K38G-TreysDoEqt2vbcPlqGuy15rzkU-zWs_za_d-eOpto8_LQE1Wf9mV5HS8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJhDDxeRTxe3eo70UAN11SL-f8TTD-mG8zXB1RUlRtVOg&oe=6A9AC492"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZZkNTrs4INsQ7kNvwHprWk-&_nc_oc=AdqSXRgZHAfcEpzbuN9BBl_0ZRz8AfMkHqhbol8URsTGEWnHXlMHtaeX1MHGPckj2gA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkeUuJuDbtFiGHZVn_gCvMXLFW3EwkrHec2HEMXE5n3w&oe=6A9AC3E9"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6n9YlozaJ_wQ7kNvwE6M__t&_nc_oc=Adqk5VJspbSQ-2j6udoZQDIt6WOAJAofTKPa0xg9oDsX9cK1J5IvpP0azoIr-Q89yAM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWofM_79nuwtaynDBVN5CiBdT3NbXa_af9QMUiRQQZZQ&oe=6A9AD751"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lPvRPrMAmdQQ7kNvwGpD5Mo&_nc_oc=AdrTE4BuCmYFWFKWBObpw_Ur2zkfDgu5An69RzjwiTdUS4ypJI76_N9IY4RCDzC0e6A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMjvggS4Hab377OU7Xlzh-3Q20PID7tUUJuuqa3LtsYg&oe=6A9AF09A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "47808930179
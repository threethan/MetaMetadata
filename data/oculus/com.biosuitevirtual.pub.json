ntent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMu_UXc36zdCzdWcmIPK7CUgNhH3sUNzE2HrguiJZKcmw&oe=6AC51100"}, {"file_name": "screen4.png", "id": "917780834655403", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499304952_917780837988736_2714144780592778232_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iP1WkJp7xgYQ7kNvwHMVBLk&_nc_oc=AdrsdFazL-AAg90ocehfkWq3sjEdLZmt0AsEEcbhwFyYDGnOHGGDsJ7-yvceAxd_FxA&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7RxOe1YrTUstBIdW-nsf3ymiGl_kVItIKK7H0tfrEYw&oe=6AC4F492"}, {"file_name": "screen7.png", "id": "3619235884891104", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/499310817_3619235888224437_8731315518145598668_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JkI44BUU5uIQ7kNvwFOHfpJ&_nc_oc=AdomUnr8UsU7aEVcltx89u-dwhragokRlGmRM932tYrhVL8VjEAxY8Vb1EkfAi-VuuQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_JPDuFnPcqieZ9KIahNVs2qJ68jAAZRyli6CevgFazA&oe=6AC4F3E9"}, {"file_name": "screen2.png", "id": "1330004605296800", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/593862973_1330004608630133_7589348606486132619_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V685yR6CjUcQ7kNvwEl4ate&_nc_oc=Adox_g5VLovzjjr47TxyNg97QKjRHxAfEDHzy9VTQGvAXo7RmVcphKPWi8k172G0uOI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_Q7R_D__ksJyQcOEDJbs-RoOZdFuiS3KxZqBZrasAlw&oe=6AC50751"}, {"file_name": "screen6.png", "id": "924520990649669", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499300603_924520997316335_3438153416817585128_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BRSQchHO7xoQ7kNvwGhEzeX&_nc_oc=Adp4JOeQIO1KakTwtiLDh1Cdx4KJDabxzjO8aqiG3L4iEKx_2xUlDcw-Mk2IS5ntrv4&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMuWJSYkJwK6GOMnSs5eCGYdfI9sslTxdBvEBzfSmGDgg&oe=6AC5209A"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "BioSuite Virtual: Lab-Scale Fermentation", "keywords": ["Science", "Biomanufacturing", "Fermentation", "Biotech", "Training"], "long_description": "# Train Smarter, Not Harder\nWhether you're preparing college students for a biomanufacturing job or onboarding employees in a lab, BioSuite Virtual removes common barriers\u2014limited equipment, instructor bandwidth, safety risks\u2014and replaces them with scalable, immersive learning.\n- No Lab Equipment, No Waste, No Risk\n- Scalable & Self-Paced\n- Always Available, Always Repeatable\n- Informed by Industry\n- Performance Tracking  \n# BioSuite Virtual Key Features\nBuilt for realism and interaction, BioSuite Virtual offers an unmatched simulation of real-world lab experiences\u2014without the capital investment and overhead. Users gain competence and confidence before using real equipment.\n- Realistic Lab Environments \n- Hands-On Assembly Tasks \n- Interactive Control Unit \n- Repeatable Practice Modules \n- Virtual Safety Protocols\u200b\u200b\n- Learning Management System Integration\n# Learning Design That Drives Results\nGrounded in proven learning science, BioSuite Virtual ensures that trainees not only understand how to perform tasks, but why they matter.\n- Step-by-Step Guidance\n- In-Depth Animations\n- Contextual Prompts\n- Knowledge Checks\n- Virtual Demonstrations", "short_description": "BioSuite Virtual is high-fidelity, self-paced training for tomorrow\u2019s biomanufacturing workforce that blends cutting-edge Mixed Reality immersion, intuitive interface design, and proven learning design. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://biosuitevirtual.com/privacy/biosuite-virtual", "developer_terms_of_service_url": null, "publisher_name": "Prism Immersive", "support_website_url": null, "website_url": "https://biosuitevirtual.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "514087707868786"}, {"id": "47808930179
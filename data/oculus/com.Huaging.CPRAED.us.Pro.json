2381540658906982_7317922052632781088_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8i_vG9Aan8MQ7kNvwG6ZA79&_nc_oc=AdozDZMcHGarknCritadIBhx8A758dI-RdG8uHgPd253JqTS4lmU6t-9lVvb4YbCYZw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yd0YGYt6XzZ3ZoH-6giuGFP528oMutemwzJGqtXLjNA&oe=6A4260EB"}, {"file_name": "\u87a2\u5e55\u622a\u5716_001_en_US.png", "id": "971880424977425", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820382_971880428310758_6870596750561031440_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yubP17MyJ6sQ7kNvwGJZ5eB&_nc_oc=AdqBSsR5eTzRGdgVXp2FQ72FjqW27w3yi1PB2-jHgULG4UoTz6WQt1DwXRBoNwknRzA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-qiKxBpS81_2rPAkJWCj00SA1xo8ZlivDlXgnNIAsTyA&oe=6A427167"}, {"file_name": "\u6210\u7e3e_en.png", "id": "1106212801404409", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491819421_1106212804737742_4031427001167199256_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v2h12tLeUqAQ7kNvwGg57hI&_nc_oc=Adoe7wM6Wtz7xv8bMuuQws8NvDIrGaT6nBMM7eJlDv0r9i-cIbKZUTnnqBjySXLPEaE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Zn9I_1CtPVGBuWovB7_DE1S80xZRNYxjODN2dPH9F1Q&oe=6A429712"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4\uff08\u7f8e\u570b\u7248\uff09(1920x1080)2m.png", "id": "728252249952781", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491819464_728252253286114_5055302708283950545_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rx12IuL3FwEQ7kNvwEezeHG&_nc_oc=AdpjiUvEAIrfGssmUNIDs200ltKqJZIUeMxE-J3HLFgxZKoLN3c-W6g7ZJFmgKf11tA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-cGcByeKYhmVjf53kf2mvOREr83QMT9SAIgh7GCrVtvA&oe=6A4263E8"}, "display_name": "Heartbeat Rescue: CPR+AED MR (Pro)", "keywords": ["CPRTraining", "AEDSimulation", "MedicalTraining", "EmergencyResponse", "ResuscitationPractice"], "long_description": "# Advanced functionality for professional education and group training\n\nBased on the latest CPR guidelines from the American Heart Association (AHA), this version is designed for schools, corporate programs, instructors, and group training. It provides a complete system for learning and assessment with enhanced flexibility.\n\n**Enhanced Features for Flexible Training**\n- Advanced settings and customizable options\n- Supports diverse needs from entry-level to realistic simulations\n\n**Adjustable CPR Compression Duration**\n- 30-second, 1-minute, and 2-minute modes\n- Flexible planning for teaching pace and intensity\n\n**\u201cTest Mode\u201d for Real-Life Simulation**\n- Visual prompts removed; audio guidance only\n- Simulates emergencies to test CPR response\n\n**Comprehensive Performance Evaluation**\n- Real-time scoring and online record tracking\n- Highlights weak points for targeted teaching\n- Auto-generates reports for progress monitoring\n\n**Supports Group Activities and Management**\n- Multi-user sessions with individual tracking\n- Admins can adjust content and view data insights\n\n\ud83d\udca1 **Subscription-based service. For full features, use with a stable internet connection.**\n\n\ud83d\udce9 Contact us: huagingofficial@gmail.com\n", "short_description": "Advanced functionality for professional education and group training.\nThis version follows the latest CPR guidelines from the American Heart Association (AHA) and is tailored for schools, corporate programs, and professional training. It provides a comprehensive learning and assessment system with enhanced flexibility.\nThis is a subscription-based service. For full access and the best experience, please use it with a stable internet connection."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.huaging.com/privacy-policy.html", "developer_terms_of_service_url": null, "publisher_name": "HUAGING Digital Technology", "support_website_url": "https://www.huaging.com/collections/cpr-and-aed", "
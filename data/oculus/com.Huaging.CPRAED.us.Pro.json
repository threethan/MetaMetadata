version": "3.9.1", "version_code": 19, "release_status": "RELEASED", "status": "APPROVED"}, "live_binary": null, "created_date": 1793072589, "id": "29533181629622559", "is_initial_release": false, "name_with_fallback": "v20", "pdp_metadata_with_fallback": {"version": 13, "application": {"is_concept": false, "latest_released_pdp_metadata": {"id": "29546048795002509"}, "release_status": "RELEASED", "id": "24613790758228362"}, "id": "29546048795002509", "release_status": "RELEASED", "status": "APPROVED"}, "release_date": null, "administration_status": "APPROVED", "is_first": false, "release_status": "RELEASED", "release_type": "SCHEDULED", "pdp_metadata": {"application": {"default_locale": "en_US", "id": "24613790758228362", "is_first_party": false, "enables_in_app_ads": false, "is_concept": false, "platform": "ANDROID_6DOF"}, "iarc_cert": {"id": "1105732944944343"}, "iarc_email": null, "msrp": null, "translations": {"nodes": [{"images": {"nodes": []}, "id": "1744082146650808", "locale": "ko_KR", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "(US) \uc2ec\ucff5 \uad6c\uc870: \uc2ec\ud3d0\uc18c\uc0dd\uc220 (CPR)+AED MR \ud6c8\ub828", "keywords": ["\uc2ec\ud3d0\uc18c\uc0dd\uc220", "\uc790\ub3d9\uc2ec\uc7a5\ucda9\uaca9\uae30", "\uc2ec\ud3d0\uc18c\uc0dd\uc220\ud6c8\ub828", "CPR\ud6c8\ub828", "AED\uad50\uc721"], "long_description": "# \ud83c\udfc6 2025 \uc11c\uc6b8\uad6d\uc81c\ubc1c\uba85\uc804\uc2dc\ud68c(SIIF) \uc218\uc0c1 \u2014 \ud55c\uad6d\uc18c\ubc29\uc0b0\uc5c5\uae30\uc220\uc6d0(KFI) \ud2b9\ubcc4\uc0c1 \uc218\uc5ec \n**\ud558\ud2b8\ub808\uc2a4\ud06c MR: \ucea0\ud37c\uc2a4 \ubc0f \uc2e4\uc804 \uc0c1\ud669 \ud6c8\ub828 \uc2dc\uc2a4\ud15c**\n\n\u3010\uc2e4\uccb4\uc801 \ucd09\uac10, \uac00\uc0c1\uc801 \uc555\ubc15: 30\ucd08 \ub9cc\uc5d0 \ub2f9\uc2e0\uc758 \uad6c\uc870 \ubcf8\ub2a5\uc744 \ubc14\uafc9\ub2c8\ub2e4\u3011 \n\n\uc65c \uc6b0\ub9ac\ub97c \uc120\ud0dd\ud574\uc57c \ud560\uae4c\uc694? \uae30\uc874\uc758 \ud6c8\ub828 \ubc29\uc2dd\uc740 \ud604\uc7a5\uac10\uc774 \ubd80\uc871\ud558\uc5ec \uc2e4\uc81c \uc0c1\ud669\uc5d0\uc11c \ub2f9\ud669\ud558\uae30 \uc27d\uc2b5\ub2c8\ub2e4. \ubcf8 \uc2dc\uc2a4\ud15c\uc740 \ud63c\ud569\ud604\uc2e4(MR) \uc744 \ud1b5\ud574 \uc2e4\uc81c \uad50\uc721\uc6a9 \ub9c8\ub124\ud0b9\uacfc \uac00\uc0c1\uc758 \uae34\uae09 \uc0c1\ud669\uc744 \uacb0\ud569\ud588\uc2b5\ub2c8\ub2e4. \ucea0\ud37c\uc2a4, \uc0ac\uace0 \ud604\uc7a5, \uae38\uac70\ub9ac \ub4f1\uc5d0\uc11c \uc2e4\uc81c\uc801\uc778 \ucd09\uac10 \ud53c\ub4dc\ubc31\uacfc \uc2dc\uac01\uc801 \uc555\ubc15\uc744 \ub3d9\uc2dc\uc5d0 \ub290\ub07c\uba70 \uad6c\uc870 \uae30\uc220\uc744 \uc5f0\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n**\uc804\ubb38\uac00\uc6a9 \uae30\ub2a5:**\n- \uc2dc\ub098\ub9ac\uc624 \uae30\ubc18 \ud6c8\ub828: \uc624\ud53c\uc2a4 \ube4c\ub529, \ucea0\ud37c\uc2a4, \uae38\uac70\ub9ac \ub4f1 \ub2e4\uc591\ud55c \uac00\uc0c1 \uc2dc\ub098\ub9ac\uc624\ub97c \uc790\uc720\ub86d\uac8c \uc804\ud658.\n- MR \ub9c8\ub124\ud0b9 \ub3d9\uae30\ud654: \uc2e4\uc81c \ub9c8\ub124\ud0b9\uc744 \uc9c0\uc6d0\ud558\uba70, \uac00\uc0c1 \uc9c0\uce68\uc744 \uc2e4\uccb4\uc801\uc778 \ucd09\uac10 \uc704\uc5d0 \uc815\ubc00\ud558\uac8c \ud22c\uc601.\n- 3\uc0c9 \uc9c4\ub2e8 \uc9c0\ud45c: \ub808\ub4dc, \ud654\uc774\ud2b8, \uadf8\ub808\uc774 \ud558\ud2b8\ub97c \ud1b5\ud574 30\ucd08 \ub0b4 \uc555\ubc15 \uae4a\uc774\uc640 \uc18d\ub3c4 \uc548\uc815\uc131\uc744 \uc9c4\ub2e8.\n- 13\ub2e8\uacc4 \uc804 \uacfc\uc815 \ud3c9\uac00: \ubaa8\ub4e0 \uc751\uae09 \uacb0\uc815 \ub2e8\uacc4\ub97c \uc790\ub3d9 \ucd94\uc801\ud558\uc5ec \uc808\ucc28\uc0c1\uc758 \uc548\uc804 \uacb0\ud568\uc744 \ud30c\uc545.\n\uad00\ub9ac \ubc0f \uad50\uc721 \uc194\ub8e8\uc158: \n- \uad50\uc0ac\uc6a9 \uc77c\uad04 \ucd94\ucd9c: \ud559\uc0dd\uc758 \ucd5c\uace0 \uc810\uc218 \uae30\ub85d, \uc5f0\uc2b5 \ud69f\uc218 \ubc0f \ub808\ub4dc \ud558\ud2b8 \ube44\uc728 \ud1b5\uacc4\ub97c \uac04\ud3b8\ud558\uac8c \ud68d\ub4dd.\n- \uc131\uc7a5 \ud2b8\ub80c\ub4dc \ubd84\uc11d: \uae30\uc220\uc744 \uc774\ud574\uc640 \uc131\ucc30\uc758 \ub3c4\uad6c\ub85c \ud65c\uc6a9\ud558\uc5ec \uac1c\ubcc4\ud654 \uad50\uc721\uc758 \uc131\uacfc\ub97c \uac15\ud654.\n\n\ud83d\ude80 \uc9c0\uae08 \ubc14\ub85c 7\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc744 \uc2dc\uc791\ud558\uace0, \uac00\uc0c1 \ucea0\ud37c\uc2a4\uc5d0\uc11c \uc804\ubb38 \uc751\uae09 \ubcf4\uace0\uc11c\ub97c \ud655\uc778\ud558\uc138\uc694! \n\n**\ud559\uad50, \uc758\ub8cc\uae30\uad00 \ubc0f \uae30\uc5c5\uc6a9 \uc194\ub8e8\uc158**\n\n20\uc778 \uc774\uc0c1\uc758 \uc751\uae09 \ucc98\uce58 \uad50\uc721 \uc194\ub8e8\uc158\uc744 \ucc3e\uace0 \uacc4\uc2ed\ub2c8\uae4c? \uad00\ub9ac\uc790\ub97c \uc704\ud574 \uc124\uacc4\ub41c \ub514\uc9c0\ud138 \ub3c4\uad6c\ub97c \uc81c\uacf5\ud569\ub2c8\ub2e4.\n\n- \ub370\uc774\ud130 \uad00\ub9ac \ub300\uc2dc\ubcf4\ub4dc: \ud559\uc0dd\uc758 \ucd5c\uace0 \uc810\uc218, \ub2ec\uc131 \ud69f\uc218 \ubc0f \uc131\uc7a5 \ucd94\uc138\ub97c \ud55c \ubc88\uc758 \ud074\ub9ad\uc73c\ub85c \ucd94\ucd9c \uac00\ub2a5.\n\n- \uc804\ubc29\uc704 \uc131\uacfc \ubd84\uc11d: \uc870\uc9c1 \ub0b4 \ub808\ub4dc \ud558\ud2b8(\ud0c1\uc6d4), \ud654\uc774\ud2b8 \ud558\ud2b8(\uc6b0\uc218), \uadf8\ub808\uc774 \ud558\ud2b8(\uc5f0\uc2b5 \ud544\uc694) \ubd84\ud3ec \ud1b5\uacc4.\n\n- \uc8fc\uc694 \ud504\ub85c\uc138\uc2a4 \uc9c4\ub2e8: 13\uac00\uc9c0 \uc808\ucc28 \uc911 \uc9d1\ub2e8\uc801\uc778 \uc624\ub958 \ud56b\uc2a4\ud31f\uc744 \uc790\ub3d9 \uac10\uc9c0\ud558\uc5ec \uad50\uc721 \ud6a8\uacfc \uac15\ud654.\n\n\uae30\uc5c5\uc6a9 \uccb4\ud5d8 \ub77c\uc774\uc120\uc2a4 \ub610\ub294 \ub2e8\uccb4 \uacac\uc801\uc774 \ud544\uc694\ud558\uc2ed\ub2c8\uae4c? MDM \ub300\ub7c9 \ubc30\ud3ec \ubc0f \ud559\uad50 \ud559\ub144\ub3c4 \uad6c\ub9e4 \ud50c\ub79c\uc744 \uc9c0\uc6d0\ud569\ub2c8\ub2e4. \n\n\ud83c\udf10 \uacf5\uc2dd \uc6f9\uc0ac\uc774\ud2b8: https://www.huaging.com/en/contact\n\n\ud83d\udce7 \ubb38\uc758 \uc774\uba54\uc77c: huaging@gmail.com", "short_description": "\ud558\ud2b8\ub808\uc2a4\ud06c MR: \ucea0\ud37c\uc2a4 \ubc0f \uc2e4\uc804 \uc0c1\ud669 \ud6c8\ub828 \uc2dc\uc2a4\ud15c\n\n\u3010\uc2e4\uccb4\uc801 \ucd09\uac10, \uac00\uc0c1\uc801 \uc555\ubc15: 30\ucd08 \ub9cc\uc5d0 \ub2f9\uc2e0\uc758 \uad6c\uc870 \ubcf8\ub2a5\uc744 \ubc14\uafc9\ub2c8\ub2e4\u3011 \n\n\uc65c \uc6b0\ub9ac\ub97c \uc120\ud0dd\ud574\uc57c \ud560\uae4c\uc694? \uae30\uc874\uc758 \ud6c8\ub828 \ubc29\uc2dd\uc740 \ud604\uc7a5\uac10\uc774 \ubd80\uc871\ud558\uc5ec \uc2e4\uc81c \uc0c1\ud669\uc5d0\uc11c \ub2f9\ud669\ud558\uae30 \uc27d\uc2b5\ub2c8\ub2e4. \ubcf8 \uc2dc\uc2a4\ud15c\uc740 \ud63c\ud569\ud604\uc2e4(MR) \uc744 \ud1b5\ud574 \uc2e4\uc81c \uad50\uc721\uc6a9 \ub9c8\ub124\ud0b9\uacfc \uac00\uc0c1\uc758 \uae34\uae09 \uc0c1\ud669\uc744 \uacb0\ud569\ud588\uc2b5\ub2c8\ub2e4. \ucea0\ud37c\uc2a4, \uc0ac\uace0 \ud604\uc7a5, \uae38\uac70\ub9ac \ub4f1\uc5d0\uc11c \uc2e4\uc81c\uc801\uc778 \ucd09\uac10 \ud53c\ub4dc\ubc31\uacfc \uc2dc\uac01\uc801 \uc555\ubc15\uc744 \ub3d9\uc2dc\uc5d0 \ub290\ub07c\uba70 \uad6c\uc870 \uae30\uc220\uc744 \uc5f0\uc2b5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.\n\n\ud83d\ude80 \uc9c0\uae08 \ubc14\ub85c 7\uc77c \ubb34\ub8cc \uccb4\ud5d8\uc744 \uc2dc\uc791\ud558\uace0, \uac00\uc0c1 \ucea0\ud37c\uc2a4\uc5d0\uc11c \uc804\ubb38 \uc751\uae09 \ubcf4\uace0\uc11c\ub97c \ud655\uc778\ud558\uc138\uc694! "}, {"images": {"nodes": []}, "id": "1652106239723680", "locale": "ja_JP", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\uff08US\uff09 \u30cf\u30fc\u30c8\u30d3\u30fc\u30c8\u6551\u547d\uff1aCPR+AED MR\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0", "keywords": ["CPR", "AED", "\u7dca\u6025\u5bfe\u5fdc", "\u8607\u751f\u7df4\u7fd2", "\u533b\u7642\u8a13\u7df4"], "long_description": "# \ud83c\udfc6 2025\u5e74 \u30bd\u30a6\u30eb\u56fd\u969b\u767a\u660e\u5c55 (SIIF) \u53d7\u8cde \u2014 \u97d3\u56fd\u6d88\u9632\u6280\u8853\u9662 (KFI) \u7279\u5225\u8cde\u53d7\u7ae0 \n**\u30ec\u30b9\u30ad\u30e5\u30fc\u30cf\u30fc\u30c8MR\uff1a\u6821\u5712\u30fb\u5b9f\u6226\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u8a13\u7df4\u30b7\u30b9\u30c6\u30e0**\n\n\u3010\u5b9f\u4f53\u306e\u611f\u89e6\u3001\u4eee\u60f3\u306e\u5727\u529b\uff1a30\u79d2\u3067\u3042\u306a\u305f\u306e\u6551\u8b77\u672c\u80fd\u3092\u5909\u3048\u308b\u3011 \n\n\u306a\u305c\u79c1\u305f\u3061\u3092\u9078\u3076\u306e\u304b\uff1f \u5f93\u6765\u306e\u8a13\u7df4\u306f\u81e8\u5834\u611f\u306b\u6b20\u3051\u3001\u5b9f\u6226\u3067\u306f\u6238\u60d1\u3046\u3053\u3068\u304c\u5c11\u306a\u304f\u3042\u308a\u307e\u305b\u3093 \u3002\u672c\u30b7\u30b9\u30c6\u30e0\u306f\n**\u6df7\u5408\u73fe\u5b9f\uff08MR\uff09**\n\u3092\u901a\u3058\u3066\u3001\u30ea\u30a2\u30eb\u306a\u8a13\u7df4\u7528\u30de\u30cd\u30ad\u30f3\u3068\u4eee\u60f3\u306e\u7dca\u6025\u5834\u9762\u3092\u878d\u5408\u3055\u305b\u307e\u3057\u305f \u3002\u6821\u5712\u3001\u4e8b\u6545\u73fe\u5834\u3001\u8def\u4e0a\u306a\u3069\u3067\u3001\u5b9f\u969b\u306e\u611f\u89e6\u3068\u8996\u899a\u7684\u306a\u5727\u529b\u3092\u611f\u3058\u306a\u304c\u3089\u6551\u547d\u6280\u8853\u3092\u5b66\u3079\u307e\u3059 \u3002\n\n**\u30d7\u30ed\u30d5\u30a7\u30c3\u30b7\u30e7\u30ca\u30eb\u6a5f\u80fd\uff1a**\n- \u30b7\u30ca\u30ea\u30aa\u8a98\u5c0e\u578b\u8a13\u7df4\uff1a\u30aa\u30d5\u30a3\u30b9\u30d3\u30eb\u3001\u6821\u5712\u3084\u8def\u4e0a\u306a\u3069\u3001\u591a\u69d8\u306a\u4eee\u60f3\u30b7\u30fc\u30f3\u3092\u81ea\u7531\u306b\u5207\u308a\u66ff\u3048\u53ef\u80fd \u3002\n- MR\u30de\u30cd\u30ad\u30f3\u540c\u671f\uff1a\u5b9f\u4f53\u306e\u30de\u30cd\u30ad\u30f3\u306b\u5bfe\u5fdc\u3057\u3001\u4eee\u60f3\u306e\u6307\u793a\u3092\u5b9f\u969b\u306e\u611f\u89e6\u306e\u4e0a\u306b\u6295\u5f71 \u3002\n- \u4e09\u8272\u8a3a\u65ad\u6307\u6a19\uff1a\u8d64\u30fb\u767d\u30fb\u7070\u8272\u306e\u30cf\u30fc\u30c8\u3067\u300130\u79d2\u9593\u306e\u5727\u8feb\u306e\u6df1\u3055\u3068\u30ea\u30ba\u30e0\u306e\u5b89\u5b9a\u5ea6\u3092\u8a3a\u65ad \u3002\n- 13\u9805\u76ee\u306e\u5168\u884c\u7a0b\u8a55\u4fa1\uff1a\u3059\u3079\u3066\u306e\u6551\u6025\u610f\u601d\u6c7a\u5b9a\u30b9\u30c6\u30c3\u30d7\u3092\u81ea\u52d5\u8ffd\u8de1\u3057\u3001\u624b\u9806\u306e\u4e0d\u5099\u3092\u7279\u5b9a \u3002\n\n**\u7ba1\u7406\u30fb\u6559\u80b2\u30bd\u30ea\u30e5\u30fc\u30b7\u30e7\u30f3\uff1a**\n- \u6559\u5e2b\u7528\u4e00\u62ec\u66f8\u304d\u51fa\u3057\uff1a\u5b66\u751f\u306e\u6700\u9ad8\u5f97\u70b9\u3001\u7df4\u7fd2\u56de\u6570\u3001\u8d64\u30cf\u30fc\u30c8\u7387\u306e\u7d71\u8a08\u3092\u7c21\u5358\u306b\u53d6\u5f97 \u3002\n- \u6210\u9577\u30c8\u30ec\u30f3\u30c9\u5206\u6790\uff1a\u30c6\u30af\u30ce\u30ed\u30b8\u30fc\u3092\u7406\u89e3\u3068\u53cd\u7701\u306e\u30c4\u30fc\u30eb\u306b\u3057\u3001\u500b\u5225\u6307\u5c0e\u306e\u52b9\u679c\u3092\u5f37\u5316 \u3002\n\n\ud83d\ude80 \u4eca\u3059\u30507\u65e5\u9593\u306e\u7121\u6599\u30c8\u30e9\u30a4\u30a2\u30eb\u3092\u958b\u59cb\u3057\u3001\u4eee\u60f3\u6821\u5712\u3067\u30d7\u30ed\u306e\u6551\u6025\u30ec\u30dd\u30fc\u30c8\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3057\u3087\u3046\uff01\n\n**\u5b66\u6821\u30fb\u516c\u52d9\u6a5f\u95a2\u30fb\u6cd5\u4eba\u5411\u3051\u30bd\u30ea\u30e5\u30fc\u30b7\u30e7\u30f3**\n\n20\u540d\u4ee5\u4e0a\u306e\u6551\u6025\u30c8\u30ec\u30fc\u30cb\u30f3\u30b0\u30d7\u30ed\u30b0\u30e9\u30e0\u3092\u304a\u63a2\u3057\u3067\u3059\u304b\uff1f\u7ba1\u7406\u8005\u5411\u3051\u306b\u8a2d\u8a08\u3055\u308c\u305f\u30c7\u30b8\u30bf\u30eb\u30c4\u30fc\u30eb\u3092\u63d0\u4f9b\u3057\u3066\u3044\u307e\u3059\u3002\n- \u30c7\u30fc\u30bf\u7ba1\u7406\u30d0\u30c3\u30af\u30a8\u30f3\u30c9\uff1a\u53d7\u8b1b\u751f\u306e\u6700\u9ad8\u5f97\u70b9\u3001\u9054\u6210\u56de\u6570\u3001\u6210\u9577\u30c8\u30ec\u30f3\u30c9\u3092\u30ef\u30f3\u30af\u30ea\u30c3\u30af\u3067\u30a8\u30af\u30b9\u30dd\u30fc\u30c8\u53ef\u80fd\u3002\n- \u5305\u62ec\u7684\u306a\u6210\u679c\u5206\u6790\uff1a\u7d44\u7e54\u5185\u306e\u30ec\u30c3\u30c9\u30cf\u30fc\u30c8\uff08\u5353\u8d8a\uff09\u3001\u30db\u30ef\u30a4\u30c8\u30cf\u30fc\u30c8\uff08\u512a\u826f\uff09\u3001\u30b0\u30ec\u30fc\u30cf\u30fc\u30c8\uff08\u8981\u7df4\u7fd2\uff09\u306e\u5206\u5e03\u3092\u7d71\u8a08\u3002\n- \u91cd\u8981\u30b9\u30c6\u30c3\u30d7\u8a3a\u65ad\uff1a13\u9805\u76ee\u306e\u30d7\u30ed\u30bb\u30b9\u306b\u304a\u3051\u308b\u96c6\u56e3\u7684\u306a\u30df\u30b9\u306e\u30db\u30c3\u30c8\u30b9\u30dd\u30c3\u30c8\u3092\u81ea\u52d5\u691c\u51fa\u3057\u3001\u6559\u80b2\u52b9\u679c\u3092\u5f37\u5316\u3002\n\n\u6cd5\u4eba\u5411\u3051\u30c8\u30e9\u30a4\u30a2\u30eb\u30e9\u30a4\u30bb\u30f3\u30b9\u3084\u56e3\u4f53\u898b\u7a4d\u3082\u308a\u3092\u3054\u5e0c\u671b\u3067\u3059\u304b\uff1fMDM\u306e\u4e00\u62ec\u5c0e\u5165\u3084\u6821\u5185\u5e74\u5ea6\u8cfc\u5165\u30d7\u30e9\u30f3\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u3059\u3002\n\n\ud83c\udf10 \u516c\u5f0f\u30b5\u30a4\u30c8\uff1ahttps://www.huaging.com/jp/contact \n\n\ud83d\udce7 \u9023\u7d61\u5148\u30e1\u30fc\u30eb\u30a2\u30c9\u30ec\u30b9\uff1ahuaging@gmail.com", "short_description": "\u30ec\u30b9\u30ad\u30e5\u30fc\u30cf\u30fc\u30c8MR\uff1a\u6821\u5712\u30fb\u5b9f\u6226\u30b7\u30c1\u30e5\u30a8\u30fc\u30b7\u30e7\u30f3\u8a13\u7df4\u30b7\u30b9\u30c6\u30e0\n\n\u3010\u5b9f\u4f53\u306e\u611f\u89e6\u3001\u4eee\u60f3\u306e\u5727\u529b\uff1a30\u79d2\u3067\u3042\u306a\u305f\u306e\u6551\u8b77\u672c\u80fd\u3092\u5909\u3048\u308b\u3011 \n\n\u306a\u305c\u79c1\u305f\u3061\u3092\u9078\u3076\u306e\u304b\uff1f \u5f93\u6765\u306e\u8a13\u7df4\u306f\u81e8\u5834\u611f\u306b\u6b20\u3051\u3001\u5b9f\u6226\u3067\u306f\u6238\u60d1\u3046\u3053\u3068\u304c\u5c11\u306a\u304f\u3042\u308a\u307e\u305b\u3093 \u3002\u672c\u30b7\u30b9\u30c6\u30e0\u306f\u6df7\u5408\u73fe\u5b9f\uff08MR\uff09\u3092\u901a\u3058\u3066\u3001\u30ea\u30a2\u30eb\u306a\u8a13\u7df4\u7528\u30de\u30cd\u30ad\u30f3\u3068\u4eee\u60f3\u306e\u7dca\u6025\u5834\u9762\u3092\u878d\u5408\u3055\u305b\u307e\u3057\u305f \u3002\u6821\u5712\u3001\u4e8b\u6545\u73fe\u5834\u3001\u8def\u4e0a\u306a\u3069\u3067\u3001\u5b9f\u969b\u306e\u611f\u89e6\u3068\u8996\u899a\u7684\u306a\u5727\u529b\u3092\u611f\u3058\u306a\u304c\u3089\u6551\u547d\u6280\u8853\u3092\u5b66\u3079\u307e\u3059 \u3002\n\n\ud83d\ude80 \u4eca\u3059\u30507\u65e5\u9593\u306e\u7121\u6599\u30c8\u30e9\u30a4\u30a2\u30eb\u3092\u958b\u59cb\u3057\u3001\u4eee\u60f3\u6821\u5712\u3067\u30d7\u30ed\u306e\u6551\u6025\u30ec\u30dd\u30fc\u30c8\u3092\u30a2\u30f3\u30ed\u30c3\u30af\u3057\u307e\u3057\u3087\u3046\uff01"}, {"images": {"nodes": []}, "id": "1541612361345263", "locale": "zh_TW", "screenshots": [], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "\uff08US\uff09\u5fc3\u52d5\u5373\u6551\uff1aCPR+AED MR\u8a13\u7df4", "keywords": ["CPR", "AED", "\u5fc3\u80ba\u5fa9\u7526\u8853\u8a13\u7df4", "\u6025\u6551\u61c9\u8b8a", "\u91ab\u7642\u8a13\u7df4"], "long_description": "# \ud83c\udfc6\u69ae\u7372 2025 \u5e74\u9996\u723e\u570b\u969b\u767c\u660e\u5c55 (SIIF) \u2014\u2014 \u97d3\u570b\u6d88\u9632\u5354\u6703 (KFI) \u7279\u5225\u734e\n\n**\u5fc3\u8df3\u6551\u63f4 MR\uff1a\u6821\u5712\u8207\u5be6\u6230\u60c5\u5883\u8a13\u7df4\u7cfb\u7d71**\n\n\u3010 \u5be6\u9ad4\u89f8\u611f\uff0c\u865b\u64ec\u58d3\u529b\uff1a30 \u79d2\u6539\u8b8a\u60a8\u7684\u6551\u8b77\u672c\u80fd \u3011\n\n\u70ba\u4ec0\u9ebc\u9078\u64c7\u6211\u5011\uff1f \u50b3\u7d71\u7df4\u7fd2\u7f3a\u4e4f\u81e8\u5834\u611f\uff0c\u5be6\u6230\u6642\u5f80\u5f80\u624b\u8db3\u7121\u63aa\u3002\u672c\u7cfb\u7d71\u900f\u904e\u6df7\u5408\u5be6\u5883 (MR)\uff0c\u5c07\u771f\u5be6\u7684\u5b89\u59ae\u6559\u5177\u8207\u865b\u64ec\u7dca\u6025\u5834\u666f\u7d50\u5408\u3002\u60a8\u5c07\u5728\u6821\u5712\u3001\u8eca\u798d\u73fe\u5834\u53ca\u8def\u908a\u7df4\u7fd2\u6551\u547d\u6280\u8853\uff0c\u611f\u53d7\u771f\u5be6\u7684\u9ad4\u611f\u56de\u994b\u8207\u8996\u89ba\u58d3\u529b\u3002\n\n**\u5c08\u696d\u7d1a\u529f\u80fd\uff1a**\n\n- \u60c5\u5883\u5c0e\u5411\u8a13\u7df4\uff1a\u81ea\u7531\u5207\u63db\u6821\u5712\u3001\u8def\u908a\u3001\u8fa6\u516c\u5927\u6a13\u7b49\u591a\u6a23\u5316\u865b\u64ec\u5834\u666f\u3002\n\n- MR \u6559\u5177\u540c\u6b65\uff1a\u652f\u63f4\u5be6\u9ad4\u5b89\u59ae\uff0c\u5c07\u865b\u64ec\u6307\u4ee4\u6295\u5f71\u65bc\u771f\u5be6\u89f8\u611f\u4e0a\u3002\n\n- \u4e09\u8272\u8a3a\u65b7\u6307\u6a19\uff1a\u900f\u904e\u7d05\u3001\u767d\u3001\u7070\u5fc3\uff0c30 \u79d2\u770b\u7a7f\u60a8\u7684\u6df1\u5ea6\u8207\u901f\u7387\u7a69\u5b9a\u5ea6\u3002\n\n- 13 \u9805\u5168\u6d41\u7a0b\u8003\u6838\uff1a\u81ea\u52d5\u8ffd\u8e64\u6bcf\u4e00\u9805\u6025\u6551\u6c7a\u7b56\u6b65\u9a5f\uff0c\u6293\u51fa\u6d41\u7a0b\u4e2d\u7684\u5b89\u5168\u6f0f\u6d1e\u3002\n\n**\u7ba1\u7406\u8207\u6559\u80b2\u65b9\u6848\uff1a**\n\n- \u6559\u5e2b\u4e00\u9375\u5c0e\u51fa\uff1a\u8f15\u9b06\u53d6\u5f97\u5b78\u751f\u7684\u6700\u9ad8\u5206\u7d00\u9304\u3001\u7df4\u7fd2\u6b21\u6578\u53ca\u7d05\u5fc3\u7387\u7d71\u8a08\u3002\n\n- \u6210\u9577\u8da8\u52e2\u5206\u6790\uff1a\u8b93\u79d1\u6280\u6210\u70ba\u4fc3\u9032\u7406\u89e3\u8207\u53cd\u601d\u7684\u5de5\u5177\uff0c\u5f37\u5316\u500b\u5225\u5316\u6559\u5b78\u6210\u6548\u3002\n\n\u7acb\u5373\u958b\u555f 7 \u5929\u514d\u8cbb\u8a66\u7528\uff0c\u5728\u865b\u64ec\u6821\u5712\u4e2d\u89e3\u9396\u60a8\u7684\u5c08\u696d\u6025\u6551\u5831\u544a\uff01\n\n**\u5b78\u6821\u3001\u91ab\u7642\u6a5f\u69cb\u8207\u4f01\u696d\u65b9\u6848**\n\n\u6b63\u5728\u5c0b\u627e\u9069\u5408 20 \u4eba\u4ee5\u4e0a\u7684\u6025\u6551\u57f9\u8a13\u65b9\u6848\u55ce\uff1f\u6211\u5011\u63d0\u4f9b\u5c08\u70ba\u7ba1\u7406\u8005\u8a2d\u8a08\u7684\u6578\u4f4d\u5de5\u5177\uff1a \n- \u6578\u64da\u7ba1\u7406\u5f8c\u53f0\uff1a\u4e00\u9375\u5c0e\u51fa\u5b78\u751f\u7684\u6700\u9ad8\u6210\u7e3e\u3001\u9054\u6210\u6b21\u6578\u53ca\u6210\u9577\u8da8\u52e2 \u3002\n- \u5168\u65b9\u4f4d\u6210\u6548\u5206\u6790\uff1a\u7d71\u8a08\u7d44\u7e54\u5167\u7684\u7d05\u5fc3\uff08\u5353\u8d8a\uff09\u3001\u767d\u5fc3\uff08\u512a\u826f\uff09\u8207\u7070\u5fc3\uff08\u9700\u7df4\u7fd2\uff09\u5206\u5e03 \u3002\n- \u95dc\u9375\u6d41\u7a0b\u8a3a\u65b7\uff1a\u81ea\u52d5\u5075\u6e2c 13 \u9805\u6d41\u7a0b\u4e2d\u7684\u96c6\u9ad4\u932f\u8aa4\u71b1\u9ede\uff0c\u5f37\u5316\u6559\u5b78\u6210\u6548\u3002\n\n\u60f3\u8981\u7372\u5f97\u4f01\u696d\u8a66\u7528\u6388\u6b0a\u6216\u5718\u9ad4\u5831\u50f9\uff1f\u6211\u5011\u652f\u6301
tent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-9TBUd5r2xE5bAdwjFgFrtoxvW5Kw3kUzReO2dyxJqw&oe=6A8D8AB6"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-34.png", "id": "750935124188943", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/499619496_750935127522276_554193967792192376_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UiAKEDY0gAgQ7kNvwEL1anH&_nc_oc=AdqHEd2nwxtALn5muIHMogzGEp_HT7v9iFwl4j3HNKaWK_lVAfRN7dxZUNB1M9HgwTA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECCgCQ3-ieZdFgKAgQvwp5itV-EoP47kdt-g0TdLIV4Q&oe=6A8D873A"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-43.png", "id": "1737986793508478", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491822897_1737986796841811_1091258000082558432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk5RMegvfOgQ7kNvwHRi26S&_nc_oc=Adqi5TECUVJoOsokTL7igJmpoXsllXzs3o4qWaMQclAtsNaqxzhZK7eA5m2J-mSd6BA&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQEA7KtCbtiLbMAlgUlqfHC315bhoLzR8Phlkfibz-kA&oe=6A8D91C6"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-10.png", "id": "1799763494230126", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499311606_1799763500896792_5636752650751671462_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XIZVjy0WtvsQ7kNvwEpJQPb&_nc_oc=Adp_N_4D81kSUksKXrZ_D0u9JkybxYDAdTS8UPIS_i5WZDH51SwtczZ-gz7dDi5nA2I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFbrO6bqZyr4aSEBEX0CtCkVo4ny1DMwWiZmY_JbBT4UA&oe=6A8D80FC"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-28.png", "id": "794450146290340", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499622354_794450149623673_4025669516105800748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxwP1AhL5Q8Q7kNvwHF-87e&_nc_oc=Adr_40iZVIiJRG_TlDC0VytRvu70I2LIkgoWIV_wWWkONH8l4M5NCp56ODzNlCV0ht8&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFllUNV01OF3PSU8U4gPcGCi6IubdVsxCshjGHzJLPvSw&oe=6A8D6910"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Sprint", "keywords": ["tag", "ape", "forest"], "long_description": "Run, climb, and sprint your way through VR with nothing but your hands.\nIn Ape Sprint, you\u2019ll move just like an ape\u2014no joysticks, no teleporting, no nonsense. Use your arms to launch off walls, swing through trees, and scale anything you can grab. Grip with both hands to climb, push off with one to leap\u2014simple, intuitive, and wildly fun.\nPlay classic Tag with up to 3 players, or switch to Infection Mode with 4 or more. Chase. Escape. Outsmart. Whether you're running from the infected or hunting down survivors, the jungle is your playground. Parkour through cliffs, treetops, and ruins in a lo-fi virtual world built for chaos and connection.\n\nHop into public rooms and meet new players or start a private session with friends. No pressure\u2014just movement, mayhem, and maybe a little monkey business. The physics feel natural, the gameplay is easy to pick up, and the mastery? That\u2019s up to you.\n\nCrossplay with PCVR supported.\n\nBecome the ape. Sprint like one.", "short_description": "Run, climb, and sprint your way through VR with nothing but your hands.\nIn Ape Sprint, you\u2019ll move just like an ape\u2014no joysticks, no teleporting, no nonsense. Use your arms to launch off walls, swing through trees, and scale anything you can grab. Grip with both hands to climb, push off with one to leap\u2014simple, intuitive, and wildly fun.\nPlay classic Tag with up to 3 players or switch to Infection Mode with 4 or more."}]}, "developer_name": "Snow Studios", "developer_privacy_policy_url": "https://apesprint.my.canva.site/#page-1", "developer_terms_of_service_url": "https://apesprint.my.canva.site/#page-0", "publisher_name": "Snow Studios", "support_website_url": null, "website_url": "https://apesprint.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_catego
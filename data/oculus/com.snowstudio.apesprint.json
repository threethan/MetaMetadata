sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nhRFZ-bD8-auFNoAwwY-pzwqobATe1J5gxj012fS9Qg&oe=6A119DB6"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-34.png", "id": "750935124188943", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499619496_750935127522276_554193967792192376_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wX7YrEZHskkQ7kNvwHfRfUP&_nc_oc=AdrW0VixbGA5ScVcxnJRecB-6QDPbEUvJWcLAocp6GF5rDsBreJieUrrE93dI8osD28&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4gMabYKjQ8x0hjxT6mLcqUafCEJxhjCa5ekvTHeL2ABg&oe=6A119A3A"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-43.png", "id": "1737986793508478", "uri": "https://scontent-sin2-1.oculuscdn.com/v/t64.5771-25/491822897_1737986796841811_1091258000082558432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=X36d6-wMsXoQ7kNvwEF_xkh&_nc_oc=AdrKjPLEWZj2aRubDgHDqvwFfS-wMWnBG1cMHRduM4uuMcPOplUqpqK5l4iC7QSTx8k&_nc_zt=3&_nc_ht=scontent-sin2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af58w9rxcWSMvaAMIHjRnzscB35rLFlm6c3TQcIjMzXCfA&oe=6A11A4C6"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-10.png", "id": "1799763494230126", "uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/499311606_1799763500896792_5636752650751671462_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfLDEXEJ2lAQ7kNvwHuYvQG&_nc_oc=AdrhaOqbR-ETaV4oMarHlqxGdLRXN39ZHAPhSYMQ4njZ2aggsjnDsFepI3q-5F2Sbe8&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4qi69G_QAIDkgqmRTYvcZ8f00ygh_vrHyCEKH9i1VB4A&oe=6A11CC3C"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-28.png", "id": "794450146290340", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/499622354_794450149623673_4025669516105800748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sVHgPYlzUjIQ7kNvwHm2ZZ7&_nc_oc=AdqgF7iKUS9SqqVo-6dggO53p9g4nA0e8tsVZsYwqkHv6hw7eaobEfXwM5ZeiJbUb4Y&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4koG0o_rZZB3QL7V9Zqr2-RonWwSoxKtBcvDtQZTg28g&oe=6A11B450"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Sprint", "keywords": ["tag", "ape", "forest"], "long_description": "Run, climb, and sprint your way through VR with nothing but your hands.\nIn Ape Sprint, you\u2019ll move just like an ape\u2014no joysticks, no teleporting, no nonsense. Use your arms to launch off walls, swing through trees, and scale anything you can grab. Grip with both hands to climb, push off with one to leap\u2014simple, intuitive, and wildly fun.\nPlay classic Tag with up to 3 players, or switch to Infection Mode with 4 or more. Chase. Escape. Outsmart. Whether you're running from the infected or hunting down survivors, the jungle is your playground. Parkour through cliffs, treetops, and ruins in a lo-fi virtual world built for chaos and connection.\n\nHop into public rooms and meet new players or start a private session with friends. No pressure\u2014just movement, mayhem, and maybe a little monkey business. The physics feel natural, the gameplay is easy to pick up, and the mastery? That\u2019s up to you.\n\nCrossplay with PCVR supported.\n\nBecome the ape. Sprint like one.", "short_description": "Run, climb, and sprint your way through VR with nothing but your hands.\nIn Ape Sprint, you\u2019ll move just like an ape\u2014no joysticks, no teleporting, no nonsense. Use your arms to launch off walls, swing through trees, and scale anything you can grab. Grip with both hands to climb, push off with one to leap\u2014simple, intuitive, and wildly fun.\nPlay classic Tag with up to 3 players or switch to Infection Mode with 4 or more."}]}, "developer_name": "Snow Studios", "developer_privacy_policy_url": "https://apesprint.my.canva.site/#page-1", "developer_terms_of_service_url": "https://apesprint.my.canva.site/#page-0", "publisher_name": "Snow Studios", "support_website_url": null, "website_url": "https://apesprint.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category":
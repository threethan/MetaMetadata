1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qCoI-5fzR9hCeTn7zwBLA1lmsebJgKXBptkd58hbYzQ&oe=6A16E3B6"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-34.png", "id": "750935124188943", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499619496_750935127522276_554193967792192376_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oXkrF3mniAUQ7kNvwHmP8dj&_nc_oc=Adq36VhJj6Dobwq56h-n-rv8QvcXWOvjxLDN35i47q_j77Js9PgXnh6hJoHifEF-anc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4BDNNf0f3-Nh62oQUFovVMFEA4rGUkn0hzV3fgetlmUg&oe=6A16E03A"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-43.png", "id": "1737986793508478", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491822897_1737986796841811_1091258000082558432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vWDqVwH0FHsQ7kNvwH9RwSC&_nc_oc=AdoI6ADpKOVQLOnqZsq5yNkO_TpKBMG5FEaZojdg1OJitc-VCz1DSLGLup4ZafzoG-0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6Fb8nfNvz-Uq8IgmCK-usWgiRz6ibJuB49tK4gJqqGqg&oe=6A16EAC6"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-10.png", "id": "1799763494230126", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/499311606_1799763500896792_5636752650751671462_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8m8JTSLl-G8Q7kNvwF1uvww&_nc_oc=AdpYylTZ5d8q3Bhi1qTXk3CTFeizJjvw7evuLjAupztO1uKsbBvZ-hqErFolDtkXRhs&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4DQ6WPTHOObc39IdKLVLIOFro1M71WED2vphRkTuVh6g&oe=6A17123C"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-28.png", "id": "794450146290340", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/499622354_794450149623673_4025669516105800748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vYwgu2p2f5gQ7kNvwGkdOXx&_nc_oc=AdrqSPMZt1UrrIs-DZM-Bk6M7cycqTTlRquidJn4RWqlXg85M0vscHbP43k31pEqg2g&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Pw4YFstXboO9EmeUjbpD7j-fzAmuLDq-iSDTn6VmiVA&oe=6A16FA50"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Sprint", "keywords": ["tag", "ape", "forest"], "long_description": "Run, climb, and sprint your way through VR with nothing but your hands.\nIn Ape Sprint, you\u2019ll move just like an ape\u2014no joysticks, no teleporting, no nonsense. Use your arms to launch off walls, swing through trees, and scale anything you can grab. Grip with both hands to climb, push off with one to leap\u2014simple, intuitive, and wildly fun.\nPlay classic Tag with up to 3 players, or switch to Infection Mode with 4 or more. Chase. Escape. Outsmart. Whether you're running from the infected or hunting down survivors, the jungle is your playground. Parkour through cliffs, treetops, and ruins in a lo-fi virtual world built for chaos and connection.\n\nHop into public rooms and meet new players or start a private session with friends. No pressure\u2014just movement, mayhem, and maybe a little monkey business. The physics feel natural, the gameplay is easy to pick up, and the mastery? That\u2019s up to you.\n\nCrossplay with PCVR supported.\n\nBecome the ape. Sprint like one.", "short_description": "Run, climb, and sprint your way through VR with nothing but your hands.\nIn Ape Sprint, you\u2019ll move just like an ape\u2014no joysticks, no teleporting, no nonsense. Use your arms to launch off walls, swing through trees, and scale anything you can grab. Grip with both hands to climb, push off with one to leap\u2014simple, intuitive, and wildly fun.\nPlay classic Tag with up to 3 players or switch to Infection Mode with 4 or more."}]}, "developer_name": "Snow Studios", "developer_privacy_policy_url": "https://apesprint.my.canva.site/#page-1", "developer_terms_of_service_url": "https://apesprint.my.canva.site/#page-0", "publisher_name": "Snow Studios", "support_website_url": null, "website_url": "https://apesprint.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2
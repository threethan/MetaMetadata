1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEf8W-VWJ_NvE08ah_dDUBDssGU95iAyQ60J5w806wh-g&oe=6A902DB6"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-34.png", "id": "750935124188943", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499619496_750935127522276_554193967792192376_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aQLc9OJvCpwQ7kNvwFM-d_n&_nc_oc=AdodjXdXkTsSQwz5NXVFOI3uwiaJBUZ6e8XcxOlDeRdKfzPbqqxwwfTkRnmo6kji5Jg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHWrMli7dDTH5tfKMfeQtRODkXbHONP7fX7Y1nH-cX4Yg&oe=6A902A3A"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-43.png", "id": "1737986793508478", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491822897_1737986796841811_1091258000082558432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk5RMegvfOgQ7kNvwHUzfod&_nc_oc=AdqqEjVdfojWzgAJ9Gwb-RjR1Uk5m3LierQ192qGK8EHA9_t0hV2VKcP7QjI4QNCYF8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHj_P2EmWXWB4sXhFeEGP61pnfQGztBhAvevMh8krR_gQ&oe=6A9034C6"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-10.png", "id": "1799763494230126", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499311606_1799763500896792_5636752650751671462_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BF-3TSjwA-UQ7kNvwGfJL4S&_nc_oc=AdoHoC_dLYFtmhl-02svaPQfoB1xmvtD3As8re7kpyqAcvC_YsAJGcr7rnQa7EtmFl4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE6LMN0FC4EYxpfeX5ZzTl13zm3NwHAA5EpP0wmFldzLw&oe=6A9023FC"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-28.png", "id": "794450146290340", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/499622354_794450149623673_4025669516105800748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3TiVtnBaXSoQ7kNvwHYGt3e&_nc_oc=AdqjyV2pKezPxUM176AYLvx-YOoKsJK4hf3mD2gx9GglLsDdAR_NTR366OmUrTR2osI&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEYqF52ohjzpKc6iy1Kqbna_9x0JXZwU_X5uNntdZIS9g&oe=6A900C10"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Sprint", "keywords": ["tag", "ape", "forest"], "long_description": "Run, climb, and sprint your way through VR with nothing but your hands.\nIn Ape Sprint, you\u2019ll move just like an ape\u2014no joysticks, no teleporting, no nonsense. Use your arms to launch off walls, swing through trees, and scale anything you can grab. Grip with both hands to climb, push off with one to leap\u2014simple, intuitive, and wildly fun.\nPlay classic Tag with up to 3 players, or switch to Infection Mode with 4 or more. Chase. Escape. Outsmart. Whether you're running from the infected or hunting down survivors, the jungle is your playground. Parkour through cliffs, treetops, and ruins in a lo-fi virtual world built for chaos and connection.\n\nHop into public rooms and meet new players or start a private session with friends. No pressure\u2014just movement, mayhem, and maybe a little monkey business. The physics feel natural, the gameplay is easy to pick up, and the mastery? That\u2019s up to you.\n\nCrossplay with PCVR supported.\n\nBecome the ape. Sprint like one.", "short_description": "Run, climb, and sprint your way through VR with nothing but your hands.\nIn Ape Sprint, you\u2019ll move just like an ape\u2014no joysticks, no teleporting, no nonsense. Use your arms to launch off walls, swing through trees, and scale anything you can grab. Grip with both hands to climb, push off with one to leap\u2014simple, intuitive, and wildly fun.\nPlay classic Tag with up to 3 players or switch to Infection Mode with 4 or more."}]}, "developer_name": "Snow Studios", "developer_privacy_policy_url": "https://apesprint.my.canva.site/#page-1", "developer_terms_of_service_url": "https://apesprint.my.canva.site/#page-0", "publisher_name": "Snow Studios", "support_website_url": null, "website_url": "https://apesprint.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2
1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL8OztpKHfvGTgJLV8SqGDWahByFavakfnq9xmk7CiHMw&oe=6ABD00B6"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-34.png", "id": "750935124188943", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619496_750935127522276_554193967792192376_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E4euRhjHkhgQ7kNvwHvs6Zc&_nc_oc=Adoku9m9o4dewzlQXJbxYaltU8lcZQepylHuBjLC69KLhqgQDKvkdFMvO5r9hMoJets&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIgdYednedprPzaxizzttQK4CcXuO2z65kcfHfHcmvQ-Q&oe=6ABD357A"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-43.png", "id": "1737986793508478", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491822897_1737986796841811_1091258000082558432_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t7DeF660WN4Q7kNvwGzM0RC&_nc_oc=Adqn2RIptaMTCBRghqJDM1nW4qIRYPyYjS5Q8Hse8bbWJX_ZN77DwlLOwUHKfukBxRg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIjsDNjIhDzPru7h1XxmDyQBpnEARQvFN47LTC8C4vPyA&oe=6ABD07C6"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-10.png", "id": "1799763494230126", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/499311606_1799763500896792_5636752650751671462_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T-TM5H6zrxIQ7kNvwGu2u2H&_nc_oc=Ado7YBP3TdPnVkxs_9QiHteimWlXjSk9tQAtHsNKn7HLuCfMB_y0JGqya3UTml2QK88&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL_3zRpab49CnzaP74f0AGn1XQ-EJdoxicaKGk-dO1u8A&oe=6ABD2F3C"}, {"file_name": "GorillaScene_Custom..._05.08.2025_00-56-28.png", "id": "794450146290340", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499622354_794450149623673_4025669516105800748_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6siNOb-acIoQ7kNvwFfu-Yy&_nc_oc=Adr9sC2PJSQ6WK5ZTcmnMM7Q0cnn5HBe4w2mvpBGND-pqfFc0QXjh_GmM7IpW9hqdhg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI9b7BfKm7sr19F8Pn_PnMXtOSG2TXHAVVaFEWVEigHoQ&oe=6ABD1750"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Ape Sprint", "keywords": ["tag", "ape", "forest"], "long_description": "Run, climb, and sprint your way through VR with nothing but your hands.\nIn Ape Sprint, you\u2019ll move just like an ape\u2014no joysticks, no teleporting, no nonsense. Use your arms to launch off walls, swing through trees, and scale anything you can grab. Grip with both hands to climb, push off with one to leap\u2014simple, intuitive, and wildly fun.\nPlay classic Tag with up to 3 players, or switch to Infection Mode with 4 or more. Chase. Escape. Outsmart. Whether you're running from the infected or hunting down survivors, the jungle is your playground. Parkour through cliffs, treetops, and ruins in a lo-fi virtual world built for chaos and connection.\n\nHop into public rooms and meet new players or start a private session with friends. No pressure\u2014just movement, mayhem, and maybe a little monkey business. The physics feel natural, the gameplay is easy to pick up, and the mastery? That\u2019s up to you.\n\nCrossplay with PCVR supported.\n\nBecome the ape. Sprint like one.", "short_description": "Run, climb, and sprint your way through VR with nothing but your hands.\nIn Ape Sprint, you\u2019ll move just like an ape\u2014no joysticks, no teleporting, no nonsense. Use your arms to launch off walls, swing through trees, and scale anything you can grab. Grip with both hands to climb, push off with one to leap\u2014simple, intuitive, and wildly fun.\nPlay classic Tag with up to 3 players or switch to Infection Mode with 4 or more."}]}, "developer_name": "Snow Studios", "developer_privacy_policy_url": "https://apesprint.my.canva.site/#page-1", "developer_terms_of_service_url": "https://apesprint.my.canva.site/#page-0", "publisher_name": "Snow Studios", "support_website_url": null, "website_url": "https://apesprint.my.canva.site/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2
qVeYQ7kNvwF1cQmr&_nc_oc=AdroRaFtxCL4CkjBNyd5_-Nk_m4a4ZiBAHEKX4S50vSCRvOS3FlBum79isAPNuo8QMg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7kr_61hrq5oaiyzaQ47nM0QxwxgmY-h30RP5_5zmG71Q&oe=6A047C75"}, {"file_name": "sc5.png", "id": "3272594143033752", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/39031461_3272594149700418_4182261214800143932_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mtsmUDrm4pwQ7kNvwEpMG7u&_nc_oc=AdotX1oPFkNUNNmsFfm8D2vn2159QLzzwfM5pKKS5kqIc4cDnFWc1QFV9Odjoe1Ild0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af59pCdTgylVQmI9RyWtfPTVqu9FZTkf9vfDsEGwwieNRQ&oe=6A046904"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "landscape.png", "id": "1860439444374587", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974777_1860439447707920_8135809563305861195_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aHeNdi0vlz4Q7kNvwHOk8PE&_nc_oc=AdpvCVj1MvlAU0_etbApvnmI9aZpDW5qwRgqUapmxy6iEo5tFyb2ZgLtyh7ocj5FTpE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7VouKPNFFcmHT8rdwFFKRT-wcB4U0UQOEjhSp9agWpRw&oe=6A0495D2"}, "display_name": "Basketball", "keywords": [], "long_description": "Step onto the virtual court and experience the excitement of a Basketball match in the immersive world of VR. \n\nOur game offers thrilling 5-on-5 basketball experience that brings the sport to life like never before. Whether you're a seasoned player or new to the game, this VR simulation provides a dynamic and engaging environment for everyone.\n\nChallenge yourself by going head-to-head against AI opponents in intense matchups. With three difficulty levels to choose from, you can tailor the game to your preferences and gradually increase the challenge as you improve your skills. Beginners can start with the Easy mode to get accustomed to the controls and gameplay mechanics.\n\nImmerse yourself in the cool graphics and lifelike animations that replicate the fast-paced action of a real basketball game. The VR technology adds a layer of realism, allowing you to feel the intensity of the game as if you were on the actual court.\n\nThe intuitive controls make it easy for players of all ages to pick up and enjoy the game. Navigate the virtual court seamlessly, execute precise passes, and take accurate shots with the VR controllers. \n\nWhether you're a basketball enthusiast or just looking for an exciting VR gaming experience, our Basketball VR game delivers an authentic and entertaining 5-on-5 matchup. Take on the AI opponents, choose your difficulty level, and let the virtual basketball court become your arena for thrilling plays, epic dunks, and intense competition. ", "short_description": "Dive into the immersive world of virtual reality with our Basketball VR game. \n\nExperience the thrill of a 5-on-5 basketball match like never before. \n\nFeel the adrenaline as you dribble, shoot, and score in a realistic virtual environment. Compete against AI opponents in intense matches, showcasing your skills in this VR basketball simulation. \n\nWith cool graphics and intuitive controls, this game brings the excitement of a real basketball game to the virtual realm. \n\nGet ready to slam dunk."}]}, "developer_name": null, "developer_privacy_policy_url": "https://artisoft.pl/policies/bb_v1.html", "developer_terms_of_service_url": null, "publisher_name": "Artisoft", "support_website_url": null, "website_url": "https://basketball.artisoft.pl/", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_dev
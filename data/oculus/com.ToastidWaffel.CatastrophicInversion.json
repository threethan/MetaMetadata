04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXVQCnAJ4AcQ7kNvwE9aLNN&_nc_oc=Adqx68SJUTSSRw7KJZNrmxg3U4zaQp_D8LZFnSyMUoeYQuc9WhNIE57L5AGkoiOVPM8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6I-_hwkODPwcmJPu8t9Jkpcv0JXQNDcnzT2juznGxBew&oe=69FDDD70"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdjRrzY4T68Q7kNvwFzXwIe&_nc_oc=AdqsEGGn1-sRS71rkM2zkW0qggS42-AewnKeeN8C2Md515JRE7b8OuwFHtqsKhcYEn4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70cZrMNEYGsBWRPw4mhS8gAgBsEhw6m6Bu7mlHDV8ZlA&oe=69FDE98A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5L5OG8apcj8Q7kNvwHH4lW-&_nc_oc=Adrpz3eYbQ77yFZpamoSoyWI5QvJD6RcN55obRdVGHqYhN5w0EHmXfrEN6WGVFDKkC8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60JTm-zMDcv_MqvdVIt_EM9LceqHr0Hb-3IQtd-2mf7g&oe=69FDD8DA"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eonESpkvGGcQ7kNvwH_XLGg&_nc_oc=AdoIGyrtGA4B-IMH_nWKCtqcWupEdeDwGqg6aaaSZG4AjqfzTLfaoNbSgw9ZSgJdJQA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iqdZMgVyQCK1Lvai9_uT2zkd3kwb4eSLErICk0XEA1g&oe=69FDD706"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-K_h7-c3EQQ7kNvwF_kIdh&_nc_oc=AdqEAwPpeWA1mMXZA822Wqtd_T2ys10X600TTZKLQZ4yRNwBxI5uTlO4ik3bv9suorQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5HUet8x76leGw-ecFvSB4n8gDiM52hqXgxA2s5GAVVcQ&oe=69FDF18C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
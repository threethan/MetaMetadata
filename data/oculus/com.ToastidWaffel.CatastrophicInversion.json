04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yXakMxafLR4Q7kNvwF8OU9B&_nc_oc=Ado4RXMLgwc4K3mGcFpF_8PXLygXfGnRmdhFCpySeIy0rvghSzOmUl0zJo_2cWAJRlk&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2sKi3EN3MUlRLaj5sH0IHLDCeysgBlu1sQ5zpMud1Rdg&oe=69EF5CF0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_8NkIUEvmYIQ7kNvwE2dngm&_nc_oc=AdpeDCxi8cGjSiIqU8Y7uRhYLiy_uKhjHQH3EPgUnsDw58pXFcKDFpTIcHu9Q0dvoCQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af13XUHEdiEcIJl5qzC4EpC9p6l1aALpiEA874pZaQvvrA&oe=69EF690A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0n9HN3KQt0Q7kNvwHzmVq0&_nc_oc=AdpqCPR1A-5z0DxVBzjzwSn-0g6rjrW9GUrk8Kn-XSFXSO_R83-RnDrPevdCXd9_cWc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0HRlOFzndVBfzpVbJFqb7dISeEIVBvgy7tbR_81JHyuw&oe=69EF585A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jrfra4yon_IQ7kNvwFPeKM4&_nc_oc=AdqvELXc638anUkD_lCeSvQwXffDZ58ipbyP0ncJT6rUuGJKu4HQHSIR9InowBhd7VQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2WIu9d63fD6dtU0AhmOLl-PbZWKVZnV2y1h5r0xhvztg&oe=69EF5686"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VR2oBpjVY1AQ7kNvwHlLAmk&_nc_oc=AdoTbpTztVJyFNycD2vsYpURg1utPVIKyjAXTQY5Xg4ty8GJ23xH3q-AYHzl3he61js&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2lExM7EeAelIWaTiHNnuqsbvJsHT92w9pUdnExLSqemA&oe=69EF710C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
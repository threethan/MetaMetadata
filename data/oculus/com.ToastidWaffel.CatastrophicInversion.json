04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9THiI1zVn2MQ7kNvwEX3_9r&_nc_oc=AdoTNcOmlfeDk6wPBJrr-UafPznx62DvSl4jab6ZwJqEcXcpTf16aoAGPctSLRiYTJ0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2-5iiGPoOwXQ7Im_3-YJfJjT2-Z_MiR8Zn9giiqtKZXA&oe=69DB9670"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5nXpgAG5v8Q7kNvwGartm_&_nc_oc=Ado4a5jez70ftFx3XqTGLj7ruSeNKbFEDes5B4wtSAhSqd3gYYK-nRAe7gNA1pYNgCg&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1lcznkHt48prxKPZyVRS4qcJNh_3Vd2d72ATQGLFdLbA&oe=69DBA28A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FIg6S46OfrgQ7kNvwFtR8b6&_nc_oc=AdrwOr2W-tva5C7mHT5MTtyPhTyUZnaMbRPKMZ-YlBfOEE_ItTLBXMmxL0uCr49j7fE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1MBxXTOVcbmmS6PlwdPnOk9qQgpszTHUWfwSs0dcZN2w&oe=69DB91DA"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CJh6JWjcYpAQ7kNvwHQlTXH&_nc_oc=Adod56VhPqZ2UEuSX2lrrYQWBm0sQzZku6Cnd2cVvPpH5zSgeg7FZkUFQYBRYlS_qJU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3tuGDziE05QkQtyrrRQGMhLgXK-DLAM7pCVvjhNtqTyg&oe=69DB9006"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLxYLPSTbVIQ7kNvwHyD3C4&_nc_oc=Adres4VxLZ_Ol8ADzGiw7RV_HH2lgFxAD4RZ05Z1vNFOGjKIYa6f3TL2g4TEQh-Iy7Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11NK428Zcf7H2LKsydp3H4F1OpoHMo1gGAKkKqMSgMhQ&oe=69DBAA8C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
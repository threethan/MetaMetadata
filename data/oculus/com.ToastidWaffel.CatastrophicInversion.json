04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C66H7P2CiAQ7kNvwHNOwIR&_nc_oc=AdqW1Fo5BIqqV504Mi7MS9ZkbNxfU8VFDtuNx5zvdyE793dk4DQu9NT4i1PbaouLtpw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPY4x4OyhvHuMF6H8Z8gzfttKput4440v81tcIe-Au4Sw&oe=6ADDFC70"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPuX9oQIBZUQ7kNvwEqBi_p&_nc_oc=AdoXPQZLCXNkqtTRMHNbetstheOVnIYh4M-YsNzY8HEAfbJBuHN3PMauFJn7cady4tQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMAXRm3ySfH2wOg3Ds1K0AdSoDjiXLu4rpgk89q3g4HEw&oe=6ADE088A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7hF9ejsL0gQ7kNvwF366Nq&_nc_oc=Adq_1oPMWBvxiM2jvNVsz48ZugBBcqo1_ZMUxyk9m0bt-Fl26zHjLqWmh8-dRvKSRyQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdXmt-sTMkPOxIH4Z8hUDK-DfJhwffarjBW6AWaq8mvQ&oe=6ADDF7DA"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwNkhLI33_MQ7kNvwHNeOMb&_nc_oc=AdqMFA1DVPJ2nY93wPlrC6i1vXhD51L-SLsq066rln-0Lm54kaCPVy0QL72ST_dWZKE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNYCVucdYuYCmlH6dLOYS4QDR3YXem9qZM8rc5_Zb-AoA&oe=6ADDF606"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBSXEchpBwEQ7kNvwEYL4D2&_nc_oc=AdqoI-lRJavgDJsKlL0OCdnGgIVNqBgRjBkCFeHlF_2OpLwTlbYpZm1f-tF4AcBnges&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-_wbjb7TuD7J7eK2SFVXL7WHW3q0dpohLECwKj0I5Lg&oe=6ADE108C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
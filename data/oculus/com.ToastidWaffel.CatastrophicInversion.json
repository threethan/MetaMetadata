04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyHdNpj6pm4Q7kNvwFWFan9&_nc_oc=Ado3OZZJ5w0b0aL_14FdkCKiiepfYqrZpO1lmZzMGxumq5fP1o1anGpm0k_jCiLD3_Y&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhsYuq7EWer9tDRY3eA39UMqxK_Rys0--IA4GmS3DwFw&oe=6AE34270"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ByFFWY2OCWIQ7kNvwGzA3TW&_nc_oc=AdqVOwD8tX9VsZuV8XIBPYa_3hyJ36QDK0u3ty6VXRKE_7yLghYNtxuqyedLmGAyVPA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPASu2-eY4_kYGAnGRoXauWLhuX0-QHlCTuVgUJvEPEBQ&oe=6AE34E8A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPYC-tJk1KQQ7kNvwGjcWBS&_nc_oc=AdqdgITF-o55OhXaE8yTQh62p44JDmEPs634La2J8W--pBT3A0_kes6IOrBUV_rm0FM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP4DNPGnMxbTxWFF2k5FRtamSwibofWRxnftsD1Og1UOw&oe=6AE33DDA"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brd3xKiBQo8Q7kNvwHGZje8&_nc_oc=AdqctKCwpdOi-RnnblsBTohM2nlnr8L7oKK0ML-97AbgRY6vZabt9A1cLFWXQALGccI&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHlphTHh7t0QX0VnH7zrAiA6Z3IyWuLMPUIkXceE2yuQ&oe=6AE33C06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwZX0oKh3u0Q7kNvwEW-dsc&_nc_oc=Adqp1Z2k23CHvPu2jWrnpaOYgRjCT2sodft7MWhep7vRaOIqGjAJiSRjOqo57W58HZI&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOD_7Ix8kUWSLZ0Suk6Iajq2KKhtIJINnERNxTC3Buacw&oe=6AE3568C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
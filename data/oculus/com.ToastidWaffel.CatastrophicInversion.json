04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSLQB0u6QMgQ7kNvwEPJMyd&_nc_oc=AdqltucmadggffghNw17XJeDPT6dEww7BrdW-XiJ5SJNr5jgwhGET2wrMFqpGIJJvIQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Q6ZD05YFZM1q5YYjCzmI3Etelm2ejmacHKWUEN_6j5g&oe=69FF2EF0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdjRrzY4T68Q7kNvwGp1WNk&_nc_oc=Adojxlftlb4z0v1m719eNLZ5ejqRp7H0dHcALc-dD3InU9ueT2BSIjAUhh_zdLrW00w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5EFg_ISsx7O2U_7qXT2DjuFRJ8emQ7eyD00736vG_SJg&oe=69FF3B0A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M4_P624S18Q7kNvwFOWj8C&_nc_oc=AdoZOGKCRT8KRH3JN05eFCPWRj_529VW70Mfi7NAjZk8KgOo3I_HGic5Ypb_xvRKRGs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rzkLPgE0mD2HfcbwlUJxvBedUj2OkHAIAFJbabDqwBg&oe=69FF2A5A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWdfZsOcSVYQ7kNvwEudn5I&_nc_oc=AdpWDHOvNe9baePDadVMUNOM0zSWi9pK-dzfM6721ala2tLFgDLSSU7GjezvG5dMG-0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nrOmMKqYhL4k2nXPuaJQgoTEGVY10oioBvxHglmOv4Q&oe=69FF2886"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B-K_h7-c3EQQ7kNvwGyUWNQ&_nc_oc=Adr9JDOwDjI60-KFCNFs8mjhjNQUqLQDqjZRvBLmoSxVgiHT8iQ1AI9MB-T54DHffF8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7pRHrH7m4P0KX9QJGaZ-HLj2h4huGv2Atg6efLmKrc9Q&oe=69FF430C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
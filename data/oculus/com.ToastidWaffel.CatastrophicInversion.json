04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kY5MP0mjHmwQ7kNvwEQGZ8u&_nc_oc=AdoDozr_66zDVCCnaY5gQBwFhMSx4-T52jjRB7kvWoUGDN0oPtHJ6EIZIg071xHpn6I&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKN0qEwYxpCJDWsuxqP0MrUHmzFM-jym-5tllafWR5zVA&oe=6ABA63F0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lz4ftlgMNNYQ7kNvwFaBKUZ&_nc_oc=AdqV7Ps5zxKjoaP8zE4Cj-yHU7z-BtEhgdIRavOVHqwu41DlMRna0lqP2ovRwNoJPT8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIpyVAmifmw4TvkODv5ZfZk1PrZqVBuSozinTYHtGB0dA&oe=6ABA700A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aLy1lV2euEQ7kNvwGtT5Pp&_nc_oc=AdpINv9OEMLtnfFeZjFzSMi8J6GNBx7xS3NMOsavOHlo6yEogGnbCgnCiBSWDBKsTM4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKaE4g4phtI0C3QvEMdyVF_F7EGau36ERaNRkEnObkFTA&oe=6ABA5F5A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zfBdQAXYlzAQ7kNvwFC7W-X&_nc_oc=Adq9FKe1pbKc8uQ35OqoBKzt6ukOcZ-_gw7-NegwZbHyLkuefh0Cfw6ccwLWg4qjLVc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQICkyE3iY2q9KgUXLIq5OU-SSuAhn8xZtAF7i7XC6H9Wg&oe=6ABA5D86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s59aUbyiIlQQ7kNvwEi_r-l&_nc_oc=Adrnb9O4yrFzdo66ItG04_JsMTc-Ei64LwvAAillK42n6xfRpg_bEYQANmbe4zdl_q8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIusYcn1XQTYPHsO1V49oGXaRKubYC_vajGjDi53gokbA&oe=6ABA780C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
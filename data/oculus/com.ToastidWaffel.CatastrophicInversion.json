04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hSLQB0u6QMgQ7kNvwHCOzU4&_nc_oc=Adr-zzpH1ZjQBXlhVxJ35sTfVTtT2KfpZw5vLV4Pqq5UZdN-pOqYxCFjPlKVlJcARhE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ohpSyU-v-Oj7y3-XQMLIebUPpqW0v1amhYZc5bnikhw&oe=6A01D1F0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ldF_Q_2bq70Q7kNvwEtAr8_&_nc_oc=AdpJhtWYrMyDZFypnXWlS-bMjcQ_RgBDMRnPOuRM6MhKnn3d65_o9KtrSPZ5LCAm9C8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5IR1Wc7mhYj_iFNlB_1t5LQmbJEMeFG7eCmN9IchZ1hg&oe=6A01DE0A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4M4_P624S18Q7kNvwGR4sfA&_nc_oc=AdrBzDeK7vxVIJS0LNeHQBZbbmko9X8Qq3y7YaZwKiXdsizEr-_fw4mI2NLKR67-0O0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56foI41ear1loyz0ZUf9LK7wwE7kN8AZc52Mg95UxyeA&oe=6A01CD5A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aWdfZsOcSVYQ7kNvwH5FT34&_nc_oc=AdpVXwMGFTugJr9sj5Co6z4h27lx5ynfNL1-gbSsshsMrVT63WQ05X2WLOBx7k50ERI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6VnYTkUlYnmkoqJFa9UFYkYZ7dMCHfpVBYCWKlKt0XDw&oe=6A01CB86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yK6pBkuuIoQ7kNvwF3CmTG&_nc_oc=AdqDWqhkP5sFE0MbauS1dbyVTAYlpkDH81jz86rIZ0bDnkz9MnLfwP8OOfv7zXSd-o8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uKnXn3b_OtuutqAwYBqP2S6j7zCwx1o_w9Cz8CToUmA&oe=6A01E60C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
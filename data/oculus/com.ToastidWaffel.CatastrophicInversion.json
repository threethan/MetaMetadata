04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl0Tkm6Vq2oQ7kNvwHzwA1O&_nc_oc=Ado6a_IymUdGCch-w6ZaGJIsBxBV__UaAdLFLvmD53bXHpqMmHmq544dt6CMsMleXtQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxX06VI-9t4z55GPRfddro64VVgFdOwnPNcvH3TQR8VQ&oe=6AF34CB0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFvZkPL-WAIQ7kNvwH5qrL_&_nc_oc=Adre_eHSsIjZvNqWDMjYBES3lV8XDDTLu_xmzhSQGHvUWl4bnGo5bDiH-eb5LiPD3Ug&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRx4PSeZy-c2rNzvecDFeI3H4RWTkH-Q6TrImA7IMZuBw&oe=6AF358CA"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Za-m_DswKJEQ7kNvwGi8x2n&_nc_oc=Adr6UvoeViSz5iPxke9tPz4iV1uY7y6Tq04FoJWKs5K_GsglrS1Wru0pq6ogm1Awe_A&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwcetkUsU4cOnNIDsyUXg_PdSwvQYSn5IA6kL1aynErw&oe=6AF3481A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lr-ZaDQ1yEMQ7kNvwFkdp_k&_nc_oc=Adp2E0yziR_wRBpjl4nNHnEe68WBBBjJUYX_L6MP8egI6EtPp5XeCN4LDnHFqIJxlPI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTCZJ4TqnUxFlEoJmnOPsHkMyiC6QftNnmMnVsqpKV_gw&oe=6AF34646"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=givYm9zqb4QQ7kNvwEjb3kM&_nc_oc=AdoTsmnwbz69y5HlkAIVsDGCMFI7Pq7_P5X2Gbhx_K5WODvwb-RNwB2F9ds1ony_GRc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ8p1FWPUUJC2r6AibvdteaLMHWsyWN9cuAccfTe3iv-Q&oe=6AF3288C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
311301", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974465_910105177644634_6351622331534701081_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RFOyUOLl7X8Q7kNvwGs3gHP&_nc_oc=AdlT-CjvEcKBMRGkLQivk2uxMHi_wur9LKXfAD1s2NWYMv6flVvfgrGUETrNbU_jcv4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Aft3Z_QLfNNhTvaJUyg9COp7uhqSjsErgZkEoK5AL77OVw&oe=6999B176"}, {"file_name": "AssaultOnBase.png", "id": "443113451591277", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982544_443113454924610_3676545296571915906_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrrpd-gAZOQQ7kNvwHgeSwZ&_nc_oc=AdlUyNuHcNJNXXGQG6y59RVXttcnuo6plhoVU3oQdqgdbnNF-xc-HRf2ZcDEPc5RNps&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afvhr4NTYKefkcczq-wkSoOhRHynPsc9JSpb1q9uKNmD7A&oe=6999ADC6"}, {"file_name": "Labyrinth.png", "id": "1300393411339063", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38982674_1300393414672396_5204739748604220557_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aCpNzujvzZYQ7kNvwEKeLFL&_nc_oc=AdlUbs5s4BbwdeljzSqQKFBTe7QO7y-j08T58F1K8iuuffpTkTg_KxjIdJYeQV6TcPI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfswlB4szJUVYYtSR2-RCTIokN8g6PydwXJaaU73DgC49Q&oe=6999BB88"}, {"file_name": "Turret.png", "id": "2302745436726053", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974751_2302745440059386_4335230081335400553_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XpTyJ2J6dAIQ7kNvwG21P4A&_nc_oc=Admgt36EH4ftTHOHjl0vJpff5dGFmg7h1TSzVQkvP86mBgosVONazljzEv9L9J3-XTw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afvgt_wUdCIrqjQcK7diIzeQAO8ty9G_16jeA0tlEjpWpA&oe=6999A95F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1083730483394050", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/86615253_1083730486727383_4084447030365624247_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmZ6zQvs9IoQ7kNvwGOpRUf&_nc_oc=AdkiyAKSBvhSOwjSkcMSSsPtTYHMvcM-SiKHrT-rzo4aNeAbvve71UycvYiSoYTz-o8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfulNLsuenxpQTi_qelNcSGDGl_7k-aTHOyZXLIrZ03DeA&oe=6999C22B"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "Catastrophic Inversion is a VR laser-tag experience built for large spaces, like the gym at your school or community center.\nInstead of using a joystick or teleporting, you **walk naturally around the maps**, alongside the other players.\nWith two simple taps to calibrate, everyone is lined up and ready to go.\n\n**PLEASE NOTE:** in order to play in shared space on maps larger than 33' x 33'. you will need to have your headset in **Developer Mode** so you can temporarily disable the Guardian boundary.\nThis can be done in the **Headset Settings** on the **Meta Horizon** mobile app. You will need to create a meta developer account, but anyone can do this even if they aren't a developer.\n\n**Take on your friends** in several exciting locations in a **neon cyber world!**\n\n- One-time setup of a space takes only a few minutes.\n- If you don't have a large space, you can play in joystick mode.\n- Multiplayer is hosted locally and can be done without an internet connection. (LAN Wi-Fi connection still required.)\n\nCatastrophic Inversion is still in early access. There are some quality-of-life updates and much more content on the way, but currently the game offers:\n- Four Weapon Types (Including Powered Turrets)\n- Customizable Game Modes (CTF/Deathmatch/Elimination, timed/scored, teams/free-for-all)\n- Two 89' x 50' maps\n- One 79' x 46' map\n- One 33' x 33' map\n- One 10' x 10' demo platform for testing the Shared Space features at home.", "short_description": "Grab your friends, bring your headsets, and head to the biggest space you can find!\n\nCatastrophic Inversion is a cyber-themed shooter that allows you to turn any large space into an immersive multiplayer VR experience rivaling professional venues."}]}, "deve
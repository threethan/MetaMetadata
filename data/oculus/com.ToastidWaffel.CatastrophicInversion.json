04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qSF690_DaIsQ7kNvwEe-34g&_nc_oc=AdrultErjuUAUrBEA3APQoct4jsqsogewcqrbpFgWNRcDFro0SmDLaWw9h3vcVtdlN8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af02tNLWZ7jrMiiwbrow2kjb0FmA0OdElnTDhGPCtxXbCg&oe=69D8F370"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z5nXpgAG5v8Q7kNvwEmffcT&_nc_oc=AdrMS0Sru7UST5oToLx-mJ2Mv7FgN7u58aMKs_yKmDMqhqbvPpPV2O_ZeoU_fChLk4g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Vw9QYaCPmJ53aurpDy1u2bdPszAc8xM1jJlC50PJFIQ&oe=69D8FF8A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kKzj7JFg7zgQ7kNvwEq1tZM&_nc_oc=AdqTwLXX5GsDx2q-DVFqyeOllNWtXHk10Z6h8HE2pnpSAi0hZCuoHk-FoMollExTgHQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2T-P1OuxRPZPPDG4kdVbvTGd5MB1R6RRWffwcqDRus1A&oe=69D8EEDA"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JUVHPHDTKdsQ7kNvwGsTEYO&_nc_oc=AdqRX7Uncoy_fHZS5qDPD16DKJEfSKe5YOylNSltFVi9WWL9bv5CiKhiyLoaMVqnm0k&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1H6qz4KWTbml1BMAxjV6hgTOgpSfm1ltXgNoKudeSDuA&oe=69D8ED06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SsMc5E2bkQwQ7kNvwFQ5KSA&_nc_oc=AdrKZqB5zLzv6raxvpHPs_CQEj8HkUHnaFWLdr40fiJlCOA4fZ1J_SeycTd2CjBIFIo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3m61XhC5FWgXsE_VedNh8jpWx7_hlyNUhJRm8nA-hxdQ&oe=69D9078C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
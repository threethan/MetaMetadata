04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCtm2meZpZwQ7kNvwEn7cKU&_nc_oc=AdqHawTjv6Kfq_qMPb_dlCg6umcrip_vHnW-UrDFMrye1zRln5UVW2qGH8DLxnpgeuM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5MHojS4b7Ao4Ko4eu5uK1cc7KoJVObSW6htElktQeYWQ&oe=6A05C670"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5LMbem1uv0Q7kNvwFKVTiJ&_nc_oc=AdqStJl4BFGOuam4t_COtZcByNtGMuSqteYVr79F_Aa3ETg_84y28XIX8HtOVRNWD0M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ahk-PR6jIrelr1cQDTAJ1w-EuTm_oe-cbpJs7IGZT7g&oe=6A05D28A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kApg5m2EzO8Q7kNvwHrgS4G&_nc_oc=Adqcxxmz7PMyuDcNy_Yev21yqu8hWk4dJF-9bJNX9Xj9QzLAorF8lAv1Q5ohIzWha-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af75AWum5Vjo0Tz4qe0Hye6qtZzc_QSW9gSx8ssCmyajRQ&oe=6A05C1DA"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEEeg3y8qxsQ7kNvwHhneea&_nc_oc=AdpKIiJkQ30_SxDZ-6GwnQ7sTLT9e7SrdgRWtROjiYshZ9i8r528KRQkhVv2m--P4gU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4KSkwvRyRJSwANbqv9aBRUsGfx2vsLrxktDz_ZhSV_PA&oe=6A05C006"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xst9BMz9vKEQ7kNvwGanRr7&_nc_oc=AdqMb3R5sN34kLK2GryjI9y3AMJmuGwUVzYtrqurssJsxiADm8NKx-TJ9Q0kPXRfk1Q&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qxjQxocsXirw1QlAPiJoUTzB2z8nt0B5wEgcO04hreg&oe=6A05DA8C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
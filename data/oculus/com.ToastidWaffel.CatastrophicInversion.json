04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdA5WNn29gQQ7kNvwGGBSMT&_nc_oc=Adr9j8grXkf69I4tGWmb19ryj8wsdREul6RyUw-t_QJfeCKK0aeo8Lm2Vek1qc9woRs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM3juCRW7UYwln5fZ7_tWr4QdoI8b2womzOxtU_l9xTGg&oe=6ACBBFB0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cytCIlm-_tMQ7kNvwFup-2a&_nc_oc=AdpniyzIsTThrEFJsJQ_oW3onjsepqIn4FR51J35V8zv3nLaGFSKJKg62Gb9MmVgP1w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqFvwgPmkgPadt6ST-6Axwi4laUaRX7kSzTP-U5YACgA&oe=6ACB938A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8iQS0ek4bwQ7kNvwETo0Cd&_nc_oc=Adr-Ggp3gs5Up2XL5SA_7Y_-vh7--MV1NRruHT9FZpx4w_W6FBbJNxC86VKpv-kmgz4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPTOmXfDhXaqa-9RfjhmhReVyRU89sVzJ7FDUSc3tij7Q&oe=6ACBBB1A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-8LR71TyFkQ7kNvwG2r428&_nc_oc=AdqbPidWsWpLKrGUwe9sczvTo20RB27bpTjgJ05u_CVV2NaMt5fC7c-dhYhyrGtbP98&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPKTUnkDBdwBz0SZrqMevJy7ajFKiaC3-uYzAoT2GQXmA&oe=6ACBB946"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=feA7wwWTw_YQ7kNvwGTvxvg&_nc_oc=Adq5ROgUoXvn46HviedP8ice5QUbZR6QbCfknEBDmCe7TrzTo4833n7BfBs7bXlaZRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNKOO4TP18j8c3lHhsPOEOiqIvtobioXLcp1vX9_8Lzmg&oe=6ACB9B8C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
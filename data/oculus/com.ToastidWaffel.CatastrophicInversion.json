443113454924610_3676545296571915906_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NIikczJ7J8Q7kNvwH0tBNR&_nc_oc=Adq9Ua59bR-6hNGWjJUuFWLwzGIAVNBxfYCAkniE41ix2AklAk4sh6bOILtLa0TWjW8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Af0oVaf2AXe6RDsjycpQK_OPG9yn42qvTR0Ond4lGQukeg&oe=69F20246"}, {"file_name": "Labyrinth.png", "id": "1300393411339063", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982674_1300393414672396_5204739748604220557_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPM3Tti3TbQQ7kNvwGXO9Ho&_nc_oc=AdonJDqCQHcO7cxAQ12aLFAeFwH14kq6_VapFhZvqAyLhBWIvPxXwS_XT0NBydu4u6I&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_Af2DGNG2ozGfceYoY-Y-Fjzw13b-QL1kCaxQWc20xK0GFQ&oe=69F21008"}, {"file_name": "Turret.png", "id": "2302745436726053", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974751_2302745440059386_4335230081335400553_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xAwz6Cp0i90Q7kNvwEVt2Qn&_nc_oc=AdrBmz15ODCeZY3uIw7GDM9uELI1K_pmaqBD0y18o-UCfrE3GP1y9IhqAJFXgochrg8&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_Af00YvFaLkUpZOy0txO4Kr40xYE2Zb_jm1iqfLIN89HztQ&oe=69F1FDDF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1083730483394050", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/86615253_1083730486727383_4084447030365624247_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDmJWXJnW3IQ7kNvwGJRX9I&_nc_oc=AdoxPqQY12_ZtAdQcXobE5TCaPvS4_oFebbdP-Cxn8A1MaYvTo1vycH8vi5L3-e_Pi4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3fpNrD2zn8ezKkfqanMOuC-GSgU69p86m_4U5hbKE81w&oe=69F216AB"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "Catastrophic Inversion is a VR laser-tag experience built for large spaces, like the gym at your school or community center.\nInstead of using a joystick or teleporting, you **walk naturally around the maps**, alongside the other players.\nWith two simple taps to calibrate, everyone is lined up and ready to go.\n\n**PLEASE NOTE:** in order to play in shared space on maps larger than 33' x 33'. you will need to have your headset in **Developer Mode** so you can temporarily disable the Guardian boundary.\nThis can be done in the **Headset Settings** on the **Meta Horizon** mobile app. You will need to create a meta developer account, but anyone can do this even if they aren't a developer.\n\n**Take on your friends** in several exciting locations in a **neon cyber world!**\n\n- One-time setup of a space takes only a few minutes.\n- If you don't have a large space, you can play in joystick mode.\n- Multiplayer is hosted locally and can be done without an internet connection. (LAN Wi-Fi connection still required.)\n\nCatastrophic Inversion is still in early access. There are some quality-of-life updates and much more content on the way, but currently the game offers:\n- Four Weapon Types (Including Powered Turrets)\n- Customizable Game Modes (CTF/Deathmatch/Elimination, timed/scored, teams/free-for-all)\n- Two 89' x 50' maps\n- One 79' x 46' map\n- One 33' x 33' map\n- One 10' x 10' demo platform for testing the Shared Space features at home.", "short_description": "Grab your friends, bring your headsets, and head to the biggest space you can find!\n\nCatastrophic Inversion is a cyber-themed shooter that allows you to turn any large space into an immersive multiplayer VR experience rivaling professional venues."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toastidwaffel.com/policies", "developer_terms_of_service_url": "https://www.toastidwaffel.com/policies", "publisher_name": "Toastid Waffel", "support_website_url": "https://www.toastidwaffel.com/about-us", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{
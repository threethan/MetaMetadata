gL_1LNL-wxxhlH6DCLAhsYV2jIqR83JrF-6JA&oe=6AC8EA76"}, {"file_name": "AssaultOnBase.png", "id": "443113451591277", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38982544_443113454924610_3676545296571915906_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJPM4GXTdBQQ7kNvwFfR34w&_nc_oc=AdpxHiVHe92PL1NfWbRAnn9faBsAAjibS_dLD90kvKBRCRbjxViRJF3YfEGvrJmajVI&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOEDPa2FYSMZW9H36ITI6hY45nUDHiuGu-US-1AXe7PQA&oe=6AC8E6C6"}, {"file_name": "Labyrinth.png", "id": "1300393411339063", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982674_1300393414672396_5204739748604220557_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-w0lLjX8QIQ7kNvwFWp1QI&_nc_oc=AdrF0bKPChZQuv49taf6z-CrK0nisOuNUjhz-N40dK3K1ybwdr-0RLYxFp3DRP0Oh8Y&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPf6FaU5ZAWW-dK1dNAEqTYlM7C59KEfDgZkdndsiT7vQ&oe=6AC8F488"}, {"file_name": "Turret.png", "id": "2302745436726053", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38974751_2302745440059386_4335230081335400553_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iQDC3GYynkQ7kNvwH5w4a3&_nc_oc=AdrJzDx3wtl8LSXUGWvbru8BU09tKwpqBTn5eGa0l99Gt9cvMYtyuJEycrdh_Xv6wrU&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQML7oe_qQ6tVzEaa9KHrjMM3_X-dHBZWlQfUYEnsMHqwg&oe=6AC91A9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1083730483394050", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/86615253_1083730486727383_4084447030365624247_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qUkyI6vq2SYQ7kNvwFU_T2z&_nc_oc=Adr0z4XGe6AKCCyYpu-dmXZYJioSpfNjk0oseqKfvgMU9eXOWraiy7hhX2YZwN2E5qE&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_4OBzr-kSaklFDA6A0YAFKwECHfaSME0123620an9TQ&oe=6AC8FB2B"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "Catastrophic Inversion is a VR laser-tag experience built for large spaces, like the gym at your school or community center.\nInstead of using a joystick or teleporting, you **walk naturally around the maps**, alongside the other players.\nWith two simple taps to calibrate, everyone is lined up and ready to go.\n\n**PLEASE NOTE:** in order to play in shared space on maps larger than 33' x 33'. you will need to have your headset in **Developer Mode** so you can temporarily disable the Guardian boundary.\nThis can be done in the **Headset Settings** on the **Meta Horizon** mobile app. You will need to create a meta developer account, but anyone can do this even if they aren't a developer.\n\n**Take on your friends** in several exciting locations in a **neon cyber world!**\n\n- One-time setup of a space takes only a few minutes.\n- If you don't have a large space, you can play in joystick mode.\n- Multiplayer is hosted locally and can be done without an internet connection. (LAN Wi-Fi connection still required.)\n\nCatastrophic Inversion is still in early access. There are some quality-of-life updates and much more content on the way, but currently the game offers:\n- Four Weapon Types (Including Powered Turrets)\n- Customizable Game Modes (CTF/Deathmatch/Elimination, timed/scored, teams/free-for-all)\n- Two 89' x 50' maps\n- One 79' x 46' map\n- One 33' x 33' map\n- One 10' x 10' demo platform for testing the Shared Space features at home.", "short_description": "Grab your friends, bring your headsets, and head to the biggest space you can find!\n\nCatastrophic Inversion is a cyber-themed shooter that allows you to turn any large space into an immersive multiplayer VR experience rivaling professional venues."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toastidwaffel.com/policies", "developer_terms_of_service_url": "https://www.toastidwaffel.com/policies", "publisher_name": "Toastid Waffel", "support_website_url": "https://www.toastidwaffel.com/about-us", "
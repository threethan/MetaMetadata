04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GnFfAA0xqDMQ7kNvwG2pp1U&_nc_oc=AdrKHNY4flDRCKHJPA6NQyNtwIiMU7wlRTljHFftCM1zpsad7O8eP2AIplcQtxjsmSg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Un95WaoyRGKqeTkCyXNgGqOke7p7e2PjiDHTG4MMA9Q&oe=69D25BF0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ki2hdg6oMe8Q7kNvwEWE8GZ&_nc_oc=AdoBnQby5eRNutjVB7LlBCqXhjXiszU4FFm4etLjOoP_xD5l0P3-PrHIPW0iA7FIhJI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0d9Z9tqIkO_UdlWLf838uSf6HCvL4BvbqxWNO7zZHpmw&oe=69D2680A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Oa45nOi90jcQ7kNvwGJkbAQ&_nc_oc=AdqXO4pT5KdWV42ZT0-5Mg5Gk3awIpTURqS2wp-cbY-75_rDdTKdrTrnFoZmwFIQFjs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2MtcL6NnjYlzy_Lg_8xgava0V0wD1saSLqaj6doSHLBA&oe=69D2575A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aEK9bqO194wQ7kNvwEVp4tf&_nc_oc=AdqkHUVOOQNrXbyacM0CqK5ksqcX1r4tyYBmGKWVcsqwO7WVxsqoM4nI1WGB7gq-yWo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20ZyqLGX8-Zbn9KPAW1J-wF3CXkD8B6FP4HgmEI9Irgw&oe=69D25586"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LbTsJslLQMQ7kNvwFPpHOk&_nc_oc=AdovSOukM3YEclqe-BbWJUVCWqaw1cf1zdohOt0OEIwWI2gUroiw6UULv1P1WXkJbhM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1HLRLnP5NBXAa751hjJgqglB4SxSgA9IQ49xrJYyfMOA&oe=69D2700C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
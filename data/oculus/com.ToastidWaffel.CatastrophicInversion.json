04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BCtm2meZpZwQ7kNvwFXOxyi&_nc_oc=AdrPKpjgP4auM845mL4wPoPVa9de7NCN2DngU69V7_YDsV3teWAhE73-WJzqGeMXA6A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44jiy01r59VxGcRuXzl4sskgK1Mi6O7l7Cd3_Jf4uzQQ&oe=6A0474F0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D5LMbem1uv0Q7kNvwF9Qu-Z&_nc_oc=Ado-kFyAjSg0PRr1HOs1hLEJ-2K13FYTEpaegnPLst3ajshS7O-pqgLC16R85hrpDMY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ehkCKcr_UW1d8dQyT5Q5TFAdmHgSI_R3jGnAnjJkNkQ&oe=6A04810A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kApg5m2EzO8Q7kNvwG_LzZo&_nc_oc=AdomProXEWJoGsSQIMCss-9_wX_AaYjEcI7579IKPDdMhW-ubeh2QIi8_G36MWHMZz4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7A3dXBlR1zDW7_2QD2Zq2kVp_LHBEkcyJAWzNqzDsqNA&oe=6A04705A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEEeg3y8qxsQ7kNvwGLSGBV&_nc_oc=AdpOFhubBK_LTkcS1wIHjsnPprqMykdWfB3XASe9qnYBX3P8Re41XTIwMwiwaPoTOZ0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60b3Dw80Ganp5ZQAwwVfuIVQr5FFDAex4AQHLc7Ktwmg&oe=6A046E86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0yK6pBkuuIoQ7kNvwG64Lr3&_nc_oc=AdqI-Nn60gZyq79e7cqRHMsTEHyi0FFkpt6ZlN0w7sYhIhBvgGUzF6tZCv8NNHhHngs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ku7P_cIHexf0k13YrVGhfh5UDxTGzluxFq3MATmF_Gw&oe=6A04890C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
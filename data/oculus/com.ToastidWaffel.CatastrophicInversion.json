04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PTA_7fnVm48Q7kNvwE6yGmf&_nc_oc=AdoNAHZIDSELhureSU5a2TlFcwJzR9eoOMVjsfBV-T00vXGsDuZy0GGVERUIKTrohfs&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4U55ZiYkAm3WvqrLSKOadSKoSYEQI5cm2cGa-y-dddvA&oe=6A1446F0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sxaUUFr_q1MQ7kNvwEmlpYX&_nc_oc=Adps3UY_lZwcT1l3MhwKD15F6TGNN6MpIc1qAtUwbyT3d5OQkrPLt4x1H3tSVitINSg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7w9VCNOr1vfkHf3oCktN-CVx_610tpETp5f8dpXoYGAw&oe=6A14530A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rMa2VkrH_xMQ7kNvwG_qVkl&_nc_oc=AdpJ-YJqgskYNia6uBwBiFfIyX64inkVIhopeKEFtOW05z0JHSEtJ9MjSiYTGFQMuSw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5usMDa5krDxdWMNwvInM6m2q2knUQtxSOg-MpsGRhUYQ&oe=6A14425A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ryv438v6apMQ7kNvwGn1itS&_nc_oc=Adog9aYuYhFDE5EHmhAmunfv-u7p2y6vI30DAWRhjetGXogCseiUpKA4MbImr1J6rDs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6W3uxq4xGFRJ0LdS8NE-Dq11cdS3MHy0hmqrd6X6ot-A&oe=6A1478C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l2R2El11maIQ7kNvwHK2LR6&_nc_oc=AdotBWg0rl-b12p9-zcZRV5lDh4r2YkYb1Ss0nGv-FwToTjJk3RAdlOZQsaY1VPr1bQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Xtm-_wNCnDjEideGNyFIKw4Q1j2gGK904KN9jgXMuGg&oe=6A145B0C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
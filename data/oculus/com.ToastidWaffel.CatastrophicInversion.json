04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XdA5WNn29gQQ7kNvwGfftlO&_nc_oc=Ado_MqfEVyuUdXoHMZBx1tYJ0_Yv6SzIeJk-xCcPOaVKA_gCoeZUVmJYWf0-RP1s2mw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO28b1tFJ_zScoIOvFP2MAGwRF8t1BTWiijViQ5xKtbPg&oe=6AC91CB0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ut9kLqxxdNYQ7kNvwG-kYcl&_nc_oc=AdotFD67yzPt3KpnRkthSDa01xwhGPMpIgbt60V_rYEVRKkG3uCXGTS2Brp32rSsn54&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNlm-CGonmW4eJTnyQ29zy7Q7iU8Yw2gVLLXOPaHecjPA&oe=6AC8F08A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P8iQS0ek4bwQ7kNvwEV6AJW&_nc_oc=Adp40uWBbbJMJMmkVgcC5kZiWImkw2q7yklyMlLMsOJCJShIojXWHulIamEZ_TD3fgk&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNQWPkf-pDrAGWBDO8CSNNHk1I00bOJiHsDtCnoxgWfRQ&oe=6AC9181A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4-8LR71TyFkQ7kNvwE4Tcyh&_nc_oc=AdoJkMhbOi8aRkXslK5PBHU-8kDtGGk0-7g13-YNLULZbYvNYQ48Fe8ZHOwgF2NbSec&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyPyYtkdWkunCa4-tRfd9iIZMFV0PJPPLBh8c57iV8ow&oe=6AC91646"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GuFz372IhjQQ7kNvwH-ZgYI&_nc_oc=AdrE-qPCDixKDrdlLtkw6djMTbKq19l_1Iv_UkcR6-pyCZ1VMLEUyhefRh2shv5kO7w&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPMzHO7_0tn6iUfnHdUosa-Rv5jG9e1L3aqAqHtGMzm0A&oe=6AC8F88C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
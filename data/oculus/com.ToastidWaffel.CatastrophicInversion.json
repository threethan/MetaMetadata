04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ekcq_ZDuxzcQ7kNvwEKXJrY&_nc_oc=Adpq44OX0GmFkVPQapIPcd4uTlprOlJMUTPVDAyJvDzCr3Wmi-DLcYzYaDfrZ2q2vtA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2XcTdke9mv8JqaAkItlRrw2HAcoE_gvopJRVugrTvhEw&oe=69E8C570"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGm3LvLHJuoQ7kNvwG6tVBy&_nc_oc=AdrJrlvVquNGtcAfrSImKMNUvT-Ngx-YYFRIhzEsJ1Xphht4sZUo1cnFzse9sQIBFZg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3Yx4HC_tNpYI-D7JSlTuVteduakavk2tT876WKv6gcQg&oe=69E8D18A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns2tvHdEHEIQ7kNvwFZ7fMn&_nc_oc=Adrf0BERW2fa8vL0ixaB0JiD8XmlolW6rJEzQxu8t85ppT70IJjKVPKfEnLjNYt9nE0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RDQGJhOgzGPboxGbgRzRai6-QdCBgAezg-qERC3Eomg&oe=69E8C0DA"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3CWnZ3c1NcQ7kNvwH-4iUt&_nc_oc=AdqmQYyn4JSXzKKAeSAV3hrr0jtaqXwP05iwanzB5Xg3dKRr8xX163CSH-71BRaRnac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2EVoP-gD_BgNChuzIhMqTtqx60imG_Sv45gkQ4IOgoag&oe=69E8BF06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dRRJd7kBrUsQ7kNvwEjgbzh&_nc_oc=AdpzWlLJqN6UJsx-T9D3QpTksKxKTPKzJQRXdtoMiyX8P6wZhQzaJxb9l822vxD-rAA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2awsikGoSUJ6HSAqVP4t0AB-X2lQHBPK0l6Bv9VQxIwg&oe=69E8D98C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
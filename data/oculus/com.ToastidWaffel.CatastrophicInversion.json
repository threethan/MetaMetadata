04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl0Tkm6Vq2oQ7kNvwGOBtLB&_nc_oc=AdpV48ICQEYFr84IZ9W4skn6G8u4HOYkf_xfCzU3QNNBpBXdVJmLNwoAMTm0XvzTu2M&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQLUKVJCN1ynlw5ytw7QCtVlNG6n5wn4ovwHFGJSwi3Xw&oe=6AF1FB30"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vFvZkPL-WAIQ7kNvwHRN87X&_nc_oc=AdqJ1a5E4cXIQBPxuxkmLOTgJO1YzjTZ0SRdFZh0lKdGrylKYv6TNKwzDcbrGzky5uc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT4xHrcbZec6gHFEcZuDgP8icX61eYbZA-vSz4vFduGDw&oe=6AF2074A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Za-m_DswKJEQ7kNvwGZ0ang&_nc_oc=AdogPYUAhzbBy2KXSJWM5h5Q5qWq7mAgo4wfkzKaF092y-pt9De78tmUvfwk7GoLfdY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUDiA10UMtq_d8XyqkfZwmr3EaXPbp12HjeC1iYbceFg&oe=6AF1F69A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lr-ZaDQ1yEMQ7kNvwGW0C-f&_nc_oc=Adr-wMQa0hFeKqprhKcsKs5ZlHSAlgFY5blZwLo9MB2T5O4-Yt1bu1wnMLc6WPYfwhM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTnCR0dI-Qqb6TMwX526JkuWX08UFcZp7fRhWTA6qnXeA&oe=6AF1F4C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOjNfCI-5doQ7kNvwE2C1Zb&_nc_oc=AdoppidofLheJaS7OXVDwB_h_e4sspWjpvOvaXnJ4IfFVFpNCGst1zZvdCfndamNj7E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyAeubZW98QKNo-yRP5nCuzVGLSyPFSeKoo0dtkFk_Fg&oe=6AF1D70C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2QMVYd7cF0Q7kNvwE6N8V5&_nc_oc=AdpT0RuCWkaPFypD7GcQXNnAOL8cPxeBTU3j4hGa3uDaVJps_QWX-7O3IBAaFrQSVYs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1vOQOw123yFVSTP_oei5o99qQILwV7-p90DiQ-Yo6EKA&oe=69F35170"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ePEbmQ79PxYQ7kNvwE-p3Qc&_nc_oc=Adrez9xzR3wh7yn6hwt4ubc-1fZVJozUxxK7A_JRoRO53f0-_Jh0hP_b8GdrvK6HQus&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0APvW-fvjY1TV3l1Gi7zs6Qz7krP2YD3NXVWS5QiSlaw&oe=69F35D8A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilXyxXgHPKoQ7kNvwFWV3gI&_nc_oc=Adoauda8Pgma1_TdgX8DOXQ5_1Ct6-RGW0h4TNYZTfTtS3M1I2osXsB715gkDlGmZ9A&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2VwRnkG0MzoNMZ64gBWbQ1HRuEcXaSMtlXI_dw35CWMA&oe=69F34CDA"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AZyHuYGF1cQ7kNvwFAiZeE&_nc_oc=AdqyWHdzfQMbUNbMvPG8l8-wbN_2JoJHYR-6Byv2mnE8yWQTHl1HSg4kSEbftqf-ne8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2p5MatGJ0xOwsdmOWyWB0J-2q3utlhTogqP7QgMSaS4g&oe=69F34B06"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNId4CQkeUoQ7kNvwEmjn-t&_nc_oc=AdovEx27vHRn5f6CgyqJ-8ZM2Pr5-z1QMN7xfnVV_dmkDAkXJsSeYJWq3oC0YnZAnY8&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2NOfqcxJIence32w99bI8prieynXHoWkeRELVYdW1rYg&oe=69F3658C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
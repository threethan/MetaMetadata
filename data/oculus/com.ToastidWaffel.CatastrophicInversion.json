gIg8bZupATY1vR1emycWLyx5uQ-BwdVI_F2hg&oe=6ABD0CF6"}, {"file_name": "AssaultOnBase.png", "id": "443113451591277", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982544_443113454924610_3676545296571915906_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pjxe7TEiy-4Q7kNvwFQDM61&_nc_oc=AdrOsC7Qp3_gD2pwmTyXR3_L_D9OpEhBkUOv9hUREuXcGrXGOU9jXnI0MhA70TBp7vA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-LWvSF65gBs-OewfY54XX_pf-zXiYQCp_gqYg4tYgrA&oe=6ABD0946"}, {"file_name": "Labyrinth.png", "id": "1300393411339063", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982674_1300393414672396_5204739748604220557_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K6BaGe9SuJwQ7kNvwF6oUHa&_nc_oc=Adr1rxJMSPjDnxFwzK7tilYGGpSqUIVnIs36uTzPQy5o1qAAh-xkTPfnpE_aXUh8bAM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ4sttP3Nt7wNgPabHbETT22NsiXfpUR1JvZUuzUnBd-A&oe=6ABD1708"}, {"file_name": "Turret.png", "id": "2302745436726053", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/38974751_2302745440059386_4335230081335400553_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lme6EV9jOQAQ7kNvwHW0fyt&_nc_oc=AdqI-aFACPx-QHWuAX38WwJwNUWfZqvChZ8J23Wv1remJCoAcV6bN2NdhMTOVyzErqU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoVRCL1q5GhWxkmrXifhSLmmWqEt9KAEQlJ9XO83PDig&oe=6ABD04DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1083730483394050", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/86615253_1083730486727383_4084447030365624247_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=skGdC79q7ZwQ7kNvwGGvDMi&_nc_oc=AdpANmnkJJhvzdGKu_Kk3Bi9thccHcGn8MQhZJb2BTzXu88H9O4t3bIfwpo-iJo8lqA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKCTZ3eJIsjEvsDEAaDVWZYwcKkdpKZBpXF4ZDe1qbLjA&oe=6ABD1DAB"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "Catastrophic Inversion is a VR laser-tag experience built for large spaces, like the gym at your school or community center.\nInstead of using a joystick or teleporting, you **walk naturally around the maps**, alongside the other players.\nWith two simple taps to calibrate, everyone is lined up and ready to go.\n\n**PLEASE NOTE:** in order to play in shared space on maps larger than 33' x 33'. you will need to have your headset in **Developer Mode** so you can temporarily disable the Guardian boundary.\nThis can be done in the **Headset Settings** on the **Meta Horizon** mobile app. You will need to create a meta developer account, but anyone can do this even if they aren't a developer.\n\n**Take on your friends** in several exciting locations in a **neon cyber world!**\n\n- One-time setup of a space takes only a few minutes.\n- If you don't have a large space, you can play in joystick mode.\n- Multiplayer is hosted locally and can be done without an internet connection. (LAN Wi-Fi connection still required.)\n\nCatastrophic Inversion is still in early access. There are some quality-of-life updates and much more content on the way, but currently the game offers:\n- Four Weapon Types (Including Powered Turrets)\n- Customizable Game Modes (CTF/Deathmatch/Elimination, timed/scored, teams/free-for-all)\n- Two 89' x 50' maps\n- One 79' x 46' map\n- One 33' x 33' map\n- One 10' x 10' demo platform for testing the Shared Space features at home.", "short_description": "Grab your friends, bring your headsets, and head to the biggest space you can find!\n\nCatastrophic Inversion is a cyber-themed shooter that allows you to turn any large space into an immersive multiplayer VR experience rivaling professional venues."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toastidwaffel.com/policies", "developer_terms_of_service_url": "https://www.toastidwaffel.com/policies", "publisher_name": "Toastid Waffel", "support_website_url": "https://www.toastidwaffel.com/about-us", "
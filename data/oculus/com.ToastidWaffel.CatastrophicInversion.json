04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrOZA5j5RHsQ7kNvwGpFmJf&_nc_oc=AdrruSRrHIut8AgQsgkASqipIm00gkZFGr9HoXaxjHRr7tGJNgScCeRDSpvrNcraf7U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzF8mo4pHCiR_WA-UFQSQy6t8zTMD2KgC5CSBPPZgzwg&oe=6AC28530"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytApZmIc3W8Q7kNvwECI1yt&_nc_oc=Adqzo8fIChj1YMPPa99TmndrASRgtOqayu-atDcGvKIRxy5VuCmrKA4NUkahRh0-mFM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPwY5ZNIbq-BZr9meLVumIg_v5cSRVhyGcBWhfMXS42Lg&oe=6AC2590A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zZvxU6X4YcQ7kNvwEgWIt8&_nc_oc=AdrRk5tssEpLztKqt-D1mAnPPD9yeYqN0caYt-JaYCYruXvvgZ8iSNl9fFTrxNU9xFg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNa3Mq3fhP9EGH9FJUzRrz6F979CVnDmqb4dorDGw9psQ&oe=6AC2809A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCkAijdms3MQ7kNvwF4q3gg&_nc_oc=AdoT1PMFVsX6Gg9Nb1AetMvVBgJRxR9mmZ3cyFfFhrbHN-6pNyjIIIpCaJ7vVryR3SM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVSrb4NAU6K79v6yXUcLggqhp4rVg0rNCKbEqfs1qzzA&oe=6AC27EC6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQhtygGjiQAQ7kNvwFDy4Ki&_nc_oc=AdpH4lgDCQcAvNSOC0o3D68zeia_OiNHYxVa3XLUQIv4J4vQz4pVRCKpkFdQqflgCyU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMTzX0KTGYClOoeMs-UZ15UhCp-iB4hT6S6a2q9VvrSzA&oe=6AC2610C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
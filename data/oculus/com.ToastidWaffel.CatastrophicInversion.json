04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Tl0Tkm6Vq2oQ7kNvwFS2pxx&_nc_oc=Adr4odjc86q187vgCoZH1udg9_eek3SzFnI-f3nz_GE5y_O8NQI7lisZSbh98cXd3Gc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSxnTxhqi_eKyeWd82vW7bnap6kIujXw5AfGeRZAmN7og&oe=6AF0A9B0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Vv2KzPClQ7kQ7kNvwEA5MYe&_nc_oc=Adp0__lhiV9hIzWepUfobGwsLkpjdH-XgK0Qz0uT6kObGCTD6g1GHQq3uu4f50XCKTs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRhXrn0InOZCHTF_leKgxixSSUOFQUHNmBzcrb9rbYT2w&oe=6AF07D8A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Za-m_DswKJEQ7kNvwETOiaR&_nc_oc=Adr8pc0db6x1zZ9_C5Hjak-yAmSavdPBKt6DifcO977a2la6jR3gYVdf3TBcKMEhiFc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQlncSWb3HyunXww9wVVoI0VX9oR2cSTh0PrT65wzPg_Q&oe=6AF0A51A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lr-ZaDQ1yEMQ7kNvwG5KdIK&_nc_oc=AdoZ9J0ePyWSGz8vHA03wJoowGejus4mNO_vuR_D9TP-SrAcBwLWkLKoVVyJOtq-6O0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTGKdaeeORddNZulNgU8-RmBYp-4H5g4uL2jSVmVwKgGQ&oe=6AF0A346"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jOjNfCI-5doQ7kNvwFBdjmX&_nc_oc=AdoeFgAxPGBEIXrrhzlO3qEOxty9tixD58PK4WAznd0wnUIrGwNmXhvzh14-xOORz3k&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS_M1iPcVpdr5yeeOOh6N_UJ0iclZiAc8GbVDOj_4FXUQ&oe=6AF0858C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
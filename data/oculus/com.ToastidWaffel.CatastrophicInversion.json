04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cyHdNpj6pm4Q7kNvwFDRBJB&_nc_oc=AdoY6nLjcc24_Qn-P_2Y5cCsFq0MVHPKNH8XiYOgo40iaCM_JYQsFLOVfKSf8j4SmWc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8h8FlFhYLh0Ex8CNi-c_wrVXCZXrhqO9G_VA3ckWrlA&oe=6AE09F70"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPuX9oQIBZUQ7kNvwGNjPFk&_nc_oc=AdrTYRRcnVr0DzTApklb7rGCetFvbqHwZphogGi8TioC522VafDpczZo0-qVBmetkY0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS81-6DDlO6YGG4IryLUx9PSBy_dMUQ9QpW0SNoTWZeg&oe=6AE0AB8A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FPYC-tJk1KQQ7kNvwG1pIvC&_nc_oc=AdqGuLy0SjnnVazzFVU2ZrMnuSNg_ECaSuMcjmXpPvZ7721p9htADX4x0tCO2mGlryg&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNx3n7PrO7g3mHGBcwQM6lPodVejdSr32TUveVrqbwKbQ&oe=6AE09ADA"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=brd3xKiBQo8Q7kNvwG38b3v&_nc_oc=AdofM1CUevjVsqbK-WtVw4iJp0G1Hma5OfRpN6zmETVpVcon5mmdlO_-KsctxWOpGUA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOH7j5Wqi2iJj6osYN_UWTCGTC-GWBJkV8Rcq5g4DhYzw&oe=6AE09906"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9n351p7BcL0Q7kNvwFGobUP&_nc_oc=AdqiuxEzCrIuiEZ9i-pOjpOA87ozEq6LMlE2vGPBu-JrKmbjoBhIxJmOEredbzZddrE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOYnUBEc3VDcZWCGxO3EdYQz_v64XHhD6T5JrztVRKuLA&oe=6AE0B38C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
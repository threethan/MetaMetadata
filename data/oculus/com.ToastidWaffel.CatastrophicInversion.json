04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ekcq_ZDuxzcQ7kNvwFjX72e&_nc_oc=AdqwNt0E4uAKBBuZMnrcjHPNTIDFzA9COweZfo0oVuxeiM8gaQAJI1lr4GGoOPApPN8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0M8QXiamzx2W2hJO5nHA0kj2ljfq6hR68g6rq-kAXAQg&oe=69EA16F0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PGm3LvLHJuoQ7kNvwFmZUF0&_nc_oc=AdopNzo8DniI5TSE6v9r5Ns9vhnVXeMxo4Onm6jI52OKDvVsAdRrGXKKYWwjvF8OXzw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BJvbDenbXHPVl9yTtBU8YjiKRfQE1aQZIbokzDGApjA&oe=69EA230A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ns2tvHdEHEIQ7kNvwEk_l3S&_nc_oc=Adpt3irz7s_ikWuRHk1QgF610zjZJYqZiud65n93RvGF_oUN8NxJImW_0A1S4o0rRCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3VTg0JcFz5MnBA9C3KDP81cn3npxrgITHJqsxjt0_Lxg&oe=69EA125A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V3CWnZ3c1NcQ7kNvwF7eGN9&_nc_oc=AdrfxyiW6SRG-ijkwoqTNtHIfbmBFykX3qGqkDLdt2wL8LlDZKV_lKkYfieeecwg_Y0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0C539cYIcff5uiIpV766hcTKXLfDpTGhqCeGtimaqdJg&oe=69EA1086"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DHuTXKjOMD8Q7kNvwGGQiC8&_nc_oc=AdrTQiV7sxoETC2Y5CUd7vJQgXOanEFdRroo7ZWyPlIjm_6VjHX7dRJU6cZvBetUlkU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3GtepQu_EeKKH9H_6NbMjwwu_FZIMsOKh5zpaLt3n1zA&oe=69EA2B0C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
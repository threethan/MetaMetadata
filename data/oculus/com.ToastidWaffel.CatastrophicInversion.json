04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o64WMF_omZEQ7kNvwH7ojfm&_nc_oc=AdrdjjH3sRGa73WC5MPOXLyb3XGeg37Uh0OLk5yx86Maknps7H1wn8tD68mzQp28IGg&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPjZIS-orp1w7vHcr1FMfA1lcsZe4quAq3SXLqFFA0fnA&oe=6AC52830"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ytApZmIc3W8Q7kNvwF9yvhp&_nc_oc=AdpY8wv9pkkJn0XqHDp0LNmXUSqYhFmnXgKoyDW6vZX62yqXMm05GvgKmIn8TR0OXCw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNLIGB2cR1mvhXZlUud0W9LOo5XddYRMglPl6MDF_3Ocw&oe=6AC4FC0A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7klV2IaD4B0Q7kNvwFmeWly&_nc_oc=AdopAzjf6VCh4jBlBgde1Q908DfNKgOQ7El3lcMDu-SPUJjvIp6eSyzlqphNoFt6xYI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0q6uNhGIj26kN08_7YFRu06bbmY04klVA-_xHF-czgA&oe=6AC5239A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z4mOzAK8py0Q7kNvwGmhDQ6&_nc_oc=Adq0qezeJ91iTCIk-JaiPV0S3148UnL72LNcdNw4oX5XgR-F5o7-tKpCA06s6xpuiAg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN4fEoi7I38JhVvouXzjE5uANWSSitMxUGvJhdTIYO6SA&oe=6AC521C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Iu9eWfF9FMEQ7kNvwGF5oF5&_nc_oc=Adr7yjc1kFjfOAmIrjtgB0-y0z7zjZeOcHzI-5JKjlNmDY0K5WGHF7h0gU67SV5_RVw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN7TjiGvdFvSetWvEv-7kEFWHSyTVWwKkF9j-Yfu9rQjw&oe=6AC5040C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
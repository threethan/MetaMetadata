04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VeyHp0nFHKIQ7kNvwF1c49j&_nc_oc=Adr5fkeLFTlmvlcCcO_b8k7EJKP98sI9dCo-h87Hgy-9ltdoOK_H4WP_B4VIWo-dqQ8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3ygRh87jQ_GN2mXSHO4IUHyOMqZL8Ek-1OuRxxEQXODw&oe=69D4FEF0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfRhG9bSvg0Q7kNvwHofANj&_nc_oc=AdplsD5by5WPBiruhyjn93T6Hsj60r9x6XVV_vAVpEQAOZPfAR0hrHEZkDl1_IcRs3g&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Ji6DvbzuSW0EWQ4WUEQNld3W7D9GlN4Ss9qGyo7ZXYQ&oe=69D50B0A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IhxFKQj2gPUQ7kNvwEEqQll&_nc_oc=AdqqeECOeuClZr7I78zYPXg1oxJVF6lv59GuLgD5Q5AKDGcnvuoQG6dCa6wLb6QhyCc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af074CWo4HYZBaDC6HckrnOI7ORt4D_nyOLxmiaHNJniYg&oe=69D4FA5A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTkrC7nLnnwQ7kNvwG0FjZL&_nc_oc=AdoIp-0EBs60gQmE2GsqVDIXwpC6vyHmcT1zB_xjG0C6Fp8tzAdg0VzfZfsdNUmzK-E&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27wF2hkzWr7Xk0ugPCk2mPqnWbyVFKN9J-HZGBRBXoOg&oe=69D4F886"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_LbTsJslLQMQ7kNvwHdem5i&_nc_oc=AdpMq_vQujkU06c0jDmGuoonPbOp0h_MhNJ3Y0DeXGnRhiArJ_GLy8DPuQ2xRtzfIh0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af20pel8NKHK2VQV6G7FOgxhMkmZimvzhurgdvD2LLzi5g&oe=69D5130C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
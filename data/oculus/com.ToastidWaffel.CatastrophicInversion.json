yssQSyjfH5Z4HJAtlB61UAa7DzIfADPO5x0Eg&oe=69F4A8F6"}, {"file_name": "AssaultOnBase.png", "id": "443113451591277", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38982544_443113454924610_3676545296571915906_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQ7adciL1LQQ7kNvwGHtQRp&_nc_oc=Adr9KIAzXSWN2J4fq0EnEP536QJICmcmO6IyAXceaz5kZ534ur9SfMX4RIXLMswnlq0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3npABcRQwGHaULmDFz3k9Ocj-Hqze6TAlzXBoQE3t0_Q&oe=69F4A546"}, {"file_name": "Labyrinth.png", "id": "1300393411339063", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982674_1300393414672396_5204739748604220557_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lyd0O5GaW_8Q7kNvwGHtQE3&_nc_oc=AdrVkZsiQyAzWm8RgqX1FCzRLr_D-9GdKz0n_mgG-GINoAnU9StkvUO1Z4xupeMk514&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2Sy9w9EQiE2qd0KrG-4_K_OsffkYTRfrKo3Kx12T0PoA&oe=69F4B308"}, {"file_name": "Turret.png", "id": "2302745436726053", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974751_2302745440059386_4335230081335400553_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=p0GPest0pvkQ7kNvwHLHb23&_nc_oc=Adorg6kSTnUD9FhutwqSbXIsKXveJtAC2SxOFWV_0TQHRamQE9hRvt2ARO94D0FNIyw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af03Y8RHOCsEGYaAoc2UYyyFL-PRYsUwTS0N7o3jY6atcA&oe=69F4A0DF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1083730483394050", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/86615253_1083730486727383_4084447030365624247_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vDmJWXJnW3IQ7kNvwGjkZS9&_nc_oc=Ados_4dq6_yFeUtlNg_zJUMR-YaQEc0kNvxxweQOUX4-SX8jxqbpNZ3LUqXtviD5xJ0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af34IdKo71_qQ1kSqhFV52bVNi4e51xhc86ne9p9_kt0tg&oe=69F4B9AB"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "Catastrophic Inversion is a VR laser-tag experience built for large spaces, like the gym at your school or community center.\nInstead of using a joystick or teleporting, you **walk naturally around the maps**, alongside the other players.\nWith two simple taps to calibrate, everyone is lined up and ready to go.\n\n**PLEASE NOTE:** in order to play in shared space on maps larger than 33' x 33'. you will need to have your headset in **Developer Mode** so you can temporarily disable the Guardian boundary.\nThis can be done in the **Headset Settings** on the **Meta Horizon** mobile app. You will need to create a meta developer account, but anyone can do this even if they aren't a developer.\n\n**Take on your friends** in several exciting locations in a **neon cyber world!**\n\n- One-time setup of a space takes only a few minutes.\n- If you don't have a large space, you can play in joystick mode.\n- Multiplayer is hosted locally and can be done without an internet connection. (LAN Wi-Fi connection still required.)\n\nCatastrophic Inversion is still in early access. There are some quality-of-life updates and much more content on the way, but currently the game offers:\n- Four Weapon Types (Including Powered Turrets)\n- Customizable Game Modes (CTF/Deathmatch/Elimination, timed/scored, teams/free-for-all)\n- Two 89' x 50' maps\n- One 79' x 46' map\n- One 33' x 33' map\n- One 10' x 10' demo platform for testing the Shared Space features at home.", "short_description": "Grab your friends, bring your headsets, and head to the biggest space you can find!\n\nCatastrophic Inversion is a cyber-themed shooter that allows you to turn any large space into an immersive multiplayer VR experience rivaling professional venues."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toastidwaffel.com/policies", "developer_terms_of_service_url": "https://www.toastidwaffel.com/policies", "publisher_name": "Toastid Waffel", "support_website_url": "https://www.toastidwaffel.com/about-us", "
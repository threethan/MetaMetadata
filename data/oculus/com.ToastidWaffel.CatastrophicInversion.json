2FMFzk1TF4NE-PAZZzZe7CkDYU76foim9T18w&oe=6ACB8D76"}, {"file_name": "AssaultOnBase.png", "id": "443113451591277", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982544_443113454924610_3676545296571915906_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zJPM4GXTdBQQ7kNvwHVytqt&_nc_oc=AdquXvMDjkgUmhB_yNw-1uCadj1LsO5HLYBTfAp61ECp60_0sy61EZ8SjGI_lxmMaMY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOY5LLFpLT4ghARAJsdW4sIUgY3pdy4FtKmSMOrxuSRNQ&oe=6ACBC206"}, {"file_name": "Labyrinth.png", "id": "1300393411339063", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982674_1300393414672396_5204739748604220557_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J3dBUQv9V3MQ7kNvwGvA_s9&_nc_oc=AdoIPRL9qXHKQ1GhMrrQ8YRlo3hqhWl0RuOwDK7d9HPltmKCCECNaX2To-2cdx4rIss&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN8-fqWbqrwi7H1s-KmCFEIYAsbenTBdLRDoalZF2NejQ&oe=6ACB9788"}, {"file_name": "Turret.png", "id": "2302745436726053", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974751_2302745440059386_4335230081335400553_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BGbzo6VMnYoQ7kNvwEJxpsw&_nc_oc=AdqE_ZwQ2XkSK3dJATkN0xSc_2tvvC23bwXqNd_KQMOFRwDL5gETDRSahEQ4ZX3uB1c&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNq3HUx2g3gOp5e5L1Edtw684p7diJhXM5LCAONv0LsxA&oe=6ACBBD9F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1083730483394050", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/86615253_1083730486727383_4084447030365624247_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lzpw8XliF-gQ7kNvwE0I59X&_nc_oc=AdqQX7WUxBBsY-EoP8ctiE0KetSlN1QTIChtn2SDQ5UcEg1BZF038VB7TF06JnViPMM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMQFXCi_qeB4YASgPOZ8ApktjoOECG8xH_exUX_QJUrKQ&oe=6ACB9E2B"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "Catastrophic Inversion is a VR laser-tag experience built for large spaces, like the gym at your school or community center.\nInstead of using a joystick or teleporting, you **walk naturally around the maps**, alongside the other players.\nWith two simple taps to calibrate, everyone is lined up and ready to go.\n\n**PLEASE NOTE:** in order to play in shared space on maps larger than 33' x 33'. you will need to have your headset in **Developer Mode** so you can temporarily disable the Guardian boundary.\nThis can be done in the **Headset Settings** on the **Meta Horizon** mobile app. You will need to create a meta developer account, but anyone can do this even if they aren't a developer.\n\n**Take on your friends** in several exciting locations in a **neon cyber world!**\n\n- One-time setup of a space takes only a few minutes.\n- If you don't have a large space, you can play in joystick mode.\n- Multiplayer is hosted locally and can be done without an internet connection. (LAN Wi-Fi connection still required.)\n\nCatastrophic Inversion is still in early access. There are some quality-of-life updates and much more content on the way, but currently the game offers:\n- Four Weapon Types (Including Powered Turrets)\n- Customizable Game Modes (CTF/Deathmatch/Elimination, timed/scored, teams/free-for-all)\n- Two 89' x 50' maps\n- One 79' x 46' map\n- One 33' x 33' map\n- One 10' x 10' demo platform for testing the Shared Space features at home.", "short_description": "Grab your friends, bring your headsets, and head to the biggest space you can find!\n\nCatastrophic Inversion is a cyber-themed shooter that allows you to turn any large space into an immersive multiplayer VR experience rivaling professional venues."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toastidwaffel.com/policies", "developer_terms_of_service_url": "https://www.toastidwaffel.com/policies", "publisher_name": "Toastid Waffel", "support_website_url": "https://www.toastidwaffel.com/about-us", "
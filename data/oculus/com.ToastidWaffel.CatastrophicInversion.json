04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2QMVYd7cF0Q7kNvwHqUxPO&_nc_oc=AdrIzHbeyqFijH6urZQnAOoMyopN2Cj6Ww3jIGFlFUrnPGrXnjHtWdYvEjQ2Z_eJ6oU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2T9aTMrC0aH4S-kBVCnduigvTJEYHLSMUhJN5rzPKPfA&oe=69F4A2F0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Eu5W2u02-uoQ7kNvwH9bRAE&_nc_oc=AdqNhyX-jLEF8V1hBNNf5yucYHcY_FmSn5uqzrq3mcVA9aPYN-BaPLUEblAZbbP-cAM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3T7itpMuflPV9F7tsv1HO5v68XOMXy4RMaGFCANnWoSg&oe=69F4AF0A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilXyxXgHPKoQ7kNvwEwQVc3&_nc_oc=AdqNXMcEy018lkJ3Y9xvhO_lKXhxAnXFEZdOpbZr73a76sHQQqz_7jlvw1uZ2ng2h_Q&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3pXJ7ffeVgYJwyWqn4-LNEFX17dUebY4FdYWF5Afi1tQ&oe=69F49E5A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6AZyHuYGF1cQ7kNvwFNGa40&_nc_oc=AdqK5Mn_W9rFoI-O1U5h7Z8Uk9p55R7BCeR-kRWAkdC6pv50Gxa25AHmnG-h2lFU_hc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0RvA_2n3-Jy54-v0QV8hfO7pC25uHSLvKOlgX13NKNfA&oe=69F49C86"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mNId4CQkeUoQ7kNvwEuzWnQ&_nc_oc=AdqmqbRfJq7lGS0X3IVgVLPjWTxyxAV1jzc8TkPlYjAUpjB8bIV5dzlGFkZm_LLulWQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0cyKZg7uq-bskIhC6aBxOu4Usuyq0do4DgAS7ffNPw9g&oe=69F4B70C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
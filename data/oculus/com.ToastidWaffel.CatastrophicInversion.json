04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvCJYPQ5G1QQ7kNvwG8UjJl&_nc_oc=AdrS-u5jMrA8EdivWHJmVd1MkzzRGtlQ2CYWruDAyfUEFaxhKXDbFarlFrRDmv74G3g&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nJuUsmmvv2hnCsPlJX1l85Rjlz9iGd6CBVSwkQy3KIg&oe=69E22DF0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pNGfjZUGFfoQ7kNvwEJHg3C&_nc_oc=AdpPhBeVQTMhh1n2nGXfLdm330ukWN_jQaIV6AoiyU6dWx64GQtivKPM_3K1j-I2Fkg&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1RIjCVhwi2KULucrF5MWwbnQP7w_ZZPoG_SJxkfuB0kw&oe=69E23A0A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=COnvvbqy64MQ7kNvwG5Yfvq&_nc_oc=AdrSUEJCOsb87xGymdW2A2kbtOnbcsXUrYOvuS-rp_vmgtdf9FOvFUKzFfIUdv-BHzc&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3xTAb33eXRQuNYwtkd__DO7aFKOmjMPTdEWItk_4Gq8g&oe=69E2295A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zT8QtvX7mH8Q7kNvwGoSaNh&_nc_oc=Adp-TzschCqhky0VnQyQmGy4LFrOcHF3lDwxjj6EjTqeiPqCYr7Bx9hgmrw2klDKEYE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af13Zrff5A3xNkQTUKhtVYalfbZ4WszAAzT61rdqATkgxA&oe=69E22786"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eiMQJUpBS84Q7kNvwFzLe1b&_nc_oc=AdobHRmQaOmjOCW2ctrVVSUeqe2SHH8PxgacWNN1_MWnIld6mflj5ogrJsZMwsQyZh0&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jf6yYFk8U7lzRCOdk7ycwOOqbGOEKPEKVnNbu8_bpSA&oe=69E2420C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
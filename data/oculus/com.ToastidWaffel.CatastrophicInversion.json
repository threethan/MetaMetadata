04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6C66H7P2CiAQ7kNvwE0NNny&_nc_oc=AdoSjfcLc4SiIk8UW63ohjWnmtycTCZIM2L7Pj9IZMrnfiaA_wpl-m0VI0T97vTIG8A&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO6RtyfrF589s3uTWyl4OR6wxeJ_lPii7XVSjNB5OPOUQ&oe=6ADCAAF0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ShAjuMishpwQ7kNvwGny40s&_nc_oc=AdpI6dPt6i8HaV9d9VtjvZ8P4hColxdnb5EOBIqW2gME7mDWSO1yIVCKoCgwR5e2p-s&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNqElSTYLdugYOQpjogM3tFchDJmmJh-SqlQeIzMucc-A&oe=6ADCB70A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S7hF9ejsL0gQ7kNvwFjZkcJ&_nc_oc=AdqnH8viM6AW7CAmpJ_xlSXKcLhgRBudyOWgaUykmXgJQi9nTIAhTAjsP9QIjdvIh0I&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOkuZYoRTPQJQXSuSM_wKpUvurXlEfKhd8BOye3MdNOZw&oe=6ADCA65A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pwNkhLI33_MQ7kNvwEZSg3O&_nc_oc=AdpWSglSiS9i9-RYOuIMZIp92PKKZSuRCOfwBIATuRw8fjXcge52g0Mu3cqhe0wi9Os&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBhOKk9YTYt2txTczQuv9Xv6ob24MBm2NwK0TQVm-GvQ&oe=6ADCA486"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wBSXEchpBwEQ7kNvwHZ55Ow&_nc_oc=AdralM9SJZbFjib1JqnA1DYI5q2cjpSraJC8XuOEDgLrA9DzVvMH9Uga8U-kEDbC04U&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPosRjcbgGU6kqhTFz2DLP3_-cEE-A2h02emcUfR8E4_A&oe=6ADCBF0C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pW2ILU1CwS0Q7kNvwEP9T0R&_nc_oc=AdohjclaYO4WWA-4H7gOz3OOAJ2qrWLFNkoaRJCiaRKam6eQSqDMAjdyo8KntJG9yiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRSC_nK1r5DwVftN-jAvManGIerfwTwwgXo30jKt7jQ8w&oe=6AE76F30"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Ghu0OkneZUQ7kNvwGkH8c-&_nc_oc=AdopeFFdbh7Zuf2RBHhcaZHqeR4CF7pvYvSohb__9RA7NhWmSvxxx050JpLR3B1YLfA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgMlHucRUaA1ZrrviEKThd8xNtNcsG9tNy2_38THCEhQ&oe=6AE7430A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Oh895_ESK8Q7kNvwHAVFgC&_nc_oc=AdrhlyLAzfm7pJoqFVpxgUaoyNfeCNSIdCfvr2-drsZIJ8CcR2wWsFuwkwgI6AvTy5s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTriObP2pbr3Xp5pxbR2dRRu414qFl0TPZF-GjjN2npXQ&oe=6AE76A9A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nFeUkqLfmQ4Q7kNvwE31FG0&_nc_oc=AdqHmmgP0rjzgRVmU_9ITR4J6kIc_HRl6k_UGTBWddzbHT-Rd-2Ocl2pwnQDSPmKsjE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhDDTw_DrFK4V24qmGi5WcacqbTM1AW0NStUg1gW7beg&oe=6AE768C6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y9hRw_nF3T8Q7kNvwFYlwkj&_nc_oc=AdqFBqyiuZdRW6wbCtPtmFnJQktrCk54Ngi0EhHeY4UaVh--G-8i98xrQgrkbSNpx-0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQdVx0HgEnZCcyot5y88M-tcVbsPJPC3-3L_rOtrGDgSQ&oe=6AE74B0C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
311301", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974465_910105177644634_6351622331534701081_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Yi43cfJFT0Q7kNvwGWLsqn&_nc_oc=AdnNwk-djxH-hg8-1EXjtFYaoav25AJW2lxrUqbY6fFNww3_vwDTgMQp_Na19r6X2CQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvwwBMNkevyjnQo90fAxIt4N_U8J19GupaQ7D6b5R_U-g&oe=699EF776"}, {"file_name": "AssaultOnBase.png", "id": "443113451591277", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982544_443113454924610_3676545296571915906_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PEgbGV4VJF0Q7kNvwEruD99&_nc_oc=AdnW8twnm9tHGkg7lYac3l_vFb3nC8hH0JjcgBQszAK7tp4-kTjyKO4dWuwRDA5iS9Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfvMgAX5mE6vu3PAL4fRtd6m4XIEhQxDjQPYY1jO9n1Y-w&oe=699EF3C6"}, {"file_name": "Labyrinth.png", "id": "1300393411339063", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982674_1300393414672396_5204739748604220557_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7fBvz9Q9cEYQ7kNvwFqpyee&_nc_oc=AdlxOYBclXE4xWRlB6E5I_9eUyINAIGV0QH3ET_BWS4phn5WXgnoLQhfXVIMMgpstuo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv2N6sp7BmEHX_nWmfTpEnase8s3ku4xS_V5A6lvrSrmw&oe=699F0188"}, {"file_name": "Turret.png", "id": "2302745436726053", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974751_2302745440059386_4335230081335400553_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7B7j6-QdaTgQ7kNvwGMdsoW&_nc_oc=AdmQPR4A94yEMwJ6boG8tDvvXzqSW4B3Qr2FvVweuE3yOAe4DijQ2lytpdTfbv5HGOw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv4LGVd_DWKQUVcfX1aQs9_pc1PItLVQJF3jpLhJ7TtZg&oe=699EEF5F"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverArtLandscape.png", "id": "1083730483394050", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/86615253_1083730486727383_4084447030365624247_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=arH4ZMfmb9MQ7kNvwHvKGJF&_nc_oc=AdlYubWF7mmOP4fvK4tGP36O2GvSZnVcwlEaa7WF376BMboES4O2j7eEJNi83V5jZBk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afsy5IsyeMYt5NZhx9yjQR1WCydFUkJIpCgxyLNZlBqYbg&oe=699F082B"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "Catastrophic Inversion is a VR laser-tag experience built for large spaces, like the gym at your school or community center.\nInstead of using a joystick or teleporting, you **walk naturally around the maps**, alongside the other players.\nWith two simple taps to calibrate, everyone is lined up and ready to go.\n\n**PLEASE NOTE:** in order to play in shared space on maps larger than 33' x 33'. you will need to have your headset in **Developer Mode** so you can temporarily disable the Guardian boundary.\nThis can be done in the **Headset Settings** on the **Meta Horizon** mobile app. You will need to create a meta developer account, but anyone can do this even if they aren't a developer.\n\n**Take on your friends** in several exciting locations in a **neon cyber world!**\n\n- One-time setup of a space takes only a few minutes.\n- If you don't have a large space, you can play in joystick mode.\n- Multiplayer is hosted locally and can be done without an internet connection. (LAN Wi-Fi connection still required.)\n\nCatastrophic Inversion is still in early access. There are some quality-of-life updates and much more content on the way, but currently the game offers:\n- Four Weapon Types (Including Powered Turrets)\n- Customizable Game Modes (CTF/Deathmatch/Elimination, timed/scored, teams/free-for-all)\n- Two 89' x 50' maps\n- One 79' x 46' map\n- One 33' x 33' map\n- One 10' x 10' demo platform for testing the Shared Space features at home.", "short_description": "Grab your friends, bring your headsets, and head to the biggest space you can find!\n\nCatastrophic Inversion is a cyber-themed shooter that allows you to turn any large space into an immersive multiplayer VR experience rivaling professional venues."}]}, "deve
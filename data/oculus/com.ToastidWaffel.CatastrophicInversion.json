3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxWVvJKyxGFYLg99KWTf5gdvpiNw1l63Ml9lJ4IPldWiA&oe=69C5390A"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4hg17XHT9VgQ7kNvwGFP54Y&_nc_oc=AdpOUOAU4Bxgt9Ea4Mpfz8dY_TEZjXTIbXOmryQ_CCZy-di3YzdehZ6Prq8xn0Qma6E&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afw2E28DzSpYEgLpYjpYRE-YlEA9H6dCNX3L0AKKkT_Kew&oe=69C5410C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is a multiplayer VR shooter made for **large shared spaces**, allowing players to naturally move among each other in massive levels with space-warping tricks to make them feel even bigger.\n\nCombatants face off in a variety of game modes including **Capture-The-Flag**, **Deathmatch**, and **Elimination**, with many adjustable settings. You can also mix and match win states to create your own custom modes.\n\n- **Joystick and Teleport Locomotion** are also available for those who don't have a large playspace available.\n- **Cross-play is available between Meta Quest and Steam**, as well as between stationary and real-space players.\n- **This PC edition can also function as a dedicated server and a spectator camera** for those not currently playing. If the game starts without a headset connected, it will automatically enter server/spectator mode.\n- The game can be played **completely offline** via a local Wi-Fi network, or **online through** a direct connection to **privately hosted servers**.\n\nWhile fully-playable as an arena shooter, we still have a lot planned. We are working on adding arenas, weapons, items, play styles, accessibility options, and quality-of-life features.", "short_description": "Catastrophic Inversion is a VR arena shooter made for large shared spaces using real movement through massive space-warping multi-story arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.toastidwaffel.com/policies", "developer_terms_of_service_url": "https://www.toastidwaffel.com/policies", "publisher_name": "Toastid Waffel", "support_website_url": "https://www.toastidwaffel.com/about", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9670749223034714"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/491822590_1864945571024562_3237496243505310796_n.png?stp=dst-png_s360x360&_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5RWmlgqVWa8Q7kNvwFbAUgj&_nc_oc=AdpLVlgP8BAnpfVh_aKYFZfd6owOo7FFy9idBVM4q0l3-v9_vKCB2Uq2SnJAsInWEqY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzI1ClTxgmNT1vfBEvU_NO4n4Fix0Fyy-ZeJbgrhU55Bg&oe=69C520BF"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Catastrophic Inversion", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Action", "id": "459781504968480"}, {"topic_name": "Shooter", "id": "3744040075834813"}], "release_date": 1730760360, "lastRevision":
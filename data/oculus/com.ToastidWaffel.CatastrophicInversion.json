04305_26224042087258678_2437308310149224298_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BrOZA5j5RHsQ7kNvwHGjT70&_nc_oc=AdqGMD9Ys4dHyQ0jZuQTsDGjX2q8MPOlb9DNvv8Sx-cG2apCvVfxiGvA2CBAMvJmx_k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsPYlnHLCumQ3s8N8LB75oqzVG8VTFDiZ7BCNgIfeK7w&oe=6AC133B0"}, {"file_name": "RPG.png", "id": "1296034958126226", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473391883_1296034961459559_5502580379449355361_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2g5JZH8-AucQ7kNvwFQ_mHf&_nc_oc=AdqXhXOA6rqZqBgFqD2_LkDZ4EUEtfo-B8bsvtcMshhZWSlVR0cJic0CsKb6Bz0BFV8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOOiRt6XWlFHv6bmtvb76ptDa6q9Kb2ZPKibMNvhLrzPg&oe=6AC1078A"}, {"file_name": "PoweredTurret.png", "id": "2046270825885216", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825094_2046270832551882_4759179704176703160_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3zZvxU6X4YcQ7kNvwFJ6hEM&_nc_oc=AdpN-DM38E-2GG6OWa1qXrOldSE2csPzxfzbkbf0SJrr2TyetjpB-VR-zUDBPhobm_s&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_czyftNqQegx-jk6P5X6erBuHbJkNw-59s9LuFKSeyw&oe=6AC12F1A"}, {"file_name": "Bots.png", "id": "2014724662781867", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499301053_2014724666115200_6829947849514445130_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SCkAijdms3MQ7kNvwHGgzPy&_nc_oc=AdrA0Q2HQ-HNFgI6gLO8aN8ZVwm55hF-hHNJFIjvUtX-NpJehHZnl-iHr4-lKq_OBcc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPaR5IOwPUPsNLio_kM-Y44WbGxNXezFDo-_zbcsfIBXQ&oe=6AC12D46"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "MetaCoverLandscape.png", "id": "3060218317458956", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473396955_3060218320792289_6166074712994379583_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eQhtygGjiQAQ7kNvwGbMCvl&_nc_oc=AdpzGnJ9pdRunI0zePKznbyfjMKAjK0ls7tNgPkfdzB4Z6ofJHVxFhABf3WJC7NF79k&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPB-At3QSOsPepj14CXSQhzbS5_AFP3dzJFWFNWQMN8Bg&oe=6AC10F8C"}, "display_name": "Catastrophic Inversion", "keywords": ["Arena", "Laser", "Cyber", "Huge", "Neon"], "long_description": "**Catastrophic Inversion** is the multiplayer shooter for large spaces. After a quick mapping of your space, it accurately aligns all players, allowing you to move around together in the same space.\n\n**TRANSFORM YOUR SPACE INTO A MULTI-LEVEL VR BATTLEGROUND**\n{1969331173680063}\n**FIGHT YOUR FRIENDS IN A GROWING COLLECTION OF PVP ARENAS**\n{942912398100454}\n**EXPLORE AND SURVIVE TOGETHER (OR ALONE) IN ADVENTURE MODE**\n{881509854914158}\n**Quick Notes:**\n- Most maps require 24x14m (79x46') to play in shared-space. There are also some 10x10m (33x33') maps. Stationary / room-scale play available for all maps.\n- Dedicated host & spectator available on PC. Hosting from the PC version is recommended (but not required) for multiplayer.\n- Games auto-connect over Wi-Fi on your local network. There are currently no official online servers, but peer-to-peer online games are possible.\n\nSee our website for the latest info.", "short_description": "Transform your space into a multi-level VR battleground!\n\nCatastrophic Inversion is the multiplayer shooter for large spaces. Accurately aligning all players, it allows you to move among each other as you battle it out in a growing collection of PVP arenas."}]}, "developer_name": null, "developer_privacy_policy_url": "https://toastidwaffel.com/policies#privacy", "developer_terms_of_service_url": "https://toastidwaffel.com/policies#aup", "publisher_name": "Toastid Waffel", "support_website_url": "https://toastidwaffel.com/support", "website_url": "https://toastidwaffel.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": 
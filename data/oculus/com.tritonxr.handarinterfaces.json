JnJ5mffEq8xgXZXGc26n2SsUnA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKPAbb_pVVhN5WU2rZKF8gAsj_fk9gEsJq3MjuHBVRunQ&oe=6AB29D2D"}, {"file_name": "305-STORE-Screenshot-05-pinch-dial-2560x1440.png", "id": "1626825148865859", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491823930_1626825152199192_5494777866746283430_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3sezArAE3IwQ7kNvwHNUys_&_nc_oc=AdrlNzxqXAbqguvo992vUCuz8w8rtyZQr2Bz3OFbAO01qV0Fnsz3vUgjR2XSy5Y2P80&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJdyXyI7f8vAy9GRoQRJd2z5BpDilLv3c87tFzMxBjypA&oe=6AB2A43D"}, {"file_name": "304-STORE-Screenshot-04-finger-chords-2560x1440.png", "id": "1106643865369309", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821796_1106643868702642_6864918676381133170_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=agv2dC6gSQAQ7kNvwFQV_38&_nc_oc=Adr1UlVmQ_-0yJ7vfNX7DbZge71JF_IJ3v0eB95vpXwZXtq8UfFSgdbP-7lYb0jnkgY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLWjEoIXqWFEPQaAXWi02FECPUHz2WTbt5n1HBmRHbcfg&oe=6AB2769E"}, {"file_name": "302-STORE-Screenshot-02-wrist-dial-2560x1440.png", "id": "1367514892160188", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491827567_1367514895493521_1014963257396988949_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kt5RIiwpyw4Q7kNvwELZpTS&_nc_oc=AdrkSwgF8cBo3LlwG44vE77vRwnNI2xM7mXjamNWNgIv1BTuol9u3LTYHAHmm5rMues&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJNA2NppwKk_FH_lQS9zJnEEt0JwXPVVLa0eQdsAeJRWg&oe=6AB27B96"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Hand AR Interfaces", "keywords": [], "long_description": "Hand AR Interfaces puts the interface where your hands already are.\n\nNot a panel floating in the room, and not a menu you reach for, eleven\ninstruments drawn directly onto the palm, wrist, forearm, knuckles and\nfingertips, in passthrough, in your actual space. You look at your hand and the controls are on it.\n\nELEVEN INTERFACES\n\n01  PALM KEYPAD     Twelve keys on your palm, readout at the wrist.\n02  WRIST DIAL      An arc of channels on the back of your wrist.\n03  VITALS CUFF     A monitoring band down the forearm, with routable leads.\n04  FINGER CHORDS   Each finger is one bit. Curl them to spell a value.\n05  PINCH DIAL      Pinch to clutch, roll your wrist to turn. One hand.\n06  KNUCKLE TABS    Tap or drag along the knuckles on the back of your hand.\n07  PALM ORRERY     A body in orbit, held in the cup of your hand.\n08  SLEEVE TERMINAL A real job running down your forearm. Run, hold, step.\n09  PALM APERTURE   Aim with your palm, tuck your thumb to commit.\n10  FAN CARDS       Spread your fingers to fan a deck. Pinch to pin one.\n11  GESTURE ATLAS   Watch your own hand being measured, finger by finger.\n\nFour of them work entirely one-handed \u2014 no reach, no target, and your other hand still free. That is the thing a hand interface can do that a panel\ncannot.\n\nBUILT FOR SKIN, NOT FOR AIR\n\nA panel in a room is far away, out of focus and stationary. A panel on a palm is 30 cm away, in focus, and moving with the surface it is drawn on.", "short_description": "Your hands are the interface. Eleven interfaces worn on your hands. A keypad on your palm, a dial on your wrist, a terminal down your forearm. No controllers, no floating panels, the UI is on your skin.\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://nebulytic.com/apps/hand-ar-interfaces/privacy.html", "developer_terms_of_service_url": "https://nebulytic.com/apps/hand-ar-interfaces/terms.html", "publisher_name": "Nebulytic", "support_website_url": "https://nebulytic.com/apps/hand-ar-interfaces/support.html", "website_url": "https://nebulytic.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "393222478507326"}], "
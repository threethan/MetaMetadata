re to knock your socks off.\nPunch the targets and dodge the obstacles all while rocking out to your favorite music. This is your workout built by you for you.", "short_description": "Shadow BoXR is a rhythm boxing game intended to make working out fun. Punch the targets and dodge the obstacles all while rocking out to your favorite music. This is your workout built by you for you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://benbryanricks.artstation.com/pages/3pupperstudiospp", "developer_terms_of_service_url": null, "publisher_name": "Three Pupper Studios LLC", "support_website_url": null, "website_url": "https://3pupperstudios.wixsite.com/shadow-boxr", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9371047482927780"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75361353_537419964626914_707014314074247781_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gzLMUkvZqugQ7kNvwF8b6PR&_nc_oc=Adqg73RRDZw3dkQ9ysANGUeivOUiMxPJ7Ck7mhWtEf3CSkm7qLCTggqnD1_u7NSAVxo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&oh=00_Af0FE1M33vivgiaI4nu8hLvtmyxMkDF2oLu5cGagkEOICQ&oe=69F0C2A9"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Shadow BoXR", "platform": "ANDROID
 library of community content music, you are sure to find what you love. Each song offers 7 different modes and 4 levels of difficulty so no matter your skill level, this game is sure to knock your socks off.\nPunch the targets and dodge the obstacles all while rocking out to your favorite music. This is your workout built by you for you.", "short_description": "Shadow BoXR is a rhythm boxing game intended to make working out fun. Punch the targets and dodge the obstacles all while rocking out to your favorite music. This is your workout built by you for you."}]}, "developer_name": null, "developer_privacy_policy_url": "http://benbryanricks.artstation.com/pages/3pupperstudiospp", "developer_terms_of_service_url": null, "publisher_name": "Three Pupper Studios LLC", "support_website_url": null, "website_url": "https://3pupperstudios.wixsite.com/shadow-boxr", "category": "GAMES", "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1672577396871977"}, {"id": "2776542286000603"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["ARCADE", "FIGHTING"], "has_in_app_ads": null, "internet_connection": "REQUIRED_FOR_DOWNLOAD", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "9371047482927780"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin6-3.oculuscdn.com/v/t64.5771-25/75361353_537419964626914_707014314074247781_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XKkyFHWLXDsQ7kNvwEmaNTE&_nc_oc=Ado1I9mMC2q0lAg6AQKNPV6pi44sjhSGpwwdgyTwMtgvkFEP5bpv4d1o0UWsKIUZ_SU&_nc_zt=3&_nc_ht=scontent-sin6-3.oculuscdn.com&_nc_ss=7
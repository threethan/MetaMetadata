XuvQ&oe=6B05C46B"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "SN_TrallerCover_2560x1440.png", "id": "1077011291541314", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499620666_1077011294874647_1555180372772644949_n.png?_nc_cat=108&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8AuQZC4DXGMQ7kNvwHPALhG&_nc_oc=Adoe0KrDHOyFSK3itONd7TkQDsscmjvl_EQKynSk8v35eS88gQQea1iqH9Xo4We-Wzo&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQQEgP84nxN59jZG-Wc0NlRfXqaSjG36mDbGHgNOa1umw&oe=6B05B90B"}, "display_name": "Supernatural", "keywords": ["cardio", "game", "strength", "active", "home"], "long_description": "#  \u2665\ufe0f YOUR NEW SUPERNATURAL IS ALMOST READY\n\nComing this fall, step back into the Boxing and Flow you love, with breathtaking environments now in higher definition, fresh workouts, new music, and an independent team building what\u2019s next.\n{1648021570002843}\n\n# \ud83c\udfaf FIND YOUR WORKOUT\n\nChoose the workout, intensity, and music that fit today. Then step in with expert coaching to keep you moving from the first move to the last.\n{1065218879766958}\n\n# \ud83e\udd4a BOXING THAT PULLS YOU IN\nPunch, duck, and weave through music-driven combinations in extraordinary places. Full-body cardio, rhythm, and focus come together in a workout that makes the rest of the world disappear for a while.\n{1378979057759196}\n\n# \ud83c\udf0a FIND YOUR FLOW\nSwing, squat, and move in rhythm as targets come at you from every direction. Flow turns full-body movement into something immersive, musical, and unmistakably Supernatural.\n{1061348792976615}\n\n# \ud83d\ude80 AND WE\u2019RE JUST GETTING STARTED\nSupernatural is independent again, with a small team listening, building, and improving from here.\n\nWishlist Supernatural now and join us this fall.\n\nAccess to Supernatural is currently limited to the US & Canada.\n", "short_description": "YOUR NEW SUPERNATURAL IS ALMOST READY\nComing this fall, step back into the Boxing and Flow you love, with breathtaking environments now in higher definition, fresh workouts, new music, and an independent team building what\u2019s next. Choose the workout, intensity, and music that fit today. Then step in with expert coaching to keep you moving from the first move to the last. Full-body cardio, rhythm, and focus come together in a worldclass workout. WISHLIST THE NEW SUPERNATURAL TODAY\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.wearesupernatural.com/privacy", "developer_terms_of_service_url": "https://www.wearesupernatural.com/terms", "publisher_name": "Supernatural Health LLC", "support_website_url": "https://www.wearesupernatural.com/contact", "website_url": "https://www.wearesupernatural.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "810139357995560"}, {"id": "2776542286000603"}, {"id": "1228796255027646"}], "external_subscription_type": "REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1340246282494656"}}]}, "scheduled_offers": {"count": 2, "nodes": [{"status": "PENDING", "id": "1977092236592481"}, {"status": "PUBLISHED", "id": "1434750855524106"}]}, "baseline_offer": {"id": "1434750855524106"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 0, "status": "PENDING", "id": "1977092236592481"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1583949778124304", "version": "8.4.0.179
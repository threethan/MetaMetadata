Ntn7vmRe3eA&oe=69C1235E"}, {"file_name": "491819980_1969594110599635_3703722979615162934_n.png", "id": "1454758429410435", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491823940_1454758432743768_1034543453923175055_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r4Qf92_kOmQQ7kNvwF2rJbV&_nc_oc=AdoFf3b4ArQn5rXzxCZ4_lu7HK0YRQi2Y9NceZsUZAWpEf_qskmCcWGjuLKuYc8u6mQ&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfyP1i56FN6VtPXR88VV4EbYaA1canOr7utgt76BT2TwxA&oe=69C13E7A"}, {"file_name": "491818849_1940735343154465_3602926846437935007_n.png", "id": "1504674167489483", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/499310720_1504674170822816_2830596740570143476_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kL1yQ0Y0wK0Q7kNvwFzUZGk&_nc_oc=AdpKz4S14ls5HucLtQZ7BCXhy2cHY1i5RJRgW1T6gH-rVDosn2Sk_EWPt8Hu5iyggys&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=8&oh=00_AfzdhUia-cxSYT_Li1lu5vhFv_3Ag0BxaTlr5jf7XcpiPw&oe=69C13AEF"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "CoverImageSafeAreaTemplateLandscape.png", "id": "1906177563632069", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/491825563_1906177570298735_9000381379552003476_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=umqZ3xYOFaMQ7kNvwGNS5nc&_nc_oc=Adp50Y-xYLxBjUsPgHj-VBT9RavTImzb7iPBeancjgyNgT2EHPErrvxUGfYt8bqGFKE&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxwvZMV7sEgVcnUkPHQpN7x5gpc0JoFNoaGbZHlw0NfUw&oe=69C125B4"}, "display_name": "Aerosurfer", "keywords": ["gliding", "flying", "surfing", "competition", "surfer"], "long_description": "## **Welcome to the Skies: Where Flow, Focus, and Speed Collide**\n\nGlide and surf through handcrafted tracks at breakneck speed. The closer you fly to the ground, the faster you go! Chase your best times, race against your ghost, and climb the global leaderboards in a high speed journey of control and flow. \n\nChase your best times, race against your ghost, and compete with friends and players worldwide in the online leaderboards.\n\n{893004980559261}\n\n\ud83e\udebd **Surf the Skies** \u2013 Glide through narrow tracks and feel your speed surge as you fly dangerously to terrain.\n\n\ud83d\udc7b **Race Your Ghost** \u2013 Compete against your best time and refine your path run after run.\n\n\ud83c\udf0d **Online Leaderboards** \u2013 Post your scores and see how you rank against players and friends.\n\n\ud83c\udfaf **Pure Skill** \u2013 Mastery comes from precision, timing, and flow\n\n\ud83d\udca8 **Intense Sessions** \u2013 Perfect for quick flights or long sessions chasing perfection.\n\nFind your rhythm. Chase perfection. Become an **Ace of the Air** in *Aerosurfer*!\n\n{1447369516729839}", "short_description": "Glide and surf through handcrafted tracks at breakneck speed. The closer you fly to the ground, the faster you go! Chase your best times, race against your ghost, and climb global leaderboards in a high speed journey of control and flow. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://breachvr.com/page/privacy-aerosurfer", "developer_terms_of_service_url": null, "publisher_name": "Breach", "support_website_url": null, "website_url": "https://breachvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}, {"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "326316023
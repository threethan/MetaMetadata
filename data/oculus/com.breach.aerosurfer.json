_2x_upscayl-standard-4x.png", "id": "1981306786126197", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499307346_1981306789459530_719580215901943468_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=I_sBbbT8O_kQ7kNvwGw7CHj&_nc_oc=AdqgheioVlckFeHpK_JWmKrbYHgl6xAPkGhqtt-MvtNyQONYj501ChcST2salmd5wPI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFHQctWtVGEE_hTSaEGkz06RLVPrmWeq5JBz20GjMZC7Q&oe=6A85A28B"}, {"file_name": "com.breach.aerosurfer-20260209-153211.png", "id": "793594620425128", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823286_793594623758461_1123956833873661453_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bi3MjLCY-iYQ7kNvwH0sub8&_nc_oc=Adp6W1IMsZWcVOQ97eB8Erujy0tc2vyIW651aLAOmNcEhNS4PnWOAL6enLgjhSk0Nls&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsYX1QifdEY5oQSZ8radF_5tKF-lKPqE9wCc0xCGbELg&oe=6A857992"}, {"file_name": "HighresScreenshot00014.png", "id": "1845146872908611", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491823746_1845146882908610_200955437162846882_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8512SWBpA0wQ7kNvwFpMLDp&_nc_oc=AdrYTyI1aX7yd5kLhTW4L3HEAVrZc8d49FXfph5S7rzcHiz41HAheZlNId6mrlJGfBY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGzDJlcyHYbmQOcztYkCVBYk7p_SfQkxx3JHsor2bpj2A&oe=6A858569"}, {"file_name": "HighresScreenshot00010.png", "id": "1060897146451115", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491825546_1060897149784448_8292638744654889205_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SPvdw6qQ430Q7kNvwFZG0Ue&_nc_oc=Adobf862WflqsCvtT9RkkRqrFrshHaqQEUkcLZEY9rLNlH3mJ1l9gEG7w2ZbXP08V0k&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH5POm4Sctaf5pRM-wNhrvwgULY7W6zWi-F51rBQt00RQ&oe=6A859864"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "horizontal.png", "id": "2206124290230137", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827646_2206124293563470_2512212224248806728_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=moWQlo_9qQkQ7kNvwFjzlnh&_nc_oc=AdoBv9RjRdzSaXIuoyKsVTcqL33RFNqM09lY4XhmB787ElZmfFfgqL0_BfBGhiA5IkQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJ1bYSV7reF9BVBn127miyE-D9t3J6yrI0_dZnwcgQ2g&oe=6A85AE0C"}, "display_name": "Aerosurfer", "keywords": ["fly", "speed", "fast", "racing", "multiplayer"], "long_description": "# **Welcome to the Skies: Where Flow, Focus, and Speed Collide**\n\nEasy to learn but difficult to master, this game will challenge you to prove yourself the best surfer in the sky. Strap on your wings and take off!\n\n{1442428761043067}\n\n# **High Risk, High Reward**\n\nFly close to obstacles to charge up your boost meter, then strategically deploy the boost by timing it just right. Activate boost when flying close to the ground for maximum satisfaction!\n\n# **Race Other Players**\n\nCompete against other players as you race to the finish line. Observe and learn from the best, improve your technique and become the number one surfer!\n\n{1527204295188395}\n\n# **Features**\n\n\ud83e\udebd **Surf the Skies** \u2013 Glide through narrow tracks and feel your speed surge as you fly dangerously to terrain.\n\n\ud83d\udc7b **Multiplayer** \u2013 See other players fly alongside you. Other players' best runs are stored, you can race the pros at any time!\n\n\ud83c\udf0d **Online Leaderboards** \u2013 Post your scores and see how you rank against players and friends.\n\n\ud83d\udca8 **Intense Sessions** \u2013 Perfect for quick flights or long sessions chasing perfection.\n\n# **Campaign**\n\nCompete across 24 carefully designed tracks as you progress through the campaign. \n\n\ud83c\udfc1 **Race to the Finish Line** \u2013 Reach the finish line as fast as possible!\n\n\u2b55 **Collect the Rings** \u2013 Fly through all the rings in any order you like. Find the best path!\n\n\n# **Hidden Collectibles**\n\nFind dozens of hidden collectibles scattered thorughout the game. Explore the racing tracks and re-discover them from a different perspective. The main menu also offers a large open area to fly around and relax in.\n\n{1540456394205519}", "short_description": "Glide and surf through handcrafted tracks at breakneck speed. Fly close to obstacles to charge up your boost meter, then time it just right when you engage your boost for max speed. Chase your best times, race against other players' ghosts, and climb global leaderboards in a high speed journey of control and flow. "}]}, "developer_name": null, "developer_privacy_policy_url": "https://breachvr.com/page/privacy-aerosurfer", "developer_terms_of_service_url": null, "publisher_name": "Breach", "support_website_url": null, "website_url": "https://breachvr.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2776542286000603"}, {"id": "459781504968480"}, {"id": "331529188132278"}, {"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "SITTING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "37423873857257167"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/673699241_3423406127865896_6375376202667278824_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b9oKmndJxoMQ7kNvwEMy1ry&_nc_oc=AdqQ914ETAHnzvGb81c7kUc1pI6RWwEn6HFKG3sXt5fx0gWzXNZNrHE_XO-8cKg3J20&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENmtJzEOMPPhKDVLKo4S5krrda3Kp_jEbicI3PeuWfcg&oe=6A858FEB"},
0264", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974583_328974202453597_1752618785878468436_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BF5ate54bl8Q7kNvwHbcune&_nc_oc=Adotfd8qHqWkqAN4G-eq9lXfufLjxjx_syE_by_Yfb_vnkKxD7cZeGKatpU-SAIsFe8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Nfb-derT-cXe49hiMy2ewn6JwLjDSPQ5kOddWWibxoQ&oe=69E3995A"}, "display_name": "Everything Is Cake", "keywords": [], "long_description": "A world where everything becomes a cake when cut.\nWe brought the unrealistic cake art that users saw into VR.\n'Everything Is Cake' for those who cannot be satisfied with just watching\nPick up the given knife in VR space and cut objects around you.\nThere is Excalibur that turns everything into a cake.\nTake a picture and show it to your Facebook friends.", "short_description": "A world where everything becomes a cake when cut.\nWe brought the unrealistic cake art that users saw into VR.\n'Everything Is Cake' for those who cannot be satisfied with just watching\nPick up the given knife in VR space and cut objects around you.\nThere is Excalibur that turns everything into a cake.\nTake a picture and show it to your Facebook friends."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/12kMRjlqLd7wQpXCOsoHquocJVv4bHS9T24eysRC1FNk/edit?usp=sharing", "developer_terms_of_service_url": null, "publisher_name": "SurReal Round", "support_website_url": null, "website_url": "https://surrealround.com/everythingiscake", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["CASUAL"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages"
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRWP2aPWUvQQ7kNvwEdCpCO&_nc_oc=AdocD5GPEVJaYYZFeUKef4HxdymAVrdlHi3X9WWBBDVqyQsKxCkc0GC-6w3AQ1KEu_4&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af65xrqTlQTXQ_tjBq4W38m_vgSaO7wGuGmPDt15xDmvkw&oe=6A1714CE"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7nZrz7mBnwQ7kNvwFGutJ2&_nc_oc=AdoccbxuMY5naaMzbWBlCi69XCtZwb8486Csc60WcxgerXDklUEnt36EEWMVaQT9TTk&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af51CNIhJ2vMGfdBzWH1KPpe0ex5-eL2k4k4OkcwAxGYRw&oe=6A170E12"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbY9YjsowmwQ7kNvwEFkLrn&_nc_oc=AdqVDlrWebycwIX3jU8_krP2x8KGZmmZgkGZ9FruO4evSGfE3AVnpwavg0cGXP3DibY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7EIEzQkv1HrQ0loVlVrcr1GqXMh2iYoJUSNXI7WXE5fQ&oe=6A170BF5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTSdetQKy1EQ7kNvwHIgX7z&_nc_oc=AdqD_0IOtl2-tkpT06LsGuc7kXtrpgmPtcEf0Uxlkru4rNzn3XlkAwHeidrYoUhe1Ho&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4twa8Glb7BqSPWcG7CbZlPJoYzC5gVTyRrmU2qlCXCvQ&oe=6A1703CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_4WIuoBoJoQ7kNvwHg3eHv&_nc_oc=AdqaeoPsj2dU4IrV9-X_WhFo-5iO0RvFz9ygmLo3YqEffNaskRWSf1ZM9XA8SkRXgv8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5kFECKGceIoQQdXnjhkEp91j2YGQ-brLqhAe9rThbo9g&oe=6A16F93F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0IwEI8vTZ8Q7kNvwFVK9KP&_nc_oc=Ado4nTgWoKq6BdU0Bn_89hiAWSg8nJLWTy8Vdw2L_5Hr1Y6X2BUvWdbRgq2-L8M5_gU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0baOgK5dBEg5tHvN1bPzM9K0sLWTkzo_yFMZoKY9NGvw&oe=69DCDA8E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swoeMIz691oQ7kNvwFrM_1D&_nc_oc=AdrD6RoRu76XkWR7t1R_0OCUZcz7Pu2t9J2caUI6E1UjDgLaQr91unAufx9yG1h-0iI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2GPoleXOWztLhr1L7ZkXvEVNF5zUH29Hw4wCA4Mq9hAA&oe=69DCD3D2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9UML1BU6pYQ7kNvwFRWNBE&_nc_oc=Adr9vzPneDqw45ahVx-AeMc82rOh0GigBW92P_d8w85j1KEtT6qoyPD0HkvOXQC0U3I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3NytaTpzmTpxl1o6c_Dm2oKxHhlxX3oSDLuUriglk0KA&oe=69DCD1B5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8QU4Qz93PYQ7kNvwFl0Beq&_nc_oc=AdqLXnMwwo-fLQT3-3g4B_Iucj-oaxxO0GgzWtJL54BA0PH5f7h80ErfdQ0lRYLysj4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ABxWZjvvD-CWZ1f-8rK-WLMCnB0hwU8RsfKB4-HUhZw&oe=69DD01CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0TPhMufReoQ7kNvwElybuh&_nc_oc=AdoHhzEddA-_o9lsvxxF5ShRp8xqvxh1oFLeNz8i7blkiFsaFdYJKjTt1bJ_Va6GBH8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2VOFDXC8Hefu3Fmtxa3gGj4ExZJ56lnRk9lpDwgP6x1A&oe=69DCF73F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
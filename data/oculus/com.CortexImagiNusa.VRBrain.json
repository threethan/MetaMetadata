1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XFg0q8v87c4Q7kNvwFOIldz&_nc_oc=Adq2zPBJ2LaCX281rSxMQmM1rb1behCZ8k4gMe0xwYQ5xmqnkfyLS_U1Zib36xfjUQ8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-XAhifOCcOlwneDOZHUtxtv4t_7_aqshk5FEiSYnDosQ&oe=6A2C2CCE"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=R7R1FEyEYUQQ7kNvwFQWUdj&_nc_oc=Adqn7pEEV8CH4cENOwiphN8lHarvcljXfyMO1UgUJ-ESeUemU5SEbj9OIp0SylSt8to&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-tgRrCxEAQzHZnnbhzGX8i8_hMsGvCOTZdsC20k7m-lw&oe=6A2C2612"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=32oVvi61XEYQ7kNvwFH9Gom&_nc_oc=AdoUhQ050acMG5GNSbkrUTyQxfeGJdJyzqc88agJQcZoL6N99cyEDyFz_5UuSackTaY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_tXGybhJ4Pixl8Pa5ifKA0xopB4yGS7giskN_mmCczfQ&oe=6A2C23F5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OljEXtEYue4Q7kNvwEkTLE0&_nc_oc=Adpgg4Xj58jvK7axwxIiKUhSdPftlvZf8BEglgUvhcgeG_rsE5WYss1BeeIHEc67Jdo&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_5bCv9c4wAdqX4fJycYcSPbiR3pCxBMvgdH_caL3elxw&oe=6A2C1BCD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMSKOFLDjaQQ7kNvwFUDFXk&_nc_oc=AdrnRv-DTPpt5BDnRgQ7hALpsIcVueoxC-Rk05RMe2r006uBuHLJEFCvT3VjI6kkTyk&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_QWFUhOkyeRdTnPwtQMxw7RtJUx2bOgQLOs0Ee7W9Yvg&oe=6A2C113F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
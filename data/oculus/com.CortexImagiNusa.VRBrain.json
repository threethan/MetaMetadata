NvwEKV_Mn&_nc_oc=AdlsGBy9sXzkhdUF1wuXm5OMls5PT0p__phGKjA6WELzTrfiOvBnwSiT_oqULjb9RLE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Afv6hagIEKNhMxCXOPX_crW1EjA89f3_-QPSxGntuDy-bQ&oe=699D928E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HteY7utxU0kQ7kNvwEy-Eqp&_nc_oc=AdnJsErk5BRC4tt59b64uDb4vVcqNCQn2K6bTOsRUk6Q1_f0S28OEgxvVEImhH8FhZQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftEjkwfoYF1RbaOrnt2HN4HvpdcKBteSZGUo9BXRJhslA&oe=699D8BD2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mgvnVfRXSNEQ7kNvwEVRpEp&_nc_oc=AdlPJAVD81gyvV-HMVl7biHTM5TKxHspxqjJS-W5bGoj0LB2u095CGiIKoE_JR9yrUI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsW8Rru3zF506u2QX6uCRtV5x_HnrGCjqrTgHXakWVQEA&oe=699D89B5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Fm02kPORuAQ7kNvwGRSbXu&_nc_oc=AdldMl_NO7Dn1EJ3c6ab9K5jvqX_3HY0ua1PHgObjRbxxkOGrTv6sYcvc3QTQok-d2w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvnT2XnzFZoF5drmGvXOscDZ_P-lgoioQ-CefCKXt6boA&oe=699D818D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r7OzAd0au84Q7kNvwFrrakz&_nc_oc=AdkMpXNhB8Fj83zaY6YiSfUVu_e2fMKyq9h4GWHbOUv5Ve1hnP3phC5V1VYhou25HK0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AfvjCoYSaT7R_nFhuxtydAhiZ2pQvCrDl9MGp2iOIFCERg&oe=699DAF3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTI
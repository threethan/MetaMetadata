NvwFmZauW&_nc_oc=Admj6xNFxDSAr81ybYMLqB-l77jzShe0tL5X3b2NfoMNHN7cR7RT8SRb6-EiGhJc40U&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afs5i1nSzQTNlt4gba_e0YeH6q8inDAQEogr46EfQxyENA&oe=69A42A0E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yYpbcRHJ1AYQ7kNvwG8V-vJ&_nc_oc=AdkMJOXClWeAVmf88RmV6UfCK-l5Zo6vIA1DRnTwUrtNSPWzCwVYARv9B2QaNiPsXAM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfuYFVX-2XEjrYrL3ZXK-tI7rvmN04QYunQIe4Hm1wsZCw&oe=69A42352"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3yo5OArrk-IQ7kNvwGr-HSS&_nc_oc=AdlzcrBmuYOqNf4ix9xuahVntfKUiN58aCuwRxIOUw3JLZozeTvaZaxZESxWh9Rfqaw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuGDDILmoPGWs0DV9qcjmEOQuvbNvUmE446Bp-J3fiJ7w&oe=69A42135"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jgLWBYPjyiMQ7kNvwEzaUha&_nc_oc=AdkLFND0knAuE3irDgcrIRGE39ZHxNu1mZitoryL280mYGbFBdNzUvzMPgwMQwUEQjw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_Afup_XUrBYMbvVdoWXB2hNvzL32p27SqPqeUsc3tSufwYg&oe=69A4514D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lbejaMSkhkwQ7kNvwGbl-LS&_nc_oc=AdmZwFYj_vdSaqa10PqMabNz5z1FGqlGa-aDYY7zv53iblbj7M4iZEJ8FkAkCLrAO7A&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AftGxq541gkz8IcdKwgwm93gaaXSfIw6y2_mRy2EcKh23A&oe=69A446BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTI
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bou-dGr0nHkQ7kNvwFyc0Od&_nc_oc=AdqiD37scrapPs74dYPrQQxaH8jF-ELprPaaISLUHNQ59DGzt4vdMC1EpYJcv5OeB6Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDAL7SGdb_EWy4kL-WqEknJNEUZYk-MSIKMmmusV-239w&oe=6A68998E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=imMr6i7JVXsQ7kNvwGyzeJX&_nc_oc=Ado4DSSFFbIbq7PtffNESI_GuzUTnLysAIoQdKnNs7U_amGcezTnn-8sW8qrZATjhUM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkZsJjujHFP2j899L89jJ_MpibI8ZfgFD4c5PQoJuCXA&oe=6A6892D2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lCArv4tMDK0Q7kNvwHIikHf&_nc_oc=Adpj0weJWpwBjOfmLWveugERemASD5Z6CAsT4vCgJpas-9lBH3Vds_7abo4EejQ06_o&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAf3RjUw-S8XM5Y2xAKCUkrNYtvoC4I2dEr4hLKhMEy-w&oe=6A6890B5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YI-R7M6n8tUQ7kNvwH5dzPH&_nc_oc=AdpTgMexWlZ06U7Mouq3TyqyBiKQFv-nMh8hvpx-zjexUWhkLMbs4qrddcSlg-UJ8WE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAwa8FOu1HnqOGI6bduyrAIZvyZe7WqAARfqk4oKzlvQ&oe=6A68C0CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Bzcs_2yx-wQ7kNvwEVvpgV&_nc_oc=Adr0UymAPKdk2RMVD7reSWGwpEGRpsBE31n8ebLTzGTduvBfaFWn0XHD9CE32pxofDc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDSBZAiQ2SkwCG7yML67WVz17upJxWzsTLGClvHDcVqPQ&oe=6A68B63F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WWWZbXghZIQ7kNvwGXhCCv&_nc_oc=Adr4jhgHePSQUnUdQUFIzoMlmHgJ4NwEdxGChXXaYffLz1it5OjRdywaFynoKRyL5XQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2NGv0GpHhJSqOzvhfz1vbOu9oGEZ7agpI9zUcK0cvJBQ&oe=69EB5B0E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmBHERoo1UIQ7kNvwEDoxAk&_nc_oc=Adoz7ypyqTu3ShhOGD9EwIsSQG7ud692TchDAmHhkPl4d95EgJCwaf-7gP0GGbhmceE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3HlcshLXN2iMud58v48Sel5f_IimIDNq7nWirZmgK4jg&oe=69EB8C92"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdVvy_sM7wUQ7kNvwGrm4AT&_nc_oc=AdoN_AaUNyp895nKkRBcttnZqqLKE3G6ALZpZNtidgXmm8zYaRsWWaGvsQoYD-ZaD4g&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af27CiREAmQn5-vKAvZXT4Bn14B9oA-qF690gnjbrkcHVg&oe=69EB8A75"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dY0JzwC3MgQ7kNvwHmKx_h&_nc_oc=Adpf_bA0X6Jb3sjbgluwAgi0JwEL-GrhILHBl1rJ4QpLsSPJ_tTooq66Wo1qiCyCYw4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3kq5HgVNSiLcOLVnN4PcKp7WlAZs6CXeCqeRH8eGp4ig&oe=69EB824D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luEu1s-f5UUQ7kNvwFOoxjX&_nc_oc=AdocA3TA36NWW0o-MM6rLLbPyHiHgy1V4jKkejt4tgTuOEjZ228qtvvWGuvMvAPBjBE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1XjWODRGqYtM9v5AY5bKggvtPf3COa9k-BKMZx9b9a9Q&oe=69EB77BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
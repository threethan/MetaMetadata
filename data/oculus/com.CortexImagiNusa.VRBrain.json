1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBKaM0AxV28Q7kNvwFySZ3r&_nc_oc=Adqzuro9o2U3Wkkh71ZVG_ee_oDP_CMwmzOl56YE84_lbiDDxWKu-2Lb6iS0J4oKPdA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7nTRoEbWckDjNKsq9fQDxEfkkZg5XwBvOxGGxwvi3I8w&oe=69FA13CE"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bwT3YbYH61EQ7kNvwFca7HC&_nc_oc=AdpMVNIJXZMTnM7V-3ex-_jZiS20aQvtnQkCB-_Ofr9vDKn7Y1_7EnEZO2f2ASstnWQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4NFwrMukc9dLbCsrpHSJTJgpDSoQxmdL_0lU4jQWv8OQ&oe=69FA0D12"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vZbM_EY1o0EQ7kNvwHPB40r&_nc_oc=Adoa_VfnrUTzhSN7UpNtMvsJstHGClCJSt1xsvJctd8KV5OEcj8j_G2EQ2iDCq_MNfM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6mD8ZpOa3HE_HT3E7yX3I8cVLiPaAVQ4G8sWoRXqdysw&oe=69FA0AF5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AbRq7tCNcGwQ7kNvwH9Nonk&_nc_oc=AdroqNKpN5Cci9-PGzobW0QpK_nMsjgYhR_j2IUBTg9VFNiBra-j9j-RG_RWlDdTnIY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5xZHqMtKljQpio28gPcTlED2NznO8rnpv8EvxaTaZKwQ&oe=69FA02CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T84MDnrdh7AQ7kNvwG4R62H&_nc_oc=Ado0SE-4w0am-FTmgtQ2VBTMgP2ybAPQWeNp8HM1g6zI8Yp8YUQJAJ5z87ta6lZJ928&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4MJkOS4_KyzZBm-ctIk_yy-vtCUh526Iul9D6oTQeGDg&oe=69F9F83F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4XzuBAoPu_AQ7kNvwGFf1dA&_nc_oc=AdrLeebJZoqXq9WxkWMor-3z5smfqqPjxR0K3rZ5tIz8YMhKXIjKt26Sw5nMvD0KshE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMGVQafsRAFNBpeTxI3ar4Bq0ixFPFgJVM1MEpbMuYgHg&oe=6ACE554E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qem2xtZSl_cQ7kNvwE4kGOP&_nc_oc=AdqApMPIqMq4iI1ouSRffkT-QfREQoZG46nGCIKnselpzqx3U86EeImufDVO1twgiuM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNBc4GMa5pywFEWgYvOk1mA5iWKkcTd1O4nUMgu_mLmMw&oe=6ACE4E92"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YfEpriXxyXcQ7kNvwHNGSip&_nc_oc=AdoURDGci2y3TCZfLxwxRkSUmQbfrTry8OuKIG10pEde4IH1p_3tbFXXucL_gZtJUkc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOwdoWbxk4f74j28Vv5lFG7ybJe5Wsm08DRYGDnN6WjEg&oe=6ACE4C75"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6bCM3raR968Q7kNvwGHct8Y&_nc_oc=AdpyYtl3_q7mfHcu_xgPoTz7u5Aj2EdKfoEaVnFNZnnxEz2SvBQ9yZ84MbMOpeVJKuY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHJInUyicl8dW7Cy399p-Beab2yhxQeYpKjG-0x-9Zvw&oe=6ACE444D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zw5VPo2ZFosQ7kNvwFcwBCX&_nc_oc=Adr5IGmXde_41DuGx0YBJ1ZclxqF_4Z_C4m7g3Eojl5sa5stvb-l_ko-EtAhh3en7-c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_WQ-yQh_ySUPAe0Gm71PK5eKCJj5EaXiogfoexaJfog&oe=6ACE39BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
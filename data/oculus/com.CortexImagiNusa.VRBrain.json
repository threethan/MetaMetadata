1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=68QcteXG7GEQ7kNvwHcmWD1&_nc_oc=Adqihu857tZanSSZCm9RQrVJznxiAhyQBxnkKOrGv3X5IVzB5jIvvdUxFewpmnaQ9c4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNn6SWOGhiRamAwUzC14YbQTjpNiXOxHCv0K27do-8VMQ&oe=6ADCD5CE"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ap3G8tjiNasQ7kNvwGDhEcO&_nc_oc=Adols7MwTQ7DjXMy69QpkPtzR328910_e54lMxRNHN4pOEP1gKHxg35DmwQTo0zzMKI&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOlffIuNyQ5QbLk-jrAWkcfkoET96OaIXx-L9U32Ymg3A&oe=6ADCCF12"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VOAvOeMvmPoQ7kNvwGw5RZ-&_nc_oc=AdrN8-wFojG-AFvISDjTaaotkepbFd3V5ArNfcAFdFucpGDXyZUnp46I_KYucwOcedU&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM_CoQ_JsG675cdfCywdoMHoAdLF4ZCXdnokQCYbu9hOQ&oe=6ADCCCF5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_JqfydYG5cwQ7kNvwHzgkrm&_nc_oc=AdqKug72REiQuoBJNMSCOlnXok4n0v38hHXq3axHX8VyhvF1Ob4w8Cm62yWlTBtHME8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMNnN8j6smfSO9h1lpxPWnDIIq2RpH8aGHGgimVp0CJEw&oe=6ADCC4CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BwZLcqu6Va4Q7kNvwE5Pm8k&_nc_oc=AdqVy3QkRXuJsIga7YwvV9T7xmKhv2GafH9ibAMTufjXa7zde_nkzSO9qt4uDxgMMIU&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMeP0C5Do_ip7NI_qqe9YDFmpIUhZfByNtogjrieHcRRw&oe=6ADCBA3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
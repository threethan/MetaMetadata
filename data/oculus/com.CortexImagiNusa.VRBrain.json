1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xFvas_464AQ7kNvwE7grsi&_nc_oc=AdoGAE0r_dPV1G8djDDlapw9i5DplHvOIX1uVG6jxZdquhMcb37RQoiXkbOA_KFbAU4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1EldDJu_R6-3ROYelktAlbSfqeEcW1XYLtNa92sCCTuQ&oe=69E7668E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_BHAj6oUvQQ7kNvwH65b4k&_nc_oc=AdqYZ4b94Oh9ZpeYEvngb67wykrPpaIPvXlHyFQ7KHih02_Ix7lE-PRqersd9pRtbgc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af378fL6kh46bv5suZRLjoVY_v2807RiCA4z9Z_4Jf5GDw&oe=69E75FD2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iegIjEf-3sQ7kNvwG9gvF2&_nc_oc=AdqXIORnsMFC-ifBYSX08GbQ_tHsLI1w6YMGQ5FfIXDg9MrK2n1mTb5Noe9fHo5wTsw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1fNhdntj38HqvJxsEqp60awLf-GEUXLPqUvSh1CwfFgQ&oe=69E75DB5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWgJk3URNGAQ7kNvwFcntDB&_nc_oc=Adq0kXj8u0CBP0HEGuREqL_hzXf45o3QdmqNHiR7N85WVb93G40_U0acRnCNNxOq8us&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0IjHgOqVvsdvbK56YUQdHHfhDBgNGizXfSfVzyM293vQ&oe=69E78DCD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2s_Dfiw1SMQ7kNvwGRrpOe&_nc_oc=AdrvZYISN4t-L8tJaB-RM_lm_THYNY95dnuUcPOZekr9V6pMQovwYpTbMWF9SPmK07M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3oMZXnr7LNFsqHRzTyLiLsq5iABjkogLTggp0hbrzlVw&oe=69E7833F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
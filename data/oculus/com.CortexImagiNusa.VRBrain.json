1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jb3QfVm_kEcQ7kNvwG4o40U&_nc_oc=Adr1G3O8ded4Y9dmD0LrPBLyLlKmmwWgOzNdG9xUA_EVmEGNP5FKzSgirLx0Byq5Qtg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxZ4a2HEW9_Y_qTAhzk33fWzte4SRr8dXuOne2Mebz-3w&oe=69C27C8E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojKvkFM0XAkQ7kNvwHNnFQx&_nc_oc=Ado-R5z-g1Duw_aSvLR02Cz9gqzscLjUAfS4XbWDsLzqO0UX-pQ-PmjIDvVxyXzvQK8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4IeUtrbAZ3NjoiLe3eSQS_mrmTPez_HdU_MkRcMEIpQ&oe=69C275D2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hp0q9XeDi7QQ7kNvwH2chEg&_nc_oc=AdoRC9qn7WTZ6Wyn0dYdp9lAEmkAd86_HBxbKsoIqu5JZdXIIValU3cYuWqIImtcMTk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy7sy8dlJP8aHbVKfi0k9Y_f8BquYePVcV0mORP4Up7-w&oe=69C273B5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9LVixsAV2kQ7kNvwEIBtTx&_nc_oc=AdojZURA5iQaAf1kqozUnrqPBldSNyskpFclOTE58H6FKjlCOUfw_ZViFqfdQ8pcmEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyR-LNrVGZto4_VUHEP-HgcCVUxBZs6aXjNnL0q6i2lbQ&oe=69C26B8D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tGYpKvfwhroQ7kNvwG0Clhg&_nc_oc=AdqmE1gRLgywzIGfC8l0j0ZwLiMfhVTsSWgtr6SJelDeobde4FaMNmj48fU9c27j67E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_QrX33qPmtfx6fa0IqoNTFzEGosc4xxjIazB5D-32CA&oe=69C2993F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
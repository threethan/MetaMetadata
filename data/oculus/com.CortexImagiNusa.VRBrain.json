1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LsQ8lXIKV74Q7kNvwHluWi8&_nc_oc=AdoyvhdGzZB31jMv-fQYeZ92E4NEMnVucdkqACsqmREngN5Jw9TPnPzlC49kthJxlbg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRVG8STeEnosU_Na6g9C_iIzxyRSezA68_c62MvBiws4Q&oe=6AEDF94E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h20oH_bmNkYQ7kNvwGu3O4z&_nc_oc=AdroKHPY7uvdjtGABRoS20kAh2-k3H4GAaaVT-4YUdwvjTGOXxNtmVZWjcYdCEBM0CI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRl1PPjeQBKrL_XwzKwsgXoRSLhTU_zC-tfq7Lis2jGWg&oe=6AEDF292"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oG1-ABA_BQgQ7kNvwErNjSu&_nc_oc=AdroBv6AFJbYeEDAOmCEc1IF1Bqho1C9gBF6b1_rx7idNE8T2PIsXj_fkGGbDcQ0G3Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT-Tdd2ovZcYHilPWNflizItpFCk-SWl-WPV_ulX2Kq9g&oe=6AEDF075"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8qIvFGRzawQ7kNvwGF-jgI&_nc_oc=AdpCID1efPoDU3CuFrGOYBndmYc9ka_TmGDZwU7-VRSww9nfLAxIqgyj0bZeGWHW8Kw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTLw9o38i6va1-auLE3PLKf2B-GvtWvIkKQMlgPu3hmFQ&oe=6AEDE84D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QQUKCD_KKqcQ7kNvwH1VjhE&_nc_oc=AdrcZVbNjzpKJ9AMOmT-lAxGDiQlzBAbphhwlHiKPpMJiCi8B5lttlzCJefQgy1OPxs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQrbo7Rnv8KSzZ-PsUzhmgCklf_tbY7ZIMa4IFt4WLclA&oe=6AEDDDBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iiqTu716AdgQ7kNvwFX0thQ&_nc_oc=AdrrEe6YMcC8-nFnZQhEqiklyHJJHYQckVyhJKhsNFsAycyJ7SUSRgDMFCu22BcAn4g&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6AgH1U94iSXQDuwPigT59sj-8uMcbZ3utHKBvSZU4pg&oe=6A80548E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aWq2aevlAQQ7kNvwGsoOha&_nc_oc=AdoZMRyrLrSEoPD7ZmkIRaVmtZsCAlYIJiPTkYxe0CDrynE24sHnQmD0x3DkO9Y_Mz8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHxUX24CwDVjrT0O98Ikiwb4AuvMaPti2OclQJVG9OPwQ&oe=6A804DD2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=a_oZxQa-LRwQ7kNvwFSkfB5&_nc_oc=Adou_aQE8CkjIaAcidvyG0mrueINoR_GC8VF3_-2zc9kcELM6XmXfBieBK2wtdp78vs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEJ8_GntFrOaHBeR0D_l5OFKTABasxR0xX9HJ77754u_Q&oe=6A804BB5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xm8VDCeBY_0Q7kNvwHa-N0k&_nc_oc=AdpsanmxOfYPcrKWTVorcTTAeMjvCiz7nJuzJ-CJj8ubixe0O5RroCU9XuAGlPuikx0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4hvCmlBkq7CQSHVhwhL_5ACoJbjQoZ6qh4OMl0K8r6w&oe=6A80438D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=foZ7x5zM-OIQ7kNvwHyHHlr&_nc_oc=Adq8wxpgwZ_tvECsN7-mpP1Ltgm5-0HPVklcrJEgSDS1WKr92XL9GoQZmRoKfCEY-4A&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJskc19U69YIHcdptQr2YPHagJ8rghPhfstK8hIA5A_Q&oe=6A80713F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cafL9TnZYGoQ7kNvwEVqRve&_nc_oc=AdreI7fWx3K9titEpsaWQ_B2IknDQSm_6Tdyf39LXO9I5OVwLD9R9NjgVj8GokkCNVw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SSsZo_Z02nbiov_SiSYZi8kmZoJAF_FboKckVusL5QA&oe=69FDD00E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-dfw5-3.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gFiOGtrzfggQ7kNvwFf10CW&_nc_oc=AdowjYTB9eaFUYNZTRmKR3HhutZwGdt2xgJ6GQIknvdoxop5EkSr9c3sfsglPL3H8W0&_nc_zt=3&_nc_ht=scontent-dfw5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5hJAS9WOwWCoqSRkeQzpMvw6lT-ATiDRxHRayju2VlYw&oe=69FE0192"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsdZ6cg2plwQ7kNvwEThgqA&_nc_oc=AdqfJlyzywhvHpelvzfKm9NYpRf06pl4j4bnfWAdJx2_E4wwspQVW5NavEKjETvbtTc&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af61rgcPfbeKny8EGTm62VYfy2uqlcc1KwgIqCJFo4x6YA&oe=69FDFF75"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5p9ChZtEdtUQ7kNvwEjs5Tm&_nc_oc=AdrlnKcZF-BLJeFjJMTyfw6HpLeHMdz7_QOLLDFgeIld4hRomwaxOOIhBOrPQ1BSx5w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5BWpDz5yoRJy8o8BHK7E4jQXPwGo9mJBetKJuxSzW1JA&oe=69FDF74D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AE6DN1Tb6IQ7kNvwEl-Y3a&_nc_oc=AdrAViItR4ih9CNJ6vWFiL207SLCbeoffP9gDfPsTrCpkAPHw6nd4jEC9Iq0RCYLqFQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4eioUJPEmJVurTC9jD_fjjnaOyWFIC0tW_ssy-ds6cRA&oe=69FDECBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=viV_4-Y99sIQ7kNvwFpAHds&_nc_oc=Ado5pxqoxJ5sm-uIRcvzx9NJo1V392O5fkHBi1MRzCdsGnXZysltR-ExhzY6ZvTHqEc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4IRzVsMpcAdgtNBoCHA7QV82CvZQoxY0qYFvd6whc8Q&oe=6A92C98E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Up4J9_SklVMQ7kNvwF06Kem&_nc_oc=AdoOPI_Soe9DTMo8pw2H8u4ykbPP-gGOpIhZIlz-5KpPk8MeJv8y1-ILsWMYjg2y68Q&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEzG6DPz2vwkDSZHkWAGKA26ras37r9pPnl0UJk5gOLXw&oe=6A92C2D2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sPTgb7VCwFAQ7kNvwFQ76IR&_nc_oc=AdrjreSNhI7vRxkHwcxiDS0GoLg6AN2YQn_qmvSWZ_qYW-EHQA4DEgvoeCQ6nUQBEyU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfuLr1G7t-XYcoVZYPgjdzxr5P2CrE4g9R6wh6Cs-YTg&oe=6A92C0B5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=axiuwbqooTUQ7kNvwHhFVJX&_nc_oc=AdqT1xjg2D0F1AoY9BJ4Sh6X_GJuS1kg4vzP2pNv-UOzAn6wPxM7LWY3N33oj163QmY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG_mITVJNYel-nRFQmhyb6WUETrKhJUFXBpNUBLSwInRw&oe=6A92B88D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lBJoaP17Sg8Q7kNvwF_V-3J&_nc_oc=AdoOKXLjlhj5Gt88Nur_f5F8rNAzanvui3YjdZ27cVtJxfQvA16CbUUeoRcWN695Jn4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEEVovj_UxFtoAAMcmBP_YaAN4GF1Q0Xhjao8z4jzfGg&oe=6A92ADFF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
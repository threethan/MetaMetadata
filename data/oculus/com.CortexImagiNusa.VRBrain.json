1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=146JWDxtAXAQ7kNvwF6RwEu&_nc_oc=AdqHfJ8fRnvMUw63c59ZAJ_uCKMseqphC3Mmw-Zejjpke93rzkEFeVDQ4IrP9ncipQw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HvJT9nQjtDdqsI8zZYuSr9YnzyUUqiFmtc1rgVcOdtA&oe=69DA378E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjnDPicSipMQ7kNvwHx3mvU&_nc_oc=AdqVf8O85Ne2pe0tCT2ePzGDww0FmIN2_gW3dFUT0yQpc3IdPCgdsckHPY9Pt0q21UM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Geih95QT1QhkxDOsWMr9Il8C4KYXX_ujEwsGJuyzC_w&oe=69DA30D2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9UML1BU6pYQ7kNvwEWXWIB&_nc_oc=AdrA8_HAIn1Hpiv4kH3BwZsUPtoyBe6YpCCetVST1QgnNYrnIdSMeLQfNiT4S_r3KcQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zYbIUHUgMeUjWZd0t0SgiaZ7TMIxJ2QDMATKyZPvzag&oe=69DA2EB5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8QU4Qz93PYQ7kNvwFZjLGY&_nc_oc=AdqM17YArh3Yu0BO-gxypXBts2rjgYZfw4S92Ag4_t2_w9Sjvki-kb6srYn3w3rgElo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cx1Rclf2WqpHvdB3VIhfKweTpSg-b8zc7XYEV7tsy8Q&oe=69DA5ECD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0TPhMufReoQ7kNvwEJ_MU8&_nc_oc=AdoDmYdo3nRQYN4FJSdRjNfIchXuuTnLNf63nSt2vf66Vh7XHTb9vgu0MeDfmPLBftQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HddEH9O8nGgTqi4ER8GEkdavXwnmePXlfa5I3MgY9BQ&oe=69DA543F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rp1pw9AO1qcQ7kNvwEclT7J&_nc_oc=AdqU-U6v69sXYXlc92rT3cnxMOznkTo4XUNrLipDtzTVW2ODirSFymh06u6w356Ydyg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8H_Emgbfuo8YzOnUujAc2Sm0EU4eR2F9rcqlixYj3YXg&oe=6A3EA1CE"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx_TcbvKJl0Q7kNvwHF3ptE&_nc_oc=AdoyoymsJ6E5mB5IpXsYVZdF5lVzfKmrMf7pwZnJKRYOqWGlk4Z3V1s2T6D91A_vxBI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-AGdDfSReBX_8fcRRlf5lG8glr2rcHgK3CI_QRRPrqIg&oe=6A3E9B12"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7Wix6By8PgQ7kNvwHObdA3&_nc_oc=Adr_vrRPCLf15gJPPyA29MBL7whzLwF2YH5uvr5gE09jXrcRcnxTDLP2rYlyD_GiBb8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_9K3a8RQ0HYqzEaOpfjwHhBF4L36i8jSkvi5CttbAgHw&oe=6A3E98F5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3pRtxjtUs4Q7kNvwGUlFpk&_nc_oc=Adpm03nU7m3Pp9d4L1SfKLlkof8ZjDR3X38lIdVfuPWphfDTOWlBdfy1iySMZS8llsM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96yPBOXOemCsmSZ8PQCLMNcbIxq9AGlgE0LYLK635ssg&oe=6A3E90CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvVak1pp1GMQ7kNvwH0qB5p&_nc_oc=Adr1k03_zq1kWQODXRrMSNjf472ZoJJ1sU5K8XEVXEs8h-zgl6knzp-GM2cvJbVAdyk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9frnCDONOlwQ2fM3EjBL4orJWQ7U4NhLGDX0js8a7L7g&oe=6A3E863F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
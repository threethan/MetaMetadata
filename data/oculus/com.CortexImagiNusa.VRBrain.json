1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDNVXwjmQHYQ7kNvwHxcfhk&_nc_oc=AdqA-dnGIL8uB2C8Iq2XMRbfKYWGbDwUWDhyr6lqfbKGbFTuisQJ6hammVluO47vSQ8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af70RSJFoPJEMF_wnm6CaqqL1DZM5ETuFmXAZ8B4BX8Lzg&oe=6A1DAC4E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zdrcOtQIe0MQ7kNvwGK-G71&_nc_oc=AdqOWO2gklbzTMkgY9LPRWm89m_6qDGmdY2U1p2PXbgmr8ovpiWrGuMglXij6pl1Ji0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4kn2P7DU04TzrZB-xqYR1xUGOvEpSkXA0BQO9MIpb6Og&oe=6A1DA592"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FryAF4YTkh4Q7kNvwG7DH4I&_nc_oc=Adqqsx5Ugs--gzhbeS4XyIGtov-iKBltGBNLnTPqyuX_6LC2m-dIz1aV-MBo4dfulrE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4d5ya2Janni1CTDzJcZGP_e1g1M9z6F3kf4UU89kur4A&oe=6A1DA375"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pvh36qZGI8Q7kNvwEUZ1BV&_nc_oc=AdpyfWOijP-KPdO2g6UYXV-kFXAqWDQGvLBLXBf3VcZXKa_3q7ti8Bb2f5trj1Se-Cs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WLkVMgga_3p8GwYxmVM6Z4y2yh6BwOssgp4I2dOBGcA&oe=6A1D9B4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpKzykoBbWQQ7kNvwEPwy5y&_nc_oc=Adp2iauaZhzBuVh8skNeGSsOTfHcY0BB5eQRwVJipYcGpX5HgTgHmT-XHpMysqm-zL4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6wcIwjzisOgOOVYyI8kq9qfLOqZ-up1pOSSXRGUNFr9w&oe=6A1D90BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KZpwWDbAwYQ7kNvwHIVsnr&_nc_oc=Adrv8HvExG2bGwFwAHuBagNVVrXOWP2mkV5RpsubnE2LIjVAMbyrlxsMlFb91Q79Gok&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkQbe5t1jbi361r6mkkNrKu5I_J-7iE4AeQzLpSVlq_A&oe=6A5E0D8E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOikdXgGTWMQ7kNvwFViUGH&_nc_oc=AdqREQuhOyrXY9R4uciFGcsIGJwlhvI57NwDfoJ6lq5xE-t1wui4Uo6lY2KtQss2r7U&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7PAa2jlTySEsdlSRvvxwuFLMLkIN7ao10wxOeEHhyUw&oe=6A5E06D2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ7LdleXnvQQ7kNvwEN7Drz&_nc_oc=AdpyRQ_i29mdp0TwKtCyefAMBSE5oW-XugtumkJCg7ITYu2qrw9WQBD7iEjZH0hmpBI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD4GNvdYJrUJadLJTxgLkYjnPG0WkBU7as3DALLNJMwzA&oe=6A5E04B5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6mJLsxIfLkQ7kNvwHw_HBP&_nc_oc=AdpcuVvT-Eu-VI4t6hIXriA9gq1yUr4npi1K1n0YeqGSenpdiPutYNqolMMovzcBerY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQALsrgpfhXh102saQGNZr_L0pwHcGpNylw-NqCUxka3QA&oe=6A5E34CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF40SuENVUEQ7kNvwFFlOTo&_nc_oc=AdpMwI6UPlcnNnnEyvUqGkStoXy29wwRR47wEkdfox9pi0a-D437aJNejlCFxPsGKzU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA6uJxYn5eVlKMMgHj8VctTcJxuSI0KqoDUKwQHP77L8Q&oe=6A5E2A3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
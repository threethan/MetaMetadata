1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wwaimUz7MeYQ7kNvwFeQA80&_nc_oc=AdrV7id5c8PXX6ZsJkJRpYrG8lSdqvnnVVeHvarUjGpaJoVSW0-DJ1FT-f417MROc_w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4fTSco47MUptWxT-7mhFWht_kNp5KyQ-_yVv_Euhui1A&oe=6A00730E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gbvr7C6xMYQQ7kNvwGbD4nz&_nc_oc=AdpsSDJRDbHlvCQ9jMzF7BTfb82esU6FdeRsZiNqmiwfb5Ab1tnXdF85_55FX_fsF8k&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6rnvNsp6a58mf0npYDwoUVKjz68b8kxSgcWBgv_gAAXg&oe=6A00A492"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VsdZ6cg2plwQ7kNvwEmcsKg&_nc_oc=AdrlsG5ahUEcELnbqbyCDVtZyAhz-5Pp7WIwBvdoSQ_SIZFcXiAw0IYeLM5KqBRwEF8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RrkkYtYSgQWo88BCzDmHrg7Bvjk6_0WOmuLJ9irE1rQ&oe=6A00A275"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5p9ChZtEdtUQ7kNvwHQdpOe&_nc_oc=AdqvosvKKdaIpD6U_O9YJ-DST3o4knKfBpS8gA7JUClc9XhqpN4zrmiL4SLcLPxx7y4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4LCL7NkuOEOzxQ0ZjIgE3k3sfqHL6onWdg0sSzQWbV2w&oe=6A009A4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9AE6DN1Tb6IQ7kNvwHT-hdP&_nc_oc=AdoAV9dno92ZgPBJY0YVED7Myv5D0a5WBNuJDdX1Il-IJzu5ijh2dob90eKAkejFXww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XxkHNBSbbHLy4mpYDTHWNij7GTVtye2byvEsPBcCUXA&oe=6A008FBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
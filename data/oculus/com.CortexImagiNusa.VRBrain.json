1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYHEWs5l0gkQ7kNvwHMUTKm&_nc_oc=Adp_J68vl_493hzRlpXZCcJ7mln2gc4R6xRG5rxlGiE5SYo2uQnFqIpt3g_LQssbS9U&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCpLM9zRZkNR-RODheJfxh5OmDBpjS5BNy4aMGkNuGzeg&oe=6A54D30E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miboj7baVNkQ7kNvwEf025r&_nc_oc=AdpZNKPoieYT6_s3OtIEfKPTSEE7unEkVOm5uWZxJjrSObPg3NpsFoK4MX1ZHd4j7eM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA_-Yde7iNEpkVuKewnALbPAaENOfUlHhMVgM0sJ3x7PQ&oe=6A550492"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vaxstDXHMDcQ7kNvwGEsYH4&_nc_oc=AdoSvOkptqg-Y11N53lqqOCPQvmK3Yy5Lsrsdw6YFK-h3VJu7xzN7FopjEOlanXbPh0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD-uIkt7lRr61K2647OeTJV3dFGWEZMwr-ghfYSBanw5A&oe=6A550275"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qBuUIcNCjz0Q7kNvwEiTkm5&_nc_oc=AdpnMUHRSdkJ8AxaiijoS2ziuzGFCXsI1YYJm1YBPS-L8dEhwGmuoRr53ZnsXnwcJsE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDJtFKKeVo1iNSszbkGscrjwn-TAyay7WsOqyR1p1tC_Q&oe=6A54FA4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EtFEXtifMc4Q7kNvwEMlww2&_nc_oc=Adp5r0hMtFuiVFCLSGRxPVS48E3IKSo_RGlJVUtlGLDh_vSmr_65twtawSyAZq44wCY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDineyIkEr5kvNsajhCvo2LLj5_qCp2NQJjejdftpmCBg&oe=6A54EFBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
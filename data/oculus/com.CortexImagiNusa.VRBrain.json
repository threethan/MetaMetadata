1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jcn9ZxxdMAQ7kNvwGbXq-K&_nc_oc=Adogp84L2tH0NvetL6P8saI4RdfKzIysQ5w6If2YQ3fyv7Mm9Nd_DEG9-39AV9Zx6nw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGSYQVPe3fuD6xx88_sQVBHIMSQbOkprUQ6YvNvz8Li7A&oe=6A74770E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xlro0-7Wo_gQ7kNvwFvSs7t&_nc_oc=Adqd_Gej5T7oCi8ROFaURaFtDMnqavtFK3yz2_A3IJm34KysqUG6CQAwa-GBEp7XLzk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEN4uawZOyLlT_j7o4lVKvD1e0TMkJ12XxXwoOCwvngkQ&oe=6A74A892"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nVgrGD-FYBcQ7kNvwEA4wD4&_nc_oc=AdqGdanH8hwsWcVUlwzV81X_qiq1pEnuA7L4eO_jyIyapKVsd3ioTUCgZq4gsJPkJF4&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGC2qn0aXhE9ExnoLcpsxFFJKD77agnLPfsnvwLQNay7Q&oe=6A74A675"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZTi8I16ojeAQ7kNvwFEHV86&_nc_oc=AdrWnNzeLD9ppDn-fWsuZIAOpdke5Ced_wXVBLY04pAW_fS-a9WYiNjqT7JGwnf1AL8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFZhx23HnucrNiXxxApDhjiBy_iE6ZBIJ1pOnne0HpyvA&oe=6A749E4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ufoTn88ZC2gQ7kNvwHRlVs3&_nc_oc=AdoX5o-eLnE1injtxSpWquXxzT8yp1rwwbSxJNVnEvDn1tmeoWB0ZBLdfdxcsISUuUg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQES1LnabSPO6XyA3ZFcWjg4LI6stMJJAiQiK1Cki69hFw&oe=6A7493BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iqkNxqK_gLAQ7kNvwESuenQ&_nc_oc=AdrntnwtqWipRaL6ge3ek9-5VTUJskJ1dI8HT50gecnnQZhpRtAljT9lO5xtXTmHDDM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fuFM0cra0SH3F2-UdU-DwRIUCPCKNP8BAbZ09UcBa8g&oe=6A30214E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J4rOAyEMlNgQ7kNvwEar0BA&_nc_oc=AdqYZMZDHxYMpfhhAMCOSOuHmJvZxUSw0WDCwhIY5BuC_OBeviUYFlVVLK3X_NXaA6U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UOh0BLMWylH2BSfoONvhjbxqiBNfrNf1Q1YEZcrAKFw&oe=6A301A92"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nw1sko9SpIsQ7kNvwGkNDCJ&_nc_oc=AdrNWBDgcUzSq40Cug1HCidpeJXOn3gjDS8MIpJpaMeCaJmbjLVXO7NZcpJQ32GnDuk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_4Q9mfKKPZEVSnxv50M0YDuCUP35VZX_ASqV2IEpz4sg&oe=6A301875"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dEyDNuhgGUIQ7kNvwFYZf7t&_nc_oc=Adp3Xu-F1y3_INmxelj7mlkAMKSNxMZV-BL-cigYaKNYwO_qVPME9zfRKM4gN8duCEo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Xmdpq6ukdUx3-xTGmeL5ltuMd-EUmsntEWd_c_vd4-w&oe=6A30104D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=19Tf-sJV53cQ7kNvwEjnZpB&_nc_oc=AdqQDbb8D5NivUI5C-h82YuinKK_BeLrXBXOyXh4s83lgUCZ4ZNGbmsijeJQRX2PTTc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82rZYDcJsbPiy6bOagLaDXRSAQXn23HBNx-SMr-Rp1eA&oe=6A3005BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3xFvas_464AQ7kNvwE3hiq9&_nc_oc=AdrxLyOD08Dx62Z3Q2g1SjxAaOGlqIhl5yeNMJUIsdJEXKjMUKTtC5ZDMtFvahQg3QY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34eVl6K7ZJHfAYcsyBzB7pdTAmCLk16wghViVHkoCF_w&oe=69EA098E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H_BHAj6oUvQQ7kNvwGg2MDr&_nc_oc=AdrKqAXbKwtKjUvOtn6asAyCAy7vZUluSZlX6q7o8QzPCmaDmHRWEoqwXatUGA5I9sc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1w_yDspF8O23cYyggn6HzseqR7kztNL4GLrdp1zjpUBA&oe=69EA3B12"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdVvy_sM7wUQ7kNvwEeZ7BU&_nc_oc=AdpR30pkuZKTix6LwQQwwmTtg5uSDetBNGkXJX5wGicUXKKKPvQOw4oDpdyvLTYxd_c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0L8J4oILVsy3GFzjD49b2PMXh4uas0mrBiYfm0HDL2zQ&oe=69EA38F5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dY0JzwC3MgQ7kNvwEADdAc&_nc_oc=AdoA_dMGaOh3drWpDevfguU_kndQdzptH53gffHNlNqONnHabsA20GL4AooEmUE23bQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1y5P7IPfU4v9gtPL3vfKNHSylcN6Nb_cI7e6aY4KiEBg&oe=69EA30CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luEu1s-f5UUQ7kNvwGo9cfV&_nc_oc=AdoiAZgWVfaTpTWTJTRq84usMYKV2yamh5UD_ZNfRI38AlrYm_USff22xX5UMCcL6cA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3IiPGhjc4c4hbwKykZ4-oMyw1isjKO33x3HycvOvHnbQ&oe=69EA263F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
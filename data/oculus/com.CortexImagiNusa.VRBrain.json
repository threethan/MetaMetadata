1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IyR91ks9bZAQ7kNvwF71Xkw&_nc_oc=Adqc0a_6VvzHa3WMv8qM3NR-6RonqCihPmQg5IP4jEec05sTRWfvLwEwE-KLJb92XLA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzIpReDPXMzrZJ6ATiMNNaXs4TlZDcgR9_CDXsr8-Eag&oe=6A883D8E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=119e9xlRwkAQ7kNvwHf8GTN&_nc_oc=Adr27fS4ftoNwFN8w0OHDfjmPeaAsy5J7hw18HbOMfYT5P7JDqahI2IED5P9-XZYNEo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGU2DGlyIK3Cy7ftjWwmB9k4Rc1uUQIda3WGT2xnI1zeQ&oe=6A8836D2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=k6Vc6tHT6XoQ7kNvwGeyIuh&_nc_oc=Adpmo3CCEapRaaVQyX-kSvkghiCwYTczi1ilMrrPT0SMt0KesZ_Vwte6UpsQ9HMWneM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG7pLGOPEfjYupioB_7RbjbduAMJnW1eKtAqGF4qQqBpQ&oe=6A8834B5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=c25_twOeqPgQ7kNvwECxy71&_nc_oc=AdrSpLms2UP-uBGsTRLydzSsuQsesKAvrUlh0eLtjgs0bBco3ezKym2hfAZPNmxuFsA&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHHmlG9wM9yPi1PIRpPNf2-x5DDDmV_ijXsbmm6p6-UkQ&oe=6A882C8D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KA5iJIyYhT8Q7kNvwFOzNui&_nc_oc=AdrMkNzuEI0384tgEF7chf_4-9i-lvh5cWqvdch8vp1c7lEWHcZIz9SBdO9hh6rAxks&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEcbmvrwKQ9mI6t1du_BLfYYeERLQzsMWKa8ND0QLKtQ&oe=6A8821FF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
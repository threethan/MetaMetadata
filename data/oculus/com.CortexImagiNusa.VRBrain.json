1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s7BX1EwIjVIQ7kNvwEqpOio&_nc_oc=Adq2AV4l1QK9k8FVlJg0C8qZpIj-_kwZQQsYstzu5z8Gb8KgZ849LEfTeJlcxuIDY3c&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFC176W0fJDfN14EmSZ_2KA97bmTx2At6eeMURchDoXg&oe=6A5CBC0E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d2KRpWzfB5QQ7kNvwFjwVDs&_nc_oc=Adp8QPWjyQWJqYyMaB8r-SrAAG3UqlMgt4hcbQZGABQMZ-5Z24WU_II9aM4VWF1i05o&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDuELj_mdKqjn7hnQgpUCyiKVMpPBIGlFRZYO915QjZng&oe=6A5CB552"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ7LdleXnvQQ7kNvwEWdxO9&_nc_oc=AdpofUB1ZxSPsJt26zkY5bwAaBXOsccBLclXcCT9cgjyJnJDw1FggKd33l8rkf69jrY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBVCy63w2LfREfiOvXssHOT85Kb7g8fVRH3fdnRDq-4dg&oe=6A5CB335"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6mJLsxIfLkQ7kNvwGlXY2a&_nc_oc=AdoNOEZSTmsEX27ZMhQT9SYIm2OCQbx4VIJMyxTiF4LhuJTbOavkuiCRq3WuTHLPpfk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCr8pKRrn-tYXNsiYaqeGA-9LQ1t76d_LEkWw4nnnAyPQ&oe=6A5CE34D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF40SuENVUEQ7kNvwFLIs6U&_nc_oc=AdrIVRc2R2XtZcu7eI5SbM9pC-zO8hoOXAGo30Y2PAh2LsasGKoiYTY0gQ3Jp7kucjg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7k1LdE3bRTkeVk6ocJ2scGsi4CEvfdecmdkdG_BBZcg&oe=6A5CD8BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2PU6SM9cZ4Q7kNvwGRIV9L&_nc_oc=AdpBGywrSxBOYUDm9VHtVtrdB7hZqFiYn1H87W4dHwyGQa6IzUFsh_fLAdJW_mkTWXo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcVBjDo9BnNm3Phw2leHJcdGDLLij5mYgzBcKey_KK9A&oe=6A5116CE"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KS1FI5BafoQ7kNvwEV81L8&_nc_oc=AdprkBcE4HrGxPQ3F4EVCQlXJPqOWFnFcdt3-eiqpjyv9B2WGPNzC9YbdNQVpVE2Y4g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDiZoZ_9P_cZ3yjsHQ_G-XXc5C6R9zbIE4x58u747CI0w&oe=6A511012"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmG8WJlqa1UQ7kNvwGjplS3&_nc_oc=Ado9JrGV1RIssslwhyt-XZl0O_Zihu6FW-NVuWqAh5HvJuF3gtpMo53_A_PA_70u6d4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAjl5sa9rq55oYwe1e_zisAx6E6sXfExZbckLf01WTdCQ&oe=6A510DF5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtStGDBf8RgQ7kNvwEqYmsc&_nc_oc=AdqPwTYUp9NQnudNtPt91wTVxhLEdXN2L6ItymLOx1L4khKwyV8lhHwwOBHuJM_bqnQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD94bqwxVwoR8BlZegeS1lUEQFiJ0y8c_nO8FpJKyGRIg&oe=6A5105CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSXNAoPjcFUQ7kNvwEi-oC_&_nc_oc=AdpLerZJx7uzrh7OTbXklNolbGLrONn-lxrC3zJgrv77F6A-YWBZWnvdIIP31V2K_eY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsRCVEa3jtQI4iCQmyFnLWMmBfHlJ225EmWRNtKtwyLg&oe=6A50FB3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
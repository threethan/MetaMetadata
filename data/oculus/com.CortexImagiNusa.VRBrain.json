1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4S0OCOP0yhAQ7kNvwHeccKm&_nc_oc=AdqAeGx5huh27WhdQaD7Y_VAmq2Y958cN9ntciR8B_zTYmGRk3V-tBxw6u41TKLFX2k&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-Wl_YQZwDJNwy_addEppTxA69yp4sUxDkvOaaBycDtXw&oe=6A3D504E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReIJevLBJAsQ7kNvwEtVzUx&_nc_oc=AdopkaEfBgx0j6VWL7whSt1J7qppS5zULXtr4uN95XqOWGsGJ1toDBeLVGGPaVxaqSc&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_M-7SdnWFTfb2BwOEiJiNZcFsr_lfdvojsmKyMnrD_Ng&oe=6A3D4992"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j7Wix6By8PgQ7kNvwFSakba&_nc_oc=Adp8dy23Vt6ExJVHtY3nz5YbU2H3DPAm0wkZhouPj3KBtU8rl-lsVsqPmwdc8ByNevg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9FnI4bU0CrlpXotW_GL9Q8kPkirqqNDPKNBBEh8YuHjg&oe=6A3D4775"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j3pRtxjtUs4Q7kNvwFmoL6l&_nc_oc=AdqlrIlAT76HCWTC9Su2ab1k-0LlBi69thN9XrBUpMDJMaxRldy027hgsHSdTB-mMzc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8M3dVp1DgFdE3CQi6eYft7_xeWBXKaWisBQLyYXvwchQ&oe=6A3D3F4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IvVak1pp1GMQ7kNvwFNNnGP&_nc_oc=AdrZoSYIowEzHuPvjxYklpFQCJid6xxxnTkbICAGWbhSkW4NY0LUZHbQ0s8pRe9x3T8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9TXuLOLh2mAIzx8V5IDdtCxNOipsrW4eG-u5OaYFPNcA&oe=6A3D34BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KZpwWDbAwYQ7kNvwG1IHvs&_nc_oc=Adq-C3p-4CielaqpiwGRFil7M93ZnbWrCPVNdhtw-z_5uLhAhVjJ3jFeIDvINhqOoEc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCd3fJPjSEES17LAFxk638eIgEQySOuVca3ZGWIb8G7qA&oe=6A5F5F0E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OOikdXgGTWMQ7kNvwGo8dpw&_nc_oc=Adr-QwgUxE4il5zMIhZ03SvipLYucqAm1q4huLQXy66jFiBAU3r8gV7ONPBymrWIS4s&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB7IQjol57G6BNU15-Vqwioj_xyWuSsOwimnyFvidZNKQ&oe=6A5F5852"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lQ7LdleXnvQQ7kNvwFjtffY&_nc_oc=AdpnWnIO7kL6t6x9s3dFm_Tycj0FqgmwHbASBwMkRDT_R93ikXKxqW-AmzUgLmzsPLo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAkfiIZLxTww2ZcbSTSbZ1FWJ9QNIOmRAowB8lqi2XHGw&oe=6A5F5635"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r6mJLsxIfLkQ7kNvwG7BiDs&_nc_oc=Adrlgc2iXmB1vWKxUUar8ODqazfJS0U2HVdl7FWTpscxPmXssf85a8DOdALmimubIms&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD_AzE6es0kCOVn5csv0C7JmG50dn2vXuUcRaHDkJE5Mg&oe=6A5F864D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RF40SuENVUEQ7kNvwE8ARo3&_nc_oc=Adocug_OT-QutA-IOje-7NC1l4MfAA3bYp9JEJCCYpxP_g62SVPZGDiqv5nzKnni9uo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIneidRCUCIAcfuGH45o_IUcJMJx3uujju4YScVmQQ2w&oe=6A5F7BBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5rAtNgz7GMIQ7kNvwH23ql1&_nc_oc=AdqvGKlNDTmeuxlDoLJq3-jxzKnQieoQezw4zmn5Rk6D4CCMwEdQewNdLLXv23JXFQA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66LwuPjt-sGNRtuaektxo2s86z6eMQsNUeVqymNFydNw&oe=6A0B374E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ov9BdXAEJGcQ7kNvwE2yXTM&_nc_oc=AdpdE8PAar2SC8Ytqx6bCVRZQW9Fj5jrwbKOMVTJX4g7jAZma5kvDveOvBxdgFDa1xM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XwvuC-VRqu7sXNAN1pIOXwmQHC2fgJo_IP_wIKBgFFQ&oe=6A0B3092"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DhGReG48tFcQ7kNvwGLZ2zR&_nc_oc=AdqYPSbv2Z2HlNuNEZsFIIGuNSzBsAcp_fzsmKgchtEad0_MX33yjmTVcbEglpkFZWg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5p4x06YgShZvohDKaLluxnz9wcaeqU6-3Yjb5Gowv3Rg&oe=6A0B2E75"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A3wHxubj_usQ7kNvwGCekx8&_nc_oc=AdqAK8vr51ESwkby-EowzIKGtht8GEwD5Zlft7-q564uURanlXAudgK3zE6E4a0gn6Y&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7qVHBAb_pQlK6iCgWn0E8UPMI1stJ07U5kqRgsa5zrUA&oe=6A0B264D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sbmcl2wvGN0Q7kNvwFU_yfC&_nc_oc=AdqyPKCNtl2yYD-9n3GM57793isCVbe1U_YKMDawXz1AL2hQc2JaE_A2ZxiloxLOJY4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5q_S0kQtorgctj8o9EIwxyUqVj27HLu6pBxOcn1hrzeA&oe=6A0B1BBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
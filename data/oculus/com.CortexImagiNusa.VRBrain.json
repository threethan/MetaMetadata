1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZnoxxzSVPKQQ7kNvwEeHXjc&_nc_oc=AdoPwgxPXUschx8N46IfaNw4tsTiDhEglmVY65aNNFJLn8VwXSzqgaNMZcq-cVMr20M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAuzV4yvf55nqA5dbPw2-C2MF1ueqePRGCfk0uaj96mpw&oe=6A64A50E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uuo-ErTc4jQQ7kNvwHWgEmn&_nc_oc=AdpGRcP-iOPal9RruXLN87XTzSfzpxxFgYkwpPySM548BVf_LLiHfuZuXO5BJcjGqLg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBZA4A8Z7RXJ4frJfxqqjYabzyctmGEQSK39R-oVdB0yg&oe=6A649E52"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VswBIhXSRWgQ7kNvwEK1Qf0&_nc_oc=AdoVf1v3bhjp2HdRNuKVSGulEHiGs4ZQfp1kjjJ688cA4KsIuSTg0o1MyRQZXJR0204&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdQ1IsrcXl4bjr9Mqiud--CnBpPrvHIHa0WTaze3D9Uw&oe=6A649C35"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0eclyM6fBesQ7kNvwHBj5Mu&_nc_oc=Adoh-pICwMYQJHvgc87x-7Yw8KZpoc5GBDu2HcW3T2IoX39X_fG_v8A-gUZvgHquUbk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCV0Ajqci5Fnph-ftIxLuRKw3yFZmjqXXlw2iSYJPbI2Q&oe=6A64CC4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=B3zIF6JmTqAQ7kNvwEwh1Et&_nc_oc=Adpxt9-VvZ2hwrGtLWj_kxUUpgn5tzjSzr-YBUoSSrnWU_3a2ceck5MjzezcE-8iZ1g&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTm9RhNgqI7Hb5UEgqt4A92UDlJ_46uCWmXkGzpwsbKw&oe=6A64C1BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
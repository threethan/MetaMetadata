1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f0IwEI8vTZ8Q7kNvwFSG3W-&_nc_oc=AdoIhDoxdx3rE4ZcFcq5RHo72odYY5Ql0BECKq9kmIGLYQrQlFyVUXdNNu1lukqp2-4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2Bi2u6CeEifcD9R5CPtRIFkZNG5W-sqOkAxrj7BJ4DlA&oe=69DB890E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=swoeMIz691oQ7kNvwEOsJwe&_nc_oc=AdrmC08Qa0-0jq-mSEdfII303r4DPmZdsnY4n9KWAku7ROBtNmeGqVelqU_al6iodhU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Tr1VP1OUGa_ZVIUFwvaRKWMxCnJA5u4TJfny14ng_Yw&oe=69DB8252"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G9UML1BU6pYQ7kNvwGaxCTv&_nc_oc=Adqh6U3uxdpeVewAnsRb6nGVGyez8ZDxoyX-mPKmSmV4FFrahev4QNRpnIdmQLOX3yk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0NnXYUC_54paoTsMHpkHKDZ8PxPjrrAkVF6dImdX5xNg&oe=69DB8035"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8QU4Qz93PYQ7kNvwF5gsfz&_nc_oc=AdpCM_0DjlFER5wkJIGiHW38M1C7IgUSl_qYMeRaNfuuUtLIWjKssgniw5SYlqbbSss&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1BgQRRSO8WJIs8NNBPUoR8JYaPfmka0tTXSF99N3ltPA&oe=69DBB04D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=s0TPhMufReoQ7kNvwHO09OU&_nc_oc=Adrimg8fKKWresmYg27Co1hDrnSlq0dFi0zUMN0_Ps5zS0qf31M_AbhKQpAm2II9cmI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0YtnOARIBZg-jfhGAnx3nnM3O389AGvOenML236QNZFA&oe=69DBA5BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
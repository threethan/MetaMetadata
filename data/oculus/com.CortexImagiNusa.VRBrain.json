1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VJ-Uzzy8e2cQ7kNvwEvSRob&_nc_oc=AdpGoY5qoA3bWrxLMc2EgkZBITHqtuuD6czoR51c-qbfJ1aJ_TSydN5H81uKmUFEh20&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af16m01J_Mso-mrnEHuxZPcMif-pGG0D3C4HfxNbjaXagQ&oe=69E6150E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0nD8D4IPpPcQ7kNvwGZU6C0&_nc_oc=AdpSOAyORnN0T7ml2rZs6cp8UickfwsAlohH2YjE3wybAHv6skhFvaBJlyZ12TxRY0E&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af32Qh7wR7J2VAoRdrYNrfDVWSwtzqPXEyLWoomZARDPqQ&oe=69E64692"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iegIjEf-3sQ7kNvwGvMegb&_nc_oc=Adr-zKkNEFQjvwnmUKLKQCI2xOY4Rzjjry-V7vsPBylAr5IqlILoH7TBvTlO21WoYRQ&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1YqxwgADGkHijdQcq5GimUxMdwD_lmwWP18Q9m6cU7NQ&oe=69E64475"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gWgJk3URNGAQ7kNvwHpW9Kc&_nc_oc=AdrARYzPMmBeJTn-r_jHzXRXe1Kwc3Hbt4LfruuqrjeN2jKlzRWlfhBYDrUcyraz1xc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2pSHvK4RgG1hhIWAm6PJmZSiUXMapfF-Yj5ETGFhzGqQ&oe=69E63C4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y2s_Dfiw1SMQ7kNvwG1HaKz&_nc_oc=AdoSmkEoyXMxJkI6nmf10hybfC8LFk_xdTiBR2nPSUfxcK3CW-NR_7a5PWgSJza1cMw&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0HqNK_M6RlPRqKBuXmbB0tXwr7ULWLsyxGAP6YIhCsgQ&oe=69E631BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crk_R7msQF4Q7kNvwFdeiCy&_nc_oc=Ado8Fbj4LJXaVbLVpDSPmRaglPEn_Ai3o0pNjlm3xM9X-Q_ksKYvwwKMw9Qi3XPrqU4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7SExjlo6xE7GdsoDUJZwM2vLuJXmYOJsoIRbJ4vphEA&oe=6AB93D4E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ouGHne2DD1cQ7kNvwH-dObD&_nc_oc=AdoMOiiJxWimrodZE4Fk6Wpo88FrPMTSr_h26lR2aT_PDg1unAle46KAk-qhIIDMtxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLHvHzJ92I1jfdhkfcrNGBY7H453Ld_4n34Sayp4ctb2A&oe=6AB93692"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TZuwOHlr028Q7kNvwGUsB32&_nc_oc=AdrkLN0Dr7Ijy9oZPHonY8VjSsC4zUZa6kgNouaCdqok81j4S11UM2N54kPr1iIW4w0&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIet_wKvh2p-doG3GWCjmPiTmzOlmE5PrJRpNgc3Z5lfA&oe=6AB93475"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wfN1fK7oxQgQ7kNvwGVv-I7&_nc_oc=Adrw6c9XPlMrb8CMlnQbQy4M1_21kfR8rPEIa932iclICxxIPNY3r2_m70ix9lCD0ho&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsApZlpIaVfKE6MWDL8BzEor483kgwxjxznrDsWLrBlQ&oe=6AB92C4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xo1ZNDMxCPkQ7kNvwHH0qsG&_nc_oc=Ado_ZVDbmFhnXcYozmQOE8BstZquRbgWtDT7PESO8PjRJa7MbnP-w4oBeZijsXp4r78&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLPVRyjqIWQllJRtP06DPnp5tdgdNp5MIYioIIT1mtwVA&oe=6AB921BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
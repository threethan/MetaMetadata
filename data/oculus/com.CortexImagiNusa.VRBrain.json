1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rp1pw9AO1qcQ7kNvwFm-7ss&_nc_oc=Adr7TVzXzd8k91nhN0sP84ZzDCtreBCRyGijbfJ78DkFiWWcnIgCp0JNPKNueSA3vSo&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9wrxDfhdXOVTS_u16iqwA9Pvs6j6AUujCYDLaOAk2M9Q&oe=6A4144CE"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mx_TcbvKJl0Q7kNvwE16D02&_nc_oc=Adqibwc9g0BnA5R3wv3cz-PrmkVt0cvxbfnV9z0V6N9GWBTRzZ6Bly655AR2KBKxaXw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_UlBZ6OC-JdOCOUL43uJS28_8AZJFY2cbKucFkGumOqA&oe=6A413E12"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VLl3uMrBAtYQ7kNvwG-IaMX&_nc_oc=AdqfEOJYCdtIOWn3rBsByhSw1y4ADaEFq3vxa-Tys-0UsQVPwAnbaO7MS1s5vaAlhfY&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_-ANvvsQW-LOT9Dp35iO8FtwaN0ESBizRr5IM4lgJI1w&oe=6A413BF5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LVPyQ6TG3WYQ7kNvwFU5fh1&_nc_oc=Adp4rrHbh-jYQ1GmOrz787UMuUh8DNtInACIpVO8MaRuszrBlgKEi7BrKJ3GhVoRU8w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Df7MygacxgC1jC2tJgWbg95qHZHu1YVwEHB7BEz0n7A&oe=6A4133CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VZUAnD85U_8Q7kNvwFWBvm-&_nc_oc=Adp2N1yTg7kKlvNfz_jHQLmhlnWULPePGQRmP5_JZj3sXd9ES25QXXFee7303Bagw-4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9c4J0ZXRq3YAnwmyVYjrvOxZnckFF2pITLe4jj7o3tmw&oe=6A41293F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
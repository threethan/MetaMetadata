1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kCgL4IeingoQ7kNvwF1NdFo&_nc_oc=AdpDwxEiieoQ6CME0ojYcdDkqsuQEFX0iq-VENjjG6X3A05_nnOUlyUbwe9Wr08MVqY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN-vKl1DInJehpVwZ_Z2y0c1H5HEfYtFulkE560DD9rrw&oe=6ABFD4CE"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Le3w_EJNlxcQ7kNvwHYn5PQ&_nc_oc=AdrjOvAU-AZWwvfrnUjUqvjwPpWbnHeo9nifwclQSPI7wYVoPCtFetjQ6LztUwAxO18&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNVTyWCqkwa75StPOWXF0IZuAmj8gdfmLJK9GU7yet6pA&oe=6ABFCE12"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IIZLjGkXUwMQ7kNvwFL7v6M&_nc_oc=AdrjO7oHZuJrb4pqOMfOQ0fXXU0HeSN6CbdIaiIU13XCwG0QrNBtnB1KJD6T_cfP7CQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMql75cgACAMNzkOkVK1KlZzzykkbT7xlqewRJmujWikw&oe=6ABFCBF5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8r2lJT67qFQQ7kNvwEbTc8S&_nc_oc=Adru9XTloSu0xpgfC88xYwY-7gBBlzvThXO868JfuNn9bzsdQnFMiNfjQRHby_xpFos&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNr6-B8AwNWxCrxvDFC9r8IrwyKDss2zSedr4hYtTJhRg&oe=6ABFC3CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z6jUOvhLhbAQ7kNvwHciKuW&_nc_oc=AdowuLTUi_7OO5qUA4ECA8xgURjcmtpr51kYtMr2aSDK3ld95odfwX-Lr-RGv7_T1KM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNZWQKQkKYpzmA2VYADzwhkcnQcaYmrI1fDYNywavlCKw&oe=6ABFB93F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
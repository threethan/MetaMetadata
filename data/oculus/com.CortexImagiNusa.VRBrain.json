1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_NhJE25KlcYQ7kNvwG14dc5&_nc_oc=AdodKtzW4yz4BTEgiY0jtswxtLxFjSaSiSYquryVCAJVDUt5xJUF-nrJsQ_7zxIfbZk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP8qfVHG_GgywsDtQOD2QtcH2xOdGL18hsLaFmEZFZFYg&oe=6AE6104E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=abQlxs371bYQ7kNvwHbQsft&_nc_oc=AdpaDn_y-34LntQeOAiidoSw2JrYW-IFICSfDod8U5mfs9Nebm4O5nx5mSufhoYaTaw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXJ6XVbm3aNX7Bj7NwdOOWbCotWFfgBpL43xT0Tm-ycw&oe=6AE60992"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MA2tUp9GsFMQ7kNvwGvUMqT&_nc_oc=AdpAS9aXujnaXcrmVQP9aRq8ok1DJvzgYdEf2gL5Il2g2R7ro9mlf-yrkdZraJkFgFU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDCCTbq5tgjQJ3c84RSlKoxZCbJOngrUFxU9XgdWqtBw&oe=6AE60775"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YaRxyPk7E3sQ7kNvwHsMPlz&_nc_oc=AdrbVe5mpj6w8yNvissIP-A9ot55hUGiHgHvragHnKjuO0bPC0NH0Rxf47eX6FQRnRY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_SLUpGM4HmE2b8WNPldTTA98urwjV3qfw5tAqgU3Igw&oe=6AE5FF4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=du2V7oUY5jUQ7kNvwFGtiJu&_nc_oc=Adoi9awXi-PvSIrrSiNhx-OqSk4VCsFZeD4ESmUAwIHjCe9H_X9aaxS3F1IkG02B2AM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNwiI2BLblXPtFVf-llS51NU7jCXT8lkyLeOqW4h46hBg&oe=6AE5F4BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
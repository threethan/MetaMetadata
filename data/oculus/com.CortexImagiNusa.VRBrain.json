1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zMRZlqWmF0Q7kNvwEXkUFM&_nc_oc=AdpqJXPGqeSdewdgRCTbfOW6SWhFPirPVK7JJBPtFZof4EirdL9FS9B-ISnzMoNLnZw&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKdZ3bL84eVp_jtIMROOpkfmBTkQCSkJiv75xh-53vmrQ&oe=6AAC0E4E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=26g7HhX3klIQ7kNvwE1gooe&_nc_oc=Ado9OFpCSObOFA-9aTP3oVAWSqxvWpOUEqvRJL9HG0aJVjmvGGgNJfJa23WwF7gucFQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK3nju1StmEx5X9hKdWeX6WbfFzyK-L9wHn2ZAkNr4m3Q&oe=6AAC0792"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JdwKOukBQ9cQ7kNvwF7OM52&_nc_oc=Adpsz-POtW-vrNUSFCbkwHfDvWnUyTbsh5QivjVwxEvroVp2lkZu-_fnBMyULhpyl1o&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLkRjGiLlOdktFjHqvMtQD1RNmJvBIpc5m2x5ZWX0jtnQ&oe=6AAC0575"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P5rJ8BFvCEkQ7kNvwHIEQ5q&_nc_oc=Adr35sfadzuWt7uXSG34TvDRP0w7EEI6T_DivI6nvow5kew4DTKugFlvU-6tG2j8PKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK7dsMaDjFwHCfDxBA6iT-MvxbIuUBhTligWyOAtWVcKw&oe=6AABFD4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYpuGQznhiMQ7kNvwGr8bom&_nc_oc=AdpmSt6WxB1XxOk2Mt7tPSxl3o_wE_KWXPEJofb6nK41pyWkeZWV1CzXCNE9k3tYwaE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI6Jwobbnl3BbDfKA0gmDXNPfmaE8OV7ecMEPEE8-bryw&oe=6AABF2BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
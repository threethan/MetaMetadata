1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WWWZbXghZIQ7kNvwERwRub&_nc_oc=Adq798xz_Lj8GaMrWa8pJ0qYIp0DE46vpojo7sPxfNet-QedyXdw3xj2bLdBuW_3Sr4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3H2ExsisHip6FdDFQ9iYLsY8JYzQdq90_gt5tQn6hJTg&oe=69ECAC8E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OmBHERoo1UIQ7kNvwEz0BtB&_nc_oc=AdpKjEyPQd9e3s07Rv3GHr99_mQ7huOxkVIWIdM5iiR5A8LEEAD9hthv7XNxuw5N5PE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1_mzxViOXqX4paFDzYOTKvwTmq4t5_KICK0WxlDPaLtA&oe=69ECA5D2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AdVvy_sM7wUQ7kNvwGt9dHG&_nc_oc=Ado9Sk0Xzh-pzy3RTJVpJQSwDogLia5e7WQAb48u0KkRd0amYic9-khgXcg3FCESZj0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3L8R45saUO5ExS2O98ylTKRt_nyHdZTGMvJA6ba_J9sw&oe=69ECA3B5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8dY0JzwC3MgQ7kNvwF_nkIx&_nc_oc=Ado-Firc8TScqzjpr5sA04G_FXBeCxROGVEQWL-SvpYNd73nO437xQGs3GP9us6YHWo&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11QqfGhEqjmQhgVBCRRljHNxlZzGGQiVTUWgnvEook-w&oe=69ECD3CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=luEu1s-f5UUQ7kNvwEJ7e-n&_nc_oc=Adqk-oc-cKa9VVCNw1eXPqH1eYNIQEqQdPROQXm_OCheQkqLtGMC0_54PfP9iZmOVkY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0dkFhVwMQegTeqn3tRZo0nOFlCo3bvmO3oNHDzgQCwnA&oe=69ECC93F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fIihbyMdp9EQ7kNvwFTts3Q&_nc_oc=AdoJ5z4o66qwwRskxtuEAAVUKvCxljP0O1IpMmoFMtkEWTeORuPBqv88QDl37wVIogY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Q_ZgMYzNOXuF4yHzS2CUjsTILJRiNfHQp8mnZYAcR6A&oe=69D6430E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nssjGl14CQ0Q7kNvwHFN5KY&_nc_oc=AdpCVlD6UnPqnSmXMgO34W-2GfhYHLsy-hwzKAJMBsL_L0ghutjsvcrSn9mQnUYxu-0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2wDYVUcnwnZHwFlRx6EhtmDbllmVF-7VWJ7Z-YxxmvrQ&oe=69D63C52"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xub4WpQmZsYQ7kNvwHitSGT&_nc_oc=Adocskzp60pD6zgOnb5A1tfpZO71IwxAShJspYvexpfyb_Vo_dq8so0HZrOttdftKc8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af049iKSNFdLcVA-NB4MQh5f97zUb2OOZbKEZtVRP8QVkg&oe=69D63A35"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LzW6doL3FkQ7kNvwGarave&_nc_oc=AdppboRkauZiwIX8iO8U2q1oawjDMZPF6oP6UjpLhVF4VOpZaJZqdoVvw3PH9tcB1DA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0GFeZ3lUKPdJ2cIs830YMX1POIZDa5dzg21JwHQuzFaQ&oe=69D6320D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIPD8YoA7_EQ7kNvwGV0Hs7&_nc_oc=AdpyvUjL1VuFfdlh4moyCzqBCg9X2hpfJXen2WIXf_O2iW6cBOvhD7pzQMgyuli8CiE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11xLnvoj9dYUXIazvW1sr7sRdH0HrnXCJAQhql225riw&oe=69D65FBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
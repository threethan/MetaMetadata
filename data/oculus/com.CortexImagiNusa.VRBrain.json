1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFU49Inp44AQ7kNvwFBwr_0&_nc_oc=AdonxTyKmCW5byQ8JrTqmRK-cEXq03sBOR-YWX7SK7oLA_-RbHeCYSb9Gkue6MjjP8Q&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1JUSnjVSWl2iPStTUrcwmI9-WemZMAtwB77loP0vZ0bw&oe=69DF7D8E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhb1DOKzArsQ7kNvwEnd9EU&_nc_oc=AdpRMzg6pnyTJ-lb5q-oeVnkPdd8_X7i13DRAiM7p0g8D4J4gcsrHeBqPC8SclalkQw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24uP_gw4qdx45rB8ralkjCxVOrBuBGjO03IMSG2KROsQ&oe=69DF76D2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gu0miaGo-gYQ7kNvwF0ua0T&_nc_oc=Adqzelj9qSOlNWdhwdiH2XotQ1q2VPK-JBRl-c3tN8p6f8aq8cITQSub3INAAbisZwM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lxVx1_SSnhGD_gWhjevWXXVCjlAErnrIcTPV5TqeOcQ&oe=69DF74B5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfW467vq45oQ7kNvwHUnZKM&_nc_oc=Adp4LS1Fc_1LZunKoW9RXC_OsdCljgwBdFzdDSwrvdotY-4XOPzMLvkF5VbifiYThrw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0nEufwo11dFSH0kxn2V2IbbTxujLuKZhfx30YP9cECkA&oe=69DF6C8D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DU4SxR0fZ0Q7kNvwFaulHz&_nc_oc=AdrVeEBYtVGi8z83bZ5rH7b76BsWdcbS_p2LfvVMd1mdsIXFC8lulfv53zDfnN96M4w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2jVyyq15Zie2uFUoDZ59MPkR4HY00m-aaA1s42dq7joQ&oe=69DF9A3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
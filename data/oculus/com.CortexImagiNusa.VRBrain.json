1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FBb-zXnT17kQ7kNvwEjlgov&_nc_oc=AdrRfhZ6JzZbnZViEUebR4vvAtPeoo58UNy5p_sosoKSchljzfzyBsCcLSVwdo1jznM&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1SEEqw9DzWBIriP_UIgSKsoAkDGmgsDCDKy2p0RwE_6Q&oe=69F61F4E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SQDnUkFolTAQ7kNvwFW0wFw&_nc_oc=AdrJl7RLmewrCLrElEa31Ow90Qy0G6zxWC6BaguZkF0KgJW1Vk5Ph1y9dg5UjZ5qXDE&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0AUVCk71klgmb9yeyMxXRSrrvkzQRoRuHKT4-40NW35g&oe=69F61892"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x90R18SLqL8Q7kNvwHL_xjE&_nc_oc=AdqHarcbZ33RuoQDye41dWmrlVqElX-BvyxTkON3f0o0UcQ3mQuUwv7r4Bi5U-26o1c&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1uIUCsUfYFGZevZZNzM-dwoPTcVxXLh4aQ_5UNKciV8A&oe=69F61675"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6NXDDTiVe84Q7kNvwGrSL-w&_nc_oc=AdoFOaCa-opevkbqVlu06vNW5avXFjXqChN35KMzWUYZfEfiGqBhIZGjh3NA8Fl2aOk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2s_o_IIe1Q2t7mpOBQADL65OLE4B03Jo-DiZqn0p2IiQ&oe=69F60E4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K3VZJTGy5voQ7kNvwEskoDx&_nc_oc=AdpEHyt526zy3vSOkP0Btf7dGtF3WNiEAQ__EW7ixLac14y_TbOVsxydPbMwsldYldo&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3f_PUG2XO0fd9A4LnDK9tLTtVJSt-qHXPJk_xpPJ3n0w&oe=69F603BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
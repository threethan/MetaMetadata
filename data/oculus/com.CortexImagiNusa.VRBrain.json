NvwEP2vU8&_nc_oc=AdlW3bKsPdOw-kYQluJT5E7uLocLFncdOihZD3M-yAE8KH3iesGoi2z8oZXR7DSMCGM&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvtCnfY3N3-oyfXldqOulS_8gugozLBLyHSU2JhhpkHDA&oe=69999E0E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aueyAEuE600Q7kNvwFGjNfL&_nc_oc=AdkYJePedNmn6bGRlq0wM_bUknU7zBbeYb6ec4sNZeEet32AfsgJZ-5boYNX3T1qpho&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftxKw88UY0VgpSGHexpg5JyAxC1ZLJss0hgyfRPcZtdXA&oe=69999752"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nDv7T0A44nUQ7kNvwFzKYoA&_nc_oc=AdlmWGfAsfLEQqAiDFE5lZV1znSNLmZgkeG4cqWNiNvLDtUBAhkQwydDv1C_G13QRp0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfthBKWDbo8ZJYfZTpbzsVmZZU03xLZ4sjzjn9997xC7Xw&oe=69999535"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aL2W9e9C19YQ7kNvwGS6A17&_nc_oc=AdnDRn1mJyAzYhtw8hnXlbgl_6qKCxuPZxjBHSS869BEACfy1-UMzoBf6sZtGiLM49Y&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfupqQge99fELImcq3IQ54dX6sn_C1BWLVcHMOe4G7qBww&oe=69998D0D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lIzx_bmjGV0Q7kNvwGH3Bcy&_nc_oc=AdniiDhgN7qQSOI_S7uBIh66e6LsBrtsc07qCaEl167smdRpJfYZofDUPJjYg7KH8Vs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_AftecR8Uaku2W7etWKQ5_t-hXRnD56T8CAS84AkAh3l0cQ&oe=6999BABF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTI
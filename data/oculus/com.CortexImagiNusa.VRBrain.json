NvwGDYDga&_nc_oc=AdnufREsyIgzdn44usmkSxyWRJt2174VlmaN9h0ArZC-x4dmRxvhlEblTskdWOUNLPc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs3CLh3BvkODsG3H6qyrj4WjRCTd5tBU_YsEDVQKeWPZQ&oe=699EE40E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HteY7utxU0kQ7kNvwHGiJfC&_nc_oc=AdmFvgRx2V3We6ezv-3ghDUtIkdjVPm7MXKcZ4w4yqwDb4Pthq4RT3nePrNV1LsJhCs&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afs2dELYerHvfVZv-yDufpWD3hTvnScsAF4jhN-JL2yY5w&oe=699EDD52"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CGwjgLY3WosQ7kNvwGNqrWd&_nc_oc=Adn5IRfQ6iIsrVBq3CAJCCDt_OcYFdkPluh7kk0rvTdBskh-8L8vm0SuIe4fFuRM_xA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfueWQLg-HUZFixmK-8D0BLoCqyJ2di5MdFtcdYQqftG5g&oe=699EDB35"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rAJ4cvc0cSMQ7kNvwFxeEFX&_nc_oc=AdldEK_nRpoqDz7zsGn0ZfnaeLy1CtD5Elw2bEYDy3cCkxq4zb7GUFL9fdO8OoAN_ao&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv-IDtYGJmWz8i9C_umRcBahpTiL7h2tUZfSkeBNAuprg&oe=699ED30D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qxFNVPBGGMQQ7kNvwHsr4dT&_nc_oc=AdldU4K2Ez0e5AN8YGhkFfbSlHItqYaFT9TxKPO_RgjCea_v5id3-FoNdDIf9EUdFDw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Aft32oL4_HNfvhzo78n1-yDSehCV_F_OvnETCSDvYgZcDA&oe=699F00BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["SITTI
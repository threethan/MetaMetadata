1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0PCaPGQ9jr4Q7kNvwGsA_ju&_nc_oc=Adrwyle2TFzukirVBdGTbekFQo5s9KcVK0v7_n--rh8W20pMN-6647rgDZed5dQjm74&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBEMPL7WvV1ZxxBaUEox961TjW-0gfY8xT35rY3rPEm1w&oe=6A6C8E0E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UU1fCM_mPngQ7kNvwE1Kmms&_nc_oc=AdrEVMad-VryPa01J4hRDm6feqhW1NRkNBQb0JeVSYV1s38kWa1A-QB56hR3KPOBgeU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDALBws2Kky7NhCWL9f8WVoW-yIBhJo8U0pOk_NZPgQRQ&oe=6A6CBF92"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=az_yx4QYziMQ7kNvwHe2QKL&_nc_oc=AdrMyMC6_6V7qUFpJsOeeHbA2zXJG3QNMSRdCLwQCBrAfIyL9zN3Z762PCBqFg8XebU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5A_EUhWbpnTZkPeFVZ_eNTf2z3FWn9z3VFI9s6mDFjg&oe=6A6CBD75"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1bBD8n8_mzkQ7kNvwEl54AS&_nc_oc=Adq4x1-3W935V3sT55E2jwBBxyRTuKrze3lbb0R0EUWlc8oIfubGvvu4-yyvfNMMQmQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDOj1qnRU-hksSj5vvCUJQoCEmMwBPUxS1DpJAXy6J7uA&oe=6A6CB54D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1IqpFv3UOIkQ7kNvwFlC7B0&_nc_oc=AdrEkkZ_S5e6l8umcS-g2VIt4BGq9Y8xX58zXtKRLGa4wyuF4w5UmS4JBIL0V1gfl5k&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBi0pEJE5TSy8OUyY-PixU2bZtBqVoxEmuhNMIxoehX_g&oe=6A6CAABF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
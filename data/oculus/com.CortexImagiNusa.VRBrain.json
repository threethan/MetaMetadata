1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYHEWs5l0gkQ7kNvwHURzej&_nc_oc=AdpsKAwoFaZiHlpNkQHpl08Iq_y7-F7bGYcAFh73AjWjZ8SXmPfLEUOAwkkUa1289I8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCM_1sZdrlAVnGcMw8F6y37PInxLONhY63ih9LArTqvqw&oe=6A52684E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miboj7baVNkQ7kNvwEEyCDO&_nc_oc=Adpgo-uLVbSAKUG88G0fAvJMRrxO9KeQ3EioycIWDlqR6xYsClSNws1h1VYBAxkGa-4&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBV0knhABlsKM4lK9dHDK6K1BCc3IC_uqSFeMUquuMphA&oe=6A526192"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmG8WJlqa1UQ7kNvwFn7h9j&_nc_oc=AdokyMmnq5nED7i9GjnXXrDG4K0rD7uRzej1d5rwW0qQdCgVIFj75GNGdLsm82Pz7uw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDRoQkIRCzrHOKFF7eJQvlBr7V3R3iarS6iiaiP_lexXw&oe=6A525F75"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtStGDBf8RgQ7kNvwHpEBlA&_nc_oc=AdrpVxTT4uCLeoK7povJH6Y-fhAGrSEk1BOuBPc96D5uurEk2Iy0gDIE3cidPo-Hj04&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCCLD8bSZbBeXlUb1aCcG6o10B4RNKSsNobybugx4NQOg&oe=6A52574D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSXNAoPjcFUQ7kNvwF9O-Mj&_nc_oc=AdpFSvwk_khXHbMqjX0U-dn7eBaItwSPVS0_1tyeyuYpjKaumE1nRA8Ff-CIXyZYgvo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBonS-zy3xLY8_K9UksjLr80W8276h6fvlLe9WhZtAyUw&oe=6A524CBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
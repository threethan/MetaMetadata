1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N2PU6SM9cZ4Q7kNvwFcItZX&_nc_oc=AdoAqZXuBq24hM-QtNGhsbHCo28_9cVJ-uaQOJuqWXHzFJDeRHooR3ijgYR4u7-3VHs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD7gFnO6fbruj7-dNAfd1LQNLCc4rj2Kvv7eSkMO2jJ5g&oe=6A4E3B8E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5KS1FI5BafoQ7kNvwEkhAQ7&_nc_oc=Adpa4zzin0XB-ecUQaYkFZTTyox3XCnmPzDaLclcZNlY05wtQxaoORXbI1gYbWlKByE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDO6xwTCr6huEoEUhMtWg93At30x3PU7xQN6oITAWq7gg&oe=6A4E6D12"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mHyWC3-Us0MQ7kNvwEjV2j1&_nc_oc=AdpaCjto17EqHGnlxgIm5oswndb9MsnF6TqcauSH0sGHlSWusdpzdUkPJxzv3Wnefyo&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD1V7UPNMv2GdhyYwhiuYE-2RjTei0DU6t2Q9B65tllpg&oe=6A4E6AF5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C0JjHqz6Po0Q7kNvwEOs6rP&_nc_oc=AdoCoH1ViWNi_0OOa9BDBiW_ZFkqOAyLgTfLQU1uaXr1ZX-7Zt_fKFlB7iu8thlJDiw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBtZR5DWb9ng-8JU-tw_R1e-5mA3YbBTgPHmfjuRABKaA&oe=6A4E62CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U-POpoHQEXoQ7kNvwH9Sga3&_nc_oc=AdqmznO9hLgxr0h7p3IUcBrh1Ja8VsQzSPXJ8FDpwJ6iscN85Fjc47UWlxiqZMYo0SM&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC9IR1iobmZWcJUj4VkyTcXOVJAFg9D-t7lOe0NH5BEXA&oe=6A4E583F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
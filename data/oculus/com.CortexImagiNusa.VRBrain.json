1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xjbpPoe1Pv8Q7kNvwFKnlIJ&_nc_oc=Adr2a5p6j7HYzoO9VEWH6pWxkduC8JyqeKOdVRXxZxW2RoHwQU0k1wEzzemKLe8uhFs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Gm40g-P4blPx9Q03Ssx701QkOXCCqj8wpgibKpY2Kbw&oe=6A20170E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cnuzoWfbp6kQ7kNvwHARDVu&_nc_oc=AdoVQ3Dg7KDpGoEsrbUYzU0PXibTiMygYlEr_4x6K48keyyqU7U4VPu3TK8glQu4xDs&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5P9ii7yl7DD4pkL_x59WSOhaU9jAKfOmS0N15UdC-lsQ&oe=6A204892"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FryAF4YTkh4Q7kNvwHn8QII&_nc_oc=AdrINse0Bxw4u0gG74TMPrw9jDdTH-p82QscQ_MUBqt5dL8CoWE42nSYOjBbUSF2VCA&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af53EcaeirPaqctg6Fu8iTu-BsIzk4LOqr_3LhWH8EbRfg&oe=6A204675"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6pvh36qZGI8Q7kNvwFrW8ok&_nc_oc=AdrZ_C3PdJv4OFISfZKdPM6uxC-4F1DFaY08AGxuh01dKYtcYEAXdOmxrnomvL-QxaU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7CtC127Z4gbneX-tq7mlYRn3dV4AuBp2FLDXmS_i00qQ&oe=6A203E4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LpKzykoBbWQQ7kNvwFYzgxD&_nc_oc=Adod1hHI4AXqURNobvFv09Dk7q2awRoq6RTZ102pZojSQAUv3oGX6GCaTJpac9XfcJA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jYTm1BP3pb_fbpyFqq-CyFKavmOOhmTyiT1zVC7FOgw&oe=6A2033BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
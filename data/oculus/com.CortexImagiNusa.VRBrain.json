1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=146JWDxtAXAQ7kNvwGJ3rYP&_nc_oc=AdrnziqOVPjiAe5FeJfiGPmZdPoMm3I1Brxsyf8a6nM7rElPzliKKtSj_pFsNWuSF0Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bNwQU65kN3xJdPfnbkr64AxxNWNgQR6rPGAFrkNIrjQ&oe=69D8E60E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjnDPicSipMQ7kNvwHFfblU&_nc_oc=AdoCBQtSJqlNsQpHQkl10mh6sYQGp8aQ3yY0pbbFTcL5h6Lj2kgyHMlK4dj8eqdC0Pk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vonl1jeHLkF2WXgQSly0j_0KxvjLaesCsMqWmtpfBdQ&oe=69D8DF52"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xub4WpQmZsYQ7kNvwE4kXKm&_nc_oc=Adqa9w09ILthx8ADu-Tc1bsCBs-oJPjzDXnj7afZ03Af8JnELPQlvxrazRybrpKqjWI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1gVs4UUb0inf0k--Fnj2YonnBlMChCc0qgMhllpK2D-Q&oe=69D8DD35"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LzW6doL3FkQ7kNvwFCVuhk&_nc_oc=AdoLL4whQcwJ2SYXyiPU7bkb7X3agO7AFa1BjlsD8JQWAjrEK1g65duC0oyR4kULqRY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Y-Z4TWo_JhiGcX3rU1D3siDQcxiuqVCRyVmfmMwsoTQ&oe=69D90D4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIPD8YoA7_EQ7kNvwEm8V32&_nc_oc=AdrCpZ42kukwyv24KAjR2YTy72tJLuGXsJEpUEpHEDjzRwI9smrrnIwP2fCWIhxUzfg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0iewdq4UJSj__f_cLxqckeSkAuS58EJxTVIQYGFKnnzw&oe=69D902BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5WMGILUGzv4Q7kNvwEcZMm-&_nc_oc=Adredv5MVWTdwcXEcTbopodm3mHc2Q9w2-omrwxw3KwGabE34sSzo8io0OOKrClTpxk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCn1w62mVP-_QVwRu04fTTpzJSWxPujEpDyabk7QNXAMA&oe=6A58C78E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1mHSoikaGdAQ7kNvwEAL-DX&_nc_oc=AdoTuMD2eLbpOvHVq6qVsa9E71lDJh6hvyQugzTK7rLAZZdd12oSB0Vd87GfXivDRts&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCJ-OWJeVMV_4WGdY1LXfduaEzZmF4jPSLwRKWYICBqpw&oe=6A58C0D2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AsblELlU8mYQ7kNvwFjeBiX&_nc_oc=Adr1vl1vTHP6piSX3qr5FUgD3Ji-XG9VpAAuXm-jL8RK_dcHuOL9TqZxoMZsESJQJBs&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC6PMq4uq3k-5dp5Rhhdzr8KFVnyLyDL0skwqp1pYKHRg&oe=6A58F6F5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zbCpaCnKewAQ7kNvwEyGiuk&_nc_oc=Adp7sBXB24MVDXCR4pRSKISSIORFPBqtY02PS17bdH5VNo1NznpcjvhDI3EL6p3cdXQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBe5LskNlTMQF4X96XcwHXDqzi2QS_nm27xMjaVjxumcQ&oe=6A58EECD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ReQDWARWJ4YQ7kNvwHKh6bM&_nc_oc=AdpHqLLyWxiCpasfBfJfj4s5u1D7R0UMmRTe4IWdiP1KXAfGJyTVImkXo2Q58hgsXxw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAFej9GT9tqf6-kAp3NQ5lBZIznujTtpEatJnThl-yR9g&oe=6A58E43F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
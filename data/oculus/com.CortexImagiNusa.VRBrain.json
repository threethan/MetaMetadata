1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Jcn9ZxxdMAQ7kNvwG1Hxk2&_nc_oc=Adqc2G5yQg7C8uxKz2coINTxFzkngwbbmR0HenL-_Cje9rGgKOk_h5YtV7ihpmPPiR8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7-4ZJoi7Q8awGMq43Ut_DSAABbvQMCQCaR4TL3agPqQ&oe=6A71D40E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xlro0-7Wo_gQ7kNvwH0PntK&_nc_oc=AdqqcQbpl_mYeikoQWvwixb_CXSyCYDfeUFo8egnCc7mAcOfb7FE-aotJfE2m44Oqj4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEO8tJekVGoQ9nZ8ZHDs6PZldAw5sSNa1XGsY-fohe5qg&oe=6A720592"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZOI6w_LTrt0Q7kNvwEpNLH5&_nc_oc=Adr98pwjnaHPNbGqcCNFOXdwHnqKt5idOZLI_d1equ1iTloOULxDaucfxcsyMpArfps&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEGcKQZHWAnABTrj6_0sSB43nFwRFOh4yBnl-lbK7OeFg&oe=6A720375"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3ag1VX-Us0oQ7kNvwFwXLW4&_nc_oc=AdpGG4y9zzDLUzGE0cNQL6ZkLHueIB9UzAikzAnDoJMWwOdUc12vH75vjpQyCOB0S80&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEbCNndFTUx_HIT1iyRINgONEp9nwMsK08lTdjxh0A7vg&oe=6A71FB4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xxHpWn3DcnoQ7kNvwGwfhed&_nc_oc=AdpAcw28IBAT-2Kp-OVbTPnhOpznl9jFFofOXkuYM6h_ZapMF6eoGr5a8KytES_01Q4&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFnInXa6HNRQpfaa5n2-wj2_k95veFHYLwWdfrpAN8InA&oe=6A71F0BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
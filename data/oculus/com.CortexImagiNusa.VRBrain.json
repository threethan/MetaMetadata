1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MFU49Inp44AQ7kNvwFRkMvC&_nc_oc=AdoaGm8fw41R7WjYacsxvuHe2FFMoch0MkHCjg45e85z86CUKPT75vkBscmz1ajOMI0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af35NcLDiERgrTKOvT9DDafqGJuGBpV_hIADyLReM6G-0Q&oe=69E0CF0E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nhb1DOKzArsQ7kNvwF7VK2S&_nc_oc=AdoXfBaGILCnm8uNmX-cDIX8gqL_BjcKCIN1fZ2q27gKxrqTj9oRaCrplZk-xVk1q6Q&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0cIuTMViULaB2hdGMJ15xpFVKDK5M0ZwZ7FEbfGilAUg&oe=69E0C852"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gu0miaGo-gYQ7kNvwFeKimA&_nc_oc=AdoFNqxxLqDwEgwfzDjfABn-NoWIAks05Mt0e6-ZqovW1QUBNJq1BUVm9DAV-tozMcA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0zQBg4IycemsQOepuQqRJFIKdjX4xmpsvZphoa1GiF6g&oe=69E0FE75"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PfW467vq45oQ7kNvwEZ2O9x&_nc_oc=Adr0Lq8ie1SLfijLLVop-E8QuKGQDm6dZxU4cPxV3ZAZ2XrUEgeW5VZn7FXjdFhd7wg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1QEOqo2aCj6tVgJK26GTxpeaHtrHGn4ep2bm7PtUjc_g&oe=69E0F64D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2DU4SxR0fZ0Q7kNvwFqg2Dk&_nc_oc=AdomtQRugeKhQjbjxNzmh5nMLhRCNNf9NIPBXcm9o-wHI1BDgf4xCKObgWkxjJ5erWg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3B3-LQr7q_uKsj5pU2ecUMrSXR-NntR8Yq5EY1vcyoVg&oe=69E0EBBF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
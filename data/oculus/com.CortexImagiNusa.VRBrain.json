1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wYHEWs5l0gkQ7kNvwFaFrpL&_nc_oc=Adqs5JJfVMOyzgRqmxvrpKEvz4Yn6KCugGu8ewMa6lGYJ54j9L4fbOcQI4jJIV9oaC0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCkkndRUQm9BsR-dPR8bEuZut5MP7r_6JLhWN2C88yZYg&oe=6A53818E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miboj7baVNkQ7kNvwHOMDS2&_nc_oc=AdoD97L2vn67qXXMQCl1tiAImAkAlj-R259O4m9FiJuawifgodNCboiL4v9SSfpgT-E&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBodI0Xf6oQtXdMAnR3BtReIGeHR7CZERbVo0umRQMcGA&oe=6A537AD2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QmG8WJlqa1UQ7kNvwFubGi-&_nc_oc=AdpbOk9AW_hXdkTrpscQEPjKrCvkfpHgO6jRCFTjcawUiTf9Y7e0UY4A4fg86XlKTHA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAQK9NsFu8PHbTo5bB3tL9opN1GxvOIGLapSLOGYMqhxg&oe=6A53B0F5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VtStGDBf8RgQ7kNvwETz_Q9&_nc_oc=AdrbpEIN6xWYtxFmIHefHMkUq8-ZYINCnMSP2rLIE7Gw4dzBEfnc6M9uS64e1ajNugc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCXn7cXj459ppUiXtJGQxQ5LZ9LITxY05q1HUF6qV0EWg&oe=6A53A8CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fSXNAoPjcFUQ7kNvwHK0hLy&_nc_oc=AdpluQgshKuag9pMCfFyk_Q5cGsDMGkP53HcPvQSxgthnzfpKbjxEbpEpHAyE3JJims&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBTS7xu-itPD49oXTsCXclGaMKP9BBBS6r3Xx8Rok1WKA&oe=6A539E3F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
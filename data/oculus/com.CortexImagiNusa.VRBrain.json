1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oSC9hzZmAWcQ7kNvwG8tvHt&_nc_oc=AdrdjN_ptLijvxY-_JUtRkdgfdyRTrNaCurPylE7v-Ke4TfHVLcVRIHTntBVpX06Sec&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy5Bd89P703hxn9WPgvujg94ORgBh3fHrCuT2Frg9dtPw&oe=69CFAB8E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7kVIzy6MEBQQ7kNvwFgxqv1&_nc_oc=Adr0eqRR0bER4zr1ZiEo0_6LhHqP2UgR83AHeSraezjAfQvRWyGMz6UdaUinRhxvF_8&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxRigTT021W-MS-UbEoRcezLD73HQcrMSUI9zfkp8Enfg&oe=69CFA4D2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=etDGNB94K3AQ7kNvwH2PmAA&_nc_oc=AdrI0aet4QwgQD5T1j8znCjf1rydFce09wb6RGKq6CifTcrw-ZcWllIlksQV8tQVgFo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDZNYRLwk9lLBkh0GeDcvZBQuyXOfbHv71r0x3jH-Egg&oe=69CFA2B5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1eh8Dw6agi0Q7kNvwGR78My&_nc_oc=Ado8xfBbTz-RDonw-IED-gZK8XKiTi9t5uHRyu7ydPGBxNWg_60q3n2xGsJGFpAwwXg&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyDTNhAv-50bQxgc940V-bsJhprDEsszefJsXOHk03wZA&oe=69CFD2CD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z7wwdSxK7dEQ7kNvwEg0lwI&_nc_oc=AdpYhnVEbDfNPR49cuxEk2fijChaYB8uVJSNNZ6b9l6l1UKezCA_2fjMZzHCyHWWX8w&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx_5kslPjALz0QfO6t9kI07wdov41toBg74ag3FNFH2SA&oe=69CFC83F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
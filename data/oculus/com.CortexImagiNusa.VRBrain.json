1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-5BrJahSM_8Q7kNvwGNGin0&_nc_oc=Ado5fbhIhVXLtKRAK6M18b2tPUx8wQ_37p6xapasoBEa_nz3pdzSUEVoDsWrTruuXxs&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af48EOlUZcUf-2bVg2DsIPfTQ-dkv4evwwGJbnMFLCXBhw&oe=6A03160E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d6r2b9_kjhIQ7kNvwGQJgDd&_nc_oc=AdpB0g7jOXJrqIxz2ILJCioYcwqBY81J7dS5D1X9jmMH7rHlSXLtJIioc5BvYK9MzUo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af54yPpJ7k-ZCW1sKot45NrHm47nWQZJDWMf7ZUNC4ySJw&oe=6A034792"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NDC26os08cQQ7kNvwF1v6RW&_nc_oc=AdpnQEgUnz9lca2XRLQjdSfZ9Vjqivac94XIPYR2SVAkrJmmzMA78Spmd7apaF9oG5w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5mSGDXUFEj0aKme18rxQP5RKxiCIVppyj9JdJ1rTTlbA&oe=6A034575"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gcJjtPTe_KsQ7kNvwFWkhF7&_nc_oc=AdrN5_JOJqsBiXTQUkcP_kZRHB3goMrpjNvVCebhBvMb6D9zG6-V79IBmuX6Uw_ZWtU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7cimmGVTfyxw_705JY6rSlTaRH1alqwtOZQiicR5qClA&oe=6A033D4D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=F3hfvkKFccsQ7kNvwGomgS_&_nc_oc=AdoF5xdwvj8z7Xr8sKJFGtgo33Ds-sDRWiQoEE2_zCIDqco1de_AAplSHTvqSrlzd4Y&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7FQDsMV1u0L_pItqEyxEvnCZrP4EZlcjNJdK8kjsItMA&oe=6A0332BF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zRWP2aPWUvQQ7kNvwFN8jMW&_nc_oc=AdrOBgPQyoxLgTfj11TfKsrSnYZe6eIeaBafpDQ_2qvcojfVNa7V3lmLWt2JvASWiWE&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4iSq9zPcdGspBHMpFjw2KbztSIao-Xjp6R9131sm7xpg&oe=6A18664E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M7nZrz7mBnwQ7kNvwGhcq-m&_nc_oc=AdpqMEz6CYVb1ySEGhNUQmUkr62RtUaPSX6sSsU3S5J-tjrJAVIgHZVi4RNx7c_mC2w&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5S9Pm7pF6Q73sqDUtcA6tUI_6d67VzOLzvKfoIP8uHcw&oe=6A185F92"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JbY9YjsowmwQ7kNvwGYETWt&_nc_oc=AdqLULKwPhffSQEG8inBx4YROaArzjlRWejVR9mU2XiQ7iIn_CfCjPIwtq5IaqD9Vso&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4i9Nu1UVWhRlqWX3CZ-uix0WOfzv5Acf_K1Dk5ii4ZHQ&oe=6A185D75"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wTSdetQKy1EQ7kNvwHqvjRt&_nc_oc=Adq_o_xd4lxzcJlCfd1t98JyoxV0kJNO_BRRhBZggipNRtsvdidiw0AQiKJ09wBcyjo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7rOFwqzIk6BlxcbR_A8TUsD_He2K3DbQ5WBE3LEyjP-Q&oe=6A18554D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_4WIuoBoJoQ7kNvwEoUQCV&_nc_oc=AdpVtKD4zJHYZWbIGAut5WCWj_Fwjw9Cquvo95AqA-649tLU1OAJcqTIeVaQhaqVra4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7sKIPhgPwpX7ewJrr8COmxurO-dl4cyW2hp8hYpLkIlg&oe=6A184ABF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
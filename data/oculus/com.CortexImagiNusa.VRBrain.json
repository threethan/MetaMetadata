1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xo4Zjk4fgwYQ7kNvwFAQd1X&_nc_oc=Adp3FFDieyaLVXP9aL98a0cNSQSGKKYr7X3zGXsEwRTEGe0R90pCWRw_mEW_rHIO-eU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH7up7eK654cZF9afBGLGU9SzGKy28AxDXAi2DakCQwaA&oe=6A8C320E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EjJ_KEZG5OgQ7kNvwG31aqq&_nc_oc=AdrGYP5Y6y0rW8oLR-FZPMQXsP_7o4qGcVLEX-K0_u6pMx_11OFN3vUnTvVyjZ4FLwI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEVZJbRStCByu5dCGvU7Cr-nCOv0UGE6g5awv3PlygE-g&oe=6A8C2B52"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cB7HbfwR6hoQ7kNvwGHidkf&_nc_oc=Ado5fb4cZv5gTAgsLuYGyPKFYY2IHdGRat3gcf57T7dNGWhzpsY-05SyMKZRYuOiRtg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTiV3UoLSSW73e9Az-kWeaxV6vfQOcG059LrjHmlcxyw&oe=6A8C2935"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0WLcjbZJLrgQ7kNvwHaSj48&_nc_oc=AdoxIUj08T9j6pnnCrIYdwnD_tu2Wr9ZRQpyIiChIC9db02_GBp6qLSE8Mxs5egNAN8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGq-Kayp1Yt0Z7W_BSIh9j5CHdHhcL9tc20cj-StvWMeA&oe=6A8C210D"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aaXLNi_q09YQ7kNvwEAvg9p&_nc_oc=AdqP-QX2saiAQ-iM_T2fd0uNl684XpGrpYTnexvzMKA5HB_li9pK-k5MJ2mwIdXGifs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFkWHvt9zE_tgbG1rM_b2UJh_BihMg1J5PTSy-s3iYSMQ&oe=6A8C167F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
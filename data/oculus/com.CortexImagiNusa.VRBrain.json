1813_677640891637598_2904006720627466988_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=146JWDxtAXAQ7kNvwFfkgjK&_nc_oc=AdoIHm9fNAMpliqtRU2L1OmF24EXWpgMy9cTsj1Y4hWhHZbh0BGCKrv-QSNEz4VbQKQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3N6MgPFPDy5oGuLmIehWTbhInj436K4Z-0WnRsl5rhKg&oe=69D7948E"}, {"file_name": "square 1.png", "id": "1197888625078425", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/473394211_1197888628411758_2022696438569761486_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fjnDPicSipMQ7kNvwG3Jcqq&_nc_oc=AdrCKyQlMPpMZDAkvCkdx6Q663chGl02HQi-tlSLLmtrGrPAXo_IKKKqtBSlbe_Ywsw&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0H9xB4GfJOH9g3gSjysPjTdbAimoQpbv_3rMflqYhRVw&oe=69D78DD2"}, {"file_name": "square 3.png", "id": "1206573564508489", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491820106_1206573567841822_6476712240705873134_n.png?_nc_cat=103&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xub4WpQmZsYQ7kNvwE-fHFt&_nc_oc=AdqxwftOTG86XDGR1v8fEW59OcgMzTlqaQs-vqUT_BCt6kV2LxxrQSVw9BOIHz7jkZ8&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0O4-z9NkHWuFPTuSSm5AizjYEBEOZZ_8OqQ6ZUzyjh2Q&oe=69D78BB5"}, {"file_name": "square 2.png", "id": "1359610948580825", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/491827665_1359610951914158_3194614623068847143_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5LzW6doL3FkQ7kNvwG2MLCO&_nc_oc=AdpDqc3vNeQShxw8n12QOU2JqbizVGpt-BJyh9AIutRp_8ayhweEUJ84gnJMD1MotIc&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2P9Xj9MN4hQszi9MST4oUOzihk66P7bhTULvYieeYJoQ&oe=69D7BBCD"}, {"file_name": "square 4.png", "id": "2170189413418935", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/491820093_2170189416752268_1530912968033794074_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mIPD8YoA7_EQ7kNvwFlRWsn&_nc_oc=Adryp-acAbmipokstEg-3nzN1Pm_8TRv2JApJP8MYIfTFKDfq5Ixb86cNpKvPZl_QeM&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3PkORuthiQ1B-vTPIqvnpNKMOKu4pC3DB9I652u8WdUQ&oe=69D7B13F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Brain VR", "keywords": ["brain", "medical", "education", "interactive", "Exploration"], "long_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make learning more interactive, immersive, and fun. With Brain VR, users can enter into an environment that fully utilizes 3D technology, where they can explore the intricate structure of the human brain like never before.\n\nThe app offers a hands-on learning experience, allowing users to touch, rotate, and closely examine different regions of the brain, including the cerebrum, cerebellum, brain stem, and more. there are interactive animations by moving the index and middle fingers on both hands to view the disassembled brain\n\nBrain VR is ideal for students, educators, and medical professionals seeking a deeper understanding of brain anatomy in a dynamic and engaging way. Users can choose between Guided Learning Modes, where they are taken through a real-life brain viewing lesson.", "short_description": "Brain VR is a Virtual Reality-based brain anatomy learning application designed to make the learning process more interactive, immersive, and fun."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.termsfeed.com/live/449e0122-ca8a-49b1-88dd-e4dc09a36838", "developer_terms_of_service_url": null, "publisher_name": "Arjun Technology", "support_website_url": null, "website_url": "https://arjuntech.id/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "478089301798119"}, {"id": "1043107547362485"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommend
771-25/38974918_2151930944997070_4290666849495569791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYSvaJdmBWIQ7kNvwEP14uR&_nc_oc=Adr-fM8p-7gVCaGWWN0MjqWRuDQ-1KMDuVoNnmV9sp-_4jAQyVv9_JTrLgkJa4vbp8M&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfzrB_S0YT7eOCuAqoXYQ0We00AnFvLvos7XY4A9Zmqp6w&oe=69C11D31"}, {"file_name": "Store-listing-screenshot-5.png", "id": "779938339938314", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974897_779938343271647_7357376386880407367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymcPYEINWEkQ7kNvwHnAPeM&_nc_oc=AdrDV4e1m1X--g_yngkL8O6RYWkXeRDyrTYa_iyeSBouQfGSiMXZ1UpLvo19Lg-ugWA&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_AfxDowVrmN5l3o6MjzJwFSfMFrtWFScu7Y48CQW33eE0yA&oe=69C12C5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LastPass", "keywords": ["productivity", "login", "lp", "security", "storage"], "long_description": "LastPass is a password manager that secures your passwords and personal information in an encrypted vault. Never forget a password again. Only remember your LastPass master password and LastPass secures the rest. With automatic device sync, anything you save on one device is instantly available on other devices.\n\n     - Securely access information like passwords, credit card numbers, \n       and addresses in the encrypted vault.\n     - Copy and paste various credentials while browsing on your Oculus \n       Device for a better experience.", "short_description": "LastPass is a password manager that secures your passwords and personal information in an encrypted vault. Never forget a password again. Only remember your LastPass master password and LastPass secures the rest. With automatic device sync, anything you save on one device is instantly available on other devices."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastpass.com/legal-center/privacy-policy", "developer_terms_of_service_url": null, "publish
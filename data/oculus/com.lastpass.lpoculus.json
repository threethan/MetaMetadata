771-25/38974918_2151930944997070_4290666849495569791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VxYqimEfek8Q7kNvwHncBa7&_nc_oc=Adn5Ue-vYh9esoSH8BZEaQ4rTm7bVxIJkbx8ztGR3ivjREm9oYHoaTwFoMwS2h8tJD0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=8&oh=00_AfxUPOt-4ut3FXqzWWJ2eWaihNUswPE-Gf2UfaEob6gOaw&oe=69B14B31"}, {"file_name": "Store-listing-screenshot-5.png", "id": "779938339938314", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974897_779938343271647_7357376386880407367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7r5nmTfw_2AQ7kNvwHVBng8&_nc_oc=AdncEGbVgq-43OYBhHtWRf24ERuMY7yum484gdzdmJzXcnHZRkoO4BpOyou684enba8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=8&oh=00_Afw9mkjQplVcgQL9tyQPAVQ6X3UcJ40B5TGMHVxKbnyqIQ&oe=69B15A5C"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LastPass", "keywords": ["productivity", "login", "lp", "security", "storage"], "long_description": "LastPass is a password manager that secures your passwords and personal information in an encrypted vault. Never forget a password again. Only remember your LastPass master password and LastPass secures the rest. With automatic device sync, anything you save on one device is instantly available on other devices.\n\n     - Securely access information like passwords, credit card numbers, \n       and addresses in the encrypted vault.\n     - Copy and paste various credentials while browsing on your Oculus \n       Device for a better experience.", "short_description": "LastPass is a password manager that secures your passwords and personal information in an encrypted vault. Never forget a password again. Only remember your LastPass master password and LastPass secures the rest. With automatic device sync, anything you save on one device is instantly available on other devices."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastpass.com/legal-center/privacy-policy", "developer_terms_of_service_url": null, "publish
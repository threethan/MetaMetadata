771-25/38974918_2151930944997070_4290666849495569791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYSvaJdmBWIQ7kNvwHdLjHR&_nc_oc=AdleRgp5QmT_fLKyMaL3I1pVrMSf0m6ARAXaqoLYfWtH8CO2SMCSfZM7jbowu7YFeec&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=8&oh=00_AfyP9U_hh99a22EQXfAQ6u_I47O2CLbq-6jB4Rno3rm3yg&oe=69BFCBB1"}, {"file_name": "Store-listing-screenshot-5.png", "id": "779938339938314", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38974897_779938343271647_7357376386880407367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ymcPYEINWEkQ7kNvwGcBRdY&_nc_oc=AdlfuYHbn_ak_pVVc4L0rW7P2d0yCk3ATgjDab54uBoVbgelekCfpg3xKwp2yWfqdOg&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=8&oh=00_AfwOXzcXhcTVEHY58uYcsUOwrBlL3B12h7XBvsY6k-1lFQ&oe=69BFDADC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LastPass", "keywords": ["productivity", "login", "lp", "security", "storage"], "long_description": "LastPass is a password manager that secures your passwords and personal information in an encrypted vault. Never forget a password again. Only remember your LastPass master password and LastPass secures the rest. With automatic device sync, anything you save on one device is instantly available on other devices.\n\n     - Securely access information like passwords, credit card numbers, \n       and addresses in the encrypted vault.\n     - Copy and paste various credentials while browsing on your Oculus \n       Device for a better experience.", "short_description": "LastPass is a password manager that secures your passwords and personal information in an encrypted vault. Never forget a password again. Only remember your LastPass master password and LastPass secures the rest. With automatic device sync, anything you save on one device is instantly available on other devices."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastpass.com/legal-center/privacy-policy", "developer_terms_of_service_url": null, "publish
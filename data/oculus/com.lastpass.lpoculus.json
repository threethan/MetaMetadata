771-25/38974918_2151930944997070_4290666849495569791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ccx_RQ1bgp0Q7kNvwHRGs55&_nc_oc=AdlhWf8nEvfvqO0PZEuPASpqry31MpUN-CNnQuZ3PcRuAA64OzvCjww5dYFZAHzqBiw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_AfwKB30L_jrKZSghxbsXAbGA3eAJKEjMqR72K_Ym7ZzPGA&oe=69AD56B1"}, {"file_name": "Store-listing-screenshot-5.png", "id": "779938339938314", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974897_779938343271647_7357376386880407367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=75O_8SyriHIQ7kNvwH_km7v&_nc_oc=AdmL7c9NZ1RS6dYxNnMsTbMhCgnpCXnHyQVuf4OoMEcpsS5U7iPgUUX-puaJTijslB8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=8&oh=00_Afx2KfeBO6fl7JD32Dnuq9oJ24V29yNoJHY2wuk2SqH_1g&oe=69AD65DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LastPass", "keywords": ["productivity", "login", "lp", "security", "storage"], "long_description": "LastPass is a password manager that secures your passwords and personal information in an encrypted vault. Never forget a password again. Only remember your LastPass master password and LastPass secures the rest. With automatic device sync, anything you save on one device is instantly available on other devices.\n\n     - Securely access information like passwords, credit card numbers, \n       and addresses in the encrypted vault.\n     - Copy and paste various credentials while browsing on your Oculus \n       Device for a better experience.", "short_description": "LastPass is a password manager that secures your passwords and personal information in an encrypted vault. Never forget a password again. Only remember your LastPass master password and LastPass secures the rest. With automatic device sync, anything you save on one device is instantly available on other devices."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastpass.com/legal-center/privacy-policy", "developer_terms_of_service_url": null, "publish
771-25/38974918_2151930944997070_4290666849495569791_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mYL_yfZxidsQ7kNvwHjO1G_&_nc_oc=AdkBdYpcP43DNdMA1LCNmKRIo6I3Av1Ii-PixRU-gd5yKLsGo5f6_mrtjGmfSgHD4Bk&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_AfyllSncOfME6mZYb129oBI4Gg5sgwhBssrG5XNozZSb_A&oe=69BD28B1"}, {"file_name": "Store-listing-screenshot-5.png", "id": "779938339938314", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38974897_779938343271647_7357376386880407367_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uoAMVToJAsgQ7kNvwH3ElCM&_nc_oc=AdnSvgh71-rg0N1-dVp5hu8XSSS7eD_6GvXd5Mk0Jg0VN51rXS-Pvq5f9S265fc4K_g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=8&oh=00_Afyt6g3C-xeCa0NBbAMYSqfso9T6XYAJ08t9nrDQN3T7qw&oe=69BD37DC"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "LastPass", "keywords": ["productivity", "login", "lp", "security", "storage"], "long_description": "LastPass is a password manager that secures your passwords and personal information in an encrypted vault. Never forget a password again. Only remember your LastPass master password and LastPass secures the rest. With automatic device sync, anything you save on one device is instantly available on other devices.\n\n     - Securely access information like passwords, credit card numbers, \n       and addresses in the encrypted vault.\n     - Copy and paste various credentials while browsing on your Oculus \n       Device for a better experience.", "short_description": "LastPass is a password manager that secures your passwords and personal information in an encrypted vault. Never forget a password again. Only remember your LastPass master password and LastPass secures the rest. With automatic device sync, anything you save on one device is instantly available on other devices."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.lastpass.com/legal-center/privacy-policy", "developer_terms_of_service_url": null, "publish
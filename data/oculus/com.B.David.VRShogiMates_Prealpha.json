nc_ss=7f20f&oh=00_AQKEyKKjQxxNFjD-RbYQGDm5z7N8Z8GW778gVaxI_32dHQ&oe=6AAD5A7B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XvUhBA1fzrkQ7kNvwG5xPc5&_nc_oc=Adr25jNuiaCamwKq5oAeRUyOImlfhUu0BTRrHh4Ch4inKezt_MOmewa3CnBP_KKW08Y&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIsjS-ngdWzw8iZR6e_MAhs1hJ6maUPY9IVhBoj5aMLqg&oe=6AAD54E1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WLPYNkN6kHEQ7kNvwHsKIM3&_nc_oc=AdpzHuX7LVIu1WbRIVx3qUK3BiJ9MQnCAz-hlhhmKfzbshYXqeqJB9z1fwkIeANy3P0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL7D1m9NIctnOYbI_zfFf7z6OKzc0VW9Qv13vQCBQt3tQ&oe=6AAD3C93"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6EThKeZxjLcQ7kNvwHP3JeX&_nc_oc=AdoZSAN-5uakj7AWHANXlaMvo6NsNbK02GNfYh4PVLamt5q85WEdTi1fzXHzBkNTIWk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKB1GEbOYdrgxv8UL5sholkxf9TIJR3EUghLKiHWvS5-w&oe=6AAD4623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IWwpT4qG508Q7kNvwGxnTCF&_nc_oc=Adpq_y_eyNNojloP3Ass_5BYbS5Jo9CUsnsgn44I5HiGdvt4WHYBMVYHBgYDsdLEN5Y&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKeedp_0z4HwV8TIJgD8NA57RLBOxBg3Q-0AOGa3QbKpQ&oe=6AAD5FFB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
nt-ord5-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LzuW-lye6P0Q7kNvwGY7WLx&_nc_oc=Adl-ALfGQaJBBFyMmYGPGygex9urfIR87UvSOri1d3ASCHUXnW0nWuU9fR6I0B7pJ7o&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfsF4At-z4dIZq0ecLbFxn0GtVAVtdYEkPhAVVBSJrhJbg&oe=699C3621"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CjJ8HzbKccQ7kNvwEoKKFJ&_nc_oc=Adkm1boUVIT01gMunhFED9No-0Anb_psCWWbqU4rYnm2Og444VoV4Kz1MyMgSJnpbns&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftZEFQ69uV_qhBPg9A-reSf1Q3PwR-Vf57qp21Fy8bL7A&oe=699C5613"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=otgyaCqW2SYQ7kNvwFMItqY&_nc_oc=AdlMj95q3J5RaFRW3phF4S1bDu_MZmaojvKdtDU9-Y_80k54OKUJqXwts7gnTnzV9o8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfuPrrvLChOKZAz1593lohvXZmHCHq5TEzEj939sc2bhYQ&oe=699C5FA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3jeS62jvd4Q7kNvwGoiBWv&_nc_oc=Adnfr_DefxVG2ZuJocrNz8rLysoeULxxb0WDuLKT3nFF53xKVjNINYgMkjay9GPsTSU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_AfvupiqEtl-3aocfsuqDKs3dliRMRyXc8mOP39-c7Yb7Zw&oe=699C413B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.websitepolicies.com/policies/view/a41733bc", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogi
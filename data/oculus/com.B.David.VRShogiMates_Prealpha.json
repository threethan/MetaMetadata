nc_ss=7f20f&oh=00_AQFEz7ffa4g54gP6KoPy7YxPFIdLlpoHUS1VcpcffKQhYg&oe=6A90213B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMxVbzu1ksUQ7kNvwHyp2Xd&_nc_oc=AdrRtzIrUThvkOD0zH3S_m5JixKep18iaw_Kgs8kkQkqFmVJEcmhX_Z6ixtKeP3RMG0&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHTUN2efGK6gQh1EUxIFd2n6XmjG-Uudxj050FjmKm1QA&oe=6A901BA1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-ogZghljdsQ7kNvwFRcHjZ&_nc_oc=Adp0bPaJDqbPn2YX-nKvX-P9Q6BqkYL1d-uTNlevpUFnU7SRX1A_CTMKsIMGGvRsvQQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEtpNznMc8lS_BG0JmjTlbdmyPk3T2RD8E_77HtNngqzg&oe=6A903B93"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEzMjBcAaNcQ7kNvwEv0OIO&_nc_oc=Adr0dcqg-gi16enIDdsnr6M8MjvFsEaziWQ7n1JJzxzLiP51uhOvk4ZGysc9t7uzaUs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEEVoPT5ZzwhusWUlEbdtGGQYst9R2MCCYdk8yXCm37xg&oe=6A900CE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZvkMUUcc_0Q7kNvwFS09VS&_nc_oc=AdrH1ob2hGwIfhWDiDQzgkTGC5K68mDe__RA_cL1ewqGWsNgJIAO67Epk1HJxfVX-6c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEIVlD5u9E_XP7TtHWzcHGouN0Y3zR3PllAg9IimIBLcQ&oe=6A9026BB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
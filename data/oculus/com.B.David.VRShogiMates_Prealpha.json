&_nc_ss=7f20f&oh=00_Af-wPvYFTfoDsW7MAQOhI8_cUJ9nZZF1rz4gSjt-h4VXGA&oe=6A2EA2CF"}, {"file_name": "VRShogiMates02cropped.png", "id": "398942312562424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404387_398942315895757_5737287799332143666_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nIS9cfk1P4EQ7kNvwGP-3pS&_nc_oc=AdrXWmTSQ-SXB_DPymFyxWzKtUS4Gm0stpjEqVxGEyG0IHxjZiXoZaocoi2PcQtKd9s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-bFgoMef1ftPfYWtPJN3TaRMm24kPhOdpTzRS_ncnyBg&oe=6A2ECA7B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9wtmb5jDhlYQ7kNvwHU42wj&_nc_oc=AdpDUPDBQjCY8HctS_h1kNXu2QTiqegylLA76FTZWtP5_eltCp-HWKzeqHNx047tH3M&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_kPXaucWwKh5Iqt-2EPjIyh99zNmBxZKyjWSDL7L0Ftg&oe=6A2EC4E1"}, {"file_name": "VRShogiMates04cropped.png", "id": "367552249204365", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031624_367552252537698_6058304213158592905_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NuPZx_1OUXgQ7kNvwHotqYn&_nc_oc=AdqMdugWVkP8diLqwyN0EVThf5myYRIjsIKxymMlFJ5JzTuESmZtC9Y-5TTrobSIh2A&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_o9885X6q4DcMGbgyNtiffB4tMIr_CHOPvWMpRBkEslA&oe=6A2EBB25"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VQKQt_gb7BIQ7kNvwGrHduY&_nc_oc=AdpKXx4bRp-p4erMLESre9tHpdYnQo07bib0OGEcZWMv04FUjfJdd5VDcYUFZBiFSFY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_zvWlRs33ZExQD-CUKuRwHGL0lvxxJv0ir8qyKEXmMew&oe=6A2EB623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-UxOJwj3jt8Q7kNvwG6a9UE&_nc_oc=AdqI3fjwMCILADmH7Tu6KYE335LU-1nFMTkjta6RmU9u0Y30Dt79PSpBY_BeNMJ8QAQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9rPGDvS60ajSKCPpM4-v8hzBBtCb0o9nulJwIuxwGCrQ&oe=6A2ECFFB"}, "display_name": "VRShogiMates", "keywords": [], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.websitepolicies.com/policies/view/a41733bc", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogimates.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7281388235284231"}}]}, "scheduled_offers": {"count": 10, "nodes": [{"status": "PUBLISHED", "id": "1309666514563636"}, {"status": "PUBLISHED", "id": "2425750037896841"}, {"status": "PUBLISHED", "id": "1210605897649031"}, {"status": "PUBLISHED", "id": "1399416624484094"}, {"status": "PUBLISHED", "id": "1879046082947345"}, {"status": "PUBLISHED", "id": "1417091573029619"}, {"status": "PUBLISHED", "id": "865177719103341"}, {"status": "PUBLISHED", "id": "8539910886030335"}, {"status": "PUBLISHED", "id": "407905571594429"}, {"status": "PUBLISHED", "id": "1091349662049190"}]}, "baseline_offer": {"id": "407905571594429"}, "is_approved": true, "firstOffer
nc_ss=7f20f&oh=00_AQHEQS5933-PjWOInNnrk27onHVw571HqL2B4M832e8E5Q&oe=6A88383B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08krS3EG96YQ7kNvwEseLVH&_nc_oc=AdoCqxJj1GkKIpdvlfnOrnosFx8B5ABfScutj6vkDeSlZ3fK59YvrXGbzRkevazTF9Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfedjxkdIwQilKfLgvPxrdNo64Qm5j-g63uitLLb29hw&oe=6A8832A1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huZGwX3sNPMQ7kNvwH41IDo&_nc_oc=AdqKQEZZYSD5rtsXQQ6HYb-AGEhJk9i5DxojY8rLJ0SE9BfwV85fwZiFYA3hEU9gr40&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHZFr69ijHYU9s4ipC9IzA2zjcG8Pwwwbd1qA8DsY1WPw&oe=6A885293"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4ru7DQkz_gQ7kNvwERWjVH&_nc_oc=AdrHRtoL9IvELW_tbbqQ2vbc4o8YiZcWPX_0Wo2g4QQ1dN28oCa0eVrcNNUDmQnY2wY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcFPLHLpClShIwsBOV-aeKKygzqfAsBppgeA5qCsQi5Q&oe=6A8823E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFBSPvoP-FAQ7kNvwFV3Wj3&_nc_oc=AdpMV6ABvrAW9_zDfY1b0j72F5cr9P8Jh2qPbPS83NwJEMV6Bv-l6ayvxI3hFbQzxOU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH5Mjorpij77GHVWq9ts7zIYtNgqbjhHV0-UxqOy4Olg&oe=6A883DBB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
nc_ss=7f20f&oh=00_AQGm04IgWIAMtos8qIVbuwioS4oziNtkGEKli0I8U9V5ZA&oe=6A8ADB3B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08krS3EG96YQ7kNvwFAhqOM&_nc_oc=Adop9gjcSl-iqPP0rqQnbYDr7ENdIxUZLL_-q6syWlR2eNmR3IgzMCdhj1dVgwjVTV8&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGP2q7ztOJYLLP2oZCYLSe3chPD0XoXW-LpGsUjILk9OA&oe=6A8AD5A1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fK-4Gn5o9e4Q7kNvwHNpL2Y&_nc_oc=AdpGaVYZ9C3mB3DQI43IcAzt9N-pailb5s0OVGfnxp8OT9VV0iIBqLhn5-Olc-X6eKs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF7XpNa1o9xU8HCYcBZb_ADUVMxRqFeLz390977NDb3dw&oe=6A8AF593"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR3lqufzvpUQ7kNvwGJNOyb&_nc_oc=Adq5kvfe2yvBzdixEjTGBOuRBj313LMQY2Ii4T9YIJy8yhVXCGsdZKYSNF69hlMddO4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFSGfNb9t4udIKL67Bcij378JUAvZ6k-riEMlxYqNIHrA&oe=6A8AC6E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=onyW-Tx0-4IQ7kNvwFiTOP0&_nc_oc=AdoVAm2mAiRSS8yvd9er49RNyh1-6sVgM4rZu6DJWFr7Q7zypTOCgXfUHtgV-dHeErQ&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGZiFIIUAMq-Pqcn2MtI_0vy1Af126SznxJVp20lT448Q&oe=6A8AE0BB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
nc_ss=7f20f&oh=00_AQLP8MKpIfy0SlmM2ALVjayrTCuFJE9kF5PjEJPABBP9eQ&oe=6A9C36FB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dM2m2Om_zjAQ7kNvwF7ELeG&_nc_oc=AdpoC4oz4HphrH6Lvk-ky6emh-bG1GQtLCsddrKVgomaoyPe2QmBOVezpRuvkFiw8a8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKX5nfoq5Tgoo8fUFoYNqOdGyy1gESVSOtyQt5e9Z8iw&oe=6A9C3161"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rlV5cL8A5Q8Q7kNvwFW_-QD&_nc_oc=AdpfM4m3gyYAND4_33U1ZgWyTQ_IWfrU4HBHsnKan-8pJYsKydi52rXNqEQaG09P85M&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKj6IL48ZUOoEbf7f98o-hpfmM7NaFSzNorMVwBTd8aUw&oe=6A9C1913"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oC8xS0qDiH4Q7kNvwGkHtNf&_nc_oc=Ado02dltBouXcVHN--p8dzWB-P1pWRN4fU38XpF0CMNbFSjnrrNm13-nOv3u4z-aHCM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLSspoRmetqC2sPovvGonIedhclqCiTUUmdJigKbk9E1g&oe=6A9C22A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qOjJjbVr_38Q7kNvwFI8oJK&_nc_oc=AdoFjkNVeEDAhNQDdwoC-DA6nHnrC9dw2GBXGWOTKa4n6VsnonY0YyAlqzt6hkPL1Ko&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJWA1L1JpLyPSBimODm4sAqeYM3EKt6DpUb7EMTb8Hz0g&oe=6A9C3C7B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
nt-ams2-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=d0EZwcGyimAQ7kNvwH8kMC0&_nc_oc=AdmZy7Ox626ut9k4k5Nh_JGnTGA5TTHCtXCU_LmzYRtxELa1ONqQkq-YRW58lrLRCQ8&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afu8aDCx8NO6FyFshwDomNjdMFUEgWTXnAvcDYc8_AYaCQ&oe=699ED921"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-CjJ8HzbKccQ7kNvwHW_84t&_nc_oc=Adl3MwUeOCSufSC24GDYKBSSBjmkRNyUKrEGMmWTe_Ra1GHSJ-Cko2PjglTHRbHmNxo&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_Afv9spS6DVnG88_EWCpAcJnHhSFezGp9LEkjIHiQveSqmQ&oe=699EF913"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJGizaMhUoAQ7kNvwGZHVeJ&_nc_oc=Admp2IpqiD74DrEu1XrxGbpngkrF2YIGhnXh5uXG__vlGU9KYopCM9Sdft1Uqe4zZU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfsCNPSAfZKhvdWRRt0v8gqMB4u9grfDC391M3qN_UOQgg&oe=699F02A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=O3jeS62jvd4Q7kNvwHENUBd&_nc_oc=AdlJYO4S6sJqF1cDeyyXbFTfpk1IjEH3FMz__16q82c7MijGE7ytgiIElbbb7jhHlCI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&oh=00_AfurPQ9iSVzs5EA2j5AZxBqlE1BjIun82nBOELq0NYm-sQ&oe=699EE43B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.websitepolicies.com/policies/view/a41733bc", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogi
.com&_nc_ss=7f20f&oh=00_AQNI5Nlxg1wCZ7tKIYPhrjgM4ZTN8mxyL6-9U-_9Xrkehw&oe=6AE348A5"}, {"file_name": "04 Background removed.png", "id": "295434423030492", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75250459_295434426363825_1133238189502684429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hKQbHcdKGaAQ7kNvwEhm68u&_nc_oc=AdrKyV5c5guRzRxtgulX0g7ZsV8yVSt0haKKxjBO_ky28lXTn9Z00YLnZmkaweX1Q8U&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPUvI1ez8R2HMS-geqSmVSq2hgmLsvKibQw3stknHGwpw&oe=6AE36461"}]}, "id": "1757276535563704", "locale": "en_US", "screenshots": [{"file_name": "VRShogiMates Tsume challenge 1  (Black to mate in 13 moves)-2560x1440.png", "id": "1212274000044966", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982440_1212274003378299_6748105456435770728_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSI9nD2_kr8Q7kNvwG3uji0&_nc_oc=Adr0n92UqlRkW7lcGs25zFHGDaDxPruz7Fg3Yw4We4Qp6Hh1hYNT13rKAHrHfoJ0nzA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6FfB_ysHL28v5k9vY8UfR-mEQ7C0q47RY2bTedakUYg&oe=6AE359BC"}, {"file_name": "VRShogiMates02cropped.png", "id": "398942312562424", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75404387_398942315895757_5737287799332143666_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tkU_WWTVKAQ7kNvwHjiMzJ&_nc_oc=AdodAZQ-4z0Jp7kEcuhFiceOgsvwzWfn_dXaNjXTRs7tGIduOmYlAaX3q5Ub7JI7a8I&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPplUyIk-wV8SdpW4FN2lFbwuuKDAAS3K67oyHkxxc6sA&oe=6AE367FB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk5vKxKc7vAQ7kNvwEFjBWG&_nc_oc=AdrHKGusXwofT9ZHmMqeKVAf6GgVdQbDaHj8Waa1vgp4m1yunssDOM2IjeQyBHMBCew&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxsuoxU459EfKIlIioZsMAwoboVQ1TcCksXhoc1yjNrA&oe=6AE36261"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1WQKbjlL5ysQ7kNvwGGQzbd&_nc_oc=AdrpwaQfWmRAoTzYR6T-LHz7EWMCbZ9RL3_rRLKx1AKltcova3ro0gYioE93EgZfekU&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuOwYqODbErXjqiI_SY3I825DGOstETAxmFUpGa4-4eg&oe=6AE34A13"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJeH34C2PoUQ7kNvwERyQwe&_nc_oc=Adpm_w7cKLvOUS0rvRSFwZ1IacwKCiNFNmnswpeORkAfUoH3gtL33DKFvfFOZjOiXIE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWlZKwpDOhuahgpMRhGJxzcJ1QBcMCKPN6svg65i1Iww&oe=6AE353A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=38VW-zA2pZ4Q7kNvwGEOKkV&_nc_oc=Adq8BK_UF0YgZ5761q5F3IIfQP4PM414gYB168pb3jjh-G7pLf-9CMHLuXEuP-qw2k4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPxjBmV1phr5oZqjaXvMX1BBx5lL25YsDVP44D8o9BQDw&oe=6AE36D7B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSqXvliv35vQxAmBcivKWHTeZU6uYtvVl-AYDhYR_j2g0rZeRh3vWME8K8kepbFus4YikVBZ3adYVrt/pub", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogimates.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
dn.com&_nc_ss=7f20f&oh=00_AQI7jpBnG5IN9fEIRGZIFfl2nlRydv6E41zDC2s8GpiazA&oe=6AA41FFB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kGVX3aHEfVUQ7kNvwH2cTcN&_nc_oc=AdpS80Tfig3aiG0TAzg5aWabo94pweTD7dbrOwFOkql1fb2Q8HXd5td3TsL5QkvbCGQ&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI_MU9_hpK0r-QVm2wPHFb8FH9vqF2JS1-hvNOL1FdTAg&oe=6AA41A61"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ALFUEEELbvgQ7kNvwGmnFkg&_nc_oc=AdqhpwocgHwsjXqnHXLkGa4id4jRPrQtJzPXvVAdFSGQQ5qiOGhcMLcmJu2EMuIPsV0&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIHv-SitD1nuxj4m5mbcihnoF4FrT52z3WVLf-Y96-KcQ&oe=6AA40213"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmPUc91Cf4gQ7kNvwH62R6O&_nc_oc=AdqnDVBZxeuc9N9p3jznnXJMWsfZts7aLuSQo3rvLk6Nlc5mbW4CQp2hOPPlKS-630c&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMou0Ssw5Hcjw9D4LyQXm7r2ZPe_-JFi3jemT2s22ldw&oe=6AA40BA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj2wZWOlM9wQ7kNvwESfyPT&_nc_oc=Adpvmt02vax5BlE7bZV968uPMp_qzZKVo8jgbdzajHXcFt7DLoeUTHsFJxQSecw_SOM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKlsJ2wU4KgwVf-KZIedE2PEC7MDOVcGc3sgQrUMvKGhA&oe=6AA4257B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": n
nc_ss=7f20f&oh=00_AQF1EhAGPUPxKRCHoivogvCfJ_90a7QediuL__1KdD5AEA&oe=6A92C43B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LMxVbzu1ksUQ7kNvwEI7vCW&_nc_oc=AdqdcCSdtFF4T6_mg47RJS04pBt8cWa3y5ByW2HabG7xX-Rj9v2eLdSZF4nRgkQ2APY&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGixuNZkzucYUWc2rNk39SLEJJne_TsMrATKPRifbOzxA&oe=6A92BEA1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLqeUcqBS0gQ7kNvwGHl0Vk&_nc_oc=AdqALugz-1PDBvviDpxDUqq8yhHH8uuklbmf-BBJ51wCj4GRByqHPJeAVX-V7Xil04Q&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGlXq1QXE_09dmJUnaIr1XQayFgn6d1mqDppoOBOmZVHw&oe=6A92DE93"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7oB94sZJZgQ7kNvwEdzywW&_nc_oc=Ado9mph4IptWVKn8ZJIlyH9vUfta-_evq_Ybv7yr6ZvVCKU5exW4wiT2fxxaqvFtZpo&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy8p-Z82q1bzl5t_6P0yZiZRYl-MrOcz9aaHjJW449_A&oe=6A92AFE3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1S-VxG0faUQ7kNvwH5-C39&_nc_oc=Ador9jJff3u7DLVfyvg2eox2AyCJc8TbUO2w72PMa3RW511DWOKU5RCoDv31-DRaut8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH1mKUs8iVrS_xuEUGWSrO8VrJFePrxhsFXyKaCa2oj3g&oe=6A92C9BB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
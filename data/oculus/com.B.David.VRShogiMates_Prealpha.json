.com&_nc_ss=7f20f&oh=00_AQMHlAkumGGgHp3xT2ltkmUitauMxDj-szh0MXlCeduz3A&oe=6AD3AEE5"}, {"file_name": "04 Background removed.png", "id": "295434423030492", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75250459_295434426363825_1133238189502684429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7hXM_Di95-kQ7kNvwHBsMmW&_nc_oc=AdqX_NT0J5bRrylVercOfbFZ2gqtgRx9QJ6JzskJFO4F_UMnxQwZ880xnleJNi6ZKPc&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9hlgdCl_JEiCHjY0mZSnXfBj36uvy3xT1CZ4uJs7B8w&oe=6AD39261"}]}, "id": "1757276535563704", "locale": "en_US", "screenshots": [{"file_name": "VRShogiMates Tsume challenge 1  (Black to mate in 13 moves)-2560x1440.png", "id": "1212274000044966", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/38982440_1212274003378299_6748105456435770728_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WK4-9UpnfWoQ7kNvwGZrVMS&_nc_oc=AdrZhZbmz3QBWvAm8sEVujLknLh7crUn5LzJpiYePHNPCnHfBzzxXqVhDDLwzVDe-C4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMG3ISD77cQrXPIHCCbmyP0rIRa9TZlFG2J72UynjmiDg&oe=6AD387BC"}, {"file_name": "VRShogiMates02cropped.png", "id": "398942312562424", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75404387_398942315895757_5737287799332143666_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YZDTV2hiAtQQ7kNvwEHXyGQ&_nc_oc=AdoZ1DQ9mLZ_0Lnc1hvCbhtJRcTgYMCyYVO8TEPfbzAYUXrt1rwQPAAJNry2cfxwf84&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO4JOGmHFkURovKWC7KRGFMdZITn4qiAaCP5gZk7Lvm-w&oe=6AD395FB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ipVyAZ21KeMQ7kNvwE0vuPr&_nc_oc=Adri0htYRbt6b4gvuASrdkW-G-tTI4mQWBca6KIOGl6SCwJ6tRD_oUR--ePRxi3r_8c&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMM7K9BIXLv7dBBG1nwhz1vFOLHDCMxNgoSSadGjYa1Sw&oe=6AD39061"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crGq0DLbPdUQ7kNvwGI-GQF&_nc_oc=AdpP-PF6qNBPUaECJHCMWKDqYiyvjlD60X2eTYtNNMhFpyXedkirjSeoSGmCgWsZt2g&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP_Svtu9uiI-xcBCA8Mpz4N_npLkK63Z0sSMDp2xZE4sQ&oe=6AD3B053"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mmuhJ3JCNkMQ7kNvwHmCDqF&_nc_oc=AdqElVNzV9ZoJUzdc21ODB16gCV7QJ101oRODaUZAw5am3_G5I9vuNK8nFnQBRiIurw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNaDA0bdN249yeiWF0xq0Xx72QivB0aj6Yp7BhTBgOGxA&oe=6AD3B9E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wK_33YjR-LQQ7kNvwGkUhn5&_nc_oc=AdobmvXpXjTPaWx16pkB-8zIa7dzYwjUyLvzV8QA3z1LYpv-6ZS_otN-sgenf2c6KZY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNRIkaCaPKEIfbsMVOlmQgFXdiKC5xzgZqFkde4wom9jA&oe=6AD39B7B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSqXvliv35vQxAmBcivKWHTeZU6uYtvVl-AYDhYR_j2g0rZeRh3vWME8K8kepbFus4YikVBZ3adYVrt/pub", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogimates.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
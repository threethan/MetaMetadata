.com&_nc_ss=7f20f&oh=00_AQQIhn2ET_jxvXI78vQaFCPXplhgdRwt-LQ6xLV-S-Q6Kw&oe=6AEE0CE5"}, {"file_name": "04 Background removed.png", "id": "295434423030492", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250459_295434426363825_1133238189502684429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gofzPJ-KabYQ7kNvwGfPVXj&_nc_oc=AdpYZUG1mTXstrgl6AwTJ8lG2UiRYWYTiGjESDgUd4vjl-_TMsyOBsO589BVhKd0XhA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXfXFzOXItxuBf96yLevUh0rrZc3po8hh4C-3JdjRjtA&oe=6AEDF061"}]}, "id": "1757276535563704", "locale": "en_US", "screenshots": [{"file_name": "VRShogiMates Tsume challenge 1  (Black to mate in 13 moves)-2560x1440.png", "id": "1212274000044966", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982440_1212274003378299_6748105456435770728_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7s0UpT8ldQYQ7kNvwFGRXd6&_nc_oc=AdpXK4URS8I1pqyqUhY8YWGjDJYrEhd3LhWAI8yGtMuWHfX3-cPXGBFgrRWKXMsOuBs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTx2J3z6Z_VueO24r-7Jlh82eXOkmwuq8vrWUqoQl-Iyw&oe=6AEDE5BC"}, {"file_name": "VRShogiMates02cropped.png", "id": "398942312562424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404387_398942315895757_5737287799332143666_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iyBlS86-8UsQ7kNvwEGJiHi&_nc_oc=AdoqDS_hQxkTjRqZTONQ6jQLcpDJisd--mdZmm3NfjnBn10DofFwGqvDr6X6cw8iX48&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQpOZ-sM7mzSH5_X2f1ENLk3S_3mJEH8W-UaiSeHqxsmQ&oe=6AEDF3FB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CAvNtLY2ehEQ7kNvwGSVxDS&_nc_oc=Adov2SeRVEpLyYAcucyI9Hcn58jELiwmXpICrLVyvapxm_hgqWV2Ro6YS9h6ELdD9gk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTOT_i98B2wXjQo2gmbH8Q0QGrpGZOGyjxTczBl9jkCiA&oe=6AEDEE61"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=l8_Y4TXHvkgQ7kNvwE2CZTr&_nc_oc=AdoC8SzfD-Q-Uvix5H4rIbDHoj0uUwjkYTspENP2e1TL-JM8Px6vIkPHY5uxzjDdnkY&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ6kuXtPBy7KmWotu2GW0Synl9YkzhWOLitJwmvtnBJKQ&oe=6AEDD613"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BSCS_waYIdwQ7kNvwGErUrZ&_nc_oc=AdopxYtcKrWH9rpf4hPxvH6lxj77ug5Xu1OVlknNckyWRe7S3M3KBT5AZ85DlDJuguE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2zisCRFAEdCJRh5n37DV3fSNVck6jm0C3W1I8we5irA&oe=6AEDDFA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QH28a2LKLGwQ7kNvwEH2lLT&_nc_oc=AdpgFHEH8hNPXCDe-UpEIsyvhsFfox_C7K4bZyEIyA15cP8oE-k2iaOrSCmJEUkdf4k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSIs_6xWL6hQCBo6mhkJwxspvvBjDuFXNJXyqeuh5qoWw&oe=6AEDF97B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSqXvliv35vQxAmBcivKWHTeZU6uYtvVl-AYDhYR_j2g0rZeRh3vWME8K8kepbFus4YikVBZ3adYVrt/pub", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogimates.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
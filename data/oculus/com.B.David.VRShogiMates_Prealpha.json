.com&_nc_ss=7f20f&oh=00_AQTj_rWaHrQbXRVi4HZ0JUc9c7auf4zaMQRhFqi4n5QpNg&oe=6AF352E5"}, {"file_name": "04 Background removed.png", "id": "295434423030492", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75250459_295434426363825_1133238189502684429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At2Ez-jvz8cQ7kNvwGJEhR1&_nc_oc=AdrKp_cHvILtKQzMxY48p61YufyT47zb3z9aoPpm1VErXyDIysNZf7KVRwb6japUog0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRBCQwScnPJ68QNT7xqDGr2kPps6CHY8jZLbkCx92dXhQ&oe=6AF33661"}]}, "id": "1757276535563704", "locale": "en_US", "screenshots": [{"file_name": "VRShogiMates Tsume challenge 1  (Black to mate in 13 moves)-2560x1440.png", "id": "1212274000044966", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982440_1212274003378299_6748105456435770728_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73c3L1GHtpUQ7kNvwHwsE4c&_nc_oc=AdpztqePWDLKoIXCj4Lu1n00lk0-Ee-D3Vg2ZvXueBkVO1gEZ4gHdq7U9cq5QwFanJk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRDVA5eIlabrprqFB_alLAX3A_WVr9r5Aj9S8Q8nzdzxQ&oe=6AF32BBC"}, {"file_name": "VRShogiMates02cropped.png", "id": "398942312562424", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75404387_398942315895757_5737287799332143666_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlqNiJsq6C8Q7kNvwH08G1u&_nc_oc=Adqkb0ngcyyytL8MpvAhBxLRd37VCkWnMbeoElHqMLjjhZWD-J3MqHUv9IN60ogfAc8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQa-Ti5OjYtVxUWs8DlrzRtlvwuS3hcJl71zjIjhg17rA&oe=6AF339FB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQbB4g5pKXAQ7kNvwEEvhue&_nc_oc=AdqYiPt_Xg6jCCOXRMK0z2Rah6TIZjbrezHTLGMCSjYNpWIfN5s0_eDUk6_qYFPsm38&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQJB8yKvaj3098H_-S4yEl3h00aF7qALP2D9YdWyB_mVw&oe=6AF33461"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6oj5I917JMQ7kNvwFhk1_M&_nc_oc=AdpW2wcoVjMovtoJ6UQoZarpfxSDnjNjzKkN8rsKRsdjAAwygIKavQqiKc43TtxMyFc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRPCZUluMNL5kM9KfjQkYNJ6YqvTjN7GoNhaXK00OL6vQ&oe=6AF35453"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKoCVZPm0ZIQ7kNvwE6XBum&_nc_oc=Adqaym3G6k76S3mHY-yDzHwR7lWOJU2kC6pkKLm14Ko_RdA7VO2xktdwmJNVZ6rK-yg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQPQpHnWy_5Avy-eQDY85NPBGp6E5ExSQrIMyzkG_Qo9Q&oe=6AF325A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22jvlxDY-dwQ7kNvwH3V3SJ&_nc_oc=AdrtJMzMM-i-MVzRC5sneKsVSFQDHBv5ZlHUvIee36iXOHVh4JehAlveeZiJGpR7O2c&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSuDNrpC5m5Ah2AwYvkEYw0BQIRbOSqg7J9SdixeHq1ng&oe=6AF33F7B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSqXvliv35vQxAmBcivKWHTeZU6uYtvVl-AYDhYR_j2g0rZeRh3vWME8K8kepbFus4YikVBZ3adYVrt/pub", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogimates.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
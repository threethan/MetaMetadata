nc_ss=7f20f&oh=00_AQDSgaSYsgooJFbF7Gs33ff45faIZpS4I2VGjYdEXFgXkQ&oe=6A6F2BBB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Wmwye0dJW8Q7kNvwFFPVN_&_nc_oc=Adr72KK9AF6N4_oSy9817WmLDBsZIbmOlh1tM73p85TXAbqhbI51cS-e2nOasrlEazc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAnZCFvypMIBhqZOLq0_R3WAlm3eS8s6YqRRPo4luorww&oe=6A6F2621"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y05P0wtlvAgQ7kNvwGl9JN_&_nc_oc=AdrLYXnvuOFdEha-jWcnec7wOKLCM4QPihmFXxcK1MM67ttxZ4e3KE-NUF1CxsIf8N8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDKZcBVdxTF2SvCTw3HvGZASXrw2sT9Le-5h1KnGy18FA&oe=6A6F4613"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Q4r1CB2s0LUQ7kNvwEExsd8&_nc_oc=Adrir4DaF3VeMSS6woF0g2K9qTzT8ICFE1DRasNqjRlhaIK48Tk63r4NK6zL-C7NXh8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAVpc83TsBsaSc2SNC4OZHpRgFOme_SaqwKdmQOBK9uaw&oe=6A6F4FA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0i-ChPrIJpkQ7kNvwF8uLlS&_nc_oc=AdoLkVQVlNyikDbC-sOpf12aqWxoH0C-ciYi3EF6tjWlqIq95no2hjztdQHg2R-qQWg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAvuEiA6nYNFUxvvWnvVDfYWAFe14A3PVa1Tw1DlorqTQ&oe=6A6F313B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
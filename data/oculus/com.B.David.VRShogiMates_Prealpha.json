nc_ss=7f20f&oh=00_Af5eMGhiWPkb3oGn6ZOrxLUKELzIIsLPKQfQmIcPacv3Aw&oe=6A1DA6FB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pMzmAddcUKAQ7kNvwHwxA2B&_nc_oc=AdqHShDTluH5GsaqZQDRI97JC5BWQchJuCocdZ8D1fqjsY6EnF1NTUti8PeFvZoj4OA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7v7abnyWP8TIfyV3QcmsGRNcQ25ytx9o0gbiKuIYtL7g&oe=6A1DA161"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq0jmjVs40AQ7kNvwG-X8rc&_nc_oc=AdofcM1uVq-P8hB_9gWvwd8ail1RcXybAPkzB4O_Jjzevs4DdhAylSxs92lEvtHdU6Y&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5R2Wm_pVsjeNt5j1LIjamtOMDTNy0lFeFiMav1Ai8Dcg&oe=6A1D8913"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syyNqtLbm2QQ7kNvwHcqXBB&_nc_oc=AdojBmIXFtq4L7bddCErQ8zOwaBNM5Qy2FLlpqg1n8Y8UvCbWBPxGnIcgfQupogB0AA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5U2KJHxJ3uhahLkm73O0AVUlnI4CVTyyE_IA2ngh_5nw&oe=6A1D92A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jn1Mx2gYStQQ7kNvwGtS9sn&_nc_oc=Adp5vl-WD622EfO52hC9mPFgUxv2aNRjyJREvLqJQMXyh6WC5pC_uh53y3AAOvgSvYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af56e_B3_By7PXRpvxdwKkiS8nwv01J-SAaQMUmPpp4tDw&oe=6A1DAC7B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
.com&_nc_ss=7f20f&oh=00_AQR_Sh2nS4choYMq_qASq-DKAykfw756mm6cWzCwLhTsvQ&oe=6AF20165"}, {"file_name": "04 Background removed.png", "id": "295434423030492", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250459_295434426363825_1133238189502684429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tOBevV9HJgUQ7kNvwHgMk1T&_nc_oc=AdqtCWbm1ENzL-oU6OT7NcKUDtGiHJX90UoitYCOOF6q9e5EHmFk6Q6eZg3dNDchFQs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR2BDc3QACT2qOIUr-2-g4pWj80wjPzLlOXCNRK2k9aHw&oe=6AF1E4E1"}]}, "id": "1757276535563704", "locale": "en_US", "screenshots": [{"file_name": "VRShogiMates Tsume challenge 1  (Black to mate in 13 moves)-2560x1440.png", "id": "1212274000044966", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982440_1212274003378299_6748105456435770728_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7vG7xO4_sLIQ7kNvwG5kTGW&_nc_oc=AdopY-n8c8zTNAOldiC8VfMqBoncd4Tm3Jq0xjuodWL3BZJxA1lt9j7JNY7fX8CMBag&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRm3v0NUGZVEWfyP3CrWRkCqv5fT5wYNgQbGLRxPK61yA&oe=6AF1DA3C"}, {"file_name": "VRShogiMates02cropped.png", "id": "398942312562424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404387_398942315895757_5737287799332143666_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YFCw2PMRKrYQ7kNvwFdHR7F&_nc_oc=Adrx2LhzjPIiyQoJZEN7iu_A8seGfKDhQzgEJU03BBfNp0D6clMZesc2XTcEbrbBu5w&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRNh0U0oPeLSMVYeOlYMzc_p72UMwuE1G6wfC3Q92vP0A&oe=6AF1E87B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LlB8M1zkZY0Q7kNvwHfvS_Y&_nc_oc=AdpfqeMLVy-uhucufYYcbmiMjHn6rzUm9l-pK6_264vDqVqlImKxc7t4g5aD4IRjm7g&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTmIQclODf_xU9NVAzuQ2VBfKPvmGrrqBHlo86nc83Dig&oe=6AF1E2E1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J6oj5I917JMQ7kNvwHx14-p&_nc_oc=AdoXsqpZziRbggLiHkdoZcWKshOnmBZCTRudI53mMluCJFAibjp-BPgnQvipGGoIbk4&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSimiMhzqXF72fmF2ULOw_-CNwLkpckkrTINdzaT0Qfqw&oe=6AF202D3"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TKoCVZPm0ZIQ7kNvwEodVAn&_nc_oc=Adp0HRJj4iT_oP_GYalmAXxdjwcTUILvLOJBLtbQ8UrF6dhzV8s-317LuigRViXgLMU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSafuJdmYwJyF--MxO4nmgTExKk3Oc6yKm0HobU1UTSWQ&oe=6AF1D423"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=22jvlxDY-dwQ7kNvwGi4qkg&_nc_oc=Adp95Qr4zRYcmuO69HBBctrNpcXXc2ttOmGprdLokV9EMXDASHmWYzcfq0iKEUzT-zM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSXcS-296nOzqDimevCMQB_2tegbgRUW-3njtrQbxV9Hg&oe=6AF1EDFB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSqXvliv35vQxAmBcivKWHTeZU6uYtvVl-AYDhYR_j2g0rZeRh3vWME8K8kepbFus4YikVBZ3adYVrt/pub", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogimates.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
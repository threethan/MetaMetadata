.com&_nc_ss=7f20f&oh=00_AQRp9YNRKpK5_ZYOnVvpnamNTM4_npsbOz9vjvsK6nzyNg&oe=6AF5BDA5"}, {"file_name": "04 Background removed.png", "id": "295434423030492", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250459_295434426363825_1133238189502684429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=At2Ez-jvz8cQ7kNvwH5izNX&_nc_oc=AdpW0kOF16ZAK9tRd8GH-CsbNvwJeAGw-Bvn4xf_V_qBejxTviAgMihN9Nxvbmh0RIQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTQgVL7Xh3cXLvRPkczGb1lXCOYi86Ym6yFkyrmYledZw&oe=6AF5D961"}]}, "id": "1757276535563704", "locale": "en_US", "screenshots": [{"file_name": "VRShogiMates Tsume challenge 1  (Black to mate in 13 moves)-2560x1440.png", "id": "1212274000044966", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982440_1212274003378299_6748105456435770728_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73c3L1GHtpUQ7kNvwFzAZyk&_nc_oc=AdoEYtjswfkJ8APHnU3hPqC_CdVr80fVVEIFd-G-Vb9sxOW-ph1afi0G1k5eQKm40Ug&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTgdsKtQKzpJdIrBMlVvTspgajhzDzMMnadOE0wcQTWmw&oe=6AF5CEBC"}, {"file_name": "VRShogiMates02cropped.png", "id": "398942312562424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404387_398942315895757_5737287799332143666_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OlqNiJsq6C8Q7kNvwE2v2IR&_nc_oc=AdochDer_0E-pykmc0SQXav8BqUnLDaBOymeRPoSopHoqOUgSA5zKjOlgL0K0jT4mWQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSz6wOmhc1u7sPSqLnlP4mXePXa6hhkqRvLCdffSx3Pag&oe=6AF5DCFB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQbB4g5pKXAQ7kNvwEst5fE&_nc_oc=Ado5VsBjaIXMbWbu5LGMNe9C1qlmHBnolyEsPdSJ6IY92TDIqxbZ9Z5TLv1oQF6zcZI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTR2RJphHs34mmtxlxIneNV4ZasSDfa6UJGszW6GceVRg&oe=6AF5D761"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Zk-ycb7TTYUQ7kNvwGcrYcs&_nc_oc=Ado0oNjM4bd8lUTsif1idIC4KWPaCDiRsvJwyuOQks0a7-EJgex5cGz-S2mp0I4_rag&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRLCDQrFzo-IfyLW0uoJF_fBstzK8sdFU3gDs2Rm4pbQw&oe=6AF5BF13"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=t2PUElyTouAQ7kNvwG2iLo_&_nc_oc=AdqiYCmfRB1_9JQO6RjSmlQk34xpyJlEkmkrZg_VmYQ5AT3gm9p2tFD8ltAzsmrz2Gg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSnbzFxXrJQw0SMVoIDyGGtEGB_VwZdOw_70HYQkT239g&oe=6AF5C8A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n3_PR5R7tH0Q7kNvwEULY7v&_nc_oc=Adq0CbhNZdWGo4xJ5N4x0yY0uVoTLmqHgZ7EtBhloYeIi6H-2T3xy5TkEWO9Rx3OBqs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWtlIj7wakQUtVJ_3DKnaym0HPcSruHGz73QALS8vPgw&oe=6AF5E27B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSqXvliv35vQxAmBcivKWHTeZU6uYtvVl-AYDhYR_j2g0rZeRh3vWME8K8kepbFus4YikVBZ3adYVrt/pub", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogimates.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
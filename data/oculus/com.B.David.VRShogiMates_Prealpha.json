c_ss=7a30f&oh=00_Af2NZgy97PV2Cl8lrzQNTRzW-90tw_6LUCOeGjsLU6FO5w&oe=69DCD53B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJuwltukrNQQ7kNvwHbCD21&_nc_oc=Adpyq7i_3hy-TFDFARaqV0y9ZTjeXUjaAS7c51H3RJTlOZwqdgchi9zs3FOSQ-mBBHA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2ZoOU2DrVzCMrz2MXg5A2YUwP8b2t83jZirogSoigFAw&oe=69DCCFA1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eMXxSuGIMSkQ7kNvwFjGTEE&_nc_oc=Adq9FsTyan9pWINtKsE7-1HTmK9gl3T82q4QMkBJMd6bBlcBGqqPGlRlOMOYigDgbjU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3S70lIpEzV7kAc04VCcq9oM8xgqcXKqexjB5Lp9Oj_qg&oe=69DCEF93"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YmQFOJkxPsgQ7kNvwFdUf7i&_nc_oc=AdoWkCcD5ZhSg-lliQHiCM6vomiG3Yy3ruU8AkwQg94dj4eANZxT2PyNb0FiZfbhFSQ&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2HH7_aVM_OEWgj-7RkfP0tqZSlWdz1rkAs1rzKokK32Q&oe=69DCF923"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DFt5jZVDZkMQ7kNvwEdHhay&_nc_oc=AdpUXz_pKgvY7KtGXsC1azhDpfkWfq3ISlHne_3b0IueRV9v_aXSeuw_NiN4-aEbiWk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0K-UdW-PNYyGR_rD3wSZlfmVa90ztCruqEJ5rWZhcTiQ&oe=69DCDABB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer
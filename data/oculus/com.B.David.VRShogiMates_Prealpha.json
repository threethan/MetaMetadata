nc_ss=7f20f&oh=00_AQGMOyWyz2ODN1nKRfeBjWlos24mVkh80HgkXyx16vu1dg&oe=6A804F3B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PVqrcnAlPwQ7kNvwEI7Q3L&_nc_oc=Ado2BIO5k96mAhQV7taxE_yt8Ld53J_SC2tgmv1HXPoII8VgRuDVRkieGZhliuHCgxI&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQElojy9MdYYMA5iO583n-sCoV4QcKe3ptF7Bpk5EdzopA&oe=6A8049A1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sz2bCAU4GIQQ7kNvwF2AYSa&_nc_oc=Adruv15S7k3epJM3Bl3KTYc9heHhBfqDLFlcEjIW-B6wpsPdN0xD-cnby_Ia4BT4078&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYFKct9lN4-hOuHcxfPM5xeiYSpQikfyq0z9zd1p397A&oe=6A806993"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3R1EJEhf4OkQ7kNvwFlk5RY&_nc_oc=Adq3zUiwJtzhXmVXf5ZNbjTSKZ6LyG52seQj0bi0JCBpQji1QEVQ7EAHgA3ZS8NbM7M&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEOjPxu3CQ9nzSdnCXKgGajKt0EUr7mn7rQNrWtFFfv9A&oe=6A807323"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tq4b4Mwcj8kQ7kNvwGF7iAV&_nc_oc=Adqdv0Vy8B5jZ5feeivWLUb3nWekFlDCj21akrhEJ72_6Wx3xJdmHeSwQF04KrcisZc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEsPoztO5Ad1poOal0qXqPftM0wM-RUvsWiVyEbkSMfQA&oe=6A8054BB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
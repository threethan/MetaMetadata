nc_ss=7f20f&oh=00_AQFqI3xpoQMMsXaWEZtHH8xn6A1veVzQ7jk8N_v4_PgCXA&oe=6A7B093B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=73H3mv_jtAwQ7kNvwEdipSx&_nc_oc=AdqDk1P3AD4fEr8ph2tN2xE0cnM-DdAfTcFSUBblck7p6o9rCIN64GNl1_WAfzxRZHs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG8iddbpIv3XRuYgs1BMP-MeaQy95tMu9hRdNbXDoNSIg&oe=6A7B03A1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1zVECxp-FoQ7kNvwETE8a_&_nc_oc=AdpZbalyWxFZ5wUxWG7k98Jx6WCOW-bDn3CboE6Lb5jgaMDH-RHwyS13QUpN3k2U4lA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy9Ox_5DE3oSv2PcFoW-rD3fFDmSmwR5lxHiX7UgLhhw&oe=6A7B2393"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PVyuJ6uZsGIQ7kNvwHw1O3z&_nc_oc=Adpken64nOVn-GluWIX5KOdGNPfNU9DVQ2cn2nF-_PFOttai4K4U9JyoFsEamNFGsZs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEgrBDF099lk7-YjjX87cIhOyLyTwNWwUjxmcfaDCAMaQ&oe=6A7B2D23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PqcokfHubr0Q7kNvwHCx8-I&_nc_oc=Adqct4HuzUCTJmpyeYFsB_Jtxxpx6WEjTGb1RGoQUDYnOvzGeHK9IMlQZo_DUAixG4U&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFamFBwtJIFaAgDHh9qaGEXCV7VXJOzEBx7VLGs8RW81g&oe=6A7B0EBB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
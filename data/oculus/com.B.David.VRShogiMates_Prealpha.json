c_ss=7a30f&oh=00_Af1DDg1DTlMDYMfBPIupu25rFo6Oy2cdfzNE-248TbtSJg&oe=69E8B2BB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UTxyWzmEXGwQ7kNvwFXU3ih&_nc_oc=AdoHQt0sOuK4vObW56WYWmcnGlKg7c_hPxe8pK3i3WKDabYCyXl8ZXOX384rxkV5mlE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0bUkEZwYbINT5sJTJroFklc00L6r0a8MQx-t4cGCkFUA&oe=69E8AD21"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Hh0XencoQtgQ7kNvwE5p5KN&_nc_oc=AdoLmwqBwje5wb1Nv2JmGXS5oHuLkV9eisqjpQLrzq1aToe8G1zCDzEvuKXIoBuCZ_w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3j_1CoiwtQe8WI7ndK2XxyY77iR3nS3UBJB8CRnv7LJg&oe=69E8CD13"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xlO5ofxnC4QQ7kNvwEfPAHl&_nc_oc=Adp4JLXY2lUoVoy7NGuLKdDjc9lD2JMRe7neOHWt48f-zuYVRiabj1tl6_08gqb8qDI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2y-qYqXl-dVVG8X9OJeh3vPEHqm4tokno2OpODm23mWA&oe=69E8D6A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x_u_IBzIIxMQ7kNvwFrorsD&_nc_oc=Adrq9hsmWa6Epn9ghncjOv0hcTg3vbsUNgOVItgOMIFSi_4mnOzwON7Pl0KE6atRphQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3FoND1l2xxM1iUL78a2xNvwamLlnJ9hbt5CL1bGl4H4w&oe=69E8B83B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer
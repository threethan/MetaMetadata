dn.com&_nc_ss=7f20f&oh=00_Af_Js-ltL_S8MVx0DHNLtiSQfaJPIqEOBZKSyayYzs0lyA&oe=6A36B37B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FUQ56WMdvWgQ7kNvwFCJdn0&_nc_oc=AdoAVa8p8K-e6aeVgEpFHUte4nvshrkf7_Qf9_hwRYcpMKvGaaGu9D4B0586QfzRYTU&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9uUU2rREtwmaCgeTrCti4UfBmj6vD97-VGeaN9J0QZow&oe=6A36ADE1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=guHQUJNbbUsQ7kNvwH5RVEJ&_nc_oc=AdrzYoTSptz35QSsg1ZZXGu5rIyh475fse54cTNs-viW8z0ZCdBlKkheH4y73EdjA-k&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8yQTKGeUfAQAFSwndbnZsljvqPknGVtT43eVsgG1OJ-A&oe=6A369593"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IAzKx8s5KQQ7kNvwFsNtVC&_nc_oc=Adqw1atK3SZK-gcGcDvbts5AtTOtPveBkEpyJx5kT9BPVrxnnm4lIYzB9D2h33DM3Fg&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-ddWAd-5Ib_x4zhR7i5_zi1MLy0BmM1nCKOoXEg6SYGA&oe=6A369F23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8qBumfZptnoQ7kNvwEcjns1&_nc_oc=Adr9J3ai3zBGXf4hb-sHj3rkR7W9mNwI1kyeGvVP16An-J_m6CxqSqEzXfnNr07x5So&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8UeS82GPbs9nKhWDvRBrD6rF6-9YuhH2BDskiM0eaCKg&oe=6A36B8FB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": n
nc_ss=7f20f&oh=00_Af4ZZIKu2B3nTA-vTudxAtWF-URyH2pszNTkV_Ym6WJTLw&oe=6A1077FB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvY52UIDVAIQ7kNvwHoT0lM&_nc_oc=Adrn6sc1jNnyL6V7SkA33rX9PY92P0VX2hNproLWnVcUVGFOS2FriTNffl-rHcv-A9A&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5nDjTsw9qT4q3ePW4Iaxc_hsR_SeDC1NwZxNtzmmli3w&oe=6A107261"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aefEtI6C2fUQ7kNvwGxrG5x&_nc_oc=AdrNWmHA9tYholpE51-y7tx8_-WXVdBly4-JqVAeelqBk5yR-NjzdGblkRGniBTMGeA&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ClMrVa32E6kP23yKPaFN5lQqUJQfNzotFyMC8sL12ZA&oe=6A105A13"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eiv97dTJhEQ7kNvwEpk4UW&_nc_oc=Adoj-xSKpAwXhpg1506qEp4Dfzx4tF9RfaOeO6m8fSEes9jNGjQGLIEN6axuad6AQ8M&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af69-zzNPrNPhtBrkRhb7F5OpE4tlweLZbHa3YBit4YYvA&oe=6A1063A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLShAU98_ngQ7kNvwFCDWN3&_nc_oc=AdoYDkheNk7qbvx3NfpkSnmbq0G8O5VhxDYNEHqQ-ZWAeIImHN1xbJhURni0R0wnWeQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7X1SFzfoZEx70p91ckT2hkP-Zal2NfF5lBow049txyYg&oe=6A107D7B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
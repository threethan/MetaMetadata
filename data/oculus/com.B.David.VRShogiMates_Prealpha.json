.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-1qnMN-mW1Fehk3tSz8cdIiBrRh795p1xJzjnPr0PDw&oe=6A85953B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCp9nY0Dj9AQ7kNvwFy4Edq&_nc_oc=AdqdNYQ8rgmGpbujIpD9RbSwE1zld2ruPKvKgkesl1d1rFc3HHIgqQSKKWDCg8MyLZs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE8WmAlyBwP9bcJ5Mk1Ukangiz6sskP6KP5yGtBYJEv4A&oe=6A858FA1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=huZGwX3sNPMQ7kNvwER9CeE&_nc_oc=Ado_CdAcVK9wUoC8aB5t1e-mAXP1C7iBrXwlLqsiN6VO3C78D8tpGtp8puWck6RoVwU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG4K8dJ-djTQhmJACeAh_-TJJnvPb9BXqEUqUQP1jLD_g&oe=6A85AF93"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WcXce_NQSzsQ7kNvwFQKoSn&_nc_oc=AdrQsA26Wlg-IVZRQzmyr1IPdTL8KQ1rGf3fhPjFFgKVNnsN-zuqg7uPUZBfeQyeQdo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF8pMhUg2KBiw4w0yKU_QlECdfuHxONIz1h3K2at_Ry0A&oe=6A8580E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFBSPvoP-FAQ7kNvwEXnfGJ&_nc_oc=AdpKtCgjoyNL3I6yBjeW7-HJqq3xqo5UskHhnTisi1Yl7-uVK4R6CCuwAGWTgbgZPXw&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEwdh6dBOur8gmOn4FgyL-6emaw8f3SqxEuHCY2Vb5x-w&oe=6A859ABB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "develope
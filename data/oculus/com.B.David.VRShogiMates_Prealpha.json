.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGDP9lZg_SSQnSKdZHxOGg4AwlrFVzHXVWR1iVxGZeKug&oe=6A8D7E3B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX1jKhnqmFoQ7kNvwFPJZid&_nc_oc=AdoDFChAoevRVS8usMBKT6HMMcVnoxfTpajrrLAKz3ZGBaKY-3w62qe3qmlf_Qb4acU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFf0J3gdH_F0wURvzlP6VStke7RcJu_mTb3tJXi3_s_3Q&oe=6A8D78A1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-ogZghljdsQ7kNvwEfCaAA&_nc_oc=AdqOO3naME8frYSnCrzrtJX_ji-Dv0WsodAzuN6wFv_hOJk-BIb4zmj7KIbY66-muXM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGM2oh5VSc0I-djUn25om5sniMFppl_e0kW36lzoC_CA&oe=6A8D9893"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AR3lqufzvpUQ7kNvwFtJbRc&_nc_oc=AdrMfJZgX55j3x0iVrrvbQbjXbDrbHjqYuO56d_3dahiVLT3OfGIXprLHbo_QUWcQNs&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6qlvK4tGHJobMRGdXLXxXcbMkny4p4YftG8B93QXaVA&oe=6A8D69E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZvkMUUcc_0Q7kNvwEleZjd&_nc_oc=Adq-SOdofzf9blo2B14KB7yrcEK2a-3hASzX7MeX6bgRS-3hYa1satqhHoUj-z_o608&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH_xjGmfTdJuOU6ZUFYKzlfnaMrJ74Cqoecy8aveS0qWQ&oe=6A8D83BB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "develope
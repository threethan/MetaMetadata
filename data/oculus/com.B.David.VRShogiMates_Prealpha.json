nc_ss=7f20f&oh=00_Af738ny5n2hw2Cl2VkeDCuZETYMi_lvsQ597wXXyiUnShA&oe=6A1C557B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-gG-rB3JrvUQ7kNvwFDCkqE&_nc_oc=AdpdvYGu6Nx109YbH3yNhMP9lg74vW4MHndBieke4TP65hr7q1M0rWqN7qm-E8dm_7I&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7RrVsubel-O-Ff1-1unwIIm4-dDxkThBkVEBxNXr16Jg&oe=6A1C4FE1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bq0jmjVs40AQ7kNvwEIQTUz&_nc_oc=AdprJhKY9gBPjROyFCDe7BZyb3PUYU7_kHeo6l0ePv5H3NACEZsbeOyxiRQCa9etW6s&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4uMUI4bfGhbRb2lzISdWKR3cPgKQKKhorncrnJ7gJDGw&oe=6A1C3793"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=syyNqtLbm2QQ7kNvwHdN9Wf&_nc_oc=AdpiUPcf3Ra3wEIwQXepAcE-1d2xa38o-6MuwFHAH7wtGS10XoSnkmQ0EpKdPuBmeec&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68PHJX_LMb3yMtRXMntMJYNLxSw5OFFHQSlj-Gf8QLyQ&oe=6A1C4123"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jn1Mx2gYStQQ7kNvwFOtcHu&_nc_oc=AdosSSjCnLNWK5-16LfjYT5U84KGA8HccUUdbC-UB5tK1V0Ej38JNvtnt6T7ZDU8gcQ&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6IfZX0NMeANxd9fB7chMQq_qqcP59O2Rxh4lMpzFy23g&oe=6A1C5AFB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
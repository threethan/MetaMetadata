nc_ss=7f20f&oh=00_Af6-XR6unOXMIjPH1TRVC1Hj-eSkwMAq8rLCJhUg44az4w&oe=6A1860FB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ND5TtxYRLmMQ7kNvwGVilr6&_nc_oc=Adpl71BUQLM_MU_9WyU6l-2mpQ16C45ijspF9ggDdZ7MAoGsfs-tYXEd6xwsohcfh3A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4RbqAItfqNslVEFDzIgj8DPNsNRAkSk9u59lViDzpS_w&oe=6A185B61"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LXd6xdhX-bwQ7kNvwEUbo5n&_nc_oc=AdoRppSI3GfJZVwLU07rbhyRbVYLQQeaOCSDc3jXvFcWoXfOvYcep3becrP3yzAMxPw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uwpid2M-xOcbCj3te15g9yMMyhSfCRYXVWF9GeRuV-w&oe=6A184313"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=157NKEoUKzIQ7kNvwHvcfOH&_nc_oc=AdqJhUsPLl2jRKwToynJIqlitVsbm7YRw2VPAml1-DI5-8EfoQkuR2Sv5luYKylXW6M&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6XZzkCJ0bvDqVp3SfsbfSmoiBp29m2GodzbZ_Rx64TLQ&oe=6A184CA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTqw0Y_KWkUQ7kNvwEufV1g&_nc_oc=Adps8P5D2KGYIlQGVKLyoHzuA8KR9hn1AloYEoODbwaHHiQryKRkb4G5oQx13kAJFO0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5k0xOKmH0H-GP7T9024evln4VHf1M-MqEyE0q-L4hCbQ&oe=6A18667B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
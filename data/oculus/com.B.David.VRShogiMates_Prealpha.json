c_ss=7a30f&oh=00_Af1ekPPtG8pFGAryNRTAEsXJiovTnYmwTLdxd_MtYNG5IA&oe=69DA323B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJuwltukrNQQ7kNvwGKpTD4&_nc_oc=AdpRHDJ4lQGsHf7yOXyAkdDZFgZWq01Yp0JthKIAL4MR-QrOwb3Q8zfbYc3GVq-Mdsg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0PhJeHELeBsJVWsHPJZiP7P2maSNXp7n--uYiA2ysBmw&oe=69DA2CA1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE8vVck9QFQQ7kNvwFRIC4R&_nc_oc=AdpsTT6eJ76LOivutiMYqtgWgNTEyyXNQn3zmQGddCRNE_ns-Uk5QbsBKYZQgM2t4aw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2K039bsIZF5heHz4_SLHTI0fn37fu4xmwU0jHfaHGnNw&oe=69DA4C93"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjcUS-mvrVYQ7kNvwFjF4uk&_nc_oc=AdrqE_GfCVTRRIS1A8msJlh4QQn4dQzJhuy2GBlP6wSztMVqsnBipztBRupda_mnuOQ&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1nBNt2s1DSiqK3n-xiPlz5D29yGP8_HX-JPkwcbWUA3w&oe=69DA5623"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChzbBKp1MHgQ7kNvwHq0Axl&_nc_oc=Adrj0qpdbCxSpS1-zq_okjHgSbHT8mh6Qu1XxAykZWgXTkImu7RXP4SkTVCru_Kh6xk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3jzZbmljrFpP_hS8wK6ng_5MXQW7lXaLUieonutaLlhQ&oe=69DA37BB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer
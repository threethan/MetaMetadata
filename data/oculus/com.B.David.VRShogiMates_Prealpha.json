.com&_nc_ss=7f20f&oh=00_AQJwqhW8y-nKdCbvv0VOBV0CC3B0J-_Y42OQm_e9kQnoew&oe=6AB28125"}, {"file_name": "04 Background removed.png", "id": "295434423030492", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75250459_295434426363825_1133238189502684429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1d-8k-fbSigQ7kNvwHYzR0B&_nc_oc=Adr-oblux2Q57sYQ-IMOHkcDp1QE1ebruNYvVwS0cnR3jAZCz4-nw3Fb2vwMks6bOPs&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJTsh3mnHR-Du1_V5Mn8KCNlwYk-6qthJvWtb7Rw1x4Nw&oe=6AB29CE1"}]}, "id": "1757276535563704", "locale": "en_US", "screenshots": [{"file_name": "VRShogiMates Tsume challenge 1  (Black to mate in 13 moves)-2560x1440.png", "id": "1212274000044966", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982440_1212274003378299_6748105456435770728_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=AnRE0Imi1eIQ7kNvwFx2Xv5&_nc_oc=AdoWV2dielueukvjzgrve7M4ZGXkDj_AXN705hJcB7ka6DK-JdW-tlOqUBRp2G9egUk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKqncC9b3Uuw3dlF6MhOusiil3e8PaVJFJ7Csj7g4R5vA&oe=6AB2923C"}, {"file_name": "VRShogiMates02cropped.png", "id": "398942312562424", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/75404387_398942315895757_5737287799332143666_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6yCsGeu7YQQ7kNvwEnBpBH&_nc_oc=AdqE6KueHFZEGCoafyJ4VHjXwwEQmDwH8EHr7yS0NLtFmkIsQGb4ekM6Ho6w1lD5RZo&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKq0YQ0i3wBfFS4zVy23G12kd1BF3WjaUxuHdRqi2OGBA&oe=6AB2A07B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NF-7M-dRzaMQ7kNvwGfoyuK&_nc_oc=AdpL-FjP1X8fHRDIuJN412yymuz-IIK1BcL0pxHyCthW_IW9xQx1WyVfupLgPEEc7ac&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQI0lqYRmABT2hqnfICH597YD7vcdS2BJZXJI_Q6hrRp9Q&oe=6AB29AE1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iul3qXfSpeEQ7kNvwG45Feu&_nc_oc=AdpYDI4LTs2NfbpAFmRNDFRPjNKSqJUHDGIP-vzEazMTFPomf6Cc5KFmkhdmHOQA4ig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJS3JqPA07yqEER5KIARNjUTJH4f51Fb3xwQ0XENw8oLA&oe=6AB28293"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XEUW_OweNoEQ7kNvwFrWje1&_nc_oc=AdoXbVe3uBkUyZkQ2Xf3I-KPBOR0f_BLpo02Wy7Ok5qcdF9NrA-1kWOCgnF2wP8gI6g&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLn4FPzYblTDo7rhF9V6xNvNw8f7DHcMtJJ1G3bsajqWw&oe=6AB28C23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=i6ooluzbdBAQ7kNvwF5EI46&_nc_oc=AdpAvzci99zkuWkm85twtXKH7CJO-9ooMcbSt1FtfPH60gp59fLcuCgIJBI4k79fmnE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLxMpQZwXts4xroEfLVCQskEI_2W7VSUKbXDndUyCJEaw&oe=6AB2A5FB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSqXvliv35vQxAmBcivKWHTeZU6uYtvVl-AYDhYR_j2g0rZeRh3vWME8K8kepbFus4YikVBZ3adYVrt/pub", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogimates.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
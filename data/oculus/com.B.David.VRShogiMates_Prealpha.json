nc_ss=7f20f&oh=00_AQB1l3Du3DJkJ-zhKg9zuBfddDqfCAMhN6UMyw9CeYCP6w&oe=6A6CC0FB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1Wmwye0dJW8Q7kNvwEqKMrt&_nc_oc=Adqw1CaSqwczUL9pf3S4Z5uMbrQCbKU_Dm61Z-mveMIGkJHTZEmgsPORRcsS7j0utSM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAmmN-3UnhYjVZUFIj9DQmUo8nLBA0aVMi7TNquHlZsEA&oe=6A6CBB61"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j850EpxKoPMQ7kNvwFnVhPa&_nc_oc=Adq7-7Yhqda-SnEs8WXjuZfD6T5OBr0Koywe1hh2Adq0-dZBv-FwmiQUq3NzqoXCCBA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh4jBiMz6aTQwuY0Psm1Qkwjlnm7FDYSE0sY9hTLf7ig&oe=6A6CA313"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_ZElyhxSJFoQ7kNvwE4xoSA&_nc_oc=Adp-fwUYKO-Hsx07E2wmJkANth_nvK1m_GmrkJS7C2yuHFuw8Ijytd-avS88lpfG8G8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBp8_dSrudJPvWIjeMnj05oll75GqZARPQ7ytoyENCAeQ&oe=6A6CACA3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=W0F4m5zgvz4Q7kNvwG6N4SL&_nc_oc=AdrJJewjhxSpqTukj3k_eONlzJwbeTiwf9hU-YERiVap2AqZrE2C99WETb1MP1UYHig&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAp472UGPj5ZK718rlw9FftNTteTY19M3MkLJBWUCStcg&oe=6A6C8E3B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
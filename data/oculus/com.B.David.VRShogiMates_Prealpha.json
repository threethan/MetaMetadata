nt-ord5-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GczO0Y2FiIYQ7kNvwHibNou&_nc_oc=AdnDm1FgRnwHAhpP6PlcJd8YWW95AonCn8DzUjgFU8E6RbFmMoDJMBe-kHM4IEbEMWw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AftXcfoA1TA3QhWS5vRygeoCdRlUaFiiwWdO14KmV_MrZw&oe=69A41F21"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4T9opQ17QiUQ7kNvwHqfItI&_nc_oc=AdnhRotvz5Tl0w1uBfIfCxnHiFSD5IB37XTLKG0nnayvlkjneIXNLV7SUITDpkEjwvM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&oh=00_AfvRhyb1JUQwv-2TBiSZY78Eslp-8t9qyBtkBp_ADKeDEA&oe=69A43F13"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0FamIVfFFMoQ7kNvwGAEljw&_nc_oc=AdmfpvlRHnLp-QVHQlQsiQY7NPjiOhiIjeI6n80nP-n0vUGFCTyxPoTMGAN5sRpm844&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&oh=00_AfvYjc_aGoP_90z1Jdw1lHSEJLQhdmEvzJag6c8i-E3Y2w&oe=69A448A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHzssYuBCx8Q7kNvwHUS27B&_nc_oc=AdmZ8RKhJwUHwabxOKZB4HzscjywBtoC8FGhzBEjryhqZ0VFbByK0yo2jqEr7yY3KQA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&oh=00_Afsz4EqgvmDkUcrPpPxBX38JgOCCi6nn2pX9TREp2Zj6aQ&oe=69A42A3B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.websitepolicies.com/policies/view/a41733bc", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogi
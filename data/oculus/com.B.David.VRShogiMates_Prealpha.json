bku6Xvrd0tsqoTjTthK-zC8C8EpXqYQLYI9cXZ85ROT8BnjLrThh009F87P0tXo&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&oh=00_AfuvsOqdS7Rfrxdd_zBDntgkT8FReSEwkxWmfFeKP8qIEA&oe=69A5763B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GczO0Y2FiIYQ7kNvwFjjhf9&_nc_oc=AdksCd2DD49_inwJzbnlXabNyXuqH5KKFvBO1zTfhigOjgUXdNnoLG-C-fWa8d9aYtI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_AfvQ1S25jDXev6AnAX7rxoczsGb0e_BijJR_Bb-qXhut7Q&oe=69A570A1"}, {"file_name": "VRShogiMates04cropped.png", "id": "367552249204365", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031624_367552252537698_6058304213158592905_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8pE7DT3sKooQ7kNvwHMBtjy&_nc_oc=AdlGpVLaAyKbMnnPg_h0ZA791p1dLPeTx9cBKWLbHSBiCGH4k4Q5WE99w73Oj1Z_VWY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfvmzQ8k6bypyddWqPWbuZfNOVpZwwQFmORGtrVACW3gBQ&oe=69A59F25"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=piSUxIeoitwQ7kNvwGL9cWf&_nc_oc=Adn3mc_7Av2JBnjAQaZwmIfuzX36CTxTOopl3HewzMyqgtXdYzOe1Io1P1521v7GNmY&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&oh=00_Afum9W79oD4B-6QUQdUm1fUzExDXN81DLsItN59AZb7nvw&oe=69A59A23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uHzssYuBCx8Q7kNvwHcX85R&_nc_oc=AdkOAAnHb15ELpA9gWxmDBtB3LDICwnZjClkSWmp9X3Cv0SYb5GTwRfBuv5IbTA-_v4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&oh=00_AfuY4eJ6RbLDzw-AvbvOMqKlRT6pgEq_4SYVJrwQ2hXi0g&oe=69A57BBB"}, "display_name": "VRShogiMates", "keywords": [], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develop
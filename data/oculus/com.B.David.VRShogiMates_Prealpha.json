8YKL82F_vjA&oe=69BA8E3B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7NXdOnFT-P0Q7kNvwEBz2Rp&_nc_oc=Adk0Nafo53N8W6qIefK61JpGpuKfLkNXt4-6jzPL_WKYSZWjoZ8U-4XWefKcxwdqy3o&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfyXn2QfmSZPILDO_HXbMCBqH4VssrDK1p8Ugjjo3_eQqQ&oe=69BA88A1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ixQ5bAW5BcIQ7kNvwFQsKWc&_nc_oc=AdkYDQ1UvNMsLpFykE0r00pwtczRkgcI_hwdxjq3jw726x_1rX2AnXmPsgyMHOIBznI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_AfxDjHJl2u55Zr-mBqj3uBDixUNDV3KVw-Grl2ABltx5ng&oe=69BAA893"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NnogqsTr_hQQ7kNvwF2Uvq7&_nc_oc=AdlCL3bHkIei5a-kBl4Zi08DoGwoRxh0N5vusdkRqJqMTVNtY5ZWDkJI8yjWvwKgu7s&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=8&oh=00_Afz9ksxb3EkyNCAx6JFkPlbfcEs5k9bxElPuPSZeIwM4oA&oe=69BAB223"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MjCVTMxSKkUQ7kNvwGQCsbx&_nc_oc=AdloMzAWBSa9lKJ-QNfPXFv79HcEGZpSIAHLNbmt3jd6hXKH5iRUbHR9otVAdS8ug8Q&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=8&oh=00_Afxa4tUtzmjiYlO_uobjwys4RE63SefhMIgPCWIyDKYP5Q&oe=69BA93BB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.websitepolicies.com/policies/view
c_ss=7a30f&oh=00_Af3APFSKtj0mP9Oxy3Mdoo61-ZYpdXcjV_g4RXF_qtGhBA&oe=69D8E0BB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlFq_eXTX5YQ7kNvwE_peEf&_nc_oc=AdojVi_jb8dRVFkZnQ58qCVi6YI49NFo8glp25fQF1zbFLMYUx-CiZPQN6X9K-mIecI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2TRSuHY9p1jNgpXvNQkHP0_XhgMy8X48N8B21gCYoddQ&oe=69D8DB21"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JE8vVck9QFQQ7kNvwHQL2tA&_nc_oc=AdqjtnJmifL-DC6FU-qO3LkyoXUfSOpNl9xj_w5H42qyMGj2aK9bGy56g7sXf4PdAoM&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af11y6G-ABaBpXUY2bx4ES71CYsXCyUbS2w_Jah3CcQbJA&oe=69D8FB13"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FjcUS-mvrVYQ7kNvwEIQddx&_nc_oc=AdoW0G5N0opa8hRl8p1PMhUHaubvdVYsueKKGtcOaBDozkt0Acs37l9xh0AXKzdin-w&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2gg6W_4jZIaE_HJOCU-_0IhNtyjmMHae6V8U3pTSJQAw&oe=69D904A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ChzbBKp1MHgQ7kNvwF3qZGF&_nc_oc=Adr7hAjt59psLwjBNgSrWnYID4USfQ4pbVFKeW3SWj5dDIRJNcmJZNZGWFBSb1e8Zy0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1FutCSDM-SdbjxHhtHlsQLCc7XmJRdEyyCa68UFe5DpQ&oe=69D8E63B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer
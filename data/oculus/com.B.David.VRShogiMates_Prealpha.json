.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFGuzwFrxULyQ0j_TIb48wbDgDpJ-C_22Gxq1C88o7f4w&oe=6A8ECFBB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zX1jKhnqmFoQ7kNvwESShBp&_nc_oc=Adomsu9Eck9nYRziLORC55GaGcA1bXECilsEfzlxb_mVpa_UPGoVQEIZ91rEEXKvGpY&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFX8tPM8o3_aDJbNUNZuQv4jTWj7kO-Mv6zkIdfXCA_Cg&oe=6A8ECA21"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3-ogZghljdsQ7kNvwFMvl8X&_nc_oc=AdoqWMGr5iH9Z_NqBoLbbpgCcaaf5tMzl7gfD6Je0oVpI3j94PfkW0KvYGwVAMGfP4I&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHGmNOOs118am2IFWq8aq-AtuGlC2lWQAw1BpTTbrQpZg&oe=6A8EEA13"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MEzMjBcAaNcQ7kNvwE0zsro&_nc_oc=Adoow88Z1DAiw463DNI7oXtkB15CMKQWnwtJz6bYz7vLM3OXKShVUA8gOEBYEVOkbNM&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGROpgZZXr2Qlx8n9dhW-RVIj1c1x3AWvPCDKZ3p86MeQ&oe=6A8EBB63"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SZvkMUUcc_0Q7kNvwH0EDuO&_nc_oc=AdrXOURK4Ftq5ndeqeDtCEEshi_YigAopdviGXFVmJbhdhoh_vdnTagDIPsHo7PJZAo&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGy7LV3cepOs1xb5qpBFT7XsYhbgpXtCI07-yi5uRV2zg&oe=6A8ED53B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "develope
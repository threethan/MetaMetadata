c_ss=7a30f&oh=00_Af3IQV-f0NJKFPNjMqFc9POh_xASJovU6itUikoulG2QCg&oe=69D4EC3B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UWPmjVv2he0Q7kNvwEj4Mm1&_nc_oc=Adosr_fhRgRWunarnnqrMBdye8WPF7T-741sj2UfJIBKYNpH9bQ8REQRQ2Mr2lF0g7Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0mqWQUKfyr6XOtyssb20KLv5c2Y1C3bb6jj876HgawSQ&oe=69D4E6A1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JPFU-vqst24Q7kNvwEWEVMj&_nc_oc=Adq51Om0-NZsdvCpuF0BEqN-1npHHYS8phfRzbrGNKH2jUlNbP2ePLAjrdlJDaiWjw0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TxnnczGdetxdZRS5Cw9HMWcVr85_-btRgx1f1oTTIZA&oe=69D50693"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bIR-poZggqMQ7kNvwFq7mXL&_nc_oc=AdoVwkxhHOvH4LDDtbK9hojot0VC4Vd0dmAeCwm2xp89K0GLEnjs9NRT9VJR3Yvidug&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0vCmstZxiveqZ2-9cjujbnxBKFi-kmIwt7PCIpG8WgQA&oe=69D51023"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NIHc5pb268wQ7kNvwGa4zJO&_nc_oc=Ado91ejpTpN-UszLKfIe8-WXjAxJSgT7H80bKXYrzxxv-V_pZG_64kQRVR4RwX8VFX8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2BHWiB-jMAFFnrtPIveVL627EuS1QRU4pCZp3tmN__6g&oe=69D4F1BB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer
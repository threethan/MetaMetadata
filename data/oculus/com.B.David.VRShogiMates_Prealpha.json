nc_ss=7f20f&oh=00_AQFMVZ27G1T2v6tb6bVov5SnNiuPl_zazz0IXflhcewk8g&oe=6A95D7BB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdptZzS8KvoQ7kNvwHxlNnF&_nc_oc=Adr1ZuXlFvEWvG-9xuLecK72g99o42oLk4t0wkPtdSDr6JlRx35rf9_M8wutf6S9Vus&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3HbDp1HWFQK8xyskpFXpA5fyQlPYQ854Ra7yo3NFwaw&oe=6A95D221"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3XqPlSFkDSsQ7kNvwHDokiw&_nc_oc=AdqpdZpOEy1dzYfyFHIppe1n_D3SYdXULKqisbvf--9qMESDN61R15EKXsFSXfoMeI0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkYj_mxt4AxovfBpCVos62Eb43cy6QW0WkbJcsKg6T-Q&oe=6A95B9D3"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7oB94sZJZgQ7kNvwEMPPpT&_nc_oc=AdrcWRZ14jDzLVi6THz8_vhfkARpoLmNa8qy4wk4J5nsN-kjVRWT81U0s-UXuGdSxck&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF5bubLNtzTF9TmYdrhlIZL0qYuLcbFNEZGmuORxapJBw&oe=6A95C363"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JQ8fzCiV9mkQ7kNvwEJyPvp&_nc_oc=Adr0-Bw7bQFZH3YVIo-0JljXCs9ibzb9aXb-FZuW0C3cMSJoOSyTHZoxQ7t0PmkV2Qc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEMebu8gfjRGWZpOL_aNI1f6LrJFeMIaAhqAF2LS8gBAA&oe=6A95DD3B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
.com&_nc_ss=7f20f&oh=00_AQNcSj_RRnSjMKNHPZ_Ms5ZcF8LcXwMtcFvEXfE9ZTGaYQ&oe=6AE49A25"}, {"file_name": "04 Background removed.png", "id": "295434423030492", "image_type": "APP_IMG_LOGO_TRANSPARENT", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75250459_295434426363825_1133238189502684429_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Mf0CuaN2U4QQ7kNvwHkX0y9&_nc_oc=AdrLEAxKp-FSutbptkOz36k7qw8ORi0NIiCvsyZkQPzvClTY4mVxr19F-BWq_4CpnAk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMA9Y9OPJa1IJSWeVUXNLXBLOW1BDLNXDbtQH3TSQMquA&oe=6AE4B5E1"}]}, "id": "1757276535563704", "locale": "en_US", "screenshots": [{"file_name": "VRShogiMates Tsume challenge 1  (Black to mate in 13 moves)-2560x1440.png", "id": "1212274000044966", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/38982440_1212274003378299_6748105456435770728_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TSI9nD2_kr8Q7kNvwF1xD4I&_nc_oc=AdpMOy3QNSXI8w185aA5dOMJ7vbLv6bXRdOO_4zXg-khwNNu0iafqjLo4pf4clDRrXQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNXTu6hIdZ_IxHOds05FCY0-TNkQDkqYilYL_MfjNQKRA&oe=6AE4AB3C"}, {"file_name": "VRShogiMates02cropped.png", "id": "398942312562424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404387_398942315895757_5737287799332143666_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0tkU_WWTVKAQ7kNvwEdpePh&_nc_oc=Adr4Uf8nci0jApu1ilDO6AGkw6aW30ZSZnAmJo123SnFVv2rW2Vm2GDnZ1z8KHudoww&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnNgiJamHMX1yEz8sgEdIJqxKh6GsTk-gx4xrSNooucw&oe=6AE4B97B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fk5vKxKc7vAQ7kNvwHqX6iV&_nc_oc=AdrNjSdrks8xO-wKjBqupXhTLMldG3uXKaMKfDujB63IRu5_yYUxFLTBeTUyJ8WPPvA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP0lLYZ3VuF_aMnjIqCeF0tx9ijm9tT6sSl1hRpe2EEJw&oe=6AE4B3E1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=T1x6wD4IxScQ7kNvwEtm2dd&_nc_oc=AdpGtG7416bDZHF-3M-iPvKK_NeOnfa3XN9_Pa6o5jAtVuUQmlnhxFzXJh-eEzzlYzg&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOL8uFQ79Wu4IJl68beIld8ZS9JRRrVHGmjAu6wcWfEEA&oe=6AE49B93"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QJeH34C2PoUQ7kNvwE4hV93&_nc_oc=AdroHTAzNqwltyxUyL1cxarPv49vkUG_FJEFsh1Jg8ugsq7Qe9hCpfQsKApVE3OVBYU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5NbyF9G7VGdaWkRbvrPlClVzmI27FNI_GlMayHg7WzA&oe=6AE4A523"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pjwCOVkiaKAQ7kNvwHLnBGz&_nc_oc=AdpMS8x_IKI2VqBqvJHe6860Y3djTxsENvZFQWGHUb1FXPZNzn7fHVi_6GQ69lqTbcA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNtLpjHtJf-COu4sQV3jDTCU0ZB8n9VmiNbRcgjY-5RnA&oe=6AE4BEFB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vSqXvliv35vQxAmBcivKWHTeZU6uYtvVl-AYDhYR_j2g0rZeRh3vWME8K8kepbFus4YikVBZ3adYVrt/pub", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogimates.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": 
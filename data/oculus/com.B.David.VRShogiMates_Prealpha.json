&_nc_ss=7f20f&oh=00_AQIuX0z3VPbXJBvt1jWv_lv_eX9a_15xGrO5gRgYzoD_fQ&oe=6AA2A6CF"}, {"file_name": "VRShogiMates02cropped.png", "id": "398942312562424", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75404387_398942315895757_5737287799332143666_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PSfW4bPYaxEQ7kNvwF-ULCs&_nc_oc=AdrNf6YXj4B6YeDtRfumU9-jd56B1AePttgV1hBWYlwJTLu3aHUJ4axv5q1fmr5l9GI&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK_39C5BMOqe3uZHppD0_hyBroBp5Gnfj5vUxnU1x7_Jg&oe=6AA2CE7B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iptPKHr_hucQ7kNvwGpx_d8&_nc_oc=Adp-3IY8IQe_LrFMrCW3nCOefk2CDZb-Md1MaoTpJeqqKHv4eS4iQ5Fu3x4TjeuqVmI&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQL-d4zBaGS5OagRy1Is6FN9_iskbMeG_yD4DUhfFVGVWg&oe=6AA2C8E1"}, {"file_name": "VRShogiMates04cropped.png", "id": "367552249204365", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/39031624_367552252537698_6058304213158592905_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U1NDhxC3QJAQ7kNvwFrfMye&_nc_oc=AdpIq7Z41OvLuDiD3KsryhOZc9fwx4jZ_3ucOsrNEfRD-TQlJhlvOLEwnyftKiZrAc4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJZba1iyoAg8DL-0-Y3njm7TnjSOD5LuLtPFv4Y2_QQgw&oe=6AA2BF25"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NmPUc91Cf4gQ7kNvwHrjdKL&_nc_oc=AdplOIww9oC3YYsSMnzFfkVhdrSTJeH3hIdzimklYuYgwPoTrIngTOS7dCYwL7M7M0w&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQInjVxP3PdrkjBTS0MBrKz2lzxL7cvZ5ZD7vZjm_Ouzyg&oe=6AA2BA23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xj2wZWOlM9wQ7kNvwE7ePZ_&_nc_oc=AdqNAvTwpMOnX1JIy6HxPYDXmci_Cz9-d0JsRUNniuaxfZvHRbHjMaZCwUidO7-YLKA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDkDTtl3HQp8W9i482YRQK4K4wGW-f-ILqB0HhhJiG0Q&oe=6AA2D3FB"}, "display_name": "VRShogiMates", "keywords": [], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.websitepolicies.com/policies/view/a41733bc", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogimates.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7281388235284231"}}]}, "scheduled_offers": {"count": 13, "nodes": [{"status": "PUBLISHED", "id": "1045448411592875"}, {"status": "PUBLISHED", "id": "28336169246006944"}, {"status": "PUBLISHED", "id": "2031591240780800"}, {"status": "PUBLISHED", "id": "1309666514563636"}, {"status": "PUBLISHED", "id": "2425750037896841"}, {"status": "PUBLISHED", "id": "1210605897649031"}, {"status": "PUBLISHED", "id": "1399416624484094"}, {"status": "PUBLISHED", "id": "1879046082947345"}, {"status": "PUBLISHED", "id": "1417091573029619"}, {"status": "PUBLISHED", "id": "865177719103341"}, {"status": "PUBLISHED", "id": "8539910886030335"}, {"status": "PUBLISHED", "i
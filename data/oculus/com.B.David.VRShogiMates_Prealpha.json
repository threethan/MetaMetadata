nc_ss=7f20f&oh=00_AQBhdazbTijrUFG9nsGz7CUmBpnOz2QfsGieEzXc5-LBTg&oe=6A537C3B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MuBXhzGSqtQQ7kNvwGBceMy&_nc_oc=Adqqq1mbzLDGXRytHkYIlxFvAFcAwkPYMr3iQKJzbKl7NJSMlrkEWabcPgstRhZUhnE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDTo7axIsP5fFeSxS8OCEDo8_oZl-kk6-uF8BJd6XWu2Q&oe=6A53AEE1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RDdm1laAJQ0Q7kNvwFmdgPc&_nc_oc=Adrv7HQf8oBFw82B8yazgqI7_UuckXSx1Z-HCpxQNYKozg1IeHSNVBv_wUw7OzDz7Qs&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAobfaHwnAnsim-C6uRBTYl-ybFDrue-Trr2HtvdcHm5A&oe=6A539693"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2K1Zv6hyDvkQ7kNvwE2nQR1&_nc_oc=Adp047p8hS5fpCPrCBmyI3YEcbF0WDHUEMFSHZFpYQfM7_8FmPsKY3PQEJ7l7Jol7Zk&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBQXj2CuH4XtXMvrJeVYUcIdWiXA4Wds5x6AYJOhOcsVQ&oe=6A53A023"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jnhbyatQBeMQ7kNvwGjXi9B&_nc_oc=AdozqVl5P37Ky-dQgPAa0YkQt-iGv_JB4paYGq-s_GAvem-P95DR8SQ-yHTYi3rg0Gc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGUwENYlVQOG1apMzUqgDMqtFHuudUYhB1vtwOh1o-jg&oe=6A5381BB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
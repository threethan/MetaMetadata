nc_ss=7f20f&oh=00_Af6l84FhoCO38txgNCbG8rj5YsVOcuYWPLLy-Xb_BbByrQ&oe=6A09E07B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lVHHeIDq12AQ7kNvwEih1Nn&_nc_oc=AdohfkSdNVFoQkgwRNePOcl-z4PEO1IVPcZ2sSc6fxN7cMN-x6j4mK3WSlriJ-RdPX0&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7T627MuUvP7mxDXRaWqA3EX3O4KTv1rARnxXojlElcqQ&oe=6A09DAE1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uVTtRpEp3CIQ7kNvwGqkGO3&_nc_oc=Adrm0OkP-o82B03AISzeWa9GspktfJ83ryT1ehXi1V5g-myDsL79Jh5d8ttVZ2jXcYE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6pJQRu3FxrZVMrEsh2q49kQ-tm665pyQIwjI9jCiFU_Q&oe=6A09C293"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mevIBZJWPMwQ7kNvwGGm3bO&_nc_oc=Adpem8iEHwStq6VSaf-Zb5Q4GSCbrpvxMZMEzVhVEpOsKz73bh6WzFEZuBRR0DbvMCc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6WNx3_B6wNK-iS2e2W_3pzs0DHOttCs5DZXbsrJKQoxQ&oe=6A09CC23"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SY9PFx0dFfYQ7kNvwH8CpK5&_nc_oc=Adq-sIgEfKeSlxsxssmCX1n_gmmbIVJsa9qmguisdsQbo_ZshQE1nSzyPpRVaSQksps&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5qIR3Z3E3tdIGeM81cAttlGjjPiJ179_vw2S0wzaCLLA&oe=6A09ADBB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
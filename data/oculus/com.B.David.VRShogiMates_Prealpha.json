&_nc_ss=7f20f&oh=00_AQFw2TxhJIJonFzGfCvSMLd9CLUZvP2sLdoknRFYHYTCog&oe=6A8848CF"}, {"file_name": "VRShogiMates02cropped.png", "id": "398942312562424", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75404387_398942315895757_5737287799332143666_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iQs2Vw2Wf0oQ7kNvwEV1dC3&_nc_oc=AdrXRAZL9X_3uoj0QWtYU7gdqxn-nhyl1A1Tx4M0LzFa_CFO2GpPKf8un_cZ_gQVkqE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEQS5933-PjWOInNnrk27onHVw571HqL2B4M832e8E5Q&oe=6A88383B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-fra3-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=08krS3EG96YQ7kNvwEseLVH&_nc_oc=AdoCqxJj1GkKIpdvlfnOrnosFx8B5ABfScutj6vkDeSlZ3fK59YvrXGbzRkevazTF9Q&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFfedjxkdIwQilKfLgvPxrdNo64Qm5j-g63uitLLb29hw&oe=6A8832A1"}, {"file_name": "VRShogiMates04cropped.png", "id": "367552249204365", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/39031624_367552252537698_6058304213158592905_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0mwDWs3qgjwQ7kNvwG2yND9&_nc_oc=AdqoHpqkRxIl5PC3K8ZhmuJNwtfDMvct-w_Ue-APTVMO56eLQ30FscNofnEuxsww1wc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGVd9C6IuoWlwbTn0Zzb1bnVHBEL03H2-1KQZPbOSnAdg&oe=6A8828E5"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M4ru7DQkz_gQ7kNvwERWjVH&_nc_oc=AdrHRtoL9IvELW_tbbqQ2vbc4o8YiZcWPX_0Wo2g4QQ1dN28oCa0eVrcNNUDmQnY2wY&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGcFPLHLpClShIwsBOV-aeKKygzqfAsBppgeA5qCsQi5Q&oe=6A8823E3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mFBSPvoP-FAQ7kNvwFV3Wj3&_nc_oc=AdpMV6ABvrAW9_zDfY1b0j72F5cr9P8Jh2qPbPS83NwJEMV6Bv-l6ayvxI3hFbQzxOU&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEH5Mjorpij77GHVWq9ts7zIYtNgqbjhHV0-UxqOy4Olg&oe=6A883DBB"}, "display_name": "VRShogiMates", "keywords": [], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://app.websitepolicies.com/policies/view/a41733bc", "developer_terms_of_service_url": null, "publisher_name": "David Laszlo Banfai", "support_website_url": null, "website_url": "https://vrshogimates.wixsite.com/home", "category": "GAMES", "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1676485315806614"}], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "STRATEGY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER", "SINGLE_USER"], "id": "7281388235284231"}}]}, "scheduled_offers": {"count": 11, "nodes": [{"status": "PUBLISHED", "id": "2031591240780800"}, {"status": "PUBLISHED", "id": "1309666514563636"}, {"status": "PUBLISHED", "id": "2425750037896841"}, {"status": "PUBLISHED", "id": "1210605897649031"}, {"status": "PUBLISHED", "id": "1399416624484094"}, {"status": "PUBLISHED", "id": "1879046082947345"}, {"status": "PUBLISHED", "id": "1417091573029619"}, {"status": "PUBLISHED", "id": "865177719103341"}, {"status": "PUBLISHED", "id": "8539910886030335"}, {"status": "PUBLISHED", "id": "407905571594429"}, {"status": "PUBLISHED", "id": "1091349662049190"}]}, "baseline_offer": {"id": "
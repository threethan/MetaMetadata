c_ss=7a30f&oh=00_AfxukLP7ITICj0BPM_7fSzKGaHQ-OB5rf8QJOHGVVJPeeQ&oe=69CE54BB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juk9nP44TB0Q7kNvwFxJV08&_nc_oc=AdpTH3YpAttCyRHg3V0NhG0Uo9Duw3soEDeYFW6dbUqQ_Z8ZuGk0JuufR0YzAkXj3Jc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzcGmiYTedp0Gmr_8URhC01XvW_6zuHkV4-zAUpr5Z3pw&oe=69CE4F21"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JsWwdCA5QgIQ7kNvwEToG2F&_nc_oc=AdoCZFG9dm0wUElAD7kqebp00gDcwqNXl-WvrNZjEDMtZBNz6AsoZQhAMZd3EqUTUho&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzludlBgPSbsZdUo5vbsx517KttWxDdJv1Yy3CN0JyDMQ&oe=69CE6F13"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FI0Fu-Da4MMQ7kNvwEijAwf&_nc_oc=AdrkG-ivMEhOy57L0ASlyl96UxKcvlKAG6qb7XbZmT5CjSTd-9GZ-3lzdHeNmwA9pNE&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfxOr7ew_tGebUVhgJY9TKW-LKKv4RoG2AVSuR2guivS-A&oe=69CE78A3"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=YkzZfR0nHPAQ7kNvwGROFTM&_nc_oc=Adrg-b_SDiRjgP0iAgae178etDewBeYDI-QQLuM1CC8LNj5KUoiiT80AM_WNyg1i51I&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKBg37zDTvDsI4cj78inj3tP4T_z3Aj60Rs3X6TlSbLA&oe=69CE5A3B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "developer
nc_ss=7f20f&oh=00_AQGHTuEF_A3y5CHYTwR8nZtp5O25-s0cr6a_CKYKgmvcMw&oe=6A9415BB"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BdptZzS8KvoQ7kNvwGBXJov&_nc_oc=AdrcvuciwDIvmXimN36gCH4UBXkk5gpxTe4JmjDGO5X24CqLrhWQkzQC1AzchkbXQTY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE3KNm-fhXM-hbaP4lCWwT0yyhcFMvOBKRcfcZuiXSNDw&oe=6A941021"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TLqeUcqBS0gQ7kNvwHassI1&_nc_oc=AdpvtFgR7egk6tYRQt3Ju1fjnSsmBB_JTDs3uiCfULBOfhjOgyJGwicpz4QDNcG6WAo&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHVw4VRSWFHSt37h1XXLyr7XMM0iez71dnJ1QXmCAPztA&oe=6A943013"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-qro1-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y7oB94sZJZgQ7kNvwHxEKEp&_nc_oc=Adqf-xtcQBxfk6RyCVtd8aeN_wPJi7ATMYiOyIN2xBkTkYr5w7Qis32REy9u4PX-Zi8&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEs5Ooiiho1-mYRJXyhdPMTOjpbfct7j7mmzXg83fSzpw&oe=6A940163"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e1S-VxG0faUQ7kNvwFsCx2f&_nc_oc=AdqxF4kc0tjHDZ54lZKAH3p9vBm-OUCFSdIjQChAI2guA2KWfvB_ZmMokC7IXz4gfSY&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE0daGa7XSyBOpzTHpV8A-Er_gSHcDUNefa6voGgAy3Zw&oe=6A941B3B"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
nc_ss=7f20f&oh=00_AQDlxGFOFpBgY-VvY0YK_j1CUvhdGfAaXA88xhuGNDgAMg&oe=6A65F13B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P7vKHVo3Q4UQ7kNvwGjjfDb&_nc_oc=Adqxhy1LqIvaVxJEucoM3TDCIaIrTvtrnjjudDRPe1UuRaZPnb1EoMRrQ5kP2XJYyfs&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD9CPmf33qINKrEQieBABpznJJhNm1P_Or9Ox5z1B7-Fg&oe=6A6623E1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jwiTiiF6ZLMQ7kNvwGVM6Gl&_nc_oc=AdrxDOIJh0xWPFuSiZ8A9rkRyne0j3y4_8O0O0EXRRioSKIEgAjroEvCT98MNIwawz0&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA5wcLxOo3MD7BKwjuvKjuu0LYU_DvqAMt6VEKqHwFmqA&oe=6A660B93"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=b2KYuov1vw4Q7kNvwGN9I3m&_nc_oc=Ado9KbunKdw8iCP5IX7AgVfkFxpLUER7ABxJdFA4FeWBmlUXYST31u-42ukSAhVCRPY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQASwlscsV5hJrhB9GyDxPeXYWxs2M1D7WC6q81xajdK1Q&oe=6A661523"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ti8eZbqeKlIQ7kNvwH0AG1p&_nc_oc=AdrC8J2WCBSg3Gr10If4WUQEt8S0y0aHQFF8hQldmADirWJ0RUAarjO5YZ3Rjx4qXNg&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAwZJn62-vC6-EKAxZmd1v_qrl_ukT82mqcX7MJ18QIiw&oe=6A65F6BB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": null, "develope
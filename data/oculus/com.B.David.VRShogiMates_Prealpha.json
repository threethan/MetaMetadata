dn.com&_nc_ss=7f20f&oh=00_Af4-_BrOkrheBad8vFEkgDioMW1A6szz06XGSBYWIBCY7g&oe=6A11C97B"}, {"file_name": "VRShogiMates03cropped.png", "id": "337914812432265", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974774_337914815765598_1762840369253842605_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RVEO94f43zoQ7kNvwFex_rF&_nc_oc=AdocTuKYZPi_5zkEA9FCD7ndss85c91RTIZMQkszvcDv-xm6eRtOj6v8lvZqPxyOjGA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af68Vtr0eQdzd3_i3Fr3n1o4IL73nUaueE5iLfDikSrUJQ&oe=6A11C3E1"}, {"file_name": "Gungi 2-2560x1440.png", "id": "1113992063485287", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/38974497_1113992066818620_843721057957030660_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aefEtI6C2fUQ7kNvwHPeMeM&_nc_oc=AdqyQAyMDqvFzR6W_b2C-Yz98fkotXVl3-1Am3r_0GdrKa98sn9AdxQgFhyc3ErzTD8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5RwNRT-VN8OIKGhDlWtIlkx_J2-7PxmJpNAtzP25IzrA&oe=6A11AB93"}, {"file_name": "Chess cropped.png", "id": "902765531159168", "uri": "https://scontent-sin11-1.oculuscdn.com/v/t64.5771-25/38984463_902765534492501_3956653358745274292_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5eiv97dTJhEQ7kNvwHpo4DG&_nc_oc=AdoweHlSvpW2Svx6uEaEvQPLQirM9i63fUOTHMCWbn7us1NE09xwbTkYNtRCpVwciYQ&_nc_zt=3&_nc_ht=scontent-sin11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6PJS6zXLX-9CW82Ze-ydlqwBUHP20KCvPRFh6nv4GgmQ&oe=6A11B523"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "TrailerScreenshot cropped.png", "id": "717849803637730", "uri": "https://scontent-sin2-3.oculuscdn.com/v/t64.5771-25/38982545_717849806971063_8753740338935084738_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nLShAU98_ngQ7kNvwEt70bs&_nc_oc=AdqsGhCvAgKZkOXXuVapuOydNdN9cOa1yloFEefvGWyaSkyvuQW_VeLaBm0IZOPlbZM&_nc_zt=3&_nc_ht=scontent-sin2-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wttEoUqOT3q6AjWrx3D0ZBWaFpnq_GrH-nFyXRwBrgQ&oe=6A11CEFB"}, "display_name": "VRShogiMates", "keywords": ["shogi", "chess", "xiangqi", "chushogi", "gungi"], "long_description": "Welcome to VRShogiMates, your gateway to a captivating virtual realm of classic board games! As a solo developer's passion project, this app delivers an unparalleled experience featuring Shogi, Chu Shogi, Chess, Xiangqi, and the unique Gungi from Hunter X Hunter.\n\nMultiplayer Mode:\nChallenge opponents worldwide in real-time or correspondence matches. Whether facing friends or discovering new adversaries, the global multiplayer functionality ensures a dynamic and engaging experience.\n\nHow to play:\nNew to these intricate games? No problem! VRShogiMates provides comprehensive rules, instructions, and a game record for each game type to help you learn. Explore the rules, grasp essential strategies, and elevate your skills!\n\nRegular Updates and Support:\nMy commitment doesn't end at launch. Expect continuous updates, bug fixes, performance enhancements, and exciting new features driven by valuable feedback from us.\n\nUnique Highlights:\nVenture into the unexplored VR realms of Shogi, Chu Shogi, Xiangqi, and Gungi - experiences currently not offered by any other VR app on the market! The last game type, Gungi, brings a touch of fantasy to your gaming repertoire. It\u2019s refreshingly different from other board games, check it out!\n\nEmbark on this virtual journey, where tradition meets innovation, and every move is a step towards victory. VRShogiMates is not just a game; it's a portal to a world where strategy, competition, and community converge. Join us and redefine your board gaming experience!", "short_description": "Dive into the immersive world of board games with VRShogiMates! Play Shogi, Chu Shogi, Chess, Xiangqi, and Gungi in a stunning virtual environment. Challenge friends globally in real-time or turn-based multiplayer. Learn the rules for all the games, while enjoying regular updates for an ever-evolving gaming experience.\n\nInternet connection is required to play. (For now)\n"}]}, "developer_name": n
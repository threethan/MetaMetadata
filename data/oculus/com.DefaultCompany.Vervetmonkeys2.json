.com&_nc_ss=7f20f&oh=00_Af8Gdxn0IynyMr_kMI15ywRVoA5QCa9nyKQvvLBzYPV_0w&oe=6A2833C6"}, {"file_name": "er.png", "id": "578947598508035", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_578947605174701_8165189107151339219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LZ7T9YaYu5gQ7kNvwEUQgXf&_nc_oc=Adqcxj0VJLBJRujuwtwsvC_iH9nUNKevwDrAZ1DiQev19EA54yVZkHLppl814Jhyg1Q&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9PkDYtjeSJ0gJN4ZXeE1_aV2U1bi6DUBcEjbowQxw8wg&oe=6A2837DC"}, {"file_name": "dd.png", "id": "989803546466227", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394077_989803549799560_3062548092914019176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hTaw6pLn6tMQ7kNvwHz4J18&_nc_oc=Ado8b2ClZqMHYslGOP8cPcRwc-vKvplOEC6pkAW3FVvBZk41OjhxtuqASC1-rmAskAY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9Gfb33apE1FemJu0Hovbo7R3mEzppZguoMDzM3I1pj5Q&oe=6A282F9F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vervet monkeys", "keywords": [], "long_description": "Vervet Monkeys is a Gorilla Tag fan game that brings players into a vibrant world of fast-paced movement, social interaction, and exciting gameplay. In this immersive VR experience, players take on the role of agile vervet monkeys, using their hands to climb, jump, and swing through dynamic environments.\n\nDesigned as a fun and engaging hangout game, Vervet Monkeys encourages freedom of movement and creativity. Whether you\u2019re chasing friends in thrilling tag-based modes, exploring unique maps, or simply socializing in a relaxed setting, the game offers an energetic and interactive experience. With its fluid locomotion system and welcoming community, Vervet Monkeys captures the spirit of Gorilla Tag while introducing its own unique charm and features.", "short_description": "Vervet Monkeys is a Gorilla Tag fan game where players take on the role of agile monkeys, climbing, jumping, and swinging through immersive environments. It\u2019s a fun and fast-paced hangout game focused on movement, social interaction, and exciting tag-based gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRTHmDVFR9_KUUcZA3NaJmy2ak45_LVJ8DqP8qaR8jtFu1Of_OfMG9VS7FtjPaUoSRhac94V5WraK_9/pub", "developer_terms_of_service_url": null, "publisher_name": "Crazy toast", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vS4WNrJwa_4E272yH-45XKSnun8Dz1eOu74NLR6wQjBSQh11da2RGH5xCOEYXKN7zm6JGkQ_wGyVW95/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9276595189089785"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "967238328808448"}]}, "baseline_offer": {"id": "967238328808448"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1741363320, "status": "PUBLISHED", "id": "967238328808448"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9436073949808574", "version": "0.19"}, "id": "635334672444488", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "9258194517596519", "is_concep
14Q7kNvwEshIU1&_nc_oc=AdmfHDuPUSZ5fuX_hTmY4JjJseRjJWvBqLGsq_BDX1QwP_VrnMI8UnrB4NHNT-LAdA8&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&oh=00_Afun93VGqytinx3EQzRM8cCRfZ3sIKqV_WTM_x2PTijquQ&oe=69A0351C"}, {"file_name": "dd.png", "id": "989803546466227", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/473394077_989803549799560_3062548092914019176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ysprTK0OrCwQ7kNvwF1obiH&_nc_oc=Adm5ZtswLGQ63RD6Ufw8Z7NqXp6fmlWSIE7_F9cjrBvoWJvSS5au7J7-2b92DJEP_io&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfvleHBv5916uvR2w9HU-7csLjZ-mQDSsYrOIJG9RdTxTw&oe=69A02CDF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vervet monkeys", "keywords": [], "long_description": "Vervet Monkeys is a Gorilla Tag fan game that brings players into a vibrant world of fast-paced movement, social interaction, and exciting gameplay. In this immersive VR experience, players take on the role of agile vervet monkeys, using their hands to climb, jump, and swing through dynamic environments.\n\nDesigned as a fun and engaging hangout game, Vervet Monkeys encourages freedom of movement and creativity. Whether you\u2019re chasing friends in thrilling tag-based modes, exploring unique maps, or simply socializing in a relaxed setting, the game offers an energetic and interactive experience. With its fluid locomotion system and welcoming community, Vervet Monkeys captures the spirit of Gorilla Tag while introducing its own unique charm and features.", "short_description": "Vervet Monkeys is a Gorilla Tag fan game where players take on the role of agile monkeys, climbing, jumping, and swinging through immersive environments. It\u2019s a fun and fast-paced hangout game focused on movement, social interaction, and exciting tag-based gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRTHmDVFR9_KUUcZA3NaJmy2ak45_LVJ8DqP8qaR8jtFu1Of_OfMG9VS7FtjPaUoSRhac94V5WraK_9/pu
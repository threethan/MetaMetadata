992539_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6wfjGAH-4RMQ7kNvwEVZJhL&_nc_oc=Adr9lXzYKzK7-ryJnWWWHQkNdxnVruICiUCmUR5aUTazQNcsPjckMVXiVyit5kDgEz4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af73UhAriqR8XhZ6knZ2Nd5MxL3Mvc8C4J7pzIih9aVAZQ&oe=6A202CDD"}, {"file_name": "SampleScene_Custom..._03.03.2025_11-42-23.png", "id": "1430735598295174", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473393507_1430735601628507_1354032772166786487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KbuLr01bmlsQ7kNvwFZb-N2&_nc_oc=Adr62zfyQUEOnVP8pfy5shD3ZmQC6Veol4Qz46veASVi742cs88QfpGpVtC3WB26Ds0&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5Z5cfyxMwA0OfaXR1rQyhQ_1lfxcxyTc5Da_I5HSTfXQ&oe=6A204AC6"}, {"file_name": "er.png", "id": "578947598508035", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/473393859_578947605174701_8165189107151339219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hCBIlEv3H9YQ7kNvwECLJeD&_nc_oc=AdpRLSuydg2FdPp-zpHX_ucm68t6svNKnUm4AEScIo4fF_ycbnTPpdqy78s41up3Qfw&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6u6HuMmqFzfjTKlpd23geBuJ0eqHkgdVgTdWKBtcqxxQ&oe=6A204EDC"}, {"file_name": "dd.png", "id": "989803546466227", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/473394077_989803549799560_3062548092914019176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bEbnqrDlFEYQ7kNvwETErKr&_nc_oc=AdqXFn6IyC5BWvp0MTJhzx7xhkwthi08C5LaMfJuqy42W9KLABgleVcfCRmwffRCw9U&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4rjNLlqpjRHye6AtYIP2dC9eQKHFUV8PvtzTaNFmx8IQ&oe=6A20469F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vervet monkeys", "keywords": [], "long_description": "Vervet Monkeys is a Gorilla Tag fan game that brings players into a vibrant world of fast-paced movement, social interaction, and exciting gameplay. In this immersive VR experience, players take on the role of agile vervet monkeys, using their hands to climb, jump, and swing through dynamic environments.\n\nDesigned as a fun and engaging hangout game, Vervet Monkeys encourages freedom of movement and creativity. Whether you\u2019re chasing friends in thrilling tag-based modes, exploring unique maps, or simply socializing in a relaxed setting, the game offers an energetic and interactive experience. With its fluid locomotion system and welcoming community, Vervet Monkeys captures the spirit of Gorilla Tag while introducing its own unique charm and features.", "short_description": "Vervet Monkeys is a Gorilla Tag fan game where players take on the role of agile monkeys, climbing, jumping, and swinging through immersive environments. It\u2019s a fun and fast-paced hangout game focused on movement, social interaction, and exciting tag-based gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRTHmDVFR9_KUUcZA3NaJmy2ak45_LVJ8DqP8qaR8jtFu1Of_OfMG9VS7FtjPaUoSRhac94V5WraK_9/pub", "developer_terms_of_service_url": null, "publisher_name": "Crazy toast", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vS4WNrJwa_4E272yH-45XKSnun8Dz1eOu74NLR6wQjBSQh11da2RGH5xCOEYXKN7zm6JGkQ_wGyVW95/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9276595189089785"}, "review_messages": []}]}, "cover_square_i
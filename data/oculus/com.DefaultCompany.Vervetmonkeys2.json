992539_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tkASZxaKrwUQ7kNvwHrKjWZ&_nc_oc=Adqg6DzslN5Pvoi9Dwq63v4qM3GYNmQyEwtr4-IljL7sxOpvhXiDckKLeZ6BZLhJFBM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyoCrGIdT-PpsEg2t-abD3sL3T3m3x3TOofGaM-JXSDdA&oe=69C3E3DD"}, {"file_name": "SampleScene_Custom..._03.03.2025_11-42-23.png", "id": "1430735598295174", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/473393507_1430735601628507_1354032772166786487_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8_KLAEt6fA0Q7kNvwF5l_qf&_nc_oc=Adpm0igG_05I09d7u7gvz79JQUaUA-I8aUEWsZ9xjsmh1bJv4V_-o2x6FXHFoLqRVI8&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwDovfZu-_YK_U5pf-GvHz5Oo0OOMxJiFeAGU_ew6TYuw&oe=69C3C986"}, {"file_name": "er.png", "id": "578947598508035", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/473393859_578947605174701_8165189107151339219_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azJxZ5l3QSUQ7kNvwGequ9U&_nc_oc=AdofeTDEb8eaA6hNcnXjxLqAYlVXgAw6Q2OPEyVlJz9ijtgRN9mBSdSVloOlZ2ppvcw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afykub0OU_YCBaRNs0IVmTqprb2JUTJ_jvyRm9SdJE3mmQ&oe=69C3CD9C"}, {"file_name": "dd.png", "id": "989803546466227", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/473394077_989803549799560_3062548092914019176_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=D6fFzNG2RvAQ7kNvwGTys5C&_nc_oc=AdptFRxJuBnnBvru4nEA3uwkGoas0kHw5riEcF5woTKDC3SLSaZQWygLxnECB2_A8Uk&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy4xkV_XI0Rf52lbRJjEjxwBc4mWKVksQF7ipXYVWytUw&oe=69C3C55F"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Vervet monkeys", "keywords": [], "long_description": "Vervet Monkeys is a Gorilla Tag fan game that brings players into a vibrant world of fast-paced movement, social interaction, and exciting gameplay. In this immersive VR experience, players take on the role of agile vervet monkeys, using their hands to climb, jump, and swing through dynamic environments.\n\nDesigned as a fun and engaging hangout game, Vervet Monkeys encourages freedom of movement and creativity. Whether you\u2019re chasing friends in thrilling tag-based modes, exploring unique maps, or simply socializing in a relaxed setting, the game offers an energetic and interactive experience. With its fluid locomotion system and welcoming community, Vervet Monkeys captures the spirit of Gorilla Tag while introducing its own unique charm and features.", "short_description": "Vervet Monkeys is a Gorilla Tag fan game where players take on the role of agile monkeys, climbing, jumping, and swinging through immersive environments. It\u2019s a fun and fast-paced hangout game focused on movement, social interaction, and exciting tag-based gameplay."}]}, "developer_name": null, "developer_privacy_policy_url": "https://docs.google.com/document/d/e/2PACX-1vRTHmDVFR9_KUUcZA3NaJmy2ak45_LVJ8DqP8qaR8jtFu1Of_OfMG9VS7FtjPaUoSRhac94V5WraK_9/pub", "developer_terms_of_service_url": null, "publisher_name": "Crazy toast", "support_website_url": null, "website_url": "https://docs.google.com/document/d/e/2PACX-1vS4WNrJwa_4E272yH-45XKSnun8Dz1eOu74NLR6wQjBSQh11da2RGH5xCOEYXKN7zm6JGkQ_wGyVW95/pub", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1023770785722696"}, {"id": "821934236779161"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["GAMEPAD"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "9276595189089785"}, "review_messages": []}]}, "cover_square_i
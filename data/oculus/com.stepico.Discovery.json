481_3008022912876645_191611294532015387_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BKxY1zBwCesQ7kNvwGQUCHE&_nc_oc=AdpGbM6U-DHoP5p6gIy4V5ETUueT2tTmbQm4XEYXm5GrBkXkuI0dxUvmjoe2f4pRzA8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOWbKV6Q_QGbT5Ttk3E1MRZu40Kaqj7QgOrz8oJDnf69g&oe=6ACE4162"}, {"file_name": "s4.png", "id": "1007659525033824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310817_1007659528367157_7148746436769413295_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HZfI5kF8pAsQ7kNvwFDebaR&_nc_oc=AdpSFtBYOY26GbyRyBJfOOAWyd_Ps2W3fWPIrpQWA4qlbfpYaQhH0sPp4EVqqb61Ga4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOduAjoeinfpVAaRMANgWHa57Qq9Q8X_DknWICG7LVa9A&oe=6ACE58BF"}, {"file_name": "s6.png", "id": "28497100756640083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_28497100783306747_3204645619017876237_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6R_4ikfVwoYQ7kNvwGiA-VX&_nc_oc=AdqIsiJVdTZ2XwdCM5kOHP6q5Q0lVu97HVGsA22vKMXdbB6rfpIDCUlWULStWla86cI&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOS2jvEl4EAYRCb7BwtTUCteTdyQ4bQdwhtxm9eFAOjbQ&oe=6ACE5ADC"}, {"file_name": "s9.png", "id": "1231579135851657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1231579142518323_7109068486871924210_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=E3qFSfilmvIQ7kNvwEjrXlL&_nc_oc=AdrI8eGK94nYa3tvdoPVyBTOouoWUcDPuT7r6OPliERKcRC9X82oiZpFeyUrMcg95PM&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMekjxbO3euLGMblezHbHbqoBu-Ho59L-Olk39zgIjoOQ&oe=6ACE6C24"}, {"file_name": "s7.png", "id": "1820018862751128", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1820018866084461_6394671013125124113_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fN6bygh-46gQ7kNvwGtghbt&_nc_oc=Adqo-uOijZeIhbKA9VnEpu6ROy-kF7A9ctq_mrX8d5uHhBYB3bXm-PpimeMvZKm31pU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOTd3Q-n6L8IGMv-dp-5KpIyTfGhtxSZOvFP1mIxfDGYQ&oe=6ACE5D39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1541414840969897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828104_1541414847636563_2863723104942724756_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JcoxMxiOkiUQ7kNvwGVKeZi&_nc_oc=AdokIcFsBTbCn53sRbjcJnyvkjyjUyKZHCNlvxyNZvL-sOfVdnc15wMggS8KyR8OMU8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMHI8pH4NcxEPH24-Zf7P7pbMsJxW_Hx3piHmGJQn6yPA&oe=6ACE4D20"}, "display_name": "Discovery: Rogue Planet", "keywords": ["FPS", "scifi", "shooter", "aliens", "action"], "long_description": "Set on **Rogax, a hostile frontier planet** filled with dangerous creatures, abandoned settlements, guarded cities, forgotten mines, and eerie swamps.\n\nYou play as a bounty hunter trying to make a living in a world where survival is never guaranteed. Take on risky jobs, fight aggressive alien threats, explore hostile environments, and uncover the secrets hidden across the planet.\n{1710710609997281}\n**Key Features**\n\n* **Full single-player VR campaign.** A narrative-driven sci-fi shooter experience built for players who want a real campaign in VR.\n* **First-person sci-fi combat.** Battle strange creatures and hostile threats with immersive VR shooting.\n* **Explore Rogax.** Discover dusty outposts, guarded cities, abandoned settlements, forgotten mines, and eerie swamps.\n* **Bounty hunter fantasy.** Take on dangerous jobs and survive a world where people do not always play by the rules.\n* **Mystery and discovery.**  Uncover the truth behind Rogax as each mission pulls you deeper into danger.\n\nSurvive the Frontier\n{1809776823549697}\nRogax is not a safe place.\n\nEvery job has a cost.\nEvery discovery has consequences.\nAnd every fight could be your last.\n", "short_description": "Rogax is alive, and it wants your next step to be our last. Blast through alien threats, explore a deadly frontier planet, and uncover the mystery behind a doomed mission in this immersive sci-fi VR FPS.\n\nBuilt in Unreal Engine, experience narrative, depth and immersion in the world of Rogax!"}]}, "developer_name": "Immersmind Studio", "developer_privacy_policy_url": "https://immersmind.com/privacypolicy.html", "developer_terms_of_service_url": "https://immersmind.com/termsofservice.html", "publisher_name": "Immersmind Studio", "support_website_url": "https://www.immersmind.com/", "website_url": "https://immersmind.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29146037308322502"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312257_2918410471827618_1212625939558370509_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6etSZfF8ZkUQ7kNvwG-XLap&_nc_oc=AdoWEkjdsOdjRFUI-XB7fz36OdsxU7DnM6Hm0Pi4hVLJnK9a66eZbbYMpb62mDMTLm0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOBeBFDinGAvkwhYYpR-BrarrK_cI57KkF4qxBNEH2rvA&oe=6ACE5EFD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Discovery: Rogue Planet", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": 
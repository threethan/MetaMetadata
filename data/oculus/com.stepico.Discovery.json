5/673525341_1663612338270433_9099276636240968678_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XVq5ioqYc5MQ7kNvwFBWN2c&_nc_oc=AdqhbP96cM9tNtKzxSZGK-VMtuGuyPmp2V3OxJsJQCXcnQB0Sqm2-9hURpnvV7uEea4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIeau9du3NBb_VVayjAOLgrWfghcQ_cefiakw8pGrUG5w&oe=6A9C286C"}, {"file_name": "s5.png", "id": "974920162113788", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499314660_974920165447121_3848942727027628656_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bpj3z-DiHmkQ7kNvwGJNNRo&_nc_oc=AdrleWfIGNRZwY1rZMT1LAzs_6FSo5qFjO-8SrLwr9DAY7x__4oz3ahKS3wJ6fDZsP0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3RJ2hFvN4ptsShUEk0r2-Jq1DNvzVs_4Ehe7JSSMUQw&oe=6A9C3C79"}, {"file_name": "s4.png", "id": "1007659525033824", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/499310817_1007659528367157_7148746436769413295_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VdTtimWkJv0Q7kNvwENDkTU&_nc_oc=Adq8ZckkYwUmsNhcJOqyXefw5urjMSXZOUG_dzxxvJZnVm0or_LgGwNCjqPMUWKdWfY&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJ3GaC5VXEpnDiEfhIJzCi4HJJfEO_o3ZVqilX9fQm4aw&oe=6A9C3FBF"}, {"file_name": "s3.png", "id": "1606992160396236", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/507823854_1606992163729569_3081853140841202823_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z5MvcThcSEcQ7kNvwGCQj5t&_nc_oc=AdqwzyFDbAAJJDx8ylhKywESQbjKY9CUJplJ8LMk-T1XMym7-cZ7se7NxjXwXebym-w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkF3AB_KRPh4RFF3RaVfyaFAOBhIC9CdQhopWPhnPxXA&oe=6A9C11B5"}, {"file_name": "1.png", "id": "2056044485791419", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491827960_2056044489124752_1300426442979872317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZeB08yQcfYQ7kNvwF8a4Ne&_nc_oc=Ado2qsrzS8k_BYmrxCo_kXpUXYoBsTSukXhdyCQtq3Tkut-JyvUwgNipgN6k4dUMTSU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQK0aUfxSxp5170cTd4PjtwOaaz41pSbsu8hJmzycC-dSQ&oe=6A9C3F33"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1541414840969897", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/491828104_1541414847636563_2863723104942724756_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Jqfh-hRiYwQ7kNvwHww2NE&_nc_oc=AdoJnVKDNA_LJqYh_GIt0KtXQT5dxO60rek5kk7FhAdBbkx4aDfpk8kGgmi3VAg9km0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIQc9KXpfGoJ9KQCrKL4-NtvWgVEEbuf8zsokmAxXV-HQ&oe=6A9C3420"}, "display_name": "Discovery: Rogue Planet", "keywords": ["FPS", "Adventure", "scifi", "shooter", "aliens"], "long_description": "Set on **Rogax, a hostile frontier planet** filled with dangerous creatures, abandoned settlements, guarded cities, forgotten mines, and eerie swamps.\n\nYou play as a bounty hunter trying to make a living in a world where survival is never guaranteed. Take on risky jobs, fight aggressive alien threats, explore hostile environments, and uncover the secrets hidden across the planet.\n\nKey Features\n\n* Full single-player VR campaign\n    A narrative-driven sci-fi shooter experience built for players who want a real campaign in VR.\n* First-person sci-fi combat\n    Battle strange creatures and hostile threats with immersive VR shooting.\n* Explore Rogax\n    Discover dusty outposts, guarded cities, abandoned settlements, forgotten mines, and eerie swamps.\n* Bounty hunter fantasy\n    Take on dangerous jobs and survive a world where people do not always play by the rules.\n* Mystery and discovery\n    Uncover the truth behind Rogax as each mission pulls you deeper into danger.\n\nSurvive the Frontier\n\nRogax is not a safe place.\n\nEvery job has a cost.\nEvery discovery has consequences.\nAnd every fight could be your last.", "short_description": "Rogax is alive, and it wants your next step to be our last. Blast through alien threats, explore a deadly frontier planet, and uncover the mystery behind a doomed mission
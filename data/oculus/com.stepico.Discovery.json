25481_3008022912876645_191611294532015387_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdZw6xbaufMQ7kNvwGAUuAD&_nc_oc=AdpULMHIT-lfwBKeSamM8fEHyHUvWK3picuAOCGKk73dBD18kdkZW1_firwLW1vw3Ws&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7S5y1lWH6p_NFr1FioH8r6VnKCCqfimfy-jlFD_LALA&oe=6AF71FE2"}, {"file_name": "s4.png", "id": "1007659525033824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310817_1007659528367157_7148746436769413295_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ap2fOBvz-K8Q7kNvwExMLZ8&_nc_oc=AdpKIakzWJqnvXF8NediePp4Snb-Jn4swntKpyjKdoGgCEENixROa3i2dsd57cdSmWU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTM7V8fjtRjIoAOk4dvfMTTTTnu-IfZn7Yf8AUv3iQCeQ&oe=6AF7373F"}, {"file_name": "s6.png", "id": "28497100756640083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_28497100783306747_3204645619017876237_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SvuqLy7yiowQ7kNvwFLktqi&_nc_oc=AdpBWvIfhiMYxfZxt4omNCEz7x2gQpJcA_IodXTsTNL0XLq2u6rorefEqrILgnGm6G8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT--ggdf1-7hg8OVXAruojABPE3Qopred8W9BKW7xZ06w&oe=6AF7395C"}, {"file_name": "s9.png", "id": "1231579135851657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1231579142518323_7109068486871924210_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSGMfx_86XwQ7kNvwHifRC_&_nc_oc=Adr6b69ODpMHv8J2jsMQyc3AlVwjKCkVqDleLNPkjRI7B_hyb5YRKs_ggAtnhZAgdjo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRReN63ejzIV2WyOJ2udqBzxXIeNnNNjll_dZsOTt2Z_A&oe=6AF74AA4"}, {"file_name": "s7.png", "id": "1820018862751128", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1820018866084461_6394671013125124113_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BxO-girNFBwQ7kNvwGDbV4Y&_nc_oc=Adqw80rE_ZRzJlep2eHHIfYqzDdIa1_tLajsVtzhQrTpV3nLz6pSi_3koMM9hYqrG8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ9DTcAng0TxPeRj8Jzi-T50v1rsAkCPgYIgWpfmeMs-Q&oe=6AF73BB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1541414840969897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828104_1541414847636563_2863723104942724756_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g7hPfFvpIX4Q7kNvwECRjRC&_nc_oc=Adp0-xa67RD4yNQiUdPXhAbHlA3YaF7TCgkCKQA5xh20k5_Gt2nnMixDtB5jOhkGjKU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRvEtV_wpWfdLtf4M5CHnrFA81WYyEALDoF_uVVchQgNA&oe=6AF72BA0"}, "display_name": "Discovery: Rogue Planet", "keywords": ["FPS", "scifi", "shooter", "aliens", "action"], "long_description": "**Discovery: Rogue Planet** is a story-driven sci-fi VR shooter and road movie set on **Rogax**, a hostile frontier planet where every journey takes you deeper into danger.\n\nTravel through abandoned settlements, forgotten mines, and eerie swamps. Fight deadly alien creatures, take on risky bounty jobs, and uncover a gripping story in a unique, immersive world.\n{1710710609997281}\n**Key Features**\n\n* **A complete 4\u20135 hour single-player VR campaign.** A focused, story-driven sci-fi shooter made for VR.\n* **First-person sci-fi combat.** Battle dangerous creatures and hostile threats with immersive VR shooting.\n* **Explore Rogax.** Discover dusty outposts, guarded cities, abandoned settlements, forgotten mines, and eerie swamps.\n* **Live the bounty hunter fantasy.** Take on risky jobs, navigate a lawless frontier, and decide who you can trust.\n* **Mystery and discovery.**  Uncover the truth behind Rogax as each mission pulls you deeper into danger.\n* **Comfortable for every player.** Play seated or standing, choose smooth locomotion or teleportation, and customize controls for left- or right-handed play.\n\nSurvive the Frontier\n{1809776823549697}\nRogax is not a safe place.\n\nEvery job has a cost.\nEvery discovery has consequences.\nAnd every fight could be your last.\n", "short_description": "Rogax is alive, and it wants your next step to be our last. Blast through alien threats, explore a deadly frontier planet, and uncover the mystery behind a doomed mission in this immersive sci-fi VR FPS.\n\nBuilt in Unreal Engine, experience narrative, depth and immersion in the world of Rogax!"}]}, "developer_name": "Immersmind Studio", "developer_privacy_policy_url": "https://immersmind.com/privacypolicy.html", "developer_terms_of_service_url": "https://immersmind.com/termsofservice.html", "publisher_name": "Immersmind Studio", "support_website_url": "https://www.immersmind.com/", "website_url": "https://immersmind.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29430127953246768"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312257_2918410471827618_1212625939558370509_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9uOc7033agQQ7kNvwGv1Jjb&_nc_oc=AdrwvXJyxJJVZ64CRcIe2ihSw1-Bd3wSEk1itZBj85xdD08l-Lo5ahTsnLu_BIe3wuY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ7B3DjUp2pkgOBDUburO8wjtO6peBRB3QKpdhxi8vePg&oe=6AF73D7D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Discovery: Rogue Planet", "platform": "ANDROID_6DOF", "context_c
FF-LP-C1I-z41LlXl7Zf0iP-NzJCcEFGknWoAUuw&oe=6AAEB433"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1541414840969897", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/491828104_1541414847636563_2863723104942724756_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-_LRgCAxDUgQ7kNvwFU8trw&_nc_oc=AdpGWlskQ7cdss4t_OuclRN0BzRThKFkK7YHtwDZopoqnfmh8eg4X2WZ8XwhriLc6tg&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKKktwmSnYMpdxmoD_dRToKRhSqcKQjfgZ5ddSA9vZp9Q&oe=6AAEA920"}, "display_name": "Discovery: Rogue Planet", "keywords": ["FPS", "scifi", "shooter", "aliens", "action"], "long_description": "Set on **Rogax, a hostile frontier planet** filled with dangerous creatures, abandoned settlements, guarded cities, forgotten mines, and eerie swamps.\n\nYou play as a bounty hunter trying to make a living in a world where survival is never guaranteed. Take on risky jobs, fight aggressive alien threats, explore hostile environments, and uncover the secrets hidden across the planet.\n\nKey Features\n\n* Full single-player VR campaign\n    A narrative-driven sci-fi shooter experience built for players who want a real campaign in VR.\n* First-person sci-fi combat\n    Battle strange creatures and hostile threats with immersive VR shooting.\n* Explore Rogax\n    Discover dusty outposts, guarded cities, abandoned settlements, forgotten mines, and eerie swamps.\n* Bounty hunter fantasy\n    Take on dangerous jobs and survive a world where people do not always play by the rules.\n* Mystery and discovery\n    Uncover the truth behind Rogax as each mission pulls you deeper into danger.\n\nSurvive the Frontier\n\nRogax is not a safe place.\n\nEvery job has a cost.\nEvery discovery has consequences.\nAnd every fight could be your last.", "short_description": "Rogax is alive, and it wants your next step to be our last. Blast through alien threats, explore a deadly frontier planet, and uncover the mystery behind a doomed mission in this immersive sci-fi VR FPS.\n\nBuilt in Unreal Engine, experience narrative, depth and immersion in the world of Rogax!"}]}, "developer_name": "Immersmind Studio", "developer_privacy_policy_url": "https://immersmind.com/privacypolicy.html", "developer_terms_of_service_url": "https://immersmind.com/termsofservice.html", "publisher_name": "Immersmind Studio", "support_website_url": "https://www.immersmind.com/", "website_url": "https://immersmind.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "3744040075834813"}, {"id": "459781504968480"}, {"id": "1008279844328894"}, {"id": "2691890164460465"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "28693397726919798"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/499312257_2918410471827618_1212625939558370509_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vvOGyifZV1gQ7kNvwGjJnCA&_nc_oc=AdrECePAen295US92HYoCRvTjggabutipH6SqK-1zNT1JPwdE_tBBvF79Fl6MU3VFIA&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLBsyZXZXj92NM8qZeWfVd0oOXgQAf9ySsucI_RL6eI_w&oe=6AAE82BD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Discovery: Rogue Planet", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Shooter", "id": "3744040075834813"}, {"topic_n
TeOG0gcLxRiefxlofblJ9chkyKh_4eg&oe=6AEB5E39"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1541414840969897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828104_1541414847636563_2863723104942724756_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_0OrKxB9XMQ7kNvwEwO9mD&_nc_oc=Ado5mkARCwFzEtigwz7uYBvNQ8GBgd_MWAg5N7TyFLwMdLeQpI-7bCdX6OLJVC9Z_kA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTrL6IWkaM22_FKmD9VPrmnl_MDwTWE7sX_DCNK7nRGjw&oe=6AEB4E20"}, "display_name": "Discovery: Rogue Planet", "keywords": ["FPS", "scifi", "shooter", "aliens", "action"], "long_description": "**Discovery: Rogue Planet** is a story-driven sci-fi VR shooter and road movie set on **Rogax**, a hostile frontier planet where every journey takes you deeper into danger.\n\nTravel through abandoned settlements, forgotten mines, and eerie swamps. Fight deadly alien creatures, take on risky bounty jobs, and uncover a gripping story in a unique, immersive world.\n{1710710609997281}\n**Key Features**\n\n* **A complete 4\u20135 hour single-player VR campaign.** A focused, story-driven sci-fi shooter made for VR.\n* **First-person sci-fi combat.** Battle dangerous creatures and hostile threats with immersive VR shooting.\n* **Explore Rogax.** Discover dusty outposts, guarded cities, abandoned settlements, forgotten mines, and eerie swamps.\n* **Live the bounty hunter fantasy.** Take on risky jobs, navigate a lawless frontier, and decide who you can trust.\n* **Mystery and discovery.**  Uncover the truth behind Rogax as each mission pulls you deeper into danger.\n* **Comfortable for every player.** Play seated or standing, choose smooth locomotion or teleportation, and customize controls for left- or right-handed play.\n\nSurvive the Frontier\n{1809776823549697}\nRogax is not a safe place.\n\nEvery job has a cost.\nEvery discovery has consequences.\nAnd every fight could be your last.\n", "short_description": "Rogax is alive, and it wants your next step to be our last. Blast through alien threats, explore a deadly frontier planet, and uncover the mystery behind a doomed mission in this immersive sci-fi VR FPS.\n\nBuilt in Unreal Engine, experience narrative, depth and immersion in the world of Rogax!"}]}, "developer_name": "Immersmind Studio", "developer_privacy_policy_url": "https://immersmind.com/privacypolicy.html", "developer_terms_of_service_url": "https://immersmind.com/termsofservice.html", "publisher_name": "Immersmind Studio", "support_website_url": "https://www.immersmind.com/", "website_url": "https://immersmind.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29430127953246768"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499312257_2918410471827618_1212625939558370509_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zptUkdnaCHQQ7kNvwFxhuOR&_nc_oc=AdrH1LAb8I6Kl3ZJ1t-uMrMIqhAAGF_27ZIioCKlkeqiwwrprx4fwLC98wtRyUL2U80&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTljtSFjR4AbcWzDWPf-4WUR6jZ6aE4fSo6BJy3lzQDPA&oe=6AEB5FFD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Discovery: Rogue Planet", "platform": "ANDROID_6DOF", "context_c
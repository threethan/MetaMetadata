", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491825257_1820018866084461_6394671013125124113_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rKZv6xJ6aI0Q7kNvwGTkbSx&_nc_oc=AdoCFIX83W5KodiNaYJ6VSMNnuVeCuBBtwH-1WJg5N1vO_rjegFWLIshsZVmgZ84NIU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQWp7HrAz17Hzf-JjXXzxSiEvaGiIDcp9PVf6G9gR3g5oA&oe=6B0EF6B9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1541414840969897", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491828104_1541414847636563_2863723104942724756_n.png?_nc_cat=101&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=mM2KSIPB6GwQ7kNvwEd3OUm&_nc_oc=AdoIb4svYktnYqWESrC7bDu10dm1rjsDWLP1iUDwg9B2Wb8vjwyhSDkty0C9Idz9OOE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQUZppW3Y-UhU_V-XQwbLuMQiehMeHpjANlCoTplFiJzgg&oe=6B0F1EE0"}, "display_name": "Discovery: Rogue Planet", "keywords": ["FPS", "scifi", "shooter", "aliens", "action"], "long_description": "**Discovery: Rogue Planet** is a story-driven sci-fi VR shooter that takes you on a dangerous journey across **Rogax**, a remote frontier planet filled with hostile creatures, abandoned settlements, and secrets waiting to be uncovered.\n\nFight your way through forgotten mines, dusty outposts, guarded cities, and eerie swamps. Explore a hostile alien world, face dangerous creatures, and follow the trail of a doomed mission as you uncover the truth behind Rogax.\n{1710710609997281}\n**Key Features**\n\n* **A complete 4\u20135 hour single-player VR campaign.** Experience a focused sci-fi adventure with a gripping story, diverse locations, and a journey full of danger.\n* **Immersive first-person VR combat.** Take on deadly alien creatures and hostile threats using hands-on VR shooting.\n* **Explore a dangerous alien world.** Travel through dusty outposts, guarded cities, abandoned settlements, forgotten mines, and eerie swamps.\n* **Live the fixer fantasy.** Take on risky jobs, navigate a lawless frontier, and decide who you can trust.\n* **Mystery and discovery.**  Uncover the truth behind Rogax as each mission pulls you deeper into danger.\n* **Comfortable for every player.** Play seated or standing, choose smooth locomotion or teleportation, and customize controls for left- or right-handed play.\n\nSurvive the Frontier\n{1809776823549697}\nRogax is not a safe place.\nRogax is a world of danger and unanswered questions.\nFight to survive. Explore the unknown. Uncover the truth behind a doomed mission.\nYour journey into Rogax begins here.\n", "short_description": "Explore a hostile alien frontier, fight deadly creatures, and uncover the truth behind a doomed mission in a story-driven sci-fi VR shooter with a 4\u20135-hour single-player campaign."}]}, "developer_name": "Immersmind Studio", "developer_privacy_policy_url": "https://immersmind.com/privacypolicy.html", "developer_terms_of_service_url": "https://immersmind.com/termsofservice.html", "publisher_name": "Immersmind Studio", "support_website_url": "https://www.immersmind.com/", "website_url": "https://immersmind.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29867132479546311"}, "review_messages": []}]}, "cover_square_image": {"uri": "http
sid=6e7a0a&_nc_ohc=VdTtimWkJv0Q7kNvwEYdy7e&_nc_oc=AdpBx0cVlcfvadxjuN5DpEEincirB4Ei5EKvC-w639IoSDRbDRdqF5tDTtJsN9i54j0&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIMhBzQvnSLF6ObL54czogdIVW-SU2_16SEMmDCfGbvbw&oe=6A9EE2BF"}, {"file_name": "s3.png", "id": "1606992160396236", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/507823854_1606992163729569_3081853140841202823_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oUeUk1XqI5cQ7kNvwGzRzLb&_nc_oc=AdrghsEUixvNv8V7pj4FbQrOLG6vewtcIYVft1gjxAvGiTPXgUOzFKYQGYjEWM9CxiM&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKM9rLEHsFFKRL-xxiTbFhzl129kyVPvclL8ifl7e7vgg&oe=6A9EB4B5"}, {"file_name": "1.png", "id": "2056044485791419", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491827960_2056044489124752_1300426442979872317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pZeB08yQcfYQ7kNvwE-TYWM&_nc_oc=Adp99wBuVw5_AqPHoKbIgcMUleVTjyJ6HC7GslsVeCYlBGNjCgg-IIlANfH1_A2TMRc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIiP7_ZmHy8BORvzBB3dim9l3U8GZkkdXnqs3DcLEVvUg&oe=6A9EE233"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1541414840969897", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491828104_1541414847636563_2863723104942724756_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HwE8KAh8ppAQ7kNvwFfVPb7&_nc_oc=Ado5gklcPkvI57r-4GNdbFzSFF_riKvc8VHiPm34N9Y6-qIXGSrasOOFhpV_UCghD34&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKu5zqC_Kqnd8NIPqYdEnb_Nf0CDH1UvmF3cJ5TDp6I0w&oe=6A9ED720"}, "display_name": "Discovery: Rogue Planet", "keywords": ["FPS", "Adventure", "scifi", "shooter", "aliens"], "long_description": "Set on **Rogax, a hostile frontier planet** filled with dangerous creatures, abandoned settlements, guarded cities, forgotten mines, and eerie swamps.\n\nYou play as a bounty hunter trying to make a living in a world where survival is never guaranteed. Take on risky jobs, fight aggressive alien threats, explore hostile environments, and uncover the secrets hidden across the planet.\n\nKey Features\n\n* Full single-player VR campaign\n    A narrative-driven sci-fi shooter experience built for players who want a real campaign in VR.\n* First-person sci-fi combat\n    Battle strange creatures and hostile threats with immersive VR shooting.\n* Explore Rogax\n    Discover dusty outposts, guarded cities, abandoned settlements, forgotten mines, and eerie swamps.\n* Bounty hunter fantasy\n    Take on dangerous jobs and survive a world where people do not always play by the rules.\n* Mystery and discovery\n    Uncover the truth behind Rogax as each mission pulls you deeper into danger.\n\nSurvive the Frontier\n\nRogax is not a safe place.\n\nEvery job has a cost.\nEvery discovery has consequences.\nAnd every fight could be your last.", "short_description": "Step onto Rogax, a hostile frontier planet where every discovery leads to danger. Discovery: Rogue Planet is a story-driven sci-fi VR FPS where you fight alien creatures, explore deadly environments, and uncover the truth behind a mission gone wrong. \n\nBuilt in Unreal Engine, experience narrative, depth and immersion in the world of Rogax!"}]}, "developer_name": "Immersmind Studio", "developer_privacy_policy_url": "https://immersmind.com/privacypolicy.html", "developer_terms_of_service_url": "https://immersmind.com/termsofservice.html", "publisher_name": "Immersmind Studio", "support_website_url": "https://www.immersmind.com/", "website_url": "https://immersmind.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMEN
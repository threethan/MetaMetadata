c_ohc=XjO8aXrw_GoQ7kNvwEhX5_l&_nc_oc=AdqdVHGK0ipn2OQD5SNKD1-Y1-zAH16NGRtii2iKawNs0-Dvan4nLlCytFIs8zHvvOo&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHy6TT-IgBlm7RlRcexSZZu8D7RWlHMqO9asSeubesYAg&oe=6A859AB9"}, {"file_name": "s4.png", "id": "1007659525033824", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/499310817_1007659528367157_7148746436769413295_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9kbZPNj7ooQQ7kNvwGmnT7M&_nc_oc=Adohd6NkwOPpCf9AUF8GRjUkJfRNEeqVyoZUbnuZo_iDI47V5Xcvo16tYrTw2zV3A4A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHqwz3nW_4B8Gt7ywNyZZHxv3ZdFMN3nSWwpp4S1Wc5qA&oe=6A859DFF"}, {"file_name": "s3.png", "id": "1606992160396236", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/507823854_1606992163729569_3081853140841202823_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=neZig7gG2rkQ7kNvwFX8sUK&_nc_oc=Adqb3UDsRrd94hGdcKuXRUJ1wHkUap3f6pF99ygNrUBSEP44N2oLAd3CD3sUDlsH0rQ&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHEJLglaI4wrE2lMYNoOoZ-7sIH1X2dqntuigpcYj6C2g&oe=6A85A835"}, {"file_name": "1.png", "id": "2056044485791419", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/491827960_2056044489124752_1300426442979872317_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ds5d9jvvT8Q7kNvwHaXhe1&_nc_oc=Adrxh5DC9g6-acAeFyTfPdNzI9g8UkwDjEjXc8OUTIGCoo0F58LbPQ4Dj3-cEOdzOgE&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG9tuf1hepRDKlScMVMIGS5XNBnt5c18S6DrjkZFhbwWg&oe=6A859D73"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1541414840969897", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/491828104_1541414847636563_2863723104942724756_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ro3ocj7y5pUQ7kNvwGyoSie&_nc_oc=Adqzmv1u107meakFqJ9_DEUoruQcIGWmOOQmRHGHpjI1drb_nul_1gkvfrp1I4tNFB0&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQ2PYnCW4p7_akKReLg1G2sJ_Wrao-1FbZ41s_KwORAg&oe=6A859260"}, "display_name": "Discovery: Rogue Planet", "keywords": ["FPS", "Adventure", "scifi", "shooter", "aliens"], "long_description": "Set on **Rogax, a hostile frontier planet** filled with dangerous creatures, abandoned settlements, guarded cities, forgotten mines, and eerie swamps.\n\nYou play as a bounty hunter trying to make a living in a world where survival is never guaranteed. Take on risky jobs, fight aggressive alien threats, explore hostile environments, and uncover the secrets hidden across the planet.\n\nKey Features\n\n* Full single-player VR campaign\n    A narrative-driven sci-fi shooter experience built for players who want a real campaign in VR.\n* First-person sci-fi combat\n    Battle strange creatures and hostile threats with immersive VR shooting.\n* Explore Rogax\n    Discover dusty outposts, guarded cities, abandoned settlements, forgotten mines, and eerie swamps.\n* Bounty hunter fantasy\n    Take on dangerous jobs and survive a world where people do not always play by the rules.\n* Mystery and discovery\n    Uncover the truth behind Rogax as each mission pulls you deeper into danger.\n\nSurvive the Frontier\n\nRogax is not a safe place.\n\nEvery job has a cost.\nEvery discovery has consequences.\nAnd every fight could be your last.", "short_description": "Step onto Rogax, a hostile frontier planet where every discovery leads to danger. Discovery: Rogue Planet is a story-driven sci-fi VR FPS where you fight alien creatures, explore deadly environments, and uncover the truth behind a mission gone wrong. \n\nBuilt in Unreal Engine, experience narrative, depth and immersion in the world of Rogax!"}]}, "developer_name": "Immersmind Studio", "developer_privacy_policy_url": "https://immersmind.com/privacypolicy.html", "developer_terms_of_service_url": "https://immersmind.com/termsofservice.html", "publisher_name": "Immersmind Studio", "support_website_url": "https://www.immersmind.com/", "website_url": "https://immersmind.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_FEW", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "27913016928291219"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1810756140302222"}]}, "baseline_offer": {"id": "1810756140302222"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1786641240, "status": "PUBLISHED", "id": "1810756140302222"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "28192860913640151", "version": "1.0.3744"}, "id": "794690745501626", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "7786285568057652", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "28192860913640151"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": []}, "change_log": null, "created_date": 1786657961, "id": "28439740905618816", "version": "1.0.3755", "version_code": 5134, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": {"id": "28439737312285842"}, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset":
481_3008022912876645_191611294532015387_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HQMZ_cn9wccQ7kNvwH0cGLD&_nc_oc=Ado7DtDzIHurBptZUgudLSAw3nwV-OHbBB1LtBsFHgT4S4LAAu5iX_l3rMte35mlSe8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNSmP2GdaVNkqItPq0Kw0hDCCG5FTh6qou_k3J6DBMLwQ&oe=6ADE1362"}, {"file_name": "s4.png", "id": "1007659525033824", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499310817_1007659528367157_7148746436769413295_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oAKBTYKir8cQ7kNvwESbM1I&_nc_oc=AdrscTCIoOsuv-ggC8-mlZbrPMjtVo0c95W5sZ9_FwFB9ueiSM4V2lkc2TJxS1efeQ0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOSuujGeju57oN2BQ058c96LbUZzZJo-hJcjjOEesYPxQ&oe=6ADE2ABF"}, {"file_name": "s6.png", "id": "28497100756640083", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823746_28497100783306747_3204645619017876237_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KJWj3Ap4l18Q7kNvwFCPKud&_nc_oc=AdqUc4fUwjABfHw6rcaWI_5Il7eOZc8kW0aUl-6AVfeV0ybw0CcORAsANs3YQ_PHl3A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNdtAvviSwXqRmjHTUsvINxEZFrMwNLshc9HJTQSlZwBQ&oe=6ADDF49C"}, {"file_name": "s9.png", "id": "1231579135851657", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491823837_1231579142518323_7109068486871924210_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-IgaNNlQb3sQ7kNvwHgcbB-&_nc_oc=Adqsff2Ao1NWcOohIAK_kdIU1YiFcOOX8_lOPtfOI3snKNLJ6E3ptks6S9W3a-W48N0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOxPWxhivdW1HUuPHHXh_gQGnYhZFfeSMXAqSiOuBbNQw&oe=6ADE05E4"}, {"file_name": "s7.png", "id": "1820018862751128", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825257_1820018866084461_6394671013125124113_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=A_udSxq3yOsQ7kNvwFXdm8t&_nc_oc=AdpJG7kTOndiQ_yJ2p2ZcJ51EAkBt0dIov6q0F3GrJr0rgUc2LFIStDEYvR2A6YHPQU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNCjAPN52vBI6MCymDkTA0vteXgUFErugQYC5eHJrwN4g&oe=6ADDF6F9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1541414840969897", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491828104_1541414847636563_2863723104942724756_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6d2V6Js2BAkQ7kNvwGXFGo6&_nc_oc=AdpIFcj6WAAXYlTT3wc-GxDjJu8OyZtfgLA9RLi9VUvNNpuEyAyVPNgGM3nFIubBlnk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPDBm4qPHchsIO7yMEutFResXL1PajSQYJU_l00eGjtaQ&oe=6ADE1F20"}, "display_name": "Discovery: Rogue Planet", "keywords": ["FPS", "scifi", "shooter", "aliens", "action"], "long_description": "Set on **Rogax, a hostile frontier planet** filled with dangerous creatures, abandoned settlements, guarded cities, forgotten mines, and eerie swamps.\n\nYou play as a bounty hunter trying to make a living in a world where survival is never guaranteed. Take on risky jobs, fight aggressive alien threats, explore hostile environments, and uncover the secrets hidden across the planet.\n{1710710609997281}\n**Key Features**\n\n* **Full single-player VR campaign.** A narrative-driven sci-fi shooter experience built for players who want a real campaign in VR.\n* **First-person sci-fi combat.** Battle strange creatures and hostile threats with immersive VR shooting.\n* **Explore Rogax.** Discover dusty outposts, guarded cities, abandoned settlements, forgotten mines, and eerie swamps.\n* **Bounty hunter fantasy.** Take on dangerous jobs and survive a world where people do not always play by the rules.\n* **Mystery and discovery.**  Uncover the truth behind Rogax as each mission pulls you deeper into danger.\n\nSurvive the Frontier\n{1809776823549697}\nRogax is not a safe place.\n\nEvery job has a cost.\nEvery discovery has consequences.\nAnd every fight could be your last.\n", "short_description": "Rogax is alive, and it wants your next step to be our last. Blast through alien threats, explore a deadly frontier planet, and uncover the mystery behind a doomed mission in this immersive sci-fi VR FPS.\n\nBuilt in Unreal Engine, experience narrative, depth and immersion in the world of Rogax!"}]}, "developer_name": "Immersmind Studio", "developer_privacy_policy_url": "https://immersmind.com/privacypolicy.html", "developer_terms_of_service_url": "https://immersmind.com/termsofservice.html", "publisher_name": "Immersmind Studio", "support_website_url": "https://www.immersmind.com/", "website_url": "https://immersmind.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29146037308322502"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499312257_2918410471827618_1212625939558370509_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Me4SVWuVV0sQ7kNvwHPUwmg&_nc_oc=Adp-WkYpXXCNUVikiXP8_YObp7hohssmGIsoV0UMRlvfhAsBCmk49pYEK1CkELHwGiI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIhAcUJjdGWYjjAXgI_Aa9cU-MZU7W-KkFmE8nMt4Y3g&oe=6ADDF8BD"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Discovery: Rogue Planet", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "context_topics": [{"topic_name": "Adventure", "id": 
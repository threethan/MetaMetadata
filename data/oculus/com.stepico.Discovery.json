25481_3008022912876645_191611294532015387_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-aAudRLgY28Q7kNvwER_RlV&_nc_oc=Adr56aEZ9s-XzrEJJhWo5IuqV5phOUgS3n0bGzw8d-ateqqmqBp-osAO-_VneS9VII4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSLqeCk2yB8-aYSexRX83IJkOpTWm7JRJzATh4Yfbji_Q&oe=6AE9F0E2"}, {"file_name": "s4.png", "id": "1007659525033824", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499310817_1007659528367157_7148746436769413295_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=734seRUks_MQ7kNvwH5K9sb&_nc_oc=Adr2KY177qWHG9WrX0ee7F2FkT3ucBSmcppGNn1wwgeqiG0ThkOBX30f71MZ3Tx0w6w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQtmBLwhYxMoSDJ3ebr2cacMdriVhuC3XinrFvGa_6-yg&oe=6AEA083F"}, {"file_name": "s6.png", "id": "28497100756640083", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823746_28497100783306747_3204645619017876237_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hd1DwSGu07sQ7kNvwHDxz0Q&_nc_oc=AdpqVHcRdKmz3RnscU-p3k4afKSD1tF9MCkbChuonWlQ7wxKEo3R_v96QMwI6IF6mXo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTYuv8wDUMQwuc0ozt7E5RscGPz1Qec44osnO5S89qyBw&oe=6AEA0A5C"}, {"file_name": "s9.png", "id": "1231579135851657", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491823837_1231579142518323_7109068486871924210_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ojAiW5Id7zwQ7kNvwGC3vWn&_nc_oc=Adp5_D-xWbbgvc8MC3Gk60xddll2g8J6fGLP_vp41-UMrGP9YKgVj2PrsVygJdIvOOw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSWvgseX7kfCGQSLaHuYOnpxDInRQsNN4_z7JhjV6Bn9g&oe=6AE9E364"}, {"file_name": "s7.png", "id": "1820018862751128", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491825257_1820018866084461_6394671013125124113_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JCCM_grlSdkQ7kNvwFMELDo&_nc_oc=Ado2Ra6V7A6j-VxJKNlXsREK_MfonI92zHgcOCBl-Pot6HqXpD8h_HcskFuzswJxULU&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRrsGAbonrybpNgJFBGiJg-9R07ZgIteHccWCaBLNtCyA&oe=6AEA0CB9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "cover.png", "id": "1541414840969897", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491828104_1541414847636563_2863723104942724756_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9_0OrKxB9XMQ7kNvwGuOTgG&_nc_oc=AdrDGCCzX7ckRCoKiRNR5Bvc7gT-W0gq8b0EHoOCFi9RldraJmbVthtV_EoOCp3JLRI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSV_NKHIsSZJOExnBKl2HoV1lcfqUobrsBEWF6JjDPuHQ&oe=6AE9FCA0"}, "display_name": "Discovery: Rogue Planet", "keywords": ["FPS", "scifi", "shooter", "aliens", "action"], "long_description": "**Discovery: Rogue Planet** is a story-driven sci-fi VR shooter and road movie set on **Rogax**, a hostile frontier planet where every journey takes you deeper into danger.\n\nTravel through abandoned settlements, forgotten mines, and eerie swamps. Fight deadly alien creatures, take on risky bounty jobs, and uncover a gripping story in a unique, immersive world.\n{1710710609997281}\n**Key Features**\n\n* **A complete 4\u20135 hour single-player VR campaign.** A focused, story-driven sci-fi shooter made for VR.\n* **First-person sci-fi combat.** Battle dangerous creatures and hostile threats with immersive VR shooting.\n* **Explore Rogax.** Discover dusty outposts, guarded cities, abandoned settlements, forgotten mines, and eerie swamps.\n* **Live the bounty hunter fantasy.** Take on risky jobs, navigate a lawless frontier, and decide who you can trust.\n* **Mystery and discovery.**  Uncover the truth behind Rogax as each mission pulls you deeper into danger.\n* **Comfortable for every player.** Play seated or standing, choose smooth locomotion or teleportation, and customize controls for left- or right-handed play.\n\nSurvive the Frontier\n{1809776823549697}\nRogax is not a safe place.\n\nEvery job has a cost.\nEvery discovery has consequences.\nAnd every fight could be your last.\n", "short_description": "Rogax is alive, and it wants your next step to be our last. Blast through alien threats, explore a deadly frontier planet, and uncover the mystery behind a doomed mission in this immersive sci-fi VR FPS.\n\nBuilt in Unreal Engine, experience narrative, depth and immersion in the world of Rogax!"}]}, "developer_name": "Immersmind Studio", "developer_privacy_policy_url": "https://immersmind.com/privacypolicy.html", "developer_terms_of_service_url": "https://immersmind.com/termsofservice.html", "publisher_name": "Immersmind Studio", "support_website_url": "https://www.immersmind.com/", "website_url": "https://immersmind.com/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "1008279844328894"}, {"id": "459781504968480"}, {"id": "3744040075834813"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ROOM_SCALE", "STANDING", "SITTING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "29430127953246768"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499312257_2918410471827618_1212625939558370509_n.png?stp=dst-png_s360x360&_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zptUkdnaCHQQ7kNvwH-O57O&_nc_oc=AdoNT50qva95rG4xJtTFyObAGH58iP9LQrMwemqVDwU2pdQbgh_U9wT42LGyk0GFMUw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSJ49te5d-roAFQYK6TCWXRSHNV2Vq7ZZNTfwBy14dwvg&oe=6AEA0E7D"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Discovery: Rogue Planet", "platform": "ANDROID_6DOF", "context_c
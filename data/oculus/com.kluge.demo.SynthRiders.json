_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H4bd7aarNg8Q7kNvwEebhPN&_nc_oc=AdoAitBAib5cntwbkMDUGzuoXmYjbkHzYWFCxa4yp3VeNhrMyP3f5eLe7JCPWvrOanY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGg9-XuAf2nAiV2B10M3Wuoxx_ZjlCjy9RkNre-SeVKbQ&oe=6A772EB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=U8R5UZ97Fm8Q7kNvwHRMpZr&_nc_oc=Adot64wSF-JNqptxU_fBizZZqUwKz8-ySqUq3727bICqBD_LsLkyk9eIC8rFwAY3yd4&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHstkRDmEx7t4uEKF9uQMVXcB74j_aiE3-VU0zKx2vMrQ&oe=6A771604"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-4Pb2aIrXBsQ7kNvwE4nFiT&_nc_oc=AdojG-6X1enMkFDhHKXuX3I4aGahLCwlMwakcLG1PDGpJj5x-PLGT9yflHokEq2MCIU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHg-RGDRvXEIOYQ081Ev0DkjZ8TNdbiDSz5KLzx_Y5nwA&oe=6A772BB3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Y30MmhWeljEQ7kNvwEmHGAI&_nc_oc=AdqXlbP4dYQ4VezZmmdDjGoB4G5rmQIhJga0rBmRR5TJt5hOjnGhZkTD3VJMOIT-yQA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF68aPtQKDCKa4Bgmy17JZ6oxiiLjL3s79lAk6B-rdccQ&oe=6A772299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hBI5EjGLMTAQ7kNvwHU3hzp&_nc_oc=AdrSEzzPVKJp1epcmuvyzhh2bsLjV7vmE__xD5nSh49jovKk0x0QkB1kpzePQ4LMWfo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeSQAmrcfpKl8EjTXonlU_ZEXZJfwE10R5c64OCmgLOA&oe=6A7716F2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
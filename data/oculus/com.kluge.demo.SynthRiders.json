_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxrknbtGe2wQ7kNvwEZ_vvB&_nc_oc=AdoVzLrRaWY6vm4YhcBC9OwDkLJe54pWX9OfqLMVZzeyRoHD05J_Y2bIfR93_BIXXZU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMK0AJXc9cuReTi7ULGrpFv4QCNg9A_LEDa5u_GInY94A&oe=6AD3AFF0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZ4t53j31UMQ7kNvwF8XJDs&_nc_oc=Adqq03aWbnH9k_RB6CF0BgVjRvHvIuUZaDZdbRuRuk0lDsoDW7YHHgu4BXAeCQVVwAs&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO83bSj9mr7eCVhQIeQKwidZlapR5iBKqlx2aGwjQFC0g&oe=6AD39744"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruO-5WFkbigQ7kNvwEZ7X0X&_nc_oc=Adpev1Jisz1mse-dcIWTC8j4NwAyXnEvMrEvJu98HmZbP28Xpr5hN4aPPSENY3FpXhU&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXj-fvAKyfDHGmJPKmkcA9ceUdiNyvzrXmpYldrn176g&oe=6AD3ACF3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGb_IZhRB8sQ7kNvwHul9IR&_nc_oc=AdoXgxZ-RxwTtcTIUINFrDCMVPgeYRu8onEehy9A8gPj9daaevpMEvVvOcit0Rq7oPQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPqIW36z3LiM6S1ZhrJZbqEseSWFxg53fTwoP9XkayO7Q&oe=6AD3A3D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kn51A3GFJ6sQ7kNvwFgWc2Z&_nc_oc=AdrEkKTZobz7q1cIrpZI55z7eP8Y9aovp8m8LiOh8rxH4uUuBtOweU6OJQoJTRdU_H4&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMnKQNBIUlw0rZM9PuuiEcR_PQsJOl7w85fG3XPfGT33Q&oe=6AD39832"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
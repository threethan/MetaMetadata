_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3oHFbsetF0Q7kNvwHM8Hx5&_nc_oc=AdooSMLYaYxJNYu4CJEf3tI7LXTt2QAhO2zWFrruMDdUgnChAIJIzelM83K2G9Y3-0g&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNIUfjHWFb1_doWQ-u9SXXO_4of3AUSV5XeYaX7fMTh4g&oe=6AE1F830"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYYAeF4oXSQQ7kNvwFq7c2P&_nc_oc=Adq3gvb0TRJZOGG2G2DPmmE5ctYQkQFJQgTb2OB0KHj5gN-BV0GVnV_d0pkHPetznes&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPBhSEctM_6aywhYj3P73YbRCYQt5h6lmyszpl77ZG4Uw&oe=6AE217C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcBs3-Lc5YEQ7kNvwGdQVk7&_nc_oc=AdrK86oR3TlqGAENPdmFH7J2Nwpob8bpptmNqiUiaarAztNUYWejb-2nGkLDivxaWr8&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN3w1Io0ySdkb387WBes-h5RicEeNRlCwayj7Vyva-mQA&oe=6AE1F533"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o_JoyOiDVwQ7kNvwFSw4ft&_nc_oc=AdqgyfxMaPRXTf0RJifuycHUIVsRPRkyrvXImk6Tfy6vc2TZrnWz9pvDeJZP17NqvLA&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNhuJBdqHlXpCf_O7dku_nW0FNdfivR__zY-_NsW_7vNw&oe=6AE1EC19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uqi3-m2gB_0Q7kNvwFLYMcI&_nc_oc=Adpu76C-BN3Z2ufQUVL-vDh8Tci-PAoj0Yi6ParZ2xvNeD5xkg1rEr3mbVnf2lcRtZI&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQONxG-p_Wae7SGnt6vHkxKwB54P55XXBgl0iRUuZoBwng&oe=6AE218B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
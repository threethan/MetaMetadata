_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8k4-7kTFFmsQ7kNvwFtwnzf&_nc_oc=Adr2b4ibVnpUgeLW9BVuwXPFPd0jorDlM4lwVGI856lzUZ6lHBcCna7yvXAm3aWws-g&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_yfJvZDyhIR2jFHOuXAU6qo8yII7vPTrhbizobc78YSw&oe=6A217D30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=HUu7WzRk2fcQ7kNvwGcVQZo&_nc_oc=AdpDmfmQovUW_F5WRjeP_xGTVVgCHlyFNYM69k6YgvDz1cdD2W6Ca99msgwZ6zcVFE4&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-42QK4tLqTJWk7Ii4cqD5EizFLkEVsXG0O7LnPVM725A&oe=6A219CC4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fXBsPV2_uOQQ7kNvwEbPot3&_nc_oc=AdpmiEOP__wf3GzDpYTgJxnKgHhExg8trfC2vRWdGkdgkvRdHtX4CKIPZW-4vp-gd4U&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_SHoqWWTwQDBW3z0k1-iGkWoHpUmpFwCkBCmoGqWbx_w&oe=6A217A33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ve0sC4ZhmogQ7kNvwEQTqmh&_nc_oc=AdpfZnW3ZMjC0trema7TIElPoIorEx7F5loEfhKOo2Ys5d2HGMu-3nY6E_e5A_5QzmM&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8RogVhH2nMnKfYsWCTNW__jHbMgFdfGNnC5MqMqh16bA&oe=6A217119"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZhHOaoeqjW0Q7kNvwGa6aYc&_nc_oc=AdqF4kJ4Xxf3HYpgMaZhi2_QBOp-jyJ4ASUEnzYX3XCoZhUJzLhtjbY8I2AVsDHvT-0&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af__dU7WPVoD-mGstIPz8j0r4DcxJfGh9KJ0D3bHvLXGZQ&oe=6A219DB2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=IEBE2fWZejEQ7kNvwGQMIbN&_nc_oc=AdpslQ6JxTlo0QncwyScmOMFaLKFybJf3XL2gZKNixo9sXAzAcCItDh1UnvQznqibEs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQOqn0rbyvURRxK2hjIkSzsYy8P-TMQK3Yeoeh9d63RDg&oe=6AEC8430"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=46qPk4B4mAgQ7kNvwGJBMbZ&_nc_oc=AdrLrqt-JQkR2kVfzbIzff_n8WzRav9KPwzblXQPqtLk_zHAb4S3_GfuMNct6dwSywU&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSwNWcjdJcMQYMUc18pstaQxzXPNECow17xZVl1nDY-0w&oe=6AECA3C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iH3JoKM2-qoQ7kNvwGL2IbU&_nc_oc=Adp4vOnkpAaBJhD8siTBZjKTGSGsNnTWsFduex2QSTGVFj3BfKzqgGa_cZBHpY5cFPE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQShTyDOxerPzbMk2gjRSdY1Et0r26SALchSpaXnSX8sg&oe=6AECB973"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S0NfRWQ8wdwQ7kNvwGCcyDk&_nc_oc=AdrvmLx_WiOipU28bjP8tFmgbC5X-CVL2mrLDCpo4RfC0XDs_mZz7wf4M7fTMgmQtbs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQT7Xc7nqs8iKQJvExFLFMpFcL1qVpQLNwvtyVmlm9-Uog&oe=6AECB059"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sTmoJq4Js_wQ7kNvwGk4Znl&_nc_oc=AdqQkoHaj__fAnn0celXjCDbBHDEmjKTmJ590w8M9PwM51WL89mnrC7Cpwsc8SHIMgQ&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQw9-su4v2XzLjp7COG9v1eeUV4O7iGA6gQrMw_2NA5Kg&oe=6AECA4B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ohcyPp2z6dwQ7kNvwEmxsSE&_nc_oc=AdqTtIiQQVQcxfnKbe2Yg6zckFwurDq7Hcal8RUUxMozAQ-RupZQMXqNuVR2SfCg7dY&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPp4z3bQmcYHcpwyJ1WKP3XoSLyOYPoBuZK8pAQo-zp_Q&oe=6AE0A6B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ilZ0vzFTXecQ7kNvwHxaVm6&_nc_oc=AdohOg0VCCIARmav28kxjtQ34QUvSP8ieFrIWlTb4PMg_SmxB1fJkcfjZVH3odFR6Sw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPJVtuTVk8qQ5LFLPY4nAQnZqf8wAb2nx1g4ZZYHAf3cA&oe=6AE0C644"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcBs3-Lc5YEQ7kNvwFqcnmu&_nc_oc=Adqg4p9s5WnZjK6Yca3OEt-Qm7muz9m4jvdFj3VNg9fFXA4MepE_1JoQ_xDZx9wa9PA&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM5iSLZWztvmxOrzgvthlsaisCoLXlUaCRJJvAhMuynag&oe=6AE0A3B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q6Ioqd2guzIQ7kNvwGbBCZL&_nc_oc=AdoTFUtu-XwOMwHhzrxemB4mH-ez7bGZ9IrIJlr2nkqc5G9fwC2VEAk2hSXmg019GDI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMltpG6anK9pzOCk0LD10fV5LvXur3x6phVHDD_LieuFw&oe=6AE09A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Uqi3-m2gB_0Q7kNvwFPXM-Y&_nc_oc=AdpGlWs-sNeSe63nnZSVgI1lFujgpL4wBfrXzzb1jq_6qIwLkaLXSV8eS9MH-gVkEW8&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPFc6bce6TIM01Wrrzh0R_z32DXFIp9xBycSi60BMGyYA&oe=6AE0C732"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YKIByQrwNUQ7kNvwGIb4iC&_nc_oc=AdoluZzRZtFeWZBM_UtZy8VYAFbvWxWQ2hmRSJMQbrubBTGZpcfJM7k-NQKcqaiuy4g&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1Tlk7AYMQoQpMpwmb0JlujaMjt9mvf1x7iF8nn2x0jig&oe=69E386B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ka3h0L23us8Q7kNvwGGGvKA&_nc_oc=AdoDxWA5DL1mhBvu0cnICyy7R7GckPywcVW0nkuLfZm4HDeBxdC9ohLgypM8UiTAbTQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Wc3zvTxGNt7JcyQOX9fCWd4kfoB3O0y4VOagh-yQ3jQ&oe=69E36E04"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrTkCwPqUZIQ7kNvwGB9wJq&_nc_oc=Adoq8E2RrkRpvwijYWqOU92Tr7Bl2tHMqoF_4yN8pNdKMN-CVblH0ZlK1Nq6S56jyuE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1kXGPvfKCqWh-gBplySmgQzF3Hpyr0pudi3cNYqLHlPA&oe=69E383B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AMSM_jDqOsQ7kNvwEGBVar&_nc_oc=Ado930TEVxQtg7wX3SiID0KLff71OwJywskZ8DB7UAJLclTxrAHit9LshLXpWyrRdN0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h4wINb1IMD7UZrSajTYmTBVw-XPb_b12qXf89HQ5lfA&oe=69E37A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSF09Qv8MYAQ7kNvwED-j4O&_nc_oc=AdoV927VV5QyPyQ_2eBeLj6h1AbtTqERABy2gz8OVPI0iTUFRylcPEJj67fD23bRV6s&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0r-M_GmBklQsZ6chLJ5OW3SJTmkaeEPSj2WUyYOFJxpA&oe=69E36EF2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
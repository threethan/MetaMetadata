_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89wAhpBFFlwQ7kNvwGF40TG&_nc_oc=AdpxjBEMwMCWw6a7rT9kKfjFg8mUrYNy7f8uw9M9Ymg4eGq73c6sourj0UNyxR4hjJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB6s6L549tOzia0lb1RRKmcJbiN41URieAoU2e17AO69Q&oe=6A4CFEB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmR1cJeBNpMQ7kNvwGSoEGQ&_nc_oc=AdrMwSBnK5D9WwyI_OGG2dpkgUQN2iMnP9hOveYCAvg2QDl9SeIa1gb0kv9qVgDvLEk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAOsOmjf9uAO-BMi2CZTbwpSGpLyiZz74xH1gxyouqt5w&oe=6A4D1E44"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r754EB6Xwe4Q7kNvwECJ0SJ&_nc_oc=Adq1ZKYKNoXpNFbLC16xIJSZso5Q1Glogi5WUfWxnuu7yfsKB_c1jb3Er3Ro6SsMD4U&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA2hC43fPwe4qRAzOkD0Oa_cLuX-VDgCoxF154xR9p_Cw&oe=6A4CFBB3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1R-I3z7Ko0Q7kNvwFTAZrY&_nc_oc=AdoeW2HOOc1G-mEGGN-e8xwXckDMeVEShXQ3BnzPtRA73ak8Gcx51M8wwe8WH9xSQHs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBbBS_iWK70VQSpMGtlm2UnHtB0wkPNaGy3D6k5OlqIeQ&oe=6A4CF299"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZfzLmZ23lgQ7kNvwEQ0FAY&_nc_oc=AdpIc9k-5x2fhQ4j71j5WY6shp_ipU1Dn_RO6K7dNNcbDsT_X_6FRat2FTMTXLdB0Ms&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC3G0SE5KzktpTh4MUy0KzcRaKrAvre8biPK30qWAdBWg&oe=6A4CE6F2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
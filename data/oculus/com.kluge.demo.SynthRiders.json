_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_ZoBkIWNqQQ7kNvwFY8L3n&_nc_oc=Adr_yCV0niZ4Gt6XGKwJmo1UWo_ayI48ELFUvnHDfftJK8joZeEn8B9CLQ4jsCeQXx4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHlye3vHMobGGj5TEqbkVSIXMJy1P7s0Him6VYJVXJKsQ&oe=6A92DE30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNGeJl5159UQ7kNvwFXgYAX&_nc_oc=AdrK_ssm6xKCeOrEaxfUhjsnmCU870MSywu-GcAFEUY4-j0zIOVIKsch9K3vObv7OhM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF9wO6GsxxnES0KOSgVMmKB6Ls-wcj-HvVByS7o0UOWHA&oe=6A92C584"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4V7-fFEvmgQ7kNvwHv5Pan&_nc_oc=Ado6a9JifQ8AM5pmx6y3rnnXyvCYRPPfX_IX3i4xFRDLTcQ6CH-lDJl57IcWiCv3dmo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGe6K4eTtWwM_xuEtIZ30H6OXF66bYnC5kK4KTq5pIp6A&oe=6A92DB33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-jIsqUXUdMQ7kNvwGS91Ey&_nc_oc=AdoH8OMJhYGG197IUs-U2lpFC7aoHkdGDBZ_ooLWtc-JFQWQlJ3nVvWmh6zK_YHoFvE&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFsDbyoq5BV4zjKtb8faxWwiFoUPhRw5d4E2hvRngeW7A&oe=6A92D219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z-dHS2kyuUQ7kNvwH9KCy3&_nc_oc=AdpAfQAFZ1GjD3w5WbJxh4jxJNWvPv3pDvATGD69sT0m-ZiFR67Ndg6jhsdFMIWQO_0&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGX1SpfqaZtyvFyEoRcJdjXTPr2efB_LOz1sC7AqN-Yig&oe=6A92C672"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gR4gCUlOSAQ7kNvwEcjvXF&_nc_oc=AdqTXFMKWuKK8Hi38Yy6eiUnbr06SGr1DkvyqwsMvw5x1Jh-BgYkhL1B8qIUY7yLpG0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLepD9vjCySNhue8Tvg1UdUPOsCmrsuLNaVo6i_RUk16w&oe=6A985C70"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocKdP7rCTlEQ7kNvwE9nUvg&_nc_oc=AdrXLjmF9w7d7laxI2kXra0d7NXTZ_ifKs7oHjfL0WTHsLblcQTa6YYwa7dSeTJ9iKs&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLLtlRZrRGEJ5sY2LMNfuiCF-LuFdn5gVgS-HRgJA28UQ&oe=6A9843C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yrqH4yYWWkQ7kNvwFoYY5C&_nc_oc=AdortTiXiVhpYLgiVugd-uImbKoasrZXVemRx_4yHLg2GNkxLK3BLzs0Ot2ikLW4DS4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLMeVhTl0apllRvM8Vdp2xwnu6tDAtFHLYoy-qv5ctH2g&oe=6A985973"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMEalWKJQWUQ7kNvwEroXYX&_nc_oc=AdplEUY0MRfcyO6Dy6bGJc8cN5iYGBmprTBxfvNUgwhPMWm-g3Evja4ej56hYyTjLwc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKkN-IvdADTB6yICv79-UmnMo3zTpa5ZB06z819L94wUg&oe=6A985059"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OFVz2mfeDYMQ7kNvwEq-JpS&_nc_oc=AdpzeRBsXslbIRZ5g5OQCVaIKWPvaun9JyGqGS0a6kR9IUCs1GXsZ2Flj4dMbLfLt_k&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQITIlrbo-lVcr64vrM-q-ExSw_qPvIPpPFo2cgpRIFhQg&oe=6A9844B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=42SnWkTJ64kQ7kNvwHl57xC&_nc_oc=AdoUcBnviE7m0lE4urdh8ZMVHqksb6j7W-BPmB24esIwY1ZY7-1yBW4j8nC9wUSajm4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af3hW5AUPYAxLel1AfXmdE91bSnSTWMG1oeH-uAKMsiAUQ&oe=69EF6430"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45Hb8Dyq4dIQ7kNvwGzWnlP&_nc_oc=Adp1aSdYYIgXpZWooUuCbVL-nf6ENAqs1rH1vb9Tw8td_n9roi17woo2eK5ZNJPe7OE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1MAHeefXhhxbrLZGjoBkFzyI5Y-3KDp51dOVv_GmVyZQ&oe=69EF4B84"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=93pA_IEN2OMQ7kNvwGn_ga_&_nc_oc=AdojhfaqU9wac_Ye3faS0FVa3xUaRwGFqRGJCq6hA7eY2Yr1HNyfBxDCWm_iNwv7jyE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af2EJP5uDoQrNNc9Z7-uNIxNC-jAyaT3TmGf-ljb946kxA&oe=69EF6133"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OI0fU-RBd68Q7kNvwGcyjYf&_nc_oc=AdrV2ZlMXzvbkp9olnPscYLB1LKwKnm7ctLTlS3FthTD4IQVJq94BPqGo2uMASOKdEA&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af0vdUls8_tyBPHzitXoXCS5fFHY4FmFagBDEzgyUieMYg&oe=69EF5819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Sn-0QZWgK9UQ7kNvwHaXDLm&_nc_oc=AdqHZmDBTCnhDwdKukeBKUjfDVUE7hldfXHErv_mJgCS4xq2jwgJ6lAXSGg5SBoF-n0&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af1IXqZMPuxbh-HDGHdaPSa30UZIdEOmQ3w-Wee3dgiMHA&oe=69EF4C72"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89wAhpBFFlwQ7kNvwFT7usx&_nc_oc=AdqfOOhM_p1Y32Zlre4Rh3Ka8prQA5jXe37ZfE69aRxTOtqOenPXA-ji-GN0DJ7pmlw&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDBbY1cKDt64F9Q-dKdBaLjrJ1lCHjb1X-3lnZy0b40Ig&oe=6A4E5030"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fmR1cJeBNpMQ7kNvwEsu9JC&_nc_oc=AdpYz_ugFRguimxlGnMim3K3tUJ1D9K-829GZ5LhTYofKrhJxdtOfdadckgZOqAAOOs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCqWXMzeSw4_KxjTd1xSWFQMrOGs1btMHtjPRumB4W3dg&oe=6A4E3784"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoT5XXG5qwgQ7kNvwHhKP05&_nc_oc=AdqnzRKtOUk6XA16ymOYkOHVhvoZUCXHssm17eMGyfcRkPfGzOZ5QxcblIXEDtHBtiI&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAdZjRiLMGjun41nV1JnBcdD6dcImcsq39TKD2-rmUnjQ&oe=6A4E4D33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n1R-I3z7Ko0Q7kNvwEOgGVo&_nc_oc=AdocLDp_XSEMQGjtus1dNSGEVkPHMp72WCaCsVv-PSe_XJ30OTg6dh0sg0sgZ6j1E3c&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAh8TlERKvGf8HpXM_OxlmP1sJ_S730WZwZnc3N-5LjnQ&oe=6A4E4419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GZfzLmZ23lgQ7kNvwE6cho5&_nc_oc=Ado_bbC-rM0JywYWIKG1GVZT8lFnxSCmryHZ0x8BLshcXstScBrcshUNvEWu7l6Hst8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAzRIQtXPgpmJp58xYwGCV8NJEnF8uUW4oVWJtHaAEBzA&oe=6A4E3872"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
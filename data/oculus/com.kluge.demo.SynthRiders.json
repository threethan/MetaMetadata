_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gf-xMm2W8gUQ7kNvwH4tNV4&_nc_oc=AdosoJNSvjsXyctrT3QcF5-eKQ1pvhBF2pGgp3r_ZWkzKzduw5fVraR8zXSvVFQdhh4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQD5EPX0ru-RlB7viiykgpIuCyg0WVXpLG-29ivNlq1ELw&oe=6A50F330"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIfrguVTq5YQ7kNvwEBj2_r&_nc_oc=AdqPZ3ayU0Mxjw0aGnsDYCTWfSlBI7t8HZWkLumDef12fUvOEk9ol5FYy_8ngfGpJ1A&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDn4Vzn8HKt6_XBdjbP6kFyjVJIzCNJfxG5c_A3MQkzgQ&oe=6A5112C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hoT5XXG5qwgQ7kNvwFN_L6U&_nc_oc=AdrEn0JHiPhG0SoQ1h2hk7iAj7-wBBevEkdpqFLJbCCb9YsWqdro47gPVLCyopxhTU0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQACmgx1ZN_-29tNI-sRpDYamf0TZ2bIb2BAhAQftGZTiw&oe=6A50F033"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5Bf7nRGzMkQ7kNvwGPGJb4&_nc_oc=Adr3_PW2dEDZpFo8InjSC3jH24yB53WQGvXLfi4m-pED9hj9D9eECX_1nGB58UIOhcA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCp2uEJsg2bSdD9sK749sUuQ7hq37MZ-s9fbnfSqUdprg&oe=6A50E719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vF3XckYJk7cQ7kNvwFyO0tK&_nc_oc=Ado_CEE6j055xZljZ6QVyiDV0W9jAhMalNdRtp_ogFbmRcdlUm9yBXhiHP5MLAu0G2g&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAbKClC343gsnKaQ4qg7lRwT9dqTqMOf-w4Umh3VjfVVg&oe=6A5113B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
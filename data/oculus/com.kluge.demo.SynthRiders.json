_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wvpzL2PoHdUQ7kNvwHRGZaJ&_nc_oc=AdpD5lDeGTmCx8ifbltMlK1emAbPvuN49-W8zYfpmJpoBO0M6Z3NdOQNt8NzkWrILhY&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCEWwZLpBtI59UWYOKxgb6_dH1_AEynxdVJZylELE9E1w&oe=6A563930"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XXG9WVH6U2oQ7kNvwGy9f7Q&_nc_oc=Adr17Jr1Fbl6reEa55CW8MENXxzZzFonDhqvhh_a0PTxnPBp2n687yPl-aCGuxbvf38&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBrBaxFXGj12DUHaFrW6RIJh-0eOxZcdliCgSfmONLLCA&oe=6A5658C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGJkcc5paHwQ7kNvwFxGi7B&_nc_oc=AdrEyxNtCI1Ye7MAKAFbOEmobvsu4DoACFXvBkLWF-t6JKtxl7IcM7TeaaGzIb6Um18&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBsMBfIZlLt4zsvS82LZjd2NXNzsNtrUQps4dL9ADaHYw&oe=6A563633"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=H036_WjlUwgQ7kNvwFenrZg&_nc_oc=Adr6s5qEJFPL5xQsJ_YDy1J_fVBQ7PI2rUfHIbp0Cfkq-gfCXkYprSKCFCaEey_G-7A&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAAqDt67_R2YYK1oqylKeSvva3BsBUq6-61bxYDQGARPA&oe=6A562D19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4GZlNkBtAQQ7kNvwHtkuwr&_nc_oc=AdpVtCKmiszW3J3Z3Lh_8u3DzxrTAH9mbhz6ocery-CgQrTjHt4JSbdYorJb190Yfok&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLkemBt3MJppxcVGpBq1Blap_35TUqmqqsLZBAUOKh9w&oe=6A5659B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zI-yd7_gc6kQ7kNvwHquvzd&_nc_oc=Adpu7EGH03lzNnPBTbu-xe-l_dV5V8ynVvno_SNRQ9elAFvWphzUqaYVUwVq2olnpV8&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4oMbEdvDSq8_vqkXVqbUvQasSF2OW4ciGV6d4LWz6ByA&oe=69FDE4B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jVbjeVqxVssQ7kNvwE6NqSn&_nc_oc=Adp5fE5u0fI1SUqspVBFJO9kA-cVhKXN9yjkvVrWWM-ExCu4pOn10cwfJmdM7npF97U&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af624EzJt2Ort8jVTX1DSEUyYI_RifFdD2iYMNdbZoWGzw&oe=69FE0444"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud-5fAKDMnYQ7kNvwEVVsLp&_nc_oc=AdpHMk3-gsxOBDO8QUl24TibDC98lsQhvAEHBjjuOzL_B21dX9tapgO85IsigRaEdGU&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7Wq4hdw6CNUPcgDmt7xwRPbMmjCnJrxTBxY0f6X0K_AQ&oe=69FDE1B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DXu4a0wpl2IQ7kNvwF_AKkU&_nc_oc=AdpWgTncrOuhBZfPV11jeYi8OcONgcZdD53UvadVyJyCh5tnLTI_4zJk2ePRsmnnSls&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7LykI2i6IQodUpMoscrA1o0DC4qBMKOL_UTBrUUZlIvQ&oe=69FDD899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CZaig-kB15gQ7kNvwHpPPyl&_nc_oc=AdpnraTyV12SQUwQW_3BXekLdCNjoEGGcY5elesznHNxQMzesOwg6SOAY1FXgzAYbEs&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4jwPCsrA_lalhRcCSKRrPuk1Vtf8gw5FgPXyFvT8S9tw&oe=69FE0532"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
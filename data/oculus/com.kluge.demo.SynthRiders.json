_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YKIByQrwNUQ7kNvwEQbwO9&_nc_oc=AdpGWdTt57LUHQ132CP9wtgbSuChFC-NnJcc20UxFt-fDbLHnznqmqjSYrxkJMRjvVk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2emuddeyxpUTi-x3cPDR2SR9eVVcE-oNYO4i9A_FPnHw&oe=69E0E3B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ka3h0L23us8Q7kNvwEDAQcS&_nc_oc=AdoxRd1bprcDKc_Wz2iZYDYScslvJ8iINvi0uTKjBtYqczUwm-sqwur25bb1EOwmvD0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3lfT5wC1bb5VnaJJ4eAfNkFj5jbz-1vDuxdRorpC16Yw&oe=69E0CB04"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnVSA7-tNmEQ7kNvwG3hf5y&_nc_oc=AdqC4ov123x48VD6t7rLZ_2R57Pc-lQDwsvK6ASX8VDSk6jj0fZ3NNPjrXkG_C8LKug&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23PXR-VEjlAZt8PE4yjG95-pNkrM5qnoWdK74VfWvc2Q&oe=69E0E0B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AMSM_jDqOsQ7kNvwGc8bu2&_nc_oc=AdrMMfJ57bVVWyRth7YtR2WBcEhjmuVEbGXoctCrZrQc2sjpYOHoZYR51ZshWTgWlZk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3TI97x31OHhjmd62-XZFsVRkc10ugUJkSaZSlrwd-Tpw&oe=69E0D799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqNdc2vTa34Q7kNvwFX6MXe&_nc_oc=AdrqEv0O14Dilt8a2cFM71_FkS_mBHZkSyRRBfR9EaYu5_TLI3fBrXGEqAEG-pHFfOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1o_jnyBtrDuR4z-l7inETM4vAvXHuMc4e8dnMtkcZr1g&oe=69E0CBF2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
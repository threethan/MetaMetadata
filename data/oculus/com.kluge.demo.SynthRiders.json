_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=plBJWEwLzOUQ7kNvwFHd_TO&_nc_oc=AdrD0uQnguy8C2GymvhptdvhYOWeaQEfgXslTYoI51bhJktfGQ_O7NWGHOzhLxzhHvk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6M3BC8LmaNVWsYZy3IOyerwkQXcnVPI2pTfnVhuNrlng&oe=6A05CDB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DpeKERCPJVAQ7kNvwHiADvd&_nc_oc=AdodHydINaZj-LP3qLvW6D-Ah_t3Hb_xKTMOntBpQsB846mNYMiEN6IJ3ViKcLheVl0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7g1hmtfb7DCdn09fPW0tIGa8ZqmJxBeBIR45LLYQ2UbQ&oe=6A05ED44"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1zxy76rFg3AQ7kNvwFsfZsw&_nc_oc=AdqKXfo7MkV6GTBC45aeshicp5gEJDG1pnoopab2wuxtYgFV6XgHv0-c77mWdA18YA0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4ktDn2JWETbbJxSQnfmn8ZL6zoXqAHXWo3cGjAHZY6eA&oe=6A05CAB3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vU0AsvGiVVMQ7kNvwG4UtB0&_nc_oc=AdqmDMJrqd5nGouLdmP_WDDMZhXb8uNiPCbnqashktvHjNc_X5Qrmtjc3VTA8r7rwdU&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af44k27AHSHvf3QUQpWGeQ884oiDeb3lWDz5sDmCdXTX9w&oe=6A05C199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BjEENOJqLoQ7kNvwE8GraL&_nc_oc=AdqHrqygZgUdRlxyXqKs2bXyq_A_QKVTX7tHBgxqhDeJHshfnezf6TdKd3nMcxVnx7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5OpK9Ri9gHtv0wZeKZxbh9z77dbk4xp_Yplq-fZofpmg&oe=6A05EE32"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
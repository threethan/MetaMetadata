_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kvJ2UqZ4O38Q7kNvwFJ9hB3&_nc_oc=Adp6LrPyOQptKIFAbNmTyj4zro3qe-IKN4A14X1ubcPSGuF7emrp4NykXoSc7ZKGWfY&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHnjSFzIvaQB0bpQsG9oeubHzpkj-VUWOs9zDk1nP2zOg&oe=6A733A30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_Kq_WJThO74Q7kNvwFPOpUM&_nc_oc=AdpRS2bOsZM2WTAAFJNdAyOuRHWNogaHdvrgm7wJOT1rEG7Mzh6eilJYvfwuyMNiHWg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGO8XF9L1bIdreWLhJ9bzqqatRm2-Xopq2pFnCQivV1bg&oe=6A732184"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CNNx16lG-B0Q7kNvwGNp3ZR&_nc_oc=AdpF0s7rXI5Fr6rjDWgSEXFY56f0ZzxK_lMSM3SeXGDetgiwyG6eLDCT7T84vSjR0Dk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGTP4Uzc4vXf3f_rp1JxlkI376Lmm44Gu9NxaHPaxBeuw&oe=6A733733"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Z8vwq7o12YAQ7kNvwHJhbzf&_nc_oc=AdrZsxV1cJf3eP0BAlMVPhzBwmP4CPn3NtUc5Txd-RGvu3W5E7nHjcIEIhj5wDcQ4d0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFgCOmBdzldop9Ik126qeWWMp5oskld7rE_oh75rTCwvw&oe=6A732E19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_3rABPxxXWoQ7kNvwGBzTOR&_nc_oc=AdoYKU42CSNzhL3_YgrscjK8jwxfNphHIVbMVLO8892oKMvRrNj5NFkbhEdBlJG1ur0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQENVWOc4n3B0CVtB3Sy6BwWBrcaxgQE97EueOjcY10WjA&oe=6A732272"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_ZoBkIWNqQQ7kNvwFaebrc&_nc_oc=AdrAzAG6xLf-nU-J5xYaRUTDrFNMfZuyFGM8j9KcEmSot8EJaG3Rq4stH-9s-saMz8k&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGwlSh9vvHeiJxXapGhoumY7_5aKRs84nGHJ4hvARYsEQ&oe=6A942FB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNGeJl5159UQ7kNvwH8DTtO&_nc_oc=AdrFnRe2IsNXerV2hG8sTInG208PthZ244GdiddEOk1DC_8lb6mUVDwdC2G6KO2i96w&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGV0wMGBJTd8jsgF8p7VZ94w3mDckSIytH064jX0xHuZg&oe=6A941704"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4V7-fFEvmgQ7kNvwHgdCX7&_nc_oc=AdoYssq0itIlKpn2EQKFPX7hkJzrqYqNqwECHfl4ATfF1VWLTSJaCRTuTa3hJYU6REc&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHaHnZQuapHM5Nld76dA970DWfpR27E6xrq1JZx_810BQ&oe=6A942CB3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-jIsqUXUdMQ7kNvwFoqw3L&_nc_oc=Ado5AVlV9kw_LzHp0pywu54JdAsEP_WLOIevmbRaRWgUTE5AgbNA77_je2o9cIak6_U&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG-iLeQgVtxzaYB50G0aezJNd2BehhTZv29aqum0NTAOw&oe=6A942399"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNAxY5EiVwwQ7kNvwEbfFb6&_nc_oc=AdoW5ZkbEZz9F7rywHxjDn7Wa6ACm6le5KAaIgEHOa_6UUWNKn_eMJYTF7UtylLyDbI&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQxO5w0LX-7Z1SPsCJAb2KJZ9-U1srEEoNStkXZ-bsTw&oe=6A9417F2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
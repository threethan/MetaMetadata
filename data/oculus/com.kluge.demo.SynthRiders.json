_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OEJmIOHf0yoQ7kNvwFHpc5-&_nc_oc=AdrGmwX625p4zOwk24t4E8fGLnf7CkVXtTccgZnSc-g1BGQJ7-Cs6aIK9ndu4jb3TQg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3A8u3rywwBKWG-Spok0LO84T7zvzOieUErSyS6Ofe6cA&oe=69DF9230"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rPZ9UvVw22wQ7kNvwEpIflB&_nc_oc=Adp7COeJD9pEzoHTM7g0P1n09MYHz4983tW9vJMBeFfoPMJqM5tbEz7hqxZON32_SPo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1CGlL1ENuzWrEdF1aUQTeEYRCy-GQGJGH-5wWfVbeBUQ&oe=69DF7984"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnVSA7-tNmEQ7kNvwEIv1-a&_nc_oc=Adqgm8m2JbNcwyVO9BeAkJDftMxlMeCv_WHs_r6e2l6xogtINVeZ4JTQS2h9XTJkkho&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0W4T1UvDsJdOYuCtokWlKQ_s8_Dea6sbH44bsxdrNKrw&oe=69DF8F33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CWrrM2jp9iMQ7kNvwG52gP-&_nc_oc=Adrxvi05rwjwCVWWQ5ihK1vn95k2rDa8WBoMfPSDTbgFiVdsxdLj5HjzxpGv8ULOPtY&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af21BA5bFLNC7sP6EFhD4ZqYvPzICvtpu5yJN0zPVlY0NQ&oe=69DF8619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RqNdc2vTa34Q7kNvwFLpr0K&_nc_oc=AdoxYzer-j80Zz8kwpGeKFMlY3cIFO0Ws3igCkrOOMcAjR0T8eHkZM6sF0ZTpOiL8JM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2e2LVpZJjiLgpXnVcMPggtafKMFTOEdmy-Vg0FVF1bAQ&oe=69DF7A72"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
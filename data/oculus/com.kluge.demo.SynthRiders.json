_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gf-xMm2W8gUQ7kNvwFPCMDA&_nc_oc=Adql46MM2TjMN9Y_itacz-NYTdf7zye83kP4JKCBIYmzoFgloEE-fKkadvS7sN1dnF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAeKH4uAEKApOtB4sRRxqCT_ni0HdBHkA0pMmt1JxukuQ&oe=6A5244B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oIfrguVTq5YQ7kNvwGHaOX_&_nc_oc=Adq9T6aQY9KoBuPIbchYZFsDUsQcZsBzU0kMe8oNqhvQ_dDJnJFvIFzhYDq_dS-w8js&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQABbNtcx7Ke0avn8CzZGzQd1qFNl_YETd-jJh0-DltpaQ&oe=6A526444"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cUfOYDpEp90Q7kNvwF6WKzE&_nc_oc=AdpOY7TzudEb-tA-U46wgSF_sOtcezGXZj1vlNJGQecaCAZgKxvL5QVrU6idkE8Jblg&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBx20pDxHeidg5Z20wDWVQh8q0z51xtkLc8sgHjXKjmJA&oe=6A5241B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q5Bf7nRGzMkQ7kNvwFYq7ij&_nc_oc=Adr1Btz-E-VWgM0Ulwx4nX8j5_GhhpyGdt6OBf8uUxieBp7Ql_HnrPirR27U4H3VmAw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCAIsXGprDlTdWhvatnwQtkYD9OAifK7YWrNDbFGevjWg&oe=6A523899"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vF3XckYJk7cQ7kNvwEqPOOI&_nc_oc=AdpwyEjuEvtuJ-SAKhjL4hZKzqGMilIRfJqG9Rfo8VUpEMIhtCu6f--2yCv7KHXU444&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAw-GfLGeC0a-dGLquPlPt6hRAzWKVqo0sV_sq1pUVrBg&oe=6A526532"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
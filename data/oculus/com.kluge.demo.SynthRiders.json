_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqoLbfrdkl4Q7kNvwGwZtR1&_nc_oc=Adqp_wnxJHztIXFLf4eSWi3Q1g-0KassiIIpxGDdufHVu7LiNu39or84xaZLW3if1U0&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN6PCGX7CrGLxBQTJWmZs9Z-kCY-t1eC-VYg2Ffldr1hQ&oe=6AC8EBB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11gPMANeeXkQ7kNvwEPZzUW&_nc_oc=AdpBwUmPy2ZfG04xvxUVoKjiQvjDabNnbTwOiAuONjXfJ9UNI_mLi7R39IoNCNvnzX8&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMUOY8Gr3VyAS9wR2Pg1qcMLB-yITCSob8OcKem90SYpw&oe=6AC90B44"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPgld0D0nQUQ7kNvwG9vN9L&_nc_oc=AdoHtlUsbS5Lgu4pSmhgq4WYJY68tW09ywYpJOSHwy7ydzTDgREzsAWoYQVPRTAW8cM&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQN9o2I7w552ri6GkwdPJfPmvrQpo0z_EFWbFwAHCOYk0Q&oe=6AC8E8B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXgTXsuyyR0Q7kNvwFiC63q&_nc_oc=Adprfh81Ml6mopwBJqTcbCGyOoKAJIqgWSIKo2lgW0IUMmfkzodtqbK6WXpinJvYUDc&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPuUfpEggNIgAYyw61ktmd1O0iGDXjKW1VwJQNL_73fhA&oe=6AC917D9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJaL_vILVxcQ7kNvwEZYukb&_nc_oc=AdrVyk4MS9_s0gZ9lnC2YoKt5_jksqVz62S9zHmwydEc9zcsbHropeU02-h9jGYeOmk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNunrXyNjUzORe1aLc9gR0bnUY04krPoJ6jmVN1vKStkw&oe=6AC90C32"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0XYmNiotq0Q7kNvwEGXBI4&_nc_oc=AdoRpTn1qhNKND5seRFpdDeb3Q_ZdCDBcspk_WfuBknazPxMshnhBbmaMVKVGHGJhOc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af643UJx990aPGa1moosWBJ5FWvlAJcbvsqJF_ycOjgQAA&oe=6A0B13B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pa3k2VKRriIQ7kNvwEBSNjc&_nc_oc=AdoEyOAyMdcdlXI1eq8hHSzsEObjFFCHpJDg9VPJr90W3e4sV83QhjUHs6H7JpfUZIw&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7yJ9ynNb82nHaYW_PuiYoE6IBRXjBHpbTsR0LXkTYG0g&oe=6A0B3344"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=M1V6QelJHhQQ7kNvwFUE5gn&_nc_oc=Adr7hz9TSKyUXZziaA54_OtnxB3t7Ppj88yX4KQyXEmOQpIjXNkoCjI8I70MuIo9N34&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af60fSkmNaUkU_Q_OH7DEWmOWzDkWfZ4HKo0f1kP_XX52Q&oe=6A0B10B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q03zusnvFnUQ7kNvwHrvS1o&_nc_oc=Adqf4MJOOCzb_xtSAbUY70_zIYFLUOZ43D18nSqllBDYuTbkrSmuoYs-WqlQMalxuUg&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4UJUbSuFh7ZrkovL2XskdzaCeQqE120MsEhLhkBau6FQ&oe=6A0B0799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEzY8-pFeFEQ7kNvwHXgmms&_nc_oc=Adr8RKGUR_hUvA_EgxqZidfzy4s7GW7mRXzqEgkp4Vpsv7Pkk6i7Od7H5-Ps18U1P7E&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6_qLKE5rCHiytO_V2zgPpXt1sCkHmoy-JwGgaAcO5xQw&oe=6A0B3432"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
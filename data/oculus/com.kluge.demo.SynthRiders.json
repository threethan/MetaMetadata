_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hEy44peiNAkQ7kNvwF5uQ1z&_nc_oc=AdrICvLxZOW4tVgrJ4_BoeaxnVoht6iA8-9iy3ElfCfiZ_hlsvhJ7DssMpCDXqnzZO8&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDbVvmrnTNaUbHxJBir7zT9sDsd_m_TtZscZmjetgqjgg&oe=6A5B7F30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QPkVkSpmnAkQ7kNvwHAOmO-&_nc_oc=Adrhl7q7kyMe4-LaoDpgrSinOWNa0XRTvwbAQpHXfDxWVkNA7bx7AYXC7q1LXxK2bZc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDzKCWRqXx9SlhlgmMvDy0oIRj4U7qi_vCnA9j0K4vAJQ&oe=6A5B6684"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5CArC6qcv4Q7kNvwHQ0agV&_nc_oc=AdpEumTqPvRb3ppmC332NsenPjlDcqzlzaYx72SuIiTQAPzbDyIApp4lu5kF7AjXPC0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAq7IKMOC5zDFOHOT6_gNuRrfQLDCrfS-A6QVFFD-Qrig&oe=6A5B7C33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Cu01ZMHBGXEQ7kNvwGnVlQo&_nc_oc=Adp-j0bY23pA5kM646WRgB2vDD2xm1VEevZAuaZ5QQDMa2kuoNLWRecRSq5usCSvAxY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLgE2XOwfO1nfmv40XrXhIUE2Si5E18Y_DvD9Ond7dLw&oe=6A5B7319"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV_Ou81x1KgQ7kNvwHFtFPf&_nc_oc=AdpWlr1S0gfszpLquyBwpN_ILeW_jpoQ8RAGSf5gv1c6vjEQ2L4M8G_-e_8kA4WnnTo&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBdQ9QU4nBqVeIBDVIy9LC_fUMp-KLAG2SNFmE6Cxahkg&oe=6A5B6772"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
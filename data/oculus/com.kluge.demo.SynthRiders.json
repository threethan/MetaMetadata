_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnLe5vKkOggQ7kNvwGRXj-L&_nc_oc=Adp9JOa5DO5wW9v6A2HDdf6GxvslqfcPHCXuSVGRifQG9yn2F84yHWTgg7OannhcgUM&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMz31v3C19SWA740A6jVe3pJQXKQ1NvclS7uJgTurNlZg&oe=6ACD1870"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZftxIX6NRaIQ7kNvwGsTC4p&_nc_oc=AdowIUfsCsO6PTcnAJ4vuQnXfROgmfOFeTPzzMluSLqt0yPlGp9myJx78gF4jwhXtQw&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNE8wvwzvy72atbCMK63Q9UaeEl9q0PQMPWChjWmY3soA&oe=6ACCFFC4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZTQ9QyxL8oQ7kNvwGj5VEa&_nc_oc=AdpEK2yWpYGax7IPpISD-n9MIRWCaO5WIn-hCaJP_UT9ZWU2DBl5SzoqVITxg4BbE68&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQON-K8iEct5LSJFVKosDRqllFRRkFhZxnag6BXKQ6zWKQ&oe=6ACD1573"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJWdWC5_2IoQ7kNvwEGU9LV&_nc_oc=AdocWtkcSUbhKrcQPxFCbFVPVICmaC19m7uhmaEinatXyKgK0YSnY8owAui_YAQJMfI&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNcxcAEp-eh5xrFn6Je0bdA-iovd2VUiyXZhyN53rQvIQ&oe=6ACD0C59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkSF5kVCAXoQ7kNvwGZSLuJ&_nc_oc=Adp2_1zf1hQv2SO8P4I3u4HSNDbMg2NsISxCk8ymhC3UhgfD1PuWllwT8aeKWIRZzQU&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPrV821fWsGchoatqCnsVgCCCgX_phjsqeIFOSdfnJhSQ&oe=6ACD00B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnLe5vKkOggQ7kNvwGyC19A&_nc_oc=AdpLlAv5oll24tRJW5x3ZXzG7Kl_7Vmc8X6T7JfrKzgyjH0xp-PqZZcHHY9sT-nKU-s&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMYegyqThGF2LhWwcWuAeXSgC9SJvGZloIsJzsxIZEqqg&oe=6ACB8EB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZftxIX6NRaIQ7kNvwHwG3fP&_nc_oc=Ador5aHvotQltlO_KCO5pddyOlWOjCTMYbiRbGouG-m_fWfWMdSN07tCE4zEt01JOHE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPEkQYfWOfoDPqYOuDBRs7bA1akg0EmRhLBx4rZSH1Meg&oe=6ACBAE44"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPgld0D0nQUQ7kNvwHvFakM&_nc_oc=AdoG6WSXV1WO5K6j4bW-5yERe_nI3tM-QCqalmewlsZAXbndO7P4LTGbq3tpEzzHkCI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPCbr8Qi9TlWg0kFZgaDg4rZUXvLah-quQxZ7UwBPlSvw&oe=6ACBC3F3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJWdWC5_2IoQ7kNvwEREL9I&_nc_oc=Adq8dSsAtCg_XIoQB_-L6XzXq3_IRq4g3a3qGQ2Vjmyejke9HGKZA0ADPIjzRBbtwXU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPhCNG7AN8lbE7tQHuCO8IfPgN7YPJVHp18VCgslVYC_Q&oe=6ACBBAD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkSF5kVCAXoQ7kNvwHxpcfy&_nc_oc=AdpP-HGvxFZc87ha2TkZColUFB0_5sd2bBSqHQF5Yc7L4BjGrIp_-3x7d297zWf2T4M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM1_mZ9x4bnSeXF7MF8viZMA_aRc_YhK1PYcJi2XWT3qg&oe=6ACBAF32"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
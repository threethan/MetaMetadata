_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGDY1bTdBUwQ7kNvwHByl_Y&_nc_oc=Adqqnh0jcwHL3HeVQmiZR5mAD_FiijgXhHF6pW3mvfUZxjEne7SA-vnp2UMu_VeJNBk&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJuaVVj0Ucb9lyucdGjVG0YwzYN_THFWR_9-26YtxsgIA&oe=6A9D6A30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwIrfrn2bEQQ7kNvwFE4IhG&_nc_oc=AdpkpN9AvuMjy9mjcc99I1jjPi3UcxOTeiYOx6ImSvy7JY0rsSofUhQocxx-fjSFE1Y&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIKAh4wyEsE_jGnEdNmTko3j7evuc_lJCBoTThNZOGMkQ&oe=6A9D89C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GO2rGXLHWJMQ7kNvwGxDa92&_nc_oc=AdqzpEx5we7FXCSFx8clLbq2TxLi6vJQ6kt0_tKvUc9wEg0G3xgAsZq4IGDKjR8Py9w&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLmk20v_oZ2pDJcJV4WUdiCmClwq7iOYpimPkFzvmZ0aQ&oe=6A9D6733"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6kGnB0PZaUQ7kNvwFcH0FY&_nc_oc=Ado0v82__iIQUk-CEfEtXdqxokjihIGdLAYXZ87cO9O8S9A43S_6Rx5Jw7pi8fBL4QE&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIz-JYGOMa6ldk387SYqs8V9s9BjRnZw10NTshJ9fUZ_g&oe=6A9D5E19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S8gKJGojUEQ7kNvwHA-6He&_nc_oc=AdpWEBHc5H6t2rUvmQ1JBGOluNZoP-PGGWXlRt-aZUg2JuhykkYSauNUp7YzQjFBN0o&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIzlgFDEMS39VbAbCOlnIby7T7wbtewLCfCojFvlJPP3A&oe=6A9D8AB2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
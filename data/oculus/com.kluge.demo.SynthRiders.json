_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4X8M-8Bzy4QQ7kNvwE6h6hr&_nc_oc=AdpWcyoJD0l8TcIyC_Dz7gdowQ2LfOPcnAbTAa-h3afB3uXoXrvbcivyEtAELnWLflc&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_0rHTAGnSC58zx0LNed6ATyd0rmsg6z-HhtfPQJ6j9YQ&oe=6A412130"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gi8ubnGyiKwQ7kNvwHq7g_D&_nc_oc=Adq1NrEfMa30ZD9OZCbjO6-eJFs_DHVMg53hy7b5k_Cp1Gv8DKjz2u4JqKJlXzHOcpw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-YRUflQu9x6YAZOOFCZcaIOV7lAD6eyF1VqnbkEBjQRg&oe=6A4140C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFN0wPOgjJUQ7kNvwFlFz_I&_nc_oc=Adq9GNghs2rnMDSMJR4ttpVTveAz__AouYkeG5CaJLoi7VmOHUzT6d8g2lFydtTXXnM&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_fqWi2o31zdvpNm8PuE1Uxk6xgqKMsp12VFD1fD_jLuA&oe=6A411E33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PamzpeCxRAQ7kNvwFRbP7n&_nc_oc=AdrS-xh6v9jCVH-VUgNDYxFSUjmEZsZFZZ-MR7zwl0_HpX-dHkHZNvlQC58F0Tfmrhw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-BE4FXenYBT3jdK1fBm5eXNzSO4JiYaP2OTZt5TzXfRQ&oe=6A411519"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=g8JO-Eexe2cQ7kNvwETcaAa&_nc_oc=AdrG2RAQO5nXlaUVmJlsHUcgDZVtvXcCxP4vwBL_f3wDDtwSHLRuElgw4fBhoqt-CXU&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9A1932H20Ou_q8lVHqlOBd432Vr9YlntdfyMZjSYd5vg&oe=6A4141B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
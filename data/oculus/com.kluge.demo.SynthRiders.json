_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAlXf5Xqy9sQ7kNvwF8W_88&_nc_oc=Adqor1aSsEFeoXxn7EqhQlEbxKrbbi66_tHL2TBwepCvKV4QBrENLTNEbAZMzPDVH0w&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCSxhIuhyJgpQq_y2ypLfqp4QF7OAkl77OLnWmCJzfwcw&oe=6A5A2DB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuOjNt6kLN0Q7kNvwHvBUau&_nc_oc=Adqj9k6kKv4KrFWbtWuhiC0QZK7NbAM5cFvRIOJY1OKzZFl8s_Rn_fM6nGV1S0TUJrM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCIj6TqwtMjmarJKVP9hRNeOezrBaG2HBbo6qP_UWVauw&oe=6A5A1504"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=L5CArC6qcv4Q7kNvwHKqVNF&_nc_oc=AdqEJgiAVF-Sm8uF_6btvct28dbIqxAb24qMjZsX5bz8DXGIbS5JyHDld1JBnPqHD-0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLHtc6JDiG9QCiaL2i2DnqXfEQim6NUAEIYccoK1xyTA&oe=6A5A2AB3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1zl3bMqAjoQ7kNvwFR3obV&_nc_oc=AdpqJJww5C5kBGdHe1dqWQ-b4awYH08nRjmg3e3A6lxSFwCKalhnMm0AnuLg8OZ0B78&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAHtPPQryz-a2_Sqm_XuXS9loTlWOKOjgzgyl2pPREhrg&oe=6A5A2199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV_Ou81x1KgQ7kNvwGAaFzk&_nc_oc=AdqbKr_7AsRP4435yGQIjuhorJuATxnZS17wRpqPtD__OrLJ-iYIQIUezYHv87pMgcE&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC5-Z22IvaI9lW7h23jDWmtQTX3UgvyIUsJhRle9qwfbA&oe=6A5A15F2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
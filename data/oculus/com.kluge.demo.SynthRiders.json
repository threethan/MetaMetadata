_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4X8M-8Bzy4QQ7kNvwF2f9qJ&_nc_oc=Adoj974NbOq9K040NnamAoNWvXBrnFJq2S8l24gpCdqmZYQdJjrlqu3DM4cBItG9YLU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8pMVLUNpf4nR612kXA5TNeSoYSprQXw94kRqxp1cin3g&oe=6A3FCFB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gi8ubnGyiKwQ7kNvwH8ILLI&_nc_oc=AdphoRiAfVoVeaPJ-N8iJJxyb_2bVBIOeCbvyocKEXN8bcMiCEOhMy6h9o8FCHIdFFs&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88QwjU3Alut9edlOncg-0VjGhXKt7Idv69r8QiCBxViQ&oe=6A3FEF44"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFN0wPOgjJUQ7kNvwHekrd_&_nc_oc=AdrxwSQaK49ovxpxRGwUgFXLpFjgfNjoKD5CHPhTj8jhz4KfKL_pISpH7mCR0li_M60&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-2gm_n2jvmB-4k8MJblXcw3D82B4geqiXhctX1MedY5g&oe=6A3FCCB3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5PamzpeCxRAQ7kNvwHBfDAc&_nc_oc=AdrfcJYMxCa6lfg-42SIbibzbDmB-NJ7gFZbX_kwHIcJRgUGS6Y5rCTVDDbopCm4oYk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-5z0ChAH_va60PvlSYLknSKxqr2YwQwbwgA_nL88sZOA&oe=6A3FC399"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlQsMquNZAgQ7kNvwH4t9uk&_nc_oc=AdqvsXfnJ8MMEdJKo-NMdaIrfaAe-OYjvIih8k7253yCJQBgc2TNrqDM4u7_nWKj4JU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_vDzGd1H4fQ19gaUGg6rqzhoS76H-hEfuBJ1Gbtj7TDw&oe=6A3FF032"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Gk_f-QbWY0wQ7kNvwF2ry7V&_nc_oc=AdrpXmpBjfXDDjY3NJcN-4JerO01fmfM3SLN36lmf6tUZ0sgfLD7JK2TZyxhV-B6Fk0&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8Rcveha-s_hYAaXYBxN9_vqLzvwfyCElMYikFCng1m_g&oe=6A33F230"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0Z523968NOwQ7kNvwHsNhop&_nc_oc=AdolgEtdwBD3FtORDv08XMFO5fbnKnuFZbW9OrXscyIc9iuMci3yJceMA5ghY6o6LgY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-nGnGh4yk2BgXVf79Z6BTM1rXsasl6S82-nHlRxz-4-w&oe=6A3411C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kweMrPpVuWUQ7kNvwGnqjQz&_nc_oc=AdpjjQW37BMLJ4hDfS1Bld4gT_U4WQ5l3lGMQ0m0WfFe2tiZX1dqHqmzPv-FBcpN56w&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_JrHeuHA3WnRI5fENgWkxWjVZ_QDFg-1tKbO29rohdtw&oe=6A33EF33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TM84bi9wRlsQ7kNvwEYJb3m&_nc_oc=Ado0I4V3FXNNbBgXWL4R5IzQEAT2fnaZLEoPEExm8F1wxpqUs-q37gLBJ27MHon3V44&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9ESb5DXZHhlaUkPmPNixYZdkCgJVKsYrWhIudj20dGoA&oe=6A341E59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gGsRnQ0_eD8Q7kNvwFfjYor&_nc_oc=AdqxAa28Q_Dpw_rTQ8IaFlVAbuYKe_5uXS8CoKu9zLB_8tIOuDsnpqc74ohqpIF3XSg&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af88xM0NrZKp_ZHLBlhsjUdi8IMzQIj_72HxiNRoQW7IHg&oe=6A3412B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
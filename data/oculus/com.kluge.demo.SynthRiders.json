_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9YKIByQrwNUQ7kNvwGbNp-J&_nc_oc=Ado1mO10sWgeA6YH30NtLPVXW7Z2LYMEjTnYItx4rC_MaOsnoSxLGTkR9RW8BjNdjh0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3C8guNv6wSvcbOcwWnB0xpRaTwkdMZYRC5VjmFZ0Ev6w&oe=69E23530"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ka3h0L23us8Q7kNvwGCvexC&_nc_oc=Adr1AhYdeL7m_o-ESc9HBN5gIpj7nNUQc7IKLVrs6s4KoXgIIB5_UZq8h35Pbj_kvI8&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2T9SsUIHki1Zl9ip4gNaoPdvSeK_-lca4bu0zRtIL05A&oe=69E21C84"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nnVSA7-tNmEQ7kNvwGlLdsV&_nc_oc=Adpir0IMxuX3jUX7jzTGVt7x9WVk1r8mzuRDig_Fpz2gkb0XfBePfpRZQ6OOu0WN5qg&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af2lBz457Q6hKBSJxhE0Rf7-cFkIigOCzOaLFYCB94W5Sw&oe=69E23233"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5AMSM_jDqOsQ7kNvwFuvl8a&_nc_oc=AdoukMNwsHOs3NkxnIN09QU3hr0Qn0OVWogxhgt-Ie-JTwCmabsviR0zqQrqFJLvpK8&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Ay9jLMV38pNkvWQKvVf6ROlLT6vc0B0kT9f-mMFsUVQ&oe=69E22919"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vSF09Qv8MYAQ7kNvwEwDTaR&_nc_oc=Ados6BaTEZcmjceWnjwW_DJ-rJ5xh_Zgq9CrDFNi6Yi8gf6EoempRut_KSVZHMy7t38&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3CjW4ET04_9fJLnQ2iWeYaGJKRjdrj4JxEJou5m7SDMQ&oe=69E21D72"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
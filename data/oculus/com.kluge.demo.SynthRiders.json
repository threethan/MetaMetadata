_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7zJ6wJfHtZsQ7kNvwE_e39D&_nc_oc=AdrJwZZ-KuisTjArnGFuudWa8gIRYKO6iHeA89CkOxTYVyTgAb4ErRuJyFG2389XaNw&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmIuvbuNr0dNLJbOZXtbSA08HNLcZHxCy2-13WVpueVg&oe=6AF9EB70"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j-3HKBQHA68Q7kNvwHkngl8&_nc_oc=Adrb4IED-g3HXqojgHY0Wr0yFITYa6Q7tWLah-C3eybJQYQXvcwWmRPYKD-7IfWk0f4&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSL_G687n6YBO6CTmwsJnniMhDnZSGEk3XTkv_aRDJRDw&oe=6AF9D2C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QNBaqfaRsPkQ7kNvwGlxce3&_nc_oc=AdpGJrEeRtRjHg-Xrlt1yJcXXnp4o5Nypc9d5MynsOoiwk4W1Yi_uQlj2pdhd-nsKnk&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSB5353XpL_qPTLvpQo1UctNmZW-5KOhfObp9AuV519dw&oe=6AF9E873"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5nAhHws-7l8Q7kNvwGhI_MM&_nc_oc=AdrzqrFo2UaWFkTfRGIq6soJ6zUdU6OK9suqCJhM89KNWrwejCXn5T8drS84Im0r7EM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSccwlZEnRDOg3bCDWjc7lIK1rCcCDSKnvnMKja14rPog&oe=6AF9DF59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZbXDe-b1Ao8Q7kNvwEur8Y6&_nc_oc=AdpgLgue_C3FYuvh-UFiKVctKKeHEgMgVtmD2Y4wtzyK_Edf1dqjOHTdtzVMLhUIXkQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSr5HorqHzhj7Xeb2s5h35jyKLDc56hXOD8KxJmaN6I1g&oe=6AF9D3B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
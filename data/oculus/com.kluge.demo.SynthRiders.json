_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z1WDX2UnlGEQ7kNvwHZmxbt&_nc_oc=AdqX01y7P0_MaSRVHpH168OuVsiAbzdOzQcYgR_lISW5y8dlEzpUAGbfzs9G6MVHETk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8e_JyIJua2PBCZnSuMJCZ4TpLmKuM1njR2gn1Yd-G0Cg&oe=6A3E7E30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-Ojcd0DnNBsQ7kNvwEQ_VMp&_nc_oc=AdoubnPtaLhlVipkX1wJK7cs2xc8iDtNpM8steKVwfS7DAox7Dgkf4ybtSTqqiMNLv4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9fKz628o3JjFNOWaM6wzIOeSIBmYRZ-luwOY0EbzDyfQ&oe=6A3E9DC4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=oFN0wPOgjJUQ7kNvwHir5PC&_nc_oc=Adr95rPiW8Y7eKP1Uo74J0XQHYmuphZkA9JtP26ONMfXnw7VTX7n5-SoK7eDsTA4CkU&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8IlfxuwPQxmxCxqnAzeEoAiU_r_-ZeW8am_a7_CB8z2A&oe=6A3E7B33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SawHqbvUeygQ7kNvwE8B_PJ&_nc_oc=AdrEfT08AlPMJeO1cuD16g1H20vX5AYhq72Mpo4mWnu6LAHmbv8_zkdK1RrN3B767T0&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-1mvIDbMjdj45fTa4rlb16fTSdyTMch5zssvuPP3eZrw&oe=6A3EAA59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FlQsMquNZAgQ7kNvwF87uO5&_nc_oc=Ado3RjeqRsvMhboBBwsJnlwzJzEQoZ3r2t1WVfkAmPqoc9kJjeRWvsoajnHmBiyJn7s&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_J4jdgDw4haMgz9uCMkjd4SQzWeBcpfRGTIiM7Uk19kQ&oe=6A3E9EB2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
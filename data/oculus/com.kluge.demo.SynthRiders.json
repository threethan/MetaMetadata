_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S5G7v1oidwQ7kNvwGEyxcH&_nc_oc=AdrQfByNO7ee4jTD2OUaraC13P1Xtm2M6M6j_di1PYep162qiS9ZXXHK-KjEUl9hydA&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz1NM6aqsm8Nd51cHg3l1Ib790QE5mqSJJ_IVz4TaXdUg&oe=69CA7A30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GYaJcH9vn0AQ7kNvwH1B_Co&_nc_oc=Ado5dxOzld8LK6lMmhi0aD3raAk6YBwKt1fp2LSF-Ll34iTDICN78f-7WC3nw8VRnJ4&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Afyp1FD29T7LhNPTIamfaD_fDrYKXvOOVKZuVX43sjZUpA&oe=69CA6184"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KAKp5TZOfAQ7kNvwED3wlp&_nc_oc=AdrInZUt7fuApHFxxnKcyTzoVvhM6mevuKLJdgG3kFqDsdcAgDD7qbSgI3xB0NXFXTs&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfyI7M9MHik4fjfOkePb5bdeW6Y_XG7SUt84pTtc5VcApA&oe=69CA7733"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Pwp6vAWn5gIQ7kNvwEJNsnH&_nc_oc=AdrcjxwziDRx1zmJn4qCVx3SRfFO0jX5W5X9lLZJkPNJvJRRQV6MYHJhrmcsB97_lYY&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwjJWqS7u-YiEfCQO23EDDcq9GPjO6-w8LrmxYRBnbfJQ&oe=69CA6E19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DgJvWhI1e4kQ7kNvwFniio4&_nc_oc=AdpWmwiYyw19EvkFhQYIwJL4dVmPOaSzzjGQa18lJeZuV-CigOYJVYXtl2uS8kZcEdQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afy_x_un-3zRiV-GLwvlHAFEzoDjvjG2Ifvt8SWyY7-tQQ&oe=69CA6272"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
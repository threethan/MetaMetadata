_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ggjHfenPR1gQ7kNvwG1Z2Tw&_nc_oc=AdowxGdHFDC5SpM7rQjp62ZVDq26zV2bi1QtbUOVeDqayftkD5pV-ecWoIQXOcQR5_M&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDGnJ8tep3Jl5g95RhL2sH-IpVFyBYlUl7xxDW189CzSA&oe=6A6B5130"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bH5SvqJg6YkQ7kNvwH4GTxs&_nc_oc=Adpjo38unfOfF4iQeA5M4XkRljxXHrYcSl0JJy4Q8LPEP9TDGOH7Tr51Q9YJ4MoiaHU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChZDtaBQ9BXeuweTWZ7ItpGUF5Qi9PmqsNeMhVbo126g&oe=6A6B70C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DqcmS0rmpSAQ7kNvwHoewQU&_nc_oc=AdoNwISBn53Lx6B09fX-3bEHNSh1mZn3JVBd7_zUmwRmtAkqMfFjLwCCpzmEg_RGBB8&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBlkjEvGkLLZvroPpgMwPSYQPXrMKwKPrQ1W-9b15E86A&oe=6A6B4E33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Xeje9nZA9a8Q7kNvwGfatHS&_nc_oc=AdqLsvQbuYxHTTmR-9fYGq1jejYBCMLfOIUS0N-Et-MRvv_8ikDD48ux3cg1pJZHhl4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCL-q1gGxGfIe0jtM5dcmsbGSjVIh5L5vDaiXiUiW_qGA&oe=6A6B4519"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6eISVuXrrA0Q7kNvwEZ8wBA&_nc_oc=Ado-0hsr-iGnFkl0LlZhQnygkBXxHdnMAMqtdu7GC35FavIHTL7oHqqbNRW7d_HRviA&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCchvS38JZEPOl6I8TxfG97-YtwCLKEyDf9iaBEJV7LBg&oe=6A6B3972"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
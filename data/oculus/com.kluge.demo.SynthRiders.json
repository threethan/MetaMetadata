_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wj93I2LT87gQ7kNvwHP1PNb&_nc_oc=AdrBcVzzVjjLktVAUPYjfUBttklhkOuKfzn_Qf7kBiauJmJamGEIU81Trb9CKL4YdZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQECbh-d-T1jSbByyBy_B4fePvtQAT__9Z6nv4Kq9M_AdA&oe=6A7B2330"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89S4wWaqU0UQ7kNvwG7-T7n&_nc_oc=AdqXru1Upo8PwP-KpIrwlArn040I7CPsjJYh89maKNn6wqHQWYSFspSoUVyKpgz97Oo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGQMYeLq4juk45uRFchHGkBvlwquMCv183Gz2NIzMrkSw&oe=6A7B0A84"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vpVGMz9Bs5EQ7kNvwFbfmEi&_nc_oc=Adpgn6Xnno8R8lmf92ACF_FJOXSenIraJYbuO4zfvovZYAkx4NPqGFaMYvLcE1WdwPw&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFzaaAhhafYI9DEBc2AwSFF8BGdcDycyIwHG9x1YrC9vg&oe=6A7B2033"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C7o8fy-O-rsQ7kNvwGpOKCe&_nc_oc=AdrDNEWpAT5hHM0krBfykwP1bGEqQbw4U5PDkQUJcEyqM933BXmpDKPkIsUQhvNn8-o&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF3yY00HpPfKj1I2LjpnT6nFcF7VB8bajFqXjbkZm-RSA&oe=6A7B1719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZMlqKcsOk1EQ7kNvwHiHZHa&_nc_oc=AdoUptx17Y4-rlNKDATqMbG31HmMtIOvYVkCd6CWxMQ97PFdUbCMMl3gpnkeW6OnNiE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGk6K_es7x_cCivnSHr9y4FPw_SYp12ARR41Wvyh-2xcA&oe=6A7B0B72"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
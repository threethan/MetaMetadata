_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSaCwdPsX-YQ7kNvwGGUfXv&_nc_oc=AdpfqYK8gq4bTnsoGEGJhpCwujhSdxZstTsDWNCFXGKXD5VCcbgUBsdSGEvbcHZcVxk&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Afz8iyB4ufasqrlTCmTLySPdUIj4kDx5S1y1GzTz71fEDw&oe=69C7D730"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1oSdszvqrYQ7kNvwG7jDDM&_nc_oc=Adp21aKQ5I8XS1Il8r0iLG_7OT5kRUiG26DLCG80JoT5XXQcUh7Skl3a1dZehJHhMe4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzzUCDKjXhm1_cwWYpnSFvGMFKFqcIdYbiVaZwwYpqHiA&oe=69C7BE84"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-KAKp5TZOfAQ7kNvwGGnWqY&_nc_oc=AdrgncipoYUsvIfmHBI25E2tXETUeFW4Sulrl2f8wx7VQ8RqZMJ3p1jLhz2li_Ux89U&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwAwQM8qytW25QquWAQ4hTH_D6GWKC_jLCdyQmQJ49Mug&oe=69C7D433"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA0NcFK4wiQQ7kNvwHxKXeK&_nc_oc=AdpMB0zKYcl9Yxrt2mUsOqtZKWfAjGMyX1_FNdrobowoyX3cT_cFko33rDtBAPqEK2w&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzEvea_wdZ1-R0-QXRWkcxRiugAwth8wb1wyHDVmll1DA&oe=69C7CB19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29elOZkxY1gQ7kNvwFzhya3&_nc_oc=AdrRcWG7doSeu4WS4jDQ_zehiuBKl-D36F-R9U-vCNB8R2BV_44l1OYd4yBgFN6Kjl0&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzONxhnJIAENdasP8nkUF_QphpObEROOWLUCbRAO69XUA&oe=69C7BF72"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
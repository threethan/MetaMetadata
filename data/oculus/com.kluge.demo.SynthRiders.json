_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxVaLBkEFzcQ7kNvwF5IYpq&_nc_oc=AdpeRkqISpIDqnVaUO3iZQlgFXc4ZnCk2lYwGICdpc9LFOwHF3SrnYpzPHvxA5xCdpc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7ZPhTZ3GQb0WM3JgjYL7qtVpE8ilEgeoOeY1kaNol3DQ&oe=69F9F030"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pPTK9xou2kQ7kNvwH0WOv0&_nc_oc=AdrboDWsYuA7506Yb_Hddst80FD4kNydXPYoTbV5KOcjR-8cSS1JTBG8tIqkofs6m7A&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af40Y4xDDeqsmnqSTnQf9nCJa6fK60Rbb62ljemm5exBEQ&oe=69FA0FC4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QSPa9wlZtCsQ7kNvwEKS6jr&_nc_oc=AdpETvJEQFaswV294-T_lCSzVFPHTMkBHkvEiCesrz8ckH8c7F-oh_jhNOHkxqDVCHA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6O-iGsKpC9BxWKXxhXaIg_pYQ1glhC2nUr42kABBx2Dw&oe=69F9ED33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxRo3uBUkYEQ7kNvwFJF0yU&_nc_oc=AdpDxHKGlUnJVKBln9fXp8P2Rpl0fdGUI-vTUZLraIxu88X_I9FHMIHdhfwNxc470OM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6MJgSP4esOjstlV1YFgcsGZnTwCIZKfUO339crHloceA&oe=69F9E419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zps2w6XOLgQQ7kNvwHIXVSa&_nc_oc=Adqk9X_C-2Upr3kdDVjp0WShqRPTcv6J7sRmGqEN9goJ_yOZMqTi4acG1U012SI_6z0&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7JAL5hf6xER4pjj0xr5yBzu0Zb6Pcx3e_7lvHmalLcfA&oe=69FA10B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
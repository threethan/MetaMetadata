_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kSaCwdPsX-YQ7kNvwFGZKoL&_nc_oc=AdqEoXS5Meyvh0WvR0koOucnA5uZCz5SQU47bXm1xI6e4vb4zga0gk98Vg_QE4GhYqk&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_AfzUn5m7judx-vsIHzGI9TKnpr_moV4tGHVUdfBPFIQAaA&oe=69C685B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q1oSdszvqrYQ7kNvwFhMXHO&_nc_oc=Adpl6wAR9WePvKBr9DsppWTCcagf3hD1JUwtW1Y0Mlp9-EXUaqcPN1vIpEhH9OGx48o&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwI3p9QE1ZI_vyur2a-FXYuI57fhrYYhRQBlnBEkGJRHA&oe=69C66D04"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WJ_e-O64RlYQ7kNvwHA27TR&_nc_oc=Ado7OEytERXVZfCPMN0JTdr73xKn_Ua3Mtiq4L-s97_znclqFPbCLtQm4SdhPXcJnfY&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afwqvio12e4ReoGZLS6UVFYunbDYH_C-oYcqKfgvLg85sg&oe=69C682B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VA0NcFK4wiQQ7kNvwFs37vP&_nc_oc=AdoeDnDqEEeGV3n9yVNyH-JZWWYd8la0O2F-_lCKJQC7eJamrwXeuYsljgWP84dHwms&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_AfwKucPDaWMFpvTNVHYLJO9Be2YDX9uZPJdcr49lYB-44w&oe=69C67999"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-atl3-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=29elOZkxY1gQ7kNvwFVKX7-&_nc_oc=Adr0_cMIOZ1Gi60uvJLAfwyBU-MKfn69jQGq6_M-SaDIssmo2yDPAiWpmuUrcpfLWFw&_nc_zt=3&_nc_ht=scontent-atl3-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Afx4hNtn7qZT6cGu-OZ5v61shQ7H1u5b883epocsHhVABA&oe=69C66DF2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
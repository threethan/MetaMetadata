_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-PFX00Gn_0cQ7kNvwHatyMV&_nc_oc=AdoUmLI034dmrK73CmASMzaxkV8Sb_SfOl7fCbpmOdRWQTHsoJ7eOl5Dr8FVMnUBXww&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af23yqD7ESepjGdiDv_kKjNrKos5z3_8mY4hTKYeempMlQ&oe=69DA4C30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RdpSwr94BmAQ7kNvwG7-96D&_nc_oc=AdpYhShSFMohVwhqSZo7ts56zGk6FOUts9xJu1R6ul0pu1BdcV7UeU_FDbPxnVP3I04&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1VkiYHpywWRao5xWaOn6VT9xYd5Z3EsKrJ8ohmZjHIbQ&oe=69DA3384"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8515SvqV9NcQ7kNvwH4qeQ1&_nc_oc=AdoUM5o8dZgDYcfVr1SnjsWMhPjCV5YDBetRpCVUwuGdC9MRukS7fHwY6Uc3jdTr2iI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0gtVqjaQcmSPUU5G4svR9EiYdUyH8IZ-0zMTnkeff8aw&oe=69DA4933"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Kh_I4_GT1FYQ7kNvwHMCryh&_nc_oc=Adrv-yTDT_cQZeK0i6vo8Z9ZIN0fErIU_aoUWqZ6rYzfVRFWp3tQLsbzgUmvHXRmygM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3cALRPQ_7pzOfWkqOqhYnS-I9o_Pi93D3GrspHVOH5-Q&oe=69DA4019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_iKqaJjpnQkQ7kNvwHwh1_g&_nc_oc=AdromvbbX2EkVJ8IvccyXvSUrlHt1sKPPlh7rPevU3ZsZILHm-7Y4f7EwI9vXnd35o4&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3YTOyAvLM_9jtAcfdb6rkK59aqPZgnSU_Jf5dot0-7bQ&oe=69DA3472"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
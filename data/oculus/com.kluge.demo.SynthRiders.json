_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qQDi4yTPGPwQ7kNvwE6ig1F&_nc_oc=AdotUUrFVAUweJb8Q3SaRUbCJ8mUXGSi4begq0Tq4A_O_G6JEjXacHy0w_1vuwxseqU&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHOl2aG9ZtJhaGJNIO8x7fkYdRHevzDETchaQEP09kAhw&oe=6A845DB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qEDSXY2ZiXQQ7kNvwF46WPp&_nc_oc=AdrkwuIpGjWgE_AD1SqsWhHPygvwLpJsdjhhxoKnu04HwXc9idAt-Bd3krzu-FI2NcY&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHkLUqB_3Yb0iCj72R4W8m4rEu-vMDe-Es7rbQeA4Vhtw&oe=6A844504"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0RrnBpXmc0Q7kNvwEESwOw&_nc_oc=Adq5O6ppIkPqYYPLsjT3xZzZ5_TD_x-vTkN79Yfa7hiHnVvVYbEaxznfv1yx00EhxiM&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQE7kTvurYxMQ3MR4bUaPs4U3Phs9NbdCDxqJjRAeZ1sLg&oe=6A845AB3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lz2uaw3z9UMQ7kNvwFrw-yc&_nc_oc=Adrv3PkwgeN8cAuosbRL3TmALmS8oR1BFl1qO4LEhO0UCqOvDpzOYRbr4ZqoqC3EceQ&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHAGjYEUdKkBziB5OrBKR8l9-mk33gOmdDQ6FG-msNuXw&oe=6A845199"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=crnQmg0QNTIQ7kNvwGoSNoY&_nc_oc=AdpOimBSbyAbACBwHM64RwSh32w67_o_eKNap2ivYvTm1cgBRR2Dh9eP_XOpNMEI4Rg&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGfVDFLNfURysQ2YM-0oGQ8Fk44gClHDduUEhfrBiRUxA&oe=6A8445F2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
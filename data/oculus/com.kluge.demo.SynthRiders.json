_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=LyQjF4I6sjIQ7kNvwE-8yuh&_nc_oc=AdqvmPWlrAMDMyv6WrE_hNlJWVjv77MDSe9-yosoXomaSexFTYuFq9D0l1DxDbO_1PI&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPHuJNW6tpqPJ7dPAJgh3PJSOUvu3xwscYobK7FZmhX_A&oe=6ADCB230"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-atl3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QK75aatCq8cQ7kNvwGJTZSL&_nc_oc=Adogo-eZrMDMb840lqsjkcDT_iITyVc7UVoD-oH5bJ7z3zMC-WYDgiGvcERZs7TX6WA&_nc_zt=3&_nc_ht=scontent-atl3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOsssXGVbN0gMe8C6IMYfqxBkbgUufU4y4FAj1qF9E-lw&oe=6ADCD1C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=n14Cb_yZ1QQQ7kNvwEeYUGN&_nc_oc=AdoAnWbbeRSvGG3bSZ6r3jYt6lbzsEJIjRDYLfCdDLoNURj48b_ieZ22HISdSYxgmoM&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOJ05_eXnD8Gi84qYD2MNy8dzDmaYvDHx8XEEbrOxT5ng&oe=6ADCAF33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rBQKkKABbzYQ7kNvwGepIbM&_nc_oc=Adq6QP2evmdiwNnyAmN84lovBtSHjIlJvEywjMqutMyjjRa0vDRulWA_ql_Eo8uD2AE&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNuSoVaiFC-Y29GALIsnS5mP6-oq1K3-VkEJ2SZDHwn7A&oe=6ADCA619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-atl3-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=DOgF1NMdw6gQ7kNvwHcRgfP&_nc_oc=Adqe_33qrGzlBpHSoNrj4riazixzYyb3TrkyQxlZyywDKCCf54sY1HK5py4U2niX2gw&_nc_zt=3&_nc_ht=scontent-atl3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM6bUjvH2AmLwPJB6EbZXaFbxdveIjnFw1AfedJzitaKg&oe=6ADCD2B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
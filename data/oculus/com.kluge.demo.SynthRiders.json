_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0XYmNiotq0Q7kNvwEUd3n8&_nc_oc=AdrZVvWi37Y2zWDJ5quDADv5-sK28KXzZ7w_tigT0YtzetNDwLMwtSBU3NH0TLw3_Xc&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5C7oi0K0FiLfNu79evhQ9de5XbhXIfj6Wu_WzC-3HMaA&oe=6A09C230"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pa3k2VKRriIQ7kNvwGCKvys&_nc_oc=AdoIeIE2ntrEn4AzWwpDIyMS2Y043CU4nY1LaHftQj5qt_1ANFkiwsUJOBj6NE9FRKE&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5CYYAkDN25SO9UxK0hJp_OtnYJsQihw2wndukuR2zKwQ&oe=6A09E1C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxVZVMOO-yYQ7kNvwGcKHxC&_nc_oc=AdpqYU2DLZAExS0PHzD8sHGTv0rEelV8dvzMpIWH0fbl5DyucmZe3S_k6JiAtD2JzVM&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ewljQO-_yguuZcbVSMlrn6BuFz87u3Mzwh6k9zyzebw&oe=6A09BF33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q03zusnvFnUQ7kNvwHAtZPf&_nc_oc=AdrfpJgLuJ9RmqXEFLOdAe9KOp_stl-MHWKo_iMfWdiEXbFvUnFGiAEdTtZK5Qd5bN4&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4nxuAJM8AO1erqKzor31t6LeV0RcmkRgrOpV9D4HeBNQ&oe=6A09B619"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SEzY8-pFeFEQ7kNvwFNTE02&_nc_oc=Adoix5EfeHiLz_gvDKfxCzi6EjcDe4pbmQjEsk-23ILa001pyeQw35YEgTgL0yZaQSk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jgB6yoK0evySxVELsfrxnJ5EmxypFfBo7oy9lwMEOYg&oe=6A09E2B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
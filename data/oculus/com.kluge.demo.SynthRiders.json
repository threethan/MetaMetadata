_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FSjgMVu0QD0Q7kNvwGEhDSq&_nc_oc=AdrZHXMg70CXxj3R3wGr3sxteuY6cQvYWStbY5qT1Ej8xh67ivVoTM7XKPYjHMJ0Yi4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIhUMRyN1OxaGhcBU3SFI07-A6THfxsD4e2RHeYuR7FYw&oe=6AB3D3B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jHCfBZfcDSwQ7kNvwFGhwgo&_nc_oc=Adp4Vevub8Q9qzUrsZ_sknF5XNCKhedRzy2d3YVYY9MIUBbFWIqEYpHQnlIddv50Roc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLDNC6D0mmguU6VdzQH2MjwTdXK2iZO41lJwWBeNa1uzw&oe=6AB3F344"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sjXRbnnXTXcQ7kNvwG2Q_L2&_nc_oc=Adq01pFSvl8uN09QTm-iJyO9xWIHAbTmW2IU85OOS_od34nV4TOviYd1fkn_pGWcTfE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJO9xXlC3j41o9R4j4reidLC0roVyEUOCIxzXrp2PbbEw&oe=6AB3D0B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ffr8L8d7Qp4Q7kNvwGQhBA7&_nc_oc=AdrI9IjFArfSTMzb_xJZSpUrcr58Fu7EuFRbZrxuwOuBQ4q3phZhnjDxL7odvMBu-0M&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIJqzhEEWYrvQuU_PT1dHS5v3HkEKWLR6XXF_FvLhTbXw&oe=6AB3C799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Q3WBVM5Ta8Q7kNvwH5dudU&_nc_oc=AdpoQYlAv6GtpMpFlcI4ylx44tDR9zJpxeIeO61fd2qsB61Xpv_QglZosDwh9SqfeVg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIoFg2MssJiPpdz3Yc84L0Jg425ORVaS4DmTRnEwH8ocg&oe=6AB3F432"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2sur_jXWJMQ7kNvwErzsZX&_nc_oc=AdqWKIqCKa5S6EeKIjL4Zv04Ih6v57-mKy5oS2BAntoYDILOcx8rsC3_3yOu3I_mNbI&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af82vZiVH4sD-VtQYcSzU_LLKzasykLymY3Qs6YSEVCszw&oe=6A2EAC30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApuMod2sNqsQ7kNvwGClZHS&_nc_oc=AdoQD5qZfbQ_dT-QAMbPOXjGAmnRkGKoG6kwMtUeiyobYWn5wc8NbOFUCF6yndckJ4E&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af96bi_-vIOpKAbVue0AkN5RuFkxGko1BieU5tQ36zHiyg&oe=6A2ECBC4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PMg36LEjq50Q7kNvwFrc7de&_nc_oc=Adqa8ok2Ou8fGlkUyyk0iYds5CqAa3YfKUNlgNr7GZ0HeqqWGB4TyBk2yC7jFhAzFWc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-feMRhvL4lOWsSNYSUSzyejChHz-uOkdUJZ8jov4CFSg&oe=6A2EA933"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_iptcWmhYUQ7kNvwGee4FX&_nc_oc=Ado092fSxpa_iTvc0TXmRT06PUAesAz9HmuBsWy66bPaeuTRw-WdMGbR45QMGJQ_6Z0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af893eg1Jf_Jkg_c8sjSM6_nhyp4MyM1lYaR8kwtNeHJmQ&oe=6A2EA019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=gHLklOgwiUwQ7kNvwFWEnAX&_nc_oc=AdrMW4aO5cdKYrOS9KAlCDx-CpaDejSa-Uzn9JR5W7KG4bfDnmYKnQJGjAfvpdoLiF4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Ho7MP5egYPQ2DNJGyVvGlV6zCaH-eDRnsuVqdmi29gw&oe=6A2ECCB2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAlXf5Xqy9sQ7kNvwFEDpzb&_nc_oc=AdpXFXUMXy2fYTlcgYFKMLlRVUhlgsBSUJQstRJcJ0XJLbA5T-fMl3SRG4-RCqb20gc&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBKdZ2GgVBYVWtc0IbqwwaD2Gr7zNSD0XERIRl_Hhh27w&oe=6A578AB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuOjNt6kLN0Q7kNvwHTOI3q&_nc_oc=AdrAyxbGiKczE0asJLIDczdAZO2ll7M9npXc9oXSULh6GEzfHoKkBsOT9qjACJjVAH8&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCcdnxEQd1EcOo30mjGmoT8EL88zuBNSkvSRGCFoNxppQ&oe=6A577204"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGJkcc5paHwQ7kNvwGrX24L&_nc_oc=AdroJXTKriafyRvPMG7jMNA8HulqFFQOMG-PzovXNUDg7w0Q6pBdc4qag17sj5khPIo&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQC12wMjcZpuoRTqyaIGiKT8wZqof4xMpFuTGxDnXq8-sg&oe=6A5787B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1zl3bMqAjoQ7kNvwHQXsUs&_nc_oc=Adpc7lQu1RCgnEpReQyDLKajhVZRhuayBrtu08ZKiUjsuvVKTOyJvJO2H0kYw50Yz5E&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQChJQJoB9MrCVw6OZnTFCdmJpuQQXTHC8nIVBF7p8HKXQ&oe=6A577E99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z4GZlNkBtAQQ7kNvwEwN-df&_nc_oc=Adp7hnLBoBTMpY4hnEj_oRGg5eq6y5xYfMm5hB6wYMwQNcl8BS4q4mZWP_2vYqt9CAc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDa9lXUky0b-JEEPyrrZJ4uCY6Fo2cl7qpiEsPfhA6Htg&oe=6A5772F2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
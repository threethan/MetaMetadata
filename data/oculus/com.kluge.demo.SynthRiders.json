_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QzjkMBH9Dm0Q7kNvwG5dZyv&_nc_oc=Adoi_jMqvNt0YjoMWondqWDEq9QKu7gMy6amGHg3JMwSIoy9C69Zc2kP9i4Y2XdDd7w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4EUOEzXh05l3KtxWuh_DEQnh_8eevOGgSqFVuaRT7iAQ&oe=6A199430"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=apmMSGmsdRAQ7kNvwGDeqYp&_nc_oc=AdoNQyPY37rQeDCNKrulpotDdSV1rL-82-rfjUxrg9P6GauDJIW2P_N2Xg1XimgN2Wg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6KqRXwlGudKSEiTG1UucyIMWm7JyOOFz2-AdabvIL-Lw&oe=6A19B3C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bea8QouIQIUQ7kNvwHPvBau&_nc_oc=AdrM1OBseDmY3LjKovj2dUX_aaVRj5Dj-g0-ouCHSD9MgM0yI9WbfUhZsPtMqApTEU8&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4XQ48ubhqUOQ5BS7I4EWJegMe9-TatGFHS2mjDkjgFKQ&oe=6A199133"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WoeqN0-SD9UQ7kNvwGBwWoa&_nc_oc=AdreFEVQEHghHrcInPZRwvZaOuYeJ94qwVJ6M1LEJFDgu8lfXslGLTebxuHJSBaD24U&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4c0WJLCuPUjkHiXHgLdDresz2nWelM170cW09GwQ4znw&oe=6A198819"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=J1niZOkSo_MQ7kNvwFuq4sz&_nc_oc=AdrpBaVoXm1tgxqQ38-a439Bi5bP9fuwJbX20a8WFp5Pmp40Napsz-zOm_eDH2wy0es&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5wbglIyIHa1_wfqvrsPPLG8JrdpDYEHQ7QxFyNgPLJIw&oe=6A19B4B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aKCQfP1DPaEQ7kNvwFIX4a-&_nc_oc=AdoBnnXHNkAo4O0m-KTgZFY60E_OFtMBZdTdtKyRGnDiC_MnQVc_pLBGvrOzZiTfWZY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIa0-6v2oTrRPmDQUbychq5ai1ERnAS81HMQCUSwJIl2A&oe=6AA2B030"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x52BuFQKsFgQ7kNvwEIwjMB&_nc_oc=AdrGVsO6OfTeol7AQUjl1TYtTVvmf6arjhS1MNCfgX1FnO8WEKrVWPhWFmsRbmtxtsU&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJl-JUap5C_en6sormJRHQvTWZG8b0m0Ps7jzvGZBis4w&oe=6AA2CFC4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocnXkRnYB_sQ7kNvwHfzXvP&_nc_oc=AdrU7JpSKBsFNEI3TZfYQ7teBWGr25CcKSbLEGu6M19ZdSEBv1Y48QT6htGSbfmYjFk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJmyouKQIaLN15oR92-KCbPw88F6rXWBMRFjowNY1Y6yw&oe=6AA2AD33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CVNN6UPDJE8Q7kNvwFWZ_ln&_nc_oc=AdoZD6olXLz8Mkj9Rm5nwlMOuAl48i7yYuRy0_Z7g02qpmLZdR_gh3rJ9u_pICbhbEM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnpHSWdyC8S4MRA-ixpoloCug1PySBV4xP1pY2fYZhPw&oe=6AA2A419"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zIHKb9zwiTQQ7kNvwG2RXmk&_nc_oc=Adpbs1ynYObhyl_n6Dfd7hGfte_lgjIqoOH0WmfI4nzHG4fr-8fkiGrtQ39DRlXUro4&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLp8YqT80W00Wx7NxQRCyX5Fed6IH_nSeYsBfHp4TFNTQ&oe=6AA2D0B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
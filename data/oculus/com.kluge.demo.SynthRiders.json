_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pER_MKmuDOIQ7kNvwGII-8t&_nc_oc=AdrFz2jeW2Uz7rMfrktbELhGQoRYksRpt9HTcauKr8TGQgUohwmPigYmcdatlXYeYGA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0Y21WaMoL3XyaYA2TcU9t22UGQaJu1RHruI1IwneZMJw&oe=69EB6FB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDTdSolND6cQ7kNvwHOzgqv&_nc_oc=AdrLAN7_Fm7FhW5iHwoJx8Fe19VU7BINTS3d3SaLcgs6yL2Rq0AS5zS7FpxiT1JXpQ0&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0atuGCjlKaRg8SG5n9tJpDV0oX9EB4GJQxSgwE6YxTbQ&oe=69EB5704"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u4na8h8T26UQ7kNvwEdZJwE&_nc_oc=AdppEPAIUczgGyRDpTpZri7n2W0LSBych3wSxhhTW1zGh7_nlRy6YF6Wyf6DFWy6jWo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3osamZMlhUsSCx8Vodd40Ve_NsgZga4j5N0ESN46hYYw&oe=69EB6CB3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWjexCwS42IQ7kNvwFnDPO2&_nc_oc=AdoW3erTg8PZkPCuyu-U-Sgt4i5dDICLOw_dfZD9wt_58xWtnv3Gn9r-Yd42-6VqAYU&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1R_iT9wXF4tmt4bSRexqFeJ-ERXPyZyixM8ZSsFxoiMw&oe=69EB6399"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfUf94D7hrUQ7kNvwEqNG6z&_nc_oc=AdrlFtpkdT88-QmtSyBqTtmYXjaQN3p2jdKsRQnhwPr9hwK4x9aDn-_TFzNDiBG9tWc&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1SUDuvn88TBN_MT2qA0GesszuM62PSTNEiizNNBHd2IA&oe=69EB57F2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
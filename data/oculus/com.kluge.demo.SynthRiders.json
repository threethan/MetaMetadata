_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JnLe5vKkOggQ7kNvwGneYj4&_nc_oc=AdpQ0tAG77ykOoHBazSaxVbcPLOaFWyZ6UB5nh9A-LBz6CXimBS_yOhRGompQb4Wi2c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPLl8Jm5ZarYW3ceM3lCdYYyxx7cAloRP5sEowTTG2oXw&oe=6ACA7570"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZftxIX6NRaIQ7kNvwHGfcVq&_nc_oc=AdolgP0zqIJl3SUkchFW63Y-Y4h7GqASquSRP00fg-i1lRZv2cIPnLBC1VD_4cAXxEc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO_-MFPNDBaR_A_Nanhq1Ulq4Sbq5NubLWiqd1QjJM2Iw&oe=6ACA5CC4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UPgld0D0nQUQ7kNvwHq6A1h&_nc_oc=AdqRs2XHl7waDvAngR3npPPBeKCQ7F69x31qI6LJkBwMP5Cn2IpC7kGbYk1NfyVIxm4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMfOODH7sEjGTSoabedeR7rSz4TYdVHMJ9ckOOGvNFXhw&oe=6ACA7273"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=RJWdWC5_2IoQ7kNvwGUQunw&_nc_oc=AdpcplxDDKw0s_23wgjjr2IbPmiGLOZ3X1qUVPJB7e5rgIdzHF2SIoAzxpOAuVDpb5I&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPyr3dF-SPNG6nqcoE7TKbUeyeDQVLc1rfsTusdY-HG0A&oe=6ACA6959"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJaL_vILVxcQ7kNvwErjj3A&_nc_oc=AdqDepMLCKwY94McDb5tcDr1oxxKcGl3gMCRTzkPDgoQtC5C-lTdbGxQHYpBJk79Ndk&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMzAfH16MqkDrEG0AAjRUxuB9bBLQR3GsB2CWvGTy2hFQ&oe=6ACA5DB2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
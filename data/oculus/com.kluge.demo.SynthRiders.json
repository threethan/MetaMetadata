_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VvL_EprIZgkQ7kNvwGBl_8c&_nc_oc=AdrdB4RnQUC6MtepdmmAxqTKoIQwJXkXn64YgWZtJbhTZg-Zmbwi66UVcsAUEWDA8fo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOA3dIcQGkpMFf9w26VHqA6ODAJnj138mc9SKLDWo4XBw&oe=6ABFB130"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zK_e-Ocnm2cQ7kNvwGnOOoY&_nc_oc=AdrJvCv6OIXrKxCataxnxiWNHbFi29rX8Yg8zOJXLRmD4Go95yDbdNpp60VijsP1-Q4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNnYAkWiMlbkuMnkRbSa_zVGFmY3MmJMOPdL0P5S26dWg&oe=6ABFD0C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=miNcmnP42_0Q7kNvwGcVHc-&_nc_oc=Adp14gBxYJjj6M4DvSMFkDj5oMq11OUo8YRmtPYTQ5wYbh1--r4QuBlmn5EEZs9P2SE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMIaMHP8X7x2hMeUIYbFAk2F6vY5Y_gVC7sAMsJH7p_9g&oe=6ABFAE33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FrP44YcSIxMQ7kNvwEDhBYa&_nc_oc=AdqXocbwFE3bULumf-aw6YPDtXZOJJPXMEpUmtRi4lz3kIo8Ianr0dtTKo0kzrrrYhU&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOw4_ILMmyMkeDr_-5wN8XhKjMlJ8LxCmI1CPrN3Gvqnw&oe=6ABFDD59"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=3k16aDYu1gwQ7kNvwGoByx1&_nc_oc=AdqqMx9_6r1ESUqliVPQNFkrf_XWubF11rFhBaCk1NQfFs6Lt8TatMGfXbqiooVJ5eQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOeJL4npzHcui_-X-HM6etfXgXgXMPW-NmQSI7bNT6img&oe=6ABFD1B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
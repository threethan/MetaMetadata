_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bOLPoyuVYSkQ7kNvwECuYzw&_nc_oc=AdqSI7NEPjNMB0dMQO5LLK78mDlJgRDAkXDRp7BxwXxP48ZVORBVwzGy-5uzQNzbGU0&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7WHkLFOrao9WJmll2CpgrhVKiHy-rRg4eDzDtWABaIPQ&oe=6A1059B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w61yNI-PTIIQ7kNvwHsPbhU&_nc_oc=AdrNY15JHa0Fc7qIAP7BKlM2OtTHT_jPJjD9tbCpFC5EzM-tCgVgSaRZaDJI88nIFoE&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7C8bD59czO1XCnzcNu7Fnrm10G_860ZTZ6FaGyk82zNQ&oe=6A107944"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-lhr6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Zz_hsk1WroQ7kNvwEL5kDs&_nc_oc=Adrly7pd4cPH_wFO7H8HRKXfOqRWOKC8tD4y9ydlk5r1aarOJ6NzVk5xATJN6CVSVuQ&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7uAzMA4imgAuJ-TKq3qh7-zDkQzK8R-wICvBQEXAvNIw&oe=6A1056B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-lhr6-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=K-hFSKuQF-EQ7kNvwGklWHD&_nc_oc=Ado6tj352GSHljFLCBEFACIW9c62hjudHogCIJAstv8q072FgBVcbOIlGxYq9t9JCAg&_nc_zt=3&_nc_ht=scontent-lhr6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PvYDzt-QXiNSOjsYwq7lbx58HOj2JH3_nahK8qlXEqg&oe=6A104D99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6FXcMNqUVtwQ7kNvwFzGupH&_nc_oc=AdpKcsUKKlPZGFw_ngmBMCxzQAuaRUXxS5or2LJeOwq1tKc6tUk7dJkclcsPlN55c6g&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af774f5Kg2bI7HRfZeIcQOAoCSf-4u1VdSwKrOKV6HtW-Q&oe=6A107A32"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KtGeZg638z4Q7kNvwHEe3_4&_nc_oc=Adp7BP0Nzf8FmwwOhHP1lRIioFcig9ODvs1GRAmyJHsZqQBpTKLx7Q6CH6IFE2FjpKg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFOdlXab8l4U9M0Ke0xNmMA5vJLEUSJr77DIl2HUxcvmw&oe=6A81BAB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eCSTkGCkizEQ7kNvwHlvW8K&_nc_oc=AdoEfpaDn_o0wCvaDtmzfSEYi4KXIJX7B9YJg3wMHB9tTmome4GeYs4ZX8TrbfisEa8&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFh3Fy_8J6W9sO6l0r8yFZ4O3Xk95oUC73OgfhzWhIVYA&oe=6A81A204"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=e0RrnBpXmc0Q7kNvwG-eB5H&_nc_oc=AdoGoBDNT1EuCfuPtA6Vb37gKSyOzZ6kx3j21QEdNcONQxODwu3Z6XiCahnXDadqw8g&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF6pYSekAjHvZLzxfsMqo5b3jeBlxnhYdsL_XAOYVVSIg&oe=6A81B7B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NI1KL9yslbYQ7kNvwGZ0Ypa&_nc_oc=AdodfFXPQXpTf57yB3MOim3dxjpkAnoEAMN3U23dmX-owfJF2UhGOe8HUOmeaT6svCs&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFeV8vmluoNJzCNBSGPITYwYROVDLsC8Bi9xYsaIx16PQ&oe=6A81AE99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4_3SKvpP3qwQ7kNvwHSsT7c&_nc_oc=AdoUsRzv4rInM2oGk1-ua-03Yo90UGiv3sXBdyYufg-bEnsdThhKFf4IuyofmFbX0Rs&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH4LYKPVJb24sH60jp2mvtpqWYiC1QAToD1vhj7vKhqPQ&oe=6A81A2F2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
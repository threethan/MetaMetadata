_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Daq4CtuciNoQ7kNvwHal4P2&_nc_oc=AdrSDsbPvm0wpBZNP3g4cPR6Oe-Qh3R4IuivHFXV97sAaLIMLKU5-fFmcnNp0jhva_o&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3y0EEVboLRgyMH18yq0_L7OR6eGNcloQ_knygfvRnhSg&oe=69D7A930"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9i5BrOmyLm8Q7kNvwEo7L6n&_nc_oc=AdqNU4BsquVYuimpzw8irbLetINPwu-s3Gfow5Zf_fXFBjaSv-37vNIpoDuDaCDLAQ0&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1DfPAetmPhnIzo5irQKPFYSxhoa0Ifxg_LPp3BawbAKA&oe=69D79084"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8515SvqV9NcQ7kNvwG2h58K&_nc_oc=Adp7ENHvGtVG8EcJ1rYS_PkVEtu9nKWhEsBzzCzRIAQlifz4gvWTXYTVaBE1xpRsOyE&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af24i3ejrDBkM_bIdyXxaoN36mjz8zM3FLm1eeFr_buE9Q&oe=69D7A633"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N-gO24iSqksQ7kNvwGACBVV&_nc_oc=AdpsQ0uKGf2ZvrL1Ks9nIcjIzBzNJXY7zWmLEwkvwgXZjjbH9Zl-bK-BDYHXfSGpAHI&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af34q_C4umzHpUTBUM3jX7vhnWH-g5w7X41LtK3YdoyA3w&oe=69D79D19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UfvGlYa1QsUQ7kNvwHpE0kl&_nc_oc=Adp0AZRj1pzrKT_0k8kWSmqrL_BVwh0raXnaa7wxQf_mJ8UHinxUFh5WXC87q4TsvRk&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1cV8VuSuug5gGSuD1XiY2rfIYX9VSO6G0ZCxSm9aTJEA&oe=69D79172"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
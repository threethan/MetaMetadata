_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pER_MKmuDOIQ7kNvwEVDBYF&_nc_oc=Adq5DeRlSQ0fMmWPgJT_J6O3CenihfHJQUJRGoXfNQGSK8QQ5W8rRwTc-hVMSbf9zME&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af0DTJsuaLidmBCYckpJfqor54Jie0bjykK05nQYNREQ0A&oe=69EA1E30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XDTdSolND6cQ7kNvwER4uRQ&_nc_oc=AdolcwWj8nnCqiTsvnZdpzmPbH9XzWNNXg8pcRqwXOH7ddIroHy8Ak6kL_S2dfh9q9M&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3bY1ZWAUPLaRTBGb9MXtWYHMyrEDeahS50CZIlO-Hxsg&oe=69EA0584"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C5SqD-i962MQ7kNvwEQsIpv&_nc_oc=Adr8BArotLxqZ3zKDMl48YbI4Wus7rfRPo2gMvxiu_Pu7DEm_0Rgd_NJuIgexJGnh7Q&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af31WjyWmnL2g4BPcJWRZLdGSh52JfL4HvCisGmiZJ6BBA&oe=69EA1B33"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MWjexCwS42IQ7kNvwG5CZfX&_nc_oc=Adp3Ksxwr-hTCbVG1YFiej-qx0-a9OWSQwtjQgBne2RUURfxXNtRXx2Vsj3qG_9cBYM&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af19S1h7MtWLV7yPbN28D6rEZkAeXnD5TzQ3hvhK8PYX6Q&oe=69EA1219"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dfUf94D7hrUQ7kNvwFIY4sC&_nc_oc=Adqjsj50UmIwKUghON_LTziBXNxt0ZBcG3rlGzax27-s29z2Y0HRuj0RS13LG5HNtfw&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1sGo2RtNd4AClP3Y_tvGe13KBHbOw2nb40iaHCV2D99Q&oe=69EA0672"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
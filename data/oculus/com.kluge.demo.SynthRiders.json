_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UAlXf5Xqy9sQ7kNvwHhz6Hp&_nc_oc=AdrsR8Eleyz4tLUfCPIwl2d7cOZ33X1IughS9myY8s97LJZTx-46Ua9AwDZKHsvIwpg&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBF4EatizxuCG4NSP09aB2Lk9t_uNSeHNW3ZTAfEiCy0A&oe=6A58DC30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vuOjNt6kLN0Q7kNvwGXFXI9&_nc_oc=AdpdJirBxZHOaFOd1cYEMvEpOPFOSS9YsKIlCHYdCR-tHKg6eDklr48kOS5wokb_qjQ&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCjYGrhOmt_KWmwBRsq1eXkUl9J4g2zzp5k9cfZGVLoZg&oe=6A58C384"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KGJkcc5paHwQ7kNvwGLWnnX&_nc_oc=AdpNQRFIEpdigSSukprvsCEOzLdjFsiz37S-jGbP5vw7Sj4FsvlGCsE0xMkGxRhZUJc&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAUuoyaYrS80cRjtTmRsmAILU91oEutuv8i3FShd6ukbA&oe=6A58D933"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=h1zl3bMqAjoQ7kNvwEwTzZP&_nc_oc=Adrqh1GZOvHoqIgTU0RMnyYydW8hJxSAHS7a8P5N4Wy6sVquZDfosv3c9NHdwrjLG30&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDwCRAD_QROnW04zOntwOupVl43NEahpVKHpf0yacih_g&oe=6A58D019"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=TV_Ou81x1KgQ7kNvwGAkpq7&_nc_oc=Adpp6-VJ1FBZFwboTD_eLFCuIZV9MkwZh7xA1O8bH3zjnhjNcgImPeLnjmrpbdvjfig&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDcft98ypDQ_vaKjU0Y-npZwVgMrEabonkZkjTzbrFwZA&oe=6A58C472"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uWHvgMMWPRMQ7kNvwFVYvA0&_nc_oc=AdqnJESm4w9NFflM1CGI7OM8RQ13xwFt95E-etrlPKUebfm3rHZlDhnMQXNApuC34xg&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHvtKE7zwI6yVE1HPV5z8feUf9MNv09ue_PdUwBeX7jvQ&oe=6A918CB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-hkg4-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=VjplVpjEDpgQ7kNvwGOMXtB&_nc_oc=AdoRtddi0KTT6Q1BVHoTiQHhzx3JCZfGQW8BQhZS0y5_YRd2LdaiILUwdFWYR58VvBc&_nc_zt=3&_nc_ht=scontent-hkg4-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFJxa12p6_3P15G6cwGfUNCwLz24_Myr_YQJGAmFsu13g&oe=6A917404"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-hkg1-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=w4V7-fFEvmgQ7kNvwEUJHQ2&_nc_oc=Adq3Tj743ErMO-wahlGa7WPNWWnOOu2Kbl-lp-NAImexUNkOWP7jfdnqVk7WpGzg-1o&_nc_zt=3&_nc_ht=scontent-hkg1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHYBA2EPuc-Gxn4Iq-1jyCdn4mDvZfarWqh8Fw225i2IQ&oe=6A9189B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-hkg4-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=jlzczNk4GBkQ7kNvwESHaxj&_nc_oc=Adps816Z9r1tNmDOebkNNkhTkOteZXIxWhfSvyoa9FQjbNeNblNKockQb1VdYzolOok&_nc_zt=3&_nc_ht=scontent-hkg4-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQEo-03fPHoxLU3dM8hvfRYku-x051gIJE10ywGLKOZg_A&oe=6A918099"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-hkg1-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9z-dHS2kyuUQ7kNvwGMHlP6&_nc_oc=AdqaZr_R_Tr3SEcS7SHa2p1_QOng8B-MBQBuq93mT1DiUNCoh_QMZ-gDyhSbLthiaDI&_nc_zt=3&_nc_ht=scontent-hkg1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGRg7RXGrOgnuFmuRp8vzWY6Z0SMct8JNcxj-1nxWB9eg&oe=6A9174F2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QyTvdUmfjwwQ7kNvwF5u_Ov&_nc_oc=Adr0zb541TapJYHUZSO48Hfajw_Tbw06rZXaMEKEnAoZHRfS3jHTWxPx_J7N24y8TSg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAlbzwcqJMdpw5NApZUqWHH5dnhsl6Nhq1wOQWFqe9j0w&oe=6A5F73B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=2KXrdiyEMNgQ7kNvwG6O60_&_nc_oc=AdqwvIdLDUoIIlAh-F0x9fg7CkG0iRiMTECjhKrrUSEu_XH5ZPhftcAdDVS5EEQ3vXE&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDUfJr9twuu_KSukANyR1Ht3o0lx1pJLKj3ExkT5nnL4A&oe=6A5F5B04"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Jlb6iN9BZzsQ7kNvwHKwfft&_nc_oc=AdofCXiN0-V9PV304MkAfx0uZ1XSp0ppAJneZwrhltHmsH6Ge8JkDYd5OaQgpWBlldk&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQA-WhAGhIMm4tHlVdH4SFS9KJcvbCaPk-wzoZpGjV4dhA&oe=6A5F70B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=InFRiwW0hh8Q7kNvwFCbLgh&_nc_oc=Adoss7cM9Pp44O8mvhAB_Eqh0PO13Pkx8_yylUVILWTZKkvBQkjlEiHbsqyy87BUjvo&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAEI_mbTgMnUr66I5jyWubeeI1gJy1MbiVgKePhtDLCow&oe=6A5F6799"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-3.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=45JhE4lYS68Q7kNvwE9GcAu&_nc_oc=AdoXCJHhlOJ1JvmNA7Hlftum3nVL_NqxCcJ6vvzeElnrklBC66W5Z6pNAxOLpvwMyeA&_nc_zt=3&_nc_ht=scontent-ord5-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQAb_BiSbDVxAXYeyMXyTGzNMx2hB11BiQE9Nri2m7_jHQ&oe=6A5F5BF2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
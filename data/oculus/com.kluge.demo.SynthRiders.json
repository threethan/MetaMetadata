_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=m0XYmNiotq0Q7kNvwEWMh-M&_nc_oc=AdqtA98vxx0IjzGxEDqQe4qc6DScbyaWcN1H-L2YB19-B9bbvpe5GUQdLkEdk6WBiKQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6y3yxIwPry9yk1zbI1GKVx6tj0XmQhKzPsUJ61p9pJQw&oe=6A0870B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=pa3k2VKRriIQ7kNvwHLZTMa&_nc_oc=AdqpUp3NMSsLnlmLnDy6_L-JbFP6G0fgoFdH2ffd5NIvaKF2J1Mw2qK8MNpj9d2No18&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6ZqslFtfGeUjUGAkwlDXFV0uLrUqFP6oPH_Yi5-F10Lg&oe=6A089044"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nxVZVMOO-yYQ7kNvwEK3gUr&_nc_oc=AdoW7zaa1Y-yP9EuVnXhs-gCE_bI2MgQtoC8pMVWP1qeG1wePSAkiTOWHPeXhJZ9sSE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4Dvf7WTUDnQUtmh_ehDYsM2STnB5LiZCjWs3KHy61mZw&oe=6A086DB3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=q03zusnvFnUQ7kNvwFUsLxP&_nc_oc=Adpm_3k8ahsb1OjnSy-vkVrMLzeSdIZlIPERSitYLvjrd0Ou8P2JaYRZ6j3Lv68frm0&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6qIY5jE3Wte85fAV-raxc4-__jILc1tovhm1-qhb8gew&oe=6A086499"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7BjEENOJqLoQ7kNvwE-8IRR&_nc_oc=AdpCZJ5427RN1it0deENQhvphSTMJ-lZRL0yWlMDHYOatyvshkUanwtVzehmgpsSV7I&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6c_pSuUHuYlLpD7YEmgcPaEl730QXR6l3WIhBq_Z0_DQ&oe=6A089132"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
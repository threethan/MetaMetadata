_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=vxrknbtGe2wQ7kNvwFmWj6y&_nc_oc=AdozvFXY5ieQt57TXIIwKvZPozCK-3-E42Qo3IxU3hrTHfHgm3Qnep2Pyvb5NioPskk&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNu-XZZ70b2z0FnAgFIp4r9qzT1Uee5HWY4pDN30lk3hA&oe=6AD22630"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sZ4t53j31UMQ7kNvwFurnbb&_nc_oc=Adq6Sgn7kLJDVNWH1_X_u4-kN3SRaTWMKkoGt070WbQxaHzh-9fJc7thee2A9EmH21w&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP5Yqp18Mu1UHRNi7jsBs7a9iSfBhxVbpXmQ9e569eD0A&oe=6AD245C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ruO-5WFkbigQ7kNvwFHoLKs&_nc_oc=AdouWPh7KwLWHylepXZOrwHvwGI7moRUq5HloCAx5vrUoU_JMmG3HhHFfTxURaWyUaQ&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOdnTHcu9yzDRO1G6QOGCB0vRZI1EmS1BGcgcshAAtzsg&oe=6AD25B73"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aGb_IZhRB8sQ7kNvwEu1A8F&_nc_oc=Adp10Yf1mJnX5A8H_yHqZPb4jBnBPGqR_iibwjpMl1sOcrruH-QmaUHLtIx_UnBG_Qc&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMXvd8Ilt0ZPn3PUMPfYgRyiNszKn9PCnQNcVSdU_mLAQ&oe=6AD25259"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=71i1ZgR4nNMQ7kNvwGToWtc&_nc_oc=AdrIOaGjeUbHIZPfaVHZhB7y21aIhTGqksJMSy5Ek5lMA4cW3MBXLLuDZAXrB6DGkpk&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMshCa-ZXcdNwAorqGFlMIBRVhBJmzsI37DBi-LciU45w&oe=6AD246B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
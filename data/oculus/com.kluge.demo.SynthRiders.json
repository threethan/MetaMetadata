_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0W3J8nMFFfMQ7kNvwG7BB0c&_nc_oc=AdrW8vLlIptcT7V7dsiXHv9crC4j3g9OUgSES-IMNzK3gpEPtiBKD7Pj64I8cQvoBHI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-O5eAcDa7gSYee51Itgun8rjqa-h1ZrHESfOX8ba_zKQ&oe=6A26C330"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ESBVlXuuDT0Q7kNvwGm_mSR&_nc_oc=AdolGX5TlAbvSVpsq9V2E4ldK-F9CP0lm0iB0wmZCb9g3UMRw4pZmAoVZA9zeSTaemA&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af9lLn0YztjbcHKbLrA2pUhz-RgcbKjEsj0EhQvxxgqfyQ&oe=6A26E2C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EaktsNVTXBIQ7kNvwGm7cYH&_nc_oc=Ado7xCM5LhdY1xeVtjAtM83-T-h1MCoyJ2X2DexSWmUG9QdQg1xXk3bd2ihd4-QZBis&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Uie9vHnsoT1kyWaWtaRZMmffDAZEusjV6R3yg7plAHA&oe=6A26C033"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5voJV-Se8vYQ7kNvwG6X7nW&_nc_oc=Adp0d1dF_8qMmtKZuAiUawRf0tDvpRqHxnH7AVVleRt4xcSsUPSnI4oub7C0J2X9jcM&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_qd4qXCUpbkG3DQVNZy_yKBNjVGOAu83Hxi8Nxwh-Mxw&oe=6A26B719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=kZNMpOM91mcQ7kNvwHx9SRg&_nc_oc=AdrAUhba6_KNH3eYUIFaHNeU2AIwwz3a_hAEnUXGfX5nNTUxzBifn6AJDBb1dbCuaCw&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8LQ-PX7FCffGTIp9pq-7VNbxaACGPaTp2fuqjQiYNEQg&oe=6A26E3B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
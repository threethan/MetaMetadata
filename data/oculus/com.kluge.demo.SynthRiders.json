_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=7gR4gCUlOSAQ7kNvwGjhezY&_nc_oc=AdoWtjrQPNcBvUjr9cXos9bisGm2OVHyuq7prigTXNuMaw9P8qdo2YrcKfq-sGSgLMI&_nc_zt=3&_nc_ht=scontent-qro1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQFAunCUJiczqfEHDSNxjn1dcb_9cl5MDlom4XENDphsKA&oe=6A974330"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ocKdP7rCTlEQ7kNvwFtESmY&_nc_oc=AdqnNiXniNvCFkHrvYBeqFL-IOYDry3vb-8zkUCw0ydsamKLBTMS0-iMpNqy_UovBRM&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWHucfKGe-_g1gWnbdwzqCgC3-faH97SgKyEyYyXm1zw&oe=6A972A84"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5yrqH4yYWWkQ7kNvwFcx49k&_nc_oc=Ado2IEwfeZxZSGuddXV_lBXSD2ylHhplBiuuLWHEqa4Xcm6DQTSazWv5rdMg8yyz7wA&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG6_kQOBNq9BKrzY_AfShb-vP_u9cQILv3PoAZOwd4yZw&oe=6A974033"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-qro3-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMEalWKJQWUQ7kNvwHfnsgd&_nc_oc=Adr9IdznmaDHv23LcLnpjmb22IFXyn39J1MbGn9mLMQw55dRg_c_nvT4_5RW5JmaQY0&_nc_zt=3&_nc_ht=scontent-qro3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHH66eYd5eUz6MhoS3nS_5EzvhKjk7IR4Q8SW89h6arbg&oe=6A973719"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-qro1-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aNAxY5EiVwwQ7kNvwEVXcwV&_nc_oc=AdolFV94FG4WwlPUZPOVpg-2L12CJPm4D1Udf4l6KbyTR2uhs28ee5a_CulfapE2sJk&_nc_zt=3&_nc_ht=scontent-qro1-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHE8kX8l1f6OwuKnQzSEb770SMBQVzFbo8nLHvlNnMIrA&oe=6A972B72"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=C-C_Zx2owN4Q7kNvwGrZ51r&_nc_oc=Ado7axWKDa9qmqaZcLEHeapViQYQNjORZGzjfgi_ZgM3h4-hXJyM85cbbLpXeOBFMvM&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQt8WrIJ6kqZQvctaHfCSMG4b4nEPlyg6gt6ZkYf7NfoQ&oe=6AE88FB0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=qCvW9ubzNtUQ7kNvwE76tPW&_nc_oc=AdoDkq9KDbtBQDowGnv6vJ4bNW3V9hUeNNFkds5dSYpLy4IsCOGQFwronOgP7NGPPxw&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTd_TfywJhWQ6FnHbxIkaSumnn89_rWfeW5HpJCl-sX8Q&oe=6AE8AF44"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ol1FhZsaw_AQ7kNvwHOY4fV&_nc_oc=Adp0uyhIBpk3ZZfABBowztiPhRojWziSbXx7bGzdho9QXeG8ceAkYdCOIa6qgxNduYs&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSKk8H7ifWdveLf86lBUqIK2iMVRKbBkUMXksiKym3-0A&oe=6AE88CB3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=G30EjNhsw84Q7kNvwHyglnL&_nc_oc=AdpFfhp-9JUwbiTq5xLryShO167x15j6hxbX3pkXImXXq1NTl5yG4filGo-98EppOZ4&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS87XC7jNYsOZn3MVRufP1HEEx0ydsFv6xtNZk6vFz3_w&oe=6AE8BBD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JOZUKQKSrBMQ7kNvwHww2Aw&_nc_oc=AdqeZU6ncsmrj_l4n3tc5eL0Gkmk5kp3datsCGrZ6EkbWhCmVFx5OUOQ4JLKJOQktm8&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSdrYMm3Wa95cbBTFpKJDEsjiz3kj89a2mNBh9uQ9mvHQ&oe=6AE8B032"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
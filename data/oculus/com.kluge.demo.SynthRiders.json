_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_2sur_jXWJMQ7kNvwHmi4b6&_nc_oc=Adq6bvsfYvKa3cCE3XVgOsCFNjT0sd0mAoWpw0DmDp90Idohxy6k3nfBNqbYIDB-ReQ&_nc_zt=3&_nc_ht=scontent-fra3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-RWmh_nYs01niaHVyCM0GR2VoXvGnYTZ8rn5QM1Ek89A&oe=6A2C0930"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-fra3-2.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ApuMod2sNqsQ7kNvwEFxvhi&_nc_oc=AdoEnCUBVtBHjAkDBhK4LMt0bDykfcOhi5fgzZ0FQ2b029WTxpPCeSsSXhKgUW_tUv4&_nc_zt=3&_nc_ht=scontent-fra3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-4TzNcBlbUdBtvUTadasBBLg5KSQPsb0wmCjF0oL6VmQ&oe=6A2C28C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OyG-VX1vnGEQ7kNvwGlgJmo&_nc_oc=Adp4NBfq2oiuzD8h2sK-yoM0YKIFcD95HgMFLSVu_F6te0W8u14T6f2CiVBnwOPzdZ4&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af8z_nmDRRz8RY9pXFljBkw4AA5NfZxxOx2aPE5H6WB3lw&oe=6A2C0633"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-fra5-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y_iptcWmhYUQ7kNvwH7_0UR&_nc_oc=AdrXuSQNXflwmaSUs5lCV_gPUUn1w58w-QhySv-2bcix6VJRbBWse6wyn4mZWe5zdSQ&_nc_zt=3&_nc_ht=scontent-fra5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af_Yllztd77a15Kgsotwj-DanhQiPjIlkuSBeCdJyqKcUA&oe=6A2BFD19"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-fra5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=wQcu5QZT8mEQ7kNvwG2IwAt&_nc_oc=Adoe2mcLwvTdtOh5XReFx8h3UIVihE9HtXkHG1YCzxxoPE1n4rlNkP01l9gQvfZXTXg&_nc_zt=3&_nc_ht=scontent-fra5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af-mbrt_llV7U3KsZVmKr7Rzgth6EW5yfIsKl99Kijp9oQ&oe=6A2C29B2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
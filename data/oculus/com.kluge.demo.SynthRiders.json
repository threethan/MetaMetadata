_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P3oHFbsetF0Q7kNvwGdHUca&_nc_oc=AdrYEMQWyeYDSTyj7iy1siYKayJQbkNQglusBdJeN26xfHYlZqos6qxeXLQKIkvP2vY&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7vlH7ZXfJjkRMwx6UpwUHOX_sxk4ZLCwRwhy8stjTQA&oe=6AE349B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=QYYAeF4oXSQQ7kNvwGzZcR8&_nc_oc=AdrI-LzhAzHvYm4W92LsLnzu4CaBpVdHOqkfT5W4b1Eg8IWqdOPQILSTd3RgpOEmLyI&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNylGQjUyuVaM2uaAn29EN42PPIA2cDe4IA1y9rZQO0CA&oe=6AE36944"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dcBs3-Lc5YEQ7kNvwECuQ3g&_nc_oc=Adoc1w0_lHkCobl_k2VlErEkLhgPoo4PNLWz9JxOa_YJiq3P890hzq_0KJ7Ssr5ZYV4&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOntXK9z9q5LC7iSXvOv-8GSXbi-Uw_5SKMSEGwW50msg&oe=6AE346B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=9o_JoyOiDVwQ7kNvwEmpg15&_nc_oc=Adq-tiFvsUdpLuFsxG48reZYGWLSz3tjR6iOugByeNJbD6MeR1VIoxBPc8ePJGHVRJY&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM53HDr50cZFBxrR5GKWn0l7UJmzbkUam51NZjRhKL3Qw&oe=6AE33D99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=u7zV59JO0A8Q7kNvwEn5LbG&_nc_oc=AdoHiBpM_JbSN55aKuNBxRKwhkcgenkOeBkAoLi3F9I6-cZh3CStOtdMCC07BltAM5s&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPo9GYD3K0Y7SoJ0GPZgtFoBi-fmdRvdQ4LaJdiBPvgAg&oe=6AE36A32"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
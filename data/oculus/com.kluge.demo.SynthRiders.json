_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nGDY1bTdBUwQ7kNvwERl3iZ&_nc_oc=AdrOVR48LAC9GngcgpdKMTkc1VdHt32fo62sm0XggIjYv48qZso7C7IQdY_bkGx9ScA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJM40R2qM6xhLrWM7wRm0bynRcz7rtapsYSTvIo1nrsDA&oe=6A9C18B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uwIrfrn2bEQQ7kNvwG4ogdU&_nc_oc=AdozGvofKzEefbqNNK5w5e-CjNU1WPFCAB33iPzgkCYDpKioWq3v7jXLTtq6BMcU48c&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLnAmxlqSjaX2Whd7iYY_BwuOj3FXvM-INa03I8_ZbdxA&oe=6A9C3844"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=z9C2fCi4yYsQ7kNvwHi31pZ&_nc_oc=Adrg3NhDSvQZOjBwCW6EoX1WU_qBGeGRNCY3Xd8NKEPvlwiAi3ew2BbexFfX7Cfh2XI&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIPcIVfbgvN8Wiog9ZSb2Rj9sGCQhvfhBEU-xVw6G6agw&oe=6A9C15B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N6kGnB0PZaUQ7kNvwFVb9v5&_nc_oc=AdqXOIIUUXa9H3KQnQ_IvVzRYaB8ml4Pd57tJFyxrXWcaiCN9SeQ5yd1FKfBLfJWrbc&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIxMBrkWMHCjFgxeyWY--MKxpOZgW0URk63GZdmwV9qrg&oe=6A9C0C99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_S8gKJGojUEQ7kNvwHJ7NSC&_nc_oc=Ado4rK3YnleFktUs2ifLzPlnq_Z3LJZbh7dde-MryEOV_ICIDFO9NirlB7QvXLETQwk&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIYkWjY88AxC5CnTzCDHLF8B5qugddmj8LELyaYO9MYgQ&oe=6A9C3932"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
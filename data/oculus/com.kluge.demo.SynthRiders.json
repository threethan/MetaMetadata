_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Lw-wOV-egu4Q7kNvwFHndJ2&_nc_oc=AdqfVyiauQ48ogJIXSxUMiZrUzMUTpnj7-IIJnxsdgGD66qDEruyE13l04ZNXqCQdRM&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1ETcxyhQijWY1uiBcWfRzdAz8S_MKqYTzzoSbAg0yJsQ&oe=69E629B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_tN9Oaz6cr8Q7kNvwGflbiW&_nc_oc=AdprJyfHvgBIB68logOa7Qh189WnUJh_ozepYuqC0eclCKtdOSEXu0wXkHmrHwAdXrE&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af1xjR0UJh3Yfm92AksqYO-Xtq_CFvY_9Ar6jGb6h1v-Ow&oe=69E61104"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZrTkCwPqUZIQ7kNvwGmWisG&_nc_oc=AdrWiENZvSFd1dt5sygqJ7C_5WiVgzC6c0bc1YG6oAE3mOaU2aHlrDTrrTsg12sIBYc&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7a30f&oh=00_Af12HHEV52tNPTBQQVT6yL0GL1qhT91_H2TZGpMnqTZK3g&oe=69E626B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ckv9srmyklQQ7kNvwGZjo0N&_nc_oc=AdonlK9oBfRv21z_ypwXimIsBwwDdTzVhudtat2yqszmQieORwNR3P54k2z6CWxuDSQ&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af29gDHEvAvyC9IGrar9jVIQV0Ca31Llle4Z9HFwtFmgfQ&oe=69E61D99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-dfw5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NSBSV53lrSIQ7kNvwFqSlbX&_nc_oc=AdqPmwRtNFeTU3Njy_oz8zJXEzOS89AJM3oRTmioGWmQaz9cI7wpU2zBwnYfq3_ux9c&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7a30f&oh=00_Af3h3Xhlxjjt8AOTYMjx-cCI9a3CEud6B6PAyOeA0CUufw&oe=69E611F2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
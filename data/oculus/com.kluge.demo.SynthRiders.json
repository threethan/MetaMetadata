_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=OY0jQqQ1hyQQ7kNvwE5ZRIG&_nc_oc=AdodREO8KGfoZfhHzgJrAoWf0aEyF0Rn_jHepr22SS7FlnJbuRyDoqHyEzjTd93EpYc&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQM7cbcYxmjS_8w-XAzp9Ax9C4yAuaWalb5rR18c5Yq87w&oe=6ACE69F0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UEdTZhM0PNkQ7kNvwEXZ-9V&_nc_oc=AdoMENgnL4VOwL9hBn28vamMHIrA7OFa4s999PfvfCjU_2qiXn5xUVjNRJx8f42f6c8&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQOgrvUmNEbUfoUr_iessRLDV5kYHnqtBcWpjwJTfmfiEw&oe=6ACE5144"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WZTQ9QyxL8oQ7kNvwEfQ2FA&_nc_oc=Adp_DyA5hUxSN1y0GTCEFFLezCLoxlWh4_u2kLw2ZvJxljA5hr10M1z2UPoxmNV6bMI&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPL2Sc7wLLUI5upsg2iy08325gmuaMyLZHQaKUy57hOvw&oe=6ACE66F3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=S9Bk6JaRRXsQ7kNvwHPguIR&_nc_oc=AdrcS7cgHhGec9MQoack_MucmAaHiG0yeSYykC_c9gjjJnJ6dbHnj-bch2PQMUvAI2w&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPpp4KtovwZ0vOsLDY8lo7FoaoN5Lk7fo4PdQKZ7RhlMA&oe=6ACE5DD9"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=NkSF5kVCAXoQ7kNvwES1dGj&_nc_oc=AdpREr-Tz6oa-fWbrObX74OaRghr8xNipqGvIxh7gLcFkb7R0C1BmoMZh7J9wPbrjAA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMp_eUj4tg6mMYRidt1I7sp3ljPxKJpE_h8yBmhzCZ3Vw&oe=6ACE5232"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
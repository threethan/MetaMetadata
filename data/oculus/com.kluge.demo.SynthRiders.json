_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CqoLbfrdkl4Q7kNvwFqifVc&_nc_oc=AdotxdLCsnRhYB4986MPl8pZuF7MOBaEHeRuyY0A3vQbc1lQfPpBNnKN4DdxSB-Em6Q&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQO-E6hLcrnMFtNk1Fj8VI9tm76J43r51-RvrIwAaGgySQ&oe=6AC79A30"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=11gPMANeeXkQ7kNvwGxPVp5&_nc_oc=AdoC0e35OAzT6m5-XuonwpyT4Soiq6kOQ28scfSBqSk55Y7smrFGpMen3ga9Nsy0cZc&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQMxVLmMrHTcwFLyXy2k1PCAisCl7XCOREQaif79SF4oqA&oe=6AC7B9C4"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PC6he3CAHuwQ7kNvwEVb5Sy&_nc_oc=Adq29OKisu-uCQrJ-dc01-DiV3OnC2FPk3YksKE88FjLj2_ys94QxD9cJ5zcFIpceQQ&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQNHRYhnm1NyXgJ1fzJm11xmLB__R4gZZaLgcWQlmkD9EA&oe=6AC79733"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hXgTXsuyyR0Q7kNvwGkur_c&_nc_oc=AdpUR9m05_GJ0mbuPZwEEm4yp1Uyu8svOmQ97IUhtDXL2VmkRcG3N-XOdJI8lSZUJOk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQP1OidHQ_FAnAXOFF2T1gygPiC7toMynURg-7uu_Np4dw&oe=6AC7C659"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=aJaL_vILVxcQ7kNvwHhejE7&_nc_oc=AdoStoHXu-coubP53Lj402JoYISOL3wBVdlJz4z1idrI9FGBC33hxWX3LHfxKl7GXPs&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQPgWfBRc2Yn7QFIy_xKIInmWysZL4leKs3g-Gb7dY0P9A&oe=6AC7BAB2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
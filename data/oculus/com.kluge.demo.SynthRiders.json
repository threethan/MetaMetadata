_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=PxVaLBkEFzcQ7kNvwEgFAld&_nc_oc=AdpvnuHVmM0HGXhBwW-wU-rauaC0TjWCLSF0bufPhc84rtCsp_QUfwZgrGq-kdVMBvM&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6TM-aIgakClSVi-YKxklpiKMUVf_2rz8puBosUhpooYQ&oe=69FB41B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=_pPTK9xou2kQ7kNvwEUyO2L&_nc_oc=Adr12a5Erg_RLTBv3xdsy1lxzMRIk1e39vWtyfWH7f2qiDI2eetearEBYhg5UzzBMVA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5zCpdQ-Kz-JWrT0pz1CAC7BLAJTvBni_LRz9IBpU3P1Q&oe=69FB2904"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Ud-5fAKDMnYQ7kNvwGXBSqh&_nc_oc=AdoKqHN7q00OIXx_DTaBdXgaCnmH0JFzqBYIR2VobAlCX6mDKQAGSHoeGzDLorHBBdA&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af66VPeRKmJFDJvw6KjMAY-oaZRY1lGLkFG1dV8M4r0JdQ&oe=69FB3EB3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=uxRo3uBUkYEQ7kNvwHTHKJm&_nc_oc=Ado-2n86twkK2RgNVcctZLSC-jG9djHrR5uSlqdmuR1yK0gQT2-j2KpoUth9qI4lN0w&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4G6v307miNGgsFoHI-W5KzfxUmImyjUBZClPMqACJ3fQ&oe=69FB3599"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-ams2-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=zps2w6XOLgQQ7kNvwFE1J4r&_nc_oc=Adpj1tNsTdGgRndTbfuEbFu-Zi7FqnbPOweNVJepPE9MrPSp2hHXOofAGBvGcfSyu6I&_nc_zt=3&_nc_ht=scontent-ams2-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5gGE1pEwi2GHG-Z1B5DOMGNZnWS5-VhkDPvVGrRyhNdQ&oe=69FB29F2"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
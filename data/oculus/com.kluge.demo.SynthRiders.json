_731931654130105_4065687922690588293_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=P96Ot6tsCGEQ7kNvwGtMoQv&_nc_oc=AdpmoBj5635tsrLYUmhh5g8Igj1klTPRRl1Pxt5MPBp1fNgIZV_vGhBG1b9Ikg_Jcro&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQIBjwB_tBER3MO_0pkkw-H-B_GK7EZHHPfk2SV5r2ZRIQ&oe=6AB676B0"}, {"file_name": "Adrenaline_Screenshot1.png", "id": "458103595396669", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/39031354_458103602063335_6716290204444562135_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MBo_H21sWuYQ7kNvwGjzEmO&_nc_oc=AdoO8uoK-aC9bJXgjEcv0JuK2Tmr65ZuzfFr2GKIL-Pf5VJuALZdYWr_Tk7HKTEwhQ4&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLzwqvuZsGf97V_jOGJdpooruZkJUr_ERLV3kThR7Vc7Q&oe=6AB69644"}, {"file_name": "38974483_2826172501001090_6709439389986592204_n.png", "id": "1541857229341944", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/75549075_1541857232675277_4774659703801469860_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hB89S1NNnggQ7kNvwHAA9Us&_nc_oc=Adp2Sc04JQb4gFv0MgjvSTFIB25IRYN2j93Shq9H18K05qGBbihSriNulUywngL2Nzc&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQJrJO9xH51m756DGmVPN8jdDv8J50Ivst9WZ0R-ju8YRQ&oe=6AB673B3"}, {"file_name": "75443251_1698434823657563_580012992956978883_n.png", "id": "762115074431769", "uri": "https://scontent-sea1-1.oculuscdn.com/v/t64.5771-25/75371506_762115077765102_4739356723719856490_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=MXPg797OwEEQ7kNvwGHljF5&_nc_oc=AdoV7sD0HjTrvuuQc-a5qdchn0J-IYuHPYhgJgkFIXm1V1gZYbiNSPo92olwCVc7niQ&_nc_zt=3&_nc_ht=scontent-sea1-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQLNPdcU7j875Qc9DoHlAPF2L_8evhQufQTP5pRE8mrPQA&oe=6AB66A99"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Landscape (2560x1440).png", "id": "492689858427362", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/38974648_492689861760695_1651259702864724545_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6Q3WBVM5Ta8Q7kNvwGMteDx&_nc_oc=AdqiJjJjtQLVXrc_Wv6LvnLhaL1pi0l7VpM7oHtlvw6SHIEEXOBbaizOeuoffXX6udk&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQKQGjFHpe-Gxa0kyW0K089HjDaO6iLAiMF5ytLG4l5qww&oe=6AB69732"}, "display_name": "Synth Riders Demo", "keywords": [], "long_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nA FREESTYLE-DANCE RHYTHM ALTERNATIVE\n\nCUSTOM SONGS officially supported - never breaks with an update\nGOOD FITNESS - activates whole body without repetitive movements\nGREAT MUSIC \u2013 74 free and 67 DLC songs from Gorillaz, Muse & more\n\nIn the demo, you can play 7 songs on all difficulty levels and experiment with all the modifiers - unlimited!\n\nThe full version of Synth Riders is available on the Meta Quest Store featuring:\n\n\u2022 135 Songs - 74 free and 67 DLC, including Gorillaz, Muse, Caravan Palace, The Offspring and more!\n\u2022 Official Custom Song Support\n\u2022 Cross-Platform Multiplayer\n\u2022 360\u00b0 Spin Mode in Every Song\n\u2022 Party mode - local multiplayer\n\nWe hope you will enjoy the demo and join the Synth Riders community soon!", "short_description": "Synth Riders Demo will no longer be supported on Meta Quest devices and new users will no longer be able to search & install this app. If you already \"own\" this entitlement, you will continue to have access.\n\n---------\n\nWelcome to the demo of Synth Riders - a freestyle dancing VR rhythm alternative. The demo comes with 5 songs on all difficulty levels with all the modifiers!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://synthridersvr.com/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "Kluge Interactive", "support_website_url": "https://synthridersvr.com/contact-us/", "website_url": "https://www.synthridersvr.com/", "category
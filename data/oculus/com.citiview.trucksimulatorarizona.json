enshot_2.png", "id": "1340598564657310", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491821796_1340598567990643_2604519518196771281_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KfI2xo3VyDMQ7kNvwHYg23x&_nc_oc=AdqFTnGznZfU-hyVc9trB0ezm0msHr04N-C5AMloQq2XMicKvCuPJ0FLuXNoZyiXhN8&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSesWd-2UJqHKw-sTDD4_M-XsoObxNl08-TYvCIdQ5hzg&oe=6AF46F56"}, {"file_name": "screenshot_4.png", "id": "2716068365456673", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491821704_2716068368790006_6785037468145842543_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=To650JlM0AEQ7kNvwFYn8dh&_nc_oc=AdqyOWRlrFPA_b2vOwFTAbKdaBXurt2RrZWM-EJMBBj92JtyC7gpUghtw7Fo694Z7VA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRV9W2L53Z75blX8rOYYp8bTh61TwfpstBhCt-9oLDbWA&oe=6AF497C0"}, {"file_name": "screenshot_3.png", "id": "1406698984409130", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/491824322_1406698991075796_8810201696097564253_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=0U2asFCKtdAQ7kNvwFqNCt7&_nc_oc=AdpBQdT2rcVSLqS0x6TLni-JVrDSelNxtXoT_cuso0-4AjuVeBywuv-t4V26z5DNjv4&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6IXpDWZQi82Nr88SKLplnVjBTTMzqfc5xhzW1cALyPA&oe=6AF4978D"}, {"file_name": "screenshot_5.png", "id": "1875464213258309", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/491824665_1875464216591642_6488805941350155805_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=v3boriQd0N8Q7kNvwGXnhAg&_nc_oc=Ado4zA10ve1EqxNu4rWhwwFSPkwk3ApaL2wT4kjvWJWmyRuiZwj24WROTM2QJcgaTRg&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQqfgM2x9HiawPnTYmcwnbtxkYhHB5NRth3-wLYIl1Mlg&oe=6AF478C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1109268038155444", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/673536876_1109268041488777_8570920867946288817_n.png?_nc_cat=105&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=tJcVpKcFy0MQ7kNvwGHMxOh&_nc_oc=AdoaWTfb8Pv1sFyN4bXrGrfk2R4PYnz4YzVfy-UT-CXGseW5B3wp5TunmSZIsLVAyGY&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQhWccs5aRCwnv-cAa_2lFXMxnI84zWncSN75r7FS4pYw&oe=6AF481AE"}, "display_name": "Truck Simulator Arizona", "keywords": ["truck", "trucking", "driving", "simulator", "arizona"], "long_description": "The open road, from the driver's seat - in Arizona.\n\nTHE PHOENIX LOOP\n47 miles of real Phoenix freeway built from real map data: Loop 202 past Sky Harbor, Tovrea Castle and Tempe Town Lake, Loop 101 north through Scottsdale and west across north Phoenix, then SR-51 through Dreamy Draw and the Phoenix Mountains. Real ramps, real overpasses, saguaros, palms and the desert all around.\n\nA SHOW TRUCK TO CALL HOME\nWalnut dash, cognac tufting, fourteen working gauges and a starlight headliner. Grip the wheel with your own hands, pull the air horn, set the parking brake - or drive with the joysticks.\n\nA REAL 10-SPEED\nPick AUTOMATIC and just drive, or switch to MANUAL and float a 10-speed through the H-pattern with a LO/HI range. Match the revs and it drops in. Miss it and it grinds.\n\nHAUL REAL ARIZONA LOADS\nSix depots in real Valley places - Sky Harbor, Tempe Marketplace, the Mesa Riverview truck stop, Scottsdale Airpark, Desert Ridge and the Biltmore. Back under your trailer, take the load and deliver it through Phoenix traffic.\n\nDAY AND NIGHT\nDrive at noon or after dark with the Valley lit up. Night runs pay extra.\n\nON THE RADIO\nA real dispatcher and five truckers on the CB with Arizona road talk.\n\nTHE SLEEPER\nLeave the seat, walk back into the sleeper and sleep through to morning.\n\nPlus 17 achievements, 9 paints and a live map.", "short_description": "Grab the wheel of a long-nose show truck and haul freight around Phoenix on a real 47-mile freeway loop. Run the Red Mountain past Sky Harbor and Tempe Town Lake, the Pima north through Scottsdale, and the Piestewa through the Phoenix Mountains, by day and by night. Shift a real 10-speed manual or let the automatic do it, take loads from dispatch, chat on the CB, then walk back and rest in your sleeper."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/trucksimulatorarizona/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/trucksimulatorarizona/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1378067645386098"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1651106559698778"}]}, "baseline_offer": {"id": "1651106559698778"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1791993780, "status": "PUBLISHED", "id": "1651106559698778"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "1381054801754049", "version": "1.0.1"}, "id": "1080753571426798", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "1378067642052765", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "1381054801754049"}, "release_s
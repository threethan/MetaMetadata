gxBXm3im6LOMQhABX5oJ_MzvtcX9FGvXa_taMwi-I-bRDqRREZdGBvb2v4dB3bHE&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ3B0fBjbH_2-0FvPh6tsOYbAj2w9HrzH6Dj0L4kj2C5A&oe=6AFC808D"}, {"file_name": "screenshot_5.png", "id": "1875464213258309", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/491824665_1875464216591642_6488805941350155805_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4bkar3wQlKcQ7kNvwEPJ_0U&_nc_oc=Adq6FwsU52P5nlEI3yiDnXu4_qMpcjGl6oQgEjx4Q_fGc6gL64fVzBiXgf4qgtn0lDk&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQR0TDd3gA6ibo9-82qw5w8QqBZ-4da8ZXJomMFwmXRT7w&oe=6AFC61C7"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "trailer_cover.png", "id": "1109268038155444", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/673536876_1109268041488777_8570920867946288817_n.png?_nc_cat=105&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5lAQduNUwTEQ7kNvwGvUSnN&_nc_oc=AdrZILNwFTJWAjKZJiEOP_t9UYFbw_R8PX0zWfM6r0ppf6dWTneSiE_2MeJClwY6Fbo&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQztND6iCr9Aoe97JKnmxJrHKq7fgw0B94pFdJNniyEnw&oe=6AFC6AAE"}, "display_name": "Truck Simulator Arizona", "keywords": ["truck", "trucking", "driving", "simulator", "arizona"], "long_description": "The open road, from the driver's seat - in Arizona.\n\nTHE PHOENIX LOOP\n47 miles of real Phoenix freeway built from real map data: Loop 202 past Sky Harbor, Tovrea Castle and Tempe Town Lake, Loop 101 north through Scottsdale and west across north Phoenix, then SR-51 through Dreamy Draw and the Phoenix Mountains. Real ramps, real overpasses, saguaros, palms and the desert all around.\n\nA SHOW TRUCK TO CALL HOME\nWalnut dash, cognac tufting, fourteen working gauges and a starlight headliner. Grip the wheel with your own hands, pull the air horn, set the parking brake - or drive with the joysticks.\n\nA REAL 10-SPEED\nPick AUTOMATIC and just drive, or switch to MANUAL and float a 10-speed through the H-pattern with a LO/HI range. Match the revs and it drops in. Miss it and it grinds.\n\nHAUL REAL ARIZONA LOADS\nSix depots in real Valley places - Sky Harbor, Tempe Marketplace, the Mesa Riverview truck stop, Scottsdale Airpark, Desert Ridge and the Biltmore. Back under your trailer, take the load and deliver it through Phoenix traffic.\n\nDAY AND NIGHT\nDrive at noon or after dark with the Valley lit up. Night runs pay extra.\n\nON THE RADIO\nA real dispatcher and five truckers on the CB with Arizona road talk.\n\nTHE SLEEPER\nLeave the seat, walk back into the sleeper and sleep through to morning.\n\nPlus 17 achievements, 9 paints and a live map.", "short_description": "Grab the wheel of a long-nose show truck and haul freight around Phoenix on a real 47-mile freeway loop. Run the Red Mountain past Sky Harbor and Tempe Town Lake, the Pima north through Scottsdale, and the Piestewa through the Phoenix Mountains, by day and by night. Shift a real 10-speed manual or let the automatic do it, take loads from dispatch, chat on the CB, then walk back and rest in your sleeper."}]}, "developer_name": "Citiview Studios", "developer_privacy_policy_url": "https://citiview-games.pages.dev/trucksimulatorarizona/privacy", "developer_terms_of_service_url": null, "publisher_name": "Citiview Studios", "support_website_url": null, "website_url": "https://citiview-games.pages.dev/trucksimulatorarizona/", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING
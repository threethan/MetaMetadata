85_868378569368798_5614677897351567918_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KMPl_Y3eiPUQ7kNvwEORbUD&_nc_oc=Adpm7kWu9xqbkJKp8TPoJ3TBKt0scQ_NQ0vHUxxatAqfC9bVAdY_ds_x9mqww2yRHgk&_nc_zt=3&_nc_ht=scontent-lhr6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7jHVcbZnC9fIX4733JbTkg-j2bFXkzmx5lw90M9S76HQ&oe=6A107B59"}, {"file_name": "4.png", "id": "2311979292603887", "uri": "https://scontent-lhr8-2.oculuscdn.com/v/t64.5771-25/491824671_2311979295937220_3734301968810257692_n.png?_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=nKkiPs7HtPQQ7kNvwGwCUoX&_nc_oc=AdrtKBC9tcxVcaBQoUrUEpNSvcWaIDMck49JGgnJ-AtppCbdd_8BPH7Y_-k9MuGrh7s&_nc_zt=3&_nc_ht=scontent-lhr8-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6AO4g4HP2GIEqQayiLMgsuTWeJECV1B__EXQ5Y7hpBbA&oe=6A107D8D"}, {"file_name": "5.png", "id": "2502902350124882", "uri": "https://scontent-lhr8-1.oculuscdn.com/v/t64.5771-25/491820887_2502902360124881_987072235515543779_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=89M-UsSrW-wQ7kNvwHyESoc&_nc_oc=AdrZRT_9GWSWC5gdRI30LbntdLE9XaV4VnlNl0_DrrNrr0nj_QzoFe1l6E-wR22kXOw&_nc_zt=3&_nc_ht=scontent-lhr8-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5X5YR30facsUSTj9Ubx9EQMDSyE26aM7s1j9uIRxCY-w&oe=6A10550B"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Bottle Shooting Simulator: Shooting Game", "keywords": ["bottle", "shooting", "fps", "simulator", "action"], "long_description": "Bottle Shooting Simulator \u2013 Shooting Game is a realistic and engaging shooting experience focused on accuracy, timing, and control. Step into immersive environments where your goal is simple but challenging: aim precisely and shoot bottles placed at varying distances and angles.\n\nThe game features smooth shooting mechanics, responsive controls, and physics-based bottle reactions that make every shot feel rewarding. As you progress, levels become more challenging, testing your focus and hand-eye coordination.\n\nDesigned for both casual fun and skill improvement, the simulator offers comfortable gameplay, clean visuals, and intuitive controls. Whether you want to relax with target practice or sharpen your shooting precision, Bottle Shooting Simulator delivers a satisfying shooting experience.\n\nKey Features\n\ud83c\udfaf Precision-Based Bottle Shooting Gameplay\n\ud83d\udd2b Realistic Shooting Mechanics & Physics\n\ud83e\udde0 Skill-Focused Levels with Increasing Difficulty\n\ud83d\udd79\ufe0f Smooth & Responsive Controls\n\ud83c\udf0d Multiple Shooting Environments\n\ud83c\udfae Casual-Friendly & Simulator-Style Gameplay", "short_description": "Bottle Shooting Simulator \u2013 Shooting Game is a skill-based shooting simulator where precision matters. Aim carefully, shoot bottles, and improve your accuracy across challenging levels. Featuring realistic shooting mechanics, smooth controls, and immersive environments, this game delivers a fun and satisfying target-shooting experience for casual players and shooting game fans alike."}]}, "developer_name": null, "developer_privacy_policy_url": "https://sites.google.com/view/prism-horizon/privacy-policy-prismhorizons", "developer_terms_of_service_url": null, "publisher_name": "Prism Horizons", "support_website_url": null, "website_url": "https://sites.google.com/view/prism-horizon/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "25682103721459214"}}]}, "scheduled_offers": {"count": 4, "nodes": [{"status": "PUBLISHED", "id": 
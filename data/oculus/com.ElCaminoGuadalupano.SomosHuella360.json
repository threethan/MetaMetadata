I0U&_nc_oc=AdqQqFn9Dt3a38aNQYgtfygLiFTUL5h9S_zYfEZnHQHwNoZbNXzFuy8u3qYwJOYbM_A&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6RLjiAmIJhUvsJG7BgkPbvp2YyHgOqIo22DjrRqo1qsQ&oe=6A20369A"}, {"file_name": "VR Screenshot.png", "id": "1500434708147842", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/499619518_1500434711481175_5178569538702747023_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=N8dfIpcEZhcQ7kNvwHPyDBF&_nc_oc=AdrnQvYT33_bHABjsDEDS_Z_ULMWLlEKSjOls5gcL8V5IH64cD-OppC53FKUs4OxSfk&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5ZoRFqHG_nCdESYV9R5HLwoZd-Qk79XLNDpgnQsA73xQ&oe=6A2036F7"}, {"file_name": "poster.png", "id": "1966183474773491", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491821702_1966183478106824_8794531289685052620_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=klEHzjhmhFMQ7kNvwFKNjdM&_nc_oc=AdpIL8Io7rPzfb0X0wrESbEK9wDXRD3NwHd5Gpl34lJD28TvFtYFyB9c_SCGDccoeB0&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7OStxm3sOtDDDf8p2gM4TYnlB9iFF6W0k0zztQBV-p4g&oe=6A201EB5"}, {"file_name": "photo_2026-03-22_00-57-16.png", "id": "1007507484937800", "uri": "https://scontent-sjc3-1.oculuscdn.com/v/t64.5771-25/491825481_1007507488271133_2208137003614492063_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=1qSthKb-CQcQ7kNvwEUqsTD&_nc_oc=AdoB2okderHjjTr5TasVSQJeyN7T1kuFrU6ZngfcklOnSWEYsYqVU5UaBP8yriM6vEQ&_nc_zt=3&_nc_ht=scontent-sjc3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af5TwDT1bDthAt-rUDJ4sgcztXHYOwK5H5I5M_Qm_iHr1g&oe=6A203115"}, {"file_name": "VR}57-16 (3).png", "id": "1308938404434474", "uri": "https://scontent-sjc6-1.oculuscdn.com/v/t64.5771-25/491820141_1308938407767807_2997545556312642824_n.png?_nc_cat=107&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=4vVmseL6VgAQ7kNvwHv-DK8&_nc_oc=AdodIDg-FnqDxbF5VTQd6fuY3jf73mGYWWba0-mlmTSFjclBQ0tfCcqm5vN4LJ9vZKc&_nc_zt=3&_nc_ht=scontent-sjc6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4PMC97ixSTOfKP8eFtPnEbVZFieJi6QrxjPSes46TPVA&oe=6A2034F6"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Somos Huella", "keywords": [], "long_description": "Somos Huella VR invites you on an unprecedented spiritual and technological journey. Immerse yourself in the historic \"Path of Juan Diego\" and relive the profound apparitions of Our Lady of Guadalupe through a highest-quality 360\u00b0 cinematic virtual reality experience.\n\nThis application has been designed with a special focus on accessibility, with seniors as our primary audience. Our goal is for technology not to be a barrier, but a bridge to faith. Therefore, we offer a simple experience that is intuitive from the very first use, requiring minimal manual interaction.\n\nExperience Features:\n\nDeep Immersion: Enjoy a highest-quality 360\u00b0 video production with a duration of approximately 40 minutes.\n\nZero Complications: Automatic video playback upon launching the application. Just put on the headset and your spiritual journey begins!\n\nSmart Sensors: The system features automatic pause when removing the headset and automatic resume when putting it back on, allowing you to take breaks without losing the thread of the story.\n\nIntegrated Accessibility: An optimized 360\u00b0 video player that includes easy-to-use toggle options for subtitles.\n\nClean Design: A minimal and clear interface, intended for non-technical users and designed specifically to avoid distractions.\n\nJoin this story of faith, hope, and love. Feel the company of Our Mother Mary face-to-face, in a peaceful, safe, high-quality technological virtual environment.", "short_description": "Relive the inspiring story of Saint Juan Diego and the apparitions of Our Lady of Guadalupe in a deeply spiritual, 360\u00b0 immersive virtual reality experience."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.elcaminoguadalupano.com/pol%C3%ADtica-de-privacidad", "developer_terms_of_service_url": null, "publisher_name": "El Camino Guadalupano", "support_website_url": n
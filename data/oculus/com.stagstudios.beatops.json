]: [Add a brief description here, e.g., An endless void filled with shifting shadows and neon ley lines.]\n\n\ufffd Other Improvements\n\nOptimised performance for smoother gameplay during high-intensity sequences.\nGeneral bug fixes and UI polish for a cleaner experience.", "created_date": 1774520313, "id": "26233204723010041", "version": "0.1.7", "version_code": 8, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}, {"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_application": {"__typename": "Application", "id": "24974378355559357", "is_concept": false, "latest_released_binary": {"__typename": "AndroidBinary", "id": "26445766621753849"}, "release_status": "RELEASED"}, "binary_release_channels": {"nodes": [{"channel_name": "LIVE", "id": "1353380233166755"}]}, "change_log": null, "created_date": 1774504312, "id": "26231297916534055", "version": "0.1.6", "version_code": 7, "release_status": "RELEASED", "status": "APPROVED", "binary_test_results": {"nodes": []}, "obb_binary": null, "asset_files": {"count": 0}, "debug_symbols": {"count": 0}, "__isAppBinaryWithFileAsset": "AndroidBinary"}]}}, "viewer": {"user": null}}}
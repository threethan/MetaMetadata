 these bubbles can bounce around the physical surfaces of your room. Your hands will change into bubbly colored texture/material that you can pinch and change the color of it, you will need to match the color of the specific bubble to pop them within 2 minutes and 20 seconds.", "short_description": "Mixed Reality casual game inspired by popping bubble wraps, bubble shooter games and push pop fidget toys! Pop bubbles using your fingers!\n\n"}]}, "developer_name": null, "developer_privacy_policy_url": "https://kaberikram.github.io/privacy", "developer_terms_of_service_url": null, "publisher_name": "ikram hakim", "support_website_url": null, "website_url": "https://kaberikram.github.io/dreampop", "category": null, "comfort_rating": null, "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "1592192974313489"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["HAND_TRACKING"], "supported_player_modes": ["ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "7702113883202785"}, "review_messages": []}]}, "cover_square_image": {"uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/75441574_1128887655047936_4220281866496840916_n.png?stp=dst-png_s360x360&_nc_cat=106&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lur81-U1MkgQ7kNvwEcpnaX&_nc_oc=AdmF8rs1abT_GFATs5kOcYLTiYVHJtEMGAzrEFWunlYrsrR2QoPzxj0X06N6tAaDkFE&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AfsR8Uz1ZlPA7WVyeHcLmUMWuOsDaUNPjj-9pAFcujL1_w&oe=69A0523A"}, "is_concept": false, "is_test": false, "is_trial_offer_valid": false, "display_name": "Dreampop", "platform": "ANDROID_6DOF", "context_category": {"context_category": "GAMES", "id": "2743326035925534"}, "
wH5BPoU&_nc_oc=AdrYV3Ljg4-tbrLw1uaE0WhAytONXxgArUMR1SyBr8lQgBQI99Qr26CsolgqcwlroiA&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS6XM9ZY1xVUGLclBVe9fUDCNnllj-IubS-kT0jdzJpbw&oe=6AFDD398"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Mars Is A Real Place", "keywords": ["photo", "pano", "3d", "gallery", "titan"], "long_description": "Experience the red planet like never before in this musical slideshow of stereoscopic 3D photos of the surface of Mars.\n\n80 spellbinding high-resolution 3D images have been carefully curated and presented for comfortable viewing.  Images include views from Mars' orbit and panoramas taken on the surface.\n\nThe slideshow is set to music, and each image comes with supporting information for those that want to delve a little deeper into each landscape.   Headphones are recommended.", "short_description": "Experience the red planet like never before in this musical slideshow of stereoscopic 3D photos of the surface of Mars.\n\n80 spellbinding high-resolution 3D images have been carefully curated and presented for comfortable viewing.  Images include views from Mars' orbit and panoramas taken on the surface.\n\nThe slideshow is set to music, and each image comes with supporting information for those that want to delve a little deeper into each landscape.   Headphones are recommended."}]}, "developer_name": "DrashVR LLC", "developer_privacy_policy_url": "http://crunchywood.com/miarp-privacy.html", "developer_terms_of_service_url": "http://www.MarsIsARealPlace.com/", "publisher_name": "DrashVR LLC", "support_website_url": null, "website_url": "http://www.MarsIsARealPlace.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": null, "context_topics": [], "external_subscription_type": "NOT_REQUIRED", "genres": ["EDUCATIONAL", "SPACE_UNIVERSE", "EXPERIENCE_360_NON_GAME"], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area
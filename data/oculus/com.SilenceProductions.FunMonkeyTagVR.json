DMdehe18N6-vSEbIyzU5FiXVmvjc8ycqQiw&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHuAGuVJeYO3n2HTis0Q6cfCC5NeckqcN3Bc4WcmUx3Cg&oe=6A79C09A"}, {"file_name": "SampleScene_Custom..._11.05.2025_00-36-08.png", "id": "2106245489843425", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/491822590_2106245493176758_6731444640854773619_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=bqFfeYtYrVgQ7kNvwEcCuG2&_nc_oc=AdrS6U4fb7eRA6sDo5xnoYCWWvcQyK5fAd9B9ZatVbLCO9GjQDFKKez4m5AmGTNzNvQ&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQF_1r5qp6lojfnXA_ihKzA7-uqJD8KBbPr5Os6B673j0w&oe=6A79E792"}, {"file_name": "SampleScene_Custom..._11.05.2025_00-36-24.png", "id": "696173076219597", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/491824611_696173079552930_840249518127391179_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=BTHhoO0hGU0Q7kNvwFk8ayd&_nc_oc=Adp61-o5hcn88fq7Icz3ZkJDsf_IwbOVBgqBwwPrko1WDmPZRBuc8icF-qLDh7ekA0Y&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQG3mPgdluQ_hmuth5zBQQ_da4pkk0w4CebDVhSk2WnUvQ&oe=6A79CAA8"}, {"file_name": "SampleScene_Custom..._11.05.2025_00-56-52.png", "id": "2079590259214654", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/491821920_2079590262547987_5766758722258167148_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=WrGUq8EPLiIQ7kNvwF5Bsm8&_nc_oc=Ado4iRJs8uD993vKPuZL5b7XrlhT-DwWv_OSFkBqnS1AJrOFzV77eH8ZBud_TsyciXk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGaoi7fjOfV6hib5ZhyIAurH_zMtnvqY--hccpwfnp8VA&oe=6A79CEEF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fun Monkey Tag VR", "keywords": [], "long_description": "Fun Monkey Tag is a high-energy VR locomotion game that turns you into a fast, agile monkey in a vibrant, interactive jungle world. Using only your hands to run, jump, swing, and climb, you'll experience true freedom of movement as you chase \u2014 or flee \u2014 in chaotic rounds of tag with friends or other online players.\n\nMaster the art of monkey locomotion as you swing through trees, scale walls, vault across obstacles, and launch yourself with precision and speed. Whether you're evading pursuit or hunting down the last untagged monkey, every movement counts in this competitive, yet hilarious experience.\n\nFeaturing multiple jungle-themed maps, customizable monkeys, and a growing list of game modes, Fun Monkey Tag is built for replayability and nonstop laughter. Whether you're playing casually with friends or diving into intense tag battles, the intuitive movement system and immersive environments will keep you coming back for more.\n\nGet ready to monkey around \u2014 and remember, in this jungle, the floor is always lava (well, sometimes).", "short_description": "Swing, climb, and leap like a wild monkey in Fun Monkey Tag \u2014 the ultimate VR locomotion game! Join friends in chaotic jungle arenas where speed, skill, and agility rule. Tag or be tagged in this fast-paced, fun-filled primate playground!"}]}, "developer_name": "MistilenceProductions", "developer_privacy_policy_url": "https://sites.google.com/view/fun-monkey-tag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MistilenceProductions", "support_website_url": null, "website_url": "https://sites.google.com/view/fun-monkey-tag/privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_
9XahiIrI29DxJ4_NJZ5f8MIvuE4IGcSw68w&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQyj3IY0w4iqEdIV7hASOA46KwcyERGXpf2oRTE5WqTNg&oe=6AF9DA5A"}, {"file_name": "SampleScene_Custom..._11.05.2025_00-36-08.png", "id": "2106245489843425", "uri": "https://scontent-dfw5-1.oculuscdn.com/v/t64.5771-25/491822590_2106245493176758_6731444640854773619_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=eX3X1U0yWMkQ7kNvwH9ADrA&_nc_oc=AdrOkqQUh81WzQvuczR5cPMzVFzfVzcHpElAt9-IrMp7e3OozmxoVfKlGhy2OqSqJ5g&_nc_zt=3&_nc_ht=scontent-dfw5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTaVwhngIqZZfSJvKdqjHNyOgRuc2IZuF7ru25YzZDYpA&oe=6AF9C912"}, {"file_name": "SampleScene_Custom..._11.05.2025_00-36-24.png", "id": "696173076219597", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491824611_696173079552930_840249518127391179_n.png?_nc_cat=102&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=XemWcicz1HQQ7kNvwGzo9kR&_nc_oc=Adr-gXfMJHLuf33g3NaanOcy8GCIHaT6Gl-neTagblW_E2pClqZ7wpGy6v41pXS4it4&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9prKWg5WV7XmJ0U8q4AEtKFr_l7U2bqoEdOF1zkQd0w&oe=6AF9E468"}, {"file_name": "SampleScene_Custom..._11.05.2025_00-56-52.png", "id": "2079590259214654", "uri": "https://scontent-dfw6-1.oculuscdn.com/v/t64.5771-25/491821920_2079590262547987_5766758722258167148_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=CESD4T340JkQ7kNvwHeB67u&_nc_oc=AdoK2HvsxREHubLAHVhLdiwiTr46L0ksN0JTFm2qlxIeQ_8iqp0z_Q9xghpiPSNGJws&_nc_zt=3&_nc_ht=scontent-dfw6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRyI9Rzfw6Obf_n86xuu_xDwbAnvgc7beylTnZfuvV7TQ&oe=6AF9E8AF"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Fun Monkey Tag VR", "keywords": [], "long_description": "Fun Monkey Tag is a high-energy VR locomotion game that turns you into a fast, agile monkey in a vibrant, interactive jungle world. Using only your hands to run, jump, swing, and climb, you'll experience true freedom of movement as you chase \u2014 or flee \u2014 in chaotic rounds of tag with friends or other online players.\n\nMaster the art of monkey locomotion as you swing through trees, scale walls, vault across obstacles, and launch yourself with precision and speed. Whether you're evading pursuit or hunting down the last untagged monkey, every movement counts in this competitive, yet hilarious experience.\n\nFeaturing multiple jungle-themed maps, customizable monkeys, and a growing list of game modes, Fun Monkey Tag is built for replayability and nonstop laughter. Whether you're playing casually with friends or diving into intense tag battles, the intuitive movement system and immersive environments will keep you coming back for more.\n\nGet ready to monkey around \u2014 and remember, in this jungle, the floor is always lava (well, sometimes).", "short_description": "Swing, climb, and leap like a wild monkey in Fun Monkey Tag \u2014 the ultimate VR locomotion game! Join friends in chaotic jungle arenas where speed, skill, and agility rule. Tag or be tagged in this fast-paced, fun-filled primate playground!"}]}, "developer_name": "MistilenceProductions", "developer_privacy_policy_url": "https://sites.google.com/view/fun-monkey-tag/privacy-policy", "developer_terms_of_service_url": null, "publisher_name": "MistilenceProductions", "support_website_url": null, "website_url": "https://sites.google.com/view/fun-monkey-tag/privacy-policy", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_
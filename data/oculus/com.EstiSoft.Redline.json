348902403374037_6278907483541781749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=o04QAWBXBnQQ7kNvwHCmAUf&_nc_oc=Adr2AkaA-o7RL8Gq18Ow4zRnwe0_lO_Kx4pDTyViRwBwRy6k_sCdQM9yoaSqm9xppvU&_nc_zt=3&_nc_ht=scontent-dfw5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDrwfwX0t9WoVK2VBUUr6ScO7rXjHPTm0kieFbuuyyzAA&oe=6A661DDB"}, {"file_name": "Image Sequence_006_0001.png", "id": "1555462039117911", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491819845_1555462042451244_8134931143829636631_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=-JYIAemCaMEQ7kNvwHQNlYK&_nc_oc=AdrHD0vP7xjpGkq05i_iVAkR7lDQEjTEPTEG7GrjzINEeT1k8JdELRIPTO4jKZx0tf0&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCC0VewmHPQMYnEHdHErclSbl51bjXVqQ5OtR5qm3vCzw&oe=6A65F81C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0001.png", "id": "1999027593997850", "uri": "https://scontent-dfw6-2.oculuscdn.com/v/t64.5771-25/491823351_1999027600664516_5180476009005180844_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=avM6S4a0m4QQ7kNvwH-DXNV&_nc_oc=Ado-rdBL7OFps8O9DJj53t0MxX9OAIE4nJKaRYel-yjW0Ezdx5qofCtdoB98StoO5CE&_nc_zt=3&_nc_ht=scontent-dfw6-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQB-ui-Bw54pvs0N0vDQVhQJRKDxdqD3_Xdp2ciYHckbpA&oe=6A65F3B9"}, "display_name": "REDLINE", "keywords": ["Racing", "Highway", "DrivingSimulator", "Traffic", "Enjoy"], "long_description": "Welcome to REDLINE, where the speedometer only knows one direction: up.\n\nStep into the driver's seat of high-performance modified machines and hit the highway. This isn't just driving; it's survival of the fastest. In REDLINE, you are the outlaw of the asphalt. Your goal is to weave through dense traffic, dodge incoming trucks, and push your luck by driving in the wrong lane to rack up insane combos.\n\nKey Features:\n\nImmersive VR Cockpit: Grab the wheel and feel the rush! Realistic car interiors and responsive controls put you right in the driver's seat.\n\nAdrenaline-Pumping Modes: Race against the clock, test your skills in endless traffic, or survive the pressure in the explosive 'Bomb Mode' where every collision could be your last.\n\nRisk & Reward System: The more dangerous you drive, the higher you score. Perform near misses and drive 'Wrong Way' to multiply your points.\n\nDynamic Environments: Tear up the highway under the scorching sun, in the dark of night, or through challenging rainy weather.\n\nCustom Rides: Admire your tuned sports cars with neon underglows and custom rims in the showroom before hitting the road.\n\nDo you have the nerves to handle the speed? Put on your headset and hit the REDLINE!", "short_description": "Push your limits in REDLINE! Experience the ultimate VR traffic racing thrill. Weave through heavy highway traffic at breakneck speeds, score big with near misses, and drive against the flow for massive combos. Featuring immersive cockpit views, dynamic weather, and high-stakes game modes like 'Bomb Survival.' Step on the gas and see how long you can survive the asphalt chaos!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "use
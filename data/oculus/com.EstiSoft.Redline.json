aORw&oe=6A4E5A17"}, {"file_name": "Image Sequence_001_0001.png", "id": "1348902400040704", "uri": "https://scontent-lga3-2.oculuscdn.com/v/t64.5771-25/491821674_1348902403374037_6278907483541781749_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=j_lQIgmNHmYQ7kNvwHpbF56&_nc_oc=Adq-uOSi3MW4xxK4i65r4Z1xD3T0xwEjX5at2cV2ThUXfBr_U08IemVa3Wl-D6_lShk&_nc_zt=3&_nc_ht=scontent-lga3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQBJ-pCBy3QOZgB37Z1IQ5--67ERUphgO8o57IvrDtJusQ&oe=6A4E62DB"}, {"file_name": "Image Sequence_006_0001.png", "id": "1555462039117911", "uri": "https://scontent-lga3-1.oculuscdn.com/v/t64.5771-25/491819845_1555462042451244_8134931143829636631_n.png?_nc_cat=110&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=EpXVlzmS4KkQ7kNvwHQ-d-I&_nc_oc=AdoXgZOlOEH4W0i5rYwmCF4LR8vOLFj-IUskIVDSH50cfwweVwyMFE1uOMDhJQuPECE&_nc_zt=3&_nc_ht=scontent-lga3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQDLnG4wK72Dee35iOvq-eDuYmExHLCTzGDLRLeUVOndOA&oe=6A4E3D1C"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "Image Sequence_001_0001.png", "id": "1999027593997850", "uri": "https://scontent-lga3-3.oculuscdn.com/v/t64.5771-25/491823351_1999027600664516_5180476009005180844_n.png?_nc_cat=108&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JDGRplC-NyMQ7kNvwE2D4-P&_nc_oc=AdpKh5Wi3bwmToQXWOLMCPE0sTXPLECpIiOiWKixgK7dO34a9dwurVxFuAi5VzUhAtg&_nc_zt=3&_nc_ht=scontent-lga3-3.oculuscdn.com&_nc_ss=7f20f&oh=00_AQCADVv6K86jTl6VHTpKqxYwhzPpj9wEHtKqk3Hq5xV5Bg&oe=6A4E38B9"}, "display_name": "REDLINE", "keywords": ["Racing", "Highway", "DrivingSimulator", "Traffic", "Enjoy"], "long_description": "Welcome to REDLINE, where the speedometer only knows one direction: up.\n\nStep into the driver's seat of high-performance modified machines and hit the highway. This isn't just driving; it's survival of the fastest. In REDLINE, you are the outlaw of the asphalt. Your goal is to weave through dense traffic, dodge incoming trucks, and push your luck by driving in the wrong lane to rack up insane combos.\n\nKey Features:\n\nImmersive VR Cockpit: Grab the wheel and feel the rush! Realistic car interiors and responsive controls put you right in the driver's seat.\n\nAdrenaline-Pumping Modes: Race against the clock, test your skills in endless traffic, or survive the pressure in the explosive 'Bomb Mode' where every collision could be your last.\n\nRisk & Reward System: The more dangerous you drive, the higher you score. Perform near misses and drive 'Wrong Way' to multiply your points.\n\nDynamic Environments: Tear up the highway under the scorching sun, in the dark of night, or through challenging rainy weather.\n\nCustom Rides: Admire your tuned sports cars with neon underglows and custom rims in the showroom before hitting the road.\n\nDo you have the nerves to handle the speed? Put on your headset and hit the REDLINE!", "short_description": "Push your limits in REDLINE! Experience the ultimate VR traffic racing thrill. Weave through heavy highway traffic at breakneck speeds, score big with near misses, and drive against the flow for massive combos. Featuring immersive cockpit views, dynamic weather, and high-stakes game modes like 'Bomb Survival.' Step on the gas and see how long you can survive the asphalt chaos!"}]}, "developer_name": "Esti Soft", "developer_privacy_policy_url": "https://drive.google.com/file/d/1_l_GxTpD64zBNaY3TAnGXtCB1cmJE-E7/view", "developer_terms_of_service_url": null, "publisher_name": "Esti Soft", "support_website_url": null, "website_url": "https://www.esti.tr/", "category": null, "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "673385183287495"}, {"id": "2776542286000603"}, {"id": "331529188132278"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "NOT_REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_lang
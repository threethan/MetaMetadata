j&_nc_oc=AdlThI2Ve1AYbUR9LF9pkEcFWs3wfAkHZ8GUMZHm1wiQmSIX8etxTfm71vT8fIFKEGY&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_Aful-qfnk65AlPmPgtpTsqutTxNrDqFPwOBbg6wXqJs88g&oe=69A2E8B6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "rollover_thumbpng land.png", "id": "709558060790554", "uri": "https://scontent-iad3-2.oculuscdn.com/v/t64.5771-25/43997716_709558064123887_8744616869073302251_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=y0bCWLiwjskQ7kNvwG9uPRy&_nc_oc=AdmQa22874YH-mEbrM_gUWyiXWohIMfT_ssxT_GuPQMWGMsv1S_HHVcebcu-ZZ8GX74&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&oh=00_AftoQy8jUhJ02ys2YgM5hp52784UXqZkjvFvUHO30EN1xw&oe=69A2F27D"}, "display_name": "Nurse's Escape", "keywords": [], "long_description": "Nurse's Escape is a VR game that simulates an escape room based on the Sepsis Bundle. The purpose is to supplement nurse's lecture-style curriculum with an interactive way to test nurse\u2019s Sepsis knowledge. Sepsis is one of the leading causes of deaths and hospitalizations yearly, so equipping nurses with the right skills and information to treat sepsis in a timely manner can save lives and money. Help treat the millionaire's illness before time runs out!\n\nThis game is sponsored by the University of Nebraska Medical Center's College of Nursing-Lincoln.", "short_description": "Save the millionaire from a mysterious condition before time runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Redundacy/NursesEscapePrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "UNMC College of Nursing", "support_website_url": "https://nursesescape.com/", "website_url": "https://www.unmc.edu/nursing/about/about_five_campuses/lincoln_campus.html", "category": null, "comfort_rating": "NOT_RATED", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "459781504968480"}, {"id": "2691890164460465"}, {"
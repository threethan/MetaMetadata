ent-ord5-1.oculuscdn.com/v/t64.5771-25/75375083_1191534468390657_1368590134200968525_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6rKR-I1EYmwQ7kNvwG2BViX&_nc_oc=Adr-ZcYyIOY4_I25loCnjlLtuCRD3oSyifANpq6spvfPY3kF5y5k2Ngj5mGQTEaXu8w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af4JY17hLO33jSWnGuRBMfNFxi_uSNeaPDx5rqnl4P95gw&oe=69F9EBB6"}], "video_trailer": null, "video_trailer_thumbnail": {"file_name": "rollover_thumbpng land.png", "id": "709558060790554", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/43997716_709558064123887_8744616869073302251_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=UkAcsg6HOMwQ7kNvwES5mnd&_nc_oc=AdoXK5GTZtI17JOrHXhywarwgDu4mK89pq6egoNKXLtBALzS7x7_WOMD6N_zHzOJl-w&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af74qLfQ7kmYCbR4uaYaOuo3TB6vVqepiPcA-N7sHmN6jA&oe=69F9F57D"}, "display_name": "Nurse's Escape", "keywords": [], "long_description": "Nurse's Escape is a VR game that simulates an escape room based on the Sepsis Bundle. The purpose is to supplement nurse's lecture-style curriculum with an interactive way to test nurse\u2019s Sepsis knowledge. Sepsis is one of the leading causes of deaths and hospitalizations yearly, so equipping nurses with the right skills and information to treat sepsis in a timely manner can save lives and money. Help treat the millionaire's illness before time runs out!\n\nThis game is sponsored by the University of Nebraska Medical Center's College of Nursing-Lincoln.", "short_description": "Save the millionaire from a mysterious condition before time runs out!"}]}, "developer_name": null, "developer_privacy_policy_url": "https://github.com/Redundacy/NursesEscapePrivacyPolicy/blob/main/README.md", "developer_terms_of_service_url": null, "publisher_name": "UNMC College of Nursing", "support_website_url": "https://nursesescape.com/", "website_url": "https://www.unmc.edu/nursing/about/about_five_campuses/lincoln_campus.html", "category": null, "comfort_rating": "NOT
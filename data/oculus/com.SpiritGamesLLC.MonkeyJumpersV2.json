64737099726280425_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=776iScbPUTsQ7kNvwF8W87H&_nc_oc=Adrx-lNHPex-tyHmI7ycdynJ7ySh8pWgbtRFhp6VYFjwBA_2uDItr2Qpryik3PUzKWU&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQHfWvvlP8OnClUJk-qZQmhQX_dRXhpKTG4B0zy7ycDHcA&oe=6A8D97C6"}, {"file_name": "ss2 v2.png", "id": "1779213046147230", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031482_1779213049480563_7642349779976588734_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lrPCFk5oDooQ7kNvwHHACN5&_nc_oc=Adp-2GoaJbTeQebZ_W1uMWQcEm7tfdgOAR9gKLNjsQPd6LZbHWo3QN2gmaxX-14y00A&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQGWL359DO64FG__xGuV6-5tLRSgSbNHaayW_SCaKPnuyw&oe=6A8D7EFB"}, {"file_name": "ss5 v2.png", "id": "568316389457273", "uri": "https://scontent-lhr11-1.oculuscdn.com/v/t64.5771-25/39031605_568316392790606_20012171714691183_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FsOyKjAgzYwQ7kNvwEUUMfG&_nc_oc=AdozssBdwzZrJNYudL0hQ35bZJF130nNORGmg7XpyNV-RjofwRvbCXGv9o2DAI033FI&_nc_zt=3&_nc_ht=scontent-lhr11-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQH6MCXLN1JJk7tLNq5fauECJbvBL2fCiiPmxb6Jb09Vtg&oe=6A8D7F05"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Jumpers V2", "keywords": ["fun", "ghxsty", "spiritgames"], "long_description": "Monkey Jumpers V2 is an immersive multiplayer VR experience that redefines social and competitive gaming. Moving beyond its predecessor's horror theme, V2 introduces a vibrant world with diverse gameplay features, including parkour, zero-gravity, and intricate modes designed for up to 10 players.\n\nPlayers can personalize their monkey with a range of purchasable cosmetics with in-game currency, showcasing their style and achievements. Advanced locomotion mechanics ensure fluid movement, while frequent updates add new maps, cosmetics, and features to keep the experience fresh.\n\nMonkey Jumpers V2 offers a dynamic and engaging environment, blending competitive gameplay with social interaction, making it a standout VR experience.", "short_description": "Monkey Jumpers V2! What could this possibly, be? Monkey Jumpers V2 introduces new features and fun game modes to try out!"}]}, "developer_name": "ghxsty", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-jumpers-llc/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkey-jumpers-llc/terms-of-service?authuser=0", "publisher_name": "Spirit Games", "support_website_url": "https://sites.google.com/view/monkey-jumpers-llc/support", "website_url": "https://sites.google.com/view/monkey-jumpers-llc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8998035346952867"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1302221684130050"}]}, "baseline_offer": {"id": "1302221684130050"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735861560, "status": "PUBLISHED", "id": "1302221684130050"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9433781856711545", "version": "8.1"}, "id": "932766981574432", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary",
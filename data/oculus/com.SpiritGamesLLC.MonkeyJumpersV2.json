: ["fun", "ghxsty", "spiritgames"], "long_description": "Monkey Jumpers V2 is an immersive multiplayer VR experience that redefines social and competitive gaming. Moving beyond its predecessor's horror theme, V2 introduces a vibrant world with diverse gameplay features, including parkour, zero-gravity, and intricate modes designed for up to 10 players.\n\nPlayers can personalize their monkey with a range of purchasable cosmetics with in-game currency, showcasing their style and achievements. Advanced locomotion mechanics ensure fluid movement, while frequent updates add new maps, cosmetics, and features to keep the experience fresh.\n\nMonkey Jumpers V2 offers a dynamic and engaging environment, blending competitive gameplay with social interaction, making it a standout VR experience.", "short_description": "Monkey Jumpers V2! What could this possibly, be? Monkey Jumpers V2 introduces new features and fun game modes to try out!"}]}, "developer_name": "ghxsty", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-jumpers-llc/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkey-jumpers-llc/terms-of-service?authuser=0", "publisher_name": "Spirit Games", "support_website_url": "https://sites.google.com/view/monkey-jumpers-llc/support", "website_url": "https://sites.google.com/view/monkey-jumpers-llc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["ST
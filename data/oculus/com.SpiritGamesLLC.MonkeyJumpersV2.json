5_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=INDBGIbyti4Q7kNvwGylOGM&_nc_oc=AdqzXczD4mnHvCy2Mtup2ej-heqECqQ9IkD5o0UII1zDUYuK0M-BmG-t4xGMs7c8CI8&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af7SbP7JsclicYqLmV3AZTz2B7wKH7gM35HpOuDjXH4uAQ&oe=6A11AAC6"}, {"file_name": "ss2 v2.png", "id": "1779213046147230", "uri": "https://scontent-sin11-2.oculuscdn.com/v/t64.5771-25/39031482_1779213049480563_7642349779976588734_n.png?_nc_cat=101&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=yP95SG63TtoQ7kNvwGbLg-A&_nc_oc=AdoRvZQEYOtP8D_P6_lFIWC7KfKcmsItUMew4z3UTmkjCNYmIaz2oMEU0Uo-ezl6XkY&_nc_zt=3&_nc_ht=scontent-sin11-2.oculuscdn.com&_nc_ss=7f20f&oh=00_Af79IDGzY4jCRZKIUTZ-lez4PDc5ViO7UlU24eRugJTswA&oe=6A11CA3B"}, {"file_name": "ss5 v2.png", "id": "568316389457273", "uri": "https://scontent-sin6-1.oculuscdn.com/v/t64.5771-25/39031605_568316392790606_20012171714691183_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cJA1iqhU_BAQ7kNvwG8u-U4&_nc_oc=AdrF9o1nQJPA72iG07Vq6ksdKOxSzj6drWJAHMEPLQWCSd2GYDJHoYgf3-j4RCZFWEA&_nc_zt=3&_nc_ht=scontent-sin6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_Af6nSgIJI-7bfMiMYRYfwPYnwq3l98RLw8m4ixLe-S7POA&oe=6A11CA45"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "Monkey Jumpers V2", "keywords": ["fun", "ghxsty", "spiritgames"], "long_description": "Monkey Jumpers V2 is an immersive multiplayer VR experience that redefines social and competitive gaming. Moving beyond its predecessor's horror theme, V2 introduces a vibrant world with diverse gameplay features, including parkour, zero-gravity, and intricate modes designed for up to 10 players.\n\nPlayers can personalize their monkey with a range of purchasable cosmetics with in-game currency, showcasing their style and achievements. Advanced locomotion mechanics ensure fluid movement, while frequent updates add new maps, cosmetics, and features to keep the experience fresh.\n\nMonkey Jumpers V2 offers a dynamic and engaging environment, blending competitive gameplay with social interaction, making it a standout VR experience.", "short_description": "Monkey Jumpers V2! What could this possibly, be? Monkey Jumpers V2 introduces new features and fun game modes to try out!"}]}, "developer_name": "ghxsty", "developer_privacy_policy_url": "https://sites.google.com/view/monkey-jumpers-llc/privacy-policy?authuser=0", "developer_terms_of_service_url": "https://sites.google.com/view/monkey-jumpers-llc/terms-of-service?authuser=0", "publisher_name": "Spirit Games", "support_website_url": "https://sites.google.com/view/monkey-jumpers-llc/support", "website_url": "https://sites.google.com/view/monkey-jumpers-llc/home", "category": null, "comfort_rating": "COMFORTABLE_FOR_SOME", "comfort_tags": [], "context_category": {"id": "2743326035925534", "context_category": "GAMES"}, "context_topics": [{"id": "2691890164460465"}, {"id": "459781504968480"}, {"id": "1990104051447093"}], "external_subscription_type": "NOT_REQUIRED", "genres": [], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["en"], "supported_input_devices": ["OCULUS_TOUCH"], "supported_player_modes": ["STANDING"], "supported_tracking_modes": [], "user_interaction_modes": ["MULTI_USER"], "id": "8998035346952867"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "1302221684130050"}]}, "baseline_offer": {"id": "1302221684130050"}, "is_approved": true, "firstOffer": {"nodes": [{"start_time": 1735861560, "status": "PUBLISHED", "id": "1302221684130050"}]}, "liveChannel": {"nodes": [{"latest_supported_binary": {"__typename": "AndroidBinary", "binary_test_results": {"nodes": []}, "id": "9433781856711545", "version": "8.1"}, "id": "932766981574432", "channel_name": "LIVE"}]}, "is_for_oculus_keys_only": false, "primary_binaries": {"nodes": [{"__typename": "AndroidBinary", "__isAppBinary": "AndroidBinary", "binary_applicati
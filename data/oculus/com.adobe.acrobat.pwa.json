me": "AcrobatOculus_Cover_100322_v01 (1).png", "id": "676042040264837", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/75348039_676042043598170_7473175276440080134_n.png?_nc_cat=106&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r5_DaFNxhKMQ7kNvwHHDID3&_nc_oc=AdpjawJiseyhcZuSwEaGlzZsY4a7RbL3VMcky135-lD2Udw77crsfx2RFUfhWmWjISc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSyX8ER1TQ8MrwUtgj6VVd1-BcGYB7-npIn7w5trnbHww&oe=6AFDE3EC"}, "display_name": "Adobe Acrobat", "keywords": ["Adobe", "Acrobat", "PDF", "Reader", "Documents"], "long_description": "Adobe Acrobat takes the work out of your paperwork. Easily view PDFs, add comments, share, and sign documents for free.\n\nUsed by millions of people, Acrobat is the industry-leading PDF solution. With Acrobat, you get the best PDF viewing experience available, so you can trust that everyone will see the same content. \n\nAcrobat also makes it quick and easy to add your e-signature or initials. You can share files too and speed reviews by collecting everyone\u2019s input in one file.\n\nIf you need more advanced Acrobat features, you can sign up for a free trial at https://www.adobe.com/tryacrobat to convert to and from PDF, create a PDF, merge files into one PDF, organize a PDF, reduce PDF size, and more. Working with PDFs has never been so easy.\n\n*You must be 13 or above to use Adobe Acrobat", "short_description": "Adobe Acrobat takes the work out of your paperwork. Easily view PDFs, add comments, share, and sign documents for free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adobe.com/go/privacy_policy", "developer_terms_of_service_url": "https://www.adobe.com/go/terms", "publisher_name": "Adobe Inc", "support_website_url": "https://helpx.adobe.com/document-cloud/help/using-pdfpack.html", "website_url": "https://acrobat.adobe.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692
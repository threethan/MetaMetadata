our e-signature or initials. You can share files too and speed reviews by collecting everyone\u2019s input in one file.\n\nIf you need more advanced Acrobat features, you can sign up for a free trial at https://www.adobe.com/tryacrobat to convert to and from PDF, create a PDF, merge files into one PDF, organize a PDF, reduce PDF size, and more. Working with PDFs has never been so easy.\n\n*You must be 13 or above to use Adobe Acrobat", "short_description": "Adobe Acrobat takes the work out of your paperwork. Easily view PDFs, add comments, share, and sign documents for free."}]}, "developer_name": null, "developer_privacy_policy_url": "https://www.adobe.com/go/privacy_policy", "developer_terms_of_service_url": "https://www.adobe.com/go/terms", "publisher_name": "Adobe Inc", "support_website_url": "https://helpx.adobe.com/document-cloud/help/using-pdfpack.html", "website_url": "https://acrobat.adobe.com/", "category": "APPS", "comfort_rating": "COMFORTABLE_FOR_MOST", "comfort_tags": [], "context_category": {"id": "362692211442873", "context_category": "APPS"}, "context_topics": [{"id": "1063584910766706"}], "external_subscription_type": "REQUIRED_FOR_SOME_CONTENT", "genres": ["UTILITY", "PRODUCTIVITY"], "has_in_app_ads": null, "internet_connection": "REQUIRED", "play_area": "NO_MOVEMENT", "recommended_graphics": null, "recommended_memory_gb": null, "recommended_processor": null, "supported_in_app_languages": ["de", "fi", "ru", "sv", "ko", "en", "pt_BR", "it", "fr", "es", "cs", "en_GB", "zh_TW", "nb", "en_US", "zh_HK", "ja", "pl", "da", "nl", "tr"], "supported_input_devices": ["TRACKED_KEYBOARD", "HAND_TRACKING", "GAMEPAD", "OCULUS_TOUCH"], "supported_player_modes": ["SITTING", "STANDING", "ROOM_SCALE"], "supported_tracking_modes": [], "user_interaction_modes": ["SINGLE_USER"], "id": "1053142432234362"}}]}, "scheduled_offers": {"count": 1, "nodes": [{"status": "PUBLISHED", "id": "499084505423678"}]}, "baseline_offer": {"id": "499084505423678"}, "is_approved": true, "f
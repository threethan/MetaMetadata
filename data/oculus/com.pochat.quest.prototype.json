ZHpnWjFtEKBOOUbUa6N4TV2eGtjahfHjo79JE&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSRbFuTtuJ1y_LW2Lp_t8kprFtksmAX3Jgn7y4PkzdEng&oe=6B0DB1BB"}, {"file_name": "858304537_29837295469191797_4388193426456345984_n.png", "id": "1667358748419421", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=8Svk3CQR8cAQ7kNvwG_AGp0&_nc_oc=Adq6RXnJclvgBMEQxPEr7Km0oX0DmmsmHNgpKwADjZjczeWOq7fvot8YelkNGZzO-vk&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRrAxYe5H1ZPuEYiDJfGuoen0BcWVlGoBUxEzr_Smz8YA&oe=6B0DD129"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZVBWUp6v2ckQ7kNvwFV_6kg&_nc_oc=AdpRB7-XWnLzwHl2T5hg-ydL2lFEUpMrH4fAgWbB35tYeeLJMXhcTwT6metJlzL8OAc&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQR8hx5xy04r-ALXIXKfp0nv1fO-BsiTG2a3k4kkNo4HcA&oe=6B0DBFEE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=iIjOy6Ma4NMQ7kNvwGhom0A&_nc_oc=AdpjHYoYJnpLT6tHaOafhGhAmszCYCUmFgogFiObHwl57QhWKz8ckdbBeibNUqfUVmw&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f30f&oh=00_AQSLhzL3iW1qNKibaeFE4RtXVxBwk-pqIDG0eU6FdyYAzQ&oe=6B0DC4EC"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=V9oftzLENDUQ7kNvwHv5b2_&_nc_oc=AdqZV84WPUBwASndMMKrrdF_ZRpfVJSqzjSt-7e8pD9aIHdTQ8F34ug7tl48DOI9dGg&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f30f&oh=00_AQRq1qbqpMbejTayqYbgm_UD0SkZ352YuLWNQMcA6RXJWw&oe=6B0DB512"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=rSeFpF2oj-YQ7kNvwG3xlyu&_nc_oc=AdrUqRYbfl3T-GLvyiAIfNdMRj57uj7Q-3kZS-ob73oNWefHTPhdptTQP79ZuIamgF4&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss
4.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJScFtNv-98Q7kNvwGfNKu3&_nc_oc=Adrix0VjXP0FIzyF68tOr7ZmwSYxm65HKQzqG627gr0PmntkCpcbUZCIb7zO75wl1OQ&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQxU80sso2cWeeVSbXVwk0Rme108VG1OiUkZ99NIi9Jsw&oe=6AF880E9"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=exWjIv2vHWUQ7kNvwGa5iXQ&_nc_oc=Adr7W5olAKXKOXi2hzeQghlXMO281IQs-qo1kmg_ard2G9agRLBLyADFpFvL_GF9LyA&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQN5VXcflRYhnNeX1WPRl75EA7H-Qhl544HhxjLmWD5pg&oe=6AF8A7EE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be anno
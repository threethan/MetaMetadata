AqPuvzbcxIiRBM7kVSBmZb_w--MpEIBlAm-zs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTWgEyozmh_Y4WqeguEe3Ae-8VCE_LskUThaAVmrenH2Q&oe=6B09BD3B"}, {"file_name": "858304537_29837295469191797_4388193426456345984_n.png", "id": "1667358748419421", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5t-TIyoSGMUQ7kNvwEmKnhB&_nc_oc=Adp-1q2ll_I-4C8rqmD2ZPVCqSwedw_cai6KzteIm-mYD0luwwJs7Y4bvZ0igoS9kUs&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmSr4ykZmaGZxtFjViDY5lUbPyN7xfJfMuKL32ICwBcg&oe=6B09A469"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=ZGuV3fA60joQ7kNvwF8CTQt&_nc_oc=AdooVeRJm8Bil1u6F-zYz1Jx2PInTWsEQolmDXw9Ea-s391fklMwa9_MYI5powFZK2I&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRE6JidVkG468gFxO68OqIa_GrOOHHsTfgt27tJDOqZYQ&oe=6B09CB6E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=24MkzUOPR7AQ7kNvwHsug-z&_nc_oc=Adp8yayjhyq0fIJxDQs5c_O3NAlrAsLRCczr1PCzfDT0XNREyssTfys9k0TCtxYnvac&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQA8AYJ8cUT-NZfuc1kTKgUL0GW9JXLTBKQCQgiaWx50A&oe=6B09D06C"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=6zDsjY6VGUcQ7kNvwHhioNR&_nc_oc=Adrpf97Iptiui9xBSVp4loRQXwI4nzmkRt5l2hFmNPJ-Kjxh0nf_1tsEa0TRU0tWkSU&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRTVPUPaiikFgSzePnhMVxyx_vOxGKqSLg7BI9Qgawz6g&oe=6B09C092"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-2.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=juJGPRWrhGkQ7kNvwH9yYBA&_nc_oc=AdqWl5znVPW7zJQ_BA1FF4o42xFBtJwSgCCKW-ovHRtAkoVm4bvPGi6zb8KK1PWVITc&_nc_zt=3&_nc_ht=scontent-sea5-2.oculuscdn.com&_nc_ss
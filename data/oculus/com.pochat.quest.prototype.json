4.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=dJScFtNv-98Q7kNvwFygJDM&_nc_oc=AdoapZ6MVNCsoevt4GGc0gkRFBrpLLI0sgY0mQT8RduccFVmBNbbrMuKXX3SBIVG7u0&_nc_zt=3&_nc_ht=scontent-iad3-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnHZXWLcvt0dar4z3v2-LDu0tf71K1fW6V8KsLRn1sAg&oe=6AF5DDE9"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNfRAaDPCyMQ7kNvwGH2aM4&_nc_oc=AdokEZsbmjbhWemnBXlAQARwpQfoAar6FbMpcwtbR1a8pwFFn1ggjnjWdGEkuk6feAQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQnslUXHIUisJpyj5VHe7v40MVlRGy0Ex4R4tC2jSw4Bw&oe=6AF5CCAE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be anno
4.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=f2L642_FJZQQ7kNvwHxB6Oe&_nc_oc=Adq1AwOF5jYVMZOiXFC1fQS1Vcmt1zhfAO-HQPrgAyL1kkkvldfYIcjndOKplgCAdZo&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSRyeKSBlzSPkpasVyK3gOsXS4nIzHGFLoBar47ER6D6w&oe=6AF48C69"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=FNfRAaDPCyMQ7kNvwFlO23K&_nc_oc=Adpad2fUTLWPv87j68SPOZZzya_ljIH3nu0mffgYYVh2EHUq8IEXQzU10Jhy1d0l7gQ&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRYPeX5Y1wXu6HiLT4EFAhl2NqOlIzM6g0QSpp4BIbpkA&oe=6AF47B2E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=cGAk0qbqzMoQ7kNvwFA2YgK&_nc_oc=AdoJ-MBHb_Cc3D2WVdsYc-_UszOPDU4jemPMcuUqIHSxRvZVPkvyI7kJ16K8b246F-Q&_nc_zt=3&_nc_ht=scontent-ord5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSrJK047xGiFasXlrU4qsidWYshj6ymAMKgNk-NrWz06w&oe=6AF4802C"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=r1orVqwqV_IQ7kNvwEb2dwy&_nc_oc=AdpwZS76ikROjLSNEkkXiq2h3a-YxlnKmXWUyP-X93o3EZya9otWMq-hATNILJ_a-1c&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSzHCzMqOj2xVsz-1TwRQSiuxJZobkMJf_Z59INpxMRJQ&oe=6AF47052"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-ord5-2.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=xhnoYX0o4mMQ7kNvwGAveZw&_nc_oc=AdrfsYQOV6JIYY4tQUWRXfLOn7B1TLB7nGhTivhaZVPW97damk7PJKK7Lj_PzzWEHWo&_nc_zt=3&_nc_ht=scontent-ord5-2.oculuscdn.com&_nc_ss=7f20f&oh=00_AQS9xXkL9ud5qvLUDqD6sVdtoqsqTCTq0FAVRtBem6XYnw&oe=6AF49717"}, {"file_name": "background-512x512.png", "id": "2126344877981813", "image_type": "APP_IMG_ICON_BACKGROUND_512", "uri": "https://scontent-ord5-1.oculuscdn.com/v/t64.5771-25/499623512_2126344881315146_4947547688862397006_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=hsAoqDpI1xIQ7kNvwFD_19x&_nc_oc=Adr8e2kcD-r5-qYJ4wD8R6R22yX_4xpI8IdDNOTcNrXk3IYtQZePkmeGZDdjtLNG9gQ&_
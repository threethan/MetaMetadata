cCcUQ0WJYy8D3vkfWM32U5QAEkROkBQ90cFAs&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSgDAuVEO7IXfXdKg6-kGlkZnck9CsPzKjUqMMw4E_TTg&oe=6B01D43B"}, {"file_name": "858304537_29837295469191797_4388193426456345984_n.png", "id": "1667358748419421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=fOGBiCE-OOEQ7kNvwEkUSce&_nc_oc=Adq2r1jbMOJFM5yHN71Xz2GRhFtko7OylJLiNF9bORoUJmdEBperW-fJBkQGu9M0DaE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTY9MEfU4w5otUuQ3OUXp3qempkUiNWH62U2jR_3Tqc5w&oe=6B01BB69"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkSm50ngqbAQ7kNvwGfNZoV&_nc_oc=Adr4tiZHuuLugkJTzXB2hfrQgYRm4KDAtklFOS4tnXRlAw9JVxL54WLwN2Im0Gyr0yM&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQNNFm66u4pd0tDRxM5rKty9pZOfPR5Zvuwo0n9u9S4pg&oe=6B01E26E"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaZONeYTjhAQ7kNvwECoN84&_nc_oc=AdryvTncttiO0yjWDadvd6LgQHkGtVEJQen6oa4uBJ6YRv8PrpeoHJ1OBVZRIRV3owU&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSN4DrVifdo0ds2MMkp5f-2gzCGaEcBQEJqkDcJfydDYA&oe=6B01E76C"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-WDKzZHKIcQ7kNvwF_TbH_&_nc_oc=AdpQfrSiiH3qZJ7kVmF0Hii1ugF-CexfZtVIdpAr2COiyKrXRem20XTpZ3k6gfXtJJQ&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQXYdyLBauyW8OgMULQIcotA-42P28xEV36MGVVxYEEIg&oe=6B01D792"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=sK17MA3HN_IQ7kNvwFZs5jQ&_nc_oc=AdoHeTNSKZXtXSW5FBTHI8QtqYRP4F8E2wte2fw8qvIkb6BEJouW6FW-RyKgCc1SBfA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss
4.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=Wq8YIW3un1AQ7kNvwHVusdl&_nc_oc=AdpCUlDZWdWO5-TOMfS7M_SM7-zUQNg8EbY1071S4mOctLxMsbb7qd8DwZfPkstKxlM&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQ_22KfktU-2xdh_hweLpwMU-PBdUrw5ggZNUN1-TWXJw&oe=6AF097E9"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=5IgHrZybxCsQ7kNvwGz-dym&_nc_oc=Adr_FO3LDAhIIDF53zvTfeNMdD0we-YpFiHREzVBkvgiQRoF3Wz_jNAi6ebTAGPh5nQ&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRwryWP5EYPJS4mzxPw82LRuaA7SNJiH0ZWCkEflvuisg&oe=6AF086AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=azhYAP_UIxIQ7kNvwG8tcDq&_nc_oc=Adpar79GEw6Ts7nE1JnRPQoLEtgBaHAf34heeQFpRGge_-O2-5c2RkljKB9RQ6CMcsY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRUClYFn7xX0hCKL0M80Q7wiz-Fl_W_OaE5sIgVoa3xwA&oe=6AF08BAC"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=GsuIyZ9KpXgQ7kNvwF05fYB&_nc_oc=AdrRu3x_dusk-hiOUCtEkTAYsEnobweoPSbnF7HOgIAM0nBb_U8Ak9domKSg1iPRbEg&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQQFOgSQ9zfWb8LBAdLrK_VTFfQnR7HfyuzgaWCNi1Wi5Q&oe=6AF0B412"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KFZ_DDoht4cQ7kNvwFPq1Ay&_nc_oc=AdoSEfqj6PmQm7eU3K1xYWLWKl-5xmMD4foZGhtFhoUl8ukd8_EWAaxReVsqqEWuEyY&_nc_zt=3&_nc_ht=scontent-sea5-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRdDGGDL2ow41_o7RnxcYolzZ_v8r_xfaeswSpHVhywCw&oe=6AF0A297"}, {"file_name": "background-512x512.png", "id": "2126344877981813", "image_type": "APP_IMG_ICON_BACKGROUND_512", "uri": "https://scontent-sea5-1.oculuscdn.com/v/t64.5771-25/499623512_2126344881315146_4947547688862397006_n.png?_nc_cat=111&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=KBnOHMLjJyQQ7kNvwHCHs54&_nc_oc=AdqqyJZoDgOQ3JlPXRArQqiV1amrOqlu2-4cEm4bGnnJ2m596bcWAZVz_ULQzgb6gnc&_
gXIYkSX1k_LeAQNECYBYPAM0dRpPj8pKafE78&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRmLkx5c4os5BUz74ZSmQyg3SSi_1BMgYTQIgTpngL1kw&oe=6B0082BB"}, {"file_name": "858304537_29837295469191797_4388193426456345984_n.png", "id": "1667358748419421", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499621314_1667358751752754_8201647328292118629_n.png?_nc_cat=111&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SdRBS8tMqOoQ7kNvwFbPkUw&_nc_oc=AdoEhF2T2rFKZ_torQaUSafgt770m0nniRgqI8mmU6jkC55MTIalkHjYdRMP48jjqmk&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTkeEZYmUP0VXypxvbdJyO-EDxiZVUU_30US74rzaKEiQ&oe=6B0069E9"}, {"file_name": "859727682_29504140965859550_6509326646980943200_n.png", "id": "1109224551511318", "uri": "https://scontent-iad6-1.oculuscdn.com/v/t64.5771-25/499621314_1109224554844651_4753753040985782763_n.png?_nc_cat=104&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=lkSm50ngqbAQ7kNvwGAnKLX&_nc_oc=Adp7LgqMPOvD6Gppczj8NJrc2kgxZW4piDLpBpLsczaFc129_2dLKjDPmmpwX8dWWOE&_nc_zt=3&_nc_ht=scontent-iad6-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQSvzu7Khc9UmNHpNLQoREbOUYIm2TVG9A_9XqEZIpp6xw&oe=6B0058AE"}], "video_trailer": null, "video_trailer_thumbnail": null, "display_name": "PoChatQuest", "keywords": ["PoChat", "chat", "messaging", "friends", "notifications"], "long_description": "PoChatQuest brings one-to-one PoChat text chat to a Quest panel.\n\nSend and accept friend requests using PoChat user IDs, then exchange messages with friends using PoChat for PC. A PoChat account and an internet connection are required. Free accounts can be created on the official website through the link on the login screen.\n\nMessage alerts can display the sender's name and play a short sound while you use another app. You can change notifications, sound and message previews in PoChatQuest. Headset permissions, volume, mute, Do Not Disturb and Horizon OS limits affect alerts and background reception. Stay signed in with receiving active.\n\nSigning in on Quest switches the receiving device for that PoChat account. Messages already delivered to a PC are not automatically transferred to Quest.\n\nThe interface is currently available in Japanese. This Early Access beta is free and may change as development continues. Future Quest access may require a paid PoChat plan; any change will be announced in advance.", "short_description": "Text chat with your PoChat friends from Quest. Free Early Access beta with a Japanese-language interface."}, {"images": {"nodes": [{"file_name": "hero-3000x900.png", "id": "29643814441887161", "image_type": "APP_IMG_HERO", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/593734382_29643814465220492_1734952509924432984_n.png?_nc_cat=109&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=JaZONeYTjhAQ7kNvwGmz2cC&_nc_oc=Adq8g_D_bx3K7QrDS3uKTNHWBORlf_MCB_b-l1ZDPBWSDVd_cEE5gUJOHdAL5cs0cLA&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQTeksJmRXnUgdfhd6Gc1qMw78pBlS-XHoj_6-ZPQ4Txmg&oe=6B005DAC"}, {"file_name": "layered_icon_composited.png", "id": "4433714773559111", "image_type": "APP_IMG_LAYERED_ICON_512", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499622192_4433714776892444_3841360977607071696_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=x-WDKzZHKIcQ7kNvwHl0KFK&_nc_oc=AdoOXZQcBPPFNHIkSVEKvrePjiuvCJrk6WkXxJVHORYIChuN3YQr3fv8miPQxfCV94I&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss=7f20f&oh=00_AQRMqwAEendpkBONgcSKfnFS2CAqL9-fpN2NM_xLtV4NWg&oe=6B008612"}, {"file_name": "cover-square-1440x1440.png", "id": "3072168866318887", "image_type": "APP_IMG_COVER_SQUARE", "uri": "https://scontent-iad3-1.oculuscdn.com/v/t64.5771-25/499628456_3072168869652220_2231868827265850702_n.png?_nc_cat=100&_nc_map=urlgen_bucketless&ccb=1-7&_nc_sid=6e7a0a&_nc_ohc=SV3H22Xhg5wQ7kNvwHXG_tL&_nc_oc=AdrjjKggbNqh3I1KFBk-4apPQEiCyNJSiCqrUHM8jxY9KwLJY08tGsFPzl7IRSNl4CE&_nc_zt=3&_nc_ht=scontent-iad3-1.oculuscdn.com&_nc_ss